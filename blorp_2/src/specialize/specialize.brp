import:
	result: map
	../utils/boolean: not, and, or
	../namespace/builtins as Builtins:
		DesignatedBoolean,
		DesignatedOption,
		DesignatedResult,
		PrimitiveType(BuiltinInt, BuiltinFloat, BuiltinString, BuiltinVoid),
		RuntimeOperation(
			FloatCopySign, FloatEquals, FloatLessThan, FloatIsNaN, FloatIsFinite,
			IntAdd, IntSubtract, IntMultiply, IntDivide, IntRemainder, IntToString, StringLength, StringConcat,
			StringPrint, StringPrintError, StringParseInt, StringParseFloat, ListRepeat, ListLength, ListGet, ListAppend, ListSet, ListConcat, StringEquals,
			StringByteAt, StringFromCodepoint, StringSlice, GetCurrentDirectory, ReadFile, WriteFile,
			IntEquals, IntLessThan, FloatAdd, FloatSubtract, FloatMultiply, FloatDivide, FloatRemainder,
			FloatToString,
		),
		RuntimeType(PrimitiveRuntimeType, ElementRuntimeType, ListRuntimeType),
		RuntimeResult(ValueResult, OptionalResult, ResultResult, BooleanResult),
		runtime_contract,
	../check/check: CheckedProgram, checked_functions
	../check/model as Checked
	../utils/ids as Declaration
	int as IntOps
	option: to_result, is_some
	../utils/source: compiler_source
	../utils/syntax:
		Diagnostic,
		DiagnosticNote(UnionPayloadDeclaration),
		Entrypoint(NoArguments, WithArguments),
		FunctionExecution(OrdinaryCalls, SelfTailLoop),
		Span,
		entry_function,
		diagnostic,
	../utils/text: concat


-- Instance identities are issued only by this compilation's specialization builder.
opaque type FunctionInstanceId = Int

opaque type UnionInstanceId = Int

opaque type RecordInstanceId = Int


private fixed record FieldIdentity {
	owner: RecordInstanceId,
	position: Int
}


opaque type FieldInstanceId = FieldIdentity


fixed union RecordRepresentation:
	InlineRecord
	ManagedRecord


fixed record ConcreteRecord {
	fields: List[TypeRef],
	representation: RecordRepresentation
}


private fixed union RecordOrigin:
	DeclaredRecord(Declaration.RecordId)
	CaptureEnvironment(Checked.LambdaId)


private fixed record RecordKey {
	origin: RecordOrigin,
	arguments: List[TypeRef]
}


private fixed record RecordInstance {
	key: RecordKey,
	layout: ConcreteRecord
}


private fixed record VariantIdentity {
	owner: UnionInstanceId,
	position: Int
}


opaque type VariantInstanceId = VariantIdentity


private fixed record VariantFieldIdentity {
	variant: VariantInstanceId,
	position: Int
}


opaque type VariantFieldInstanceId = VariantFieldIdentity


pure func variant_field_variant(id: VariantFieldInstanceId) -> VariantInstanceId:
	from_opaque VariantFieldInstanceId(id).variant


pure func variant_field_number(id: VariantFieldInstanceId) -> Int:
	from_opaque VariantFieldInstanceId(id).position


pure func variant_field(
	id: VariantInstanceId,
	position: Int,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[VariantFieldInstanceId, Diagnostic]:
	layout ?= unions.get(union_number(variant_owner(id))).to_result(invalid(span, "unknown variant owner"))
	fields ?= layout.variants.get(variant_number(id)).to_result(invalid(span, "unknown variant identity"))
	valid ?= fields.get(position).to_result(invalid(span, "unknown variant field"))
	Ok(into_opaque VariantFieldInstanceId({ variant = id, position = position }))


fixed union TypeRef:
	VoidType
	IntType
	FloatType
	StringType
	ListType(TypeRef)
	RecordType(RecordInstanceId)
	UnionType(UnionInstanceId)


-- Storage ownership belongs to this compilation's concrete layouts, before
-- insertion chooses any owners or borrows. Stored slots remain in the complete
-- layouts; this classification does not replace their order or multiplicity.
fixed union ValueOwnership:
	NoOwnership
	ManagedStringLeaf
	ManagedListRoot
	ManagedRecordRoot(RecordInstanceId)
	InlineOwnedFields(UnionInstanceId)
	ManagedUnionRoot(UnionInstanceId)


-- A union naming itself as a payload has no finite inline storage, so every
-- value of it is a counted heap node and the self payload is a pointer edge.
fixed union UnionRepresentation:
	InlineUnmanaged
	InlineOwningPayload
	BoxedRecursive


fixed record ConcreteUnion {
	-- Complete storage; the summary is derived once from every child. A
	-- BoxedRecursive layout's own instance appears among its payloads.
	variants: List[List[TypeRef]],
	representation: UnionRepresentation
}


fixed record FunctionSignature {
	parameters: List[TypeRef],
	return_type: TypeRef
}


fixed union CallTarget:
	UserFunction(FunctionInstanceId)
	RuntimeFunction(RuntimeOperation[VariantInstanceId, TypeRef])


fixed record ConcreteCall {
	target: CallTarget,
	span: Span
}


private pure func primitive_ref(value_type: PrimitiveType) -> TypeRef:
	match value_type:
		BuiltinVoid:
			VoidType
		BuiltinInt:
			IntType
		BuiltinFloat:
			FloatType
		BuiltinString:
			StringType


pure func runtime_type_ref(value_type: Builtins.RuntimeType[TypeRef]) -> TypeRef:
	match value_type:
		PrimitiveRuntimeType(primitive): primitive_ref(primitive)
		ElementRuntimeType(element): element
		ListRuntimeType(element): ListType(element)


pure func runtime_signature(operation: RuntimeOperation[VariantInstanceId, TypeRef]) -> FunctionSignature:
	contract = runtime_contract(operation)

	result = match contract.return_type:
		ValueResult(value_type):
			runtime_type_ref(value_type)
		OptionalResult(_, option):
			UnionType(variant_owner(option.some))
		ResultResult(_, _, constructors):
			UnionType(variant_owner(constructors.ok))
		BooleanResult(boolean):
			UnionType(variant_owner(boolean.true_variant))

	{
		parameters = contract.parameters.map(
			pure func(parameter: Builtins.RuntimeType[TypeRef]) -> TypeRef: runtime_type_ref(parameter),
		),
		return_type = result
	}


fixed record ConcreteRecordField {
	field: FieldInstanceId,
	value: ConcreteExpr
}


fixed record RetainedRecordField { field: FieldInstanceId, value_type: TypeRef }


fixed record ConcreteRecordUpdate {
	base: ConcreteExpr,
	base_expression_span: Span,
	replacements: List[ConcreteRecordField],
	inherited: List[RetainedRecordField]
}


-- What an expression computes. A receiver is the first argument of its call, so
-- evaluation order is list order; a payload-free variant has no arguments.
fixed union ConcreteForm:
	LiteralVoid
	LiteralInteger(Int)
	LiteralFloat(Float)
	LiteralString(String)
	ReadBinding(Checked.BindingId)
	ConstructVariant(VariantInstanceId, List[ConcreteExpr])
	ConstructRecord(RecordInstanceId, List[ConcreteRecordField])
	ConstructList(List[ConcreteExpr])
	Match(ConcreteJoin)
	UpdateRecord(RecordInstanceId, ConcreteRecordUpdate)
	InvokeFunction(ConcreteCall, List[ConcreteExpr])
	ReadRecordField(ConcreteExpr, FieldInstanceId)


-- One evaluated expression. `span` is the checked node's own occurrence span,
-- carried through unchanged. A call's callee anchor is a separate fact, the span
-- of its ConcreteCall.
fixed record ConcreteExpr {
	form: ConcreteForm,
	value_type: TypeRef,
	span: Span
}


fixed union ConcreteStatement:
	InitializeBinding(Checked.BindingId, ConcreteExpr)
	ReassignBinding(Checked.BindingId, ConcreteExpr)
	DiscardExpression(ConcreteExpr)
	RunWhile(ConcreteWhile)
	RunFor(ConcreteFor)
	BreakSourceLoop(Span)
	ContinueSourceLoop(Span)


fixed record ConcreteWhile {
	condition: ConcreteExpr,
	body: List[ConcreteStatement],
	carried: List[Checked.BindingId],
	boolean: DesignatedBoolean[VariantInstanceId],
	span: Span
}


fixed union ConcreteIteration:
	ListIteration(ConcreteExpr, TypeRef, DesignatedOption[VariantInstanceId])
	AscendingIntRange(ConcreteExpr, ConcreteExpr, DesignatedBoolean[VariantInstanceId])


fixed record ConcreteFor {
	iteration: ConcreteIteration,
	item: Option[Checked.BindingId],
	body: List[ConcreteStatement],
	carried: List[Checked.BindingId],
	span: Span
}


fixed record ConcretePatternPlace {
	value_type: TypeRef,
	route: ConcretePatternRoute
}


fixed union ConcretePatternRoute:
	MatchRoot
	UnionField(ConcretePatternPlace, VariantFieldInstanceId)
	ListElement(ConcretePatternPlace, Int)


fixed union ConcretePatternArgument:
	BorrowPlace(ConcretePatternPlace)
	CopyListSuffix(ConcretePatternPlace, Int)


fixed union ConcreteDecisionNode:
	TestVariant(ConcretePatternPlace, VariantInstanceId, Checked.DecisionNodeId, Checked.DecisionNodeId)
	EnterArm(Checked.MatchArmId, List[ConcretePatternArgument])
	TestListLength(ConcretePatternPlace, Checked.ListLengthTest, Checked.DecisionNodeId, Checked.DecisionNodeId)
	TestStringBytes(ConcretePatternPlace, String, Checked.DecisionNodeId, Checked.DecisionNodeId)


fixed record ConcreteSelection {
	nodes: List[ConcreteDecisionNode],
	entry: Checked.DecisionNodeId
}


fixed record ConcreteArm {
	id: Checked.MatchArmId,
	inputs: List[Checked.BindingId],
	statements: List[ConcreteStatement],
	body: ConcreteExit
}


fixed record ConcreteMatch {
	scrutinee: ConcreteExpr,
	selection: ConcreteSelection,
	arms: List[ConcreteArm]
}


fixed union ConcreteExit:
	ReturnExpression(ConcreteExpr)
	RecurWith(List[ConcreteExpr], Span)


-- An arm of a bound or statement match, yielding `value` to the join.
fixed record ConcreteJoinArm {
	id: Checked.MatchArmId,
	inputs: List[Checked.BindingId],
	statements: List[ConcreteStatement],
	value: ConcreteExpr
}


fixed record ConcreteJoin {
	scrutinee: ConcreteExpr,
	selection: ConcreteSelection,
	arms: List[ConcreteJoinArm],
	carried: List[Checked.BindingId]
}


fixed union ConcreteBody:
	ConcreteValueBody(ConcreteExit)
	ConcreteMatchBody(ConcreteMatch)


fixed record ConcreteFunction {
	execution: FunctionExecution,
	signature: FunctionSignature,
	bindings: List[ConcreteBinding],
	statements: List[ConcreteStatement],
	body: ConcreteBody
}


fixed record SpecializedContents {
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
	functions: List[ConcreteFunction],
	entrypoint: Entrypoint[FunctionInstanceId]
}


opaque type SpecializedProgram = SpecializedContents


pure func record_number(id: RecordInstanceId) -> Int:
	from_opaque RecordInstanceId(id)


pure func field_owner(id: FieldInstanceId) -> RecordInstanceId:
	from_opaque FieldInstanceId(id).owner


pure func field_number(id: FieldInstanceId) -> Int:
	from_opaque FieldInstanceId(id).position


pure func union_number(id: UnionInstanceId) -> Int:
	from_opaque UnionInstanceId(id)


pure func variant_owner(id: VariantInstanceId) -> UnionInstanceId:
	from_opaque VariantInstanceId(id).owner


pure func variant_number(id: VariantInstanceId) -> Int:
	from_opaque VariantInstanceId(id).position


pure func same_type(left: TypeRef, right: TypeRef) -> Bool:
	match left:
		ListType(left_element):
			match right:
				ListType(right_element):
					same_type(left_element, right_element)
				_:
					False
		RecordType(left_record):
			match right:
				RecordType(right_record):
					IntOps.equals(record_number(left_record), record_number(right_record))
				_:
					False
		VoidType:
			match right:
				VoidType:
					True
				_:
					False
		IntType:
			match right:
				IntType:
					True
				_:
					False
		FloatType:
			match right:
				FloatType:
					True
				_:
					False
		StringType:
			match right:
				StringType:
					True
				_:
					False
		UnionType(left_union):
			match right:
				UnionType(right_union):
					IntOps.equals(union_number(left_union), union_number(right_union))
				_:
					False


pure func function_number(id: FunctionInstanceId) -> Int:
	from_opaque FunctionInstanceId(id)


pure func specialized_contents(program: SpecializedProgram) -> SpecializedContents:
	from_opaque SpecializedProgram(program)


fixed record ConcreteBinding {
	origin: Checked.BindingOrigin,
	value_type: TypeRef,
	span: Span
}


private fixed union CallableStorage:
	ErasedCallable
	EnvironmentCallable(RecordInstanceId)


private fixed record KnownCallable {
	parameter: Checked.CallableParameterId,
	body: Checked.BodyOwner,
	arguments: List[TypeRef],
	storage: CallableStorage
}


-- Lambda arguments substitute its genuine root parameters; callable choices stay ordered.
private fixed record InstanceKey {
	body: Checked.BodyOwner,
	arguments: List[TypeRef],
	callables: List[KnownCallable]
}


-- A declaration parameter and the type that replaces it: a concrete TypeRef
-- during translation, a PartialType while layouts are being prepared.
private fixed record TypeSubstitution[T] {
	parameter: Checked.TypeParameterId,
	value_type: T
}


private pure func invalid(span: Span, message: String) -> Diagnostic:
	{
		span = span,
		note = None,
		message = "internal specialization error: ".concat(message),
		help = "report this compiler error with the input program"
	}


private pure func missing_body(source: RequestSource, message: String) -> Diagnostic:
	span = match source:
		ConcreteRequest(span): span
		EntrypointRoot:
			{
				source = compiler_source(),
				start = 0,
				end = 0
			}
	invalid(span, message)


private pure func ownership_error(message: String) -> Diagnostic:
	{
		span = {
			source = compiler_source(),
			start = 0,
			end = 0
		},
		note = None,
		message = "internal compiler error: ".concat(message),
		help = "report this compiler error with the input program"
	}


-- Project the published storage fact, without rediscovering managed children.
-- Raw ownership verification additionally checks supplied layout consistency.
pure func value_ownership(
	type_ref: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[ValueOwnership, Diagnostic]:
	match type_ref:
		RecordType(id):
			match records.get(record_number(id)).to_result(
				ownership_error("invalid record identity in ownership representation"),
			):
				Ok(layout):
					ownership: ValueOwnership = match layout.representation:
						InlineRecord:
							NoOwnership
						ManagedRecord:
							ManagedRecordRoot(id)
					Ok(ownership)
				Err(error): Err(error)
		VoidType | IntType | FloatType:
			Ok(NoOwnership)
		StringType:
			Ok(ManagedStringLeaf)
		ListType(_):
			Ok(ManagedListRoot)
		UnionType(id):
			match unions.get(union_number(id)):
				Some(layout):
					ownership: ValueOwnership = match layout.representation:
						InlineUnmanaged:
							NoOwnership
						InlineOwningPayload:
							InlineOwnedFields(id)
						BoxedRecursive:
							ManagedUnionRoot(id)
					Ok(ownership)
				None:
					Err(ownership_error("invalid union identity in ownership representation"))


private pure func translated_list[T, U](
	values: List[T],
	translate: pure (T) -> Result[U, Diagnostic],
) -> Result[List[U], Diagnostic]:
	var translated: List[U] = []
	var failure: Option[Diagnostic] = None

	for value in values:
		match translate(value):
			Ok(translated_value):
				translated = translated.append(translated_value)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(translated)


private pure func same_record_origin(left: RecordOrigin, right: RecordOrigin) -> Bool:
	match left:
		DeclaredRecord(id):
			match right:
				DeclaredRecord(other): IntOps.equals(Declaration.record_number(id), Declaration.record_number(other))
				_: False
		CaptureEnvironment(id):
			match right:
				CaptureEnvironment(other): IntOps.equals(Checked.lambda_number(id), Checked.lambda_number(other))
				_: False


private pure func find_record_instance(
	records: List[RecordInstance],
	key: RecordKey,
) -> Option[RecordInstanceId]:
	var found: Option[RecordInstanceId] = None
	var position = 0

	for instance in records:
		if same_record_origin(instance.key.origin, key.origin):
			if same_arguments(instance.key.arguments, key.arguments):
				found = Some(into_opaque RecordInstanceId(position))
				break

		position = IntOps.add(position, 1)

	found


private pure func concrete_record_field_type(
	field: Checked.FieldId,
	owner: RecordInstanceId,
	records: List[RecordInstance],
	span: Span,
) -> Result[TypeRef, Diagnostic]:
	instance ?= records.get(record_number(owner)).to_result(invalid(span, "unknown concrete record"))
	valid: Void ?= if same_record_origin(instance.key.origin, DeclaredRecord(Checked.field_owner(field))):
		Ok(void)
	else:
		Err(invalid(span, "field declaration differs from concrete record"))
	instance.layout.fields
		.get(Checked.field_number(field))
		.to_result(invalid(span, "unknown record field"))


private pure func translate_field(
	field: Checked.FieldId,
	owner: RecordInstanceId,
	records: List[RecordInstance],
	span: Span,
) -> Result[FieldInstanceId, Diagnostic]:
	valid ?= concrete_record_field_type(field, owner, records, span)
	Ok(into_opaque FieldInstanceId({ owner = owner, position = Checked.field_number(field) }))


-- The prepared instance of a record declaration at these checked type arguments.
private pure func concrete_record(
	opaques: List[Checked.CheckedOpaque],
	declaration: Declaration.RecordId,
	arguments: List[Checked.TypeRef],
	substitution: List[TypeSubstitution[TypeRef]],
	unions: List[UnionInstance],
	span: Span,
	records: List[RecordInstance],
) -> Result[RecordInstanceId, Diagnostic]:
	concrete ?= concrete_types(opaques, arguments, substitution, unions, span, records)
	lookup_record_instance(declaration, concrete, records, span)


-- The prepared instance for a declaration at concrete type arguments.
private pure func lookup_record_instance(
	declaration: Declaration.RecordId,
	arguments: List[TypeRef],
	records: List[RecordInstance],
	span: Span,
) -> Result[RecordInstanceId, Diagnostic]:
	find_record_instance(records, { origin = DeclaredRecord(declaration), arguments = arguments }).to_result(invalid(span, "unprepared record instance"))


-- A record construction's instance: the declaration its form names, at the type
-- arguments of its checked type, which checking derived from that declaration.
private pure func record_instance(
	opaques: List[Checked.CheckedOpaque],
	declaration: Declaration.RecordId,
	value: Checked.CheckedExpr,
	substitution: List[TypeSubstitution[TypeRef]],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[RecordInstanceId, Diagnostic]:
	match value.value_type:
		Checked.RecordType(_):
			lookup_record_instance(declaration, [], records, value.span)
		Checked.AppliedRecordType(_, arguments):
			concrete_record(opaques, declaration, arguments, substitution, unions, value.span, records)
		_:
			Err(invalid(value.span, "record construction has a non-record type"))


private pure func concrete_types(
	opaques: List[Checked.CheckedOpaque],
	arguments: List[Checked.TypeRef],
	substitution: List[TypeSubstitution[TypeRef]],
	unions: List[UnionInstance],
	span: Span,
	records: List[RecordInstance],
) -> Result[List[TypeRef], Diagnostic]:
	var concrete: List[TypeRef] = []
	var failure: Option[Diagnostic] = None

	for argument in arguments:
		match concrete_type(opaques, argument, substitution, unions, span, records):
			Ok(value):
				concrete = concrete.append(value)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(concrete)


private pure func concrete_type(
	opaques: List[Checked.CheckedOpaque],
	value_type: Checked.TypeRef,
	substitution: List[TypeSubstitution[TypeRef]],
	unions: List[UnionInstance],
	span: Span,
	records: List[RecordInstance],
) -> Result[TypeRef, Diagnostic]:
	match value_type:
		Checked.OpaqueType(id):
			match opaques.get(Declaration.opaque_number(id)):
				Some(declaration): concrete_type(opaques, declaration.underlying_type.value_type, [], unions, span, records)
				None: Err(invalid(span, "unknown opaque declaration"))
		Checked.PureCallableType(_, _):
			Err(invalid(span, "callable type reached a data layout"))
		Checked.RecordType(id):
			-- A non-generic record has no arguments to translate.
			match lookup_record_instance(id, [], records, span):
				Ok(owner): Ok(RecordType(owner))
				Err(error): Err(error)
		Checked.VoidType:
			Ok(VoidType)
		Checked.IntType:
			Ok(IntType)
		Checked.FloatType:
			Ok(FloatType)
		Checked.StringType:
			Ok(StringType)
		Checked.ListType(element):
			match concrete_type(opaques, element, substitution, unions, span, records):
				Ok(concrete): Ok(ListType(concrete))
				Err(error): Err(error)
		Checked.AppliedRecordType(id, arguments):
			match concrete_record(opaques, id, arguments, substitution, unions, span, records):
				Ok(owner): Ok(RecordType(owner))
				Err(error): Err(error)
		Checked.AppliedUnionType(id, arguments):
			match concrete_types(opaques, arguments, substitution, unions, span, records):
				Ok(concrete_arguments):
					match find_union_instance(
						unions,
						{
							declaration = id,
							arguments = concrete_arguments
						},
					).to_result(invalid(span, "unprepared generic union instance")):
						Ok(union_id): Ok(UnionType(union_id))
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.UnionType(id):
			match find_union_instance(
				unions,
				{
					declaration = id,
					arguments = []
				},
			).to_result(invalid(span, "unprepared ordinary union instance")):
				Ok(union_id): Ok(UnionType(union_id))
				Err(error): Err(error)
		Checked.ParameterType(id):
			var replacement: Option[TypeRef] = None

			for argument in substitution:
				if Checked.same_parameter(id, argument.parameter):
					-- A supplied concrete replacement is terminal.
					replacement = Some(argument.value_type)
					break

			match replacement:
				Some(value):
					Ok(value)
				None:
					Err(invalid(span, "unresolved or foreign type parameter"))


private pure func same_arguments(left: List[TypeRef], right: List[TypeRef]) -> Bool:
	var matches = IntOps.equals(left.length(), right.length())
	var position: Int = 0

	for value in left:
		match right.get(position):
			Some(other):
				matches = match matches:
					True: same_type(value, other)
					False: False
			None:
				matches = False

		if matches.not():
			break

		position = IntOps.add(position, 1)

	matches


private pure func find_instance(
	keys: List[FunctionRequest],
	key: InstanceKey,
) -> Option[FunctionInstanceId]:
	var found: Option[FunctionInstanceId] = None
	var position: Int = 0

	for known in keys:
		matches_key = match Checked.same_body(known.key.body, key.body):
			True:
				match same_arguments(known.key.arguments, key.arguments):
					True: same_callables(known.key.callables, key.callables)
					False: False
			False: False

		if matches_key:
			found = Some(into_opaque FunctionInstanceId(position))
			break

		position = IntOps.add(position, 1)

	found


private pure func same_callable_storage(left: CallableStorage, right: CallableStorage) -> Bool:
	match left:
		ErasedCallable:
			match right:
				ErasedCallable: True
				_: False
		EnvironmentCallable(id):
			match right:
				EnvironmentCallable(other): IntOps.equals(record_number(id), record_number(other))
				_: False


private pure func same_callables(left: List[KnownCallable], right: List[KnownCallable]) -> Bool:
	var matches = IntOps.equals(left.length(), right.length())
	var position = 0
	for value in left:
		match right.get(position):
			Some(other):
				matches = match matches:
					False: False
					True:
						match and(Checked.same_callable_parameter(value.parameter, other.parameter), Checked.same_body(value.body, other.body)):
							True: same_arguments(value.arguments, other.arguments)
							False: False
				if matches:
					matches = same_callable_storage(value.storage, other.storage)
			None: matches = False
		if matches.not():
			break
		position = IntOps.add(position, 1)
	matches


private pure func callable_choice(
	choices: List[KnownCallable],
	parameter: Checked.CallableParameterId,
	span: Span,
) -> Result[KnownCallable, Diagnostic]:
	var found: Option[KnownCallable] = None
	for choice in choices:
		if Checked.same_callable_parameter(choice.parameter, parameter):
			found = Some(choice)
			break
	found.to_result(invalid(span, "missing concrete callable parameter choice"))


private pure func parameter_substitution[T](
	parameters: List[Checked.TypeParameterId],
	arguments: List[T],
	owner: Checked.TypeParameterOwner,
	span: Span,
) -> Result[List[TypeSubstitution[T]], Diagnostic]:
	var substitution: List[TypeSubstitution[T]] = []
	var failure: Option[Diagnostic] = None
	var position: Int = 0

	if IntOps.equals(parameters.length(), arguments.length()).not():
		Err(invalid(span, "type argument count differs from the declaration"))
	else:
		for parameter in parameters:
			owner_matches = match Checked.parameter_owner(parameter):
				Checked.FunctionDeclaration(id):
					match owner:
						Checked.FunctionDeclaration(expected):
							IntOps.equals(
								Declaration.function_number(id),
								Declaration.function_number(expected),
							)
						_:
							False
				Checked.RecordDeclaration(id):
					match owner:
						Checked.RecordDeclaration(expected):
							IntOps.equals(
								Declaration.record_number(id),
								Declaration.record_number(expected),
							)
						_:
							False
				Checked.UnionDeclaration(id):
					match owner:
						Checked.UnionDeclaration(expected):
							IntOps.equals(
								Declaration.union_number(id),
								Declaration.union_number(expected),
							)
						_:
							False

			if or(
				owner_matches.not(),
				IntOps.equals( Checked.parameter_position(parameter), position, ).not(),
			):
				failure = Some(invalid(span, "invalid declaration type parameter"))
				break

			match arguments.get(position):
				Some(value):
					substitution = substitution.append({
						parameter = parameter,
						value_type = value,
					})
				None:
					failure = Some(invalid(span, "missing concrete type argument"))
					break

			position = IntOps.add(position, 1)

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(substitution)


private fixed record UnionKey {
	declaration: Declaration.UnionId,
	arguments: List[TypeRef]
}


private fixed record UnionInstance {
	key: UnionKey,
	layout: ConcreteUnion
}


-- A type named while a layout on the current path is still being built. A
-- pending reference carries the in-progress layout's key; it is resolved to
-- that layout's identity when the layout completes. A reader of a pending
-- reference needs only its ownership class, which membership in a recursive
-- layout group fixes: a pending union is owning, a pending record managed.
private fixed union PartialType:
	KnownType(TypeRef)
	PendingUnionType(PartialUnionKey)
	PendingRecordType(PartialRecordKey)
	PendingListType(PartialType)


private fixed record PartialUnionKey {
	declaration: Declaration.UnionId,
	arguments: List[PartialType]
}


private fixed record PartialRecordKey {
	origin: RecordOrigin,
	arguments: List[PartialType]
}


-- A layout slot of the local builder. A pending slot already has its identity
-- (its index) and representation; only references to layouts that were still
-- in progress when it completed remain unresolved, and every one of them is
-- filled when that layout completes. Sealing accepts complete slots only.
private fixed union UnionSlot:
	CompleteUnion(UnionInstance)
	PendingUnion(PendingUnionInstance)


private fixed record PendingUnionInstance {
	key: PartialUnionKey,
	variants: List[List[PartialType]],
	representation: UnionRepresentation
}


private fixed union RecordSlot:
	CompleteRecord(RecordInstance)
	PendingRecord(PendingRecordInstance)


private fixed record PendingRecordInstance {
	key: PartialRecordKey,
	fields: List[PartialType],
	representation: RecordRepresentation
}


-- The layouts whose children are being prepared, innermost last, each
-- marked once a child refers back to it.
private fixed union InProgressLayout:
	InProgressUnion(PartialUnionKey, BackReference)
	InProgressRecord(PartialRecordKey, BackReference)


-- Whether a child prepared under an in-progress layout referred back to it,
-- leaving pending references that its completion fills. A layout no child
-- referred back to completes without revisiting any slot.
private fixed union BackReference:
	NotReferencedBack
	ReferencedBack


private fixed union RequestSource:
	EntrypointRoot
	ConcreteRequest(Span)


private fixed record FunctionRequest {
	key: InstanceKey,
	source: RequestSource
}


private fixed record PreparedType {
	value_type: PartialType,
	unions: List[UnionSlot],
	records: List[RecordSlot],
	in_progress: List[InProgressLayout]
}


private fixed record PreparedInstances {
	functions: List[FunctionRequest],
	unions: List[UnionSlot],
	records: List[RecordSlot]
}


-- The builder after sealing: every layout complete, read by translation.
private fixed record SealedInstances {
	functions: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance]
}


private pure func contains_parameter(value: Checked.TypeRef) -> Bool:
	match value:
		Checked.PureCallableType(parameters, result):
			match parameters.any(contains_parameter):
				True: True
				False: contains_parameter(result)
		Checked.ListType(element):
			contains_parameter(element)
		Checked.ParameterType(_):
			True
		Checked.AppliedRecordType(_, arguments):
			var found: Bool = False

			for argument in arguments:
				if contains_parameter(argument):
					found = True
					break

			found
		Checked.AppliedUnionType(_, arguments):
			var found: Bool = False

			for argument in arguments:
				if contains_parameter(argument):
					found = True
					break

			found
		_:
			False


private pure func request_span(
	depends_on_caller: Bool,
	source: RequestSource,
	fallback: Span,
) -> Span:
	match source:
		ConcreteRequest(span):
			if depends_on_caller:
				span
			else:
				fallback
		EntrypointRoot:
			fallback


-- The sealed instance for a key, read by translation.
private pure func find_union_instance(
	keys: List[UnionInstance],
	key: UnionKey,
) -> Option[UnionInstanceId]:
	var found: Option[UnionInstanceId] = None
	var position: Int = 0

	for known in keys:
		matches_key = match IntOps.equals(
			Declaration.union_number(known.key.declaration),
			Declaration.union_number(key.declaration),
		):
			True: same_arguments(known.key.arguments, key.arguments)
			False: False

		if matches_key:
			found = Some(into_opaque UnionInstanceId(position))
			break

		position = IntOps.add(position, 1)

	found


private pure func same_partial_type(left: PartialType, right: PartialType) -> Bool:
	match left:
		KnownType(known):
			match right:
				KnownType(other): same_type(known, other)
				_: False
		PendingUnionType(key):
			match right:
				PendingUnionType(other): same_partial_union_key(key, other)
				_: False
		PendingRecordType(key):
			match right:
				PendingRecordType(other): same_partial_record_key(key, other)
				_: False
		PendingListType(element):
			match right:
				PendingListType(other): same_partial_type(element, other)
				_: False


private pure func same_partial_arguments(left: List[PartialType], right: List[PartialType]) -> Bool:
	var matches = IntOps.equals(left.length(), right.length())
	var position: Int = 0

	for value in left:
		if matches:
			match right.get(position):
				Some(other): matches = same_partial_type(value, other)
				None: matches = False

		position = IntOps.add(position, 1)

	matches


private pure func same_partial_union_key(left: PartialUnionKey, right: PartialUnionKey) -> Bool:
	match IntOps.equals(Declaration.union_number(left.declaration), Declaration.union_number(right.declaration)):
		True: same_partial_arguments(left.arguments, right.arguments)
		False: False


private pure func same_partial_record_key(left: PartialRecordKey, right: PartialRecordKey) -> Bool:
	match same_record_origin(left.origin, right.origin):
		True: same_partial_arguments(left.arguments, right.arguments)
		False: False


private pure func known_arguments(arguments: List[TypeRef]) -> List[PartialType]:
	var partial: List[PartialType] = []

	for argument in arguments:
		partial = partial.append(KnownType(argument))

	partial


-- A complete key's known arguments compared against a request's partial
-- ones in place, so a lookup allocates nothing.
private pure func same_known_arguments(known: List[TypeRef], partial: List[PartialType]) -> Bool:
	var matches = IntOps.equals(known.length(), partial.length())
	var position: Int = 0

	for value in known:
		if matches:
			match partial.get(position):
				Some(KnownType(other)): matches = same_type(value, other)
				_: matches = False

		position = IntOps.add(position, 1)

	matches


private pure func slot_has_union_key(slot: UnionSlot, key: PartialUnionKey) -> Bool:
	match slot:
		CompleteUnion(instance):
			match IntOps.equals(Declaration.union_number(instance.key.declaration), Declaration.union_number(key.declaration)):
				True: same_known_arguments(instance.key.arguments, key.arguments)
				False: False
		PendingUnion(instance):
			same_partial_union_key(instance.key, key)


private pure func slot_has_record_key(slot: RecordSlot, key: PartialRecordKey) -> Bool:
	match slot:
		CompleteRecord(instance):
			match same_record_origin(instance.key.origin, key.origin):
				True: same_known_arguments(instance.key.arguments, key.arguments)
				False: False
		PendingRecord(instance):
			same_partial_record_key(instance.key, key)


private pure func slot_union_representation(slot: UnionSlot) -> UnionRepresentation:
	match slot:
		CompleteUnion(instance): instance.layout.representation
		PendingUnion(instance): instance.representation


private pure func slot_record_representation(slot: RecordSlot) -> RecordRepresentation:
	match slot:
		CompleteRecord(instance): instance.layout.representation
		PendingRecord(instance): instance.representation


private pure func find_union_slot(slots: List[UnionSlot], key: PartialUnionKey) -> Option[UnionInstanceId]:
	var found: Option[UnionInstanceId] = None
	var position: Int = 0

	for slot in slots:
		if slot_has_union_key(slot, key):
			found = Some(into_opaque UnionInstanceId(position))
			break

		position = IntOps.add(position, 1)

	found


private pure func find_record_slot(slots: List[RecordSlot], key: PartialRecordKey) -> Option[RecordInstanceId]:
	var found: Option[RecordInstanceId] = None
	var position: Int = 0

	for slot in slots:
		if slot_has_record_key(slot, key):
			found = Some(into_opaque RecordInstanceId(position))
			break

		position = IntOps.add(position, 1)

	found


-- The in-progress layouts with this union marked as referred back to, if
-- it is on the current path.
private pure func refer_back_to_union(layouts: List[InProgressLayout], key: PartialUnionKey) -> Option[List[InProgressLayout]]:
	var found: Option[List[InProgressLayout]] = None
	var position = 0

	for layout in layouts:
		match layout:
			InProgressUnion(other, _):
				if same_partial_union_key(other, key):
					found = Some(layouts.set(position, InProgressUnion(other, ReferencedBack)))
					break
			InProgressRecord(_, _):
				void

		position = IntOps.add(position, 1)

	found


private pure func refer_back_to_record(layouts: List[InProgressLayout], key: PartialRecordKey) -> Option[List[InProgressLayout]]:
	var found: Option[List[InProgressLayout]] = None
	var position = 0

	for layout in layouts:
		match layout:
			InProgressRecord(other, _):
				if same_partial_record_key(other, key):
					found = Some(layouts.set(position, InProgressRecord(other, ReferencedBack)))
					break
			InProgressUnion(_, _):
				void

		position = IntOps.add(position, 1)

	found


private fixed record LeftLayout {
	remaining: List[InProgressLayout],
	back_reference: BackReference
}


-- Pops the innermost in-progress layout once its slot is published.
private pure func leave_layout(layouts: List[InProgressLayout], span: Span) -> Result[LeftLayout, Diagnostic]:
	last = IntOps.subtract(layouts.length(), 1)
	innermost ?= layouts.get(last).to_result(invalid(span, "layout completed outside its own preparation"))
	remaining ?= layouts.remove(last).to_result(invalid(span, "layout completed outside its own preparation"))
	back_reference = match innermost:
		InProgressUnion(_, marked): marked
		InProgressRecord(_, marked): marked
	Ok({ remaining = remaining, back_reference = back_reference })


-- A List of a known element is itself known.
private pure func partial_list(element: PartialType) -> PartialType:
	match element:
		KnownType(known): KnownType(ListType(known))
		_: PendingListType(element)


private pure func has_pending(value: PartialType) -> Bool:
	match value:
		KnownType(_): False
		PendingUnionType(key): True
		PendingRecordType(key): True
		PendingListType(element): has_pending(element)


private pure func any_pending(values: List[PartialType]) -> Bool:
	var found: Bool = False

	for value in values:
		if has_pending(value):
			found = True
			break

	found


-- The layout that just completed, whose pending references now resolve.
private fixed union CompletedLayout:
	CompletedUnion(PartialUnionKey, UnionInstanceId)
	CompletedRecord(PartialRecordKey, RecordInstanceId)


private pure func resolve_partial(value: PartialType, completed: CompletedLayout) -> PartialType:
	match value:
		KnownType(_):
			value
		PendingUnionType(key):
			match completed:
				CompletedUnion(done, id):
					if same_partial_union_key(key, done):
						KnownType(UnionType(id))
					else:
						PendingUnionType({ key | arguments = resolve_partials(key.arguments, completed) })
				CompletedRecord(_, _):
					PendingUnionType({ key | arguments = resolve_partials(key.arguments, completed) })
		PendingRecordType(key):
			match completed:
				CompletedRecord(done, id):
					if same_partial_record_key(key, done):
						KnownType(RecordType(id))
					else:
						PendingRecordType({ key | arguments = resolve_partials(key.arguments, completed) })
				CompletedUnion(_, _):
					PendingRecordType({ key | arguments = resolve_partials(key.arguments, completed) })
		PendingListType(element):
			partial_list(resolve_partial(element, completed))


private pure func resolve_partials(values: List[PartialType], completed: CompletedLayout) -> List[PartialType]:
	var resolved: List[PartialType] = []

	for value in values:
		resolved = resolved.append(resolve_partial(value, completed))

	resolved


private pure func known_type(value: PartialType, span: Span) -> Result[TypeRef, Diagnostic]:
	match value:
		KnownType(known): Ok(known)
		_: Err(invalid(span, "layout reference left unresolved after its group completed"))


private pure func known_types(values: List[PartialType], span: Span) -> Result[List[TypeRef], Diagnostic]:
	var known: List[TypeRef] = []
	var failure: Option[Diagnostic] = None

	for value in values:
		match known_type(value, span):
			Ok(resolved): known = known.append(resolved)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error): Err(error)
		None: Ok(known)


-- A pending union instance with no reference left becomes complete.
private pure func settle_union(instance: PendingUnionInstance, span: Span) -> Result[UnionSlot, Diagnostic]:
	var pending = any_pending(instance.key.arguments)

	for fields in instance.variants:
		pending = match pending:
			True: True
			False: any_pending(fields)

	if pending:
		Ok(PendingUnion(instance))
	else:
		match known_types(instance.key.arguments, span):
			Ok(arguments):
				var variants: List[List[TypeRef]] = []
				var failure: Option[Diagnostic] = None

				for fields in instance.variants:
					match known_types(fields, span):
						Ok(known): variants = variants.append(known)
						Err(error):
							failure = Some(error)
							break

				match failure:
					Some(error):
						Err(error)
					None:
						Ok(CompleteUnion({
							key = { declaration = instance.key.declaration, arguments = arguments },
							layout = { variants = variants, representation = instance.representation },
						}))
			Err(error): Err(error)


private pure func settle_record(instance: PendingRecordInstance, span: Span) -> Result[RecordSlot, Diagnostic]:
	pending: Bool = match any_pending(instance.key.arguments):
		True: True
		False: any_pending(instance.fields)
	if pending:
		Ok(PendingRecord(instance))
	else:
		match known_types(instance.key.arguments, span):
			Ok(arguments):
				match known_types(instance.fields, span):
					Ok(fields):
						Ok(CompleteRecord({
							key = { origin = instance.key.origin, arguments = arguments },
							layout = { fields = fields, representation = instance.representation },
						}))
					Err(error): Err(error)
			Err(error): Err(error)


-- Fills every reference to a completed layout that a child referred back
-- to. Only slots published while it was in progress, from `first` on, can
-- hold such a reference, so earlier slots are not revisited.
private pure func resolve_union_slots(
	slots: List[UnionSlot],
	first: Int,
	completed: CompletedLayout,
	span: Span,
) -> Result[List[UnionSlot], Diagnostic]:
	var resolved = slots
	var position = first
	var failure: Option[Diagnostic] = None

	while and(IntOps.less_than(position, resolved.length()), failure.is_some().not()):
		match resolved.get(position):
			Some(PendingUnion(instance)):
				filled: PendingUnionInstance = {
					key = { instance.key | arguments = resolve_partials(instance.key.arguments, completed) },
					variants = resolve_variants(instance.variants, completed),
					representation = instance.representation,
				}
				match settle_union(filled, span):
					Ok(slot): resolved = resolved.set(position, slot)
					Err(error): failure = Some(error)
			Some(CompleteUnion(_)):
				void
			None:
				failure = Some(invalid(span, "union slot left its builder"))

		position = IntOps.add(position, 1)

	match failure:
		Some(error): Err(error)
		None: Ok(resolved)


private pure func resolve_variants(variants: List[List[PartialType]], completed: CompletedLayout) -> List[List[PartialType]]:
	var resolved: List[List[PartialType]] = []

	for fields in variants:
		resolved = resolved.append(resolve_partials(fields, completed))

	resolved


private pure func resolve_record_slots(
	slots: List[RecordSlot],
	first: Int,
	completed: CompletedLayout,
	span: Span,
) -> Result[List[RecordSlot], Diagnostic]:
	var resolved = slots
	var position = first
	var failure: Option[Diagnostic] = None

	while and(IntOps.less_than(position, resolved.length()), failure.is_some().not()):
		match resolved.get(position):
			Some(PendingRecord(instance)):
				filled: PendingRecordInstance = {
					key = { instance.key | arguments = resolve_partials(instance.key.arguments, completed) },
					fields = resolve_partials(instance.fields, completed),
					representation = instance.representation,
				}
				match settle_record(filled, span):
					Ok(slot): resolved = resolved.set(position, slot)
					Err(error): failure = Some(error)
			Some(CompleteRecord(_)):
				void
			None:
				failure = Some(invalid(span, "record slot left its builder"))

		position = IntOps.add(position, 1)

	match failure:
		Some(error): Err(error)
		None: Ok(resolved)


-- Whether a prepared payload owns managed storage: a managed record, an
-- owning or boxed union, a String, a List, or any layout still in progress.
private pure func payload_owns_children(
	payload: PartialType,
	unions: List[UnionSlot],
	records: List[RecordSlot],
	span: Span,
) -> Result[Bool, Diagnostic]:
	match payload:
		PendingUnionType(_) | PendingRecordType(_) | PendingListType(_):
			Ok(True)
		KnownType(known):
			match known:
				VoidType | IntType | FloatType:
					Ok(False)
				StringType | ListType(_):
					Ok(True)
				RecordType(child):
					match records.get(record_number(child)):
						None:
							Err(invalid(span, "missing concrete record child layout"))
						Some(slot):
							owns_children: Bool = match slot_record_representation(slot):
								ManagedRecord: True
								InlineRecord: False
							Ok(owns_children)
				UnionType(child):
					match unions.get(union_number(child)):
						None:
							Err(invalid(span, "missing concrete child layout"))
						Some(slot):
							owns_children: Bool = match slot_union_representation(slot):
								InlineOwningPayload | BoxedRecursive: True
								InlineUnmanaged: False
							Ok(owns_children)


private pure func ensure_union(
	key: PartialUnionKey,
	checked: Checked.CheckedFunctions,
	unions: List[UnionSlot],
	span: Span,
	records: List[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	match find_union_slot(unions, key):
		Some(id):
			Ok({ value_type = KnownType(UnionType(id)), unions = unions, records = records, in_progress = in_progress })
		None:
			match refer_back_to_union(in_progress, key):
				Some(marked):
					-- A reference back into a layout on the current path.
					Ok({ value_type = PendingUnionType(key), unions = unions, records = records, in_progress = marked })
				None:
					prepare_union(key, checked, unions, span, records, in_progress)


private pure func prepare_union(
	key: PartialUnionKey,
	checked: Checked.CheckedFunctions,
	unions: List[UnionSlot],
	span: Span,
	records: List[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	declaration ?= checked.unions
		.get(Declaration.union_number(key.declaration))
		.to_result(invalid(span, "unknown union declaration"))
	substitution ?= parameter_substitution(
		declaration.type_parameters,
		key.arguments,
		Checked.UnionDeclaration(key.declaration),
		span,
	)
	var dependencies = unions
	var record_dependencies = records
	var layouts: List[InProgressLayout] = in_progress.append(InProgressUnion(key, NotReferencedBack))
	var variants: List[List[PartialType]] = []
	var owning: Bool = False
	var self_referencing: Bool = False
	var failure: Option[Diagnostic] = None

	for variant in declaration.variants:
		var fields: List[PartialType] = []
		for written in variant.fields:
			match prepare_type(written.value_type, substitution, checked, dependencies, written.span, record_dependencies, layouts):
				Err(error):
					failure = Some(error)
					break
				Ok(prepared):
					dependencies = prepared.unions
					record_dependencies = prepared.records
					layouts = prepared.in_progress
					fields = fields.append(prepared.value_type)
					-- The union's own direct payload is the boxed unary shape.
					match prepared.value_type:
						PendingUnionType(other):
							if same_partial_union_key(other, key):
								self_referencing = True
						_:
							void
					match payload_owns_children(prepared.value_type, dependencies, record_dependencies, span):
						Ok(owns): owning = or(owning, owns)
						Err(error):
							failure = Some(error)
							break
		if failure.is_some():
			break
		variants = variants.append(fields)

	ready: Void ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	-- A self-referencing union is boxed whatever else it stores; the
	-- box owns every payload. Otherwise an owning child makes it owning.
	representation: UnionRepresentation = if self_referencing:
		BoxedRecursive
	else if owning:
		InlineOwningPayload
	else:
		InlineUnmanaged

	-- Children complete before their parent, so the parent takes the
	-- next identity; only references back to layouts still on the
	-- path, including its own direct self payload, remain to fill.
	id: UnionInstanceId = into_opaque UnionInstanceId(dependencies.length())
	slot ?= settle_union({ key = key, variants = variants, representation = representation }, span)
	published = dependencies.append(slot)
	left ?= leave_layout(layouts, span)
	match left.back_reference:
		NotReferencedBack:
			Ok({ value_type = KnownType(UnionType(id)), unions = published, records = record_dependencies, in_progress = left.remaining })
		ReferencedBack:
			completed: CompletedLayout = CompletedUnion(key, id)
			match resolve_union_slots(published, unions.length(), completed, span):
				Ok(resolved_unions):
					match resolve_record_slots(record_dependencies, records.length(), completed, span):
						Ok(resolved_records):
							Ok({
								value_type = KnownType(UnionType(id)),
								unions = resolved_unions,
								records = resolved_records,
								in_progress = left.remaining,
							})
						Err(error): Err(error)
				Err(error): Err(error)


-- Whether a prepared field keeps its record inline: a number, or a record
-- whose own layout is inline.
private pure func inline_record_field(field: PartialType, records: List[RecordSlot]) -> Result[Bool, Diagnostic]:
	match field:
		KnownType(IntType) | KnownType(FloatType):
			Ok(True)
		KnownType(RecordType(child)):
			match records.get(record_number(child)):
				None:
					Err(invalid({
									source = compiler_source(),
									start = 0,
									end = 0
								}, "missing concrete record child layout"))
				Some(slot):
					is_inline: Bool = match slot_record_representation(slot):
						InlineRecord: True
						ManagedRecord: False
					Ok(is_inline)
		_:
			Ok(False)


private pure func ensure_record(
	key: PartialRecordKey,
	checked: Checked.CheckedFunctions,
	unions: List[UnionSlot],
	span: Span,
	records: List[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	match find_record_slot(records, key):
		Some(instance):
			Ok({ value_type = KnownType(RecordType(instance)), unions = unions, records = records, in_progress = in_progress })
		None:
			match refer_back_to_record(in_progress, key):
				Some(marked):
					Ok({ value_type = PendingRecordType(key), unions = unions, records = records, in_progress = marked })
				None:
					prepare_record(key, checked, unions, span, records, in_progress)


private fixed union RecordStoragePolicy:
	InlineEligible
	AlwaysManaged


private fixed record SelectedRecord {
	type_parameters: List[Checked.TypeParameterId],
	parameter_owner: Checked.TypeParameterOwner,
	fields: List[Checked.TypeUse],
	storage: RecordStoragePolicy
}


private pure func selected_record(
	origin: RecordOrigin,
	checked: Checked.CheckedFunctions,
	span: Span,
) -> Result[SelectedRecord, Diagnostic]:
	match origin:
		DeclaredRecord(id):
			match checked.records.get(Declaration.record_number(id)):
				None: Err(invalid(span, "unknown record declaration"))
				Some(declaration): Ok({
					type_parameters = declaration.type_parameters,
					parameter_owner = Checked.RecordDeclaration(id),
					fields = declaration.fields.map(pure func(field): field.value_type),
					storage = InlineEligible
				})
		CaptureEnvironment(id):
			match checked.lambdas.get(Checked.lambda_number(id)):
				None: Err(invalid(span, "unknown capture environment lambda"))
				Some(lambda):
					match checked.functions.get(Declaration.function_number(lambda.root)):
						None: Err(invalid(span, "unknown capture environment root"))
						Some(root): Ok({
							type_parameters = root.signature.type_parameters,
							parameter_owner = Checked.FunctionDeclaration(lambda.root),
							fields = lambda.captures.map(pure func(capture): capture.value_type),
							storage = AlwaysManaged
						})


private pure func prepare_record(
	key: PartialRecordKey,
	checked: Checked.CheckedFunctions,
	unions: List[UnionSlot],
	span: Span,
	records: List[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	declaration ?= selected_record(key.origin, checked, span)
	substitution ?= parameter_substitution(declaration.type_parameters, key.arguments, declaration.parameter_owner, span)
	var fields: List[PartialType] = []
	var dependencies = unions
	var record_dependencies = records
	var layouts: List[InProgressLayout] = in_progress.append(InProgressRecord(key, NotReferencedBack))
	var managed: Bool = match declaration.storage:
		InlineEligible: False
		AlwaysManaged: True
	var found_error: Option[Diagnostic] = None

	for field in declaration.fields:
		match prepare_type(field.value_type, substitution, checked, dependencies, field.span, record_dependencies, layouts):
			Err(failure):
				found_error = Some(failure)
				break
			Ok(prepared):
				dependencies = prepared.unions
				record_dependencies = prepared.records
				layouts = prepared.in_progress
				fields = fields.append(prepared.value_type)
				-- Only numbers and inline records keep a record inline;
				-- every other field, including a layout still in
				-- progress, needs a counted root.
				match inline_record_field(prepared.value_type, record_dependencies):
					Ok(inline):
						if inline.not():
							managed = True
					Err(failure):
						found_error = Some(failure)
						break

	ready: Void ?= match found_error:
		Some(failure):
			Err(failure)
		None:
			Ok(void)

	representation: RecordRepresentation = if managed:
		ManagedRecord
	else:
		InlineRecord
	instance: RecordInstanceId = into_opaque RecordInstanceId(record_dependencies.length())
	slot ?= settle_record({ key = key, fields = fields, representation = representation }, span)
	published = record_dependencies.append(slot)
	left ?= leave_layout(layouts, span)
	match left.back_reference:
		NotReferencedBack:
			Ok({ value_type = KnownType(RecordType(instance)), unions = dependencies, records = published, in_progress = left.remaining })
		ReferencedBack:
			completed: CompletedLayout = CompletedRecord(key, instance)
			match resolve_union_slots(dependencies, unions.length(), completed, span):
				Ok(resolved_unions):
					match resolve_record_slots(published, records.length(), completed, span):
						Ok(resolved_records):
							Ok({
								value_type = KnownType(RecordType(instance)),
								unions = resolved_unions,
								records = resolved_records,
								in_progress = left.remaining,
							})
						Err(error): Err(error)
				Err(error): Err(error)


private pure func prepare_arguments(
	arguments: List[Checked.TypeRef],
	substitution: List[TypeSubstitution[PartialType]],
	checked: Checked.CheckedFunctions,
	unions: List[UnionSlot],
	span: Span,
	records: List[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedArguments, Diagnostic]:
	var types: List[PartialType] = []
	var dependencies = unions
	var record_dependencies = records
	var layouts = in_progress
	var failure: Option[Diagnostic] = None

	for argument in arguments:
		match prepare_type(argument, substitution, checked, dependencies, span, record_dependencies, layouts):
			Ok(prepared):
				types = types.append(prepared.value_type)
				dependencies = prepared.unions
				record_dependencies = prepared.records
				layouts = prepared.in_progress
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error): Err(error)
		None: Ok({ arguments = types, unions = dependencies, records = record_dependencies, in_progress = layouts })


private fixed record PreparedArguments {
	arguments: List[PartialType],
	unions: List[UnionSlot],
	records: List[RecordSlot],
	in_progress: List[InProgressLayout]
}


private pure func prepare_type(
	value: Checked.TypeRef,
	substitution: List[TypeSubstitution[PartialType]],
	checked: Checked.CheckedFunctions,
	unions: List[UnionSlot],
	span: Span,
	records: List[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	match value:
		Checked.OpaqueType(id):
			match checked.opaques.get(Declaration.opaque_number(id)):
				Some(declaration): prepare_type(declaration.underlying_type.value_type, [], checked, unions, span, records, in_progress)
				None: Err(invalid(span, "unknown opaque declaration"))
		Checked.PureCallableType(_, _):
			Err(invalid(span, "callable type reached a data layout"))
		Checked.VoidType:
			Ok({ value_type = KnownType(VoidType), unions = unions, records = records, in_progress = in_progress })
		Checked.IntType:
			Ok({ value_type = KnownType(IntType), unions = unions, records = records, in_progress = in_progress })
		Checked.FloatType:
			Ok({ value_type = KnownType(FloatType), unions = unions, records = records, in_progress = in_progress })
		Checked.StringType:
			Ok({ value_type = KnownType(StringType), unions = unions, records = records, in_progress = in_progress })
		Checked.ParameterType(id):
			var replacement: Option[PartialType] = None

			for argument in substitution:
				if Checked.same_parameter(id, argument.parameter):
					-- A supplied replacement is terminal.
					replacement = Some(argument.value_type)
					break

			match replacement:
				Some(replaced):
					Ok({ value_type = replaced, unions = unions, records = records, in_progress = in_progress })
				None:
					Err(invalid(span, "unresolved or foreign type parameter"))
		Checked.ListType(element):
			match prepare_type(element, substitution, checked, unions, span, records, in_progress):
				Ok(prepared): Ok({ prepared | value_type = partial_list(prepared.value_type) })
				Err(error): Err(error)
		Checked.RecordType(id):
			ensure_record({ origin = DeclaredRecord(id), arguments = [] }, checked, unions, span, records, in_progress)
		Checked.UnionType(id):
			ensure_union({ declaration = id, arguments = [] }, checked, unions, span, records, in_progress)
		Checked.AppliedRecordType(id, arguments):
			match prepare_arguments(arguments, substitution, checked, unions, span, records, in_progress):
				Ok(prepared): ensure_record({ origin = DeclaredRecord(id), arguments = prepared.arguments }, checked, prepared.unions, span, prepared.records, prepared.in_progress)
				Err(error): Err(error)
		Checked.AppliedUnionType(id, arguments):
			match prepare_arguments(arguments, substitution, checked, unions, span, records, in_progress):
				Ok(prepared): ensure_union({ declaration = id, arguments = prepared.arguments }, checked, prepared.unions, span, prepared.records, prepared.in_progress)
				Err(error): Err(error)


-- Every slot is complete once no layout is in progress; sealing projects the
-- builder into the immutable instance list the translation phase reads.
private pure func seal_unions(slots: List[UnionSlot]) -> Result[List[UnionInstance], Diagnostic]:
	var instances: List[UnionInstance] = []
	var failure: Option[Diagnostic] = None

	for slot in slots:
		match slot:
			CompleteUnion(instance):
				instances = instances.append(instance)
			PendingUnion(_):
				failure = Some(invalid({
									source = compiler_source(),
									start = 0,
									end = 0
								}, "union layout sealed while still pending"))
				break

	match failure:
		Some(error): Err(error)
		None: Ok(instances)


private pure func seal_records(slots: List[RecordSlot]) -> Result[List[RecordInstance], Diagnostic]:
	var instances: List[RecordInstance] = []
	var failure: Option[Diagnostic] = None

	for slot in slots:
		match slot:
			CompleteRecord(instance):
				instances = instances.append(instance)
			PendingRecord(_):
				failure = Some(invalid({
							source = compiler_source(),
							start = 0,
							end = 0
						}, "record layout sealed while still pending"))
				break

	match failure:
		Some(error): Err(error)
		None: Ok(instances)


private pure func value_types(value: Checked.CheckedExpr) -> List[Checked.TypeUse]:
	append_value_types([], value)


-- A call's callee anchor locates its type errors; any other node's own span does.
private pure func anchor(value: Checked.CheckedExpr) -> Span:
	match value.form:
		Checked.InvokeFunction(call, _):
			call.span
		_:
			value.span


-- A node's type precedes its children's, which follow in order. Instance numbers
-- follow this order, so it fixes the names in the emitted C.
private pure func append_value_types(
	collected: List[Checked.TypeUse],
	value: Checked.CheckedExpr,
) -> List[Checked.TypeUse]:
	var types: List[Checked.TypeUse] = collected.append({
		value_type = value.value_type,
		span = anchor(value),
	})

	match value.form:
		Checked.UpdateRecord(_, update):
			types = append_value_types(types, update.base)
			for field in update.replacements:
				types = append_value_types(types, field.value)
			for field in update.inherited:
				types = types.append({ value_type = field.value_type, span = update.base_expression_span })
		Checked.ConstructVariant(_, children):
			for child in children:
				types = append_value_types(types, child)
		Checked.ConstructRecord(_, fields):
			for field in fields:
				types = append_value_types(types, field.value)
		Checked.ConstructOpaque(_, child):
			types = append_value_types(types, child)
		Checked.ProjectOpaque(_, child):
			types = append_value_types(types, child)
		Checked.ConstructList(elements):
			for element in elements:
				types = append_value_types(types, element)
		Checked.Match(join):
			types = append_value_types(types, join.scrutinee)
			types = types.concat(selection_types(join.selection, join.scrutinee.span))
			for arm in join.arms:
				types = types.concat(statement_types(arm.statements))
				types = append_value_types(types, arm.value)
		Checked.InvokeFunction(_, arguments):
			for argument in arguments:
				types = append_value_types(types, argument)
		Checked.ReadRecordField(receiver, _):
			types = append_value_types(types, receiver)
		Checked.LiteralVoid | Checked.LiteralInteger(_) | Checked.LiteralFloat(_) | Checked.LiteralString(_) | Checked.ReadBinding(_) | Checked.ReadCapture(_):
			void

	types


private pure func statement_types(
	statements: List[Checked.CheckedStatement],
) -> List[Checked.TypeUse]:
	var types: List[Checked.TypeUse] = []

	for statement in statements:
		match statement:
			Checked.InitializeBinding(_, value):
				types = types.concat(value_types(value))
			Checked.DiscardExpression(value):
				types = types.concat(value_types(value))
			Checked.ReassignBinding(_, value):
				types = types.concat(value_types(value))
			Checked.RunWhile(loop):
				types = types.concat(value_types(loop.condition)).concat(statement_types(loop.body))
			Checked.BreakSourceLoop(_) | Checked.ContinueSourceLoop(_): void
			Checked.RunFor(loop):
				match loop.iteration:
					Checked.ListIteration(iterable, element, option):
						types = types.concat(value_types(iterable)).append({
							value_type = Checked.AppliedUnionType(Declaration.variant_owner(option.some), [element]),
							span = loop.span,
						})
					Checked.AscendingIntRange(start, end, boolean):
						types = types.concat(value_types(start)).concat(value_types(end)).append({
							value_type = Checked.UnionType(Declaration.variant_owner(boolean.true_variant)),
							span = loop.span,
						})
				types = types.concat(statement_types(loop.body))

	types


private pure func exit_types(exit: Checked.CheckedExit) -> List[Checked.TypeUse]:
	match exit:
		Checked.ReturnExpression(value):
			value_types(value)
		Checked.RecurWith(arguments, _):
			var types: List[Checked.TypeUse] = []

			for argument in arguments:
				types = types.concat(value_types(argument))

			types


-- The selected body owns these facts; only its genuine root owns rigid parameters.
-- This view is local to preparation/translation, never a published function row.
private fixed record SelectedBody {
	captures: List[Checked.CheckedCapture],
	root: Declaration.FunctionId,
	type_parameters: List[Checked.TypeParameterId],
	parameters: List[Checked.TypeUse],
	return_type: Checked.TypeUse,
	bindings: List[Checked.BindingDefinition],
	statements: List[Checked.CheckedStatement],
	body: Checked.CheckedBody,
	execution: FunctionExecution
}


private pure func selected_body(
	checked: Checked.CheckedFunctions,
	owner: Checked.BodyOwner,
	source: RequestSource,
) -> Result[SelectedBody, Diagnostic]:
	match owner:
		Checked.DeclaredBody(id):
			match checked.functions.get(Declaration.function_number(id)):
				None: Err(missing_body(source, "unknown function declaration"))
				Some(function): Ok({
					captures = [],
					root = function.id,
					type_parameters = function.signature.type_parameters,
					parameters = function.signature.parameters,
					return_type = function.signature.return_type,
					bindings = function.bindings,
					statements = function.statements,
					body = function.body,
					execution = function.execution
				})
		Checked.LambdaBody(id):
			match checked.lambdas.get(Checked.lambda_number(id)):
				None: Err(missing_body(source, "unknown lambda identity"))
				Some(lambda):
					match checked.functions.get(Declaration.function_number(lambda.root)):
						None: Err(invalid(lambda.return_type.span, "unknown lambda root"))
						Some(root): Ok({
							captures = lambda.captures,
							root = root.id,
							type_parameters = root.signature.type_parameters,
							parameters = lambda.parameters,
							return_type = lambda.return_type,
							bindings = lambda.bindings,
							statements = lambda.statements,
							body = lambda.body,
							execution = OrdinaryCalls
						})


private pure func place_types(place: Checked.CheckedPatternPlace, span: Span) -> List[Checked.TypeUse]:
	own: Checked.TypeUse = { value_type = place.value_type, span = span }
	match place.route:
		Checked.MatchRoot: [own]
		Checked.UnionField(parent, _, _): [own].concat(place_types(parent, span))
		Checked.ListElement(parent, _): [own].concat(place_types(parent, span))


private pure func selection_types(selection: Checked.CheckedSelection, span: Span) -> List[Checked.TypeUse]:
	var types: List[Checked.TypeUse] = []
	for node in selection.nodes:
		match node:
			Checked.TestVariant(place, _, _, _): types = types.concat(place_types(place, span))
			Checked.TestListLength(place, _, _, _): types = types.concat(place_types(place, span))
			Checked.TestStringBytes(place, _, _, _): types = types.concat(place_types(place, span))
			Checked.EnterArm(_, arguments):
				for argument in arguments:
					match argument:
						Checked.BorrowPlace(place): types = types.concat(place_types(place, span))
						Checked.CopyListSuffix(place, _): types = types.concat(place_types(place, span))
	types


private pure func function_types(function: SelectedBody) -> List[Checked.TypeUse]:
	var types: List[Checked.TypeUse] = []
	for parameter in function.parameters:
		match parameter.value_type:
			Checked.PureCallableType(inputs, output):
				for child in inputs.append(output):
					types = types.append({ value_type = child, span = parameter.span })
			_: types = types.append(parameter)

	types = types
		.append(function.return_type)
		.concat(statement_types(function.statements))

	match function.body:
		Checked.CheckedValueBody(value):
			types.concat(exit_types(value))
		Checked.CheckedMatchBody(matched):
			types = types.concat(value_types(matched.scrutinee)).concat(selection_types(matched.selection, matched.scrutinee.span))

			for arm in matched.arms:
				types = types
					.concat(statement_types(arm.statements))
					.concat(exit_types(arm.body))

			types


private pure func request_instance(
	prepared: PreparedInstances,
	key: InstanceKey,
	source: RequestSource,
) -> PreparedInstances:
	if find_instance(prepared.functions, key).is_some():
		prepared
	else:
		{ prepared | functions = prepared.functions.append({ key = key, source = source }) }


private fixed record PreparedCallableStorage {
	storage: CallableStorage,
	prepared: PreparedInstances
}


private pure func prepare_callable_storage(
	id: Checked.LambdaId,
	captures: List[Checked.CheckedExpr],
	arguments: List[TypeRef],
	checked: Checked.CheckedFunctions,
	prepared: PreparedInstances,
	span: Span,
) -> Result[PreparedCallableStorage, Diagnostic]:
	if captures.is_empty():
		Ok({ storage = ErasedCallable, prepared = prepared })
	else:
		match ensure_record({ origin = CaptureEnvironment(id), arguments = known_arguments(arguments) }, checked, prepared.unions, span, prepared.records, []):
			Err(error): Err(error)
			Ok(layout):
				match known_type(layout.value_type, span):
					Err(error): Err(error)
					Ok(RecordType(owner)): Ok({
						storage = EnvironmentCallable(owner),
						prepared = { prepared | unions = layout.unions, records = layout.records }
					})
					Ok(_): Err(invalid(span, "capture environment has a non-record layout"))


private pure func prepare_function(
	function: SelectedBody,
	request: FunctionRequest,
	checked: Checked.CheckedFunctions,
	initial: PreparedInstances,
) -> Result[PreparedInstances, Diagnostic]:
	substitution ?= parameter_substitution(
		function.type_parameters,
		known_arguments(request.key.arguments),
		Checked.FunctionDeclaration(function.root),
		function.return_type.span,
	)
	var prepared = initial
	var failure: Option[Diagnostic] = None
	has_type_parameters = function.type_parameters.is_empty().not()

	for written in function_types(function):
		depends_on_caller = match has_type_parameters:
			True: contains_parameter(written.value_type)
			False: False
		match prepare_type(
			written.value_type,
			substitution,
			checked,
			prepared.unions,
			request_span(depends_on_caller, request.source, written.span),
			prepared.records,
			[],
		):
			Ok(value):
				prepared = { prepared |
					unions = value.unions,
					records = value.records
				}
			Err(error):
				failure = Some(error)
				break

	if failure.is_some().not():
		for call in Checked.body_calls(function.statements, function.body):
			match call.target:
				Checked.RuntimeFunction(_): void
				Checked.CallableParameter(parameter):
					match callable_choice(request.key.callables, parameter, call.span):
						Err(error): failure = Some(error)
						Ok(choice):
							prepared = request_instance(prepared, {
								body = choice.body,
								arguments = choice.arguments,
								callables = []
							}, request.source)
				Checked.UserFunction(declaration, arguments, callables):
					var concrete: List[TypeRef] = []
					var depends_on_caller: Bool = False

					for argument in arguments:
						-- One dependency fact serves both this argument's diagnostic
						-- and the request chain. Nongeneric callers need no tree scan.
						argument_depends_on_caller = match has_type_parameters:
							True: contains_parameter(argument)
							False: False
						depends_on_caller = or(depends_on_caller, argument_depends_on_caller)
						match prepare_type(
							argument,
							substitution,
							checked,
							prepared.unions,
							request_span(argument_depends_on_caller, request.source, call.span),
							prepared.records,
							[],
						):
							Ok(value):
								prepared = { prepared |
									unions = value.unions,
									records = value.records
								}
								-- No layout is in progress at a function boundary.
								match known_type(value.value_type, call.span):
									Ok(known): concrete = concrete.append(known)
									Err(error):
										failure = Some(error)
										break
							Err(error):
								failure = Some(error)
								break

					if failure.is_some():
						break

					var choices: List[KnownCallable] = []
					for callable in callables:
						var choice_depends_on_caller: Bool = False
						choice_result: Result[KnownCallable, Diagnostic] = match callable.choice:
							Checked.ForwardedCallable(parameter):
								-- A forwarded selection depends on the current caller's key.
								choice_depends_on_caller = True
								callable_choice(request.key.callables, parameter, callable.span)
									.map(pure func(choice): { choice | parameter = callable.parameter })
							Checked.LambdaCallable(id, captures):
								choice_depends_on_caller = has_type_parameters
								match prepare_callable_storage(id, captures, request.key.arguments, checked, prepared, callable.span):
									Err(error): Err(error)
									Ok(storage):
										prepared = storage.prepared
										Ok({
											parameter = callable.parameter,
											body = Checked.LambdaBody(id),
											arguments = request.key.arguments,
											storage = storage.storage
										})
							Checked.NamedCallable(id, named_arguments):
								choice_depends_on_caller = match has_type_parameters:
									True: named_arguments.any(contains_parameter)
									False: False
								match prepare_arguments(
									named_arguments, substitution, checked, prepared.unions,
									request_span(choice_depends_on_caller, request.source, callable.span), prepared.records, [],
								):
									Err(error): Err(error)
									Ok(types):
										prepared = { prepared | unions = types.unions, records = types.records }
										known_types(types.arguments, callable.span).map(pure func(values): {
											parameter = callable.parameter,
											body = Checked.DeclaredBody(id),
											arguments = values,
											storage = ErasedCallable
										})
						depends_on_caller = or(depends_on_caller, choice_depends_on_caller)
						match choice_result:
							Err(error):
								failure = Some(error)
								break
							Ok(choice):
								choices = choices.append(choice)
								prepared = request_instance(prepared, {
									body = choice.body,
									arguments = choice.arguments,
									callables = []
								}, ConcreteRequest(request_span(choice_depends_on_caller, request.source, callable.span)))
					if failure.is_some().not():
						prepared = request_instance(prepared, {
							body = Checked.DeclaredBody(declaration),
							arguments = concrete,
							callables = choices
						}, ConcreteRequest(request_span(depends_on_caller, request.source, call.span)))
			if failure.is_some():
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(prepared)


private pure func expand_instances(
	checked: Checked.CheckedFunctions,
	initial: PreparedInstances,
) -> Result[PreparedInstances, Diagnostic]:
	var prepared = initial
	var cursor: Int = 0
	var failure: Option[Diagnostic] = None

	-- Checking rejects growing recursive substitutions. Finite concrete keys are
	-- requested once, so regular self/mutual recursion reuses an existing identity.
	while IntOps.less_than(cursor, prepared.functions.length()):
		match prepared.functions.get(cursor):
			None:
				failure = Some(
					invalid(
						{
							source = compiler_source(),
							start = 0,
							end = 0
						},
						"missing instance request",
					),
				)
			Some(request):
				match selected_body(checked, request.key.body, request.source):
					Err(error): failure = Some(error)
					Ok(function):
						match prepare_function(function, request, checked, prepared):
							Ok(value): prepared = value
							Err(error): failure = Some(error)

		if failure.is_some():
			break

		cursor = IntOps.add(cursor, 1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(prepared)


-- A call's concrete result instance names the designated union's constructors.
private pure func translate_option(
	option: DesignatedOption[Declaration.VariantId],
	result_type: TypeRef,
	unions: List[UnionInstance],
	span: Span,
) -> Result[DesignatedOption[VariantInstanceId], Diagnostic]:
	owner ?= concrete_union_owner(result_type, span)
	some ?= translate_variant(option.some, owner, unions, span)
	none ?= translate_variant(option.none, owner, unions, span)
	Ok({
		some = some,
		none = none,
	})


private pure func translate_result(
	result: DesignatedResult[Declaration.VariantId],
	result_type: TypeRef,
	unions: List[UnionInstance],
	span: Span,
) -> Result[DesignatedResult[VariantInstanceId], Diagnostic]:
	owner ?= concrete_union_owner(result_type, span)
	ok ?= translate_variant(result.ok, owner, unions, span)
	error ?= translate_variant(result.err, owner, unions, span)
	Ok({ ok = ok, err = error })


private pure func translate_boolean(
	boolean: DesignatedBoolean[Declaration.VariantId],
	result_type: TypeRef,
	unions: List[UnionInstance],
	span: Span,
) -> Result[DesignatedBoolean[VariantInstanceId], Diagnostic]:
	owner ?= concrete_union_owner(result_type, span)
	true_variant ?= translate_variant(boolean.true_variant, owner, unions, span)
	false_variant ?= translate_variant(boolean.false_variant, owner, unions, span)
	Ok({
		true_variant = true_variant,
		false_variant = false_variant,
	})


private fixed union CaptureBinding:
	NoCaptureBinding
	LambdaCaptureBinding(Checked.LambdaId, RecordInstanceId, Checked.BindingId)


private fixed record CallableBinding {
	parameter: Checked.CallableParameterId,
	binding: Checked.BindingId
}


-- Runtime bindings are body-local translation facts, never specialization keys.
private fixed record TranslationBindings {
	callables: List[KnownCallable],
	callable_bindings: List[CallableBinding],
	capture: CaptureBinding
}


private pure func lambda_storage(
	id: Checked.LambdaId,
	captures: List[Checked.CheckedExpr],
	arguments: List[TypeRef],
	records: List[RecordInstance],
	span: Span,
) -> Result[CallableStorage, Diagnostic]:
	if captures.is_empty():
		Ok(ErasedCallable)
	else:
		match find_record_instance(records, { origin = CaptureEnvironment(id), arguments = arguments }):
			None: Err(invalid(span, "unprepared capture environment"))
			Some(owner): Ok(EnvironmentCallable(owner))


private pure func callable_environment(
	parameter: Checked.CallableParameterId,
	translation: TranslationBindings,
	span: Span,
) -> Result[ConcreteExpr, Diagnostic]:
	choice ?= callable_choice(translation.callables, parameter, span)
	var binding: Option[Checked.BindingId] = None
	for known in translation.callable_bindings:
		if Checked.same_callable_parameter(known.parameter, parameter):
			binding = Some(known.binding)
			break
	id ?= binding.to_result(invalid(span, "missing callable environment binding"))
	match choice.storage:
		ErasedCallable: Err(invalid(span, "erased callable has no environment"))
		EnvironmentCallable(owner): Ok({ form = ReadBinding(id), value_type = RecordType(owner), span = span })


private pure func translate_call(
	opaques: List[Checked.CheckedOpaque],
	call: Checked.CheckedCall,
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
	result_type: TypeRef,
) -> Result[ConcreteCall, Diagnostic]:
	target_result: Result[CallTarget, Diagnostic] = match call.target:
		Checked.RuntimeFunction(operation):
			concrete_result: Result[RuntimeOperation[VariantInstanceId, TypeRef], Diagnostic] = match operation:
				IntAdd:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntAdd
					Ok(accepted)
				IntSubtract:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntSubtract
					Ok(accepted)
				IntMultiply:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntMultiply
					Ok(accepted)
				IntDivide:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntDivide
					Ok(accepted)
				IntRemainder:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntRemainder
					Ok(accepted)
				IntToString:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntToString
					Ok(accepted)
				FloatAdd:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatAdd
					Ok(accepted)
				FloatSubtract:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatSubtract
					Ok(accepted)
				FloatMultiply:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatMultiply
					Ok(accepted)
				FloatDivide:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatDivide
					Ok(accepted)
				FloatRemainder:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatRemainder
					Ok(accepted)
				FloatToString:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatToString
					Ok(accepted)
				FloatCopySign:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatCopySign
					Ok(accepted)
				ListRepeat(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListRepeat(concrete))
						Err(error): Err(error)
				ListLength(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListLength(concrete))
						Err(error): Err(error)
				ListAppend(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListAppend(concrete))
						Err(error): Err(error)
				ListSet(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListSet(concrete))
						Err(error): Err(error)
				ListConcat(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListConcat(concrete))
						Err(error): Err(error)
				StringLength:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.StringLength
					Ok(accepted)
				StringConcat:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.StringConcat
					Ok(accepted)
				StringPrint:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.StringPrint
					Ok(accepted)
				StringPrintError:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.StringPrintError
					Ok(accepted)
				StringParseInt(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringParseInt(translated))
						Err(error): Err(error)
				StringParseFloat(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringParseFloat(translated))
						Err(error): Err(error)
				StringByteAt(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringByteAt(translated))
						Err(error): Err(error)
				ReadFile(result):
					match translate_result(result, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.ReadFile(translated))
						Err(error): Err(error)
				WriteFile(result):
					match translate_result(result, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.WriteFile(translated))
						Err(error): Err(error)
				GetCurrentDirectory(result):
					match translate_result(result, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.GetCurrentDirectory(translated))
						Err(error): Err(error)
				StringFromCodepoint(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringFromCodepoint(translated))
						Err(error): Err(error)
				StringSlice(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringSlice(translated))
						Err(error): Err(error)
				ListGet(element, option):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete):
							match translate_option(option, result_type, unions, call.span):
								Ok(translated): Ok(Builtins.ListGet(concrete, translated))
								Err(error): Err(error)
						Err(error): Err(error)
				IntEquals(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.IntEquals(translated))
						Err(error): Err(error)
				IntLessThan(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.IntLessThan(translated))
						Err(error): Err(error)
				FloatEquals(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.FloatEquals(translated))
						Err(error): Err(error)
				FloatLessThan(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.FloatLessThan(translated))
						Err(error): Err(error)
				FloatIsNaN(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.FloatIsNaN(translated))
						Err(error): Err(error)
				FloatIsFinite(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.FloatIsFinite(translated))
						Err(error): Err(error)
				StringEquals(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringEquals(translated))
						Err(error): Err(error)

			match concrete_result:
				Ok(concrete): Ok(RuntimeFunction(concrete))
				Err(error): Err(error)
		Checked.CallableParameter(parameter):
			match callable_choice(callables.callables, parameter, call.span):
				Err(error): Err(error)
				Ok(choice):
					find_instance(keys, {
						body = choice.body,
						arguments = choice.arguments,
						callables = []
					}).to_result(invalid(call.span, "unexpanded callable target")).map(pure func(id): UserFunction(id))
		Checked.UserFunction(declaration, arguments, written_choices):
			match concrete_types(opaques, arguments, substitution, unions, call.span, records):
				Err(error): Err(error)
				Ok(concrete):
					var choices: List[KnownCallable] = []
					var failure: Option[Diagnostic] = None
					for written in written_choices:
						choice_result: Result[KnownCallable, Diagnostic] = match written.choice:
							Checked.ForwardedCallable(parameter):
								callable_choice(callables.callables, parameter, written.span)
									.map(pure func(choice): { choice | parameter = written.parameter })
							Checked.LambdaCallable(id, captures):
								root_arguments = substitution.map(pure func(value): value.value_type)
								lambda_storage(id, captures, root_arguments, records, written.span).map(pure func(storage): {
									parameter = written.parameter,
									body = Checked.LambdaBody(id),
									arguments = root_arguments,
									storage = storage
								})
							Checked.NamedCallable(id, named_arguments):
								concrete_types(opaques, named_arguments, substitution, unions, written.span, records).map(pure func(values): {
									parameter = written.parameter,
									body = Checked.DeclaredBody(id),
									arguments = values,
									storage = ErasedCallable
								})
						match choice_result:
							Ok(choice): choices = choices.append(choice)
							Err(error):
								failure = Some(error)
								break
					match failure:
						Some(error): Err(error)
						None:
							find_instance(keys, {
								body = Checked.DeclaredBody(declaration),
								arguments = concrete,
								callables = choices
							}).to_result(invalid(call.span, "unexpanded function instance")).map(pure func(id): UserFunction(id))

	target ?= target_result
	Ok({
		target = target,
		span = call.span,
	})


private pure func concrete_union_owner(
	value: TypeRef,
	span: Span,
) -> Result[UnionInstanceId, Diagnostic]:
	match value:
		UnionType(id):
			Ok(id)
		_:
			Err(invalid(span, "variant occurrence has no concrete union type"))


private pure func translate_variant(
	id: Declaration.VariantId,
	owner: UnionInstanceId,
	unions: List[UnionInstance],
	span: Span,
) -> Result[VariantInstanceId, Diagnostic]:
	instance ?= unions
		.get(union_number(owner))
		.to_result(invalid(span, "unknown concrete union"))

	membership: Void ?= if IntOps.equals(
		Declaration.union_number(instance.key.declaration),
		Declaration.union_number(Declaration.variant_owner(id)),
	):
		Ok(void)
	else:
		Err(invalid(span, "variant belongs to a different union declaration"))

	position = Declaration.variant_number(id)
	member ?= instance.layout.variants
		.get(position)
		.to_result(invalid(span, "unknown union variant"))
	Ok(into_opaque VariantInstanceId({
				owner = owner,
				position = position
			}))


-- A written record field of a literal or an update, with its field instance.
private pure func translate_record_field(
	opaques: List[Checked.CheckedOpaque],
	field: Checked.CheckedRecordField,
	owner: RecordInstanceId,
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[ConcreteRecordField, Diagnostic]:
	id ?= translate_field(field.field, owner, records, field.span)
	child ?= translate_expr(opaques, field.value, substitution, callables, keys, unions, records)
	Ok({ field = id, value = child })


private pure func translate_record_fields(
	opaques: List[Checked.CheckedOpaque],
	fields: List[Checked.CheckedRecordField],
	owner: RecordInstanceId,
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[List[ConcreteRecordField], Diagnostic]:
	var translated: List[ConcreteRecordField] = []
	var failure: Option[Diagnostic] = None

	for field in fields:
		match translate_record_field(opaques, field, owner, substitution, callables, keys, unions, records):
			Ok(concrete):
				translated = translated.append(concrete)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(translated)


-- A node's type and identity translate before its children, except a field read,
-- whose instance needs its receiver's concrete record.
private pure func translate_expr(
	opaques: List[Checked.CheckedOpaque],
	value: Checked.CheckedExpr,
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[ConcreteExpr, Diagnostic]:
	match value.form:
		Checked.ConstructOpaque(_, child):
			match translate_expr(opaques, child, substitution, callables, keys, unions, records):
				Ok(translated): Ok({ translated | span = value.span })
				Err(error): Err(error)
		Checked.ProjectOpaque(_, child):
			match translate_expr(opaques, child, substitution, callables, keys, unions, records):
				Ok(translated): Ok({ translated | span = value.span })
				Err(error): Err(error)
		Checked.ReadRecordField(receiver, field):
			match translate_expr(opaques, receiver, substitution, callables, keys, unions, records):
				Ok(source):
					-- The receiver's translated type already names its record instance.
					match source.value_type:
						RecordType(owner):
							-- The prepared receiver row already owns this exact concrete field type.
							match concrete_record_field_type(field, owner, records, value.span):
								Ok(value_type):
									translated_field = into_opaque FieldInstanceId({ owner = owner, position = Checked.field_number(field) })
									Ok({ form = ReadRecordField(source, translated_field), value_type = value_type, span = value.span })
								Err(error): Err(error)
						_: Err(invalid(value.span, "record operation has a non-record receiver"))
				Err(error): Err(error)
		Checked.InvokeFunction(call, arguments):
			match concrete_type(opaques, value.value_type, substitution, unions, call.span, records):
				Ok(value_type):
					match translate_call(opaques, call, substitution, callables, keys, unions, records, value_type):
						Ok(concrete):
							match translate_call_arguments(opaques, call, arguments, substitution, callables, keys, unions, records):
								Ok(values): Ok({ form = InvokeFunction(concrete, values), value_type = value_type, span = value.span })
								Err(error): Err(error)
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.UpdateRecord(declaration, update):
			match record_instance(opaques, declaration, value, substitution, unions, records):
				Ok(owner):
					match translate_expr(opaques, update.base, substitution, callables, keys, unions, records):
						Ok(base):
							match translate_record_fields(opaques, update.replacements, owner, substitution, callables, keys, unions, records):
								Ok(replacements):
									inherited_result: Result[List[RetainedRecordField], Diagnostic] = translated_list(update.inherited, pure func(field: Checked.RetainedRecordField) -> Result[RetainedRecordField, Diagnostic]:
										match translate_field(field.field, owner, records, update.base_expression_span):
											Ok(id):
												match concrete_type(opaques, field.value_type, substitution, unions, update.base_expression_span, records):
													Ok(value_type): Ok({ field = id, value_type = value_type })
													Err(error): Err(error)
											Err(error): Err(error)
									)
									match inherited_result:
										Ok(inherited):
											form: ConcreteForm = UpdateRecord(owner, { base = base, base_expression_span = update.base_expression_span, replacements = replacements, inherited = inherited })
											Ok({ form = form, value_type = RecordType(owner), span = value.span })
										Err(error): Err(error)
								Err(error): Err(error)
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.ConstructVariant(id, children):
			match concrete_type(opaques, value.value_type, substitution, unions, value.span, records):
				Ok(value_type):
					match concrete_union_owner(value_type, value.span):
						Ok(owner):
							match translate_variant(id, owner, unions, value.span):
								Ok(variant):
									match translate_exprs(opaques, children, substitution, callables, keys, unions, records):
										Ok(values): Ok({ form = ConstructVariant(variant, values), value_type = value_type, span = value.span })
										Err(error): Err(error)
								Err(error): Err(error)
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.ConstructRecord(declaration, fields):
			match record_instance(opaques, declaration, value, substitution, unions, records):
				Ok(owner):
					match translate_record_fields(opaques, fields, owner, substitution, callables, keys, unions, records):
						Ok(concrete): Ok({ form = ConstructRecord(owner, concrete), value_type = RecordType(owner), span = value.span })
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.ConstructList(elements):
			match concrete_type(opaques, value.value_type, substitution, unions, value.span, records):
				Ok(value_type):
					match translate_exprs(opaques, elements, substitution, callables, keys, unions, records):
						Ok(values): Ok({ form = ConstructList(values), value_type = value_type, span = value.span })
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.Match(join):
			match concrete_type(opaques, value.value_type, substitution, unions, value.span, records):
				Ok(value_type):
					match translate_join(opaques, join, substitution, callables, keys, unions, records, value.span):
						Ok(concrete): Ok({ form = Match(concrete), value_type = value_type, span = value.span })
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.LiteralVoid:
			translate_leaf(opaques, LiteralVoid, value, substitution, unions, records)
		Checked.LiteralString(text):
			translate_leaf(opaques, LiteralString(text), value, substitution, unions, records)
		Checked.LiteralInteger(integer):
			translate_leaf(opaques, LiteralInteger(integer), value, substitution, unions, records)
		Checked.LiteralFloat(number):
			translate_leaf(opaques, LiteralFloat(number), value, substitution, unions, records)
		Checked.ReadCapture(id):
			match callables.capture:
				NoCaptureBinding: Err(invalid(value.span, "capture read outside a capture environment"))
				LambdaCaptureBinding(lambda, owner, binding):
					if IntOps.equals(Checked.lambda_number(lambda), Checked.lambda_number(Checked.capture_owner(id))):
						receiver: ConcreteExpr = { form = ReadBinding(binding), value_type = RecordType(owner), span = value.span }
						field = into_opaque FieldInstanceId({ owner = owner, position = Checked.capture_number(id) })
						translate_leaf(opaques, ReadRecordField(receiver, field), value, substitution, unions, records)
					else:
						Err(invalid(value.span, "capture read belongs to another lambda"))
		Checked.ReadBinding(id):
			translate_leaf(opaques, ReadBinding(id), value, substitution, unions, records)


-- A leaf keeps its checked form; only its type is made concrete.
private pure func translate_leaf(
	opaques: List[Checked.CheckedOpaque],
	form: ConcreteForm,
	value: Checked.CheckedExpr,
	substitution: List[TypeSubstitution[TypeRef]],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[ConcreteExpr, Diagnostic]:
	value_type ?= concrete_type(opaques, value.value_type, substitution, unions, value.span, records)
	Ok({ form = form, value_type = value_type, span = value.span })


-- Check retains ordinary operands densely; callback identities carry written
-- positions. Merge in that order before Lower evaluates the ordinary expressions.
private pure func translate_call_arguments(
	opaques: List[Checked.CheckedOpaque],
	call: Checked.CheckedCall,
	arguments: List[Checked.CheckedExpr],
	substitution: List[TypeSubstitution[TypeRef]],
	translation: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[List[ConcreteExpr], Diagnostic]:
	match call.target:
		Checked.RuntimeFunction(_):
			translate_exprs(opaques, arguments, substitution, translation, keys, unions, records)
		Checked.CallableParameter(parameter):
			match translate_exprs(opaques, arguments, substitution, translation, keys, unions, records):
				Err(error): Err(error)
				Ok(values):
					match callable_choice(translation.callables, parameter, call.span):
						Err(error): Err(error)
						Ok(choice):
							match choice.storage:
								ErasedCallable: Ok(values)
								EnvironmentCallable(_):
									match callable_environment(parameter, translation, call.span):
										Err(error): Err(error)
										Ok(environment): Ok([environment].concat(values))
		Checked.UserFunction(_, _, choices):
			if choices.is_empty():
				translate_exprs(opaques, arguments, substitution, translation, keys, unions, records)
			else:
				var values: List[ConcreteExpr] = []
				var data_position = 0
				var choice_position = 0
				var written_position = 0
				var failure: Option[Diagnostic] = None
				while IntOps.less_than(written_position, IntOps.add(arguments.length(), choices.length())):
					written = choices.get(choice_position)
					is_callback = match written:
						Some(choice): IntOps.equals(Checked.callable_position(choice.parameter), written_position)
						None: False
					if is_callback:
						match written:
							None: failure = Some(invalid(call.span, "missing written callable operand"))
							Some(choice):
								match translate_callable_operand(opaques, choice, substitution, translation, keys, unions, records):
									Err(error): failure = Some(error)
									Ok(environment):
										match environment:
											None: void
											Some(value): values = values.append(value)
						choice_position = IntOps.add(choice_position, 1)
					else:
						match arguments.get(data_position):
							None: failure = Some(invalid(call.span, "missing ordinary call operand"))
							Some(argument):
								match translate_expr(opaques, argument, substitution, translation, keys, unions, records):
									Err(error): failure = Some(error)
									Ok(value): values = values.append(value)
						data_position = IntOps.add(data_position, 1)
					if failure.is_some():
						break
					written_position = IntOps.add(written_position, 1)
				match failure:
					Some(error): Err(error)
					None: Ok(values)


private pure func translate_callable_operand(
	opaques: List[Checked.CheckedOpaque],
	choice: Checked.CallableArgument,
	substitution: List[TypeSubstitution[TypeRef]],
	translation: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[Option[ConcreteExpr], Diagnostic]:
	match choice.choice:
		Checked.NamedCallable(_, _): Ok(None)
		Checked.ForwardedCallable(parameter):
			match callable_choice(translation.callables, parameter, choice.span):
				Err(error): Err(error)
				Ok(known):
					match known.storage:
						ErasedCallable: Ok(None)
						EnvironmentCallable(_): callable_environment(parameter, translation, choice.span).map(pure func(value): Some(value))
		Checked.LambdaCallable(id, captures):
			match lambda_storage(id, captures, substitution.map(pure func(value): value.value_type), records, choice.span):
				Err(error): Err(error)
				Ok(ErasedCallable): Ok(None)
				Ok(EnvironmentCallable(owner)):
					match translate_exprs(opaques, captures, substitution, translation, keys, unions, records):
						Err(error): Err(error)
						Ok(children):
							var fields: List[ConcreteRecordField] = []
							var position = 0
							for value in children:
								fields = fields.append({ field = into_opaque FieldInstanceId({ owner = owner, position = position }), value = value })
								position = IntOps.add(position, 1)
							Ok(Some({ form = ConstructRecord(owner, fields), value_type = RecordType(owner), span = choice.span }))


private pure func translate_exprs(
	opaques: List[Checked.CheckedOpaque],
	values: List[Checked.CheckedExpr],
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[List[ConcreteExpr], Diagnostic]:
	var translated: List[ConcreteExpr] = []
	var failure: Option[Diagnostic] = None

	for value in values:
		match translate_expr(opaques, value, substitution, callables, keys, unions, records):
			Ok(concrete):
				translated = translated.append(concrete)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(translated)


private pure func translate_statements(
	opaques: List[Checked.CheckedOpaque],
	statements: List[Checked.CheckedStatement],
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[List[ConcreteStatement], Diagnostic]:
	translated_list(statements, pure func(
		statement: Checked.CheckedStatement,
	) -> Result[ConcreteStatement, Diagnostic]:
		match statement:
			Checked.InitializeBinding(id, value):
				match translate_expr(opaques, value, substitution, callables, keys, unions, records):
					Ok(translated_value): Ok(InitializeBinding(id, translated_value))
					Err(error): Err(error)
			Checked.DiscardExpression(value):
				match translate_expr(opaques, value, substitution, callables, keys, unions, records):
					Ok(translated_value): Ok(DiscardExpression(translated_value))
					Err(error): Err(error)
			Checked.ReassignBinding(id, value):
				match translate_expr(opaques, value, substitution, callables, keys, unions, records):
					Ok(translated_value): Ok(ReassignBinding(id, translated_value))
					Err(error): Err(error)
			Checked.RunWhile(loop):
				match translate_expr(opaques, loop.condition, substitution, callables, keys, unions, records):
					Err(error): Err(error)
					Ok(condition):
						match translate_statements(opaques, loop.body, substitution, callables, keys, unions, records):
							Err(error): Err(error)
							Ok(body):
								match translate_boolean(loop.boolean, condition.value_type, unions, loop.span):
									Err(error): Err(error)
									Ok(boolean):
										Ok(RunWhile({
											condition = condition, body = body, carried = loop.carried,
											boolean = boolean, span = loop.span,
										}))
			Checked.BreakSourceLoop(span): Ok(BreakSourceLoop(span))
			Checked.ContinueSourceLoop(span): Ok(ContinueSourceLoop(span))
			Checked.RunFor(loop):
				iteration: Result[ConcreteIteration, Diagnostic] = match loop.iteration:
					Checked.ListIteration(iterable, element, option):
						match translate_expr(opaques, iterable, substitution, callables, keys, unions, records):
							Err(error): Err(error)
							Ok(value):
								match concrete_type(opaques, element, substitution, unions, loop.span, records):
									Err(error): Err(error)
									Ok(concrete_element):
										match concrete_type(
											opaques, Checked.AppliedUnionType(Declaration.variant_owner(option.some), [element]),
											substitution, unions, loop.span, records,
										):
											Err(error): Err(error)
											Ok(option_type):
												match translate_option(option, option_type, unions, loop.span):
													Err(error): Err(error)
													Ok(concrete_option): Ok(ListIteration(value, concrete_element, concrete_option))
					Checked.AscendingIntRange(start, end, boolean):
						match translate_expr(opaques, start, substitution, callables, keys, unions, records):
							Err(error): Err(error)
							Ok(concrete_start):
								match translate_expr(opaques, end, substitution, callables, keys, unions, records):
									Err(error): Err(error)
									Ok(concrete_end):
										match concrete_type(
											opaques, Checked.UnionType(Declaration.variant_owner(boolean.true_variant)),
											substitution, unions, loop.span, records,
										):
											Err(error): Err(error)
											Ok(boolean_type):
												match translate_boolean(boolean, boolean_type, unions, loop.span):
													Err(error): Err(error)
													Ok(concrete_boolean): Ok(AscendingIntRange(concrete_start, concrete_end, concrete_boolean))
				match iteration:
					Err(error): Err(error)
					Ok(concrete_iteration):
						match translate_statements(opaques, loop.body, substitution, callables, keys, unions, records):
							Err(error): Err(error)
							Ok(body): Ok(RunFor({
								iteration = concrete_iteration, item = loop.item, body = body,
								carried = loop.carried, span = loop.span,
							}))
	)


private pure func translate_place(
	opaques: List[Checked.CheckedOpaque],
	place: Checked.CheckedPatternPlace,
	substitution: List[TypeSubstitution[TypeRef]],
	unions: List[UnionInstance],
	records: List[RecordInstance],
	span: Span,
) -> Result[ConcretePatternPlace, Diagnostic]:
	value_type ?= concrete_type(opaques, place.value_type, substitution, unions, span, records)
	route: Result[ConcretePatternRoute, Diagnostic] = match place.route:
		Checked.MatchRoot: Ok(MatchRoot)
		Checked.ListElement(parent, index):
			match translate_place(opaques, parent, substitution, unions, records, span):
				Err(error): Err(error)
				Ok(concrete_parent): Ok(ListElement(concrete_parent, index))
		Checked.UnionField(parent, id, ordinal):
			match translate_place(opaques, parent, substitution, unions, records, span):
				Err(error): Err(error)
				Ok(concrete_parent):
					match concrete_union_owner(concrete_parent.value_type, span):
						Err(error): Err(error)
						Ok(owner):
							match translate_variant(id, owner, unions, span):
								Err(error): Err(error)
								Ok(variant):
									Ok(UnionField(concrete_parent, into_opaque VariantFieldInstanceId({ variant = variant, position = ordinal })))
	translated ?= route
	Ok({ value_type = value_type, route = translated })


private pure func translate_pattern_argument(
	opaques: List[Checked.CheckedOpaque],
	argument: Checked.CheckedPatternArgument,
	substitution: List[TypeSubstitution[TypeRef]],
	unions: List[UnionInstance],
	records: List[RecordInstance],
	span: Span,
) -> Result[ConcretePatternArgument, Diagnostic]:
	match argument:
		Checked.BorrowPlace(place):
			match translate_place(opaques, place, substitution, unions, records, span):
				Ok(concrete): Ok(BorrowPlace(concrete))
				Err(error): Err(error)
		Checked.CopyListSuffix(place, skipped):
			match translate_place(opaques, place, substitution, unions, records, span):
				Ok(concrete): Ok(CopyListSuffix(concrete, skipped))
				Err(error): Err(error)


private pure func translate_selection(
	opaques: List[Checked.CheckedOpaque],
	selection: Checked.CheckedSelection,
	substitution: List[TypeSubstitution[TypeRef]],
	unions: List[UnionInstance],
	records: List[RecordInstance],
	span: Span,
) -> Result[ConcreteSelection, Diagnostic]:
	nodes ?= translated_list(selection.nodes, pure func(node: Checked.CheckedDecisionNode) -> Result[ConcreteDecisionNode, Diagnostic]:
		match node:
			Checked.EnterArm(id, arguments):
				match translated_list(arguments, pure func(argument: Checked.CheckedPatternArgument) -> Result[ConcretePatternArgument, Diagnostic]: translate_pattern_argument(opaques, argument, substitution, unions, records, span)):
					Ok(values): Ok(EnterArm(id, values))
					Err(error): Err(error)
			Checked.TestListLength(place, test, yes, no):
				match translate_place(opaques, place, substitution, unions, records, span):
					Ok(concrete): Ok(TestListLength(concrete, test, yes, no))
					Err(error): Err(error)
			Checked.TestStringBytes(place, bytes, yes, no):
				match translate_place(opaques, place, substitution, unions, records, span):
					Ok(concrete): Ok(TestStringBytes(concrete, bytes, yes, no))
					Err(error): Err(error)
			Checked.TestVariant(place, id, yes, no):
				match translate_place(opaques, place, substitution, unions, records, span):
					Err(error): Err(error)
					Ok(concrete_place):
						match concrete_union_owner(concrete_place.value_type, span):
							Err(error): Err(error)
							Ok(owner):
								match translate_variant(id, owner, unions, span):
									Ok(variant): Ok(TestVariant(concrete_place, variant, yes, no))
									Err(error): Err(error)
	)
	Ok({ nodes = nodes, entry = selection.entry })


-- A non-tail match specializes exactly as the tail match does, arm by arm.
private pure func translate_join(
	opaques: List[Checked.CheckedOpaque],
	join: Checked.CheckedJoin,
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
	span: Span,
) -> Result[ConcreteJoin, Diagnostic]:
	scrutinee ?= translate_expr(opaques, join.scrutinee, substitution, callables, keys, unions, records)
	selected ?= translate_selection(opaques, join.selection, substitution, unions, records, span)
	var arms: List[ConcreteJoinArm] = []
	var failure: Option[Diagnostic] = None
	for arm in join.arms:
		match translate_join_arm(opaques, arm, substitution, callables, keys, unions, records, span):
			Err(error):
				failure = Some(error)
				break
			Ok(translated):
				arms = arms.append(translated)
	match failure:
		Some(error): Err(error)
		None: Ok({ scrutinee = scrutinee, selection = selected, arms = arms, carried = join.carried })


private pure func translate_join_arm(
	opaques: List[Checked.CheckedOpaque],
	arm: Checked.CheckedJoinArm,
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
	span: Span,
) -> Result[ConcreteJoinArm, Diagnostic]:
	statements ?= translate_statements(opaques, arm.statements, substitution, callables, keys, unions, records)
	value ?= translate_expr(opaques, arm.value, substitution, callables, keys, unions, records)
	Ok({ id = arm.id, inputs = arm.inputs, statements = statements, value = value })


private pure func translate_exit(
	opaques: List[Checked.CheckedOpaque],
	exit: Checked.CheckedExit,
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[ConcreteExit, Diagnostic]:
	match exit:
		Checked.ReturnExpression(value):
			match translate_expr(opaques, value, substitution, callables, keys, unions, records):
				Ok(concrete): Ok(ReturnExpression(concrete))
				Err(error): Err(error)
		Checked.RecurWith(arguments, span):
			match translate_exprs(opaques, arguments, substitution, callables, keys, unions, records):
				Ok(concrete): Ok(RecurWith(concrete, span))
				Err(error): Err(error)


private pure func admit_scalar_type(
	value_type: TypeRef,
	span: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	plan ?= value_ownership(value_type, unions, records)
	match plan:
		NoOwnership: Ok(void)
		_: Err(diagnostic(span, "managed values in @tail_recursive functions are not supported yet", "use an unmanaged helper, or remove @tail_recursive"))


private pure func admit_scalar_binding(
	id: Checked.BindingId,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	binding ?= bindings.get(Checked.binding_number(id)).to_result(ownership_error("invalid binding identity in scalar admission"))
	admit_scalar_type(binding.value_type, binding.span, unions, records)


private pure func admit_scalar_values(
	values: List[ConcreteExpr],
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for value in values:
		admitted = admit_scalar_value(value, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


private pure func admit_scalar_fields(
	fields: List[ConcreteRecordField],
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for field in fields:
		admitted = admit_scalar_value(field.value, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


private pure func admit_scalar_value(
	value: ConcreteExpr,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	children ?= match value.form:
		ConstructVariant(_, values): admit_scalar_values(values, bindings, unions, records)
		ConstructList(values): admit_scalar_values(values, bindings, unions, records)
		ConstructRecord(_, fields): admit_scalar_fields(fields, bindings, unions, records)
		UpdateRecord(_, update): admit_scalar_update(update, bindings, unions, records)
		InvokeFunction(_, arguments): admit_scalar_values(arguments, bindings, unions, records)
		ReadRecordField(receiver, _): admit_scalar_value(receiver, bindings, unions, records)
		Match(join): admit_scalar_value(join.scrutinee, bindings, unions, records)
		LiteralVoid | LiteralInteger(_) | LiteralFloat(_) | LiteralString(_) | ReadBinding(_): Ok(void)
	span = match value.form:
		InvokeFunction(call, _): call.span
		_: value.span
	parent: Void ?= match value.form:
		-- Binding aliases do not define a value in Lower. Parameters and captures
		-- have already been admitted at their actual defining origins.
		ReadBinding(_): Ok(void)
		_: admit_scalar_type(value.value_type, span, unions, records)
	match value.form:
		Match(join): admit_scalar_join(join, bindings, unions, records)
		_: Ok(void)


private pure func admit_scalar_update(
	update: ConcreteRecordUpdate,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	base ?= admit_scalar_value(update.base, bindings, unions, records)
	replaced ?= admit_scalar_fields(update.replacements, bindings, unions, records)
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for field in update.inherited:
		admitted = admit_scalar_type(field.value_type, update.base_expression_span, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


private pure func admit_scalar_statements(
	statements: List[ConcreteStatement],
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for statement in statements:
		admitted = match statement:
			InitializeBinding(_, value): admit_scalar_value(value, bindings, unions, records)
			ReassignBinding(_, value): admit_scalar_value(value, bindings, unions, records)
			DiscardExpression(value): admit_scalar_value(value, bindings, unions, records)
			RunWhile(loop):
				match admit_scalar_value(loop.condition, bindings, unions, records):
					Err(error): Err(error)
					Ok(_): admit_scalar_statements(loop.body, bindings, unions, records)
			BreakSourceLoop(_) | ContinueSourceLoop(_): Ok(void)
			RunFor(loop):
				iteration: Result[Void, Diagnostic] = match loop.iteration:
					ListIteration(iterable, _, _):
						-- The iteration cursor owns list storage even when its source is
						-- a binding alias, so scalar TCO cannot admit that hidden root.
						match admit_scalar_value(iterable, bindings, unions, records):
							Err(error): Err(error)
							Ok(_): admit_scalar_type(iterable.value_type, iterable.span, unions, records)
					AscendingIntRange(start, end, _):
						match admit_scalar_value(start, bindings, unions, records):
							Err(error): Err(error)
							Ok(_): admit_scalar_value(end, bindings, unions, records)
				match iteration:
					Err(error): Err(error)
					Ok(_): admit_scalar_statements(loop.body, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


private pure func admit_scalar_exit(
	exit: ConcreteExit,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match exit:
		ReturnExpression(value): admit_scalar_value(value, bindings, unions, records)
		RecurWith(arguments, _): admit_scalar_values(arguments, bindings, unions, records)


private pure func admit_scalar_arm(
	inputs: List[Checked.BindingId],
	statements: List[ConcreteStatement],
	exit: ConcreteExit,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for id in inputs:
		admitted = admit_scalar_binding(id, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	captures ?= admitted
	prefix ?= admit_scalar_statements(statements, bindings, unions, records)
	admit_scalar_exit(exit, bindings, unions, records)


private pure func admit_scalar_join(
	join: ConcreteJoin,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for binding in join.carried:
		admitted = admit_scalar_binding(binding, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	carriers ?= admitted
	var checked_arms: Result[Void, Diagnostic] = Ok(void)
	for arm in join.arms:
		checked_arms = admit_scalar_arm(arm.inputs, arm.statements, ReturnExpression(arm.value), bindings, unions, records)
		match checked_arms:
			Err(_): break
			Ok(_): void
	checked_arms


private pure func admit_scalar_function(
	function: ConcreteFunction,
	annotation: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for value_type in function.signature.parameters.append(function.signature.return_type):
		admitted = admit_scalar_type(value_type, annotation, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	signature ?= admitted
	prefix ?= admit_scalar_statements(function.statements, function.bindings, unions, records)
	match function.body:
		ConcreteValueBody(exit): admit_scalar_exit(exit, function.bindings, unions, records)
		ConcreteMatchBody(matched): admit_scalar_match(matched, function.bindings, unions, records)


private pure func admit_scalar_match(
	matched: ConcreteMatch,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	scrutinee ?= admit_scalar_value(matched.scrutinee, bindings, unions, records)
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for arm in matched.arms:
		admitted = admit_scalar_arm(arm.inputs, arm.statements, arm.body, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


-- Eligibility only: this does not re-establish checking's source/whole-program
-- invariants. Production calls it once, after all concrete layouts are sealed.
pure func admit_scalar_loop(
	function: ConcreteFunction,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match function.execution:
		OrdinaryCalls: Ok(void)
		SelfTailLoop(annotation): admit_scalar_function(function, annotation, unions, records)

private fixed record TranslatedParameters {
	parameters: List[TypeRef],
	bindings: List[ConcreteBinding],
	translation: TranslationBindings
}


private pure func translate_parameters(
	opaques: List[Checked.CheckedOpaque],
	function: SelectedBody,
	key: InstanceKey,
	substitution: List[TypeSubstitution[TypeRef]],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[TranslatedParameters, Diagnostic]:
	span = function.return_type.span
	var parameters: List[TypeRef] = []
	var appended: List[ConcreteBinding] = []
	var callable_bindings: List[CallableBinding] = []
	var capture: CaptureBinding = NoCaptureBinding
	var data_positions: List[Int] = []
	var written_position = 0
	var failure: Option[Diagnostic] = None
	match key.body:
		Checked.DeclaredBody(_): void
		Checked.LambdaBody(id):
			match function.captures.is_empty():
				True: void
				False:
					match find_record_instance(records, { origin = CaptureEnvironment(id), arguments = key.arguments }):
						None: failure = Some(invalid(span, "missing lambda capture layout"))
						Some(owner):
							binding = Checked.binding_id(function.bindings.length())
							capture = LambdaCaptureBinding(id, owner, binding)
							parameters = parameters.append(RecordType(owner))
							appended = appended.append({ origin = Checked.ParameterBinding(0), value_type = RecordType(owner), span = span })

	for written in function.parameters:
		if failure.is_some():
			break
		match written.value_type:
			Checked.PureCallableType(_, _):
				parameter = Checked.callable_parameter(function.root, written_position)
				match callable_choice(key.callables, parameter, written.span):
					Err(error): failure = Some(error)
					Ok(choice):
						match choice.storage:
							ErasedCallable: void
							EnvironmentCallable(owner):
								binding = Checked.binding_id(IntOps.add(function.bindings.length(), appended.length()))
								appended = appended.append({ origin = Checked.ParameterBinding(parameters.length()), value_type = RecordType(owner), span = written.span })
								callable_bindings = callable_bindings.append({ parameter = parameter, binding = binding })
								parameters = parameters.append(RecordType(owner))
			_:
				match concrete_type(opaques, written.value_type, substitution, unions, written.span, records):
					Err(error): failure = Some(error)
					Ok(value_type):
						data_positions = data_positions.append(parameters.length())
						parameters = parameters.append(value_type)
		written_position = IntOps.add(written_position, 1)

	ready: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	var bindings: List[ConcreteBinding] = []
	for binding in function.bindings:
		origin_result: Result[Checked.BindingOrigin, Diagnostic] = match binding.origin:
			Checked.ParameterBinding(position):
				data_positions.get(position).to_result(invalid(binding.span, "missing runtime parameter ordinal"))
					.map(pure func(runtime_position): Checked.ParameterBinding(runtime_position))
			_: Ok(binding.origin)
		match origin_result:
			Err(error):
				failure = Some(error)
				break
			Ok(origin):
				match concrete_type(opaques, binding.value_type, substitution, unions, binding.span, records):
					Err(error):
						failure = Some(error)
						break
					Ok(value_type): bindings = bindings.append({ origin = origin, value_type = value_type, span = binding.span })
	match failure:
		Some(error): Err(error)
		None: Ok({
			parameters = parameters,
			bindings = bindings.concat(appended),
			translation = { callables = key.callables, callable_bindings = callable_bindings, capture = capture }
		})


private pure func translate_match_arm(
	opaques: List[Checked.CheckedOpaque],
	arm: Checked.CheckedArm,
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
) -> Result[ConcreteArm, Diagnostic]:
	statements ?= translate_statements(opaques, arm.statements, substitution, callables, keys, unions, records)
	body ?= translate_exit(opaques, arm.body, substitution, callables, keys, unions, records)
	Ok({ id = arm.id, inputs = arm.inputs, statements = statements, body = body })


private pure func translate_match(
	opaques: List[Checked.CheckedOpaque],
	matched: Checked.CheckedMatch,
	substitution: List[TypeSubstitution[TypeRef]],
	callables: TranslationBindings,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
	span: Span,
) -> Result[ConcreteMatch, Diagnostic]:
	scrutinee ?= translate_expr(opaques, matched.scrutinee, substitution, callables, keys, unions, records)
	selected ?= translate_selection(opaques, matched.selection, substitution, unions, records, span)
	arms ?= translated_list(matched.arms, pure func(arm: Checked.CheckedArm) -> Result[ConcreteArm, Diagnostic]:
		translate_match_arm(opaques, arm, substitution, callables, keys, unions, records)
	)
	Ok({ scrutinee = scrutinee, selection = selected, arms = arms })


private pure func translate_function(
	opaques: List[Checked.CheckedOpaque],
	function: SelectedBody,
	key: InstanceKey,
	keys: List[FunctionRequest],
	unions: List[UnionInstance],
	records: List[RecordInstance],
	union_layouts: List[ConcreteUnion],
	record_layouts: List[ConcreteRecord],
) -> Result[ConcreteFunction, Diagnostic]:
	span = function.return_type.span
	substitution ?= parameter_substitution(
		function.type_parameters,
		key.arguments,
		Checked.FunctionDeclaration(function.root),
		span,
	)

	runtime ?= translate_parameters(opaques, function, key, substitution, unions, records)
	parameters = runtime.parameters
	bindings = runtime.bindings
	translation = runtime.translation

	return_type ?= concrete_type(
		opaques,
		function.return_type.value_type,
		substitution,
		unions,
		function.return_type.span,
		records,
	)

	statements ?= translate_statements(opaques, function.statements, substitution, translation, keys, unions, records)

	body_result: Result[ConcreteBody, Diagnostic] = match function.body:
		Checked.CheckedValueBody(value):
			match translate_exit(opaques, value, substitution, translation, keys, unions, records):
				Ok(concrete): Ok(ConcreteValueBody(concrete))
				Err(error): Err(error)
		Checked.CheckedMatchBody(matched):
			match translate_match(opaques, matched, substitution, translation, keys, unions, records, span):
				Ok(concrete): Ok(ConcreteMatchBody(concrete))
				Err(error): Err(error)

	body ?= body_result
	concrete: ConcreteFunction = {
		execution = function.execution,
		signature = {
			parameters = parameters,
			return_type = return_type
		},
		bindings = bindings,
		statements = statements,
		body = body,
	}
	admitted ?= admit_scalar_loop(concrete, union_layouts, record_layouts)

	Ok(concrete)


pure func specialize(program: CheckedProgram) -> Result[SpecializedProgram, Diagnostic]:
	checked = checked_functions(program)
	-- Checked entrypoint identity is the only root. Requests discover complete
	-- callees and layouts before this local builder freezes into the concrete program.
	initial: PreparedInstances = {
		functions = [
			{
				key = {
					body = Checked.DeclaredBody(entry_function(checked.entrypoint)),
					arguments = [],
					callables = []
				},
				source = EntrypointRoot
			},
		],
		unions = [],
		records = []
	}
	expanded ?= expand_instances(checked, initial)
	sealed_unions ?= seal_unions(expanded.unions)
	sealed_records ?= seal_records(expanded.records)
	prepared: SealedInstances = { functions = expanded.functions, unions = sealed_unions, records = sealed_records }
	union_layouts = prepared.unions.map(pure func(instance: UnionInstance): instance.layout)
	record_layouts = prepared.records.map(pure func(instance: RecordInstance): instance.layout)
	functions ?= translated_list(prepared.functions, pure func(
		request: FunctionRequest,
	) -> Result[ConcreteFunction, Diagnostic]:
		match selected_body(checked, request.key.body, request.source):
			Err(error): Err(error)
			Ok(function):
				translate_function(
					checked.opaques,
					function,
					request.key,
					prepared.functions,
					prepared.unions,
					prepared.records,
					union_layouts,
					record_layouts,
				)
	)
	entrypoint ?= find_instance(
		prepared.functions,
		{
			body = Checked.DeclaredBody(entry_function(checked.entrypoint)),
			arguments = [],
			callables = []
		},
	).to_result(
		invalid(
			{
				source = compiler_source(),
				start = 0,
				end = 0
			},
			"missing entrypoint instance",
		),
	)

	accepted: Entrypoint[FunctionInstanceId] = match checked.entrypoint:
		NoArguments(_, result):
			NoArguments(entrypoint, result)
		WithArguments(_, result):
			WithArguments(entrypoint, result)

	Ok(into_opaque SpecializedProgram({
				records = record_layouts,
				unions = union_layouts,
				functions = functions,
				entrypoint = accepted
			}))
