import:
	result: Result methods
	bool: not, and, or
	../namespace/builtins as Builtins:
		DesignatedBoolean,
		DesignatedOption,
		DesignatedResult,
		PrimitiveType(BuiltinInt, BuiltinFloat, BuiltinString, BuiltinVoid),
		RuntimeOperation(
			FloatCopySign, FloatEquals, FloatLessThan,
			IntAdd, IntSubtract, IntMultiply, IntDivide, IntRemainder, IntToString, StringLength, StringConcat, StringAppendInt,
			StringPrint, StringPrintError, StringParseInt, StringParseFloat, ListRepeat, ListLength, ListGet, ListAppend, ListSet, ListConcat, StringEquals,
			StringByteAt, StringFromCodepoint, StringSlice, GetCurrentDirectory, ReadFile, WriteFile, RunToFiles,
			IntEquals, IntLessThan, FloatAdd, FloatSubtract, FloatMultiply, FloatDivide, FloatRemainder,
			FloatToString,
		),
		RuntimeType(PrimitiveRuntimeType, ElementRuntimeType, ListRuntimeType, StringListRuntimeType),
		RuntimeResult(ValueResult, OptionalResult, ResultResult, BooleanResult),
		runtime_contract,
	../check/check: CheckedProgram, checked_functions
	../check/model as Checked
	../check/declarations as Declarations
	../utils/ids as Declaration
	./indexed_list: IndexedList, append_entry, empty_indexed_list, find_position
	int: Int methods
	option: Option methods
	../utils/source: FunctionLabel, lambda_label
	../utils/syntax:
		Diagnostic,
		DiagnosticNote(UnionPayloadDeclaration),
		Entrypoint(NoArguments, WithArguments),
		FunctionExecution(OrdinaryCalls, SelfTailLoop),
		Span,
		compiler_span,
		entry_function,
		diagnostic,
		internal_error,
	../utils/text: concat


-- Instance identities are issued only by this compilation's specialization builder.
opaque type FunctionInstanceId = Int

opaque type UnionInstanceId = Int

opaque type RecordInstanceId = Int


private fixed record FieldIdentity {
	owner: RecordInstanceId,
	position: Int
}


opaque type FieldInstanceId = FieldIdentity


private union RecordRepresentation:
	InlineRecord
	ManagedRecord


union ConcreteRecord:
	InlineFields(List[TypeRef])
	CountedFields(List[TypeRef])


pure func record_fields(layout: ConcreteRecord) -> List[TypeRef]:
	match layout:
		InlineFields(fields): fields
		CountedFields(fields): fields


private union RecordOrigin:
	DeclaredRecord(Declaration.RecordId)
	CaptureEnvironment(Checked.LambdaId)
	StructuralTuple


private record RecordKey {
	origin: RecordOrigin,
	arguments: List[TypeRef]
}


private record RecordInstance {
	key: RecordKey,
	layout: ConcreteRecord
}


private fixed record VariantIdentity {
	owner: UnionInstanceId,
	position: Int
}


opaque type VariantInstanceId = VariantIdentity


private fixed record VariantFieldIdentity {
	variant: VariantInstanceId,
	position: Int
}


opaque type VariantFieldInstanceId = VariantFieldIdentity


pure func variant_field_variant(id: VariantFieldInstanceId) -> VariantInstanceId:
	from_opaque VariantFieldInstanceId(id).variant


pure func variant_field_number(id: VariantFieldInstanceId) -> Int:
	from_opaque VariantFieldInstanceId(id).position


pure func variant_field(
	id: VariantInstanceId,
	position: Int,
	unions: List[ConcreteUnion],
	span: Span,
) -> Result[VariantFieldInstanceId, Diagnostic]:
	layout ?= unions.get(union_number(variant_owner(id))).to_result(internal_error(span, "unknown variant owner"))
	fields ?= union_variants(layout).get(variant_number(id)).to_result(internal_error(span, "unknown variant identity"))
	valid ?= fields.get(position).to_result(internal_error(span, "unknown variant field"))
	Ok(into_opaque VariantFieldInstanceId({ variant = id, position = position }))


union TypeRef:
	VoidType
	IntType
	FloatType
	StringType
	ListType(TypeRef)
	CallableType(List[TypeRef], TypeRef)
	RecordType(RecordInstanceId)
	UnionType(UnionInstanceId)


-- A union naming itself as a payload has no finite inline storage, so every
-- value of it is a counted heap node and the self payload is a pointer edge.
private union UnionRepresentation:
	InlineUnmanaged
	InlineOwningPayload
	BoxedRecursive


-- Complete storage; the case is derived once from every child. A
-- BoxedCases layout's own instance appears among its payloads.
union ConcreteUnion:
	PlainCases(List[List[TypeRef]])
	OwningCases(List[List[TypeRef]])
	BoxedCases(List[List[TypeRef]])


pure func union_variants(layout: ConcreteUnion) -> List[List[TypeRef]]:
	match layout:
		PlainCases(variants): variants
		OwningCases(variants): variants
		BoxedCases(variants): variants


record FunctionSignature {
	parameters: List[TypeRef],
	return_type: TypeRef
}


union CallTarget:
	UserFunction(FunctionInstanceId)
	RuntimeFunction(RuntimeOperation[VariantInstanceId, TypeRef])


record ConcreteCall {
	target: CallTarget,
	span: Span
}


private pure func primitive_ref(value_type: PrimitiveType) -> TypeRef:
	match value_type:
		BuiltinVoid:
			VoidType
		BuiltinInt:
			IntType
		BuiltinFloat:
			FloatType
		BuiltinString:
			StringType


pure func runtime_type_ref(value_type: Builtins.RuntimeType[TypeRef]) -> TypeRef:
	match value_type:
		PrimitiveRuntimeType(primitive): primitive_ref(primitive)
		ElementRuntimeType(element): element
		ListRuntimeType(element): ListType(element)
		StringListRuntimeType: ListType(StringType)


pure func runtime_signature(operation: RuntimeOperation[VariantInstanceId, TypeRef]) -> FunctionSignature:
	contract = runtime_contract(operation)

	result = match contract.return_type:
		ValueResult(value_type):
			runtime_type_ref(value_type)
		OptionalResult(_, option):
			UnionType(variant_owner(option.some))
		ResultResult(_, _, constructors):
			UnionType(variant_owner(constructors.ok))
		BooleanResult(boolean):
			UnionType(variant_owner(boolean.true_variant))

	{
		parameters = contract.parameters.map(
			pure func(parameter: Builtins.RuntimeType[TypeRef]) -> TypeRef: runtime_type_ref(parameter),
		),
		return_type = result
	}


record ConcreteRecordField {
	field: FieldInstanceId,
	value: ConcreteExpr
}


record RetainedRecordField { field: FieldInstanceId, value_type: TypeRef }


record ConcreteRecordUpdate {
	base: ConcreteExpr,
	base_expression_span: Span,
	replacements: List[ConcreteRecordField],
	inherited: List[RetainedRecordField]
}


-- What an expression computes. A receiver is the first argument of its call, so
-- evaluation order is list order; a payload-free variant has no arguments.
union ConcreteForm:
	LiteralVoid
	LiteralInteger(Int)
	LiteralFloat(Float)
	LiteralString(String)
	ReadBinding(Checked.BindingId)
	ConstructVariant(VariantInstanceId, List[ConcreteExpr])
	ConstructRecord(RecordInstanceId, List[ConcreteRecordField])
	ConstructList(List[ConcreteExpr])
	Match(ConcreteJoin)
	UpdateRecord(RecordInstanceId, ConcreteRecordUpdate)
	InvokeFunction(ConcreteCall, List[ConcreteExpr])
	InvokeCallable(ConcreteExpr, List[ConcreteExpr])
	FreeCallable(FunctionInstanceId)
	CapturedCallable(FunctionInstanceId, ConcreteExpr)
	ReadRecordField(ConcreteExpr, FieldInstanceId)


-- One evaluated expression. `span` is the checked node's own occurrence span,
-- carried through unchanged. A call's callee anchor is a separate fact, the span
-- of its ConcreteCall.
record ConcreteExpr {
	form: ConcreteForm,
	value_type: TypeRef,
	span: Span
}


union ConcreteStatement:
	InitializeBinding(Checked.BindingId, ConcreteExpr)
	ReassignBinding(Checked.BindingId, ConcreteExpr)
	DiscardExpression(ConcreteExpr)
	RunWhile(ConcreteWhile)
	RunFor(ConcreteFor)
	BreakSourceLoop(Span)
	ContinueSourceLoop(Span)


record ConcreteWhile {
	condition: ConcreteExpr,
	body: List[ConcreteStatement],
	carried: List[Checked.BindingId],
	boolean: DesignatedBoolean[VariantInstanceId],
	span: Span
}


union ConcreteIteration:
	ListIteration(ConcreteExpr, TypeRef, DesignatedOption[VariantInstanceId])
	AscendingIntRange(ConcreteExpr, ConcreteExpr, DesignatedBoolean[VariantInstanceId])


record ConcreteFor {
	iteration: ConcreteIteration,
	item: Option[Checked.BindingId],
	body: List[ConcreteStatement],
	carried: List[Checked.BindingId],
	span: Span
}


record ConcretePatternPlace {
	value_type: TypeRef,
	route: ConcretePatternRoute
}


union ConcretePatternRoute:
	MatchRoot
	UnionField(ConcretePatternPlace, VariantFieldInstanceId)
	ListElement(ConcretePatternPlace, Int)
	RecordField(ConcretePatternPlace, FieldInstanceId)


union ConcretePatternArgument:
	BorrowPlace(ConcretePatternPlace)
	CopyListSuffix(ConcretePatternPlace, Int)


union ConcreteDecisionNode:
	TestVariant(ConcretePatternPlace, VariantInstanceId, Checked.DecisionNodeId, Checked.DecisionNodeId)
	EnterArm(Checked.MatchArmId, List[ConcretePatternArgument])
	TestListLength(ConcretePatternPlace, Checked.ListLengthTest, Checked.DecisionNodeId, Checked.DecisionNodeId)
	TestStringBytes(ConcretePatternPlace, String, Checked.DecisionNodeId, Checked.DecisionNodeId)


record ConcreteSelection {
	nodes: List[ConcreteDecisionNode],
	entry: Checked.DecisionNodeId
}


record ConcreteArm {
	id: Checked.MatchArmId,
	inputs: List[Checked.BindingId],
	statements: List[ConcreteStatement],
	body: ConcreteExit
}


record ConcreteMatch {
	scrutinee: ConcreteExpr,
	selection: ConcreteSelection,
	arms: List[ConcreteArm]
}


union ConcreteExit:
	ReturnExpression(ConcreteExpr)
	RecurWith(List[ConcreteExpr], Span)


-- An arm of a bound or statement match, yielding `value` to the join.
record ConcreteJoinArm {
	id: Checked.MatchArmId,
	inputs: List[Checked.BindingId],
	statements: List[ConcreteStatement],
	value: ConcreteExpr
}


record ConcreteJoin {
	scrutinee: ConcreteExpr,
	selection: ConcreteSelection,
	arms: List[ConcreteJoinArm],
	carried: List[Checked.BindingId]
}


union ConcreteBody:
	ConcreteValueBody(ConcreteExit)
	ConcreteMatchBody(ConcreteMatch)


record ConcreteFunction {
	-- A debugging annotation in generated C, never semantics.
	label: FunctionLabel,
	execution: FunctionExecution,
	signature: FunctionSignature,
	bindings: List[ConcreteBinding],
	statements: List[ConcreteStatement],
	body: ConcreteBody
}


record SpecializedContents {
	records: List[ConcreteRecord],
	unions: List[ConcreteUnion],
	functions: List[ConcreteFunction],
	entrypoint: Entrypoint[FunctionInstanceId]
}


opaque type SpecializedProgram = SpecializedContents


pure func record_number(id: RecordInstanceId) -> Int:
	from_opaque RecordInstanceId(id)


pure func field_owner(id: FieldInstanceId) -> RecordInstanceId:
	from_opaque FieldInstanceId(id).owner


pure func field_number(id: FieldInstanceId) -> Int:
	from_opaque FieldInstanceId(id).position


pure func union_number(id: UnionInstanceId) -> Int:
	from_opaque UnionInstanceId(id)


pure func variant_owner(id: VariantInstanceId) -> UnionInstanceId:
	from_opaque VariantInstanceId(id).owner


pure func variant_number(id: VariantInstanceId) -> Int:
	from_opaque VariantInstanceId(id).position


pure func same_type(left: TypeRef, right: TypeRef) -> Bool:
	match left:
		CallableType(parameters, result):
			match right:
				CallableType(others, other):
					match same_elements(parameters, others, same_type):
						True: same_type(result, other)
						False: False
				_: False
		ListType(left_element):
			match right:
				ListType(right_element):
					same_type(left_element, right_element)
				_:
					False
		RecordType(left_record):
			match right:
				RecordType(right_record):
					record_number(left_record) == record_number(right_record)
				_:
					False
		VoidType:
			match right:
				VoidType:
					True
				_:
					False
		IntType:
			match right:
				IntType:
					True
				_:
					False
		FloatType:
			match right:
				FloatType:
					True
				_:
					False
		StringType:
			match right:
				StringType:
					True
				_:
					False
		UnionType(left_union):
			match right:
				UnionType(right_union):
					union_number(left_union) == union_number(right_union)
				_:
					False


pure func function_number(id: FunctionInstanceId) -> Int:
	from_opaque FunctionInstanceId(id)


pure func specialized_contents(program: SpecializedProgram) -> SpecializedContents:
	from_opaque SpecializedProgram(program)


record ConcreteBinding {
	origin: Checked.BindingOrigin,
	value_type: TypeRef,
	span: Span
}


private union CallableStorage:
	ErasedCallable
	EnvironmentCallable(RecordInstanceId)


private record KnownCallable {
	parameter: Checked.CallableParameterId,
	body: Checked.BodyOwner,
	arguments: List[Checked.TypeRef],
	storage: CallableStorage
}


private union CallableMode:
	StaticCallable(KnownCallable)
	RuntimeCallable(Checked.CallableParameterId)


-- Lambda arguments substitute its genuine root parameters; callable choices stay ordered.
private record InstanceKey {
	body: Checked.BodyOwner,
	arguments: List[Checked.TypeRef],
	callables: List[CallableMode]
}


-- A declaration parameter and its physical replacement while layouts are prepared.
private record TypeSubstitution[T] {
	parameter: Checked.TypeParameterId,
	value_type: T
}


private pure func missing_body(source: RequestSource, message: String) -> Diagnostic:
	span = match source:
		ConcreteRequest(span): span
		EntrypointRoot:
			compiler_span()
	internal_error(span, message)


-- Project the published storage fact, without rediscovering managed children.
-- Raw ownership verification additionally checks supplied layout consistency.
pure func value_needs_ownership(
	type_ref: TypeRef,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Bool, Diagnostic]:
	match type_ref:
		VoidType | IntType | FloatType:
			Ok(False)
		StringType | ListType(_) | CallableType(_, _):
			Ok(True)
		RecordType(id):
			match records.get(record_number(id)):
				None:
					Err(internal_error(compiler_span(), "invalid record identity in ownership representation"))
				Some(declaration):
					match declaration:
						InlineFields(_): Ok(False)
						CountedFields(_): Ok(True)
		UnionType(id):
			match unions.get(union_number(id)):
				None:
					Err(internal_error(compiler_span(), "invalid union identity in ownership representation"))
				Some(declaration):
					match declaration:
						PlainCases(_): Ok(False)
						OwningCases(_) | BoxedCases(_): Ok(True)


private pure func translated_list[T, U](
	values: List[T],
	translate: pure (T) -> Result[U, Diagnostic],
) -> Result[List[U], Diagnostic]:
	var translated: List[U] = []
	var failure: Option[Diagnostic] = None

	for value in values:
		match translate(value):
			Ok(translated_value):
				translated = translated.append(translated_value)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(translated)


private pure func same_record_origin(left: RecordOrigin, right: RecordOrigin) -> Bool:
	match left:
		DeclaredRecord(id):
			match right:
				DeclaredRecord(other): Declaration.record_number(id) == Declaration.record_number(other)
				_: False
		StructuralTuple:
			match right:
				StructuralTuple: True
				_: False
		CaptureEnvironment(id):
			match right:
				CaptureEnvironment(other): Checked.lambda_number(id) == Checked.lambda_number(other)
				_: False


-- A structural tuple instantiates no declaration; its digest is this base less
-- its arity, which equality compares. That is negative, so it never meets the
-- non-negative number of a declaration.
private TUPLE_DIGEST_BASE: Int = -1


-- Indexes a record by the number of what it instantiates, which origin equality
-- compares, or by arity for a tuple. Numbers of different kinds may coincide:
-- the full key then decides. Equality also compares the argument count.
private pure func record_digest(origin: RecordOrigin, argument_count: Int) -> Int:
	match origin:
		DeclaredRecord(id): Declaration.record_number(id)
		CaptureEnvironment(id): Checked.lambda_number(id)
		StructuralTuple: TUPLE_DIGEST_BASE.subtract(argument_count)


-- Indexes a union by its declaration number, which key equality compares.
private pure func union_digest(declaration: Declaration.UnionId) -> Int:
	Declaration.union_number(declaration)


-- The position of the entry under `digest` that `matches`. An index naming a
-- missing entry has diverged from its list: an internal error.
private pure func indexed_position[T](
	table: IndexedList[T], digest: Int, span: Span, matches: pure (T) -> Bool,
) -> Result[Option[Int], Diagnostic]:
	match find_position(table, digest, matches):
		Ok(found): Ok(found)
		Err(_): Err(internal_error(span, "specialization index names a missing instance"))


private pure func find_record_instance(
	records: IndexedList[RecordInstance],
	key: RecordKey,
	span: Span,
) -> Result[Option[RecordInstanceId], Diagnostic]:
	found ?= indexed_position(records, record_digest(key.origin, key.arguments.length()), span, pure func(instance: RecordInstance) -> Bool:
		and(same_record_origin(instance.key.origin, key.origin), same_elements(instance.key.arguments, key.arguments, same_type))
	)
	Ok(found.map(pure func(position: Int) -> RecordInstanceId: into_opaque RecordInstanceId(position)))


private pure func concrete_record_field_type(
	field: Checked.FieldId,
	owner: RecordInstanceId,
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[TypeRef, Diagnostic]:
	instance ?= records.entries.get(record_number(owner)).to_result(internal_error(span, "unknown concrete record"))
	_: Void ?= if same_record_origin(instance.key.origin, DeclaredRecord(Checked.field_owner(field))):
		Ok(void)
	else:
		Err(internal_error(span, "field declaration differs from concrete record"))
	record_fields(instance.layout)
		.get(Checked.field_number(field))
		.to_result(internal_error(span, "unknown record field"))


private pure func translate_field(
	field: Checked.FieldId,
	owner: RecordInstanceId,
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[FieldInstanceId, Diagnostic]:
	valid ?= concrete_record_field_type(field, owner, records, span)
	Ok(into_opaque FieldInstanceId({ owner = owner, position = Checked.field_number(field) }))


-- The prepared instance of a record declaration at these checked type arguments.
private pure func concrete_record(
	opaques: List[Checked.CheckedOpaque],
	declaration: Declaration.RecordId,
	arguments: List[Checked.TypeRef],
	substitution: Declarations.Substitution,
	unions: IndexedList[UnionInstance],
	span: Span,
	records: IndexedList[RecordInstance],
) -> Result[RecordInstanceId, Diagnostic]:
	concrete ?= concrete_types(opaques, arguments, substitution, unions, span, records)
	lookup_record_instance(declaration, concrete, records, span)


-- The prepared instance for a declaration at concrete type arguments.
private pure func lookup_record_instance(
	declaration: Declaration.RecordId,
	arguments: List[TypeRef],
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[RecordInstanceId, Diagnostic]:
	found ?= find_record_instance(records, { origin = DeclaredRecord(declaration), arguments = arguments }, span)
	found.to_result(internal_error(span, "unprepared record instance"))


-- A record construction's instance: the declaration its form names, at the type
-- arguments of its checked type, which checking derived from that declaration.
private pure func record_instance(
	opaques: List[Checked.CheckedOpaque],
	declaration: Declaration.RecordId,
	value: Checked.CheckedExpr,
	substitution: Declarations.Substitution,
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[RecordInstanceId, Diagnostic]:
	match value.value_type:
		Checked.NominalType(Checked.AggregateNominal(Checked.RecordAggregate(_)), arguments):
			concrete_record(opaques, declaration, arguments, substitution, unions, value.span, records)
		_:
			Err(internal_error(value.span, "record construction has a non-record type"))


private pure func concrete_types(
	opaques: List[Checked.CheckedOpaque],
	arguments: List[Checked.TypeRef],
	substitution: Declarations.Substitution,
	unions: IndexedList[UnionInstance],
	span: Span,
	records: IndexedList[RecordInstance],
) -> Result[List[TypeRef], Diagnostic]:
	var concrete: List[TypeRef] = []
	var failure: Option[Diagnostic] = None

	for argument in arguments:
		match concrete_type(opaques, argument, substitution, unions, span, records):
			Ok(value):
				concrete = concrete.append(value)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(concrete)


private pure func concrete_type(
	opaques: List[Checked.CheckedOpaque],
	value_type: Checked.TypeRef,
	substitution: Declarations.Substitution,
	unions: IndexedList[UnionInstance],
	span: Span,
	records: IndexedList[RecordInstance],
) -> Result[TypeRef, Diagnostic]:
	match value_type:
		-- The arguments close in the enclosing substitution; the underlying type
		-- then expands in the opaque declaration's own.
		Checked.NominalType(Checked.OpaqueNominal(id), arguments):
			match opaques.get(Declaration.opaque_number(id)):
				Some(declaration):
					match semantic_arguments(arguments, substitution, span):
						Err(error): Err(error)
						Ok(closed):
							concrete_type(opaques, declaration.underlying_type.value_type, { owner = Checked.OpaqueDeclaration(id), values = closed }, unions, span, records)
				None: Err(internal_error(span, "unknown opaque declaration"))
		Checked.CallableType(_, parameters, result):
			match concrete_types(opaques, parameters, substitution, unions, span, records):
				Err(error): Err(error)
				Ok(inputs):
					match concrete_type(opaques, result, substitution, unions, span, records):
						Err(error): Err(error)
						Ok(output):
							Ok(CallableType(inputs, output))
		Checked.VoidType:
			Ok(VoidType)
		Checked.IntType:
			Ok(IntType)
		Checked.FloatType:
			Ok(FloatType)
		Checked.StringType:
			Ok(StringType)
		Checked.TupleType(elements):
			concrete_tuple_type(opaques, elements, substitution, unions, span, records)
		Checked.ListType(element):
			match concrete_type(opaques, element, substitution, unions, span, records):
				Ok(concrete): Ok(ListType(concrete))
				Err(error): Err(error)
		Checked.NominalType(Checked.AggregateNominal(Checked.RecordAggregate(id)), arguments):
			match concrete_record(opaques, id, arguments, substitution, unions, span, records):
				Ok(owner): Ok(RecordType(owner))
				Err(error): Err(error)
		Checked.NominalType(Checked.AggregateNominal(Checked.UnionAggregate(id)), arguments):
			match concrete_types(opaques, arguments, substitution, unions, span, records):
				Ok(concrete_arguments):
					match find_union_instance(
						unions,
						{
							declaration = id,
							arguments = concrete_arguments
						},
						span,
					):
						Ok(Some(union_id)): Ok(UnionType(union_id))
						Ok(None): Err(internal_error(span, "unprepared union instance"))
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.ParameterType(id):
			match semantic_type(Checked.ParameterType(id), substitution, span):
				Err(error): Err(error)
				Ok(value): concrete_type(opaques, value, substitution, unions, span, records)


private pure func concrete_tuple_type(
	opaques: List[Checked.CheckedOpaque], elements: List[Checked.TypeRef],
	substitution: Declarations.Substitution, unions: IndexedList[UnionInstance],
	span: Span, records: IndexedList[RecordInstance],
) -> Result[TypeRef, Diagnostic]:
	arguments ?= concrete_types(opaques, elements, substitution, unions, span, records)
	found ?= find_record_instance(records, { origin = StructuralTuple, arguments = arguments }, span)
	owner ?= found.to_result(internal_error(span, "unprepared structural tuple instance"))
	Ok(RecordType(owner))


-- True when both lists have the same length and every pair agrees. Compares in
-- place and stops at the first mismatch.
private pure func same_elements[T, U](
	left: List[T], right: List[U], same: pure (T, U) -> Bool,
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var matches: Bool = True
		var position: Int = 0

		for value in left:
			match right.get(position):
				Some(other): matches = same(value, other)
				-- Unreachable after the length check; the match must be total.
				None: matches = False

			if matches.not():
				break

			position = position.add(1)

		matches


-- Indexes a function instance by the number of the body it instantiates, which
-- body equality compares. Numbers of different kinds may coincide: the full key
-- then decides.
private pure func body_digest(body: Checked.BodyOwner) -> Int:
	match body:
		Checked.DeclaredBody(id): Declaration.function_number(id)
		Checked.LambdaBody(id): Checked.lambda_number(id)
		Checked.DerivedEqualityBody(Checked.RecordAggregate(id)): Declaration.record_number(id)
		Checked.DerivedEqualityBody(Checked.UnionAggregate(id)): Declaration.union_number(id)


private pure func find_instance(
	keys: IndexedList[FunctionRequest],
	key: InstanceKey,
	span: Span,
) -> Result[Option[FunctionInstanceId], Diagnostic]:
	found ?= indexed_position(keys, body_digest(key.body), span, pure func(known: FunctionRequest) -> Bool:
		and(
			Checked.same_body(known.key.body, key.body),
			and(Checked.same_types(known.key.arguments, key.arguments), same_elements(known.key.callables, key.callables, same_callable_mode)),
		)
	)
	Ok(found.map(pure func(position: Int) -> FunctionInstanceId: into_opaque FunctionInstanceId(position)))


private pure func same_callable_storage(left: CallableStorage, right: CallableStorage) -> Bool:
	match left:
		ErasedCallable:
			match right:
				ErasedCallable: True
				_: False
		EnvironmentCallable(id):
			match right:
				EnvironmentCallable(other): record_number(id) == record_number(other)
				_: False


private pure func same_callable_mode(left: CallableMode, right: CallableMode) -> Bool:
	match left:
		RuntimeCallable(parameter):
			match right:
				RuntimeCallable(other): Checked.same_callable_parameter(parameter, other)
				_: False
		StaticCallable(value):
			match right:
				RuntimeCallable(_): False
				StaticCallable(other):
					match and(Checked.same_callable_parameter(value.parameter, other.parameter), Checked.same_body(value.body, other.body)):
						False: False
						True:
							match Checked.same_types(value.arguments, other.arguments):
								True: same_callable_storage(value.storage, other.storage)
								False: False


private pure func callable_mode(
	choices: List[CallableMode], parameter: Checked.CallableParameterId, span: Span,
) -> Result[CallableMode, Diagnostic]:
	var found: Option[CallableMode] = None
	for choice in choices:
		id = match choice:
			StaticCallable(known): known.parameter
			RuntimeCallable(runtime_parameter): runtime_parameter
		if Checked.same_callable_parameter(id, parameter):
			found = Some(choice)
			break
	found.to_result(internal_error(span, "missing concrete callable parameter mode"))


private pure func forward_callable(
	choices: List[CallableMode], source_parameter: Checked.CallableParameterId,
	destination_parameter: Checked.CallableParameterId, span: Span,
) -> Result[CallableMode, Diagnostic]:
	mode ?= callable_mode(choices, source_parameter, span)
	match mode:
		StaticCallable(known): Ok(StaticCallable({ known | parameter = destination_parameter }))
		RuntimeCallable(_): Ok(RuntimeCallable(destination_parameter))


private pure func validate_type_parameters(
	parameters: List[Checked.TypeParameterId], argument_count: Int,
	owner: Checked.TypeParameterOwner, span: Span,
) -> Result[Void, Diagnostic]:
	var failure: Option[Diagnostic] = None
	var position = 0
	if parameters.length() != argument_count:
		Err(internal_error(span, "type argument count differs from the declaration"))
	else:
		for parameter in parameters:
			owner_matches = Checked.same_owner(Checked.parameter_owner(parameter), owner)

			if or(
				owner_matches.not(),
				Checked.parameter_position(parameter) != position,
			):
				failure = Some(internal_error(span, "invalid declaration type parameter"))
				break

			position = position.add(1)
		match failure:
			Some(error): Err(error)
			None: Ok(void)


private pure func parameter_substitution[T](
	parameters: List[Checked.TypeParameterId], arguments: List[T],
	owner: Checked.TypeParameterOwner, span: Span,
) -> Result[List[TypeSubstitution[T]], Diagnostic]:
	valid ?= validate_type_parameters(parameters, arguments.length(), owner, span)
	var substitution: List[TypeSubstitution[T]] = []
	var failure: Option[Diagnostic] = None
	var position = 0
	for parameter in parameters:
		match arguments.get(position):
			Some(value): substitution = substitution.append({ parameter = parameter, value_type = value })
			None:
				failure = Some(internal_error(span, "missing concrete type argument"))
				break
		position = position.add(1)
	match failure:
		Some(error): Err(error)
		None: Ok(substitution)


-- Keys retain ground semantic arguments. Layout projection cannot replace this
-- authority: same-storage opaque types may select different ordinary bodies.
private pure func function_substitution(
	function: SelectedBody, arguments: List[Checked.TypeRef], span: Span,
) -> Result[Declarations.Substitution, Diagnostic]:
	owner: Checked.TypeParameterOwner = function.parameter_owner
	valid ?= validate_type_parameters(function.type_parameters, arguments.length(), owner, span)
	Ok({ owner = owner, values = arguments })


private pure func semantic_type(
	value: Checked.TypeRef, substitution: Declarations.Substitution, span: Span,
) -> Result[Checked.TypeRef, Diagnostic]:
	match Declarations.substitute_type(value, substitution, span):
		Err(_): Err(internal_error(span, "unresolved or foreign type parameter"))
		Ok(replaced):
			if contains_parameter(replaced):
				Err(internal_error(span, "unresolved or foreign type parameter"))
			else:
				Ok(replaced)


private pure func semantic_arguments(
	arguments: List[Checked.TypeRef], substitution: Declarations.Substitution, span: Span,
) -> Result[List[Checked.TypeRef], Diagnostic]:
	translated_list(arguments, pure func(value: Checked.TypeRef) -> Result[Checked.TypeRef, Diagnostic]: semantic_type(value, substitution, span))


private record UnionKey {
	declaration: Declaration.UnionId,
	arguments: List[TypeRef]
}


private record UnionInstance {
	key: UnionKey,
	layout: ConcreteUnion
}


-- A type named while a layout on the current path is still being built. A
-- pending reference carries the in-progress layout's key; it is resolved to
-- that layout's identity when the layout completes. A reader of a pending
-- reference needs only its ownership class, which membership in a recursive
-- layout group fixes: a pending union is owning, a pending record managed.
private union PartialType:
	KnownType(TypeRef)
	PendingUnionType(PartialUnionKey)
	PendingRecordType(PartialRecordKey)
	PendingListType(PartialType)
	PendingCallable(List[PartialType], PartialType)


private record PartialUnionKey {
	declaration: Declaration.UnionId,
	arguments: List[PartialType]
}


private record PartialRecordKey {
	origin: RecordOrigin,
	arguments: List[PartialType]
}


-- A layout slot of the local builder. A pending slot already has its identity
-- (its index) and representation; only references to layouts that were still
-- in progress when it completed remain unresolved, and every one of them is
-- filled when that layout completes. Sealing accepts complete slots only.
private union UnionSlot:
	CompleteUnion(UnionInstance)
	PendingUnion(PendingUnionInstance)


private record PendingUnionInstance {
	key: PartialUnionKey,
	variants: List[List[PartialType]],
	representation: UnionRepresentation
}


private union RecordSlot:
	CompleteRecord(RecordInstance)
	PendingRecord(PendingRecordInstance)


private record PendingRecordInstance {
	key: PartialRecordKey,
	fields: List[PartialType],
	representation: RecordRepresentation
}


-- The layouts whose children are being prepared, innermost last, each
-- marked once a child refers back to it.
private union InProgressLayout:
	InProgressUnion(PartialUnionKey, BackReference)
	InProgressRecord(PartialRecordKey, BackReference)


-- Whether a child prepared under an in-progress layout referred back to it,
-- leaving pending references that its completion fills. A layout no child
-- referred back to completes without revisiting any slot.
private union BackReference:
	NotReferencedBack
	ReferencedBack


private union RequestSource:
	EntrypointRoot
	ConcreteRequest(Span)


private record FunctionRequest {
	key: InstanceKey,
	source: RequestSource
}


private record PreparedType {
	value_type: PartialType,
	unions: IndexedList[UnionSlot],
	records: IndexedList[RecordSlot],
	in_progress: List[InProgressLayout]
}


private record PreparedInstances {
	functions: IndexedList[FunctionRequest],
	unions: IndexedList[UnionSlot],
	records: IndexedList[RecordSlot]
}


-- The builder after sealing: every layout complete, read by translation.
private record SealedInstances {
	functions: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance]
}


private pure func contains_parameter(value: Checked.TypeRef) -> Bool:
	match value:
		Checked.CallableType(purity, parameters, result):
			match parameters.any(contains_parameter):
				True: True
				False: contains_parameter(result)
		Checked.TupleType(elements):
			elements.any(contains_parameter)
		Checked.ListType(element):
			contains_parameter(element)
		Checked.ParameterType(_):
			True
		Checked.NominalType(_, arguments):
			arguments.any(contains_parameter)
		_:
			False


private pure func request_span(
	depends_on_caller: Bool,
	source: RequestSource,
	fallback: Span,
) -> Span:
	match source:
		ConcreteRequest(span):
			if depends_on_caller:
				span
			else:
				fallback
		EntrypointRoot:
			fallback


-- The sealed instance for a key, read by translation.
private pure func find_union_instance(
	keys: IndexedList[UnionInstance],
	key: UnionKey,
	span: Span,
) -> Result[Option[UnionInstanceId], Diagnostic]:
	found ?= indexed_position(keys, union_digest(key.declaration), span, pure func(known: UnionInstance) -> Bool:
		and(union_digest(known.key.declaration) == union_digest(key.declaration), same_elements(known.key.arguments, key.arguments, same_type))
	)
	Ok(found.map(pure func(position: Int) -> UnionInstanceId: into_opaque UnionInstanceId(position)))


private pure func same_partial_type(left: PartialType, right: PartialType) -> Bool:
	match left:
		KnownType(known):
			match right:
				KnownType(other): same_type(known, other)
				_: False
		PendingUnionType(key):
			match right:
				PendingUnionType(other): same_partial_union_key(key, other)
				_: False
		PendingRecordType(key):
			match right:
				PendingRecordType(other): same_partial_record_key(key, other)
				_: False
		PendingCallable(parameters, result):
			match right:
				PendingCallable(others, other):
					match same_elements(parameters, others, same_partial_type):
						True: same_partial_type(result, other)
						False: False
				_: False
		PendingListType(element):
			match right:
				PendingListType(other): same_partial_type(element, other)
				_: False


private pure func same_partial_union_key(left: PartialUnionKey, right: PartialUnionKey) -> Bool:
	if Declaration.union_number(left.declaration) == Declaration.union_number(right.declaration):
		same_elements(left.arguments, right.arguments, same_partial_type)
	else:
		False


private pure func same_partial_record_key(left: PartialRecordKey, right: PartialRecordKey) -> Bool:
	match same_record_origin(left.origin, right.origin):
		True: same_elements(left.arguments, right.arguments, same_partial_type)
		False: False


private pure func known_arguments(arguments: List[TypeRef]) -> List[PartialType]:
	var partial: List[PartialType] = []

	for argument in arguments:
		partial = partial.append(KnownType(argument))

	partial


-- A complete key's known argument against a request's partial one, so a
-- lookup compares in place and allocates nothing.
private pure func same_known_type(known: TypeRef, partial: PartialType) -> Bool:
	match partial:
		KnownType(other): same_type(known, other)
		_: False


private pure func slot_has_union_key(slot: UnionSlot, key: PartialUnionKey) -> Bool:
	match slot:
		CompleteUnion(instance):
			if Declaration.union_number(instance.key.declaration) == Declaration.union_number(key.declaration):
				same_elements(instance.key.arguments, key.arguments, same_known_type)
			else:
				False
		PendingUnion(instance):
			same_partial_union_key(instance.key, key)


private pure func slot_has_record_key(slot: RecordSlot, key: PartialRecordKey) -> Bool:
	match slot:
		CompleteRecord(instance):
			match same_record_origin(instance.key.origin, key.origin):
				True: same_elements(instance.key.arguments, key.arguments, same_known_type)
				False: False
		PendingRecord(instance):
			same_partial_record_key(instance.key, key)


private pure func slot_union_representation(slot: UnionSlot) -> UnionRepresentation:
	match slot:
		CompleteUnion(instance):
			match instance.layout:
				PlainCases(_): InlineUnmanaged
				OwningCases(_): InlineOwningPayload
				BoxedCases(_): BoxedRecursive
		PendingUnion(instance): instance.representation


private pure func slot_record_representation(slot: RecordSlot) -> RecordRepresentation:
	match slot:
		CompleteRecord(instance):
			match instance.layout:
				InlineFields(_): InlineRecord
				CountedFields(_): ManagedRecord
		PendingRecord(instance): instance.representation


private pure func find_union_slot(
	slots: IndexedList[UnionSlot], key: PartialUnionKey, span: Span,
) -> Result[Option[UnionInstanceId], Diagnostic]:
	found ?= indexed_position(slots, union_digest(key.declaration), span, pure func(slot: UnionSlot) -> Bool: slot_has_union_key(slot, key))
	Ok(found.map(pure func(position: Int) -> UnionInstanceId: into_opaque UnionInstanceId(position)))


private pure func find_record_slot(
	slots: IndexedList[RecordSlot], key: PartialRecordKey, span: Span,
) -> Result[Option[RecordInstanceId], Diagnostic]:
	found ?= indexed_position(slots, record_digest(key.origin, key.arguments.length()), span, pure func(slot: RecordSlot) -> Bool: slot_has_record_key(slot, key))
	Ok(found.map(pure func(position: Int) -> RecordInstanceId: into_opaque RecordInstanceId(position)))


-- The in-progress layouts with this union marked as referred back to, if
-- it is on the current path.
private pure func refer_back_to_union(layouts: List[InProgressLayout], key: PartialUnionKey) -> Option[List[InProgressLayout]]:
	var found: Option[List[InProgressLayout]] = None
	var position = 0

	for layout in layouts:
		match layout:
			InProgressUnion(other, _):
				if same_partial_union_key(other, key):
					found = Some(layouts.set(position, InProgressUnion(other, ReferencedBack)))
					break
			InProgressRecord(_, _):
				void

		position = position.add(1)

	found


private pure func refer_back_to_record(layouts: List[InProgressLayout], key: PartialRecordKey) -> Option[List[InProgressLayout]]:
	var found: Option[List[InProgressLayout]] = None
	var position = 0

	for layout in layouts:
		match layout:
			InProgressRecord(other, _):
				if same_partial_record_key(other, key):
					found = Some(layouts.set(position, InProgressRecord(other, ReferencedBack)))
					break
			InProgressUnion(_, _):
				void

		position = position.add(1)

	found


private record LeftLayout {
	remaining: List[InProgressLayout],
	back_reference: BackReference
}


-- Pops the innermost in-progress layout once its slot is published.
private pure func leave_layout(layouts: List[InProgressLayout], span: Span) -> Result[LeftLayout, Diagnostic]:
	last = layouts.length().subtract(1)
	innermost ?= layouts.get(last).to_result(internal_error(span, "layout completed outside its own preparation"))
	remaining ?= layouts.remove(last).to_result(internal_error(span, "layout completed outside its own preparation"))
	back_reference = match innermost:
		InProgressUnion(_, marked): marked
		InProgressRecord(_, marked): marked
	Ok({ remaining = remaining, back_reference = back_reference })


-- A List of a known element is itself known.
private pure func partial_list(element: PartialType) -> PartialType:
	match element:
		KnownType(known): KnownType(ListType(known))
		_: PendingListType(element)


-- Callable signatures carry no inline aggregate storage. Pending nominal children
-- resolve through the same group slots before a concrete signature is published.
private pure func partial_callable(parameters: List[PartialType], result: PartialType) -> PartialType:
	var inputs: List[TypeRef] = []
	var complete: Bool = True
	for parameter in parameters:
		match parameter:
			KnownType(value): inputs = inputs.append(value)
			_: complete = False
	match result:
		KnownType(output):
			if complete:
				KnownType(CallableType(inputs, output))
			else:
				PendingCallable(parameters, result)
		_: PendingCallable(parameters, result)


private pure func has_pending(value: PartialType) -> Bool:
	match value:
		KnownType(_): False
		PendingUnionType(key): True
		PendingRecordType(key): True
		PendingListType(element): has_pending(element)
		PendingCallable(parameters, result):
			match any_pending(parameters):
				True: True
				False: has_pending(result)


private pure func any_pending(values: List[PartialType]) -> Bool:
	var found: Bool = False

	for value in values:
		if has_pending(value):
			found = True
			break

	found


-- The layout that just completed, whose pending references now resolve.
private union CompletedLayout:
	CompletedUnion(PartialUnionKey, UnionInstanceId)
	CompletedRecord(PartialRecordKey, RecordInstanceId)


private pure func resolve_partial(value: PartialType, completed: CompletedLayout) -> PartialType:
	match value:
		KnownType(_):
			value
		PendingUnionType(key):
			match completed:
				CompletedUnion(done, id):
					if same_partial_union_key(key, done):
						KnownType(UnionType(id))
					else:
						PendingUnionType({ key | arguments = resolve_partials(key.arguments, completed) })
				CompletedRecord(_, _):
					PendingUnionType({ key | arguments = resolve_partials(key.arguments, completed) })
		PendingRecordType(key):
			match completed:
				CompletedRecord(done, id):
					if same_partial_record_key(key, done):
						KnownType(RecordType(id))
					else:
						PendingRecordType({ key | arguments = resolve_partials(key.arguments, completed) })
				CompletedUnion(_, _):
					PendingRecordType({ key | arguments = resolve_partials(key.arguments, completed) })
		PendingListType(element):
			partial_list(resolve_partial(element, completed))
		PendingCallable(parameters, result):
			partial_callable(resolve_partials(parameters, completed), resolve_partial(result, completed))


private pure func resolve_partials(values: List[PartialType], completed: CompletedLayout) -> List[PartialType]:
	var resolved: List[PartialType] = []

	for value in values:
		resolved = resolved.append(resolve_partial(value, completed))

	resolved


private pure func known_type(value: PartialType, span: Span) -> Result[TypeRef, Diagnostic]:
	match value:
		KnownType(known): Ok(known)
		_: Err(internal_error(span, "layout reference left unresolved after its group completed"))


private pure func known_types(values: List[PartialType], span: Span) -> Result[List[TypeRef], Diagnostic]:
	var known: List[TypeRef] = []
	var failure: Option[Diagnostic] = None

	for value in values:
		match known_type(value, span):
			Ok(resolved): known = known.append(resolved)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error): Err(error)
		None: Ok(known)


-- A pending union instance with no reference left becomes complete.
private pure func settle_union(instance: PendingUnionInstance, span: Span) -> Result[UnionSlot, Diagnostic]:
	var pending = any_pending(instance.key.arguments)

	for fields in instance.variants:
		pending = match pending:
			True: True
			False: any_pending(fields)

	if pending:
		Ok(PendingUnion(instance))
	else:
		match known_types(instance.key.arguments, span):
			Ok(arguments):
				var variants: List[List[TypeRef]] = []
				var failure: Option[Diagnostic] = None

				for fields in instance.variants:
					match known_types(fields, span):
						Ok(known): variants = variants.append(known)
						Err(error):
							failure = Some(error)
							break

				match failure:
					Some(error):
						Err(error)
					None:
						layout: ConcreteUnion = match instance.representation:
							InlineUnmanaged: PlainCases(variants)
							InlineOwningPayload: OwningCases(variants)
							BoxedRecursive: BoxedCases(variants)
						Ok(CompleteUnion({
							key = { declaration = instance.key.declaration, arguments = arguments },
							layout = layout,
						}))
			Err(error): Err(error)


private pure func settle_record(instance: PendingRecordInstance, span: Span) -> Result[RecordSlot, Diagnostic]:
	pending: Bool = match any_pending(instance.key.arguments):
		True: True
		False: any_pending(instance.fields)
	if pending:
		Ok(PendingRecord(instance))
	else:
		match known_types(instance.key.arguments, span):
			Ok(arguments):
				match known_types(instance.fields, span):
					Ok(fields):
						layout: ConcreteRecord = match instance.representation:
							InlineRecord: InlineFields(fields)
							ManagedRecord: CountedFields(fields)
						Ok(CompleteRecord({
							key = { origin = instance.key.origin, arguments = arguments },
							layout = layout,
						}))
					Err(error): Err(error)
			Err(error): Err(error)


-- Fills every reference to a completed layout that a child referred back
-- to. Only slots published while it was in progress, from `first` on, can
-- hold such a reference, so earlier slots are not revisited.
private pure func resolve_union_slots(
	slots: IndexedList[UnionSlot],
	first: Int,
	completed: CompletedLayout,
	span: Span,
) -> Result[IndexedList[UnionSlot], Diagnostic]:
	var resolved = slots.entries
	var position = first
	var failure: Option[Diagnostic] = None

	while and(position.less_than(resolved.length()), failure.is_some().not()):
		match resolved.get(position):
			Some(PendingUnion(instance)):
				filled: PendingUnionInstance = {
					key = { instance.key | arguments = resolve_partials(instance.key.arguments, completed) },
					variants = resolve_variants(instance.variants, completed),
					representation = instance.representation,
				}
				match settle_union(filled, span):
					Ok(slot): resolved = resolved.set(position, slot)
					Err(error): failure = Some(error)
			Some(CompleteUnion(_)):
				void
			None:
				failure = Some(internal_error(span, "union slot left its builder"))

		position = position.add(1)

	match failure:
		Some(error): Err(error)
		None: Ok({ slots | entries = resolved })


private pure func resolve_variants(variants: List[List[PartialType]], completed: CompletedLayout) -> List[List[PartialType]]:
	var resolved: List[List[PartialType]] = []

	for fields in variants:
		resolved = resolved.append(resolve_partials(fields, completed))

	resolved


private pure func resolve_record_slots(
	slots: IndexedList[RecordSlot],
	first: Int,
	completed: CompletedLayout,
	span: Span,
) -> Result[IndexedList[RecordSlot], Diagnostic]:
	var resolved = slots.entries
	var position = first
	var failure: Option[Diagnostic] = None

	while and(position.less_than(resolved.length()), failure.is_some().not()):
		match resolved.get(position):
			Some(PendingRecord(instance)):
				filled: PendingRecordInstance = {
					key = { instance.key | arguments = resolve_partials(instance.key.arguments, completed) },
					fields = resolve_partials(instance.fields, completed),
					representation = instance.representation,
				}
				match settle_record(filled, span):
					Ok(slot): resolved = resolved.set(position, slot)
					Err(error): failure = Some(error)
			Some(CompleteRecord(_)):
				void
			None:
				failure = Some(internal_error(span, "record slot left its builder"))

		position = position.add(1)

	match failure:
		Some(error): Err(error)
		None: Ok({ slots | entries = resolved })


-- Whether a prepared payload owns managed storage: a managed record, an
-- owning or boxed union, a String, a List, or any layout still in progress.
private pure func payload_owns_children(
	payload: PartialType,
	unions: IndexedList[UnionSlot],
	records: IndexedList[RecordSlot],
	span: Span,
) -> Result[Bool, Diagnostic]:
	match payload:
		PendingUnionType(_) | PendingRecordType(_) | PendingListType(_) | PendingCallable(_, _):
			Ok(True)
		KnownType(known):
			match known:
				VoidType | IntType | FloatType:
					Ok(False)
				StringType | ListType(_) | CallableType(_, _):
					Ok(True)
				RecordType(child):
					match records.entries.get(record_number(child)):
						None:
							Err(internal_error(span, "missing concrete record child layout"))
						Some(slot):
							owns_children: Bool = match slot_record_representation(slot):
								ManagedRecord: True
								InlineRecord: False
							Ok(owns_children)
				UnionType(child):
					match unions.entries.get(union_number(child)):
						None:
							Err(internal_error(span, "missing concrete child layout"))
						Some(slot):
							owns_children: Bool = match slot_union_representation(slot):
								InlineOwningPayload | BoxedRecursive: True
								InlineUnmanaged: False
							Ok(owns_children)


private pure func ensure_union(
	key: PartialUnionKey,
	checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot],
	span: Span,
	records: IndexedList[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	existing ?= find_union_slot(unions, key, span)
	match existing:
		Some(id):
			Ok({ value_type = KnownType(UnionType(id)), unions = unions, records = records, in_progress = in_progress })
		None:
			match refer_back_to_union(in_progress, key):
				Some(marked):
					-- A reference back into a layout on the current path.
					Ok({ value_type = PendingUnionType(key), unions = unions, records = records, in_progress = marked })
				None:
					prepare_union(key, checked, unions, span, records, in_progress)


private pure func prepare_union(
	key: PartialUnionKey,
	checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot],
	span: Span,
	records: IndexedList[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	declaration ?= checked.unions
		.get(Declaration.union_number(key.declaration))
		.to_result(internal_error(span, "unknown union declaration"))
	substitution ?= parameter_substitution(
		declaration.type_parameters,
		key.arguments,
		Checked.UnionDeclaration(key.declaration),
		span,
	)
	var dependencies = unions
	var record_dependencies = records
	var layouts: List[InProgressLayout] = in_progress.append(InProgressUnion(key, NotReferencedBack))
	var variants: List[List[PartialType]] = []
	var owning: Bool = False
	var self_referencing: Bool = False
	var failure: Option[Diagnostic] = None

	for variant in declaration.variants:
		var fields: List[PartialType] = []
		for written in variant.fields:
			match prepare_type(written.value_type, substitution, checked, dependencies, written.span, record_dependencies, layouts):
				Err(error):
					failure = Some(error)
					break
				Ok(prepared):
					dependencies = prepared.unions
					record_dependencies = prepared.records
					layouts = prepared.in_progress
					fields = fields.append(prepared.value_type)
					-- The union's own direct payload is the boxed unary shape.
					match prepared.value_type:
						PendingUnionType(other):
							if same_partial_union_key(other, key):
								self_referencing = True
						_:
							void
					match payload_owns_children(prepared.value_type, dependencies, record_dependencies, span):
						Ok(owns): owning = or(owning, owns)
						Err(error):
							failure = Some(error)
							break
		if failure.is_some():
			break
		variants = variants.append(fields)

	_: Void ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	-- A self-referencing union is boxed whatever else it stores; the
	-- box owns every payload. Otherwise an owning child makes it owning.
	representation: UnionRepresentation = if self_referencing:
		BoxedRecursive
	else if owning:
		InlineOwningPayload
	else:
		InlineUnmanaged
	-- Checking accepts a fixed union only when every payload is unmanaged and
	-- none contains the union, so its instances are always InlineUnmanaged.
	-- Any other representation means the two rules disagree.
	unmanaged: Bool = match representation:
		InlineUnmanaged: True
		InlineOwningPayload | BoxedRecursive: False
	_: Void ?= if and(declaration.fixed, unmanaged.not()):
		Err(internal_error(span, "a fixed union instance is not stored inline"))
	else:
		Ok(void)

	-- Children complete before their parent, so the parent takes the
	-- next identity; only references back to layouts still on the
	-- path, including its own direct self payload, remain to fill.
	id: UnionInstanceId = into_opaque UnionInstanceId(dependencies.entries.length())
	slot ?= settle_union({ key = key, variants = variants, representation = representation }, span)
	published = append_entry(dependencies, slot, union_digest(key.declaration))
	left ?= leave_layout(layouts, span)
	match left.back_reference:
		NotReferencedBack:
			Ok({ value_type = KnownType(UnionType(id)), unions = published, records = record_dependencies, in_progress = left.remaining })
		ReferencedBack:
			completed: CompletedLayout = CompletedUnion(key, id)
			match resolve_union_slots(published, unions.entries.length(), completed, span):
				Ok(resolved_unions):
					match resolve_record_slots(record_dependencies, records.entries.length(), completed, span):
						Ok(resolved_records):
							Ok({
								value_type = KnownType(UnionType(id)),
								unions = resolved_unions,
								records = resolved_records,
								in_progress = left.remaining,
							})
						Err(error): Err(error)
				Err(error): Err(error)


-- Whether a prepared field keeps its record inline: a number, a record whose
-- own layout is inline, or a union declared fixed. A fixed union is always
-- InlineUnmanaged, which prepare_union asserts; an ordinary union is not
-- inline here even when it is unmanaged, so that a record's layout follows
-- declared promises rather than another union's current payloads.
private pure func inline_record_field(
	field: PartialType, checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot], records: IndexedList[RecordSlot], span: Span,
) -> Result[Bool, Diagnostic]:
	match field:
		KnownType(IntType) | KnownType(FloatType):
			Ok(True)
		KnownType(UnionType(child)):
			match unions.entries.get(union_number(child)):
				None:
					Err(internal_error(span, "missing concrete child layout"))
				Some(slot):
					declaration: Declaration.UnionId = match slot:
						CompleteUnion(instance): instance.key.declaration
						PendingUnion(instance): instance.key.declaration
					checked.unions
						.get(Declaration.union_number(declaration))
						.map(pure func(union_declaration: Checked.CheckedUnion) -> Bool: union_declaration.fixed)
						.to_result(internal_error(span, "unknown union declaration"))
		KnownType(RecordType(child)):
			match records.entries.get(record_number(child)):
				None:
					Err(internal_error(span, "missing concrete record child layout"))
				Some(slot):
					is_inline: Bool = match slot_record_representation(slot):
						InlineRecord: True
						ManagedRecord: False
					Ok(is_inline)
		_:
			Ok(False)


private pure func ensure_record(
	key: PartialRecordKey,
	checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot],
	span: Span,
	records: IndexedList[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	existing ?= find_record_slot(records, key, span)
	match existing:
		Some(instance):
			Ok({ value_type = KnownType(RecordType(instance)), unions = unions, records = records, in_progress = in_progress })
		None:
			match refer_back_to_record(in_progress, key):
				Some(marked):
					Ok({ value_type = PendingRecordType(key), unions = unions, records = records, in_progress = marked })
				None:
					prepare_record(key, checked, unions, span, records, in_progress)


-- How a record's fields decide its storage. A fixed record has promised
-- inline storage, which checking has verified, so any other layout is a
-- disagreement between the two rules.
private union RecordStoragePolicy:
	InlineEligible
	DeclaredInline
	AlwaysManaged


private record SelectedRecord {
	type_parameters: List[Checked.TypeParameterId],
	parameter_owner: Checked.TypeParameterOwner,
	fields: List[Checked.TypeUse],
	storage: RecordStoragePolicy
}


private pure func prepare_record(
	key: PartialRecordKey, checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot], span: Span, records: IndexedList[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	match key.origin:
		StructuralTuple:
			publish_record(
				key, key.arguments, ManagedRecord, unions, span, records,
				in_progress.append(InProgressRecord(key, NotReferencedBack)),
				unions.entries.length(), records.entries.length(),
			)
		DeclaredRecord(id): prepare_source_record(key, id, checked, unions, span, records, in_progress)
		CaptureEnvironment(id): prepare_capture_record(key, id, checked, unions, span, records, in_progress)


private pure func prepare_source_record(
	key: PartialRecordKey, id: Declaration.RecordId, checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot], span: Span, records: IndexedList[RecordSlot], in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	declaration ?= checked.records.get(Declaration.record_number(id)).to_result(internal_error(span, "unknown record declaration"))
	storage: RecordStoragePolicy = if declaration.fixed:
		DeclaredInline
	else:
		InlineEligible
	selected: SelectedRecord = {
		type_parameters = declaration.type_parameters,
		parameter_owner = Checked.RecordDeclaration(id),
		fields = declaration.fields.map(pure func(field): field.value_type),
		storage = storage,
	}
	prepare_declared_record(key, selected, checked, unions, span, records, in_progress)


private pure func prepare_capture_record(
	key: PartialRecordKey, id: Checked.LambdaId, checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot], span: Span, records: IndexedList[RecordSlot], in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	lambda ?= checked.lambdas.get(Checked.lambda_number(id)).to_result(internal_error(span, "unknown capture environment lambda"))
	root ?= checked.functions.get(Declaration.function_number(lambda.root)).to_result(internal_error(span, "unknown capture environment root"))
	selected: SelectedRecord = {
		type_parameters = root.signature.type_parameters,
		parameter_owner = Checked.FunctionDeclaration(lambda.root),
		fields = lambda.captures.map(pure func(capture): capture.value_type),
		storage = AlwaysManaged,
	}
	prepare_declared_record(key, selected, checked, unions, span, records, in_progress)


private pure func prepare_declared_record(
	key: PartialRecordKey, declaration: SelectedRecord, checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot], span: Span, records: IndexedList[RecordSlot], in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	substitution ?= parameter_substitution(declaration.type_parameters, key.arguments, declaration.parameter_owner, span)
	var fields: List[PartialType] = []
	var dependencies = unions
	var record_dependencies = records
	var layouts: List[InProgressLayout] = in_progress.append(InProgressRecord(key, NotReferencedBack))
	var managed: Bool = match declaration.storage:
		InlineEligible | DeclaredInline: False
		AlwaysManaged: True
	var found_error: Option[Diagnostic] = None

	for field in declaration.fields:
		match prepare_type(field.value_type, substitution, checked, dependencies, field.span, record_dependencies, layouts):
			Err(failure):
				found_error = Some(failure)
				break
			Ok(prepared):
				dependencies = prepared.unions
				record_dependencies = prepared.records
				layouts = prepared.in_progress
				fields = fields.append(prepared.value_type)
				-- Only numbers, inline records and fixed unions keep a record
				-- inline; every other field, including a layout still in
				-- progress, needs a counted root.
				match inline_record_field(prepared.value_type, checked, dependencies, record_dependencies, field.span):
					Ok(inline):
						if inline.not():
							managed = True
					Err(failure):
						found_error = Some(failure)
						break

	_: Void ?= match found_error:
		Some(failure):
			Err(failure)
		None:
			Ok(void)

	-- Checking accepts a fixed record only when every field is a number, a
	-- fixed record or a fixed union and none contains the record.
	_: Void ?= match declaration.storage:
		DeclaredInline:
			if managed:
				Err(internal_error(span, "a fixed record instance is not stored inline"))
			else:
				Ok(void)
		InlineEligible | AlwaysManaged:
			Ok(void)

	representation: RecordRepresentation = if managed:
		ManagedRecord
	else:
		InlineRecord
	publish_record(key, fields, representation, dependencies, span, record_dependencies, layouts, unions.entries.length(), records.entries.length())


-- Both source-owned products and structural tuples settle through one record inventory.
private pure func publish_record(
	key: PartialRecordKey, fields: List[PartialType], representation: RecordRepresentation,
	dependencies: IndexedList[UnionSlot], span: Span,
	record_dependencies: IndexedList[RecordSlot], layouts: List[InProgressLayout],
	first_union: Int, first_record: Int,
) -> Result[PreparedType, Diagnostic]:
	instance: RecordInstanceId = into_opaque RecordInstanceId(record_dependencies.entries.length())
	slot ?= settle_record({ key = key, fields = fields, representation = representation }, span)
	published = append_entry(record_dependencies, slot, record_digest(key.origin, key.arguments.length()))
	left ?= leave_layout(layouts, span)
	match left.back_reference:
		NotReferencedBack:
			Ok({ value_type = KnownType(RecordType(instance)), unions = dependencies, records = published, in_progress = left.remaining })
		ReferencedBack:
			completed: CompletedLayout = CompletedRecord(key, instance)
			match resolve_union_slots(dependencies, first_union, completed, span):
				Ok(resolved_unions):
					match resolve_record_slots(published, first_record, completed, span):
						Ok(resolved_records):
							Ok({
								value_type = KnownType(RecordType(instance)),
								unions = resolved_unions,
								records = resolved_records,
								in_progress = left.remaining,
							})
						Err(error): Err(error)
				Err(error): Err(error)


private pure func prepare_arguments(
	arguments: List[Checked.TypeRef],
	substitution: List[TypeSubstitution[PartialType]],
	checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot],
	span: Span,
	records: IndexedList[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedArguments, Diagnostic]:
	var types: List[PartialType] = []
	var dependencies = unions
	var record_dependencies = records
	var layouts = in_progress
	var failure: Option[Diagnostic] = None

	for argument in arguments:
		match prepare_type(argument, substitution, checked, dependencies, span, record_dependencies, layouts):
			Ok(prepared):
				types = types.append(prepared.value_type)
				dependencies = prepared.unions
				record_dependencies = prepared.records
				layouts = prepared.in_progress
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error): Err(error)
		None: Ok({ arguments = types, unions = dependencies, records = record_dependencies, in_progress = layouts })


private record PreparedArguments {
	arguments: List[PartialType],
	unions: IndexedList[UnionSlot],
	records: IndexedList[RecordSlot],
	in_progress: List[InProgressLayout]
}


private pure func prepare_type(
	value: Checked.TypeRef,
	substitution: List[TypeSubstitution[PartialType]],
	checked: Checked.CheckedFunctions,
	unions: IndexedList[UnionSlot],
	span: Span,
	records: IndexedList[RecordSlot],
	in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	match value:
		Checked.NominalType(Checked.OpaqueNominal(id), arguments):
			match checked.opaques.get(Declaration.opaque_number(id)):
				Some(declaration): prepare_opaque(declaration, arguments, substitution, checked, unions, span, records, in_progress)
				None: Err(internal_error(span, "unknown opaque declaration"))
		Checked.CallableType(_, parameters, result):
			match prepare_arguments(parameters, substitution, checked, unions, span, records, in_progress):
				Err(error): Err(error)
				Ok(inputs):
					match prepare_type(result, substitution, checked, inputs.unions, span, inputs.records, inputs.in_progress):
						Err(error): Err(error)
						Ok(output):
							Ok({ output | value_type = partial_callable(inputs.arguments, output.value_type) })
		Checked.VoidType:
			Ok({ value_type = KnownType(VoidType), unions = unions, records = records, in_progress = in_progress })
		Checked.IntType:
			Ok({ value_type = KnownType(IntType), unions = unions, records = records, in_progress = in_progress })
		Checked.FloatType:
			Ok({ value_type = KnownType(FloatType), unions = unions, records = records, in_progress = in_progress })
		Checked.StringType:
			Ok({ value_type = KnownType(StringType), unions = unions, records = records, in_progress = in_progress })
		Checked.ParameterType(id):
			var replacement: Option[PartialType] = None

			for argument in substitution:
				if Checked.same_parameter(id, argument.parameter):
					-- A supplied replacement is terminal.
					replacement = Some(argument.value_type)
					break

			match replacement:
				Some(replaced):
					Ok({ value_type = replaced, unions = unions, records = records, in_progress = in_progress })
				None:
					Err(internal_error(span, "unresolved or foreign type parameter"))
		Checked.TupleType(elements):
			prepare_tuple_type(elements, substitution, checked, unions, span, records, in_progress)
		Checked.ListType(element):
			match prepare_type(element, substitution, checked, unions, span, records, in_progress):
				Ok(prepared): Ok({ prepared | value_type = partial_list(prepared.value_type) })
				Err(error): Err(error)
		Checked.NominalType(Checked.AggregateNominal(Checked.RecordAggregate(id)), arguments):
			match prepare_arguments(arguments, substitution, checked, unions, span, records, in_progress):
				Ok(prepared): ensure_record({ origin = DeclaredRecord(id), arguments = prepared.arguments }, checked, prepared.unions, span, prepared.records, prepared.in_progress)
				Err(error): Err(error)
		Checked.NominalType(Checked.AggregateNominal(Checked.UnionAggregate(id)), arguments):
			match prepare_arguments(arguments, substitution, checked, unions, span, records, in_progress):
				Ok(prepared): ensure_union({ declaration = id, arguments = prepared.arguments }, checked, prepared.unions, span, prepared.records, prepared.in_progress)
				Err(error): Err(error)


-- As for a record: prepare the arguments, then the underlying type under the
-- declaration's parameters bound to them.
private pure func prepare_opaque(
	declaration: Checked.CheckedOpaque, arguments: List[Checked.TypeRef], substitution: List[TypeSubstitution[PartialType]],
	checked: Checked.CheckedFunctions, unions: IndexedList[UnionSlot], span: Span,
	records: IndexedList[RecordSlot], in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	prepared ?= prepare_arguments(arguments, substitution, checked, unions, span, records, in_progress)
	inner ?= parameter_substitution(declaration.type_parameters, prepared.arguments, Checked.OpaqueDeclaration(declaration.id), span)
	prepare_type(declaration.underlying_type.value_type, inner, checked, prepared.unions, span, prepared.records, prepared.in_progress)


private pure func prepare_tuple_type(
	elements: List[Checked.TypeRef], substitution: List[TypeSubstitution[PartialType]],
	checked: Checked.CheckedFunctions, unions: IndexedList[UnionSlot], span: Span,
	records: IndexedList[RecordSlot], in_progress: List[InProgressLayout],
) -> Result[PreparedType, Diagnostic]:
	prepared ?= prepare_arguments(elements, substitution, checked, unions, span, records, in_progress)
	ensure_record({ origin = StructuralTuple, arguments = prepared.arguments }, checked, prepared.unions, span, prepared.records, prepared.in_progress)


-- Every slot is complete once no layout is in progress; sealing projects the
-- builder into the immutable instance list the translation phase reads. An
-- instance keeps its slot's position and every key field the digest reads, so
-- the builder's `positions` carry over. `seal_records` relies on the same.
private pure func seal_unions(slots: IndexedList[UnionSlot]) -> Result[IndexedList[UnionInstance], Diagnostic]:
	var instances: List[UnionInstance] = []
	var failure: Option[Diagnostic] = None

	for slot in slots.entries:
		match slot:
			CompleteUnion(instance):
				instances = instances.append(instance)
			PendingUnion(_):
				failure = Some(internal_error(compiler_span(), "union layout sealed while still pending"))
				break

	match failure:
		Some(error): Err(error)
		None: Ok({ entries = instances, positions = slots.positions })


private pure func seal_records(slots: IndexedList[RecordSlot]) -> Result[IndexedList[RecordInstance], Diagnostic]:
	var instances: List[RecordInstance] = []
	var failure: Option[Diagnostic] = None

	for slot in slots.entries:
		match slot:
			CompleteRecord(instance):
				instances = instances.append(instance)
			PendingRecord(_):
				failure = Some(internal_error(compiler_span(), "record layout sealed while still pending"))
				break

	match failure:
		Some(error): Err(error)
		None: Ok({ entries = instances, positions = slots.positions })


private pure func value_types(value: Checked.CheckedExpr) -> List[Checked.TypeUse]:
	append_value_types([], value)


-- A call's callee anchor locates its type errors; any other node's own span does.
private pure func anchor(value: Checked.CheckedExpr) -> Span:
	match value.form:
		Checked.InvokeFunction(call):
			call.span
		_:
			value.span


-- A node's type precedes its children's, which follow in order. Instance numbers
-- follow this order, so it fixes the names in the emitted C.
private pure func append_value_types(
	collected: List[Checked.TypeUse],
	value: Checked.CheckedExpr,
) -> List[Checked.TypeUse]:
	var types: List[Checked.TypeUse] = collected.append({
		value_type = value.value_type,
		span = anchor(value),
	})

	match value.form:
		Checked.UpdateRecord(_, update):
			types = append_value_types(types, update.base)
			for field in update.replacements:
				types = append_value_types(types, field.value)
			for field in update.inherited:
				types = types.append({ value_type = field.value_type, span = update.base_expression_span })
		Checked.ConstructVariant(_, children):
			for child in children:
				types = append_value_types(types, child)
		Checked.ConstructRecord(_, fields):
			for field in fields:
				types = append_value_types(types, field.value)
		Checked.ConstructOpaque(_, child):
			types = append_value_types(types, child)
		Checked.ProjectOpaque(_, child):
			types = append_value_types(types, child)
		Checked.ConstructTuple(elements):
			for element in elements:
				types = append_value_types(types, element)
		Checked.ConstructList(elements):
			for element in elements:
				types = append_value_types(types, element)
		Checked.Match(join):
			types = append_value_types(types, join.scrutinee)
			types = types.concat(selection_types(join.selection, join.scrutinee.span))
			for arm in join.arms:
				types = types.concat(statement_types(arm.statements))
				types = append_value_types(types, arm.value)
		Checked.InvokeFunction(call):
			match call.target:
				Checked.ValueCall(callee): types = append_value_types(types, callee)
				_: void
			for operand in call.operands:
				match operand:
					Checked.ValueOperand(argument): types = append_value_types(types, argument)
					Checked.CallableOperand(_, choice, _):
						match choice:
							Checked.LambdaCallable(_, captures):
								for capture in captures:
									types = append_value_types(types, capture)
							Checked.StoredCallable(child): types = append_value_types(types, child)
							Checked.MethodCallable(_) | Checked.NamedCallable(_, _) | Checked.ForwardedCallable(_): void
		Checked.MakeCallable(choice):
			match choice:
				Checked.LambdaCallable(_, captures):
					for capture in captures:
						types = append_value_types(types, capture)
				Checked.StoredCallable(child): types = append_value_types(types, child)
				Checked.MethodCallable(_) | Checked.NamedCallable(_, _) | Checked.ForwardedCallable(_): void
		Checked.ReadTupleElement(receiver, _):
			types = append_value_types(types, receiver)
		Checked.ReadRecordField(receiver, _):
			types = append_value_types(types, receiver)
		Checked.LiteralVoid | Checked.LiteralInteger(_) | Checked.LiteralFloat(_) | Checked.LiteralString(_) | Checked.ReadBinding(_) | Checked.ReadCapture(_):
			void

	types


private pure func statement_types(
	statements: List[Checked.CheckedStatement],
) -> List[Checked.TypeUse]:
	var types: List[Checked.TypeUse] = []

	for statement in statements:
		match statement:
			Checked.InitializeBinding(_, value):
				types = types.concat(value_types(value))
			Checked.DiscardExpression(value):
				types = types.concat(value_types(value))
			Checked.ReassignBinding(_, value):
				types = types.concat(value_types(value))
			Checked.RunWhile(loop):
				types = types.concat(value_types(loop.condition)).concat(statement_types(loop.body))
			Checked.BreakSourceLoop(_) | Checked.ContinueSourceLoop(_): void
			Checked.RunFor(loop):
				match loop.iteration:
					Checked.ListIteration(iterable, element, option):
						types = types.concat(value_types(iterable)).append({
							value_type = Checked.NominalType(Checked.AggregateNominal(Checked.UnionAggregate(Declaration.variant_owner(option.some))), [element]),
							span = loop.span,
						})
					Checked.AscendingIntRange(start, end, boolean):
						types = types.concat(value_types(start)).concat(value_types(end)).append({
							value_type = Checked.NominalType(Checked.AggregateNominal(Checked.UnionAggregate(Declaration.variant_owner(boolean.true_variant))), []),
							span = loop.span,
						})
				types = types.concat(statement_types(loop.body))

	types


private pure func exit_types(exit: Checked.CheckedExit) -> List[Checked.TypeUse]:
	match exit:
		Checked.ReturnExpression(value):
			value_types(value)
		Checked.RecurWith(arguments, _):
			var types: List[Checked.TypeUse] = []

			for argument in arguments:
				types = types.concat(value_types(argument))

			types


-- The selected body owns these facts; only its genuine root owns rigid parameters.
-- This view is local to preparation/translation, never a published function row.
-- `base_label` is the root function's; a lambda adds its own in translation.
private record SelectedBody {
	base_label: FunctionLabel,
	captures: List[Checked.CheckedCapture],
	parameter_owner: Checked.TypeParameterOwner,
	type_parameters: List[Checked.TypeParameterId],
	parameters: List[Checked.TypeUse],
	return_type: Checked.TypeUse,
	bindings: List[Checked.BindingDefinition],
	statements: List[Checked.CheckedStatement],
	body: Checked.CheckedBody,
	execution: FunctionExecution
}


private pure func selected_body(
	checked: Checked.CheckedFunctions,
	owner: Checked.BodyOwner,
	source: RequestSource,
) -> Result[SelectedBody, Diagnostic]:
	match owner:
		Checked.DeclaredBody(id):
			match checked.functions.get(Declaration.function_number(id)):
				None: Err(missing_body(source, "unknown function declaration"))
				Some(function): Ok({
					base_label = function.label,
					captures = [],
					parameter_owner = Checked.FunctionDeclaration(function.id),
					type_parameters = function.signature.type_parameters,
					parameters = function.signature.parameters,
					return_type = function.signature.return_type,
					bindings = function.bindings,
					statements = function.statements,
					body = function.body,
					execution = function.execution
				})
		Checked.LambdaBody(id):
			match checked.lambdas.get(Checked.lambda_number(id)):
				None: Err(missing_body(source, "unknown lambda identity"))
				Some(lambda):
					match checked.functions.get(Declaration.function_number(lambda.root)):
						None: Err(internal_error(lambda.return_type.span, "unknown lambda root"))
						Some(root): Ok({
							base_label = root.label,
							captures = lambda.captures,
							parameter_owner = Checked.FunctionDeclaration(root.id),
							type_parameters = root.signature.type_parameters,
							parameters = lambda.parameters,
							return_type = lambda.return_type,
							bindings = lambda.bindings,
							statements = lambda.statements,
							body = lambda.body,
							execution = OrdinaryCalls
						})

		Checked.DerivedEqualityBody(aggregate):
			match Checked.equality_body(checked.traits, aggregate):
				None: Err(missing_body(source, "unknown derived equality body"))
				Some(template): Ok({
					base_label = template.label, captures = [], parameter_owner = Checked.aggregate_owner(aggregate),
					type_parameters = template.signature.type_parameters,
					parameters = template.signature.parameters, return_type = template.signature.return_type,
					bindings = template.bindings, statements = [], body = template.body,
					execution = OrdinaryCalls
				})


private pure func place_types(place: Checked.CheckedPatternPlace, span: Span) -> List[Checked.TypeUse]:
	own: Checked.TypeUse = { value_type = place.value_type, span = span }
	match place.route:
		Checked.MatchRoot: [own]
		Checked.UnionField(parent, _, _): [own].concat(place_types(parent, span))
		Checked.ListElement(parent, _): [own].concat(place_types(parent, span))
		Checked.RecordField(parent, _): [own].concat(place_types(parent, span))


private pure func selection_types(selection: Checked.CheckedSelection, span: Span) -> List[Checked.TypeUse]:
	var types: List[Checked.TypeUse] = []
	for node in selection.nodes:
		match node:
			Checked.TestVariant(place, _, _, _): types = types.concat(place_types(place, span))
			Checked.TestListLength(place, _, _, _): types = types.concat(place_types(place, span))
			Checked.TestStringBytes(place, _, _, _): types = types.concat(place_types(place, span))
			Checked.EnterArm(_, arguments):
				for argument in arguments:
					match argument:
						Checked.BorrowPlace(place): types = types.concat(place_types(place, span))
						Checked.CopyListSuffix(place, _): types = types.concat(place_types(place, span))
	types


private pure func function_types(function: SelectedBody) -> List[Checked.TypeUse]:
	var types: List[Checked.TypeUse] = []
	types = types.concat(function.parameters)

	types = types
		.append(function.return_type)
		.concat(statement_types(function.statements))

	match function.body:
		Checked.CheckedValueBody(value):
			types.concat(exit_types(value))
		Checked.CheckedMatchBody(matched):
			types = types.concat(value_types(matched.scrutinee)).concat(selection_types(matched.selection, matched.scrutinee.span))

			for arm in matched.arms:
				types = types
					.concat(statement_types(arm.statements))
					.concat(exit_types(arm.body))

			types


private pure func runtime_key(
	body: Checked.BodyOwner, arguments: List[Checked.TypeRef], checked: Checked.CheckedFunctions, span: Span,
) -> Result[InstanceKey, Diagnostic]:
	function ?= selected_body(checked, body, ConcreteRequest(span))
	var modes: List[CallableMode] = []
	for binding in function.bindings:
		match binding.origin:
			Checked.CallableParameterBinding(parameter): modes = modes.append(RuntimeCallable(parameter))
			_: void
	Ok({ body = body, arguments = arguments, callables = modes })


private pure func runtime_instance(
	keys: IndexedList[FunctionRequest], body: Checked.BodyOwner, arguments: List[Checked.TypeRef], span: Span,
) -> Result[FunctionInstanceId, Diagnostic]:
	found ?= indexed_position(keys, body_digest(body), span, pure func(request: FunctionRequest) -> Bool:
		if and(Checked.same_body(request.key.body, body), Checked.same_types(request.key.arguments, arguments)):
			var all_runtime: Bool = True
			for mode in request.key.callables:
				match mode:
					RuntimeCallable(_): void
					StaticCallable(_): all_runtime = False
			all_runtime
		else:
			False
	)
	found.map(pure func(position: Int) -> FunctionInstanceId: into_opaque FunctionInstanceId(position))
		.to_result(internal_error(span, "missing runtime callable body instance"))


private pure func request_instance(
	prepared: PreparedInstances,
	key: InstanceKey,
	source: RequestSource,
	span: Span,
) -> Result[PreparedInstances, Diagnostic]:
	existing ?= find_instance(prepared.functions, key, span)
	match existing:
		Some(_): Ok(prepared)
		None: Ok({ prepared | functions = append_entry(prepared.functions, { key = key, source = source }, body_digest(key.body)) })


private record PreparedCallableStorage {
	storage: CallableStorage,
	prepared: PreparedInstances
}


private pure func prepare_callable_storage(
	id: Checked.LambdaId,
	captures: List[Checked.CheckedExpr],
	arguments: List[TypeRef],
	checked: Checked.CheckedFunctions,
	prepared: PreparedInstances,
	span: Span,
) -> Result[PreparedCallableStorage, Diagnostic]:
	if captures.is_empty():
		Ok({ storage = ErasedCallable, prepared = prepared })
	else:
		match ensure_record({ origin = CaptureEnvironment(id), arguments = known_arguments(arguments) }, checked, prepared.unions, span, prepared.records, []):
			Err(error): Err(error)
			Ok(layout):
				match known_type(layout.value_type, span):
					Err(error): Err(error)
					Ok(RecordType(owner)): Ok({
						storage = EnvironmentCallable(owner),
						prepared = { prepared | unions = layout.unions, records = layout.records }
					})
					Ok(_): Err(internal_error(span, "capture environment has a non-record layout"))


-- Check has proved the obligation. Ground semantic Self before selecting the
-- ordinary body request; opaque receiver identity never comes from its layout.
private pure func selected_method_body(method: Checked.AcceptedMethodCall, substitution: Declarations.Substitution, traits: Checked.AcceptedTraits, span: Span) -> Result[Checked.SelectedMethodBody, Diagnostic]:
	receiver ?= semantic_type(Checked.method_receiver(method), substitution, span)
	Checked.method_body(traits, Checked.accepted_method(Checked.method_identity(method), receiver))
		.to_result(internal_error(span, "accepted method has no implementation body"))


private pure func prepare_body_instance(body: Checked.BodyOwner, arguments: List[Checked.TypeRef], checked: Checked.CheckedFunctions, initial: PreparedInstances, span: Span) -> Result[PreparedInstances, Diagnostic]:
	types ?= prepare_arguments(arguments, [], checked, initial.unions, span, initial.records, [])
	concrete ?= known_types(types.arguments, span)
	key ?= runtime_key(body, arguments, checked, span)
	request_instance({ initial | unions = types.unions, records = types.records }, key, ConcreteRequest(span), span)


private pure func prepare_named_instance(id: Declaration.FunctionId, arguments: List[Checked.TypeRef], checked: Checked.CheckedFunctions, initial: PreparedInstances, span: Span) -> Result[PreparedInstances, Diagnostic]:
	prepare_body_instance(Checked.DeclaredBody(id), arguments, checked, initial, span)


private pure func prepare_named_creation(
	id: Declaration.FunctionId, arguments: List[Checked.TypeRef],
	substitution: Declarations.Substitution, checked: Checked.CheckedFunctions,
	initial: PreparedInstances, span: Span,
) -> Result[PreparedInstances, Diagnostic]:
	semantic ?= semantic_arguments(arguments, substitution, span)
	prepare_named_instance(id, semantic, checked, initial, span)


private pure func prepare_lambda_creation(
	id: Checked.LambdaId, captures: List[Checked.CheckedExpr],
	arguments: List[Checked.TypeRef], storage_arguments: List[TypeRef],
	checked: Checked.CheckedFunctions, initial: PreparedInstances, span: Span,
) -> Result[PreparedInstances, Diagnostic]:
	storage ?= prepare_callable_storage(id, captures, storage_arguments, checked, initial, span)
	key ?= runtime_key(Checked.LambdaBody(id), arguments, checked, span)
	request_instance(storage.prepared, key, ConcreteRequest(span), span)


private pure func prepare_creation(
	value: Checked.CheckedExpr, request: FunctionRequest,
	substitution: Declarations.Substitution, storage_arguments: List[TypeRef],
	checked: Checked.CheckedFunctions, initial: PreparedInstances,
) -> Result[PreparedInstances, Diagnostic]:
	match value.form:
		Checked.MakeCallable(Checked.MethodCallable(method)):
			match selected_method_body(method, substitution, checked.traits, value.span):
				Ok(selected): prepare_body_instance(selected.body, selected.arguments, checked, initial, value.span)
				Err(error): Err(error)
		Checked.MakeCallable(Checked.NamedCallable(id, arguments)):
			prepare_named_creation(id, arguments, substitution, checked, initial, value.span)
		Checked.MakeCallable(Checked.LambdaCallable(id, captures)):
			prepare_lambda_creation(id, captures, request.key.arguments, storage_arguments, checked, initial, value.span)
		_: Ok(initial)


private pure func method_callable(method: Checked.AcceptedMethodCall, parameter: Checked.CallableParameterId, substitution: Declarations.Substitution, traits: Checked.AcceptedTraits, span: Span) -> Result[CallableMode, Diagnostic]:
	selected ?= selected_method_body(method, substitution, traits, span)
	Ok(StaticCallable({ parameter = parameter, body = selected.body, arguments = selected.arguments, storage = ErasedCallable }))


private pure func prepare_function(
	function: SelectedBody,
	request: FunctionRequest,
	checked: Checked.CheckedFunctions,
	initial: PreparedInstances,
) -> Result[PreparedInstances, Diagnostic]:
	semantic ?= function_substitution(function, request.key.arguments, function.return_type.span)
	argument_layouts ?= prepare_arguments(request.key.arguments, [], checked, initial.unions, function.return_type.span, initial.records, [])
	storage_arguments ?= known_types(argument_layouts.arguments, function.return_type.span)
	substitution ?= parameter_substitution(
		function.type_parameters, argument_layouts.arguments,
		function.parameter_owner, function.return_type.span,
	)
	var prepared = { initial | unions = argument_layouts.unions, records = argument_layouts.records }
	var failure: Option[Diagnostic] = None
	has_type_parameters = function.type_parameters.is_empty().not()

	for written in function_types(function):
		depends_on_caller = match has_type_parameters:
			True: contains_parameter(written.value_type)
			False: False
		match prepare_type(
			written.value_type,
			substitution,
			checked,
			prepared.unions,
			request_span(depends_on_caller, request.source, written.span),
			prepared.records,
			[],
		):
			Ok(value):
				prepared = { prepared |
					unions = value.unions,
					records = value.records
				}
			Err(error):
				failure = Some(error)
				break

	if failure.is_some().not():
		for value in Checked.body_callable_creations(function.statements, function.body):
			match prepare_creation(value, request, semantic, storage_arguments, checked, prepared):
				Ok(next): prepared = next
				Err(error):
					failure = Some(error)
					break

	if failure.is_some().not():
		for call in Checked.body_calls(function.statements, function.body):
			match call.target:
				Checked.TraitMethod(method):
					match selected_method_body(method, semantic, checked.traits, call.span):
						Err(error): failure = Some(error)
						Ok(selected):
							match prepare_body_instance(selected.body, selected.arguments, checked, prepared, call.span):
								Err(error): failure = Some(error)
								Ok(next): prepared = next
				Checked.RuntimeFunction(_): void
				Checked.ValueCall(_): void
				Checked.CallableParameter(parameter):
					match callable_mode(request.key.callables, parameter, call.span):
						Err(error): failure = Some(error)
						Ok(RuntimeCallable(_)): void
						Ok(StaticCallable(choice)):
							match runtime_key(choice.body, choice.arguments, checked, call.span):
								Ok(key):
									match request_instance(prepared, key, request.source, call.span):
										Ok(next): prepared = next
										Err(error): failure = Some(error)
								Err(error): failure = Some(error)
				Checked.UserFunction(declaration, arguments):
					var concrete: List[Checked.TypeRef] = []
					var depends_on_caller: Bool = False

					for argument in arguments:
						-- One dependency fact serves both this argument's diagnostic
						-- and the request chain. Nongeneric callers need no tree scan.
						argument_depends_on_caller = match has_type_parameters:
							True: contains_parameter(argument)
							False: False
						depends_on_caller = or(depends_on_caller, argument_depends_on_caller)
						argument_span = request_span(argument_depends_on_caller, request.source, call.span)
						match semantic_type(argument, semantic, argument_span):
							Err(error):
								failure = Some(error)
								break
							Ok(replaced):
								match prepare_type(replaced, [], checked, prepared.unions, argument_span, prepared.records, []):
									Err(error):
										failure = Some(error)
										break
									Ok(value):
										prepared = { prepared | unions = value.unions, records = value.records }
										-- No layout is in progress at a function boundary.
										match known_type(value.value_type, call.span):
											Ok(_): concrete = concrete.append(replaced)
											Err(error):
												failure = Some(error)
												break

					if failure.is_some():
						break

					var choices: List[CallableMode] = []
					for operand in call.operands:
						match operand:
							Checked.ValueOperand(_): void
							Checked.CallableOperand(written_parameter, written_choice, written_span):
								var choice_depends_on_caller: Bool = False
								choice_result: Result[CallableMode, Diagnostic] = match written_choice:
									Checked.ForwardedCallable(parameter):
										-- A forwarded selection depends on the current caller's key.
										choice_depends_on_caller = True
										forward_callable(request.key.callables, parameter, written_parameter, written_span)
									Checked.LambdaCallable(id, captures):
										choice_depends_on_caller = has_type_parameters
										match prepare_callable_storage(id, captures, storage_arguments, checked, prepared, written_span):
											Err(error): Err(error)
											Ok(storage):
												prepared = storage.prepared
												Ok(StaticCallable({
													parameter = written_parameter,
													body = Checked.LambdaBody(id),
													arguments = request.key.arguments,
													storage = storage.storage
												}))
									Checked.MethodCallable(method):
										choice_depends_on_caller = has_type_parameters
										match selected_method_body(method, semantic, checked.traits, written_span):
											Err(error): Err(error)
											Ok(selected):
												match prepare_arguments(selected.arguments, [], checked, prepared.unions, written_span, prepared.records, []):
													Err(error): Err(error)
													Ok(layouts):
														prepared = { prepared | unions = layouts.unions, records = layouts.records }
														known_types(layouts.arguments, written_span).map(pure func(_): StaticCallable({ parameter = written_parameter, body = selected.body, arguments = selected.arguments, storage = ErasedCallable }))
									Checked.NamedCallable(id, named_arguments):
										choice_depends_on_caller = match has_type_parameters:
											True: named_arguments.any(contains_parameter)
											False: False
										span = request_span(choice_depends_on_caller, request.source, written_span)
										match semantic_arguments(named_arguments, semantic, span):
											Err(error): Err(error)
											Ok(callable_arguments):
												match prepare_arguments(callable_arguments, [], checked, prepared.unions, span, prepared.records, []):
													Err(error): Err(error)
													Ok(callable_layouts):
														prepared = { prepared | unions = callable_layouts.unions, records = callable_layouts.records }
														known_types(callable_layouts.arguments, written_span).map(pure func(_): StaticCallable({
															parameter = written_parameter,
															body = Checked.DeclaredBody(id),
															arguments = callable_arguments,
															storage = ErasedCallable
														}))
									Checked.StoredCallable(_): Ok(RuntimeCallable(written_parameter))
								depends_on_caller = or(depends_on_caller, choice_depends_on_caller)
								match choice_result:
									Err(error):
										failure = Some(error)
										break
									Ok(choice):
										choices = choices.append(choice)
										match choice:
											RuntimeCallable(_): void
											StaticCallable(known):
												span = request_span(choice_depends_on_caller, request.source, written_span)
												match runtime_key(known.body, known.arguments, checked, span):
													Ok(key):
														match request_instance(prepared, key, ConcreteRequest(span), span):
															Ok(next): prepared = next
															Err(error):
																failure = Some(error)
																break
													Err(error):
														failure = Some(error)
														break
					if failure.is_some().not():
						callee_span = request_span(depends_on_caller, request.source, call.span)
						match request_instance(prepared, {
							body = Checked.DeclaredBody(declaration),
							arguments = concrete,
							callables = choices
						}, ConcreteRequest(callee_span), callee_span):
							Ok(next): prepared = next
							Err(error): failure = Some(error)
			if failure.is_some():
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(prepared)


private pure func expand_instances(
	checked: Checked.CheckedFunctions,
	initial: PreparedInstances,
) -> Result[PreparedInstances, Diagnostic]:
	var prepared = initial
	var cursor: Int = 0
	var failure: Option[Diagnostic] = None

	-- Checking rejects growing recursive substitutions. Finite concrete keys are
	-- requested once, so regular self/mutual recursion reuses an existing identity.
	while cursor.less_than(prepared.functions.entries.length()):
		match prepared.functions.entries.get(cursor):
			None:
				failure = Some(
					internal_error(
						compiler_span(),
						"missing instance request",
					),
				)
			Some(request):
				match selected_body(checked, request.key.body, request.source):
					Err(error): failure = Some(error)
					Ok(function):
						match prepare_function(function, request, checked, prepared):
							Ok(value): prepared = value
							Err(error): failure = Some(error)

		if failure.is_some():
			break

		cursor = cursor.add(1)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(prepared)


-- A call's concrete result instance names the designated union's constructors.
private pure func translate_option(
	option: DesignatedOption[Declaration.VariantId],
	result_type: TypeRef,
	unions: IndexedList[UnionInstance],
	span: Span,
) -> Result[DesignatedOption[VariantInstanceId], Diagnostic]:
	owner ?= concrete_union_owner(result_type, span)
	some ?= translate_variant(option.some, owner, unions, span)
	none ?= translate_variant(option.none, owner, unions, span)
	Ok({
		some = some,
		none = none,
	})


private pure func translate_result(
	result: DesignatedResult[Declaration.VariantId],
	result_type: TypeRef,
	unions: IndexedList[UnionInstance],
	span: Span,
) -> Result[DesignatedResult[VariantInstanceId], Diagnostic]:
	owner ?= concrete_union_owner(result_type, span)
	ok ?= translate_variant(result.ok, owner, unions, span)
	error ?= translate_variant(result.err, owner, unions, span)
	Ok({ ok = ok, err = error })


private pure func translate_boolean(
	boolean: DesignatedBoolean[Declaration.VariantId],
	result_type: TypeRef,
	unions: IndexedList[UnionInstance],
	span: Span,
) -> Result[DesignatedBoolean[VariantInstanceId], Diagnostic]:
	owner ?= concrete_union_owner(result_type, span)
	true_variant ?= translate_variant(boolean.true_variant, owner, unions, span)
	false_variant ?= translate_variant(boolean.false_variant, owner, unions, span)
	Ok({
		true_variant = true_variant,
		false_variant = false_variant,
	})


private union CaptureBinding:
	NoCaptureBinding
	LambdaCaptureBinding(Checked.LambdaId, RecordInstanceId, Checked.BindingId)


-- Each checked binding has exactly one physical translation. A static callable
-- has no data slot; an environment or stored value has one issued runtime slot.
private union BindingTranslation:
	ErasedCallableBinding(KnownCallable, TypeRef)
	CapturedCallableBinding(KnownCallable, Checked.BindingId, TypeRef)
	RuntimeCallableBinding(Checked.CallableParameterId, Checked.BindingId, TypeRef)
	RuntimeValueBinding(Checked.BindingId, TypeRef)


private record TranslationBindings {
	traits: Checked.AcceptedTraits,
	bindings: List[BindingTranslation],
	capture: CaptureBinding
}


private pure func translated_binding(
	translation: TranslationBindings, id: Checked.BindingId, span: Span,
) -> Result[BindingTranslation, Diagnostic]:
	translation.bindings.get(Checked.binding_number(id)).to_result(internal_error(span, "missing checked binding translation"))


private pure func runtime_binding(
	translation: TranslationBindings, id: Checked.BindingId, span: Span,
) -> Result[Checked.BindingId, Diagnostic]:
	binding ?= translated_binding(translation, id, span)
	match binding:
		RuntimeValueBinding(runtime, _): Ok(runtime)
		RuntimeCallableBinding(_, runtime, _): Ok(runtime)
		ErasedCallableBinding(_, _) | CapturedCallableBinding(_, _, _):
			Err(internal_error(span, "static callable used as an ordinary binding"))


private pure func runtime_bindings(
	translation: TranslationBindings, ids: List[Checked.BindingId], span: Span,
) -> Result[List[Checked.BindingId], Diagnostic]:
	translated_list(ids, pure func(id: Checked.BindingId) -> Result[Checked.BindingId, Diagnostic]: runtime_binding(translation, id, span))


private pure func translated_callable(
	translation: TranslationBindings, parameter: Checked.CallableParameterId, span: Span,
) -> Result[BindingTranslation, Diagnostic]:
	var found: Option[BindingTranslation] = None
	for binding in translation.bindings:
		matches = match binding:
			ErasedCallableBinding(known, _): Checked.same_callable_parameter(known.parameter, parameter)
			CapturedCallableBinding(known, _, _): Checked.same_callable_parameter(known.parameter, parameter)
			RuntimeCallableBinding(id, _, _): Checked.same_callable_parameter(id, parameter)
			RuntimeValueBinding(_, _): False
		if matches:
			found = Some(binding)
			break
	found.to_result(internal_error(span, "missing callable formal binding translation"))


private pure func forward_translation(
	translation: TranslationBindings, source_parameter: Checked.CallableParameterId,
	destination_parameter: Checked.CallableParameterId, span: Span,
) -> Result[CallableMode, Diagnostic]:
	binding ?= translated_callable(translation, source_parameter, span)
	match binding:
		ErasedCallableBinding(known, _): Ok(StaticCallable({ known | parameter = destination_parameter }))
		CapturedCallableBinding(known, _, _): Ok(StaticCallable({ known | parameter = destination_parameter }))
		RuntimeCallableBinding(_, _, _): Ok(RuntimeCallable(destination_parameter))
		RuntimeValueBinding(_, _): Err(internal_error(span, "ordinary binding used as a callable formal"))


private pure func lambda_storage(
	id: Checked.LambdaId,
	capture_count: Int,
	arguments: List[Checked.TypeRef], opaques: List[Checked.CheckedOpaque],
	substitution: Declarations.Substitution, unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance], span: Span,
) -> Result[CallableStorage, Diagnostic]:
	if capture_count == 0:
		Ok(ErasedCallable)
	else:
		match concrete_types(opaques, arguments, substitution, unions, span, records):
			Err(error): Err(error)
			Ok(physical):
				match find_record_instance(records, { origin = CaptureEnvironment(id), arguments = physical }, span):
					Err(error): Err(error)
					Ok(None): Err(internal_error(span, "unprepared capture environment"))
					Ok(Some(owner)): Ok(EnvironmentCallable(owner))


private pure func callable_environment(
	parameter: Checked.CallableParameterId,
	translation: TranslationBindings,
	span: Span,
) -> Result[ConcreteExpr, Diagnostic]:
	binding ?= translated_callable(translation, parameter, span)
	match binding:
		CapturedCallableBinding(known, runtime, _):
			match known.storage:
				EnvironmentCallable(owner): Ok({ form = ReadBinding(runtime), value_type = RecordType(owner), span = span })
				ErasedCallable: Err(internal_error(span, "environment binding has erased storage"))
		_: Err(internal_error(span, "callable has no separate environment parameter"))


private pure func translate_call(
	opaques: List[Checked.CheckedOpaque],
	call: Checked.CheckedCall,
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	result_type: TypeRef,
) -> Result[ConcreteCall, Diagnostic]:
	target_result: Result[CallTarget, Diagnostic] = match call.target:
		Checked.TraitMethod(method):
			match selected_method_body(method, substitution, callables.traits, call.span):
				Err(error): Err(error)
				Ok(selected): runtime_instance(keys, selected.body, selected.arguments, call.span).map(pure func(id): UserFunction(id))
		Checked.RuntimeFunction(operation):
			concrete_result: Result[RuntimeOperation[VariantInstanceId, TypeRef], Diagnostic] = match operation:
				IntAdd:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntAdd
					Ok(accepted)
				IntSubtract:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntSubtract
					Ok(accepted)
				IntMultiply:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntMultiply
					Ok(accepted)
				IntDivide:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntDivide
					Ok(accepted)
				IntRemainder:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntRemainder
					Ok(accepted)
				IntToString:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.IntToString
					Ok(accepted)
				FloatAdd:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatAdd
					Ok(accepted)
				FloatSubtract:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatSubtract
					Ok(accepted)
				FloatMultiply:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatMultiply
					Ok(accepted)
				FloatDivide:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatDivide
					Ok(accepted)
				FloatRemainder:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatRemainder
					Ok(accepted)
				FloatToString:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatToString
					Ok(accepted)
				FloatCopySign:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.FloatCopySign
					Ok(accepted)
				ListRepeat(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListRepeat(concrete))
						Err(error): Err(error)
				ListLength(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListLength(concrete))
						Err(error): Err(error)
				ListAppend(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListAppend(concrete))
						Err(error): Err(error)
				ListSet(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListSet(concrete))
						Err(error): Err(error)
				ListConcat(element):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete): Ok(Builtins.ListConcat(concrete))
						Err(error): Err(error)
				StringLength:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.StringLength
					Ok(accepted)
				StringConcat:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.StringConcat
					Ok(accepted)
				StringAppendInt:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.StringAppendInt
					Ok(accepted)
				StringPrint:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.StringPrint
					Ok(accepted)
				StringPrintError:
					accepted: RuntimeOperation[VariantInstanceId, TypeRef] = Builtins.StringPrintError
					Ok(accepted)
				StringParseInt(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringParseInt(translated))
						Err(error): Err(error)
				StringParseFloat(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringParseFloat(translated))
						Err(error): Err(error)
				StringByteAt(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringByteAt(translated))
						Err(error): Err(error)
				RunToFiles(result):
					match translate_result(result, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.RunToFiles(translated))
						Err(error): Err(error)
				ReadFile(result):
					match translate_result(result, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.ReadFile(translated))
						Err(error): Err(error)
				WriteFile(result):
					match translate_result(result, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.WriteFile(translated))
						Err(error): Err(error)
				GetCurrentDirectory(result):
					match translate_result(result, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.GetCurrentDirectory(translated))
						Err(error): Err(error)
				StringFromCodepoint(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringFromCodepoint(translated))
						Err(error): Err(error)
				StringSlice(option):
					match translate_option(option, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringSlice(translated))
						Err(error): Err(error)
				ListGet(element, option):
					match concrete_type(opaques, element, substitution, unions, call.span, records):
						Ok(concrete):
							match translate_option(option, result_type, unions, call.span):
								Ok(translated): Ok(Builtins.ListGet(concrete, translated))
								Err(error): Err(error)
						Err(error): Err(error)
				IntEquals(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.IntEquals(translated))
						Err(error): Err(error)
				IntLessThan(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.IntLessThan(translated))
						Err(error): Err(error)
				FloatEquals(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.FloatEquals(translated))
						Err(error): Err(error)
				FloatLessThan(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.FloatLessThan(translated))
						Err(error): Err(error)
				StringEquals(boolean):
					match translate_boolean(boolean, result_type, unions, call.span):
						Ok(translated): Ok(Builtins.StringEquals(translated))
						Err(error): Err(error)

			match concrete_result:
				Ok(concrete): Ok(RuntimeFunction(concrete))
				Err(error): Err(error)
		Checked.ValueCall(_): Err(internal_error(call.span, "stored call reached direct call translation"))
		Checked.CallableParameter(parameter):
			match translated_callable(callables, parameter, call.span):
				Err(error): Err(error)
				Ok(binding):
					choice: Result[KnownCallable, Diagnostic] = match binding:
						ErasedCallableBinding(known, _): Ok(known)
						CapturedCallableBinding(known, _, _): Ok(known)
						_: Err(internal_error(call.span, "runtime callable reached direct call translation"))
					match choice:
						Err(error): Err(error)
						Ok(known):
							runtime_instance(keys, known.body, known.arguments, call.span).map(pure func(id): UserFunction(id))
		Checked.UserFunction(declaration, arguments):
			match semantic_arguments(arguments, substitution, call.span):
				Err(error): Err(error)
				Ok(concrete):
					var choices: List[CallableMode] = []
					var failure: Option[Diagnostic] = None
					for operand in call.operands:
						match operand:
							Checked.ValueOperand(_): void
							Checked.CallableOperand(written_parameter, written_choice, written_span):
								choice_result: Result[CallableMode, Diagnostic] = match written_choice:
									Checked.ForwardedCallable(parameter):
										forward_translation(callables, parameter, written_parameter, written_span)
									Checked.LambdaCallable(id, captures):
										root_arguments = substitution.values
										lambda_storage(id, captures.length(), root_arguments, opaques, substitution, unions, records, written_span).map(pure func(storage): StaticCallable({
											parameter = written_parameter,
											body = Checked.LambdaBody(id),
											arguments = root_arguments,
											storage = storage
										}))
									Checked.MethodCallable(method): method_callable(method, written_parameter, substitution, callables.traits, written_span)
									Checked.NamedCallable(id, named_arguments):
										semantic_arguments(named_arguments, substitution, written_span).map(pure func(values): StaticCallable({
											parameter = written_parameter,
											body = Checked.DeclaredBody(id),
											arguments = values,
											storage = ErasedCallable
										}))
									Checked.StoredCallable(_): Ok(RuntimeCallable(written_parameter))
								match choice_result:
									Ok(choice): choices = choices.append(choice)
									Err(error):
										failure = Some(error)
										break
					match failure:
						Some(error): Err(error)
						None:
							match find_instance(keys, {
								body = Checked.DeclaredBody(declaration),
								arguments = concrete,
								callables = choices
							}, call.span):
								Err(error): Err(error)
								Ok(None): Err(internal_error(call.span, "unexpanded function instance"))
								Ok(Some(id)): Ok(UserFunction(id))

	target ?= target_result
	Ok({
		target = target,
		span = call.span,
	})


private pure func concrete_union_owner(
	value: TypeRef,
	span: Span,
) -> Result[UnionInstanceId, Diagnostic]:
	match value:
		UnionType(id):
			Ok(id)
		_:
			Err(internal_error(span, "variant occurrence has no concrete union type"))


private pure func translate_variant(
	id: Declaration.VariantId,
	owner: UnionInstanceId,
	unions: IndexedList[UnionInstance],
	span: Span,
) -> Result[VariantInstanceId, Diagnostic]:
	instance ?= unions.entries
		.get(union_number(owner))
		.to_result(internal_error(span, "unknown concrete union"))

	_: Void ?= if Declaration.union_number(instance.key.declaration) == Declaration.union_number(Declaration.variant_owner(id)):
		Ok(void)
	else:
		Err(internal_error(span, "variant belongs to a different union declaration"))

	position = Declaration.variant_number(id)
	member ?= union_variants(instance.layout)
		.get(position)
		.to_result(internal_error(span, "unknown union variant"))
	Ok(into_opaque VariantInstanceId({
				owner = owner,
				position = position
			}))


-- A written record field of a literal or an update, with its field instance.
private pure func translate_record_field(
	opaques: List[Checked.CheckedOpaque],
	field: Checked.CheckedRecordField,
	owner: RecordInstanceId,
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[ConcreteRecordField, Diagnostic]:
	id ?= translate_field(field.field, owner, records, field.span)
	child ?= translate_expr(opaques, field.value, substitution, callables, keys, unions, records)
	Ok({ field = id, value = child })


private pure func translate_record_fields(
	opaques: List[Checked.CheckedOpaque],
	fields: List[Checked.CheckedRecordField],
	owner: RecordInstanceId,
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[List[ConcreteRecordField], Diagnostic]:
	var translated: List[ConcreteRecordField] = []
	var failure: Option[Diagnostic] = None

	for field in fields:
		match translate_record_field(opaques, field, owner, substitution, callables, keys, unions, records):
			Ok(concrete):
				translated = translated.append(concrete)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(translated)


private pure func callable_binding_value(
	binding: BindingTranslation, keys: IndexedList[FunctionRequest], span: Span,
) -> Result[ConcreteExpr, Diagnostic]:
	match binding:
		RuntimeValueBinding(runtime, value_type): Ok({ form = ReadBinding(runtime), value_type = value_type, span = span })
		RuntimeCallableBinding(_, runtime, value_type): Ok({ form = ReadBinding(runtime), value_type = value_type, span = span })
		ErasedCallableBinding(known, value_type):
			match runtime_instance(keys, known.body, known.arguments, span):
				Err(error): Err(error)
				Ok(id):
					Ok({ form = FreeCallable(id), value_type = value_type, span = span })
		CapturedCallableBinding(known, runtime, value_type):
			match runtime_instance(keys, known.body, known.arguments, span):
				Err(error): Err(error)
				Ok(id):
					match known.storage:
						ErasedCallable: Err(internal_error(span, "captured callable has erased storage"))
						EnvironmentCallable(owner):
							environment: ConcreteExpr = { form = ReadBinding(runtime), value_type = RecordType(owner), span = span }
							Ok({ form = CapturedCallable(id, environment), value_type = value_type, span = span })


private pure func translate_callable_value(
	opaques: List[Checked.CheckedOpaque], choice: Checked.CallableChoice, value_type: TypeRef,
	substitution: Declarations.Substitution, translation: TranslationBindings,
	keys: IndexedList[FunctionRequest], unions: IndexedList[UnionInstance], records: IndexedList[RecordInstance], span: Span,
) -> Result[ConcreteExpr, Diagnostic]:
	match choice:
		Checked.StoredCallable(value): translate_expr(opaques, value, substitution, translation, keys, unions, records)
		Checked.ForwardedCallable(parameter):
			match translated_callable(translation, parameter, span):
				Err(error): Err(error)
				Ok(binding):
					callable_binding_value(binding, keys, span)
		Checked.MethodCallable(method):
			match selected_method_body(method, substitution, translation.traits, span):
				Err(error): Err(error)
				Ok(selected):
					runtime_instance(keys, selected.body, selected.arguments, span).map(pure func(body) -> ConcreteExpr: { form = FreeCallable(body), value_type = value_type, span = span })
		Checked.NamedCallable(id, arguments):
			match semantic_arguments(arguments, substitution, span):
				Err(error): Err(error)
				Ok(concrete):
					match runtime_instance(keys, Checked.DeclaredBody(id), concrete, span):
						Err(error): Err(error)
						Ok(body):
							Ok({ form = FreeCallable(body), value_type = value_type, span = span })
		Checked.LambdaCallable(id, captures):
			arguments = substitution.values
			match runtime_instance(keys, Checked.LambdaBody(id), arguments, span):
				Err(error): Err(error)
				Ok(body):
					match translate_capture_environment(opaques, id, captures, substitution, translation, keys, unions, records, span):
						Err(error): Err(error)
						Ok(environment):
							form: ConcreteForm = match environment:
								None: FreeCallable(body)
								Some(value): CapturedCallable(body, value)
							Ok({ form = form, value_type = value_type, span = span })


private pure func translate_invocation(
	opaques: List[Checked.CheckedOpaque], value: Checked.CheckedExpr,
	call: Checked.CheckedCall,
	substitution: Declarations.Substitution, translation: TranslationBindings,
	keys: IndexedList[FunctionRequest], unions: IndexedList[UnionInstance], records: IndexedList[RecordInstance],
) -> Result[ConcreteExpr, Diagnostic]:
	callee: Result[Option[ConcreteExpr], Diagnostic] = match call.target:
		Checked.ValueCall(operand): translate_expr(opaques, operand, substitution, translation, keys, unions, records).map(pure func(callee_value): Some(callee_value))
		Checked.CallableParameter(parameter):
			match translated_callable(translation, parameter, call.span):
				Err(error): Err(error)
				Ok(binding):
					match binding:
						RuntimeCallableBinding(_, _, _): callable_binding_value(binding, keys, call.span).map(pure func(callee_value): Some(callee_value))
						_: Ok(None)
		_: Ok(None)
	selected ?= callee
	value_type ?= concrete_type(opaques, value.value_type, substitution, unions, call.span, records)
	match selected:
		Some(callable):
			match translate_call_operands(opaques, call, substitution, translation, keys, unions, records):
				Err(error): Err(error)
				Ok(values):
					Ok({ form = InvokeCallable(callable, values), value_type = value_type, span = value.span })
		None:
			match translate_call(opaques, call, substitution, translation, keys, unions, records, value_type):
				Err(error): Err(error)
				Ok(concrete):
					match translate_call_arguments(opaques, call, substitution, translation, keys, unions, records):
						Err(error): Err(error)
						Ok(values):
							Ok({ form = InvokeFunction(concrete, values), value_type = value_type, span = value.span })


private pure func translate_tuple_element(
	opaques: List[Checked.CheckedOpaque], value: Checked.CheckedExpr,
	receiver: Checked.CheckedExpr, ordinal: Int,
	substitution: Declarations.Substitution, callables: TranslationBindings,
	keys: IndexedList[FunctionRequest], unions: IndexedList[UnionInstance], records: IndexedList[RecordInstance],
) -> Result[ConcreteExpr, Diagnostic]:
	source ?= translate_expr(opaques, receiver, substitution, callables, keys, unions, records)
	match source.value_type:
		RecordType(owner):
			field = into_opaque FieldInstanceId({ owner = owner, position = ordinal })
			translate_leaf(opaques, ReadRecordField(source, field), value, substitution, unions, records)
		_: Err(internal_error(value.span, "tuple projection has a non-record concrete receiver"))


private pure func translate_tuple(
	opaques: List[Checked.CheckedOpaque], value: Checked.CheckedExpr,
	elements: List[Checked.CheckedExpr], substitution: Declarations.Substitution,
	callables: TranslationBindings, keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance], records: IndexedList[RecordInstance],
) -> Result[ConcreteExpr, Diagnostic]:
	value_type ?= concrete_type(opaques, value.value_type, substitution, unions, value.span, records)
	values ?= translate_exprs(opaques, elements, substitution, callables, keys, unions, records)
	match value_type:
		RecordType(owner):
			var fields: List[ConcreteRecordField] = []
			var ordinal = 0
			for child in values:
				fields = fields.append({ field = into_opaque FieldInstanceId({ owner = owner, position = ordinal }), value = child })
				ordinal = ordinal.add(1)
			Ok({ form = ConstructRecord(owner, fields), value_type = value_type, span = value.span })
		_: Err(internal_error(value.span, "tuple construction has a non-record concrete type"))


-- A node's type and identity translate before its children, except a field read,
-- whose instance needs its receiver's concrete record.
private pure func translate_expr(
	opaques: List[Checked.CheckedOpaque],
	value: Checked.CheckedExpr,
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[ConcreteExpr, Diagnostic]:
	match value.form:
		Checked.MakeCallable(choice):
			match concrete_type(opaques, value.value_type, substitution, unions, value.span, records):
				Err(error): Err(error)
				Ok(value_type):
					translate_callable_value(opaques, choice, value_type, substitution, callables, keys, unions, records, value.span)
		Checked.ConstructOpaque(_, child):
			match translate_expr(opaques, child, substitution, callables, keys, unions, records):
				Ok(translated): Ok({ translated | span = value.span })
				Err(error): Err(error)
		Checked.ProjectOpaque(_, child):
			match translate_expr(opaques, child, substitution, callables, keys, unions, records):
				Ok(translated): Ok({ translated | span = value.span })
				Err(error): Err(error)
		Checked.ReadTupleElement(receiver, ordinal):
			translate_tuple_element(opaques, value, receiver, ordinal, substitution, callables, keys, unions, records)
		Checked.ReadRecordField(receiver, field):
			match translate_expr(opaques, receiver, substitution, callables, keys, unions, records):
				Ok(source):
					-- The receiver's translated type already names its record instance.
					match source.value_type:
						RecordType(owner):
							-- The prepared receiver row already owns this exact concrete field type.
							match concrete_record_field_type(field, owner, records, value.span):
								Ok(value_type):
									translated_field = into_opaque FieldInstanceId({ owner = owner, position = Checked.field_number(field) })
									Ok({ form = ReadRecordField(source, translated_field), value_type = value_type, span = value.span })
								Err(error): Err(error)
						_: Err(internal_error(value.span, "record operation has a non-record receiver"))
				Err(error): Err(error)
		Checked.InvokeFunction(call):
			translate_invocation(opaques, value, call, substitution, callables, keys, unions, records)
		Checked.UpdateRecord(declaration, update):
			match record_instance(opaques, declaration, value, substitution, unions, records):
				Ok(owner):
					match translate_expr(opaques, update.base, substitution, callables, keys, unions, records):
						Ok(base):
							match translate_record_fields(opaques, update.replacements, owner, substitution, callables, keys, unions, records):
								Ok(replacements):
									inherited_result: Result[List[RetainedRecordField], Diagnostic] = translated_list(update.inherited, pure func(field: Checked.RetainedRecordField) -> Result[RetainedRecordField, Diagnostic]:
										match translate_field(field.field, owner, records, update.base_expression_span):
											Ok(id):
												match concrete_type(opaques, field.value_type, substitution, unions, update.base_expression_span, records):
													Ok(value_type): Ok({ field = id, value_type = value_type })
													Err(error): Err(error)
											Err(error): Err(error)
									)
									match inherited_result:
										Ok(inherited):
											form: ConcreteForm = UpdateRecord(owner, { base = base, base_expression_span = update.base_expression_span, replacements = replacements, inherited = inherited })
											Ok({ form = form, value_type = RecordType(owner), span = value.span })
										Err(error): Err(error)
								Err(error): Err(error)
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.ConstructVariant(id, children):
			match concrete_type(opaques, value.value_type, substitution, unions, value.span, records):
				Ok(value_type):
					match concrete_union_owner(value_type, value.span):
						Ok(owner):
							match translate_variant(id, owner, unions, value.span):
								Ok(variant):
									match translate_exprs(opaques, children, substitution, callables, keys, unions, records):
										Ok(values): Ok({ form = ConstructVariant(variant, values), value_type = value_type, span = value.span })
										Err(error): Err(error)
								Err(error): Err(error)
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.ConstructTuple(elements):
			translate_tuple(opaques, value, elements, substitution, callables, keys, unions, records)
		Checked.ConstructRecord(declaration, fields):
			match record_instance(opaques, declaration, value, substitution, unions, records):
				Ok(owner):
					match translate_record_fields(opaques, fields, owner, substitution, callables, keys, unions, records):
						Ok(concrete): Ok({ form = ConstructRecord(owner, concrete), value_type = RecordType(owner), span = value.span })
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.ConstructList(elements):
			match concrete_type(opaques, value.value_type, substitution, unions, value.span, records):
				Ok(value_type):
					match translate_exprs(opaques, elements, substitution, callables, keys, unions, records):
						Ok(values): Ok({ form = ConstructList(values), value_type = value_type, span = value.span })
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.Match(join):
			match concrete_type(opaques, value.value_type, substitution, unions, value.span, records):
				Ok(value_type):
					match translate_join(opaques, join, substitution, callables, keys, unions, records, value.span):
						Ok(concrete): Ok({ form = Match(concrete), value_type = value_type, span = value.span })
						Err(error): Err(error)
				Err(error): Err(error)
		Checked.LiteralVoid:
			translate_leaf(opaques, LiteralVoid, value, substitution, unions, records)
		Checked.LiteralString(text):
			translate_leaf(opaques, LiteralString(text), value, substitution, unions, records)
		Checked.LiteralInteger(integer):
			translate_leaf(opaques, LiteralInteger(integer), value, substitution, unions, records)
		Checked.LiteralFloat(number):
			translate_leaf(opaques, LiteralFloat(number), value, substitution, unions, records)
		Checked.ReadCapture(id):
			match callables.capture:
				NoCaptureBinding: Err(internal_error(value.span, "capture read outside a capture environment"))
				LambdaCaptureBinding(lambda, owner, binding):
					if Checked.lambda_number(lambda) == Checked.lambda_number(Checked.capture_owner(id)):
						receiver: ConcreteExpr = { form = ReadBinding(binding), value_type = RecordType(owner), span = value.span }
						field = into_opaque FieldInstanceId({ owner = owner, position = Checked.capture_number(id) })
						translate_leaf(opaques, ReadRecordField(receiver, field), value, substitution, unions, records)
					else:
						Err(internal_error(value.span, "capture read belongs to another lambda"))
		Checked.ReadBinding(id):
			match translated_binding(callables, id, value.span):
				Err(error): Err(error)
				Ok(binding):
					callable_binding_value(binding, keys, value.span)


-- A leaf keeps its checked form; only its type is made concrete.
private pure func translate_leaf(
	opaques: List[Checked.CheckedOpaque],
	form: ConcreteForm,
	value: Checked.CheckedExpr,
	substitution: Declarations.Substitution,
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[ConcreteExpr, Diagnostic]:
	value_type ?= concrete_type(opaques, value.value_type, substitution, unions, value.span, records)
	Ok({ form = form, value_type = value_type, span = value.span })


-- Ordinary values, stored callables and callback environments retain written order.
private pure func translate_call_operands(
	opaques: List[Checked.CheckedOpaque],
	call: Checked.CheckedCall,
	substitution: Declarations.Substitution,
	translation: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[List[ConcreteExpr], Diagnostic]:
	var values: List[ConcreteExpr] = []
	var failure: Option[Diagnostic] = None
	for operand in call.operands:
		match operand:
			Checked.ValueOperand(argument):
				match translate_expr(opaques, argument, substitution, translation, keys, unions, records):
					Err(error): failure = Some(error)
					Ok(value): values = values.append(value)
			Checked.CallableOperand(_, choice, span):
				match translate_callable_operand(opaques, choice, span, substitution, translation, keys, unions, records):
					Err(error): failure = Some(error)
					Ok(environment):
						match environment:
							None: void
							Some(value): values = values.append(value)
		if failure.is_some():
			break
	_: Void ?= match failure:
		Some(error): Err(error)
		None: Ok(void)
	Ok(values)


private pure func translate_call_arguments(
	opaques: List[Checked.CheckedOpaque],
	call: Checked.CheckedCall,
	substitution: Declarations.Substitution,
	translation: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[List[ConcreteExpr], Diagnostic]:
	values ?= translate_call_operands(opaques, call, substitution, translation, keys, unions, records)
	match call.target:
		Checked.CallableParameter(parameter):
			match translated_callable(translation, parameter, call.span):
				Err(error): Err(error)
				Ok(binding):
					match binding:
						ErasedCallableBinding(_, _): Ok(values)
						CapturedCallableBinding(_, _, _):
							match callable_environment(parameter, translation, call.span):
								Err(error): Err(error)
								Ok(environment): Ok([environment].concat(values))
						_: Err(internal_error(call.span, "runtime callable reached direct argument translation"))
		Checked.TraitMethod(_) | Checked.RuntimeFunction(_) | Checked.UserFunction(_, _) | Checked.ValueCall(_): Ok(values)


private pure func translate_callable_operand(
	opaques: List[Checked.CheckedOpaque],
	choice: Checked.CallableChoice,
	span: Span,
	substitution: Declarations.Substitution,
	translation: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[Option[ConcreteExpr], Diagnostic]:
	match choice:
		Checked.MethodCallable(_) | Checked.NamedCallable(_, _): Ok(None)
		Checked.StoredCallable(value): translate_expr(opaques, value, substitution, translation, keys, unions, records).map(pure func(concrete): Some(concrete))
		Checked.ForwardedCallable(parameter):
			match translated_callable(translation, parameter, span):
				Err(error): Err(error)
				Ok(binding):
					match binding:
						ErasedCallableBinding(_, _): Ok(None)
						CapturedCallableBinding(_, _, _): callable_environment(parameter, translation, span).map(pure func(value): Some(value))
						RuntimeCallableBinding(_, _, _): callable_binding_value(binding, keys, span).map(pure func(value): Some(value))
						RuntimeValueBinding(_, _): Err(internal_error(span, "ordinary binding used as a forwarded callable"))
		Checked.LambdaCallable(id, captures):
			translate_capture_environment(opaques, id, captures, substitution, translation, keys, unions, records, span)


private pure func translate_capture_environment(
	opaques: List[Checked.CheckedOpaque], id: Checked.LambdaId, captures: List[Checked.CheckedExpr],
	substitution: Declarations.Substitution, translation: TranslationBindings,
	keys: IndexedList[FunctionRequest], unions: IndexedList[UnionInstance], records: IndexedList[RecordInstance], span: Span,
) -> Result[Option[ConcreteExpr], Diagnostic]:
	match lambda_storage(id, captures.length(), substitution.values, opaques, substitution, unions, records, span):
		Err(error): Err(error)
		Ok(ErasedCallable): Ok(None)
		Ok(EnvironmentCallable(owner)):
			match translate_exprs(opaques, captures, substitution, translation, keys, unions, records):
				Err(error): Err(error)
				Ok(children):
					var fields: List[ConcreteRecordField] = []
					var position = 0
					for value in children:
						fields = fields.append({ field = into_opaque FieldInstanceId({ owner = owner, position = position }), value = value })
						position = position.add(1)
					Ok(Some({ form = ConstructRecord(owner, fields), value_type = RecordType(owner), span = span }))


private pure func translate_exprs(
	opaques: List[Checked.CheckedOpaque],
	values: List[Checked.CheckedExpr],
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[List[ConcreteExpr], Diagnostic]:
	var translated: List[ConcreteExpr] = []
	var failure: Option[Diagnostic] = None

	for value in values:
		match translate_expr(opaques, value, substitution, callables, keys, unions, records):
			Ok(concrete):
				translated = translated.append(concrete)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(translated)


private pure func translate_statements(
	opaques: List[Checked.CheckedOpaque],
	statements: List[Checked.CheckedStatement],
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[List[ConcreteStatement], Diagnostic]:
	translated_list(statements, pure func(
		statement: Checked.CheckedStatement,
	) -> Result[ConcreteStatement, Diagnostic]:
		match statement:
			Checked.InitializeBinding(id, value):
				match translate_expr(opaques, value, substitution, callables, keys, unions, records):
					Ok(translated_value):
						match runtime_binding(callables, id, value.span):
							Ok(runtime): Ok(InitializeBinding(runtime, translated_value))
							Err(error): Err(error)
					Err(error): Err(error)
			Checked.DiscardExpression(value):
				match translate_expr(opaques, value, substitution, callables, keys, unions, records):
					Ok(translated_value): Ok(DiscardExpression(translated_value))
					Err(error): Err(error)
			Checked.ReassignBinding(id, value):
				match translate_expr(opaques, value, substitution, callables, keys, unions, records):
					Ok(translated_value):
						match runtime_binding(callables, id, value.span):
							Ok(runtime): Ok(ReassignBinding(runtime, translated_value))
							Err(error): Err(error)
					Err(error): Err(error)
			Checked.RunWhile(loop):
				match runtime_bindings(callables, loop.carried, loop.span):
					Err(error): Err(error)
					Ok(carried):
						match translate_expr(opaques, loop.condition, substitution, callables, keys, unions, records):
							Err(error): Err(error)
							Ok(condition):
								match translate_statements(opaques, loop.body, substitution, callables, keys, unions, records):
									Err(error): Err(error)
									Ok(body):
										match translate_boolean(loop.boolean, condition.value_type, unions, loop.span):
											Err(error): Err(error)
											Ok(boolean):
												Ok(RunWhile({
													condition = condition, body = body, carried = carried,
													boolean = boolean, span = loop.span,
												}))
			Checked.BreakSourceLoop(span): Ok(BreakSourceLoop(span))
			Checked.ContinueSourceLoop(span): Ok(ContinueSourceLoop(span))
			Checked.RunFor(loop):
				match runtime_bindings(callables, loop.carried, loop.span):
					Err(error): Err(error)
					Ok(carried):
						item_result: Result[Option[Checked.BindingId], Diagnostic] = match loop.item:
							None: Ok(None)
							Some(id): runtime_binding(callables, id, loop.span).map(pure func(runtime): Some(runtime))
						match item_result:
							Err(error): Err(error)
							Ok(item):
								iteration: Result[ConcreteIteration, Diagnostic] = match loop.iteration:
									Checked.ListIteration(iterable, element, option):
										match translate_expr(opaques, iterable, substitution, callables, keys, unions, records):
											Err(error): Err(error)
											Ok(value):
												match concrete_type(opaques, element, substitution, unions, loop.span, records):
													Err(error): Err(error)
													Ok(concrete_element):
														match concrete_type(
															opaques, Checked.NominalType(Checked.AggregateNominal(Checked.UnionAggregate(Declaration.variant_owner(option.some))), [element]),
															substitution, unions, loop.span, records,
														):
															Err(error): Err(error)
															Ok(option_type):
																match translate_option(option, option_type, unions, loop.span):
																	Err(error): Err(error)
																	Ok(concrete_option): Ok(ListIteration(value, concrete_element, concrete_option))
									Checked.AscendingIntRange(start, end, boolean):
										match translate_expr(opaques, start, substitution, callables, keys, unions, records):
											Err(error): Err(error)
											Ok(concrete_start):
												match translate_expr(opaques, end, substitution, callables, keys, unions, records):
													Err(error): Err(error)
													Ok(concrete_end):
														match concrete_type(
															opaques, Checked.NominalType(Checked.AggregateNominal(Checked.UnionAggregate(Declaration.variant_owner(boolean.true_variant))), []),
															substitution, unions, loop.span, records,
														):
															Err(error): Err(error)
															Ok(boolean_type):
																match translate_boolean(boolean, boolean_type, unions, loop.span):
																	Err(error): Err(error)
																	Ok(concrete_boolean): Ok(AscendingIntRange(concrete_start, concrete_end, concrete_boolean))
								match iteration:
									Err(error): Err(error)
									Ok(concrete_iteration):
										match translate_statements(opaques, loop.body, substitution, callables, keys, unions, records):
											Err(error): Err(error)
											Ok(body): Ok(RunFor({
												iteration = concrete_iteration, item = item, body = body,
												carried = carried, span = loop.span,
											}))
	)


private pure func translate_place_variant(
	value_type: TypeRef,
	id: Declaration.VariantId,
	unions: IndexedList[UnionInstance],
	span: Span,
) -> Result[VariantInstanceId, Diagnostic]:
	owner ?= concrete_union_owner(value_type, span)
	translate_variant(id, owner, unions, span)


private pure func translate_place(
	opaques: List[Checked.CheckedOpaque],
	place: Checked.CheckedPatternPlace,
	substitution: Declarations.Substitution,
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[ConcretePatternPlace, Diagnostic]:
	value_type ?= concrete_type(opaques, place.value_type, substitution, unions, span, records)
	route: Result[ConcretePatternRoute, Diagnostic] = match place.route:
		Checked.MatchRoot: Ok(MatchRoot)
		Checked.RecordField(parent, ordinal):
			match translate_place(opaques, parent, substitution, unions, records, span):
				Err(error): Err(error)
				Ok(concrete_parent):
					match concrete_parent.value_type:
						RecordType(owner): Ok(RecordField(concrete_parent, into_opaque FieldInstanceId({ owner = owner, position = ordinal })))
						_: Err(internal_error(span, "pattern record projection has a non-record parent"))
		Checked.ListElement(parent, index):
			match translate_place(opaques, parent, substitution, unions, records, span):
				Err(error): Err(error)
				Ok(concrete_parent): Ok(ListElement(concrete_parent, index))
		Checked.UnionField(parent, id, ordinal):
			match translate_place(opaques, parent, substitution, unions, records, span):
				Err(error): Err(error)
				Ok(concrete_parent):
					match translate_place_variant(concrete_parent.value_type, id, unions, span):
						Err(error): Err(error)
						Ok(variant):
							Ok(UnionField(concrete_parent, into_opaque VariantFieldInstanceId({ variant = variant, position = ordinal })))
	translated ?= route
	Ok({ value_type = value_type, route = translated })


private pure func translate_pattern_argument(
	opaques: List[Checked.CheckedOpaque],
	argument: Checked.CheckedPatternArgument,
	substitution: Declarations.Substitution,
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[ConcretePatternArgument, Diagnostic]:
	match argument:
		Checked.BorrowPlace(place):
			translate_place(opaques, place, substitution, unions, records, span).map(pure func(concrete): BorrowPlace(concrete))
		Checked.CopyListSuffix(place, skipped):
			match translate_place(opaques, place, substitution, unions, records, span):
				Ok(concrete): Ok(CopyListSuffix(concrete, skipped))
				Err(error): Err(error)


private pure func translate_selection(
	opaques: List[Checked.CheckedOpaque],
	selection: Checked.CheckedSelection,
	substitution: Declarations.Substitution,
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[ConcreteSelection, Diagnostic]:
	nodes ?= translated_list(selection.nodes, pure func(node: Checked.CheckedDecisionNode) -> Result[ConcreteDecisionNode, Diagnostic]:
		match node:
			Checked.EnterArm(id, arguments):
				match translated_list(arguments, pure func(argument: Checked.CheckedPatternArgument) -> Result[ConcretePatternArgument, Diagnostic]: translate_pattern_argument(opaques, argument, substitution, unions, records, span)):
					Ok(values): Ok(EnterArm(id, values))
					Err(error): Err(error)
			Checked.TestListLength(place, test, yes, no):
				match translate_place(opaques, place, substitution, unions, records, span):
					Ok(concrete): Ok(TestListLength(concrete, test, yes, no))
					Err(error): Err(error)
			Checked.TestStringBytes(place, bytes, yes, no):
				match translate_place(opaques, place, substitution, unions, records, span):
					Ok(concrete): Ok(TestStringBytes(concrete, bytes, yes, no))
					Err(error): Err(error)
			Checked.TestVariant(place, id, yes, no):
				match translate_place(opaques, place, substitution, unions, records, span):
					Err(error): Err(error)
					Ok(concrete_place):
						match translate_place_variant(concrete_place.value_type, id, unions, span):
							Ok(variant): Ok(TestVariant(concrete_place, variant, yes, no))
							Err(error): Err(error)
	)
	Ok({ nodes = nodes, entry = selection.entry })


-- A non-tail match specializes exactly as the tail match does, arm by arm.
private pure func translate_join(
	opaques: List[Checked.CheckedOpaque],
	join: Checked.CheckedJoin,
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[ConcreteJoin, Diagnostic]:
	carried ?= runtime_bindings(callables, join.carried, span)
	scrutinee ?= translate_expr(opaques, join.scrutinee, substitution, callables, keys, unions, records)
	selected ?= translate_selection(opaques, join.selection, substitution, unions, records, span)
	var arms: List[ConcreteJoinArm] = []
	var failure: Option[Diagnostic] = None
	for arm in join.arms:
		match translate_join_arm(opaques, arm, substitution, callables, keys, unions, records, span):
			Err(error):
				failure = Some(error)
				break
			Ok(translated):
				arms = arms.append(translated)
	match failure:
		Some(error): Err(error)
		None: Ok({ scrutinee = scrutinee, selection = selected, arms = arms, carried = carried })


private pure func translate_join_arm(
	opaques: List[Checked.CheckedOpaque],
	arm: Checked.CheckedJoinArm,
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[ConcreteJoinArm, Diagnostic]:
	statements ?= translate_statements(opaques, arm.statements, substitution, callables, keys, unions, records)
	value ?= translate_expr(opaques, arm.value, substitution, callables, keys, unions, records)
	inputs ?= runtime_bindings(callables, arm.inputs, span)
	Ok({ id = arm.id, inputs = inputs, statements = statements, value = value })


private pure func translate_exit(
	opaques: List[Checked.CheckedOpaque],
	exit: Checked.CheckedExit,
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
) -> Result[ConcreteExit, Diagnostic]:
	match exit:
		Checked.ReturnExpression(value):
			match translate_expr(opaques, value, substitution, callables, keys, unions, records):
				Ok(concrete): Ok(ReturnExpression(concrete))
				Err(error): Err(error)
		Checked.RecurWith(arguments, span):
			match translate_exprs(opaques, arguments, substitution, callables, keys, unions, records):
				Ok(concrete): Ok(RecurWith(concrete, span))
				Err(error): Err(error)


private pure func admit_scalar_type(
	value_type: TypeRef,
	span: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	needs_owner ?= value_needs_ownership(value_type, unions, records)
	match needs_owner:
		False: Ok(void)
		True: Err(diagnostic(span, "managed values in @tail_recursive functions are not supported yet", "use an unmanaged helper, or remove @tail_recursive"))


private pure func admit_scalar_binding(
	id: Checked.BindingId,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	binding ?= bindings.get(Checked.binding_number(id)).to_result(internal_error(compiler_span(), "invalid binding identity in scalar admission"))
	admit_scalar_type(binding.value_type, binding.span, unions, records)


private pure func admit_scalar_values(
	values: List[ConcreteExpr],
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for value in values:
		admitted = admit_scalar_value(value, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


private pure func admit_scalar_fields(
	fields: List[ConcreteRecordField],
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for field in fields:
		admitted = admit_scalar_value(field.value, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


private pure func admit_scalar_value(
	value: ConcreteExpr,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	children ?= match value.form:
		ConstructVariant(_, values): admit_scalar_values(values, bindings, unions, records)
		ConstructList(values): admit_scalar_values(values, bindings, unions, records)
		ConstructRecord(_, fields): admit_scalar_fields(fields, bindings, unions, records)
		UpdateRecord(_, update): admit_scalar_update(update, bindings, unions, records)
		InvokeFunction(_, arguments): admit_scalar_values(arguments, bindings, unions, records)
		InvokeCallable(callee, arguments): admit_scalar_values([callee].concat(arguments), bindings, unions, records)
		FreeCallable(_): Ok(void)
		CapturedCallable(_, environment): admit_scalar_value(environment, bindings, unions, records)
		ReadRecordField(receiver, _): admit_scalar_value(receiver, bindings, unions, records)
		Match(join): admit_scalar_value(join.scrutinee, bindings, unions, records)
		LiteralVoid | LiteralInteger(_) | LiteralFloat(_) | LiteralString(_) | ReadBinding(_): Ok(void)
	span = match value.form:
		InvokeFunction(call, _): call.span
		_: value.span
	_: Void ?= match value.form:
		-- Binding aliases do not define a value in Lower. Parameters and captures
		-- have already been admitted at their actual defining origins.
		ReadBinding(_): Ok(void)
		_: admit_scalar_type(value.value_type, span, unions, records)
	match value.form:
		Match(join): admit_scalar_join(join, bindings, unions, records)
		_: Ok(void)


private pure func admit_scalar_update(
	update: ConcreteRecordUpdate,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	base ?= admit_scalar_value(update.base, bindings, unions, records)
	replaced ?= admit_scalar_fields(update.replacements, bindings, unions, records)
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for field in update.inherited:
		admitted = admit_scalar_type(field.value_type, update.base_expression_span, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


private pure func admit_scalar_statements(
	statements: List[ConcreteStatement],
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for statement in statements:
		admitted = match statement:
			InitializeBinding(_, value): admit_scalar_value(value, bindings, unions, records)
			ReassignBinding(_, value): admit_scalar_value(value, bindings, unions, records)
			DiscardExpression(value): admit_scalar_value(value, bindings, unions, records)
			RunWhile(loop):
				match admit_scalar_value(loop.condition, bindings, unions, records):
					Err(error): Err(error)
					Ok(_): admit_scalar_statements(loop.body, bindings, unions, records)
			BreakSourceLoop(_) | ContinueSourceLoop(_): Ok(void)
			RunFor(loop):
				iteration: Result[Void, Diagnostic] = match loop.iteration:
					ListIteration(iterable, _, _):
						-- The iteration cursor owns list storage even when its source is
						-- a binding alias, so scalar TCO cannot admit that hidden root.
						match admit_scalar_value(iterable, bindings, unions, records):
							Err(error): Err(error)
							Ok(_): admit_scalar_type(iterable.value_type, iterable.span, unions, records)
					AscendingIntRange(start, end, _):
						match admit_scalar_value(start, bindings, unions, records):
							Err(error): Err(error)
							Ok(_): admit_scalar_value(end, bindings, unions, records)
				match iteration:
					Err(error): Err(error)
					Ok(_): admit_scalar_statements(loop.body, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


private pure func admit_scalar_exit(
	exit: ConcreteExit,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match exit:
		ReturnExpression(value): admit_scalar_value(value, bindings, unions, records)
		RecurWith(arguments, _): admit_scalar_values(arguments, bindings, unions, records)


private pure func admit_scalar_arm(
	inputs: List[Checked.BindingId],
	statements: List[ConcreteStatement],
	exit: ConcreteExit,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for id in inputs:
		admitted = admit_scalar_binding(id, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	captures ?= admitted
	prefix ?= admit_scalar_statements(statements, bindings, unions, records)
	admit_scalar_exit(exit, bindings, unions, records)


private pure func admit_scalar_join(
	join: ConcreteJoin,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for binding in join.carried:
		admitted = admit_scalar_binding(binding, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	carriers ?= admitted
	var checked_arms: Result[Void, Diagnostic] = Ok(void)
	for arm in join.arms:
		checked_arms = admit_scalar_arm(arm.inputs, arm.statements, ReturnExpression(arm.value), bindings, unions, records)
		match checked_arms:
			Err(_): break
			Ok(_): void
	checked_arms


private pure func admit_scalar_function(
	function: ConcreteFunction,
	annotation: Span,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for value_type in function.signature.parameters.append(function.signature.return_type):
		admitted = admit_scalar_type(value_type, annotation, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	signature ?= admitted
	prefix ?= admit_scalar_statements(function.statements, function.bindings, unions, records)
	match function.body:
		ConcreteValueBody(exit): admit_scalar_exit(exit, function.bindings, unions, records)
		ConcreteMatchBody(matched): admit_scalar_match(matched, function.bindings, unions, records)


private pure func admit_scalar_match(
	matched: ConcreteMatch,
	bindings: List[ConcreteBinding],
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	scrutinee ?= admit_scalar_value(matched.scrutinee, bindings, unions, records)
	var admitted: Result[Void, Diagnostic] = Ok(void)
	for arm in matched.arms:
		admitted = admit_scalar_arm(arm.inputs, arm.statements, arm.body, bindings, unions, records)
		match admitted:
			Err(_): break
			Ok(_): void
	admitted


-- Eligibility only: this does not re-establish checking's source/whole-program
-- invariants. Production calls it once per translated function, after all
-- concrete layouts are sealed.
pure func admit_scalar_loop(
	function: ConcreteFunction,
	unions: List[ConcreteUnion],
	records: List[ConcreteRecord],
) -> Result[Void, Diagnostic]:
	match function.execution:
		OrdinaryCalls: Ok(void)
		SelfTailLoop(annotation): admit_scalar_function(function, annotation, unions, records)

private record TranslatedParameters {
	parameters: List[TypeRef],
	bindings: List[ConcreteBinding],
	translation: TranslationBindings
}


private pure func translate_parameters(
	opaques: List[Checked.CheckedOpaque],
	function: SelectedBody,
	key: InstanceKey,
	substitution: Declarations.Substitution,
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	traits: Checked.AcceptedTraits,
) -> Result[TranslatedParameters, Diagnostic]:
	span = function.return_type.span
	var parameters: List[TypeRef] = []
	var bindings: List[ConcreteBinding] = []
	var translations: List[BindingTranslation] = []
	var capture: CaptureBinding = NoCaptureBinding
	var failure: Option[Diagnostic] = None
	match key.body:
		Checked.DeclaredBody(_) | Checked.DerivedEqualityBody(_): void
		Checked.LambdaBody(id):
			match lambda_storage(id, function.captures.length(), key.arguments, opaques, substitution, unions, records, span):
				Err(error): failure = Some(error)
				Ok(ErasedCallable): void
				Ok(EnvironmentCallable(owner)):
					capture = LambdaCaptureBinding(id, owner, Checked.binding_id(function.bindings.length()))
					parameters = [RecordType(owner)]

	-- The checked binding origin carries the formal link. Erasing a selected
	-- callable cannot shift another checked id: this map records every old id.
	for written in function.bindings:
		if failure.is_some():
			break
		runtime = Checked.binding_id(bindings.length())
		match written.origin:
			Checked.CallableParameterBinding(parameter):
				match callable_mode(key.callables, parameter, written.span):
					Err(error): failure = Some(error)
					Ok(StaticCallable(known)):
						match concrete_type(opaques, written.value_type, substitution, unions, written.span, records):
							Err(error): failure = Some(error)
							Ok(value_type):
								match known.storage:
									ErasedCallable: translations = translations.append(ErasedCallableBinding(known, value_type))
									EnvironmentCallable(owner):
										translations = translations.append(CapturedCallableBinding(known, runtime, value_type))
										bindings = bindings.append({ origin = Checked.ParameterBinding(parameters.length()), value_type = RecordType(owner), span = written.span })
										parameters = parameters.append(RecordType(owner))
					Ok(RuntimeCallable(_)):
						match concrete_type(opaques, written.value_type, substitution, unions, written.span, records):
							Err(error): failure = Some(error)
							Ok(value_type):
								translations = translations.append(RuntimeCallableBinding(parameter, runtime, value_type))
								bindings = bindings.append({ origin = Checked.ParameterBinding(parameters.length()), value_type = value_type, span = written.span })
								parameters = parameters.append(value_type)
			_:
				match concrete_type(opaques, written.value_type, substitution, unions, written.span, records):
					Err(error): failure = Some(error)
					Ok(value_type):
						origin = match written.origin:
							Checked.ParameterBinding(_): Checked.ParameterBinding(parameters.length())
							_: written.origin
						match written.origin:
							Checked.ParameterBinding(_): parameters = parameters.append(value_type)
							_: void
						translations = translations.append(RuntimeValueBinding(runtime, value_type))
						bindings = bindings.append({ origin = origin, value_type = value_type, span = written.span })
	match capture:
		NoCaptureBinding: void
		LambdaCaptureBinding(id, owner, _):
			-- Lambda requests use runtime parameter modes. Publish the actual final
			-- local ordinal here, independently of any erased declaration formals.
			capture = LambdaCaptureBinding(id, owner, Checked.binding_id(bindings.length()))
			bindings = bindings.append({ origin = Checked.ParameterBinding(0), value_type = RecordType(owner), span = span })

	match failure:
		Some(error): Err(error)
		None: Ok({
			parameters = parameters, bindings = bindings,
			translation = { bindings = translations, capture = capture, traits = traits },
		})


private pure func translate_match_arm(
	opaques: List[Checked.CheckedOpaque],
	arm: Checked.CheckedArm,
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[ConcreteArm, Diagnostic]:
	statements ?= translate_statements(opaques, arm.statements, substitution, callables, keys, unions, records)
	body ?= translate_exit(opaques, arm.body, substitution, callables, keys, unions, records)
	inputs ?= runtime_bindings(callables, arm.inputs, span)
	Ok({ id = arm.id, inputs = inputs, statements = statements, body = body })


private pure func translate_match(
	opaques: List[Checked.CheckedOpaque],
	matched: Checked.CheckedMatch,
	substitution: Declarations.Substitution,
	callables: TranslationBindings,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	span: Span,
) -> Result[ConcreteMatch, Diagnostic]:
	scrutinee ?= translate_expr(opaques, matched.scrutinee, substitution, callables, keys, unions, records)
	selected ?= translate_selection(opaques, matched.selection, substitution, unions, records, span)
	arms ?= translated_list(matched.arms, pure func(arm: Checked.CheckedArm) -> Result[ConcreteArm, Diagnostic]:
		translate_match_arm(opaques, arm, substitution, callables, keys, unions, records, span)
	)
	Ok({ scrutinee = scrutinee, selection = selected, arms = arms })


private pure func translate_function(
	opaques: List[Checked.CheckedOpaque],
	function: SelectedBody,
	key: InstanceKey,
	keys: IndexedList[FunctionRequest],
	unions: IndexedList[UnionInstance],
	records: IndexedList[RecordInstance],
	union_layouts: List[ConcreteUnion],
	record_layouts: List[ConcreteRecord],
	traits: Checked.AcceptedTraits,
) -> Result[ConcreteFunction, Diagnostic]:
	span = function.return_type.span
	substitution ?= function_substitution(function, key.arguments, span)

	runtime ?= translate_parameters(opaques, function, key, substitution, unions, records, traits)
	parameters = runtime.parameters
	bindings = runtime.bindings
	translation = runtime.translation

	return_type ?= concrete_type(
		opaques,
		function.return_type.value_type,
		substitution,
		unions,
		function.return_type.span,
		records,
	)

	statements ?= translate_statements(opaques, function.statements, substitution, translation, keys, unions, records)

	body_result: Result[ConcreteBody, Diagnostic] = match function.body:
		Checked.CheckedValueBody(value):
			translate_exit(opaques, value, substitution, translation, keys, unions, records).map(pure func(concrete): ConcreteValueBody(concrete))
		Checked.CheckedMatchBody(matched):
			translate_match(opaques, matched, substitution, translation, keys, unions, records, span).map(pure func(concrete): ConcreteMatchBody(concrete))

	body ?= body_result
	label = match key.body:
		Checked.LambdaBody(_): lambda_label(function.base_label)
		Checked.DeclaredBody(_) | Checked.DerivedEqualityBody(_): function.base_label
	concrete: ConcreteFunction = {
		label = label,
		execution = function.execution,
		signature = {
			parameters = parameters,
			return_type = return_type
		},
		bindings = bindings,
		statements = statements,
		body = body,
	}
	admitted ?= admit_scalar_loop(concrete, union_layouts, record_layouts)

	Ok(concrete)


pure func specialize(program: CheckedProgram) -> Result[SpecializedProgram, Diagnostic]:
	checked = checked_functions(program)
	-- Checked entrypoint identity is the only root. Requests discover complete
	-- callees and layouts before this local builder freezes into the concrete program.
	entry_key: InstanceKey = {
		body = Checked.DeclaredBody(entry_function(checked.entrypoint)),
		arguments = [],
		callables = []
	}
	initial: PreparedInstances = {
		functions = append_entry(empty_indexed_list(), { key = entry_key, source = EntrypointRoot }, body_digest(entry_key.body)),
		unions = empty_indexed_list(),
		records = empty_indexed_list()
	}
	expanded ?= expand_instances(checked, initial)
	sealed_unions ?= seal_unions(expanded.unions)
	sealed_records ?= seal_records(expanded.records)
	prepared: SealedInstances = { functions = expanded.functions, unions = sealed_unions, records = sealed_records }
	union_layouts = prepared.unions.entries.map(pure func(instance: UnionInstance): instance.layout)
	record_layouts = prepared.records.entries.map(pure func(instance: RecordInstance): instance.layout)
	functions ?= translated_list(prepared.functions.entries, pure func(
		request: FunctionRequest,
	) -> Result[ConcreteFunction, Diagnostic]:
		match selected_body(checked, request.key.body, request.source):
			Err(error): Err(error)
			Ok(function):
				translate_function(
					checked.opaques,
					function,
					request.key,
					prepared.functions,
					prepared.unions,
					prepared.records,
					union_layouts,
					record_layouts,
					checked.traits,
				)
	)
	entry_span: Span = compiler_span()
	located ?= find_instance(prepared.functions, entry_key, entry_span)
	entrypoint ?= located.to_result(internal_error(entry_span, "missing entrypoint instance"))

	accepted: Entrypoint[FunctionInstanceId] = match checked.entrypoint:
		NoArguments(_, result):
			NoArguments(entrypoint, result)
		WithArguments(_, result):
			WithArguments(entrypoint, result)

	Ok(into_opaque SpecializedProgram({
				records = record_layouts,
				unions = union_layouts,
				functions = functions,
				entrypoint = accepted
			}))
