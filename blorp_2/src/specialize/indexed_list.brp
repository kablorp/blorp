---
A list of specialization instances with an index from an Int digest to the
positions of the entries that share it. A lookup compares full keys only
within one digest's positions, so the cost no longer grows with the number of
instances.

The digest is a hint, never an identity: equal keys share one, and the caller
then compares whole keys. Different keys may share a digest, which costs a
comparison and changes no result. Only `append_entry` adds to the index, in
the same step as the entry, and a lookup that finds them disagreeing reports
it. Entries never move. A caller that replaces entries, or carries `positions`
over to a list of another entry type, keeps every key field its digest reads.

`IndexedList` is a plain record, so importers can reach `entries`: Blorp 2 has
no generic opaque types yet. The module becomes opaque when it does, and
`entries` is then read through an accessor.
---
import:
	../utils/int_map as IntMaps
	int: Int methods
	list: List methods


-- `positions` maps a digest to the positions in `entries` of the entries
-- appended under it, in append order.
fixed record IndexedList[T] {
	entries: List[T],
	positions: IntMaps.IntMap[List[Int]]
}


pure func empty_indexed_list[T]() -> IndexedList[T]:
	no_entries: List[T] = []
	{ entries = no_entries, positions = IntMaps.empty_int_map() }


-- `table` with `entry` at the next position, indexed under `digest`.
pure func append_entry[T](table: IndexedList[T], entry: T, digest: Int) -> IndexedList[T]:
	{
		entries = table.entries.append(entry),
		positions = IntMaps.set(table.positions, digest, candidate_positions(table, digest).append(table.entries.length())),
	}


-- The positions of every entry appended under `digest`: the only entries a
-- key with this digest can equal.
pure func candidate_positions[T](table: IndexedList[T], digest: Int) -> List[Int]:
	match IntMaps.get(table.positions, digest):
		Some(bucket): bucket
		None: []


-- The first position under `digest` whose entry satisfies `matches`: the
-- whole-key comparison the digest only narrows. `Err` is an indexed position
-- with no entry, which `append_entry` cannot produce.
pure func find_position[T](
	table: IndexedList[T], digest: Int, matches: pure (T) -> Bool,
) -> Result[Option[Int], Int]:
	var outcome: Result[Option[Int], Int] = Ok(None)

	for position in candidate_positions(table, digest):
		match table.entries.get(position):
			Some(entry):
				if matches(entry):
					outcome = Ok(Some(position))
					break
			None:
				outcome = Err(position)
				break

	outcome
