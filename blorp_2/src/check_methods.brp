---
The callable scope of each module: direct-call targets and the receiver
functions UFCS may select, chosen by receiver type and argument count.
---
import:
	./check_calls:
		Caller,
		contains_parameter,
		ReceiverContract,
		infer_arguments,
		inferred_substitution,
		receiver_contract,
		start_inference,
	./check_errors:
		ArgumentMismatch,
		CallError(UnknownFunction),
		CheckError,
		CheckerInvariant(AmbiguousResolvedFunction, InvalidResolvedFunction),
		ExpectedTypeSite(SourceAnnotation),
		MethodCandidateSite,
		MethodError(AmbiguousMethod, ConstructorUFCS, MethodArgumentCounts, NoApplicableMethod),
		call_error,
		checker_invariant,
		method_error,
	./check_model:
		CheckedRecord,
		CheckedUnion,
		FunctionSignature,
		TypeParameterOwner(FunctionDeclaration),
		TypeRef,
		TypeUse,
		same_type,
		type_head,
	./check_signatures: AcceptedFunction
	./check_types: TypeAdmission, substitute_type
	declarations: FunctionId, function_id, function_number
	int as IntOps
	list: contains
	names: NameId, same_name
	namespace:
		FunctionOrigin(LocalFunction, ImportedFunction),
		Namespace,
		imported_functions,
		method_selection_requests,
		same_type_candidate,
		variant_candidates,
	option: is_some
	result: and_then
	source: ModuleId, same_module
	syntax: CallNotation(DirectCall, ReceiverCall), ReceiverApplication, Span, WrittenName


pure func contains_variant(namespace: Namespace, module: ModuleId, name: NameId) -> Bool:
	variant_candidates(namespace, module, name)
		.get(0)
		.is_some()


fixed record ResolutionContext {
	caller: Caller,
	module: ModuleId,
	namespace: Namespace,
	signatures: List[AcceptedFunction],
	unions: List[CheckedUnion],
	records: List[CheckedRecord],
	callables: List[CallableBinding],
	admission: TypeAdmission
}


-- A receiver function UFCS may select, with its accepted declaration.
fixed record ReceiverCandidate {
	binding: CallableBinding,
	function: AcceptedFunction
}


fixed union ResolvedReceiver:
	UniqueReceiver(ReceiverContract)
	ReceiverCandidates(List[ReceiverCandidate])


private fixed union CallableVisibility:
	DirectAndUfcs
	UfcsOnly


fixed record CallableBinding {
	module: ModuleId,
	name: NameId,
	function: FunctionId,
	visibility: CallableVisibility,
	origin: FunctionOrigin
}


private pure func callable_candidates(
	bindings: List[CallableBinding],
	module: ModuleId,
	name: NameId,
	notation: CallNotation,
) -> List[CallableBinding]:
	var candidates: List[CallableBinding] = []

	for binding in bindings:
		visible = match notation:
			ReceiverCall:
				True
			DirectCall:
				match binding.visibility:
					DirectAndUfcs:
						True
					UfcsOnly:
						False

		if (
			visible
			and same_module(binding.module, module)
			and same_name(binding.name, name)
		):
			candidates = candidates.append(binding)

	candidates


pure func lookup_target(
	context: ResolutionContext,
	name: WrittenName,
) -> Result[Option[FunctionId], CheckError]:
	match callable_candidates(context.callables, context.module, name.id, DirectCall):
		[]:
			Ok(None)
		[candidate]:
			Ok(Some(candidate.function))
		[_, _, ..._]:
			Err(checker_invariant(name.span, AmbiguousResolvedFunction(name.id)))


private pure func append_callable(
	bindings: List[CallableBinding],
	incoming: CallableBinding,
) -> List[CallableBinding]:
	var result = bindings
	var position = 0
	var found = False

	for binding in bindings:
		if (
			same_module(binding.module, incoming.module)
			and IntOps.equals(function_number(binding.function), function_number(incoming.function))
		):
			-- Availability belongs to this scope. A named exposure promotes the
			-- existing identity without creating another overload candidate.
			match incoming.visibility:
				DirectAndUfcs:
					result = result.set(position, { incoming | visibility = DirectAndUfcs })
				UfcsOnly:
					void

			found = True
			break

		position = IntOps.add(position, 1)

	if found:
		result
	else:
		result.append(incoming)


pure func build_callables(
	namespace: Namespace,
	functions: List[AcceptedFunction],
) -> List[CallableBinding]:
	-- Derived once after accepted signatures. Bindings retain only declaration
	-- identity, scope availability and provenance; signatures have one authority.
	var bindings: List[CallableBinding] = []
	var position = 0

	for function in functions:
		bindings = append_callable(
			bindings,
			{
				module = function.declaration.module,
				name = function.declaration.function_name.id,
				function = function_id(position),
				visibility = DirectAndUfcs,
				origin = LocalFunction
			},
		)
		position = IntOps.add(position, 1)

	for binding in imported_functions(namespace):
		bindings = append_callable(
			bindings,
			{
				module = binding.module,
				name = binding.name.id,
				function = binding.function,
				visibility = DirectAndUfcs,
				origin = ImportedFunction(binding.name.span)
			},
		)

	for request in method_selection_requests(namespace):
		position = 0

		for function in functions:
			if same_module(function.declaration.module, request.target):
				receiver = function.signature.parameters
					.get(0)
					.and_then(pure func(parameter): type_head(parameter.value_type))

				match receiver:
					Some(head):
						if same_type_candidate(head, request.receiver):
							bindings = append_callable(
								bindings,
								{
									module = request.module,
									name = function.declaration.function_name.id,
									function = function_id(position),
									visibility = UfcsOnly,
									origin = ImportedFunction(request.name.span)
								},
							)
					None:
						void

			position = IntOps.add(position, 1)

	bindings


pure func method_sites(candidates: List[ReceiverCandidate]) -> List[MethodCandidateSite]:
	var sites: List[MethodCandidateSite] = []

	for candidate in candidates:
		import_site = match candidate.binding.origin:
			LocalFunction:
				None
			ImportedFunction(site):
				Some(site)

		sites = sites.append({
			function = candidate.binding.function,
			declaration = candidate.function.declaration.function_name.span,
			import_site = import_site,
		})

	sites


pure func classify_receiver(
	application: ReceiverApplication,
	context: ResolutionContext,
) -> Result[ResolvedReceiver, CheckError]:
	name = application.callee

	match callable_candidates(context.callables, context.module, name.id, ReceiverCall):
		[]:
			if contains_variant(context.namespace, context.module, name.id):
				Err(method_error(name.span, ConstructorUFCS(name.id)))
			else:
				Err(call_error(name.span, UnknownFunction(name.id)))
		[candidate]:
			contract ?= receiver_contract(
				context.caller,
				name,
				application.arguments,
				candidate.function,
				context.signatures,
			)
			Ok(UniqueReceiver(contract))
		candidates:
			resolved ?= receiver_candidates(candidates, context.signatures, name.span, [])
			Ok(ReceiverCandidates(resolved))


private pure func receiver_candidates(
	bindings: List[CallableBinding],
	signatures: List[AcceptedFunction],
	span: Span,
	resolved: List[ReceiverCandidate],
) -> Result[List[ReceiverCandidate], CheckError]:
	match bindings.get(resolved.length()):
		None:
			Ok(resolved)
		Some(binding):
			function ?= signatures
				.get(function_number(binding.function))
				.to_result(checker_invariant(span, InvalidResolvedFunction(binding.function)))
			receiver_candidates(
				bindings,
				signatures,
				span,
				resolved.append({
					binding = binding,
					function = function,
				}),
			)


-- A concrete first parameter can give a receiver constructor its type.
private pure func receiver_parameter(signature: FunctionSignature) -> Option[TypeRef]:
	match signature.parameters.get(0):
		None:
			None
		Some(parameter):
			if (
				signature.type_parameters.is_empty()
				and not contains_parameter(parameter.value_type)
			):
				Some(parameter.value_type)
			else:
				None


-- Competing receivers supply an expected type only when they all agree on it.
pure func receiver_expectation(receiver: ResolvedReceiver) -> Option[TypeRef]:
	match receiver:
		UniqueReceiver(contract):
			receiver_parameter(contract.call.signature)
		ReceiverCandidates(candidates):
			var expectation: Option[TypeRef] = None
			var common = True

			for candidate in candidates:
				match receiver_parameter(candidate.function.signature):
					None:
						common = False
					Some(value_type):
						match expectation:
							None:
								expectation = Some(value_type)
							Some(previous):
								common = common and same_type(previous, value_type)

			if common:
				expectation
			else:
				None


-- Whether a receiver of the actual type satisfies a candidate's first
-- parameter, inferring the candidate's type parameters from the receiver alone.
private pure func receiver_matches(
	function: FunctionId,
	signature: FunctionSignature,
	parameter: TypeUse,
	actual: TypeUse,
) -> Bool:
	inference = start_inference(FunctionDeclaration(function), signature.type_parameters)
	obligation: ArgumentMismatch = {
		expected = parameter.value_type,
		actual = actual,
		argument_position = 0,
		expected_site = SourceAnnotation(parameter.span)
	}

	match infer_arguments(parameter.value_type, actual.value_type, inference, obligation):
		Err(_):
			False
		Ok(inferred):
			match substitute_type(
				parameter.value_type,
				inferred_substitution(inferred),
				actual.span,
			):
				Err(_):
					False
				Ok(expected):
					same_type(expected, actual.value_type)


pure func select_receiver_contract(
	application: ReceiverApplication,
	receiver: ResolvedReceiver,
	actual: TypeUse,
	context: ResolutionContext,
) -> Result[ReceiverContract, CheckError]:
	match receiver:
		UniqueReceiver(contract):
			Ok(contract)
		ReceiverCandidates(candidates):
			arity = IntOps.add(application.arguments.length(), 1)
			chosen ?= choose_receiver(application.callee, candidates, actual, arity)
			receiver_contract(
				context.caller,
				application.callee,
				application.arguments,
				chosen.binding.function,
				context.signatures,
			)


-- Competing receivers are narrowed by receiver type, then by argument count;
-- import order never ranks them.
private pure func choose_receiver(
	callee: WrittenName,
	candidates: List[ReceiverCandidate],
	actual: TypeUse,
	arity: Int,
) -> Result[ReceiverCandidate, CheckError]:
	var compatible: List[ReceiverCandidate] = []
	var matching_arity: List[ReceiverCandidate] = []
	var counts: List[Int] = []

	for candidate in candidates:
		signature = candidate.function.signature

		match signature.parameters.get(0):
			Some(parameter):
				if receiver_matches(candidate.binding.function, signature, parameter, actual):
					compatible = compatible.append(candidate)
					count = signature.parameters.length()

					if IntOps.equals(count, arity):
						matching_arity = matching_arity.append(candidate)

					if not counts.contains(count):
						counts = counts.append(count)
			None:
				void

	match compatible:
		[]:
			Err(
				method_error(
					callee.span,
					NoApplicableMethod(callee.id, actual.value_type, method_sites(candidates)),
				),
			)
		[candidate]:
			Ok(candidate)
		_:
			match matching_arity:
				[candidate]:
					Ok(candidate)
				[]:
					Err(
						method_error(
							callee.span,
							MethodArgumentCounts(
								callee.id,
								arity,
								counts,
								method_sites(compatible),
							),
						),
					)
				applicable:
					Err(
						method_error(
							callee.span,
							AmbiguousMethod(callee.id, actual.value_type, method_sites(applicable)),
						),
					)
