-- Temporary input library, copied from standard_library/src/int.brp.
-- Upstream revision: 7cb72f355a82474c386cb95f524f6fe98612624d
-- Upstream SHA256: 2b9dd588eaac0b90be4bfe80f5e7f1833f938f2968eaac501e61fedf292605f6
-- Int is owned by _base.brp. Active arithmetic functions are lifted
-- from upstream trait implementations.
import:
    _base: Int, String, Bool(True, False)
    traits: Equatable

implements Equatable for Int:
    pure func equals(left: Self, right: Self) -> Bool:
        builtin("int.equals")

pure func less_than(a: Int, b: Int) -> Bool:
    builtin("int.less_than")

pure func greater_than(a: Int, b: Int) -> Bool:
    less_than(b, a)

pure func less_than_or_equal(a: Int, b: Int) -> Bool:
    match less_than(b, a):
        True: False
        False: True

pure func greater_than_or_equal(a: Int, b: Int) -> Bool:
    match less_than(a, b):
        True: False
        False: True

pure func min(a: Int, b: Int) -> Int:
    match less_than(a, b):
        True: a
        False: b

pure func max(a: Int, b: Int) -> Int:
    match less_than(b, a):
        True: a
        False: b

INT_MIN: Int = -9223372036854775808
INT_MAX: Int = 9223372036854775807

pure func add(a: Int, b: Int) -> Int:
    builtin("int.add")

pure func to_string(value: Int) -> String:
    builtin("int.to_string")

pure func subtract(a: Int, b: Int) -> Int:
    builtin("int.subtract")

pure func multiply(a: Int, b: Int) -> Int:
    builtin("int.multiply")

pure func divide(a: Int, b: Int) -> Int:
    builtin("int.divide")

pure func remainder(a: Int, b: Int) -> Int:
    builtin("int.remainder")
