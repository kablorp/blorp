-- Temporary input library, copied from standard_library/src/int.brp.
-- Upstream revision: 7cb72f355a82474c386cb95f524f6fe98612624d
-- Upstream SHA256: 2b9dd588eaac0b90be4bfe80f5e7f1833f938f2968eaac501e61fedf292605f6
-- Int is owned by _base.brp and implements its ordering and arithmetic traits.
import:
    _base:
        Int, String, Bool(True, False), Orderable, Hashable,
        Addable, Subtractable, Multipliable, Divisible, Modulable, Negatable
    traits: Equatable

implements Equatable for Int:
    pure func equals(left: Self, right: Self) -> Bool:
        builtin("int.equals")

implements Hashable for Int:
    pure func hash(value: Self) -> Int:
        value

implements Orderable for Int:
    pure func less_than(left: Self, right: Self) -> Bool:
        builtin("int.less_than")

pure func min(a: Int, b: Int) -> Int:
    match less_than(a, b):
        True: a
        False: b

pure func max(a: Int, b: Int) -> Int:
    match less_than(b, a):
        True: a
        False: b

INT_MIN: Int = -9223372036854775808
INT_MAX: Int = 9223372036854775807

implements Addable for Int:
    pure func add(left: Self, right: Self) -> Self:
        builtin("int.add")

pure func to_string(value: Int) -> String:
    builtin("int.to_string")

implements Subtractable for Int:
    pure func subtract(left: Self, right: Self) -> Self:
        builtin("int.subtract")

implements Multipliable for Int:
    pure func multiply(left: Self, right: Self) -> Self:
        builtin("int.multiply")

implements Divisible for Int:
    pure func divide(left: Self, right: Self) -> Self:
        builtin("int.divide")

implements Modulable for Int:
    pure func remainder(left: Self, right: Self) -> Self:
        builtin("int.remainder")

-- Subtraction wraps, so the negation of INT_MIN is INT_MIN.
implements Negatable for Int:
    pure func negate(value: Self) -> Self:
        subtract(0, value)
