-- The base owns primitive identities, ordinary base unions, and the Orderable
-- and Hashable traits. It is the only module that may declare builtin types;
-- every other module imports what it uses.
type Int = builtin
type Float = builtin
type String = builtin
type Void = builtin
type List[T] = builtin

union Bool:
    True
    False

union Option[A]:
    Some(A)
    None

union Result[Value, Error]:
    Ok(Value)
    Err(Error)

-- Ordering for `T: Orderable`. Only less_than is required; the defaults assume a
-- total order, so a type with incomparable values, such as Float's NaN, writes
-- its own less_than_or_equal and greater_than_or_equal. A library module may
-- implement a trait declared here for a type declared here, which is how int.brp
-- and float.brp implement it. `_base` imports nothing, so the defaults use match
-- rather than `not`.
trait Orderable:
    pure func less_than(left: Self, right: Self) -> Bool
    pure func greater_than(left: Self, right: Self) -> Bool:
        less_than(right, left)
    pure func less_than_or_equal(left: Self, right: Self) -> Bool:
        match less_than(right, left):
            True: False
            False: True
    pure func greater_than_or_equal(left: Self, right: Self) -> Bool:
        match less_than(left, right):
            True: False
            False: True

-- Hashes may be any signed Int. Equal values must have equal hashes; distinct
-- values may collide. Implementations are written explicitly, never derived.
trait Hashable:
    pure func hash(value: Self) -> Int

-- Set, Dict, and other foundational declarations remain deferred.
