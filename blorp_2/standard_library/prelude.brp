-- The prelude is the only implicit import, and only user modules receive it.
-- Types, Orderable and Hashable come from _base; traits supplies canonical equality.
-- Each operation module contributes its written receiver methods.
import:
    _base: Int, Float, String, List, Void, Bool(True, False), Option(Some, None), Result(Ok, Err), Orderable, Hashable
    traits: Equatable
    int: Int methods
    float: Float methods
    string: String methods
    list: List methods
