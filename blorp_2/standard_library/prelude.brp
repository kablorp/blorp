-- The prelude is the only implicit import, and only user modules receive it.
-- Types, Orderable, Hashable and the arithmetic traits come from _base; traits
-- supplies the canonical equality contract.
-- Each operation module contributes its written receiver methods.
import:
    _base:
        Int, Float, String, List, Void, Bool(True, False), Option(Some, None), Result(Ok, Err), Orderable,
        Hashable, Addable, Subtractable, Multipliable, Divisible, Modulable, Negatable
    traits: Equatable
    int: Int methods
    float: Float methods
    string: String methods
    list: List methods
