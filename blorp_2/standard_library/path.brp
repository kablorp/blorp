-- Pure logical paths; only ASCII '/' is a separator.
import:
    _base: Int, String, List, Bool(True, False), Option(Some, None)
    int: Int methods_only
    string: String methods_only
    list: List methods_only

private PATH_SEPARATOR_BYTE: Int = 47

private pure func is_separator(path: String, position: Int) -> Bool:
    match path.byte_at(position):
        Some(byte): byte.equals(PATH_SEPARATOR_BYTE)
        None: False

-- Empty children add or preserve the separator used by library-prefix checks.
-- Components and separator runs are preserved without normalization.
pure func join(base: String, child: String) -> String:
    match is_separator(child, 0):
        True:
            child
        False:
            base_length = base.length()
            match base_length.equals(0):
                True:
                    child
                False:
                    match is_separator(base, base_length.subtract(1)):
                        True:
                            base.add(child)
                        False:
                            base.add("/").add(child)

-- Ignore trailing separators, remove the final component and its separator run.
-- Interior components remain lexical; root stays '/', empty/basename becomes '.'.
pure func dirname(path: String) -> String:
    var end = path.length()

    while end.greater_than(0):
        match is_separator(path, end.subtract(1)):
            True: end = end.subtract(1)
            False: break

    while end.greater_than(0):
        match is_separator(path, end.subtract(1)):
            True: break
            False: end = end.subtract(1)

    while end.greater_than(0):
        match is_separator(path, end.subtract(1)):
            True: end = end.subtract(1)
            False: break

    match end.equals(0):
        True:
            match is_separator(path, 0):
                True: "/"
                False: "."
        False:
            -- 0 < end <= byte length, and byte[end] is ASCII '/'.
            -- Both endpoints are scalar boundaries; checked Slice cannot fail.
            match path.slice(0, end):
                Some(parent): parent
                None: "."

-- Callers supply one nonempty component cut at proved scalar boundaries.
-- Only ordinary components cancel; unresolved relative parents remain stacked.
private pure func normalized_component(components: List[String], component: String, absolute: Bool) -> List[String]:
    match component.equals("."):
        True: components
        False:
            match component.equals(".."):
                False: components.append(component)
                True:
                    match components.last():
                        Some(previous):
                            match previous.equals(".."):
                                True: components.append(component)
                                False: components.take(components.length().subtract(1))
                        None:
                            match absolute:
                                True: components
                                False: components.append(component)

-- Pure logical normalization: no filesystem, symlink or Unicode normalization.
-- The byte scan/materialization is linear. List append/take still copy slots,
-- and final List.join uses balanced String copying; no COW cost is assumed.
pure func normalize(path: String) -> String:
    absolute = is_separator(path, 0)
    size = path.length()
    var components: List[String] = []
    var start = 0
    var position = 0

    while position.less_than(size):
        if is_separator(path, position):
            if start.less_than(position):
                -- start is 0 or follows '/'; position points at ASCII '/'.
                -- 0 <= start < position < size; both are scalar boundaries.
                components = match path.slice(start, position):
                    Some(component): normalized_component(components, component, absolute)
                    None: components
            start = position.add(1)
        position = position.add(1)

    if start.less_than(size):
        -- start is 0 or follows '/', and size is the input's scalar boundary.
        -- 0 <= start < size; checked Slice cannot fail at these endpoints.
        components = match path.slice(start, size):
            Some(component): normalized_component(components, component, absolute)
            None: components

    joined = components.join("/")
    match absolute:
        True: "/".add(joined)
        False:
            match components.length().equals(0):
                True: "."
                False: joined
