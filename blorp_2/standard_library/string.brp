-- Temporary target adaptation of standard_library/src/string.brp.
-- Upstream revision: 2f5795cc750200a97115dfe5a637f5c4e6e47ddb
-- Upstream SHA256: 9e45bace6dfff8b749c5d3782fb3ab3608c7044196f02c02019370c045597d5a
-- ParseInt uses strict counted ASCII bytes and returns the designated Option.
import:
    _base: Int, Float, String, Bool(True, False), Option(Some, None)
    int as IntOps

pure func parse_int(text: String) -> Option[Int]:
    builtin("string.parse_int")

pure func parse_float(text: String) -> Option[Float]:
    builtin("string.parse_float")

pure func equals(left: String, right: String) -> Bool:
    builtin("string.equals")

pure func length(value: String) -> Int:
    builtin("string.length")

pure func add(left: String, right: String) -> String:
    builtin("string.add")

pure func byte_at(value: String, index: Int) -> Option[Int]:
    builtin("string.byte_at")

pure func from_codepoint(value: Int) -> Option[String]:
    builtin("string.from_codepoint")

pure func append_int(self: String, value: Int) -> String:
    add(self, IntOps.to_string(value))

-- Temporary: this walk uses native stack linear in the matching prefix.
-- Replace it only after scalar-loop support is accepted.
private pure func prefix_bytes_equal(value: String, prefix: String, position: Int) -> Bool:
    match byte_at(prefix, position):
        None: True
        Some(expected):
            match byte_at(value, position):
                None: False
                Some(actual):
                    match IntOps.equals(actual, expected):
                        False: False
                        True: prefix_bytes_equal(value, prefix, IntOps.add(position, 1))

pure func starts_with(value: String, prefix: String) -> Bool:
    prefix_bytes_equal(value, prefix, 0)
