-- The filesystem library. A native reports a failure as an Int code, and the
-- pure functions here decode it into an IOError that names the caller's path.
import:
    _base: Int, String, Void, Bool(True, False), Option(Some, None), Result(Ok, Err)
    int: Int methods

-- What went wrong. Every kind but OtherOs is a fact about the world that a
-- caller can act on; OtherOs keeps the operating system's own number, which
-- differs between macOS and Linux.
union IOErrorKind:
    NotFound
    PermissionDenied
    AlreadyExists
    NotADirectory
    IsADirectory
    DirectoryNotEmpty
    NotARegularFile
    ReadOnlyFilesystem
    -- ENOSPC and EDQUOT.
    NoSpace
    -- EFBIG and EOVERFLOW, or contents beyond the String capacity.
    FileTooLarge
    -- EXDEV from rename; the caller can fall back to copying.
    CrossesDevices
    -- Found before any operating system call.
    PathContainsNul
    -- Found after reading bytes.
    InvalidUtf8
    -- Any other errno, such as ELOOP, ENAMETOOLONG or EMFILE.
    OtherOs(Int)

-- `path` is always the path the caller passed, even when the operating system
-- refused a parent directory, so "x: permission denied" does not say whether x
-- or one of its parents refused. `destination` is the second path of a
-- two-path operation, and is None for every operation that has one path.
record IOError {
    path: String,
    destination: Option[String],
    kind: IOErrorKind
}

-- What a path names without following a link.
fixed union EntryKind:
    File
    Directory
    Symlink
    Other

-- Codes from src/runtime/fs.brp's FS_HELPERS_RUNTIME enum. A named kind has a
-- positive code; any other errno arrives negated, so OtherOs keeps the
-- platform's number. The two sides agree only by the tests that name each
-- code as a literal.
private NOT_FOUND_CODE: Int = 1
private PERMISSION_DENIED_CODE: Int = 2
private ALREADY_EXISTS_CODE: Int = 3
private NOT_A_DIRECTORY_CODE: Int = 4
private IS_A_DIRECTORY_CODE: Int = 5
private DIRECTORY_NOT_EMPTY_CODE: Int = 6
private NOT_A_REGULAR_FILE_CODE: Int = 7
private READ_ONLY_FILESYSTEM_CODE: Int = 8
private NO_SPACE_CODE: Int = 9
private FILE_TOO_LARGE_CODE: Int = 10
private CROSSES_DEVICES_CODE: Int = 11
private PATH_CONTAINS_NUL_CODE: Int = 12
private INVALID_UTF8_CODE: Int = 13

-- The entry codes of FS_HELPERS_RUNTIME's second enum.
private ABSENT_ENTRY_CODE: Int = 0
private FILE_ENTRY_CODE: Int = 1
private DIRECTORY_ENTRY_CODE: Int = 2
private SYMLINK_ENTRY_CODE: Int = 3

private pure func decode_error(code: Int) -> IOErrorKind:
    if code == NOT_FOUND_CODE:
        NotFound
    else if code == PERMISSION_DENIED_CODE:
        PermissionDenied
    else if code == ALREADY_EXISTS_CODE:
        AlreadyExists
    else if code == NOT_A_DIRECTORY_CODE:
        NotADirectory
    else if code == IS_A_DIRECTORY_CODE:
        IsADirectory
    else if code == DIRECTORY_NOT_EMPTY_CODE:
        DirectoryNotEmpty
    else if code == NOT_A_REGULAR_FILE_CODE:
        NotARegularFile
    else if code == READ_ONLY_FILESYSTEM_CODE:
        ReadOnlyFilesystem
    else if code == NO_SPACE_CODE:
        NoSpace
    else if code == FILE_TOO_LARGE_CODE:
        FileTooLarge
    else if code == CROSSES_DEVICES_CODE:
        CrossesDevices
    else if code == PATH_CONTAINS_NUL_CODE:
        PathContainsNul
    else if code == INVALID_UTF8_CODE:
        InvalidUtf8
    else:
        -- A positive code that no constant names is a disagreement between the
        -- two tables. It stays visible as a negative OtherOs number, which no
        -- real errno produces.
        OtherOs(0 - code)

-- Every code that is not a named kind is Other, because the C side sends
-- Other for each remaining st_mode type.
private pure func decode_entry_kind(code: Int) -> Option[EntryKind]:
    if code == ABSENT_ENTRY_CODE:
        None
    else if code == FILE_ENTRY_CODE:
        Some(File)
    else if code == DIRECTORY_ENTRY_CODE:
        Some(Directory)
    else if code == SYMLINK_ENTRY_CODE:
        Some(Symlink)
    else:
        Some(Other)

private pure func at_path[T](result: Result[T, Int], path: String) -> Result[T, IOError]:
    match result:
        Ok(value): Ok(value)
        Err(code): Err({ path = path, destination = None, kind = code.decode_error() })

private func native_read_text(path: String) -> Result[String, Int]:
    builtin("fs.read_text")

private func native_write_text(path: String, text: String) -> Result[Void, Int]:
    builtin("fs.write_text")

private func native_entry_kind(path: String) -> Result[Int, Int]:
    builtin("fs.entry_kind")

private pure func phrase(kind: IOErrorKind) -> String:
    match kind:
        NotFound: "no such file"
        PermissionDenied: "permission denied"
        AlreadyExists: "already exists"
        NotADirectory: "not a directory"
        IsADirectory: "is a directory"
        DirectoryNotEmpty: "directory not empty"
        NotARegularFile: "not a regular file"
        ReadOnlyFilesystem: "read-only file system"
        NoSpace: "no space left on device"
        FileTooLarge: "file too large"
        CrossesDevices: "crosses devices"
        PathContainsNul: "path contains a NUL byte"
        InvalidUtf8: "contents are not valid UTF-8"
        OtherOs(number): "operating system error ${number.to_string()}"

-- "settings.conf: no such file"; "a -> b: crosses devices". The text is fixed
-- per kind, never the operating system's own wording.
pure func describe(error: IOError) -> String:
    match error.destination:
        Some(destination): "${error.path} -> ${destination}: ${error.kind.phrase()}"
        None: "${error.path}: ${error.kind.phrase()}"

-- The common idiom: a missing file means a default. Any other failure stays.
pure func default_if_not_found[T](result: Result[T, IOError], fallback: T) -> Result[T, IOError]:
    match result:
        Ok(value): Ok(value)
        Err(error):
            match error.kind:
                NotFound: Ok(fallback)
                _: Err(error)

-- Reads to end of file, so a file that changes size is read as it is, then
-- validates UTF-8. A directory is IsADirectory. A FIFO blocks until its writer
-- closes. There is no size limit: a file or device that never ends, such as
-- /dev/zero, exhausts memory and the allocation aborts.
func read_text(path: String) -> Result[String, IOError]:
    path.native_read_text().at_path(path)

-- Replaces the file atomically: readers see the old contents or the new, never
-- a mix, even after a crash. A symlink is written through and stays a link; a
-- dangling link is NotFound and creates nothing. A new file gets mode 0666
-- narrowed by the umask, and a replaced file keeps its mode and, where the
-- operating system permits, its owner and group, or its group alone. An Err
-- before the rename leaves the target unchanged; an Err after it (only the
-- directory flush can fail there) means the target holds the old contents or
-- the new.
--
-- Limits: a hard link to the old file keeps the old contents; extended
-- attributes and ACLs are not copied; a link re-pointed between resolving it
-- and the rename is not detected. The new file is created beside the target,
-- so a writable file in a directory this process cannot write is
-- PermissionDenied, and a crash can leave a hidden `.blorp-tmp-*` file there.
-- A busy executable (ETXTBSY) or a bind-mounted target (EBUSY) is OtherOs. A
-- directory without read permission gives an Err after a rename that
-- succeeded. Writing past the file-size limit (RLIMIT_FSIZE) raises SIGXFSZ,
-- which ends the process unless the program ignores that signal; a library
-- does not change signal dispositions.
func write_text(path: String, text: String) -> Result[Void, IOError]:
    path.native_write_text(text).at_path(path)

-- lstat: a link is not followed, so a symlink is Symlink even when dangling.
-- ENOENT, and ENOTDIR from a file used as a directory, give Ok(None).
func entry_kind(path: String) -> Result[Option[EntryKind], IOError]:
    code ?= path.native_entry_kind().at_path(path)
    Ok(code.decode_entry_kind())
