import:
    _base: Int, String, Bool(True, False), List
    int as IntOps
    string as StringOps
    io: print

fixed record TestSuite {
    description: String,
    tests: List[(String, () -> Bool)]
}

fixed record TestCounts {
    passed: Int,
    failed: Int
}

func run_suite_result(suite: TestSuite) -> TestCounts:
    print("")
    print(StringOps.add(StringOps.add(">> ", suite.description), " Tests"))
    var passed: Int = 0
    var failed: Int = 0

    for (name, callback) in suite.tests:
        match callback():
            True:
                print(StringOps.add("  [PASS] ", name))
                passed = IntOps.add(passed, 1)
            False:
                print(StringOps.add("  [FAIL] ", name))
                failed = IntOps.add(failed, 1)

    print("")
    test_count: Int = IntOps.add(passed, failed)
    total: String = IntOps.to_string(test_count)
    match IntOps.equals(failed, 0):
        True:
            print(StringOps.add(StringOps.add("All ", total), " tests passed"))
        False:
            counts: String = StringOps.add(
                StringOps.add(IntOps.to_string(failed), " of "),
                total,
            )
            print(StringOps.add(counts, " tests failed"))

    { passed = passed, failed = failed }


func run_suite(suite: TestSuite) -> Int:
    counts: TestCounts = run_suite_result(suite)
    match IntOps.equals(counts.failed, 0):
        True: 0
        False: 1
