import:
    _base: Int, String, Bool(True, False), List
    int: Int methods_only
    string: String methods_only
    io: print

fixed record TestSuite {
    description: String,
    tests: List[(String, () -> Bool)]
}

fixed record TestCounts {
    passed: Int,
    failed: Int
}

func run_suite_result(suite: TestSuite) -> TestCounts:
    print("")
    print(">> ".add(suite.description).add(" Tests"))
    var passed: Int = 0
    var failed: Int = 0

    for (name, callback) in suite.tests:
        match callback():
            True:
                print("  [PASS] ".add(name))
                passed = passed.add(1)
            False:
                print("  [FAIL] ".add(name))
                failed = failed.add(1)

    print("")
    test_count: Int = passed.add(failed)
    total: String = test_count.to_string()
    match failed.equals(0):
        True:
            print("All ".add(total).add(" tests passed"))
        False:
            counts: String = failed.to_string().add(" of ").add(
                total,
            )
            print(counts.add(" tests failed"))

    { passed = passed, failed = failed }


func run_suite(suite: TestSuite) -> Int:
    counts: TestCounts = run_suite_result(suite)
    match counts.failed.equals(0):
        True: 0
        False: 1
