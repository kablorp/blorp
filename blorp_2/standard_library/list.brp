-- Immutable owned Lists; these wrappers preserve ordinary source call identity.
import:
    _base: Int, List, String, Bool(True, False), Option(Some, None), Orderable
    traits: Equatable
    int: Int methods
    string: String methods

pure func repeat[T](element: T, count: Int) -> List[T]:
    builtin("list.repeat")
pure func length[T](values: List[T]) -> Int:
    builtin("list.length")
pure func get[T](values: List[T], index: Int) -> Option[T]:
    builtin("list.get")
pure func append[T](values: List[T], value: T) -> List[T]:
    builtin("list.append")
pure func set[T](values: List[T], index: Int, value: T) -> List[T]:
    builtin("list.set")
pure func concat[T](left: List[T], right: List[T]) -> List[T]:
    builtin("list.concat")

pure func set_index[T](values: List[T], index: Int, value: T) -> Option[List[T]]:
    match get(values, index):
        Some(_): Some(set(values, index, value))
        None: None


pure func contains[Element: Equatable](values: List[Element], needle: Element) -> Bool:
    var found: Bool = False
    for element in values:
        if element == needle:
            found = True
            break
    found


implements Equatable for List[Element: Equatable]:
    pure func equals(left: Self, right: Self) -> Bool:
        count = length(left)
        match count.equals(length(right)):
            False: False
            True:
                var same: Bool = True
                for index in 0..count:
                    same = match get(left, index):
                        None: False
                        Some(element):
                            match get(right, index):
                                None: False
                                Some(other): equals(element, other)
                    match same:
                        False: break
                        True: void
                same

-- The first append to "" copies the shared literal; every later one extends the
-- dying accumulator in place.
pure func join(values: List[String], separator: String) -> String:
    var joined: String = ""
    var position = 0
    for value in values:
        if position > 0:
            joined = joined + separator
        joined = joined + value
        position = position + 1
    joined

pure func any[T](values: List[T], predicate: pure (T) -> Bool) -> Bool:
    var found: Bool = False
    for value in values:
        if predicate(value):
            found = True
            break
    found

pure func map[T, U](values: List[T], callback: pure (T) -> U) -> List[U]:
    var mapped: List[U] = []
    for value in values:
        mapped = mapped.append(callback(value))
    mapped

pure func filter[T](values: List[T], predicate: pure (T) -> Bool) -> List[T]:
    var kept: List[T] = []
    for value in values:
        if predicate(value):
            kept = kept.append(value)
    kept

pure func get_or[T](values: List[T], index: Int, default: T) -> T:
    match get(values, index):
        Some(value): value
        None: default

pure func is_empty[T](values: List[T]) -> Bool:
    length(values).equals(0)

pure func last[T](values: List[T]) -> Option[T]:
    get(values, length(values) - 1)

-- Private callers establish 0 <= start <= end <= length(values).
private pure func copy_range[T](values: List[T], start: Int, end: Int) -> List[T]:
    var copied: List[T] = []
    for index in start..end:
        match get(values, index):
            Some(value): copied = copied.append(value)
            None: void
    copied

pure func take[T](values: List[T], count: Int) -> List[T]:
    copy_range(values, 0, count.max(0).min(length(values)))

pure func remove[T](values: List[T], index: Int) -> Option[List[T]]:
    match index < 0:
        True: None
        False:
            size = length(values)
            match index < size:
                False: None
                True:
                    Some(concat(copy_range(values, 0, index), copy_range(values, index + 1, size)))

pure func drop[T](values: List[T], count: Int) -> List[T]:
    copy_range(values, count.max(0).min(length(values)), length(values))

pure func reverse[T](values: List[T]) -> List[T]:
    count = length(values)
    var reversed: List[T] = []
    for offset in 1..(count + 1):
        match get(values, count - offset):
            Some(value): reversed = reversed.append(value)
            None: void
    reversed

pure func find[T](values: List[T], predicate: pure (T) -> Bool) -> Option[T]:
    var found: Option[T] = None
    for value in values:
        if predicate(value):
            found = Some(value)
            break
    found

pure func all[T](values: List[T], predicate: pure (T) -> Bool) -> Bool:
    var every: Bool = True
    for value in values:
        match predicate(value):
            True: void
            False:
                every = False
                break
    every

-- Balanced immutable merging copies O(n * log(n + 1)^2) slots in the worst case;
-- it is not a linear builder or COW merge, and keys may be evaluated repeatedly.
private record MergedPrefix[T] {
    values: List[T],
    left_position: Int,
    right_position: Int
}

private pure func merge_first[T, Key: Orderable](
    left: List[T],
    right: List[T],
    left_position: Int,
    right_position: Int,
    key: pure (T) -> Key,
) -> MergedPrefix[T]:
    match get(left, left_position):
        Some(left_value):
            match get(right, right_position):
                Some(right_value):
                    left_key = key(left_value)
                    right_key = key(right_value)
                    match right_key < left_key:
                        True: {
                            values = [right_value],
                            left_position = left_position,
                            right_position = right_position + 1
                        }
                        False: {
                            values = [left_value],
                            left_position = left_position + 1,
                            right_position = right_position
                        }
                None: {
                    values = [left_value],
                    left_position = left_position + 1,
                    right_position = right_position
                }
        None:
            match get(right, right_position):
                Some(right_value): {
                    values = [right_value],
                    left_position = left_position,
                    right_position = right_position + 1
                }
                None: {
                    values = [],
                    left_position = left_position,
                    right_position = right_position
                }

-- Count is a nonnegative prefix of the still-unread child ranges. The first
-- result owns the updated positions used by the second; no cursor is shared.
private pure func merge_prefix[T, Key: Orderable](
    left: List[T],
    right: List[T],
    left_position: Int,
    right_position: Int,
    count: Int,
    key: pure (T) -> Key,
) -> MergedPrefix[T]:
    match count.equals(0):
        True: {
            values = [],
            left_position = left_position,
            right_position = right_position
        }
        False:
            match count.equals(1):
                True: merge_first(left, right, left_position, right_position, key)
                False:
                    first_count = count / 2
                    first = merge_prefix(left, right, left_position, right_position, first_count, key)
                    second = merge_prefix(left, right, first.left_position, first.right_position, count - first_count, key)
                    {
                        values = concat(first.values, second.values),
                        left_position = second.left_position,
                        right_position = second.right_position
                    }

private pure func sort_range[T, Key: Orderable](
    values: List[T],
    start: Int,
    count: Int,
    key: pure (T) -> Key,
) -> List[T]:
    match count.equals(0):
        True: []
        False:
            match count.equals(1):
                True:
                    match get(values, start):
                        Some(value): [value]
                        None: []
                False:
                    left_count = count / 2
                    left = sort_range(values, start, left_count, key)
                    right = sort_range(values, start + left_count, count - left_count, key)
                    merged = merge_prefix(left, right, 0, 0, count, key)
                    merged.values

-- Stable ascending sort by each element's Orderable key. Equal keys, those
-- where neither is less than the other, keep input order; key is pure and may
-- run more than once per element. A key order that is not total, such as Float
-- NaN, still yields a permutation of the input, in an unspecified order.
pure func sort_by[T, Key: Orderable](values: List[T], key: pure (T) -> Key) -> List[T]:
    match length(values) < 2:
        True: values
        False: sort_range(values, 0, length(values), key)
