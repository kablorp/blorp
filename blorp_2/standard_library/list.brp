-- Immutable owned Lists; these wrappers preserve ordinary source call identity.
import:
    _base: Int, List, String, Bool(True, False), Option(Some, None), Orderable
    traits: Equatable
    int: Int methods
    string: String methods

pure func repeat[T](element: T, count: Int) -> List[T]:
    builtin("list.repeat")
pure func length[T](values: List[T]) -> Int:
    builtin("list.length")
pure func get[T](values: List[T], index: Int) -> Option[T]:
    builtin("list.get")
pure func append[T](values: List[T], value: T) -> List[T]:
    builtin("list.append")
pure func set[T](values: List[T], index: Int, value: T) -> List[T]:
    builtin("list.set")
pure func concat[T](left: List[T], right: List[T]) -> List[T]:
    builtin("list.concat")

pure func set_index[T](values: List[T], index: Int, value: T) -> Option[List[T]]:
    match get(values, index):
        Some(_): Some(set(values, index, value))
        None: None


pure func contains[Element: Equatable](values: List[Element], needle: Element) -> Bool:
    var found: Bool = False
    for element in values:
        if element == needle:
            found = True
            break
    found


implements Equatable for List[Element: Equatable]:
    pure func equals(left: Self, right: Self) -> Bool:
        count = length(left)
        match count.equals(length(right)):
            False: False
            True:
                var same: Bool = True
                for index in 0..count:
                    same = match get(left, index):
                        None: False
                        Some(element):
                            match get(right, index):
                                None: False
                                Some(other): equals(element, other)
                    match same:
                        False: break
                        True: void
                same

-- Temporary balanced copying: O(n + bytes * log(n + 1)) work,
-- O(log(n + 1)) stack. Replace when a reviewed linear String builder is available.
private pure func join_range(values: List[String], start: Int, count: Int, separator: String) -> String:
    match count.less_than(1):
        True: ""
        False:
            match count.equals(1):
                True:
                    match get(values, start):
                        Some(value): value
                        None: ""
                False:
                    left_count = count.divide(2)
                    left = join_range(values, start, left_count, separator)
                    right = join_range(values, start.add(left_count), count.subtract(left_count), separator)
                    left.add(separator).add(right)

pure func join(values: List[String], separator: String) -> String:
    join_range(values, 0, length(values), separator)

-- Existing concat copies both inputs: balanced map/filter temporarily copy
-- O(n log n) slots with O(log n) C stack. No COW fast path is assumed.
-- Replace after an accepted efficient builder/loop path is measured.
pure func any[T](values: List[T], predicate: pure (T) -> Bool) -> Bool:
    any_range(values, predicate, 0, length(values))

private pure func any_range[T](
    values: List[T],
    predicate: pure (T) -> Bool,
    start: Int,
    count: Int,
) -> Bool:
    match count.equals(0):
        True: False
        False:
            match count.equals(1):
                True:
                    match get(values, start):
                        Some(value): predicate(value)
                        None: False
                False:
                    left_count = count.divide(2)
                    match any_range(values, predicate, start, left_count):
                        True: True
                        False:
                            any_range(
                                values, predicate, start.add(left_count),
                                count.subtract(left_count),
                            )

pure func map[T, U](values: List[T], callback: pure (T) -> U) -> List[U]:
    map_range(values, callback, 0, length(values))

private pure func map_range[T, U](
    values: List[T],
    callback: pure (T) -> U,
    start: Int,
    count: Int,
) -> List[U]:
    match count.equals(0):
        True: []
        False:
            match count.equals(1):
                True:
                    match get(values, start):
                        Some(value): [callback(value)]
                        None: []
                False:
                    left_count = count.divide(2)
                    left_values = map_range(values, callback, start, left_count)
                    right_values = map_range(
                        values, callback, start.add(left_count),
                        count.subtract(left_count),
                    )
                    concat(left_values, right_values)

pure func filter[T](values: List[T], predicate: pure (T) -> Bool) -> List[T]:
    filter_range(values, predicate, 0, length(values))

private pure func filter_range[T](
    values: List[T],
    predicate: pure (T) -> Bool,
    start: Int,
    count: Int,
) -> List[T]:
    match count.equals(0):
        True: []
        False:
            match count.equals(1):
                True:
                    match get(values, start):
                        Some(value):
                            match predicate(value):
                                True: [value]
                                False: []
                        None: []
                False:
                    left_count = count.divide(2)
                    left_values = filter_range(values, predicate, start, left_count)
                    right_values = filter_range(
                        values, predicate, start.add(left_count),
                        count.subtract(left_count),
                    )
                    concat(left_values, right_values)

pure func get_or[T](values: List[T], index: Int, default: T) -> T:
    match get(values, index):
        Some(value): value
        None: default

pure func is_empty[T](values: List[T]) -> Bool:
    length(values).equals(0)

pure func last[T](values: List[T]) -> Option[T]:
    get(values, length(values).subtract(1))

-- Temporary O(n log n) copied slots and O(log n) stack; no COW fast path.
-- Replace after an efficient builder is accepted and measured.
-- Private callers establish 0 <= start <= end <= length(values).
private pure func copy_range[T](values: List[T], start: Int, end: Int) -> List[T]:
    match start.equals(end):
        True: []
        False:
            match end.subtract(start).equals(1):
                True:
                    match get(values, start):
                        Some(value): [value]
                        None: []
                False:
                    middle = start.add(end.subtract(start).divide(2))
                    concat(copy_range(values, start, middle), copy_range(values, middle, end))

pure func take[T](values: List[T], count: Int) -> List[T]:
    copy_range(values, 0, count.max(0).min(length(values)))

pure func remove[T](values: List[T], index: Int) -> Option[List[T]]:
    match index.less_than(0):
        True: None
        False:
            size = length(values)
            match index.less_than(size):
                False: None
                True:
                    Some(concat(copy_range(values, 0, index), copy_range(values, index.add(1), size)))

pure func drop[T](values: List[T], count: Int) -> List[T]:
    copy_range(values, count.max(0).min(length(values)), length(values))

private pure func reverse_range[T](values: List[T], start: Int, end: Int) -> List[T]:
    match end.subtract(start).less_than(2):
        True: copy_range(values, start, end)
        False:
            middle = start.add(end.subtract(start).divide(2))
            concat(reverse_range(values, middle, end), reverse_range(values, start, middle))

pure func reverse[T](values: List[T]) -> List[T]:
    reverse_range(values, 0, length(values))

pure func find[T](values: List[T], predicate: pure (T) -> Bool) -> Option[T]:
    find_range(values, predicate, 0, length(values))

private pure func find_range[T](
    values: List[T],
    predicate: pure (T) -> Bool,
    start: Int,
    count: Int,
) -> Option[T]:
    match count.equals(0):
        True: None
        False:
            match count.equals(1):
                True:
                    match get(values, start):
                        Some(value):
                            match predicate(value):
                                True: Some(value)
                                False: None
                        None: None
                False:
                    left_count = count.divide(2)
                    match find_range(values, predicate, start, left_count):
                        Some(value): Some(value)
                        None:
                            find_range(
                                values, predicate, start.add(left_count),
                                count.subtract(left_count),
                            )

pure func all[T](values: List[T], predicate: pure (T) -> Bool) -> Bool:
    all_range(values, predicate, 0, length(values))

private pure func all_range[T](
    values: List[T],
    predicate: pure (T) -> Bool,
    start: Int,
    count: Int,
) -> Bool:
    match count.equals(0):
        True: True
        False:
            match count.equals(1):
                True:
                    match get(values, start):
                        Some(value): predicate(value)
                        None: True
                False:
                    left_count = count.divide(2)
                    match all_range(values, predicate, start, left_count):
                        True:
                            all_range(
                                values, predicate, start.add(left_count),
                                count.subtract(left_count),
                            )
                        False: False

-- Balanced immutable merging copies O(n * log(n + 1)^2) slots in the worst case;
-- it is not a linear builder or COW merge, and keys may be evaluated repeatedly.
private record MergedPrefix[T] {
    values: List[T],
    left_position: Int,
    right_position: Int
}

private pure func merge_first[T, Key: Orderable](
    left: List[T],
    right: List[T],
    left_position: Int,
    right_position: Int,
    key: pure (T) -> Key,
) -> MergedPrefix[T]:
    match get(left, left_position):
        Some(left_value):
            match get(right, right_position):
                Some(right_value):
                    left_key = key(left_value)
                    right_key = key(right_value)
                    match right_key.less_than(left_key):
                        True: {
                            values = [right_value],
                            left_position = left_position,
                            right_position = right_position.add(1)
                        }
                        False: {
                            values = [left_value],
                            left_position = left_position.add(1),
                            right_position = right_position
                        }
                None: {
                    values = [left_value],
                    left_position = left_position.add(1),
                    right_position = right_position
                }
        None:
            match get(right, right_position):
                Some(right_value): {
                    values = [right_value],
                    left_position = left_position,
                    right_position = right_position.add(1)
                }
                None: {
                    values = [],
                    left_position = left_position,
                    right_position = right_position
                }

-- Count is a nonnegative prefix of the still-unread child ranges. The first
-- result owns the updated positions used by the second; no cursor is shared.
private pure func merge_prefix[T, Key: Orderable](
    left: List[T],
    right: List[T],
    left_position: Int,
    right_position: Int,
    count: Int,
    key: pure (T) -> Key,
) -> MergedPrefix[T]:
    match count.equals(0):
        True: {
            values = [],
            left_position = left_position,
            right_position = right_position
        }
        False:
            match count.equals(1):
                True: merge_first(left, right, left_position, right_position, key)
                False:
                    first_count = count.divide(2)
                    first = merge_prefix(left, right, left_position, right_position, first_count, key)
                    second = merge_prefix(left, right, first.left_position, first.right_position, count.subtract(first_count), key)
                    {
                        values = concat(first.values, second.values),
                        left_position = second.left_position,
                        right_position = second.right_position
                    }

private pure func sort_range[T, Key: Orderable](
    values: List[T],
    start: Int,
    count: Int,
    key: pure (T) -> Key,
) -> List[T]:
    match count.equals(0):
        True: []
        False:
            match count.equals(1):
                True:
                    match get(values, start):
                        Some(value): [value]
                        None: []
                False:
                    left_count = count.divide(2)
                    left = sort_range(values, start, left_count, key)
                    right = sort_range(values, start.add(left_count), count.subtract(left_count), key)
                    merged = merge_prefix(left, right, 0, 0, count, key)
                    merged.values

-- Stable ascending sort by each element's Orderable key. Equal keys, those
-- where neither is less than the other, keep input order; key is pure and may
-- run more than once per element. A key order that is not total, such as Float
-- NaN, still yields a permutation of the input, in an unspecified order.
pure func sort_by[T, Key: Orderable](values: List[T], key: pure (T) -> Key) -> List[T]:
    match length(values).less_than(2):
        True: values
        False: sort_range(values, 0, length(values), key)
