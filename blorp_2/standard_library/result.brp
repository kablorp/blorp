import:
    _base: Bool(True, False), Result(Ok, Err)

pure func is_ok[T, E](self: Result[T, E]) -> Bool:
    match self:
        Ok(_): True
        Err(_): False

pure func map[T, U, E](self: Result[T, E], callback: pure (T) -> U) -> Result[U, E]:
    match self:
        Ok(value): Ok(callback(value))
        Err(error): Err(error)

pure func map_err[T, E, F](self: Result[T, E], callback: pure (E) -> F) -> Result[T, F]:
    match self:
        Ok(value): Ok(value)
        Err(error): Err(callback(error))

pure func and_then[T, U, E](self: Result[T, E], callback: pure (T) -> Result[U, E]) -> Result[U, E]:
    match self:
        Ok(value): callback(value)
        Err(error): Err(error)
