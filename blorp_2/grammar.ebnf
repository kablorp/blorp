(* Blorp 2: the Int-parameter and nested-call increment.

   This is a byte-level source grammar. No whitespace is implicit.
   Dialect: `=` defines a rule; `;` ends it; juxtaposition concatenates;
   `|` means alternatives; (...) groups; [...] is zero or one occurrence;
   {...} is zero or more occurrences; quoted strings are literal bytes;
   "A".."Z" is an inclusive single-byte range; comments use parentheses
   around asterisks. X - Y excludes the complete strings of Y from X.
   Literal escapes are \n = LF (0x0A) and \t = TAB (0x09).
   EOF succeeds only at the exact end of the source, consuming no byte.

   Lexical contracts:
   - Identifiers use the longest consecutive identifier byte run.
   - The exact spellings `func` and `pure` are reserved identifiers.
   - Digits use the longest consecutive digit run. Only the runs `0` and `1`
     are supported; `00`, other integers, floats and signed numbers are errors.
   - Arrow bytes stay adjacent. Spaces occur only where these rules permit.
   - All source bytes are ASCII; CR, comments and other bytes are unsupported.

   Syntax accepts any unreserved function, parameter and type identifier.
   The checker requires exactly one zero-parameter `main`, `Int` parameter
   and return types, declared callees, matching call arity, distinct function
   names, acyclic calls, and pure callers calling only pure callees. A bare
   name must be the containing function's parameter. That parameter shadows
   a same-named function and cannot be called. Unannotated functions are impure.
*)

letter           = "A".."Z" | "a".."z" ;
digit            = "0".."9" ;
identifier_start = letter | "_" ;
identifier_byte  = identifier_start | digit ;
identifier       = (identifier_start { identifier_byte }) - ("func" | "pure") ;

space            = " " ;
spaces           = { space } ;
required_spaces  = space spaces ;
newline          = "\n" ;
indent           = "\t" | "    " ;

(* Each declaration is two lines. A single LF separates declarations; the
   final body may omit its LF. Blank lines and trailing whitespace after the
   final LF are unsupported. Spaces in a call are explicit, including f ( ). *)
integer          = "0" | "1" ;
call             = identifier spaces "(" spaces [ expression ] spaces ")" ;
expression       = integer | identifier | call ;
parameter        = identifier spaces ":" spaces identifier ;
function         = [ "pure" required_spaces ] "func" required_spaces identifier spaces "(" spaces
                   [ parameter ] spaces ")" spaces "->" spaces identifier spaces ":" spaces
                   newline indent expression spaces ;
program          = function { newline function } [ newline ] EOF ;
