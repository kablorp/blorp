import:
	../../src/lex: lex
	../../src/parse: parsed_contents
	../unit/input: parse
	test: TestSuite


private pure func accepts(source: String) -> Bool:
	match lex(source).and_then(pure func(tokens): parse(tokens)):
		Err(_):
			False
		Ok(program):
			match parsed_contents(program).functions:
				[function]:
					match function.tail_annotation:
						Some(span):
							span.start == 0 and span.end == 15
						None:
							False
				_:
					False


pure func test_annotation_same_line_with_pure() -> Bool:
	accepts("@tail_recursive pure func main() -> Int:\n\tmain()\n")


pure func test_annotation_standalone_with_spaces() -> Bool:
	accepts("@tail_recursive   \nfunc main() -> Int:\n    main()\n")


pure func test_annotation_same_line_without_pure() -> Bool:
	accepts("@tail_recursive func main() -> Int:\n\tmain()\n")


pure func test_annotation_allows_blank_lines() -> Bool:
	accepts("@tail_recursive\n\nfunc main() -> Int:\n\tmain()\n")


tests: TestSuite = {
	description = "Restricted tail annotation grammar",
	tests = [
		("annotation before pure on same line", test_annotation_same_line_with_pure),
		("standalone annotation accepts trailing spaces", test_annotation_standalone_with_spaces),
		("annotation before impure function", test_annotation_same_line_without_pure),
		("annotation accepts blank lines before declaration", test_annotation_allows_blank_lines),
	]
}
