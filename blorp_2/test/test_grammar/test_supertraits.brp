import:
	../../src/lex/lex: lex
	../../src/parse/parse: module_contents, parse_module
	../../src/utils/names: program_names
	../../src/utils/source: module_source, root_module_id
	../../src/utils/syntax: TypeSyntax(AtomicType, QualifiedType, AppliedType)
	test: TestSuite


-- trait_declaration's three forms: a method block, supertraits before a
-- second colon and the methods, and a bundle ending its line or the file.
pure func test_trait_declaration_forms() -> Bool:
	source: String =
		|trait Shape:
		|    pure func area(value: Self) -> Int
		|trait Ordered: Equatable + Base.Hashable:
		|    pure func before(left: Self, right: Self) -> Bool
		|trait Ring: Addable + Multipliable
		|trait Last: Ring
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
		Err(_): False
		Ok(parsed):
			match module_contents(parsed).traits:
				[shape, ordered, ring, last]:
					match (shape.supertraits, ordered.supertraits, ring.supertraits, last.supertraits):
						([], [AtomicType(_), QualifiedType(_, [], _)], [AtomicType(_), AtomicType(_)], [AtomicType(_)]):
							shape.methods.length() == 1 and ordered.methods.length() == 1 and ring.methods.is_empty() and last.methods.is_empty()
						_: False
				_: False


-- A supertrait is any written type here; Check requires a visible trait.
pure func test_supertraits_use_the_type_bound_grammar() -> Bool:
	source: String = "trait Applied: Box[Int]\n"
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
		Err(_): False
		Ok(parsed):
			match module_contents(parsed).traits:
				[declaration]:
					match declaration.supertraits:
						[AppliedType(_, [AtomicType(_)], _)]: declaration.methods.is_empty()
						_: False
				_: False


tests: TestSuite = {
	description = "Supertrait grammar",
	tests = [
		("trait declaration forms", test_trait_declaration_forms),
		("supertraits use the type bound grammar", test_supertraits_use_the_type_bound_grammar),
	]
}
