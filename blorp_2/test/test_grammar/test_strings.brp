import:
	../../src/utils/names: program_names
	../../src/utils/ids: inventory_functions
	../../src/lex/lex: lex
	../../src/parse/assemble: parsed_contents
	../../src/utils/source: module_source, root_module_id
	../../src/utils/syntax:
		ExpressionBase(StringExpression),
		ParsedBody(ParsedValueBody),
		PostfixOperation(ReceiverInvocation),
	../unit/input: parse
	test: TestSuite


private pure func accepts(source: String) -> Bool:
	lex(module_source(root_module_id()), source, program_names().names)
		.and_then(pure func(tokens): parse(tokens))
		.is_ok()


pure func test_quoted_values_compose_with_bindings_calls_and_returns() -> Bool:
	source: String =
		|pure func text() -> String:
		|    "é😀"
		|pure func identity(value: String) -> String:
		|    value
		|func main() -> Int:
		|    original = "hello -- data"
		|    var current = original
		|    current = identity(text())
		|    current.length()
		|
	accepts(source)


pure func test_string_primary_and_ufcs_retain_byte_spans() -> Bool:
	source = "func main() -> Int:\n    \"é😀\".length()\n"

	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(_):
			False
		Ok(parsed):
			match inventory_functions(parsed_contents(parsed).declarations).filter(pure func(row): row.declaration.module == root_module_id()).map(pure func(row): row.declaration):
				[function]:
					match function.body:
						ParsedValueBody(value):
							match (value.base, value.applications):
								(StringExpression(bytes), [ReceiverInvocation(call)]):
									(
										bytes == "é😀"
										and value.base_span.start == 24
										and value.base_span.end == 32
										and call.span.start == 33
										and call.span.end == 41
										and value.span.end == 41
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_escaped_brace_allows_literal_interpolation_text() -> Bool:
	accepts("func main() -> String:\n    \"$\\{name}\\n\\u{1F600}\"\n")


pure func test_pipe_and_raw_strings_are_expression_lines() -> Bool:
	source: String =
		|pure func banner() -> String:
		|    |first
		|    ||second
		|pure func text() -> String:
		|    raw
		|        |\n
		|        |
		|func main() -> Int:
		|    match banner():
		|        _:
		|            |arm text
		|
	accepts(source)


-- The lexer reads Char literal tokens; the parser rejects them until the
-- Char type exists.
pure func test_char_literals_are_rejected_with_teaching_help() -> Bool:
	match lex(module_source(root_module_id()), "func main() -> Int:\n    'a'\n", program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(error):
			(
				error.message == "Char literals are not supported yet"
				and error.help == "use a one-character String literal such as \"a\""
				and error.span.start == 24
				and error.span.end == 27
			)
		Ok(_):
			False


pure func test_interpolation_is_a_string_expression() -> Bool:
	accepts("func main() -> String:\n    \"$" + "{name}\"\n")


tests: TestSuite = {
	description = "Blorp 2 quoted String grammar",
	tests = [
		(
			"quoted values compose with bindings calls and returns",
			test_quoted_values_compose_with_bindings_calls_and_returns,
		),
		(
			"String primary and UFCS retain byte spans",
			test_string_primary_and_ufcs_retain_byte_spans,
		),
		(
			"escaped brace permits literal interpolation text",
			test_escaped_brace_allows_literal_interpolation_text,
		),
		(
			"interpolation is a String expression",
			test_interpolation_is_a_string_expression,
		),
		("pipe and raw strings are expression lines", test_pipe_and_raw_strings_are_expression_lines),
		("char literals are rejected with teaching help", test_char_literals_are_rejected_with_teaching_help),
	]
}
