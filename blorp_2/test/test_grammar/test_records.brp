import:
	../../src/utils/ids: inventory_functions
	../../src/utils/source: module_source, root_module_id
	../../src/lex/lex: lex
	../../src/utils/names: name_spelling, program_names
	../../src/parse/assemble: parsed_contents
	../../src/utils/syntax:
		ExpressionBase(RecordExpression, DirectApplication),
		ParsedBody(ParsedValueBody),
		PostfixOperation(FieldAccess, ReceiverInvocation),
	../unit/input: parse
	option: is_none
	test: TestSuite


private IDENTIFIER_HELP: String = "use an ASCII identifier starting with a letter or underscore; keywords and lone '_' are reserved"

private MAIN: String =
	|func main() -> Int:
	|	0
	|


private pure func accepts(source: String) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Ok(_):
			True
		_:
			False


private pure func rejects(
	prefix: String,
	marked: String,
	suffix: String,
	message: String,
	help: String,
) -> Bool:
	match lex(module_source(root_module_id()), prefix + marked + suffix, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and error.message == message
				and error.help == help
				and error.note.is_none()
			)
		_:
			False


-- `fixed` is a name in the host and stays one; `record` and `union` are
-- reserved and cannot be declared as names.
pure func test_fixed_remains_an_ordinary_name_and_record_is_reserved() -> Bool:
	source: String =
		|record fixed { first: Int }
		|pure func make(fixed: fixed) -> Int:
		|	fixed.first
		|func main() -> Int:
		|	make({ first = 7 })
		|
	(
		accepts(source)
		and rejects("record Pair { ", "record", ": Int }\n" + MAIN, "`record` is a reserved keyword and cannot be used as a name", "choose another identifier such as `record_name`")
	)


pure func test_nested_calls_and_literal_arguments() -> Bool:
	source: String =
		|record Pair { first: Int, second: Int }
		|func main() -> Int:
		|	outer({ second = inner(9), first = 7 }).first.to_string().length()
		|
	accepts(source)


pure func test_record_literal_and_projection_spans() -> Bool:
	prefix = "func main() -> Int:\n\t"
	literal = "{ second = inner(9), first = 7 }"
	source = prefix + literal + ".first\n"

	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Ok(program):
			parsed = parsed_contents(program)

			match inventory_functions(parsed.declarations).filter(pure func(row): row.declaration.module == root_module_id()).map(pure func(row): row.declaration):
				[function]:
					match function.body:
						ParsedValueBody(value):
							match value.base:
								RecordExpression([second, first]):
									match second.value.base:
										DirectApplication(_, [child]):
											match value.applications:
												[FieldAccess(field)]:
													(
														value.base_span.start == prefix.length()
														and value.base_span.end == prefix.length() + literal.length()
														and value.span.end == prefix.length() + literal.length() + 6
														and second.name.span.start == prefix.length() + 2
														and second.name.span.end == prefix.length() + 8
														and second.value.span.start == prefix.length() + 11
														and second.value.span.end == prefix.length() + 19
														and child.span.start == prefix.length() + 17
														and child.span.end == prefix.length() + 18
														and first.value.span.start == prefix.length() + 29
														and field.span.start == prefix.length() + literal.length() + 1
														and field.span.end == prefix.length() + literal.length() + 6
														and name_spelling(
															parsed.names,
															field.id,
														) == Some("first")
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_empty_literal_is_syntax_but_empty_declaration_is_not() -> Bool:
	(
		accepts("func main() -> Int:\n\t{}\n")
		and rejects(
			"record Empty { ",
			"}",
			"\n" + MAIN,
			"expected a record field name",
			IDENTIFIER_HELP,
		)
	)


pure func test_declaration_requires_opening_brace() -> Bool:
	rejects(
		"record Pair ",
		":",
		"\n" + MAIN,
		"expected '{' after the record type name",
		"write record Name { field: Int }",
	)


pure func test_generic_record_declaration_matches_ordered_parameter_grammar() -> Bool:
	accepts("record Pair[A, B] { first: A, second: Box[B] }\n" + MAIN)


pure func test_empty_record_parameters_reject_and_trailing_comma_is_accepted() -> Bool:
	(
	rejects("record Box[", "]", " { value: Int }\n" + MAIN,
		"expected a type parameter name", "declare type parameters separated by commas, such as [A, B]")
	and accepts("record Box[T, ] { value: T }\n" + MAIN)
	)


pure func test_record_parameter_names_use_existing_rule() -> Bool:
	rejects("record Box[", "lower", "] { value: Int }\n" + MAIN,
		"invalid type parameter name", "start with a capital ASCII letter and use only ASCII letters and digits, such as T or Element2")


pure func test_bare_name_base_requires_the_record_update_bar() -> Bool:
	rejects(
		"func main() -> Int:\n\t{ first ",
		":",
		" 7 }\n",
		"expected '|' after the record update base",
		"write { existing_record | field = expression }",
	)


pure func test_known_literal_requires_equals_for_later_fields() -> Bool:
	rejects(
		"func main() -> Int:\n\t{ first = 7, second ",
		":",
		" 9 }\n",
		"expected '=' after the record field name",
		"write field = expression",
	)


pure func test_literal_requires_comma() -> Bool:
	rejects(
		"func main() -> Int:\n\t{ first = 7 ",
		"second",
		" = 9 }\n",
		"expected '}' after the record fields",
		"separate record fields with commas, then close the literal with '}'",
	)


pure func test_declaration_requires_comma() -> Bool:
	rejects(
		"record Pair { first: Int ",
		"second",
		": Int }\n" + MAIN,
		"expected '}' after the record declaration",
		"separate record fields with commas, then close the declaration with '}'",
	)


pure func test_literal_trailing_comma_is_accepted() -> Bool:
	accepts("func main() -> Int:\n\t{ first = 7, }\n")


pure func test_declaration_trailing_comma_is_accepted() -> Bool:
	accepts("record Pair { first: Int, }\n" + MAIN)


pure func test_multiline_literal_is_accepted() -> Bool:
	source: String =
		|func main() -> Int:
		|	{ first = 7,
		|	second = 9 }
		|

	accepts(source)


pure func test_multiline_declaration_is_accepted() -> Bool:
	source: String =
		|record Pair {
		|	first: Int,
		|	second: Int
		|}
		|

	accepts(source + MAIN)


pure func test_missing_literal_closing_brace() -> Bool:
	rejects(
		"func main() -> Int:\n\t{ first = 7",
		"",
		"",
		"expected '}' after the record fields",
		"separate record fields with commas, then close the literal with '}'",
	)


pure func test_missing_declaration_closing_brace() -> Bool:
	rejects(
		"record Pair { first: Int",
		"",
		"",
		"expected '}' after the record declaration",
		"separate record fields with commas, then close the declaration with '}'",
	)


tests: TestSuite = {
	description = "Fixed record grammar",
	tests = [
		("fixed remains a name and record is reserved", test_fixed_remains_an_ordinary_name_and_record_is_reserved),
		("nested calls and concrete literal arguments", test_nested_calls_and_literal_arguments),
		("literal name child and projection byte spans", test_record_literal_and_projection_spans),
		(
			"empty literal parses and empty declaration rejects",
			test_empty_literal_is_syntax_but_empty_declaration_is_not,
		),
		("declaration opening brace", test_declaration_requires_opening_brace),
		("generic record ordered parameters", test_generic_record_declaration_matches_ordered_parameter_grammar),
		("empty parameter list rejected and trailing comma accepted", test_empty_record_parameters_reject_and_trailing_comma_is_accepted),
		("record parameter spelling", test_record_parameter_names_use_existing_rule),
		("bare name base requires update bar", test_bare_name_base_requires_the_record_update_bar),
		("known literal requires later equals", test_known_literal_requires_equals_for_later_fields),
		("literal comma", test_literal_requires_comma),
		("declaration comma", test_declaration_requires_comma),
		("literal trailing comma accepted", test_literal_trailing_comma_is_accepted),
		("declaration trailing comma accepted", test_declaration_trailing_comma_is_accepted),
		("multiline literal accepted", test_multiline_literal_is_accepted),
		("multiline declaration accepted", test_multiline_declaration_is_accepted),
		("literal closing brace", test_missing_literal_closing_brace),
		("declaration closing brace", test_missing_declaration_closing_brace),
	]
}
