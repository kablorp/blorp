import:
	../../src/lex/lex: lex
	../../src/utils/source: module_source, root_module_id
	../unit/input: parse
	test: TestSuite


private PREFIX: String = "pure func number() -> Float:\n    "


private pure func source(literal: String) -> String:
	PREFIX + literal + "\nfunc main() -> Int:\n    0\n"


private pure func accepts(literal: String) -> Bool:
	lex(module_source(root_module_id()), source(literal))
		.and_then(pure func(tokens): parse(tokens))
		.is_ok()


private pure func rejects(literal: String, message: String, help: String) -> Bool:
	match lex(
		module_source(root_module_id()),
		source(literal),
	).and_then(
		pure func(tokens): parse(tokens),
	):
		Err(error):
			(
				error.message == message
				and error.help == help
				and error.span.start == PREFIX.length()
				and error.span.end == PREFIX.length() + literal.length()
			)
		Ok(_):
			False


pure func test_fraction_has_digits_on_both_sides() -> Bool:
	accepts("0.5") and accepts("-1.25")


pure func test_exponent_can_replace_fraction() -> Bool:
	accepts("1e2") and accepts("-1E-2") and accepts("0e+2")


pure func test_fraction_can_have_signed_exponent() -> Bool:
	accepts("1.25e+20") and accepts("-1.25E-20")


pure func test_signed_zero_subnormal_and_underflow_are_accepted() -> Bool:
	accepts("-0.0") and accepts("5e-324") and accepts("-1e-9999")


pure func test_missing_integer_part_teaches_leading_zero() -> Bool:
	rejects(
		".5",
		"Float literals need digits before the decimal point",
		"write 0.5; a source Float literal needs an integer part",
	)


pure func test_missing_fraction_teaches_trailing_zero() -> Bool:
	rejects(
		"1.",
		"Float literals need digits after the decimal point",
		"write 1.0; otherwise use a UFCS function call after '.'",
	)


pure func test_leading_zero_integer_part_is_rejected() -> Bool:
	rejects(
		"01.5",
		"Float literals cannot have leading zeros",
		"write 0.5 or remove the leading zeros from the integer part",
	)


pure func test_source_leading_plus_is_rejected() -> Bool:
	-- The lexical error covers the unsupported sign itself.
	match lex(module_source(root_module_id()), source("+1.5")):
		Err(error):
			(
				error.message == "source numeric literals cannot start with '+'"
				and error.help == "remove the leading '+'; use an adjacent '-' for a negative literal"
				and error.span.start == PREFIX.length()
				and error.span.end == PREFIX.length() + 1
			)
		Ok(_):
			False


pure func test_missing_exponent_digits_keep_precise_help() -> Bool:
	rejects(
		"1.0e+",
		"expected decimal digits in Float exponent",
		(
			"write a decimal Float such as 1.0, 0.5 or 1e2; an exponent needs at least one "
			+ "digit"
		),
	)


pure func test_hexadecimal_form_is_rejected() -> Bool:
	rejects(
		"0x1p2",
		"numeric literals cannot have suffixes or separators",
		(
			"write decimal digits with an optional fractional part or exponent; use no "
			+ "underscores or type suffixes"
		),
	)


pure func test_separator_is_rejected() -> Bool:
	rejects(
		"1_0",
		"numeric literals cannot have suffixes or separators",
		(
			"write decimal digits with an optional fractional part or exponent; use no "
			+ "underscores or type suffixes"
		),
	)


pure func test_type_suffix_is_rejected() -> Bool:
	rejects(
		"1e2f64",
		"numeric literals cannot have suffixes or separators",
		(
			"write decimal digits with an optional fractional part or exponent; use no "
			+ "underscores or type suffixes"
		),
	)


pure func test_source_overflow_has_finite_range_diagnostic() -> Bool:
	rejects(
		"1e309",
		"Float literal is outside the finite Float64 range",
		(
			"use a smaller magnitude or exponent; infinities are produced by arithmetic, not "
			+ "literals"
		),
	)


pure func test_float_primary_composes_with_ufcs() -> Bool:
	program: String =
		|pure func identity(value: Float) -> Float:
		|    value
		|pure func number() -> Float:
		|    1.25.identity()
		|func main() -> Int:
		|    0
		|
	lex(module_source(root_module_id()), program)
		.and_then(pure func(tokens): parse(tokens))
		.is_ok()


tests: TestSuite = {
	description = "Blorp 2 decimal Float grammar and diagnostics",
	tests = [
		("fraction has digits on both sides", test_fraction_has_digits_on_both_sides),
		("exponent can replace fraction", test_exponent_can_replace_fraction),
		("fraction can have signed exponent", test_fraction_can_have_signed_exponent),
		(
			"signed zero subnormal and underflow are accepted",
			test_signed_zero_subnormal_and_underflow_are_accepted,
		),
		(
			"missing integer part teaches leading zero",
			test_missing_integer_part_teaches_leading_zero,
		),
		("missing fraction teaches trailing zero", test_missing_fraction_teaches_trailing_zero),
		("leading zero integer part is rejected", test_leading_zero_integer_part_is_rejected),
		("source leading plus is rejected", test_source_leading_plus_is_rejected),
		(
			"missing exponent digits keep precise help",
			test_missing_exponent_digits_keep_precise_help,
		),
		("hexadecimal form is rejected", test_hexadecimal_form_is_rejected),
		("separator is rejected", test_separator_is_rejected),
		("type suffix is rejected", test_type_suffix_is_rejected),
		(
			"source overflow has finite-range diagnostic",
			test_source_overflow_has_finite_range_diagnostic,
		),
		("Float primary composes with UFCS", test_float_primary_composes_with_ufcs),
	]
}
