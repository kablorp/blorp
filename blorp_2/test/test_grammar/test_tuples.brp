import:
	../../src/lex/lex: lex
	../../src/parse/parse: module_contents, parse_module
	../../src/utils/names: program_names
	../../src/utils/source: module_source, root_module_id
	../../src/utils/syntax:
		ExpressionBase(TupleExpression),
		ForBinder(TupleForBinder),
		ParsedBody(ParsedMatchBody),
		ParsedPattern(PatternTuple, PatternConstructor),
		ParsedStatement(TupleBinding, ForLoop),
		TypeSyntax(TupleTypeSyntax, AppliedType),
	test: TestSuite


pure func test_tuple_terms_allow_spaces_newlines_and_trailing_commas() -> Bool:
	source: String =
		|func read(value: List [ ( Int , String , ) ]) -> Int:
		|    (first, _,) = (
		|        7,
		|        "seven",
		|    )
		|    for (left, right,) in value:
		|        consume(left, right)
		|    match (first, "seven",):
		|        (number, _,): number
		|
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
		Err(_): False
		Ok(parsed):
			match module_contents(parsed).functions:
				[function]:
					match (function.parameters, function.statements, function.body):
						([parameter], [TupleBinding([_, _], value, _), ForLoop(loop)], ParsedMatchBody(body)):
							match body.arms:
								[arm]:
									match (parameter.type_name, value.base, loop.binder, body.scrutinee.base):
										(AppliedType(_, [TupleTypeSyntax([_, _], _)], _), TupleExpression([_, _]), TupleForBinder([_, _], _), TupleExpression([_, _])):
											match arm.pattern:
												PatternTuple([_, _], _): True
												_: False
										_: False
								_: False
						_: False
				_: False


pure func test_tuple_patterns_are_recursive_constructor_children() -> Bool:
	source: String =
		|func read(value: Value) -> Int:
		|    match value:
		|        Some((first, (second, _))): first
		|
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
		Err(_): False
		Ok(parsed):
			match module_contents(parsed).functions:
				[function]:
					match function.body:
						ParsedMatchBody(body):
							match body.arms:
								[arm]:
									match arm.pattern:
										PatternConstructor(_, [PatternTuple([_, PatternTuple([_, _], _)], _)], _): True
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Tuple EBNF conformance",
	tests = [
		("tuple terms allow spaces newlines and trailing commas", test_tuple_terms_allow_spaces_newlines_and_trailing_commas),
		("tuple patterns are recursive constructor children", test_tuple_patterns_are_recursive_constructor_children),
	]
}
