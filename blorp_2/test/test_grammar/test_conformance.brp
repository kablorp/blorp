import:
	../../src/lex: lex
	../../src/names: NameTable, name_spelling
	../../src/parse: ParsedProgram, parse_prelude, parsed_contents
	../../src/syntax:
		BindingSyntax(ImmutableBinding, MutableBinding),
		CallNotation(DirectCall, ReceiverCall),
		Diagnostic,
		ExpressionBase(IntegerExpression, NameExpression, DirectApplication),
		FieldPattern(FieldName, FieldWildcard),
		ParsedBody(ParsedValueBody, ParsedMatchBody),
		ParsedBuiltinType(IntegerBuiltin, StringBuiltin),
		ParsedFunction,
		ParsedMatch,
		ParsedPattern(PatternName, PatternWildcard, PatternConstructor),
		ParsedPrelude,
		ParsedRuntimeOperation(IntegerToStringBuiltin, StringLengthBuiltin),
		ParsedUnion,
		Purity(Pure, Impure),
		TypeSyntax(AtomicType, AppliedType),
		ValueExpression,
		WrittenName,
	../unit/input: parse
	test: TestSuite


private HEADER: String = "func main() -> Int:\n"

private MATCH_HEADER: String = "func f(value: V) -> Int:\n\tmatch value:\n"

private IDENTIFIER_HELP: String = (
	"use an ASCII identifier starting with a letter or underscore; 'func', 'pure', "
	+ "'match', 'var', and lone '_' are reserved"
)

private INDENT_HELP: String = "use tabs only, or spaces in groups of four; do not mix tabs and spaces"

private CHARACTER_HELP: String = (
	"use ASCII function declarations and Int literals, parameter names, or calls; "
	+ "keep -> adjacent"
)

private TRAILING_HELP: String = "start each declaration at column 1 with no blank lines"

private EXPRESSION_HELP: String = "use a literal, a parameter or variant name, or a call as the entire body"

private PATTERN_CLOSE_HELP: String = "write Variant(name), Variant(_), or a nullary Variant()"


private pure func parse_source(source: String) -> Result[ParsedProgram, Diagnostic]:
	input ?= lex(source)
	parse(input)


private pure func prelude_syntax(source: String) -> Result[ParsedPrelude, Diagnostic]:
	input ?= lex(source)
	parse_prelude(input)


private pure func prelude_rejects(
	source: String,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match prelude_syntax(source):
		Err(error):
			(
				error.span.start == start
				and error.span.end == end
				and error.message == message
				and error.help == help
			)
		Ok(_):
			False


pure func test_prelude_builtin_type_alternatives_and_spaces() -> Bool:
	match prelude_syntax("type Int=builtin\ntype String = builtin"):
		Err(_):
			False
		Ok(parsed):
			contents = parsed

			match contents.types:
				[IntegerBuiltin(integer), StringBuiltin(string)]:
					(
						name_spelling(contents.names, integer.id) == Some("Int")
						and name_spelling(contents.names, string.id) == Some("String")
						and contents.functions.length() == 0
					)
				_:
					False


pure func test_prelude_runtime_labels_and_shared_header_syntax() -> Bool:
	match prelude_syntax(
		"pure func convert(value: Int) -> String:\n    builtin ( \"int.to_string\" )\nfunc size ( value : String ) -> Int :\n\tbuiltin(\"string.length\")\n",
	):
		Err(_):
			False
		Ok(parsed):
			match parsed.functions:
				[first, second]:
					(
						first.operation == IntegerToStringBuiltin
						and first.header.purity == Pure
						and second.operation == StringLengthBuiltin
						and second.header.purity == Impure
					)
				_:
					False


pure func test_prelude_unknown_type_and_operation_are_closed_syntax() -> Bool:
	(
		prelude_rejects(
			"type Float = builtin",
			5,
			10,
			"unknown builtin type",
			"declare type Int = builtin or type String = builtin",
		)
		and prelude_rejects(
			"pure func f(value: Int) -> String:\n\tbuiltin(\"unknown\")",
			44,
			53,
			"unknown builtin operation",
			"use \"int.to_string\" or \"string.length\"",
		)
	)


pure func test_prelude_requires_quoted_label_and_closing_parenthesis() -> Bool:
	(
		prelude_rejects(
			"pure func f(value: Int) -> String:\n\tbuiltin(int.to_string)",
			44,
			47,
			"expected a quoted builtin label",
			"use \"int.to_string\" or \"string.length\"",
		)
		and prelude_rejects(
			"pure func f(value: Int) -> String:\n\tbuiltin(\"int.to_string\"",
			59,
			59,
			"expected ')' after the builtin label",
			"give builtin exactly one quoted operation label",
		)
	)


pure func test_prelude_has_no_general_function_body_or_blank_separator() -> Bool:
	(
		prelude_rejects(
			"pure func f(value: Int) -> Int:\n\tvalue",
			33,
			38,
			"expected 'builtin'",
			"use the temporary prelude declaration syntax",
		)
		and prelude_rejects(
			"type Int = builtin\n\n",
			19,
			20,
			"expected a builtin prelude declaration",
			(
				"declare type Int = builtin, type String = builtin, or a pure function with a "
				+ "builtin(...) body"
			),
		)
	)


-- Expected names and byte spans are written independently of the lexer/parser.
private pure func accepts(
	source: String,
	name: String,
	name_start: Int,
	name_end: Int,
	type_name: String,
	type_start: Int,
	type_end: Int,
) -> Bool:
	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match function.body:
						ParsedValueBody(body):
							match first_base(body):
								IntegerExpression(value):
									(
										value == 0
										and function.purity == Impure
										and call_occurrences(body).length() == 0
										and name_spelling(
											program.names,
											function.function_name.id,
										) == Some(name)
										and function.function_name.span.start == name_start
										and function.function_name.span.end == name_end
										and written_type_is(
											program.names,
											function.return_type,
											type_name,
											type_start,
											type_end,
										)
									)
								_:
									False
						_:
							False
				_:
					False


private pure func rejects(
	source: String,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match parse_source(source):
		Ok(_):
			False
		Err(diagnostic):
			(
				diagnostic.span.start == start
				and diagnostic.span.end == end
				and diagnostic.message == message
				and diagnostic.help == help
			)


private pure func written_type_is(
	names: NameTable,
	value: TypeSyntax,
	spelling: String,
	start: Int,
	end: Int,
) -> Bool:
	match value:
		AtomicType(name):
			written_name_is(names, name, spelling, start, end)
		AppliedType(_, _, _):
			False


private pure func written_name_is(
	names: NameTable,
	name: WrittenName,
	spelling: String,
	start: Int,
	end: Int,
) -> Bool:
	(
		name_spelling(names, name.id) == Some(spelling)
		and name.span.start == start
		and name.span.end == end
	)


private pure func rejects_identifier(
	source: String,
	start: Int,
	end: Int,
	message: String,
) -> Bool:
	rejects(source, start, end, message, IDENTIFIER_HELP)


private pure func expression_name_is(
	names: NameTable,
	expression: ValueExpression,
	spelling: String,
	start: Int,
	end: Int,
) -> Bool:
	match first_base(expression):
		NameExpression(name):
			(
				written_name_is(names, name, spelling, start, end)
				and call_occurrences(expression).length() == 0
				and expression.span.start == start
				and expression.span.end == end
			)
		_:
			False


private pure func expression_integer_is(
	expression: ValueExpression,
	value: Int,
	start: Int,
	end: Int,
) -> Bool:
	match first_base(expression):
		IntegerExpression(actual):
			(
				actual == value
				and call_occurrences(expression).length() == 0
				and expression.span.start == start
				and expression.span.end == end
			)
		_:
			False


pure func test_indent_alternatives_and_final_lf() -> Bool:
	(
		accepts(HEADER + "\t0\n", "main", 5, 9, "Int", 15, 18)
		and accepts(HEADER + "    0", "main", 5, 9, "Int", 15, 18)
	)


pure func test_identifier_start_alternatives() -> Bool:
	(
		accepts("func a()->Z:\n\t0", "a", 5, 6, "Z", 10, 11)
		and accepts("func _n()->_t:\n\t0", "_n", 5, 7, "_t", 11, 13)
		and accepts("func A()->z:\n\t0", "A", 5, 6, "z", 10, 11)
	)


pure func test_identifier_continuation_repetition() -> Bool:
	(
		accepts("func a0()->Z_:\n\t0", "a0", 5, 7, "Z_", 11, 13)
		and accepts("func A0_bZ9()->a9_Zb0:\n\t0", "A0_bZ9", 5, 11, "a9_Zb0", 15, 21)
		and accepts("func funcx()->func0:\n\t0", "funcx", 5, 10, "func0", 14, 19)
	)


pure func test_space_repetition_and_token_adjacency() -> Bool:
	(
		accepts("func main()->Int:\n\t0", "main", 5, 9, "Int", 13, 16)
		and accepts("func main ( ) -> Int : \n\t0 \n", "main", 5, 9, "Int", 17, 20)
		and accepts("func  main  (  )  ->  Int  :  \n    0  ", "main", 6, 10, "Int", 22, 25)
	)


pure func test_reserved_keyword_and_word_boundaries() -> Bool:
	(
		rejects(
			"funcmain() -> Int:\n\t0",
			0,
			8,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
		and rejects(
			"Func main() -> Int:\n\t0",
			0,
			4,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
		and rejects("func func() -> Int:\n\t0", 5, 9, "expected a function name", IDENTIFIER_HELP)
		and rejects("func main() -> func:\n\t0", 15, 19, "expected a return type", IDENTIFIER_HELP)
	)


pure func test_identifier_invalid_start_and_non_ascii() -> Bool:
	(
		rejects("func 0() -> Int:\n\t0", 5, 6, "expected a function name", IDENTIFIER_HELP)
		and rejects("func é() -> Int:\n\t0", 5, 6, "unsupported character", CHARACTER_HELP)
	)


pure func test_header_requires_every_term_in_order() -> Bool:
	(
		rejects(
			"",
			0,
			0,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
		and rejects("func () -> Int:\n\t0", 5, 6, "expected a function name", IDENTIFIER_HELP)
		and rejects(
			"func main) -> Int:\n\t0",
			9,
			10,
			"expected '(' after the function name",
			"write main() or helper(value: Int)",
		)
		and rejects(
			"func main( -> Int:\n\t0",
			11,
			13,
			"expected a parameter name or ')'",
			IDENTIFIER_HELP,
		)
		and rejects(
			"func main() Int:\n\t0",
			12,
			15,
			"expected '->' before the return type",
			"write main() -> Int with adjacent arrow characters",
		)
		and rejects("func main() -> :\n\t0", 15, 16, "expected a return type", IDENTIFIER_HELP)
		and rejects(
			"func main() -> Int\n\t0",
			18,
			19,
			"expected ':' after the function header",
			"end the header with ':' and put the return expression on the next line",
		)
		and rejects(
			"func main() -> Int: 0",
			20,
			21,
			"expected a newline after the function header",
			"put the return expression on the next line",
		)
	)


pure func test_untyped_parameter_and_separated_arrow_are_rejected() -> Bool:
	(
		rejects(
			"func main(x) -> Int:\n\t0",
			11,
			12,
			"expected ':' after the parameter name",
			"write each parameter as name: Type",
		)
		and rejects(
			"func main() - > Int:\n\t0",
			12,
			13,
			"expected decimal digits immediately after '-'",
			"write a signed integer such as -42; '-' is not an operator",
		)
	)


pure func test_indentation_is_exact() -> Bool:
	(
		rejects(
			HEADER + "0",
			20,
			21,
			"expected an indent of one tab or four spaces",
			"indent the body with exactly one tab or four spaces",
		)
		and rejects(HEADER + "   0", 20, 23, "invalid indentation", INDENT_HELP)
		and rejects(HEADER + "     0", 20, 25, "invalid indentation", INDENT_HELP)
		and rejects(HEADER + "\t 0", 20, 22, "invalid indentation", INDENT_HELP)
		and rejects(HEADER + "    \t0", 20, 25, "invalid indentation", INDENT_HELP)
		and rejects(
			HEADER + "\t\t0",
			20,
			22,
			"expected an indent of one tab or four spaces",
			"indent the body with exactly one tab or four spaces",
		)
	)


pure func test_header_starts_at_column_one() -> Bool:
	(
		rejects(
			"    " + HEADER + "\t0",
			0,
			4,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
		and rejects(
			"\n" + HEADER + "\t0",
			0,
			1,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
	)


pure func test_only_ascii_spaces_and_lf_separate_terms() -> Bool:
	(
		rejects(
			"func\tmain() -> Int:\n\t0",
			4,
			5,
			"tabs are allowed only in the body indentation",
			"separate tokens with spaces and indent the body with one tab or four spaces",
		)
		and rejects(
			"func main() -> Int:\r\n\t0",
			19,
			20,
			"only LF line endings are supported",
			"replace CRLF or CR line endings with LF",
		)
		and rejects(
			HEADER + "\t0\r",
			22,
			23,
			"only LF line endings are supported",
			"replace CRLF or CR line endings with LF",
		)
	)


pure func test_body_requires_indent_and_expression() -> Bool:
	(
		rejects(
			HEADER,
			20,
			20,
			"expected an indent of one tab or four spaces",
			"indent the body with exactly one tab or four spaces",
		)
		and rejects(
			HEADER + "\t",
			21,
			21,
			"expected a return expression",
			"use a literal, a parameter or variant name, or a call as the entire body",
		)
		and rejects(
			HEADER + "\tx(",
			23,
			23,
			"expected a return expression",
			"use a literal, a parameter or variant name, or a call as the entire body",
		)
		and rejects(
			HEADER + "\n\t0",
			20,
			21,
			"expected an indent of one tab or four spaces",
			"indent the body with exactly one tab or four spaces",
		)
	)


pure func test_numeric_spelling_is_restricted() -> Bool:
	(
		rejects(
			HEADER + "\t00",
			21,
			23,
			"integer literals cannot have leading zeros",
			"write 0 or -0, or remove the leading zeros",
		)
		and rejects(
			HEADER + "\t-00",
			21,
			24,
			"integer literals cannot have leading zeros",
			"write 0 or -0, or remove the leading zeros",
		)
		and rejects(HEADER + "\t+1", 21, 22, "unsupported character", CHARACTER_HELP)
		and accepts(HEADER + "\t-0", "main", 5, 9, "Int", 15, 18)
		and rejects(HEADER + "\t0.0", 23, 24, "expected a function name after '.'", IDENTIFIER_HELP)
	)


pure func test_optional_final_lf_cannot_repeat() -> Bool:
	(
		rejects(
			HEADER + "\t0\n\n",
			23,
			24,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
		and rejects(
			HEADER + "\t0\n    ",
			23,
			27,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
	)


pure func test_eof_requires_full_consumption() -> Bool:
	(
		rejects(
			HEADER + "\t0 0",
			23,
			24,
			"expected a newline after the return expression",
			"separate declarations with one newline and no blank lines",
		)
		and rejects(
			HEADER + "\t0\n0",
			23,
			24,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
	)


pure func test_declaration_repetition_and_call_syntax() -> Bool:
	match parse_source("func main() -> Int:\n\tone ( )\nfunc one() -> Int:\n    1"):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[first, second]:
					second_is_one: Bool = match second.body:
						ParsedValueBody(body):
							match first_base(body):
								IntegerExpression(1):
									call_occurrences(body).length() == 0
								_:
									False
						_:
							False

					match first.body:
						ParsedValueBody(body):
							match first_base(body):
								DirectApplication(name, []):
									(
										name_spelling(program.names, name.id) == Some("one")
										and call_occurrences(body).length() == 0
										and name.span.start == 21
										and name.span.end == 24
										and name_spelling(
											program.names,
											first.function_name.id,
										) == Some("main")
										and first.function_name.span.start == 5
										and first.function_name.span.end == 9
										and written_type_is(
											program.names,
											first.return_type,
											"Int",
											15,
											18,
										)
										and name_spelling(
											program.names,
											second.function_name.id,
										) == Some("one")
										and second.function_name.span.start == 34
										and second.function_name.span.end == 37
										and written_type_is(
											program.names,
											second.return_type,
											"Int",
											43,
											46,
										)
										and second_is_one
										and program.end.start == 53
										and program.end.end == 53
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_argument_syntax_and_blank_separator_rule() -> Bool:
	argument_accepted: Bool = match parse_source(HEADER + "\tone(0)"):
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match function.body:
						ParsedValueBody(body):
							match first_base(body):
								IntegerExpression(0):
									match call_occurrences(body):
										[call]:
											(
												name_spelling(
													program.names,
													call.callee.id,
												) == Some("one")
												and call.callee.span.start == 21
												and call.callee.span.end == 24
												and call.notation == DirectCall
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False

	(
		argument_accepted
		and rejects(
			HEADER + "\t0\n\nfunc one() -> Int:\n\t1",
			23,
			24,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
	)


pure func test_pure_qualifier_preserves_names_and_spans() -> Bool:
	match parse_source("pure func main() -> Int:\n\t0"):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match function.body:
						ParsedValueBody(body):
							match first_base(body):
								IntegerExpression(0):
									(
										function.purity == Pure
										and call_occurrences(body).length() == 0
										and name_spelling(
											program.names,
											function.function_name.id,
										) == Some("main")
										and function.function_name.span.start == 10
										and function.function_name.span.end == 14
										and written_type_is(
											program.names,
											function.return_type,
											"Int",
											20,
											23,
										)
										and program.end.start == 27
										and program.end.end == 27
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_malformed_and_reserved_pure_are_rejected() -> Bool:
	(
		rejects(
			"pure pure func main() -> Int:\n\t0",
			5,
			9,
			"expected 'func' after 'pure'",
			"write pure func name() -> Int:",
		)
		and rejects("pure", 4, 4, "expected 'func' after 'pure'", "write pure func name() -> Int:")
		and rejects("func pure() -> Int:\n\t0", 5, 9, "expected a function name", IDENTIFIER_HELP)
		and rejects("func main() -> pure:\n\t0", 15, 19, "expected a return type", IDENTIFIER_HELP)
		and accepts("func purex() -> Int:\n\t0", "purex", 5, 10, "Int", 16, 19)
	)


pure func test_parameter_and_nested_call_are_valid_syntax() -> Bool:
	match parse_source("func f(value: Foo) -> Bar:\n\touter(inner(value))\n"):
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match function.parameters:
						[parameter]:
							match function.body:
								ParsedValueBody(body):
									match first_base(body):
										NameExpression(value):
											match call_occurrences(body):
												[inner, outer]:
													(
														function.purity == Impure
														and name_spelling(
															program.names,
															function.function_name.id,
														) == Some("f")
														and function.function_name.span.start == 5
														and function.function_name.span.end == 6
														and name_spelling(
															program.names,
															parameter.name.id,
														) == Some("value")
														and parameter.name.span.start == 7
														and parameter.name.span.end == 12
														and written_type_is(
															program.names,
															parameter.type_name,
															"Foo",
															14,
															17,
														)
														and written_type_is(
															program.names,
															function.return_type,
															"Bar",
															22,
															25,
														)
														and name_spelling(
															program.names,
															value.id,
														) == Some("value")
														and value.span.start == 40
														and value.span.end == 45
														and name_spelling(
															program.names,
															inner.callee.id,
														) == Some("inner")
														and inner.callee.span.start == 34
														and inner.callee.span.end == 39
														and inner.notation == DirectCall
														and name_spelling(
															program.names,
															outer.callee.id,
														) == Some("outer")
														and outer.callee.span.start == 28
														and outer.callee.span.end == 33
														and outer.notation == DirectCall
														and program.end.start == 48
														and program.end.end == 48
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_parameter_annotation_requires_colon() -> Bool:
	rejects(
		"func f(value) -> Int:\n\t0\n",
