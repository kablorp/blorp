pure func test_ufcs_interleaves_with_pending_direct_calls() -> Bool:
	source: String =
		|func f(value: Foo) -> Bar:
		|	zero(identity(value).one()).identity()
		|

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match root_functions(program):
				[function]:
					match function.body:
						ParsedValueBody(body):
							match first_base(body):
								NameExpression(value):
									match call_occurrences(body):
										[first, second, third, fourth]:
											(
												name_spelling(
													program.names,
													value.id,
												) == Some("value")
												and value.span.start == 42
												and value.span.end == 47
												and name_spelling(
													program.names,
													first.callee.id,
												) == Some("identity")
												and first.callee.span.start == 33
												and first.callee.span.end == 41
												and first.receiver_call == False
												and name_spelling(
													program.names,
													second.callee.id,
												) == Some("one")
												and second.callee.span.start == 49
												and second.callee.span.end == 52
											and second.receiver_call == True
												and name_spelling(
													program.names,
													third.callee.id,
												) == Some("zero")
												and third.callee.span.start == 28
												and third.callee.span.end == 32
											and third.receiver_call == False
												and name_spelling(
													program.names,
													fourth.callee.id,
												) == Some("identity")
												and fourth.callee.span.start == 56
												and fourth.callee.span.end == 64
											and fourth.receiver_call == True
												and program.end.start == 67
												and program.end.end == 67
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_postfix_requires_name_and_distinguishes_parentheses() -> Bool:
	(
		rejects(
			HEADER + "\t1.",
			21,
			23,
			"Float literals need digits after the decimal point",
			"write 1.0; otherwise use a UFCS function call after '.'",
		)
		-- Two adjacent dots are the range symbol, so these are ranges.
		and main_is_range(HEADER + "\t1..one()")
		and main_is_range(HEADER + "\t1.5..one()")
		and parse_source(HEADER + "\t1.one").is_ok()
		and rejects(
			HEADER + "\t1.one(",
			27,
			27,
			"expected a return expression",
			"use a literal, a parameter or variant name, or a call as the entire body",
		)
		and parse_source(HEADER + "\t1.one(0)").is_ok()
	)


pure func test_ufcs_tail_requires_full_consumption() -> Bool:
	rejects(
		HEADER + "\t1.one() 0",
		29,
		30,
		"expected a newline after the return expression",
		"put each declaration on a new line",
	)


pure func test_union_names_variants_and_expression_spans() -> Bool:
	match parse_source(
		"union Choice:\n\tFirst\n\tSecond\nfunc value() -> Choice:\n\tFirst   \n",
	):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match root_unions(program):
				[declaration]:
					match declaration.variants.map(pure func(row): row.declaration):
						[first, second]:
							match root_functions(program):
								[function]:
									match function.body:
										ParsedValueBody(body):
											match first_base(body):
												NameExpression(name):
													(
														name_spelling(
															program.names,
															declaration.type_name.id,
														) == Some("Choice")
														and declaration.type_name.span.start == 6
														and declaration.type_name.span.end == 12
														and name_spelling(
															program.names,
															first.name.id,
														) == Some("First")
														and first.name.span.start == 15
														and first.name.span.end == 20
														and name_spelling(
															program.names,
															second.name.id,
														) == Some("Second")
														and second.name.span.start == 22
														and second.name.span.end == 28
														and name_spelling(
															program.names,
															function.function_name.id,
														) == Some("value")
														and function.function_name.span.start == 34
														and function.function_name.span.end == 39
														and return_type_is(
															program.names,
															function.return_type,
															"Choice",
															51,
															57,
														)
														and name_spelling(
															program.names,
															name.id,
														) == Some("First")
														and name.span.start == 54
														and name.span.end == 59
														and body.span.start == 54
														and body.span.end == 59
														and call_occurrences(body).length() == 0
														and program.end.start == 69
														and program.end.end == 69
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


