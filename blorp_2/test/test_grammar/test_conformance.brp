pure func test_match_patterns_require_supported_field_shape() -> Bool:
	(
		rejects_identifier(MATCH_HEADER + "\t\t0: 1", 41, 42, "expected a match pattern")
		and rejects_identifier(
			MATCH_HEADER + "\t\tNumber(0): 1",
			48,
			49,
			"expected an Int field binding or '_'",
		)
		and rejects(
			MATCH_HEADER + "\t\tNumber(Inner(x)): 1",
			53,
			54,
			"expected ')' after the constructor pattern",
			PATTERN_CLOSE_HELP,
		)
		and rejects(
			MATCH_HEADER + "\t\tNumber(x: 1",
			49,
			50,
			"expected ')' after the constructor pattern",
			PATTERN_CLOSE_HELP,
		)
		and rejects(
			MATCH_HEADER + "\t\tNumber(x y): 1",
			50,
			51,
			"expected ')' after the constructor pattern",
			PATTERN_CLOSE_HELP,
		)
		and rejects(
			MATCH_HEADER + "\t\t_(): 1",
			42,
			43,
			"expected ':' after the match pattern",
			"write Pattern: expression on one line",
		)
		and rejects(
			MATCH_HEADER + "\t\tValue.Empty: 1",
			46,
			47,
			"expected ':' after the match pattern",
			"write Pattern: expression on one line",
		)
	)


pure func test_match_arms_require_colon_and_inline_result() -> Bool:
	(
		rejects(
			MATCH_HEADER + "\t\t_ 0",
			43,
			44,
			"expected ':' after the match pattern",
			"write Pattern: expression on one line",
		)
		and rejects(
			MATCH_HEADER + "\t\t_:",
			43,
			43,
			"expected a return expression",
			EXPRESSION_HELP,
		)
		and rejects(
			MATCH_HEADER + "\t\t_: \n\t\t\t1",
			44,
			45,
			"expected a return expression",
			EXPRESSION_HELP,
		)
		and rejects(
			MATCH_HEADER + "\t\t_: match value:",
			44,
			49,
			"expected a return expression",
			EXPRESSION_HELP,
		)
		and rejects(
			HEADER + "\tone(match value)",
			25,
			30,
			"expected a return expression",
			EXPRESSION_HELP,
		)
		and rejects(
			MATCH_HEADER + "\t\t_: 1 2",
			46,
			47,
			"expected a newline after the return expression",
			"separate declarations with one newline and no blank lines",
		)
	)


