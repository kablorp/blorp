pure func test_binding_prefix_and_final_value_shape() -> Bool:
	match parse_source(HEADER + "\tfirst=1\n\tvar current = first\n\tcurrent=42\n\tfirst"):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match function.bindings:
						[first, current, update]:
							(
								first.mutability == ImmutableBinding
								and current.mutability == MutableBinding
								and update.mutability == ImmutableBinding
								and written_name_is(program.names, first.name, "first", 21, 26)
								and expression_integer_is(first.initializer, 1, 27, 28)
								and current.name.span.start == 34
								and current.initializer.span.start == 44
								and value_body_name_is(
									program.names,
									function.body,
									"first",
									63,
									68,
								)
							)
						_:
							False
				_:
					False


private pure func value_body_name_is(
	names: NameTable,
	body: ParsedBody,
	name: String,
	start: Int,
	end: Int,
) -> Bool:
	match body:
		ParsedValueBody(value):
			expression_name_is(names, value, name, start, end)
		_:
			False


pure func test_binding_spaces_and_tail_match() -> Bool:
