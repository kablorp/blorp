pure func test_function_type_parameter_list_preserves_order_and_spans() -> Bool:
	prefix = "pure func choose["

	match parse_source(prefix + "A, B, C](a:A,b:B,c:C)->C:\n\tc\n"):
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match function.type_parameters:
						[first, second, third]:
							(
								written_name_is(
									program.names,
									first,
									"A",
									prefix.length(),
									prefix.length() + 1,
								)
								and written_name_is(
									program.names,
									second,
									"B",
									prefix.length() + 3,
									prefix.length() + 4,
								)
								and written_name_is(
									program.names,
									third,
									"C",
									prefix.length() + 6,
									prefix.length() + 7,
								)
							)
						_:
							False
				_:
					False
		_:
			False


