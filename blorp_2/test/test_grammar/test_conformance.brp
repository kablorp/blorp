		_:
			False


private pure func rejects_marked(
	prefix: String,
	marked: String,
	suffix: String,
	message: String,
	help: String,
) -> Bool:
	rejects(
		prefix + marked + suffix,
		prefix.length(),
		prefix.length() + marked.length(),
		message,
		help,
	)


pure func test_generic_parameter_names_are_validated_by_parser() -> Bool:
	help = (
		"start with a capital ASCII letter and use only ASCII letters and digits, such "
		+ "as T or Element2"
	)
	(
		rejects_marked(
			"func f[",
			"t",
			"](value: t) -> t:\n\tvalue",
			"invalid type parameter name",
			help,
		)
		and rejects_marked(
			"func f[",
			"T_",
			"](value: T_) -> T_:\n\tvalue",
			"invalid type parameter name",
			help,
		)
	)


pure func test_generic_parameter_requires_one_name_and_closing_bracket() -> Bool:
	(
		rejects_marked(
			"func f[",
			"]",
			"() -> Int:\n\t0",
			"expected a type parameter name",
			"declare type parameters separated by commas, such as [A, B]",
		)
		and rejects_marked(
			"func f[T",
			"(",
			"value: T) -> T:\n\tvalue",
			"expected ',' or ']' after a type parameter",
			"separate type parameters with commas and close the list with ']'",
		)
		and rejects_marked(
			"func f[T ",
			"U",
			"](value: T) -> T:\n\tvalue",
			"expected ',' or ']' after a type parameter",
			"separate type parameters with commas and close the list with ']'",
		)
	)


pure func test_explicit_function_type_arguments_are_rejected() -> Bool:
	(
		rejects_marked(
			HEADER + "\tidentity",
			"[",
			"Int](7)",
			"explicit function type arguments are unsupported",
			"omit the brackets at calls; argument types determine the type parameters",
		)
		and rejects_marked(
			HEADER + "\t7.identity",
			"[",
			"Int]()",
			"explicit function type arguments are unsupported",
			"omit the brackets at calls; argument types determine the type parameters",
		)
	)


private pure func applied_type_is(
	names: NameTable,
	value: TypeSyntax,
	argument_spelling: String,
	start: Int,
	end: Int,
	argument_start: Int,
	argument_end: Int,
) -> Bool:
	match value:
		AppliedType(owner, [argument], span):
			(
				written_name_is(names, owner, "Box", start, start + 3)
				and written_name_is(
					names,
					argument,
					argument_spelling,
					argument_start,
					argument_end,
				)
				and span.start == start
				and span.end == end
			)
		AtomicType(_) | AppliedType(_, _, _):
			False


pure func test_generic_union_and_atomic_application_spans() -> Bool:
	match parse_source(
		"fixed union Box [ T ]:\n\tBox(T)\npure func keep[T](value: Box [ T ]) -> Box[Int]:\n\tvalue\n",
	):
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.unions:
				[declaration]:
					match declaration.type_parameters:
						[parameter]:
							match declaration.variants:
								[variant]:
									match variant.payload:
										Some(payload):
											match program.functions:
												[function]:
													match function.parameters:
														[value]:
															(
																written_name_is(
																	program.names,
																	declaration.type_name,
																	"Box",
																	12,
																	15,
																)
																and written_name_is(
																	program.names,
																	parameter,
																	"T",
																	18,
																	19,
																)
																and written_name_is(
																	program.names,
																	payload,
																	"T",
																	28,
																	29,
																)
																and applied_type_is(
																	program.names,
																	value.type_name,
																	"T",
																	56,
																	65,
																	62,
																	63,
																)
																and applied_type_is(
																	program.names,
																	function.return_type,
																	"Int",
																	70,
																	78,
																	74,
																	77,
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_written_nested_applications_are_rejected_explicitly() -> Bool:
	rejects_marked(
		"func f(value: Box[Box",
		"[",
		"Int]]) -> Int:\n\t0",
		"nested type applications are not supported",
		(
			"use Int, String, a declared parameter, or an ordinary union as the written "
			+ "argument"
		),
	)


pure func test_written_application_requires_one_atomic_argument() -> Bool:
