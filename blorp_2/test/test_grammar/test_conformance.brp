private pure func value_union_shape(names: NameTable, declaration: UnionRow) -> Bool:
	match declaration.variants.map(pure func(row): row.declaration):
		[empty, number]:
			match empty.fields:
				[]:
					match number.fields:
						[AtomicType(type_name)]:
							(
								written_name_is(names, declaration.type_name, "Value", 12, 17)
								and written_name_is(names, empty.name, "Empty", 20, 25)
								and written_name_is(names, number.name, "Number", 27, 33)
								and written_name_is(names, type_name, "Int", 34, 37)
							)
						_:
							False
				_:
					False
		_:
			False


private pure func unwrap_match_shape(names: NameTable, body: ParsedMatch) -> Bool:
	match body.arms:
		[empty, number]:
			match empty.pattern:
				PatternName(empty_name):
					match number.pattern:
						PatternConstructor(BareHead(number_name), [PatternName(field)], span):
							match arm_base(empty):
								Some(IntegerExpression(0)):
									(
										expression_name_is(names, body.scrutinee, "value", 85, 90)
										and body.span.start == 79
										and body.span.end == 127
										and body.keyword_span.start == 79
										and body.keyword_span.end == 84
										and written_name_is(names, empty_name, "Empty", 94, 99)
										and empty.span.start == 94
										and empty.span.end == 102
										and arm_value_start(empty) == Some(101)
										and arm_value_end(empty) == Some(102)
										and arm_calls(empty).length() == 0
										and written_name_is(names, number_name, "Number", 105, 111)
										and written_name_is(names, field, "number", 112, 118)
										and span.start == 105
										and span.end == 119
										and number.span.start == 105
										and number.span.end == 127
										and arm_name_is(names, number,
											"number",
											121,
											127,
										)
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func unwrap_function_shape(names: NameTable, function: ParsedFunction) -> Bool:
	match function.parameters:
		[parameter]:
			match function.body:
				ParsedMatchBody(body):
					(
						unwrap_match_shape(names, body)
						and function.purity == Pure
						and written_name_is(names, function.function_name, "unwrap", 49, 55)
						and written_name_is(names, parameter.name, "value", 56, 61)
						and written_type_is(names, parameter.type_name, "Value", 63, 68)
						and return_type_is(names, function.return_type, "Int", 73, 76)
					)
				_:
					False
		_:
			False


private pure func constructed_main_shape(names: NameTable, function: ParsedFunction) -> Bool:
	no_parameters: Bool = match function.parameters:
		[]:
			True
		_:
			False

	match function.body:
		ParsedValueBody(body):
			match first_base(body):
				IntegerExpression(42):
					match call_occurrences(body):
						[number, call]:
							(
								function.purity == Impure
								and no_parameters
								and written_name_is(names, function.function_name, "main", 133, 137)
								and return_type_is(names, function.return_type, "Int", 143, 146)
								and body.span.start == 149
								and body.span.end == 167
								and written_name_is(names, number.callee, "Number", 156, 162)
								and number.receiver_call == False
								and written_name_is(names, call.callee, "unwrap", 149, 155)
								and call.receiver_call == False
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_payload_and_match_syntax() -> Bool:
	source: String =
		|union Value:
		|	Empty
		|	Number(Int)
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Empty: 0
		|		Number(number): number
		|func main() -> Int:
		|	unwrap(Number(42))
		|

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match root_unions(program):
				[declaration]:
					match root_functions(program):
						[unwrap, main_function]:
							(
								value_union_shape(program.names, declaration)
								and unwrap_function_shape(program.names, unwrap)
								and constructed_main_shape(program.names, main_function)
								and program.end.start == 168
								and program.end.end == 168
							)
						_:
							False
				_:
					False


private pure func spaced_union_shape(names: NameTable, declaration: UnionRow) -> Bool:
	match declaration.variants.map(pure func(row): row.declaration):
		[empty, number]:
			match empty.fields:
				[]:
					match number.fields:
						[AtomicType(type_name)]:
							(
								written_name_is(names, declaration.type_name, "V", 148, 149)
								and written_name_is(names, empty.name, "Empty", 155, 160)
								and written_name_is(names, number.name, "Number", 165, 171)
								and written_name_is(names, type_name, "Float", 174, 179)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_pattern_alternatives_space_layout_and_following_union() -> Bool:
	-- The trailing-space holes preserve the exact layout bytes and spans.
	source: String =
		|func f(value:V)->Int:
		|    match value :${" "}
		|        Empty ( ) : zero(1).identity()${" "}
		|        Number ( _ ) : 2
		|        whole: 3
		|        _: 4
		|union V:
		|    Empty
		|    Number ( Float )${" "}

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			union_ok: Bool = match root_unions(program):
				[declaration]:
					spaced_union_shape(program.names, declaration)
				_:
					False

			match root_functions(program):
				[function]:
					header_ok: Bool = match function.parameters:
						[parameter]:
							(
								function.purity == Impure
								and written_name_is(
									program.names,
									function.function_name,
									"f",
									5,
									6,
								)
								and written_name_is(program.names, parameter.name, "value", 7, 12)
								and written_type_is(program.names, parameter.type_name, "V", 13, 14)
								and return_type_is(
									program.names,
									function.return_type,
									"Int",
									17,
									20,
								)
							)
						_:
							False

					match function.body:
						ParsedMatchBody(body):
							match body.arms:
								[empty, number, whole, wildcard]:
									empty_body_ok: Bool = match arm_base(empty):
										Some(IntegerExpression(1)):
											match arm_calls(empty):
												[zero, identity]:
													(
														written_name_is(
															program.names,
															zero.callee,
															"zero",
															61,
															65,
														)
														and zero.receiver_call == False
														and written_name_is(
															program.names,
															identity.callee,
															"identity",
															69,
															77,
														)
														and identity.receiver_call == True
														and arm_value_start(empty) == Some(61)
														and arm_value_end(empty) == Some(79)
													)
												_:
													False
										_:
											False

									empty_ok: Bool = match empty.pattern:
										PatternConstructor(BareHead(name), [], span):
											(
												written_name_is(
													program.names,
													name,
													"Empty",
													49,
													54,
												)
												and span.start == 49
												and span.end == 58
											)
										_:
											False

									number_ok: Bool = match number.pattern:
										PatternConstructor(BareHead(name), [PatternWildcard(field)], span):
											(
												written_name_is(
													program.names,
													name,
													"Number",
													89,
													95,
												)
												and field.start == 98
												and field.end == 99
												and span.start == 89
												and span.end == 101
											)
										_:
											False

									whole_ok: Bool = match whole.pattern:
										PatternName(name):
											written_name_is(program.names, name, "whole", 114, 119)
										_:
											False

									wildcard_ok: Bool = match wildcard.pattern:
										PatternWildcard(span):
											span.start == 131 and span.end == 132
										_:
											False

									(
										header_ok
										and empty_ok
										and number_ok
										and whole_ok
										and wildcard_ok
										and empty_body_ok
										and arm_integer_is(number, 2, 104, 105)
										and arm_integer_is(whole, 3, 121, 122)
										and arm_integer_is(wildcard, 4, 134, 135)
										and expression_name_is(
											program.names,
											body.scrutinee,
											"value",
											32,
											37,
										)
										and body.span.start == 26
										and body.span.end == 135
										and body.keyword_span.start == 26
										and body.keyword_span.end == 31
										and empty.span.start == 49
										and empty.span.end == 79
										and number.span.start == 89
										and number.span.end == 105
										and whole.span.start == 114
										and whole.span.end == 122
										and wildcard.span.start == 131
										and wildcard.span.end == 135
										and union_ok
										and program.end.start == 182
										and program.end.end == 182
									)
								_:
									False
						_:
							False
				_:
					False


private pure func single_wildcard_match_is(source: String, eof: Int) -> Bool:
	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match root_functions(program):
				[function]:
					match function.parameters:
						[parameter]:
							match function.body:
								ParsedMatchBody(body):
									match body.arms:
										[arm]:
											match arm.pattern:
												PatternWildcard(span):
													(
														function.purity == Impure
														and written_name_is(
															program.names,
															function.function_name,
															"f",
															5,
															6,
														)
														and written_name_is(
															program.names,
															parameter.name,
															"value",
															7,
															12,
														)
														and written_type_is(
															program.names,
															parameter.type_name,
															"V",
															14,
															15,
														)
														and return_type_is(
															program.names,
															function.return_type,
															"Int",
															20,
															23,
														)
														and expression_name_is(
															program.names,
															body.scrutinee,
															"value",
															32,
															37,
														)
														and body.span.start == 26
														and body.span.end == 45
														and body.keyword_span.start == 26
														and body.keyword_span.end == 31
														and span.start == 41
														and span.end == 42
														and arm.span.start == 41
														and arm.span.end == 45
														and arm_integer_is(
															arm,
															1,
															44,
															45,
														)
														and root_unions(program).length() == 0
														and program.end.start == eof
														and program.end.end == eof
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_match_one_arm_and_optional_final_lf() -> Bool:
	(
		single_wildcard_match_is(MATCH_HEADER + "\t\t_: 1", 45)
		and single_wildcard_match_is(MATCH_HEADER + "\t\t_: 1\n", 46)
	)


-- A reserved word where a name is declared is named in the host's words.
private pure func rejects_keyword(source: String, start: Int, end: Int, spelling: String) -> Bool:
	rejects(
		source,
		start,
		end,
		"`" + spelling + "` is a reserved keyword and cannot be used as a name",
		"choose another identifier such as `" + spelling + "_name`",
	)


pure func test_match_and_wildcard_are_reserved_in_name_contexts() -> Bool:
	(
		rejects_identifier("func _() -> Int:\n\t0", 5, 6, "expected a function name")
		and rejects_keyword("func match() -> Int:\n\t0", 5, 10, "match")
		and rejects_identifier("func main() -> _:\n\t0", 15, 16, "expected a return type")
		and rejects_keyword("func main() -> match:\n\t0", 15, 20, "match")
		and rejects_identifier(
			"func f(_: Int) -> Int:\n\t0",
			7,
			8,
			"expected a parameter name or ')'",
		)
		and rejects_keyword(
			"func f(match: Int) -> Int:\n\t0",
			7,
			12,
			"match",
			)
		and rejects_identifier("func f(x: _) -> Int:\n\t0", 10, 11, "expected a parameter type")
		and rejects_keyword("func f(x: match) -> Int:\n\t0", 10, 15, "match")
		and rejects_identifier("union _:\n\tA", 6, 7, "expected a union type name")
		and rejects_keyword("union match:\n\tA", 6, 11, "match")
		and rejects_identifier("union V:\n\t_", 10, 11, "expected a union variant name")
		and rejects_keyword("union V:\n\tmatch", 10, 15, "match")
		and rejects_identifier("union V:\n\tNumber(_)", 17, 18, "expected a payload type")
		and rejects_keyword("union V:\n\tNumber(match)", 17, 22, "match")
		and rejects_identifier(
			HEADER + "\t1._()",
			23,
			24,
			"expected a field or function name after '.'",
		)
		and rejects_keyword(
			HEADER + "\t1.match()",
			23,
			28,
			"match",
			)
		and rejects_keyword(MATCH_HEADER + "\t\tmatch: 1", 41, 46, "match")
		and rejects_keyword(
			MATCH_HEADER + "\t\tNumber(match): 1",
			48,
			53,
			"match",
			)
		and accepts("func matchx()->_t:\n\t0", "matchx", 5, 11, "_t", 15, 17)
	)


pure func test_match_header_requires_scrutinee_colon_and_lf() -> Bool:
	invalid_match_source: String =
		|union Value:
		|	Empty
		|pure func make(value: Int) -> Value:
		|	Empty
		|func main() -> Int:
		|	match-1.make():
		|		_: 0
		|
	(
		rejects(
			invalid_match_source,
			96,
			98,
			"expected a space after 'match'",
			"put a space between 'match' and the matched expression",
		)
		and rejects(
			"func f(value: V) -> Int:\n\tmatch :\n\t\t_: 0",
			32,
			33,
			"expected a return expression",
			EXPRESSION_HELP,
		)
		and rejects(
			"func f(value: V) -> Int:\n\tmatch value\n\t\t_: 0",
			37,
			38,
			"expected `:` after match expression",
			BLOCK_HEADER_HELP,
		)
		and rejects(
			"func f(value: V) -> Int:\n\tmatch value: 0",
			39,
			40,
			"expected newline before match cases",
			"start the next statement or item on its own line",
		)
	)


pure func test_match_requires_nonempty_indented_arms() -> Bool:
	(
		rejects(MATCH_HEADER, 39, 39, "expected an indented block", ARM_INDENT_HELP)
		and rejects(MATCH_HEADER + "_: 0", 39, 39, "expected an indented block", ARM_INDENT_HELP)
		and rejects(MATCH_HEADER + "\t_: 0", 40, 41, "expected an indented block", ARM_INDENT_HELP)
		and parse_source(MATCH_HEADER + "\t\t\t_: 0").is_ok()
		and rejects(MATCH_HEADER + "       _: 0", 39, 46, "invalid indentation", INDENT_HELP)
		and rejects(MATCH_HEADER + "\t\t _: 0", 39, 42, "invalid indentation", INDENT_HELP)
		and parse_source(MATCH_HEADER + "\n\t\t_: 0").is_ok()
		and rejects(MATCH_HEADER + HEADER + "\t0", 39, 39, "expected an indented block", ARM_INDENT_HELP)
		and rejects(MATCH_HEADER + "union V:\n\tA", 39, 39, "expected an indented block", ARM_INDENT_HELP)
	)


pure func test_match_patterns_require_supported_field_shape() -> Bool:
	(
		rejects_identifier(MATCH_HEADER + "\t\t0: 1", 41, 42, "expected a match pattern")
		and rejects_identifier(
			MATCH_HEADER + "\t\tNumber(0): 1",
			48,
			49,
			"expected a match pattern",
		)
		-- Fields are patterns, so a constructor nests; checking rejects it.
		and parse_source(MATCH_HEADER + "\t\tNumber(Inner(x)): 1").is_ok()
		and rejects(
			MATCH_HEADER + "\t\tNumber(x: 1",
			49,
			50,
			"expected ')' after the constructor pattern",
			PATTERN_CLOSE_HELP,
		)
		and rejects(
			MATCH_HEADER + "\t\tNumber(x y): 1",
			50,
			51,
			"expected ')' after the constructor pattern",
			PATTERN_CLOSE_HELP,
		)
		and rejects(
			MATCH_HEADER + "\t\t_(): 1",
			42,
			43,
			"expected ':' after the match pattern",
			"write Pattern: expression, or put the arm body on the next indented line",
		)
		-- A dotted pattern is a qualified constructor; checking rejects it.
		and parse_source(MATCH_HEADER + "\t\tValue.Empty: 1").is_ok()
	)


pure func test_match_arms_require_colon_and_result() -> Bool:
	(
		rejects(
			MATCH_HEADER + "\t\t_ 0",
			43,
			44,
			"expected ':' after the match pattern",
			"write Pattern: expression, or put the arm body on the next indented line",
		)
		and rejects(MATCH_HEADER + "\t\t_:", 43, 43, "expected an indented match arm result", ARM_RESULT_INDENT_HELP)
		and rejects(
			MATCH_HEADER + "\t\t_: match value:",
			56,
			56,
			"expected an indented block",
			ARM_INDENT_HELP,
		)
		and rejects(
			HEADER + "\tone(match value)",
			36,
			37,
			"expected `:` after match expression",
			BLOCK_HEADER_HELP,
		)
		and rejects(
			MATCH_HEADER + "\t\t_: 1 2",
			46,
			47,
			"expected a newline after the return expression",
			"put each declaration on a new line",
		)
	)


pure func test_binding_prefix_and_final_value_shape() -> Bool:
	source: String =
		|func main() -> Int:
		|	first=1
		|	var current = first
		|	current=42
		|	first

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match root_functions(program):
				[function]:
					match function.statements:
						[BindingStatement(first), BindingStatement(current), BindingStatement(update)]:
							(
								first.mutable == False
								and current.mutable == True
								and update.mutable == False
								and written_name_is(program.names, first.name, "first", 21, 26)
								and expression_integer_is(first.initializer, 1, 27, 28)
								and current.name.span.start == 34
								and current.initializer.span.start == 44
								and value_body_name_is(
									program.names,
									function.body,
									"first",
									63,
									68,
								)
							)
						_:
							False
				_:
					False


private pure func value_body_name_is(
	names: NameTable,
	body: ParsedBody,
	name: String,
	start: Int,
	end: Int,
) -> Bool:
	match body:
		ParsedValueBody(value):
			expression_name_is(names, value, name, start, end)
		_:
			False


pure func test_binding_spaces_and_tail_match() -> Bool:
	match parse_source(
		"func f(value: V) -> Int:\n    local = value  \n    match local:\n        _: 0\n",
	):
		Err(_):
			False
		Ok(parsed):
			match root_functions(parsed_contents(parsed)):
				[function]:
					match function.body:
						ParsedMatchBody(_):
							function.statements.length() == 1
						_:
							False
				_:
					False


-- After '=' the value is on the same line or alone on an indented line; a
-- next line at the same level is missing its indentation.
pure func test_binding_value_on_the_next_line_must_be_indented() -> Bool:
	rejects(
		HEADER + "\tvalue =\n\t0\n",
		30,
		31,
		"expected an indented value after '='",
		"put the value on the same line as '=', or alone on the next line indented one level",
	)


pure func test_binding_requires_a_final_expression() -> Bool:
	(
		rejects(
			HEADER + "\tvalue = 1",
			30,
			30,
			"expected a final expression after the bindings",
			"finish the function with a value expression or tail match",
		)
		and rejects(
			HEADER + "\tvalue = 1\n",
			31,
			31,
			"expected a final expression after the bindings",
			"finish the function with a value expression or tail match",
		)
	)


pure func test_var_is_reserved_but_longer_names_are_identifiers() -> Bool:
	(
		rejects_keyword("func var() -> Int:\n\t0\n", 5, 8, "var")
		and accepts("func variable()->Int:\n\t0", "variable", 5, 13, "Int", 17, 20)
		and rejects(HEADER + "\tvar = 1\n\t0\n", 25, 26, "expected a binding name", IDENTIFIER_HELP)
	)


-- A reserved word where a binding or parameter is declared names the keyword.
pure func test_reserved_words_are_named_at_binding_and_parameter_sites() -> Bool:
	(
		rejects_keyword(HEADER + "\tin = 1\n\t0\n", 21, 23, "in")
		and rejects_keyword(HEADER + "\tvar in = 1\n\t0\n", 25, 27, "in")
		and rejects_keyword("func main(for: Int) -> Int:\n\t0\n", 10, 13, "for")
		and rejects_keyword(HEADER + "\twhere = 1\n\t0\n", 21, 26, "where")
		and rejects(HEADER + "\telse:\n\t\t2\n", 21, 25, "`else` has no matching `if`", "write else on its own line at the indentation of its if, directly after the if branch; else is not a value")
	)


-- An annotated binding parses; a discard does not.
pure func test_binding_annotations_parse_and_discards_remain_unsupported() -> Bool:
	(
		parse_source(HEADER + "\tvar value: Int = 1\n\tvalue\n").is_ok()
		and rejects(
			HEADER + "\t_ = 1\n\t0\n",
			21,
			22,
			"expected a return expression",
			EXPRESSION_HELP,
		)
	)


pure func test_arm_block_bindings_and_inline_sibling_spans() -> Bool:
	source: String =
		|func f(value: V) -> Int:
		|	match value:
		|		A:
		|			var current = value
		|			original = current
		|			current = 42
		|			original
		|		B: 0

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match root_functions(program):
				[function]:
					match function.body:
						ParsedMatchBody(body):
							match body.arms:
								[first, second]:
									match first.block.statements:
										[BindingStatement(current), BindingStatement(original), BindingStatement(reassigned)]:
											(
												current.mutable == True
												and written_name_is(
													program.names,
													current.name,
													"current",
													51,
													58,
												)
												and expression_name_is(
													program.names,
													current.initializer,
													"value",
													61,
													66,
												)
												and original.mutable == False
												and written_name_is(
													program.names,
													original.name,
													"original",
													70,
													78,
												)
												and expression_name_is(
													program.names,
													original.initializer,
													"current",
													81,
													88,
												)
												and reassigned.mutable == False
												and written_name_is(
													program.names,
													reassigned.name,
													"current",
													92,
													99,
												)
												and expression_integer_is(
													reassigned.initializer,
													42,
													102,
													104,
												)
												and arm_name_is(
													program.names,
													first,
													"original",
													108,
													116,
												)
												and first.span.start == 41
												and first.span.end == 116
												and second.block.statements.length() == 0
												and second.span.start == 119
												and second.span.end == 123
												and arm_integer_is(second, 0, 122, 123)
												and body.span.end == 123
												and program.end.start == 123
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_block_without_bindings_and_optional_final_lf() -> Bool:
	var accepted = True

	for suffix in ["", "\n"]:
		match parse_source(MATCH_HEADER + "\t\t_: \n\t\t\t7" + suffix):
			Err(_):
				accepted = False
			Ok(parsed):
				match root_functions(parsed_contents(parsed)):
					[function]:
						match function.body:
							ParsedMatchBody(body):
								match body.arms:
									[arm]:
										accepted = (
											accepted
											and arm.block.statements.length() == 0
											and arm_integer_is(arm, 7, 48, 49)
										)
									_:
										accepted = False
							_:
								accepted = False
					_:
						accepted = False

	accepted


pure func test_arm_block_spaces_and_following_declaration() -> Bool:
	source: String =
		|func f(value: V) -> Int:
		|    match value:
		|        A:
		|            x = 7
		|            x
		|        B: 0
		|func main() -> Int:
		|    0

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match root_functions(program):
				[first, second]:
					match first.body:
						ParsedMatchBody(body):
							match body.arms:
								[block, inline]:
									match block.block.statements:
										[BindingStatement(binding)]:
											(
												written_name_is(
													program.names,
													binding.name,
													"x",
													65,
													66,
												)
												and expression_integer_is(
													binding.initializer,
													7,
													69,
													70,
												)
												and arm_name_is(
													program.names,
													block,
													"x",
													83,
													84,
												)
												and inline.block.statements.length() == 0
												and arm_integer_is(inline, 0, 96, 97)
												and written_name_is(
													program.names,
													second.function_name,
													"main",
													103,
													107,
												)
												and program.end.start == 123
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


-- A block may end after a statement; it then has no value, which the
-- checker rejects for a tail-match arm. The parser accepts both shapes.
pure func test_arm_block_may_end_after_a_statement() -> Bool:
	(
		parse_source(MATCH_HEADER + "\t\tA:\n\t\t\tx = 1\n\t\tB: 0").is_ok()
		and parse_source(MATCH_HEADER + "\t\t_:\n\t\t\tx = 1").is_ok()
	)


pure func test_arm_block_requires_a_deeper_level() -> Bool:
	(
		rejects(MATCH_HEADER + "\t\t_:\n\t\t7", 46, 47, "expected an indented match arm result", ARM_RESULT_INDENT_HELP)
		and parse_source(MATCH_HEADER + "\t\t_:\n\t\t\t\t7").is_ok()
	)


pure func test_arm_block_may_nest_a_match() -> Bool:
	parse_source(MATCH_HEADER + "\t\t_:\n\t\t\tmatch value:\n\t\t\t\t_: 0").is_ok()


pure func test_arm_binding_value_on_the_next_line_must_be_indented() -> Bool:
	rejects(
		MATCH_HEADER + "\t\t_:\n\t\t\tx =\n\t\t\t0",
		54,
		55,
		"expected an indented value after '='",
		"put the value on the same line as '=', or alone on the next line indented one level",
	)


pure func test_function_type_parameter_list_preserves_order_and_spans() -> Bool:
	prefix = "pure func choose["

	match parse_source(prefix + "A, B, C](a:A,b:B,c:C)->C:\n\tc\n"):
		Ok(parsed):
			program = parsed_contents(parsed)

			match root_functions(program):
				[function]:
					match function.type_parameters:
						[first, second, third]:
							(
								written_name_is(
									program.names,
									first.name,
									"A",
									prefix.length(),
									prefix.length() + 1,
								)
								and written_name_is(
									program.names,
									second.name,
									"B",
									prefix.length() + 3,
									prefix.length() + 4,
								)
								and written_name_is(
									program.names,
									third.name,
									"C",
									prefix.length() + 6,
									prefix.length() + 7,
								)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_generic_parameter_name_and_annotation_spans() -> Bool:
	prefix = "pure func identity["

	match parse_source(prefix + "Element2](value: Element2) -> Element2:\n\tvalue\n"):
		Ok(program):
			contents = parsed_contents(program)

			match root_functions(contents):
				[function]:
					match function.type_parameters:
						[name]:
							written_name_is(
								contents.names,
								name.name,
								"Element2",
								prefix.length(),
								prefix.length() + 8,
							)
						_:
							False
				_:
					False
		_:
			False


private pure func rejects_marked(
	prefix: String,
	marked: String,
	suffix: String,
	message: String,
	help: String,
) -> Bool:
	rejects(
		prefix + marked + suffix,
		prefix.length(),
		prefix.length() + marked.length(),
		message,
		help,
	)


pure func test_generic_parameter_names_are_validated_by_parser() -> Bool:
	help = (
		"start with a capital ASCII letter and use only ASCII letters and digits, such "
		+ "as T or Element2"
	)
	(
		rejects_marked(
			"func f[",
			"t",
			"](value: t) -> t:\n\tvalue",
			"invalid type parameter name",
			help,
		)
		and rejects_marked(
			"func f[",
			"T_",
			"](value: T_) -> T_:\n\tvalue",
			"invalid type parameter name",
			help,
		)
	)


pure func test_generic_parameter_requires_one_name_and_closing_bracket() -> Bool:
	(
		rejects_marked(
			"func f[",
			"]",
			"() -> Int:\n\t0",
			"expected a type parameter name",
			"declare type parameters separated by commas, such as [A, B]",
		)
		and rejects_marked(
			"func f[T",
			"(",
			"value: T) -> T:\n\tvalue",
			"expected ',' or ']' after a type parameter",
			"separate type parameters with commas and close the list with ']'",
		)
		and rejects_marked(
			"func f[T ",
			"U",
			"](value: T) -> T:\n\tvalue",
			"expected ',' or ']' after a type parameter",
			"separate type parameters with commas and close the list with ']'",
		)
	)


pure func test_explicit_function_type_arguments_are_rejected() -> Bool:
	(
		rejects_marked(
			HEADER + "\tidentity",
			"[",
			"Int](7)",
			"explicit function type arguments are unsupported",
			"omit the brackets at calls; argument types determine the type parameters",
		)
		and rejects_marked(
			HEADER + "\t7.identity",
			"[",
			"Int]()",
			"explicit function type arguments are unsupported",
			"omit the brackets at calls; argument types determine the type parameters",
		)
	)


private pure func applied_type_is(
	names: NameTable,
	value: TypeSyntax,
	argument_spelling: String,
	start: Int,
	end: Int,
	argument_start: Int,
	argument_end: Int,
) -> Bool:
	match value:
		AppliedType(owner, [AtomicType(argument)], span):
			(
				written_name_is(names, owner, "Box", start, start + 3)
				and written_name_is(
					names,
					argument,
					argument_spelling,
					argument_start,
					argument_end,
				)
				and span.start == start
				and span.end == end
			)
		AtomicType(_) | AppliedType(_, _, _) | QualifiedType(_, _, _) | CallableTypeSyntax(_, _, _, _) | TupleTypeSyntax(_, _):
			False


pure func test_generic_union_and_atomic_application_spans() -> Bool:
	source: String =
		|union Box [ T ]:
		|	Box(T)
		|pure func keep[T](value: Box [ T ]) -> Box[Int]:
		|	value
		|

	match parse_source(source):
		Ok(parsed):
			program = parsed_contents(parsed)

			match root_unions(program):
				[declaration]:
					match declaration.type_parameters:
						[parameter]:
							match declaration.variants.map(pure func(row): row.declaration):
								[variant]:
									match variant.fields:
										[AtomicType(payload)]:
											match root_functions(program):
												[function]:
													match function.parameters:
														[value]:
															(
																written_name_is(
																	program.names,
																	declaration.type_name,
																	"Box",
																	12,
																	15,
																)
																and written_name_is(
																	program.names,
																	parameter,
																	"T",
																	18,
																	19,
																)
																and written_name_is(
																	program.names,
																	payload,
																	"T",
																	28,
																	29,
																)
																and applied_type_is(
																	program.names,
																	value.type_name,
																	"T",
																	56,
																	65,
																	62,
																	63,
																)
																and applied_return_type_is(
																	program.names,
																	function.return_type,
																	"Int",
																	70,
																	78,
																	74,
																	77,
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_written_nested_applications_parse() -> Bool:
	parse_source("func f(value: Box[Box[Int]]) -> Int:\n\t0").is_ok()


pure func test_nested_application_requires_its_inner_closing_bracket() -> Bool:
	rejects_marked(
		"func f(value: Box[Box[Int",
		")",
		" -> Int:\n\t0",
		"expected ']' after the type arguments",
		"write comma-separated type arguments, such as Result[Box[Int], Int]",
	)


pure func test_written_application_requires_nonempty_comma_separated_arguments() -> Bool:
	(
		rejects_marked(
			"func f(value: Box[",
			"]",
			") -> Int:\n\t0",
			"expected a type argument",
			IDENTIFIER_HELP,
		)
		and rejects_marked(
			"func f(value: Box[Int ",
			"String",
			"]) -> Int:\n\t0",
			"expected ']' after the type arguments",
			"write comma-separated type arguments, such as Result[Box[Int], Int]",
		)
		and rejects_marked(
			"union Box[",
			"t",
			"]:\n\tValue",
			"invalid type parameter name",
			(
				"start with a capital ASCII letter and use only ASCII letters and digits, such "
				+ "as T or Element2"
			),
		)
	)


pure func test_multiple_union_parameters_and_arguments_preserve_order_and_spans() -> Bool:
	declarations: String =
		|union Result[T, E]:
		|	Ok(T)
		|	Err(E)
		|
	prefix = declarations + "func read(value:"

	match parse_source(prefix + "Result[Int, String])->Int:\n\t0"):
		Ok(parsed):
			program = parsed_contents(parsed)

			match (root_unions(program), root_functions(program)):
				([declaration], [function]):
					match (declaration.type_parameters, function.parameters):
						([t, e], [parameter]):
							match parameter.type_name:
								AppliedType(head, [AtomicType(integer), AtomicType(text)], whole):
									(
										written_name_is(program.names, t, "T", 19, 20)
										and written_name_is(program.names, e, "E", 22, 23)
										and written_name_is(
											program.names,
											head,
											"Result",
											prefix.length(),
											prefix.length() + 6,
										)
										and written_name_is(
											program.names,
											integer,
											"Int",
											prefix.length() + 7,
											prefix.length() + 10,
										)
										and written_name_is(
											program.names,
											text,
											"String",
											prefix.length() + 12,
											prefix.length() + 18,
										)
										and whole.start == prefix.length()
										and whole.end == prefix.length() + 19
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_recursive_calls_use_ordinary_call_syntax() -> Bool:
	source: String =
		|pure func first[T](value: T) -> T:
		|	value.second()
		|pure func second[U](value: U) -> U:
		|	first(value)
		|func main() -> Int:
		|	first(7)
		|
	parse_source(source).is_ok()


pure func test_builtin_is_reserved_and_is_the_entire_body() -> Bool:
	source: String =
		|pure func add(first: Int, second: Int) -> Int:
		|    builtin("int.add")
		|func main() -> Int:
		|    add(20, 22)
		|

	accepted = match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			match root_functions(parsed_contents(parsed)):
				[added, main]:
					match (added.body, main.body):
						(ParsedBuiltinBody(IntegerAddBuiltin, _), ParsedValueBody(_)):
							True
						_:
							False
				_:
					False
	reserved = (
		rejects_keyword("pure func builtin(first: Int) -> Int:\n    first\n", 10, 17, "builtin")
		and rejects(
			"func main() -> Int:\n    builtin(20, 22)\n",
			32,
			34,
			"expected a quoted builtin label",
			BUILTIN_LABEL_HELP,
		)
	)

	with_binding: String =
		|pure func add(first: Int, second: Int) -> Int:
		|    local = first
		|    builtin("int.add")
		|
	start = "pure func add(first: Int, second: Int) -> Int:\n    local = first\n    ".length()
	accepted and reserved and rejects(
		with_binding,
		start,
		start + "builtin".length(),
		"builtin must be the entire function body",
		(
			"use builtin as the entire function body; put other work in an ordinary wrapper "
			+ "function"
		),
	)


-- A match before further lines is a statement; a line at the match's own
-- indentation is never one of its arms.
pure func test_match_before_further_lines_is_a_statement() -> Bool:
	(
		parse_source(MATCH_HEADER + "\t\t_: 0\n\t1").is_ok()
		and rejects(MATCH_HEADER + "\t\tEmpty: 0\n\tNumber(n): n", 60, 61, "expected a newline after the return expression", "put each declaration on a new line")
	)


pure func test_lines_that_open_no_block_cannot_be_indented() -> Bool:
	help = "indent a line only to open the block of a header ending in ':'; otherwise align it with the line above"
	(
		rejects(HEADER + "\tvalue = 1\n\t\tvalue", 31, 33, "unexpected indentation", help)
		and rejects("union V:\n\tA\n\t\tB", 12, 14, "unexpected indentation", help)
	)


pure func test_binding_line_ends_after_its_initializer() -> Bool:
	rejects(HEADER + "\tvalue = 1 2\n\tvalue", 31, 32, "expected a newline after the binding", "put each statement on its own line")


pure func test_equality_symbols_follow_the_comparison_production() -> Bool:
	match parse_source(HEADER + "\t7!=9\n"):
		Err(_): False
		Ok(parsed):
			match root_functions(parsed_contents(parsed)):
				[function]:
					match function.body:
						ParsedValueBody(value):
							match value.base:
								ComparisonExpression(NotEqualOperator, operator, left, right):
									(
										operator.start == 22 and operator.end == 24
										and expression_integer_is(left, 7, 21, 22)
										and expression_integer_is(right, 9, 24, 25)
									)
								_: False
						_: False
				_: False


pure func test_comparison_production_rejects_a_second_symbol() -> Bool:
	rejects(
		HEADER + "\t7==7!=9\n", 25, 27,
		"comparisons cannot be chained",
		"compare each pair separately, or parenthesize an intended nested comparison",
	)


