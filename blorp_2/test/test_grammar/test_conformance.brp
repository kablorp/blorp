-- Trace lexical call occurrences in evaluation order. The recursive tree is
-- checked directly by the multiple-argument phase tests; these older unary
-- examples pin names, receiver-call status and exact written spans independently of shape.
private record CallOccurrence {
	callee: WrittenName,
	receiver_call: Bool
}


-- Whether the root function's body is a range expression.
private pure func main_is_range(source: String) -> Bool:
	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			match root_functions(parsed_contents(parsed)).get(0).map(pure func(function): function.body):
				Some(ParsedValueBody(value)):
					match value.base:
						RangeExpression(_, _):
							True
						_:
							False
				_:
					False


-- Arm readers: an arm's value when its block ends with one.
private pure func arm_base(arm: ParsedMatchArm) -> Option[ExpressionBase]:
	arm.block.value.map(pure func(value): first_base(value))


private pure func arm_calls(arm: ParsedMatchArm) -> List[CallOccurrence]:
	match arm.block.value:
		Some(value):
			call_occurrences(value)
		None:
			[]


private pure func arm_value_start(arm: ParsedMatchArm) -> Option[Int]:
	arm.block.value.map(pure func(value): value.span.start)


private pure func arm_value_end(arm: ParsedMatchArm) -> Option[Int]:
	arm.block.value.map(pure func(value): value.span.end)


private pure func arm_name_is(names: NameTable, arm: ParsedMatchArm, spelling: String, start: Int, end: Int) -> Bool:
	match arm.block.value:
		Some(value):
			expression_name_is(names, value, spelling, start, end)
		None:
			False


private pure func arm_integer_is(arm: ParsedMatchArm, expected: Int, start: Int, end: Int) -> Bool:
	match arm.block.value:
		Some(value):
			expression_integer_is(value, expected, start, end)
		None:
			False


private pure func first_base(value: ValueExpression) -> ExpressionBase:
	match value.base:
		DirectApplication(_, [argument]):
			first_base(argument)
		_:
			value.base


private pure func call_occurrences(value: ValueExpression) -> List[CallOccurrence]:
	var calls: List[CallOccurrence] = []

	match value.base:
		TupleExpression(elements):
			for element in elements:
				calls = calls.concat(call_occurrences(element))
		DirectApplication(name, arguments):
			for argument in arguments:
				calls = calls.concat(call_occurrences(argument))

			if arguments.length() > 0:
				calls = calls.append({
					callee = name,
					receiver_call = False,
				})
		_:
			void

	for postfix in value.applications:
		match postfix:
			ReceiverInvocation(application):
				for argument in application.arguments:
					calls = calls.concat(call_occurrences(argument))

				calls = calls.append({
					callee = application.callee,
					receiver_call = True,
				})
			TupleIndex(index, _):
				calls = calls.concat(call_occurrences(index))
			FieldAccess(_):
				void

	calls


private pure func return_type_is(
	names: NameTable,
	value: Option[TypeSyntax],
	spelling: String,
	start: Int,
	end: Int,
) -> Bool:
	match value:
		Some(written): written_type_is(names, written, spelling, start, end)
		None: False


private pure func applied_return_type_is(
	names: NameTable,
	value: Option[TypeSyntax],
	argument_spelling: String,
	start: Int,
	end: Int,
	argument_start: Int,
	argument_end: Int,
) -> Bool:
	match value:
		Some(written): applied_type_is(names, written, argument_spelling, start, end, argument_start, argument_end)
		None: False
