pure func test_arm_block_bindings_and_inline_sibling_spans() -> Bool:
	source = MATCH_HEADER + "\t\tA:\n\t\t\tvar current = value\n\t\t\toriginal = current\n\t\t\tcurrent = 42\n\t\t\toriginal\n\t\tB: 0"

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match function.body:
						ParsedMatchBody(body):
							match body.arms:
								[first, second]:
									match first.bindings:
										[current, original, reassigned]:
											(
												current.mutability == MutableBinding
												and written_name_is(
													program.names,
													current.name,
													"current",
													51,
													58,
												)
												and expression_name_is(
													program.names,
													current.initializer,
													"value",
													61,
													66,
												)
												and original.mutability == ImmutableBinding
												and written_name_is(
													program.names,
													original.name,
													"original",
													70,
													78,
												)
												and expression_name_is(
													program.names,
													original.initializer,
													"current",
													81,
													88,
												)
												and reassigned.mutability == ImmutableBinding
												and written_name_is(
													program.names,
													reassigned.name,
													"current",
													92,
													99,
												)
												and expression_integer_is(
													reassigned.initializer,
													42,
													102,
													104,
												)
												and expression_name_is(
													program.names,
													first.body,
													"original",
													108,
													116,
												)
												and first.span.start == 41
												and first.span.end == 116
												and second.bindings.length() == 0
												and second.span.start == 119
												and second.span.end == 123
												and expression_integer_is(second.body, 0, 122, 123)
												and body.span.end == 123
												and program.end.start == 123
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_block_without_bindings_and_optional_final_lf() -> Bool:
	var accepted = True

	for suffix in ["", "\n"]:
		match parse_source(MATCH_HEADER + "\t\t_: \n\t\t\t7" + suffix):
			Err(_):
				accepted = False
			Ok(parsed):
				match parsed_contents(parsed).functions:
					[function]:
						match function.body:
							ParsedMatchBody(body):
								match body.arms:
									[arm]:
										accepted = (
											accepted
											and arm.bindings.length() == 0
											and expression_integer_is(arm.body, 7, 48, 49)
										)
									_:
										accepted = False
							_:
								accepted = False
					_:
						accepted = False

	accepted


pure func test_arm_block_spaces_and_following_declaration() -> Bool:
	source = "func f(value: V) -> Int:\n    match value:\n        A:\n            x = 7\n            x\n        B: 0\nfunc main() -> Int:\n    0"

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[first, second]:
					match first.body:
						ParsedMatchBody(body):
							match body.arms:
								[block, inline]:
									match block.bindings:
										[binding]:
											(
												written_name_is(
													program.names,
													binding.name,
													"x",
													65,
													66,
												)
												and expression_integer_is(
													binding.initializer,
													7,
													69,
													70,
												)
												and expression_name_is(
													program.names,
													block.body,
													"x",
													83,
													84,
												)
												and inline.bindings.length() == 0
												and expression_integer_is(inline.body, 0, 96, 97)
												and written_name_is(
													program.names,
													second.function_name,
													"main",
													103,
													107,
												)
												and program.end.start == 123
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


