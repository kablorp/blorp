		and rejects_marked(
			"fixed union Box[",
			"t",
			"]:\n\tValue",
			"invalid type parameter name",
			(
				"start with a capital ASCII letter and use only ASCII letters and digits, such "
				+ "as T or Element2"
			),
		)
	)


pure func test_multiple_union_parameters_and_arguments_preserve_order_and_spans() -> Bool:
	declarations = "fixed union Result[T, E]:\n\tOk(T)\n\tErr(E)\n"
	prefix = declarations + "func read(value:"

	match parse_source(prefix + "Result[Int, String])->Int:\n\t0"):
		Ok(parsed):
			program = parsed_contents(parsed)

			match (program.unions, program.functions):
				([declaration], [function]):
					match (declaration.type_parameters, function.parameters):
						([t, e], [parameter]):
							match parameter.type_name:
								AppliedType(head, [integer, text], whole):
									(
										written_name_is(program.names, t, "T", 19, 20)
										and written_name_is(program.names, e, "E", 22, 23)
										and written_name_is(
											program.names,
											head,
											"Result",
											prefix.length(),
											prefix.length() + 6,
										)
										and written_name_is(
											program.names,
											integer,
											"Int",
											prefix.length() + 7,
											prefix.length() + 10,
										)
										and written_name_is(
											program.names,
											text,
											"String",
											prefix.length() + 12,
											prefix.length() + 18,
										)
										and whole.start == prefix.length()
										and whole.end == prefix.length() + 19
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


