			27,
			28,
			"expected a function declaration at column 1",
			"start with func main() -> Int:",
		)
	)


private pure func value_union_shape(names: NameTable, declaration: ParsedUnion) -> Bool:
	match declaration.variants:
		[empty, number]:
			match empty.payload:
				NoPayloadSyntax:
					match number.payload:
						OnePayloadSyntax(type_name):
							(
								written_name_is(names, declaration.type_name, "Value", 12, 17)
								and written_name_is(names, empty.name, "Empty", 20, 25)
								and written_name_is(names, number.name, "Number", 27, 33)
								and written_name_is(names, type_name, "Int", 34, 37)
							)
						_:
							False
				_:
					False
		_:
			False


private pure func unwrap_match_shape(names: NameTable, body: ParsedMatch) -> Bool:
	match body.arms:
		[empty, number]:
			match empty.pattern:
				PatternName(empty_name):
					match number.pattern:
						PatternConstructor(number_name, OnePatternField(FieldName(field)), span):
							match empty.body.base:
								IntegerExpression(0):
									(
										expression_name_is(names, body.scrutinee, "value", 85, 90)
										and body.span.start == 79
										and body.span.end == 127
										and body.keyword_span.start == 79
										and body.keyword_span.end == 84
										and written_name_is(names, empty_name, "Empty", 94, 99)
										and empty.span.start == 94
										and empty.span.end == 102
										and empty.body.span.start == 101
										and empty.body.span.end == 102
										and empty.body.applications.length() == 0
										and written_name_is(names, number_name, "Number", 105, 111)
										and written_name_is(names, field, "number", 112, 118)
										and span.start == 105
										and span.end == 119
										and number.span.start == 105
										and number.span.end == 127
										and expression_name_is(
											names,
											number.body,
											"number",
											121,
											127,
										)
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func unwrap_function_shape(names: NameTable, function: ParsedFunction) -> Bool:
	match function.parameters:
		SingleParameter(parameter):
			match function.body:
				ParsedMatchBody(body):
					(
						unwrap_match_shape(names, body)
						and function.purity == Pure
						and written_name_is(names, function.function_name, "unwrap", 49, 55)
						and written_name_is(names, parameter.name, "value", 56, 61)
						and written_name_is(names, parameter.type_name, "Value", 63, 68)
						and written_name_is(names, function.return_type, "Int", 73, 76)
					)
				_:
					False
		_:
			False


private pure func constructed_main_shape(names: NameTable, function: ParsedFunction) -> Bool:
	no_parameters: Bool = match function.parameters:
		EmptyParameters:
			True
		SingleParameter(_):
			False

	match function.body:
		ParsedValueBody(body):
			match body.base:
				IntegerExpression(42):
					match body.applications:
						[number, call]:
							(
								function.purity == Impure
								and no_parameters
								and written_name_is(names, function.function_name, "main", 133, 137)
								and written_name_is(names, function.return_type, "Int", 143, 146)
								and body.span.start == 149
								and body.span.end == 167
								and written_name_is(names, number.callee, "Number", 156, 162)
								and number.notation == DirectCall
								and written_name_is(names, call.callee, "unwrap", 149, 155)
								and call.notation == DirectCall
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_payload_and_match_syntax() -> Bool:
	match parse_source(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func unwrap(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty: 0\n\t\tNumber(number): number\nfunc main() -> Int:\n\tunwrap(Number(42))\n",
	):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.unions:
				[declaration]:
					match program.functions:
						[unwrap, main_function]:
							(
								value_union_shape(program.names, declaration)
								and unwrap_function_shape(program.names, unwrap)
								and constructed_main_shape(program.names, main_function)
								and program.end.start == 168
								and program.end.end == 168
							)
						_:
							False
				_:
					False


private pure func spaced_union_shape(names: NameTable, declaration: ParsedUnion) -> Bool:
	match declaration.variants:
		[empty, number]:
			match empty.payload:
				NoPayloadSyntax:
					match number.payload:
						OnePayloadSyntax(type_name):
							(
								written_name_is(names, declaration.type_name, "V", 148, 149)
								and written_name_is(names, empty.name, "Empty", 155, 160)
								and written_name_is(names, number.name, "Number", 165, 171)
								and written_name_is(names, type_name, "Float", 174, 179)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_pattern_alternatives_space_layout_and_following_union() -> Bool:
	match parse_source(
		"func f(value:V)->Int:\n    match value : \n        Empty ( ) : zero(1).identity() \n        Number ( _ ) : 2\n        whole: 3\n        _: 4\nfixed union V:\n    Empty\n    Number ( Float ) ",
	):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			union_ok: Bool = match program.unions:
				[declaration]:
					spaced_union_shape(program.names, declaration)
				_:
					False

			match program.functions:
				[function]:
					header_ok: Bool = match function.parameters:
						SingleParameter(parameter):
							(
								function.purity == Impure
								and written_name_is(
									program.names,
									function.function_name,
									"f",
									5,
									6,
								)
								and written_name_is(program.names, parameter.name, "value", 7, 12)
								and written_name_is(program.names, parameter.type_name, "V", 13, 14)
								and written_name_is(
									program.names,
									function.return_type,
									"Int",
									17,
									20,
								)
							)
						_:
							False

					match function.body:
						ParsedMatchBody(body):
							match body.arms:
								[empty, number, whole, wildcard]:
									empty_body_ok: Bool = match empty.body.base:
										IntegerExpression(1):
											match empty.body.applications:
												[zero, identity]:
													(
														written_name_is(
															program.names,
															zero.callee,
															"zero",
															61,
															65,
														)
														and zero.notation == DirectCall
														and written_name_is(
															program.names,
															identity.callee,
															"identity",
															69,
															77,
														)
														and identity.notation == ReceiverCall
														and empty.body.span.start == 61
														and empty.body.span.end == 79
													)
												_:
													False
										_:
											False

									empty_ok: Bool = match empty.pattern:
										PatternConstructor(name, NoPatternFields, span):
											(
												written_name_is(
													program.names,
													name,
													"Empty",
													49,
													54,
												)
												and span.start == 49
												and span.end == 58
											)
										_:
											False

									number_ok: Bool = match number.pattern:
										PatternConstructor(name, OnePatternField(FieldWildcard(field)), span):
											(
												written_name_is(
													program.names,
													name,
													"Number",
													89,
													95,
												)
												and field.start == 98
												and field.end == 99
												and span.start == 89
												and span.end == 101
											)
										_:
											False

									whole_ok: Bool = match whole.pattern:
										PatternName(name):
											written_name_is(program.names, name, "whole", 114, 119)
										_:
											False

									wildcard_ok: Bool = match wildcard.pattern:
										PatternWildcard(span):
											span.start == 131 and span.end == 132
										_:
											False

									(
										header_ok
										and empty_ok
										and number_ok
										and whole_ok
										and wildcard_ok
										and empty_body_ok
										and expression_integer_is(number.body, 2, 104, 105)
										and expression_integer_is(whole.body, 3, 121, 122)
										and expression_integer_is(wildcard.body, 4, 134, 135)
										and expression_name_is(
											program.names,
											body.scrutinee,
											"value",
											32,
											37,
										)
										and body.span.start == 26
										and body.span.end == 135
										and body.keyword_span.start == 26
										and body.keyword_span.end == 31
										and empty.span.start == 49
										and empty.span.end == 79
										and number.span.start == 89
										and number.span.end == 105
										and whole.span.start == 114
										and whole.span.end == 122
										and wildcard.span.start == 131
										and wildcard.span.end == 135
										and union_ok
										and program.end.start == 182
										and program.end.end == 182
									)
								_:
									False
						_:
							False
				_:
					False


private pure func single_wildcard_match_is(source: String, eof: Int) -> Bool:
	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match function.parameters:
						SingleParameter(parameter):
							match function.body:
								ParsedMatchBody(body):
									match body.arms:
										[arm]:
											match arm.pattern:
												PatternWildcard(span):
													(
														function.purity == Impure
														and written_name_is(
															program.names,
															function.function_name,
															"f",
															5,
															6,
														)
														and written_name_is(
															program.names,
															parameter.name,
															"value",
															7,
															12,
														)
														and written_name_is(
															program.names,
															parameter.type_name,
															"V",
															14,
															15,
														)
														and written_name_is(
															program.names,
															function.return_type,
															"Int",
															20,
															23,
														)
														and expression_name_is(
															program.names,
															body.scrutinee,
															"value",
															32,
															37,
														)
														and body.span.start == 26
														and body.span.end == 45
														and body.keyword_span.start == 26
														and body.keyword_span.end == 31
														and span.start == 41
														and span.end == 42
														and arm.span.start == 41
														and arm.span.end == 45
														and expression_integer_is(
															arm.body,
															1,
															44,
															45,
														)
														and program.unions.length() == 0
														and program.end.start == eof
														and program.end.end == eof
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_match_one_arm_and_optional_final_lf() -> Bool:
	(
		single_wildcard_match_is(MATCH_HEADER + "\t\t_: 1", 45)
		and single_wildcard_match_is(MATCH_HEADER + "\t\t_: 1\n", 46)
	)


pure func test_match_and_wildcard_are_reserved_in_name_contexts() -> Bool:
	(
		rejects_identifier("func _() -> Int:\n\t0", 5, 6, "expected a function name")
		and rejects_identifier("func match() -> Int:\n\t0", 5, 10, "expected a function name")
		and rejects_identifier("func main() -> _:\n\t0", 15, 16, "expected a return type")
		and rejects_identifier("func main() -> match:\n\t0", 15, 20, "expected a return type")
		and rejects_identifier(
			"func f(_: Int) -> Int:\n\t0",
			7,
			8,
			"expected a parameter name or ')'",
		)
		and rejects_identifier(
			"func f(match: Int) -> Int:\n\t0",
			7,
			12,
			"expected a parameter name or ')'",
		)
		and rejects_identifier("func f(x: _) -> Int:\n\t0", 10, 11, "expected a parameter type")
		and rejects_identifier("func f(x: match) -> Int:\n\t0", 10, 15, "expected a parameter type")
		and rejects_identifier("fixed union _:\n\tA", 12, 13, "expected a union type name")
		and rejects_identifier("fixed union match:\n\tA", 12, 17, "expected a union type name")
		and rejects_identifier("fixed union V:\n\t_", 16, 17, "expected a union variant name")
		and rejects_identifier("fixed union V:\n\tmatch", 16, 21, "expected a union variant name")
		and rejects_identifier("fixed union V:\n\tNumber(_)", 23, 24, "expected a payload type")
		and rejects_identifier("fixed union V:\n\tNumber(match)", 23, 28, "expected a payload type")
		and rejects_identifier(HEADER + "\t1._()", 23, 24, "expected a function name after '.'")
		and rejects_identifier(HEADER + "\t1.match()", 23, 28, "expected a function name after '.'")
		and rejects_identifier(MATCH_HEADER + "\t\tmatch: 1", 41, 46, "expected a match pattern")
		and rejects_identifier(
			MATCH_HEADER + "\t\tNumber(match): 1",
			48,
			53,
			"expected an Int field binding or '_'",
		)
		and accepts("func matchx()->_t:\n\t0", "matchx", 5, 11, "_t", 15, 17)
	)


pure func test_match_header_requires_scrutinee_colon_and_lf() -> Bool:
	(
		rejects(
			"fixed union Value:\n\tEmpty\npure func make(value: Int) -> Value:\n\tEmpty\nfunc main() -> Int:\n\tmatch-1.make():\n\t\t_: 0\n",
