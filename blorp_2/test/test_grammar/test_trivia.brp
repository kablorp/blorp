import:
	../../src/source: module_source, root_module_id, same_module
	../../src/lex: lex
	../../src/names: program_names
	../../src/parse: ParsedProgram, ParsedContents, parse_module, parsed_contents as program_contents
	../../src/syntax: Diagnostic
	../unit/input: parse
	test: TestSuite


-- Observe root declarations while the ordinary test prelude remains in the inventory.
private pure func root_contents(program: ParsedProgram) -> ParsedContents:
	contents = program_contents(program)
	{ contents |
		functions = contents.functions.filter(pure func(row): same_module(row.module, root_module_id())),
		unions = contents.unions.filter(pure func(row): same_module(row.module, root_module_id())),
		records = contents.records.filter(pure func(row): same_module(row.module, root_module_id())),
	}


private pure func parse_source(source: String) -> Result[ParsedProgram, Diagnostic]:
	lex(module_source(root_module_id()), source).and_then(pure func(tokens): parse(tokens))


private pure func rejects(
	source: String,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match parse_source(source):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == start
				and error.span.end == end
				and error.message == message
				and error.help == help
				and error.note.is_none()
			)


pure func test_blank_and_comment_lines_surround_real_main() -> Bool:
	source: String =
		|
		|-- leading comment
		|
		|func main() -> Int: -- header
		|-- shallow comment inside body
		|
		|    0 -- return
		|
		|-- final comment
	parse_source(source).is_ok()


pure func test_trivia_is_transparent_across_all_block_depths() -> Bool:
	source: String =
		|fixed union Choice: -- union header
		|    -- before first variant
		|
		|    First -- first variant
		|-- between variants
		|    Second
		|
		|fixed record Pair { value: Int } -- record declaration
		|
		|pure func choose(value: Choice) -> Int:
		|    var saved = 0 -- binding
		|        -- comment is deeper than the binding
		|
		|    match value: -- match header
		|-- comment is shallower than the arm
		|        First: -- block arm header
		|
		|            saved = 1 -- assignment
		|    -- comment is shallower than the arm block
		|            saved -- block result
		|
		|        Second: 0 -- inline arm
		|
		|func main() -> Int:
		|    choose(First)
		|

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = root_contents(parsed)
			(
				program.functions.length() == 2
				and program.unions.length() == 1
				and program.records.length() == 1
			)


pure func test_annotation_associates_across_trivia() -> Bool:
	source: String =
		|@tail_recursive -- annotation
		|
		|  	-- incidental mixed indentation
		|pure func again() -> Int:
		|    again()
		|

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			match root_contents(parsed).functions:
				[function]:
					match function.tail_annotation:
						Some(span):
							span.start == 0 and span.end == 15
						None:
							False
				_:
					False


pure func test_builtin_module_uses_the_same_trivia_rules() -> Bool:
	source: String =
		|
		|-- builtin declaration
		|type Int = builtin -- Int
		|
		|type String = builtin
		|type Float = builtin
		|type Void = builtin
		|-- function separator
		|pure func to_string(value: Int) -> String: -- function
		|    -- runtime body
		|    builtin("int.to_string") -- operation
		|
	lex(module_source(root_module_id()), source)
		.and_then(pure func(tokens): parse_module(tokens, root_module_id(), program_names().names))
		.is_ok()


pure func test_builtin_module_requires_real_line_separators() -> Bool:
	match lex(
		module_source(root_module_id()),
		"type Int = builtin type String = builtin",
	).and_then(
		pure func(tokens): parse_module(tokens, root_module_id(), program_names().names),
	):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == 19
				and error.span.end == 23
				and error.message == "expected a newline after the return expression"
				and error.help == "put each declaration on a new line"
				and error.note.is_none()
			)


pure func test_trivia_does_not_supply_a_required_body() -> Bool:
	rejects(
		"func main() -> Int:\n--x\n \t\n",
		27,
		27,
		"expected an indent of one tab or four spaces",
		"indent the body with exactly one tab or four spaces",
	)


pure func test_comment_only_module_has_no_declarations() -> Bool:
	match parse_source("--\n \t\n"):
		Err(_): False
		Ok(parsed):
			contents = root_contents(parsed)
			contents.functions.length() == 0 and contents.unions.length() == 0 and contents.records.length() == 0


pure func test_trivia_does_not_supply_a_union_variant() -> Bool:
	rejects(
		"fixed union Empty:\n--\n",
		22,
		22,
		"expected an indented union variant",
		"declare at least one variant, indented with one tab or four spaces",
	)


pure func test_annotation_trivia_still_requires_a_function() -> Bool:
	rejects(
		"@tail_recursive\n--\n",
		0,
		15,
		"@tail_recursive has no function declaration",
		"put a function declaration immediately after @tail_recursive",
	)


pure func test_comment_cannot_continue_an_expression() -> Bool:
	rejects(
		"func main() -> Int:\n    one(-- argument\n    0)\n",
		39,
		40,
		"expected a return expression",
		"use a literal, a parameter or variant name, or a call as the entire body",
	)


pure func test_following_real_dedent_starts_a_new_declaration() -> Bool:
	source: String =
		|func first() -> Int:
		|    1
		|            -- deep comment after first body
		|
		|func main() -> Int:
		|    first()
		|

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			root_contents(parsed).functions.length() == 2


tests: TestSuite = {
	description = "Restricted lexical trivia grammar",
	tests = [
		("blank and comment lines around main", test_blank_and_comment_lines_surround_real_main),
		(
			"trivia across declarations and block depths",
			test_trivia_is_transparent_across_all_block_depths,
		),
		("annotation associates across trivia", test_annotation_associates_across_trivia),
		("builtin modules share the trivia rules", test_builtin_module_uses_the_same_trivia_rules),
		("builtin modules need real line separators", test_builtin_module_requires_real_line_separators),
		("trivia cannot supply a required body", test_trivia_does_not_supply_a_required_body),
		("comment-only module is empty", test_comment_only_module_has_no_declarations),
		("trivia cannot supply a union variant", test_trivia_does_not_supply_a_union_variant),
		(
			"annotation trivia still needs a function",
			test_annotation_trivia_still_requires_a_function,
		),
		("comment cannot continue an expression", test_comment_cannot_continue_an_expression),
		("real dedent after deep comment", test_following_real_dedent_starts_a_new_declaration),
	]
}
