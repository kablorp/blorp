import:
	../../src/utils/source: module_source, root_module_id, same_module
	../../src/lex/lex: lex
	../../src/utils/names: program_names
	../../src/parse/assemble: ParsedProgram, ParsedContents, parsed_contents as program_contents
	../../src/utils/ids: FunctionRow, RecordRow, UnionRow, inventory_functions, inventory_records, inventory_unions
	../../src/parse/parse: parse_module
	../../src/utils/syntax: Diagnostic
	../unit/input: parse
	test: TestSuite


-- Root projections leave the complete parsed inventory unchanged.
private pure func root_functions(contents: ParsedContents) -> List[FunctionRow]:
	inventory_functions(contents.declarations).filter(pure func(row): same_module(row.declaration.module, root_module_id()))


private pure func root_unions(contents: ParsedContents) -> List[UnionRow]:
	inventory_unions(contents.declarations).filter(pure func(row): same_module(row.module, root_module_id()))


private pure func root_records(contents: ParsedContents) -> List[RecordRow]:
	inventory_records(contents.declarations).filter(pure func(row): same_module(row.declaration.module, root_module_id()))


private pure func parse_source(source: String) -> Result[ParsedProgram, Diagnostic]:
	lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens))


private pure func rejects(
	source: String,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match parse_source(source):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == start
				and error.span.end == end
				and error.message == message
				and error.help == help
				and error.note.is_none()
			)


pure func test_blank_and_comment_lines_surround_real_main() -> Bool:
	source: String =
		|
		|-- leading comment
		|
		|func main() -> Int: -- header
		|-- shallow comment inside body
		|
		|    0 -- return
		|
		|-- final comment
	parse_source(source).is_ok()


pure func test_trivia_is_transparent_across_all_block_depths() -> Bool:
	source: String =
		|fixed union Choice: -- union header
		|    -- before first variant
		|
		|    First -- first variant
		|-- between variants
		|    Second
		|
		|fixed record Pair { value: Int } -- record declaration
		|
		|pure func choose(value: Choice) -> Int:
		|    var saved = 0 -- binding
		|        -- comment is deeper than the binding
		|
		|    match value: -- match header
		|-- comment is shallower than the arm
		|        First: -- block arm header
		|
		|            saved = 1 -- assignment
		|    -- comment is shallower than the arm block
		|            saved -- block result
		|
		|        Second: 0 -- inline arm
		|
		|func main() -> Int:
		|    choose(First)
		|

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			program = program_contents(parsed)
			(
				root_functions(program).length() == 2
				and root_unions(program).length() == 1
				and root_records(program).length() == 1
			)


pure func test_annotation_associates_across_trivia() -> Bool:
	source: String =
		|@tail_recursive -- annotation
		|
		|  	-- incidental mixed indentation
		|pure func again() -> Int:
		|    again()
		|

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			match root_functions(program_contents(parsed)):
				[function]:
					match function.declaration.tail_annotation:
						Some(span):
							span.start == 0 and span.end == 15
						None:
							False
				_:
					False


pure func test_builtin_module_uses_the_same_trivia_rules() -> Bool:
	source: String =
		|
		|-- builtin declaration
		|type Int = builtin -- Int
		|
		|type String = builtin
		|type Float = builtin
		|type Void = builtin
		|-- function separator
		|pure func to_string(value: Int) -> String: -- function
		|    -- runtime body
		|    builtin("int.to_string") -- operation
		|
	lex(module_source(root_module_id()), source, program_names().names)
		.and_then(pure func(tokens): parse_module(tokens, root_module_id()))
		.is_ok()


pure func test_builtin_module_requires_real_line_separators() -> Bool:
	match lex(
		module_source(root_module_id()),
		"type Int = builtin type String = builtin",
		program_names().names,
	).and_then(
		pure func(tokens): parse_module(tokens, root_module_id()),
	):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == 19
				and error.span.end == 23
				and error.message == "expected a newline after the return expression"
				and error.help == "put each declaration on a new line"
				and error.note.is_none()
			)


pure func test_trivia_does_not_supply_a_required_body() -> Bool:
	rejects(
		"func main() -> Int:\n--x\n \t\n",
		27,
		27,
		"expected an indented block",
		"indent the lines of the block under its header",
	)


pure func test_comment_only_module_has_no_declarations() -> Bool:
	match parse_source("--\n \t\n"):
		Err(_): False
		Ok(parsed):
			contents = program_contents(parsed)
			root_functions(contents).length() == 0 and root_unions(contents).length() == 0 and root_records(contents).length() == 0


pure func test_trivia_does_not_supply_a_union_variant() -> Bool:
	rejects(
		"fixed union Empty:\n--\n",
		22,
		22,
		"expected an indented union variant",
		"declare at least one variant on an indented line",
	)


pure func test_annotation_trivia_still_requires_a_function() -> Bool:
	rejects(
		"@tail_recursive\n--\n",
		0,
		15,
		"@tail_recursive has no function declaration",
		"put a function declaration immediately after @tail_recursive",
	)


-- Inside an open bracket the comment and line break are trivia.
pure func test_comment_inside_brackets_does_not_end_the_call() -> Bool:
	source: String =
		|func main() -> Int:
		|    one(-- argument
		|    0)
		|

	parse_source(source).is_ok()


-- Outside brackets a comment ends the line, so a deeper next line that is
-- not a method chain is an indentation error at its prefix; a deeper `.`
-- line still continues the chain (host 4.2).
pure func test_comment_cannot_continue_an_expression_outside_brackets() -> Bool:
	method_source: String =
		|func main() -> Int:
		|    one -- argument
		|        .f()
		|

	(
		rejects(
			"func main() -> Int:\n    one -- argument\n        (1)\n",
			40,
			48,
			"unexpected indentation",
			"indent a line only to open the block of a header ending in ':'; otherwise align it with the line above",
		)
		and parse_source(method_source).is_ok()
	)


-- Documentation blocks are trivia before a declaration and inside a body.
pure func test_documentation_blocks_are_trivia() -> Bool:
	source: String =
		|---
		|Documents main.
		|---
		|func main() -> Int:
		|---
		|Documents nothing; the body continues.
		|---
		|    0
		|
	parse_source(source).is_ok()


pure func test_unterminated_documentation_block_has_exact_diagnostic() -> Bool:
	source: String =
		|---
		|Documents main.
		|func main() -> Int:
		|    0
		|

	rejects(
		source,
		0,
		3,
		"unterminated documentation block",
		"close the block with a line holding only --- at column 1",
	)


pure func test_following_real_dedent_starts_a_new_declaration() -> Bool:
	source: String =
		|func first() -> Int:
		|    1
		|            -- deep comment after first body
		|
		|func main() -> Int:
		|    first()
		|

	match parse_source(source):
		Err(_):
			False
		Ok(parsed):
			root_functions(program_contents(parsed)).length() == 2


tests: TestSuite = {
	description = "Restricted lexical trivia grammar",
	tests = [
		("blank and comment lines around main", test_blank_and_comment_lines_surround_real_main),
		(
			"trivia across declarations and block depths",
			test_trivia_is_transparent_across_all_block_depths,
		),
		("annotation associates across trivia", test_annotation_associates_across_trivia),
		("builtin modules share the trivia rules", test_builtin_module_uses_the_same_trivia_rules),
		("builtin modules need real line separators", test_builtin_module_requires_real_line_separators),
		("trivia cannot supply a required body", test_trivia_does_not_supply_a_required_body),
		("comment-only module is empty", test_comment_only_module_has_no_declarations),
		("trivia cannot supply a union variant", test_trivia_does_not_supply_a_union_variant),
		(
			"annotation trivia still needs a function",
			test_annotation_trivia_still_requires_a_function,
		),
		("documentation blocks are trivia", test_documentation_blocks_are_trivia),
		("unterminated documentation block has exact diagnostic", test_unterminated_documentation_block_has_exact_diagnostic),
		("comment inside brackets does not end the call", test_comment_inside_brackets_does_not_end_the_call),
		(
			"comment cannot continue an expression outside brackets",
			test_comment_cannot_continue_an_expression_outside_brackets,
		),
		("real dedent after deep comment", test_following_real_dedent_starts_a_new_declaration),
	]
}
