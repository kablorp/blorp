import:
	../../src/lex/lex: lex
	../../src/parse/parse: ParsedModule, parse_module
	../../src/utils/names: program_names
	../../src/utils/source: module_source, root_module_id
	../../src/utils/syntax: Diagnostic
	test: TestSuite


private pure func parse_source(source: String) -> Result[ParsedModule, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parse_module(tokens, root_module_id())


pure func test_propagation_is_a_function_statement() -> Bool:
	source: String =
		|func main() -> Int:
		|    value ?= Some(1)
		|    value
		|
	parse_source(source).is_ok()


pure func test_propagation_is_not_an_if_block_statement() -> Bool:
	source: String =
		|func main() -> Int:
		|    if True:
		|        value ?= Some(1)
		|    0
		|
	match parse_source(source):
		Err(error):
			(
				error.span.start == 47 and error.span.end == 49
				and error.message == "`?=` cannot be used inside an `if` or `match` block"
				and error.help == "match on the Result or Option in place, or move the block into its own function and use `?=` at its top"
			)
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 function-statement propagation grammar",
	tests = [
		("propagation is a function statement", test_propagation_is_a_function_statement),
		("propagation is not an if-block statement", test_propagation_is_not_an_if_block_statement),
	]
}
