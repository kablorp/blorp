import:
	./cost: CostLimits
	./harness: Example, NativeCase, argv_case, run_example
	test: TestSuite


-- Measured compiler costs plus 15% allocations and 18% retired instructions;
-- see benchmarks/results/blorp_2_join_2026-10-16.md.
private pure func limits(allocations: Int, instructions: Int) -> CostLimits:
	{
		allocations = allocations,
		instructions = instructions
	}


private pure func join_example(
	fixture: String,
	cost: CostLimits,
	first: NativeCase,
	remaining: List[NativeCase],
) -> Example:
	{
		name = "join: " + fixture,
		fixture = "blorp_2/test/e2e/fixtures/join/" + fixture + ".brp",
		expected_c = None,
		first_case = first,
		remaining_cases = remaining,
		limits = cost
	}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Bound and statement matches",
		tests = [
			("statement match carries its changed and untouched Int", func(): run_example(
				compiler,
				join_example(
					"carried_int",
					limits(30000, 150000000),
					argv_case("both arms", [], 0, "7\n1\n"),
					[],
				),
			)),
			("allocated alias survives the selected String reassignment", func(): run_example(
				compiler,
				join_example(
					"carried_string_alias",
					limits(30000, 150000000),
					argv_case("both arms", [], 0, "1\n777\n1\n1\n"),
					[],
				),
			)),
			("previously staged outer assignment returns its selected value", func(): run_example(
				compiler,
				join_example(
					"carried_existing",
					limits(30000, 150000000),
					argv_case("existing input", [], 1, ""),
					[],
				),
			)),
			("same-type carrier order follows bindings", func(): run_example(
				compiler,
				join_example(
					"carried_order",
					limits(30000, 150000000),
					argv_case("both arms", [], 0, "101\n202\n11\n22\n"),
					[],
				),
			)),
			("assignment target overrides the RHS carried map", func(): run_example(
				compiler,
				join_example(
					"carried_rhs",
					limits(30000, 150000000),
					argv_case("both arms", [], 0, "9\n3\n"),
					[],
				),
			)),
			("sixteen nested joins transfer the selected String carrier", func(): run_example(
				compiler,
				join_example(
					"carried_nested",
					limits(60000, 300000000),
					argv_case("four paths", [], 0, "7\n1\n1\n1\n"),
					[],
				),
			)),
			("result and carrier preserve duplicate String obligations", func(): run_example(
				compiler,
				join_example(
					"carried_duplicate",
					limits(30000, 150000000),
					argv_case("both arms", [], 0, "7\n7\n1\n1\n"),
					[],
				),
			)),
			("projected child survives its arm-local parent", func(): run_example(
				compiler,
				join_example(
					"carried_projected",
					limits(30000, 150000000),
					argv_case("both arms", [], 0, "1\n777\n1\n1\n"),
					[],
				),
			)),
			("String swap acquires both next owners before retiring old values", func(): run_example(
				compiler,
				join_example(
					"carried_swap",
					limits(30000, 150000000),
					argv_case("both arms", [], 0, "2\n1\n1\n2\n"),
					[],
				),
			)),
			("unused managed carrier cleans up and selected effects continue", func(): run_example(
				compiler,
				join_example(
					"carried_unused",
					limits(30000, 150000000),
					argv_case("both arms", [], 0, "true\nafter\nfalse\nafter\n"),
					[],
				),
			)),
			("bound match yields Int to the code after it", func(): run_example(
					compiler,
					join_example(
						"bound_int",
						limits(20000, 97842731),
						argv_case("Circle arm", [], 7, ""),
						[argv_case("Square arm", ["square"], 6, "")],
					),
				)),
			("bound match yields a fresh or a re-acquired prefix String", func(): run_example(
					compiler,
					join_example(
						"bound_managed",
						limits(19300, 78446370),
						argv_case("prefix value", [], 2, "42\n42\n"),
						[argv_case("fresh value", ["hello"], 1, "5\n42\n")],
					),
				)),
			("statement match runs one arm then continues", func(): run_example(
					compiler,
					join_example(
						"statement",
						limits(19400, 78487414),
						argv_case("value arm", [], 1, "one\nafter\n"),
						[argv_case("arm ending with a binding", ["a", "b"], 3, "3\nafter\n")],
					),
				)),
			("nested bound matches", func(): run_example(
					compiler,
					join_example(
						"nested",
						limits(22600, 88043217),
						argv_case("small outer, bound inner", [], 11, ""),
						[
							argv_case("large outer, small inner", ["a"], 201, ""),
							argv_case("large outer, large inner", ["a", "b"], 7, ""),
						],
					),
				)),
			("bound match in an arm of the tail match", func(): run_example(
					compiler,
					join_example(
						"tail_arm",
						limits(20200, 80459112),
						argv_case("no argument skips the join", [], 0, "42\n"),
						[
							argv_case("prefix value yielded", ["kept"], 2, "42\n"),
							argv_case("arm value yielded", ["other"], 5, "other\n"),
						],
					),
				)),
			("Void tail discards each nested arm's value", func(): run_example(
					compiler,
					join_example(
						"void_tail",
						limits(19500, 90331263),
						argv_case("no argument", [], 0, "none\n"),
						[
							argv_case("Void arm", ["say"], 0, "said\n"),
							argv_case("discarded Int arm", ["other"], 0, ""),
						],
					),
				)),
			("sixteen nested bound matches", func(): run_example(
					compiler,
					join_example(
						"deep",
						limits(31100, 117896899),
						argv_case("innermost arm", [], 15, ""),
						[argv_case("outermost arm", ["x"], 101, "")],
					),
				)),
		]
	}
