import:
	./cost: CostLimits
	./harness: run_output_example, run_source_example, verify_rejected_command, with_directory
	system: file_exists, read_file, write_file
	test: TestSuite


-- Ordinary Contains is checked with the default library on every compile.
-- Only measured native fields carry this increment's revision; see
-- benchmarks/results/blorp_2_list_contains_2026-10-19.md.

-- Measured compile costs plus 15% (see the increment report).
private DEPTH_LIMITS: CostLimits = {
	allocations = 22500,
	instructions = 80000000
}

private SHARED_LIMITS: CostLimits = {
	allocations = 24400,
	instructions = 85600000
}

private DEEP_LIMITS: CostLimits = {
	allocations = 25600,
	instructions = 88400000
}

private TRAIL_LIMITS: CostLimits = {
	allocations = 24600,
	instructions = 86400000
}

private FIXTURES: String = "blorp_2/test/e2e/fixtures/recursive/"


private func verify_rejection(
	compiler: String,
	directory: String,
	fixture: String,
	location: String,
) -> Result[Void, String]:
	input = FIXTURES + fixture + ".brp"
	output = directory + "/rejected.c"
	expected = input + ":" + location + ": error: recursive aggregate types are not supported yet\nhelp: use finite record and union fields; recursion is supported through a record field, a List element or one direct self payload of a non-generic union, such as Next(Node)\n"
	rejected ?= verify_rejected_command(compiler, input, output, expected)

	if file_exists(output):
		Err("a rejected recursive union published C output")
	else:
		Ok(void)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Unary recursive unions",
		tests = [
			("depth three chain counts to its exit status", func(): run_source_example(
				compiler, FIXTURES + "depth.brp", 3, DEPTH_LIMITS,
			)),
			("a chain stored twice in a record is counted twice and freed once", func(): run_source_example(
				compiler, FIXTURES + "shared.brp", 4, SHARED_LIMITS,
			)),
			("a 10,000-deep chain is built, walked and released", func(): run_output_example(
				compiler, FIXTURES + "deep.brp", "10000\n", DEEP_LIMITS,
			)),
			("a String beside the self child inside an inline owning parent is printed and released", func(): run_output_example(
				compiler, FIXTURES + "trail.brp", "first\nsecond\nend\n", TRAIL_LIMITS,
			)),
			("mutual recursion stays rejected", func(): with_directory(
				func(directory: String): verify_rejection(compiler, directory, "reject_mutual", "5:13"),
			)),
			("recursion through List is admitted", func(): run_source_example(
				compiler, FIXTURES + "list_payload.brp", 0, DEPTH_LIMITS,
			)),
			("generic self-reference stays rejected", func(): with_directory(
				func(directory: String): verify_rejection(compiler, directory, "reject_generic", "3:10"),
			)),
		]
	}
