import:
    int as IntOps

fixed record Parcel { parts: List[Int] }

implements Equatable for Parcel:
    pure func equals(left: Self, right: Self) -> Bool:
        match left.parts:
            [_, _]:
                match right.parts:
                    [_, _]: IntOps.equals(2, 2)
                    _: IntOps.equals(2, 1)
            _: False

func main() -> Int:
    left: Parcel = { parts = [1, 2] }
    same_length: Parcel = { parts = [9, 8] }
    different_length: Parcel = { parts = [3] }
    match equals(left, same_length):
        False: 0
        True:
            match equals(left, different_length):
                True: 0
                False: 23
