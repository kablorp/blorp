type Int = builtin
type Float = builtin
type String = builtin
type Void = builtin
type List[T] = builtin

fixed union Bool:
    True
    False

fixed union Option[A]:
    Some(A)
    None

fixed union Result[Value, Error]:
    Ok(Value)
    Err(Error)

trait Equatable:
    pure func equals(left: Self, right: Self) -> Bool
