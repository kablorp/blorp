import:
    int as IntOps

trait Visit:
    pure func visit(value: Self) -> Int

fixed record Box[Element] { value: Element }

fixed union Tree:
    Leaf(Int)
    Branch(List[Tree])

fixed record Left { children: List[Right] }

fixed union Right:
    End(Int)
    Back(List[Left])

implements Visit for Int:
    pure func visit(value: Self) -> Int:
        value

implements Visit for List[Element: Visit]:
    pure func visit(value: Self) -> Int:
        match value:
            []: 0
            [head, ...tail]: IntOps.add(visit(head), visit(tail))

implements Visit for Box[Element: Visit]:
    pure func visit(value: Self) -> Int:
        visit(value.value)

implements Visit for Tree:
    pure func visit(value: Self) -> Int:
        match value:
            Leaf(item): visit(item)
            Branch(children): visit(children)

implements Visit for Left:
    pure func visit(value: Self) -> Int:
        visit(value.children)

implements Visit for Right:
    pure func visit(value: Self) -> Int:
        match value:
            End(item): visit(item)
            Back(children): visit(children)

pure func box[Element](value: Element) -> Box[Element]:
    { value = value }

func main() -> Int:
    tree: Tree = Branch([Leaf(7), Leaf(9)])
    left: Left = { children = [End(5), Back([])] }
    right: Right = End(4)
    deep = box(box(box(box(box(7)))))
    results = [
        visit(tree), visit(tree), visit(deep), visit([1, 2, 3]),
        visit(left), visit(right), visit(box(tree)),
        visit([box(3), box(4)]), visit([tree]),
    ]
    match results:
        [observed_1, observed_2, observed_3, observed_4, observed_5, observed_6, observed_7, observed_8, observed_9]:
            match [
                IntOps.equals(observed_1, 16),
                IntOps.equals(observed_2, 16),
                IntOps.equals(observed_3, 7),
                IntOps.equals(observed_4, 6),
                IntOps.equals(observed_5, 5),
                IntOps.equals(observed_6, 4),
                IntOps.equals(observed_7, 16),
                IntOps.equals(observed_8, 7),
                IntOps.equals(observed_9, 16),
            ]:
                [True, True, True, True, True, True, True, True, True]: 23
                _: 0
        _: 0
