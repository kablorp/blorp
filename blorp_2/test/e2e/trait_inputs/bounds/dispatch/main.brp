import:
    int as IntOps
    io: print

trait Visit:
    pure func visit(value: Self) -> Int

opaque type First = Int
opaque type Second = Int

implements Visit for First:
    pure func visit(value: Self) -> Int:
        7

implements Visit for Second:
    pure func visit(value: Self) -> Int:
        9

fixed record Stored {
    first: pure (First) -> Int,
    second: pure (Second) -> Int
}

pure func forward[Element: Visit](value: Element) -> Int:
    visit(value)

pure func reference[Element: Visit](witness: Element) -> pure (Element) -> Int:
    visit

pure func apply[Element: Visit](left: Element, callback: pure (Element) -> Int, right: Element) -> Int:
    IntOps.add(callback(left), callback(right))

func produced(label: String) -> First:
    print(label)
    into_opaque First(1)

func main() -> Int:
    first = forward(into_opaque First(1))
    second = forward(into_opaque Second(2))
    repeated = forward(into_opaque First(3))
    direct: pure (First) -> Int = visit
    returned_first = reference(into_opaque First(4))
    returned_second = reference(into_opaque Second(5))
    repeated_reference = reference(into_opaque First(6))
    stored: Stored = { first = direct, second = returned_second }
    stored_first: pure (First) -> Int = stored.first
    stored_second: pure (Second) -> Int = stored.second
    ordered = apply(produced("left"), visit, produced("right"))
    results = [
        first, second, repeated,
        stored_first(into_opaque First(7)),
        stored_second(into_opaque Second(8)),
        returned_first(into_opaque First(9)),
        returned_second(into_opaque Second(10)),
        repeated_reference(into_opaque First(11)),
        ordered,
    ]
    match results:
        [observed_1, observed_2, observed_3, observed_4, observed_5, observed_6, observed_7, observed_8, observed_9]:
            match [
                IntOps.equals(observed_1, 7),
                IntOps.equals(observed_2, 9),
                IntOps.equals(observed_3, 7),
                IntOps.equals(observed_4, 7),
                IntOps.equals(observed_5, 9),
                IntOps.equals(observed_6, 7),
                IntOps.equals(observed_7, 9),
                IntOps.equals(observed_8, 7),
                IntOps.equals(observed_9, 14),
            ]:
                [True, True, True, True, True, True, True, True, True]: 23
                _: 0
        _: 0
