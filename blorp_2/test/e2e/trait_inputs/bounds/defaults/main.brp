import:
    int as IntOps
    ./provider: measure, make_default, make_override

opaque type Unequal = Int

implements Equatable for Unequal:
    pure func equals(left: Self, right: Self) -> Bool:
        False

private pure func marker() -> Int:
    11

func main() -> Int:
    defaults = measure(make_default())
    overridden = measure(make_override())
    repeated_default = measure(make_default())
    caller = marker()
    match not_equals(into_opaque Unequal(1), into_opaque Unequal(1)):
        False: 0
        True:
            match [defaults, overridden, repeated_default, caller]:
                [observed_1, observed_2, observed_3, observed_4]:
                    match [
                        IntOps.equals(observed_1, 7),
                        IntOps.equals(observed_2, 9),
                        IntOps.equals(observed_3, 7),
                        IntOps.equals(observed_4, 11),
                    ]:
                        [True, True, True, True]: 23
                        _: 0
                _: 0
