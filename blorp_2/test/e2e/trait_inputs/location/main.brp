import:
    int as Compare

record Point { value: Int }

pure func same[Value: Equatable](left: Value, right: Value) -> Bool:
    Compare.equals(left, right)

func main() -> Int:
    left: Point = { value = 7 }
    equal: Point = { value = 7 }
    different: Point = { value = 9 }
    comparator: pure (Point, Point) -> Bool = Compare.equals
    truth: Bool = True
    falsehood: Bool = False
    results = [
        same(left, equal),
        Compare.not_equals(left, different),
        comparator(left, equal),
        Compare.equals(truth, truth),
        Compare.not_equals(truth, falsehood),
    ]
    match results:
        [True, True, True, True, True]: 23
        _: 0
