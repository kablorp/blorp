-- The base owns primitive identities, the fixed union Bool and the ordinary
-- base unions. It is the only module that may declare builtin types; every
-- other module imports what it uses.
type Int = builtin
type Float = builtin
type String = builtin
type Void = builtin
type List[T] = builtin

fixed union Bool:
    True
    False

union Option[A]:
    Some(A)
    None

union Result[Value, Error]:
    Ok(Value)
    Err(Error)

-- Set, Dict, and other foundational declarations remain deferred.
