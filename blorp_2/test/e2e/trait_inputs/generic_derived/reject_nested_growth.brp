import:
    int: equals

record Node[Element] { value: Element }
record Box[Element] { value: Element }
record Holder { nested: Box[Int] }

func main() -> Int:
    value: Holder = { nested = { value = 7 } }
    result = equals(value, value)
    0

implements Equatable for Node[Element: Equatable]:
    pure func equals(left: Self, right: Self) -> Bool:
        relay(left)

pure func relay[Value: Equatable](value: Value) -> Bool:
    wrapped: Box[Node[Value]] = { value = { value = value } }
    equals(wrapped, wrapped)
