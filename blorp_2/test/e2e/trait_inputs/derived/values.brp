import:
    int: equals
    list as ListOps -- Loads the ordinary bounded List equality implementation.
    float as FloatOps
    io: print

record Point { first: Int, second: Int }
record Managed { items: List[Int] }

union Reply:
    Empty
    Value(Point)
    Items(List[Int])

record Floating { value: Float, children: List[Int] }
union FloatReply:
    FloatValue(Float, List[Int])

func produced(label: String) -> Point:
    print(label)
    { first = 7, second = 9 }

func main() -> Int:
    point: Point = { first = 7, second = 9 }
    same: Point = { first = 7, second = 9 }
    first_changed: Point = { first = 8, second = 9 }
    last_changed: Point = { first = 7, second = 8 }
    managed: Managed = { items = [1, 2, 3] }
    managed_same: Managed = { items = [1, 2, 3] }
    managed_changed: Managed = { items = [1, 2, 4] }
    empty: Reply = Empty
    value: Reply = Value(point)
    same_value: Reply = Value(same)
    changed_value: Reply = Value(last_changed)
    items: Reply = Items([1, 2, 3])
    same_items: Reply = Items([1, 2, 3])
    changed_items: Reply = Items([1, 2, 4])
    nan = FloatOps.nan()
    floating: Floating = { value = nan, children = [1] }
    float_value: FloatReply = FloatValue(nan, [1])
    ordered = equals(produced("left"), produced("right"))
    results = [
        equals(point, point), equals(point, same),
        equals(point, first_changed), equals(point, last_changed),
        equals(empty, empty), equals(empty, value),
        equals(value, empty), equals(items, value),
        equals(value, same_value), equals(value, changed_value),
        equals(items, same_items), equals(items, changed_items),
        equals(managed, managed_same), equals(managed, managed_changed),
        FloatOps.is_nan(nan), equals(floating, floating),
        equals(float_value, float_value), ordered,
    ]
    match results:
        [True, True, False, False, True, False, False, False, True, False, True, False, True, False, True, False, False, True]: 23
        _: 0
