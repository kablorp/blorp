import:
    int: equals
    list as ListOps -- Loads the ordinary bounded List equality implementation.

union Tree:
    Leaf(Int)
    Branch(List[Tree])

record Deep { values: List[List[List[Tree]]] }
record Left { children: List[Right] }
union Right:
    End(Int)
    Back(List[Left])

func main() -> Int:
    tree: Tree = Branch([Leaf(7), Branch([Leaf(9), Leaf(11)])])
    same: Tree = Branch([Leaf(7), Branch([Leaf(9), Leaf(11)])])
    changed: Tree = Branch([Leaf(7), Branch([Leaf(9), Leaf(12)])])
    changed_tag: Tree = Leaf(7)
    deep: Deep = { values = [[[tree]]] }
    deep_same: Deep = { values = [[[same]]] }
    deep_changed: Deep = { values = [[[changed]]] }
    left: Left = { children = [End(5), Back([{ children = [End(7)] }])] }
    left_same: Left = { children = [End(5), Back([{ children = [End(7)] }])] }
    left_changed: Left = { children = [End(5), Back([{ children = [End(8)] }])] }
    right: Right = Back([left])
    right_same: Right = Back([left_same])
    right_changed: Right = Back([left_changed])
    results = [
        equals(tree, same), equals(tree, changed), equals(tree, changed_tag),
        equals(deep, deep_same), equals(deep, deep_changed),
        equals(left, left_same), equals(left, left_changed),
        equals(right, right_same), equals(right, right_changed),
        equals(tree, same), equals(deep, deep_same), equals(left, left_same),
    ]
    match results:
        [True, False, False, True, False, True, False, True, False, True, True, True]: 23
        _: 0
