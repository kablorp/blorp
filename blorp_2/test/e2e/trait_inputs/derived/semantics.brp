import:
    int: equals
    list as ListOps -- Loads the ordinary bounded List equality implementation.
    void_equality as VoidOps -- Loads written equality for logical Void positions.

record Custom { value: Int }
implements Equatable for Custom:
    pure func equals(left: Self, right: Self) -> Bool:
        False

record Outer { nested: Custom }
union Wrapped:
    Nested(Custom)

record Erased { before: Int, hidden: Void, after: Int }
union ErasedPayload:
    Absent
    Present(Int, Void, Int)

trait Visit:
    pure func visit(value: Self) -> Int

implements Visit for Int:
    pure func visit(value: Self) -> Int:
        value

record Conditional[Element] { value: Element }
implements Equatable for Conditional[Element: Visit]:
    pure func equals(left: Self, right: Self) -> Bool:
        False

record Holder { wrapped: Conditional[Int] }

-- Unsupported declarations and construction alone are legal; no equality use.
record Unavailable { callback: pure () -> Int, children: List[Unavailable] }
record Deferred[Element] { value: Element }

pure func seven() -> Int:
    7

pure func declared_only() -> Unavailable:
    { callback = seven, children = [] }

pure func generic_declared_only() -> Deferred[Int]:
    { value = 7 }

func main() -> Int:
    custom: Custom = { value = 7 }
    outer: Outer = { nested = custom }
    wrapped: Wrapped = Nested(custom)
    erased: Erased = { before = 7, hidden = void, after = 9 }
    payload: ErasedPayload = Present(7, void, 9)
    absent: ErasedPayload = Absent
    holder: Holder = { wrapped = { value = 7 } }
    unused = declared_only()
    deferred = generic_declared_only()
    results = [
        equals(custom, custom), equals(outer, outer), equals(wrapped, wrapped),
        equals(void, void), equals(erased, erased), equals(payload, payload),
        equals(absent, absent), equals(absent, payload), equals(holder, holder),
    ]
    match results:
        [False, False, False, False, False, False, True, False, False]: 23
        _: 0
