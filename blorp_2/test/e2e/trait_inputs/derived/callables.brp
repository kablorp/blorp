import:
    int: equals, not_equals

fixed record Point { first: Int, second: Int }
union Reply:
    Empty
    Value(Point)

fixed record Comparisons {
    equal: pure (Point, Point) -> Bool,
    unequal: pure (Point, Point) -> Bool
}

pure func forwarded[Element: Equatable](left: Element, right: Element) -> Bool:
    equals(left, right)

pure func reference[Element: Equatable](witness: Element) -> pure (Element, Element) -> Bool:
    equals

pure func apply[Element](left: Element, callback: pure (Element, Element) -> Bool, right: Element) -> Bool:
    callback(left, right)

func main() -> Int:
    point: Point = { first = 7, second = 9 }
    same: Point = { first = 7, second = 9 }
    changed: Point = { first = 7, second = 8 }
    value: Reply = Value(point)
    same_value: Reply = Value(same)
    changed_value: Reply = Value(changed)
    direct: pure (Point, Point) -> Bool = equals
    direct_default: pure (Point, Point) -> Bool = not_equals
    union_reference: pure (Reply, Reply) -> Bool = equals
    returned = reference(point)
    returned_union = reference(value)
    stored: Comparisons = { equal = equals, unequal = not_equals }
    stored_equal: pure (Point, Point) -> Bool = stored.equal
    stored_unequal: pure (Point, Point) -> Bool = stored.unequal
    results = [
        direct(point, same), direct(point, changed),
        direct_default(point, same), direct_default(point, changed),
        forwarded(point, same), forwarded(point, changed),
        apply(point, equals, same), apply(point, equals, changed),
        stored_equal(point, same), stored_unequal(point, changed),
        returned(point, same), returned(point, changed),
        union_reference(value, same_value), union_reference(value, changed_value),
        returned_union(value, same_value), returned_union(value, changed_value),
        not_equals(value, same_value), not_equals(value, changed_value),
    ]
    match results:
        [True, False, False, True, True, False, True, False, True, True, True, False, True, False, True, False, False, True]: 23
        _: 0
