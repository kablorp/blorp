import:
    _base: Float, Bool(True, False), Equatable

implements Equatable for Float:
    pure func equals(left: Self, right: Self) -> Bool:
        builtin("float.equals")

pure func multiply(left: Float, right: Float) -> Float:
    builtin("float.multiply")

pure func subtract(left: Float, right: Float) -> Float:
    builtin("float.subtract")

pure func is_nan(value: Float) -> Bool:
    match equals(value, value):
        True: False
        False: True

-- Existing Float arithmetic produces NaN; no new builtin label is introduced.
pure func nan() -> Float:
    infinity = multiply(1e308, 1e308)
    subtract(infinity, infinity)
