type Int = builtin
type Float = builtin
type String = builtin
type Void = builtin
type List[T] = builtin

union Bool:
    True
    False

union Option[A]:
    Some(A)
    None

union Result[Value, Error]:
    Ok(Value)
    Err(Error)

trait Equatable:
    pure func equals(left: Self, right: Self) -> Bool
    pure func not_equals(left: Self, right: Self) -> Bool:
        match equals(left, right):
            True: False
            False: True
