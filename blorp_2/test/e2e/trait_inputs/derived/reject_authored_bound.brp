import:
    int: equals

trait Visit:
    pure func visit(value: Self) -> Int

fixed record NoVisit { value: Int }
fixed record Conditional[Element] { value: Element }

implements Equatable for Conditional[Element: Visit]:
    pure func equals(left: Self, right: Self) -> Bool:
        True

pure func compare(left: Conditional[NoVisit], right: Conditional[NoVisit]) -> Bool:
    equals(left, right)

func main() -> Int:
    0
