import:
	../../src/runtime/memory: MEMORY_RUNTIME
	../unit/compilation: compile
	./harness: native_case, run_example
	test: TestSuite


private EXPECTED_C: String = MEMORY_RUNTIME + "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);int64_t blorp_f_2(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=blorp_f_1();(void)blorp_vl_0;return blorp_vl_0;}\nint64_t blorp_f_1(void){const int64_t blorp_vl_0=blorp_f_2();(void)blorp_vl_0;return blorp_vl_0;}\nint64_t blorp_f_2(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;return blorp_vl_0;}\nint main(void){blorp_memory_start();return blorp_memory_finish((int)blorp_f_0());}\n"


pure func test_pure_calls_preserve_checked_entrypoint() -> Bool:
	source: String =
		|pure func one() -> Int:
		|	1
		|pure func answer() -> Int:
		|	one()
		|func main() -> Int:
		|	answer()
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			output == EXPECTED_C


func test_pure_calls_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "pure_calls",
			library_root = "blorp_2/standard_library",
			fixture = "blorp_2/test/e2e/fixtures/pure/calls.brp",
			expected_c = None,
			first_case = native_case("native output", "", 1, ""),
			remaining_cases = [],
			limits = {
				allocations = 131600,
				instructions = 440000000
			}
		},
	)


pure func test_pure_main_literal_has_the_same_c_abi() -> Bool:
	pure_source: String =
		|pure func main() -> Int:
		|	1
		|
	impure_source: String =
		|func main() -> Int:
		|	1
		|

	match compile(pure_source):
		Err(_):
			False
		Ok(output):
			match compile(impure_source):
				Err(_):
					False
				Ok(default_output):
					output == default_output


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 pure calls",
		tests = [
			("pure calls preserve checked entrypoint", test_pure_calls_preserve_checked_entrypoint),
			("pure main literal has the same C ABI", test_pure_main_literal_has_the_same_c_abi),
			(
				"pure calls native execution and cost",
				func(): test_pure_calls_native_and_cost(compiler),
			),
		]
	}
