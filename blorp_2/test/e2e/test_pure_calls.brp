import:
	../unit/compilation: compile
	harness: run_example
	test: TestSuite


private EXPECTED_C: String = "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);int64_t blorp_f_2(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_1(void){const int64_t blorp_vl_0=blorp_f_0();(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_2(void){const int64_t blorp_vl_0=blorp_f_1();(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_2();}\n"


pure func test_pure_calls_preserve_checked_entrypoint() -> Bool:
	match compile(
		"pure func one() -> Int:\n\t1\npure func answer() -> Int:\n\tone()\nfunc main() -> Int:\n\tanswer()\n",
	):
		Err(_):
			False
		Ok(output):
			output == EXPECTED_C


func test_pure_calls_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "pure_calls",
			fixture = "blorp_2/test/e2e/fixtures/pure_calls.brp",
			expected_c = Some(EXPECTED_C),
			exit_status = 1,
			limits = {
				allocations = 1300,
				instructions = 40000000
			}
		},
	)


pure func test_pure_main_literal_has_the_same_c_abi() -> Bool:
	match compile("pure func main() -> Int:\n\t1\n"):
		Err(_):
			False
		Ok(output):
			match compile("func main() -> Int:\n\t1\n"):
				Err(_):
					False
				Ok(default_output):
					output == default_output


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 pure calls",
		tests = [
			("pure calls preserve checked entrypoint", test_pure_calls_preserve_checked_entrypoint),
			("pure main literal has the same C ABI", test_pure_main_literal_has_the_same_c_abi),
			(
				"pure calls native execution and cost",
				func(): test_pure_calls_native_and_cost(compiler),
			),
		]
	}
