import:
	./harness: run_accounted_example, TargetAllocations(PositiveTargetAllocations)
	test: TestSuite


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 stored callable values",
		tests = [
			("same pure entry is stored twice and both record fields are invoked", func():
				run_accounted_example(
					compiler, "blorp_2/standard_library", "blorp_2/test/e2e/fixtures/callable_values/pure_storage.brp", 42, "",
					{ allocations = 150000, instructions = 1470000000 },
					PositiveTargetAllocations, "build/self-hosted-tests-goal3/native/artifacts/pure_storage.c",
				)
			),
			("heterogeneous captured environments survive List aliasing", func():
				run_accounted_example(
					compiler, "blorp_2/standard_library", "blorp_2/test/e2e/fixtures/callable_values/heterogeneous.brp", 0, "left\ntext\nnumber\nnumber\n",
					{ allocations = 150000, instructions = 1480000000 },
					PositiveTargetAllocations, "build/self-hosted-tests-goal3/native/artifacts/heterogeneous.c",
				)
			),
			("forwarded callable and dynamic String survive both creators and a copy", func():
				run_accounted_example(
					compiler, "blorp_2/standard_library", "blorp_2/test/e2e/fixtures/callable_values/forwarded_capture.brp", 0, "kept!\nkept!\n",
					{ allocations = 150000, instructions = 1460000000 },
					PositiveTargetAllocations, "build/self-hosted-tests-goal3/native/artifacts/forwarded_capture.c",
				)
			),
			("direct callable Lists preserve copies and distinct signatures", func():
				run_accounted_example(
					compiler, "blorp_2/standard_library", "blorp_2/test/e2e/fixtures/callable_values/direct_list_copy.brp", 25, "",
					{ allocations = 150000, instructions = 1520000000 },
					PositiveTargetAllocations, "build/self-hosted-tests-goal3/native/artifacts/direct_list_copy.c",
				)
			),
			("stored receiver is produced once before its ordinary argument", func():
				run_accounted_example(
					compiler, "blorp_2/standard_library", "blorp_2/test/e2e/fixtures/callable_values/receiver_order.brp", 0, "receiver\nargument\n17\n",
					{ allocations = 150000, instructions = 1600000000 },
					PositiveTargetAllocations, "build/self-hosted-tests-goal3/native/artifacts/receiver_order.c",
				)
			),
		]
	}
