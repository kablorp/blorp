import:
    ./self_hosted_harness as NativeTests
    ./self_hosted_system as SystemTests
    ../runtime/process_suite as ProcessTests
    ../runtime/fs_suite as FsTests
    ../runtime/list_reuse_suite as ListTests
    ../runtime/allocation_sites_suite as AllocationSiteTests
    ../runtime/string_literal_suite as StringLiteralTests
    ../runtime/system_suite as SystemRuntimeTests
    test: run_suite
    io: print_error
    bool: not, and
    int: Int methods
    string: String methods


private pure func configured_path(path: String) -> Bool:
    path.starts_with("/")


-- This ordinary entrypoint supplies explicit Make configuration to real suites.
-- Constant component suites keep their generated --test-suite entry unchanged.
func main(arguments: List[String]) -> Int:
    match arguments:
        [_, compiler, c_compiler, work_directory]:
            if configured_path(compiler).and(configured_path(c_compiler)).and(configured_path(work_directory)):
                process_status = run_suite(ProcessTests.suite(c_compiler, work_directory))
                fs_status = run_suite(FsTests.suite(c_compiler, work_directory))
                list_status = run_suite(ListTests.suite(c_compiler, work_directory))
                sites_status = run_suite(AllocationSiteTests.suite(c_compiler, work_directory))
                literal_status = run_suite(StringLiteralTests.suite(c_compiler, work_directory))
                directory_status = run_suite(SystemRuntimeTests.current_directory_suite(c_compiler, work_directory))
                directory_e2e_status = run_suite(SystemTests.current_directory_suite(compiler, c_compiler, work_directory))
                native_status = run_suite(NativeTests.suite(compiler, c_compiler, work_directory))
                if process_status.equals(0).and(fs_status.equals(0)).and(list_status.equals(0)).and(sites_status.equals(0)).and(literal_status.equals(0)).and(directory_status.equals(0)).and(directory_e2e_status.equals(0)).and(native_status.equals(0)):
                    0
                else:
                    1
            else:
                print_error("self-hosted e2e requires absolute compiler, C compiler and work-directory paths")
                2
        _:
            print_error("usage: self-hosted-e2e COMPILER C_COMPILER WORK_DIRECTORY")
            2
