import:
    ./self_hosted_harness as NativeTests
    ./self_hosted_system as SystemTests
    ./self_hosted_components as ComponentTests
    ./self_hosted_selection:
        EndToEndRun, Invocation(Components, Deferred, EndToEnd), group_sources, component_selection, scan_entries, deferral_line, parse_invocation
    ../runtime/process_suite as ProcessTests
    ../runtime/fs_suite as FsTests
    ../runtime/list_reuse_suite as ListTests
    ../runtime/allocation_sites_suite as AllocationSiteTests
    ../runtime/string_literal_suite as StringLiteralTests
    ../runtime/system_suite as SystemRuntimeTests
    fs: describe, list_directory, with_temporary_directory
    test: run_suite
    io: print, print_error
    bool: and
    int: Int methods
    list: List methods
    result: Result methods


-- The component programs `make test` runs; a suite file joins by being listed
-- here. Directories run in order of first appearance and keep list order within
-- a group, so each phase's imports compile once and a strict leak or crash is
-- attributed to that phase. `make test-target-components
-- TARGET_COMPONENT_SOURCES=...` runs its own list instead of this one.
