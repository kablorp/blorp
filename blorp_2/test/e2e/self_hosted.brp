-- Where test sources live. The deferred report counts, per top directory, the
-- test_*.brp files below it that no component selection runs.
private DEFERRAL_ROOTS: List[String] = ["blorp_2/test/unit", "blorp_2/test/runtime", "blorp_2/test/test_grammar", "blorp_2/test/e2e"]
private TEMPORARY_PREFIX: String = "blorp2-test."
private USAGE_STATUS: Int = 2


private func test_sources_under(directory: String) -> Result[List[String], String]:
    entries ?= list_directory(directory).map_err(describe)
    scan = scan_entries(directory, entries)
    var found: Result[List[String], String] = Ok(scan.test_sources)
    for subdirectory in scan.subdirectories:
        found = match found:
            Ok(sources): test_sources_under(subdirectory).map(pure func(nested: List[String]): sources.concat(nested))
            Err(error): Err(error)
    found


private func report_deferred(selected: List[String]) -> Int:
    var status = 0
    for directory in DEFERRAL_ROOTS:
        match test_sources_under(directory):
            Ok(found): print(deferral_line(directory, found, selected))
            Err(error):
                print_error(error)
                status = 1
    status


-- 0 only when every suite passed.
private func run_native_suites(run: EndToEndRun, work_directory: String) -> Int:
    compiler = run.compiler
    c_compiler = run.c_compiler
    process_status = run_suite(ProcessTests.suite(c_compiler, work_directory))
    fs_status = run_suite(FsTests.suite(c_compiler, work_directory))
    list_status = run_suite(ListTests.suite(c_compiler, work_directory))
    sites_status = run_suite(AllocationSiteTests.suite(c_compiler, work_directory))
    literal_status = run_suite(StringLiteralTests.suite(c_compiler, work_directory))
    directory_status = run_suite(SystemRuntimeTests.current_directory_suite(c_compiler, work_directory))
    directory_e2e_status = run_suite(SystemTests.current_directory_suite(compiler, c_compiler, work_directory))
    native_status = run_suite(NativeTests.suite(compiler, c_compiler, work_directory))
    if process_status.equals(0).and(fs_status.equals(0)).and(list_status.equals(0)).and(sites_status.equals(0)).and(literal_status.equals(0)).and(directory_status.equals(0)).and(directory_e2e_status.equals(0)).and(native_status.equals(0)):
        0
    else:
        1


-- The work directory is removed when the suites end, pass or fail; failing to
-- remove it fails the run.
private func run_native(run: EndToEndRun) -> Int:
    outcome = with_temporary_directory(
        run.temporary_parent, TEMPORARY_PREFIX,
        func(work_directory: String): Ok(run_native_suites(run, work_directory)),
        describe,
    )
    match outcome:
        Ok(status): status
        Err(error):
            print_error(error)
            1


-- This ordinary entrypoint runs real suites with the explicit configuration Make
-- passes as arguments; the driver reads no environment.
func main(arguments: List[String]) -> Int:
    match parse_invocation(arguments):
        Err(message):
            print_error(message)
            USAGE_STATUS
        Ok(invocation):
            match invocation:
                Components(run):
                    match component_selection(run.sources, COMPONENT_SOURCES):
                        Ok(selected): run_suite(ComponentTests.suite(run.tools, group_sources(selected)))
                        Err(message):
                            print_error(message)
                            1
                Deferred(requested):
                    match component_selection(requested, COMPONENT_SOURCES):
                        Ok(selected): report_deferred(selected)
                        Err(message):
                            print_error(message)
                            1
                EndToEnd(run): run_native(run)
