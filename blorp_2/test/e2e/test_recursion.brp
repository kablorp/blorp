import:
	./cost: CostLimits
	./harness: run_source_example
	test: TestSuite


private RECURSION_LIMITS: CostLimits = {
	allocations = 140000,
	instructions = 500000000
}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Function recursion",
		tests = [
			(
				"self call",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/recursion/self.brp",
					7,
					RECURSION_LIMITS,
				),
			),
			(
				"mutual calls",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/recursion/mutual.brp",
					7,
					RECURSION_LIMITS,
				),
			),
			(
				"UFCS self call",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/recursion/ufcs.brp",
					7,
					RECURSION_LIMITS,
				),
			),
			(
				"argument self call",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/recursion/argument.brp",
					7,
					RECURSION_LIMITS,
				),
			),
			(
				"binding self call",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/recursion/binding.brp",
					7,
					RECURSION_LIMITS,
				),
			),
			(
				"record field self call",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/recursion/record.brp",
					7,
					RECURSION_LIMITS,
				),
			),
			(
				"generic self call",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/recursion/generic.brp",
					7,
					RECURSION_LIMITS,
				),
			),
			(
				"managed recursive result",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/recursion/string_result.brp",
					1,
					RECURSION_LIMITS,
				),
			),
			(
				"managed local across recursive call",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/recursion/string_live_local.brp",
					1,
					RECURSION_LIMITS,
				),
			),
		]
	}
