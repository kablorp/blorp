import:
	./harness: Example, argv_case, native_case, verify_all, with_directory
	test: TestSuite


private func verify_edges(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "ordinary target logical path normalization",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/path_normalize/edges.brp", expected_c = None,
		first_case = argv_case("cancel ordinary component", ["/foo/bar/../baz"], 0, "/foo/baz\n"),
		remaining_cases = [
			argv_case("skip dot", ["/foo/./bar"], 0, "/foo/bar\n"),
			argv_case("collapse separators", ["/foo//bar"], 0, "/foo/bar\n"),
			argv_case("clean absolute", ["/foo/bar"], 0, "/foo/bar\n"),
			argv_case("relative cancellation", ["foo/bar/../baz"], 0, "foo/baz\n"),
			argv_case("only dot", ["."], 0, ".\n"),
			argv_case("parent at root", ["/.."], 0, "/\n"),
			argv_case("leading parents", ["../../x"], 0, "../../x\n"),
			argv_case("parent beyond ordinary component", ["a/../../x"], 0, "../x\n"),
			argv_case("one leading parent", ["../x"], 0, "../x\n"),
			argv_case("ordinary component above leading parent", ["../a/../b"], 0, "../b\n"),
			argv_case("only parents", ["../.."], 0, "../..\n"),
			argv_case("absolute parent above root", ["/../x"], 0, "/x\n"),
			argv_case("multiple absolute parents above root", ["/../../x"], 0, "/x\n"),
			argv_case("cancel component above leading parent", ["../a/.."], 0, "..\n"),
			argv_case("cancel final component", ["a/.."], 0, ".\n"),
			argv_case("empty", [""], 0, ".\n"),
			argv_case("root", ["/"], 0, "/\n"),
			argv_case("separator run root", ["////"], 0, "/\n"),
			argv_case("leading and trailing runs", ["///a//b///"], 0, "/a/b\n"),
			argv_case("trailing dot", ["a/b/."], 0, "a/b\n"),
			argv_case("trailing parent", ["a/b/.."], 0, "a\n"),
			argv_case("relative leading dots", ["././a///"], 0, "a\n"),
			argv_case("multiple canceled components", ["a/b/../../.."], 0, "..\n"),
			argv_case("root remains after cancellation", ["/a/b/../../../"], 0, "/\n"),
			argv_case("parent spelling is exact", [".../..x/x.."], 0, ".../..x/x..\n"),
			argv_case("backslash is content", ["a\\b/../c"], 0, "c\n"),
			argv_case("Unicode components", ["é/树/../🙂"], 0, "é/🙂\n"),
			argv_case("Unicode slash-boundary cut", ["é/leaf"], 0, "é/leaf\n"),
			argv_case("ASCII slash-boundary cut", ["ab/leaf"], 0, "ab/leaf\n"),
			argv_case("Unicode end-boundary cut", ["é"], 0, "é\n"),
			argv_case("ASCII end-boundary cut", ["ab"], 0, "ab\n"),
			argv_case("combining spelling preserved", ["e\u{301}//é"], 0, "e\u{301}/é\n"),
			native_case("counted NUL and surviving source/result aliases", "", 0,
				"a\0b\nc\n\0\né/🙂\né/🙂\né/树/../🙂//./leaf/..\na\0b\n"),
		],
		limits = { allocations = 200000, instructions = 600000000 }
	}
	verify_all(compiler, directory, example)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 ordinary pure target path normalization",
		tests = [
			("34 lexical, counted-NUL and ownership states through one fixture build", func(): with_directory(func(directory: String): verify_edges(compiler, directory))),
		]
	}
