import:
	./cost: CostLimits
	./harness: run_source_example, run_output_example, verify_rejected_command, with_directory
	test: TestSuite


private LIMITS: CostLimits = { allocations = 140000, instructions = 500000000 }
private FIXTURES: String = "blorp_2/test/e2e/fixtures/constant/"


private func example(compiler: String, fixture: String, expected: Int) -> Bool:
	run_source_example(compiler, FIXTURES + fixture + ".brp", expected, LIMITS)


private func output(compiler: String, fixture: String, expected: String) -> Bool:
	run_output_example(compiler, FIXTURES + fixture + ".brp", expected, LIMITS)


private func rejected(compiler: String, fixture: String, location: String, message: String, help: String) -> Bool:
	input = FIXTURES + fixture + ".brp"
	expected = input + ":" + location + ": error: " + message + "\nhelp: " + help + "\n"
	with_directory(func(directory): verify_rejected_command(compiler, input, directory + "/rejected.c", expected))


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 scalar constants",
		tests = [
			("Int constant returns 23", func(): example(compiler, "integer", 23)),
			("former unsupported constant returns seven", func(): example(compiler, "seven", 7)),
			("former unsupported import returns seven", func(): example(compiler, "imported/main", 7)),
			("Float constant retains exact value", func(): output(compiler, "float", "1.25\n")),
			("String constant retains Unicode bytes", func(): output(compiler, "string", "hello λ\n")),
			("pipe String constant retains line breaks", func(): output(compiler, "pipe", "hello λ\nsecond line\n")),
			("materialized aliases survive reassignment", func(): output(compiler, "aliases", "old λ\nnew λ\nold λ\n")),
			("generic constant reads preserve NUL bytes and negative zero", func(): output(compiler, "managed_generic", "kept λ\0kept λ\0\nkept λ\0kept λ\0\n-0\n")),
			("constant call rejects with teaching help", func(): rejected(compiler, "called", "4:5", "constant 'ANSWER' cannot be called", "read the constant without parentheses, such as ANSWER")),
			("initializer call rejects without resolution", func(): rejected(compiler, "nonclosed", "1:12", "constant initializer is not a closed value", "use an Int, Float, or String literal")),
		]
	}
