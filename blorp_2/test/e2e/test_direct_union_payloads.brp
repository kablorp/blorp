import:
	cost: CostLimits
	harness: run_output_example, run_source_example, verify_rejected_command, with_directory
	system: file_exists, read_file, write_file
	test: TestSuite


private PAYLOAD_LIMITS: CostLimits = {
	allocations = 140000,
	instructions = 500000000
}
private FIXTURES: String = "blorp_2/test/e2e/fixtures/union/direct/"


private func verify_diagnostic(
	compiler: String,
	directory: String,
	fixture: String,
	location: String,
	message: String,
	help: String,
) -> Result[Void, String]:
	input = FIXTURES + fixture + ".brp"
	output = directory + "/rejected.c"
	expected = input + ":" + location + ": error: " + message + "\nhelp: " + help + "\n"
	rejected ?= verify_rejected_command(compiler, input, output, expected)

	unpublished ?= if file_exists(output):
		Err("invalid direct union payload published C output")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve direct union payload output")
	rejected_existing ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)

	if actual == "preserve direct union payload output":
		Ok(void)
	else:
		Err("invalid direct union payload overwrote existing C output")


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Direct unary union payloads",
		tests = [
			("direct String payload escapes its temporary parent", func(): run_source_example(
				compiler, FIXTURES + "string_escape.brp", 2, PAYLOAD_LIMITS,
			)),
			("direct Float payload preserves exact native output", func(): run_output_example(
				compiler, FIXTURES + "float_output.brp", "2.5\n", PAYLOAD_LIMITS,
			)),
			("direct managed record payload survives temporary union", func(): run_output_example(
				compiler, FIXTURES + "managed_record_escape.brp", "7\n42\n", PAYLOAD_LIMITS,
			)),
			("nested applied payload preserves its acquired String", func(): run_output_example(
				compiler, FIXTURES + "nested_nominal_escape.brp", "42\n", PAYLOAD_LIMITS,
			)),
			("old direct parent alias and child survive reassignment", func(): run_output_example(
				compiler, FIXTURES + "parent_alias_reassignment.brp", "42\n42\n7\n", PAYLOAD_LIMITS,
			)),
			("direct Void payload retains its unary variant tag", func(): run_source_example(
				compiler, FIXTURES + "void_tag.brp", 2, PAYLOAD_LIMITS,
			)),
			("nullary alternative stays distinct from Void payload", func(): run_source_example(
				compiler, FIXTURES + "void_empty.brp", 1, PAYLOAD_LIMITS,
			)),
			("forward finite union and record payloads remain valid", func(): run_source_example(
				compiler, FIXTURES + "forward_finite.brp", 7, PAYLOAD_LIMITS,
			)),
			("unused direct union self-cycle rejects without publishing C", func(): with_directory(
				func(directory: String): verify_diagnostic(
					compiler, directory, "union_self_unused", "2:10",
					"recursive aggregate types are not supported yet",
					"use finite record and union fields until recursive data is supported",
				),
			)),
			("nested payload arity rejects and preserves existing output", func(): with_directory(
				func(directory: String): verify_diagnostic(
					compiler, directory, "reject_nested_arity", "3:17",
					"union type argument count does not match its declaration",
					"expected 1 type arguments, got 2; supply types in declaration order",
				),
			)),
			("symbolic List payload rejects even without its constructor", func(): with_directory(
				func(directory: String): verify_diagnostic(
					compiler, directory, "symbolic_list_admission", "2:11",
					"List currently supports only String elements",
					"use List[String]; other concrete element types are not supported yet",
				),
			)),
		]
	}
