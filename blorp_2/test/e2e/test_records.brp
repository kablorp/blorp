import:
	cost: CostLimits
	harness: run_source_example, verify_rejected_command, with_directory
	system: file_exists, read_file, write_file
	test: TestSuite


private RECORD_LIMITS: CostLimits = {
	allocations = 10000,
	instructions = 100000000
}


func test_pair_returns_first_field(compiler: String) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/record/basic.brp", 7, RECORD_LIMITS)


private func verify_missing_field_diagnostic(
	compiler: String,
	directory: String,
) -> Result[Void, String]:
	source: String =
		|fixed record Pair { first: Int, second: Int }
		|pure func make_pair() -> Pair:
		|	{}
		|func main() -> Int:
		|	0
		|
	input = directory + "/missing.brp"
	output = directory + "/rejected.c"
	written ?= write_file(input, source)
	expected = input + ":3:2: error: missing field in record literal\nhelp: provide every declared record field exactly once\n" + input + ":1:21: note: record field declared here\n"
	rejected ?= verify_rejected_command(compiler, input, output, expected)

	unpublished ?= if file_exists(output):
		Err("invalid record published C output")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve record output")
	rejected_existing ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)

	if actual == "preserve record output":
		Ok(void)
	else:
		Err("invalid record overwrote existing C output")


func test_missing_field_note_and_output_preservation(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_missing_field_diagnostic(compiler, directory))


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Fixed records",
		tests = [
			(
				"missing field diagnostic note and output preservation",
				func(): test_missing_field_note_and_output_preservation(compiler),
			),
			("pair returns its first field", func(): test_pair_returns_first_field(compiler)),
			(
				"reordered second nominal record",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/reordered.brp",
					9,
					RECORD_LIMITS,
				),
			),
			(
				"record alias survives reassignment",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/aliases.brp",
					7,
					RECORD_LIMITS,
				),
			),
			(
				"whole record reassignment",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/reassigned.brp",
					42,
					RECORD_LIMITS,
				),
			),
			(
				"generic function with record and mixed postfix",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/generic.brp",
					1,
					RECORD_LIMITS,
				),
			),
			(
				"nested literals and concrete UFCS context",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/context.brp",
					7,
					RECORD_LIMITS,
				),
			),
			(
				"flat 32 field record",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/wide.brp",
					31,
					RECORD_LIMITS,
				),
			),
			(
				"unused full width record fields",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/extrema.brp",
					0,
					RECORD_LIMITS,
				),
			),
		]
	}
