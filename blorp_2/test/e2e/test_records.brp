import:
	./cost: CostLimits
	./harness: argv_case, run_example, run_output_example, run_source_example, verify_rejected_command, with_directory
	system: file_exists, read_file, write_file
	test: TestSuite


private RECORD_LIMITS: CostLimits = {
	allocations = 140000,
	instructions = 500000000
}


func test_pair_returns_first_field(compiler: String) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/record/basic.brp", 7, RECORD_LIMITS)


private func verify_missing_field_diagnostic(
	compiler: String,
	directory: String,
) -> Result[Void, String]:
	source: String =
		|fixed record Pair { first: Int, second: Int }
		|pure func make_pair() -> Pair:
		|	{}
		|func main() -> Int:
		|	0
		|
	input = directory + "/missing.brp"
	output = directory + "/rejected.c"
	written ?= write_file(input, source)
	expected = input + ":3:2: error: missing field in record literal\nhelp: provide every declared record field exactly once\n" + input + ":1:21: note: record field declared here\n"
	rejected ?= verify_rejected_command(compiler, input, output, expected)

	unpublished ?= if file_exists(output):
		Err("invalid record published C output")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve record output")
	rejected_existing ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)

	if actual == "preserve record output":
		Ok(void)
	else:
		Err("invalid record overwrote existing C output")


func test_missing_field_note_and_output_preservation(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_missing_field_diagnostic(compiler, directory))


private func verify_recursive_record_diagnostic(
	compiler: String,
	directory: String,
	fixture: String,
	location: String,
) -> Result[Void, String]:
	input = "blorp_2/test/e2e/fixtures/record/" + fixture + ".brp"
	output = directory + "/rejected.c"
	expected = input + ":" + location + ": error: recursive aggregate types are not supported yet\nhelp: use finite record and union fields; a non-generic union may refer to itself only as one direct variant payload, such as Next(Node)\n"
	rejected ?= verify_rejected_command(compiler, input, output, expected)

	unpublished ?= if file_exists(output):
		Err("recursive record published C output")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve recursive record output")
	rejected_existing ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)

	if actual == "preserve recursive record output":
		Ok(void)
	else:
		Err("recursive record overwrote existing C output")


private func test_list_field_and_owned_lookup(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "record List field and owned element lookup",
			fixture = "blorp_2/test/e2e/fixtures/record/list_field.brp",
			expected_c = None,
			first_case = argv_case("record and lookup preserve argument bytes", ["kept é🙂", "unused"], 0, "3\nkept é🙂\n"),
			remaining_cases = [
				argv_case("empty argument remains present", [""], 0, "2\n\n"),
				argv_case("missing argument remains absent", [], 1, "1\nmissing\n"),
			],
			limits = RECORD_LIMITS
		},
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Fixed records",
		tests = [
			(
				"missing field diagnostic note and output preservation",
				func(): test_missing_field_note_and_output_preservation(compiler),
			),
			("unused directly recursive record rejects without publishing C", func(): with_directory(
					func(directory: String): verify_recursive_record_diagnostic(compiler, directory, "recursive_direct", "1:27"),
				)),
			("mutually recursive pass through records preserve existing output", func(): with_directory(
					func(directory: String): verify_recursive_record_diagnostic(compiler, directory, "recursive_mutual", "2:29"),
				)),
			("record through instantiated union rejects with exact diagnostic", func(): with_directory(
					func(directory: String): verify_recursive_record_diagnostic(compiler, directory, "recursive_union", "3:27"),
				)),
			("pair returns its first field", func(): test_pair_returns_first_field(compiler)),
			(
				"reordered second nominal record",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/reordered.brp",
					9,
					RECORD_LIMITS,
				),
			),
			(
				"record alias survives reassignment",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/aliases.brp",
					7,
					RECORD_LIMITS,
				),
			),
			(
				"whole record reassignment",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/reassigned.brp",
					42,
					RECORD_LIMITS,
				),
			),
			(
				"generic function with record and mixed postfix",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/generic.brp",
					1,
					RECORD_LIMITS,
				),
			),
			(
				"nested literals and concrete UFCS context",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/context.brp",
					7,
					RECORD_LIMITS,
				),
			),
			(
				"flat 32 field record",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/wide.brp",
					31,
					RECORD_LIMITS,
				),
			),
			(
				"unused full width record fields",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/record/extrema.brp",
					0,
					RECORD_LIMITS,
				),
			),
			("managed mixed record returns an owned String projection", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/mixed.brp", 2, RECORD_LIMITS,
				)),
			("mixed record fields preserve Int Float and String values", func(): run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/record/mixed_fields.brp", "7\n2.5\n42\n", RECORD_LIMITS,
				)),
			("nested scalar records preserve numeric fields", func(): run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/record/scalar_nested_field.brp", "7\n2.5\n9\n", RECORD_LIMITS,
				)),
			("two stored String occurrences have independent owners", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/shared_string.brp", 4, RECORD_LIMITS,
				)),
			("two stored record occurrences preserve both child values", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/shared_record.brp", 4, RECORD_LIMITS,
				)),
			("unused managed record follows normal root cleanup", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/unused_managed.brp", 0, RECORD_LIMITS,
				)),
			("nested owned results outlive each temporary parent", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/nested_escape.brp", 2, RECORD_LIMITS,
				)),
			("nested field projections outlive intermediate parents", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/nested_projection.brp", 2, RECORD_LIMITS,
				)),
			("record alias retains old fields across whole reassignment", func(): run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/record/managed_aliases.brp", "42\n42\n7\n7\n", RECORD_LIMITS,
				)),
			("borrowed record identity returns an independent owner", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/identity_escape.brp", 2, RECORD_LIMITS,
				)),
			("managed self assignment preserves the existing value", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/managed_self_assignment.brp", 2, RECORD_LIMITS,
				)),
			("identity reassignment establishes its owner before replacement", func(): run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/record/identity_reassignment.brp", "42\n42\n42\n7\n", RECORD_LIMITS,
				)),
			("generic union carries an owning record through a borrowed match", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/union_payload.brp", 2, RECORD_LIMITS,
				)),
			("owning record payload survives union alias reassignment", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/union_aliases.brp", 2, RECORD_LIMITS,
				)),
			("record projection acquires an owning inline union", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/owning_union_field.brp", 2, RECORD_LIMITS,
				)),
			("nested inline union field keeps its String alive", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/nested_union_field.brp", 2, RECORD_LIMITS,
				)),
			("record with unmanaged union handles both active variants", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/unmanaged_union_field.brp", 42, RECORD_LIMITS,
				)),
			("phantom String and record arguments remain valid record fields", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/phantom_union_fields.brp", 14, RECORD_LIMITS,
				)),
			("Void field is read from its temporary record", func(): run_source_example(
					compiler, "blorp_2/test/e2e/fixtures/record/void_field.brp", 0, RECORD_LIMITS,
				)),
			("record initializers evaluate once in written field order", func(): run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/record/field_order.brp", "3\nmiddle\n1\n1\n3\n", RECORD_LIMITS,
				)),
			("record List field and owned lookup survive temporary parents", func(): test_list_field_and_owned_lookup(compiler)),
		]
	}
