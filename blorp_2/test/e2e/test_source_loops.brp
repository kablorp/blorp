import:
	./harness: run_output_example, run_source_example
	test: TestSuite


-- Prospective feature ceilings fixed before candidate/native execution.
-- These witnesses remain pending until the common loop path accepts them.
pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 source loop control and managed headers",
		tests = [
			("List iteration sums through the normal main return", func(): run_source_example(
				compiler,
				"blorp_2/test/e2e/fixtures/source_loops/list_sum.brp",
				6,
				{ allocations = 300000, instructions = 1000000000 },
			)),
			("thirty two nested loops compile at default C limits", func(): run_output_example(
				compiler,
				"blorp_2/test/e2e/fixtures/source_loops/nesting.brp",
				"1\n",
				{ allocations = 1500000, instructions = 5000000000 },
			)),
			("source loops evaluate iterables once and target nearest control", func(): run_output_example(
				compiler,
				"blorp_2/test/e2e/fixtures/source_loops/control.brp",
				"0\n0\n0\n0\nlow\nhigh\n1\n2\nitems\n6\n6\ninner\nouter\ninner\nouter\n232\n",
				{ allocations = 600000, instructions = 2000000000 },
			)),
			("managed headers acquire repeated outgoing values before retiring aliases", func(): run_output_example(
				compiler,
				"blorp_2/test/e2e/fixtures/source_loops/managed_headers.brp",
				"A?\nmiddle\nB!\nA!\nA!\nA\n3\n3\nS:B!A!B!\nB!\nA!\nB!\nB!\nA!\nB!\nB!\nB!\nA\nA\nB!\nA\nA\n",
				{ allocations = 1000000, instructions = 3000000000 },
			)),
		]
	}
