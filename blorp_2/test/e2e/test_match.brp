pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 payload construction and match source examples",
		tests = [
			("qualified flat patterns preserve captures", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/match/qualified_flat.brp", "42\n7\n1\n0\n", COMPANION_LIMITS,
			)),
			(
				"match returns payload with cost limits",
				func(): test_match_returns_payload(compiler),
			),
			("whole value capture", func(): test_whole_value_capture(compiler)),
			("empty constructor", func(): test_empty_constructor(compiler)),
			("whole empty capture", func(): test_whole_empty_capture(compiler)),
			("wildcard capture", func(): test_wildcard_capture(compiler)),
			("capture preserves parameter", func(): test_capture_preserves_the_parameter(compiler)),
			("sibling payload", func(): test_sibling_payload(compiler)),
			("sibling empty", func(): test_sibling_empty(compiler)),
			("selected arm", func(): test_selected_arm(compiler)),
			("scalar wildcard preserves scrutinee", func(): test_scalar_wildcard_preserves_the_scrutinee(compiler)),
			("constructor argument", func(): test_constructor_argument(compiler)),
			(
				"arm binding preserves original",
				func(): test_arm_binding_preserves_original(compiler),
			),
			("arm binding returns current", func(): test_arm_binding_returns_current(compiler)),
			("arm binding empty branch", func(): test_arm_binding_empty_branch(compiler)),
			(
				"arm binding preserves outer local",
				func(): test_arm_binding_preserves_the_outer_local(compiler),
			),
			("flat C for 256 arms and constructor spine", func(): test_match_structure(compiler)),
			(
				"rejected matches preserve output and exact diagnostics",
				func(): test_rejected_matches_preserve_output(compiler),
			),
		]
	}
