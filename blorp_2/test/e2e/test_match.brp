import:
	../unit/compilation: compile
	./cost: CostLimits
	./harness:
		Example,
		check_resource_limits,
		measure_compilation_cost,
		native_case,
		remove_existing_file,
		run_output_example,
		run_source_example,
		verify_native_result,
		verify_rejected_command,
		with_directory,
	system: file_exists, read_file, write_file
	result: map_err
	test: TestSuite


private COMPANION_LIMITS: CostLimits = {
	allocations = 140000,
	instructions = 500000000
}

private STRESS_LIMITS: CostLimits = {
	allocations = 230000,
	instructions = 900000000
}

-- These bounds describe the retained match_many_arms fixture and the emitted
-- selector node and shared arm blocks; they do not inventory arbitrary inputs.
private STRESS_ARM_COUNT: Int = 256

private MAXIMUM_MATCH_BRACE_DEPTH: Int = 3

private FIXTURE: String = "blorp_2/test/e2e/fixtures/match/value.brp"

private VALUE_HEADER: String =
	|fixed union Value:
	|	Empty
	|	Number(Int)
	|


private func verify_fixture(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "match_value",
		library_root = "blorp_2/standard_library",
		fixture = FIXTURE,
		expected_c = None,
		first_case = native_case("native output", "", 42, ""),
		remaining_cases = [],
		limits = {
			allocations = 135000,
			instructions = 500000000
		}
	}
	cost ?= measure_compilation_cost(compiler, directory, example)
	native ?= verify_native_result(directory, example.first_case.exit_status)
	check_resource_limits(cost, example.limits)


private pure func maximum_brace_depth(program: String) -> Int:
	var depth = 0
	var maximum = 0

	for position in 0..program.length():
		byte = program.substring(position, 1)

		if byte == "{":
			depth += 1
			maximum = max(maximum, depth)
		else if byte == "}":
			depth -= 1

	maximum


private func verify_structure(compiler: String, directory: String) -> Result[Void, String]:
	stress: Example = {
		name = "match_many_arms",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/match/many_arms.brp",
		expected_c = None,
		first_case = native_case("native output", "", 42, ""),
		remaining_cases = [],
		limits = STRESS_LIMITS
	}
	cost ?= measure_compilation_cost(compiler, directory, stress)
	-- Isolate this structural oracle from unrelated default-library helpers.
	-- The native run below still executes C from the real loader and prelude.
	source ?= read_file(stress.fixture)
	program ?= compile(source).map_err(pure func(errors): errors.first.message)
	depth = maximum_brace_depth(program)

	-- Each source arm has one body label and one incoming edge. Check each
	-- identity so duplicated or omitted bodies cannot hide behind a total.
	var complete = program.count("_arm_") == STRESS_ARM_COUNT * 2
	for position in 0..STRESS_ARM_COUNT:
		arm = "_arm_".append_int(position)
		complete = complete and program.count(arm + ":{") == 1 and program.count(arm + ";") == 1

	labels ?= if complete:
		Ok(void)
	else:
		Err("match C must retain one body and incoming edge for every explicit constructor arm")

	flat ?= if depth <= MAXIMUM_MATCH_BRACE_DEPTH:
		Ok(void)
	else:
		Err("match C nesting grows with its arm count")

	verified ?= verify_native_result(directory, stress.first_case.exit_status)
	print(
		"match variants=".append_int(
			STRESS_ARM_COUNT,
		) + "; isolated phase C bytes=".append_int(program.length()) + "; brace depth=".append_int(depth),
	)
	spine: Example = {
		name = "match_constructor_spine",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/match/constructor_spine.brp",
		expected_c = None,
		first_case = native_case("native output", "", 42, ""),
		remaining_cases = [],
		limits = STRESS_LIMITS
	}
	spine_cost ?= measure_compilation_cost(compiler, directory, spine)
	spine_verified ?= verify_native_result(directory, spine.first_case.exit_status)
	bounded ?= check_resource_limits(cost, STRESS_LIMITS)
	check_resource_limits(spine_cost, STRESS_LIMITS)


private func verify_rejection(
	directory: String,
	compiler: String,
	source: String,
	expected: String,
) -> Result[Void, String]:
	input = directory + "/invalid.brp"
	output = directory + "/rejected.c"
	written ?= write_file(input, source)
	removed ?= remove_existing_file(output)
	rejected ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, input + expected)

	unpublished ?= if file_exists(output):
		Err("rejected match or construction published C")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve this output")
	rejected_existing ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, input + expected)
	actual ?= read_file(output)

	if actual == "preserve this output":
		Ok(void)
	else:
		Err("rejected match or construction overwrote existing C")


private func verify_rejections(compiler: String, directory: String) -> Result[Void, String]:
	choose_body: String =
		|pure func choose() -> Value:
		|	Empty
		|func main() -> Int:
		|	match choose():
		|
	missing_payload_body: String =
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Empty: 0
		|		Number(number): number
		|func main() -> Int:
		|	unwrap(Number())
		|
	inline_effect_source: String =
		|func effect() -> Int:
		|	9
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Empty: effect()
		|		Number(number): number
		|func main() -> Int:
		|	unwrap(Number(42))
		|
	block_effect_source: String =
		|func effect() -> Int:
		|	9
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Empty:
		|			unused = effect()
		|			0
		|		Number(number): number
		|func main() -> Int:
		|	unwrap(Number(42))
		|
	immutable_capture_source: String =
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Empty: 0
		|		Number(number):
		|			number = 1
		|			number
		|func main() -> Int:
		|	unwrap(Number(42))
		|
	choose = VALUE_HEADER + choose_body
	unwrap = VALUE_HEADER + missing_payload_body
	var result: Result[Void, String] = Ok(void)

	for (source, expected) in [
		(
			choose + "\t\tEmpty: 0\n",
			":7:2: error: non-exhaustive match\nhelp: add an arm for the missing variant: Number(_)\n",
		),
		(
			choose + "\t\tEmpty: 0\n\t\tEmpty: 1\n\t\tNumber(number): number\n",
			":9:3: error: match arm is unreachable\nhelp: remove this arm; earlier arms already cover all values it could match\n",
		),
		(
			choose + "\t\tEmpty:\n\t\t\tunused = 0\n\t\tNumber(number): number\n",
			":8:3: error: match arm has no final value\nhelp: finish the arm with a value expression on its own indented line\n",
		),
		(
			unwrap,
			":9:9: error: constructor field count does not match its declaration\nhelp: expected 1 fields, got 0; pass one expression per declared field\n",
		),
		(
			VALUE_HEADER + inline_effect_source,
			":8:10: error: pure functions cannot call impure functions\nhelp: mark the callee pure or remove pure from the caller\n",
		),
		(
			VALUE_HEADER + block_effect_source,
			":9:13: error: pure functions cannot call impure functions\nhelp: mark the callee pure or remove pure from the caller\n",
		),
		(
			VALUE_HEADER + immutable_capture_source,
			":8:4: error: cannot assign to an immutable binding\nhelp: declare the binding with var to allow reassignment\n",
		),
	]:
		result = verify_rejection(directory, compiler, source, expected)

		match result:
			Err(_):
				break
			Ok(_):
				void

	result


func test_match_returns_payload(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_fixture(compiler, directory))


func test_match_structure(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_structure(compiler, directory))


func test_rejected_matches_preserve_output(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_rejections(compiler, directory))


func test_whole_value_capture(compiler: String) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/match/values.brp", 42, COMPANION_LIMITS)


