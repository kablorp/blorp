import:
	cost: CostLimits
	harness: Example, argv_case, run_example, run_output_example
	test: TestSuite


-- Measured normal fixture compilations with separate stress headroom.
private INTEGER_LIMITS: CostLimits = { allocations = 235000, instructions = 700000000 }

private FLOAT_LIMITS: CostLimits = { allocations = 250000, instructions = 740000000 }

-- New source-literal NUL fixture: 68,969 allocations and 190.5M instructions.
private NUL_LIMITS: CostLimits = { allocations = 206000, instructions = 610000000 }

private PROJECTION_LIMITS: CostLimits = { allocations = 260000, instructions = 800000000 }


private pure func integer_example() -> Example:
	{
		name = "integer conversion",
		fixture = "blorp_2/test/e2e/fixtures/conversion/integer.brp",
		expected_c = None,
		first_case = argv_case("minimum", ["-9223372036854775808"], 0, "-9223372036854775808\n"),
		remaining_cases = [
			argv_case("maximum", ["9223372036854775807"], 0, "9223372036854775807\n"),
			argv_case("zero", ["0"], 0, "0\n"),
			argv_case("positive sign and leading zeros", ["+00042"], 0, "42\n"),
			argv_case("negative zero", ["-0"], 0, "0\n"),
			argv_case("positive overflow", ["9223372036854775808"], 1, "invalid integer\n"),
			argv_case("negative overflow", ["-9223372036854775809"], 1, "invalid integer\n"),
			argv_case("sign without digits", ["+"], 1, "invalid integer\n"),
			argv_case("minus without digits", ["-"], 1, "invalid integer\n"),
			argv_case("leading space", [" 42"], 1, "invalid integer\n"),
			argv_case("trailing space", ["42 "], 1, "invalid integer\n"),
			argv_case("CR is not stripped", ["42\r"], 1, "invalid integer\n"),
			argv_case("suffix", ["42x"], 1, "invalid integer\n"),
			argv_case("hexadecimal", ["0x2a"], 1, "invalid integer\n"),
			argv_case("digit separator", ["4_2"], 1, "invalid integer\n"),
			argv_case("non ASCII digits", ["٤٢"], 1, "invalid integer\n"),
			argv_case("empty argument", [""], 1, "invalid integer\n"),
			argv_case("missing argument", [], 1, "missing input\n"),
			argv_case("newline inside numeric argument is rejected", ["42\n"], 1, "invalid integer\n"),
			argv_case("extra arguments ignored", ["42", "99"], 0, "42\n"),
			argv_case("long overflow does not overflow accumulator", ["9".repeat(65536)], 1, "invalid integer\n"),
		],
		limits = INTEGER_LIMITS
	}


private pure func float_example() -> Example:
	{
		name = "Float conversion",
		fixture = "blorp_2/test/e2e/fixtures/conversion/float.brp",
		expected_c = None,
		first_case = argv_case("integer only mantissa", ["42"], 0, "42\n"),
		remaining_cases = [
			argv_case("negative zero", ["-0.0"], 0, "-0\n"),
			argv_case("sign leading zeros and exponent", ["+001.25e1"], 0, "12.5\n"),
			argv_case("decimal mantissa", ["6.5"], 0, "6.5\n"),
			argv_case("signed exponent", ["1e+2"], 0, "100\n"),
			argv_case("seventeen digit precision", ["1.2345678901234567"], 0, "1.2345678901234567\n"),
			argv_case("integer halfway rounds to even", ["9007199254740993"], 0, "9007199254740992\n"),
			argv_case("decimal halfway at one rounds to even", ["1.00000000000000011102230246251565404236316680908203125"], 0, "1\n"),
			argv_case("decimal above halfway rounds to adjacent value", ["1.00000000000000011102230246251565404236316680908203126"], 0, "1.0000000000000002\n"),
			argv_case("maximum finite", ["1.7976931348623157e308"], 0, "1.7976931348623157e+308\n"),
			argv_case("minimum normal", ["2.2250738585072014e-308"], 0, "2.2250738585072014e-308\n"),
			argv_case("minimum subnormal", ["5e-324"], 0, "4.94066e-324\n"),
			argv_case("positive underflow", ["1e-9999"], 0, "0\n"),
			argv_case("negative underflow", ["-1e-9999"], 0, "-0\n"),
			argv_case("overflow", ["1e309"], 1, "invalid float\n"),
			argv_case("NaN spelling", ["nan"], 1, "invalid float\n"),
			argv_case("infinity spelling", ["inf"], 1, "invalid float\n"),
			argv_case("hexadecimal mantissa", ["0x1p2"], 1, "invalid float\n"),
			argv_case("digit separator", ["1_0.0"], 1, "invalid float\n"),
			argv_case("missing integer digits", [".5"], 1, "invalid float\n"),
			argv_case("missing fractional digits", ["1."], 1, "invalid float\n"),
			argv_case("missing exponent digits", ["1e+"], 1, "invalid float\n"),
			argv_case("sign without digits", ["+"], 1, "invalid float\n"),
			argv_case("leading whitespace", [" 6.5"], 1, "invalid float\n"),
			argv_case("trailing whitespace", ["6.5 "], 1, "invalid float\n"),
			argv_case("CR is not stripped", ["6.5\r"], 1, "invalid float\n"),
			argv_case("non ASCII digits", ["٦.٥"], 1, "invalid float\n"),
			argv_case("suffix", ["6.5x"], 1, "invalid float\n"),
			argv_case("empty argument", [""], 1, "invalid float\n"),
			argv_case("missing argument", [], 1, "missing input\n"),
			argv_case("newline inside numeric argument is rejected", ["6.5\n"], 1, "invalid float\n"),
			argv_case("long mantissa remains bounded", ["9".repeat(65536)], 1, "invalid float\n"),
			argv_case("extra arguments ignored", ["6.5", "invalid"], 0, "6.5\n"),
		],
		limits = FLOAT_LIMITS
	}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 strict numeric conversion",
		tests = [
			("integer conversion inputs", func(): run_example(compiler, integer_example())),
			("Float conversion inputs", func(): run_example(compiler, float_example())),
			("source literals retain numeric and equality NUL regressions", func(): run_output_example(
					compiler,
					"blorp_2/test/e2e/fixtures/conversion/nul_bytes.brp",
					"invalid integer\ninvalid float\nsame\ndifferent\n",
					NUL_LIMITS,
				)),
			("64 ADT result projections preserve output and cleanup", func(): run_output_example(
					compiler,
					"blorp_2/test/e2e/fixtures/conversion/projection_stress.brp",
					"42\n".repeat(64),
					PROJECTION_LIMITS,
				)),
		]
	}
