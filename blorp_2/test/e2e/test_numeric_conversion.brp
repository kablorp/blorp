import:
	cost: CostLimits
	harness: Example, native_case, run_example, run_output_example
	test: TestSuite


-- Measured normal fixture compilations with separate stress headroom.
private INTEGER_LIMITS: CostLimits = { allocations = 105000, instructions = 300000000 }

private FLOAT_LIMITS: CostLimits = { allocations = 120000, instructions = 340000000 }

private PROJECTION_LIMITS: CostLimits = { allocations = 130000, instructions = 400000000 }


private pure func integer_example() -> Example:
	{
		name = "integer conversion",
		fixture = "blorp_2/test/e2e/fixtures/conversion/integer.brp",
		expected_c = None,
		first_case = native_case("minimum", "-9223372036854775808\n", 0, "-9223372036854775808\n"),
		remaining_cases = [
			native_case("maximum", "9223372036854775807\n", 0, "9223372036854775807\n"),
			native_case("zero", "0\n", 0, "0\n"),
			native_case("positive sign and leading zeros", "+00042\n", 0, "42\n"),
			native_case("negative zero", "-0\n", 0, "0\n"),
			native_case("positive overflow", "9223372036854775808\n", 1, "invalid integer\n"),
			native_case("negative overflow", "-9223372036854775809\n", 1, "invalid integer\n"),
			native_case("sign without digits", "+\n", 1, "invalid integer\n"),
			native_case("minus without digits", "-\n", 1, "invalid integer\n"),
			native_case("leading space", " 42\n", 1, "invalid integer\n"),
			native_case("trailing space", "42 \n", 1, "invalid integer\n"),
			native_case("CR is not stripped", "42\r\n", 1, "invalid integer\n"),
			native_case("suffix", "42x\n", 1, "invalid integer\n"),
			native_case("NUL followed by digits", "42\0" + "123\n", 1, "invalid integer\n"),
			native_case("hexadecimal", "0x2a\n", 1, "invalid integer\n"),
			native_case("digit separator", "4_2\n", 1, "invalid integer\n"),
			native_case("non ASCII digits", "٤٢\n", 1, "invalid integer\n"),
			native_case("empty line", "\n", 1, "invalid integer\n"),
			native_case("EOF", "", 1, "missing input\n"),
			native_case("unterminated final line", "42", 0, "42\n"),
			native_case("extra lines ignored", "42\n99\n", 0, "42\n"),
			native_case("long overflow does not overflow accumulator", "9".repeat(65536) + "\n", 1, "invalid integer\n"),
		],
		limits = INTEGER_LIMITS
	}


private pure func float_example() -> Example:
	{
		name = "Float conversion",
		fixture = "blorp_2/test/e2e/fixtures/conversion/float.brp",
		expected_c = None,
		first_case = native_case("integer only mantissa", "42\n", 0, "42\n"),
		remaining_cases = [
			native_case("negative zero", "-0.0\n", 0, "-0\n"),
			native_case("sign leading zeros and exponent", "+001.25e1\n", 0, "12.5\n"),
			native_case("decimal mantissa", "6.5\n", 0, "6.5\n"),
			native_case("signed exponent", "1e+2\n", 0, "100\n"),
			native_case("seventeen digit precision", "1.2345678901234567\n", 0, "1.2345678901234567\n"),
			native_case("integer halfway rounds to even", "9007199254740993\n", 0, "9007199254740992\n"),
			native_case("decimal halfway at one rounds to even", "1.00000000000000011102230246251565404236316680908203125\n", 0, "1\n"),
			native_case("decimal above halfway rounds to adjacent value", "1.00000000000000011102230246251565404236316680908203126\n", 0, "1.0000000000000002\n"),
			native_case("maximum finite", "1.7976931348623157e308\n", 0, "1.7976931348623157e+308\n"),
			native_case("minimum normal", "2.2250738585072014e-308\n", 0, "2.2250738585072014e-308\n"),
			native_case("minimum subnormal", "5e-324\n", 0, "4.94066e-324\n"),
			native_case("positive underflow", "1e-9999\n", 0, "0\n"),
			native_case("negative underflow", "-1e-9999\n", 0, "-0\n"),
			native_case("overflow", "1e309\n", 1, "invalid float\n"),
			native_case("NaN spelling", "nan\n", 1, "invalid float\n"),
			native_case("infinity spelling", "inf\n", 1, "invalid float\n"),
			native_case("hexadecimal mantissa", "0x1p2\n", 1, "invalid float\n"),
			native_case("digit separator", "1_0.0\n", 1, "invalid float\n"),
			native_case("missing integer digits", ".5\n", 1, "invalid float\n"),
			native_case("missing fractional digits", "1.\n", 1, "invalid float\n"),
			native_case("missing exponent digits", "1e+\n", 1, "invalid float\n"),
			native_case("sign without digits", "+\n", 1, "invalid float\n"),
			native_case("leading whitespace", " 6.5\n", 1, "invalid float\n"),
			native_case("trailing whitespace", "6.5 \n", 1, "invalid float\n"),
			native_case("CR is not stripped", "6.5\r\n", 1, "invalid float\n"),
			native_case("NUL followed by digits", "6.5\0" + "123\n", 1, "invalid float\n"),
			native_case("non ASCII digits", "٦.٥\n", 1, "invalid float\n"),
			native_case("suffix", "6.5x\n", 1, "invalid float\n"),
			native_case("empty line", "\n", 1, "invalid float\n"),
			native_case("EOF", "", 1, "missing input\n"),
			native_case("unterminated final line", "6.5", 0, "6.5\n"),
			native_case("long mantissa remains bounded", "9".repeat(65536) + "\n", 1, "invalid float\n"),
		],
		limits = FLOAT_LIMITS
	}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 strict numeric conversion",
		tests = [
			("integer conversion inputs", func(): run_example(compiler, integer_example())),
			("Float conversion inputs", func(): run_example(compiler, float_example())),
			("64 ADT result projections preserve output and cleanup", func(): run_output_example(
					compiler,
					"blorp_2/test/e2e/fixtures/conversion/projection_stress.brp",
					"42\n".repeat(64),
					PROJECTION_LIMITS,
				)),
		]
	}
