import:
	bytes: bytes, set_index
	cost: CostLimits
	harness: NativeCase, native_case, run_example
	test: TestSuite


-- Fresh compilation measured 13,649 allocations and 63.5M instructions.
private LIMITS: CostLimits = {
	allocations = 17500,
	instructions = 85000000
}


private pure func non_utf8_case() -> NativeCase:
	{
		name = "non UTF-8 byte is preserved",
		stdin = bytes(2).set_index(0, 255).set_index(1, 10),
		exit_status = 0,
		stdout = bytes(2).set_index(0, 255).set_index(1, 10),
		stderr = "".to_bytes()
	}


private func run_inputs(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "line input",
			fixture = "blorp_2/test/e2e/fixtures/line_input/basic.brp",
			expected_c = None,
			first_case = native_case("LF is removed once", "text\n", 0, "text\n"),
			remaining_cases = [
				native_case("empty line is present", "\n", 0, "\n"),
				native_case("EOF has no line", "", 1, "EOF\n"),
				native_case("unterminated final line", "text", 0, "text\n"),
				native_case("CR is preserved", "text\r\n", 0, "text\r\n"),
				native_case("NUL and following digits are preserved", "a\0" + "123\n", 0, "a\0" + "123\n"),
				native_case("multiple UTF-8 scalars are preserved", "é🙂\n", 0, "é🙂\n"),
				native_case("next line is not included", "first\nsecond\n", 0, "first\n"),
				native_case("empty line before another line", "\nsecond\n", 0, "\n"),
				native_case("long line grows input buffer", "x".repeat(65536) + "\n", 0, "x".repeat(65536) + "\n"),
				non_utf8_case(),
			],
			limits = LIMITS
		},
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 line input bytes and EOF",
		tests = [("line input cases", func(): run_inputs(compiler))]
	}
