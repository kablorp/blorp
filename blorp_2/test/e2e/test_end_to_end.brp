import:
	harness: build_compiler
	test: TestSuite, run_suite_result
	test_bindings as Bindings
	test_calculator as Calculator
	test_call_one as CallOne
	test_direct_union_payloads as DirectUnionPayloads
	test_effects as Effects
	test_frontend as Frontend
	test_generics as Generics
	test_generic_records as GenericRecords
	test_imports as Imports
	test_int_add as IntAdd
	test_integer_literals as IntegerLiterals
	test_lists as Lists
	test_argument_input as ArgumentInput
	test_match as Match
	test_main_signatures as MainSignatures
	test_multiple_union_fields as MultipleUnionFields
	test_nested_calls as NestedCalls
	test_numeric_conversion as NumericConversion
	test_option_input as OptionInput
	test_owned_prefix as OwnedPrefix
	test_pure_calls as PureCalls
	test_records as Records
	test_record_updates as RecordUpdates
	test_recursion as Recursion
	test_return_zero as ReturnZero
	test_string_literals as StringLiterals
	test_strings as Strings
	test_tail_recursion as TailRecursion
	test_ufcs as Ufcs
	test_unions as Unions


func run_end_to_end() -> Bool:
	match build_compiler():
		Err(error):
			print_error(error)
			False
		Ok(compiler):
			var passed = 0
			var failed = 0

			for group in [
				ReturnZero.suite(compiler),
				CallOne.suite(compiler),
				PureCalls.suite(compiler),
				NestedCalls.suite(compiler),
				Ufcs.suite(compiler),
				Unions.suite(compiler),
				DirectUnionPayloads.suite(compiler),
				MultipleUnionFields.suite(compiler),
				Records.suite(compiler),
				RecordUpdates.suite(compiler),
				GenericRecords.suite(compiler),
				OwnedPrefix.suite(compiler),
				Recursion.suite(compiler),
				TailRecursion.suite(compiler),
				IntegerLiterals.suite(compiler),
				Match.suite(compiler),
				Bindings.suite(compiler),
				Strings.suite(compiler),
				StringLiterals.suite(compiler),
				Generics.suite(compiler),
				Imports.suite(compiler),
				IntAdd.suite(compiler),
				Effects.suite(compiler),
				MainSignatures.suite(compiler),
				OptionInput.suite(compiler),
				ArgumentInput.suite(compiler),
				Lists.suite(compiler),
				NumericConversion.suite(compiler),
				Calculator.suite(compiler),
				Frontend.suite(),
			]:
				result = run_suite_result(group)
				passed += result[0]
				failed += result[1]

			print("E2e cases: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
			failed == 0


tests: TestSuite = {
	description = "Blorp 2 end to end",
	tests = [("build once and run every fixture group", run_end_to_end)]
}
