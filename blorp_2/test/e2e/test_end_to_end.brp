import:
	harness: build_compiler
	test: TestSuite, run_suite_result
	test_bindings as Bindings
	test_call_one as CallOne
	test_frontend as Frontend
	test_integer_literals as IntegerLiterals
	test_match as Match
	test_nested_calls as NestedCalls
	test_pure_calls as PureCalls
	test_return_zero as ReturnZero
	test_ufcs as Ufcs
	test_unions as Unions


func run_end_to_end() -> Bool:
	match build_compiler():
		Err(error):
			print_error(error)
			False
		Ok(compiler):
			var passed = 0
			var failed = 0

			for group in [
				ReturnZero.suite(compiler),
				CallOne.suite(compiler),
				PureCalls.suite(compiler),
				NestedCalls.suite(compiler),
				Ufcs.suite(compiler),
				Unions.suite(compiler),
				IntegerLiterals.suite(compiler),
				Match.suite(compiler),
				Bindings.suite(compiler),
				Frontend.suite(),
			]:
				result = run_suite_result(group)
				passed += result[0]
				failed += result[1]

			print("E2e cases: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
			failed == 0


tests: TestSuite = {
	description = "Blorp 2 end to end",
	tests = [("build once and run every fixture group", run_end_to_end)]
}
