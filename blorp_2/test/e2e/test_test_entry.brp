import:
    ./harness: run_successfully, verify_native_output, with_directory
    test: TestSuite


private func entry(compiler: String, fixture: String, status: Int, output: String) -> Bool:
    with_directory(func(directory):
        compiled ?= run_successfully(compiler, [
            "--library-root", "blorp_2/standard_library", "--test-suite",
            "blorp_2/test/e2e/fixtures/test_entry/" + fixture + ".brp",
            directory + "/program.c",
        ])
        verify_native_output(directory, status, output)
    )


private func counts(compiler: String) -> Bool:
    with_directory(func(directory):
        compiled ?= run_successfully(compiler, [
            "--library-root", "blorp_2/standard_library",
            "blorp_2/test/e2e/fixtures/test_entry/counts.brp",
            directory + "/program.c",
        ])
        verify_native_output(directory, 21, "\n>> counts Tests\n  [PASS] yes\n  [FAIL] no\n  [PASS] again\n\n1 of 3 tests failed\n")
    )


pure func suite(compiler: String) -> TestSuite:
    {
        description = "Blorp 2 constant suite registration",
        tests = [
            ("private pure and impure callbacks", func(): entry(compiler, "passing", 0, "\n>> registration Tests\n  [PASS] pure\neffect\n  [PASS] effect\n\nAll 2 tests passed\n")),
            ("failed callbacks preserve order and continued execution", func(): entry(compiler, "failing", 1, "\n>> continued registration Tests\nfirst\n  [FAIL] first case\nsecond\n  [PASS] second case\nthird\n  [FAIL] third case\n\n2 of 3 tests failed\n")),
            ("empty constant suite succeeds", func(): entry(compiler, "empty", 0, "\n>> empty registration Tests\n\nAll 0 tests passed\n")),
            ("imported visible suite uses its private callbacks", func(): entry(compiler, "imported", 0, "\n>> registration Tests\n  [PASS] pure\neffect\n  [PASS] effect\n\nAll 2 tests passed\n")),
            ("ordinary value runner returns exact TestCounts", func(): counts(compiler)),
        ]
    }
