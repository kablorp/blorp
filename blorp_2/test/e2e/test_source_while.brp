import:
	./harness: run_output_example
	test: TestSuite


-- Initial FEATURE limits fixed after the genuine unsupported RED and before
-- any candidate/native compilation. Existing shared-control limits are tighter.
pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 first source while",
		tests = [
			("nested scalar loops preserve inner state reset and borrowed PRE", func(): run_output_example(
				compiler,
				"blorp_2/test/e2e/fixtures/source_while/nested.brp",
				"0\n2\n6\n7\npre!xy\npre!xy\npre!x\npre!xy\npre!xy\npre!x\npre!\npre!\n",
				{ allocations = 300000, instructions = 1000000000 },
			)),
			("source location keeps borrowed PRE across UTF8 NUL and LF boundaries", func(): run_output_example(
				compiler,
				"blorp_2/test/e2e/fixtures/source_while/location.brp",
				"src:1:1\nsrc:1:2\nsrc:2:1\nsrc:3:1\nsrc:3:3\nsrc:3:4\nsrc:3:5\n",
				{ allocations = 150000, instructions = 500000000 },
			)),
			("condition runs n plus one times and mortal body aliases retire", func(): run_output_example(
				compiler,
				"blorp_2/test/e2e/fixtures/source_while/evaluation_order.brp",
				"c0\nb0\nc1\nb1\nc2\nb2\nc3\ndone103\n",
				{ allocations = 150000, instructions = 500000000 },
			)),
			("headers initialize once and swap from fresh snapshots", func(): run_output_example(
				compiler,
				"blorp_2/test/e2e/fixtures/source_while/header_swap.brp",
				"i1\ni2\n2\n1\n",
				{ allocations = 150000, instructions = 500000000 },
			)),
		]
	}
