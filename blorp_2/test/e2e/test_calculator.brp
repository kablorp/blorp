import:
	cost: CostLimits
	harness: Example, argv_case, run_example, run_output_example
	test: TestSuite


-- Measured normal fixture compilations; each bound retains modest headroom.
private ADDITION_LIMITS: CostLimits = { allocations = 240000, instructions = 710000000 }

private INTEGER_LIMITS: CostLimits = { allocations = 255000, instructions = 800000000 }

private FLOAT_LIMITS: CostLimits = { allocations = 270000, instructions = 800000000 }

private FLOAT_LITERAL_LIMITS: CostLimits = { allocations = 190000, instructions = 590000000 }

private FLOAT_STRESS_LIMITS: CostLimits = { allocations = 230000, instructions = 720000000 }


private pure func addition_example() -> Example:
	{
		name = "integer addition calculator",
		fixture = "blorp_2/test/e2e/fixtures/calculator/addition.brp",
		expected_c = None,
		first_case = argv_case("two decimal operands", ["20", "22"], 0, "42\n"),
		remaining_cases = [
			argv_case("signed operands and leading zeros", ["+020", "-002"], 0, "18\n"),
			argv_case("integer negative zero", ["-0", "0"], 0, "0\n"),
			argv_case("maximum addition wraps", ["9223372036854775807", "1"], 0, "-9223372036854775808\n"),
			argv_case("minimum addition wraps", ["-9223372036854775808", "-1"], 0, "9223372036854775807\n"),
			argv_case("above maximum is rejected", ["9223372036854775808", "0"], 1, "invalid integer\n"),
			argv_case("below minimum is rejected", ["-9223372036854775809", "0"], 1, "invalid integer\n"),
			argv_case("suffix is rejected", ["1x", "2"], 1, "invalid integer\n"),
			argv_case("empty operand is invalid", ["", "2"], 1, "invalid integer\n"),
			argv_case("first invalid operand wins over missing second", ["invalid"], 1, "invalid integer\n"),
			argv_case("spaces are not stripped", [" 20", "22"], 1, "invalid integer\n"),
			argv_case("missing operands", [], 1, "missing input\n"),
			argv_case("missing second operand", ["20"], 1, "missing input\n"),
			argv_case("newline inside numeric argument is rejected", ["20", "22\n"], 1, "invalid integer\n"),
			argv_case("extra arguments are ignored", ["20", "22", "99"], 0, "42\n"),
		],
		limits = ADDITION_LIMITS
	}


private pure func integer_example() -> Example:
	{
		name = "integer operation calculator",
		fixture = "blorp_2/test/e2e/fixtures/calculator/integer.brp",
		expected_c = None,
		first_case = argv_case("multiply", ["multiply", "6", "7"], 0, "42\n"),
		remaining_cases = [
			argv_case("add", ["add", "20", "22"], 0, "42\n"),
			argv_case("subtract", ["subtract", "6", "7"], 0, "-1\n"),
			argv_case("minimum subtraction wraps", ["subtract", "-9223372036854775808", "1"], 0, "9223372036854775807\n"),
			argv_case("division truncates toward zero", ["divide", "-7", "2"], 0, "-3\n"),
			argv_case("zero divisor returns zero", ["divide", "7", "0"], 0, "0\n"),
			argv_case("minimum divided by negative one wraps", ["divide", "-9223372036854775808", "-1"], 0, "-9223372036854775808\n"),
			argv_case("remainder follows dividend sign", ["remainder", "-7", "2"], 0, "-1\n"),
			argv_case("minimum remainder negative one is zero", ["remainder", "-9223372036854775808", "-1"], 0, "0\n"),
			argv_case("zero remainder divisor returns zero", ["remainder", "7", "0"], 0, "0\n"),
			argv_case("multiplication wraps", ["multiply", "9223372036854775807", "2"], 0, "-2\n"),
			argv_case("minimum multiplied by negative one wraps", ["multiply", "-9223372036854775808", "-1"], 0, "-9223372036854775808\n"),
			argv_case("unknown operation before operand validation", ["power"], 1, "unknown operation\n"),
			argv_case("unknown operation wins over invalid operands", ["power", "invalid", "invalid"], 1, "unknown operation\n"),
			argv_case("empty operation is unknown", [""], 1, "unknown operation\n"),
			argv_case("extra arguments are ignored", ["multiply", "6", "7", "invalid"], 0, "42\n"),
			argv_case("operation words are case sensitive", ["Multiply", "6", "7"], 1, "unknown operation\n"),
			argv_case("missing second operand", ["multiply", "6"], 1, "missing input\n"),
			argv_case("missing operation", [], 1, "missing input\n"),
			argv_case("missing first operand", ["multiply"], 1, "missing input\n"),
			argv_case("invalid first operand before missing second argument", ["multiply", "invalid"], 1, "invalid integer\n"),
			argv_case("invalid second operand", ["multiply", "6", "invalid"], 1, "invalid integer\n"),
			argv_case("CR in operation is not stripped", ["multiply\r", "6", "7"], 1, "unknown operation\n"),
		],
		limits = INTEGER_LIMITS
	}


private pure func float_example() -> Example:
	{
		name = "Float operation calculator",
		fixture = "blorp_2/test/e2e/fixtures/calculator/float.brp",
		expected_c = None,
		first_case = argv_case("multiply decimal operands", ["multiply", "6.5", "2"], 0, "13\n"),
		remaining_cases = [
			argv_case("addition needs seventeen digit precision", ["add", "0.1", "0.2"], 0, "0.30000000000000004\n"),
			argv_case("subtract", ["subtract", "1", "2"], 0, "-1\n"),
			argv_case("sign exponent and leading zeros", ["add", "+001.25e1", "-0.5"], 0, "12\n"),
			argv_case("negative zero is preserved", ["multiply", "-0", "2"], 0, "-0\n"),
			argv_case("negative zero divisor returns positive zero", ["divide", "1", "-0"], 0, "0\n"),
			argv_case("remainder truncates toward zero", ["remainder", "-7", "2"], 0, "-1\n"),
			argv_case("arithmetic overflow formats infinity", ["multiply", "1e308", "1e308"], 0, "inf\n"),
			argv_case("minimum subnormal round trips", ["multiply", "5e-324", "1"], 0, "4.94066e-324\n"),
			argv_case("underflow retains negative zero", ["multiply", "-1e-9999", "1"], 0, "-0\n"),
			argv_case("parse overflow is rejected", ["multiply", "1e309", "1"], 1, "invalid float\n"),
			argv_case("NaN input is rejected", ["multiply", "nan", "1"], 1, "invalid float\n"),
			argv_case("infinity input is rejected", ["multiply", "inf", "1"], 1, "invalid float\n"),
			argv_case("CR is preserved and rejected", ["multiply", "6.5\r", "2"], 1, "invalid float\n"),
			argv_case("missing second operand", ["multiply", "6.5"], 1, "missing input\n"),
			argv_case("missing operation", [], 1, "missing input\n"),
			argv_case("unknown operation wins over missing operands", ["power"], 1, "unknown operation\n"),
			argv_case("operation newline is not split", ["multiply\n6.5\n2"], 1, "unknown operation\n"),
			argv_case("missing first operand", ["multiply"], 1, "missing input\n"),
			argv_case("invalid first operand before missing second argument", ["multiply", "invalid"], 1, "invalid float\n"),
			argv_case("empty second operand", ["multiply", "6.5", ""], 1, "invalid float\n"),
			argv_case("newline inside numeric argument is rejected", ["multiply", "6.5", "2\n"], 1, "invalid float\n"),
			argv_case("extra arguments are ignored", ["multiply", "6.5", "2", "99"], 0, "13\n"),
		],
		limits = FLOAT_LIMITS
	}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 argument calculators",
		tests = [
			("integer addition inputs", func(): run_example(compiler, addition_example())),
			("integer operation inputs", func(): run_example(compiler, integer_example())),
			("Float operation inputs", func(): run_example(compiler, float_example())),
			("Float literals arithmetic and exceptional output", func(): run_output_example(
					compiler,
					"blorp_2/test/e2e/fixtures/calculator/float_literals.brp",
					"13\n0.30000000000000004\n-0\ninf\n-inf\nnan\n0\n0\n4.94066e-324\n1.7976931348623157e+308\n2.2250738585072014e-308\n",
					FLOAT_LITERAL_LIMITS,
				)),
			("64 Float literal calls preserve precision and order", func(): run_output_example(
					compiler,
					"blorp_2/test/e2e/fixtures/calculator/float_stress.brp",
					"0.30000000000000004\n".repeat(64),
					FLOAT_STRESS_LIMITS,
				)),
		]
	}
