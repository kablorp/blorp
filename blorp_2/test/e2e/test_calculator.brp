import:
	cost: CostLimits
	harness: Example, native_case, run_example, run_output_example
	test: TestSuite


-- Measured normal fixture compilations; each bound retains modest headroom.
private ADDITION_LIMITS: CostLimits = { allocations = 110000, instructions = 310000000 }

private INTEGER_LIMITS: CostLimits = { allocations = 125000, instructions = 400000000 }

private FLOAT_LIMITS: CostLimits = { allocations = 140000, instructions = 400000000 }

private FLOAT_LITERAL_LIMITS: CostLimits = { allocations = 60000, instructions = 190000000 }

private FLOAT_STRESS_LIMITS: CostLimits = { allocations = 100000, instructions = 320000000 }


private pure func addition_example() -> Example:
	{
		name = "integer addition calculator",
		fixture = "blorp_2/test/e2e/fixtures/calculator/addition.brp",
		expected_c = None,
		first_case = native_case("two decimal operands", "20\n22\n", 0, "42\n"),
		remaining_cases = [
			native_case("signed operands and leading zeros", "+020\n-002\n", 0, "18\n"),
			native_case("integer negative zero", "-0\n0\n", 0, "0\n"),
			native_case("maximum addition wraps", "9223372036854775807\n1\n", 0, "-9223372036854775808\n"),
			native_case("minimum addition wraps", "-9223372036854775808\n-1\n", 0, "9223372036854775807\n"),
			native_case("above maximum is rejected", "9223372036854775808\n0\n", 1, "invalid integer\n"),
			native_case("below minimum is rejected", "-9223372036854775809\n0\n", 1, "invalid integer\n"),
			native_case("suffix is rejected", "1x\n2\n", 1, "invalid integer\n"),
			native_case("digits after NUL are rejected", "1\0" + "123\n2\n", 1, "invalid integer\n"),
			native_case("empty operand is invalid", "\n2\n", 1, "invalid integer\n"),
			native_case("immediate EOF", "", 1, "missing input\n"),
			native_case("missing second operand", "20\n", 1, "missing input\n"),
			native_case("unterminated final operand", "20\n22", 0, "42\n"),
			native_case("extra lines are ignored", "20\n22\n99\n", 0, "42\n"),
		],
		limits = ADDITION_LIMITS
	}


private pure func integer_example() -> Example:
	{
		name = "integer operation calculator",
		fixture = "blorp_2/test/e2e/fixtures/calculator/integer.brp",
		expected_c = None,
		first_case = native_case("multiply", "multiply\n6\n7\n", 0, "42\n"),
		remaining_cases = [
			native_case("add", "add\n20\n22\n", 0, "42\n"),
			native_case("subtract", "subtract\n6\n7\n", 0, "-1\n"),
			native_case("minimum subtraction wraps", "subtract\n-9223372036854775808\n1\n", 0, "9223372036854775807\n"),
			native_case("division truncates toward zero", "divide\n-7\n2\n", 0, "-3\n"),
			native_case("zero divisor returns zero", "divide\n7\n0\n", 0, "0\n"),
			native_case("minimum divided by negative one wraps", "divide\n-9223372036854775808\n-1\n", 0, "-9223372036854775808\n"),
			native_case("remainder follows dividend sign", "remainder\n-7\n2\n", 0, "-1\n"),
			native_case("minimum remainder negative one is zero", "remainder\n-9223372036854775808\n-1\n", 0, "0\n"),
			native_case("zero remainder divisor returns zero", "remainder\n7\n0\n", 0, "0\n"),
			native_case("multiplication wraps", "multiply\n9223372036854775807\n2\n", 0, "-2\n"),
			native_case("minimum multiplied by negative one wraps", "multiply\n-9223372036854775808\n-1\n", 0, "-9223372036854775808\n"),
			native_case("unknown operation before operand reads", "power\n", 1, "unknown operation\n"),
			native_case("operation words are case sensitive", "Multiply\n6\n7\n", 1, "unknown operation\n"),
			native_case("missing second operand", "multiply\n6\n", 1, "missing input\n"),
			native_case("missing operation", "", 1, "missing input\n"),
			native_case("missing first operand", "multiply\n", 1, "missing input\n"),
			native_case("invalid first operand before EOF", "multiply\ninvalid\n", 1, "invalid integer\n"),
			native_case("invalid second operand", "multiply\n6\ninvalid\n", 1, "invalid integer\n"),
			native_case("CR in operation is not stripped", "multiply\r\n6\n7\n", 1, "unknown operation\n"),
			native_case("NUL in operation is not ignored", "multiply\0" + "123\n6\n7\n", 1, "unknown operation\n"),
		],
		limits = INTEGER_LIMITS
	}


private pure func float_example() -> Example:
	{
		name = "Float operation calculator",
		fixture = "blorp_2/test/e2e/fixtures/calculator/float.brp",
		expected_c = None,
		first_case = native_case("multiply decimal operands", "multiply\n6.5\n2\n", 0, "13\n"),
		remaining_cases = [
			native_case("addition needs seventeen digit precision", "add\n0.1\n0.2\n", 0, "0.30000000000000004\n"),
			native_case("subtract", "subtract\n1\n2\n", 0, "-1\n"),
			native_case("sign exponent and leading zeros", "add\n+001.25e1\n-0.5\n", 0, "12\n"),
			native_case("negative zero is preserved", "multiply\n-0\n2\n", 0, "-0\n"),
			native_case("negative zero divisor returns positive zero", "divide\n1\n-0\n", 0, "0\n"),
			native_case("remainder truncates toward zero", "remainder\n-7\n2\n", 0, "-1\n"),
			native_case("arithmetic overflow formats infinity", "multiply\n1e308\n1e308\n", 0, "inf\n"),
			native_case("minimum subnormal round trips", "multiply\n5e-324\n1\n", 0, "4.94066e-324\n"),
			native_case("underflow retains negative zero", "multiply\n-1e-9999\n1\n", 0, "-0\n"),
			native_case("parse overflow is rejected", "multiply\n1e309\n1\n", 1, "invalid float\n"),
			native_case("NaN input is rejected", "multiply\nnan\n1\n", 1, "invalid float\n"),
			native_case("infinity input is rejected", "multiply\ninf\n1\n", 1, "invalid float\n"),
			native_case("CR is preserved and rejected", "multiply\n6.5\r\n2\n", 1, "invalid float\n"),
			native_case("digits after NUL are rejected", "multiply\n6.5\0" + "123\n2\n", 1, "invalid float\n"),
			native_case("missing second operand", "multiply\n6.5\n", 1, "missing input\n"),
			native_case("missing operation", "", 1, "missing input\n"),
			native_case("missing first operand", "multiply\n", 1, "missing input\n"),
			native_case("invalid first operand before EOF", "multiply\ninvalid\n", 1, "invalid float\n"),
			native_case("empty second operand", "multiply\n6.5\n\n", 1, "invalid float\n"),
			native_case("unterminated final operand", "multiply\n6.5\n2", 0, "13\n"),
			native_case("extra lines are ignored", "multiply\n6.5\n2\n99\n", 0, "13\n"),
		],
		limits = FLOAT_LIMITS
	}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 stdin calculators",
		tests = [
			("integer addition inputs", func(): run_example(compiler, addition_example())),
			("integer operation inputs", func(): run_example(compiler, integer_example())),
			("Float operation inputs", func(): run_example(compiler, float_example())),
			("Float literals arithmetic and exceptional output", func(): run_output_example(
					compiler,
					"blorp_2/test/e2e/fixtures/calculator/float_literals.brp",
					"13\n0.30000000000000004\n-0\ninf\n-inf\nnan\n0\n0\n4.94066e-324\n1.7976931348623157e+308\n2.2250738585072014e-308\n",
					FLOAT_LITERAL_LIMITS,
				)),
			("64 Float literal calls preserve precision and order", func(): run_output_example(
					compiler,
					"blorp_2/test/e2e/fixtures/calculator/float_stress.brp",
					"0.30000000000000004\n".repeat(64),
					FLOAT_STRESS_LIMITS,
				)),
		]
	}
