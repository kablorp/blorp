import:
	./harness: Example, argv_case, native_case, verify_all, with_directory
	test: TestSuite

private func verify_arguments(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "ordinary target String starts_with",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/string_starts_with/arguments.brp", expected_c = None,
		first_case = argv_case("two empty", ["", ""], 0, "1\n1\n"),
		remaining_cases = [
			argv_case("empty prefix", ["abc", ""], 0, "1\n1\n"),
			argv_case("empty value", ["", "a"], 0, "0\n0\n"),
			argv_case("equal", ["hello", "hello"], 0, "1\n1\n"),
			argv_case("proper prefix", ["hello world", "hello"], 0, "1\n1\n"),
			argv_case("long prefix", ["he", "hello"], 0, "0\n0\n"),
			argv_case("first mismatch", ["abc", "xbc"], 0, "0\n0\n"),
			argv_case("middle mismatch", ["abc", "ax"], 0, "0\n0\n"),
			argv_case("last mismatch", ["ab", "ac"], 0, "0\n0\n"),
			argv_case("case sensitive", ["Hello", "hello"], 0, "0\n0\n"),
			argv_case("UTF8 prefix", ["é/树", "é"], 0, "1\n1\n"),
			argv_case("emoji prefix", ["🙂x", "🙂"], 0, "1\n1\n"),
			argv_case("different scalar", ["é", "ê"], 0, "0\n0\n"),
			argv_case("combining spelling differs", ["é/x", "é"], 0, "0\n0\n"),
			argv_case("library boundary", ["/library/module.brp", "/library/"], 0, "1\n1\n"),
			argv_case("library sibling", ["/library-extra/module.brp", "/library/"], 0, "0\n0\n"),
			argv_case("library root is not its prefix", ["/library", "/library/"], 0, "0\n0\n"),
			argv_case("LF counted", ["a\nb", "a\n"], 0, "1\n1\n"),
			argv_case("4096 matching bytes", ["", ""], 0, "1\n1\n"),
			argv_case("late mismatch at4095", ["", ""], 0, "0\n0\n"),
		],
		limits = { allocations = 150000, instructions = 600000000 }
	}
	verify_all(compiler, directory, example)

private func verify_counted(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "target String starts_with counted aliases",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/string_starts_with/counted_aliases.brp", expected_c = None,
		first_case = native_case("counted NUL and surviving aliases", "", 0, "1\n0\n0\n1\n1\né\0tail\né\0tail\né\0tail\n"),
		remaining_cases = [],
		limits = { allocations = 150000, instructions = 600000000 }
	}
	verify_all(compiler, directory, example)

pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 ordinary target String starts_with",
		tests = [
			("literal argv edge table", func(): with_directory(func(directory: String): verify_arguments(compiler, directory))),
			("counted NUL and lifetime routes", func(): with_directory(func(directory: String): verify_counted(compiler, directory))),
		]
	}
