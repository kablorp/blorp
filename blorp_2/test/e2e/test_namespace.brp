import:
	./cost: CostLimits
	./harness: run_output_example, verify_rejected_command, with_directory
	test: TestSuite


-- Ordinary Contains is checked with the default library on every compile.
-- Only measured native fields carry this increment's revision; see
-- benchmarks/results/blorp_2_list_contains_2026-10-19.md.

-- Measured 2026-10-15; ceilings carry about 15% allocation and 18%
-- instruction headroom (see the namespace aliases report).
private LIMITS: CostLimits = { allocations = 48000, instructions = 96000000 }
private FIXTURES: String = "blorp_2/test/e2e/fixtures/namespace/"


-- A rejected fixture: exit 1, empty stdout, the exact diagnostic (and any
-- note lines) on stderr. The fixture keeps its command-line spelling.
private func rejected(compiler: String, fixture: String, location: String, message: String, help: String, notes: String) -> Bool:
	input = FIXTURES + fixture + ".brp"
	expected = input + ":" + location + ": error: " + message + "\nhelp: " + help + "\n" + notes
	with_directory(func(directory: String): verify_rejected_command(compiler, input, directory + "/rejected.c", expected))


private func previous_note(fixture: String, location: String) -> String:
	FIXTURES + fixture + ".brp:" + location + ": note: previous declaration or import here\n"


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Module aliases, qualified names and private declarations",
		tests = [
			("alias call reaches the module's function", func(): run_output_example(
				compiler, FIXTURES + "alias_call.brp", "3\n", LIMITS,
			)),
			("alias constructors and calls build and read a local module's values", func(): run_output_example(
				compiler, FIXTURES + "alias_constructor.brp", "12\n9\n1\n", LIMITS,
			)),
			("alias type names a module's record in a signature", func(): run_output_example(
				compiler, FIXTURES + "alias_type.brp", "5\n", LIMITS,
			)),
			("one import row combines an alias with selections", func(): run_output_example(
				compiler, FIXTURES + "combined_import.brp", "12\n0\n", LIMITS,
			)),
			("private functions are called within their modules", func(): run_output_example(
				compiler, FIXTURES + "private_local.brp", "42\n7\n7\n", LIMITS,
			)),
			("a declared function is selected beside an imported type", func(): run_output_example(
				compiler, FIXTURES + "declared_function_imported_type/main.brp", "42\n", LIMITS,
			)),
			("a type selection binds the module's public methods", func(): run_output_example(
				compiler, FIXTURES + "public_method.brp", "3\n", LIMITS,
			)),
			("a type selection never binds a private method", func(): rejected(
				compiler, "private_method", "4:20", "unknown function", "declare the function locally or import it by name; type selections enable receiver calls only", "",
			)),
			("methods_only never binds a private method", func(): rejected(
				compiler, "private_methods_only", "5:20", "unknown function", "declare the function locally or import it by name; type selections enable receiver calls only", "",
			)),
			("selecting a private function is rejected", func(): rejected(
				compiler, "private_selection", "2:15", "secret is private to ./hidden", "remove private or import a public declaration", "",
			)),
			("selecting a private type is rejected", func(): rejected(
				compiler, "private_type_selection", "2:15", "Point is private to ./hidden", "remove private or import a public declaration", "",
			)),
			("qualifying a private function is rejected", func(): rejected(
				compiler, "private_qualified", "4:7", "secret is private to ./hidden", "remove private or qualify a public declaration", "",
			)),
			("unknown qualified name names the alias and module", func(): rejected(
				compiler, "unknown_qualified", "4:7", "module ./hidden declares no public missing", "H names module ./hidden; qualify a public function, constructor or type it declares; imports are not reexported", "",
			)),
			("a bare alias is not a value", func(): rejected(
				compiler, "bare_alias", "4:13", "H is a module alias", "write H.name to use a declaration of that module", "",
			)),
			("a qualified function is not a value", func(): rejected(
				compiler, "qualified_not_called", "4:13", "H.visible names a function", "call this function or pass it directly to a pure callable parameter", "",
			)),
			("two aliases of one module are two imports", func(): rejected(
				compiler, "two_aliases", "3:5", "module imported more than once", "combine the alias and the selected names into one import, such as path as Alias: name", previous_note("two_aliases", "2:5"),
			)),
			("an alias row and a selection row of one module are two imports", func(): rejected(
				compiler, "alias_and_plain", "3:5", "module imported more than once", "combine the alias and the selected names into one import, such as path as Alias: name", previous_note("alias_and_plain", "2:5"),
			)),
			("an alias cannot reuse a visible name", func(): rejected(
				compiler, "alias_conflict", "2:24", "Shape is already a module alias", "choose another alias for that module, or omit Shape from this selection", previous_note("alias_conflict", "2:17"),
			)),
			("a qualified type needs its alias in the import block", func(): rejected(
				compiler, "unknown_qualified_type", "1:23", "unknown module alias Shared", "add path as Shared to the import block", "",
			)),
		]
	}
