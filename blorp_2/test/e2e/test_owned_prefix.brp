import:
	cost: CostLimits
	harness: Example, NativeCase, argv_case, run_example, run_source_example
	test: TestSuite


private OWNED_PREFIX_LIMITS: CostLimits = {
	allocations = 140000,
	instructions = 500000000
}


private pure func input_example(
	fixture: String,
	first: NativeCase,
	remaining: List[NativeCase],
) -> Example:
	{
		name = "owned match prefix: " + fixture,
		fixture = "blorp_2/test/e2e/fixtures/owned_prefix/" + fixture + ".brp",
		expected_c = None,
		first_case = first,
		remaining_cases = remaining,
		limits = OWNED_PREFIX_LIMITS
	}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Owned values before a terminating match",
		tests = [
			(
				"owned record prefix reaches the selected arm",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/owned_prefix/record.brp",
					2,
					OWNED_PREFIX_LIMITS,
				),
			),
			("record prefix is used or unused in the selected variant arm", func(): run_example(
					compiler,
					input_example(
						"record_arms",
						argv_case("Yes reads the prefix child", [], 2, ""),
						[argv_case("No does not read the prefix child", ["no"], 0, "")],
					),
				)),
			("unused record prefix reaches either arm exit", func(): run_example(
					compiler,
					input_example(
						"unused_record",
						argv_case("first arm", [], 7, ""),
						[argv_case("second arm", ["no"], 9, "")],
					),
				)),
			("unused String prefix reaches either arm exit", func(): run_example(
					compiler,
					input_example(
						"unused_string",
						argv_case("first arm", [], 7, ""),
						[argv_case("second arm", ["no"], 9, "")],
					),
				)),
			("unused owning union prefix reaches either arm exit", func(): run_example(
					compiler,
					input_example(
						"unused_union",
						argv_case("first arm", [], 7, ""),
						[argv_case("second arm", ["no"], 9, "")],
					),
				)),
			("unused List alias prefix reaches either arm exit", func(): run_example(
					compiler,
					input_example(
						"unused_list",
						argv_case("first arm", [], 7, ""),
						[argv_case("second arm", ["no"], 9, "")],
					),
				)),
			("acquired record projection is the managed scrutinee", func(): run_example(
					compiler,
					input_example(
						"projected_scrutinee",
						argv_case("Some preserves the projected String", ["kept"], 4, "kept\n"),
						[
							argv_case("None selects the empty arm", [], 0, "missing\n"),
							argv_case("empty String remains present", [""], 0, "\n"),
						],
					),
				)),
			("prefix record root transfers through a helper match", func(): run_example(
					compiler,
					input_example(
						"root_escape",
						argv_case("return the prefix root", [], 2, ""),
						[argv_case("return a fresh arm root", ["no"], 1, "")],
					),
				)),
			("prefix child escapes through a helper match", func(): run_example(
					compiler,
					input_example(
						"child_escape",
						argv_case("return the acquired prefix child", [], 2, ""),
						[argv_case("return a fresh arm String", ["no"], 1, "")],
					),
				)),
			("prefix projection returns directly or through borrowed identity", func(): run_example(
					compiler,
					input_example(
						"projection_escape",
						argv_case("transfer projected owner", [], 2, ""),
						[argv_case("identity acquires its own result", ["no"], 2, "")],
					),
				)),
			("prefix identity RHS and reassignment preserve the old alias", func(): run_example(
					compiler,
					input_example(
						"reassignment_aliases",
						argv_case("observe original then replacement", [], 0, "42\n7\nyes\n"),
						[argv_case("observe replacement then original", ["no"], 0, "7\n42\nno\n")],
					),
				)),
			("two prefix record roots share an independently owned child", func(): run_example(
					compiler,
					input_example(
						"shared_child_roots",
						argv_case("read both children in first arm", [], 4, ""),
						[argv_case("read both children in second arm", ["no"], 22, "")],
					),
				)),
			("borrowed caller record survives either helper arm", func(): run_example(
					compiler,
					input_example(
						"borrowed_parameter",
						argv_case("use caller and local child", [], 5, ""),
						[argv_case("use caller and retire unused local", ["no"], 4, "")],
					),
				)),
			("prefix runs once and only the selected arm has effects", func(): run_example(
					compiler,
					input_example(
						"selected_effects",
						argv_case("only yes prints after prefix", [], 2, "prefix\nyes\n"),
						[argv_case("only no prints after prefix", ["no"], 3, "prefix\nno\n")],
					),
				)),
			("owned prefix reaches both explicit arms and a useful default", func(): run_example(
					compiler,
					input_example(
						"default_arm",
						argv_case("First explicit arm", [], 2, ""),
						[
							argv_case("Second explicit arm", ["second"], 12, ""),
							argv_case(
								"Third uses default",
								["third", "extra"],
								22,
								"",
							),
						],
					),
				)),
			(
				"returned borrowed parameter or local child has an independent owner",
				func(): run_example(
					compiler,
					input_example(
						"borrowed_child_return",
						argv_case(
							"caller String returned and caller remains live",
							[],
							0,
							"42\n42\n",
						),
						[
							argv_case(
								"local child returned and caller remains live",
								["no"],
								0,
								"42\n7\n",
							),
						],
					),
				),
			),
			("owned union scrutinee coexists with an owned String prefix", func(): run_example(
					compiler,
					input_example(
						"owned_union_scrutinee",
						argv_case("Some arm observes both Strings and presence", ["kept"], 7, ""),
						[
							argv_case("None arm observes the prefix String", [], 2, ""),
							argv_case("Some empty String is distinct from None", [""], 3, ""),
						],
					),
				)),
			("prefix List root transfers independently through either arm", func(): run_example(
					compiler,
					input_example(
						"list_escape",
						argv_case("first arm returns one-element argv", [], 1, ""),
						[argv_case("second arm returns two-element argv", ["kept"], 2, "")],
					),
				)),
			("prefix owning union transfers independently through either arm", func(): run_example(
					compiler,
					input_example(
						"union_escape",
						argv_case("first arm returns the prefix union", [], 2, ""),
						[argv_case("second arm returns the prefix union", ["no"], 2, "")],
					),
				)),
			(
				"managed projected scrutinee supports Int and String payload reads",
				func(): run_example(
					compiler,
					input_example(
						"mixed_int_scrutinee",
						argv_case("Left reads scalar payload", [], 42, ""),
						[argv_case("Right reads owned String payload", ["kept"], 4, "")],
					),
				),
			),
			(
				"managed projected scrutinee supports Void and String payload reads",
				func(): run_example(
					compiler,
					input_example(
						"mixed_void_scrutinee",
						argv_case("Left reads Void payload", [], 0, ""),
						[argv_case("Right reads owned String payload", ["kept"], 4, "")],
					),
				),
			),
		]
	}
