import:
	./harness: run_source_example, run_output_example
	./cost: CostLimits
	test: TestSuite


-- Preserve the restricted-control plan's initial absolute feature gates.
private VALUE_IF_LIMITS: CostLimits = { allocations = 45000, instructions = 200000000 }


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 value conditionals",
		tests = [
			("annotated initializer returns exact answer", func(): run_source_example(
				compiler, "blorp_2/test/e2e/fixtures/value_if/answer.brp", 42, VALUE_IF_LIMITS,
			)),
			("tail if returns chosen value", func(): run_source_example(
				compiler, "blorp_2/test/e2e/fixtures/value_if/return.brp", 1, VALUE_IF_LIMITS,
			)),
			("effects and managed aliases follow only selected arms", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/value_if/effects.brp",
				"condition\nthen\nold value\nnew value\nold value\ncondition only\nelse\nnew value\nnew value\nold value\nelse if\nanswer 42\n", VALUE_IF_LIMITS,
			)),
			("List result and state aliases survive both selections", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/value_if/list_aliases.brp",
				"old list\nnew list\nold list\nold list\nold list\nold list\n", VALUE_IF_LIMITS,
			)),
		]
	}
