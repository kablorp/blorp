func test_union_current(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/binding/union_current.brp",
		0,
		COMPANION_LIMITS,
	)


func test_capture_shadows_local(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/binding/capture_shadow.brp",
		42,
		COMPANION_LIMITS,
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 scalar binding source examples",
		tests = [
			(
				"original survives reassignment with cost limits",
				func(): test_binding_fixture_returns_original_with_cost_limits(compiler),
			),
			("current after reassignment", func(): test_current_after_reassignment(compiler)),
			("self assignment", func(): test_self_assignment(compiler)),
			("parameter shadow", func(): test_parameter_shadow(compiler)),
			("pure mutation", func(): test_pure_mutation(compiler)),
			("unused initializer value", func(): test_unused_initializer_value(compiler)),
			("ordered reassignment value", func(): test_ordered_reassignment_value(compiler)),
			("union original", func(): test_union_original(compiler)),
			("union current", func(): test_union_current(compiler)),
			("capture shadows local", func(): test_capture_shadows_local(compiler)),
			(
				"immutable assignment diagnostic preserves output",
				func(): test_immutable_assignment_diagnostic_preserves_output(compiler),
			),
		]
	}
