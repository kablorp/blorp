import:
	cost: CostLimits, check_limits
	harness:
		Example,
		measure_compilation_cost,
		run_source_example,
		verify_native_result,
		verify_rejected_command,
		with_directory,
	system: file_exists, read_file, write_file
	test: TestSuite


private COMPANION_LIMITS: CostLimits = {
	allocations = 10000,
	instructions = 100000000
}


private func verify_fixture(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "bindings",
		fixture = "blorp_2/test/e2e/fixtures/binding/basic.brp",
		expected_c = None,
		exit_status = 1,
		limits = {
			allocations = 10000,
			instructions = 100000000
		}
	}
	cost ?= measure_compilation_cost(compiler, directory, example)
	native ?= verify_native_result(directory, example.exit_status)
	check_limits(cost, example.limits)


private func verify_rejected_assignment(
	compiler: String,
	directory: String,
) -> Result[Void, String]:
	input = directory + "/immutable.brp"
	output = directory + "/rejected.c"
	written ?= write_file(input, "func main() -> Int:\n\tvalue = 1\n\tvalue = 42\n\tvalue\n")
	expected = input + ":3:2: error: cannot assign to an immutable binding\nhelp: declare the binding with var to allow reassignment\n"
	missing ?= verify_rejected_command(compiler, input, output, expected)

	no_output ?= if file_exists(output):
		Err("invalid binding published C output")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve binding output")
	existing ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)

	if actual == "preserve binding output":
		Ok(void)
	else:
		Err("invalid binding overwrote existing C output")


func test_binding_fixture_returns_original_with_cost_limits(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_fixture(compiler, directory))


func test_immutable_assignment_diagnostic_preserves_output(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_rejected_assignment(compiler, directory))


func test_current_after_reassignment(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/binding/values.brp",
		42,
		COMPANION_LIMITS,
	)


func test_self_assignment(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/binding/self_assignment.brp",
		7,
		COMPANION_LIMITS,
	)


func test_parameter_shadow(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/binding/parameter_shadow.brp",
		17,
		COMPANION_LIMITS,
	)


func test_pure_mutation(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/binding/pure_mutation.brp",
		42,
		COMPANION_LIMITS,
	)


