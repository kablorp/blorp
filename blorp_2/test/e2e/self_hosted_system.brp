import:
    ./self_hosted_harness: NativeRun, reported, verify_runs
    process: run_to_files
    fs: describe, read_text
    test: TestSuite
    bool: and
    int: Int methods
    string: String methods
    result: Result methods


private SHELL: String = "/bin/sh"
private SHELL_TIMEOUT_MS: Int = 10000
private FIXTURES: String = "blorp_2/test/e2e/fixtures/"


-- Runs one POSIX shell script with positional arguments and returns its stdout.
-- The shell reports the physical directory (`pwd -P`) independently of the
-- system call under test.
private func shell(label: String, work_directory: String, script: String, arguments: List[String]) -> Result[String, String]:
    prefix = work_directory + "/" + label
    status ?= run_to_files(SHELL, ["-c", script, "sh"].concat(arguments), prefix + ".out", prefix + ".err", SHELL_TIMEOUT_MS)
    errors ?= read_text(prefix + ".err").map_err(describe)
    if status.equals(0).and(errors.equals("")):
        read_text(prefix + ".out").map_err(describe)
    else:
        Err(label + ": shell exit " + status.to_string() + ": " + errors)


private pure func run_in(directory: String, label: String, stdout: String, allocations: Int) -> NativeRun:
    { label = Some(label), arguments = [], directory = Some(directory), status = 0, stdout = stdout, allocations = allocations }


-- The physical directory, as `pwd -P` reports it, with a trailing newline.
private func current_directory_runs(compiler: String, c_compiler: String, work_directory: String, name: String, fixture: String, allocations: Int) -> Result[Void, String]:
    physical ?= shell(name + "-physical", work_directory, "cd \"$1\" && pwd -P", [work_directory])
    verify_runs(compiler, c_compiler, work_directory, name, FIXTURES + fixture, [
        run_in("/", "root", "/\n", allocations),
        run_in(work_directory, "temporary", physical, allocations),
    ])


func current_directory_suite(compiler: String, c_compiler: String, work_directory: String) -> TestSuite:
    {
        description = "Blorp 2 current directory",
        tests = [
            ("native Result reaches real main in two CWDs", func(): reported(current_directory_runs(compiler, c_compiler, work_directory, "current_directory_basic", "current_directory/basic.brp", 2))),
            ("ignored Result and escaping String keep ownership", func(): reported(current_directory_runs(compiler, c_compiler, work_directory, "current_directory_ownership", "current_directory/ownership.brp", 4))),
        ]
    }
