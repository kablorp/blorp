import:
	cost: CostLimits
	harness: run_source_example
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 20000,
	instructions = 200000000
}


func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 generics",
		tests = [
			("generic union wraps and matches its payload", func():
				run_source_example(compiler, "blorp_2/test/e2e/fixtures/generic_box.brp", 7, LIMITS)
			),
			("generic forwarding accepts a concrete union argument", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic_union_identity.brp",
					7,
					LIMITS,
				)
			),
			("phantom applications preserve distinct nominal arguments", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic_phantom.brp",
					1,
					LIMITS,
				)
			),
			("String argument with fixed Int payload remains unmanaged", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic_tagged_int.brp",
					7,
					LIMITS,
				)
			),
			("one declaration specializes for Int and String", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic_identity.brp",
					1,
					LIMITS,
				)
			),
			("generic forwarding specializes its callee", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic_forward.brp",
					42,
					LIMITS,
				)
			),
			("String forwarding retains a borrowed argument across replacement", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic_forward_string.brp",
					1,
					LIMITS,
				)
			),
			("binding and reassignment types specialize independently", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic_bindings.brp",
					2,
					LIMITS,
				)
			),
		]
	}
