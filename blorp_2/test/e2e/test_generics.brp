import:
	./cost: CostLimits
	./harness: run_source_example, run_output_example
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 150000,
	instructions = 600000000
}

private ANNOTATION_LIMITS: CostLimits = { allocations = 43000, instructions = 180000000 }

-- Depth 20 exercises default C structural limits and has a larger compiler workload.
private DEEP_LIMITS: CostLimits = {
	allocations = 180000,
	instructions = 600000000
}


func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 generics",
		tests = [
			("generic List callbacks preserve stable outputs and owned children", func():
				run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/generic/managed/list_callbacks.brp",
					"false\ntrue\ntrue\nfalse\ninput\n1\n2\n3\n2\ntrue\n3\n1\n0\n0\n2\n2\n0\ntrue\n42é\0!\n!\n42é\0\n42é\0\n7\n7\n8\n",
					LIMITS,
				)
			),
			("List String join preserves separators order and managed aliases", func():
				run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/generic/managed/list_join.brp",
					"\nsolo\n//\nabc\na::::c\nleft!§\0left!\né\0|😀\nleft!\n§\0\nleft!\n2047\n",
					LIMITS,
				)
			),
			("local annotation checks a scalar initializer", func(): run_source_example(
				compiler, "blorp_2/test/e2e/fixtures/annotations/identity.brp", 7, ANNOTATION_LIMITS,
			)),
			("local annotation infers a generic List and preserves its old alias", func(): run_source_example(
				compiler, "blorp_2/test/e2e/fixtures/annotations/contextual_list.brp", 1, ANNOTATION_LIMITS,
			)),
			("ordered named callbacks and binary builtin keep distinct results", func():
				run_output_example(compiler, "blorp_2/test/e2e/fixtures/generic/named/ordered.brp", "7\n8\n7\n42\n", LIMITS)
			),
			("managed callbacks retain aliases and evaluate defaults eagerly", func():
				run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/generic/named/managed.brp",
					"eager\né\0\né\0\neager\nfallback!\né\0\n42\n", LIMITS,
				)
			),
			("named generic callback is erased to a direct call", func():
				run_source_example(compiler, "blorp_2/test/e2e/fixtures/generic/named/identity.brp", 17, LIMITS)
			),
			("Option and Result callbacks select branches and preserve managed payloads", func():
				run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/generic/managed/option_result_callbacks.brp",
					"42é\0!\n42é\0\nnone\n7\nunchanged!\n42\nkept!\n8!\nbypass!\nunit!\nreceiver\neager!\n", LIMITS,
				)
			),
			(
				"explicit Option and Result helpers preserve eager defaults and managed values",
				func(): run_output_example(
					compiler, "blorp_2/test/e2e/fixtures/generic/managed/option_result_helpers.brp",
					"eager\né\0\ntrue\nfallback\nfallback\n7\neager-error\ntrue\nfalse\nfalse\ntrue\ntrue\nfalse\nok\nerror\n",
					LIMITS,
				),
			),
			(
				"repeated result retains common partial nominal head",
				func(): run_source_example(compiler, "blorp_2/test/e2e/fixtures/generic/contextual/repeated_hint.brp", 7, LIMITS),
			),
			(
				"expected result solves empty call",
				func(): run_source_example(compiler, "blorp_2/test/e2e/fixtures/generic/contextual/expected_result.brp", 7, LIMITS),
			),
			(
				"nested result preserves caller rigid ownership",
				func(): run_source_example(compiler, "blorp_2/test/e2e/fixtures/generic/contextual/nested_rigid.brp", 7, LIMITS),
			),
			(
				"later sibling solves earlier call",
				func(): run_source_example(compiler, "blorp_2/test/e2e/fixtures/generic/contextual/sibling.brp", 7, LIMITS),
			),
			(
				"partial nominal constructor solves payload",
				func(): run_source_example(compiler, "blorp_2/test/e2e/fixtures/generic/contextual/partial_constructor.brp", 9, LIMITS),
			),
			(
				"unique UFCS partial nominal receiver solves payload",
				func(): run_source_example(compiler, "blorp_2/test/e2e/fixtures/generic/contextual/partial_ufcs.brp", 9, LIMITS),
			),
			(
				"managed generic basic",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/managed/basic.brp",
					2,
					LIMITS,
				),
			),
			(
				"managed generic saved",
