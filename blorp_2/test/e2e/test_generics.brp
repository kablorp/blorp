import:
	cost: CostLimits
	harness: run_source_example
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 20000,
	instructions = 200000000
}


func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 generics",
		tests = [
			(
				"union type parameters ok",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/union_parameters/ok.brp",
					7,
					LIMITS,
				),
			),
			(
				"union type parameters err",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/union_parameters/err.brp",
					9,
					LIMITS,
				),
			),
			(
				"union type parameters third",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/union_parameters/third.brp",
					11,
					LIMITS,
				),
			),
			(
				"union type parameters unwrap_or",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/union_parameters/unwrap_or.brp",
					7,
					LIMITS,
				),
			),
			(
				"union type parameters phantom_keys",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/union_parameters/phantom_keys.brp",
					5,
					LIMITS,
				),
			),
			(
				"function type parameters second",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/function_parameters/second.brp",
					2,
					LIMITS,
				),
			),
			(
				"function type parameters third",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/function_parameters/third.brp",
					3,
					LIMITS,
				),
			),
			(
				"function type parameters forwarding",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/function_parameters/forwarding.brp",
					2,
					LIMITS,
				),
			),
			(
				"function type parameters saved_result",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/function_parameters/saved_result.brp",
					3,
					LIMITS,
				),
			),
			(
				"function type parameters boxed",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/function_parameters/boxed.brp",
					7,
					LIMITS,
				),
			),
			(
				"wide call stays flat in C",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/multiple_arguments/wide.brp",
					39,
					LIMITS,
				),
			),
			(
				"generic arguments",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/arguments.brp",
					7,
					LIMITS,
				),
			),
			(
				"generic arguments first string",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/arguments_first_string.brp",
					1,
					LIMITS,
				),
			),
			(
				"generic arguments second string",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/arguments_second_string.brp",
					3,
					LIMITS,
				),
			),
			(
				"generic arguments repeated string",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/arguments_repeated_string.brp",
					3,
					LIMITS,
				),
			),
			(
				"generic arguments later",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/arguments_later.brp",
					42,
					LIMITS,
				),
			),
			(
				"generic arguments box",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/arguments_box.brp",
					7,
					LIMITS,
				),
			),
			(
				"multiple arguments order",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/multiple_arguments/order.brp",
					9,
					LIMITS,
				),
			),
			("generic union wraps and matches its payload", func():
				run_source_example(compiler, "blorp_2/test/e2e/fixtures/generic/box.brp", 7, LIMITS)
			),
			("generic forwarding accepts a concrete union argument", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/union_identity.brp",
					7,
					LIMITS,
				)
			),
			("phantom applications preserve distinct nominal arguments", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/phantom.brp",
					1,
					LIMITS,
				)
			),
			("String argument with fixed Int payload remains unmanaged", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/tagged_int.brp",
					7,
					LIMITS,
				)
			),
			("one declaration specializes for Int and String", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/identity.brp",
					1,
					LIMITS,
				)
			),
			("generic forwarding specializes its callee", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/forward.brp",
					42,
					LIMITS,
				)
			),
			("String forwarding retains a borrowed argument across replacement", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/forward_string.brp",
					1,
					LIMITS,
				)
			),
			("binding and reassignment types specialize independently", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/generic/bindings.brp",
					2,
					LIMITS,
				)
			),
		]
	}
