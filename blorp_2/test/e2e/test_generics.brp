import:
	cost: CostLimits
	harness: run_source_example
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 150000,
	instructions = 600000000
}

-- Depth 20 exercises default C structural limits and has a larger compiler workload.
private DEEP_LIMITS: CostLimits = {
	allocations = 180000,
	instructions = 600000000
}


