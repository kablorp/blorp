import:
	./cost: CostLimits
	./harness: run_source_example
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 134000,
	instructions = 450000000
}

private LONG_LIMITS: CostLimits = {
	allocations = 170000,
	instructions = 540000000
}

-- Fixtures that hold a 4 KB literal in a function nothing calls, so the compile
-- cost is parsing and decoding alone. Measured 2026-10-16 at -O0.
-- long_unreached: 8,792 allocations, 55.3M instructions steady, 63.1M to 64.1M
-- on the first run of a freshly linked compiler (69.9M seen in review).
-- many_escapes_unreached: 12,813 allocations, 64.3M steady, 72.0M to 73.0M cold.
-- Allocations are deterministic and carry the check, with 15% headroom. Only
-- CostLimits can state a limit, so the instruction ceilings sit about 33% over
-- steady to survive a cold run; they catch gross growth, not the regression.
-- The compiler before the fix measured 20,792 / 78.0M and 23,452 / 83.1M; see
-- benchmarks/results/blorp_2_string_decoding_2026-10-16.md.
-- The checked List set helper adds 1,338 compiler allocations; its approved
-- revision adds 1,500 to this bound (blorp_2_list_set_names_2026-10-18.md).
private UNREACHED_LONG_LIMITS: CostLimits = {
	allocations = 11600,
	instructions = 74000000
}

private UNREACHED_ESCAPES_LIMITS: CostLimits = {
	allocations = 14700,
	instructions = 85000000
}


private func example(compiler: String, fixture: String, expected: Int, limits: CostLimits) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/string_literal/" + fixture + ".brp", expected, limits)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 quoted String literals",
		tests = [
			-- The imported Int module's Bool dependency measures 23,628 allocations.
			("both tail arms return literal Strings", func(): example(compiler, "tail_arms", 7, { allocations = 156000, instructions = 500000000 })),
			("basic", func(): example(compiler, "basic", 5, LIMITS)),
			("empty", func(): example(compiler, "empty", 0, LIMITS)),
			("escapes", func(): example(compiler, "escapes", 9, LIMITS)),
			("nul digits", func(): example(compiler, "nul_digits", 5, LIMITS)),
			("copy return", func(): example(compiler, "copy_return", 8, LIMITS)),
			("unused", func(): example(compiler, "unused", 0, LIMITS)),
			("generic", func(): example(compiler, "generic", 5, LIMITS)),
			("union", func(): example(compiler, "union", 6, LIMITS)),
			("unicode", func(): example(compiler, "unicode", 6, LIMITS)),
			("unicode escapes", func(): example(compiler, "unicode_escapes", 6, LIMITS)),
			("normalization", func(): example(compiler, "normalization", 5, LIMITS)),
			("trigraphs", func(): example(compiler, "trigraphs", 9, LIMITS)),
			("comment text", func(): example(compiler, "comment_text", 7, LIMITS)),
			("long literal exceeds C string token limit", func(): example(compiler, "long", 1, LONG_LIMITS)),
			("decoding a long plain literal allocates nothing per byte", func(): example(compiler, "long_unreached", 0, UNREACHED_LONG_LIMITS)),
			("decoding many escapes allocates a constant number of Strings per escape", func(): example(compiler, "many_escapes_unreached", 0, UNREACHED_ESCAPES_LIMITS)),
		]
	}
