import:
	./harness: verify_rejected_command, with_directory
	system: getcwd
	test: TestSuite


-- Each fixture uses one form the parser reads ahead of its semantics; the
-- checker rejects it with exact text naming the form and its milestone.
private FIXTURES: String = "blorp_2/test/e2e/fixtures/unsupported/"


-- `error_file` names the fixture file the diagnostic points into. The entry
-- file keeps its command-line spelling; an imported module displays its
-- absolute normalized path, as in test_imports.
private func rejected_in(compiler: String, fixture: String, error_file: String, location: String, message: String, help: String) -> Bool:
	input = FIXTURES + fixture + ".brp"
	error_path = if error_file == fixture:
		input
	else:
		getcwd() + "/" + FIXTURES + error_file + ".brp"
	expected = error_path + ":" + location + ": error: " + message + "\nhelp: " + help + "\n"
	with_directory(func(directory: String): verify_rejected_command(compiler, input, directory + "/rejected.c", expected))


private func rejected(compiler: String, fixture: String, location: String, message: String, help: String) -> Bool:
	rejected_in(compiler, fixture, fixture, location, message, help)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 forms parsed ahead of their semantics",
		tests = [
			(
				"imported constant is rejected before namespace lookup",
				func(): rejected_in(compiler, "constant_import/main", "constant_import/m", "1:1", "module constants are not supported yet", "return the value from a function; constants arrive with the constants milestone"),
			),
			(
				"imported opaque type is rejected before namespace lookup",
				func(): rejected_in(compiler, "opaque_import/main", "opaque_import/m", "1:13", "opaque types are not supported yet", "declare a fixed record with one field; opaque types arrive with the recursive-types milestone"),
			),
			(
				"opaque type declaration",
				func(): rejected(compiler, "opaque_type", "2:13", "opaque types are not supported yet", "declare a fixed record with one field; opaque types arrive with the recursive-types milestone"),
			),
			(
				"into_opaque",
				func(): rejected(compiler, "into_opaque", "3:2", "into_opaque is not supported yet", "construct the underlying value directly; opaque types arrive with the recursive-types milestone"),
			),
			(
				"from_opaque",
				func(): rejected(compiler, "from_opaque", "3:2", "from_opaque is not supported yet", "read the underlying value directly; opaque types arrive with the recursive-types milestone"),
			),
			(
				"module constant",
				func(): rejected(compiler, "constant", "2:1", "module constants are not supported yet", "return the value from a function; constants arrive with the constants milestone"),
			),
			(
				"binding type annotation",
				func(): rejected(compiler, "local_annotation", "3:9", "binding type annotations are not supported yet", "remove the annotation; the binding's type is inferred from its initializer until the join milestone"),
			),
			(
				"range",
				func(): rejected(compiler, "range", "3:2", "ranges are not supported yet", "iterate with an explicit index; low..high arrives with the loops milestone"),
			),
			(
				"and/or",
				func(): rejected(compiler, "and_or", "3:10", "`and`/`or` are not supported yet", "match on the Bool operands; `and`/`or` arrive with the join milestone"),
			),
			(
				"not",
				func(): rejected(compiler, "not", "3:10", "`not` is not supported yet", "match on the Bool operand; `not` arrives with the join milestone"),
			),
			(
				"if",
				func(): rejected(compiler, "if", "3:2", "`if` is not supported yet", "match on the Bool condition; `if` arrives with the join milestone"),
			),
			(
				"propagating binding",
				func(): rejected(compiler, "propagation", "3:2", "`?=` is not supported yet", "match on the Option or Result and return its failing case; `?=` arrives with the join milestone"),
			),
			(
				"while loop",
				func(): rejected(compiler, "while", "4:2", "`while` is not supported yet", "write a recursive function; loops arrive with the loops milestone"),
			),
			(
				"for loop",
				func(): rejected(compiler, "for", "3:2", "`for` is not supported yet", "write a recursive function; loops arrive with the loops milestone"),
			),
			(
				"lambda",
				func(): rejected(compiler, "lambda", "3:9", "lambdas are not supported yet", "declare a named function and call it; lambdas arrive with the lambdas milestone"),
			),
			(
				"self call at the tail of a nested match",
				func(): rejected(compiler, "tail_call_nested_match", "12:11", "a recursive call at the tail of a nested match is not supported yet", "make it an arm of the function's own match, or remove @tail_recursive; backedges from nested matches arrive with the loops milestone"),
			),
			(
				"match inside a larger expression",
				func(): rejected(compiler, "match_in_expression", "5:11", "a `match` inside a larger expression is not supported yet", "bind the match first with name = match ..., then use the name"),
			),
			(
				"reassignment across a join arm",
				func(): rejected(compiler, "join_reassignment", "6:4", "reassigning a variable declared outside this match arm is not supported yet", "bind the match's value with name = match ... instead; reassignment inside an arm arrives with joins that carry reassigned variables"),
			),
			(
				"nested pattern",
				func(): rejected(compiler, "nested_pattern", "14:8", "nested patterns are not supported yet", "bind the field to a name and match it in a second match; nested patterns arrive with the pattern-compilation milestone"),
			),
			(
				"nested constructor written as a bare name",
				func(): rejected(compiler, "nested_constructor_name", "17:8", "nested patterns are not supported yet", "bind the field to a name and match it in a second match; nested patterns arrive with the pattern-compilation milestone"),
			),
			(
				"or-pattern",
				func(): rejected(compiler, "or_pattern", "12:3", "or-patterns are not supported yet", "write one arm per alternative; or-patterns arrive with the pattern-compilation milestone"),
			),
			(
				"list pattern",
				func(): rejected(compiler, "list_pattern", "7:3", "list patterns are not supported yet", "match on list.length and list.get; list patterns arrive with the pattern-compilation milestone"),
			),
			(
				"String literal pattern",
				func(): rejected(compiler, "string_pattern", "8:3", "String literal patterns are not supported yet", "compare with string.equals in the arm; literal patterns arrive with the pattern-compilation milestone"),
			),
			(
				"Char literal pattern",
				func(): rejected(compiler, "char_pattern", "11:3", "Char literal patterns are not supported yet", "compare the character in the arm; literal patterns arrive with the pattern-compilation milestone"),
			),
			(
				"qualified constructor pattern",
				func(): rejected(compiler, "qualified_pattern", "12:3", "qualified constructor patterns are not supported yet", "import the constructor and write it bare; qualified patterns arrive with the namespace milestone"),
			),
		]
	}
