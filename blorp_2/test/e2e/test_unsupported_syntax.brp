import:
	./harness: run_source_example, verify_rejected_command, with_directory
	system: getcwd
	test: TestSuite


-- Existing syntax fixtures accept opaque declarations and reject unsupported
-- forms and invalid placements with an exact location, diagnostic and help.
private FIXTURES: String = "blorp_2/test/e2e/fixtures/unsupported/"


-- `error_file` names the fixture file the diagnostic points into. The entry
-- file keeps its command-line spelling; an imported module displays its
-- absolute normalized path, as in test_imports.
private func rejected_in(compiler: String, fixture: String, error_file: String, location: String, message: String, help: String) -> Bool:
	input = FIXTURES + fixture + ".brp"
	error_path = if error_file == fixture:
		input
	else:
		getcwd() + "/" + FIXTURES + error_file + ".brp"
	expected = error_path + ":" + location + ": error: " + message + "\nhelp: " + help + "\n"
	with_directory(func(directory: String): verify_rejected_command(compiler, input, directory + "/rejected.c", expected))


private func rejected(compiler: String, fixture: String, location: String, message: String, help: String) -> Bool:
	rejected_in(compiler, fixture, fixture, location, message, help)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 syntax admission and placement",
		tests = [
			(
				"opaque support module as root still requires main",
				func(): rejected(compiler, "opaque_import/m", "2:1", "expected a main function", "declare func main() -> Int: as the entrypoint"),
			),
			(
				"imported opaque declaration is accepted",
				func(): run_source_example(
					compiler, FIXTURES + "opaque_import/main.brp", 0,
					{ allocations = 40000, instructions = 140000000 },
				),
			),
			(
				"unused opaque declaration has a finite representation",
				func(): run_source_example(
					compiler, FIXTURES + "opaque_type.brp", 0,
					{ allocations = 40000, instructions = 140000000 },
				),
			),
			(
				"into_opaque",
				func(): rejected(compiler, "into_opaque", "3:14", "unknown opaque type", "import or declare an opaque type before converting it"),
			),
			(
				"from_opaque",
				func(): rejected(compiler, "from_opaque", "3:14", "unknown opaque type", "import or declare an opaque type before converting it"),
			),
			(
				"range",
				func(): rejected(compiler, "range", "3:2", "ranges are not supported yet", "iterate with an explicit index; low..high arrives with the loops milestone"),
			),
			(
				"and/or",
				func(): rejected(compiler, "and_or", "3:10", "`and`/`or` infix syntax is invalid", "call and(left, right) or left.and(right); call or(left, right) or left.or(right)"),
			),
			(
				"not",
				func(): rejected(compiler, "not", "3:10", "`not value` is invalid", "call not(value) or value.not()"),
			),
			(
				"if",
				func(): rejected(compiler, "if", "2:11", "an if nested inside another expression is not supported yet", "bind the if result to a local before using it here"),
			),
			(
				"propagation requires a Result-returning function",
				func(): rejected(compiler, "propagation", "3:2", "`?=` requires a Result-returning function", "return Result[Value, Error] from this function, or match on the value explicitly"),
			),
			(
				"propagation in an untaken if block is rejected during parsing",
				func(): rejected(compiler, "propagation_if", "3:15", "`?=` cannot be used inside an `if` or `match` block", "match on the Result or Option in place, or move the block into its own function and use `?=` at its top"),
			),
			(
				"propagation in a tail match arm is rejected during parsing",
				func(): rejected(compiler, "propagation_match", "4:19", "`?=` cannot be used inside an `if` or `match` block", "match on the Result or Option in place, or move the block into its own function and use `?=` at its top"),
			),
			(
				"source while condition requires Bool",
				func(): rejected(compiler, "while", "3:8", "condition must have the designated Bool type", "use a Bool value as the condition"),
			),
			(
				"source for iterable requires a List or an Int range",
				func(): rejected(compiler, "for", "3:14", "for iterable must be a List or an Int range", "iterate a List value, or write start..end with Int bounds"),
			),
			(
				"lambda",
				func(): rejected(compiler, "lambda", "3:9", "lambda values are only supported as pure callback arguments", "pass a pure func literal to a pure callable parameter; store and return ordinary data"),
			),
			(
				"self call at the tail of a nested match",
				func(): rejected(compiler, "tail_call_nested_match", "12:11", "a recursive call at the tail of a nested match is not supported yet", "make it an arm of the function's own match, or remove @tail_recursive; backedges from nested matches arrive with the loops milestone"),
			),
			(
				"match inside a larger expression",
				func(): rejected(compiler, "match_in_expression", "5:11", "a `match` inside a larger expression is not supported yet", "bind the match first with name = match ..., then use the name"),
			),
			(
				"exhaustive nested pattern makes the fallback unreachable",
				func(): rejected(compiler, "nested_pattern", "15:3", "match arm is unreachable", "remove this arm; earlier arms already cover all values it could match"),
			),
			(
				"bare nested constructor still requires the other inner variant",
				func(): rejected(compiler, "nested_constructor_name", "16:2", "non-exhaustive match", "add an arm for the missing pattern: Wrap(B)"),
			),
			(
				"Char literal pattern",
				func(): rejected(compiler, "char_pattern", "11:3", "Char literal patterns are not supported yet", "compare the character in the arm; literal patterns arrive with the pattern-compilation milestone"),
			),
			(
				"qualified constructor pattern needs a declared alias",
				func(): rejected(compiler, "qualified_pattern", "12:3", "unknown module alias Shapes", "add path as Shapes to the import block"),
			),
		]
	}
