import:
	cost: CompilationCost, CostLimits, check_limits, parse_allocations, parse_instructions
	process: ProcessOutput, run
	system: file_exists, getenv, read_file, remove_dir, remove_file, temp_dir, write_file


fixed record Example {
	name: String,
	fixture: String,
	expected_c: String,
	exit_status: Int,
	limits: CostLimits
}


fixed record CompilerBinaries {
	normal: String,
	diagnostic: String
}


func run_isolated(program: String, arguments: List[String]) -> Result[ProcessOutput, String]:
	-- A parent's leak-check mode must not instrument the normal instruction run.
	run(
		"/usr/bin/env",
		["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", program].concat(arguments),
	)


func run_successfully(program: String, arguments: List[String]) -> Result[ProcessOutput, String]:
	output ?= run_isolated(program, arguments)

	if output.exit_code() != 0:
		Err(program + " failed: " + output.stderr())
	else:
		Ok(output)


func prepare_compiler() -> Result[CompilerBinaries, String]:
	prepared ?= run_successfully(
		"make",
		["-C", "blorp_2", "test-compiler"],
	)
	Ok({
		normal = "blorp_2/build/compiler",
		diagnostic = "blorp_2/build/compiler-diagnostic",
	})


func verify_generated_c(path: String, expected_c: String) -> Result[Void, String]:
	actual ?= read_file(path)

	if actual == expected_c:
		Ok(void)
	else:
		Err("the compiler did not emit the expected example C")


func remove_existing_file(path: String) -> Result[Void, String]:
	if not file_exists(path) or remove_file(path):
		Ok(void)
	else:
		Err("could not remove previous measurement output: " + path)


func measure_instructions(
	compiler: String,
	directory: String,
	example: Example,
) -> Result[Int, String]:
	-- Each child must publish fresh C and a fresh report; old files are no oracle.
	removed_c ?= remove_existing_file(directory + "/program.c")
	removed_report ?= remove_existing_file(directory + "/instructions.txt")
	output ?= run_successfully(
		"/usr/bin/time",
		[
			"-l",
			"-o",
			directory + "/instructions.txt",
			compiler,
			example.fixture,
			directory + "/program.c",
		],
	)

	if output.stdout() != "" or output.stderr() != "":
		Err("the compiler must be silent on success")
	else:
		verified ?= verify_generated_c(directory + "/program.c", example.expected_c)
		report ?= read_file(directory + "/instructions.txt")
		parse_instructions(report)


func measure_compilation_cost(
	compilers: CompilerBinaries,
	directory: String,
	example: Example,
) -> Result[CompilationCost, String]:
	-- Allocation diagnostics and normal instruction measurements use the same C.
	removed_c ?= remove_existing_file(directory + "/program.c")
	allocation_run ?= run_successfully(
		"/usr/bin/env",
		[
			"BLORP_LEAK_CHECK=strict",
			compilers.diagnostic,
			example.fixture,
			directory + "/program.c",
		],
	)

	if allocation_run.stdout() != "":
		Err("the compiler must have empty stdout on success")
	else:
		verified ?= verify_generated_c(directory + "/program.c", example.expected_c)
		allocations ?= parse_allocations(allocation_run.stderr())
		first ?= measure_instructions(compilers.normal, directory, example)
		second ?= measure_instructions(compilers.normal, directory, example)
		third ?= measure_instructions(compilers.normal, directory, example)
		instructions: Int = min(
			min(first, second),
			third,
		)
		cost: CompilationCost = {
			allocations = allocations,
			instructions = instructions
		}
		print(
			example.name + " compiler: allocations=" + "".append_int(
				allocations,
			) + "/" + "".append_int(
				example.limits.allocations,
			) + "; instructions=" + "".append_int(
				instructions,
			) + "/" + "".append_int(example.limits.instructions) + " (minimum of 3)",
		)
		print(
			"instruction samples: " + "".append_int(
				first,
			) + ", " + "".append_int(second) + ", " + "".append_int(third),
		)
		Ok(cost)


func verify_native_result(directory: String, expected_exit: Int) -> Result[Void, String]:
	generated_c: String = directory + "/program.c"
	binary: String = directory + "/program"
	linked ?= run_successfully(
		getenv("BLORP_CC").get_or("clang"),
		["-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic", "-O2", generated_c, "-o", binary],
	)
	executed ?= run_isolated(binary, [])

	if (
		executed.exit_code() != expected_exit
		or executed.stdout() != ""
		or executed.stderr() != ""
	):
		Err((
				"the generated program must return the expected status with empty stdout and "
				+ "stderr"
			))
	else:
		Ok(void)


func verify_rejected_command(
	compiler: String,
	input: String,
	output: String,
	expected: String,
) -> Result[Void, String]:
	rejected ?= run_isolated(
		compiler,
		[input, output],
	)

	if (
		rejected.exit_code() != 1
		or rejected.stdout() != ""
		or rejected.stderr() != expected
	):
		Err("rejected input must exit 1 with the expected location, diagnostic, and help")
	else:
		Ok(void)


func verify_rejected_input(compiler: String, directory: String) -> Result[Void, String]:
	input: String = directory + "/invalid.brp"
	output: String = directory + "/rejected.c"
	written_input ?= write_file(input, "func start() -> Int:\n\t0\n")
	expected: String = input + ":3:1: error: expected a main function\nhelp: declare func main() -> Int: as the entrypoint\n"
	missing_output_rejection ?= verify_rejected_command(compiler, input, output, expected)

	missing_output ?= if file_exists(output):
		Err("rejected source created a C output file")
	else:
		Ok(void)

	written_output ?= write_file(output, "preserve this output")
	existing_output_rejection ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)

	if actual != "preserve this output":
		Err("rejected source overwrote the existing output")
	else:
		Ok(void)


func verify_all(directory: String, example: Example) -> Result[Void, String]:
	compilers ?= prepare_compiler()
	cost ?= measure_compilation_cost(compilers, directory, example)
	native_result ?= verify_native_result(directory, example.exit_status)
	rejected_output ?= verify_rejected_input(compilers.normal, directory)
	check_limits(cost, example.limits)


func run_example(example: Example) -> Bool:
	match (
		run_successfully(
			"mktemp",
			["-d", temp_dir() + "/blorp-2-e2e.XXXXXX"],
		)
	):
		Err(error):
			print_error(error)
			False
		Ok(temporary):
			directory: String = temporary
				.stdout()
				.trim()
			result: Result[Void, String] = verify_all(directory, example)
			_ = remove_file(directory + "/instructions.txt")
			_ = remove_file(directory + "/program.c")
			_ = remove_file(directory + "/program")
			_ = remove_file(directory + "/invalid.brp")
			_ = remove_file(directory + "/rejected.c")
			_ = remove_dir(directory)

			match result:
				Ok(_):
					True
				Err(error):
					print_error("FAIL: " + error)
					False
