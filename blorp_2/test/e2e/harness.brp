import:
	bytes: to_hex
	./cost:
		CompilationCost, CostLimits, InstructionCheck(RequiredInstructions, DisabledInstructions),
		ResourceVerdict(ResourceChecksPassed, InitialBootstrapDebt, AllocationDebt),
		assess_resource_limits, format_cost, format_initial_bootstrap_debt, format_allocation_debt,
		parse_allocations, parse_instruction_check, parse_instructions, parse_resource_policy
	fs: IOError, create_directories, resource_path, temporary_directory
	path: dirname
	process:
		ProcessCommand,
		ProcessError,
		ProcessExit(Exited, Signaled, TimedOut),
		ProcessOutput,
		ProcessResult,
		ProcessStdin(BytesStdin),
		command,
		run,
		run_command,
	system: file_exists, getenv, read_file, remove_file, temp_dir, write_bytes, write_file
	test: TestSuite, run_suite_result


fixed record NativeCase {
	name: String,
	cwd: Option[String],
	arguments: List[String],
	stdin: Bytes,
	exit_status: Int,
	stdout: Bytes,
	stderr: Bytes
}


fixed record Example {
	name: String,
	library_root: String,
	fixture: String,
	expected_c: Option[String],
	first_case: NativeCase,
	remaining_cases: List[NativeCase],
	limits: CostLimits
}


pure func native_case(name: String, stdin: String, exit_status: Int, stdout: String) -> NativeCase:
	{
		name = name,
		cwd = None,
		arguments = [],
		stdin = stdin.to_bytes(),
		exit_status = exit_status,
		stdout = stdout.to_bytes(),
		stderr = "".to_bytes()
	}


pure func argv_case(name: String, arguments: List[String], exit_status: Int, stdout: String) -> NativeCase:
	{ native_case(name, "", exit_status, stdout) | arguments = arguments }


pure func native_command(binary: String, expected: NativeCase) -> ProcessCommand:
	{ command(binary, expected.arguments) |
		cwd = expected.cwd,
		stdin = BytesStdin(expected.stdin),
		environment = [
			{ name = "BLORP_LEAK_CHECK", value = None },
			{ name = "BLORP_MEMORY_STATS", value = None },
		]
	}


pure func verify_native_case_result(expected: NativeCase, actual: ProcessResult) -> Result[Void, String]:
	status ?= match actual.exit:
		Exited(code):
			if code == expected.exit_status:
				Ok(void)
			else:
				Err("expected exit " + expected.exit_status.to_string() + ", got exit " + code.to_string())
		Signaled(signal):
			Err("expected exit " + expected.exit_status.to_string() + ", got signal " + signal.to_string())
		TimedOut:
			Err("expected exit " + expected.exit_status.to_string() + ", got timeout")

	if actual.stdout != expected.stdout:
		Err("stdout: expected hex " + expected.stdout.to_hex() + ", got " + actual.stdout.to_hex())
	else if actual.stderr != expected.stderr:
		Err("stderr: expected hex " + expected.stderr.to_hex() + ", got " + actual.stderr.to_hex())
	else:
		Ok(void)


func run_isolated(program: String, arguments: List[String]) -> Result[ProcessOutput, String]:
	-- Keep a parent's leak mode out of unrelated child commands.
	-- Measurements enable strict allocation diagnostics explicitly.
	run(
		"/usr/bin/env",
		["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", program].concat(arguments),
	)


func run_successfully(program: String, arguments: List[String]) -> Result[ProcessOutput, String]:
	output ?= run_isolated(program, arguments)

	if output.exit_code() != 0:
		Err(program + " failed: " + output.stderr())
	else:
		Ok(output)


-- The Makefile's test-e2e recipe names the compiler under test on its command
-- line; the suite never chooses one itself. `make -C blorp_2 test` builds it first.
func compiler_under_test() -> Result[String, String]:
	match getenv("BLORP2_COMPILER"):
		None:
			Err("BLORP2_COMPILER must name the pilot executable to test; run make -C blorp_2 test-e2e")
		Some(compiler):
			if file_exists(compiler):
				Ok(compiler)
			else:
				Err("BLORP2_COMPILER names a missing pilot executable: " + compiler + "; run make -C blorp_2 test-compiler")


func verify_generated_c(path: String, expected_c: Option[String]) -> Result[Void, String]:
	actual ?= read_file(path)

	match expected_c:
		None:
			Ok(void)
		Some(expected):
			if actual == expected:
				Ok(void)
			else:
				Err("the compiler did not emit the expected example C")


func remove_existing_file(path: String) -> Result[Void, String]:
	if not file_exists(path) or remove_file(path):
		Ok(void)
	else:
		Err("could not remove previous measurement output: " + path)


pure func compilation_command(
	compiler: String,
	directory: String,
	fixture: String,
	library_root: String,
	instruction_check: InstructionCheck,
) -> ProcessCommand:
	arguments = [
		"--library-root",
		library_root,
		fixture,
		directory + "/program.c",
	]
	request = match instruction_check:
		RequiredInstructions:
			command(
				"/usr/bin/time",
				["-l", "-o", directory + "/instructions.txt", compiler].concat(arguments),
			)
		DisabledInstructions:
			command(compiler, arguments)
	{ request |
		environment = [
			{ name = "BLORP_LEAK_CHECK", value = Some("strict") },
			{ name = "BLORP_MEMORY_STATS", value = None },
		]
	}


pure func compilation_output(result: Result[ProcessResult, ProcessError]) -> Result[ProcessResult, String]:
	match result:
		Err(error):
			Err(error.to_string())
		Ok(actual):
			match actual.exit:
				Exited(0):
					if actual.stdout == "".to_bytes():
						Ok(actual)
					else:
						Err("the compiler must have empty stdout on success")
				Exited(code):
					Err("compiler exited with status " + code.to_string() + ": " + actual.stderr.to_string())
				Signaled(signal):
					Err("compiler terminated by signal " + signal.to_string() + ": " + actual.stderr.to_string())
				TimedOut:
					Err("compiler timed out: " + actual.stderr.to_string())


func measure_compilation_cost(
	compiler: String,
	directory: String,
	example: Example,
) -> Result[CompilationCost, String]:
	-- Validate explicit policy before touching fixture outputs or invoking its compiler.
	instruction_check ?= parse_instruction_check(getenv("BLORP_2_INSTRUCTION_CHECK"))
	removed_c ?= remove_existing_file(directory + "/program.c")
	request = compilation_command(compiler, directory, example.fixture, example.library_root, instruction_check)
	-- The environment is installed before time starts the compiler process.
	removed_report ?= match instruction_check:
		RequiredInstructions: remove_existing_file(directory + "/instructions.txt")
		DisabledInstructions: Ok(void)
	compiled ?= compilation_output(run_command(request))

	verified ?= verify_generated_c(directory + "/program.c", example.expected_c)
	allocations ?= parse_allocations(compiled.stderr.to_string())
	instruction_result: Result[Option[Int], String] = match instruction_check:
		RequiredInstructions:
			report ?= read_file(directory + "/instructions.txt")
			count ?= parse_instructions(report)
			Ok(Some(count))
		DisabledInstructions:
			Ok(None)
	instructions ?= instruction_result
	cost: CompilationCost = {
		allocations = allocations,
		instructions = instructions,
	}
	print(example.name + " compiler: " + format_cost(cost, example.limits))
	Ok(cost)


-- Only an already measured budget decision may become explicitly selected debt.
-- Compile, counter, native, sanitizer and strict-accounting errors return earlier.
func check_resource_limits(cost: CompilationCost, limits: CostLimits) -> Result[Void, String]:
	policy ?= parse_resource_policy(getenv("BLORP_2_RESOURCE_POLICY"))
	verdict ?= assess_resource_limits(policy, cost, limits)
	match verdict:
		ResourceChecksPassed: Ok(void)
		InitialBootstrapDebt(measured, ceilings, reason):
			print(format_initial_bootstrap_debt(measured, ceilings, reason))
			Ok(void)
		AllocationDebt(measured, ceilings, reason):
			print(format_allocation_debt(measured, ceilings, reason))
			Ok(void)


func verify_native_result(directory: String, expected_exit: Int) -> Result[Void, String]:
	verify_native_output(directory, expected_exit, "")


func verify_native_output(
	directory: String,
	expected_exit: Int,
	expected_stdout: String,
) -> Result[Void, String]:
	binary ?= link_native(directory)
	run_native_case(binary, native_case("native output", "", expected_exit, expected_stdout))


private func link_native(directory: String) -> Result[String, String]:
	link_native_mode(directory, 0)


private func link_native_mode(directory: String, diagnostics: Int) -> Result[String, String]:
	generated_c: String = directory + "/program.c"
	binary = if diagnostics == 0:
		directory + "/program"
	else:
		directory + "/program-strict"
	linked ?= run_successfully(
		getenv("BLORP_CC").get_or("clang"),
		[
			"-std=c11",
			"-Wall",
			"-Wextra",
			"-Werror",
			"-pedantic",
			"-O0",
			"-fsanitize=address,undefined",
			"-fno-sanitize-recover=all",
			"-DBLORP_MEMORY_DIAGNOSTICS=" + diagnostics.to_string(),
			generated_c,
			"-lm",
			"-o",
			binary,
		],
	)
	Ok(binary)


private func run_native_case(binary: String, expected: NativeCase) -> Result[Void, String]:
	match run_command(native_command(binary, expected)):
		Err(error):
			Err(error.to_string())
		Ok(actual):
			verify_native_case_result(expected, actual)


private func native_case_passed(binary: String, expected: NativeCase) -> Bool:
	match run_native_case(binary, expected):
		Ok(_):
			True
		Err(error):
			print_error(expected.name + ": " + error)
			False


private func verify_native_cases(directory: String, example: Example) -> Result[Void, String]:
	-- Link once; every explicit input case runs this same unmodified binary.
	binary ?= link_native(directory)
	cases = [example.first_case].concat(example.remaining_cases)
	callbacks = cases.map(func(expected: NativeCase):
		(
			expected.name,
			func(): native_case_passed(binary, expected),
		)
	)
	suite: TestSuite = {
		description = example.name + " native inputs",
		tests = callbacks
	}
	result = run_suite_result(suite)

	if result[1] == 0:
		Ok(void)
	else:
		Err("native input cases failed")


func verify_rejected_command(
	compiler: String,
	library_root: String,
	input: String,
	output: String,
	expected: String,
) -> Result[Void, String]:
	rejected ?= run_isolated(
		compiler,
		["--library-root", library_root, input, output],
	)

	if (
		rejected.exit_code() != 1
		or rejected.stdout() != ""
		or rejected.stderr() != expected
	):
		Err("rejected input must exit 1 with the expected location, diagnostic, and help")
	else:
		Ok(void)


func verify_rejected_input(compiler: String, directory: String) -> Result[Void, String]:
	other_source: String =
		|func start() -> Int:
		|	0
		|
	input: String = directory + "/invalid.brp"
	output: String = directory + "/rejected.c"
	written_input ?= write_file(input, other_source)
	expected: String = input + ":3:1: error: expected a main function\nhelp: declare func main() -> Int: as the entrypoint\n"
	missing_output_rejection ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, expected)

	missing_output ?= if file_exists(output):
		Err("rejected source created a C output file")
	else:
		Ok(void)

	written_output ?= write_file(output, "preserve this output")
	existing_output_rejection ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, expected)
	actual ?= read_file(output)

	if actual != "preserve this output":
		Err("rejected source overwrote the existing output")
	else:
		Ok(void)


func verify_all(compiler: String, directory: String, example: Example) -> Result[Void, String]:
	cost ?= measure_compilation_cost(compiler, directory, example)
	native_result ?= verify_native_cases(directory, example)
	check_resource_limits(cost, example.limits)


private func check_in_directory(check: (String) -> Result[Void, String]) -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-e2e-"):
		match check(directory.resource_path()):
			Ok(_):
				Ok(True)
			Err(error):
				print_error(error)
				Ok(False)


func with_directory(check: (String) -> Result[Void, String]) -> Bool:
	match check_in_directory(check):
		Ok(passed):
			passed
		Err(error):
			print_error(error.to_string())
			False


func run_example(compiler: String, example: Example) -> Bool:
	with_directory(func(directory: String): verify_all(compiler, directory, example))


-- All examples use their own main and the same unchanged-C execution path.
func run_source_example(
	compiler: String,
	fixture: String,
	expected_exit: Int,
	limits: CostLimits,
) -> Bool:
	run_example(
		compiler,
		{
			name = fixture,
			library_root = "blorp_2/standard_library",
			fixture = fixture,
			expected_c = None,
			first_case = native_case("native output", "", expected_exit, ""),
			remaining_cases = [],
			limits = limits
		},
	)


func run_output_example(
	compiler: String,
	fixture: String,
	expected_stdout: String,
	limits: CostLimits,
) -> Bool:
	run_example(
		compiler,
		{
			name = fixture,
			library_root = "blorp_2/standard_library",
			fixture = fixture,
			expected_c = None,
			first_case = native_case("native output", "", 0, expected_stdout),
			remaining_cases = [],
			limits = limits
		},
	)


-- Supplemental target accounting uses the same generated C and real main.
-- Zero is explicit because a scalar-only fixture can have no target heap work.
union TargetAllocations:
	ZeroTargetAllocations
	PositiveTargetAllocations


private func verify_target_allocations(report: Bytes, expected: TargetAllocations) -> Result[Void, String]:
	match expected:
		ZeroTargetAllocations:
			if report == "blorp: leak check: 0 allocs, 0 releases, 0 leaked, 0 bytes\n".to_bytes():
				Ok(void)
			else:
				Err("expected the complete balanced zero-allocation target report; got " + report.to_hex())
		PositiveTargetAllocations:
			match parse_allocations(report.to_string()):
				Err(error): Err("target allocation report: " + error)
				Ok(count):
					exact = "blorp: leak check: " + count.to_string() + " allocs, " + count.to_string() + " releases, 0 leaked, 0 bytes\n"
					if report == exact.to_bytes():
						Ok(void)
					else:
						Err("expected exactly one complete target allocation report; got " + report.to_hex())


private func verify_accounted_native_case(
	binary: String,
	expected: NativeCase,
	allocation_policy: TargetAllocations,
	evidence_c_path: String,
) -> Result[Void, String]:
	request = { native_command(binary, expected) |
		environment = [
			{ name = "BLORP_LEAK_CHECK", value = Some("strict") },
			{ name = "BLORP_MEMORY_STATS", value = None },
		]
	}
	actual ?= match run_command(request):
		Err(error): Err(error.to_string())
		Ok(result): Ok(result)
	reported ?= write_bytes(evidence_c_path + ".memory.txt", actual.stderr)
	accounted ?= verify_target_allocations(actual.stderr, allocation_policy)
	-- The entire stderr has been consumed as a strict accounting report above.
	-- Removing only that validated report preserves the original expected stderr
	-- as well as the normal exact exit/stdout checks.
	verify_native_case_result(expected, { actual | stderr = "".to_bytes() })


private func verify_accounted_example(
	compiler: String,
	directory: String,
	example: Example,
	allocation_policy: TargetAllocations,
	evidence_c_path: String,
) -> Result[Void, String]:
	cost ?= measure_compilation_cost(compiler, directory, example)
	generated ?= read_file(directory + "/program.c")
	prepared ?= create_directories(dirname(evidence_c_path)).map_err(pure func(error): error.to_string())
	retained ?= write_file(evidence_c_path, generated)
	normal ?= link_native_mode(directory, 0)
	normal_passed ?= run_native_case(normal, example.first_case)
	strict ?= link_native_mode(directory, 1)
	strict_passed ?= verify_accounted_native_case(strict, example.first_case, allocation_policy, evidence_c_path)
	check_resource_limits(cost, example.limits)


-- This bounded helper has one input case per fixture. The existing ordinary
-- suite and its multi-input helper retain their normal execution contract.
func run_accounted_example(
	compiler: String,
	library_root: String,
	fixture: String,
	expected_exit: Int,
	expected_stdout: String,
	limits: CostLimits,
	allocation_policy: TargetAllocations,
	evidence_c_path: String,
) -> Bool:
	example: Example = {
		name = fixture,
		library_root = library_root,
		fixture = fixture,
		expected_c = None,
		first_case = native_case("native output", "", expected_exit, expected_stdout),
		remaining_cases = [],
		limits = limits,
	}
	with_directory(func(directory: String): verify_accounted_example(compiler, directory, example, allocation_policy, evidence_c_path))
