import:
	./harness: Example, native_case, verify_all, with_directory
	test: TestSuite


func verify_concat(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "fresh concat with aliasing UTF-8 and NUL operands",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/string_operations/concat.brp",
		expected_c = None,
		first_case = native_case("real main", "", 0, "é\0😀é\0😀\né\0😀\n\n"),
		remaining_cases = [],
		limits = { allocations = 205000, instructions = 600000000 }
	}
	verify_all(compiler, directory, example)


private func run_concat(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_concat(compiler, directory))


private func run_reuse(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_all(compiler, directory, {
		name = "concat-only accumulation and counted aliases",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/string_operations/concat_reuse.brp",
		expected_c = None,
		first_case = native_case("real main", "", 0, "xxxxxxxx\né\0\né\0😀\nsamesame\n"),
		remaining_cases = [],
		limits = { allocations = 205000, instructions = 600000000 }
	}))


private func run_integer_append(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_all(compiler, directory, {
		name = "direct integer append edges aliases callables and mixed loop",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/string_operations/append_int_builtin.brp",
		expected_c = None,
		first_case = native_case("real main", "", 0,
			"zero=0\nnegative=-7\nminimum=-9223372036854775808\nmaximum=9223372036854775807\né\0\né\0-7\nnamed=12\nstored=-7\nvalue=0\nvalue=1\nvalue=2\n\n"),
		remaining_cases = [],
		limits = { allocations = 205000, instructions = 1800000000 }
	}))


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 String concat",
		tests = [
			("concatenation borrows aliased operands and returns exact bytes", func(): run_concat(compiler)),
			("concat-only accumulation preserves shared aliases and exact bytes", func(): run_reuse(compiler)),
			("direct integer append preserves decimal edges aliases and mixed accumulation", func(): run_integer_append(compiler)),
		]
	}
