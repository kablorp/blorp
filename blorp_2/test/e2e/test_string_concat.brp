import:
	./harness: Example, native_case, verify_all, with_directory
	test: TestSuite


func verify_concat(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "fresh concat with aliasing UTF-8 and NUL operands",
		fixture = "blorp_2/test/e2e/fixtures/string_operations/concat.brp",
		expected_c = None,
		first_case = native_case("real main", "", 0, "é\0😀é\0😀\né\0😀\n\n"),
		remaining_cases = [],
		limits = { allocations = 205000, instructions = 600000000 }
	}
	verify_all(compiler, directory, example)


private func run_concat(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_concat(compiler, directory))


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 String concat",
		tests = [("concatenation borrows aliased operands and returns exact bytes", func(): run_concat(compiler))]
	}
