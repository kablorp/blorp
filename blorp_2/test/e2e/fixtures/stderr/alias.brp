import:
    io: print_error
func choose(selected: Bool, message: String) -> Void:
    match selected:
        True: print_error(message)
        False: print_error("unselected")
func main() -> Int:
    var message = "old"
    kept_message = message
    print_error(message)
    message = "new"
    print_error(kept_message)
    choose(True, message)
    print_error(message)
    3
