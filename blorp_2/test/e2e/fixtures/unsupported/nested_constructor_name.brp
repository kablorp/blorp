-- A field written as a bare name that spells a constructor of the field's
-- union is a nested constructor pattern, not a binding; checking rejects it
-- until the pattern-compilation milestone. (Bound as a name, the one arm
-- would match every value and this program would compile and exit 1.)
fixed union Inner:
	A
	B

fixed union Outer:
	Wrap(Inner)

pure func make() -> Outer:
	Wrap(B)

func main() -> Int:
	match make():
		Wrap(A): 1
