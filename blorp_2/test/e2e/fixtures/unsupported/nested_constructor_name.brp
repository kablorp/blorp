-- A field written as a bare name that spells a constructor of the field's
-- union is a nested constructor pattern, not a binding. The missing Wrap(B)
-- must be diagnosed. If A were incorrectly bound as a name, this one arm
-- would match every value and the program would instead compile and exit 1.
union Inner:
	A
	B

union Outer:
	Wrap(Inner)

pure func make() -> Outer:
	Wrap(B)

func main() -> Int:
	match make():
		Wrap(A): 1
