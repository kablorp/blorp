-- The nested constructor covers every value of these single-variant unions.
-- The later fallback must therefore be rejected as unreachable.
fixed union Inner:
	Two(Int)

fixed union Outer:
	Wrap(Inner)

pure func make() -> Outer:
	Wrap(Two(1))

func main() -> Int:
	match make():
		Wrap(Two(_)): 1
		_: 0
