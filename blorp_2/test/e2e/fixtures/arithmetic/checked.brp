import:
    _base: MathError(DivisionByZero, Overflow)
    io: print
    int: INT_MIN, INT_MAX, add_checked, subtract_checked, multiply_checked, divide_checked, remainder_checked, negate_checked

pure func shown(result: Result[Int, MathError]) -> String:
    match result:
        Ok(value): value.to_string()
        Err(DivisionByZero): "division by zero"
        Err(Overflow): "overflow"

-- One output line per function: the label, then each result in order.
pure func line(label: String, results: List[Result[Int, MathError]]) -> String:
    var text = label
    var separator = " "
    for result in results:
        text = text + separator + shown(result)
        separator = ", "
    text

-- Each function's cases start in range, then cover every branch and both sides
-- of each bounds test. 3037000499 is the largest square root that fits;
-- 3037000500 squared exceeds INT_MAX.
func main() -> Int:
    print(line("add", [
        add_checked(40, 2),
        add_checked(INT_MAX, INT_MIN),
        add_checked(INT_MAX, 1),
        add_checked(INT_MAX - 1, 1),
        add_checked(INT_MIN, -1),
        add_checked(-1, INT_MIN),
        add_checked(INT_MIN, 0),
    ]))
    print(line("subtract", [
        subtract_checked(5, 7),
        subtract_checked(INT_MIN, 1),
        subtract_checked(INT_MIN + 1, 1),
        subtract_checked(INT_MIN, 0),
        subtract_checked(INT_MAX, -1),
        subtract_checked(0, INT_MIN),
        subtract_checked(-1, INT_MIN),
    ]))
    print(line("multiply", [
        multiply_checked(-6, 7),
        multiply_checked(0, INT_MIN),
        multiply_checked(INT_MIN, 0),
        multiply_checked(INT_MIN, 1),
        multiply_checked(INT_MIN, -1),
        multiply_checked(-1, INT_MIN),
        multiply_checked(-1, INT_MAX),
        multiply_checked(INT_MAX, 2),
        multiply_checked(-4611686018427387904, 2),
        multiply_checked(4611686018427387904, 2),
        multiply_checked(3037000499, 3037000499),
        multiply_checked(3037000500, 3037000500),
        multiply_checked(-3037000500, 3037000500),
    ]))
    print(line("divide", [
        divide_checked(-7, 2),
        divide_checked(7, 0),
        divide_checked(INT_MIN, 1),
        divide_checked(INT_MIN, -1),
        divide_checked(INT_MAX, -1),
    ]))
    print(line("remainder", [remainder_checked(-7, 2), remainder_checked(7, 0), remainder_checked(INT_MIN, -1)]))
    print(line("negate", [negate_checked(5), negate_checked(0), negate_checked(INT_MAX), negate_checked(INT_MIN)]))
    -- The prelude's Int methods reach the checked forms through UFCS.
    print(line("method", [INT_MAX.add_checked(1), 6.multiply_checked(7)]))
    0
