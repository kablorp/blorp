import:
    io: print
    float: copysign
    int: INT_MIN, INT_MAX, multiply, remainder

-- Each helper reaches its member only through its bound, so every row below
-- dispatches through a trait implementation. Two helpers call the selected
-- member names directly; the others use UFCS.
pure func sum[Value: Addable](left: Value, right: Value) -> Value:
    left.add(right)

pure func difference[Value: Subtractable](left: Value, right: Value) -> Value:
    left.subtract(right)

pure func product[Value: Multipliable](left: Value, right: Value) -> Value:
    multiply(left, right)

pure func quotient[Value: Divisible](left: Value, right: Value) -> Value:
    left.divide(right)

pure func modulo[Value: Modulable](left: Value, right: Value) -> Value:
    remainder(left, right)

pure func negation[Value: Negatable](value: Value) -> Value:
    value.negate()

-- A dying total moves into each sum, so a String total grows in place rather
-- than being copied on every turn; the allocation count pins that.
pure func repeated[Value: Addable](start: Value, step: Value, count: Int) -> Value:
    var total = start
    for _ in 0..count:
        total = sum(total, step)
    total

-- Rows: Int sum, wrap above INT_MAX, wrap below INT_MIN, product, truncating
-- quotient and remainder, both by zero, INT_MIN by -1 for each, negation and
-- negation of INT_MIN; Float sum, difference, product, quotient, remainder, both
-- by zero, quotient by -0.0 (positive zero, which prints 0), negation, negated
-- infinity, and the sign of negated 0.0 and -0.0; String concatenation, and
-- repeated Int and String sums.
func main() -> Int:
    print(sum(40, 2).to_string())
    print(sum(INT_MAX, 1).to_string())
    print(difference(INT_MIN, 1).to_string())
    print(product(-6, 7).to_string())
    print(quotient(-7, 2).to_string())
    print(modulo(-7, 2).to_string())
    print(quotient(7, 0).to_string())
    print(modulo(7, 0).to_string())
    print(quotient(INT_MIN, -1).to_string())
    print(modulo(INT_MIN, -1).to_string())
    print(negation(5).to_string())
    print(negation(INT_MIN).to_string())
    print(sum(1.5, 2.25).to_string())
    print(difference(1.0, 2.5).to_string())
    print(product(1.5, -2.0).to_string())
    print(quotient(7.0, 2.0).to_string())
    print(modulo(-7.5, 2.0).to_string())
    print(quotient(1.0, 0.0).to_string())
    print(modulo(1.0, 0.0).to_string())
    print(quotient(1.0, -0.0).to_string())
    print(negation(2.5).to_string())
    infinity: Float = 1.0e308.multiply(10.0)
    print(negation(infinity).to_string())
    print(copysign(1.0, negation(0.0)).to_string())
    print(copysign(1.0, negation(-0.0)).to_string())
    print(sum("con", "cat"))
    print(repeated(0, 3, 4).to_string())
    print(repeated("", "ab", 8))
    0
