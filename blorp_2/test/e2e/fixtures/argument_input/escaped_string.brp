import:
    list: get
    io: print
fixed union Box[T]:
    Box(T)
pure func box[T](value: T) -> Box[T]:
    Box(value)
pure func unbox[T](wrapped: Box[T]) -> T:
    match wrapped:
        Box(value): value
pure func returned_alias(values: List[String]) -> List[String]:
    unbox(box(values))
pure func escaped_string(values: List[String]) -> Option[String]:
    alias = returned_alias(values)
    get(alias, 1)
func report(value: Option[String]) -> Int:
    match value:
        Some(text):
            print(text)
            0
        None:
            print("missing")
            1
func main(arguments: List[String]) -> Int:
    first_status = report(escaped_string(arguments))
    report(get(arguments, 1))
