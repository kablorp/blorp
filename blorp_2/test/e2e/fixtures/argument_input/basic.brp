import:
    list: get, length
    int: to_string
    io: print
func show(value: Option[String]) -> Void:
    match value:
        Some(text): print(text)
        None: print("missing")
func show_executable(value: Option[String]) -> Void:
    match value:
        Some(_): print("executable present")
        None: print("missing executable")
func main(supplied: List[String]) -> Int:
    print(to_string(length(supplied)))
    show_executable(get(supplied, 0))
    show(get(supplied, 1))
    show(get(supplied, 2))
    show(get(supplied, -1))
    show(get(supplied, length(supplied)))
    show(get(supplied, -9223372036854775808))
    show(get(supplied, 9223372036854775807))
    0
