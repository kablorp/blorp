import:
    option: Option(Some, None)
    string: parse_int
    int: to_string
    io: print, read_line
func input_line(line: Option[String]) -> Int:
    match line:
        Some(text): number(parse_int(text))
        None:
            print("missing input")
            1
func number(value: Option[Int]) -> Int:
    match value:
        Some(parsed):
            print(to_string(parsed))
            0
        None:
            print("invalid integer")
            1
func main() -> Int:
    input_line(read_line())
