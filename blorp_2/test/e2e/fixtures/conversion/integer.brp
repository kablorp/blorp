import:
    list: get
    string: parse_int
    int: to_string
    io: print
pure func parse_argument(argument: Option[String]) -> Result[Int, String]:
    match argument:
        Some(text): parsed_number(parse_int(text))
        None: Err("missing input")
pure func parsed_number(number: Option[Int]) -> Result[Int, String]:
    match number:
        Some(value): Ok(value)
        None: Err("invalid integer")
pure func evaluate(args: List[String]) -> Result[Int, String]:
    parse_argument(get(args, 1))
func report(result: Result[Int, String]) -> Int:
    match result:
        Ok(value):
            print(to_string(value))
            0
        Err(message):
            print(message)
            1
func main(args: List[String]) -> Int:
    report(evaluate(args))
