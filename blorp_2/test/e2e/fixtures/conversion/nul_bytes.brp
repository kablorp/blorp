import:
    string: parse_int, parse_float, equals
    io: print
func integer_result(number: Option[Int]) -> Void:
    match number:
        Some(_): print("unexpected integer")
        None: print("invalid integer")
func float_result(number: Option[Float]) -> Void:
    match number:
        Some(_): print("unexpected float")
        None: print("invalid float")
func equality_result(equal: Bool) -> Void:
    match equal:
        True: print("same")
        False: print("different")
func main() -> Int:
    integer_result(parse_int("42\0123"))
    float_result(parse_float("6.5\0123"))
    equality_result(equals("multiply\0123", "multiply\0123"))
    equality_result(equals("multiply\0123", "multiply\0124"))
    0
