import:
	io: print
	string as StringOps


-- Keep the public library on the supported old label until seed publication.
pure func append_number(text: String, number: Int) -> String:
	builtin("string.append_int")


pure func apply_number(callback: pure (String, Int) -> String, text: String, number: Int) -> String:
	callback(text, number)


pure func stored_append() -> pure (String, Int) -> String:
	append_number


pure func render_lines() -> String:
	var output = ""
	for number in 0..3:
		output = StringOps.add(output, "value=")
		output = output.append_number(number)
		output = StringOps.add(output, "\n")
	output


func main() -> Int:
	print(append_number("zero=", 0))
	print("negative=".append_number(-7))
	print(append_number("minimum=", -9223372036854775808))
	print(append_number("maximum=", 9223372036854775807))
	before = "é\0"
	after = append_number(before, -7)
	print(before)
	print(after)
	print(apply_number(append_number, "named=", 12))
	callback = stored_append()
	print(callback("stored=", -7))
	print(render_lines())
	0
