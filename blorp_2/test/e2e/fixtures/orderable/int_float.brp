import:
    io: print
    float: abs

-- One digit per Orderable member, in declaration order: <, >, <=, >=.
pure func digit(value: Bool) -> String:
    if value:
        "1"
    else:
        "0"

pure func ordering_digits[Value: Orderable](left: Value, right: Value) -> String:
    less = digit(left.less_than(right))
    greater = digit(left.greater_than(right))
    at_most = digit(left.less_than_or_equal(right))
    at_least = digit(left.greater_than_or_equal(right))
    "${less}${greater}${at_most}${at_least}"

-- Rows: Int below, equal, above; Float below, -0.0 against 0.0, infinity against
-- itself, -infinity against infinity; NaN on the left, the right and both sides;
-- abs(-2.5) against 2.5.
func main() -> Int:
    print(ordering_digits(2, 3))
    print(ordering_digits(3, 3))
    print(ordering_digits(-4, -5))
    print(ordering_digits(1.5, 2.5))
    print(ordering_digits(-0.0, 0.0))
    infinity: Float = 1.0e308.multiply(10.0)
    negative_infinity: Float = infinity.multiply(-1.0)
    print(ordering_digits(infinity, infinity))
    print(ordering_digits(negative_infinity, infinity))
    nan: Float = infinity.subtract(infinity)
    print(ordering_digits(nan, 1.0))
    print(ordering_digits(1.0, nan))
    print(ordering_digits(nan, nan))
    print(ordering_digits(abs(-2.5), 2.5))
    0
