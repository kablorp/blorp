import:
    path: join
    io: print

pure func combine(base: String, child: String) -> String:
    join(base, child)

func main(args: List[String]) -> Int:
    match args.get(1):
        None:
            2
        Some(base):
            match args.get(2):
                None:
                    2
                Some(child):
                    print(combine(base, child))
                    0
