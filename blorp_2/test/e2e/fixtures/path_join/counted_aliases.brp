import:
    path: join
    string: add
    io: print

pure func combine(base: String, child: String) -> String:
    join(base, child)

func main() -> Int:
    segment = add("é", "\0part")
    print(combine("a\0b", "c\0d"))
    print(combine("a\0/", "b"))
    print(combine("base", "/a\0b"))
    print(combine(segment, segment))
    print(segment)
    print(combine("", segment))
    print(combine(segment, ""))
    0
