import:
    io: print
record Entry { number: Int, text: String }
pure func make_entry(number: Int) -> Entry:
    { number = number, text = number.to_string() }
pure func identity(value: Entry) -> Entry:
    value
pure func escaped_text(value: Entry) -> String:
    value.text
func main() -> Void:
    var current = make_entry(42)
    original = identity(current)
    current = make_entry(7)
    print(original.number.to_string())
    print(escaped_text(original))
    print(current.number.to_string())
    print(escaped_text(current))
