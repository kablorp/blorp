fixed record Packet { payload: Option[Int] }
pure func make_packet(value: Option[Int]) -> Packet:
    { payload = value }
pure func unbox(value: Option[Int]) -> Int:
    match value:
        Some(number): number
        None: 0
func main() -> Int:
    present = unbox(make_packet(Some(42)).payload)
    absent = unbox(make_packet(None).payload)
    present.add(absent)
