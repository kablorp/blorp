import:
    io: print
record Arguments { values: List[String] }
pure func make_arguments(values: List[String]) -> Arguments:
    { values = values }
pure func escaped_list(value: Arguments) -> List[String]:
    value.values
pure func escaped_element(value: Arguments) -> Option[String]:
    value.values.get(1)
func report(value: Option[String]) -> Int:
    match value:
        Some(text):
            print(text)
            0
        None:
            print("missing")
            1
func main(arguments: List[String]) -> Int:
    value = make_arguments(arguments)
    print(escaped_list(value).length().to_string())
    report(escaped_element(make_arguments(escaped_list(value))))
