union Box[T]:
    Box(T)
record Entry { text: String }
pure func make_entry(number: Int) -> Entry:
    { text = number.to_string() }
pure func box[T](value: T) -> Box[T]:
    Box(value)
pure func unbox[T](value: Box[T]) -> T:
    match value:
        Box(payload): payload
pure func identity[T](value: T) -> T:
    value
func main() -> Int:
    var current = box(make_entry(42))
    original = identity(current)
    current = box(make_entry(7))
    unbox(original).text.length()
