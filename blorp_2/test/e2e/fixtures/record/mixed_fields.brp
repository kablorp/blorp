import:
    io: print
fixed record Entry { count: Int, ratio: Float, text: String }
pure func make_entry() -> Entry:
    { text = 42.to_string(), ratio = 2.5, count = 7 }
func main() -> Void:
    value = make_entry()
    print(value.count.to_string())
    print(value.ratio.to_string())
    print(value.text)
