import:
    io: print
fixed record Numeric { count: Int, ratio: Float }
fixed record Nested { value: Numeric, extra: Int }
pure func make_nested() -> Nested:
    { value = { ratio = 2.5, count = 7 }, extra = 9 }
func main() -> Void:
    value = make_nested()
    print(value.value.count.to_string())
    print(value.value.ratio.to_string())
    print(value.extra.to_string())
