import:
    io: print
fixed record Pair[A, B] { first: A, second: B }
pure func preserve[T](value: Pair[T, T]) -> Pair[T, T]:
    value
func logged(number: Int) -> Int:
    print(number.to_string())
    number
func main() -> Void:
    value = preserve({ second = logged(7), first = logged(9) })
    print(value.first.to_string())
    print(value.second.to_string())
