import:
    io: print
fixed record Marker[A, B] { value: Int }
pure func forward() -> Marker[Int, String]:
    { value = 7 }
pure func reverse() -> Marker[String, Int]:
    { value = 9 }
pure func read[A, B](value: Marker[A, B]) -> Int:
    value.value
func main() -> Void:
    print(read(forward()).to_string())
    print(read(reverse()).to_string())
