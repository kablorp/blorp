import:
    io: print
fixed record Box[T] { value: T }
pure func box[T](value: T) -> Box[T]:
    { value = value }
pure func unbox[T](value: Box[T]) -> T:
    value.value
func main() -> Void:
    text = unbox(box(42.to_string()))
    number = unbox(box(7))
    print(text)
    print(number.to_string())
