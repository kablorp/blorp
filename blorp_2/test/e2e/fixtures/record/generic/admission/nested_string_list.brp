import:
    io: print
fixed record Values[T] { items: List[T] }
union Stored[T]:
    Kept(Values[T])
pure func selected(items: List[String]) -> String:
    match items.get(1):
        Some(text): text
        None: "missing"
pure func read(value: Stored[String]) -> String:
    match value:
        Kept(values): selected(values.items)
pure func stored(items: List[String]) -> Stored[String]:
    Kept({ items = items })
func main(arguments: List[String]):
    print(read(stored(arguments)))
