import:
    io: print
fixed record Pair[A, B] { first: A, second: B }
pure func pair[A, B](first: A, second: B) -> Pair[A, B]:
    { second = second, first = first }
pure func first[A, B](value: Pair[A, B]) -> A:
    value.first
pure func second[A, B](value: Pair[A, B]) -> B:
    value.second
func main() -> Void:
    forward = pair(7, 42.to_string())
    reverse = pair(9.to_string(), 3)
    print(first(forward).to_string())
    print(second(forward))
    print(first(reverse))
    print(second(reverse).to_string())
