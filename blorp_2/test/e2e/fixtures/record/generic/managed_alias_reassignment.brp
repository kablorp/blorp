import:
    io: print
record Box[T] { value: T }
pure func box[T](value: T) -> Box[T]:
    { value = value }
pure func unbox[T](value: Box[T]) -> T:
    value.value
func main() -> Void:
    var current = box(42.to_string())
    original = current
    escaped = unbox(current)
    current = box(7.to_string())
    print(unbox(original))
    print(escaped)
    print(unbox(current))
