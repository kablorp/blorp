fixed union Box[T]:
    Box(T)
fixed record Entry { count: Int, text: String }
pure func make_entry() -> Entry:
    { count = 7, text = 42.to_string() }
pure func box[T](value: T) -> Box[T]:
    Box(value)
pure func unbox[T](value: Box[T]) -> T:
    match value:
        Box(payload): payload
func main() -> Int:
    unbox(box(make_entry())).text.length()
