union Box[T]:
    Box(T)
fixed record Packet { payload: Box[Box[String]] }
pure func box[T](value: T) -> Box[T]:
    Box(value)
pure func unbox[T](value: Box[T]) -> T:
    match value:
        Box(payload): payload
pure func make_packet() -> Packet:
    { payload = box(box(42.to_string())) }
func main() -> Int:
    unbox(unbox(make_packet().payload)).length()
