fixed union Box[T]:
    Box(T)
fixed record Packet { payload: Box[String], code: Int }
pure func box[T](value: T) -> Box[T]:
    Box(value)
pure func unbox[T](value: Box[T]) -> T:
    match value:
        Box(payload): payload
pure func make_packet() -> Packet:
    { payload = box(42.to_string()), code = 7 }
pure func escaped_payload(value: Packet) -> Box[String]:
    value.payload
func main() -> Int:
    unbox(escaped_payload(make_packet())).length()
