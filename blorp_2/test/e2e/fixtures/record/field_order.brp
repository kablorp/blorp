import:
    io: print
record Ordered { first: String, middle: Void, last: String }
func logged(number: Int) -> String:
    print(number.to_string())
    number.to_string()
func mark() -> Void:
    print("middle")
func main() -> Void:
    value = { last = logged(3), middle = mark(), first = logged(1) }.identity()
    print(value.first)
    print(value.last)
    value.middle
pure func identity(value: Ordered) -> Ordered:
    value
