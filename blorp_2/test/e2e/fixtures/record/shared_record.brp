fixed record Leaf { text: String }
fixed record Pair { first: Leaf, second: Leaf }
pure func make_pair() -> Pair:
    value = { text = 42.to_string() }.identity()
    { first = value, second = value }
pure func identity(value: Leaf) -> Leaf:
    value
func main() -> Int:
    value = make_pair()
    value.first.text.length().add(value.second.text.length())
