import:
    io: print
fixed union Message:
    Empty
    Mixed(Int, Float, String, Void)
pure func make() -> Message:
    Mixed(7, 2.5, 42.to_string(), void)
func show(value: Message) -> Void:
    match value:
        Empty: print("empty")
        Mixed(count, ratio, text, _):
            print(count.to_string())
            print(ratio.to_string())
            print(text)
func main() -> Void:
    show(make())
