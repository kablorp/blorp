import:
    io: print
union Message:
    Pair(String, String)
pure func make(first: Int, second: Int) -> Message:
    Pair(first.to_string(), second.to_string())
pure func preserve(value: Message) -> Message:
    match value:
        _: value
pure func left(value: Message) -> String:
    match value:
        Pair(first, _): first
pure func right(value: Message) -> String:
    match value:
        Pair(_, second): second
func main() -> Void:
    var current = make(7, 42)
    original = preserve(current)
    escaped_left = left(current)
    escaped_right = right(current)
    current = make(9, 3)
    print(left(original))
    print(right(original))
    print(escaped_left)
    print(escaped_right)
    print(left(current))
    print(right(current))
