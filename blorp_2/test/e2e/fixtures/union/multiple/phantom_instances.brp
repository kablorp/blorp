import:
    io: print
fixed record Marker[T] { text: String }
fixed union Marks:
    Pair(Marker[Int], Marker[String])
pure func first() -> Marker[Int]:
    { text = 7.to_string() }
pure func second() -> Marker[String]:
    { text = 42.to_string() }
pure func make() -> Marks:
    Pair(first(), second())
pure func left(value: Marks) -> String:
    match value:
        Pair(first, _): first.text
pure func right(value: Marks) -> String:
    match value:
        Pair(_, second): second.text
func main() -> Void:
    print(left(make()))
    print(right(make()))
