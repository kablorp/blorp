import:
    io: print
fixed union Message:
    Empty
    Pair(String, String)
func first() -> String:
    print("left")
    "7"
func second() -> String:
    print("right")
    "42"
func make() -> Message:
    Pair(first(), second())
pure func escaped(value: Message) -> String:
    match value:
        Empty: "empty"
        Pair(_, right): right
func main() -> Void:
    print(escaped(make()))
