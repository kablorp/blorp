import:
    io: print
union Message:
    Empty
    Pair(String, String)
pure func make() -> Message:
    Pair(7.to_string(), 42.to_string())
pure func escaped(value: Message) -> String:
    match value:
        Empty: "empty"
        Pair(_, right): right
func main() -> Void:
    print(escaped(make()))
