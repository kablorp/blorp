import:
    io: print
fixed union Pair[A, B]:
    Pair(A, B)
pure func make[A, B](first: A, second: B) -> Pair[A, B]:
    Pair(first, second)
pure func left[A, B](value: Pair[A, B]) -> A:
    match value:
        Pair(first, _): first
pure func right[A, B](value: Pair[A, B]) -> B:
    match value:
        Pair(_, second): second
func main() -> Void:
    first = make(7, 42.to_string())
    second = make(42.to_string(), 7)
    print(right(first))
    print(left(second))
