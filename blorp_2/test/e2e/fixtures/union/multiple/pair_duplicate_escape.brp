fixed union Message:
    Empty
    Pair(String, String)
pure func make(value: Int) -> Message:
    text = value.to_string()
    Pair(text, text)
pure func escaped(value: Message) -> String:
    match value:
        Empty: "empty"
        Pair(left, _): left
func main() -> Int:
    escaped(make(42)).length()
