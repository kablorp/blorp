union Outer:
    Value(Inner)
union Inner:
    Wrapped(Payload)
record Payload { value: Int }
pure func make() -> Outer:
    Value(Wrapped({ value = 7 }))
pure func inner(value: Outer) -> Inner:
    match value:
        Value(item): item
pure func payload(value: Inner) -> Payload:
    match value:
        Wrapped(item): item
func main() -> Int:
    payload(inner(make())).value
