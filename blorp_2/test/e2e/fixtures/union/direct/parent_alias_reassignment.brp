import:
    io: print
union Message:
    Empty
    Text(String)
pure func make(number: Int) -> Message:
    Text(number.to_string())
pure func read(value: Message) -> String:
    match value:
        Empty: "empty"
        Text(text): text
func main() -> Void:
    var current = make(42)
    original = current
    escaped = read(current)
    current = make(7)
    print(read(original))
    print(escaped)
    print(read(current))
