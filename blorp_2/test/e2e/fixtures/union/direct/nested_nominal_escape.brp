import:
    io: print
fixed record Box[T] { value: T }
union Message:
    Empty
    Wrapped(Box[Option[String]])
pure func make() -> Message:
    Wrapped({ value = Some(42.to_string()) })
pure func read_box(value: Message) -> Box[Option[String]]:
    match value:
        Empty: { value = None }
        Wrapped(box): box
pure func read_text(value: Option[String]) -> String:
    match value:
        None: "empty"
        Some(text): text
func main() -> Void:
    print(read_text(read_box(make()).value))
