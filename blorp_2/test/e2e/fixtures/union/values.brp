fixed union Choice:
	First
	Second
pure func first() -> Choice:
	First
pure func second() -> Choice:
	Second
pure func identity(value: Choice) -> Choice:
	value
pure func direct() -> Choice:
	identity(Second)
pure func receiver() -> Choice:
	First.identity()
func main() -> Int:
	first_choice = first()
	second_choice = second()
	copied = identity(first_choice)
	direct_choice = direct()
	receiver_choice = receiver()
	match receiver_choice:
		First: 0
		Second: 1
