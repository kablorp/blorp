import:
    io: print
private record Secret { value: Int }
private union Mood:
    Calm
    Loud(String)
private pure func open(secret: Secret) -> Int:
    secret.value
private pure func shout(mood: Mood) -> String:
    match mood:
        Calm: "calm"
        Loud(text): text
func main() -> Void:
    secret: Secret = { value = 6 }
    print(open(secret).to_string())
    print(shout(Loud("loud")))
    print(shout(Calm))
