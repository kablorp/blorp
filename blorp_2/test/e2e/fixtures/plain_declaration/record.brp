import:
    io: print
record Point { x: Int, y: Int }
record Labelled { label: String, values: List[Int] }
record Box[T] { value: T }
record Pair[A, B] { first: A, second: B }
pure func moved(point: Point) -> Point:
    { point | x = 5 }
pure func labelled() -> Labelled:
    { label = 42.to_string(), values = [1, 2, 3] }
pure func relabelled(value: Labelled) -> Labelled:
    { value | label = 7.to_string() }
pure func box[T](value: T) -> Box[T]:
    { value = value }
pure func swapped[A, B](pair: Pair[A, B]) -> Pair[B, A]:
    { first = pair.second, second = pair.first }
func main() -> Void:
    point: Point = { x = 1, y = 2 }
    shifted = moved(point)
    print(point.x.to_string())
    print(shifted.x.to_string())
    print(shifted.y.to_string())
    old = labelled()
    fresh = relabelled(old)
    print(old.label)
    print(fresh.label)
    print(fresh.values.length().to_string())
    print(box("kept").value)
    print(box(9).value.to_string())
    pair: Pair[Int, String] = { first = 3, second = "three" }
    print(swapped(pair).first)
    print(swapped(pair).second.to_string())
