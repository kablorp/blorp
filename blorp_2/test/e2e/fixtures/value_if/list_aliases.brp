import:
    list as ListOps
    string: add
    io: print
fixed record Choice { selected: List[String], current: List[String], old: List[String] }
pure func choose(flag: Bool) -> Choice:
    var values: List[String] = ["old".add(" list")]
    old = values
    selected: List[String] = if flag:
        values = ["new".add(" list")]
        old
    else:
        values
    { selected = selected, current = values, old = old }
pure func first(values: List[String]) -> String:
    match ListOps.get(values, 0):
        Some(value): value
        None: "missing"
func show(flag: Bool) -> Void:
    value = choose(flag)
    print(first(value.selected))
    print(first(value.current))
    print(first(value.old))
func main() -> Int:
    show(True)
    show(False)
    0
