import:
    dict as D
    io: print
    int: Int methods
    string: String methods

-- Sequential Int keys 0..9,999 with 100,000 lookups of keys that are not there.
-- Int hashes to itself, so without the table's HASH_SPREAD multiply the keys fill
-- one run of slots and each absent key whose home slot is inside the run walks to
-- its end. The absent keys are i + 16,383 for each i in 0..9,999: 16,383 is the
-- slot count of a Dict with 10,000 keys, so they start inside that run.
--
-- This is a time budget, the harness's 10 s native timeout. Measured under ASan
-- at -O0 on the development machine, the run takes under 1 s with the spread and
-- 50 s with HASH_SPREAD = 1 (about 133,000 instructions per miss against 154),
-- so the budget sits 10 times above one and 5 times below the other.
private PRESENT: Int = 10000

private SLOT_COUNT: Int = 16383

private ROUNDS: Int = 10

func main() -> Int:
    var dict: D.Dict[Int, Int] = D.empty()
    for key in 0..PRESENT:
        dict = dict.set(key, key)
    var found = 0
    for round in 0..ROUNDS:
        for index in 0..PRESENT:
            if dict.contains(index + SLOT_COUNT):
                found = found + 1
    print(D.length(dict).to_string() + " " + found.to_string())
    0
