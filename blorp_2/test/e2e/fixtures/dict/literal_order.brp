import:
    io: print
    int: Int methods
    list: join, map

-- A literal evaluates left to right, each key before its value.

func traced(label: String, value: Int) -> Int:
    print(label)
    value

pure func text(value: Int) -> String:
    value.to_string()

func main() -> Int:
    dict = {traced("key 1", 1) => traced("value 1", 10), traced("key 2", 2) => traced("value 2", 20), traced("key 3", 1) => traced("value 3", 30)}
    print(dict.keys().map(text).join(",") + " " + dict.values().map(text).join(","))
    0
