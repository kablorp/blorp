import:
	io: print
	string: add

fixed union Side:
	Left(String, Int)
	Right(Int, String)
	Other
fixed union Envelope:
	Nothing
	Items(List[Side])

func source() -> Envelope:
	print("source")
	Items([Right(11, "é\0".add("R"))])

func choose(value: Envelope) -> String:
	match value:
		Items([Left(item, _) | Right(_, item)]):
			print("selected")
			item
		Items([_, ..._]):
			print("nonempty")
			"many"
		Items([]):
			print("empty")
			"none"
		Nothing:
			print("nothing")
			"absent"

func main() -> Int:
	original = source()
	original_copy = original
	result = choose(original)
	result_alias = result
	print(result)
	print(result_alias)
	print(choose(original_copy))
	print(choose(Items([])))
	print(choose(Items([Other])))
	print(choose(Items([Left("ignored", 1), Other])))
	print(choose(Nothing))
	0
