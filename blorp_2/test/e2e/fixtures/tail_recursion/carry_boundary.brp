fixed union Digit:
	D0
	D1
	D2
fixed union Carry:
	Decrement
	Keep
fixed union Step:
	Stop
	Once
pure func predecessor(digit: Digit) -> Digit:
	match digit:
		D0:
			D2
		D1:
			D0
		D2:
			D1
pure func borrow(digit: Digit, incoming: Carry) -> Carry:
	match digit:
		D0:
			incoming
		_:
			Keep
pure func adjust(digit: Digit, incoming: Carry) -> Digit:
	match incoming:
		Decrement:
			predecessor(digit)
		Keep:
			digit
pure func first_digit(digit: Digit, rest: Int) -> Int:
	match digit:
		D2:
			rest
		_:
			1
pure func second_digit(digit: Digit, rest: Int) -> Int:
	match digit:
		D2:
			rest
		_:
			2
pure func third_digit(digit: Digit) -> Int:
	match digit:
		D0:
			7
		_:
			3
@tail_recursive
pure func decrement_once(step: Step, a: Digit, b: Digit, c: Digit) -> Int:
	match step:
		Stop:
			first_digit(a, second_digit(b, third_digit(c)))
		Once:
			carry_b = borrow(a, Decrement)
			carry_c = borrow(b, carry_b)
			decrement_once(Stop, predecessor(a), adjust(b, carry_b), adjust(c, carry_c))
func main() -> Int:
	decrement_once(Once, D0, D0, D1)
