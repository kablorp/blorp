fixed union Step:
	Stop
	Once
fixed record Pair { first: Int, second: Int }
@tail_recursive
pure func walk(step: Step, pair: Pair) -> Int:
	match step:
		Stop:
			pair.first
		Once:
			walk(Stop, { first = pair.second, second = pair.first })
func main() -> Int:
	walk(Once, { first = 7, second = 9 })
