fixed union Step:
	Stop
	Once
pure func measure(value: Int) -> Int:
	text = value.to_string()
	text.length()
@tail_recursive
pure func walk(step: Step, value: Int) -> Int:
	measured = measure(value)
	match step:
		Stop:
			measured
		Once:
			walk(Stop, measured)
func main() -> Int:
	walk(Once, 42)
