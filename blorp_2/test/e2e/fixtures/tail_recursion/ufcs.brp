fixed union Step:
	StopLeft
	StopRight
	Once
pure func choose(step: Step) -> Step:
	match step:
		StopLeft: StopRight
		StopRight: StopLeft
		Once: StopRight
@tail_recursive pure func walk(step: Step, left: Int, right: Int) -> Int:
	match step:
		StopLeft: left
		StopRight: right
		Once: StopLeft.choose().walk(right, left)
func main() -> Int:
	Once.walk(7, 9)
