fixed union Digit:
	D0
	D1
	D2
	D3
	D4
	D5
	D6
	D7
	D8
	D9
	D10
	D11
	D12
	D13
	D14
	D15
fixed union Carry:
	Decrement
	Keep
pure func predecessor(digit: Digit) -> Digit:
	match digit:
		D0:
			D15
		D1:
			D0
		D2:
			D1
		D3:
			D2
		D4:
			D3
		D5:
			D4
		D6:
			D5
		D7:
			D6
		D8:
			D7
		D9:
			D8
		D10:
			D9
		D11:
			D10
		D12:
			D11
		D13:
			D12
		D14:
			D13
		D15:
			D14
pure func borrow(digit: Digit, incoming: Carry) -> Carry:
	match digit:
		D0:
			incoming
		_:
			Keep
pure func adjust(digit: Digit, incoming: Carry) -> Digit:
	match incoming:
		Decrement:
			predecessor(digit)
		Keep:
			digit
pure func nonzero(digit: Digit) -> Carry:
	match digit:
		D0:
			Keep
		_:
			Decrement
pure func either(left: Carry, right: Carry) -> Carry:
	match left:
		Decrement:
			Decrement
		Keep:
			right
@tail_recursive
pure func countdown(a: Digit, b: Digit, c: Digit, d: Digit) -> Int:
	active = either(nonzero(a), either(nonzero(b), either(nonzero(c), nonzero(d))))
	match active:
		Keep:
			7
		Decrement:
			carry_b = borrow(a, Decrement)
			carry_c = borrow(b, carry_b)
			carry_d = borrow(c, carry_c)
			countdown(predecessor(a), adjust(b, carry_b), adjust(c, carry_c), adjust(d, carry_d))
func main() -> Int:
	countdown(D15, D15, D15, D15)
