fixed record Point { x: Int, y: Int }
fixed record Cell[T] { value: T, count: Int }
opaque type Code = Int
fixed union Signal:
    Off
    Level(Int)
    Ratio(Float)
fixed union Event:
    Quiet
    Pulse(Signal)
    At(Point)
    Counted(Cell[Int])
    Coded(Code)
    Flag(Bool)
pure func signal_value(signal: Signal) -> Int:
    match signal:
        Off: 0
        Level(level): level
        Ratio(_): 1
pure func event_value(event: Event) -> Int:
    match event:
        Quiet: 0
        Pulse(signal): signal_value(signal)
        At(point): point.x.add(point.y)
        Counted(cell): cell.value.add(cell.count)
        Coded(code): from_opaque Code(code)
        Flag(set):
            if set:
                1
            else:
                0
func main() -> Int:
    quiet = event_value(Quiet)
    level = event_value(Pulse(Level(5)))
    ratio = event_value(Pulse(Ratio(2.5)))
    point = event_value(At({ x = 3, y = 4 }))
    counted = event_value(Counted({ value = 10, count = 2 }))
    coded = event_value(Coded(into_opaque Code(16)))
    flag = event_value(Flag(True))
    quiet.add(level).add(ratio).add(point).add(counted).add(coded).add(flag)
