import:
    int as IntOps
    io: print
    list: get_or

record Bundle { pair: (Int, String), values: List[String], run: pure (Int) -> Int }

pure func identity[T](value: T) -> T:
    value

VALUE: Bundle = { pair = (7, "seven"), values = ["left", "right"], run = identity }

func main() -> Int:
    first = VALUE
    second = VALUE
    (_, word) = first.pair
    callback = first.run
    print(word)
    print(second.values.get_or(1, "missing"))
    print(IntOps.to_string(callback(7)))
    0
