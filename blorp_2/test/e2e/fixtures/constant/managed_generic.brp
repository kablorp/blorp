import:
    float: to_string
    io: print
    string: add

private UNUSED: String = "absent"
private TEXT: String = "kept λ\0"
private NEGATIVE_ZERO: Float = -0.0

pure func materialize[T](marker: T) -> String:
    first = TEXT
    second = TEXT
    first.add(second)

func main():
    print(materialize(0))
    print(materialize(1.25))
    print(to_string(NEGATIVE_ZERO))
