pure func depth(node: Node) -> Int:
    match node.next:
        None: 1
        Some(next): add(1, depth(next))

func main() -> Int:
    first = VALUE
    second = VALUE
    print(to_string(depth(first)))
    print(to_string(depth(second)))
    print(first.value)
    0
