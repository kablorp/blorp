import:
    io: print
    list: get
    string: add


-- A constant is not a global: each read evaluates its literal again.
GREETING: String = "hello"

record Labelled { label: String }


-- Each call returns a closure capturing the String of the same literal site.
pure func make_reader() -> () -> String:
    text = "captured"
    func() -> String:
        text


pure func make_labelled() -> Labelled:
    { label = "field" }


pure func make_list() -> List[String]:
    ["stored"]


pure func first(values: List[String]) -> String:
    match values.get(0):
        Some(value): value
        None: "missing"


-- Every aggregate below holds a shared literal String at the same time as
-- another owner of it, and all of them are dropped before the exit check.
func main() -> Int:
    print(GREETING)
    print(GREETING.add("!"))
    first_reader = make_reader()
    second_reader = make_reader()
    print(first_reader())
    print(second_reader())
    left = make_labelled()
    right = make_labelled()
    print(left.label.add(right.label))
    stored = make_list()
    again = make_list()
    print(first(stored).add(first(again)))
    0
