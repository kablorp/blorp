fixed union Box[T]:
    Box(T)
pure func identity[T](value: T) -> T:
    value
pure func boxed[T](value: T) -> Box[T]:
    Box(value)
pure func unbox[T](value: Box[T]) -> T:
    match value:
        Box(item): item
pure func unit(value: Void) -> Void:
    var current = identity(value)
    current = unbox(boxed(void))
    current
func main() -> Int:
    unit(void)
    0
