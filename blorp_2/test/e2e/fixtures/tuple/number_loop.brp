import:
    int: Int methods

-- A pair of numbers keeps its fields inline, so returning one allocates nothing.
pure func step(index: Int) -> (Int, Int):
    (index, index.add(1))

func main() -> Int:
    var count = 0
    var total = 0
    while count.less_than(200):
        pair = step(count)
        total = total.add(pair[1].subtract(pair[0]))
        count = count.add(1)
    total
