import:
    io: print
    string: add

union Side:
    Left((String, Int))
    Right((Int, String))

pure func selected_text(value: Side) -> String:
    match value:
        Left((text, _)) | Right((_, text)): text

func subject() -> (String, Int, String):
    print("subject")
    ("first".add("!"), 2, "third".add("!"))

func main() -> Int:
    (first, _, third) = subject()
    print(first)
    print(third)
    print(selected_text(Left(("left".add("!"), 1))))
    print(selected_text(Right((2, "right".add("!")))))
    value: (Option[(String, Int)], List[String]) = (Some(("nested".add("!"), 3)), ["list".add("!")])
    match value:
        (Some((text, _)), [item]):
            print(text)
            print(item)
        _: print("wrong")
    match (first, third, "tail"):
        (a, b, c):
            print(a)
            print(b)
            print(c)
    0
