import:
    list: List methods_only
    int: Int methods_only
    string: String methods_only
    io: print

-- Each accumulator enters an inner loop once per row. Its header takes the
-- dying outer obligation, so the first inner update sees a unique buffer.
pure func rows(count: Int) -> List[Int]:
    var values: List[Int] = []
    for row in 0..count:
        for column in 0..4:
            values = values.append(row.multiply(4).add(column))
    values

-- A snapshot stored before inner-loop entry keeps its own occurrence: the
-- inner update copies rather than changing what the snapshot sees.
pure func snapshots() -> List[List[Int]]:
    var values: List[Int] = []
    var saved: List[List[Int]] = []
    for row in 0..3:
        saved = saved.append(values)
        for column in 0..2:
            values = values.append(row.multiply(2).add(column))
    saved.append(values)

pure func nested_words() -> List[List[String]]:
    var outer: List[List[String]] = []
    for row in 0..3:
        var inner: List[String] = []
        word = row.to_string()
        for column in 0..2:
            inner = inner.append(word.append_int(column))
        outer = outer.append(inner)
    outer

pure func digits(count: Int) -> String:
    var text = ""
    for row in 0..count:
        for column in 0..3:
            text = text.append_int(column)
    text

pure func number_at(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1

pure func row_length(values: List[List[Int]], index: Int) -> Int:
    match values.get(index):
        Some(row): row.length()
        None: -1

pure func word_at(values: List[List[String]], row: Int, column: Int) -> String:
    match values.get(row):
        Some(words):
            match words.get(column):
                Some(word): word
                None: "missing-word"
        None: "missing-row"

func main() -> Void:
    numbers = rows(5)
    print(numbers.length().to_string())
    print(number_at(numbers, 0).to_string())
    print(number_at(numbers, 19).to_string())

    saved = snapshots()
    print(saved.length().to_string())
    print(row_length(saved, 0).to_string())
    print(row_length(saved, 1).to_string())
    print(row_length(saved, 2).to_string())
    print(row_length(saved, 3).to_string())

    words = nested_words()
    print(words.length().to_string())
    print(word_at(words, 0, 0))
    print(word_at(words, 2, 1))

    print(digits(3))
