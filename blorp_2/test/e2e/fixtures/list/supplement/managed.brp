import:
    list: drop, reverse, find, all, map, join
    string: add
    int as IntOps
    io: print
fixed record Entry { text: String, children: List[String] }
pure func entries() -> List[Entry]:
    text = 42.to_string().add("é\0")
    repeated: Entry = { text = text, children = [text, 3.to_string()] }
    [repeated, repeated, { text = 7.to_string(), children = [7.to_string()] }]
pure func render(entry: Entry) -> String:
    entry.text.add(":").add(entry.children.join("/"))
pure func has_children(entry: Entry) -> Bool:
    IntOps.greater_than(entry.children.length(), 1)
pure func escaped_find() -> Option[Entry]:
    entries().find(has_children)
pure func escaped_drop() -> List[Entry]:
    entries().drop(1)
pure func escaped_reverse() -> List[Entry]:
    entries().reverse()
func show(values: List[Entry]) -> Void:
    print(values.map(render).join("|"))
func found(value: Option[Entry]) -> Void:
    match value:
        Some(entry): print(render(entry))
        None: print("none")
pure func nested() -> List[List[String]]:
    text = 9.to_string().add("é\0")
    [[text, 2.to_string()], [4.to_string()], []]
pure func render_nested(values: List[String]) -> String:
    "[".add(values.join("/")).add("]")
func main() -> Void:
    original = entries()
    original_alias = original
    selected = original.find(has_children)
    suffix = original.drop(1)
    reversed = original.reverse()
    show(suffix)
    show(reversed)
    found(selected)
    show(original_alias)
    found(escaped_find())
    show(escaped_drop())
    show(escaped_reverse())
    lists = nested()
    lists_alias = lists
    print(lists.drop(1).reverse().map(render_nested).join("|"))
    print(lists_alias.reverse().map(render_nested).join("|"))
    print(nested().reverse().map(render_nested).join("|"))
