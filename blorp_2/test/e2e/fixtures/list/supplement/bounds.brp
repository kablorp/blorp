import:
    list: get_or, is_empty, last, take, drop, remove, reverse, map, join
    string: add
    int: INT_MIN, INT_MAX, to_string
    io: print
pure func render(values: List[Int]) -> String:
    "[".add(values.map(to_string).join(",")).add("]")
pure func removed(result: Option[List[Int]]) -> String:
    match result:
        Some(values): render(values)
        None: "none"
pure func ending(values: List[Int]) -> String:
    match values.last():
        Some(value): value.to_string()
        None: "none"
pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"
func row(values: List[Int], index: Int) -> Void:
    print(render(values).add("|").add(index.to_string()).add("|")
        .add(values.get_or(index, 9).to_string()).add("|")
        .add(render(values.take(index))).add("|")
        .add(render(values.drop(index))).add("|").add(removed(values.remove(index))))
func sweep(values: List[Int]) -> Void:
    row(values, INT_MIN)
    row(values, -1)
    row(values, 0)
    row(values, 1)
    row(values, 2)
    row(values, 3)
    row(values, 4)
    row(values, INT_MAX)
    print(truth(values.is_empty()).add("|").add(ending(values)).add("|").add(render(values.reverse())))
func main() -> Void:
    empty: List[Int] = []
    sweep(empty)
    sweep([7])
    sweep([1, 2, 3])
    print(render([1, 2, 3, 4, 5].reverse()))
