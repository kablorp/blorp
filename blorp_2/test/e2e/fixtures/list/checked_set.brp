import:
    list: repeat, get, set_index
    int: Int methods_only
    string: String methods_only
    io: print
pure func int_at(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1
func show_ints(result: Option[List[Int]]) -> Void:
    match result:
        Some(values):
            print(int_at(values, 0).to_string())
            print(int_at(values, 1).to_string())
        None: print("none")
pure func void_presence(result: Option[List[Void]]) -> String:
    match result:
        Some(values):
            match values.get(0):
                Some(_): "void-some"
                None: "void-missing"
        None: "void-none"
pure func text_at(values: List[String], index: Int) -> String:
    match values.get(index):
        Some(value): value
        None: "missing"
pure func selected(result: Option[List[String]], index: Int) -> String:
    match result:
        Some(values): text_at(values, index)
        None: "none-text"
pure func escaped_result() -> Option[List[String]]:
    original = repeat(42.to_string().add("é\0"), 2)
    original.set_index(1, 7.to_string())
func replacement() -> Int:
    print("replacement")
    5
func main() -> Void:
    values = [1, 2]
    show_ints(values.set_index(0, 7))
    show_ints(values.set_index(1, 9))
    show_ints(values.set_index(-1, replacement()))
    show_ints(values.set_index(2, 5))
    show_ints(repeat(0, 0).set_index(0, 5))
    print(void_presence(repeat(void, 1).set_index(0, void)))
    original = repeat(42.to_string(), 2)
    replacement_text = 7.to_string()
    updated = original.set_index(1, replacement_text)
    print(text_at(original, 1))
    print(replacement_text)
    print(selected(updated, 0))
    print(selected(updated, 1))
    print(selected(escaped_result(), 0))
    print(selected(escaped_result(), 1))
