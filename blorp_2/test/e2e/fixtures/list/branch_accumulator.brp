import:
    list: List methods_only
    int: Int methods_only
    string: String methods_only
    io: print

-- Each update sits in a join arm. The join takes the dying accumulator, so
-- the update sees a unique buffer and the other arm retires it.
pure func alternating(count: Int) -> List[Int]:
    var values: List[Int] = []
    for index in 0..count:
        if index.remainder(2).equals(0):
            values = values.append(index)
        else:
            values = values.append(index.multiply(10))
    values

-- A snapshot stored before the join keeps its own occurrence: the update in
-- the arm copies rather than changing what the snapshot sees.
pure func snapshots() -> List[List[Int]]:
    var values: List[Int] = []
    var saved: List[List[Int]] = []
    for index in 0..4:
        saved = saved.append(values)
        if index.remainder(2).equals(0):
            values = values.append(index)
    saved.append(values)

pure func labelled_rows(count: Int) -> List[List[String]]:
    var rows: List[List[String]] = []
    for row in 0..count:
        match row.remainder(2).equals(0):
            True:
                rows = rows.append(["even", row.to_string()])
            False:
                rows = rows.append(["odd"])
    rows

pure func digits(count: Int) -> String:
    var text = ""
    for index in 0..count:
        if index.remainder(3).equals(0):
            text = text.append_int(index)
        else:
            text = text.append_int(0)
    text

-- The accumulator is matched on itself: the Some arm drops the old Option on
-- entry, so the update consumes the payload it acquired.
pure func optional(count: Int) -> Option[List[Int]]:
    var acc: Option[List[Int]] = Some([])
    for index in 0..count:
        match acc:
            Some(values):
                acc = Some(values.append(index))
            None:
                acc = None
    acc

-- The `break` arm retires the accumulator at its edge after acquiring it.
pure func capped(limit: Int) -> List[Int]:
    var values: List[Int] = []
    for index in 0..100:
        if index.less_than(limit):
            values = values.append(index)
        else:
            break
    values

pure func number_at(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1

pure func row_length(values: List[List[Int]], index: Int) -> Int:
    match values.get(index):
        Some(row): row.length()
        None: -1

pure func word_at(values: List[List[String]], row: Int, column: Int) -> String:
    match values.get(row):
        Some(words):
            match words.get(column):
                Some(word): word
                None: "missing-word"
        None: "missing-row"

func main() -> Void:
    numbers = alternating(20)
    print(numbers.length().to_string())
    print(number_at(numbers, 0).to_string())
    print(number_at(numbers, 19).to_string())

    saved = snapshots()
    print(saved.length().to_string())
    print(row_length(saved, 0).to_string())
    print(row_length(saved, 1).to_string())
    print(row_length(saved, 3).to_string())
    print(row_length(saved, 4).to_string())

    rows = labelled_rows(5)
    print(rows.length().to_string())
    print(word_at(rows, 2, 1))
    print(word_at(rows, 3, 0))

    print(digits(7))

    match optional(6):
        Some(values): print(number_at(values, 5).to_string())
        None: print("none")

    print(capped(7).length().to_string())
