import:
    list: length, get
    io: print
fixed record Point { x: Int, y: Int }
pure func points() -> List[Point]:
    [{ x = 1, y = 2 }]
pure func y_at(values: List[Point], index: Int) -> Int:
    match values.get(index):
        Some(point): point.y
        None: -1
func main() -> Void:
    values = points()
    print(values.length().to_string())
    print(y_at(values, 0).to_string())
