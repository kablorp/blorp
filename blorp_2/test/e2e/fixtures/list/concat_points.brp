import:
    list: repeat, length, get, concat
    io: print
fixed record Point { x: Int, y: Int }
pure func make_point(x: Int, y: Int) -> Point:
    { x = x, y = y }
pure func x_at(values: List[Point], index: Int) -> Int:
    match values.get(index):
        Some(point): point.x
        None: -1
pure func y_at(values: List[Point], index: Int) -> Int:
    match values.get(index):
        Some(point): point.y
        None: -1
func show(values: List[Point]) -> Void:
    print(values.length().to_string())
    print(x_at(values, 0).to_string())
    print(y_at(values, 2).to_string())
func main() -> Void:
    empty = repeat(make_point(0, 0), 0)
    left = repeat(make_point(1, 2), 1)
    right = repeat(make_point(3, 4), 2)
    show(left.concat(right))
    show(right.concat(empty))
    show(empty.concat(left))
