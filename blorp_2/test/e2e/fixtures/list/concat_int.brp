import:
    list: repeat, length, get, concat
    io: print
pure func element(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1
func show(values: List[Int]) -> Void:
    print(values.length().to_string())
    print(element(values, 0).to_string())
    print(element(values, 4).to_string())
func main() -> Void:
    empty = repeat(0, 0)
    left = repeat(1, 2)
    right = repeat(2, 3)
    show(empty.concat(left))
    show(left.concat(empty))
    show(left.concat(right))
    show(empty.concat(empty))
