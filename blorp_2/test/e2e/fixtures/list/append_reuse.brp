import:
    list: List methods_only
    int: Int methods_only
    string: String methods_only
    io: print

fixed record Entry { text: String, children: List[String] }

-- A returned borrowed parameter acquires a separate counted root occurrence.
pure func saved_values[T](values: List[T]) -> List[T]:
    values

pure func numbers() -> List[Int]:
    var values: List[Int] = []
    while values.length().less_than(12):
        values = values.append(values.length())
    values

pure func number_at(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1

pure func entry_text(values: List[Entry], index: Int) -> String:
    match values.get(index):
        Some(value): value.text
        None: "missing"

pure func entry_child(values: List[Entry], index: Int) -> String:
    match values.get(index):
        Some(value):
            match value.children.get(1):
                Some(text): text
                None: "missing-child"
        None: "missing-entry"

pure func repeated_entries(entry: Entry) -> List[Entry]:
    var values: List[Entry] = []
    while values.length().less_than(12):
        values = values.append(entry)
    values

pure func nested_text(values: List[List[String]], index: Int) -> String:
    match values.get(index):
        Some(inner):
            match inner.get(0):
                Some(text): text
                None: "empty-inner"
        None: "empty-outer"

func main() -> Void:
    grown = numbers()
    print(grown.length().to_string())
    print(number_at(grown, 0).to_string())
    print(number_at(grown, 11).to_string())

    text = 42.to_string().add(" child")
    child: Entry = { text = text, children = [text, text] }
    repeated = repeated_entries(child)
    snapshot = saved_values(repeated)
    updated = repeated.append({ text = "new", children = ["new", "tail"] })
    print(snapshot.length().to_string())
    print(entry_text(snapshot, 11))
    print(entry_child(snapshot, 11))
    print(updated.length().to_string())
    print(entry_text(updated, 12))
    print(entry_child(updated, 12))

    inner = [7.to_string()]
    var outer: List[List[String]] = []
    while outer.length().less_than(12):
        outer = outer.append(inner)
    saved = saved_values(outer)
    outer = outer.append(["last"])
    print(saved.length().to_string())
    print(nested_text(saved, 11))
    print(outer.length().to_string())
    print(nested_text(outer, 12))

    unused = numbers().append(99)
    print("done")
