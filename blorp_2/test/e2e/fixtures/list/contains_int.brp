import:
    list: contains, contains_with, repeat
    int as IntOps
    string as StringOps
    io: print

fixed record Entry { text: String }

pure func same_text(left: String, right: String) -> Bool:
    StringOps.equals(left, right)

pure func same_entry(left: Entry, right: Entry) -> Bool:
    StringOps.equals(left.text, right.text)

pure func directional(left: Int, right: Int) -> Bool:
    match IntOps.equals(left, 1):
        True: IntOps.equals(right, 2)
        False: False

pure func entry(text: String) -> Entry:
    { text = text }

func report(value: Bool) -> Void:
    match value:
        True: print("true")
        False: print("false")

func needle() -> Int:
    print("needle")
    7

func main() -> Int:
    values = [-9223372036854775808, -1, 0, 9223372036854775807]
    original_values = values
    report(contains([], 0))
    report(values.contains(-9223372036854775808))
    report(values.contains(9223372036854775807))
    report(values.contains(1))
    report(original_values.contains(0))
    report([4294967296].contains(0))
    report(repeat(7, 64).contains(needle()))
    report(repeat(7, 64).contains(8))
    texts = repeat(42.to_string().add("é\0kept"), 2)
    texts_alias = texts
    report(contains_with(texts, "42é\0kept", same_text))
    report(contains_with(texts_alias, "42é\0changed", same_text))
    records = repeat(entry(7.to_string()), 2)
    saved = records
    report(contains_with(records, entry("7"), same_entry))
    report(contains_with(saved, entry("other"), same_entry))
    report(contains_with([1], 2, directional))
    report(contains_with([2], 1, directional))
    0
