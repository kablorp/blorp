import:
    list: any, contains, repeat
    int as IntOps
    io: print

record Entry { text: String }

pure func is_one(value: Int) -> Bool:
    IntOps.equals(value, 1)

pure func entry(text: String) -> Entry:
    { text = text }

func report(value: Bool) -> Void:
    match value:
        True: print("true")
        False: print("false")

func needle() -> Int:
    print("needle")
    7

func main() -> Int:
    values = [-9223372036854775808, -1, 0, 9223372036854775807]
    original_values = values
    report(contains([], 0))
    report(values.contains(-9223372036854775808))
    report(values.contains(9223372036854775807))
    report(values.contains(1))
    report(original_values.contains(0))
    report([4294967296].contains(0))
    report(repeat(7, 64).contains(needle()))
    report(repeat(7, 64).contains(8))
    texts = repeat(42.to_string().add("é\0kept"), 2)
    texts_alias = texts
    report(contains(texts, "42é\0kept"))
    report(contains(texts_alias, "42é\0changed"))
    records = repeat(entry(7.to_string()), 2)
    saved = records
    report(contains(records, entry("7")))
    report(contains(saved, entry("other")))
    report(any([1], is_one))
    report(any([2], is_one))
    0
