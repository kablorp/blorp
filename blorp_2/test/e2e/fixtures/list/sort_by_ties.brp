import:
    list: sort_by, append, length, get_or
    int: Int methods
    string: String methods
    io: print

-- 1,000 is not a power of two, so from width 8 on each of the bottom-up merge's
-- passes ends on a short or lone run. Seven keys give about 143 ties each, and
-- every tie must keep input order.
private COUNT: Int = 1000

-- 389 is coprime to 1,000, so the keys arrive scrambled.
pure func tie_key(position: Int) -> Int:
    ((position * 389) % COUNT) % 7

pure func positions() -> List[Int]:
    var values: List[Int] = []
    for position in 0..COUNT:
        values = values.append(position)
    values

-- Counts adjacent pairs whose keys descend, or whose equal keys left input order.
pure func disorders(sorted: List[Int]) -> Int:
    var count = 0
    for index in 1..sorted.length():
        before = sorted.get_or(index - 1, -1)
        after = sorted.get_or(index, -1)
        if tie_key(after) < tie_key(before):
            count = count + 1
        if tie_key(after) == tie_key(before):
            if after < before:
                count = count + 1
    count

func main() -> Int:
    sorted = positions().sort_by(tie_key)
    print(sorted.length().to_string() + " " + disorders(sorted).to_string())
    0
