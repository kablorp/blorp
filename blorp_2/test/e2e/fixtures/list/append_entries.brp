import:
    list: repeat, length, get, append
    io: print
fixed record Entry { number: Int, text: String }
pure func make_entry(number: Int) -> Entry:
    { number = number, text = number.to_string() }
pure func text_at(values: List[Entry], index: Int) -> String:
    match values.get(index):
        Some(entry): entry.text
        None: "missing"
func show(values: List[Entry]) -> Void:
    print(values.length().to_string())
    print(text_at(values, 0))
    print(text_at(values, 2))
func main() -> Void:
    kept = make_entry(42)
    pair = repeat(kept, 2)
    three = pair.append(kept)
    four = three.append(make_entry(7))
    show(pair)
    show(three)
    show(four)
