import:
    list: map, filter, reverse, sort_by, join, append, length, get_or
    int: Int methods
    string: String methods
    io: print

-- A strict allocation count that grows with n, not with n log n. map, filter,
-- reverse, sort_by and join allocate a constant number of times however long
-- the List; sort_by copies its input into its two merge buffers at most once
-- each. At 4,096 elements (12 merge levels) a sort that built a List per run
-- would allocate about 8,000 more than the pinned count.
private COUNT: Int = 4096

-- 1237 is odd, so these are the numbers 0..4095 in a scrambled order.
pure func scrambled() -> List[Int]:
    var values: List[Int] = []
    for index in 0..COUNT:
        values = values.append((index * 1237) % COUNT)
    values

pure func add_one(value: Int) -> Int:
    value + 1

pure func is_even(value: Int) -> Bool:
    value % 2 == 0

pure func same(value: Int) -> Int:
    value

pure func text(value: Int) -> String:
    value.to_string()

func main() -> Int:
    values = scrambled()
    mapped = values.map(add_one)
    evens = mapped.filter(is_even)
    sorted = values.sort_by(same)
    print(mapped.length().to_string() + " " + evens.length().to_string() + " " + sorted.length().to_string())
    print(sorted.get_or(0, -1).to_string() + " " + sorted.get_or(COUNT - 1, -1).to_string() + " " + values.reverse().get_or(0, -1).to_string())
    print(values.map(text).join(",").length().to_string())
    0
