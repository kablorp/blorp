import:
    list: repeat, get
    int: to_string
    io: print
fixed record Entry { number: Int, text: String }
pure func make_entry(text: String, number: Int) -> Entry:
    { number = number, text = text }
pure func selected_entry() -> Option[Entry]:
    values = repeat(make_entry(to_string(42), 7), 2)
    values.get(1)
pure func selected_text(value: Option[Entry]) -> String:
    match value:
        Some(entry): entry.text
        None: "missing"
pure func escaped_text() -> String:
    selected = selected_entry()
    selected_text(selected)
func main() -> Void:
    print(escaped_text())
