import:
    list: List methods
    int: Int methods
    string: String methods
    io: print

-- Returning a borrowed parameter acquires an independent root occurrence.
pure func snapshot[T](values: List[T]) -> List[T]:
    values

pure func text_at(values: List[String], index: Int) -> String:
    match values.get(index):
        Some(value): value
        None: "missing"

pure func nested_at(values: List[List[String]], index: Int) -> String:
    match values.get(index):
        Some(inner): text_at(inner, 0)
        None: "missing-outer"

pure func changed(values: List[String], replacement: String) -> List[String]:
    values.set(0, replacement)

func main() -> Void:
    child = 42.to_string().add(" child")
    replacement = 7.to_string().add(" replacement")
    var values = [child, child]
    saved = snapshot(values)
    values = values.set(0, replacement)
    print(text_at(saved, 0))
    print(text_at(saved, 1))
    print(text_at(values, 0))
    print(text_at(values, 1))
    values = values.set(1, child)
    values = values.set(-1, "unused-negative")
    values = values.set(2, "unused-outside")
    print(values.length().to_string())
    print(text_at(values, 0))
    print(text_at(values, 1))

    borrowed_result = changed(saved, replacement)
    print(text_at(saved, 0))
    print(text_at(borrowed_result, 0))

    inner = [child]
    var nested = [inner, inner]
    nested_saved = snapshot(nested)
    nested = nested.set(0, [replacement])
    nested = nested.concat([inner, inner])
    print(nested_saved.length().to_string())
    print(nested_at(nested_saved, 0))
    print(nested.length().to_string())
    print(nested_at(nested, 0))
    print(nested_at(nested, 3))

    var joined: List[String] = []
    joined = joined.concat([])
    joined = joined.concat([child, child])
    joined_saved = snapshot(joined)
    joined = joined.concat(joined_saved)
    joined = joined.concat([])
    print(joined_saved.length().to_string())
    print(joined.length().to_string())
    print(text_at(joined, 3))
    same_owner = saved.concat(saved)
    print(same_owner.length().to_string())
    print(text_at(same_owner, 3))

    unused_set = [child].set(0, replacement)
    unused_concat = [child].concat([replacement])
    print("done")
