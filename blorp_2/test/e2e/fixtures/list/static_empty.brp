import:
    list: List methods
    int: Int methods
    string: String methods
    io: print

-- Every call evaluates a fresh `[]` literal.
pure func no_texts() -> List[String]:
    []

pure func text_at(values: List[String], index: Int) -> String:
    match values.get(index):
        Some(value): value
        None: "missing"

func main() -> Void:
    -- A thousand empty literals are made and dropped without allocating.
    var count = 0
    while count.less_than(1000):
        count = count.add(no_texts().length().add(1))
    print(count.to_string())

    -- Borrowed updates copy the empty literal and leave it empty.
    empty = no_texts()
    appended = empty.append("first")
    replaced = empty.set(0, "ignored")
    joined = empty.concat(appended)
    print(text_at(appended, 0))
    print(replaced.length().to_string())
    print(text_at(joined, 0))
    print(empty.length().to_string())

    -- A consumed `[]` accumulator copies on its first append, then grows in place.
    var grown: List[String] = []
    while grown.length().less_than(5):
        grown = grown.append("x")
    print(grown.length().to_string())
    print(text_at(grown, 4))
    print(no_texts().length().to_string())
