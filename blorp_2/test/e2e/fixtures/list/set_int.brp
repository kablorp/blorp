import:
    list: repeat, length, get, set
    io: print
pure func element(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1
func show(values: List[Int]) -> Void:
    print(values.length().to_string())
    print(element(values, 0).to_string())
    print(element(values, 2).to_string())
func main() -> Void:
    values = repeat(1, 3)
    first = values.set(0, 7)
    last = values.set(2, 9)
    beyond = values.set(3, 5)
    negative = values.set(-1, 5)
    empty = repeat(0, 0).set(0, 5)
    show(values)
    show(first)
    show(last)
    show(beyond)
    show(negative)
    show(empty)
