import:
    list: remove
    int: INT_MIN, INT_MAX
    io: print
pure func at(values: List[Int], index: Int) -> Int:
    match values.get(index):
        Some(value): value
        None: -1
func show(result: Option[List[Int]]) -> Void:
    match result:
        None: print("none")
        Some(values):
            print(values.length().to_string())
            print(at(values, 0).to_string())
            print(at(values, 1).to_string())
            print(at(values, 2).to_string())
            print(at(values, 3).to_string())
            print(at(values, 4).to_string())
func main() -> Void:
    values = [0, 10, 20, 30, 40]
    show(remove(values, INT_MIN))
    show(values.remove(-1))
    show(values.remove(5))
    show(values.remove(INT_MAX))
    empty: List[Int] = []
    show(empty.remove(0))
    show(values.remove(0))
    show(values.remove(2))
    show(values.remove(4))
    show([7].remove(0))
    show(Some(values))
