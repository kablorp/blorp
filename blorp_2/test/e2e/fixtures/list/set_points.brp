import:
    list: repeat, length, get, set_or_keep
    io: print
fixed record Point { x: Int, y: Int }
pure func make_point(x: Int, y: Int) -> Point:
    { x = x, y = y }
pure func x_at(values: List[Point], index: Int) -> Int:
    match values.get(index):
        Some(point): point.x
        None: -1
pure func y_at(values: List[Point], index: Int) -> Int:
    match values.get(index):
        Some(point): point.y
        None: -1
func show(values: List[Point]) -> Void:
    print(values.length().to_string())
    print(x_at(values, 0).to_string())
    print(y_at(values, 1).to_string())
func main() -> Void:
    values = repeat(make_point(1, 1), 2)
    replaced = values.set_or_keep(0, make_point(3, 4))
    beyond = values.set_or_keep(5, make_point(9, 9))
    show(values)
    show(replaced)
    show(beyond)
