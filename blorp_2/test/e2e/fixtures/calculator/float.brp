import:
    list: get
    string: parse_float, equals
    float: add, subtract, multiply, divide, remainder, to_string
    io: print
union Operation:
    Addition
    Subtraction
    Multiplication
    Division
    Remainder
pure func decode_addition(matches: Bool, text: String) -> Result[Operation, String]:
    match matches:
        True: Ok(Addition)
        False: decode_subtraction(equals(text, "subtract"), text)
pure func decode_subtraction(matches: Bool, text: String) -> Result[Operation, String]:
    match matches:
        True: Ok(Subtraction)
        False: decode_multiplication(equals(text, "multiply"), text)
pure func decode_multiplication(matches: Bool, text: String) -> Result[Operation, String]:
    match matches:
        True: Ok(Multiplication)
        False: decode_division(equals(text, "divide"), text)
pure func decode_division(matches: Bool, text: String) -> Result[Operation, String]:
    match matches:
        True: Ok(Division)
        False: decode_remainder(equals(text, "remainder"))
pure func decode_remainder(matches: Bool) -> Result[Operation, String]:
    match matches:
        True: Ok(Remainder)
        False: Err("unknown operation")
pure func calculate(operation: Operation, first: Float, second: Float) -> Float:
    match operation:
        Addition: add(first, second)
        Subtraction: subtract(first, second)
        Multiplication: multiply(first, second)
        Division: divide(first, second)
        Remainder: remainder(first, second)
pure func operation_argument(args: List[String], argument: Option[String]) -> Result[Float, String]:
    match argument:
        Some(text): operation_result(args, decode_addition(equals(text, "add"), text))
        None: Err("missing input")
pure func operation_result(args: List[String], operation: Result[Operation, String]) -> Result[Float, String]:
    match operation:
        Ok(selected): first_argument(args, selected, get(args, 2))
        Err(message): Err(message)
pure func first_argument(args: List[String], operation: Operation, argument: Option[String]) -> Result[Float, String]:
    match argument:
        Some(text): first_number(args, operation, parse_float(text))
        None: Err("missing input")
pure func first_number(args: List[String], operation: Operation, number: Option[Float]) -> Result[Float, String]:
    match number:
        Some(first): second_argument(operation, first, get(args, 3))
        None: Err("invalid float")
pure func second_argument(operation: Operation, first: Float, argument: Option[String]) -> Result[Float, String]:
    match argument:
        Some(text): second_number(operation, first, parse_float(text))
        None: Err("missing input")
pure func second_number(operation: Operation, first: Float, number: Option[Float]) -> Result[Float, String]:
    match number:
        Some(second): Ok(calculate(operation, first, second))
        None: Err("invalid float")
pure func evaluate(args: List[String]) -> Result[Float, String]:
    operation_argument(args, get(args, 1))
func report(result: Result[Float, String]) -> Int:
    match result:
        Ok(value):
            print(to_string(value))
            0
        Err(message):
            print(message)
            1
func main(args: List[String]) -> Int:
    report(evaluate(args))
