import:
    option: Option(Some, None)
    bool: Bool(True, False)
    string: parse_int, equals
    int: add, subtract, multiply, divide, remainder, to_string
    io: print, read_line
fixed union Operation:
    Addition
    Subtraction
    Multiplication
    Division
    Remainder
func failure(message: String) -> Int:
    print(message)
    1
pure func decode_addition(matches: Bool, text: String) -> Option[Operation]:
    match matches:
        True: Some(Addition)
        False: decode_subtraction(equals(text, "subtract"), text)
pure func decode_subtraction(matches: Bool, text: String) -> Option[Operation]:
    match matches:
        True: Some(Subtraction)
        False: decode_multiplication(equals(text, "multiply"), text)
pure func decode_multiplication(matches: Bool, text: String) -> Option[Operation]:
    match matches:
        True: Some(Multiplication)
        False: decode_division(equals(text, "divide"), text)
pure func decode_division(matches: Bool, text: String) -> Option[Operation]:
    match matches:
        True: Some(Division)
        False: decode_remainder(equals(text, "remainder"))
pure func decode_remainder(matches: Bool) -> Option[Operation]:
    match matches:
        True: Some(Remainder)
        False: None
pure func calculate(operation: Operation, first: Int, second: Int) -> Int:
    match operation:
        Addition: add(first, second)
        Subtraction: subtract(first, second)
        Multiplication: multiply(first, second)
        Division: divide(first, second)
        Remainder: remainder(first, second)
func operation_line(line: Option[String]) -> Int:
    match line:
        Some(text): operation_value(decode_addition(equals(text, "add"), text))
        None: failure("missing input")
func operation_value(operation: Option[Operation]) -> Int:
    match operation:
        Some(selected): first_line(selected, read_line())
        None: failure("unknown operation")
func first_line(operation: Operation, line: Option[String]) -> Int:
    match line:
        Some(text): first_number(operation, parse_int(text))
        None: failure("missing input")
func first_number(operation: Operation, number: Option[Int]) -> Int:
    match number:
        Some(first): second_line(operation, first, read_line())
        None: failure("invalid integer")
func second_line(operation: Operation, first: Int, line: Option[String]) -> Int:
    match line:
        Some(text): second_number(operation, first, parse_int(text))
        None: failure("missing input")
func second_number(operation: Operation, first: Int, number: Option[Int]) -> Int:
    match number:
        Some(second):
            print(to_string(calculate(operation, first, second)))
            0
        None: failure("invalid integer")
func main() -> Int:
    operation_line(read_line())
