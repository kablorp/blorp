import:
    float: add, subtract, multiply, divide, remainder, to_string
    io: print
pure func infinity() -> Float:
    multiply(1e308, 1e308)
func main() -> Int:
    print(to_string(multiply(6.5, 2.0)))
    print(to_string(add(0.1, 0.2)))
    print(to_string(multiply(-0.0, 2.0)))
    print(to_string(infinity()))
    print(to_string(multiply(-1e308, 1e308)))
    print(to_string(subtract(infinity(), infinity())))
    print(to_string(divide(1.0, -0.0)))
    print(to_string(remainder(-1.0, 0.0)))
    print(to_string(5e-324))
    print(to_string(1.7976931348623157e308))
    print(to_string(2.2250738585072014e-308))
    0
