import:
    option: Option(Some, None)
    string: parse_int
    int: add, to_string
    io: print, read_line
func failure(message: String) -> Int:
    print(message)
    1
func first_line(line: Option[String]) -> Int:
    match line:
        Some(text): first_number(parse_int(text))
        None: failure("missing input")
func first_number(number: Option[Int]) -> Int:
    match number:
        Some(first): second_line(first, read_line())
        None: failure("invalid integer")
func second_line(first: Int, line: Option[String]) -> Int:
    match line:
        Some(text): second_number(first, parse_int(text))
        None: failure("missing input")
func second_number(first: Int, number: Option[Int]) -> Int:
    match number:
        Some(second):
            print(to_string(add(first, second)))
            0
        None: failure("invalid integer")
func main() -> Int:
    first_line(read_line())
