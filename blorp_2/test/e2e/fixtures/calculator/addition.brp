import:
    list: get
    string: parse_int
    int: add, to_string
    io: print
pure func first_argument(args: List[String], argument: Option[String]) -> Result[Int, String]:
    match argument:
        Some(text): first_number(args, parse_int(text))
        None: Err("missing input")
pure func first_number(args: List[String], number: Option[Int]) -> Result[Int, String]:
    match number:
        Some(first): second_argument(first, get(args, 2))
        None: Err("invalid integer")
pure func second_argument(first: Int, argument: Option[String]) -> Result[Int, String]:
    match argument:
        Some(text): second_number(first, parse_int(text))
        None: Err("missing input")
pure func second_number(first: Int, number: Option[Int]) -> Result[Int, String]:
    match number:
        Some(second): Ok(add(first, second))
        None: Err("invalid integer")
pure func evaluate(args: List[String]) -> Result[Int, String]:
    first_argument(args, get(args, 1))
func report(result: Result[Int, String]) -> Int:
    match result:
        Ok(value):
            print(to_string(value))
            0
        Err(message):
            print(message)
            1
func main(args: List[String]) -> Int:
    report(evaluate(args))
