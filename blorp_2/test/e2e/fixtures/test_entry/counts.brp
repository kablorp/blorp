import:
    test: TestSuite, TestCounts, run_suite_result

private pure func yes() -> Bool:
    True

private pure func no() -> Bool:
    False

tests: TestSuite = {
    description = "counts",
    tests = [("yes", yes), ("no", no), ("again", yes)]
}

func main() -> Int:
    counts: TestCounts = run_suite_result(tests)
    counts.passed.multiply(10).add(counts.failed)
