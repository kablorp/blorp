import:
    int as IntOps
    string as StringOps
    io: print
record SourceFile {
    path: String,
    contents: String
}
pure func location(file: SourceFile, end: Int) -> String:
    var line: Int = 1
    var column: Int = 1
    var cursor: Int = 0
    while IntOps.less_than(cursor, end):
        line_feed = match StringOps.byte_at(file.contents, cursor):
            Some(byte): IntOps.equals(byte, 10)
            None: False
        if line_feed:
            line = IntOps.add(line, 1)
            column = 1
        else:
            column = IntOps.add(column, 1)
        cursor = IntOps.add(cursor, 1)
    file.path.add(":").add("".append_int(line)).add(":").add("".append_int(column))
func main() -> Int:
    file: SourceFile = { path = "src", contents = "a\n\né\0z" }
    print(location(file, 0))
    print(location(file, 1))
    print(location(file, 2))
    print(location(file, 3))
    print(location(file, 5))
    print(location(file, 6))
    print(location(file, 7))
    0
