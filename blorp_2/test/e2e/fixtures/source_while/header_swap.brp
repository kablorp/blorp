import:
    string: add, append_int
    io: print
func initial(value: Int) -> Int:
    print("i".add("".append_int(value)))
    value
func main() -> Int:
    var first: Int = initial(1)
    var second: Int = initial(2)
    var again: Bool = True
    while again:
        previous = first
        first = second
        second = previous
        again = False
    print("".append_int(first))
    print("".append_int(second))
    0
