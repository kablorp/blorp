-- A bound match inside an arm, and a bare match as an arm's value.
fixed union Size:
	Small
	Large(Int)


pure func size(count: Int) -> Size:
	match count.equals(1):
		True: Small
		False: Large(count)


pure func score(outer: Size, inner: Size) -> Int:
	total = match outer:
		Small:
			bonus = match inner:
				Small: 1
				Large(n): n
			bonus.add(10)
		Large(m):
			match inner:
				Small: m.multiply(100)
				Large(n): m.multiply(n)
	total.add(1)


func main(arguments: List[String]) -> Int:
	count = arguments.length()
	score(size(count), size(count.subtract(1)))
