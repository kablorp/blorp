-- A bound match whose arms yield Int; the function continues after it.
union Shape:
	Circle(Int)
	Square(Int)


pure func width(shape: Shape) -> Int:
	w = match shape:
		Circle(radius): radius.multiply(2)
		Square(side): side
	w.add(1)


pure func pick(selected: Bool) -> Shape:
	match selected:
		True: Circle(3)
		False: Square(5)


func main(arguments: List[String]) -> Int:
	width(pick(arguments.length().equals(1)))
