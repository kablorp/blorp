import:
    io: print

fixed record TextPair { left: String, right: String }

pure func choose(flag: Bool) -> TextPair:
    var held = 1.to_string()
    selected = match flag:
        True:
            held = 7.to_string()
            held
        False: held
    { left = selected, right = held }

func main() -> Int:
    changed = choose(True)
    print(changed.left)
    print(changed.right)
    unchanged = choose(False)
    print(unchanged.left)
    print(unchanged.right)
    0
