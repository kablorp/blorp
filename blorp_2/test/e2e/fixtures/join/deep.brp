-- Sixteen nested bound matches; the generated C nests 33 braces deep.
pure func deep(selected: Bool) -> Int:
	value_1 = match selected:
		True:
			value_2 = match selected:
				True:
					value_3 = match selected:
						True:
							value_4 = match selected:
								True:
									value_5 = match selected:
										True:
											value_6 = match selected:
												True:
													value_7 = match selected:
														True:
															value_8 = match selected:
																True:
																	value_9 = match selected:
																		True:
																			value_10 = match selected:
																				True:
																					value_11 = match selected:
																						True:
																							value_12 = match selected:
																								True:
																									value_13 = match selected:
																										True:
																											value_14 = match selected:
																												True:
																													value_15 = match selected:
																														True:
																															value_16 = match selected:
																																True: 0
																																False: 116
																															value_16.add(1)
																														False: 115
																													value_15.add(1)
																												False: 114
																											value_14.add(1)
																										False: 113
																									value_13.add(1)
																								False: 112
																							value_12.add(1)
																						False: 111
																					value_11.add(1)
																				False: 110
																			value_10.add(1)
																		False: 109
																	value_9.add(1)
																False: 108
															value_8.add(1)
														False: 107
													value_7.add(1)
												False: 106
											value_6.add(1)
										False: 105
									value_5.add(1)
								False: 104
							value_4.add(1)
						False: 103
					value_3.add(1)
				False: 102
			value_2.add(1)
		False: 101
	value_1


func main(arguments: List[String]) -> Int:
	deep(arguments.length().equals(1))
