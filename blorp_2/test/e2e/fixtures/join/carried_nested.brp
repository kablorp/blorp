import:
    io: print

pure func choose(outer: Bool, inner: Bool) -> String:
    var total = 1.to_string()
    match outer:
        True: match inner:
            True: match inner:
                True: match inner:
                    True: match inner:
                        True: match inner:
                            True: match inner:
                                True: match inner:
                                    True: match inner:
                                        True: match inner:
                                            True: match inner:
                                                True: match inner:
                                                    True: match inner:
                                                        True: match inner:
                                                            True: match inner:
                                                                True: match inner:
                                                                    True: total = 7.to_string()
                                                                    False: void
                                                                False: void
                                                            False: void
                                                        False: void
                                                    False: void
                                                False: void
                                            False: void
                                        False: void
                                    False: void
                                False: void
                            False: void
                        False: void
                    False: void
                False: void
            False: void
        False: void
    total

func main() -> Int:
    print(choose(True, True))
    print(choose(True, False))
    print(choose(False, True))
    print(choose(False, False))
    0
