import:
    io: print

fixed record Numbers { left: Int, right: Int }

pure func choose(flag: Bool) -> Numbers:
    var left = 11
    var right = 22
    match flag:
        True:
            right = 202
            left = 101
        False: void
    { left = left, right = right }

func main() -> Int:
    changed = choose(True)
    print(changed.left.to_string())
    print(changed.right.to_string())
    unchanged = choose(False)
    print(unchanged.left.to_string())
    print(unchanged.right.to_string())
    0
