import:
    io: print

record TextPair { old: String, current: String }

pure func choose_text(flag: Bool) -> TextPair:
    var text = 1.to_string()
    old = text
    match flag:
        True: text = 777.to_string()
        False: void
    { old = old, current = text }

func main() -> Int:
    changed = choose_text(True)
    print(changed.old)
    print(changed.current)
    unchanged = choose_text(False)
    print(unchanged.old)
    print(unchanged.current)
    0
