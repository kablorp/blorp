import:
    io: print

record Box { text: String }
record TextPair { old: String, current: String }

pure func make_box() -> Box:
    { text = 777.to_string() }

pure func choose(flag: Bool) -> TextPair:
    var held = 1.to_string()
    previous = held
    match flag:
        True:
            parent = make_box()
            held = parent.text
        False: void
    { old = previous, current = held }

func main() -> Int:
    changed = choose(True)
    print(changed.old)
    print(changed.current)
    unchanged = choose(False)
    print(unchanged.old)
    print(unchanged.current)
    0
