private record Point { x: Int, y: Int }
private pure func secret() -> Int:
    7
pure func visible() -> Int:
    secret()
record Holder { value: Int }
pure func make_holder(value: Int) -> Holder:
    { value = value }
pure func shown(holder: Holder) -> Int:
    holder.value
private pure func secret_value(holder: Holder) -> Int:
    holder.value
