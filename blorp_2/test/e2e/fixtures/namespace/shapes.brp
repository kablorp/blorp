import:
    int: multiply, subtract
fixed union Shape:
    Circle(Int)
    Square(Int)
fixed union Flag:
    On
    Off
fixed record Span { start: Int, end: Int }
pure func make_span(start: Int, end: Int) -> Span:
    { start = start, end = end }
pure func area(shape: Shape) -> Int:
    match shape:
        Circle(radius): multiply(multiply(radius, radius), 3)
        Square(side): multiply(side, side)
pure func flag_value(flag: Flag) -> Int:
    match flag:
        On: 1
        Off: 0
private pure func secret() -> Int:
    7
pure func revealed() -> Int:
    secret()
