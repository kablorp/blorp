import:
    io: print
    string as StringOps

pure func make_reader(text: String) -> () -> String:
    func() -> String:
        text

pure func forward_reader(callback: () -> String) -> () -> String:
    func() -> String:
        callback()

func main() -> Int:
    returned: () -> String = forward_reader(make_reader(StringOps.add("kept", "!")))
    copied: () -> String = returned
    print(returned())
    print(copied())
    0
