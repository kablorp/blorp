import:
    io: print
    int: to_string

pure func identity(value: Int) -> Int:
    value

func receiver() -> pure (Int) -> Int:
    print("receiver")
    identity

func argument() -> Int:
    print("argument")
    17

pure func use(callback: pure (Int) -> Int, value: Int) -> Int:
    callback(value)

func main() -> Int:
    result = receiver().use(argument())
    print(to_string(result))
    0
