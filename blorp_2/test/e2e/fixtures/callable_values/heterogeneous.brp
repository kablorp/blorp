import:
    io: print
    int as IntOps
    string as StringOps

record TestCase {
    name: String,
    run: () -> Bool
}

pure func cases(text: String, number: Int) -> List[TestCase]:
    [
        {
            name = "text",
            run = func() -> Bool:
                print(text)
                StringOps.equals(text, "left")
        },
        {
            name = "number",
            run = func() -> Bool:
                print("number")
                IntOps.equals(number, 7)
        },
    ]

func main() -> Int:
    values = cases("left", 7)
    saved_cases = values
    var failed: Int = 0
    for test in saved_cases:
        callback: () -> Bool = test.run
        match callback():
            True: print(test.name)
            False: failed = IntOps.add(failed, 1)
    failed
