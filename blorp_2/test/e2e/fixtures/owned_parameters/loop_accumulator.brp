import:
    list: List methods
    int: Int methods
    string: String methods
    io: print

-- `items` and `extra` own: loop headers take their obligations at entry and
-- append to them in place. The loop's break leaves `spare` live, so the exit
-- must still retire it.
pure func fill(items: List[Int], extra: List[Int], count: Int) -> List[Int]:
    var values = items
    var spare = extra
    var remaining = count
    while 0.less_than(remaining):
        values = values.append(remaining)
        spare = spare.append(remaining)
        remaining = remaining.subtract(1)
    values

pure func describe(values: List[Int]) -> String:
    match values.get(0):
        Some(first): "${values.length().to_string()} from ${first.to_string()}"
        None: "empty"

func main() -> Int:
    kept: List[Int] = [7]
    -- `kept` is used afterwards, so the call receives an acquisition and the
    -- callee copies instead of growing the caller's value.
    grown = fill(kept, [], 3)
    print(describe(grown))
    print(describe(kept))
    -- A dying accumulator moves in and grows in place.
    print(describe(fill([0], [1], 4)))
    0
