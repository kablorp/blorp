import:
	int as IntOps

pure func apply[T, U](f: pure (T) -> U, value: T) -> U:
	f(value)

func main() -> Int:
	first = apply(pure func(number): IntOps.add(number, 1), 7)
	second = apply(pure func(number: Int) -> Int:
		IntOps.add(number, 1)
	, 33)
	looped = apply(pure func(number: Int) -> Int:
		var again: Bool = True
		var current = number
		while again:
			current = IntOps.add(current, 1)
			again = False
		current
	, 2)
	match IntOps.equals(looped, 3):
		True: IntOps.add(first, second)
		False: 1
