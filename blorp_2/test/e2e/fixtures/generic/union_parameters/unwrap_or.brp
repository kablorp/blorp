fixed union TestResult[T, E]:
    Ok(T)
    Err(E)
pure func success() -> TestResult[Int, Int]:
    Ok(7)
pure func failure() -> TestResult[Int, Int]:
    Err(9)
pure func unwrap_or[T, E](value: TestResult[T, E], fallback: T) -> T:
    match value:
        Ok(item): item
        Err(_): fallback
func main() -> Int:
    saved = success().unwrap_or(3)
    failure().unwrap_or(saved)
