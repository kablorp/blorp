fixed union Result[T, E]:
    Ok(T)
    Err(E)
pure func success() -> Result[Int, Int]:
    Ok(7)
pure func failure() -> Result[Int, Int]:
    Err(9)
pure func unwrap_or[T, E](value: Result[T, E], fallback: T) -> T:
    match value:
        Ok(item): item
        Err(_): fallback
func main() -> Int:
    saved = success().unwrap_or(3)
    failure().unwrap_or(saved)
