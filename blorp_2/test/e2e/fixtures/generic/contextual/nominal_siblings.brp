import:
    io: print
    int as IntOps

fixed record Pair { first: Int, second: Int }

fixed union Choice[T]:
    Empty
    Full(T)

pure func pick[T](left: T, right: T) -> T:
    left

pure func identity[T](value: T) -> T:
    value

func mark(label: String, value: Int) -> Int:
    print(label)
    value

func make_pair(label: String) -> Pair:
    { first = mark(label, 7), second = 9 }

func make_choice(label: String) -> Choice[Int]:
    Full(mark(label, 7))

func show(value: Choice[Int]) -> Void:
    match value:
        Empty: print("empty")
        Full(payload): print(payload.to_string())

func main() -> Void:
    print(pick(make_pair("left"), { first = mark("right", 7), second = 9 }).first.to_string())
    print(pick({ first = mark("reverse-left", 7), second = 9 }, make_pair("reverse-right")).first.to_string())
    print(pick(identity({ first = mark("nested-left", 7), second = 9 }), make_pair("nested-right")).first.to_string())
    show(pick(make_choice("choice-left"), Full(mark("choice-right", 7))))
    show(pick(Full(mark("choice-reverse-left", 7)), make_choice("choice-reverse-right")))
