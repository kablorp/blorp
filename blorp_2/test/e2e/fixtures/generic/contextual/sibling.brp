union Choice[T]:
    Empty
    Value(T)

pure func empty[T]() -> Choice[T]:
    Empty

pure func integer() -> Choice[Int]:
    Value(9)

pure func first[T](left: T, right: T) -> T:
    left

func main() -> Int:
    selected = first(empty(), integer())
    match selected:
        Empty: 7
        Value(value): value
