fixed union Box[T]:
	Box(T)
pure func box[T](value: T) -> Box[T]:
	Box(value)
pure func unbox[T](value: Box[T]) -> T:
	match value:
		Box(payload):
			payload
pure func identity[T](value: T) -> T:
	value
pure func forward[Item](value: Item) -> Item:
	identity(value)
func main() -> Int:
	original = box(7).forward()
	other = box(42)
	unbox(original.identity())
