import:
    list: any, map, filter, get, length, repeat
    int as IntOps
    string as StringOps
    io: print
fixed record Entry { text: String }
pure func item(values: List[String], index: Int) -> String:
    match get(values, index):
        Some(value): value
        None: "missing"
pure func one(value: Int) -> Bool:
    IntOps.equals(value, 1)
pure func yes(value: Void) -> Bool:
    True
pure func no(value: Void) -> Bool:
    False
pure func unit(value: Int) -> Void:
    void
pure func text(value: Int) -> String:
    IntOps.to_string(value)
pure func has_bytes(value: String) -> Bool:
    match IntOps.equals(StringOps.length(value), 0):
        True: False
        False: True
pure func keep(value: Int) -> Bool:
    match IntOps.equals(value, 2):
        True: False
        False: True
pure func copy_text(value: String) -> String:
    StringOps.add(value, "!")
pure func label(value: Entry) -> String:
    value.text
pure func entry(value: String) -> Entry:
    { text = value }
pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"
pure func forward[T, U](values: List[T], callback: pure (T) -> U) -> List[U]:
    map(values, callback)
func needle() -> List[Int]:
    print("input")
    [1, 2, 3]
func main() -> Int:
    print(truth(any(repeat(0, 0), one)))
    print(truth([1, 0].any(one)))
    print(truth(any([0, 1], one)))
    print(truth(any([0, 0], one)))
    mapped = forward(needle(), text)
    print(item(mapped, 0))
    print(item(mapped, 1))
    print(item(mapped, 2))
    selected = [3, 2, 1, 2].filter(keep)
    print(IntOps.to_string(length(selected)))
    print(truth(any(selected, one)))
    print(item(map(selected, text), 0))
    print(item(map(selected, text), 1))
    print(IntOps.to_string(length(map(repeat(0, 0), text))))
    print(IntOps.to_string(length(filter([2, 2], one))))
    print(IntOps.to_string(length(map([1, 2], unit))))
    print(IntOps.to_string(length(filter([void, void], yes))))
    print(IntOps.to_string(length(filter([void], no))))
    print(truth(any([void], yes)))
    values = [IntOps.to_string(42).add("é\0"), ""]
    original_values = values
    copies = map(values, copy_text)
    print(item(copies, 0))
    print(item(copies, 1))
    print(item(filter(values, has_bytes), 0))
    print(item(original_values, 0))
    records = [entry(IntOps.to_string(7))]
    saved = records
    print(item(map(records, label), 0))
    print(item(map(saved, label), 0))
    print(item(map([entry(IntOps.to_string(8))], label), 0))
    0
