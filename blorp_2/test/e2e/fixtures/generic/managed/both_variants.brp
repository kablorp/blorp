import:
	int: Int
	string: String
fixed union Choice[T]:
	Left(T)
	Right(T)
pure func left[T](value: T) -> Choice[T]:
	Left(value)
pure func right[T](value: T) -> Choice[T]:
	Right(value)
pure func extract[T](value: Choice[T]) -> T:
	match value:
		Left(payload): payload
		Right(payload): payload
func main() -> Int:
	unused = extract(left(42.to_string())).length()
	extract(right(7.to_string())).length()
