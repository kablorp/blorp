import:
    list: sort_by, get, length
    int as IntOps
    string as StringOps
    io: print
fixed record Entry { major: Int, minor: Int, ordinal: Int, label: String }
pure func major_key(value: Entry) -> Int:
    value.major
pure func minor_key(value: Entry) -> Int:
    value.minor
pure func ordinal_key(value: Entry) -> Int:
    value.ordinal
pure func equal_key(value: Entry) -> Int:
    0
pure func integer_key(value: Int) -> Int:
    value
pure func unit_key(value: Void) -> Int:
    0
pure func label_at(values: List[Entry], index: Int) -> String:
    match get(values, index):
        Some(value): value.label
        None: "missing"
pure func text_at(values: List[String], index: Int) -> String:
    match get(values, index):
        Some(value): value
        None: "missing"
pure func temporary() -> List[Entry]:
    values: List[Entry] = [
        { major = 2, minor = 0, ordinal = 0, label = "later" },
        { major = 0, minor = 0, ordinal = 0, label = "é\0" },
        { major = 1, minor = 0, ordinal = 0, label = "middle" }
    ]
    sort_by(values, major_key)
func main() -> Int:
    empty: List[Int] = []
    print(length(sort_by(empty, integer_key)).to_string())
    singleton: List[String] = ["only"]
    print(text_at(sort_by(singleton, StringOps.length), 0))
    print(text_at(singleton, 0))
    values: List[Entry] = [
        { major = 1, minor = 1, ordinal = 2, label = "A" },
        { major = 0, minor = 1, ordinal = 1, label = "B" },
        { major = 1, minor = 0, ordinal = 0, label = "C" }
    ]
    original_values = values
    stable = sort_by(values, equal_key)
    print(label_at(stable, 0))
    print(label_at(stable, 1))
    print(label_at(stable, 2))
    chained = values.sort_by(ordinal_key).sort_by(minor_key).sort_by(major_key)
    print(label_at(chained, 0))
    print(label_at(chained, 1))
    print(label_at(chained, 2))
    print(label_at(original_values, 0))
    extremes: List[Entry] = [
        { major = IntOps.INT_MIN, minor = 0, ordinal = 0, label = "min1" },
        { major = IntOps.INT_MAX, minor = 0, ordinal = 0, label = "max" },
        { major = IntOps.INT_MIN, minor = 0, ordinal = 0, label = "min2" }
    ]
    ordered = sort_by(extremes, major_key)
    print(label_at(ordered, 0))
    print(label_at(ordered, 1))
    print(label_at(ordered, 2))
    strings = sort_by(["zz", "a", "x"], StringOps.length)
    print(text_at(strings, 0))
    print(text_at(strings, 1))
    print(text_at(strings, 2))
    print(length(sort_by([void, void], unit_key)).to_string())
    escaped = temporary()
    print(label_at(escaped, 0))
    print(label_at(escaped, 1))
    print(label_at(escaped, 2))
    0
