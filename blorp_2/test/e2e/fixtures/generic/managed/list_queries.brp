import:
    list: get_or, is_empty, last, repeat
    int as IntOps
    string: add
    io: print
pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"
pure func final_text(values: List[String]) -> String:
    match last(values):
        Some(value): value
        None: "none"
pure func final_int(values: List[Int]) -> Int:
    match last(values):
        Some(value): value
        None: -1
pure func unit_presence(values: List[Void]) -> String:
    match last(values):
        Some(_): "unit-some"
        None: "unit-none"
func make_default() -> String:
    print("eager")
    "fallback".add("!")
pure func escaped() -> String:
    get_or([IntOps.to_string(42).add("é\0")], 0, "unused")
func main() -> Int:
    print(IntOps.to_string(get_or([1, 2], 1, 9)))
    print(IntOps.to_string(final_int([1, 2])))
    print(IntOps.to_string(final_int(repeat(0, 0))))
    values = [IntOps.to_string(42).add("é\0")]
    original_values = values
    fallback = IntOps.to_string(7).add("!")
    print(values.get_or(0, make_default()))
    print(get_or(values, -1, make_default()))
    print(get_or(values, 1, fallback))
    print(get_or(values, 0, fallback))
    print(final_text(values))
    print(final_text(repeat("unused", 0)))
    print(truth(is_empty(repeat(0, 0))))
    print(truth(is_empty([1])))
    print(truth(values.is_empty()))
    get_or([void], 0, void)
    get_or(repeat(void, 0), -1, void)
    print(unit_presence([void]))
    print(unit_presence(repeat(void, 0)))
    print(escaped())
    print(final_text(original_values))
    print(fallback)
    0
