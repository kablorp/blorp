import:
    io: print
    list: get
    option: is_some, is_none, get_or, to_result
    result: is_ok
pure func payload(value: Result[String, String]) -> String:
    match value:
        Ok(text): text
        Err(error): error
pure func truth(value: Bool) -> String:
    match value:
        True: "true"
        False: "false"
func printed(value: String) -> String:
    print(value)
    value
pure func present_value() -> Option[String]:
    Some("é\0")
pure func missing_unit() -> Option[Void]:
    None
func main() -> Int:
    missing = get(["unused"], 1)
    fallback = "fallback"
    present = present_value()
    print(present.get_or(printed("eager")))
    print(truth(present.is_some()))
    print(get_or(missing, fallback))
    print(fallback)
    print(get_or(Some(7), 0).to_string())
    get_or(Some(void), void)
    unit_missing = missing_unit()
    get_or(unit_missing, void)
    ok = Some("ok").to_result(printed("eager-error"))
    error = missing.to_result("error")
    print(truth(Some("kept").is_some()))
    print(truth(missing.is_some()))
    print(truth(Some("kept").is_none()))
    print(truth(missing.is_none()))
    print(truth(ok.is_ok()))
    print(truth(is_ok(error)))
    print(payload(ok))
    print(payload(error))
    0
