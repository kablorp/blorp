fixed union Box[T]:
	Box(T)
pure func box[T](value: T) -> Box[T]:
	Box(value)
pure func unbox[T](value: Box[T]) -> T:
	match value:
		Box(payload): payload
pure func identity[T](value: T) -> T:
	value
func main() -> Int:
	var current = box(42.to_string())
	saved = identity(current)
	current = box(7.to_string())
	unbox(saved).length()
