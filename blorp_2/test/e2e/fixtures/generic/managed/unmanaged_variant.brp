import:
	int: Int
	string: String
fixed union Choice[T]:
	Text(T)
	Number(Int)
pure func text(value: String) -> Choice[String]:
	Text(value)
pure func number(value: Int) -> Choice[String]:
	Number(value)
pure func measure(value: Choice[String]) -> Int:
	match value:
		Text(payload): payload.length()
		Number(payload): payload
func main() -> Int:
	unused = measure(text(42.to_string()))
	measure(number(7))
