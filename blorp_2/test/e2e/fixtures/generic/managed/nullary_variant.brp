fixed union Choice[T]:
	Empty
	Text(T)
pure func empty() -> Choice[String]:
	Empty
pure func text(value: String) -> Choice[String]:
	Text(value)
pure func measure(value: Choice[String]) -> Int:
	match value:
		Empty: 7
		Text(payload): payload.length()
func main() -> Int:
	unused = measure(text(42.to_string()))
	measure(empty())
