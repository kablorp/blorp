union Box[T]:
	Box(T)
pure func box[T](value: T) -> Box[T]:
	Box(value)
pure func unbox[T](value: Box[T]) -> T:
	match value:
		Box(payload): payload
union Choice[A,B]:
	Left(A)
	Right(B)
pure func left() -> Choice[Box[Int],Int]:
	Left(box(7))
pure func right() -> Choice[Box[Int],Int]:
	Right(9)
pure func read(value: Choice[Box[Int],Int]) -> Int:
	match value:
		Left(item): unbox(item)
		Right(item): item
func main() -> Int:
	read(right())
