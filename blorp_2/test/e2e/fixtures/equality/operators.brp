import:
    float as FloatOps

fixed record Point { first: Int, second: Int }
fixed record Managed { items: List[String] }
fixed union Reply:
    Empty
    Value(Point)
    Items(List[Int])
fixed record Box[Element] { value: Element }

pure func same[Value: Equatable](left: Value, right: Value) -> Bool:
    left == right

pure func different[Value: Equatable](left: Value, right: Value) -> Bool:
    left != right

func main() -> Int:
    truth: Bool = True
    falsehood: Bool = False
    point: Point = { first = 7, second = 9 }
    equal: Point = { first = 7, second = 9 }
    changed: Point = { first = 7, second = 8 }
    text = "kept\0bytes"
    text_alias = text
    managed: Managed = { items = [text, "tail"] }
    same_managed: Managed = { items = [text_alias, "tail"] }
    other_managed: Managed = { items = [text_alias, "other"] }
    empty: Reply = Empty
    value: Reply = Value(point)
    equal_value: Reply = Value(equal)
    changed_value: Reply = Value(changed)
    items: Reply = Items([1, 2])
    same_items: Reply = Items([1, 2])
    other_items: Reply = Items([1, 9])
    empty_list: List[Int] = []
    empty_alias = empty_list
    boxed: Box[List[Int]] = { value = [1, 2] }
    same_box: Box[List[Int]] = { value = [1, 2] }
    other_box: Box[List[Int]] = { value = [2, 1] }
    infinity = FloatOps.multiply(1.0e308, 1.0e308)
    nan = FloatOps.subtract(infinity, infinity)
    results = [
        7 == 7, 7 != 9, 7 == 9, 7 != 7,
        truth == truth, truth != falsehood,
        1.25 == 1.25, 1.25 != 2.5,
        nan == nan, nan != nan,
        text == text_alias, text != "kept\0other",
        point == equal, point != changed,
        managed == same_managed, managed != other_managed,
        empty == empty, empty != value, value == equal_value,
        value != changed_value, items == same_items, items != other_items,
        [1, 2] == [1, 2], [1] != [1, 2], empty_list == empty_alias,
        [[1, 2], [3]] == [[1, 2], [3]], [[1, 2]] != [[1, 9]],
        boxed == same_box, boxed != other_box,
        same(point, equal), different(managed, other_managed),
        (7 == 7) == truth, (7 != 7) != truth,
    ]
    match results:
        [True, True, False, False, True, True, True, True, False, True,
         True, True, True, True, True, True, True, True, True, True,
         True, True, True, True, True, True, True, True, True, True,
         True, True, True]: 23
        _: 0
