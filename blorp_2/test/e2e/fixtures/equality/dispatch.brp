fixed record Marker { value: Int }

implements Equatable for Marker:
    pure func equals(left: Self, right: Self) -> Bool:
        False
    pure func not_equals(left: Self, right: Self) -> Bool:
        False

opaque type Ticket = Int

implements Equatable for Ticket:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque Ticket(left) == from_opaque Ticket(right)

func main() -> Int:
    marker: Marker = { value = 7 }
    marker_alias = marker
    ticket = into_opaque Ticket(7)
    same_ticket = into_opaque Ticket(7)
    other_ticket = into_opaque Ticket(9)
    results = [
        marker == marker_alias, marker != marker_alias,
        ticket == same_ticket, ticket != other_ticket,
    ]
    match results:
        [False, False, True, True]: 23
        _: 0
