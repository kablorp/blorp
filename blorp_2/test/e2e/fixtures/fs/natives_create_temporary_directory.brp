import:
    io: print

-- A program that calls one native and nothing else from fs must still build
-- as valid C under -Werror, so this declares the builtin directly. A missing
-- parent is NotFound, and nothing is created.
func temporary_native(parent: String, prefix: String) -> Result[String, Int]:
    builtin("fs.create_temporary_directory")

func main() -> Int:
    match temporary_native("/blorp-fs-no-such-path", "scratch-"):
        Ok(_):
            print("created")
            1
        Err(code):
            print(code.to_string())
            0
