import:
    io: print

func produced(label: String, value: Int) -> Int:
    print(label)
    value

-- Each operator evaluates its left operand, then its right, once each.
func main() -> Int:
    less = produced("left", 1) < produced("right", 2)
    greater = produced("left", 1) > produced("right", 2)
    at_most = produced("left", 1) <= produced("right", 2)
    at_least = produced("left", 1) >= produced("right", 2)
    match [less, greater, at_most, at_least]:
        [True, False, True, False]: 23
        _: 0
