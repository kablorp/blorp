import:
    io: print

-- One digit per comparison, so each output row is the four operators in order:
-- <, >, <=, >=.
pure func digit(value: Bool) -> String:
    if value:
        "1"
    else:
        "0"

pure func ordered[Value: Orderable](left: Value, right: Value) -> String:
    "${digit(left < right)}${digit(left > right)}${digit(left <= right)}${digit(left >= right)}"

-- Only less_than follows the values; the three other members answer False. The
-- trait defaults, or `>=` written as a negated `<`, would print 0101 and 1010.
fixed record Marker { value: Int }

implements Orderable for Marker:
    pure func less_than(left: Self, right: Self) -> Bool:
        left.value < right.value
    pure func greater_than(left: Self, right: Self) -> Bool:
        False
    pure func less_than_or_equal(left: Self, right: Self) -> Bool:
        False
    pure func greater_than_or_equal(left: Self, right: Self) -> Bool:
        False

-- An opaque type has no derived equality, so Rank is ordered but not Equatable.
opaque type Rank = Int

implements Orderable for Rank:
    pure func less_than(left: Self, right: Self) -> Bool:
        from_opaque Rank(left) < from_opaque Rank(right)

-- Rows: Int below, equal and above, at concrete types; Float below, -0.0
-- against 0.0, and NaN on the left, the right and both sides; the same Int and
-- Float rows through the generic bound; Marker's overrides; Rank's defaults.
func main() -> Int:
    print("${digit(2 < 3)}${digit(2 > 3)}${digit(2 <= 3)}${digit(2 >= 3)}")
    print("${digit(3 < 3)}${digit(3 > 3)}${digit(3 <= 3)}${digit(3 >= 3)}")
    print("${digit(-4 < -5)}${digit(-4 > -5)}${digit(-4 <= -5)}${digit(-4 >= -5)}")
    print("${digit(1.5 < 2.5)}${digit(1.5 > 2.5)}${digit(1.5 <= 2.5)}${digit(1.5 >= 2.5)}")
    print("${digit(-0.0 < 0.0)}${digit(-0.0 > 0.0)}${digit(-0.0 <= 0.0)}${digit(-0.0 >= 0.0)}")
    infinity: Float = 1.0e308.multiply(10.0)
    nan: Float = infinity.subtract(infinity)
    print("${digit(nan < 1.0)}${digit(nan > 1.0)}${digit(nan <= 1.0)}${digit(nan >= 1.0)}")
    print("${digit(1.0 < nan)}${digit(1.0 > nan)}${digit(1.0 <= nan)}${digit(1.0 >= nan)}")
    print("${digit(nan < nan)}${digit(nan > nan)}${digit(nan <= nan)}${digit(nan >= nan)}")
    print(ordered(2, 3))
    print(ordered(3, 3))
    print(ordered(-4, -5))
    print(ordered(-0.0, 0.0))
    print(ordered(nan, 1.0))
    low: Marker = { value = 1 }
    high: Marker = { value = 2 }
    print(ordered(low, high))
    print(ordered(high, low))
    print(ordered(into_opaque Rank(1), into_opaque Rank(2)))
    print(ordered(into_opaque Rank(2), into_opaque Rank(2)))
    0
