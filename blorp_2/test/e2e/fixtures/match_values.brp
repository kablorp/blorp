fixed union Value:
	Empty
	Number(Int)
fixed union Flag:
	Off
	On
pure func unwrap(value: Value) -> Int:
	match value:
		Number(number): number
		Empty(): 0
pure func number(value: Int) -> Value:
	Number(value)
pure func empty() -> Value:
	Empty
pure func retain(value: Value) -> Value:
	match value:
		captured: captured
pure func ignore(value: Value) -> Int:
	match value:
		_: -7
pure func minimum() -> Int:
	unwrap(Number(-9223372036854775808))
pure func maximum() -> Int:
	9223372036854775807.number().unwrap()
pure func choose() -> Value:
	Number(42)
pure func read_chosen() -> Int:
	match choose():
		Empty: empty_arm()
		Number(captured): selected(captured)
pure func empty_arm() -> Int:
	-999
pure func selected(value: Int) -> Int:
	value
pure func flag() -> Flag:
	On
pure func retain_flag() -> Flag:
	match flag():
		captured: captured
pure func shadow(value: Int) -> Int:
	match choose():
		Empty: value
		Number(value): value
pure func sibling(value: Value) -> Int:
	match value:
		Number(Empty): Empty
		Empty: 3
pure func payload_source() -> Int:
	42
pure func construct_once() -> Value:
	Number(payload_source())
func main() -> Int:
	unwrap(Number(42))
