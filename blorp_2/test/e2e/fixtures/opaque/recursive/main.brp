import:
    io: print
    int: add
    list: get
fixed record Node { value: Int, children: List[Node] }
union Chain:
    End
    Next(Chain)
opaque type Tree = Node
opaque type Trail = Chain

pure func leaf(value: Int) -> Node:
    { value = value, children = [] }

pure func branch() -> Node:
    { value = 3, children = [leaf(7), leaf(9)] }

pure func first(value: Node) -> Node:
    match get(value.children, 0):
        Some(child): child
        None: leaf(0)

pure func tail(value: Chain) -> Chain:
    match value:
        End: End
        Next(child): child

pure func depth(value: Chain) -> Int:
    match value:
        End: 0
        Next(child): add(1, depth(child))

func main() -> Void:
    var current = into_opaque Tree(branch())
    saved = first(from_opaque Tree(current))
    current = into_opaque Tree(leaf(2))
    replacement = from_opaque Tree(current)
    var chain = into_opaque Trail(Next(Next(End)))
    retained = tail(from_opaque Trail(chain))
    chain = into_opaque Trail(End)
    replaced = from_opaque Trail(chain)
    print(saved.value.to_string())
    print(replacement.value.to_string())
    print(depth(retained).to_string())
    print(depth(replaced).to_string())
