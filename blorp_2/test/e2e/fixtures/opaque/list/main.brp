import:
    io: print
    list: get, repeat
opaque type Id = Int
opaque type Text = String
opaque type Ids = List[Id]
opaque type Texts = List[Text]

pure func id_at(values: Ids, index: Int) -> Int:
    items = from_opaque Ids(values)
    match get(items, index):
        Some(value): from_opaque Id(value)
        None: 0

pure func text_at(values: Texts, index: Int) -> Text:
    items = from_opaque Texts(values)
    match get(items, index):
        Some(value): value
        None: into_opaque Text("missing")

func main() -> Void:
    ids = into_opaque Ids([into_opaque Id(7), into_opaque Id(9)])
    print(id_at(ids, 0).to_string())
    print(id_at(ids, 1).to_string())
    text = into_opaque Text(42.to_string())
    var texts = into_opaque Texts(repeat(text, 2))
    first = text_at(texts, 0)
    second = text_at(texts, 1)
    texts = into_opaque Texts([])
    print(from_opaque Text(first))
    print(from_opaque Text(second))
