fixed record Rows[V] { values: List[V] }
opaque type Box[V] = Rows[V]
opaque type Nested = Box[Box[Int]]
pure func wrap[V](value: V) -> Box[V]:
    into_opaque Box({ values = [value] })
pure func first[V](box: Box[V], fallback: V) -> V:
    match from_opaque Box(box).values:
        [value, ..._]: value
        []: fallback
pure func twice[V](value: V) -> Box[Box[V]]:
    wrap(wrap(value))
pure func nested(value: Int) -> Nested:
    into_opaque Nested(twice(value))
func main() -> Int:
    ints = twice(7)
    texts = twice("seven")
    inner = first(from_opaque Nested(nested(3)), wrap(0))
    first(first(ints, wrap(0)), 0).add(first(first(texts, wrap("")), "").length()).add(first(inner, 0))
