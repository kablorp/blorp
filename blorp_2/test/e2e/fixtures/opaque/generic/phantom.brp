fixed record User { name: String }
fixed record Order { total: Int }
opaque type Id[T] = Int
pure func user_id(number: Int) -> Id[User]:
    into_opaque Id(number)
pure func order_id(number: Int) -> Id[Order]:
    into_opaque Id(number)
pure func raw[T](id: Id[T]) -> Int:
    from_opaque Id(id)
pure func user_number(id: Id[User]) -> Int:
    raw(id)
func main() -> Int:
    user_number(user_id(3)).add(raw(order_id(4)))
