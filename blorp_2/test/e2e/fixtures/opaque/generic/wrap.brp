import:
    int: Int methods
    list: List methods

fixed record Rows[V] { entries: List[V], slots: List[Int] }

opaque type Box[V] = Rows[V]

pure func make[V](value: V) -> Box[V]:
    into_opaque Box({ entries = [value], slots = [0] })

pure func count[V](box: Box[V]) -> Int:
    rows: Rows[V] = from_opaque Box(box)
    rows.entries.length()

func main() -> Int:
    box: Box[String] = make("three")
    count(box).add(count(box))
