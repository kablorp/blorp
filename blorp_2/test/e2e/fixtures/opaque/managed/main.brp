import:
    io: print
    ./value: make_text, text_bytes, read_text, secret_text, make_label, read_label, make_item, item_text, make_generic, generic_text, make_choice, choice_text

func main() -> Void:
    text = make_text(42)
    label = make_label(text)
    var current = make_item(42)
    saved = item_text(current)
    current = make_item(9)
    generic = generic_text(make_generic(7))
    choice = choice_text(make_choice(11))
    print(read_text(text))
    print(secret_text(7))
    print(saved)
    print(item_text(current))
    print(generic)
    print(choice)
    print(read_label(label))
    bytes = text_bytes("é\0")
    print(read_text(bytes))
    print(read_text(bytes))
