private record Entry { text: String }
private record Box[T] { value: T }
private union Payload:
    Empty
    TextValue(String)
opaque type Text = String
private opaque type Secret = String
opaque type Label = Text
opaque type Item = Entry
opaque type GenericItem = Box[String]
opaque type Choice = Payload

pure func make_text(value: Int) -> Text:
    into_opaque Text(value.to_string())

pure func read_text(value: Text) -> String:
    from_opaque Text(value)

pure func secret_text(value: Int) -> String:
    secret = into_opaque Secret(value.to_string())
    from_opaque Secret(secret)

pure func make_label(value: Text) -> Label:
    into_opaque Label(value)

pure func read_label(value: Label) -> String:
    from_opaque Text(from_opaque Label(value))

pure func make_item(value: Int) -> Item:
    into_opaque Item({ text = value.to_string() })

pure func item_text(value: Item) -> String:
    entry = from_opaque Item(value)
    entry.text

pure func make_generic(value: Int) -> GenericItem:
    into_opaque GenericItem({ value = value.to_string() })

pure func generic_text(value: GenericItem) -> String:
    box = from_opaque GenericItem(value)
    box.value

pure func make_choice(value: Int) -> Choice:
    into_opaque Choice(TextValue(value.to_string()))

pure func choice_text(value: Choice) -> String:
    payload = from_opaque Choice(value)
    match payload:
        Empty: "empty"
        TextValue(text): text

pure func text_bytes(value: String) -> Text:
    into_opaque Text(value)
