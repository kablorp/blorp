import:
    io: print
    float: Float methods_only
opaque type Number = Float
opaque type Unit = Void

pure func unit() -> Unit:
    into_opaque Unit(void)

func mark() -> Void:
    print("unit")

func main() -> Void:
    empty = unit()
    from_opaque Unit(empty)
    number = into_opaque Number(1.25)
    plain = from_opaque Number(number)
    print(plain.to_string())
    from_opaque Unit(into_opaque Unit(mark()))
