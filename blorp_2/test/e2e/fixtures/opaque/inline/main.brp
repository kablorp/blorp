import:
    io: print
    float: Float methods
fixed record Pair { left: Int, right: Int }
fixed record Box[T] { value: T }
fixed union Choice:
    Empty
    Number(Int)
opaque type Plain = Pair
opaque type Applied = Box[Float]
opaque type Flag = Choice

pure func read(value: Flag) -> Int:
    choice = from_opaque Flag(value)
    match choice:
        Empty: 3
        Number(number): number

func main() -> Void:
    wrapped = into_opaque Plain({ left = 7, right = 9 })
    pair = from_opaque Plain(wrapped)
    generic = into_opaque Applied({ value = 1.25 })
    box = from_opaque Applied(generic)
    empty = read(into_opaque Flag(Empty))
    full = read(into_opaque Flag(Number(11)))
    print(pair.left.to_string())
    print(pair.right.to_string())
    print(box.value.to_string())
    print(empty.to_string())
    print(full.to_string())
