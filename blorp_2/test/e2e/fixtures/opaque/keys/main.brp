import:
    io: print
    int: Int methods_only
opaque type A = Int
opaque type B = Int
fixed record Box[T] { value: T }
pure func box[T](value: T) -> Box[T]:
    { value = value }
pure func identity[T](value: T) -> T:
    value
pure func first(value: A) -> Int:
    from_opaque A(value)
pure func second(value: B) -> Int:
    from_opaque B(value).add(1)
pure func apply[T](value: T, callback: pure (T) -> Int) -> Int:
    callback(value)
func main() -> Void:
    left = into_opaque A(7)
    right = into_opaque B(9)
    print(apply(left, first).to_string())
    print(apply(right, second).to_string())
    first_box = identity(box(left))
    second_box = identity(box(right))
    raw_box = identity(box(11))
    print(first(first_box.value).to_string())
    print(second(second_box.value).to_string())
    print(raw_box.value.to_string())
