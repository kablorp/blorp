import:
    io: print

-- An Ordered bound provides Equatable: `==`, `!=` and the `equals` method. The
-- default at_most calls that supertrait method on Self.
trait Ordered: Equatable:
    pure func before(left: Self, right: Self) -> Bool
    pure func at_most(left: Self, right: Self) -> Bool:
        match before(left, right):
            True: True
            False: equals(left, right)

pure func digit(value: Bool) -> String:
    if value:
        "1"
    else:
        "0"

-- One digit each for ==, equals, != and at_most, all through the bound.
pure func compare[Value: Ordered](left: Value, right: Value) -> String:
    "${digit(left == right)}${digit(left.equals(right))}${digit(left != right)}${digit(left.at_most(right))}"

implements Ordered for Int:
    pure func before(left: Self, right: Self) -> Bool:
        left < right

-- Version's equality is automatic.
record Version { major: Int, minor: Int }

implements Ordered for Version:
    pure func before(left: Self, right: Self) -> Bool:
        if left.major == right.major:
            left.minor < right.minor
        else:
            left.major < right.major

-- Tagged's written equality compares only the tag. For equal tags and
-- different details it prints 1101, where the derived body would print 0010.
record Tagged { tag: Int, detail: Int }

implements Equatable for Tagged:
    pure func equals(left: Self, right: Self) -> Bool:
        left.tag == right.tag

implements Ordered for Tagged:
    pure func before(left: Self, right: Self) -> Bool:
        left.tag < right.tag

-- Rows: Int equal, below and above; Version equal, below and above; Tagged.
func main() -> Int:
    print(compare(3, 3))
    print(compare(3, 4))
    print(compare(5, 4))
    old: Version = { major = 1, minor = 2 }
    new: Version = { major = 1, minor = 3 }
    print(compare(old, old))
    print(compare(old, new))
    print(compare(new, old))
    first: Tagged = { tag = 7, detail = 1 }
    second: Tagged = { tag = 7, detail = 9 }
    print(compare(first, second))
    0
