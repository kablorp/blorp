import:
    io: print

trait Addable:
    pure func plus(left: Self, right: Self) -> Self

trait Multipliable:
    pure func times(left: Self, right: Self) -> Self

-- A bundle has no methods of its own, and its implementations no body.
trait Ring: Addable + Multipliable

implements Addable for Int:
    pure func plus(left: Self, right: Self) -> Self:
        left.add(right)

implements Multipliable for Int:
    pure func times(left: Self, right: Self) -> Self:
        left.multiply(right)

implements Ring for Int

-- Pair's operations work on each component.
fixed record Pair { first: Int, second: Int }

implements Addable for Pair:
    pure func plus(left: Self, right: Self) -> Self:
        { first = left.first.add(right.first), second = left.second.add(right.second) }

implements Multipliable for Pair:
    pure func times(left: Self, right: Self) -> Self:
        { first = left.first.multiply(right.first), second = left.second.multiply(right.second) }

implements Ring for Pair

-- value * value + value, with a method from each supertrait.
pure func square_plus[Value: Ring](value: Value) -> Value:
    plus(times(value, value), value)

func main() -> Int:
    print(square_plus(7).to_string())
    start: Pair = { first = 2, second = -4 }
    result = square_plus(start)
    print("${result.first.to_string()},${result.second.to_string()}")
    0
