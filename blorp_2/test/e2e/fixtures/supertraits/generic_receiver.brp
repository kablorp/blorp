import:
    io: print

trait Ordered: Equatable:
    pure func before(left: Self, right: Self) -> Bool

implements Ordered for Int:
    pure func before(left: Self, right: Self) -> Bool:
        left < right

-- Box's automatic equality needs Element: Equatable, which the receiver's
-- Element: Ordered entails.
fixed record Box[Element] { value: Element }

implements Ordered for Box[Element: Ordered]:
    pure func before(left: Self, right: Self) -> Bool:
        before(left.value, right.value)

pure func digit(value: Bool) -> String:
    if value:
        "1"
    else:
        "0"

-- One digit each for == and before, through the bound.
pure func compare[Value: Ordered](left: Value, right: Value) -> String:
    "${digit(left == right)}${digit(left.before(right))}"

-- Rows: equal and ordered Box[Box[Int]] values through the bound, then `==`
-- on the same values at the concrete type.
func main() -> Int:
    one: Box[Box[Int]] = { value = { value = 1 } }
    two: Box[Box[Int]] = { value = { value = 2 } }
    print(compare(one, one))
    print(compare(one, two))
    print("${digit(one == one)}${digit(one == two)}")
    0
