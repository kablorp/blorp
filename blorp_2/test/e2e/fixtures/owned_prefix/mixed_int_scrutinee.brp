union Either[A, B]:
    Left(A)
    Right(B)
fixed record Envelope { payload: Either[Int, String] }
pure func choose(arguments: List[String]) -> Either[Int, String]:
    match arguments.get(1):
        Some(text): Right(text)
        None: Left(42)
pure func wrap(value: Either[Int, String]) -> Envelope:
    { payload = value }
func main(arguments: List[String]) -> Int:
    parent = wrap(choose(arguments))
    projected = parent.payload
    match projected:
        Left(number): number
        Right(text): text.length()
