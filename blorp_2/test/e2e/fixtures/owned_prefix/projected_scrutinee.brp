import:
    io: print
fixed record Envelope { payload: Option[String] }
pure func wrap(value: Option[String]) -> Envelope:
    { payload = value }
func main(arguments: List[String]) -> Int:
    parent = wrap(arguments.get(1))
    projected = parent.payload
    match projected:
        Some(text):
            print(text)
            text.length()
        None:
            print("missing")
            0
