fixed record Holder { text: String }
pure func make(value: Int) -> Holder:
    { text = value.to_string() }
pure func selected_root(selected: Bool) -> Holder:
    owned = make(42)
    match selected:
        True: owned
        False: make(7)
func main(arguments: List[String]) -> Int:
    selected_root(arguments.length().equals(1)).text.length()
