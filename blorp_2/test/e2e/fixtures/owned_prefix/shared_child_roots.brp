fixed record Holder { text: String }
pure func wrap(value: String) -> Holder:
    { text = value }
func main(arguments: List[String]) -> Int:
    child = 42.to_string()
    first = wrap(child)
    second = wrap(child)
    match arguments.length().equals(1):
        True: first.text.length().add(second.text.length())
        False: second.text.length().multiply(10).add(first.text.length())
