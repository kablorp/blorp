union Choice:
    First
    Second
    Third
record Holder { text: String }
pure func choose_last(count: Int) -> Choice:
    match count.equals(2):
        True: Second
        False: Third
pure func choose(count: Int) -> Choice:
    match count.equals(1):
        True: First
        False: choose_last(count)
pure func make() -> Holder:
    { text = 42.to_string() }
func main(arguments: List[String]) -> Int:
    owned = make()
    match choose(arguments.length()):
        First: owned.text.length()
        Second: owned.text.length().add(10)
        _: owned.text.length().add(20)
