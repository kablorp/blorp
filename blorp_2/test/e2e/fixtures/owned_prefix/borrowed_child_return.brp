import:
    io: print
fixed record Holder { text: String }
pure func make() -> Holder:
    { text = 7.to_string() }
pure func selected_child(value: String, selected: Bool) -> String:
    owned = make()
    match selected:
        True: value
        False: owned.text
func main(arguments: List[String]) -> Void:
    caller = 42.to_string()
    result = selected_child(caller, arguments.length().equals(1))
    print(caller)
    print(result)
