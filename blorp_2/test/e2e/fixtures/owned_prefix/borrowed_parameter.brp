record Holder { text: String }
pure func make(value: Int) -> Holder:
    { text = value.to_string() }
pure func inspect(value: Holder, selected: Bool) -> Int:
    owned = make(7)
    match selected:
        True: value.text.length().add(owned.text.length())
        False: value.text.length()
func main(arguments: List[String]) -> Int:
    caller = make(42)
    observed = inspect(caller, arguments.length().equals(1))
    observed.add(caller.text.length())
