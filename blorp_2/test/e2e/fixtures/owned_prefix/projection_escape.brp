fixed record Holder { text: String }
pure func make() -> Holder:
    { text = 42.to_string() }
pure func identity(value: String) -> String:
    value
pure func selected_child(selected: Bool) -> String:
    parent = make()
    projected = parent.text
    match selected:
        True: projected
        False: identity(projected)
func main(arguments: List[String]) -> Int:
    selected_child(arguments.length().equals(1)).length()
