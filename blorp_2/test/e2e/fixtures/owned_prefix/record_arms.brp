union Choice:
    Yes
    No
fixed record Holder { text: String }
pure func choose(arguments: List[String]) -> Choice:
    match arguments.length().equals(1):
        True: Yes
        False: No
pure func make() -> Holder:
    { text = 42.to_string() }
func main(arguments: List[String]) -> Int:
    owned = make()
    match choose(arguments):
        Yes: owned.text.length()
        No: 0
