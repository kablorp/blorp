import:
    io: print
fixed record Holder { text: String }
pure func make(value: Int) -> Holder:
    { text = value.to_string() }
pure func identity(value: Holder) -> Holder:
    value
func main(arguments: List[String]) -> Void:
    var current = make(42)
    original = identity(current)
    current = identity(current)
    current = make(7)
    match arguments.length().equals(1):
        True:
            print(original.text)
            print(current.text)
            print("yes")
        False:
            print(current.text)
            print(original.text)
            print("no")
