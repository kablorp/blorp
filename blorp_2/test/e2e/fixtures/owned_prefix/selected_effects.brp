import:
    io: print
record Holder { text: String }
func make() -> Holder:
    print("prefix")
    { text = 42.to_string() }
func report(value: Holder, label: String) -> Int:
    print(label)
    value.text.length()
func main(arguments: List[String]) -> Int:
    owned = make()
    match arguments.length().equals(1):
        True: report(owned, "yes")
        False:
            print("no")
            owned.text.length().add(1)
