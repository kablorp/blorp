import:
    system: write_file, read_file
    list: get
    io: print, print_error

func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None: 3
        Some(path):
            match write_file(path, "\u{FEFF}é😀\r\n\0tail"):
                Ok(_):
                    match read_file(path):
                        Ok(text):
                            print(text)
                            7
                        Err(error):
                            print_error(error)
                            2
                Err(error):
                    print_error(error)
                    1
