import:
    system: write_file, read_file
    list: get
    io: print, print_error

func escape(path: String) -> String:
    match write_file(path, ""):
        Ok(_): "unexpected success"
        Err(error): error

func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None: 2
        Some(path):
            match get(arguments, 2):
                None: 2
                Some(missing):
                    unused = write_file(path, "")
                    result = write_file(path, "")
                    kept_result = result
                    copies = [result, kept_result]
                    error_result = write_file(missing, "")
                    error_alias = error_result
                    errors = [error_result, error_alias]
                    contents = match read_file(path):
                        Ok(text): text
                        Err(_): "unexpected read failure"
                    print(contents)
                    print_error(escape(missing))
                    0
