import:
    int: add, to_string
    io: print
    list: get
fixed record Expr { form: Form, span: Int }
union Form:
    Leaf(Int)
    Call(String, List[Expr])
    Field(Expr, Int)
pure func leaf(value: Int) -> Expr:
    { form = Leaf(value), span = value }
pure func make() -> Expr:
    { form = Call("sum", [leaf(1), { form = Field(leaf(2), 7), span = 3 }, leaf(4)]), span = 5 }
pure func total(value: Expr) -> Int:
    match value.form:
        Leaf(number): number
        Call(name, arguments): add(name.length(), sum(arguments, 0, 0))
        Field(inner, offset): add(total(inner), offset)
pure func sum(values: List[Expr], index: Int, acc: Int) -> Int:
    match get(values, index):
        Some(value): sum(values, add(index, 1), add(acc, total(value)))
        None: acc
func main() -> Void:
    tree = make()
    print(to_string(total(tree)))
    print(to_string(tree.span))
