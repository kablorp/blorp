import:
    io: print
fixed union Trail:
    End
    Step(String, Trail)
fixed union Holder:
    Nothing
    Keep(Trail)
pure func make() -> Holder:
    Keep(Step("first", Step("second", End)))
func walk(value: Trail) -> Void:
    match value:
        End: print("end")
        Step(text, rest):
            print(text)
            walk(rest)
func main() -> Void:
    match make():
        Nothing: print("nothing")
        Keep(trail): walk(trail)
