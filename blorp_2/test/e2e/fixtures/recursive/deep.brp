import:
    int: add, subtract, equals, to_string
    io: print
union Nat:
    Zero
    Succ(Nat)
pure func build(remaining: Int) -> Nat:
    match equals(remaining, 0):
        True: Zero
        False: Succ(build(subtract(remaining, 1)))
pure func count(value: Nat, total: Int) -> Int:
    match value:
        Zero: total
        Succ(child): count(child, add(total, 1))
func main() -> Void:
    print(to_string(count(build(10000), 0)))
