import:
    int: add, to_string
    io: print
fixed record Step { operation: Int, rest: Links }
fixed union Links:
    Done
    Link(Step, Links)
pure func make() -> Links:
    Link({ operation = 1, rest = Done }, Link({ operation = 3, rest = Link({ operation = 4, rest = Done }, Done) }, Done))
pure func total(value: Links) -> Int:
    match value:
        Done: 0
        Link(step, next): add(add(step.operation, total(step.rest)), total(next))
func main() -> Void:
    print(to_string(total(make())))
