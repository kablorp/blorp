import:
    int: add, to_string
    io: print
union Links:
    Done
    Link(Holder, Links)
fixed record Holder { kind: Kind }
union Kind:
    Plain(Int)
    Nested(Links)
pure func make() -> Links:
    Link({ kind = Nested(Link({ kind = Plain(2) }, Done)) }, Link({ kind = Plain(3) }, Done))
pure func total(value: Links) -> Int:
    match value:
        Done: 0
        Link(holder, next): add(kind_total(holder.kind), total(next))
pure func kind_total(kind: Kind) -> Int:
    match kind:
        Plain(number): number
        Nested(links): total(links)
func main() -> Void:
    print(to_string(total(make())))
