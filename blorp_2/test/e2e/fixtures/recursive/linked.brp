import:
    int: add, to_string
    io: print
fixed record Node { value: Int, next: Option[Node] }
pure func make() -> Node:
    { value = 1, next = Some({ value = 2, next = Some({ value = 3, next = None }) }) }
pure func total(node: Node) -> Int:
    match node.next:
        None: node.value
        Some(next): add(node.value, total(next))
func main() -> Void:
    first = make()
    print(to_string(total(first)))
