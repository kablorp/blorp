import:
    int: add, equals, subtract, to_string
    io: print
fixed union A:
    X(R)
    Done
fixed record R { b: B, weight: Int }
fixed union B:
    Y(A)
    Stop
pure func make(depth: Int) -> A:
    match equals(depth, 0):
        True: Done
        False: X({ b = Y(make(subtract(depth, 1))), weight = depth })
pure func total(value: A) -> Int:
    match value:
        Done: 0
        X(link): add(link.weight, inner(link.b))
pure func inner(value: B) -> Int:
    match value:
        Stop: 0
        Y(next): total(next)
func main() -> Void:
    print(to_string(total(make(4))))
