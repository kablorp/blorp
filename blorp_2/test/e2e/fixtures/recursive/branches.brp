import:
    int: add, to_string
    io: print
fixed union Branch:
    ElseIf(Clause)
    Otherwise(String)
fixed record Clause { condition: Int, rest: Option[Branch] }
pure func make() -> Clause:
    { condition = 1, rest = Some(ElseIf({ condition = 2, rest = Some(Otherwise("done")) })) }
pure func conditions(value: Clause) -> Int:
    match value.rest:
        None: value.condition
        Some(branch): add(value.condition, branch_conditions(branch))
pure func branch_conditions(branch: Branch) -> Int:
    match branch:
        ElseIf(next): conditions(next)
        Otherwise(text): text.length()
func main() -> Void:
    print(to_string(conditions(make())))
