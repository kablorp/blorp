import:
    int: add
fixed union Nat:
    Zero
    Succ(Nat)
fixed record Pair { left: Nat, right: Nat }
pure func count(value: Nat, total: Int) -> Int:
    match value:
        Zero: total
        Succ(child): count(child, add(total, 1))
pure func two() -> Nat:
    Succ(Succ(Zero))
pure func make() -> Pair:
    shared = two()
    { left = shared, right = shared }
func main() -> Int:
    pair = make()
    add(count(pair.left, 0), count(pair.right, 0))
