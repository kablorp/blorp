import:
    int as IntOps
    list as Lists
    string: add
    io: print

fixed record State { text: String, values: List[String] }
fixed union PairValue:
    Pair(String, String)
fixed union Chain:
    End
    Link(String, Chain)

pure func head(value: Chain) -> String:
    match value:
        End: "end"
        Link(text, _): text

func show_pair(value: PairValue) -> Void:
    match value:
        Pair(left, right):
            print(left)
            print(right)

pure func natural(pre: String) -> String:
    var text: String = pre
    var turn: Int = 0
    while False:
        text = "wrong"
    while IntOps.less_than(turn, 1):
        text = add(text, "?")
        turn = IntOps.add(turn, 1)
    text

func exercise(pre: String) -> Void:
    var left: String = add(pre, "!")
    var right: String = "B!"
    original = left
    var values: List[String] = []
    var state: State = { text = "S:", values = values }
    var pair: PairValue = Pair(pre, pre)
    saved_pair = pair
    var chain: Chain = Link(pre, End)
    saved_chain = chain
    for index in 0..3:
        previous = left
        left = right
        right = previous
        values = Lists.append(values, left)
        -- The same outgoing List and String occur in several managed H values.
        state = { state | text = add(state.text, left), values = values }
        pair = Pair(left, left)
        chain = Link(left, chain)
        if IntOps.equals(index, 0):
            continue
        match IntOps.equals(index, 2):
            True: break
            False: void
        print("middle")
    print(left)
    print(right)
    print(original)
    print(pre)
    print(Lists.length(values).to_string())
    print(Lists.length(state.values).to_string())
    print(state.text)
    for value in values:
        print(value)
    for value in state.values:
        print(value)
    show_pair(pair)
    show_pair(saved_pair)
    print(head(chain))
    print(head(saved_chain))

func main() -> Void:
    pre = add("A", "")
    print(natural(pre))
    exercise(pre)
    print(pre)
