import:
    io: print
    int as IntOps
    float as FloatOps

func piece(label: String, value: String) -> String:
    print(label)
    value

pure func identity[T](value: T) -> T:
    value

pure func apply[T, U](callback: pure (T) -> U, value: T) -> U:
    callback(value)

func main() -> Int:
    print("begin${piece("first", "α\0")}middle${piece("second", "ω")}end")
    var value = "original"
    saved = "${value}"
    value = "replacement"
    print(saved)
    lines: String =
        |one ${piece("third", value)}
        |two ${IntOps.to_string(42)} ${FloatOps.to_string(1.5)}
    print(lines)
    print("generic ${"kept".identity()}")
    print("lambda ${apply(pure func(part): part, "kept")}")
    print("literal $\{kept} ${"yes"}")
    print("left\0${"right"}")
    0
