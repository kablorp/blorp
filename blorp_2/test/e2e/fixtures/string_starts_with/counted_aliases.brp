import:
    string: starts_with, add
    io: print

func print_truth(value: Bool) -> Void:
    match value:
        True: print("1")
        False: print("0")

pure func surviving_source() -> String:
    value = add("é\0", "tail")
    match starts_with(value, "é\0"):
        True: value
        False: "wrong prefix"

func main() -> Int:
    print_truth(starts_with("a\0b", "a\0"))
    print_truth(starts_with("a\0b", "a\0c"))
    print_truth(starts_with("é", "e\u{301}"))
    print_truth(starts_with("\u{feff}x", "\u{feff}"))
    source = add("é\0", "tail")
    original_value = source
    print_truth(starts_with(source, "é\0"))
    print(original_value)
    print(source)
    print(surviving_source())
    0
