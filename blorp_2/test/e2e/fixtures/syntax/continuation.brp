-- A line break inside an open bracket continues the line; the indentation of
-- continuation lines is not layout, and comments there are trivia.
import:
	int: add

fixed record Pair {
	first: Int,
	second: Int
}

pure func sum(
	pair: Pair -- the only parameter
) -> Int:
	add(
		pair.first,
			pair.second
	)

func main() -> Int:
	sum({
		first = 2,
		second = 5
	})
