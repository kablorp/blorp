import:
    system: read_file
    list: get
    io: print

func escape(path: String) -> String:
    match read_file(path):
        Ok(contents): contents
        Err(error): error

func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None: 2
        Some(path):
            unused = read_file(path)
            contents = escape(path)
            print(contents)
            0
