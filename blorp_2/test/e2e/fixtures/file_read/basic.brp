import:
    system: read_file
    list: get
    io: print
func main(arguments: List[String]) -> Int:
    match get(arguments, 1):
        None:
            print("missing path")
            2
        Some(path):
            match read_file(path):
                Ok(contents):
                    print(contents)
                    0
                Err(error):
                    print(error)
                    1
