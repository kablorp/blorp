fixed union Choice:
	Empty
	Number(Int)
pure func identity(value: Int) -> Int:
	value
pure func inspect(choice: Choice) -> Int:
	match choice:
		Empty:
			var current = 1
			current = identity(0)
			current
		Number(payload):
			var current = payload
			current = identity(42)
			current
func main() -> Int:
	inspect(Empty)
