fixed union Choice:
    First
    Second
pure func choose(choice: Choice) -> String:
    match choice:
        First:
            unused = 99.to_string()
            var current = 7.to_string()
            original = current
            current = 42.to_string()
            original
        Second:
            42.to_string()
func main() -> Int:
    choose(First).length()
