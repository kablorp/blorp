import:
	../../src/main: compile
	harness: run_example
	test: TestSuite


private CALL_C: String = "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(int64_t blorp_p_0);int64_t blorp_f_2(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_1(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_2(void){const int64_t blorp_vl_0=blorp_f_0();(void)blorp_vl_0;const int64_t blorp_vl_1=blorp_f_1(blorp_vl_0);(void)blorp_vl_1;return blorp_vl_1;}int main(void){return (int)blorp_f_2();}\n"

private CHAIN_C: String = "#include <stdint.h>\nint64_t blorp_f_0(int64_t blorp_p_0);int64_t blorp_f_1(int64_t blorp_p_0);int64_t blorp_f_2(void);int64_t blorp_f_0(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(1);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_1(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(0);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_2(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;const int64_t blorp_vl_1=blorp_f_0(blorp_vl_0);(void)blorp_vl_1;const int64_t blorp_vl_2=blorp_f_1(blorp_vl_1);(void)blorp_vl_2;return blorp_vl_2;}int main(void){return (int)blorp_f_2();}\n"

private MIXED_C: String = "#include <stdint.h>\nint64_t blorp_f_0(int64_t blorp_p_0);int64_t blorp_f_1(int64_t blorp_p_0);int64_t blorp_f_2(int64_t blorp_p_0);int64_t blorp_f_3(void);int64_t blorp_f_0(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_1(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(1);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_2(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(0);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_3(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;const int64_t blorp_vl_1=blorp_f_0(blorp_vl_0);(void)blorp_vl_1;const int64_t blorp_vl_2=blorp_f_1(blorp_vl_1);(void)blorp_vl_2;const int64_t blorp_vl_3=blorp_f_2(blorp_vl_2);(void)blorp_vl_3;const int64_t blorp_vl_4=blorp_f_0(blorp_vl_3);(void)blorp_vl_4;return blorp_vl_4;}int main(void){return (int)blorp_f_3();}\n"


pure func test_ufcs_emits_the_direct_call() -> Bool:
	match compile(
		"pure func one() -> Int:\n\t1\npure func identity(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tone().identity()\n",
	):
		Err(_):
			False
		Ok(output):
			output == CALL_C


pure func test_chain_emits_left_to_right() -> Bool:
	match compile(
		"pure func one(value: Int) -> Int:\n\t1\npure func zero(value: Int) -> Int:\n\t0\nfunc main() -> Int:\n\t1.one().zero()\n",
	):
		Err(_):
			False
		Ok(output):
			output == CHAIN_C


pure func test_prefix_and_postfix_interleave_in_c() -> Bool:
	match compile(
		"pure func identity(value: Int) -> Int:\n\tvalue\npure func one(value: Int) -> Int:\n\t1\npure func zero(value: Int) -> Int:\n\t0\nfunc main() -> Int:\n\tzero(identity(1).one()).identity()\n",
	):
		Err(_):
			False
		Ok(output):
			output == MIXED_C


func test_ufcs_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "ufcs_calls",
			fixture = "blorp_2/test/e2e/fixtures/ufcs_calls.brp",
			expected_c = Some(CALL_C),
			exit_status = 1,
			limits = {
				allocations = 650,
				instructions = 40000000
			}
		},
	)


func test_chain_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "ufcs_chain",
			fixture = "blorp_2/test/e2e/fixtures/ufcs_chain.brp",
			expected_c = Some(CHAIN_C),
			exit_status = 0,
			limits = {
				allocations = 750,
				instructions = 40000000
			}
		},
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 UFCS",
		tests = [
			("UFCS emits the direct call", test_ufcs_emits_the_direct_call),
			("chain emits left to right", test_chain_emits_left_to_right),
			("prefix and postfix interleave in C", test_prefix_and_postfix_interleave_in_c),
			("UFCS native execution and cost", func(): test_ufcs_native_and_cost(compiler)),
			("chain native execution and cost", func(): test_chain_native_and_cost(compiler)),
		]
	}
