import:
	../../src/runtime/memory: MEMORY_RUNTIME
	../unit/compilation: compile
	./harness: native_case, run_example
	test: TestSuite


private CALL_C: String = MEMORY_RUNTIME + "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);int64_t blorp_f_2(int64_t blorp_p_0);int64_t blorp_f_0(void){const int64_t blorp_vl_0=blorp_f_1();(void)blorp_vl_0;const int64_t blorp_vl_1=blorp_f_2(blorp_vl_0);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_1(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_2(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;return blorp_vl_0;}int main(void){blorp_memory_start();return blorp_memory_finish((int)blorp_f_0());}\n"

private CHAIN_C: String = MEMORY_RUNTIME + "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(int64_t blorp_p_0);int64_t blorp_f_2(int64_t blorp_p_0);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;const int64_t blorp_vl_1=blorp_f_1(blorp_vl_0);(void)blorp_vl_1;const int64_t blorp_vl_2=blorp_f_2(blorp_vl_1);(void)blorp_vl_2;return blorp_vl_2;}int64_t blorp_f_1(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(1);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_2(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(0);(void)blorp_vl_1;return blorp_vl_1;}int main(void){blorp_memory_start();return blorp_memory_finish((int)blorp_f_0());}\n"

private MIXED_C: String = MEMORY_RUNTIME + "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(int64_t blorp_p_0);int64_t blorp_f_2(int64_t blorp_p_0);int64_t blorp_f_3(int64_t blorp_p_0);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;const int64_t blorp_vl_1=blorp_f_1(blorp_vl_0);(void)blorp_vl_1;const int64_t blorp_vl_2=blorp_f_2(blorp_vl_1);(void)blorp_vl_2;const int64_t blorp_vl_3=blorp_f_3(blorp_vl_2);(void)blorp_vl_3;const int64_t blorp_vl_4=blorp_f_1(blorp_vl_3);(void)blorp_vl_4;return blorp_vl_4;}int64_t blorp_f_1(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_2(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(1);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_3(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(0);(void)blorp_vl_1;return blorp_vl_1;}int main(void){blorp_memory_start();return blorp_memory_finish((int)blorp_f_0());}\n"


pure func test_ufcs_emits_the_direct_call() -> Bool:
	source: String =
		|pure func one() -> Int:
		|	1
		|pure func identity(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	one().identity()
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			output == CALL_C


pure func test_chain_emits_left_to_right() -> Bool:
	source: String =
		|pure func one(value: Int) -> Int:
		|	1
		|pure func zero(value: Int) -> Int:
		|	0
		|func main() -> Int:
		|	1.one().zero()
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			output == CHAIN_C


pure func test_prefix_and_postfix_interleave_in_c() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func one(value: Int) -> Int:
		|	1
		|pure func zero(value: Int) -> Int:
		|	0
		|func main() -> Int:
		|	zero(identity(1).one()).identity()
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			output == MIXED_C


func test_ufcs_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "ufcs_calls",
			fixture = "blorp_2/test/e2e/fixtures/ufcs/calls.brp",
			expected_c = None,
			first_case = native_case("native output", "", 1, ""),
			remaining_cases = [],
			limits = {
				allocations = 132000,
				instructions = 440000000
			}
		},
	)


func test_chain_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "ufcs_chain",
			fixture = "blorp_2/test/e2e/fixtures/ufcs/chain.brp",
			expected_c = None,
			first_case = native_case("native output", "", 0, ""),
			remaining_cases = [],
			limits = {
				allocations = 132000,
				instructions = 440000000
			}
		},
	)


-- A 64-link receiver chain nests as deeply as the 64-level constructor_spine
-- fixture. Translation folds a chain iteratively; only lowering recurses to
-- that depth.
func test_chain_64_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "ufcs_chain_64",
			fixture = "blorp_2/test/e2e/fixtures/ufcs/chain_64.brp",
			expected_c = None,
			first_case = native_case("native output", "", 65, ""),
			remaining_cases = [],
			limits = {
				allocations = 26300,
				instructions = 100000000
			}
		},
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 UFCS",
		tests = [
			("UFCS emits the direct call", test_ufcs_emits_the_direct_call),
			("chain emits left to right", test_chain_emits_left_to_right),
			("prefix and postfix interleave in C", test_prefix_and_postfix_interleave_in_c),
			("UFCS native execution and cost", func(): test_ufcs_native_and_cost(compiler)),
			("chain native execution and cost", func(): test_chain_native_and_cost(compiler)),
			("64-link chain native execution and cost", func(): test_chain_64_native_and_cost(compiler)),
		]
	}
