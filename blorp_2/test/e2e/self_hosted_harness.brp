import:
    process: run_to_files
    fs: describe, read_text, write_text
    io: print_error
    test: TestSuite
    ./self_hosted_reports: verify_accounting
    bool: not, and
    result: Result methods
    int: Int methods
    string: String methods


private ENVIRONMENT_TOOL: String = "/usr/bin/env"
private SHELL: String = "/bin/sh"
private LIBRARY_ROOT: String = "blorp_2/standard_library"
-- Compilation includes C sanitizer linking; native fixtures should finish quickly.
private COMPILATION_TIMEOUT_MS: Int = 600000
private NATIVE_TIMEOUT_MS: Int = 10000
private PRESERVED_OUTPUT: String = "preserve this rejected output"
private FS_PREPARE_SCRIPT: String = "blorp_2/test/e2e/fixtures/fs/prepare.sh"
private FS_WRITE_PREPARE_SCRIPT: String = "blorp_2/test/e2e/fixtures/fs/prepare_write.sh"
private FS_DIRECTORIES_PREPARE_SCRIPT: String = "blorp_2/test/e2e/fixtures/fs/prepare_directories.sh"
-- prepare.sh's exit status when it runs as root, which file permissions do
-- not refuse, so no fs example could provoke PermissionDenied.
private FS_NOT_RUN_STATUS: Int = 77
private FS_READ_OUTPUT: String =
    |read_text settings.conf: ok 6 bytes
    |read_text empty.txt: ok 0 bytes
    |read_text link_to_file: ok 6 bytes
    |read_text missing.txt: missing.txt: no such file
    |read_text locked.txt: locked.txt: permission denied
    |read_text settings.conf/child: settings.conf/child: not a directory
    |read_text folder: folder: is a directory
    |read_text not_utf8.bin: not_utf8.bin: contents are not valid UTF-8
    |read_text loop: OtherOs
    |read_text dangling_link: dangling_link: no such file
    |read_text nul: nul: path contains a NUL byte
    |entry_kind settings.conf: file
    |entry_kind locked.txt: file
    |entry_kind folder: directory
    |entry_kind link_to_file: symlink
    |entry_kind dangling_link: symlink
    |entry_kind loop: symlink
    |entry_kind pipe: other
    |entry_kind missing.txt: absent
    |entry_kind settings.conf/child: absent
    |entry_kind loop/inside: OtherOs
    |entry_kind nul: nul: path contains a NUL byte
    |default_if_not_found missing.txt: ok 8 bytes
    |default_if_not_found settings.conf: ok 6 bytes
    |default_if_not_found locked.txt: locked.txt: permission denied
    |default_if_not_found folder: folder: is a directory
    |settings.conf: no such file
    |settings.conf: permission denied
    |settings.conf: already exists
    |settings.conf: not a directory
    |settings.conf: is a directory
    |settings.conf: directory not empty
    |settings.conf: not a regular file
    |settings.conf: read-only file system
    |settings.conf: no space left on device
    |settings.conf: file too large
    |settings.conf: crosses devices
    |settings.conf: path contains a NUL byte
    |settings.conf: contents are not valid UTF-8
    |settings.conf: changed during removal
    |settings.conf: operating system error 40
    |a -> b: crosses devices
    |


private FS_WRITE_OUTPUT: String =
    |write_text new.txt: ok
    |  new.txt holds "created"
    |write_text existing.txt: ok
    |  existing.txt holds "replaced"
    |write_text link: ok
    |  real/target.txt holds "through the link"
    |  link is symlink
    |write_text dangling: dangling: no such file
    |  missing_target is absent
    |write_text read_only.txt: read_only.txt: permission denied
    |  read_only.txt holds "kept"
    |write_text pipe: pipe: not a regular file
    |write_text folder: folder: is a directory
    |write_text folder/: folder/: is a directory
    |  folder is directory
    |write_text existing.txt/child: existing.txt/child: not a directory
    |write_text missing/child.txt: missing/child.txt: no such file
    |write_text loop: OtherOs
    |write_text nul: nul: path contains a NUL byte
    |


-- The directory operations' kinds, in the order directories.brp provokes them.
private FS_DIRECTORIES_OUTPUT: String =
    |list_directory listing: 7 entries
    |  B file
    |  _ file
    |  a file
    |  ab file
    |  dir directory
    |  link symlink
    |  e-acute file
    |list_directory listing_link: 7 entries
    |  B file
    |  _ file
    |  a file
    |  ab file
    |  dir directory
    |  link symlink
    |  e-acute file
    |list_directory empty: 0 entries
    |list_directory missing: missing: no such file
    |list_directory file.txt: file.txt: not a directory
    |list_directory locked: locked: permission denied
    |remove_directory locked: ok
    |create_directory fresh: ok
    |create_directory fresh: fresh: already exists
    |create_directory absent/child: absent/child: no such file
    |create_directory slashed/: ok
    |  slashed is directory
    |create_directories deep/a/b/c: ok
    |create_directories deep/a/b/c: ok
    |  deep/a/b/c is directory
    |create_directories file.txt/x/y: file.txt/x/y: not a directory
    |create_directories file.txt: file.txt: already exists
    |create_directories dangling: dangling: already exists
    |remove_file to_remove.txt: ok
    |remove_file to_remove.txt: to_remove.txt: no such file
    |remove_file listing/dir: listing/dir: is a directory
    |remove_directory removable: ok
    |remove_directory nonempty: nonempty: directory not empty
    |remove_directory removable: removable: no such file
    |remove_directory file.txt: file.txt: not a directory
    |rename old.txt -> new.txt: ok
    |  old.txt is absent
    |  new.txt holds "moved"
    |rename old.txt -> again.txt: old.txt -> again.txt: no such file
    |rename source_dir -> nonempty: source_dir -> nonempty: directory not empty
    |remove_directory_tree tree: ok
    |  tree is absent
    |  outside is directory
    |  outside/precious.txt holds "precious"
    |remove_directory_tree tree: tree: no such file
    |remove_directory_tree file.txt: file.txt: not a directory
    |remove_directory_tree listing_link: listing_link: not a directory
    |remove_directory_tree listing_link/: listing_link/: not a directory
    |remove_directory_tree listing/.: OtherOs
    |list_directory listing: 7 entries
    |  B file
    |  _ file
    |  a file
    |  ab file
    |  dir directory
    |  link symlink
    |  e-acute file
    |with_temporary_directory ok: 7
    |  scratch holds 0 entries
    |with_temporary_directory text error: body failed
    |  scratch holds 0 entries
    |with_temporary_directory removed by body: directory: no such file
    |  path is the directory the body was given
    |  scratch holds 0 entries
    |with_temporary_directory body error: body: permission denied
    |  scratch holds 0 entries
    |with_temporary_directory missing parent: missing: no such file
    |


-- Each native's code, the same on macOS and Linux: macOS refuses unlink of a
-- directory with EPERM and Linux with EISDIR, and both are IsADirectory (5).
private FS_NATIVE_DIRECTORIES_OUTPUT: String =
    |create_directories: ok
    |create_directory: 3
    |rename: ok
    |entry 2 renamed
    |remove_file: 5
    |remove_directory: 6
    |remove_directory: ok
    |remove_directory: ok
    |create_temporary_directory: ok
    |create_directories: ok
    |write_text: ok
    |remove_directory_tree: ok
    |remove_directory_tree: 1
    |remove_directory: ok
    |


private union NativeMode:
    NormalNative
    StrictNative


-- `arguments` follow the program name on the native command line.
private record Example {
    name: String,
    source: String,
    status: Int,
    stdout: String,
    allocations: Int,
    arguments: List[String]
}


-- A fixture the compiler must reject with exactly this diagnostic text.
private record Rejection {
    name: String,
    source: String,
    diagnostic: String
}


private pure func expect(actual: String, expected: String, description: String) -> Result[Void, String]:
    if actual.equals(expected):
        Ok(void)
    else:
        Err(description + ": expected [" + expected + "], got [" + actual + "]")


private func command(arguments: List[String], prefix: String, expected_status: Int, timeout_ms: Int) -> Result[Void, String]:
    actual: Int ?= run_to_files(ENVIRONMENT_TOOL, arguments, prefix + ".stdout", prefix + ".stderr", timeout_ms).map_err(pure func(error: String): prefix + ": " + error)
    if actual.equals(expected_status):
        Ok(void)
    else:
        match read_text(prefix + ".stderr").map_err(describe):
            Ok(captured): Err(prefix + ": expected exit " + expected_status.to_string() + ", got " + actual.to_string() + ": " + captured)
            Err(error): Err(error)


-- `inputs` are the compiler arguments between the library root and the output.
private func compile_fixture(compiler: String, inputs: List[String], prefix: String) -> Result[Void, String]:
    _ ?= command(
        ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict", compiler,
         "--library-root", LIBRARY_ROOT].concat(inputs).concat([prefix + ".c"]),
        prefix + ".compile", 0, COMPILATION_TIMEOUT_MS,
    )
    output: String ?= read_text(prefix + ".compile.stdout").map_err(describe)
    _ ?= expect(output, "", "compiler stdout")
    report: String ?= read_text(prefix + ".compile.stderr").map_err(describe)
    _ ?= verify_accounting(report, True)
    generated: String ?= read_text(prefix + ".c").map_err(describe)
    if generated.length().equals(0):
        Err("successful compilation emitted empty C")
    else:
        Ok(void)


private func link_fixture(c_compiler: String, prefix: String, mode: NativeMode) -> Result[Void, String]:
    (suffix, definition) = match mode:
        NormalNative: (".normal", "-DBLORP_MEMORY_DIAGNOSTICS=0")
        StrictNative: (".strict", "-DBLORP_MEMORY_DIAGNOSTICS=1")
    binary = prefix + suffix
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", c_compiler,
         "-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic", "-O0",
         "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
         definition,
         prefix + ".c", "-o", binary, "-lm", "-lpthread"],
        binary + ".link", 0, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_text(binary + ".link.stdout").map_err(describe)
    _ ?= expect(stdout, "", "C compiler stdout")
    stderr: String ?= read_text(binary + ".link.stderr").map_err(describe)
    expect(stderr, "", "C compiler stderr")


-- One native invocation. A run that shares its fixture with others has a
-- `label` naming its capture files and error text; `directory` is where the
-- program starts (None keeps the runner's own).
record NativeRun {
    label: Option[String],
    arguments: List[String],
    directory: Option[String],
    status: Int,
    stdout: String,
    allocations: Int
}


-- The shell only changes directory and then replaces itself with the program.
private CHANGE_DIRECTORY: String = "cd \"$1\" && shift && exec \"$@\""


private pure func launch(binary: String, run: NativeRun) -> List[String]:
    match run.directory:
        None: [binary].concat(run.arguments)
        Some(directory): [SHELL, "-c", CHANGE_DIRECTORY, "sh", directory, binary].concat(run.arguments)


private pure func label_suffix(run: NativeRun) -> String:
    match run.label:
        None: ""
        Some(label): "." + label


private func run_normal(prefix: String, run: NativeRun) -> Result[Void, String]:
    capture = prefix + label_suffix(run)
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS"].concat(launch(prefix + ".normal", run)),
        capture + ".normal.run", run.status, NATIVE_TIMEOUT_MS,
    )
    output: String ?= read_text(capture + ".normal.run.stdout").map_err(describe)
    _ ?= expect(output, run.stdout, "native stdout" + label_suffix(run))
    errors: String ?= read_text(capture + ".normal.run.stderr").map_err(describe)
    expect(errors, "", "native stderr" + label_suffix(run))


private func run_strict(prefix: String, run: NativeRun) -> Result[Void, String]:
    capture = prefix + label_suffix(run)
    _ ?= command(
        ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict"].concat(launch(prefix + ".strict", run)),
        capture + ".strict.run", run.status, NATIVE_TIMEOUT_MS,
    )
    strict_output: String ?= read_text(capture + ".strict.run.stdout").map_err(describe)
    _ ?= expect(strict_output, run.stdout, "strict native stdout" + label_suffix(run))
    accounting: String ?= read_text(capture + ".strict.run.stderr").map_err(describe)
    expected = ("blorp: leak check: " + run.allocations.to_string() + " allocs, ") + run.allocations.to_string() + " releases, 0 leaked, 0 bytes\n"
    expect(accounting, expected, "strict native accounting" + label_suffix(run))


private func run_fixture(prefix: String, run: NativeRun) -> Result[Void, String]:
    _ ?= run_normal(prefix, run)
    run_strict(prefix, run)


private pure func example_run(example: Example) -> NativeRun:
    { label = None, arguments = example.arguments, directory = None, status = example.status, stdout = example.stdout, allocations = example.allocations }


private func run_all(prefix: String, runs: List[NativeRun]) -> Result[Void, String]:
    var outcome: Result[Void, String] = Ok(void)
    for run in runs:
        match outcome:
            Ok(_): outcome = run_fixture(prefix, run)
            Err(_): void
    outcome


private func verify_example(compiler: String, c_compiler: String, work_directory: String, example: Example) -> Result[Void, String]:
    prefix = work_directory + "/" + example.name
    _ ?= compile_fixture(compiler, [example.source], prefix)
    _ ?= link_fixture(c_compiler, prefix, NormalNative)
    _ ?= link_fixture(c_compiler, prefix, StrictNative)
    run_fixture(prefix, example_run(example))


-- One `--test-suite` program: `example.source` is the first root, which owns
-- the entry, and `grouped` are the later roots in command-line order.
private func verify_suites(compiler: String, c_compiler: String, work_directory: String, example: Example, grouped: List[String]) -> Result[Void, String]:
    prefix = work_directory + "/" + example.name
    _ ?= compile_fixture(compiler, ["--test-suite", example.source].concat(grouped), prefix)
    _ ?= link_fixture(c_compiler, prefix, NormalNative)
    _ ?= link_fixture(c_compiler, prefix, StrictNative)
    run_fixture(prefix, example_run(example))


-- Compiles `source` once and runs it as every entry of `runs`, in order.
func verify_runs(compiler: String, c_compiler: String, work_directory: String, name: String, source: String, runs: List[NativeRun]) -> Result[Void, String]:
    prefix = work_directory + "/" + name
    _ ?= compile_fixture(compiler, [source], prefix)
    _ ?= link_fixture(c_compiler, prefix, NormalNative)
    _ ?= link_fixture(c_compiler, prefix, StrictNative)
    run_all(prefix, runs)


private func rejected_fixture(compiler: String, work_directory: String) -> Result[Void, String]:
    source = work_directory + "/rejected.brp"
    output = work_directory + "/rejected.c"
    _ ?= write_text(source, "func start() -> Int:\n    0\n").map_err(describe)
    _ ?= write_text(output, PRESERVED_OUTPUT).map_err(describe)
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", compiler,
         "--library-root", LIBRARY_ROOT, source, output],
        work_directory + "/rejected.compile", 1, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_text(work_directory + "/rejected.compile.stdout").map_err(describe)
    _ ?= expect(stdout, "", "rejected compiler stdout")
    stderr: String ?= read_text(work_directory + "/rejected.compile.stderr").map_err(describe)
    diagnostic = source + ":3:1: error: expected a main function\nhelp: declare func main() -> Int: as the entrypoint\n"
    _ ?= expect(stderr, diagnostic, "rejected compiler diagnostic")
    unchanged: String ?= read_text(output).map_err(describe)
    expect(unchanged, PRESERVED_OUTPUT, "rejected output sentinel")


-- The compiler exits 1 with nothing on stdout and exactly this stderr.
private func expect_failure(compiler: String, source: String, output: String, prefix: String, expected_stderr: String) -> Result[Void, String]:
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", compiler,
         "--library-root", LIBRARY_ROOT, source, output],
        prefix + ".compile", 1, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_text(prefix + ".compile.stdout").map_err(describe)
    _ ?= expect(stdout, "", "failed compiler stdout")
    stderr: String ?= read_text(prefix + ".compile.stderr").map_err(describe)
    expect(stderr, expected_stderr, "failed compiler diagnostic")


-- fs words the failure, naming the output path the compiler was given.
private func directory_output_fixture(compiler: String, work_directory: String) -> Result[Void, String]:
    source = work_directory + "/directory_output.brp"
    _ ?= write_text(source, "func main() -> Int:\n    0\n").map_err(describe)
    expect_failure(
        compiler, source, work_directory, work_directory + "/directory_output",
        "blorp_2: error: could not write " + work_directory + ": is a directory\nhelp: provide a writable output path\n",
    )


-- fs words the failure, naming the module path the loader resolved.
private func missing_module_fixture(compiler: String, work_directory: String) -> Result[Void, String]:
    source = work_directory + "/missing_module.brp"
    _ ?= write_text(source, "import:\n    ./missing: thing\nfunc main() -> Int:\n    0\n").map_err(describe)
    expect_failure(
        compiler, source, work_directory + "/missing_module.c", work_directory + "/missing_module",
        source + ":2:5: error: could not read module " + work_directory + "/missing.brp: no such file\nhelp: check the import path and provide a readable .brp file under its source root\n",
    )


private func verify_rejection(compiler: String, work_directory: String, rejection: Rejection) -> Result[Void, String]:
    prefix = work_directory + "/" + rejection.name
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", compiler,
         "--library-root", LIBRARY_ROOT, rejection.source, prefix + ".c"],
        prefix + ".compile", 1, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_text(prefix + ".compile.stdout").map_err(describe)
    _ ?= expect(stdout, "", "rejected compiler stdout")
    stderr: String ?= read_text(prefix + ".compile.stderr").map_err(describe)
    expect(stderr, rejection.source + rejection.diagnostic, "rejected compiler diagnostic")


private pure func generic_opaque(name: String, diagnostic: String) -> Rejection:
    { name = "opaque_" + name, source = "blorp_2/test/e2e/fixtures/opaque/generic/" + name + ".brp", diagnostic = diagnostic }


private RECURSIVE_AGGREGATE: String = " error: recursive aggregate types are not supported yet\nhelp: use finite record and union fields; recursion is supported through a record field, a List element or one direct self payload of a non-generic union, such as Next(Node)\n"


private RECURSIVE_OPAQUE: String = " error: recursive opaque representations are not supported yet\nhelp: wrap an independently recursive aggregate instead of referring back to the opaque type\n"


func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_): True
        Err(error):
            print_error(error)
            False


-- The fs examples read, write and change trees that the prepare scripts build,
-- because no fs operation can create a file that is not UTF-8, a symlink, a
-- read-only file, a mode 000 directory or a FIFO. Where prepare.sh cannot build
-- its tree, as root, all three examples are reported as not run and left out,
-- so that they earn no PASS credit: each needs a user that file permissions
-- refuse.
private func fs_tree_tests(compiler: String, c_compiler: String, work_directory: String) -> List[(String, () -> Bool)]:
    tree = work_directory + "/fs_tree"
    write_tree = work_directory + "/fs_write_tree"
    directories_tree = work_directory + "/fs_directories_tree"
    prefix = work_directory + "/fs_prepare"
    read: Example = { name = "fs_read", source = "blorp_2/test/e2e/fixtures/fs/read.brp", status = 0, stdout = FS_READ_OUTPUT, allocations = 260, arguments = [tree] }
    write: Example = { name = "fs_write", source = "blorp_2/test/e2e/fixtures/fs/write.brp", status = 0, stdout = FS_WRITE_OUTPUT, allocations = 168, arguments = [write_tree] }
    directories: Example = { name = "fs_directories", source = "blorp_2/test/e2e/fixtures/fs/directories.brp", status = 0, stdout = FS_DIRECTORIES_OUTPUT, allocations = 574, arguments = [directories_tree] }
    match run_to_files(SHELL, [FS_PREPARE_SCRIPT, tree], prefix + ".stdout", prefix + ".stderr", NATIVE_TIMEOUT_MS):
        Err(error): [("the fs example tree is prepared", func(): reported(Err(error)))]
        Ok(status):
            if status.equals(FS_NOT_RUN_STATUS):
                print_error("fs examples not run: their trees need a user that file permissions refuse")
                []
            else if status.equals(0):
                [
                    ("fs read_text and entry_kind return each kind, and describe words each one", func(): reported(verify_example(compiler, c_compiler, work_directory, read))),
                    ("fs write_text replaces, creates and writes through a link, and returns each kind it can", func(): reported(verify_on_rebuilt_tree(compiler, c_compiler, work_directory, write, write_tree, FS_WRITE_PREPARE_SCRIPT))),
                    ("fs directory operations list, create, remove and rename, and return each kind they can", func(): reported(verify_on_rebuilt_tree(compiler, c_compiler, work_directory, directories, directories_tree, FS_DIRECTORIES_PREPARE_SCRIPT))),
                ]
            else:
                [("the fs example tree is prepared", func(): reported(Err(FS_PREPARE_SCRIPT + " exited " + status.to_string())))]


-- Rebuilds the directory an example that changes it is given, from nothing.
private func rebuilt_tree(script: String, directory: String, prefix: String) -> Result[Void, String]:
    status ?= run_to_files(SHELL, [script, directory], prefix + ".stdout", prefix + ".stderr", NATIVE_TIMEOUT_MS)
    if status.equals(0):
        Ok(void)
    else:
        Err(script + " exited " + status.to_string())


-- The write and directories examples change the directory they are given, so
-- each of their two runs gets the directory, which is also the example's
-- argument, just rebuilt by its prepare script, and neither run sees the
-- other's changes.
private func verify_on_rebuilt_tree(compiler: String, c_compiler: String, work_directory: String, example: Example, directory: String, script: String) -> Result[Void, String]:
    prefix = work_directory + "/" + example.name
    _ ?= compile_fixture(compiler, [example.source], prefix)
    _ ?= link_fixture(c_compiler, prefix, NormalNative)
    _ ?= link_fixture(c_compiler, prefix, StrictNative)
    _ ?= rebuilt_tree(script, directory, prefix + ".normal.prepare")
    _ ?= run_normal(prefix, example_run(example))
    _ ?= rebuilt_tree(script, directory, prefix + ".strict.prepare")
    run_strict(prefix, example_run(example))


func suite(compiler: String, c_compiler: String, work_directory: String) -> TestSuite:
    zero: Example = { name = "zero", source = "blorp_2/test/e2e/fixtures/return/zero.brp", status = 0, stdout = "", allocations = 0, arguments = [] }
    nonzero: Example = { name = "nonzero", source = "blorp_2/test/e2e/fixtures/return/23.brp", status = 23, stdout = "", allocations = 0, arguments = [] }
    text: Example = { name = "text", source = "blorp_2/test/e2e/fixtures/effects/hello.brp", status = 0, stdout = "Hello, World!\n", allocations = 1, arguments = [] }
    discard: Example = { name = "discard", source = "blorp_2/test/e2e/fixtures/result_propagation/discard.brp", status = 0, stdout = "once\nshared-value\n7\nerror-once\nkept-error\n", allocations = 12, arguments = [] }
    append_reuse: Example = { name = "append_reuse", source = "blorp_2/test/e2e/fixtures/list/append_reuse.brp", status = 0, stdout = "12\n0\n11\n12\n42 child\n42 child\n13\nnew\ntail\n12\n7\n13\nlast\ndone\n", allocations = 27, arguments = [] }
    update_reuse: Example = { name = "update_reuse", source = "blorp_2/test/e2e/fixtures/list/update_reuse.brp", status = 0, stdout = "42 child\n42 child\n7 replacement\n42 child\n2\n7 replacement\n42 child\n42 child\n7 replacement\n2\n42 child\n4\n7 replacement\n42 child\n2\n4\n42 child\n4\n42 child\ndone\n", allocations = 28, arguments = [] }
    literal: Example = { name = "literal", source = "blorp_2/test/e2e/fixtures/list/literal_int.brp", status = 0, stdout = "3\n1\n3\n", allocations = 4, arguments = [] }
