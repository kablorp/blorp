import:
    process: run_to_files
    system: read_file, write_file
    io: print_error
    test: TestSuite
    ./self_hosted_reports: verify_accounting
    bool: not, and
    result: Result methods_only
    int: Int methods_only
    string: String methods_only


private ENVIRONMENT_TOOL: String = "/usr/bin/env"
private LIBRARY_ROOT: String = "blorp_2/standard_library"
-- Compilation includes C sanitizer linking; native fixtures should finish quickly.
private COMPILATION_TIMEOUT_MS: Int = 600000
private NATIVE_TIMEOUT_MS: Int = 10000
private PRESERVED_OUTPUT: String = "preserve this rejected output"


private fixed union NativeMode:
    NormalNative
    StrictNative


private fixed record Example {
    name: String,
    source: String,
    status: Int,
    stdout: String,
    allocations: Int
}


private pure func expect(actual: String, expected: String, description: String) -> Result[Void, String]:
    if actual.equals(expected):
        Ok(void)
    else:
        Err(description.add(": expected [").add(expected).add("], got [").add(actual).add("]"))


private func command(arguments: List[String], prefix: String, expected_status: Int, timeout_ms: Int) -> Result[Void, String]:
    actual: Int ?= run_to_files(ENVIRONMENT_TOOL, arguments, prefix.add(".stdout"), prefix.add(".stderr"), timeout_ms).map_err(pure func(error: String): prefix.add(": ").add(error))
    if actual.equals(expected_status):
        Ok(void)
    else:
        match read_file(prefix.add(".stderr")):
            Ok(captured): Err(prefix.add(": expected exit ").add(expected_status.to_string()).add(", got ").add(actual.to_string()).add(": ").add(captured))
            Err(error): Err(error)


private func compile_fixture(compiler: String, source: String, prefix: String) -> Result[Void, String]:
    _ ?= command(
        ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict", compiler,
         "--library-root", LIBRARY_ROOT, source, prefix.add(".c")],
        prefix.add(".compile"), 0, COMPILATION_TIMEOUT_MS,
    )
    output: String ?= read_file(prefix.add(".compile.stdout"))
    _ ?= expect(output, "", "compiler stdout")
    report: String ?= read_file(prefix.add(".compile.stderr"))
    _ ?= verify_accounting(report, True)
    generated: String ?= read_file(prefix.add(".c"))
    if generated.length().equals(0):
        Err("successful compilation emitted empty C")
    else:
        Ok(void)


private func link_fixture(c_compiler: String, prefix: String, mode: NativeMode) -> Result[Void, String]:
    (suffix, definition) = match mode:
        NormalNative: (".normal", "-DBLORP_MEMORY_DIAGNOSTICS=0")
        StrictNative: (".strict", "-DBLORP_MEMORY_DIAGNOSTICS=1")
    binary = prefix.add(suffix)
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", c_compiler,
         "-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic", "-O0",
         "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
         definition,
         prefix.add(".c"), "-o", binary, "-lm", "-lpthread"],
        binary.add(".link"), 0, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_file(binary.add(".link.stdout"))
    _ ?= expect(stdout, "", "C compiler stdout")
    stderr: String ?= read_file(binary.add(".link.stderr"))
    expect(stderr, "", "C compiler stderr")


private func run_fixture(prefix: String, example: Example) -> Result[Void, String]:
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", prefix.add(".normal")],
        prefix.add(".normal.run"), example.status, NATIVE_TIMEOUT_MS,
    )
    output: String ?= read_file(prefix.add(".normal.run.stdout"))
    _ ?= expect(output, example.stdout, "native stdout")
    errors: String ?= read_file(prefix.add(".normal.run.stderr"))
    _ ?= expect(errors, "", "native stderr")
    _ ?= command(
        ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict", prefix.add(".strict")],
        prefix.add(".strict.run"), example.status, NATIVE_TIMEOUT_MS,
    )
    strict_output: String ?= read_file(prefix.add(".strict.run.stdout"))
    _ ?= expect(strict_output, example.stdout, "strict native stdout")
    accounting: String ?= read_file(prefix.add(".strict.run.stderr"))
    expected = "blorp: leak check: ".add(example.allocations.to_string()).add(" allocs, ").add(example.allocations.to_string()).add(" releases, 0 leaked, 0 bytes\n")
    expect(accounting, expected, "strict native accounting")


private func verify_example(compiler: String, c_compiler: String, work_directory: String, example: Example) -> Result[Void, String]:
    prefix = work_directory.add("/").add(example.name)
    _ ?= compile_fixture(compiler, example.source, prefix)
    _ ?= link_fixture(c_compiler, prefix, NormalNative)
    _ ?= link_fixture(c_compiler, prefix, StrictNative)
    run_fixture(prefix, example)


private func rejected_fixture(compiler: String, work_directory: String) -> Result[Void, String]:
    source = work_directory.add("/rejected.brp")
    output = work_directory.add("/rejected.c")
    _ ?= write_file(source, "func start() -> Int:\n    0\n")
    _ ?= write_file(output, PRESERVED_OUTPUT)
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", compiler,
         "--library-root", LIBRARY_ROOT, source, output],
        work_directory.add("/rejected.compile"), 1, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_file(work_directory.add("/rejected.compile.stdout"))
    _ ?= expect(stdout, "", "rejected compiler stdout")
    stderr: String ?= read_file(work_directory.add("/rejected.compile.stderr"))
    diagnostic = source.add(":3:1: error: expected a main function\nhelp: declare func main() -> Int: as the entrypoint\n")
    _ ?= expect(stderr, diagnostic, "rejected compiler diagnostic")
    unchanged: String ?= read_file(output)
    expect(unchanged, PRESERVED_OUTPUT, "rejected output sentinel")


private func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_): True
        Err(error):
            print_error(error)
            False


func suite(compiler: String, c_compiler: String, work_directory: String) -> TestSuite:
    zero: Example = { name = "zero", source = "blorp_2/test/e2e/fixtures/return/zero.brp", status = 0, stdout = "", allocations = 0 }
    nonzero: Example = { name = "nonzero", source = "blorp_2/test/e2e/fixtures/return/23.brp", status = 23, stdout = "", allocations = 0 }
    text: Example = { name = "text", source = "blorp_2/test/e2e/fixtures/effects/hello.brp", status = 0, stdout = "Hello, World!\n", allocations = 1 }
    discard: Example = { name = "discard", source = "blorp_2/test/e2e/fixtures/result_propagation/discard.brp", status = 0, stdout = "once\nshared-value\n7\nerror-once\nkept-error\n", allocations = 9 }
    append_reuse: Example = { name = "append_reuse", source = "blorp_2/test/e2e/fixtures/list/append_reuse.brp", status = 0, stdout = "12\n0\n11\n12\n42 child\n42 child\n13\nnew\ntail\n12\n7\n13\nlast\ndone\n", allocations = 27 }
    update_reuse: Example = { name = "update_reuse", source = "blorp_2/test/e2e/fixtures/list/update_reuse.brp", status = 0, stdout = "42 child\n42 child\n7 replacement\n42 child\n2\n7 replacement\n42 child\n42 child\n7 replacement\n2\n42 child\n4\n7 replacement\n42 child\n2\n4\n42 child\n4\n42 child\ndone\n", allocations = 30 }
    literal: Example = { name = "literal", source = "blorp_2/test/e2e/fixtures/list/literal_int.brp", status = 0, stdout = "3\n1\n3\n", allocations = 4 }
    loop_entry: Example = { name = "loop_entry_accumulator", source = "blorp_2/test/e2e/fixtures/list/loop_entry_accumulator.brp", status = 0, stdout = "20\n0\n19\n4\n0\n2\n4\n6\n3\n00\n21\n012012012\n", allocations = 29 }
    branch: Example = { name = "branch_accumulator", source = "blorp_2/test/e2e/fixtures/list/branch_accumulator.brp", status = 0, stdout = "20\n0\n190\n5\n0\n1\n2\n2\n5\n2\nodd\n0003006\n5\n7\n", allocations = 33 }
    {
        description = "Self-hosted native e2e",
        tests = [
            ("zero exit and empty output", func(): reported(verify_example(compiler, c_compiler, work_directory, zero))),
            ("nonzero native exit is preserved", func(): reported(verify_example(compiler, c_compiler, work_directory, nonzero))),
            ("managed text stdout and strict accounting", func(): reported(verify_example(compiler, c_compiler, work_directory, text))),
            ("discard propagation preserves effects aliases and failures", func(): reported(verify_example(compiler, c_compiler, work_directory, discard))),
            ("List growth preserves snapshots managed children and nested values", func(): reported(verify_example(compiler, c_compiler, work_directory, append_reuse))),
            ("List set and concat preserve snapshots aliases invalid indices and nested values", func(): reported(verify_example(compiler, c_compiler, work_directory, update_reuse))),
            ("exact-sized List literal compiles without growth calls", func(): reported(verify_example(compiler, c_compiler, work_directory, literal))),
            ("inner-loop entry takes dying accumulators and preserves snapshots", func(): reported(verify_example(compiler, c_compiler, work_directory, loop_entry))),
            ("join arms take dying accumulators and preserve snapshots", func(): reported(verify_example(compiler, c_compiler, work_directory, branch))),
            ("rejected compilation preserves an existing output", func(): reported(rejected_fixture(compiler, work_directory))),
        ]
    }
