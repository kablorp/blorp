    ordering_order: Example = { name = "ordering_order", source = "blorp_2/test/e2e/fixtures/ordering/order.brp", status = 23, stdout = "left\nright\nleft\nright\nleft\nright\nleft\nright\n", allocations = 9 }
    ordering_nesting: Example = { name = "ordering_nesting", source = "blorp_2/test/e2e/fixtures/ordering/nesting.brp", status = 23, stdout = "", allocations = 1 }
    supertrait_entailment: Example = { name = "supertrait_entailment", source = "blorp_2/test/e2e/fixtures/supertraits/entailment.brp", status = 0, stdout = "1101\n0011\n0010\n1101\n0011\n0010\n1101\n", allocations = 16 }
