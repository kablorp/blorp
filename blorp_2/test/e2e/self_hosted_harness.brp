    {
        description = "Self-hosted native e2e",
        tests = [
            ("zero exit and empty output", func(): reported(verify_example(compiler, c_compiler, work_directory, zero))),
            ("nonzero native exit is preserved", func(): reported(verify_example(compiler, c_compiler, work_directory, nonzero))),
            ("managed text stdout and strict accounting", func(): reported(verify_example(compiler, c_compiler, work_directory, text))),
            ("discard propagation preserves effects aliases and failures", func(): reported(verify_example(compiler, c_compiler, work_directory, discard))),
            ("List growth preserves snapshots managed children and nested values", func(): reported(verify_example(compiler, c_compiler, work_directory, append_reuse))),
            ("List set and concat preserve snapshots aliases invalid indices and nested values", func(): reported(verify_example(compiler, c_compiler, work_directory, update_reuse))),
            ("exact-sized List literal compiles without growth calls", func(): reported(verify_example(compiler, c_compiler, work_directory, literal))),
            ("empty literals share an immortal root that updates copy and drops ignore", func(): reported(verify_example(compiler, c_compiler, work_directory, static_empty))),
            ("inner-loop entry takes dying accumulators and preserves snapshots", func(): reported(verify_example(compiler, c_compiler, work_directory, loop_entry))),
            ("join arms take dying accumulators and preserve snapshots", func(): reported(verify_example(compiler, c_compiler, work_directory, branch))),
            ("Int and Float order through Orderable, NaN comparing false", func(): reported(verify_example(compiler, c_compiler, work_directory, orderable))),
            ("Int, Float and String arithmetic dispatch through the arithmetic traits", func(): reported(verify_example(compiler, c_compiler, work_directory, arithmetic_traits))),
            ("each arithmetic operator calls its own canonical trait member", func(): reported(verify_example(compiler, c_compiler, work_directory, arithmetic_operators))),
            ("arithmetic operators evaluate operands once from left to right", func(): reported(verify_example(compiler, c_compiler, work_directory, arithmetic_order))),
            ("64 mixed-precedence arithmetic levels match ordinary calls under default limits", func(): reported(verify_example(compiler, c_compiler, work_directory, arithmetic_nesting))),
            ("a 2,000-term sum and a 2,000-part String join compile and run", func(): reported(verify_example(compiler, c_compiler, work_directory, arithmetic_long_sum))),
            ("each ordering operator calls its own canonical Orderable member", func(): reported(verify_example(compiler, c_compiler, work_directory, ordering_operators))),
            ("ordering operators evaluate operands once from left to right", func(): reported(verify_example(compiler, c_compiler, work_directory, ordering_order))),
            ("64 grouped ordering comparisons and ordinary calls compile under default limits", func(): reported(verify_example(compiler, c_compiler, work_directory, ordering_nesting))),
            ("an Ordered bound provides ==, equals and a default's supertrait call, dispatching a written Equatable", func(): reported(verify_example(compiler, c_compiler, work_directory, supertrait_entailment))),
            ("a bodyless Ring bundle provides both supertraits' methods on Int and a record", func(): reported(verify_example(compiler, c_compiler, work_directory, supertrait_bundle))),
            ("Box[Element: Ordered] entails its automatic equality's bound on Box[Box[Int]]", func(): reported(verify_example(compiler, c_compiler, work_directory, supertrait_generic_receiver))),
            ("stable Int-key sorting preserves managed aliases and chained keys", func(): reported(verify_example(compiler, c_compiler, work_directory, sort_by))),
            ("stable sort preserves every reversed element and nested owned aliases", func(): reported(verify_example(compiler, c_compiler, work_directory, sort_by_nested))),
            ("Float and user Orderable keys sort stably, and NaN keys still permute", func(): reported(verify_example(compiler, c_compiler, work_directory, sort_by_orderable))),
            ("take clamps counts and preserves exact prefix order", func(): reported(verify_example(compiler, c_compiler, work_directory, list_take_int))),
            ("remove checks bounds and shifts each surviving Int in order", func(): reported(verify_example(compiler, c_compiler, work_directory, list_remove_int))),
            ("take and remove preserve mortal repeated children and escaping aliases", func(): reported(verify_example(compiler, c_compiler, work_directory, list_take_remove_managed))),
            ("take and remove distinguish Void presence, Some empty and None", func(): reported(verify_example(compiler, c_compiler, work_directory, list_take_remove_void))),
            ("take and remove handle 256 elements and retain the input", func(): reported(verify_example(compiler, c_compiler, work_directory, list_take_remove_moderate))),
            ("take, drop, remove and reverse clamp all Int bounds and keep exact order", func(): reported(verify_example(compiler, c_compiler, work_directory, list_supplement_bounds))),
            ("find chooses the first match, and all handles empty, Void and forwarded predicates", func(): reported(verify_example(compiler, c_compiler, work_directory, list_supplement_predicates))),
            ("drop, reverse and find preserve escaped mortal payloads and nested aliases", func(): reported(verify_example(compiler, c_compiler, work_directory, list_supplement_managed))),
            ("List queries keep owned results and eager defaults", func(): reported(verify_example(compiler, c_compiler, work_directory, list_queries))),
            ("map, filter and any keep stable outputs and owned children", func(): reported(verify_example(compiler, c_compiler, work_directory, list_callbacks))),
            ("join keeps separators, order and managed aliases", func(): reported(verify_example(compiler, c_compiler, work_directory, list_join))),
            ("map, filter, reverse, take, drop, remove, any, all, find and sort_by agree at lengths 0 to 9", func(): reported(verify_example(compiler, c_compiler, work_directory, library_loops))),
            ("map, filter, reverse, sort_by and join of 4,096 elements allocate in proportion to the length", func(): reported(verify_example(compiler, c_compiler, work_directory, library_linear))),
            ("ordinary List take import reaches real main", func(): reported(verify_example(compiler, c_compiler, work_directory, list_import_take))),
            ("ordinary List drop import reaches real main", func(): reported(verify_example(compiler, c_compiler, work_directory, list_import_drop))),
            ("ordinary List remove import reaches real main", func(): reported(verify_example(compiler, c_compiler, work_directory, list_import_remove))),
            ("ordinary List reverse import reaches real main", func(): reported(verify_example(compiler, c_compiler, work_directory, list_import_reverse))),
            ("ordinary List find import reaches real main", func(): reported(verify_example(compiler, c_compiler, work_directory, list_import_find))),
            ("ordinary List all import reaches real main", func(): reported(verify_example(compiler, c_compiler, work_directory, list_import_all))),
            ("generic opaque wrap and unwrap, the CF-030 shape", func(): reported(verify_example(compiler, c_compiler, work_directory, opaque_wrap))),
            ("phantom opaque arguments are fixed by the expected type", func(): reported(verify_example(compiler, c_compiler, work_directory, opaque_phantom))),
            ("Box[Box[V]] at two types and in a declaration", func(): reported(verify_example(compiler, c_compiler, work_directory, opaque_nesting))),
            ("an empty generic opaque takes its argument from the result type", func(): reported(verify_example(compiler, c_compiler, work_directory, opaque_empty))),
            ("Id[Order] is not Id[User]", func(): reported(verify_rejection(compiler, work_directory, phantom_mismatch))),
            ("into_opaque Box([]) needs an expected type", func(): reported(verify_rejection(compiler, work_directory, empty_needs_type))),
            ("Box[V] has no representation fields", func(): reported(verify_rejection(compiler, work_directory, field_access))),
            ("Box[V] has no representation methods", func(): reported(verify_rejection(compiler, work_directory, method_access))),
            ("a generic opaque type needs its arguments", func(): reported(verify_rejection(compiler, work_directory, arity_missing))),
            ("a generic opaque type takes its declared argument count", func(): reported(verify_rejection(compiler, work_directory, arity_count))),
            ("a nongeneric opaque type takes no arguments", func(): reported(verify_rejection(compiler, work_directory, arity_nongeneric))),
            ("conversions take no written type arguments", func(): reported(verify_rejection(compiler, work_directory, explicit_arguments))),
            ("another module cannot wrap a generic opaque", func(): reported(verify_rejection(compiler, work_directory, foreign_wrap))),
            ("an opaque cycle with growing arguments is rejected", func(): reported(verify_rejection(compiler, work_directory, cycle_growing))),
            ("an opaque cycle through a generic record is rejected", func(): reported(verify_rejection(compiler, work_directory, cycle_record))),
            ("an opaque cycle through a List is rejected", func(): reported(verify_rejection(compiler, work_directory, cycle_list))),
            ("an opaque cycle through a phantom argument is rejected", func(): reported(verify_rejection(compiler, work_directory, cycle_phantom))),
            ("an opaque cycle through a callable type is rejected", func(): reported(verify_rejection(compiler, work_directory, cycle_callable))),
            ("a union stored by value through an applied opaque is a cycle", func(): reported(verify_rejection(compiler, work_directory, cycle_by_value))),
            ("each self payload through an applied opaque is by-value", func(): reported(verify_rejection(compiler, work_directory, cycle_two_self_payloads))),
            ("recursion that grows Box[V] is rejected", func(): reported(verify_rejection(compiler, work_directory, growing_recursion))),
            ("a generic opaque type's written equality and trait methods dispatch at each argument", func(): reported(verify_example(compiler, c_compiler, work_directory, opaque_trait))),
            ("fixed unions of numbers, records, opaques, Bool and fixed unions allocate nothing", func(): reported(verify_example(compiler, c_compiler, work_directory, fixed_union))),
            ("records holding Bool and fixed unions are inline and allocate nothing", func(): reported(verify_example(compiler, c_compiler, work_directory, fixed_record))),
            ("a literal evaluated in a loop creates its String once", func(): reported(verify_example(compiler, c_compiler, work_directory, literal_loop))),
            ("appending to a shared literal copies and leaves it intact", func(): reported(verify_example(compiler, c_compiler, work_directory, literal_append))),
            ("literals in constants closures records and Lists stay balanced", func(): reported(verify_example(compiler, c_compiler, work_directory, literal_indirect))),
            ("every in-place runtime helper is defined under the name its call uses", func(): reported(verify_example(compiler, c_compiler, work_directory, in_place))),
            ("owned loop accumulators grow in place and preserve the caller's value", func(): reported(verify_example(compiler, c_compiler, work_directory, owned_loop))),
            ("an early propagation exit retires a live owned parameter", func(): reported(verify_example(compiler, c_compiler, work_directory, owned_exit))),
            ("plain records declare, update and project like fixed records", func(): reported(verify_example(compiler, c_compiler, work_directory, plain_record))),
            ("the specialization index cannot be imported from its production module", func(): reported(verify_rejection(compiler, work_directory, private_specialization_index))),
            ("private applies to plain records and unions", func(): reported(verify_example(compiler, c_compiler, work_directory, plain_private))),
            ("a bounded opaque index over a bounded record runs with its restated key bounds", func(): reported(verify_example(compiler, c_compiler, work_directory, declaration_bounds))),
            ("a signature naming a bounded record restates the bound", func(): reported(verify_rejection(compiler, work_directory, unrestated_bound))),
            ("a record update projects before it rebuilds, so a dying base grows its field in place", func(): reported(verify_example(compiler, c_compiler, work_directory, record_accumulator))),
            ("grouped suites run in order and a failed suite fails the program", func(): reported(verify_suites(compiler, c_compiler, work_directory, grouped_suites, ["blorp_2/test/e2e/fixtures/test_entry/failing.brp"]))),
            ("the first suite alone passes", func(): reported(verify_suites(compiler, c_compiler, work_directory, single_suite, []))),
            ("rejected compilation preserves an existing output", func(): reported(rejected_fixture(compiler, work_directory))),
