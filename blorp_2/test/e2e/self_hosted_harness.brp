    supertrait_generic_receiver: Example = { name = "supertrait_generic_receiver", source = "blorp_2/test/e2e/fixtures/supertraits/generic_receiver.brp", status = 0, stdout = "10\n01\n10\n", allocations = 5 }
    sort_by: Example = { name = "sort_by", source = "blorp_2/test/e2e/fixtures/generic/managed/list_sort_by.brp", status = 0, stdout = "0\nonly\nonly\nA\nB\nC\nB\nC\nA\nA\nmin1\nmin2\nmax\na\nx\nzz\n2\né\0\nmiddle\nlater\n", allocations = 68 }
