import:
    process: run_to_files
    system: read_file, write_file
    io: print_error
    test: TestSuite
    ./self_hosted_reports: verify_accounting
    bool: not, and
    result: Result methods
    int: Int methods
    string: String methods


private ENVIRONMENT_TOOL: String = "/usr/bin/env"
private LIBRARY_ROOT: String = "blorp_2/standard_library"
-- Compilation includes C sanitizer linking; native fixtures should finish quickly.
private COMPILATION_TIMEOUT_MS: Int = 600000
private NATIVE_TIMEOUT_MS: Int = 10000
private PRESERVED_OUTPUT: String = "preserve this rejected output"


private union NativeMode:
    NormalNative
    StrictNative


private record Example {
    name: String,
    source: String,
    status: Int,
    stdout: String,
    allocations: Int
}


-- A fixture the compiler must reject with exactly this diagnostic text.
private record Rejection {
    name: String,
    source: String,
    diagnostic: String
}


private pure func expect(actual: String, expected: String, description: String) -> Result[Void, String]:
    if actual.equals(expected):
        Ok(void)
    else:
        Err(description + ": expected [" + expected + "], got [" + actual + "]")


private func command(arguments: List[String], prefix: String, expected_status: Int, timeout_ms: Int) -> Result[Void, String]:
    actual: Int ?= run_to_files(ENVIRONMENT_TOOL, arguments, prefix + ".stdout", prefix + ".stderr", timeout_ms).map_err(pure func(error: String): prefix + ": " + error)
    if actual.equals(expected_status):
        Ok(void)
    else:
        match read_file(prefix + ".stderr"):
            Ok(captured): Err(prefix + ": expected exit " + expected_status.to_string() + ", got " + actual.to_string() + ": " + captured)
            Err(error): Err(error)


-- `inputs` are the compiler arguments between the library root and the output.
private func compile_fixture(compiler: String, inputs: List[String], prefix: String) -> Result[Void, String]:
    _ ?= command(
        ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict", compiler,
         "--library-root", LIBRARY_ROOT].concat(inputs).concat([prefix + ".c"]),
        prefix + ".compile", 0, COMPILATION_TIMEOUT_MS,
    )
    output: String ?= read_file(prefix + ".compile.stdout")
    _ ?= expect(output, "", "compiler stdout")
    report: String ?= read_file(prefix + ".compile.stderr")
    _ ?= verify_accounting(report, True)
    generated: String ?= read_file(prefix + ".c")
    if generated.length().equals(0):
        Err("successful compilation emitted empty C")
    else:
        Ok(void)


private func link_fixture(c_compiler: String, prefix: String, mode: NativeMode) -> Result[Void, String]:
    (suffix, definition) = match mode:
        NormalNative: (".normal", "-DBLORP_MEMORY_DIAGNOSTICS=0")
        StrictNative: (".strict", "-DBLORP_MEMORY_DIAGNOSTICS=1")
    binary = prefix + suffix
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", c_compiler,
         "-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic", "-O0",
         "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
         definition,
         prefix + ".c", "-o", binary, "-lm", "-lpthread"],
        binary + ".link", 0, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_file(binary + ".link.stdout")
    _ ?= expect(stdout, "", "C compiler stdout")
    stderr: String ?= read_file(binary + ".link.stderr")
    expect(stderr, "", "C compiler stderr")


private func run_fixture(prefix: String, example: Example) -> Result[Void, String]:
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", prefix + ".normal"],
        prefix + ".normal.run", example.status, NATIVE_TIMEOUT_MS,
    )
    output: String ?= read_file(prefix + ".normal.run.stdout")
    _ ?= expect(output, example.stdout, "native stdout")
    errors: String ?= read_file(prefix + ".normal.run.stderr")
    _ ?= expect(errors, "", "native stderr")
    _ ?= command(
        ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict", prefix + ".strict"],
        prefix + ".strict.run", example.status, NATIVE_TIMEOUT_MS,
    )
    strict_output: String ?= read_file(prefix + ".strict.run.stdout")
    _ ?= expect(strict_output, example.stdout, "strict native stdout")
    accounting: String ?= read_file(prefix + ".strict.run.stderr")
    expected = ("blorp: leak check: " + example.allocations.to_string() + " allocs, ") + example.allocations.to_string() + " releases, 0 leaked, 0 bytes\n"
    expect(accounting, expected, "strict native accounting")


private func verify_example(compiler: String, c_compiler: String, work_directory: String, example: Example) -> Result[Void, String]:
    prefix = work_directory + "/" + example.name
    _ ?= compile_fixture(compiler, [example.source], prefix)
    _ ?= link_fixture(c_compiler, prefix, NormalNative)
    _ ?= link_fixture(c_compiler, prefix, StrictNative)
    run_fixture(prefix, example)


-- One `--test-suite` program: `example.source` is the first root, which owns
-- the entry, and `grouped` are the later roots in command-line order.
private func verify_suites(compiler: String, c_compiler: String, work_directory: String, example: Example, grouped: List[String]) -> Result[Void, String]:
    prefix = work_directory + "/" + example.name
    _ ?= compile_fixture(compiler, ["--test-suite", example.source].concat(grouped), prefix)
    _ ?= link_fixture(c_compiler, prefix, NormalNative)
    _ ?= link_fixture(c_compiler, prefix, StrictNative)
    run_fixture(prefix, example)


private func rejected_fixture(compiler: String, work_directory: String) -> Result[Void, String]:
    source = work_directory + "/rejected.brp"
    output = work_directory + "/rejected.c"
    _ ?= write_file(source, "func start() -> Int:\n    0\n")
    _ ?= write_file(output, PRESERVED_OUTPUT)
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", compiler,
         "--library-root", LIBRARY_ROOT, source, output],
        work_directory + "/rejected.compile", 1, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_file(work_directory + "/rejected.compile.stdout")
    _ ?= expect(stdout, "", "rejected compiler stdout")
    stderr: String ?= read_file(work_directory + "/rejected.compile.stderr")
    diagnostic = source + ":3:1: error: expected a main function\nhelp: declare func main() -> Int: as the entrypoint\n"
    _ ?= expect(stderr, diagnostic, "rejected compiler diagnostic")
    unchanged: String ?= read_file(output)
    expect(unchanged, PRESERVED_OUTPUT, "rejected output sentinel")


private func verify_rejection(compiler: String, work_directory: String, rejection: Rejection) -> Result[Void, String]:
    prefix = work_directory + "/" + rejection.name
    _ ?= command(
        ["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", compiler,
         "--library-root", LIBRARY_ROOT, rejection.source, prefix + ".c"],
        prefix + ".compile", 1, COMPILATION_TIMEOUT_MS,
    )
    stdout: String ?= read_file(prefix + ".compile.stdout")
    _ ?= expect(stdout, "", "rejected compiler stdout")
    stderr: String ?= read_file(prefix + ".compile.stderr")
    expect(stderr, rejection.source + rejection.diagnostic, "rejected compiler diagnostic")


private pure func generic_opaque(name: String, diagnostic: String) -> Rejection:
    { name = "opaque_" + name, source = "blorp_2/test/e2e/fixtures/opaque/generic/" + name + ".brp", diagnostic = diagnostic }


private RECURSIVE_AGGREGATE: String = " error: recursive aggregate types are not supported yet\nhelp: use finite record and union fields; recursion is supported through a record field, a List element or one direct self payload of a non-generic union, such as Next(Node)\n"


private RECURSIVE_OPAQUE: String = " error: recursive opaque representations are not supported yet\nhelp: wrap an independently recursive aggregate instead of referring back to the opaque type\n"


private func reported(result: Result[Void, String]) -> Bool:
    match result:
        Ok(_): True
        Err(error):
            print_error(error)
            False


func suite(compiler: String, c_compiler: String, work_directory: String) -> TestSuite:
    zero: Example = { name = "zero", source = "blorp_2/test/e2e/fixtures/return/zero.brp", status = 0, stdout = "", allocations = 0 }
    nonzero: Example = { name = "nonzero", source = "blorp_2/test/e2e/fixtures/return/23.brp", status = 23, stdout = "", allocations = 0 }
    text: Example = { name = "text", source = "blorp_2/test/e2e/fixtures/effects/hello.brp", status = 0, stdout = "Hello, World!\n", allocations = 1 }
    discard: Example = { name = "discard", source = "blorp_2/test/e2e/fixtures/result_propagation/discard.brp", status = 0, stdout = "once\nshared-value\n7\nerror-once\nkept-error\n", allocations = 12 }
    append_reuse: Example = { name = "append_reuse", source = "blorp_2/test/e2e/fixtures/list/append_reuse.brp", status = 0, stdout = "12\n0\n11\n12\n42 child\n42 child\n13\nnew\ntail\n12\n7\n13\nlast\ndone\n", allocations = 27 }
    update_reuse: Example = { name = "update_reuse", source = "blorp_2/test/e2e/fixtures/list/update_reuse.brp", status = 0, stdout = "42 child\n42 child\n7 replacement\n42 child\n2\n7 replacement\n42 child\n42 child\n7 replacement\n2\n42 child\n4\n7 replacement\n42 child\n2\n4\n42 child\n4\n42 child\ndone\n", allocations = 28 }
    literal: Example = { name = "literal", source = "blorp_2/test/e2e/fixtures/list/literal_int.brp", status = 0, stdout = "3\n1\n3\n", allocations = 4 }
    static_empty: Example = { name = "static_empty", source = "blorp_2/test/e2e/fixtures/list/static_empty.brp", status = 0, stdout = "1000\nfirst\n0\nfirst\n0\n5\nx\n0\n", allocations = 12 }
    loop_entry: Example = { name = "loop_entry_accumulator", source = "blorp_2/test/e2e/fixtures/list/loop_entry_accumulator.brp", status = 0, stdout = "20\n0\n19\n4\n0\n2\n4\n6\n3\n00\n21\n012012012\n", allocations = 29 }
    in_place: Example = { name = "every_in_place_helper", source = "blorp_2/test/e2e/fixtures/in_place/every_helper.brp", status = 0, stdout = "4\n6 and 7\n", allocations = 5 }
    owned_loop: Example = { name = "owned_loop_accumulator", source = "blorp_2/test/e2e/fixtures/owned_parameters/loop_accumulator.brp", status = 0, stdout = "4 from 7\n1 from 7\n5 from 0\n", allocations = 15 }
    owned_exit: Example = { name = "owned_propagation_exit", source = "blorp_2/test/e2e/fixtures/owned_parameters/propagation_exit.brp", status = 0, stdout = "ok 3\nnot a number: x\n2\nok 2\nnot a number: y\n", allocations = 17 }
    record_accumulator: Example = { name = "record_field_accumulator", source = "blorp_2/test/e2e/fixtures/record/update/field_accumulator.brp", status = 0, stdout = "5 items, count 4\n5 items, count 4\n5 items, count 0\n2 items, count 10\nnot a number: x\n2 items, count 1\n1 items, count 0\n2 items, count 10\nnot a number: x\n1 items, count 0\n", allocations = 65 }
    branch: Example = { name = "branch_accumulator", source = "blorp_2/test/e2e/fixtures/list/branch_accumulator.brp", status = 0, stdout = "20\n0\n190\n5\n0\n1\n2\n2\n5\n2\nodd\n0003006\n5\n7\n", allocations = 30 }
    opaque_wrap: Example = { name = "opaque_wrap", source = "blorp_2/test/e2e/fixtures/opaque/generic/wrap.brp", status = 2, stdout = "", allocations = 4 }
    opaque_phantom: Example = { name = "opaque_phantom", source = "blorp_2/test/e2e/fixtures/opaque/generic/phantom.brp", status = 7, stdout = "", allocations = 0 }
    opaque_nesting: Example = { name = "opaque_nesting", source = "blorp_2/test/e2e/fixtures/opaque/generic/nesting.brp", status = 15, stdout = "", allocations = 21 }
    passing_suite_output = "\n>> registration Tests\n  [PASS] pure\neffect\n  [PASS] effect\n\nAll 2 tests passed\n"
    failing_suite_output = "\n>> continued registration Tests\nfirst\n  [FAIL] first case\nsecond\n  [PASS] second case\nthird\n  [FAIL] third case\n\n2 of 3 tests failed\n"
    grouped_suites: Example = { name = "grouped_suites", source = "blorp_2/test/e2e/fixtures/test_entry/passing.brp", status = 1, stdout = passing_suite_output + failing_suite_output, allocations = 42 }
    single_suite: Example = { grouped_suites | name = "single_suite", status = 0, stdout = passing_suite_output, allocations = 21 }
    opaque_empty: Example = { name = "opaque_empty", source = "blorp_2/test/e2e/fixtures/opaque/generic/empty.brp", status = 5, stdout = "", allocations = 0 }
    phantom_mismatch = generic_opaque("phantom_mismatch", ":9:5: error: argument type does not match the parameter type\nhelp: use an expression of type Id[User] here\n")
    empty_needs_type = generic_opaque("empty_needs_type", ":3:11: error: cannot infer type parameter V of opaque type Box\nhelp: give into_opaque an expected type, as in value: Box[...] = into_opaque Box(...), or give from_opaque an operand whose Box type is known\n")
    field_access = generic_opaque("field_access", ":4:9: error: field access requires a record value\nhelp: read a declared record field, or use parentheses for a UFCS function call\n")
    method_access = generic_opaque("method_access", ":5:9: error: argument type does not match the parameter type\nhelp: use an expression of type List[Int] here\n")
    arity_missing = generic_opaque("arity_missing", ":2:18: error: generic opaque type requires one type argument\nhelp: write a concrete or symbolic application, such as Box[Int] or Box[T]\n")
    arity_count = generic_opaque("arity_count", ":2:18: error: opaque type argument count does not match its declaration\nhelp: expected 1 type arguments, got 2; supply types in declaration order\n")
    arity_nongeneric = generic_opaque("arity_nongeneric", ":2:19: error: ordinary opaque type does not accept a type argument\nhelp: remove the type argument from this opaque type\n")
    explicit_arguments = generic_opaque("explicit_arguments", ":3:20: error: opaque conversions take no type arguments\nhelp: write into_opaque Name(value) or from_opaque Name(value); the value and the expected type supply the arguments\n")
    foreign_wrap: Rejection = {
        name = "opaque_foreign",
        source = "blorp_2/test/e2e/fixtures/opaque/generic/foreign/main.brp",
        diagnostic = ":4:33: error: opaque values can be constructed only in their declaring module\nhelp: call a public constructor from the declaring module\n"
    }
    cycle_growing = generic_opaque("cycle_growing", ":3:20:" + RECURSIVE_OPAQUE)
    cycle_record = generic_opaque("cycle_record", ":1:21:" + RECURSIVE_OPAQUE)
    cycle_list = generic_opaque("cycle_list", ":1:20:" + RECURSIVE_OPAQUE)
    cycle_phantom = generic_opaque("cycle_phantom", ":2:20:" + RECURSIVE_OPAQUE)
    cycle_callable = generic_opaque("cycle_callable", ":1:20:" + RECURSIVE_OPAQUE)
    cycle_by_value = generic_opaque("cycle_by_value", ":3:7:" + RECURSIVE_AGGREGATE)
    cycle_two_self_payloads = generic_opaque("cycle_two_self_payloads", ":3:7:" + RECURSIVE_AGGREGATE)
    growing_recursion = generic_opaque("growing_recursion", ":5:16: error: recursive calls grow type arguments without bound\nhelp: pass recursive type arguments unchanged, permute them, or reset them to concrete types\n")
    opaque_trait: Example = { name = "opaque_trait", source = "blorp_2/test/e2e/fixtures/opaque/generic/trait.brp", status = 0, stdout = "10\n10\nbox of 1\nbox of box of 1\n", allocations = 28 }
    orderable: Example = { name = "orderable", source = "blorp_2/test/e2e/fixtures/orderable/int_float.brp", status = 0, stdout = "1010\n0011\n0101\n1010\n0011\n0011\n1010\n0000\n0000\n0000\n0011\n", allocations = 24 }
    arithmetic_traits: Example = { name = "arithmetic_traits", source = "blorp_2/test/e2e/fixtures/arithmetic/traits.brp", status = 0, stdout = "42\n-9223372036854775808\n9223372036854775807\n-42\n-3\n-1\n0\n0\n-9223372036854775808\n0\n-5\n-9223372036854775808\n3.75\n-1.5\n-3\n3.5\n-1.5\n0\n0\n0\n-2.5\n-inf\n-1\n1\nconcat\n12\nabababababababab\n", allocations = 31 }
    arithmetic_operators: Example = { name = "arithmetic_operators", source = "blorp_2/test/e2e/fixtures/arithmetic/operators.brp", status = 0, stdout = "9 5 14 3 1 -7\n-5 -9 -14 -3 -1 7\n9 5 14 3 1 -7\n9.5 5.5 15 3.75 1.5 -7.5\n-5.5 -9.5 -15 -3.75 -1.5 7.5\n9.5 5.5 15 3.75 1.5 -7.5\n-9223372036854775808 9223372036854775807 -2 -9223372036854775808\n0 0 0 0\n-9223372036854775808 0\n-0 -0 0\n5 2 14 -6 4\nab\nabab\nmarker 34\n", allocations = 115 }
    arithmetic_order: Example = { name = "arithmetic_order", source = "blorp_2/test/e2e/fixtures/arithmetic/order.brp", status = 23, stdout = "left\nright\nleft\nright\nleft\nright\nleft\nright\nleft\nright\noperand\n", allocations = 12 }
    arithmetic_nesting: Example = { name = "arithmetic_nesting", source = "blorp_2/test/e2e/fixtures/arithmetic/nesting.brp", status = 23, stdout = "", allocations = 1 }
    arithmetic_long_sum: Example = { name = "arithmetic_long_sum", source = "blorp_2/test/e2e/fixtures/arithmetic/long_sum.brp", status = 0, stdout = "2001000\n2000\n", allocations = 2003 }
