import:
	./cost: CostLimits
	./harness: run_source_example, run_output_example
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 145000,
	instructions = 500000000
}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 library Option and input",
		tests = [
			(
				"strict parse Int",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/parse_int.brp",
					42,
					LIMITS,
				),
			),
			("conversion uses foundation Option", func(): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/imported.brp",
					42,
					{
						allocations = 205000,
						instructions = 600000000
					},
				)),
			("32 flat result projections", func(): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/repeated.brp",
					42,
					{
						allocations = 170000,
						instructions = 550000000
					},
				)),
			("byte_at reads an unsigned UTF-8 byte", func(): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/byte_at.brp",
					169,
					{
						allocations = 205000,
						instructions = 600000000
					},
				)),
			("from_codepoint drops its Option and preserves the escaping String", func(): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/from_codepoint_ownership.brp",
					2,
					{
						allocations = 250000,
						instructions = 800000000
					},
				)),
			("byte_at distinguishes Some zero from None", func(): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/byte_at_zero.brp",
					0,
					{
						allocations = 205000,
						instructions = 600000000
					},
				)),
			("from_codepoint prints a counted NUL byte", func(): run_output_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/from_codepoint_nul.brp",
					"\0\n",
					{
						allocations = 250000,
						instructions = 800000000
					},
				)),
		]
	}
