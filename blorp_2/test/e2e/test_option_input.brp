import:
	./cost: CostLimits
	./harness: run_source_example
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 145000,
	instructions = 500000000
}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 library Option and input",
		tests = [
			(
				"strict parse Int",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/parse_int.brp",
					42,
					LIMITS,
				),
			),
			("conversion uses foundation Option", func(): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/imported.brp",
					42,
					{
						allocations = 205000,
						instructions = 600000000
					},
				)),
			("32 flat result projections", func(): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/option_input/repeated.brp",
					42,
					{
						allocations = 170000,
						instructions = 550000000
					},
				)),
		]
	}
