import:
	./harness: Example, native_case, verify_all, with_directory
	process: ProcessExit(Exited), command, run_command
	test: TestSuite


private func run_directory_example(compiler: String, fixture: String) -> Bool:
	with_directory(func(directory: String):
		physical ?= run_command({ command("/bin/pwd", ["-P"]) | cwd = Some(directory) }).map_err(pure func(error): error.to_string())
		match physical.exit:
			Exited(0):
				example: Example = {
					name = fixture, fixture = fixture, expected_c = None,
					first_case = { native_case("root directory", "", 0, "/\n") | cwd = Some("/") },
					remaining_cases = [{ native_case("temporary directory", "", 0, "") | cwd = Some(directory), stdout = physical.stdout }],
					limits = { allocations = 205000, instructions = 600000000 }
				}
				if physical.stderr != "".to_bytes():
					Err("physical-directory oracle wrote stderr")
				else:
					verify_all(compiler, directory, example)
			_: Err("physical-directory oracle failed")
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 current directory",
		tests = [
			("native Result reaches real main in two CWDs", func(): run_directory_example(compiler, "blorp_2/test/e2e/fixtures/current_directory/basic.brp")),
			("ignored Result and escaping String keep ownership", func(): run_directory_example(compiler, "blorp_2/test/e2e/fixtures/current_directory/ownership.brp")),
		]
	}
