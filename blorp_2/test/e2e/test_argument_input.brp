import:
	./cost: CostLimits
	./harness: argv_case, run_example
	list as Lists
	test: TestSuite


private BASIC_LIMITS: CostLimits = { allocations = 195000, instructions = 620000000 }

private ESCAPED_LIMITS: CostLimits = { allocations = 210000, instructions = 650000000 }

private STRESS_LIMITS: CostLimits = { allocations = 270000, instructions = 850000000 }


private func run_arguments(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "argument input",
			fixture = "blorp_2/test/e2e/fixtures/argument_input/basic.brp",
			expected_c = None,
			first_case = argv_case("no user arguments includes executable", [], 0, "1\nexecutable present\nmissing\nmissing\nmissing\nmissing\nmissing\nmissing\n"),
			remaining_cases = [
				argv_case("arguments retain order", ["first", "second"], 0, "3\nexecutable present\nfirst\nsecond\nmissing\nmissing\nmissing\nmissing\n"),
				argv_case("empty argument is present", ["", "second"], 0, "3\nexecutable present\n\nsecond\nmissing\nmissing\nmissing\nmissing\n"),
				argv_case("spaces and quotes stay within values", ["two words", "\"quoted\""], 0, "3\nexecutable present\ntwo words\n\"quoted\"\nmissing\nmissing\nmissing\nmissing\n"),
				argv_case("newline and CR are not stripped or split", ["line\nbreak", "carriage\rreturn"], 0, "3\nexecutable present\nline\nbreak\ncarriage\rreturn\nmissing\nmissing\nmissing\nmissing\n"),
				argv_case("Unicode stays in its original bytes", ["é🙂", "é"], 0, "3\nexecutable present\né🙂\né\nmissing\nmissing\nmissing\nmissing\n"),
				argv_case("one argument leaves the second absent", ["first"], 0, "2\nexecutable present\nfirst\nmissing\nmissing\nmissing\nmissing\nmissing\n"),
				argv_case("many arguments retain length and ordering", ["first", "second"].concat(Lists.repeat("extra", 254)), 0, "257\nexecutable present\nfirst\nsecond\nmissing\nmissing\nmissing\nmissing\n"),
				argv_case("long argument retains all bytes", ["x".repeat(65536)], 0, "2\nexecutable present\n" + "x".repeat(65536) + "\nmissing\nmissing\nmissing\nmissing\nmissing\n"),
			],
			limits = BASIC_LIMITS
		},
	)


private func run_escaped_string(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "returned List alias and escaped String",
			fixture = "blorp_2/test/e2e/fixtures/argument_input/escaped_string.brp",
			expected_c = None,
			first_case = argv_case("String remains owned after helper alias and first Option drop", ["kept é🙂", "unused"], 0, "kept é🙂\nkept é🙂\n"),
			remaining_cases = [
				argv_case("empty String survives a second lookup", [""], 0, "\n\n"),
				argv_case("missing String remains absent twice", [], 1, "missing\nmissing\n"),
				argv_case("unused argument ownership stress", ["kept"].concat(Lists.repeat("unused", 255)), 0, "kept\nkept\n"),
			],
			limits = ESCAPED_LIMITS
		},
	)


private func run_access_stress(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "64 argument accesses",
			fixture = "blorp_2/test/e2e/fixtures/argument_input/access_stress.brp",
			expected_c = None,
			first_case = argv_case("64 owned successful lookups preserve bytes", ["é🙂"], 0, "é🙂\n".repeat(64)),
			remaining_cases = [argv_case("64 absent lookups stay absent", [], 0, "missing\n".repeat(64))],
			limits = STRESS_LIMITS
		},
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 immutable process arguments",
		tests = [
			("argument length bytes ordering and bounds", func(): run_arguments(compiler)),
			("returned List aliases and escaped String ownership", func(): run_escaped_string(compiler)),
			("64 accesses compile within default C depth", func(): run_access_stress(compiler)),
		]
	}
