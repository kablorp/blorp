import:
	./cost: CostLimits
	./harness: run_accounted_example, TargetAllocations(PositiveTargetAllocations)
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 600000,
	instructions = 2000000000
}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 String interpolation",
		tests = [
			("holes preserve effects aliases UTF-8 and NUL", func(): run_accounted_example(
					compiler, "blorp_2/test/e2e/fixtures/interpolation/ordered.brp", 0,
					"first\nsecond\nbeginα\0middleωend\noriginal\nthird\none replacement\ntwo 42 1.5\ngeneric kept\nlambda kept\nliteral $" + "{kept} yes\nleft\0right\n", LIMITS, PositiveTargetAllocations, "build/interpolation-evidence/native/ordered.c")),
			("eight holes compile at default C limits", func(): run_accounted_example(
					compiler, "blorp_2/test/e2e/fixtures/interpolation/eight.brp", 0, "x".repeat(8) + "\n", LIMITS, PositiveTargetAllocations, "build/interpolation-evidence/native/eight.c")),
			("thirty two holes compile at default C limits", func(): run_accounted_example(
					compiler, "blorp_2/test/e2e/fixtures/interpolation/thirty_two.brp", 0, "x".repeat(32) + "\n", LIMITS, PositiveTargetAllocations, "build/interpolation-evidence/native/thirty_two.c")),
			("one hundred twenty eight holes compile at default C limits", func(): run_accounted_example(
					compiler, "blorp_2/test/e2e/fixtures/interpolation/one_hundred_twenty_eight.brp", 0, "x".repeat(128) + "\n", LIMITS, PositiveTargetAllocations, "build/interpolation-evidence/native/one_hundred_twenty_eight.c")),
		]
	}
