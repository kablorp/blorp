import:
	./cost: CostLimits
	./harness: argv_case, run_example
	test: TestSuite


private LIMITS: CostLimits = { allocations = 195000, instructions = 620000000 }


private func entry(
	compiler: String,
	fixture: String,
	empty_status: Int,
	argument_status: Int,
	empty_output: String,
	argument_output: String,
) -> Bool:
	run_example(
		compiler,
		{
			name = fixture,
			fixture = "blorp_2/test/e2e/fixtures/main/" + fixture + ".brp",
			expected_c = None,
			first_case = argv_case("no user arguments", [], empty_status, empty_output),
			remaining_cases = [argv_case("two user arguments", ["first", "second"], argument_status, argument_output)],
			limits = LIMITS
		},
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 main signature conventions",
		tests = [
			("impure Int without arguments", func(): entry(compiler, "int_nullary", 7, 7, "", "")),
			("pure Int without arguments", func(): entry(compiler, "pure_int_nullary", 7, 7, "", "")),
			("impure Int with arguments", func(): entry(compiler, "int_arguments", 1, 3, "", "")),
			("pure Int with arguments", func(): entry(compiler, "pure_int_arguments", 1, 3, "", "")),
			("Void evaluates then discards an Int result", func(): entry(compiler, "void_nullary", 0, 0, "number\n", "number\n")),
			("omitted return type discards an owned String", func(): entry(compiler, "implicit_void_nullary", 0, 0, "owned\n", "owned\n")),
			("Void discards an owned argument List", func(): entry(compiler, "void_arguments", 0, 0, "1\n", "3\n")),
			("omitted return type discards heterogeneous match results", func(): entry(compiler, "implicit_void_arguments", 0, 0, "", "first\n")),
		]
	}
