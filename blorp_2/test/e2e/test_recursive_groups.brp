import:
	./cost: CostLimits
	./harness: run_output_example
	test: TestSuite


-- Ordinary Contains is checked with the default library on every compile.
-- Only measured native fields carry this increment's revision; see
-- benchmarks/results/blorp_2_list_contains_2026-10-19.md.

-- Measured compile costs plus 15% (see the recursive layout group report).
private TREE_LIMITS: CostLimits = {
	allocations = 54000,
	instructions = 111100000
}

private GROUP_LIMITS: CostLimits = {
	allocations = 49000,
	instructions = 95000000
}

private LINKS_LIMITS: CostLimits = {
	allocations = 48000,
	instructions = 92700000
}

private BRANCHES_LIMITS: CostLimits = {
	allocations = 49000,
	instructions = 94000000
}

private LINKED_LIMITS: CostLimits = {
	allocations = 47000,
	instructions = 91000000
}

private KINDS_LIMITS: CostLimits = {
	allocations = 49000,
	instructions = 95600000
}

private FIXTURES: String = "blorp_2/test/e2e/fixtures/recursive/"


-- Each program builds a value of a layout group recursive through a record
-- field or a List element, walks it, and releases it through the group's
-- mutually recursive release helpers.
pure func suite(compiler: String) -> TestSuite:
	{
		description = "Recursive layout groups through records and Lists",
		tests = [
			("an Expr tree through a record, a union and a List is walked and released", func(): run_output_example(
				compiler, FIXTURES + "tree.brp", "17\n5\n", TREE_LIMITS,
			)),
			("a union-record-union group with a by-value back-reference runs", func(): run_output_example(
				compiler, FIXTURES + "group.brp", "10\n", GROUP_LIMITS,
			)),
			("a boxed self payload inside a record cycle is walked and released", func(): run_output_example(
				compiler, FIXTURES + "links.brp", "8\n", LINKS_LIMITS,
			)),
			("a record holding an Option of a union holding the record runs", func(): run_output_example(
				compiler, FIXTURES + "branches.brp", "7\n", BRANCHES_LIMITS,
			)),
			("a record linked through an Option of itself runs", func(): run_output_example(
				compiler, FIXTURES + "linked.brp", "6\n", LINKED_LIMITS,
			)),
			("an inline union storing a later boxed union of its group runs", func(): run_output_example(
				compiler, FIXTURES + "kinds.brp", "5\n", KINDS_LIMITS,
			)),
		]
	}
