import:
	cost: CostLimits
	harness: run_isolated, run_source_example, with_directory
	process: ProcessOutput
	system: read_file, write_file
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 20000,
	instructions = 200000000
}


private func verify_prelude_diagnostic(compiler: String, directory: String) -> Result[Void, String]:
	prelude = directory + "/prelude.brp"
	input = directory + "/main.brp"
	output = directory + "/program.c"
	written_prelude ?= write_file(prelude, "type Int = builtin\n")
	written_input ?= write_file(input, "func main() -> Int:\n\t0\n")
	written_output ?= write_file(output, "preserve output")
	result ?= run_isolated(
		compiler,
		[prelude, input, output],
	)
	retained ?= read_file(output)

	if (
		result.exit_code() == 1
		and result.stdout() == ""
		and result.stderr() == prelude + ":2:1: error: missing String builtin declaration\nhelp: add type String = builtin to the prelude\n"
		and retained == "preserve output"
	):
		Ok(void)
	else:
		Err("prelude errors must retain their source and preserve existing output")


func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 mortal Strings",
		tests = [
			("prelude diagnostic retains source and output", func():
				with_directory(
					func(directory: String): verify_prelude_diagnostic(compiler, directory),
				)
			),
			("conversion and borrowed length", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/mortal_string.brp",
					1,
					LIMITS,
				)
			),
			("unused String result returns zero", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/mortal_string_unused.brp",
					0,
					LIMITS,
				)
			),
			("owned return may alias borrowed argument", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/mortal_string_identity.brp",
					1,
					LIMITS,
				)
			),
			("reassignment preserves live original", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/mortal_string_alias.brp",
					2,
					LIMITS,
				)
			),
			("Int64 minimum conversion length", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/mortal_string_minimum.brp",
					20,
					LIMITS,
				)
			),
			("Int64 maximum conversion length", func():
				run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/mortal_string_maximum.brp",
					19,
					LIMITS,
				)
			),
		]
	}
