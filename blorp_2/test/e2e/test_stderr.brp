import:
	./harness: Example, native_case, verify_all, with_directory
	test: TestSuite


private func run_stderr(compiler: String, fixture: String, status: Int, expected: String) -> Bool:
	with_directory(func(directory: String):
		example: Example = {
			name = fixture, fixture = fixture, expected_c = None,
			first_case = { native_case("stderr bytes and real main", "", status, "") | stderr = expected.to_bytes() },
			remaining_cases = [], limits = { allocations = 205000, instructions = 600000000 }
		}
		verify_all(compiler, directory, example)
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 counted stderr output",
		tests = [
			("NUL multibyte LF and empty messages", func(): run_stderr(compiler, "blorp_2/test/e2e/fixtures/stderr/bytes.brp", 7, "line1\n\0é😀\n\n")),
			("live alias reassignment and selected arm", func(): run_stderr(compiler, "blorp_2/test/e2e/fixtures/stderr/alias.brp", 3, "old\nold\nnew\nnew\n")),
		]
	}
