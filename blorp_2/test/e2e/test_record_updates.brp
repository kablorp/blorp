import:
	../../src/utils/text: concat
	./cost: CostLimits
	./harness: run_output_example
	test: TestSuite


-- Ordinary Contains is checked with the default library on every compile.
-- Only measured native fields carry this increment's revision; see
-- benchmarks/results/blorp_2_list_contains_2026-10-19.md.

-- Normal-main smoke measurements use the same O0 compiler/target recipes as
-- this suite. These feature limits leave room for later bounded increments.
private ALIAS_LIMITS: CostLimits = { allocations = 47000, instructions = 150000000 }
private ORDER_LIMITS: CostLimits = { allocations = 48000, instructions = 180000000 }
private ESCAPE_LIMITS: CostLimits = { allocations = 51000, instructions = 150000000 }
-- Measured at 17,838 allocations and 77.2M instructions; about 30% headroom.
private REORDER_LIMITS: CostLimits = { allocations = 51000, instructions = 100000000 }
private FIXTURES: String = "blorp_2/test/e2e/fixtures/record/update/"


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Fresh record updates",
		tests = [
			("old alias retains its original text", func(): run_output_example(
				compiler, FIXTURES.concat("aliases.brp"), "42\n7\n", ALIAS_LIMITS,
			)),
			("base and reverse replacements execute once in order", func(): run_output_example(
				compiler, FIXTURES.concat("order.brp"), "base\ntext\nnumber\n7\n7\n", ORDER_LIMITS,
			)),
			("List and mortal String outlive updated parents", func(): run_output_example(
				compiler, FIXTURES.concat("escaped_children.brp"), "42\n2\n7\n", ESCAPE_LIMITS,
			)),
			-- Storage, and so ownership acquisition, follows written order, here
			-- out of declaration order for two managed fields.
			("managed replacements out of declaration order", func(): run_output_example(
				compiler, FIXTURES.concat("managed_reorder.brp"), "42\n7\n3\n1\n42\n2\n", REORDER_LIMITS,
			)),
		]
	}
