import:
	../../src/main: compile
	../../src/syntax: Span
	test: TestSuite


fixed record RejectedCase {
	description: String,
	source: String,
	message: String,
	span: Span
}


pure func verify_rejected(case: RejectedCase) -> Result[Void, String]:
	match compile(case.source):
		Ok(_):
			Err(case.description + ": invalid source was accepted")
		Err(diagnostic):
			if diagnostic.message != case.message:
				Err(
					case.description + ": expected '" + case.message + "', got '" + diagnostic.message + "'",
				)
			else if (
				diagnostic.span.start != case.span.start
				or diagnostic.span.end != case.span.end
			):
				Err(case.description + ": diagnostic span differed")
			else if diagnostic.help == "":
				Err(case.description + ": diagnostic must suggest a correction")
			else:
				Ok(void)


pure func verify_frontend() -> Result[Int, String]:
	header: String = "func main() -> Int:\n"
	accepted: List[String] = [
		header + "\t0\n",
		header + "    0",
		"func main ( ) -> Int :  \n\t0   \n",
	]
	var failure: Option[String] = None

	for source in accepted:
		match compile(source):
			Err(diagnostic):
				failure = Some("valid source rejected: " + diagnostic.message)
				break
			Ok(_):
				void

	accepted_result ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)

	length: Int = header.length()
	cases: List[RejectedCase] = [
		{
			description = "wrong entrypoint",
			source = "func start() -> Int:\n\t0\n",
			message = "expected exactly one main function",
			span = {
				start = 5,
				end = 10
			}
		},
		{
			description = "wrong return type",
			source = "func main() -> Bool:\n\t0\n",
			message = "expected Int as the main return type",
			span = {
				start = 15,
				end = 19
			}
		},
		{
			description = "parameter",
			source = "func main(arg) -> Int:\n\t0\n",
			message = "expected ')' with no parameters",
			span = {
				start = 10,
				end = 13
			}
		},
		{
			description = "missing body indent",
			source = header + "0\n",
			message = "expected an indent of one tab or four spaces",
			span = {
				start = length,
				end = length + 1
			}
		},
		{
			description = "three spaces",
			source = header + "   0\n",
			message = "expected an indent of one tab or four spaces",
			span = {
				start = length,
				end = length + 3
			}
		},
		{
			description = "five spaces",
			source = header + "     0\n",
			message = "expected an indent of one tab or four spaces",
			span = {
				start = length,
				end = length + 5
			}
		},
		{
			description = "mixed indent",
			source = header + "\t 0\n",
			message = "expected an indent of one tab or four spaces",
			span = {
				start = length,
				end = length + 1
			}
		},
		{
			description = "header indent",
			source = "    " + header + "\t0\n",
			message = "expected a function declaration at column 1",
			span = {
				start = 0,
				end = 4
			}
		},
		{
			description = "CRLF",
			source = "func main() -> Int:\r\n\t0\r\n",
			message = "only LF line endings are supported",
			span = {
				start = length - 1,
				end = length
			}
		},
		{
			description = "tab between tokens",
			source = "func\tmain() -> Int:\n\t0\n",
			message = "tabs are allowed only in the body indentation",
			span = {
				start = 4,
				end = 5
			}
		},
		{
			description = "joined keyword",
			source = "funcmain() -> Int:\n\t0\n",
			message = "expected a function declaration at column 1",
			span = {
				start = 0,
				end = 8
			}
		},
		{
			description = "leading blank line",
			source = "\n" + header + "\t0\n",
			message = "expected a function declaration at column 1",
			span = {
				start = 0,
				end = 1
			}
		},
		{
			description = "trailing blank line",
			source = header + "\t0\n\n",
			message = "unexpected input after the zero expression",
			span = {
				start = length + 3,
				end = length + 4
			}
		},
		{
			description = "second expression",
			source = header + "\t0\n\t0\n",
			message = "unexpected input after the zero expression",
			span = {
				start = length + 3,
				end = length + 4
			}
		},
		{
			description = "alternate zero spelling",
			source = header + "\t00\n",
			message = "only the integer literal 0 is supported",
			span = {
				start = length + 1,
				end = length + 3
			}
		},
		{
			description = "nonzero integer",
			source = header + "\t1\n",
			message = "only the integer literal 0 is supported",
			span = {
				start = length + 1,
				end = length + 2
			}
		},
		{
			description = "negative zero",
			source = header + "\t-0\n",
			message = "unsupported character",
			span = {
				start = length + 1,
				end = length + 2
			}
		},
		{
			description = "floating-point zero",
			source = header + "\t0.0\n",
			message = "unsupported character",
			span = {
				start = length + 2,
				end = length + 3
			}
		},
		{
			description = "non-ASCII body",
			source = header + "\té\n",
			message = "unsupported character",
			span = {
				start = length + 1,
				end = length + 2
			}
		},
		{
			description = "call expression",
			source = header + "\tprint()\n",
			message = "expected the integer literal 0",
			span = {
				start = length + 1,
				end = length + 6
			}
		},
		{
			description = "second declaration",
			source = header + "\t0\n" + header + "\t0\n",
			message = "unexpected input after the zero expression",
			span = {
				start = length + 3,
				end = length + 7
			}
		},
		{
			description = "missing return arrow",
			source = "func main() Int:\n\t0\n",
			message = "expected '->' before the return type",
			span = {
				start = 12,
				end = 15
			}
		},
		{
			description = "separated arrow characters",
			source = "func main() - > Int:\n\t0\n",
			message = "unsupported character",
			span = {
				start = 12,
				end = 13
			}
		},
		{
			description = "missing header colon",
			source = "func main() -> Int\n\t0\n",
			message = "expected ':' after the function header",
			span = {
				start = 18,
				end = 19
			}
		},
		{
			description = "same-line body",
			source = "func main() -> Int: 0",
			message = "expected a newline after the function header",
			span = {
				start = 20,
				end = 21
			}
		},
		{
			description = "empty input",
			source = "",
			message = "expected a function declaration at column 1",
			span = {
				start = 0,
				end = 0
			}
		},
		{
			description = "missing body",
			source = header,
			message = "expected an indent of one tab or four spaces",
			span = {
				start = length,
				end = length
			}
		},
		{
			description = "missing return value",
			source = header + "\t",
			message = "expected the integer literal 0",
			span = {
				start = length + 1,
				end = length + 1
			}
		},
	]

	for case in cases:
		match verify_rejected(case):
			Err(error):
				failure = Some(error)
				break
			Ok(_):
				void

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(accepted.length() + cases.length())


func test_frontend_grammar_and_diagnostics() -> Bool:
	match verify_frontend():
		Ok(_):
			True
		Err(error):
			print_error("FAIL: " + error)
			False


tests: TestSuite = {
	description = "Blorp 2 frontend",
	tests = [("grammar and located diagnostics", test_frontend_grammar_and_diagnostics)]
}
