import:
	../../src/main: compile
	harness: run_example
	test: TestSuite


pure func test_forward_call_returns_one() -> Bool:
	match compile("func main() -> Int:\n\tone()\nfunc one() -> Int:\n\t1\n"):
		Err(_):
			False
		Ok(output):
			output.contains("return blorp_f_1();") and output.contains("return INT64_C(1);")


func test_call_one_native_and_cost() -> Bool:
	run_example({
		name = "call_one",
		fixture = "blorp_2/test/e2e/fixtures/call_one.brp",
		expected_c = "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);int64_t blorp_f_0(void){return blorp_f_1();}int64_t blorp_f_1(void){return INT64_C(1);}int main(void){return (int)blorp_f_0();}\n",
		exit_status = 1,
		limits = {
			allocations = 300,
			instructions = 26000000
		},
	})


pure func test_call_resolves_after_reordering_declarations() -> Bool:
	match compile("func one() -> Int:\n\t1\nfunc main() -> Int:\n\tone()\n"):
		Err(_):
			False
		Ok(output):
			output == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);int64_t blorp_f_0(void){return INT64_C(1);}int64_t blorp_f_1(void){return blorp_f_0();}int main(void){return (int)blorp_f_1();}\n"


pure func test_written_names_do_not_become_c_symbols() -> Bool:
	match compile(
		"func main() -> Int:\n\tint()\nfunc int() -> Int:\n\tblorp_f_0()\nfunc blorp_f_0() -> Int:\n\t1\n",
	):
		Err(_):
			False
		Ok(output):
			output == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);int64_t blorp_f_2(void);int64_t blorp_f_0(void){return blorp_f_1();}int64_t blorp_f_1(void){return blorp_f_2();}int64_t blorp_f_2(void){return INT64_C(1);}int main(void){return (int)blorp_f_0();}\n"


tests: TestSuite = {
	description = "Blorp 2 function calls",
	tests = [
		("forward call returns one", test_forward_call_returns_one),
		("written names do not become C symbols", test_written_names_do_not_become_c_symbols),
		(
			"reordered declarations preserve call identity",
			test_call_resolves_after_reordering_declarations,
		),
		("call one native execution and compilation cost", test_call_one_native_and_cost),
	]
}
