import:
	../unit/compilation: compile
	harness: run_example
	test: TestSuite


pure func test_forward_call_returns_one() -> Bool:
	source: String =
		|func main() -> Int:
		|	one()
		|func one() -> Int:
		|	1
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			(
				output.contains("const int64_t blorp_vl_0=blorp_f_1();")
				and output.contains("const int64_t blorp_vl_0=INT64_C(1);")
			)


func test_call_one_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "call_one",
			fixture = "blorp_2/test/e2e/fixtures/call/one.brp",
			expected_c = Some(
				"#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=blorp_f_1();(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_1(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_0();}\n",
			),
			exit_status = 1,
			limits = {
				allocations = 1000,
				instructions = 40000000
			}
		},
	)


pure func test_call_resolves_after_reordering_declarations() -> Bool:
	source: String =
		|func one() -> Int:
		|	1
		|func main() -> Int:
		|	one()
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			output == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_1(void){const int64_t blorp_vl_0=blorp_f_0();(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_1();}\n"


pure func test_written_names_do_not_become_c_symbols() -> Bool:
	source: String =
		|func main() -> Int:
		|	int()
		|func int() -> Int:
		|	blorp_f_0()
		|func blorp_f_0() -> Int:
		|	1
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			output == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);int64_t blorp_f_2(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=blorp_f_1();(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_1(void){const int64_t blorp_vl_0=blorp_f_2();(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_2(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_0();}\n"


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 function calls",
		tests = [
			("forward call returns one", test_forward_call_returns_one),
			("written names do not become C symbols", test_written_names_do_not_become_c_symbols),
			(
				"reordered declarations preserve call identity",
				test_call_resolves_after_reordering_declarations,
			),
			(
				"call one native execution and compilation cost",
				func(): test_call_one_native_and_cost(compiler),
			),
		]
	}
