import:
	./cost: CostLimits
	./harness: run_output_example, run_source_example
	test: TestSuite


-- Normal-main O0 compilations measured for this increment; instructions retain
-- room for measurement variation. Shared-corpus feature ceilings are separate.
private ENTRY_LIMITS: CostLimits = { allocations = 20000, instructions = 100000000 }
private MORTAL_LIMITS: CostLimits = { allocations = 17500, instructions = 85000000 }
private NESTED_LIMITS: CostLimits = { allocations = 19000, instructions = 90000000 }
private PRESENCE_LIMITS: CostLimits = { allocations = 14000, instructions = 80000000 }
-- Fresh-result updates, measured 2026-10-15 with about 15% allocation and
-- 18% instruction headroom; the measurements are in the list intrinsics report.
private APPEND_INT_LIMITS: CostLimits = { allocations = 19800, instructions = 88000000 }
private APPEND_ENTRY_LIMITS: CostLimits = { allocations = 21800, instructions = 93000000 }
private APPEND_POINT_LIMITS: CostLimits = { allocations = 24400, instructions = 99000000 }
private SET_INT_LIMITS: CostLimits = { allocations = 23100, instructions = 96000000 }
private SET_ENTRY_LIMITS: CostLimits = { allocations = 23400, instructions = 97000000 }
private SET_POINT_LIMITS: CostLimits = { allocations = 23800, instructions = 97000000 }
private CONCAT_INT_LIMITS: CostLimits = { allocations = 21600, instructions = 92000000 }
private CONCAT_ENTRY_LIMITS: CostLimits = { allocations = 23700, instructions = 97000000 }
private CONCAT_POINT_LIMITS: CostLimits = { allocations = 25100, instructions = 100000000 }
private FIXTURES: String = "blorp_2/test/e2e/fixtures/list/"


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 generic owned Lists",
		tests = [
			("managed Entry escapes its List", func(): run_output_example(
				compiler, FIXTURES + "entries.brp", "7\nkept\n", ENTRY_LIMITS,
			)),
			("mortal String escapes List and Entry", func(): run_output_example(
				compiler, FIXTURES + "mortal_entry.brp", "42\n", MORTAL_LIMITS,
			)),
			("String escapes nested Lists", func(): run_output_example(
				compiler, FIXTURES + "nested.brp", "42\n", NESTED_LIMITS,
			)),
			("zero is a present Int element", func(): run_source_example(
				compiler, FIXTURES + "zero.brp", 0, PRESENCE_LIMITS,
			)),
			("Void is a present element", func(): run_source_example(
				compiler, FIXTURES + "void.brp", 7, PRESENCE_LIMITS,
			)),
			("empty String is a present element", func(): run_output_example(
				compiler, FIXTURES + "empty_string.brp", "\n", PRESENCE_LIMITS,
			)),
			("append grows empty and nonempty Int Lists", func(): run_output_example(
				compiler, FIXTURES + "append_int.brp", "0\n-1\n-1\n1\n7\n-1\n3\n7\n9\n", APPEND_INT_LIMITS,
			)),
			("append acquires a repeated managed Entry", func(): run_output_example(
				compiler, FIXTURES + "append_entries.brp", "2\n42\nmissing\n3\n42\n42\n4\n42\n42\n", APPEND_ENTRY_LIMITS,
			)),
			("append copies inline Points", func(): run_output_example(
				compiler, FIXTURES + "append_points.brp", "0\n-1\n-1\n1\n1\n-1\n3\n1\n6\n", APPEND_POINT_LIMITS,
			)),
			("set replaces in range and copies out of range", func(): run_output_example(
				compiler, FIXTURES + "set_int.brp", "3\n1\n1\n3\n7\n1\n3\n1\n9\n3\n1\n1\n3\n1\n1\n0\n-1\n-1\n", SET_INT_LIMITS,
			)),
			("set keeps old Entry aliases and surviving children", func(): run_output_example(
				compiler, FIXTURES + "set_entries.brp", "2\n42\n42\n2\n42\n7\n2\n42\n42\n2\n42\n42\n", SET_ENTRY_LIMITS,
			)),
			("set replaces an inline Point", func(): run_output_example(
				compiler, FIXTURES + "set_points.brp", "2\n1\n1\n2\n3\n1\n2\n1\n1\n", SET_POINT_LIMITS,
			)),
			("concat joins empty and nonempty Int Lists", func(): run_output_example(
				compiler, FIXTURES + "concat_int.brp", "2\n1\n-1\n2\n1\n-1\n5\n1\n2\n0\n-1\n-1\n", CONCAT_INT_LIMITS,
			)),
			("concat acquires Entries from both sides", func(): run_output_example(
				compiler, FIXTURES + "concat_entries.brp", "3\n42\n7\n4\n42\n42\n2\n42\nmissing\n", CONCAT_ENTRY_LIMITS,
			)),
			("concat copies inline Points", func(): run_output_example(
				compiler, FIXTURES + "concat_points.brp", "3\n1\n4\n2\n3\n-1\n1\n1\n-1\n", CONCAT_POINT_LIMITS,
			)),
		]
	}
