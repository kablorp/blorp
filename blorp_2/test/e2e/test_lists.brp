import:
	./cost: CostLimits
	./harness: run_output_example, run_source_example, run_accounted_example, verify_rejected_command, with_directory, TargetAllocations(PositiveTargetAllocations)
	test: TestSuite


-- Ordinary Contains is checked with the default library on every compile.
-- Only measured native fields carry this increment's revision; see
-- benchmarks/results/blorp_2_list_contains_2026-10-19.md.

-- Normal-main O0 compilations measured for this increment; instructions retain
-- room for measurement variation. Shared-corpus feature ceilings are separate.
-- Checked set adds 1,338–1,339 allocations to the affected existing cases.
-- ENTRY/MORTAL/PRESENCE/APPEND_INT include the approved +1,500 revision;
-- see benchmarks/results/blorp_2_list_set_names_2026-10-18.md.
private ENTRY_LIMITS: CostLimits = { allocations = 50000, instructions = 108000000 }
private MORTAL_LIMITS: CostLimits = { allocations = 48000, instructions = 93000000 }
private NESTED_LIMITS: CostLimits = { allocations = 49000, instructions = 98000000 }
private PRESENCE_LIMITS: CostLimits = { allocations = 45000, instructions = 91000000 }
-- Fresh-result updates, measured 2026-10-15 with about 15% allocation and
-- 18% instruction headroom; the measurements are in the list intrinsics report.
private APPEND_INT_LIMITS: CostLimits = { allocations = 50000, instructions = 107000000 }
private APPEND_ENTRY_LIMITS: CostLimits = { allocations = 51000, instructions = 101000000 }
private APPEND_POINT_LIMITS: CostLimits = { allocations = 54000, instructions = 107000000 }
private SET_INT_LIMITS: CostLimits = { allocations = 53000, instructions = 113000000 }
private SET_ENTRY_LIMITS: CostLimits = { allocations = 53000, instructions = 105000000 }
private SET_POINT_LIMITS: CostLimits = { allocations = 53000, instructions = 105000000 }
private CONCAT_INT_LIMITS: CostLimits = { allocations = 51000, instructions = 110000000 }
private CONCAT_ENTRY_LIMITS: CostLimits = { allocations = 53000, instructions = 105000000 }
private CONCAT_POINT_LIMITS: CostLimits = { allocations = 54000, instructions = 108000000 }
-- List literals, measured 2026-10-15 with the same headroom.
private LITERAL_INT_LIMITS: CostLimits = { allocations = 46000, instructions = 98000000 }
private LITERAL_ENTRY_LIMITS: CostLimits = { allocations = 49000, instructions = 98000000 }
private LITERAL_POINT_LIMITS: CostLimits = { allocations = 46000, instructions = 91000000 }
private LITERAL_EMPTY_LIMITS: CostLimits = { allocations = 46000, instructions = 99000000 }
private LITERAL_CALL_LIMITS: CostLimits = { allocations = 48000, instructions = 95000000 }
private LITERAL_NESTED_LIMITS: CostLimits = { allocations = 49000, instructions = 97000000 }
private CONTAINS_LIMITS: CostLimits = { allocations = 73000, instructions = 200000000 }
-- Initial 14-answer prototype: 206,411 allocations / 1,643,501,332 normal instructions.
-- Current 19-answer B sample: 211,742 allocations / 1,809,680,583 instructions.
-- These new-fixture caps and all existing fixture limits stay fixed.
private EQUATABLE_CONTAINS_LIMITS: CostLimits = { allocations = 250000, instructions = 2000000000 }
private CHECKED_SET_LIMITS: CostLimits = { allocations = 73000, instructions = 200000000 }
-- Prospective limits frozen before native execution; existing caps are unchanged.
private SUPPLEMENT_LIMITS: CostLimits = { allocations = 150000, instructions = 600000000 }
private FIXTURES: String = "blorp_2/test/e2e/fixtures/list/"


-- A rejected literal fixture: exit 1, empty stdout, the exact diagnostic on stderr.
private func rejected(compiler: String, fixture: String, location: String, message: String, help: String) -> Bool:
	input = FIXTURES + fixture + ".brp"
	expected = input + ":" + location + ": error: " + message + "\nhelp: " + help + "\n"
	with_directory(func(directory: String): verify_rejected_command(compiler, "blorp_2/standard_library", input, directory + "/rejected.c", expected))


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 generic owned Lists",
		tests = [
			("take clamps counts and preserves exact prefix order", func(): run_output_example(
				compiler, FIXTURES + "take_int.brp", "0\n-1\n-1\n-1\n-1\n-1\n0\n-1\n-1\n-1\n-1\n-1\n0\n-1\n-1\n-1\n-1\n-1\n1\n0\n-1\n-1\n-1\n-1\n3\n0\n10\n20\n-1\n-1\n4\n0\n10\n20\n30\n-1\n5\n0\n10\n20\n30\n40\n5\n0\n10\n20\n30\n40\n0\n-1\n-1\n-1\n-1\n-1\n5\n0\n10\n20\n30\n40\n", SUPPLEMENT_LIMITS,
			)),
			("remove checks bounds and shifts each surviving Int in order", func(): run_output_example(
				compiler, FIXTURES + "remove_int.brp", "none\nnone\nnone\nnone\nnone\n4\n10\n20\n30\n40\n-1\n4\n0\n10\n30\n40\n-1\n4\n0\n10\n20\n30\n-1\n0\n-1\n-1\n-1\n-1\n-1\n5\n0\n10\n20\n30\n40\n", SUPPLEMENT_LIMITS,
			)),
			("take/remove preserve mortal repeated children and escaping aliases", func(): run_output_example(
				compiler, FIXTURES + "take_remove_managed.brp", "3\n42é\0\n42é\0\n42é\0\n2\n42é\0\n42é\0\n42é\0\n2\n42é\0\n7\n42é\0\n2\n42é\0\n42é\0\n42é\0\n2\n42é\0\n7\n42é\0\n", SUPPLEMENT_LIMITS,
			)),
			("take/remove distinguish Void presence, Some empty and None", func(): run_output_example(
				compiler, FIXTURES + "take_remove_void.brp", "2\npresent\n2\npresent\n0\nempty\nnone\nnone\n0\nempty\n3\npresent\n", SUPPLEMENT_LIMITS,
			)),
			("balanced take/remove handle 256 elements and retain the input", func(): run_output_example(
				compiler, FIXTURES + "take_remove_moderate.brp", "255\n7\n7\n7\n-1\n255\n7\n7\n7\n-1\n255\n7\n7\n7\n-1\n256\n7\n", SUPPLEMENT_LIMITS,
			)),
			("List supplement clamps all Int bounds and preserves exact order", func(): run_output_example(
				compiler, FIXTURES + "supplement/bounds.brp", "[]|-9223372036854775808|9|[]|[]|none\n[]|-1|9|[]|[]|none\n[]|0|9|[]|[]|none\n[]|1|9|[]|[]|none\n[]|2|9|[]|[]|none\n[]|3|9|[]|[]|none\n[]|4|9|[]|[]|none\n[]|9223372036854775807|9|[]|[]|none\ntrue|none|[]\n[7]|-9223372036854775808|9|[]|[7]|none\n[7]|-1|9|[]|[7]|none\n[7]|0|7|[]|[7]|[]\n[7]|1|9|[7]|[]|none\n[7]|2|9|[7]|[]|none\n[7]|3|9|[7]|[]|none\n[7]|4|9|[7]|[]|none\n[7]|9223372036854775807|9|[7]|[]|none\nfalse|7|[7]\n[1,2,3]|-9223372036854775808|9|[]|[1,2,3]|none\n[1,2,3]|-1|9|[]|[1,2,3]|none\n[1,2,3]|0|1|[]|[1,2,3]|[2,3]\n[1,2,3]|1|2|[1]|[2,3]|[1,3]\n[1,2,3]|2|3|[1,2]|[3]|[1,2]\n[1,2,3]|3|9|[1,2,3]|[]|none\n[1,2,3]|4|9|[1,2,3]|[]|none\n[1,2,3]|9223372036854775807|9|[1,2,3]|[]|none\nfalse|3|[3,2,1]\n[5,4,3,2,1]\n", SUPPLEMENT_LIMITS,
			)),
			("find chooses the first match and all handles empty, Void and forwarded predicates", func(): run_output_example(
				compiler, FIXTURES + "supplement/predicates.brp", "8\n6\n6\nnone\n2\nnone\nnone\ntrue\ntrue\nfalse\ntrue\nfalse\nfalse\ntrue\nunit-some\nunit-none\nunit-none\ntrue\nfalse\ntrue\nunit-some\n2\n", SUPPLEMENT_LIMITS,
			)),
			("drop, reverse and find preserve escaped mortal payloads and nested aliases", func(): run_output_example(
				compiler, FIXTURES + "supplement/managed.brp", "42é\0:42é\0/3|7:7\n7:7|42é\0:42é\0/3|42é\0:42é\0/3\n42é\0:42é\0/3\n42é\0:42é\0/3|42é\0:42é\0/3|7:7\n42é\0:42é\0/3\n42é\0:42é\0/3|7:7\n7:7|42é\0:42é\0/3|42é\0:42é\0/3\n[]|[4]\n[]|[4]|[9é\0/2]\n[]|[4]|[9é\0/2]\n", SUPPLEMENT_LIMITS,
			)),
			("ordinary List get_or import reaches real main", func(): run_source_example(
				compiler, FIXTURES + "supplement/imports/get_or.brp", 7, SUPPLEMENT_LIMITS,
			)),
			("ordinary List is_empty import reaches real main", func(): run_source_example(
				compiler, FIXTURES + "supplement/imports/is_empty.brp", 0, SUPPLEMENT_LIMITS,
			)),
			("ordinary List last import reaches real main", func(): run_source_example(
				compiler, FIXTURES + "supplement/imports/last.brp", 7, SUPPLEMENT_LIMITS,
			)),
			("ordinary List take import reaches real main", func(): run_source_example(
				compiler, FIXTURES + "supplement/imports/take.brp", 1, SUPPLEMENT_LIMITS,
			)),
			("ordinary List remove import reaches real main", func(): run_source_example(
				compiler, FIXTURES + "supplement/imports/remove.brp", 0, SUPPLEMENT_LIMITS,
			)),
			("ordinary List drop import reaches real main", func(): run_source_example(
				compiler, FIXTURES + "supplement/imports/drop.brp", 0, SUPPLEMENT_LIMITS,
			)),
			("ordinary List find import reaches real main", func(): run_source_example(
				compiler, FIXTURES + "supplement/imports/find.brp", 7, SUPPLEMENT_LIMITS,
			)),
			("ordinary List all import reaches real main", func(): run_source_example(
				compiler, FIXTURES + "supplement/imports/all.brp", 0, SUPPLEMENT_LIMITS,
			)),
			("ordinary List reverse import reaches real main", func(): run_source_example(
				compiler, FIXTURES + "supplement/imports/reverse.brp", 1, SUPPLEMENT_LIMITS,
			)),
			("generic membership selects equality across values and stored references", func(): run_accounted_example(
				compiler, "blorp_2/standard_library", FIXTURES + "contains_equatable.brp", 23, "needle\n",
				EQUATABLE_CONTAINS_LIMITS, PositiveTargetAllocations, "build/traits-T5-library/native/membership.c",
			)),
			("List membership preserves generic aliases and predicate callbacks", func(): run_output_example(
				compiler, FIXTURES + "contains_int.brp",
				"false\ntrue\ntrue\nfalse\ntrue\nfalse\nneedle\ntrue\nfalse\ntrue\nfalse\ntrue\nfalse\ntrue\nfalse\n", CONTAINS_LIMITS,
			)),
			("set_index distinguishes bounds and preserves managed aliases", func(): run_output_example(
				compiler, FIXTURES + "checked_set.brp", "7\n2\n1\n9\nreplacement\nnone\nnone\nnone\nvoid-some\n42\n7\n42\n7\n42é\0\n7\n", CHECKED_SET_LIMITS,
			)),
			("managed Entry escapes its List", func(): run_output_example(
				compiler, FIXTURES + "entries.brp", "7\nkept\n", ENTRY_LIMITS,
			)),
			("mortal String escapes List and Entry", func(): run_output_example(
				compiler, FIXTURES + "mortal_entry.brp", "42\n", MORTAL_LIMITS,
			)),
			("String escapes nested Lists", func(): run_output_example(
				compiler, FIXTURES + "nested.brp", "42\n", NESTED_LIMITS,
			)),
			("zero is a present Int element", func(): run_source_example(
				compiler, FIXTURES + "zero.brp", 0, PRESENCE_LIMITS,
			)),
			("Void is a present element", func(): run_source_example(
				compiler, FIXTURES + "void.brp", 7, PRESENCE_LIMITS,
			)),
			("empty String is a present element", func(): run_output_example(
				compiler, FIXTURES + "empty_string.brp", "\n", PRESENCE_LIMITS,
			)),
			("append grows empty and nonempty Int Lists", func(): run_output_example(
				compiler, FIXTURES + "append_int.brp", "0\n-1\n-1\n1\n7\n-1\n3\n7\n9\n", APPEND_INT_LIMITS,
			)),
			("append acquires a repeated managed Entry", func(): run_output_example(
				compiler, FIXTURES + "append_entries.brp", "2\n42\nmissing\n3\n42\n42\n4\n42\n42\n", APPEND_ENTRY_LIMITS,
			)),
			("append copies inline Points", func(): run_output_example(
				compiler, FIXTURES + "append_points.brp", "0\n-1\n-1\n1\n1\n-1\n3\n1\n6\n", APPEND_POINT_LIMITS,
			)),
			("set replaces in range and preserves out-of-range values", func(): run_output_example(
				compiler, FIXTURES + "set_int.brp", "3\n1\n1\n3\n7\n1\n3\n1\n9\n3\n1\n1\n3\n1\n1\n0\n-1\n-1\n", SET_INT_LIMITS,
			)),
			("set preserves Entry aliases and surviving children", func(): run_output_example(
				compiler, FIXTURES + "set_entries.brp", "2\n42\n42\n2\n42\n7\n2\n42\n42\n2\n42\n42\n", SET_ENTRY_LIMITS,
			)),
			("set replaces an inline Point", func(): run_output_example(
				compiler, FIXTURES + "set_points.brp", "2\n1\n1\n2\n3\n1\n2\n1\n1\n", SET_POINT_LIMITS,
			)),
			("concat joins empty and nonempty Int Lists", func(): run_output_example(
				compiler, FIXTURES + "concat_int.brp", "2\n1\n-1\n2\n1\n-1\n5\n1\n2\n0\n-1\n-1\n", CONCAT_INT_LIMITS,
			)),
			("concat acquires Entries from both sides", func(): run_output_example(
				compiler, FIXTURES + "concat_entries.brp", "3\n42\n7\n4\n42\n42\n2\n42\nmissing\n", CONCAT_ENTRY_LIMITS,
			)),
			("concat copies inline Points", func(): run_output_example(
				compiler, FIXTURES + "concat_points.brp", "3\n1\n4\n2\n3\n-1\n1\n1\n-1\n", CONCAT_POINT_LIMITS,
			)),
			("Int literal is one root of three slots", func(): run_output_example(
				compiler, FIXTURES + "literal_int.brp", "3\n1\n3\n", LITERAL_INT_LIMITS,
			)),
			("managed literal acquires a repeated Entry twice", func(): run_output_example(
				compiler, FIXTURES + "literal_entries.brp", "2\n42\n42\n42\n", LITERAL_ENTRY_LIMITS,
			)),
			("literal element takes the expected record type", func(): run_output_example(
				compiler, FIXTURES + "literal_points.brp", "1\n2\n", LITERAL_POINT_LIMITS,
			)),
			("empty literal takes E from parameter, return and generic argument", func(): run_output_example(
				compiler, FIXTURES + "literal_empty.brp", "0\n0\n1\n", LITERAL_EMPTY_LIMITS,
			)),
			("literal feeds append, get and concat directly", func(): run_output_example(
				compiler, FIXTURES + "literal_calls.brp", "3\n7\n3\n", LITERAL_CALL_LIMITS,
			)),
			("nested empty literal takes its element from an earlier sibling", func(): run_output_example(
				compiler, FIXTURES + "literal_nested.brp", "3\n2\n0\n1\n", LITERAL_NESTED_LIMITS,
			)),
			("mixed element types are rejected at the second element", func(): rejected(
				compiler, "literal_mixed", "2:18", "list elements must have one type: element 2 is Float, element 1 is Int", "give every element the type Int",
			)),
			("empty literal without a List context is rejected", func(): rejected(
				compiler, "literal_empty_untyped", "2:14", "cannot infer the element type of an empty list literal", "give it a context with a List type, such as a List parameter, return type or append argument",
			)),
		]
	}
