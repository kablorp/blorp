import:
	./harness: verify_rejected_command, with_directory
	system: file_exists, getcwd, read_file, write_file
	test: TestSuite


private FIXTURES: String = "blorp_2/test/e2e/fixtures/names/"
private RENAME: String = "choose a different name for this binding"


private func rejected(compiler: String, fixture: String, location: String, message: String, help: String, note: String) -> Bool:
	with_directory(func(directory: String) -> Result[Void, String]:
		input = FIXTURES + fixture + ".brp"
		output = directory + "/rejected.c"
		expected = input + ":" + location + ": error: " + message + "\nhelp: " + help + "\n" + note
		missing ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, expected)
		unpublished ?= if file_exists(output):
			Err("invalid binding or pattern published C output")
		else:
			Ok(void)
		saved ?= write_file(output, "preserve binding output")
		existing ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, expected)
		actual ?= read_file(output)
		if actual == "preserve binding output":
			Ok(void)
		else:
			Err("invalid binding or pattern overwrote C output")
	)


private pure func prior(fixture: String, location: String) -> String:
	FIXTURES + fixture + ".brp:" + location + ": note: previous declaration or import here\n"


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Binding and constructor name rejections",
		tests = [
			("bare typo rejects without publishing C", func(): rejected(compiler, "typo", "7:9",
				"a bare name in a match arm is a constructor; use `_` to match anything",
				"use a visible constructor of the matched union, or write `_` and use the match's scrutinee in the arm", "",
			)),
			("parameter cannot hide a function", func(): rejected(compiler, "function_parameter", "3:15",
				"`helper` is already a function in this module", RENAME, prior("function_parameter", "1:11"),
			)),
			("local cannot hide a function", func(): rejected(compiler, "function_local", "4:5",
				"`helper` is already a function in this module", RENAME, prior("function_local", "1:11"),
			)),
			("var cannot hide a parameter", func(): rejected(compiler, "parameter_shadow", "2:9",
				"`value` is already a parameter in this function", RENAME, prior("parameter_shadow", "1:15"),
			)),
			("duplicate var keeps the first declaration note", func(): rejected(compiler, "duplicate_var", "3:9",
				"`value` is already a local in this function", RENAME, prior("duplicate_var", "2:9"),
			)),
			("bare constructor needs its import", func(): rejected(compiler, "unimported/main", "6:9",
				"Square is a constructor of Shape but is not imported",
				"import Square with its union: Shape(Square), from the module that declares Shape", getcwd() + "/" + prior("unimported/shapes", "3:5"),
			)),
			("nested constructor needs its import", func(): rejected(compiler, "unimported/nested", "7:15",
				"Square is a constructor of Shape but is not imported",
				"import Square with its union: Shape(Square), from the module that declares Shape", getcwd() + "/" + prior("unimported/shapes", "3:5"),
			)),
		]
	}
