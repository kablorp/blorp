import:
	cost: CostLimits
	harness: run_example
	test: TestSuite


-- Function-call architecture baseline: 107 allocations, 18,938,270 instructions.
-- Rounded ceilings allow startup variation; changes to them are reviewed.
private RETURN_ZERO_LIMITS: CostLimits = {
	allocations = 120,
	instructions = 22000000
}

private EXPECTED_C: String = "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){return INT64_C(0);}int main(void){return (int)blorp_f_0();}\n"


func test_return_zero_and_rejected_output() -> Bool:
	run_example({
		name = "return_zero",
		fixture = "blorp_2/test/e2e/fixtures/return_zero.brp",
		expected_c = EXPECTED_C,
		exit_status = 0,
		limits = RETURN_ZERO_LIMITS,
	})


tests: TestSuite = {
	description = "Blorp 2 native execution",
	tests = [("return zero and preserve rejected output", test_return_zero_and_rejected_output)]
}
