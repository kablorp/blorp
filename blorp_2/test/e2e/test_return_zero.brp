import:
	../../src/runtime/memory: MEMORY_RUNTIME
	./cost: CostLimits
	./harness: native_case, run_example, verify_rejected_input, with_directory
	test: TestSuite


-- Includes the mandatory base/default library scope; unused declarations emit no C.
-- Instructions include strict allocation diagnostics in the -O0 compiler.
private RETURN_ZERO_LIMITS: CostLimits = {
	allocations = 131100,
	instructions = 440000000
}


private RETURN_ZERO_C: String =
	|#include <stdint.h>
	|int64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return blorp_vl_0;}int main(void){blorp_memory_start();return blorp_memory_finish((int)blorp_f_0());}
	|


func test_return_zero(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "return_zero",
			fixture = "blorp_2/test/e2e/fixtures/return/zero.brp",
			expected_c = Some(MEMORY_RUNTIME + RETURN_ZERO_C),
			first_case = native_case("native output", "", 0, ""),
			remaining_cases = [],
			limits = RETURN_ZERO_LIMITS
		},
	)


func test_lexical_trivia(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "lexical_trivia",
			fixture = "blorp_2/test/e2e/fixtures/syntax/trivia.brp",
			expected_c = None,
			first_case = native_case("native output", "", 0, ""),
			remaining_cases = [],
			limits = {
				allocations = 132000,
				instructions = 440000000
			}
		},
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 native execution",
		tests = [
			("return zero", func(): test_return_zero(compiler)),
			("blank lines and comments", func(): test_lexical_trivia(compiler)),
			("rejected input preserves output", func():
				with_directory(func(directory: String): verify_rejected_input(compiler, directory))
			),
		]
	}
