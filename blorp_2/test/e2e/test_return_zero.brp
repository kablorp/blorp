import:
	cost: CostLimits
	harness: run_example, verify_rejected_input, with_directory
	test: TestSuite


-- Explicit prelude plus checked ownership: 623 allocations on return zero.
-- Instructions include strict allocation diagnostics in the -O0 compiler.
private RETURN_ZERO_LIMITS: CostLimits = {
	allocations = 800,
	instructions = 40000000
}

private EXPECTED_C: String = "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_0();}\n"


func test_return_zero(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "return_zero",
			fixture = "blorp_2/test/e2e/fixtures/return_zero.brp",
			expected_c = Some(EXPECTED_C),
			exit_status = 0,
			limits = RETURN_ZERO_LIMITS
		},
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 native execution",
		tests = [
			("return zero", func(): test_return_zero(compiler)),
			("rejected input preserves output", func():
				with_directory(func(directory: String): verify_rejected_input(compiler, directory))
			),
		]
	}
