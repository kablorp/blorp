import:
	./cost: CostLimits
	./harness: run_accounted_example, TargetAllocations(PositiveTargetAllocations)
	test: TestSuite


private TUPLE_LIMITS: CostLimits = {
	allocations = 140000,
	instructions = 500000000
}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 structural tuples",
		tests = [
			("triple reads first field through real main", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/tuple/triple.brp", 1, "", TUPLE_LIMITS,
				PositiveTargetAllocations, "build/tuple-evidence/native/triple.c",
			)),
			("two through four elements nest and specialize generically", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/tuple/values.brp", 0, "1\n2\n3\n4\n5\n3\n", TUPLE_LIMITS,
				PositiveTargetAllocations, "build/tuple-evidence/native/values.c",
			)),
			("Void preserves written effects and logical ordinals", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/tuple/void_order.brp", 0,
				"first\nnumber\nthird\n7\nlast!\nempty-first\nempty-second\ndone\n", TUPLE_LIMITS,
				PositiveTargetAllocations, "build/tuple-evidence/native/void_order.c",
			)),
			("nested patterns and flat declarations preserve managed values", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/tuple/patterns.brp", 0,
				"subject\nfirst!\nthird!\nleft!\nright!\nnested!\nlist!\nfirst!\nthird!\ntail\n", TUPLE_LIMITS,
				PositiveTargetAllocations, "build/tuple-evidence/native/patterns.c",
			)),
			("returned captures and for control flow retain tuples", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/tuple/loops_capture.brp", 0, "kept\nvalues\nfirst!\nthird!\n4\n", TUPLE_LIMITS,
				PositiveTargetAllocations, "build/tuple-evidence/native/loops_capture.c",
			)),
			("callable and List members survive aliases and destructuring", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/tuple/callable_members.brp", 0, "captured\ncaptured\ncaptured\ncaptured\n", TUPLE_LIMITS,
				PositiveTargetAllocations, "build/tuple-evidence/native/callable_members.c",
			)),
			("32 tuple levels compile at default C nesting limits", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/tuple/moderate_nested.brp", 0, "42\n", TUPLE_LIMITS,
				PositiveTargetAllocations, "build/tuple-evidence/native/moderate_nested.c",
			)),
		]
	}
