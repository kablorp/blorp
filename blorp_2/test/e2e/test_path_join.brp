import:
	./harness: Example, argv_case, native_case, verify_all, with_directory
	test: TestSuite


func verify_arguments(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "ordinary target path join",
		fixture = "blorp_2/test/e2e/fixtures/path_join/arguments.brp",
		expected_c = None,
		first_case = argv_case("absolute child replaces base", ["/library/base", "/module.brp"], 0, "/module.brp\n"),
		remaining_cases = [
			argv_case("absolute child preserves separator runs", ["ignored", "///module//file"], 0, "///module//file\n"),
			argv_case("empty base returns relative child", ["", "module.brp"], 0, "module.brp\n"),
			argv_case("two empty operands stay empty", ["", ""], 0, "\n"),
			argv_case("empty base returns absolute child", ["", "/module.brp"], 0, "/module.brp\n"),
			argv_case("empty child adds library prefix separator", ["/library", ""], 0, "/library/\n"),
			argv_case("empty child preserves existing separator", ["/library/", ""], 0, "/library/\n"),
			argv_case("root and empty child preserve root", ["/", ""], 0, "/\n"),
			argv_case("relative segments get one separator", ["directory", "module.brp"], 0, "directory/module.brp\n"),
			argv_case("existing separator is retained", ["directory/", "module.brp"], 0, "directory/module.brp\n"),
			argv_case("base separator runs stay lexical", ["directory///", "module.brp"], 0, "directory///module.brp\n"),
			argv_case("dot and parent components stay lexical", ["a/..", "./b"], 0, "a/.././b\n"),
			argv_case("backslash is ordinary content", ["a\\", "b"], 0, "a\\/b\n"),
			argv_case("multibyte operands preserve UTF-8", ["é/树", "🙂"], 0, "é/树/🙂\n"),
			argv_case("multibyte base trailing slash stays single", ["é/树/", "🙂"], 0, "é/树/🙂\n"),
			argv_case("combining spelling stays distinct", ["e\u{301}", "é"], 0, "e\u{301}/é\n"),
			argv_case("root with child preserves one separator", ["/", "child"], 0, "/child\n"),
			argv_case("empty child preserves separator run", ["a///", ""], 0, "a///\n"),
			argv_case("relative child punctuation stays lexical", ["base", ".././child//"], 0, "base/.././child//\n"),
		],
		limits = { allocations = 205000, instructions = 600000000 }
	}
	verify_all(compiler, directory, example)


func verify_counted_aliases(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "target path join counted NUL and aliases",
		fixture = "blorp_2/test/e2e/fixtures/path_join/counted_aliases.brp",
		expected_c = None,
		first_case = native_case("NUL decisions and surviving shared operands", "", 0,
			"a\0b/c\0d\na\0/b\n/a\0b\né\0part/é\0part\né\0part\né\0part\né\0part/\n"),
		remaining_cases = [],
		limits = { allocations = 205000, instructions = 600000000 }
	}
	verify_all(compiler, directory, example)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 ordinary pure target path join",
		tests = [
			("exact logical path edge table through real main", func(): with_directory(func(directory: String): verify_arguments(compiler, directory))),
			("counted NUL and aliased operands through real main", func(): with_directory(func(directory: String): verify_counted_aliases(compiler, directory))),
		]
	}
