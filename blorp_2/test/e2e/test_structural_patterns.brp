import:
	./harness: run_accounted_example, TargetAllocations(ZeroTargetAllocations, PositiveTargetAllocations)
	test: TestSuite


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 shared structural pattern inputs",
		tests = [
			("previous Or rejection executes its shared arm", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/pattern/previous_or_pattern.brp", 1, "",
				{ allocations = 140000, instructions = 500000000 },
				ZeroTargetAllocations, "build/source-patterns/native-subset01/artifacts/previous_or_pattern.c",
			)),
			("previous List rejection executes its head and rest pattern", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/pattern/previous_list_pattern.brp", 0, "",
				{ allocations = 140000, instructions = 500000000 },
				PositiveTargetAllocations, "build/source-patterns/native-subset01/artifacts/previous_list_pattern.c",
			)),
			("previous String rejection executes its exact literal arm", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/pattern/previous_string_pattern.brp", 1, "",
				{ allocations = 140000, instructions = 500000000 },
				PositiveTargetAllocations, "build/source-patterns/native-subset01/artifacts/previous_string_pattern.c",
			)),
			("different-ordinal managed alternatives enter one body", func(): run_accounted_example(
				compiler,
				"blorp_2/test/e2e/fixtures/pattern/alternative_inputs.brp", 0,
				"selected\nselected\nselected\né\0input\né\0input\né\0input\n",
				{ allocations = 140000, instructions = 500000000 },
				PositiveTargetAllocations, "build/source-patterns/native-subset01/artifacts/alternative_inputs.c",
			)),
			("nested constructors retain ordered fallthrough", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/pattern/nested_fallthrough.brp", 0,
				"é\0nested\né\0nested\ninner-none\nouter-none\n",
				{ allocations = 140000, instructions = 500000000 },
				PositiveTargetAllocations, "build/source-patterns/native-subset01/artifacts/nested_fallthrough.c",
			)),
			("List and nested alternatives evaluate source and body once", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/pattern/ordered_inputs.brp", 0,
				"source\nselected\né\0R\né\0R\nselected\né\0R\nempty\nnone\nnonempty\nmany\nnonempty\nmany\nnothing\nabsent\n",
				{ allocations = 140000, instructions = 500000000 },
				PositiveTargetAllocations, "build/source-patterns/native-subset01/artifacts/ordered_inputs.c",
			)),
			("rest captures own mortal aliases and empty suffixes", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/pattern/list_rest.brp", 0,
				"é\0tail\né\0tail\né\0tail\né\0tail\nhead\né\0tail\né\0tail\nempty\n",
				{ allocations = 140000, instructions = 500000000 },
				PositiveTargetAllocations, "build/source-patterns/native-subset01/artifacts/list_rest.c",
			)),
			("String patterns compare full UTF8 and NUL byte sequences", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/pattern/string_bytes.brp", 0,
				"exact\nexact\nshort\nother\nother\nempty\nother\n",
				{ allocations = 140000, instructions = 500000000 },
				PositiveTargetAllocations, "build/source-patterns/native-subset01/artifacts/string_bytes.c",
			)),
			("32 nested constructors select deep and fallback values", func(): run_accounted_example(
				compiler, "blorp_2/test/e2e/fixtures/pattern/moderate_nested.brp", 0, "42\n7\n0\n",
				{ allocations = 140000, instructions = 500000000 },
				PositiveTargetAllocations, "build/source-patterns/native-subset01/artifacts/moderate_nested.c",
			)),
		]
	}
