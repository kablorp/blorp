import:
	harness:
		Example,
		prepare_compiler,
		run_example,
		run_isolated,
		run_successfully,
		verify_rejected_command,
	process: exit_code, stderr, stdout
	system: file_exists, getenv, read_file, remove_dir, remove_file, temp_dir, write_file
	test: TestSuite


private FORTY_TWO: Example = {
	name = "return42",
	fixture = "blorp_2/test/e2e/fixtures/return_42.brp",
	expected_c = "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){return INT64_C(42);}int main(void){return (int)blorp_f_0();}\n",
	exit_status = 42,
	limits = {
		allocations = 230,
		instructions = 26000000
	}
}


func test_literal_returns_42() -> Bool:
	run_example(FORTY_TWO)


private func verify_driver(
	directory: String,
	name: String,
	source: String,
	status: Int,
) -> Result[Void, String]:
	path = directory + "/" + name
	written ?= write_file(path + ".c", source)
	linked ?= run_successfully(
		getenv("BLORP_CC").get_or("clang"),
		[
			"-std=c11",
			"-Wall",
			"-Wextra",
			"-Werror",
			"-pedantic",
			"-O2",
			"-fsanitize=undefined",
			"-fno-sanitize-recover=all",
			path + ".c",
			"-o",
			path,
		],
	)
	actual ?= run_isolated(path, [])

	if (
		actual.exit_code() == status
		and actual.stdout() == ""
		and actual.stderr() == ""
	):
		Ok(void)
	else:
		Err(
			"the independent Int64 endpoint driver returned an unexpected status or stream: " + actual.stderr(),
		)


private func verify_endpoints(directory: String, compiler: String) -> Result[Void, String]:
	compiled ?= run_successfully(
		compiler,
		["blorp_2/test/e2e/fixtures/integer_endpoints.brp", directory + "/program.c"],
	)
	program ?= read_file(directory + "/program.c")
	-- Rename only the emitted entrypoint. These independent comparisons never narrow Int64.
	driver = "#define main blorp_entrypoint_wrapper\n" + program + "#undef main\nint main(void){return blorp_f_0()==INT64_MIN && blorp_f_1()==INT64_MAX ? 0 : 1;}\n"
	verified ?= verify_driver(directory, "endpoints", driver, 0)
	wrong_value = driver.replace("return INT64_MIN;", "return INT64_C(0);")

	changed ?= if wrong_value == driver:
		Err("the endpoint fault proof did not change the emitted minimum")
	else:
		Ok(void)

	verify_driver(directory, "wrong-value", wrong_value, 1)


private func verify_range_rejection(directory: String, compiler: String) -> Result[Void, String]:
	input = directory + "/overflow.brp"
	output = directory + "/rejected.c"
	written ?= write_file(input, "func main() -> Int:\n\t9223372036854775808\n")
	expected = input + ":2:2: error: integer literal is outside the Int64 range\nhelp: use a value from -9223372036854775808 to 9223372036854775807\n"
	rejected_missing ?= verify_rejected_command(compiler, input, output, expected)

	unpublished ?= if file_exists(output):
		Err("an out-of-range literal published C")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve this output")
	rejected_existing ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)

	if actual == "preserve this output":
		Ok(void)
	else:
		Err("an out-of-range literal overwrote existing output")


private func verify_integer_contract(directory: String) -> Result[Void, String]:
	compilers ?= prepare_compiler()
	endpoints ?= verify_endpoints(directory, compilers.normal)
	verify_range_rejection(directory, compilers.normal)


func test_full_width_endpoints_and_rejected_range() -> Bool:
	match (
		run_successfully(
			"mktemp",
			["-d", temp_dir() + "/blorp-2-int64.XXXXXX"],
		)
	):
		Err(error):
			print_error(error)
			False
		Ok(temporary):
			directory = temporary
				.stdout()
				.trim()
			result = verify_integer_contract(directory)

			for name in [
				"program.c",
				"endpoints.c",
				"endpoints",
				"wrong-value.c",
				"wrong-value",
				"overflow.brp",
				"rejected.c",
			]:
				_ = remove_file(directory + "/" + name)

			_ = remove_dir(directory)

			match result:
				Ok(_):
					True
				Err(error):
					print_error(error)
					False


tests: TestSuite = {
	description = "Blorp 2 signed integer literals",
	tests = [
		("literal returns42", test_literal_returns_42),
		(
			"full-width endpoints, wrong-value fault proof and rejected range",
			test_full_width_endpoints_and_rejected_range,
		),
	]
}
