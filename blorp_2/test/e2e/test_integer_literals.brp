import:
	./cost: CostLimits
	./harness: Example, native_case, run_example, run_source_example, verify_rejected_command, with_directory
	system: file_exists, read_file, write_file
	test: TestSuite


private COMPANION_LIMITS: CostLimits = {
	allocations = 140000,
	instructions = 500000000
}

private pure func forty_two_example() -> Example:
	{
		name = "return42",
		fixture = "blorp_2/test/e2e/fixtures/return/42.brp",
		expected_c = None,
		first_case = native_case("native output", "", 42, ""),
		remaining_cases = [],
		limits = {
			allocations = 131100,
			instructions = 440000000
		}
	}


func test_literal_returns_42(compiler: String) -> Bool:
	run_example(compiler, forty_two_example())


private func verify_range_rejection(directory: String, compiler: String) -> Result[Void, String]:
	source: String =
		|func main() -> Int:
		|	9223372036854775808
		|
	input = directory + "/overflow.brp"
	output = directory + "/rejected.c"
	written ?= write_file(input, source)
	expected = input + ":2:2: error: integer literal is outside the Int64 range\nhelp: use a value from -9223372036854775808 to 9223372036854775807\n"
	rejected_missing ?= verify_rejected_command(compiler, input, output, expected)

	unpublished ?= if file_exists(output):
		Err("an out-of-range literal published C")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve this output")
	rejected_existing ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)

	if actual == "preserve this output":
		Ok(void)
	else:
		Err("an out-of-range literal overwrote existing output")


private func verify_integer_contract(compiler: String, directory: String) -> Result[Void, String]:
	verify_range_rejection(directory, compiler)


func test_rejected_integer_range(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_integer_contract(compiler, directory))


-- Exit status observes only the platform's low byte; phase tests pin Int64.
func test_minimum_source_runs_under_ubsan(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/integer/minimum.brp",
		0,
		COMPANION_LIMITS,
	)


-- Exit status observes only the platform's low byte; phase tests pin Int64.
func test_maximum_source_runs_under_ubsan(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/integer/maximum.brp",
		255,
		COMPANION_LIMITS,
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 signed integer literals",
		tests = [
			(
				"minimum source executes under UBSan",
				func(): test_minimum_source_runs_under_ubsan(compiler),
			),
			(
				"maximum source executes under UBSan",
				func(): test_maximum_source_runs_under_ubsan(compiler),
			),
			("literal returns42", func(): test_literal_returns_42(compiler)),
			(
				"rejected integer range preserves output",
				func(): test_rejected_integer_range(compiler),
			),
		]
	}
