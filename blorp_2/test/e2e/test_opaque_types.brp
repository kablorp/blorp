import:
	./harness: run_output_example, run_source_example
	test: TestSuite


func int_round_trip(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/opaque/int/main.brp",
		7,
		{ allocations = 42000, instructions = 140000000 },
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 ordinary opaque representations",
		tests = [
			("erased layouts reuse while named callback targets stay distinct", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/opaque/keys/main.brp", "7\n10\n7\n10\n11\n",
				{ allocations = 50000, instructions = 140000000 },
			)),
			("two-file opaque Int returns exactly seven", func(): int_round_trip(compiler)),
			("Float and Void preserve values and one operand effect", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/opaque/scalar/main.brp", "1.25\nunit\n",
				{ allocations = 44000, instructions = 140000000 },
			)),
			("inline records and unmanaged union preserve every value", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/opaque/inline/main.brp", "7\n9\n1.25\n3\n11\n",
				{ allocations = 48000, instructions = 180000000 },
			)),
			("private managed representations escape through public opaques", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/opaque/managed/main.brp", "42\n7\n42\n9\n7\n11\n42\né\0\né\0\n",
				{ allocations = 58000, instructions = 220000000 },
			)),
			("opaque List elements survive repeated storage and parent replacement", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/opaque/list/main.brp", "7\n9\n42\n42\n",
				{ allocations = 60000, instructions = 240000000 },
			)),
			("independent recursive records and boxed unions retain children", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/opaque/recursive/main.brp", "7\n2\n1\n0\n",
				{ allocations = 75000, instructions = 300000000 },
			)),
		]
	}
