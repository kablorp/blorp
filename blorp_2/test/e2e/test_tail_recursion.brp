import:
	cost: CostLimits
	harness: run_source_example
	test: TestSuite


private TAIL_RECURSION_LIMITS: CostLimits = {
	allocations = 10000,
	instructions = 100000000
}

private COUNTDOWN_LIMITS: CostLimits = {
	allocations = 100000,
	instructions = 500000000
}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Guaranteed self tail recursion",
		tests = [
			(
				"direct backedge",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/direct.brp",
					7,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"base arm",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/base.brp",
					9,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"swap preserves old left",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/swap_right.brp",
					7,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"swap preserves old right",
				func(

				): run_source_example(
					compiler,
