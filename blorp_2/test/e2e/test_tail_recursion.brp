import:
	./cost: CostLimits
	./harness: Example, argv_case, run_example, run_output_example, run_source_example
	test: TestSuite


private TAIL_RECURSION_LIMITS: CostLimits = {
	allocations = 140000,
	instructions = 500000000
}

private COUNTDOWN_LIMITS: CostLimits = {
	allocations = 230000,
	instructions = 900000000
}

-- Compilation cost is independent of the selected runtime iteration count.
private ACCUMULATOR_LIMITS: CostLimits = {
	allocations = 230000,
	instructions = 700000000
}


private pure func accumulator_example() -> Example:
	{
		name = "numeric tail-recursive accumulator",
		fixture = "blorp_2/test/e2e/fixtures/tail_recursion/accumulator.brp",
		expected_c = None,
		first_case = argv_case("one million exact iterations", [], 0, "1000000\n"),
		remaining_cases = [
			argv_case("zero iterations", ["0"], 0, "0\n"),
			argv_case("one iteration", ["1"], 0, "1\n"),
			argv_case("seventeen iterations", ["17"], 0, "17\n"),
		],
		limits = ACCUMULATOR_LIMITS
	}


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Guaranteed self tail recursion",
		tests = [
			("Int equality preserves signed 64-bit values", func(): run_output_example(
				compiler,
				"blorp_2/test/e2e/fixtures/int/equals.brp",
				"7\n",
				ACCUMULATOR_LIMITS,
			)),
			("numeric accumulator checks every tail iteration", func(): run_example(compiler, accumulator_example())),
			(
				"direct backedge",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/direct.brp",
					7,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"base arm",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/base.brp",
					9,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"swap preserves old left",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/swap_right.brp",
					7,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"swap preserves old right",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/swap_left.brp",
					9,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"duplicate operand",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/duplicates.brp",
					9,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"duplicate second operand",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/duplicates_right.brp",
					9,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"UFCS receiver chain",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/ufcs.brp",
					7,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"prefix recomputed each iteration",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/prefix.brp",
					7,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"arm aliases and var versions",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/arm_bindings.brp",
					7,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"updated arm variable",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/arm_current.brp",
					9,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"record argument",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/record.brp",
					9,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"union payload",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/payload.brp",
					42,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"helper may manage its own values",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/managed_helper.brp",
					1,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"borrow across two digit boundaries",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/carry_boundary.brp",
					7,
					TAIL_RECURSION_LIMITS,
				),
			),
			(
				"65535 backedges without stack growth",
				func(

				): run_source_example(
					compiler,
					"blorp_2/test/e2e/fixtures/tail_recursion/countdown.brp",
					7,
					COUNTDOWN_LIMITS,
				),
			),
		]
	}
