-- Test-only readers for the host runtime and macOS /usr/bin/time reports.
-- Required counters are errors when missing; explicitly disabled measurement is None.
union InstructionCheck:
	RequiredInstructions
	DisabledInstructions


record CompilationCost {
	allocations: Int,
	instructions: Option[Int]
}


record CostLimits {
	allocations: Int,
	instructions: Int
}


union ResourcePolicy:
	EnforceLimits
	RecordInitialBootstrapDebt
	RecordAllocationDebt


union ResourceVerdict:
	ResourceChecksPassed
	InitialBootstrapDebt(CompilationCost, CostLimits, String)
	AllocationDebt(CompilationCost, CostLimits, String)


pure func parse_resource_policy(setting: Option[String]) -> Result[ResourcePolicy, String]:
	match setting:
		None: Ok(EnforceLimits)
		Some("enforce-limits"): Ok(EnforceLimits)
		Some("record-initial-bootstrap-debt"): Ok(RecordInitialBootstrapDebt)
		Some("record-allocation-debt"): Ok(RecordAllocationDebt)
		Some(_):
			Err("BLORP_2_RESOURCE_POLICY must be 'enforce-limits', 'record-initial-bootstrap-debt' or 'record-allocation-debt'; unset it to enforce resource limits")


private ALLOCATION_PREFIX: String = "blorp: leak check: "

private INSTRUCTION_SUFFIX: String = " instructions retired"


pure func parse_instruction_check(setting: Option[String]) -> Result[InstructionCheck, String]:
	match setting:
		None: Ok(RequiredInstructions)
		Some("required"): Ok(RequiredInstructions)
		Some("disabled"): Ok(DisabledInstructions)
		Some(_):
			Err("BLORP_2_INSTRUCTION_CHECK must be 'required' or 'disabled'; unset it to require retired-instruction counters")


private pure func positive_count(text: String) -> Result[Int, String]:
	var decimal: Bool = text.length() > 0

	for position in 0..text.length():
		decimal = decimal and "0123456789".contains(text.substring(position, 1))

	if decimal:
		match text.parse_int():
			Some(count):
				if count > 0:
					Ok(count)
				else:
					Err("cost counter must be positive")
			None:
				Err("cost counter is outside Int range")
	else:
		Err("cost counter must contain decimal digits")


private pure func counter_field(text: String, suffix: String) -> Result[Int, String]:
	if text.ends_with(suffix):
		positive_count(text.substring(0, text.length() - suffix.length()))
	else:
		Err("missing cost counter field " + suffix)


pure func parse_allocations(report: String) -> Result[Int, String]:
	text: String = report.trim()

	if text.starts_with(ALLOCATION_PREFIX):
		fields: List[String] = text
			.substring(ALLOCATION_PREFIX.length(), text.length() - ALLOCATION_PREFIX.length())
			.split(", ")

		match fields:
			[allocated, released, "0 leaked", "0 bytes"]:
				allocations ?= counter_field(allocated, " allocs")
				releases ?= counter_field(released, " releases")

				if allocations == releases:
					Ok(allocations)
				else:
					Err("compiler allocation and release counters disagree")
			_:
				Err("expected one complete allocation report with no leaks")
	else:
		Err("missing compiler allocation report")


pure func parse_instructions(report: String) -> Result[Int, String]:
	var counters: List[String] = []

	for line in report.split("\n"):
		text: String = line.trim()

		if text.ends_with(INSTRUCTION_SUFFIX):
			counters = counters.append(
				text
					.substring(0, text.length() - INSTRUCTION_SUFFIX.length())
					.trim(),
			)

	match counters:
		[counter]:
			positive_count(counter)
		_:
			Err("expected exactly one retired-instruction counter from macOS /usr/bin/time -l")


pure func check_limits(cost: CompilationCost, limits: CostLimits) -> Result[Void, String]:
	if cost.allocations > limits.allocations:
		Err(
			"compiler allocations exceeded limit: " + "".append_int(
				cost.allocations,
			) + " > " + "".append_int(limits.allocations),
		)
	else:
		check_instruction_limit(cost, limits)


private pure func check_instruction_limit(cost: CompilationCost, limits: CostLimits) -> Result[Void, String]:
	match cost.instructions:
		Some(instructions):
			if instructions > limits.instructions:
				Err(
					"compiler retired instructions exceeded limit: " + "".append_int(
						instructions,
					) + " > " + "".append_int(limits.instructions),
				)
			else:
				Ok(void)
		None:
			Ok(void)


pure func assess_resource_limits(
	policy: ResourcePolicy,
	cost: CompilationCost,
	limits: CostLimits,
) -> Result[ResourceVerdict, String]:
	-- Allocation debt must never hide an instruction failure behind the
	-- strict checker's allocation-first diagnostic.
	instruction_checked ?= match policy:
		RecordAllocationDebt: check_instruction_limit(cost, limits)
		EnforceLimits | RecordInitialBootstrapDebt: Ok(void)
	match check_limits(cost, limits):
		Ok(_): Ok(ResourceChecksPassed)
		Err(error):
			match policy:
				EnforceLimits: Err(error)
				RecordInitialBootstrapDebt: Ok(InitialBootstrapDebt(cost, limits, error))
				RecordAllocationDebt: Ok(AllocationDebt(cost, limits, error))


pure func format_initial_bootstrap_debt(cost: CompilationCost, limits: CostLimits, reason: String) -> String:
	instructions = match cost.instructions:
		Some(count): count.to_string()
		None: "unmeasured"
	(
		"BLORP2_RESOURCE_RESULT status=FAIL policy=record-initial-bootstrap-debt allocations=" + cost.allocations.to_string()
		+ " allocation_limit=" + limits.allocations.to_string() + " instructions=" + instructions
		+ " instruction_limit=" + limits.instructions.to_string() + " reason=" + reason
	)


pure func format_allocation_debt(cost: CompilationCost, limits: CostLimits, reason: String) -> String:
	instructions = match cost.instructions:
		Some(count): count.to_string()
		None: "unmeasured"
	(
		"BLORP2_ALLOCATION_RESULT status=FAIL policy=record-allocation-debt allocations=" + cost.allocations.to_string()
		+ " allocation_limit=" + limits.allocations.to_string() + " instructions=" + instructions
		+ " instruction_limit=" + limits.instructions.to_string() + " reason=" + reason
	)


pure func format_cost(cost: CompilationCost, limits: CostLimits) -> String:
	instructions = match cost.instructions:
		Some(count): count.to_string() + "/" + limits.instructions.to_string()
		None: "disabled"
	"allocations=" + cost.allocations.to_string() + "/" + limits.allocations.to_string() + "; instructions=" + instructions
