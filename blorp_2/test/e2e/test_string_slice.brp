import:
	./harness: Example, argv_case, verify_all, with_directory, run_output_example
	test: TestSuite


private func run_bounds(compiler: String) -> Bool:
	with_directory(func(directory: String):
		example: Example = {
			library_root = "blorp_2/standard_library",
			name = "String slice bounds", fixture = "blorp_2/test/e2e/fixtures/string_slice/bounds.brp", expected_c = None,
			first_case = argv_case("whole", ["0", "9"], 0, "Aé🙂\0Z\n"),
			remaining_cases = [
				argv_case("multibyte", ["1", "7"], 0, "é🙂\n"),
				argv_case("counted NUL", ["7", "8"], 0, "\0\n"),
				argv_case("empty boundary", ["3", "3"], 0, "\n"),
				argv_case("empty end", ["9", "9"], 0, "\n"),
				argv_case("interior empty", ["2", "2"], 0, "none\n"),
				argv_case("interior start", ["2", "3"], 0, "none\n"),
				argv_case("interior end", ["1", "2"], 0, "none\n"),
				argv_case("reversed", ["7", "1"], 0, "none\n"),
				argv_case("past end", ["0", "10"], 0, "none\n"),
				argv_case("negative start", ["-1", "0"], 0, "none\n"),
				argv_case("negative end", ["0", "-1"], 0, "none\n"),
				argv_case("minimum", ["-9223372036854775808", "0"], 0, "none\n"),
				argv_case("maximum", ["0", "9223372036854775807"], 0, "none\n"),
				argv_case("wide start", ["4294967297", "4294967298"], 0, "none\n"),
				argv_case("wide end", ["0", "4294967297"], 0, "none\n"),
			],
			limits = { allocations = 25000, instructions = 90000000 }
		}
		verify_all(compiler, directory, example)
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 checked String slices",
		tests = [
			("runtime Int64 bounds and scalar boundaries reach real main", func(): run_bounds(compiler)),
			("exact counted bytes reach real main", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/string_slice/bytes.brp",
				"世\n🙂\n\u{80}\n\u{BF}\ne\u{301}\n\u{FEFF}\n\r\n\n\0\nnone\n",
				{ allocations = 35000, instructions = 120000000 },
			)),
			("source and Option aliases preserve payload lifetime", func(): run_output_example(
				compiler, "blorp_2/test/e2e/fixtures/string_slice/ownership.brp",
				"é🙂\né🙂\nAé🙂\0Z\né🙂\n", { allocations = 45000, instructions = 150000000 },
			)),
		]
	}
