import:
	./harness: run_source_example, verify_rejected_command, with_directory
	system: file_exists, getcwd, read_file, write_file
	test: TestSuite


private func example(compiler: String, directory: String, expected: Int) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/import/" + directory + "/main.brp",
		expected,
		{ allocations = 150000, instructions = 600000000 },
	)


private func rejected_field(compiler: String, directory: String) -> Result[Void, String]:
	root: String =
		|import:
		|    ./helper: take
		|func main() -> Int:
		|    take({ number = 42.to_string() })
		|
	helper: String =
		|fixed record Holder { number: Int }
		|pure func take(value: Holder) -> Int:
		|    value.number
		|
	input = directory + "/main.brp"
	output = directory + "/rejected.c"
	written_root ?= write_file(input, root)
	written_helper ?= write_file(directory + "/helper.brp", helper)
	expected = input + ":4:21: error: record field requires Int\nhelp: use an expression of type Int here\n" + directory + "/helper.brp:1:31: note: record field declared here\n"
	rejected ?= verify_rejected_command(compiler, input, output, expected)
	absent ?= if file_exists(output):
		Err("rejected module program created C")
	else:
		Ok(void)
	written_output ?= write_file(output, "preserve this output")
	rejected_again ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)
	if actual == "preserve this output":
		Ok(void)
	else:
		Err("rejected module program overwrote existing C")


private func rejected_example(compiler: String, directory: String, fixture: String, diagnostic: String) -> Result[Void, String]:
	input = "blorp_2/test/e2e/fixtures/import/" + fixture + ".brp"
	output = directory + "/rejected.c"
	checked ?= verify_rejected_command(compiler, input, output, input + diagnostic)
	if file_exists(output):
		Err("rejected import program created C")
	else:
		Ok(void)


-- The root keeps its command-line spelling; dependencies display their absolute
-- normalized paths, so the closing import is located in the absolute helper path.
private func rejected_cycle(compiler: String, directory: String) -> Result[Void, String]:
	root = "blorp_2/test/e2e/fixtures/import/cycle/main.brp"
	helper = getcwd() + "/blorp_2/test/e2e/fixtures/import/cycle/helper.brp"
	output = directory + "/rejected.c"
	expected = helper + ":2:2: error: import cycle: " + root + " -> " + helper + " -> " + root + "\nhelp: move the declarations both modules need into a third module that both import\n"
	checked ?= verify_rejected_command(compiler, root, output, expected)
	if file_exists(output):
		Err("rejected import cycle created C")
	else:
		Ok(void)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 local modules",
		tests = [
			("selective import executes", func(): example(compiler, "basic", 42)),
			("callee keeps its defining scope", func(): example(compiler, "home", 42)),
			("diamond shares one module", func(): example(compiler, "diamond", 42)),
			("dependency cycle is rejected at its closing import", func(): with_directory(func(directory: String): rejected_cycle(compiler, directory))),
			("foreign nominal value through generic UFCS", func(): example(compiler, "managed", 2)),
			("two independent method modules preserve type identity", func(): example(compiler, "method_modules", 42)),
			("forwarded constructors retain their declaration", func(): example(compiler, "forwarding", 42)),
			("helper module receives the default prelude", func(): example(compiler, "prelude_helper", 2)),
			("explicit base import overlaps the prelude", func(): example(compiler, "explicit_base", 42)),
			("same-named methods resolve by receiver type", func(): example(compiler, "receiver_types", 42)),
			("generic methods preserve managed values", func(): example(compiler, "generic_methods", 4)),
			("method-only exposure cannot be called directly", func(): with_directory(func(directory: String): rejected_example(compiler, directory, "method_modules/direct_rejected", ":5:5: error: unknown function\nhelp: declare the function locally or import it by name; type selections enable receiver calls only\n"))),
			("method-only selection needs exact visible type", func(): with_directory(func(directory: String): rejected_example(compiler, directory, "method_modules/missing_type", ":2:15: error: method receiver type is not independently visible\nhelp: import the exact type with an ordinary type selection before using methods_only\n"))),
			("default prelude exposes receiver calls only", func(): with_directory(func(directory: String): rejected_example(compiler, directory, "prelude_helper/direct_rejected", ":2:5: error: unknown function\nhelp: declare the function locally or import it by name; type selections enable receiver calls only\n"))),
			("cross-file field diagnostic preserves output", func(): with_directory(func(directory: String): rejected_field(compiler, directory))),
		]
	}
