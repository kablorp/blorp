import:
	./cost: CostLimits
	./harness: Example, native_case, run_source_example, verify_all, verify_rejected_command, with_directory
	system: file_exists, getcwd, read_file, write_file
	test: TestSuite

-- Ordinary Contains is checked with the default library on every compile.
-- Only measured native fields carry this increment's revision; see
-- benchmarks/results/blorp_2_list_contains_2026-10-19.md.

private func example(compiler: String, directory: String, expected: Int) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/import/" + directory + "/main.brp",
		expected,
		{ allocations = 150000, instructions = 600000000 },
	)


private func rejected_field(compiler: String, directory: String) -> Result[Void, String]:
	root: String =
		|import:
		|    ./helper: take
		|func main() -> Int:
		|    take({ number = 42.to_string() })
		|
	helper: String =
		|fixed record Holder { number: Int }
		|pure func take(value: Holder) -> Int:
		|    value.number
		|
	input = directory + "/main.brp"
	output = directory + "/rejected.c"
	written_root ?= write_file(input, root)
	written_helper ?= write_file(directory + "/helper.brp", helper)
	expected = input + ":4:21: error: record field requires Int\nhelp: use an expression of type Int here\n" + directory + "/helper.brp:1:31: note: record field declared here\n"
	rejected ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, expected)
	absent ?= if file_exists(output):
		Err("rejected module program created C")
	else:
		Ok(void)
	written_output ?= write_file(output, "preserve this output")
	rejected_again ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, expected)
	actual ?= read_file(output)
	if actual == "preserve this output":
		Ok(void)
	else:
		Err("rejected module program overwrote existing C")


private func rejected_example(compiler: String, directory: String, fixture: String, diagnostic: String) -> Result[Void, String]:
	input = "blorp_2/test/e2e/fixtures/import/" + fixture + ".brp"
	output = directory + "/rejected.c"
	checked ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, input + diagnostic)
	if file_exists(output):
		Err("rejected import program created C")
	else:
		Ok(void)


-- The root keeps its command-line spelling; dependencies display their absolute
-- normalized paths, so the closing import is located in the absolute helper path.
private func rejected_cycle(compiler: String, directory: String) -> Result[Void, String]:
	root = "blorp_2/test/e2e/fixtures/import/cycle/main.brp"
	helper = getcwd() + "/blorp_2/test/e2e/fixtures/import/cycle/helper.brp"
	output = directory + "/rejected.c"
	expected = helper + ":2:2: error: import cycle: " + root + " -> " + helper + " -> " + root + "\nhelp: move the declarations both modules need into a third module that both import\n"
	checked ?= verify_rejected_command(compiler, "blorp_2/standard_library", root, output, expected)
	if file_exists(output):
		Err("rejected import cycle created C")
	else:
		Ok(void)


-- Generated programs of CHAIN_MODULES modules. Under this harness's strict
-- leak check the namespace scopes commit measured the direct chain at 248 M
-- instructions and 79,774 allocations and the flat program at 132 M and
-- 27,515, where the program-wide namespace before it measured 528 M and 375 M.
-- Allocation ceilings also reject the old program-wide namespace when CI
-- disables instruction checks; the two workloads have independent oracles.
private CHAIN_MODULES: Int = 64
private DIRECT_CHAIN_LIMITS: CostLimits = { allocations = 110000, instructions = 300000000 }
private FLAT_LIMITS: CostLimits = { allocations = 60000, instructions = 160000000 }


private func written(directory: String, name: String, source: String) -> Bool:
	match write_file(directory + "/" + name, source):
		Ok(_): True
		Err(_): False


-- main calls m1, each module calls the next and selects Box from the last one,
-- which declares it.
private func write_direct_chain(directory: String) -> Bool:
	last = CHAIN_MODULES.to_string()
	var complete = written(directory, "main.brp", "import:\n    ./m1: f1\n    ./m" + last + ": Box(Pack)\nfunc main() -> Int:\n    match f1():\n        Pack(value): value\n")
	for position in 1..CHAIN_MODULES:
		next = (position + 1).to_string()
		body = "pure func f" + position.to_string() + "() -> Box:\n    match f" + next + "():\n        Pack(value): Pack(value)\n"
		imports = if next == last:
			"import:\n    ./m" + last + ": f" + last + ", Box(Pack)\n"
		else:
			"import:\n    ./m" + next + ": f" + next + "\n    ./m" + last + ": Box(Pack)\n"
		complete = complete and written(directory, "m" + position.to_string() + ".brp", imports + body)
	complete and written(directory, "m" + last + ".brp", "fixed union Box:\n    Pack(Int)\npure func f" + last + "() -> Box:\n    Pack(0)\n")


-- main selects one type from each module, each declaring its own.
private func write_flat(directory: String) -> Bool:
	var imports = "import:\n"
	var complete = True
	for position in 1..(CHAIN_MODULES + 1):
		number = position.to_string()
		imports = imports + "    ./m" + number + ": Type" + number + "\n"
		complete = complete and written(directory, "m" + number + ".brp", "fixed union Type" + number + "[T]:\n    Make" + number + "(T)\n")
	complete and written(directory, "main.brp", imports + "func main() -> Int:\n    0\n")


private func chain_within_ceiling(compiler: String, directory: String, name: String, complete: Bool, limits: CostLimits) -> Result[Void, String]:
	if complete:
		verify_all(compiler, directory, {
			name = name,
			library_root = "blorp_2/standard_library",
			fixture = directory + "/main.brp",
			expected_c = None,
			first_case = native_case("native output", "", 0, ""),
			remaining_cases = [],
			limits = limits
		})
	else:
		Err("could not write the generated " + name + " program")


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 local modules",
		tests = [
			("selective import executes", func(): example(compiler, "basic", 42)),
			("callee keeps its defining scope", func(): example(compiler, "home", 42)),
			("diamond shares one module", func(): example(compiler, "diamond", 42)),
			("dependency cycle is rejected at its closing import", func(): with_directory(func(directory: String): rejected_cycle(compiler, directory))),
			("foreign nominal value through generic UFCS", func(): example(compiler, "managed", 2)),
			("two independent method modules preserve type identity", func(): example(compiler, "method_modules", 42)),
			("methods_only reaches functions on a type imported elsewhere", func(): example(compiler, "forwarding", 42)),
			("a module does not reexport an imported union", func(): with_directory(func(directory: String): rejected_example(compiler, directory, "forwarding/facade", ":2:12: error: Box is imported by ./ops, not declared there\nhelp: import Box from the module that declares it, or write ./ops: Box methods_only to use the functions ./ops declares on Box\n" + getcwd() + "/blorp_2/test/e2e/fixtures/import/forwarding/box.brp:1:13: note: declared here\n"))),
			("helper module receives the default prelude", func(): example(compiler, "prelude_helper", 2)),
			("explicit base import overlaps the prelude", func(): example(compiler, "explicit_base", 42)),
			("same-named methods resolve by receiver type", func(): example(compiler, "receiver_types", 42)),
			("generic methods preserve managed values", func(): example(compiler, "generic_methods", 4)),
			("method-only exposure cannot be called directly", func(): with_directory(func(directory: String): rejected_example(compiler, directory, "method_modules/direct_rejected", ":5:5: error: unknown function\nhelp: declare the function locally or import it by name; type selections enable receiver calls only\n"))),
			("method-only selection needs exact visible type", func(): with_directory(func(directory: String): rejected_example(compiler, directory, "method_modules/missing_type", ":2:15: error: method receiver type is not independently visible\nhelp: import the exact type with an ordinary type selection before using methods_only\n"))),
			("default prelude exposes receiver calls only", func(): with_directory(func(directory: String): rejected_example(compiler, directory, "prelude_helper/direct_rejected", ":2:5: error: unknown function\nhelp: declare the function locally or import it by name; type selections enable receiver calls only\n"))),
			("cross-file field diagnostic preserves output", func(): with_directory(func(directory: String): rejected_field(compiler, directory))),
			("direct module chain stays within its cost ceiling", func(): with_directory(func(directory: String): chain_within_ceiling(compiler, directory, "direct chain", write_direct_chain(directory), DIRECT_CHAIN_LIMITS))),
			("flat modules stay within their cost ceiling", func(): with_directory(func(directory: String): chain_within_ceiling(compiler, directory, "flat modules", write_flat(directory), FLAT_LIMITS))),
		]
	}
