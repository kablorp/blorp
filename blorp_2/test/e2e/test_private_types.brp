import:
	./harness: verify_rejected_command, with_directory
	test: TestSuite


private func rejected(compiler: String, fixture: String, location: String, owner: String) -> Bool:
	input = "blorp_2/test/e2e/fixtures/private_type/" + fixture + ".brp"
	expected = (
		input + ":" + location + ": error: Secret is private but appears in public declaration " + owner
		+ "\nhelp: make Secret public, or make " + owner + " private\n"
	)
	with_directory(func(directory: String): verify_rejected_command(compiler, "blorp_2/standard_library", input, directory + "/rejected.c", expected))


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Private types in public declarations",
		tests = [
			("public parameter rejects private type", func(): rejected(compiler, "parameter", "2:25", "reveal")),
			("public nested return rejects private type", func(): rejected(compiler, "return", "2:30", "reveal")),
			("public record field rejects private type", func(): rejected(compiler, "record_field", "2:32", "Envelope")),
			("public union payload rejects private type", func(): rejected(compiler, "union_payload", "3:13", "Envelope")),
			("public nested argument rejects private type", func(): rejected(compiler, "nested", "2:37", "reveal")),
			("private head rejects before invalid arity", func(): rejected(compiler, "bad_arity", "2:25", "reveal")),
		]
	}
