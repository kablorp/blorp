import:
	./harness: run_isolated, run_source_example, verify_rejected_command, with_directory
	process: ProcessOutput
	system: read_file, write_file
	test: TestSuite


private func example(compiler: String, fixture: String, expected: Int) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/int/" + fixture + ".brp",
		expected,
		-- Includes reading the commented upstream source retained in the library.
		-- The default prelude loads all active operation modules.
		{ allocations = 155000, instructions = 550000000 },
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 target library Int addition",
		tests = [
			("imported addition", func(): example(compiler, "add", 42)),
			("imported UFCS addition", func(): example(compiler, "ufcs", 42)),
			("nested imported addition", func(): example(compiler, "nested", 42)),
			("negative addition", func(): example(compiler, "negative", 3)),
			("opposite signs cancel", func(): example(compiler, "cancel", 0)),
			("maximum wraps to negative signed limit", func(): example(compiler, "wrap_max", 20)),
			("minimum wraps to positive signed limit", func(): example(compiler, "wrap_min", 19)),
			("two minimum values wrap to one digit", func(): example(compiler, "wrap_twice", 1)),
			("missing library root preserves existing output", func(): with_directory(func(directory: String): missing_root(compiler, directory))),
			("malformed library root option teaches usage", func(): invalid_option(compiler, ["--library-root", "blorp_2/standard_library"])),
			("incomplete library root option does not read the flag as a file", func(): invalid_option(compiler, ["--library-root", "blorp_2/standard_library", "output.c"])),
			("incomplete test-suite option does not read the flag as a file", func(): invalid_option(compiler, ["--library-root", "blorp_2/standard_library", "--test-suite", "output.c"])),
		]
	}


private func missing_root(compiler: String, directory: String) -> Result[Void, String]:
	input = "blorp_2/test/e2e/fixtures/int/add.brp"
	output = directory + "/preserved.c"
	written ?= write_file(output, "preserve this output")
	expected = "blorp_2: error: expected a library root, input and output paths\nhelp: run blorp_2 --library-root DIRECTORY [--test-suite] INPUT.brp OUTPUT.c\n"
	actual_command ?= run_isolated(compiler, [input, output])
	rejected ?= if actual_command.exit_code() == 1 and actual_command.stdout() == "" and actual_command.stderr() == expected:
		Ok(void)
	else:
		Err("missing library-root option did not report CLI usage")
	actual ?= read_file(output)
	if actual == "preserve this output":
		Ok(void)
	else:
		Err("missing library root overwrote existing C output")


private func invalid_option(compiler: String, arguments: List[String]) -> Bool:
	match run_isolated(compiler, arguments):
		Err(_): False
		Ok(output):
			(output.exit_code() == 1 and output.stdout() == ""
				and output.stderr() == "blorp_2: error: expected a library root, input and output paths\nhelp: run blorp_2 --library-root DIRECTORY [--test-suite] INPUT.brp OUTPUT.c\n")
