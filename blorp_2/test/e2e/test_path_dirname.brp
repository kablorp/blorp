import:
	./harness: Example, argv_case, native_case, verify_all, with_directory
	test: TestSuite


private func verify_edges(compiler: String, directory: String) -> Result[Void, String]:
	example: Example = {
		name = "ordinary target lexical dirname",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/path_dirname/edges.brp", expected_c = None,
		first_case = argv_case("simple", ["/foo/bar/baz.txt"], 0, "/foo/bar\n"),
		remaining_cases = [
			argv_case("root child", ["/foo"], 0, "/\n"),
			argv_case("basename", ["file.txt"], 0, ".\n"),
			argv_case("one trailing slash", ["/foo/bar/"], 0, "/foo\n"),
			argv_case("trailing absolute run", ["/a///"], 0, "/\n"),
			argv_case("trailing relative run", ["a//b//"], 0, "a\n"),
			argv_case("preceding relative run", ["a///b"], 0, "a\n"),
			argv_case("preceding absolute run", ["/a///b"], 0, "/a\n"),
			argv_case("root one", ["/"], 0, "/\n"),
			argv_case("root two", ["//"], 0, "/\n"),
			argv_case("root three", ["///"], 0, "/\n"),
			argv_case("root four", ["////"], 0, "/\n"),
			argv_case("empty", [""], 0, ".\n"),
			argv_case("one component", ["name"], 0, ".\n"),
			argv_case("one component with run", ["name///"], 0, ".\n"),
			argv_case("interior runs", ["a//b/c"], 0, "a//b\n"),
			argv_case("leading and interior runs", ["///a//b///"], 0, "///a\n"),
			argv_case("parent component", ["a/.."], 0, "a\n"),
			argv_case("interior parent", ["a/../b"], 0, "a/..\n"),
			argv_case("relative parent", ["../x"], 0, "..\n"),
			argv_case("multibyte prefix", ["é/树/leaf///"], 0, "é/树\n"),
			argv_case("emoji prefix", ["🙂//é"], 0, "🙂\n"),
			argv_case("multibyte basename", ["é///"], 0, ".\n"),
			argv_case("Unicode prefix survives exact boundary", ["é/leaf"], 0, "é\n"),
			argv_case("ASCII prefix retains both bytes", ["ab/leaf"], 0, "ab\n"),
			native_case("NUL parents and surviving source/result aliases", "", 0,
				"a\0b\na\0b\n\0\né/树\né/树\né/树/leaf///\na\0b\n"),
		],
		limits = { allocations = 200000, instructions = 600000000 }
	}
	verify_all(compiler, directory, example)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 ordinary pure target dirname",
		tests = [
			("26 lexical, counted-NUL and ownership states through one fixture build", func(): with_directory(func(directory: String): verify_edges(compiler, directory))),
		]
	}
