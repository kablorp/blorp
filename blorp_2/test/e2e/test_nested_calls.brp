import:
	../unit/compilation: compile
	harness: run_example
	test: TestSuite


private EXPECTED_C: String = "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(int64_t blorp_p_0);int64_t blorp_f_2(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_1(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;return blorp_vl_0;}int64_t blorp_f_2(void){const int64_t blorp_vl_0=blorp_f_0();(void)blorp_vl_0;const int64_t blorp_vl_1=blorp_f_1(blorp_vl_0);(void)blorp_vl_1;return blorp_vl_1;}int main(void){return (int)blorp_f_2();}\n"

private ORDERED_C: String = "#include <stdint.h>\nint64_t blorp_f_0(int64_t blorp_p_0);int64_t blorp_f_1(int64_t blorp_p_0);int64_t blorp_f_2(void);int64_t blorp_f_0(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(0);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_1(int64_t blorp_p_0){const int64_t blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const int64_t blorp_vl_1=INT64_C(1);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_2(void){const int64_t blorp_vl_0=INT64_C(1);(void)blorp_vl_0;const int64_t blorp_vl_1=blorp_f_1(blorp_vl_0);(void)blorp_vl_1;const int64_t blorp_vl_2=blorp_f_0(blorp_vl_1);(void)blorp_vl_2;return blorp_vl_2;}int main(void){return (int)blorp_f_2();}\n"


pure func test_nested_calls_emit_resolved_int_parameter() -> Bool:
	source: String =
		|pure func one() -> Int:
		|	1
		|pure func identity(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	identity(one())
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			output == EXPECTED_C


func test_nested_calls_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "nested_calls",
			fixture = "blorp_2/test/e2e/fixtures/nested/calls.brp",
			expected_c = Some(EXPECTED_C),
			exit_status = 1,
			limits = {
				allocations = 1500,
				instructions = 40000000
			}
		},
	)


pure func test_wrappers_emit_inner_to_outer() -> Bool:
	source: String =
		|pure func zero(value: Int) -> Int:
		|	0
		|pure func one(value: Int) -> Int:
		|	1
		|func main() -> Int:
		|	zero(one(1))
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			output == ORDERED_C


func test_wrapper_order_native_and_cost(compiler: String) -> Bool:
	run_example(
		compiler,
		{
			name = "nested_order",
			fixture = "blorp_2/test/e2e/fixtures/nested/order.brp",
			expected_c = Some(ORDERED_C),
			exit_status = 0,
			limits = {
				allocations = 1700,
				instructions = 40000000
			}
		},
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 Int parameters and nested calls",
		tests = [
			("unary wrappers emit inner to outer", test_wrappers_emit_inner_to_outer),
			(
				"wrapper order and unused parameters execute natively",
				func(): test_wrapper_order_native_and_cost(compiler),
			),
			(
				"nested calls emit the resolved Int parameter",
				test_nested_calls_emit_resolved_int_parameter,
			),
			(
				"nested calls native execution and cost",
				func(): test_nested_calls_native_and_cost(compiler),
			),
		]
	}
