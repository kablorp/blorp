import:
	./cost: CostLimits
	./harness: Example, native_case, run_example, run_source_example, verify_rejected_command, with_directory
	system: file_exists, read_file, write_file
	test: TestSuite


private COMPANION_LIMITS: CostLimits = {
	allocations = 140000,
	instructions = 500000000
}

private pure func union_values_example() -> Example:
	{
		name = "union_values",
		library_root = "blorp_2/standard_library",
		fixture = "blorp_2/test/e2e/fixtures/union/values.brp",
		expected_c = None,
		first_case = native_case("native output", "", 0, ""),
		remaining_cases = [],
		limits = {
			allocations = 135000,
			instructions = 445000000
		}
	}


func test_union_native_and_cost(compiler: String) -> Bool:
	run_example(compiler, union_values_example())


private func verify_nominal_rejection(directory: String, compiler: String) -> Result[Void, String]:
	source: String =
		|fixed union Left:
		|	Same
		|fixed union Right:
		|	Matching
		|func take(value: Right) -> Int:
		|	0
		|func left() -> Left:
		|	Same
		|func main() -> Int:
		|	take(left())
		|
	input = directory + "/nominal.brp"
	output = directory + "/rejected.c"
	written ?= write_file(input, source)
	-- Both constructors have ordinal zero. C's enum conversion rules cannot
	-- establish the language's nominal type rule; the compiler must reject it.
	expected = input + ":10:2: error: argument type does not match the parameter type\nhelp: use an expression of type Right here\n"
	rejected_missing ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, expected)

	unpublished ?= if file_exists(output):
		Err("a nominal union mismatch published C")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve this output")
	rejected_existing ?= verify_rejected_command(compiler, "blorp_2/standard_library", input, output, expected)
	actual ?= read_file(output)

	if actual == "preserve this output":
		Ok(void)
	else:
		Err("a nominal union mismatch overwrote existing output")


private func verify_union_contract(compiler: String, directory: String) -> Result[Void, String]:
	verify_nominal_rejection(directory, compiler)


func test_rejected_cross_union_call(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_union_contract(compiler, directory))


func test_first_source_value(compiler: String) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/union/first.brp", 0, COMPANION_LIMITS)


func test_second_source_value(compiler: String) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/union/second.brp", 1, COMPANION_LIMITS)


func test_direct_source_value(compiler: String) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/union/direct.brp", 1, COMPANION_LIMITS)


func test_receiver_source_value(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/union/receiver.brp",
		0,
		COMPANION_LIMITS,
	)


func test_identity_source_value(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/union/identity.brp",
		1,
		COMPANION_LIMITS,
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 payload-free fixed unions",
		tests = [
			("first union source value", func(): test_first_source_value(compiler)),
			("second union source value", func(): test_second_source_value(compiler)),
			("direct union source value", func(): test_direct_source_value(compiler)),
			("receiver union source value", func(): test_receiver_source_value(compiler)),
			("identity union source value", func(): test_identity_source_value(compiler)),
			("union native execution and cost", func(): test_union_native_and_cost(compiler)),
			(
				"nominal union mismatch preserves output",
				func(): test_rejected_cross_union_call(compiler),
			),
		]
	}
