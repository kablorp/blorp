import:
	cost: CostLimits
	harness: Example, run_example, run_source_example, verify_rejected_command, with_directory
	system: file_exists, read_file, write_file
	test: TestSuite


private COMPANION_LIMITS: CostLimits = {
	allocations = 10000,
	instructions = 100000000
}

private UNION_VALUES: Example = {
	name = "union_values",
	fixture = "blorp_2/test/e2e/fixtures/union_values.brp",
	expected_c = Some(
		"#include <stdint.h>\nenum blorp_u_0{blorp_v_0_0,blorp_v_0_1};enum blorp_u_0 blorp_f_0(void);enum blorp_u_0 blorp_f_1(void);enum blorp_u_0 blorp_f_2(enum blorp_u_0 blorp_p_0);enum blorp_u_0 blorp_f_3(void);enum blorp_u_0 blorp_f_4(void);int64_t blorp_f_5(void);enum blorp_u_0 blorp_f_0(void){const enum blorp_u_0 blorp_vl_0=blorp_v_0_0;(void)blorp_vl_0;return blorp_vl_0;}enum blorp_u_0 blorp_f_1(void){const enum blorp_u_0 blorp_vl_0=blorp_v_0_1;(void)blorp_vl_0;return blorp_vl_0;}enum blorp_u_0 blorp_f_2(enum blorp_u_0 blorp_p_0){const enum blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;return blorp_vl_0;}enum blorp_u_0 blorp_f_3(void){const enum blorp_u_0 blorp_vl_0=blorp_v_0_1;(void)blorp_vl_0;const enum blorp_u_0 blorp_vl_1=blorp_f_2(blorp_vl_0);(void)blorp_vl_1;return blorp_vl_1;}enum blorp_u_0 blorp_f_4(void){const enum blorp_u_0 blorp_vl_0=blorp_v_0_0;(void)blorp_vl_0;const enum blorp_u_0 blorp_vl_1=blorp_f_2(blorp_vl_0);(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_5(void){const enum blorp_u_0 blorp_vl_0=blorp_f_0();(void)blorp_vl_0;const enum blorp_u_0 blorp_vl_1=blorp_f_1();(void)blorp_vl_1;const enum blorp_u_0 blorp_vl_2=blorp_f_2(blorp_vl_0);(void)blorp_vl_2;const enum blorp_u_0 blorp_vl_3=blorp_f_3();(void)blorp_vl_3;const enum blorp_u_0 blorp_vl_4=blorp_f_4();(void)blorp_vl_4;switch(blorp_vl_4){case blorp_v_0_0:{const int64_t blorp_vl_5=INT64_C(0);(void)blorp_vl_5;return blorp_vl_5;}case blorp_v_0_1:default:{const int64_t blorp_vl_6=INT64_C(1);(void)blorp_vl_6;return blorp_vl_6;}}}int main(void){return (int)blorp_f_5();}\n",
	),
	exit_status = 0,
	limits = {
		allocations = 2500,
		instructions = 40000000
	}
}


func test_union_native_and_cost(compiler: String) -> Bool:
	run_example(compiler, UNION_VALUES)


private func verify_nominal_rejection(directory: String, compiler: String) -> Result[Void, String]:
	input = directory + "/nominal.brp"
	output = directory + "/rejected.c"
	written ?= write_file(
		input,
		"fixed union Left:\n\tSame\nfixed union Right:\n\tSame\nfunc take(value: Right) -> Int:\n\t0\nfunc left() -> Left:\n\tSame\nfunc main() -> Int:\n\ttake(left())\n",
	)
	-- Both constructors have ordinal zero. C's enum conversion rules cannot
	-- establish the language's nominal type rule; the compiler must reject it.
	expected = input + ":10:2: error: argument type does not match the parameter type\nhelp: use an expression of type Right here\n"
	rejected_missing ?= verify_rejected_command(compiler, input, output, expected)

	unpublished ?= if file_exists(output):
		Err("a nominal union mismatch published C")
	else:
		Ok(void)

	sentinel ?= write_file(output, "preserve this output")
	rejected_existing ?= verify_rejected_command(compiler, input, output, expected)
	actual ?= read_file(output)

	if actual == "preserve this output":
		Ok(void)
	else:
		Err("a nominal union mismatch overwrote existing output")


private func verify_union_contract(compiler: String, directory: String) -> Result[Void, String]:
	verify_nominal_rejection(directory, compiler)


func test_rejected_cross_union_call(compiler: String) -> Bool:
	with_directory(func(directory: String): verify_union_contract(compiler, directory))


func test_first_source_value(compiler: String) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/union_first.brp", 0, COMPANION_LIMITS)


func test_second_source_value(compiler: String) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/union_second.brp", 1, COMPANION_LIMITS)


func test_direct_source_value(compiler: String) -> Bool:
	run_source_example(compiler, "blorp_2/test/e2e/fixtures/union_direct.brp", 1, COMPANION_LIMITS)


func test_receiver_source_value(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/union_receiver.brp",
		0,
		COMPANION_LIMITS,
	)


func test_identity_source_value(compiler: String) -> Bool:
	run_source_example(
		compiler,
		"blorp_2/test/e2e/fixtures/union_identity.brp",
		1,
		COMPANION_LIMITS,
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 payload-free fixed unions",
		tests = [
			("first union source value", func(): test_first_source_value(compiler)),
			("second union source value", func(): test_second_source_value(compiler)),
			("direct union source value", func(): test_direct_source_value(compiler)),
			("receiver union source value", func(): test_receiver_source_value(compiler)),
			("identity union source value", func(): test_identity_source_value(compiler)),
			("union native execution and cost", func(): test_union_native_and_cost(compiler)),
			(
				"nominal union mismatch preserves output",
				func(): test_rejected_cross_union_call(compiler),
			),
		]
	}
