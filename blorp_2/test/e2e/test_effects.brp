import:
	./cost: CostLimits
	./harness: run_output_example
	test: TestSuite


private LIMITS: CostLimits = {
	allocations = 145000,
	instructions = 500000000
}


private func example(
	compiler: String,
	fixture: String,
	expected: String,
	limits: CostLimits,
) -> Bool:
	run_output_example(
		compiler,
		"blorp_2/test/e2e/fixtures/effects/" + fixture + ".brp",
		expected,
		limits,
	)


pure func suite(compiler: String) -> TestSuite:
	{
		description = "Blorp 2 Void and concrete print",
		tests = [
			("Hello, World!", func(): example(compiler, "hello", "Hello, World!\n", LIMITS)),
			("interleaved mutation", func(): example(compiler, "order", "first\nsecond\n", LIMITS)),
			(
				"empty UTF-8 and embedded NUL",
				func(): example(compiler, "bytes", "\né😀\0123\n", LIMITS),
			),
			(
				"selected arm only",
				func(): example(compiler, "selected_arm", "selected\nlast\n", LIMITS),
			),
			(
				"alias survives print and reassignment",
				func(): example(compiler, "alias", "kept\nkept\nreplacement\n", LIMITS),
			),
			(
				"nested argument and UFCS order",
				func(): example(compiler, "nested", "left\nleft\nright\nright\n", LIMITS),
			),
			(
				"Void through locals generics and payloads",
				func(): example(compiler, "unit", "", LIMITS),
			),
			("flat sequence of 64 prints", func(): example(
					compiler,
					"sequence",
					"x\n".repeat(64),
					{
						allocations = 230000,
						instructions = 800000000
					},
				)),
		]
	}
