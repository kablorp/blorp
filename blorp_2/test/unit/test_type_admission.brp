pure func test_generic_string_forwarding_keeps_terminal_caller_parameters() -> Bool:
	source: String =
		|fixed union Values[T]:
		|    Empty
		|    Items(List[T])
		|pure func make[T](value: T) -> Values[T]:
		|    Empty
		|pure func forward[T](value: T) -> Values[T]:
		|    make(value)
		|func main() -> Int:
		|    saved = forward("valid")
		|    0
		|
	accepts(source)


pure func test_two_string_requirements_are_both_satisfied() -> Bool:
	source: String =
		|fixed record Both[A, B] { first: List[A], second: List[B] }
		|func unused(value: Both[String, String]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	accepts(source)


pure func test_duplicate_child_requirements_preserve_one_parameter_fact() -> Bool:
	source: String =
		|fixed record Values[T] { items: List[T] }
		|fixed record Pair[T] { left: Values[T], right: Values[T] }
		|fixed union Choice[T]:
		|    Empty
		|    Full(Pair[T], Values[T])
		|pure func make() -> Choice[String]:
		|    Empty
		|func main() -> Int:
		|    saved = make()
		|    0
		|
	accepts(source)


tests: TestSuite = {
	description = "Blorp 2 concrete aggregate type admission",
	tests = [
		("forward declaration summary before bodies", test_forward_declaration_summary_is_available_before_body_checking),
		("second List requirement is enforced", test_second_list_requirement_cannot_be_overlooked),
		("finite cycle rejects before concrete admission", test_finite_cycle_rejection_precedes_concrete_type_admission),
		("first field error precedes shallower later field", test_nested_first_field_error_precedes_shallower_later_field),
		("unknown later child precedes nominal freeze admission", test_unknown_later_child_precedes_freeze_only_nominal_admission),
		("unused record parameter rejects Int List requirement", test_unused_record_parameter_rejects_concrete_list_requirement),
		("unused union parameter rejects Int List requirement", test_unused_union_parameter_rejects_concrete_list_requirement),
		("unused return rejects Int List requirement", test_unused_return_annotation_rejects_concrete_list_requirement),
		("record field rejects invalid child instance", test_record_field_rejects_concrete_child_requirement),
		("union field rejects invalid child instance", test_union_field_rejects_concrete_child_requirement),
		("nested record requirement reaches outer annotation", test_nested_record_requirement_reaches_written_outer_application),
		("union requirement remaps parameter position", test_union_parameter_requirement_is_remapped_by_position),
		("phantom nested argument still requires valid type", test_phantom_outer_argument_must_still_be_a_valid_type),
		("List type argument cannot satisfy String requirement", test_list_type_argument_does_not_satisfy_string_requirement),
		("Void cannot satisfy String requirement", test_void_argument_does_not_satisfy_string_requirement),
		("inferred result rejects at call", test_inferred_call_result_rejects_at_the_instantiating_call),
		("forwarded result rejects at concrete call", test_forwarded_call_result_rejects_at_the_concrete_call),
		("unused body still checks generic calls", test_invalid_generic_call_in_unused_body_is_checked),
		("inferred result checks nested phantom argument", test_inferred_call_rejects_invalid_nested_phantom_argument),
		("annotation error precedes unknown body value", test_invalid_annotation_precedes_unknown_body_value),
		("unused String record accepted", test_unused_string_record_instance_is_accepted),
		("String union checks every variant field", test_string_union_instance_includes_unselected_variant_fields),
		("symbolic record requirement accepted", test_symbolic_record_requirement_remains_valid),
		("symbolic union requirement accepted", test_symbolic_union_requirement_remains_valid),
		("record Void payload accepted", test_record_void_payload_is_valid),
		("pure union containing Void accepted", test_pure_function_can_return_union_containing_void),
		("phantom Int remains unconstrained", test_phantom_int_parameter_is_unconstrained),
		("phantom Void remains unconstrained", test_phantom_void_parameter_is_unconstrained),
		("second parameter accepts String after remap", test_remapped_second_parameter_accepts_string),
		("generic String forwarding accepted", test_generic_string_forwarding_keeps_terminal_caller_parameters),
		("two String requirements satisfied", test_two_string_requirements_are_both_satisfied),
		("duplicate child requirements remain valid", test_duplicate_child_requirements_preserve_one_parameter_fact),
	]
}
