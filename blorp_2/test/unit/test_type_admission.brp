import:
	../../src/check as API
	../../src/check_errors as Errors
	../../src/check_render: render_check_error, render_failure
	../../src/check_model: TypeRef(AppliedRecordType, IntType)
	../../src/check_types: admit_type, validate_declarations, validate_finite_declarations
	../../src/assemble: parsed_contents
	../../src/lex: lex
	../../src/namespace: TypeCandidate(RecordCandidate), build_namespace, type_candidates
	../../src/source: module_source, root_module_id, same_source
	../../src/specialize: specialize
	../../src/syntax: Span
	input: check_failure, checked_source, parse
	test: TestSuite


private pure func rejects_list(source: String, start: Int, end: Int) -> Bool:
	match lex(module_source(root_module_id()), source).and_then(parse):
		Err(_): False
		Ok(parsed):
			match API.check(parsed):
				Ok(_): False
				Err(failure):
					errors = API.check_errors(failure)
					diagnostics = render_failure(failure)
					typed = match errors.first.kind:
						Errors.TypeTermRejection(Errors.UnsupportedListElement): True
						_: False
					(
						typed and errors.remaining.is_empty() and diagnostics.remaining.is_empty()
						and same_source(errors.first.span.source, module_source(root_module_id()))
						and errors.first.span.start == start and errors.first.span.end == end
						and diagnostics.first.span.start == start and diagnostics.first.span.end == end
						and diagnostics.first.message == "List currently supports only String elements"
						and diagnostics.first.help == "use List[String]; other concrete element types are not supported yet"
					)


private pure func accepts(source: String) -> Bool:
	checked_source(source).and_then(specialize).is_ok()


-- Exercise the declaration producer and its sealed consumer directly. No
-- signatures or bodies are checked, and the record identity comes from the
-- actual namespace rather than an unchecked ordinal constructor.
pure func test_forward_declaration_summary_is_available_before_body_checking() -> Bool:
	source: String =
		|fixed record Outer[T] { child: Values[T] }
		|fixed record Values[T] { items: List[T] }
		|func unused(value: Outer[Int]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	match lex(module_source(root_module_id()), source).and_then(parse):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			namespace = build_namespace(program)
			match validate_declarations(parsed, namespace).and_then(validate_finite_declarations):
				Err(_): False
				Ok(admission):
					match parsed.records.get(0):
						None: False
						Some(declaration):
							match type_candidates(namespace, root_module_id(), declaration.type_name.id):
								[RecordCandidate(owner)]:
									span: Span = { source = module_source(root_module_id()), start = 104, end = 114 }
									match admit_type(AppliedRecordType(owner, [IntType]), admission, span):
										Err(error):
											typed = match error.kind:
												Errors.TypeTermRejection(Errors.UnsupportedListElement): True
												_: False
											diagnostic = render_check_error(program, error)
											(
												typed and error.span.start == 104 and error.span.end == 114
												and diagnostic.message == "List currently supports only String elements"
												and diagnostic.help == "use List[String]; other concrete element types are not supported yet"
											)
										Ok(_): False
								_: False


pure func test_second_list_requirement_cannot_be_overlooked() -> Bool:
	source: String =
		|fixed record Both[A, B] { first: List[A], second: List[B] }
		|func unused(value: Both[String, Int]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	rejects_list(source, 79, 96)


pure func test_finite_cycle_rejection_precedes_concrete_type_admission() -> Bool:
	source: String =
		|fixed record Node[T] { next: Node[T], items: List[T] }
		|func unused(value: Node[Int]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	typed = match check_failure(source):
		Some(error):
			match error.kind:
				Errors.TypeDeclarationRejection(Errors.RecursiveAggregateType(_)):
					error.span.start == 29 and error.span.end == 36
				_: False
		None: False
	match checked_source(source):
		Ok(_): False
		Err(error):
			(
				typed and error.message == "recursive aggregate types are not supported yet"
				and error.help == "use finite record and union fields until recursive data is supported"
				and error.span.start == 29 and error.span.end == 36
			)


pure func test_nested_first_field_error_precedes_shallower_later_field() -> Bool:
	source: String =
		|fixed record Values[T] { items: List[T] }
		|fixed record Marker[T] { value: Int }
		|fixed record Bad { first: Marker[Values[Int]], second: Values[Float] }
		|func main() -> Int:
		|    0
		|
	rejects_list(source, 106, 125)


pure func test_unknown_later_child_precedes_freeze_only_nominal_admission() -> Bool:
	source: String =
		|fixed union Values[T]:
		|    Empty
		|    Items(List[T])
		|pure func make[T](value: T) -> Values[T]:
		|    Empty
		|pure func outer[T](left: T, right: Int) -> Int:
		|    0
		|func main() -> Int:
		|    outer(make(1), missing)
		|
	typed = match check_failure(source):
		Some(error):
			match error.kind:
				Errors.ValueRejection(Errors.UnknownValue(_)):
					error.span.start == 197 and error.span.end == 204
				_: False
		None: False
	match checked_source(source):
		Ok(_): False
		Err(error):
			(
				typed and error.message == "unknown value"
				and error.help == "use this function's parameter name, a declared variant, or a call"
				and error.span.start == 197 and error.span.end == 204
			)


