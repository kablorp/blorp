import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../run_to_files_inputs: process_seed
	../module_input: test_base
	int: Int methods_only
	bool: Bool methods_only
	test: TestSuite


pure func test_process_signature_has_string_list_and_integer_result() -> Bool:
	match process_seed(test_base()):
		Err(_): False
		Ok(seed):
			signature = Concrete.runtime_signature(Builtins.RunToFiles(seed.constructors))
			match (signature.parameters, signature.return_type):
				([Concrete.StringType, Concrete.ListType(Concrete.StringType), Concrete.StringType, Concrete.StringType, Concrete.IntType], Concrete.UnionType(owner)):
					match Lower.lowered_functions(seed.lowered).unions.get(Concrete.union_number(owner)):
						Some(layout):
							match Concrete.union_variants(layout):
								[[Concrete.IntType], [Concrete.StringType]]:
									Concrete.union_number(owner).equals(Concrete.union_number(Concrete.variant_owner(seed.constructors.ok))).and(Concrete.union_number(owner).equals(Concrete.union_number(Concrete.variant_owner(seed.constructors.err))))
								_: False
						None: False
				_: False


tests: TestSuite = {
	description = "Process builtin specialization",
	tests = [("String list and designated Int/String Result", test_process_signature_has_string_list_and_integer_result)]
}
