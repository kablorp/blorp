import:
	../../../src/specialize/specialize as Concrete
	../module_input: test_base
	../void_string_result_inputs: specialized_result
	test: TestSuite


pure func test_ordinary_result_preserves_both_payload_types() -> Bool:
	match specialized_result(test_base()):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).unions:
				[row]:
					match (row.variants, row.representation):
						([[Concrete.VoidType], [Concrete.StringType]], Concrete.InlineOwningPayload): True
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 ordinary Void/String Result specialization",
	tests = [("Void and String retain their distinct stored payload roles", test_ordinary_result_preserves_both_payload_types)]
}
