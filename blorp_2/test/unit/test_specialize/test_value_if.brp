import:
	../../../src/check/model: binding_number
	../../../src/specialize/specialize as Concrete
	../value_if_inputs as Input
	test: TestSuite


private pure func result_and_carrier_types(source: String, expected: Concrete.TypeRef) -> Bool:
	match Input.concrete(source):
		Err(_): False
		Ok(program):
			var accepted = False
			for function in Concrete.specialized_contents(program).functions:
				for statement in function.statements:
					match statement:
						Concrete.InitializeBinding(_, value):
							match value.form:
								Concrete.Match(join):
									accepted = (Concrete.same_type(value.value_type, expected)
										and join.carried.map(binding_number) == [1]
										and join.arms.length() == 2
										and join.arms.all(pure func(arm): Concrete.same_type(arm.value.value_type, expected)))
								_: void
						_: void
			accepted


pure func test_string_if_keeps_result_and_carrier_types() -> Bool:
	result_and_carrier_types(Input.STRING_ALIAS, Concrete.StringType)


pure func test_list_if_keeps_result_and_carrier_types() -> Bool:
	result_and_carrier_types(Input.LIST_ALIAS, Concrete.ListType(Concrete.StringType))


tests: TestSuite = {
	description = "Blorp 2 value if specialization",
	tests = [
		("String result and carried binding types", test_string_if_keeps_result_and_carrier_types),
		("List result and carried binding types", test_list_if_keeps_result_and_carrier_types),
	]
}
