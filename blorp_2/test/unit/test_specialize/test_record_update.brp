import:
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, entry_function
	../../../src/utils/source: module_source, root_module_id
	../input: checked_source
	int as IntOps
	test: TestSuite


private pure func specialized(source: String) -> Result[Concrete.SpecializedContents, Diagnostic]:
	checked ?= checked_source(source)
	program ?= Concrete.specialize(checked)
	Ok(Concrete.specialized_contents(program))


private pure func returned_update(function: Concrete.ConcreteFunction) -> Option[Concrete.ConcreteRecordUpdate]:
	match function.body:
		Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
			match value.form:
				Concrete.UpdateRecord(_, update): Some(update)
				Concrete.ReadRecordField(receiver, _):
					match receiver.form:
						Concrete.UpdateRecord(_, update): Some(update)
						_: None
				_: None
		_: None


private pure func fields_belong_to(update: Concrete.ConcreteRecordUpdate, owner: Concrete.RecordInstanceId) -> Bool:
	var valid = True
	for field in update.replacements:
		valid = valid and Concrete.RecordType(Concrete.field_owner(field.field)) == Concrete.RecordType(owner)
	for field in update.inherited:
		valid = valid and Concrete.RecordType(Concrete.field_owner(field.field)) == Concrete.RecordType(owner)
	valid


private pure func pair_fields(layout: Concrete.ConcreteRecord, first: Concrete.TypeRef, second: Concrete.TypeRef) -> Bool:
	match Concrete.record_fields(layout):
		[left, right]: left == first and right == second
		_: False


private pure func box_update_fields(update: Concrete.ConcreteRecordUpdate, element: Concrete.TypeRef) -> Bool:
	inherited = match update.inherited:
		[field]: IntOps.equals(Concrete.field_number(field.field), 0) and field.value_type == element
		_: False
	replacement = match update.replacements:
		[field]: IntOps.equals(Concrete.field_number(field.field), 1) and field.value.value_type == Concrete.IntType
		_: False
	inherited and replacement


pure func test_each_generic_update_uses_its_complete_concrete_instance() -> Bool:
	source: String =
		|record Box[T] { value: T, count: Int }
		|pure func make[T](value: T) -> Box[T]:
		|    { value = value, count = 1 }
		|pure func change[T](box: Box[T]) -> Box[T]:
		|    { box | count = 7 }
		|func main() -> Int:
		|    text = change(make("kept"))
		|    number = change(make(9))
		|    number.value
		|
	match specialized(source):
		Err(_): False
		Ok(program):
			var updates = 0
			var valid = True
			var inline_count = 0
			var managed_count = 0
			for function in program.functions:
				match returned_update(function):
					None: void
					Some(update):
						updates = IntOps.add(updates, 1)
						match function.signature.return_type:
							Concrete.RecordType(owner):
								valid = valid and fields_belong_to(update, owner) and update.base.value_type == Concrete.RecordType(owner)
								match program.records.get(Concrete.record_number(owner)):
									None: valid = False
									Some(layout):
										element = match layout:
											Concrete.InlineFields(_):
												inline_count = IntOps.add(inline_count, 1)
												Concrete.IntType
											Concrete.CountedFields(_):
												managed_count = IntOps.add(managed_count, 1)
												Concrete.StringType
										valid = valid and pair_fields(layout, element, Concrete.IntType) and box_update_fields(update, element)
							_: valid = False
			(valid and IntOps.equals(updates, 2) and IntOps.equals(program.records.length(), 2)
			and IntOps.equals(inline_count, 1) and IntOps.equals(managed_count, 1))


pure func test_phantom_arguments_preserve_distinct_update_owners() -> Bool:
	source: String =
		|record Marker[A, B] { value: Int, ignored: Void }
		|pure func first() -> Marker[Int, String]:
		|    { value = 1, ignored = void }
		|pure func second() -> Marker[String, Int]:
		|    { value = 2, ignored = void }
		|pure func change[A, B](value: Marker[A, B]) -> Marker[A, B]:
		|    { value | value = 7 }
		|func main() -> Int:
		|    old = change(first())
		|    change(second()).value
		|
	match specialized(source):
		Err(_): False
		Ok(program):
			var owners: List[Concrete.TypeRef] = []
			var valid = True
			for function in program.functions:
				match returned_update(function):
					None: void
					Some(update):
						owners = owners.append(function.signature.return_type)
						match function.signature.return_type:
							Concrete.RecordType(owner):
								valid = valid and fields_belong_to(update, owner)
								match update.inherited:
									[field]: valid = valid and IntOps.equals(Concrete.field_number(field.field), 1) and field.value_type == Concrete.VoidType
									_: valid = False
							_: valid = False
			layouts = match program.records:
				[first, second]:
					first_managed = match first:
						Concrete.CountedFields(_): True
						Concrete.InlineFields(_): False
					second_managed = match second:
						Concrete.CountedFields(_): True
						Concrete.InlineFields(_): False
					first_managed and second_managed and pair_fields(first, Concrete.IntType, Concrete.VoidType) and pair_fields(second, Concrete.IntType, Concrete.VoidType)
				_: False
			identities = match owners:
				[first, second]: not (first == second)
				_: False
			valid and layouts and identities


private pure func prepared_nested_child(program: Concrete.SpecializedContents, value: Concrete.TypeRef) -> Bool:
	match value:
		Concrete.ListType(Concrete.ListType(Concrete.RecordType(box))):
			match program.records.get(Concrete.record_number(box)):
				Some(layout):
					match Concrete.record_fields(layout):
						[Concrete.RecordType(entry)]:
							match program.records.get(Concrete.record_number(entry)):
								Some(layout): pair_fields(layout, Concrete.IntType, Concrete.StringType)
								None: False
						_: False
				None: False
		_: False


pure func test_inherited_nested_list_keeps_prepared_nominal_children() -> Bool:
	source: String =
		|record Entry { number: Int, text: String }
		|record Box[T] { value: T }
		|record Container { values: List[List[Box[Entry]]], count: Int }
		|union Maybe[T]:
		|    Missing
		|    Present(T)
		|pure func change(value: Container) -> Container:
		|    { value | count = 7 }
		|pure func missing() -> Maybe[Container]:
		|    Missing
		|func main() -> Int:
		|    match missing():
		|        Present(value): change(value).count
		|        Missing: 0
		|
	match specialized(source):
		Err(_): False
		Ok(program):
			var updates = 0
			var valid = True
			for function in program.functions:
				match returned_update(function):
					None: void
					Some(update):
						updates = IntOps.add(updates, 1)
						match update.inherited:
							[field]: valid = valid and prepared_nested_child(program, field.value_type)
							_: valid = False
			valid and IntOps.equals(updates, 1) and IntOps.equals(program.records.length(), 3)


private pure func prepared_integer_call(program: Concrete.SpecializedContents, value: Concrete.ConcreteExpr, expected: Concrete.TypeRef) -> Bool:
	match value.form:
		Concrete.InvokeFunction(call, [_]):
			match call.target:
				Concrete.UserFunction(id):
					match program.functions.get(Concrete.function_number(id)):
						Some(function):
							parameters = match function.signature.parameters:
								[Concrete.IntType]: True
								_: False
							parameters and function.signature.return_type == expected
						None: False
				_: False
		_: False


pure func test_generic_calls_in_base_and_replacement_are_prepared() -> Bool:
	source: String =
		|record Box[T] { value: T }
		|pure func make[T](value: T) -> Box[T]:
		|    { value = value }
		|pure func identity[T](value: T) -> T:
		|    value
		|func main() -> Int:
		|    { make(1) | value = identity(7) }.value
		|
	match specialized(source):
		Err(_): False
		Ok(program):
			match program.functions.get(Concrete.function_number(entry_function(program.entrypoint))):
				None: False
				Some(main):
					match returned_update(main):
						None: False
						Some(update):
							base_call = prepared_integer_call(program, update.base, update.base.value_type)
							rhs_call = match update.replacements:
								[field]: prepared_integer_call(program, field.value, Concrete.IntType)
								_: False
							base_call and rhs_call and IntOps.equals(program.functions.length(), 3)


pure func test_written_replacements_keep_order_values_types_and_spans() -> Bool:
	source: String =
		|record Triple { first: Int, middle: Int, last: Int }
		|pure func change(value: Triple) -> Triple:
		|    { value | last = 9223372036854775807, first = -9223372036854775808 }
		|func main() -> Int:
		|    changed = change({ first = 1, middle = 2, last = 3 })
		|    changed.middle
		|
	maximum_literal = "9223372036854775807"
	minimum_literal = "-9223372036854775808"
	match specialized(source):
		Err(_): False
		Ok(program):
			var updates = 0
			var valid = True
			for function in program.functions:
				match returned_update(function):
					None: void
					Some(update):
						updates = IntOps.add(updates, 1)
						match (update.replacements, update.inherited, function.signature.return_type):
							([last, first], [middle], Concrete.RecordType(owner)):
								valid = valid and fields_belong_to(update, owner)
								valid = valid and update.base.value_type == Concrete.RecordType(owner)
								valid = valid and Concrete.field_number(last.field) == 2 and Concrete.field_number(first.field) == 0 and Concrete.field_number(middle.field) == 1
								valid = valid and last.value.value_type == Concrete.IntType
								valid = valid and first.value.value_type == Concrete.IntType
								valid = valid and middle.value_type == Concrete.IntType
								valid = valid and Some(last.value.span.start) == source.index_of(maximum_literal)
								valid = valid and last.value.span.end == last.value.span.start + maximum_literal.length()
								valid = valid and Some(first.value.span.start) == source.index_of(minimum_literal)
								valid = valid and first.value.span.end == first.value.span.start + minimum_literal.length()
								valid = valid and last.value.span.source == module_source(root_module_id())
								valid = valid and first.value.span.source == module_source(root_module_id())
								match (last.value.form, first.value.form):
									(Concrete.LiteralInteger(high), Concrete.LiteralInteger(low)):
										valid = valid and high == 9223372036854775807 and low == -9223372036854775808
									_: valid = False
							_: valid = False
			valid and updates == 1


tests: TestSuite = {
	description = "Record update specialization",
	tests = [
		("written replacements keep order, values, types and spans", test_written_replacements_keep_order_values_types_and_spans),
		("generic updates use complete concrete instances", test_each_generic_update_uses_its_complete_concrete_instance),
		("phantom arguments preserve distinct update owners", test_phantom_arguments_preserve_distinct_update_owners),
		("inherited Lists keep prepared nominal children", test_inherited_nested_list_keeps_prepared_nominal_children),
		("generic base and RHS calls are prepared", test_generic_calls_in_base_and_replacement_are_prepared),
	]
}
