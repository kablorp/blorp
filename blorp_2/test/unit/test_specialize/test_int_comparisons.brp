import:
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../int_comparison_inputs: checked_comparison
	../module_input: TestFoundation, test_base
	test: TestSuite


private pure func retains_bool_roles(foundation: TestFoundation, true_tag: Int, false_tag: Int) -> Bool:
	match checked_comparison(foundation).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, function]:
					match function.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match (value.form, value.value_type):
								(Concrete.InvokeFunction(call, [_, _]), Concrete.UnionType(owner)):
									match call.target:
										Concrete.RuntimeFunction(Builtins.IntLessThan(boolean)):
											(Concrete.variant_number(boolean.true_variant) == true_tag
												and Concrete.variant_number(boolean.false_variant) == false_tag
												and Concrete.union_number(Concrete.variant_owner(boolean.true_variant)) == Concrete.union_number(owner)
												and Concrete.union_number(Concrete.variant_owner(boolean.false_variant)) == Concrete.union_number(owner))
										_: False
								_: False
						_: False
				_: False


pure func test_comparison_uses_designated_bool_roles() -> Bool:
	retains_bool_roles(test_base(), 0, 1)


pure func test_reversed_bool_declarations_preserve_roles() -> Bool:
	retains_bool_roles({ test_base() | types = test_base().types.replace("    True\n    False", "    False\n    True") }, 1, 0)


tests: TestSuite = {
	description = "Signed Int comparison specialization",
	tests = [
		("Bool constructors name the result instance", test_comparison_uses_designated_bool_roles),
		("reversed Bool declarations preserve True and False", test_reversed_bool_declarations_preserve_roles),
	]
}
