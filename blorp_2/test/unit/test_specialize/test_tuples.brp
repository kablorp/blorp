import:
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic
	../input: checked_source
	test: TestSuite


private pure func specialized(source: String) -> Result[Concrete.SpecializedContents, Diagnostic]:
	checked ?= checked_source(source)
	program ?= Concrete.specialize(checked)
	Ok(Concrete.specialized_contents(program))


pure func test_equal_structural_shapes_share_one_managed_layout() -> Bool:
	source: String =
		|pure func pair(value: Int) -> (Int, String):
		|    (value, "text")
		|func main() -> Int:
		|    first = pair(1)
		|    second = (2, "other")
		|    first[0]
		|
	match specialized(source):
		Ok(program):
			match program.records:
				[layout]:
					match (Concrete.record_fields(layout), layout):
						([Concrete.IntType, Concrete.StringType], Concrete.CountedFields(_)): True
						_: False
				_: False
		Err(_): False


pure func test_void_members_keep_logical_field_ordinals() -> Bool:
	source: String =
		|pure func tuple() -> (Void, Int, Void):
		|    (void, 7, void)
		|func main() -> Int:
		|    tuple()[1]
		|
	match specialized(source):
		Ok(program):
			match program.functions:
				[main, _]:
					match main.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match value.form:
								Concrete.ReadRecordField(_, field):
									Concrete.field_number(field) == 1 and program.records.length() == 1
								_: False
						_: False
				_: False
		Err(_): False


pure func test_reversed_elements_and_named_record_have_distinct_layouts() -> Bool:
	source: String =
		|fixed record Named { number: Int, text: String }
		|func main() -> Int:
		|    first = (1, "text")
		|    second = ("text", 1)
		|    named: Named = { number = 1, text = "text" }
		|    first[0]
		|
	match specialized(source):
		Ok(program): program.records.length() == 3
		Err(_): False


tests: TestSuite = {
	description = "Structural tuple specialization",
	tests = [
		("equal tuples share managed layout", test_equal_structural_shapes_share_one_managed_layout),
		("Void keeps logical ordinals", test_void_members_keep_logical_field_ordinals),
		("tuple order and nominal identity differ", test_reversed_elements_and_named_record_have_distinct_layouts),
	]
}
