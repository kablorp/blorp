import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../file_write_inputs: file_write_seed
	../module_input: TEST_BASE
	test: TestSuite


pure func test_write_result_has_distinct_payload_types() -> Bool:
	match file_write_seed(TEST_BASE):
		Err(_): False
		Ok(seed):
			signature = Concrete.runtime_signature(Builtins.WriteFile(seed.constructors))
			match (signature.parameters, signature.return_type, Lower.lowered_functions(seed.lowered).unions):
				([Concrete.StringType, Concrete.StringType], Concrete.UnionType(owner), [layout]):
					match (layout.variants, layout.representation):
						([[Concrete.VoidType], [Concrete.StringType]], Concrete.InlineOwningPayload):
							Concrete.union_number(owner) == Concrete.union_number(Concrete.variant_owner(seed.constructors.ok))
						_: False
				_: False


pure func test_reversed_result_preserves_constructor_roles() -> Bool:
	foundation = { TEST_BASE | types = TEST_BASE.types.replace("    Ok(Value)\n    Err(Error)", "    Err(Error)\n    Ok(Value)") }
	match file_write_seed(foundation):
		Err(_): False
		Ok(seed): Concrete.variant_number(seed.constructors.ok) == 1 and Concrete.variant_number(seed.constructors.err) == 0


tests: TestSuite = {
	description = "Blorp 2 file-write specialization",
	tests = [
		("two Strings keep the concrete Result owner", test_write_result_has_distinct_payload_types),
		("reversed declarations retain Ok and Err roles", test_reversed_result_preserves_constructor_roles),
	]
}
