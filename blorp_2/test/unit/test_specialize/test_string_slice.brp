import:
	../../../src/check/check: check
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../input: setup_diagnostic
	../module_input: TestFoundation, TEST_BASE, parse_modules_with_base
	../string_slice_inputs: SLICE_SOURCE
	test: TestSuite


private pure func slice_specializes_with_foundation(foundation: TestFoundation, some_index: Int, none_index: Int) -> Bool:
	match parse_modules_with_base([{ source = SLICE_SOURCE, targets = [] }], foundation)
		.and_then(pure func(parsed): check(parsed).map_err(setup_diagnostic)).and_then(Concrete.specialize):
		Err(_): False
		Ok(program):
			contents = Concrete.specialized_contents(program)
			match contents.functions:
				[_, query, _]:
					match (query.signature.parameters, query.signature.return_type, query.body):
						([Concrete.StringType, Concrete.IntType, Concrete.IntType], Concrete.UnionType(owner), Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
							match value.form:
								Concrete.InvokeFunction(call, [text, start, end]):
									match call.target:
										Concrete.RuntimeFunction(Builtins.StringSlice(option)):
											match contents.unions.get(Concrete.union_number(owner)):
												Some(layout):
													match (layout.variants.get(some_index), layout.variants.get(none_index), layout.representation):
														(Some([Concrete.StringType]), Some([]), Concrete.InlineOwningPayload):
															(
																Concrete.same_type(text.value_type, Concrete.StringType)
																and Concrete.same_type(start.value_type, Concrete.IntType) and Concrete.same_type(end.value_type, Concrete.IntType)
																and Concrete.union_number(Concrete.variant_owner(option.some)) == Concrete.union_number(owner)
																and Concrete.union_number(Concrete.variant_owner(option.none)) == Concrete.union_number(owner)
																and Concrete.variant_number(option.some) == some_index and Concrete.variant_number(option.none) == none_index
															)
														_: False
												None: False
										_: False
								_: False
						_: False
				_: False


pure func test_slice_specializes_its_owning_option_constructors() -> Bool:
	slice_specializes_with_foundation(TEST_BASE, 0, 1)


pure func test_slice_preserves_reversed_option_constructor_roles() -> Bool:
	foundation = { TEST_BASE | types = TEST_BASE.types.replace("    Some(A)\n    None", "    None\n    Some(A)") }
	slice_specializes_with_foundation(foundation, 1, 0)


tests: TestSuite = {
	description = "Blorp 2 concrete String slice",
	tests = [
		("slice keeps ordered types and actual owning Option identities", test_slice_specializes_its_owning_option_constructors),
		("slice preserves reversed Some and None roles", test_slice_preserves_reversed_option_constructor_roles),
	]
}
