import:
	../../../src/specialize/indexed_list as Indexed
	bool: and
	int: Int methods
	list: List methods
	option: is_none
	string as StringOps
	../../../src/utils/int_map as IntMaps
	test: TestSuite


-- Entries are names, digested by length: "ab" and "cd" share a digest but are
-- different keys, as two instances of one declaration do.
private pure func digest(name: String) -> Int:
	StringOps.length(name)


-- The position of `name`, comparing whole keys within its digest's positions
-- only, as a specialization lookup does.
private pure func find(table: Indexed.IndexedList[String], name: String) -> Option[Int]:
	match Indexed.find_position(table, digest(name), pure func(known: String) -> Bool: known == name):
		Ok(found): found
		Err(_): None


-- The existing instance's table when `name` is known, otherwise the table with it appended.
private pure func ensured(table: Indexed.IndexedList[String], name: String) -> Indexed.IndexedList[String]:
	match find(table, name):
		Some(_): table
		None: Indexed.append_entry(table, name, digest(name))


private pure func ensuring_each(names: List[String]) -> Indexed.IndexedList[String]:
	var table: Indexed.IndexedList[String] = Indexed.empty_indexed_list()
	for name in names:
		table = ensured(table, name)
	table


pure func test_a_repeated_key_finds_its_first_position() -> Bool:
	table = ensuring_each(["ab", "abc", "ab", "abc"])
	match (find(table, "ab"), find(table, "abc")):
		(Some(first), Some(second)): and(first == 0, and(second == 1, table.entries.length() == 2))
		_: False


-- "ab" and "cd" share a digest; only the whole key tells them apart.
pure func test_a_colliding_digest_with_a_different_key_is_kept_apart() -> Bool:
	table = ensuring_each(["ab", "cd", "ef"])
	match (find(table, "ab"), find(table, "cd"), find(table, "ef")):
		(Some(first), Some(second), Some(third)):
			and(and(first == 0, second == 1), and(third == 2, Indexed.candidate_positions(table, 2).length() == 3))
		_: False


pure func test_a_new_key_is_absent_then_takes_the_next_position() -> Bool:
	before = ensuring_each(["ab", "cd", "xyz"])
	after = ensured(before, "uv")
	match (find(before, "uv"), find(after, "uv")):
		(None, Some(position)): position == 3
		_: False


pure func test_a_digest_with_no_entries_has_no_positions() -> Bool:
	table = ensuring_each(["ab"])
	and(Indexed.candidate_positions(table, 7).is_empty(), find(table, "xyz").is_none())


-- An index naming a position its list lacks is reported, not skipped.
pure func test_an_index_naming_a_missing_entry_is_an_error() -> Bool:
	diverged: Indexed.IndexedList[String] = {
		entries = [],
		positions = IntMaps.set(IntMaps.empty_int_map(), 2, [0]),
	}
	match Indexed.find_position(diverged, 2, pure func(known: String) -> Bool: True):
		Err(position): position == 0
		Ok(_): False


tests: TestSuite = {
	description = "Blorp 2 specialization indexed instance list",
	tests = [
		("a repeated key finds its first position", test_a_repeated_key_finds_its_first_position),
		("a colliding digest with a different key is kept apart", test_a_colliding_digest_with_a_different_key_is_kept_apart),
		("a new key is absent then takes the next position", test_a_new_key_is_absent_then_takes_the_next_position),
		("a digest with no entries has no positions", test_a_digest_with_no_entries_has_no_positions),
		("an index naming a missing entry is an error", test_an_index_naming_a_missing_entry_is_an_error),
	]
}
