import:
	../../../src/check/model as Checked
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: entry_function, same_span
	../../../src/utils/source: module_source, root_module_id
	../source_while_inputs as Input
	test: TestSuite


private pure func loop_in(function: Concrete.ConcreteFunction) -> Option[Concrete.ConcreteWhile]:
	var found: Option[Concrete.ConcreteWhile] = None
	for statement in function.statements:
		match statement:
			Concrete.RunWhile(loop): found = Some(loop)
			_: void
	found


private pure func scalar_carriers() -> Option[Bool]:
	accepted ?= Input.concrete(Input.HEADER_SWAP).to_option()
	contents = Concrete.specialized_contents(accepted)
	function ?= contents.functions.get(Concrete.function_number(entry_function(contents.entrypoint)))
	loop ?= loop_in(function)
	var eligible = True
	for id in loop.carried:
		match function.bindings.get(Checked.binding_number(id)):
			None: eligible = False
			Some(binding):
				match Concrete.value_ownership(binding.value_type, contents.unions, contents.records):
					Err(_): eligible = False
					Ok(plan):
						admitted = match plan:
							Concrete.NoOwnership: True
							_: False
						eligible = eligible and admitted
	Some(eligible and loop.carried.length() == 3
		and loop.body.length() == 4 and function.bindings.length() == 4
		and Concrete.same_type(loop.condition.value_type, Concrete.UnionType(Concrete.variant_owner(loop.boolean.true_variant)))
		and Concrete.union_number(Concrete.variant_owner(loop.boolean.true_variant)) == Concrete.union_number(Concrete.variant_owner(loop.boolean.false_variant))
		and Concrete.variant_number(loop.boolean.true_variant) != Concrete.variant_number(loop.boolean.false_variant))


pure func test_source_loop_uses_sealed_no_ownership_for_ordered_h() -> Bool:
	scalar_carriers().get_or(False)


private pure func managed_carrier_facts() -> Option[Bool]:
	source: String =
		|func main() -> Int:
		|    var text: String = "old"
		|    while False:
		|        text = "new"
		|    0
		|
	accepted ?= Input.concrete(source).to_option()
	contents = Concrete.specialized_contents(accepted)
	function ?= contents.functions.get(Concrete.function_number(entry_function(contents.entrypoint)))
	loop ?= loop_in(function)
	id ?= loop.carried.get(0)
	binding ?= function.bindings.get(Checked.binding_number(id))
	start ?= source.index_of("text: String")
	plan ?= Concrete.value_ownership(binding.value_type, contents.unions, contents.records).to_option()
	match plan:
		Concrete.ManagedStringLeaf:
			Some(loop.carried.length() == 1 and loop.body.length() == 1
				and Checked.binding_number(id) == 0 and Concrete.same_type(binding.value_type, Concrete.StringType)
				and same_span(binding.span, { source = module_source(root_module_id()), start = start, end = start + "text".length() }))
		_: None


pure func test_managed_reassignment_retains_actual_binding_and_layout() -> Bool:
	managed_carrier_facts().get_or(False)


pure func test_managed_values_are_allowed_when_not_carried() -> Bool:
	source: String =
		|func main() -> Int:
		|    retained = "borrowed outer value"
		|    while False:
		|        local = retained
		|        retained_local = local
		|    0
		|
	Input.concrete(source).is_ok()


tests: TestSuite = {
	description = "Blorp 2 source while specialization",
	tests = [
		("ordered source H uses sealed NoOwnership", test_source_loop_uses_sealed_no_ownership_for_ordered_h),
		("managed reassignment retains binding and layout", test_managed_reassignment_retains_actual_binding_and_layout),
		("managed outer and local values are not H", test_managed_values_are_allowed_when_not_carried),
	]
}
