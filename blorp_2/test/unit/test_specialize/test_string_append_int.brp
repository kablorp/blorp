import:
	../../../src/check/model: binding_number, BindingOrigin(ParameterBinding)
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../source_while_inputs as Input
	../string_append_int_inputs: APPEND_DECLARATION, DIRECT_APPEND, RECEIVER_APPEND
	test: TestSuite


private pure func append_preserves_scalar_parameter_order(source: String) -> Bool:
	match Input.concrete(APPEND_DECLARATION + source):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, function]:
					match (function.signature.parameters, function.signature.return_type, function.body):
						([Concrete.StringType, Concrete.IntType], Concrete.StringType, Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
							match value.form:
								Concrete.InvokeFunction(call, [text, number]):
									match (call.target, text.form, number.form):
										(Concrete.RuntimeFunction(Builtins.StringAppendInt), Concrete.ReadBinding(text_id), Concrete.ReadBinding(number_id)):
											match (function.bindings.get(binding_number(text_id)), function.bindings.get(binding_number(number_id))):
												(Some(text_binding), Some(number_binding)):
													match (text_binding.origin, number_binding.origin):
														(ParameterBinding(0), ParameterBinding(1)):
															(Concrete.same_type(text.value_type, Concrete.StringType)
																and Concrete.same_type(number.value_type, Concrete.IntType)
																and Concrete.same_type(value.value_type, Concrete.StringType))
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 integer append specialization",
	tests = [
		("direct runtime target retains String and Int order", pure func(): append_preserves_scalar_parameter_order(DIRECT_APPEND)),
		("UFCS runtime target retains String and Int order", pure func(): append_preserves_scalar_parameter_order(RECEIVER_APPEND)),
	]
}
