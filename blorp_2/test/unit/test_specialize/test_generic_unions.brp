import:
	../../../src/utils/names: program_names
	../../../src/check/model as Model
	../../../src/utils/source: module_source, root_module_id
	../../../src/check/check: CheckedProgram, check, checked_functions
	../../../src/check/errors as Errors
	../../../src/lex/lex: lex
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, entry_function
	../compilation: compile, compile_modules
	int as IntOps
	../input: check_failure, parse, setup_diagnostic
	../module_input: PRIMITIVE_BASE, STRING_OPERATIONS
	../../../src/load/load: load_program
	fs: temporary_directory, resource_path, message
	system: temp_dir, write_file
	test: TestSuite


private pure func same_variant_fields(actual: List[List[Concrete.TypeRef]], expected: List[List[Concrete.TypeRef]]) -> Bool:
	var matches = actual.length() == expected.length()
	for (left, right) in actual.zip(expected):
		matches = matches and left.length() == right.length()
		for (a, b) in left.zip(right):
			matches = matches and Concrete.same_type(a, b)
	matches


private func helper_instances() -> Result[Bool, String]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-option-instances-") on error => message(error):
		source: String =
			|import:
			|    option: get_or, to_result
			|    result: is_ok
			|func main() -> Int:
			|    integer = get_or(Some(7), 0)
			|    text = get_or(Some("text"), "default")
			|    mixed = to_result(Some("mixed"), 0)
			|    unit = to_result(Some(void), "unit-error")
			|    unit_ok = is_ok(unit)
			|    integer
			|
		path = directory.resource_path() + "/main.brp"
		written ?= write_file(path, source)
		loaded ?= load_program(path, "blorp_2/standard_library").map_err(func(failure): failure.diagnostic.message)
		checked ?= check(loaded.program).map_err(pure func(failure): setup_diagnostic(failure).message)
		concrete ?= Concrete.specialize(checked).map_err(pure func(error): error.message)
		rows = Concrete.specialized_contents(concrete)
		var integer = False
		var text = False
		var mixed = False
		var unit = False
		var unit_predicate = False
		for function in rows.functions:
			match (function.signature.parameters, function.signature.return_type):
				([Concrete.UnionType(owner), Concrete.IntType], Concrete.IntType):
					integer = rows.unions.get(Concrete.union_number(owner))
						.map(pure func(row): same_variant_fields(row.variants, [[Concrete.IntType], []])).get_or(False)
				([Concrete.UnionType(owner), Concrete.StringType], Concrete.StringType):
					text = rows.unions.get(Concrete.union_number(owner))
						.map(pure func(row): same_variant_fields(row.variants, [[Concrete.StringType], []])).get_or(False)
				([Concrete.UnionType(option), _], Concrete.UnionType(result)):
					match function.body:
						Concrete.ConcreteMatchBody(matched):
							owners = Concrete.union_number(matched.owner) == Concrete.union_number(option) and matched.arms.all(pure func(arm):
								match (arm.pattern, arm.body):
									(Concrete.VariantCase(pattern, _), Concrete.ReturnExpression(value)):
										match value.form:
											Concrete.ConstructVariant(constructor, [child]):
												(
													Concrete.union_number(Concrete.variant_owner(pattern)) == Concrete.union_number(option)
													and Concrete.union_number(Concrete.variant_owner(constructor)) == Concrete.union_number(result)
													and rows.unions.get(Concrete.union_number(result))
														.and_then(pure func(row): row.variants.get(Concrete.variant_number(constructor)))
														.map(pure func(fields): same_variant_fields([fields], [[child.value_type]])).get_or(False)
												)
											_: False
									_: False
							)
							match rows.unions.get(Concrete.union_number(result)):
								Some(row):
									mixed = mixed or (owners and same_variant_fields(row.variants, [[Concrete.StringType], [Concrete.IntType]]))
									unit = unit or (owners and same_variant_fields(row.variants, [[Concrete.VoidType], [Concrete.StringType]]))
								None: void
						_: void
				([Concrete.UnionType(result)], Concrete.UnionType(boolean)):
					unit_predicate = match (rows.unions.get(Concrete.union_number(result)), rows.unions.get(Concrete.union_number(boolean))):
						(Some(input), Some(output)):
							same_variant_fields(input.variants, [[Concrete.VoidType], [Concrete.StringType]]) and same_variant_fields(output.variants, [[], []])
						_: False
				_: void
		Ok(integer and text and mixed and unit and unit_predicate)


func test_library_helpers_specialize_payloads_and_constructor_owners() -> Bool:
	match helper_instances():
		Ok(passed): passed
		Err(error):
			print_error(error)
			False


private pure func callback_map_contract(
	function: Concrete.ConcreteFunction,
	callback: Concrete.FunctionInstanceId,
	bypassed: Concrete.VariantInstanceId,
) -> Bool:
	match (function.signature.parameters, function.body):
		([Concrete.UnionType(owner)], Concrete.ConcreteMatchBody(matched)):
			parameters = function.bindings.filter(pure func(binding):
				match binding.origin:
					Model.ParameterBinding(_): True
					_: False
			)
			parameter_positions_match = parameters.all(pure func(binding):
				match binding.origin:
					Model.ParameterBinding(position): position == 0
					_: False
			)
			var passed = (
				parameters.length() == 1 and function.statements.is_empty()
				and parameter_positions_match
				and Concrete.union_number(Concrete.variant_owner(bypassed)) == Concrete.union_number(owner)
				and Concrete.union_number(matched.owner) == Concrete.union_number(owner)
				and Concrete.same_type(function.signature.return_type, Concrete.UnionType(owner))
			)
			var selected = 0
			var skipped = 0
			for arm in matched.arms:
				passed = passed and arm.statements.is_empty()
				match (arm.pattern, arm.body):
					(Concrete.VariantCase(tag, captures), Concrete.ReturnExpression(value)):
						passed = passed and Concrete.union_number(Concrete.variant_owner(tag)) == Concrete.union_number(owner)
						match (value.form, single_capture(captures)):
							(Concrete.ConstructVariant(returned, [payload]), Some(binding)):
								passed = passed and (
									Concrete.union_number(Concrete.variant_owner(returned)) == Concrete.union_number(owner)
									and Concrete.variant_number(returned) == Concrete.variant_number(tag)
								)
								if Concrete.variant_number(tag) == Concrete.variant_number(bypassed):
									skipped = skipped + 1
									valid_payload = match payload.form:
										Concrete.ReadBinding(read): Model.binding_number(read) == Model.binding_number(binding)
										_: False
									passed = passed and valid_payload
								else:
									selected = selected + 1
									valid_call = match payload.form:
										Concrete.InvokeFunction(call, [argument]):
											match (call.target, argument.form):
												(Concrete.UserFunction(target), Concrete.ReadBinding(read)):
													Concrete.function_number(target) == Concrete.function_number(callback) and Model.binding_number(read) == Model.binding_number(binding)
												_: False
										_: False
									passed = passed and valid_call
							_: passed = False
					_: passed = False
			passed and selected == 1 and skipped == 1
		_: False


private pure func injected_bypass_is_rejected(function: Concrete.ConcreteFunction, callback: Concrete.FunctionInstanceId, bypass: Concrete.VariantInstanceId) -> Bool:
	match function.body:
		Concrete.ConcreteMatchBody(matched):
			match matched.arms:
				[selected, skipped]:
					match (selected.body, skipped.pattern, skipped.body):
						(Concrete.ReturnExpression(value), Concrete.VariantCase(_, captures), Concrete.ReturnExpression(returned)):
							match (value.form, single_capture(captures)):
								(Concrete.ConstructVariant(_, [call]), Some(binding)):
									match call.form:
										Concrete.InvokeFunction(invoked, [_]):
											argument = { call | form = Concrete.ReadBinding(binding) }
											injected = { call | form = Concrete.InvokeFunction(invoked, [argument]) }
											broken = { skipped | body = Concrete.ReturnExpression({ returned | form = Concrete.ConstructVariant(bypass, [injected]) }) }
											not callback_map_contract({ function | body = Concrete.ConcreteMatchBody({ matched | arms = [selected, broken] }) }, callback, bypass)
										_: False
								_: False
						_: False
				_: False
		_: False


private func callback_instance(negative: Bool) -> Result[Bool, String]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-callback-instance-") on error => message(error):
		source: String =
			|import:
			|    result as Results
			|pure func identity[T](value: T) -> T:
			|    value
			|func main() -> Int:
			|    argument: Result[String, String] = Err("error")
			|    probe = identity("probe")
			|    mapped = Results.map(argument, identity)
			|    0
			|
		path = directory.resource_path() + "/main.brp"
		written ?= write_file(path, source)
		loaded ?= load_program(path, "blorp_2/standard_library").map_err(func(failure): failure.diagnostic.message)
		checked ?= check(loaded.program).map_err(pure func(failure): setup_diagnostic(failure).message)
		concrete ?= Concrete.specialize(checked).map_err(pure func(error): error.message)
		rows = Concrete.specialized_contents(concrete)
		main ?= rows.functions.get(Concrete.function_number(entry_function(rows.entrypoint))).to_result("missing main")
		match main.statements:
			[Concrete.InitializeBinding(_, input), Concrete.InitializeBinding(_, probe), Concrete.InitializeBinding(_, mapped)]:
				match (input.form, probe.form, mapped.form):
					(Concrete.ConstructVariant(bypass, [_]), Concrete.InvokeFunction(probed, [_]), Concrete.InvokeFunction(called, [_])):
						match (probed.target, called.target):
							(Concrete.UserFunction(target), Concrete.UserFunction(helper)):
								function ?= rows.functions.get(Concrete.function_number(helper)).to_result("missing library instance")
								layout = rows.unions.get(Concrete.union_number(Concrete.variant_owner(bypass)))
									.map(pure func(row): same_variant_fields(row.variants, [[Concrete.StringType], [Concrete.StringType]])).get_or(False)
								valid = layout and callback_map_contract(function, target, bypass)
								Ok(valid and (not negative or injected_bypass_is_rejected(function, target, bypass)))
							_: Ok(False)
					_: Ok(False)
			_: Ok(False)


func test_library_map_erases_the_callback_and_keeps_direct_identity() -> Bool:
	callback_instance(False).get_or(False)


func test_library_map_count_rejects_a_typed_bypass_invocation() -> Bool:
	callback_instance(True).get_or(False)


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	check(parsed)
		.map_err(setup_diagnostic)


private BOX: String =
	|fixed union Box[T]:
	|	Box(T)
	|pure func box[T](value: T) -> Box[T]:
	|	Box(value)
	|pure func unbox[T](value: Box[T]) -> T:
	|	match value:
	|		Box(payload):
	|			payload
	|


pure func test_box_and_unbox_specialize_from_the_argument() -> Bool:
	main_source: String =
		|func main() -> Int:
		|	unbox(box(7))
		|
	compile(BOX + main_source).is_ok()


pure func test_applied_type_equality_preserves_the_complete_argument_and_owner() -> Bool:
	source: String =
		|fixed union First:
		|	Value
		|fixed union Second:
		|	Item
		|pure func first() -> First:
		|	Value
		|pure func second() -> Second:
		|	Item
		|func main() -> Int:
		|	0
		|

	match checked(source):
		Ok(program):
			match checked_functions(program).functions:
				[first, second, _]:
					match first.signature.return_type.value_type:
						Model.UnionType(first):
							match second.signature.return_type.value_type:
								Model.UnionType(second):
									integer = Model.AppliedUnionType(first, [Model.IntType])
									text = Model.AppliedUnionType(first, [Model.StringType])
									(
										Model.same_type(integer, integer)
										and not Model.same_type(integer, text)
										and not Model.same_type(
											integer,
											Model.UnionType(first),
										)
										and not Model.same_type(
											integer,
											Model.AppliedUnionType(second, [Model.IntType]),
										)
										and not Model.same_type(
											Model.AppliedUnionType(first, [integer]),
											Model.AppliedUnionType(first, [text]),
										)
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private MAIN: String =
	|func main() -> Int:
	|	0
	|


private pure func rejects(
	prefix: String,
	marked: String,
	suffix: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(prefix + marked + suffix):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)


private pure func admits_layout(prefix: String, application: String, suffix: String) -> Bool:
	compile(prefix + application + suffix).is_ok()


pure func test_generic_constructor_checks_its_rigid_payload_once() -> Bool:
	box_source: String =
		|fixed union Box[T]:
		|	Box(T)
		|pure func bad[T](value: T) -> Box[T]:
	rejects(box_source + "\n\t", "Box", "(7)\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(_)):
				True
			_:
				False
	)


