pure func test_generic_union_admits_direct_string_payload() -> Bool:
	match checked("fixed union Box[T]:\n    Box(String)\n" + MAIN):
		Ok(program):
			match checked_functions(program).unions:
				[box, _, _, _]:
					match box.variants.map(pure func(variant): variant.fields):
						[[payload]]:
							Model.same_type(payload.value_type, Model.StringType)
						_: False
				_: False
		Err(_): False


private pure func specialized(source: String) -> Result[Concrete.SpecializedContents, Diagnostic]:
	program ?= checked(source)
	program ?= Concrete.specialize(program)
	Ok(Concrete.specialized_contents(program))


private pure func single_capture(captures: List[Option[Model.BindingId]]) -> Option[Model.BindingId]:
	if captures.length() == 1:
		captures.get(0).and_then(pure func(capture): capture)
	else:
		None


private pure func rigid_pattern(function: Model.CheckedFunction) -> Bool:
	match function.signature.type_parameters:
		[parameter]:
			match function.body:
				Model.CheckedMatchBody(matched):
					match matched.arms:
						[arm]:
							match arm.pattern:
								Model.VariantCase(_, captures):
									match single_capture(captures):
										Some(id):
											match function.bindings:
												[_, payload]:
													Model.binding_number(id) == 1 and Model.same_type(
														payload.value_type,
														Model.ParameterType(parameter),
													) and Model.same_type(
														function.signature.return_type.value_type,
														payload.value_type,
													)
												_:
													False
										None: False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_pattern_payload_uses_the_function_owned_rigid_parameter() -> Bool:
	match checked(BOX + MAIN):
		Ok(program):
			rows = checked_functions(program)

			match rows.unions:
				[declaration, _, _, _]:
					match declaration.type_parameters:
						[union_parameter]:
							match rows.functions:
								[box, unbox, _]:
									match box.signature.type_parameters:
										[box_parameter]:
											match unbox.signature.type_parameters:
												[unbox_parameter]:
													match Model.parameter_owner(union_parameter):
														Model.UnionDeclaration(_):
															(
																not Model.same_parameter(
																	union_parameter,
																	box_parameter,
																)
																and not Model.same_parameter(
																	box_parameter,
																	unbox_parameter,
																)
																and rigid_pattern(unbox)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func construction_owner(function: Concrete.ConcreteFunction) -> Option[Int]:
	match function.body:
		Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
			match value.form:
				Concrete.ConstructVariant(id, []):
					Some(Concrete.union_number(Concrete.variant_owner(id)))
				_:
					None
		_:
			None


-- User function numbers along the receiver chain, innermost call first.
private pure func receiver_targets(value: Concrete.ConcreteExpr) -> List[Int]:
	match value.form:
		Concrete.InvokeFunction(call, arguments):
			inner: List[Int] = match arguments.get(0):
				Some(receiver):
					receiver_targets(receiver)
				None:
					[]

			match call.target:
				Concrete.UserFunction(id):
					inner.append(Concrete.function_number(id))
				_:
					inner
		_:
			[]


private pure func receiver_chain_is(value: Concrete.ConcreteExpr, expected: List[Int]) -> Bool:
	actual = receiver_targets(value)
	var same = IntOps.equals(actual.length(), expected.length())
	var position = 0

	for target in actual:
		match expected.get(position):
			Some(number):
				same = same and IntOps.equals(target, number)
			None:
				same = False

		position = IntOps.add(position, 1)

	same


pure func test_phantom_instances_keep_nominal_arguments_and_reuse_direct_ufcs_requests() -> Bool:
	source: String =
		|fixed union Marker[T]:
		|	Only
		|pure func identity[T](value: T) -> T:
		|	value
		|pure func integer() -> Marker[Int]:
		|	Only
		|pure func text() -> Marker[String]:
		|	Only
		|func main() -> Int:
		|	first = integer().identity().identity()
		|	again = identity(integer())
		|	other = text().identity()
		|	0
		|

	match specialized(source):
		Ok(program):
			match program.unions:
				[first_union, second_union]:
					match first_union.variants:
						[[]]:
							match second_union.variants:
								[[]]:
									match program.functions:
										[main, integer, first_identity, text, second_identity]:
											match main.statements:
												[Concrete.InitializeBinding(_, first), Concrete.InitializeBinding(_, again), Concrete.InitializeBinding(_, other)]:
													match main.bindings:
														[first_binding, again_binding, other_binding]:
															(
																construction_owner(
																	integer,
																) == Some(0)
																and construction_owner(
																	text,
																) == Some(1)
																and not Concrete.same_type(
																	integer.signature.return_type,
																	text.signature.return_type,
																)
																and Concrete.same_type(
																	first_identity.signature.return_type,
																	integer.signature.return_type,
																)
																and Concrete.same_type(
																	second_identity.signature.return_type,
																	text.signature.return_type,
																)
																and receiver_chain_is(first, [1, 2, 2])
																and receiver_chain_is(again, [1, 2])
																and receiver_chain_is(other, [3, 4])
																and Concrete.same_type(
																	first_binding.value_type,
																	integer.signature.return_type,
																)
																and Concrete.same_type(
																	again_binding.value_type,
																	integer.signature.return_type,
																)
																and Concrete.same_type(
																	other_binding.value_type,
																	text.signature.return_type,
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_box_instance_translates_constructor_pattern_and_binding_types() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|    value
		|func main() -> Int:
		|    unbox(identity(box(7)))
		|
	match specialized(BOX + source):
		Ok(program):
			match (program.unions, program.functions):
				([declaration], [_, box, identity, unbox]):
					layout = match declaration.variants:
						[[Concrete.IntType]]: True
						_: False
					match (box.body, unbox.body):
						(Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)), Concrete.ConcreteMatchBody(matched)):
							match (value.form, matched.arms, unbox.bindings):
								(Concrete.ConstructVariant(id, [child]), [arm], [_, payload]):
									match arm.pattern:
										Concrete.VariantCase(pattern, captures):
											match single_capture(captures):
												Some(binding):
													(
														layout
														and Concrete.union_number(Concrete.variant_owner(id)) == 0
														and Concrete.union_number(matched.owner) == 0
														and Concrete.union_number(Concrete.variant_owner(pattern)) == 0
														and Concrete.variant_number(pattern) == Concrete.variant_number(id)
														and Model.binding_number(binding) == 1
														and Concrete.same_type(child.value_type, Concrete.IntType)
														and Concrete.same_type(payload.value_type, Concrete.IntType)
														and Concrete.same_type(unbox.signature.return_type, Concrete.IntType)
														and Concrete.same_type(identity.signature.return_type, box.signature.return_type)
													)
												None: False
										_: False
								_: False
						_: False
				_: False
		Err(_): False

