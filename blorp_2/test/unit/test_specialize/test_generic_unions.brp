import:
	../../../src/utils/names: program_names
	../../../src/check/model as Model
	../../../src/utils/source: module_source, root_module_id
	../../../src/check/check: CheckedProgram, check, checked_functions
	../../../src/check/errors as Errors
	../../../src/lex/lex: lex
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic
	../compilation: compile, compile_modules
	int as IntOps
	../input: check_failure, parse, setup_diagnostic
	../module_input: PRIMITIVE_BASE, STRING_OPERATIONS
	test: TestSuite


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	check(parsed)
		.map_err(setup_diagnostic)


private BOX: String =
	|fixed union Box[T]:
	|	Box(T)
	|pure func box[T](value: T) -> Box[T]:
	|	Box(value)
	|pure func unbox[T](value: Box[T]) -> T:
	|	match value:
	|		Box(payload):
	|			payload
	|


pure func test_box_and_unbox_specialize_from_the_argument() -> Bool:
	main_source: String =
		|func main() -> Int:
		|	unbox(box(7))
		|
	compile(BOX + main_source).is_ok()


pure func test_applied_type_equality_preserves_the_complete_argument_and_owner() -> Bool:
	source: String =
		|fixed union First:
		|	Value
		|fixed union Second:
		|	Value
		|pure func first() -> First:
		|	Value
		|pure func second() -> Second:
		|	Value
		|func main() -> Int:
		|	0
		|

	match checked(source):
		Ok(program):
			match checked_functions(program).functions:
				[first, second, _]:
					match first.signature.return_type.value_type:
						Model.UnionType(first):
							match second.signature.return_type.value_type:
								Model.UnionType(second):
									integer = Model.AppliedUnionType(first, [Model.IntType])
									text = Model.AppliedUnionType(first, [Model.StringType])
									(
										Model.same_type(integer, integer)
										and not Model.same_type(integer, text)
										and not Model.same_type(
											integer,
											Model.UnionType(first),
										)
										and not Model.same_type(
											integer,
											Model.AppliedUnionType(second, [Model.IntType]),
										)
										and not Model.same_type(
											Model.AppliedUnionType(first, [integer]),
											Model.AppliedUnionType(first, [text]),
										)
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private MAIN: String =
	|func main() -> Int:
	|	0
	|


private pure func rejects(
	prefix: String,
	marked: String,
	suffix: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(prefix + marked + suffix):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)


private pure func admits_layout(prefix: String, application: String, suffix: String) -> Bool:
	compile(prefix + application + suffix).is_ok()


pure func test_generic_constructor_checks_its_rigid_payload_once() -> Bool:
	box_source: String =
		|fixed union Box[T]:
		|	Box(T)
		|pure func bad[T](value: T) -> Box[T]:
	rejects(box_source + "\n\t", "Box", "(7)\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_generic_pattern_payload_remains_rigid() -> Bool:
	box_source: String =
		|fixed union Box[T]:
		|	Box(T)
		|pure func bad[T](value: Box[T]) -> Int:
		|	match value:
		|		Box(payload):
	rejects(box_source + "\n\t\t\t", "payload", "\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_constructor_missing_rigid_payload_has_type_correct_help() -> Bool:
	box_source: String =
		|fixed union Box[T]:
		|	Box(T)
		|pure func bad[T](value: T) -> Box[T]:
	rejects(box_source + "\n\t", "Box", "\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ConstructorRejection(Errors.ConstructorFieldCountMismatch(_, 1, 0)):
				True
			_:
				False
	)


pure func test_pattern_missing_rigid_payload_has_type_correct_help() -> Bool:
	box_source: String =
		|fixed union Box[T]:
		|	Box(T)
		|pure func bad[T](value: Box[T]) -> Int:
		|	match value:
	rejects(box_source + "\n\t\t", "Box", ": 0\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.MatchRejection(Errors.PatternFieldCountMismatch(_, 1, 0)):
				True
			_:
				False
	)


pure func test_applied_type_mismatch_renders_the_complete_expected_type() -> Bool:
	p_source: String =
		|fixed union P[T]:
		|	Only
		|pure func wrong(value: P[Int]) -> P[String]:
	rejects(p_source + "\n\t", "value", "\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_concrete_written_string_layout_is_admitted() -> Bool:
	admits_layout(BOX + "pure func bad(value: ", "Box[String]", ") -> Int:\n\t0\n" + MAIN)


pure func test_forwarded_symbolic_string_layout_is_admitted() -> Bool:
	source: String =
		|pure func wrap[T](value: T) -> T:
		|	ignored = box(value)
		|	value
		|pure func middle[U](value: U) -> U:
		|	wrap(value)
		|func main() -> Int:
	compile_modules([
		{ source = ("import:\n    string: length\n" + BOX + source + "\n\t") + "middle" + ("(\"7\").length()\n"), targets = [1] },
		{ source = STRING_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE).is_ok()


pure func test_inferred_binding_string_layout_is_admitted() -> Bool:
	main_source: String =
		|func main() -> Int:
		|	bad =
	admits_layout(BOX + main_source + " ", "box", "(\"7\")\n\t0\n")


pure func test_semantic_nested_application_has_unmanaged_payload_layout() -> Bool:
	main_source: String =
		|func main() -> Int:
		|	bad =
	compile(BOX + main_source + " box(box(7))\n\t0\n").is_ok()


pure func test_wrapping_an_already_typed_nominal_union_compiles() -> Bool:
	source: String =
		|fixed union Value:
		|	Only
		|pure func value() -> Value:
		|	Only
		|func main() -> Int:
		|	bad =
	compile(BOX + source + " box(value())\n\t0\n").is_ok()


pure func test_phantom_string_application_has_no_managed_payload() -> Bool:
	source: String =
		|fixed union Marker[T]:
		|	Only
		|pure func text() -> Marker[String]:
		|	Only
		|func main() -> Int:
		|	value = text()
		|	0
		|
	compile(source).is_ok()


pure func test_generic_union_requires_an_argument() -> Bool:
	box_source: String =
		|fixed union Box[T]:
		|	Box(T)
		|pure func bad(value:
	rejects(box_source + " ", "Box", ") -> Int:\n\t0\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.TypeTermRejection(Errors.MissingUnionTypeArguments(_, 1)):
				True
			_:
				False
	)


pure func test_ordinary_union_rejects_an_argument() -> Bool:
	value_source: String =
		|fixed union Value:
		|	Only
		|pure func bad(value:
	rejects(value_source + " ", "Value[Int]", ") -> Int:\n\t0\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.TypeTermRejection(Errors.OrdinaryUnionApplied(_)):
				True
			_:
				False
	)


pure func test_builtin_type_rejects_application() -> Bool:
