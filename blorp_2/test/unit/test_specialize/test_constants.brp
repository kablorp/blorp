import:
	../../../src/specialize/specialize as Concrete
	../../../src/utils/source: module_source, root_module_id, same_source
	../constant_inputs: TWICE, concrete
	test: TestSuite


pure func test_two_same_type_constants_project_their_own_values() -> Bool:
	source: String =
		|FIRST: Int = 23
		|SECOND: Int = 17
		|func main() -> Int:
		|    first = FIRST
		|    SECOND
		|
	match concrete(source):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[main]:
					match (main.statements, main.body):
						([Concrete.InitializeBinding(_, first)], Concrete.ConcreteValueBody(Concrete.ReturnExpression(second))):
							match (first.form, second.form):
								(Concrete.LiteralInteger(23), Concrete.LiteralInteger(17)): True
								_: False
						_: False
				_: False


pure func test_string_reads_keep_each_use_span_and_decoded_value() -> Bool:
	match concrete(TWICE):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[main]:
					match main.statements:
						[Concrete.InitializeBinding(_, first), Concrete.InitializeBinding(_, second)]:
							match (first.form, second.form):
								(Concrete.LiteralString(left), Concrete.LiteralString(right)):
									prefix = "private UNUSED: String = \"absent\"\nprivate TEXT: String = \"kept λ\"\nfunc main() -> Int:\n    first = "
									second_prefix = prefix + "TEXT\n    second = "
									(left == "kept λ" and right == left
										and first.span.start == prefix.length() and first.span.end == prefix.length() + 4
										and second.span.start == second_prefix.length() and second.span.end == second_prefix.length() + 4
										and same_source(first.span.source, module_source(root_module_id()))
										and same_source(second.span.source, first.span.source))
								_: False
						_: False
				_: False


pure func test_float_constant_projects_an_existing_float_literal() -> Bool:
	source: String =
		|NUMBER: Float = 1.25
		|func main() -> Int:
		|    number = NUMBER
		|    0
		|
	match concrete(source):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[main]:
					match main.statements:
						[Concrete.InitializeBinding(_, value)]:
							match value.form:
								Concrete.LiteralFloat(number): number == 1.25 and Concrete.same_type(value.value_type, Concrete.FloatType)
								_: False
						_: False
				_: False


pure func test_generic_instances_repeat_string_bytes_at_original_use_spans() -> Bool:
	source: String =
		|TEXT: String = "kept λ\0"
		|pure func materialize[T](marker: T) -> String:
		|    first = TEXT
		|    TEXT
		|func main() -> Int:
		|    integer = materialize(0)
		|    floating = materialize(1.25)
		|    0
		|
	match concrete(source):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, integer, floating]:
					match (integer.signature.parameters, floating.signature.parameters):
						([Concrete.IntType], [Concrete.FloatType]):
							var valid = True
							for function in [integer, floating]:
								match (function.signature.return_type, function.statements, function.body):
									(Concrete.StringType, [Concrete.InitializeBinding(_, first)], Concrete.ConcreteValueBody(Concrete.ReturnExpression(second))):
										match (first.value_type, first.form, second.value_type, second.form):
											(Concrete.StringType, Concrete.LiteralString(left), Concrete.StringType, Concrete.LiteralString(right)):
												valid = valid and left == "kept λ\0" and right == left
												valid = valid and Some(first.span.start) == source.index_of("TEXT\n    TEXT") and first.span.end == first.span.start + 4
												valid = valid and Some(second.span.start) == source.index_of("TEXT\nfunc main") and second.span.end == second.span.start + 4
												valid = valid and same_source(first.span.source, module_source(root_module_id())) and same_source(second.span.source, first.span.source)
											_: valid = False
									_: valid = False
							valid
						_: False
				_: False


tests: TestSuite = {
	description = "Constant specialization at each use",
	tests = [
		("same-type constants retain their own values", test_two_same_type_constants_project_their_own_values),
		("String reads keep decoded bytes and each use span", test_string_reads_keep_each_use_span_and_decoded_value),
		("Float constant becomes an ordinary Float literal", test_float_constant_projects_an_existing_float_literal),
		("generic Int/Float instances repeat String bytes and use spans", test_generic_instances_repeat_string_bytes_at_original_use_spans),
	]
}
