import:
	../../../src/check/check: check
	../../../src/specialize/specialize as Concrete
	../test_check/test_traits: parse_concrete_trait_fixture
	int as IntOps
	test: TestSuite


private pure func selected_ordinary_call(value: Concrete.ConcreteExpr) -> Bool:
	match value.form:
		Concrete.Match(matched):
			match matched.scrutinee.form:
				Concrete.InvokeFunction(call, [left, right]):
					match (call.target, left.form, right.form):
						(Concrete.UserFunction(id), Concrete.LiteralInteger(first), Concrete.LiteralInteger(second)):
							IntOps.equals(Concrete.function_number(id), 1) and IntOps.equals(first, 7) and IntOps.equals(second, 7)
						_: False
				_: False
		_: False


pure func test_accepted_method_selects_an_ordinary_body_instance() -> Bool:
	match parse_concrete_trait_fixture():
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Err(_): False
				Ok(checked):
					match Concrete.specialize(checked):
						Err(_): False
						Ok(specialized):
							match Concrete.specialized_contents(specialized).functions:
								[main, implementation]:
									match main.body:
										Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
											selected_ordinary_call(value) and implementation.signature.parameters.length() == 2 and Concrete.same_type(main.signature.return_type, Concrete.IntType)
										_: False
								_: False


tests: TestSuite = {
	description = "Blorp 2 concrete trait specialization",
	tests = [("accepted method selects an ordinary body instance", test_accepted_method_selects_an_ordinary_body_instance)]
}
