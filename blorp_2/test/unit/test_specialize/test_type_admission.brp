import:
	../../../src/check/check as API
	../../../src/check/errors as Errors
	../../../src/check/render: render_failure
	../../../src/check/model as Model
	../../../src/check/declarations: occurrence_fields, substitute_type, validate_declarations, validate_finite_declarations
	../../../src/utils/ids as Declaration
	../../../src/parse/assemble: parsed_contents
	../../../src/lex/lex: lex
	../../../src/utils/names: same_name, program_names
	../../../src/namespace/namespace: build_namespace
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/specialize/specialize: specialize
	../input: check_failure, checked_source, parse, existing_name
	test: TestSuite


private pure func publishes(source: String, matches: pure (Model.CheckedFunctions) -> Bool) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names).and_then(parse):
		Err(_): False
		Ok(parsed):
			match API.check(parsed):
				Err(_): False
				Ok(accepted):
					issued = parsed_contents(parsed).declarations
					facts = API.checked_functions(accepted)
					(
						Declaration.inventory_records(issued).map(pure func(row): Declaration.record_number(row.id)) == facts.records.map(pure func(row): Declaration.record_number(row.id))
						and Declaration.inventory_unions(issued).map(pure func(row): Declaration.union_number(row.id)) == facts.unions.map(pure func(row): Declaration.union_number(row.id))
						and Declaration.inventory_functions(issued).map(pure func(row): Declaration.function_number(row.id)) == facts.functions.map(pure func(row): Declaration.function_number(row.id))
						and matches(facts) and specialize(accepted).is_ok()
					)


private pure func list_record(declaration: Model.CheckedRecord) -> Bool:
	match declaration.type_parameters:
		[parameter]:
			match declaration.fields:
				[field]:
					(
						Model.same_owner(Model.parameter_owner(parameter), Model.RecordDeclaration(declaration.id))
						and Model.parameter_position(parameter) == 0
						and Model.same_type(field.value_type.value_type, Model.ListType(Model.ParameterType(parameter)))
					)
				_: False
		_: False


private pure func list_union(declaration: Model.CheckedUnion) -> Bool:
	match declaration.type_parameters:
		[parameter]:
			match declaration.variants:
				[empty, items]:
					match items.fields:
						[field]:
							(
								Model.same_owner(Model.parameter_owner(parameter), Model.UnionDeclaration(declaration.id))
								and Model.parameter_position(parameter) == 0 and empty.fields.is_empty()
								and Model.same_type(field.value_type, Model.ListType(Model.ParameterType(parameter)))
							)
						_: False
				_: False
		_: False


private pure func record_parameter(source: String, element: Model.TypeRef, start: Int, end: Int) -> Bool:
	publishes(source, pure func(facts):
		match facts.records:
			[values]:
				match facts.functions.get(0):
					Some(function):
						match function.signature.parameters:
							[parameter]:
								(
									list_record(values) and Model.same_type(parameter.value_type, Model.AppliedRecordType(values.id, [element]))
									and same_source(parameter.span.source, module_source(root_module_id()))
									and parameter.span.start == start and parameter.span.end == end
								)
							_: False
					_: False
			_: False
	)


private pure func integer_call(value: Model.CheckedExpr, callee: Declaration.FunctionId, expected: Model.TypeRef) -> Bool:
	match value.form:
		Model.InvokeFunction(call, [argument]):
			match call.target:
				Model.UserFunction(actual, [element], []):
					(
						Declaration.function_number(actual) == Declaration.function_number(callee)
						and Model.same_type(element, Model.IntType) and Model.same_type(argument.value_type, Model.IntType)
						and Model.same_type(value.value_type, expected)
					)
				_: False
		_: False


private pure func unknown_value(source: String, start: Int, end: Int) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names).and_then(parse):
		Err(_): False
		Ok(parsed):
			match API.check(parsed):
				Ok(_): False
				Err(failure):
					errors = API.check_errors(failure)
					diagnostics = render_failure(failure)
					typed = match errors.first.kind:
						Errors.ValueRejection(Errors.UnknownValue(name)):
							match existing_name(parsed_contents(parsed).names, "missing"):
								Some(expected): same_name(name, expected)
								None: False
						_: False
					(
						typed and errors.remaining.is_empty() and diagnostics.remaining.is_empty()
						and same_source(errors.first.span.source, module_source(root_module_id()))
						and errors.first.span.start == start and errors.first.span.end == end
						and diagnostics.first.span.start == start and diagnostics.first.span.end == end
						and same_source(diagnostics.first.span.source, errors.first.span.source)
						and diagnostics.first.message == "unknown value"
						and diagnostics.first.help == "use this function's parameter name, a declared variant, or a call"
						and diagnostics.first.note.is_none()
					)


private pure func accepts(source: String) -> Bool:
	checked_source(source).and_then(specialize).is_ok()


-- Exercise the declaration producer and its sealed consumer directly. No
-- signatures or bodies are checked, and the record identity comes from the
-- issued declaration row rather than an unchecked ordinal constructor.
pure func test_forward_declarations_publish_complete_fields_before_body_checking() -> Bool:
	source: String =
		|fixed record Outer[T] { child: Values[T] }
		|fixed record Values[T] { items: List[T] }
		|func unused(value: Outer[Int]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	match lex(module_source(root_module_id()), source, program_names().names).and_then(parse):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			match build_namespace(program):
				Err(_): False
				Ok(namespace):
					match validate_declarations(parsed, namespace):
						Err(_): False
						Ok(declarations):
							match Declaration.inventory_records(parsed.declarations):
								[outer_row, values_row]:
									match declarations.records:
										[outer, values]:
											match outer.type_parameters:
												[outer_parameter]:
													match values.type_parameters:
														[values_parameter]:
															match outer.fields:
																[child]:
																	(
																		Declaration.record_number(outer.id) == Declaration.record_number(outer_row.id)
																		and Declaration.record_number(values.id) == Declaration.record_number(values_row.id)
																		and Model.same_owner(Model.parameter_owner(outer_parameter), Model.RecordDeclaration(outer_row.id))
																		and Model.same_owner(Model.parameter_owner(values_parameter), Model.RecordDeclaration(values_row.id))
																		and Model.parameter_position(outer_parameter) == 0 and Model.parameter_position(values_parameter) == 0
																		and not Model.same_parameter(outer_parameter, values_parameter)
																		and Model.same_type(child.value_type.value_type, Model.AppliedRecordType(values_row.id, [Model.ParameterType(outer_parameter)]))
																		and Model.field_number(child.id) == 0 and list_record(values)
																		and validate_finite_declarations(declarations).is_ok()
																	)
																_: False
														_: False
												_: False
										_: False
								_: False


pure func test_two_list_fields_keep_distinct_element_parameters() -> Bool:
	source: String =
		|fixed record Both[A, B] { first: List[A], second: List[B] }
		|func unused(value: Both[String, Int]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	publishes(source, pure func(facts):
		match facts.records:
			[both]:
				match facts.functions.get(0):
					Some(function):
						match both.type_parameters:
							[first_parameter, second_parameter]:
								match both.fields:
									[first, second]:
										match function.signature.parameters:
											[input]:
												(
													Model.parameter_position(first_parameter) == 0 and Model.parameter_position(second_parameter) == 1
													and not Model.same_parameter(first_parameter, second_parameter)
													and Model.same_type(first.value_type.value_type, Model.ListType(Model.ParameterType(first_parameter)))
													and Model.same_type(second.value_type.value_type, Model.ListType(Model.ParameterType(second_parameter)))
													and Model.same_type(input.value_type, Model.AppliedRecordType(both.id, [Model.StringType, Model.IntType]))
													and input.span.start == 79 and input.span.end == 96
												)
											_: False
									_: False
							_: False
					_: False
			_: False
	)


pure func test_finite_cycle_rejection_still_precedes_body_checking() -> Bool:
	source: String =
		|fixed record Node[T] { next: Node[T], items: List[T] }
		|func unused(value: Node[Int]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	typed = match check_failure(source):
		Some(error):
			match error.kind:
				Errors.TypeDeclarationRejection(Errors.RecursiveAggregateType(_)):
					error.span.start == 29 and error.span.end == 36
				_: False
		None: False
	match checked_source(source):
		Ok(_): False
		Err(error):
			(
				typed and error.message == "recursive aggregate types are not supported yet"
				and error.help == "use finite record and union fields; recursion is supported through a record field, a List element or one direct self payload of a non-generic union, such as Next(Node)"
				and error.span.start == 29 and error.span.end == 36
			)


pure func test_nested_and_later_list_fields_keep_complete_arguments() -> Bool:
	source: String =
		|fixed record Values[T] { items: List[T] }
		|fixed record Marker[T] { value: Int }
		|fixed record Bad { first: Marker[Values[Int]], second: Values[Float] }
		|func main() -> Int:
		|    0
		|
	publishes(source, pure func(facts):
		match facts.records:
			[values, marker, parent]:
				match parent.fields:
					[first, second]:
						(
							list_record(values)
							and Model.same_type(first.value_type.value_type, Model.AppliedRecordType(marker.id, [Model.AppliedRecordType(values.id, [Model.IntType])]))
							and Model.same_type(second.value_type.value_type, Model.AppliedRecordType(values.id, [Model.FloatType]))
							and first.value_type.span.start == 106 and first.value_type.span.end == 125
						)
					_: False
			_: False
	)


pure func test_unknown_later_child_precedes_deferred_nominal_inference() -> Bool:
	source: String =
		|fixed union Values[T]:
		|    Empty
		|    Items(List[T])
		|pure func make[T](value: T) -> Values[T]:
		|    Empty
		|pure func outer[T](left: T, right: Int) -> Int:
		|    0
		|func main() -> Int:
		|    outer(make(1), missing)
		|
	typed = match check_failure(source):
		Some(error):
			match error.kind:
				Errors.ValueRejection(Errors.UnknownValue(_)):
					error.span.start == 197 and error.span.end == 204
				_: False
		None: False
	match checked_source(source):
		Ok(_): False
		Err(error):
			(
				typed and error.message == "unknown value"
				and error.help == "use this function's parameter name, a declared variant, or a call"
				and error.span.start == 197 and error.span.end == 204
			)


