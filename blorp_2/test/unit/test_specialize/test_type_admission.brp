pure func test_inferred_call_result_keeps_int_list_substitution() -> Bool:
	source: String =
		|fixed union Values[T]:
		|    Empty
		|    Items(List[T])
		|pure func make[T](value: T) -> Values[T]:
		|    Empty
		|func main() -> Int:
		|    saved = make(1)
		|    0
		|
	publishes(source, pure func(facts):
		match facts.unions:
			[values, _, _, _]:
				match facts.functions:
					[make, caller]:
						match caller.statements:
							[Model.InitializeBinding(_, value)]:
								(
									list_union(values) and integer_call(value, make.id, Model.AppliedUnionType(values.id, [Model.IntType]))
									and value.span.start == 136 and value.span.end == 143
								)
							_: False
					_: False
			_: False
	)


