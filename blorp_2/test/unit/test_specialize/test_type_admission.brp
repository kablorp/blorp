pure func test_nested_record_application_keeps_list_parameter_identity() -> Bool:
	source: String =
		|fixed record Values[T] { items: List[T] }
		|fixed record Outer[T] { child: Values[T] }
		|func unused(value: Outer[Int]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	publishes(source, pure func(facts):
		match facts.records:
			[values, outer]:
				match facts.functions.get(0):
					Some(function):
						match outer.type_parameters:
							[parameter]:
								match outer.fields:
									[child]:
										match function.signature.parameters:
											[input]:
												(
													list_record(values)
													and Model.same_type(child.value_type.value_type, Model.AppliedRecordType(values.id, [Model.ParameterType(parameter)]))
													and Model.same_type(input.value_type, Model.AppliedRecordType(outer.id, [Model.IntType]))
													and input.span.start == 104 and input.span.end == 114
												)
											_: False
									_: False
							_: False
					_: False
			_: False
	)


private pure func remapped_union_fields(
	owner: Declaration.RecordId,
	child: Model.TypeUse,
	fields: List[Model.TypeUse],
) -> Bool:
	match substitute_type(child.value_type, { owner = Model.RecordDeclaration(owner), values = [Model.FloatType] }, child.span):
		Err(_): False
		Ok(replaced):
			match Model.union_occurrence(replaced):
				None: False
				Some(occurrence):
					match occurrence_fields(fields, occurrence):
						Ok([field]): Model.same_type(field.value_type, Model.ListType(Model.FloatType))
						_: False


pure func test_union_list_element_is_remapped_by_parameter_position() -> Bool:
	source: String =
		|fixed union Values[A, B]:
		|    Empty
		|    Items(List[B])
		|fixed record Outer[T] { child: Values[Int, T] }
		|func unused(value: Outer[Float]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	publishes(source, pure func(facts):
		match facts.records:
			[outer]:
				match facts.unions:
					[values, _, _, _]:
						match facts.functions.get(0):
							Some(function):
								match values.type_parameters:
									[first, second]:
										match outer.type_parameters:
											[parameter]:
												match outer.fields:
													[child]:
														match values.variants:
															[empty, items]:
																match function.signature.parameters:
																	[input]:
																		match items.fields:
																			[field]:
																				(
																					Model.parameter_position(first) == 0 and Model.parameter_position(second) == 1 and empty.fields.is_empty()
																					and Model.same_type(field.value_type, Model.ListType(Model.ParameterType(second)))
																					and Model.same_type(child.value_type.value_type, Model.AppliedUnionType(values.id, [Model.IntType, Model.ParameterType(parameter)]))
																					and Model.same_type(input.value_type, Model.AppliedRecordType(outer.id, [Model.FloatType]))
																					and remapped_union_fields(outer.id, child.value_type, items.fields)
																					and input.span.start == 122 and input.span.end == 134
																				)
																			_: False
																	_: False
															_: False
													_: False
											_: False
									_: False
							_: False
					_: False
			_: False
	)


