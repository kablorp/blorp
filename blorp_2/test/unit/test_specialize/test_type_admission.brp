pure func test_unused_string_record_instance_is_accepted() -> Bool:
	source: String =
		|fixed record Values[T] { items: List[T] }
		|func unused(value: Values[String]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	accepts(source)


pure func test_string_union_instance_includes_unselected_variant_fields() -> Bool:
	source: String =
		|fixed union Values[T]:
		|    Empty
		|    Items(List[T])
		|pure func make() -> Values[String]:
		|    Empty
		|func main() -> Int:
		|    saved = make()
		|    0
		|
	accepts(source)


pure func test_symbolic_record_list_element_remains_valid() -> Bool:
	source: String =
		|fixed record Values[T] { items: List[T] }
		|pure func identity[T](value: Values[T]) -> Values[T]:
		|    value
		|func main() -> Int:
		|    0
		|
	accepts(source)


pure func test_symbolic_union_list_element_remains_valid() -> Bool:
	source: String =
		|fixed union Values[T]:
		|    Empty
		|    Items(List[T])
		|pure func identity[T](value: Values[T]) -> Values[T]:
		|    value
		|func main() -> Int:
		|    0
		|
	accepts(source)


pure func test_record_void_payload_is_valid() -> Bool:
	source: String =
		|fixed record Box[T] { value: T }
		|pure func boxed() -> Box[Void]:
		|    { value = void }
		|func main() -> Int:
		|    saved = boxed()
		|    0
		|
	accepts(source)


pure func test_pure_function_can_return_union_containing_void() -> Bool:
	source: String =
		|fixed union Maybe[T]:
		|    None
		|    Some(T)
		|pure func make() -> Maybe[Void]:
		|    Some(void)
		|func main() -> Int:
		|    saved = make()
		|    0
		|
	accepts(source)


pure func test_phantom_int_parameter_is_unconstrained() -> Bool:
	source: String =
		|fixed record Marker[T] { value: Int }
		|pure func make() -> Marker[Int]:
		|    { value = 7 }
		|func main() -> Int:
		|    make().value
		|
	accepts(source)


pure func test_phantom_void_parameter_is_unconstrained() -> Bool:
	source: String =
		|fixed record Marker[T] { value: Int }
		|pure func make() -> Marker[Void]:
		|    { value = 7 }
		|func main() -> Int:
		|    make().value
		|
	accepts(source)


pure func test_remapped_second_parameter_accepts_string() -> Bool:
	source: String =
		|fixed union Values[A, B]:
		|    Empty
		|    Items(List[B])
		|fixed record Outer[T] { child: Values[Int, T] }
		|func unused(value: Outer[String]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	accepts(source)


pure func test_generic_string_forwarding_keeps_terminal_caller_parameters() -> Bool:
	source: String =
		|fixed union Values[T]:
		|    Empty
		|    Items(List[T])
		|pure func make[T](value: T) -> Values[T]:
		|    Empty
		|pure func forward[T](value: T) -> Values[T]:
		|    make(value)
		|func main() -> Int:
		|    saved = forward("valid")
		|    0
		|
	accepts(source)


pure func test_two_string_list_fields_are_accepted() -> Bool:
	source: String =
		|fixed record Both[A, B] { first: List[A], second: List[B] }
		|func unused(value: Both[String, String]) -> Int:
		|    0
		|func main() -> Int:
		|    0
		|
	accepts(source)


pure func test_repeated_nominal_children_preserve_one_parameter_fact() -> Bool:
	source: String =
		|fixed record Values[T] { items: List[T] }
		|fixed record Pair[T] { left: Values[T], right: Values[T] }
		|fixed union Choice[T]:
		|    Empty
		|    Full(Pair[T], Values[T])
		|pure func make() -> Choice[String]:
		|    Empty
		|func main() -> Int:
		|    saved = make()
		|    0
		|
	accepts(source)


tests: TestSuite = {
	description = "Blorp 2 complete aggregate element types",
	tests = [
		("forward declarations publish complete fields before bodies", test_forward_declarations_publish_complete_fields_before_body_checking),
		("two List fields keep distinct element parameters", test_two_list_fields_keep_distinct_element_parameters),
		("finite cycle still rejects before bodies", test_finite_cycle_rejection_still_precedes_body_checking),
		("nested and later fields retain complete arguments", test_nested_and_later_list_fields_keep_complete_arguments),
		("unknown later child precedes deferred nominal inference", test_unknown_later_child_precedes_deferred_nominal_inference),
		("unused record parameter retains Int List application", test_unused_record_parameter_keeps_int_list_application),
		("unused union parameter retains Int List application", test_unused_union_parameter_keeps_int_list_application),
		("unused return retains Int List application", test_unused_return_keeps_int_list_application),
		("record field retains concrete Int List child", test_record_field_keeps_concrete_int_list_child),
		("union field retains concrete Int List child", test_union_field_keeps_concrete_int_list_child),
		("nested record application preserves parameter identity", test_nested_record_application_keeps_list_parameter_identity),
		("union List element remaps by parameter position", test_union_list_element_is_remapped_by_parameter_position),
		("phantom argument retains nested Int List type", test_phantom_outer_argument_retains_nested_int_list_type),
		("List type argument retains nested element", test_list_type_argument_keeps_nested_list_element),
		("Void is a complete List element", test_void_argument_is_a_complete_list_element),
		("inferred call retains Int List substitution", test_inferred_call_result_keeps_int_list_substitution),
		("forwarded call retains Int List substitution", test_forwarded_call_result_keeps_int_list_substitution),
		("unused body retains generic call substitution", test_generic_call_in_unused_body_keeps_int_list_substitution),
		("inferred call retains nested phantom List argument", test_inferred_call_keeps_nested_phantom_list_argument),
		("valid Int List annotation still checks unknown body", test_valid_int_list_annotation_still_checks_unknown_body_value),
		("unused String record accepted", test_unused_string_record_instance_is_accepted),
		("String union checks every variant field", test_string_union_instance_includes_unselected_variant_fields),
		("symbolic record List element accepted", test_symbolic_record_list_element_remains_valid),
		("symbolic union List element accepted", test_symbolic_union_list_element_remains_valid),
		("record Void payload accepted", test_record_void_payload_is_valid),
		("pure union containing Void accepted", test_pure_function_can_return_union_containing_void),
		("phantom Int remains unconstrained", test_phantom_int_parameter_is_unconstrained),
		("phantom Void remains unconstrained", test_phantom_void_parameter_is_unconstrained),
		("second parameter accepts String after remap", test_remapped_second_parameter_accepts_string),
		("generic String forwarding accepted", test_generic_string_forwarding_keeps_terminal_caller_parameters),
		("two String List fields accepted", test_two_string_list_fields_are_accepted),
		("repeated nominal children retain one parameter fact", test_repeated_nominal_children_preserve_one_parameter_fact),
	]
}
