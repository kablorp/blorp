pure func test_structural_conflict_keeps_first_candidate_and_annotation_origin() -> Bool:
	source: String =
		|Marker[A])->B:
		|	b
		|func main() -> Int:
		|	first(
	annotation_prefix: String =
		|fixed union Marker[T]:
		|	Only
		|pure func integer()->Marker[Int]:
		|	Only
		|pure func text()->Marker[String]:
		|	Only
		|pure func first[A,B](a:Marker[A],b:B,agree:Marker[A],bad:
	declarations = annotation_prefix + source
	prefix = declarations + "integer(), 7, integer(), "

	match check_failure(prefix + "text())\n"):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
					match conflict.mismatch.expected:
						Model.AppliedUnionType(expected_owner, [Model.IntType]):
							match conflict.mismatch.actual.value_type:
								Model.AppliedUnionType(actual_owner, [Model.StringType]):
									match conflict.mismatch.expected_site:
										Errors.SourceAnnotation(annotation):
											(
												parameter_is(conflict.parameter, 2, 0)
												and conflict.mismatch.argument_position == 3
												and Declaration.union_number(expected_owner) == 0
												and Declaration.union_number(actual_owner) == 0
												and Model.same_type(
													conflict.previous.value_type,
													Model.IntType,
												)
												and Model.same_type(
													conflict.current.value_type,
													Model.StringType,
												)
												and conflict.previous.span.start == declarations.length()
												and conflict.previous.span.end == declarations.length() + 9
												and error.span.start == prefix.length()
												and error.span.end == prefix.length() + 6
												and same_span(conflict.current.span, error.span)
												and same_span(conflict.mismatch.actual.span, error.span)
												and annotation.end == annotation_prefix.length() + 9
												and annotation.start == annotation_prefix.length()
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		None:
			False


private pure func forwards_to(function: Concrete.ConcreteFunction, expected: Int) -> Bool:
	match function.body:
		Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
			concrete_target(value) == Some(expected)
		_:
			False


pure func test_forwarding_substitution_is_permuted_and_caller_owned() -> Bool:
	forwarding_source: String =
		|pure func forward[Left,Right](left:Left,right:Right)->Left:
		|	second(right,left)
		|func main() -> Int:
		|	saved = forward("42",7)
		|	0
		|
	source = SECOND + forwarding_source

	match checked(source):
		Ok(program):
			match checked_functions(program).functions:
				[second, forward, _]:
					match forward.signature.type_parameters:
						[left, right]:
							match forward.body:
								Model.CheckedValueBody(Model.ReturnExpression(value)):
									match arguments(value):
										Some([Model.ParameterType(first), Model.ParameterType(last)]):
											match Concrete.specialize(program):
												Ok(concrete):
													match Concrete.specialized_contents(
														concrete,
													).functions:
														[_, concrete_forward, concrete_second]:
															match concrete_forward.signature.parameters:
																[Concrete.StringType, Concrete.IntType]:
																	match concrete_second.signature.parameters:
																		[Concrete.IntType, Concrete.StringType]:
																			(
																				parameter_is(
																					first,
																					1,
																					1,
																				)
																				and parameter_is(
																					last,
																					1,
																					0,
																				)
																				and Model.same_parameter(
																					first,
																					right,
																				)
																				and Model.same_parameter(
																					last,
																					left,
																				)
																				and forwards_to(
																					concrete_forward,
																					2,
																				)
																				and Concrete.same_type(
																					concrete_second.signature.return_type,
																					Concrete.StringType,
																				)
																				and Concrete.same_type(
																					concrete_forward.signature.return_type,
																					Concrete.StringType,
																				)
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func concrete_target(value: Concrete.ConcreteExpr) -> Option[Int]:
	match value.form:
		Concrete.InvokeFunction(call, _):
			match call.target:
				Concrete.UserFunction(id):
					Some(Concrete.function_number(id))
				_:
					None
		_:
			None


pure func test_unused_later_parameter_still_distinguishes_instance_keys() -> Bool:
	source: String =
		|pure func first[A,B](a:A,b:B)->A:
		|	a
		|func main() -> Int:
		|	a = first(7,8)
		|	b = first(7,"8")
		|	c = first(9,10)
		|	d = first(9,"10")
		|	0
		|

	match specialized(source):
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[main, integer, text]:
					match main.statements:
						[Concrete.InitializeBinding(_, a), Concrete.InitializeBinding(_, b), Concrete.InitializeBinding(_, c), Concrete.InitializeBinding(_, d)]:
							match integer.signature.parameters:
								[Concrete.IntType, Concrete.IntType]:
									match text.signature.parameters:
										[Concrete.IntType, Concrete.StringType]:
											(
												concrete_target(a) == Some(1)
												and concrete_target(b) == Some(2)
												and concrete_target(c) == Some(1)
												and concrete_target(d) == Some(2)
												and Concrete.same_type(
													integer.signature.return_type,
													Concrete.IntType,
												)
												and Concrete.same_type(
													integer.signature.return_type,
													text.signature.return_type,
												)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func parser_rejects(
	prefix: String,
	marked: String,
	suffix: String,
	message: String,
	help: String,
) -> Bool:
	match lex(module_source(root_module_id()), prefix + marked + suffix, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and error.message == message
				and error.help == help
			)
		Ok(_):
			False


pure func test_malformed_parameter_lists_have_exact_parser_diagnostics() -> Bool:
	name_help = "declare type parameters separated by commas, such as [A, B]"
	close_help = "separate type parameters with commas and close the list with ']'"
	(
		parser_rejects(
			"func f[",
			"]",
			"()->Int:\n\t0\n",
			"expected a type parameter name",
			name_help,
		)
		and parser_rejects(
			"func f[A,",
			",",
			"B]()->Int:\n\t0\n",
			"expected a type parameter name",
			name_help,
		)
		and parser_rejects(
			"func f[A ",
			"B",
			"]()->Int:\n\t0\n",
			"expected ',' or ']' after a type parameter",
			close_help,
		)
		and parser_rejects(
			"func f[A",
			"",
			"",
			"expected ',' or ']' after a type parameter",
			close_help,
		)
	)


pure func test_union_parameter_headers_accept_multiple_names() -> Bool:
	pair_source: String =
		|fixed union Pair[A,B]:
		|	Only
		|
	checked(pair_source + MAIN).is_ok()


pure func test_ordered_calls_and_instances_preserve_int_string_permutation() -> Bool:
	main_source: String =
		|func main() -> Int:
		|	first = second(7,"8")
		|	second_value = "8".second(7)
		|	second_value
		|

	match checked(SECOND + main_source):
		Ok(program):
			match checked_functions(program).functions:
				[_, main]:
					match main.statements:
						[Model.InitializeBinding(_, first), Model.InitializeBinding(_, second)]:
							match (arguments(first), second.form):
								(Some([Model.IntType, Model.StringType]), Model.InvokeFunction(call, _)):
									match call.target:
										Model.UserFunction(_, [Model.StringType, Model.IntType]):
											match Concrete.specialize(program):
												Ok(concrete):
													match Concrete.specialized_contents(
														concrete,
													).functions:
														[_, first, second]:
															(
																Concrete.same_type(
																	first.signature.return_type,
																	Concrete.StringType,
																)
																and Concrete.same_type(
																	second.signature.return_type,
																	Concrete.IntType,
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_duplicate_renderer_uses_typed_error_without_rechecking() -> Bool:
	match lex(module_source(root_module_id()), SECOND + MAIN, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			match check(parsed):
				Ok(program):
					match checked_functions(program).functions:
						[function, _]:
							match function.signature.type_parameters:
								[first, second]:
									primary: Span = {
										source = module_source(root_module_id()),
										start = 26,
										end = 27
									}
									error: Errors.CheckError = {
										span = primary,
										kind = Errors.TypeDeclarationRejection(Errors.DuplicateTypeParameter(
											second,
											first,
											{
												source = module_source(root_module_id()),
												start = 23,
												end = 24
											},
										))
									}
									rendered = Renderer.render_check_error(parsed, error)
									(
										same_span(rendered.span, primary)
										and not rendered.note.is_some()
										and rendered.message == "duplicate type parameter name"
										and rendered.help == "choose a distinct name for each type parameter, such as A and B"
									)
								_:
									False
						_:
							False
				Err(_):
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Multiple function type parameters",
	tests = [
		("binding without context keeps later parameter uninferred", test_binding_without_context_keeps_a_later_parameter_uninferred),
		(
			"two parameters accept independent int and string arguments",
			test_two_parameters_accept_independent_int_and_string_arguments,
		),
