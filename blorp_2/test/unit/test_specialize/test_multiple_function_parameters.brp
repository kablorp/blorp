import:
	../../../src/utils/names: program_names
	../../../src/check/model as Model
	../../../src/utils/ids as Declaration
	../../../src/utils/source: module_source, root_module_id
	../../../src/check/check: CheckedProgram, check, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/render as Renderer
	../../../src/lex/lex: lex
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, Span, same_span
	../input: check_failure, parse, setup_diagnostic, check_modules_failure
	../module_input: PRIMITIVE_BASE, INTEGER_OPERATIONS
	test: TestSuite


private CHOICE: String =
	|fixed union Choice:
	|	Number(Int)
	|


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	check(parsed)
		.map_err(setup_diagnostic)


pure func test_two_parameters_accept_independent_int_and_string_arguments() -> Bool:
	source: String =
		|pure func second[A, B](first: A, second_value: B) -> B:
		|	second_value
		|func main() -> Int:
		|	saved = second(7, "42")
		|	0
		|
	checked(source).is_ok()


pure func test_generic_explicit_concrete_annotation_supplies_constructor_hint() -> Bool:
	source: String =
		|pure func receiver[T](choice: Choice, value: T) -> T:
		|	value
		|func main() -> Int:
		|	receiver(Number(8), 7)
		|
	checked(CHOICE + source).is_ok()


pure func test_unique_generic_concrete_receiver_supplies_constructor_hint() -> Bool:
	source: String =
		|pure func receiver[T](choice: Choice, value: T) -> T:
		|    value
		|func main() -> Int:
		|    Number(8).receiver(7)
		|
	checked(CHOICE + source).is_ok()


private MAIN: String =
	|func main() -> Int:
	|	0
	|

private SECOND: String =
	|pure func second[A, B](first: A, second_value: B) -> B:
	|	second_value
	|


private pure func parameter_is(id: Model.TypeParameterId, owner: Int, position: Int) -> Bool:
	match Model.parameter_owner(id):
		Model.FunctionDeclaration(function):
			(
				Declaration.function_number(function) == owner
				and Model.parameter_position(id) == position
			)
		_:
			False


private pure func arguments(value: Model.CheckedExpr) -> Option[List[Model.TypeRef]]:
	match value.form:
		Model.InvokeFunction(call, _):
			match call.target:
				Model.UserFunction(_, arguments):
					Some(arguments)
				_:
					None
		_:
			None


private pure func specialized(source: String) -> Result[Concrete.SpecializedProgram, Diagnostic]:
	program ?= checked(source)
	Concrete.specialize(program)


pure func test_three_parameters_reach_concrete_signatures_and_bindings() -> Bool:
	call_source: String =
		|pure func choice() -> Choice:
		|	Number(7)
		|pure func third[A,B,C](first:A,second:B,third_value:C)->C:
		|	saved = third_value
		|	saved
		|func main() -> Int:
		|	saved = third(7, "8", choice())
		|	0
		|
	source = CHOICE + call_source

	match checked(source):
		Ok(program):
			match checked_functions(program).functions:
				[_, third, main]:
					match third.signature.type_parameters:
						[first, second, last]:
							match main.statements:
								[Model.InitializeBinding(_, value)]:
									match arguments(value):
										Some([Model.IntType, Model.StringType, Model.UnionType(owner)]):
											match Concrete.specialize(program):
												Ok(concrete):
													match Concrete.specialized_contents(
														concrete,
													).functions:
														[_, choice, instance]:
															match instance.signature.parameters:
																[Concrete.IntType, Concrete.StringType, nominal]:
																	match instance.bindings:
																		[_, _, parameter, saved]:
																			(
																				parameter_is(
																					first,
																					1,
																					0,
																				)
																				and parameter_is(
																					second,
																					1,
																					1,
																				)
																				and parameter_is(
																					last,
																					1,
																					2,
																				)
																				and not Model.same_parameter(
																					first,
																					last,
																				)
																				and Declaration.union_number(
																					owner,
																				) == 0
																				and Concrete.same_type(
																					nominal,
																					choice.signature.return_type,
																				)
																				and Concrete.same_type(
																					instance.signature.return_type,
																					nominal,
																				)
																				and Concrete.same_type(
																					parameter.value_type,
																					nominal,
																				)
																				and Concrete.same_type(
																					saved.value_type,
																					nominal,
																				)
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_unused_body_keeps_distinct_rigid_parameter_positions() -> Bool:
	prefix = "pure func bad[A,B](first:A,second:B)->A:\n\t"

	match check_failure(prefix + "second\n" + MAIN):
		Some(error):
			match error.kind:
				Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
					match mismatch.expected:
						Model.ParameterType(first):
							match mismatch.actual.value_type:
								Model.ParameterType(second):
									(
										parameter_is(first, 0, 0)
										and parameter_is(second, 0, 1)
										and not Model.same_parameter(first, second)
										and error.span.start == prefix.length()
										and error.span.end == prefix.length() + 6
										and same_span(mismatch.actual.span, error.span)
									)
								_:
									False
						_:
							False
				_:
					False
		None:
			False


pure func test_duplicate_parameters_are_owned_semantic_errors() -> Bool:
	declaration_source: String =
		|A](value:A)->A:
		|	value
		|
	prefix = "pure func bad[A, B, "

	match check_failure(prefix + declaration_source + MAIN):
		Some(error):
			match error.kind:
				Errors.TypeDeclarationRejection(Errors.DuplicateTypeParameter(current, previous, first)):
					(
						parameter_is(current, 0, 2)
						and parameter_is(previous, 0, 0)
						and not Model.same_parameter(current, previous)
						and first.start == 14
						and first.end == 15
						and error.span.start == prefix.length()
						and error.span.end == prefix.length() + 1
					)
				_:
					False
		None:
			False


pure func test_first_missing_parameter_precedes_an_ordinary_mismatch() -> Bool:
	prefix_source: String =
		|import:
		|    int: to_string
		|pure func first[A,B,C](ordinary:Int,value:A)->A:
		|	value
		|func main() -> Int:
	prefix = prefix_source + "\n\t"

	match check_modules_failure([
		{ source = prefix + "first(8.to_string(), 7)\n", targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.UninferableTypeParameter(parameter)):
					(
						parameter_is(parameter, 0, 1)
						and error.span.start == prefix.length()
						and error.span.end == prefix.length() + 5
					)
				_:
					False
		None:
			False


pure func test_expected_result_completes_a_later_parameter() -> Bool:
	source: String =
		|fixed union Phantom[T]:
		|    Empty
		|pure func empty[A,B](value:A)->Phantom[B]:
		|    Empty
		|pure func use()->Phantom[Int]:
		|    empty(7)
		|
	match checked(source + MAIN):
		Ok(program):
			match checked_functions(program).functions.get(1):
				Some(function):
					match function.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.InvokeFunction(call, [_]):
									match call.target:
										Model.UserFunction(owner, [Model.IntType, Model.IntType]): Declaration.function_number(owner) == 0
										_: False
								_: False
						_: False
				None: False
		Err(_): False


pure func test_binding_without_context_keeps_a_later_parameter_uninferred() -> Bool:
	prefix_source: String =
		|fixed union Phantom[T]:
		|	Empty
		|pure func empty[A,B](value:A)->Phantom[B]:
		|	Empty
		|pure func use()->Int:
	prefix = prefix_source + "\n\tvalue = "

	match check_failure(prefix + "empty(7)\n\t0\n" + MAIN):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.UninferableTypeParameter(parameter)):
					(
						parameter_is(parameter, 0, 1)
						and error.span.start == prefix.length()
						and error.span.end == prefix.length() + 5
					)
				_:
					False
		None:
			False


pure func test_runtime_order_selects_conflict_across_parameters() -> Bool:
	prefix_source: String =
		|import:
		|    int: to_string
		|pure func first[A,B](a:A,b:B,again_b:B,again_a:A)->A:
		|	a
		|func main() -> Int:
		|	first(7,
	prefix = prefix_source + " "

	match check_modules_failure([
		{ source = prefix + "8.to_string(), 9, 10.to_string())\n", targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
					(
						parameter_is(conflict.parameter, 0, 1)
						and conflict.mismatch.argument_position == 2
						and Model.same_type(conflict.previous.value_type, Model.StringType)
						and Model.same_type(conflict.current.value_type, Model.IntType)
						and conflict.previous.span.start == prefix.length()
						and conflict.previous.span.end == prefix.length() + 13
						and error.span.start == prefix.length() + 15
						and error.span.end == prefix.length() + 16
						and same_span(conflict.current.span, error.span)
						and same_span(conflict.mismatch.actual.span, error.span)
					)
				_:
					False
		None:
			False


