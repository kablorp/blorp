	prefix_source: String =
		|import:
		|    int: to_string
		|pure func first[A,B](ordinary:Int,a:A,again:A,b:B)->A:
		|	a
		|func main() -> Int:
		|	first(1.to_string(), 7,
	prefix = prefix_source + " "

	match check_modules_failure([
		{ source = prefix + "8.to_string(), 9)\n", targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
					(
						parameter_is(conflict.parameter, 0, 0)
						and conflict.mismatch.argument_position == 2
						and Model.same_type(conflict.previous.value_type, Model.IntType)
						and Model.same_type(conflict.current.value_type, Model.StringType)
						and error.span.start == prefix.length()
						and error.span.end == prefix.length() + 13
					)
				_:
					False
		None:
			False


pure func test_unknown_later_child_precedes_generic_conflict() -> Bool:
	prefix_source: String =
		|import:
		|    int: to_string
		|pure func first[A,B](a:A,again:A,b:B)->A:
		|	a
		|func main() -> Int:
		|	first(7, 8.to_string(),
	prefix = prefix_source + " "

	match check_modules_failure([
		{ source = prefix + "missing)\n", targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE):
		Some(error):
			match error.kind:
				Errors.ValueRejection(Errors.UnknownValue(_)):
					error.span.start == prefix.length() and error.span.end == prefix.length() + 7
