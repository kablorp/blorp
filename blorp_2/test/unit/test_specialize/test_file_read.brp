import:
	../../../src/specialize/specialize as Concrete
	../file_read_inputs: checked_file_read, file_read_seed
	../module_input: test_base
	test: TestSuite


pure func test_result_strings_have_inline_owning_storage() -> Bool:
	match checked_file_read(test_base()).and_then(Concrete.specialize):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).unions:
				[layout]:
					match (Concrete.union_variants(layout), layout):
						([[Concrete.StringType], [Concrete.StringType]], Concrete.OwningCases(_)): True
						_: False
				_: False


pure func test_reversed_result_order_preserves_constructor_roles() -> Bool:
	foundation = { test_base() | types = test_base().types.replace("    Ok(Value)\n    Err(Error)", "    Err(Error)\n    Ok(Value)") }
	match file_read_seed(foundation):
		Err(_): False
		Ok(seed):
			Concrete.variant_number(seed.constructors.ok) == 1 and Concrete.variant_number(seed.constructors.err) == 0


tests: TestSuite = {
	description = "Blorp 2 file-read specialization",
	tests = [
		("Result String fields own inline storage", test_result_strings_have_inline_owning_storage),
		("reversed Result order preserves roles", test_reversed_result_order_preserves_constructor_roles),
	]
}
