import:
	../../../src/check/check: check
	../../../src/check/model: BindingOrigin(ParameterBinding), binding_number
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../input: setup_diagnostic
	../module_input: parse_modules
	../direct_string_concat_inputs: CONCAT_DECLARATION, DIRECT_CONCAT, RECEIVER_CONCAT
	test: TestSuite


private pure func concat_specialization_preserves_typed_operands(source: String) -> Bool:
	match parse_modules([{ source = CONCAT_DECLARATION + source, targets = [] }])
		.and_then(pure func(parsed): check(parsed).map_err(setup_diagnostic))
		.and_then(Concrete.specialize):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, function]:
					match (function.signature.parameters, function.signature.return_type, function.body):
						([Concrete.StringType, Concrete.StringType], Concrete.StringType, Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
							match value.form:
								Concrete.InvokeFunction(call, [left, right]):
									match (call.target, left.form, right.form):
										(Concrete.RuntimeFunction(Builtins.StringConcat), Concrete.ReadBinding(left_id), Concrete.ReadBinding(right_id)):
											match (function.bindings.get(binding_number(left_id)), function.bindings.get(binding_number(right_id))):
												(Some(left_binding), Some(right_binding)):
													match (left_binding.origin, right_binding.origin):
														(ParameterBinding(0), ParameterBinding(1)):
															value.value_type == Concrete.StringType and left.value_type == Concrete.StringType and right.value_type == Concrete.StringType
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 String concat specialization",
	tests = [
		("direct source call keeps operation and parameter order", pure func(): concat_specialization_preserves_typed_operands(DIRECT_CONCAT)),
		("UFCS source call keeps operation and parameter order", pure func(): concat_specialization_preserves_typed_operands(RECEIVER_CONCAT)),
	]
}
