import:
	../../src/lower:
		LoweredExit(ReturnValue, RecurValues),
		LoweredFunction,
		LoweredTail(ExitValue, MatchValue),
		MatchLabel(DefaultLabel),
		ValueOperation(ParameterValue),
		value_number,
	../../src/own:
		OwnedExit(RecurArguments),
		OwnedTail(ReturnTail),
		OwnershipOperation(DefineValue),
		ResultOwnership(UnmanagedResult),
		exit_last_uses,
		insert_function,
	../../src/prelude as Prelude: RuntimeOperation(IntToString)
	../../src/specialize: TypeRef(IntType, StringType, UnionType)
	../../src/syntax: Diagnostic, FunctionExecution(SelfTailLoop), same_span
	ownership_inputs: InputIds, input_ids, integer, parameter, runtime, span
	test: TestSuite


private pure func unmanaged(result: ResultOwnership) -> Bool:
	match result:
		UnmanagedResult:
			True
		_:
			False


private pure func uses_equal(
	result: Result[List[Option[Int]], Diagnostic],
	expected: List[Option[Int]],
) -> Bool:
	match result:
		Ok(uses):
			uses == expected
		Err(_):
			False


private pure func loop(ids: InputIds) -> LoweredFunction:
	{
		execution = SelfTailLoop(span(90)),
		signature = {
			parameters = [IntType, IntType],
			return_type = IntType
		},
		definitions = [
			parameter(ids.first, IntType),
			{ parameter(ids.second, IntType) | operation = ParameterValue(1) },
		],
		tail = ExitValue(
			RecurValues(
				[ids.second, ids.first],
				span(80),
			),
		)
	}


pure func test_permuted_arguments_remain_unmanaged() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match insert_function(loop(ids), ids.unions, []):
				Err(_):
					False
				Ok(owned):
					match owned.operations:
						[DefineValue(first), DefineValue(second)]:
							match owned.tail:
								ReturnTail(RecurArguments([left, right], occurrence)):
									(
										unmanaged(first.result)
										and unmanaged(second.result)
										and value_number(left) == 1
										and value_number(right) == 0
										and same_span(occurrence, span(80))
									)
								_:
									False
						_:
							False


pure func test_duplicate_operands_have_terminal_use() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			definitions = loop(ids).definitions.append(integer(ids.third, 7, 30))
			uses_equal(
				exit_last_uses(
					definitions,
					RecurValues(
						[ids.first, ids.first],
						span(80),
					),
					0,
					0,
				),
				[Some(3), None, None],
			)


pure func test_permutation_operands_have_terminal_uses() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			definitions = loop(ids).definitions.append(integer(ids.third, 7, 30))
			uses_equal(
				exit_last_uses(
					definitions,
					RecurValues(
						[ids.second, ids.first],
						span(80),
					),
					0,
					0,
				),
				[Some(3), Some(3), None],
			)


pure func test_arm_capture_has_terminal_use() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			uses_equal(
				exit_last_uses(
					[integer(ids.third, 7, 30)],
					RecurValues(
						[ids.first, ids.third],
						span(80),
					),
					2,
					2,
				),
				[Some(1)],
			)


pure func test_zero_argument_backedge_has_no_result() -> Bool:
	function: LoweredFunction = {
		execution = SelfTailLoop(span(90)),
		signature = {
			parameters = [],
			return_type = IntType
		},
		definitions = [],
		tail = ExitValue(RecurValues([], span(80)))
	}

	match insert_function(function, [], []):
		Err(_):
			False
		Ok(owned):
			match owned.tail:
				ReturnTail(RecurArguments([], occurrence)):
					owned.operations.length() == 0 and same_span(occurrence, span(80)) and uses_equal(
						exit_last_uses(
							[],
							RecurValues([], span(80)),
							0,
							0,
						),
						[],
					)
				_:
					False


private pure func rejects_managed(function: LoweredFunction, ids: InputIds, start: Int) -> Bool:
	match insert_function(function, ids.unions, []):
		Ok(_):
			False
		Err(error):
			(
				same_span(error.span, span(start))
				and error.message == "managed values in @tail_recursive functions are not supported yet"
				and error.help == "use an unmanaged helper, or remove @tail_recursive"
			)


pure func test_managed_signature_rejects_at_annotation() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects_managed(
				{ original |
					signature = { original.signature | parameters = [StringType, IntType] }
				},
				ids,
				90,
			)


pure func test_managed_result_rejects_at_annotation() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects_managed(
				{ original | signature = { original.signature | return_type = StringType } },
				ids,
				90,
			)


pure func test_unused_managed_initializer_rejects_at_definition() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects_managed(
				{ original |
					definitions = original.definitions.append(
						runtime(
							ids.third,
							Prelude.IntToString,
							[ids.first],
							StringType,
							30,
						),
					)
				},
				ids,
				30,
			)


pure func test_managed_arm_initializer_rejects_at_definition() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			union_type = UnionType(ids.union_id)
			rejects_managed(
				{ original |
					signature = { original.signature | parameters = [union_type, IntType] },
					definitions = [
						parameter(ids.first, union_type),
						{ parameter(ids.second, IntType) | operation = ParameterValue(1) },
					],
					tail = MatchValue({
						scrutinee = ids.first,
						owner = ids.union_id,
						arms = [
							{
								label = DefaultLabel,
								body = {
									definitions = [
										runtime(
											ids.third,
											Prelude.IntToString,
											[ids.second],
											StringType,
											30,
										),
									],
									exit = RecurValues(
										[ids.first, ids.second],
										span(80),
									)
								}
							},
						],
					})
				},
				ids,
				30,
			)


tests: TestSuite = {
	description = "Unmanaged recursive backedge ownership",
	tests = [
		(
			"permuted arguments have no owners or fictitious result",
			test_permuted_arguments_remain_unmanaged,
		),
		("duplicate operands have a terminal use", test_duplicate_operands_have_terminal_use),
		(
			"permuted operands each have a terminal use",
			test_permutation_operands_have_terminal_uses,
		),
		("arm capture has a terminal use", test_arm_capture_has_terminal_use),
		("zero-argument backedge has no result", test_zero_argument_backedge_has_no_result),
		(
			"managed signature diagnostic at annotation",
			test_managed_signature_rejects_at_annotation,
		),
		("managed result diagnostic at annotation", test_managed_result_rejects_at_annotation),
		(
			"unused managed initializer diagnostic at definition",
			test_unused_managed_initializer_rejects_at_definition,
		),
		(
			"managed arm initializer diagnostic at definition",
			test_managed_arm_initializer_rejects_at_definition,
		),
	]
}
