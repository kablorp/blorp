import:
	../../src/lex: lex
	../../src/names:
		NameId,
		NameTable,
		find_name,
		initial_names,
		intern_name,
		name_spelling,
		same_name,
	../../src/parse: parse, parsed_contents
	../../src/syntax:
		ExpressionBase(NameExpression),
		ParameterList(SingleParameter),
		ParsedBody(ParsedValueBody),
		ParsedFunction,
	option: is_none
	test: TestSuite


private pure func base_of(function: ParsedFunction) -> Option[ExpressionBase]:
	match function.body:
		ParsedValueBody(value):
			Some(value.base)
		_:
			None


private pure func same_found(left: Option[NameId], right: Option[NameId]) -> Bool:
	match left:
		None:
			False
		Some(left):
			match right:
				None:
					False
				Some(right):
					same_name(left, right)


private pure func spells(names: NameTable, id: Option[NameId], expected: String) -> Bool:
	match id:
		None:
			False
		Some(id):
			name_spelling(names, id) == Some(expected)


pure func test_canonical_names_share_the_interning_authority() -> Bool:
	initial = initial_names()
	names = intern_name(
		intern_name(initial.names, "main"),
		"Int",
	)
	same_found(
		find_name(names, "main"),
		Some(initial.special.main),
	) and same_found(
		find_name(names, "Int"),
		Some(initial.special.integer),
	) and name_spelling(
		names,
		initial.special.main,
	) == Some("main") and name_spelling(names, initial.special.integer) == Some("Int")


pure func test_repeated_spelling_has_one_identity() -> Bool:
	initial = initial_names()
	first = intern_name(initial.names, "identity")
	repeated = intern_name(first, "identity")
	case_variant = intern_name(repeated, "Identity")
	prefix_variant = intern_name(case_variant, "identity_more")
	same_found(
		find_name(first, "identity"),
		find_name(repeated, "identity"),
	) and not same_found(
		find_name(first, "identity"),
		find_name(case_variant, "Identity"),
	) and not same_found(
		find_name(first, "identity"),
		find_name(prefix_variant, "identity_more"),
	) and same_found(
		find_name(case_variant, "Identity"),
		find_name(
			intern_name(first, "Identity"),
			"Identity",
		),
	) and spells(
		prefix_variant,
		find_name(prefix_variant, "identity"),
		"identity",
	) and spells(
		prefix_variant,
		find_name(prefix_variant, "Identity"),
		"Identity",
	) and spells(
		prefix_variant,
		find_name(prefix_variant, "identity_more"),
		"identity_more",
	)


pure func test_independent_extensions_keep_their_own_spellings() -> Bool:
	seed = initial_names()
	left = intern_name(seed.names, "left")
	right = intern_name(seed.names, "right")

	match find_name(left, "left"):
		None:
			False
		Some(left_id):
			name_spelling(left, left_id) == Some("left") and spells(
				right,
				find_name(right, "right"),
				"right",
			) and name_spelling(seed.names, left_id) == None and find_name(right, "left").is_none()


pure func test_parser_shares_identity_across_roles_but_preserves_spans() -> Bool:
	match lex("func Int(Int: Int) -> Int:\n\tInt\n"):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					program = parsed_contents(parsed)
					integer = program.special.integer

					match program.functions:
						[function]:
							match function.parameters:
								SingleParameter(parameter):
									match base_of(function):
										Some(NameExpression(value)):
											(
												same_name(function.function_name.id, integer)
												and same_name(parameter.name.id, integer)
												and same_name(parameter.type_name.id, integer)
												and same_name(function.return_type.id, integer)
												and same_name(value.id, integer)
												and function.function_name.span.start == 5
												and function.function_name.span.end == 8
												and parameter.name.span.start == 9
												and parameter.name.span.end == 12
												and parameter.type_name.span.start == 14
												and parameter.type_name.span.end == 17
												and function.return_type.span.start == 22
												and function.return_type.span.end == 25
												and value.span.start == 28
												and value.span.end == 31
											)
										_:
											False
								_:
									False
						_:
							False


tests: TestSuite = {
	description = "Blorp 2 name identities",
	tests = [
		(
			"parser shares identity across roles but preserves spans",
			test_parser_shares_identity_across_roles_but_preserves_spans,
		),
		(
			"canonical names share the interning authority",
			test_canonical_names_share_the_interning_authority,
		),
		("repeated spelling has one identity", test_repeated_spelling_has_one_identity),
		(
			"independent extensions keep their own spellings",
			test_independent_extensions_keep_their_own_spellings,
		),
	]
}
