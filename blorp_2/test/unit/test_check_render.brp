import:
	../../src/source: module_source, root_module_id
	../../src/check: check, check_errors, union_declaration_id
	../../src/check_errors as Errors
	../../src/check_render as Renderer
	../../src/lex: lex
	../../src/assemble: ParsedProgram
	../../src/syntax: Diagnostic, Span, same_span
	../../src/text: concat
	input: parse
	test: TestSuite


private pure func parsed(source: String) -> Result[ParsedProgram, Diagnostic]:
	lex(module_source(root_module_id()), source).and_then(pure func(tokens): parse(tokens))


private pure func span(start: Int, end: Int) -> Span:
	{
		source = module_source(root_module_id()),
		start = start,
		end = end
	}


pure func test_failure_retains_original_parsed_authority() -> Bool:
	unrelated_source: String =
		|fixed union Substitute:
		|	SubstituteValue
		|func main() -> Int:
		|	0
		|
	prefix_source: String =
		|fixed union Original:
		|	OriginalValue
		|pure func accept(value: Original) -> Int:
		|	0
		|func main() -> Int:
	prefix = prefix_source + "\n\t"

	match parsed(prefix.concat("accept(7)\n")):
		Err(_):
			False
		Ok(program):
			match check(program):
				Ok(_):
					False
				Err(failure):
					match parsed(unrelated_source):
						Err(_):
							False
						Ok(unrelated):
							diagnostics = Renderer.render_failure(failure)
							other = Renderer.render_check_errors(
								unrelated,
								check_errors(failure),
							)
							(
								same_span(diagnostics.first.span, span(prefix.length(), prefix.length() + 6))
								and diagnostics.first.note.is_none()
								and diagnostics.first.message == "argument type does not match the parameter type"
								and diagnostics.first.help == "use an expression of type Original here"
								and diagnostics.remaining.is_empty()
								and other.first.help == "use an expression of type Substitute here"
							)


pure func test_error_uses_supplied_frozen_arity() -> Bool:
	source: String =
		|fixed union Pair[A, B]:
		|	PairValue
		|func main() -> Int:
		|	0
		|

	match parsed(source):
		Err(_):
			False
		Ok(program):
			match check(program):
				Err(_):
					False
				Ok(checked):
					match union_declaration_id(checked, 0):
						None:
							False
						Some(owner):
							diagnostic = Renderer.render_check_error(
								program,
								{
									span = span(3, 14),
									kind = Errors.TypeTermRejection(Errors.UnionTypeArgumentCountMismatch(owner, 4, 3))
								},
							)
							(
								same_span(diagnostic.span, span(3, 14))
								and diagnostic.note.is_none()
								and diagnostic.message == "union type argument count does not match its declaration"
								and diagnostic.help == "expected 4 type arguments, got 3; supply types in declaration order"
							)


pure func test_collection_retains_order_spans_help_and_notes() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|

	match parsed(source):
		Err(_):
			False
		Ok(program):
			diagnostics = Renderer.render_check_errors(
				program,
				{
					first = {
						span = span(0, 4),
						kind = Errors.SignatureRejection(Errors.MissingMain)
					},
					remaining = [
						{
							span = span(8, 12),
							kind = Errors.RecursionRejection(Errors.GrowingRecursiveInstantiation)
						},
						{
							span = span(16, 20),
							kind = Errors.MatchRejection(Errors.UnreachableArm)
						},
					]
				},
			)

			match diagnostics.remaining:
				[second, third]:
					(
						same_span(diagnostics.first.span, span(0, 4))
						and diagnostics.first.note.is_none()
						and diagnostics.first.message == "expected a main function"
						and diagnostics.first.help == "declare func main() -> Int: as the entrypoint"
						and same_span(second.span, span(8, 12))
						and second.note.is_none()
						and second.message == "recursive calls grow type arguments without bound"
						and second.help == (
							"pass recursive type arguments unchanged, permute them, or reset them to "
							+ "concrete types"
						)
						and same_span(third.span, span(16, 20))
						and third.note.is_none()
						and third.message == "match arm is unreachable"
						and third.help == "remove this arm; earlier arms already cover all values it could match"
					)
				_:
					False


tests: TestSuite = {
	description = "Blorp 2 checker diagnostic rendering boundary",
	tests = [
		(
			"failure retains original parsed authority",
			test_failure_retains_original_parsed_authority,
		),
		("error uses supplied frozen arity", test_error_uses_supplied_frozen_arity),
		(
			"collection retains order spans help and notes",
			test_collection_retains_order_spans_help_and_notes,
		),
	]
}
