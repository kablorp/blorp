import:
	../../../src/utils/names: contextual_words, program_names, same_name
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax:
		Visibility(Public),
		ExpressionBase(IntegerExpression),
		LexedProgram,
		ParsedBinding,
		ParsedMatchArm,
		ParsedPattern(PatternWildcard),
		ParsedStatement(BindingStatement),
		ParsedUnion,
		ParsedVariant,
		Purity(Pure, Impure),
		Spacing(Adjacent),
		Span,
		Token,
		TokenKind(IdentifierToken),
		ValueExpression,
		WrittenName,
		TypeSyntax(AtomicType), type_span,
		same_purity,
	int as IntOps
	bool: and, not
	test: TestSuite


pure func test_token_update_preserves_original_payload_and_span() -> Bool:
	seed = program_names()
	other = contextual_words(seed.names).fixed_word
	original: Token = {
		kind = IdentifierToken(seed.main),
		span = {
			source = module_source(root_module_id()),
			start = 5,
			end = 9
		},
		spacing = Adjacent
	}
	changed: Token = { original | kind = IdentifierToken(other) }

	match original.kind:
		IdentifierToken(name):
			match changed.kind:
				IdentifierToken(changed_name):
					and(same_name(name, seed.main), and(
						same_name(changed_name, other),
						and(IntOps.equals(original.span.start, 5), and(
							IntOps.equals(original.span.end, 9),
							and(IntOps.equals(changed.span.start, 5), IntOps.equals(changed.span.end, 9)),
						)),
					))
				_:
					False
		_:
			False


pure func test_published_tokens_are_independent_of_local_builder() -> Bool:
	seed = program_names()
	first: Token = {
		kind = IdentifierToken(seed.main),
		span = {
			source = module_source(root_module_id()),
			start = 0,
			end = 4
		},
		spacing = Adjacent
	}
	var builder: List[Token] = [first]
	published: LexedProgram = {
		source_text = "main",
		tokens = builder,
		end = {
			source = module_source(root_module_id()),
			start = 4,
			end = 4
		},
		base_names = seed.names,
		names = seed.names
	}
	builder = builder.append({
		kind = IdentifierToken(seed.main),
		span = {
			source = module_source(root_module_id()),
			start = 5,
			end = 9
		},
		spacing = Adjacent,
	})
	and(IntOps.equals(published.tokens.length(), 1), and(
		IntOps.equals(builder.length(), 2),
		and(IntOps.equals(published.end.start, 4), IntOps.equals(published.end.end, 4)),
	))


pure func test_union_publication_and_expression_updates_preserve_original() -> Bool:
	name: WrittenName = {
		id = program_names().main,
		span = {
			source = module_source(root_module_id()),
			start = 12,
			end = 15
		}
	}
	variant: ParsedVariant = {
		name = name,
		fields = []
	}
	var variants: List[ParsedVariant] = [variant]
	published: ParsedUnion = {
		module = root_module_id(),
		visibility = Public,
		type_name = name,
		type_parameters = [],
		variants = variants
	}
	variants = variants.append(
		{ variant |
			fields = [AtomicType(name)],
			name = { name | span = {
					source = module_source(root_module_id()),
					start = 20,
					end = 23
				} }
		},
	)
	original: ValueExpression = {
		base = IntegerExpression(42),
		base_span = {
			source = module_source(root_module_id()),
			start = 21,
			end = 23
		},
		applications = [],
		span = {
			source = module_source(root_module_id()),
			start = 21,
			end = 23
		}
	}
	changed: ValueExpression = { original | base = IntegerExpression(-42) }

	payloads_unchanged = match published.variants:
		[first]:
			match first.fields:
				[]:
					match variants:
						[_, second]:
							match second.fields:
								[field]:
									and(IntOps.equals(type_span(field).start, 12), IntOps.equals(type_span(field).end, 15))
								_:
									False
						_:
							False
				_:
					False
		_:
			False

	match original.base:
		IntegerExpression(original_value):
			match changed.base:
				IntegerExpression(changed_value):
					if and(IntOps.equals(original_value, 42), and(IntOps.equals(changed_value, -42), payloads_unchanged)):
						match published.variants.get(0):
							Some(first):
								and(IntOps.equals(published.variants.length(), 1), and(
									IntOps.equals(variants.length(), 2),
									and(IntOps.equals(first.name.span.start, 12), and(
										IntOps.equals(original.span.start, 21),
										and(IntOps.equals(original.span.end, 23), and(
											IntOps.equals(changed.span.start, 21), IntOps.equals(changed.span.end, 23),
										)),
									)),
								))
							None: False
					else:
						False
				_:
					False
		_:
			False


pure func test_arm_binding_publication_is_independent_of_builder() -> Bool:
	span: Span = {
		source = module_source(root_module_id()),
		start = 10,
		end = 12
	}
	value: ValueExpression = {
		base = IntegerExpression(42),
		base_span = span,
		applications = [],
		span = span
	}
	binding: ParsedBinding = {
		name = {
			id = program_names().main,
			span = span
		},
		annotation = None,
		mutable = True,
		initializer = value
	}
	var bindings: List[ParsedBinding] = [binding]
	arm: ParsedMatchArm = {
		pattern = PatternWildcard(span),
		block = {
			statements = bindings.map(pure func(item): BindingStatement(item)),
			value = Some(value),
			span = span
		},
		span = span
	}
	bindings = bindings.append(binding)
	and(IntOps.equals(arm.block.statements.length(), 1), and(IntOps.equals(bindings.length(), 2), IntOps.equals(arm.block.span.start, 10)))


pure func test_purity_equality_covers_each_variant_pair() -> Bool:
	and(same_purity(Pure, Pure), and(
		same_purity(Impure, Impure),
		and(same_purity(Pure, Impure).not(), same_purity(Impure, Pure).not()),
	))


tests: TestSuite = {
	description = "Blorp 2 syntax data",
	tests = [
		("purity equality covers each pair", test_purity_equality_covers_each_variant_pair),
		(
			"arm bindings publish independently of builder",
			test_arm_binding_publication_is_independent_of_builder,
		),
		(
			"published union and updated expression preserve original",
			test_union_publication_and_expression_updates_preserve_original,
		),
		("token update preserves original", test_token_update_preserves_original_payload_and_span),
		(
			"published tokens are independent of builder",
			test_published_tokens_are_independent_of_local_builder,
		),
	]
}
