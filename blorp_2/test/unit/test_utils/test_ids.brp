import:
	../../../src/utils/ids:
		NominalRow(RecordDeclarationRow, UnionDeclarationRow),
		function_number,
		inventory_functions,
		inventory_records,
		inventory_unions,
		issue_inventory,
		next_nominal,
		record_number,
		union_number,
		variant_number,
		variant_owner,
	../../../src/utils/source: module_number
	../declaration_inputs: sample_inventory
	test: TestSuite


pure func test_declaration_ordinals_retain_their_identity_domain() -> Bool:
	inventory = sample_inventory()
	match (inventory_functions(inventory), inventory_records(inventory), inventory_unions(inventory)):
		([_, _, _, function], [_, _, record_row, _], [_, union_row, _, _, _]):
			function_number(function.id) == 3 and record_number(record_row.id) == 2 and union_number(union_row.id) == 1
		_: False


pure func test_variant_identity_retains_owner_and_position() -> Bool:
	match inventory_unions(sample_inventory()):
		[_, _, _, _, owner]:
			match owner.variants:
				[_, _, variant]:
					union_number(variant_owner(variant.id)) == 4 and variant_number(variant.id) == 2
				_: False
		_: False


pure func test_inventory_is_dense_in_each_domain_across_modules() -> Bool:
	inventory = sample_inventory()
	functions = inventory_functions(inventory)
	records = inventory_records(inventory)
	unions = inventory_unions(inventory)
	var variants_correct = True
	for row in unions:
		variants_correct = (
			variants_correct
			and row.variants.map(pure func(variant): variant_number(variant.id)) == [0, 1, 2]
			and row.variants.all(pure func(variant): union_number(variant_owner(variant.id)) == union_number(row.id))
		)
	correct = (
		functions.map(pure func(row): function_number(row.id)) == [0, 1, 2, 3]
		and records.map(pure func(row): record_number(row.id)) == [0, 1, 2, 3]
		and unions.map(pure func(row): union_number(row.id)) == [0, 1, 2, 3, 4]
		and variants_correct
	)
	match (functions.get(2), records.get(2), unions.get(2)):
		(Some(function), Some(record_row), Some(union_row)):
			correct and module_number(function.declaration.module) == 2 and module_number(record_row.declaration.module) == 2 and module_number(union_row.module) == 2
		_: False


pure func test_empty_inventory_has_no_rows_or_nominal_successor() -> Bool:
	inventory = issue_inventory([], [], [], [])
	inventory_functions(inventory).is_empty() and inventory_records(inventory).is_empty() and inventory_unions(inventory).is_empty() and next_nominal(inventory, 0, 0).is_none()


pure func test_nominal_projection_preserves_module_and_source_order() -> Bool:
	inventory = sample_inventory()
	var records_seen = 0
	var unions_seen = 0
	var sequence: List[String] = []
	for _ in 0..9:
		match next_nominal(inventory, records_seen, unions_seen):
			Some(RecordDeclarationRow(row)):
				sequence = sequence.append("record" + record_number(row.id).to_string())
				records_seen = records_seen + 1
			Some(UnionDeclarationRow(row)):
				sequence = sequence.append("union" + union_number(row.id).to_string())
				unions_seen = unions_seen + 1
			None: sequence = sequence.append("missing")
	sequence == ["record0", "union0", "record1", "union1", "union2", "record2", "union3", "record3", "union4"] and next_nominal(inventory, records_seen, unions_seen).is_none()


tests: TestSuite = {
	description = "Blorp 2 declaration identities",
	tests = [
		("declaration ordinals retain their identity domain", test_declaration_ordinals_retain_their_identity_domain),
		("variant identity retains owner and position", test_variant_identity_retains_owner_and_position),
		("inventory is dense across modules and domains", test_inventory_is_dense_in_each_domain_across_modules),
		("empty inventory has no rows or successor", test_empty_inventory_has_no_rows_or_nominal_successor),
		("nominal projection preserves module and source order", test_nominal_projection_preserves_module_and_source_order),
	]
}
