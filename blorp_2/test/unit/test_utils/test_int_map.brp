import:
	../../../src/utils/int_map as IntMaps
	int as IntOps
	string as StringOps
	bool: and
	option: is_none
	test: TestSuite


private pure func with_keys(map: IntMaps.IntMap[String], added: List[Int]) -> IntMaps.IntMap[String]:
	var result = map
	for key in added:
		result = IntMaps.set(result, key, key.to_string())
	result


-- `map` holds exactly `expected`, each key with its own spelling as its value.
private pure func holds_each(map: IntMaps.IntMap[String], expected: List[Int]) -> Bool:
	var valid: Bool = IntOps.equals(IntMaps.values(map).length(), expected.length())
	for key in expected:
		if valid:
			valid = match IntMaps.get(map, key):
				Some(value): StringOps.equals(value, key.to_string())
				None: False
	valid


private pure func counting(count: Int) -> List[Int]:
	var result: List[Int] = []
	var key: Int = 0
	while IntOps.less_than(key, count):
		result = result.append(key)
		key = IntOps.add(key, 1)
	result


-- Keys 0..count-1 in a scrambled but fixed order (37 is coprime to 101).
private pure func scrambled(count: Int) -> List[Int]:
	var result: List[Int] = []
	var step: Int = 0
	while IntOps.less_than(step, count):
		result = result.append(IntOps.remainder(IntOps.multiply(step, 37), 101))
		step = IntOps.add(step, 1)
	result


pure func test_an_empty_map_holds_nothing() -> Bool:
	map: IntMaps.IntMap[String] = IntMaps.empty_int_map()
	and(IntMaps.values(map).is_empty(), IntMaps.get(map, 0).is_none())


pure func test_set_then_get_returns_each_value() -> Bool:
	holds_each(with_keys(IntMaps.empty_int_map(), [1, 2, 3]), [1, 2, 3])


pure func test_replacing_a_key_keeps_one_entry() -> Bool:
	map = IntMaps.set(with_keys(IntMaps.empty_int_map(), [1, 2, 3]), 2, "two")
	if IntOps.equals(IntMaps.values(map).length(), 3):
		match (IntMaps.get(map, 2), IntMaps.get(map, 3)):
			(Some("two"), Some("3")): True
			_: False
	else:
		False


-- 100 keys pass through five doublings of the index (8 to 256 slots).
pure func test_every_key_survives_several_growths() -> Bool:
	holds_each(with_keys(IntMaps.empty_int_map(), counting(100)), counting(100))


-- The fourth insertion precedes the first growth; 100 insertions pass five
-- growths. Replace the second key before them and the third key afterwards.
pure func test_growth_and_replacement_preserve_insertion_order() -> Bool:
	order = scrambled(100)
	var map: IntMaps.IntMap[String] = IntMaps.empty_int_map()
	for key in order:
		map = IntMaps.set(map, key, key.to_string())
		if IntOps.equals(key, 10):
			map = IntMaps.set(map, 37, "before growth")
	map = IntMaps.set(map, 74, "after growth")
	var expected: List[String] = []
	var associated: Bool = True
	for key in order:
		value = if IntOps.equals(key, 37):
			"before growth"
		else if IntOps.equals(key, 74):
			"after growth"
		else:
			key.to_string()
		expected = expected.append(value)
		if associated:
			associated = match IntMaps.get(map, key):
				Some(actual): StringOps.equals(actual, value)
				None: False
	actual = IntMaps.values(map)
	var ordered: Bool = IntOps.equals(actual.length(), expected.length())
	var position: Int = 0
	while IntOps.less_than(position, expected.length()):
		if ordered:
			ordered = match (actual.get(position), expected.get(position)):
				(Some(left), Some(right)): StringOps.equals(left, right)
				_: False
		position = IntOps.add(position, 1)
	if ordered:
		associated
	else:
		False


-- A presized map behaves like a grown one.
pure func test_a_presized_map_holds_its_keys() -> Bool:
	holds_each(with_keys(IntMaps.int_map_with_capacity(40), scrambled(60)), scrambled(60))


pure func test_negative_keys_have_their_own_slots() -> Bool:
	added = [-1, -8, -9, -16, IntOps.INT_MIN, 7, 0]
	holds_each(with_keys(IntMaps.empty_int_map(), added), added)


-- Probing past the last slot continues at the first: 7 and 15 share the last
-- of eight slots.
pure func test_probing_wraps_past_the_last_slot() -> Bool:
	holds_each(with_keys(IntMaps.empty_int_map(), [7, 15]), [7, 15])


-- Multiples of the initial slot count share a home slot; probing keeps them apart.
pure func test_colliding_keys_are_kept_apart() -> Bool:
	holds_each(with_keys(IntMaps.empty_int_map(), [0, 8, 16, 24]), [0, 8, 16, 24])


pure func test_an_absent_key_is_none() -> Bool:
	map = with_keys(IntMaps.empty_int_map(), [0, 8, 3])
	and(IntMaps.get(map, 16).is_none(), IntMaps.get(map, -3).is_none())


tests: TestSuite = {
	description = "Blorp 2 insertion-ordered Int-keyed map",
	tests = [
		("an empty map holds nothing", test_an_empty_map_holds_nothing),
		("set then get returns each value", test_set_then_get_returns_each_value),
		("replacing a key keeps one entry", test_replacing_a_key_keeps_one_entry),
		("every key survives several growths", test_every_key_survives_several_growths),
		("growth and replacement preserve insertion order", test_growth_and_replacement_preserve_insertion_order),
		("a presized map holds its keys", test_a_presized_map_holds_its_keys),
		("negative keys have their own slots", test_negative_keys_have_their_own_slots),
		("probing wraps past the last slot", test_probing_wraps_past_the_last_slot),
		("colliding keys are kept apart", test_colliding_keys_are_kept_apart),
		("an absent key is none", test_an_absent_key_is_none),
	]
}
