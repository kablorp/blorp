import:
	../../../src/utils/boolean: not, and, or
	test: TestSuite


pure func test_not_true() -> Bool:
	True.not() == False


pure func test_not_false() -> Bool:
	False.not() == True


pure func test_and_true_true() -> Bool:
	and(True, True) == True


pure func test_and_true_false() -> Bool:
	and(True, False) == False


pure func test_and_false_true() -> Bool:
	and(False, True) == False


pure func test_and_false_false() -> Bool:
	and(False, False) == False


pure func test_or_true_true() -> Bool:
	or(True, True) == True


pure func test_or_true_false() -> Bool:
	or(True, False) == True


pure func test_or_false_true() -> Bool:
	or(False, True) == True


pure func test_or_false_false() -> Bool:
	or(False, False) == False


tests: TestSuite = {
	description = "Blorp 2 source Boolean calls",
	tests = [
		("not true", test_not_true),
		("not false", test_not_false),
		("and true true", test_and_true_true),
		("and true false", test_and_true_false),
		("and false true", test_and_false_true),
		("and false false", test_and_false_false),
		("or true true", test_or_true_true),
		("or true false", test_or_true_false),
		("or false true", test_or_false_true),
		("or false false", test_or_false_false),
	]
}
