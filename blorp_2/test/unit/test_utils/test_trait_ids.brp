import:
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: trait_method_header, inventory_functions, inventory_traits, inventory_implementations, function_number, trait_number, impl_number, trait_method_owner, trait_method_number, FunctionRole(FreeFunctionBody, ImplementationBody)
	../../../src/utils/names: name_spelling
	../../../src/utils/source: module_id, root_module_id, same_module
	../module_input: parse_modules
	option: map, get_or
	test: TestSuite


private ROOT: String =
	|import:
	|    ./other as Other
	|trait Equatable:
	|    pure func equals(left: Self, right: Self) -> Bool
	|pure func before() -> Int:
	|    1
	|implements Equatable for Int:
	|    pure func equals(left: Int, right: Int) -> Bool:
	|        True
	|pure func after() -> Int:
	|    2
	|

private OTHER: String =
	|trait Observable:
	|    pure func observe(value: Self)
	|    pure func reset(value: Self)
	|implements Observable for Int:
	|    pure func reset(value: Int):
	|        void
	|    pure func observe(value: Int):
	|        void
	|pure func elsewhere() -> Int:
	|    3
	|


pure func test_abstract_and_implemented_methods_have_distinct_genuine_identities() -> Bool:
	match (parse_modules([{ source = ROOT, targets = [1] }, { source = OTHER, targets = [] }]), module_id(1)):
		(Ok(parsed), Some(other_module)):
			contents = parsed_contents(parsed)
			inventory = contents.declarations
			match (inventory_traits(inventory), inventory_implementations(inventory), inventory_functions(inventory)):
				([equality, observable], [integer_equality, integer_observer], [before, equals_body, after, reset_body, observe_body, elsewhere]):
					match (equality.methods, observable.methods, integer_equality.methods, integer_observer.methods):
						([equals_method], [observe_method, reset_method], [equals_id], [reset_id, observe_id]):
							roles_match = match (before.role, equals_body.role, after.role, observe_body.role):
								(FreeFunctionBody, ImplementationBody, FreeFunctionBody, ImplementationBody):
									match (reset_body.role, elsewhere.role):
										(ImplementationBody, FreeFunctionBody): True
										_: False
								_: False
							(roles_match and trait_number(equality.id) == 0 and trait_number(observable.id) == 1
								and impl_number(integer_equality.id) == 0 and impl_number(integer_observer.id) == 1
								and trait_method_owner(equals_method.id) == equality.id
								and trait_method_owner(observe_method.id) == observable.id
								and trait_method_number(equals_method.id) == 0 and trait_method_number(observe_method.id) == 0
								and trait_method_number(reset_method.id) == 1 and trait_method_owner(reset_method.id) == observable.id
								and [function_number(before.id), function_number(equals_body.id), function_number(after.id), function_number(reset_body.id), function_number(observe_body.id), function_number(elsewhere.id)] == [0, 1, 2, 3, 4, 5]
								and function_number(reset_id) == function_number(reset_body.id) and function_number(equals_id) == function_number(equals_body.id) and function_number(observe_id) == function_number(observe_body.id)
								and same_module(equality.module, root_module_id()) and same_module(integer_equality.header.module, root_module_id())
								and same_module(equals_body.declaration.module, root_module_id()) and same_module(after.declaration.module, root_module_id())
								and same_module(observable.module, other_module) and same_module(integer_observer.header.module, other_module)
								and same_module(observe_body.declaration.module, other_module) and same_module(elsewhere.declaration.module, other_module)
								and trait_method_header(equals_method, inventory).map(pure func(header): name_spelling(contents.names, header.function_name.id) == Some("equals")).get_or(False)
								and trait_method_header(observe_method, inventory).map(pure func(header): name_spelling(contents.names, header.function_name.id) == Some("observe")).get_or(False)
								and name_spelling(contents.names, equals_body.declaration.function_name.id) == Some("equals")
								and name_spelling(contents.names, observe_body.declaration.function_name.id) == Some("observe")
								and name_spelling(contents.names, reset_body.declaration.function_name.id) == Some("reset"))
						_: False
				_: False
		_: False


tests: TestSuite = {
	description = "Blorp 2 trait declaration inventory identities",
	tests = [
		("abstract methods consume no FunctionIds and authored bodies keep roles and module order", test_abstract_and_implemented_methods_have_distinct_genuine_identities),
	]
}
