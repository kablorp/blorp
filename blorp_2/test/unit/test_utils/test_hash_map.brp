import:
	../../../src/utils/hash_map as HashMaps
	int as IntOps
	string as StringOps
	bool: and
	option: is_none
	test: TestSuite


-- Every Coordinate in a column shares one hash, so only equality tells the
-- keys of a column apart.
record Coordinate { column: Int, row: Int }


implements Hashable for Coordinate:
	pure func hash(value: Self) -> Int:
		value.column


private pure func coordinate_at(column: Int, row: Int) -> Coordinate:
	{ column = column, row = row }


private pure func with_keys(map: HashMaps.HashMap[Int, String], added: List[Int]) -> HashMaps.HashMap[Int, String]:
	var result = map
	for key in added:
		result = HashMaps.set(result, key, key.to_string())
	result


-- `map` holds exactly `expected`, each key with its own spelling as its value.
private pure func holds_each(map: HashMaps.HashMap[Int, String], expected: List[Int]) -> Bool:
	var valid: Bool = IntOps.equals(HashMaps.values(map).length(), expected.length())
	for key in expected:
		if valid:
			valid = match HashMaps.get(map, key):
				Some(value): StringOps.equals(value, key.to_string())
				None: False
	valid


private pure func counting(count: Int) -> List[Int]:
	var result: List[Int] = []
	var key: Int = 0
	while key < count:
		result = result.append(key)
		key = key + 1
	result


-- Keys 0..count-1 in a scrambled but fixed order (37 is coprime to 101).
private pure func scrambled(count: Int) -> List[Int]:
	var result: List[Int] = []
	var step: Int = 0
	while step < count:
		result = result.append((step * 37) % 101)
		step = step + 1
	result


pure func test_an_empty_map_holds_nothing() -> Bool:
	map: HashMaps.HashMap[Int, String] = HashMaps.empty_hash_map()
	and(HashMaps.values(map).is_empty(), HashMaps.get(map, 0).is_none())


pure func test_set_then_get_returns_each_value() -> Bool:
	holds_each(with_keys(HashMaps.empty_hash_map(), [1, 2, 3]), [1, 2, 3])


pure func test_replacing_a_key_keeps_one_entry() -> Bool:
	map = HashMaps.set(with_keys(HashMaps.empty_hash_map(), [1, 2, 3]), 2, "two")
	if IntOps.equals(HashMaps.values(map).length(), 3):
		match (HashMaps.get(map, 2), HashMaps.get(map, 3)):
			(Some("two"), Some("3")): True
			_: False
	else:
		False


-- 100 keys pass through five doublings of the index (8 to 256 slots).
pure func test_every_key_survives_several_growths() -> Bool:
	holds_each(with_keys(HashMaps.empty_hash_map(), counting(100)), counting(100))


-- The fourth insertion precedes the first growth; 100 insertions pass five
-- growths. Replace the second key before them and the third key afterwards.
pure func test_growth_and_replacement_preserve_insertion_order() -> Bool:
	order = scrambled(100)
	var map: HashMaps.HashMap[Int, String] = HashMaps.empty_hash_map()
	for key in order:
		map = HashMaps.set(map, key, key.to_string())
		if IntOps.equals(key, 10):
			map = HashMaps.set(map, 37, "before growth")
	map = HashMaps.set(map, 74, "after growth")
	var expected: List[String] = []
	var associated: Bool = True
	for key in order:
		value = if IntOps.equals(key, 37):
			"before growth"
		else if IntOps.equals(key, 74):
			"after growth"
		else:
			key.to_string()
		expected = expected.append(value)
		if associated:
			associated = match HashMaps.get(map, key):
				Some(actual): StringOps.equals(actual, value)
				None: False
	actual = HashMaps.values(map)
	var ordered: Bool = IntOps.equals(actual.length(), expected.length())
	var position: Int = 0
	while position < expected.length():
		if ordered:
			ordered = match (actual.get(position), expected.get(position)):
				(Some(left), Some(right)): StringOps.equals(left, right)
				_: False
		position = position + 1
	if ordered:
		associated
	else:
		False


-- A presized map behaves like a grown one.
pure func test_a_presized_map_holds_its_keys() -> Bool:
	holds_each(with_keys(HashMaps.hash_map_with_capacity(40), scrambled(60)), scrambled(60))


pure func test_negative_keys_have_their_own_slots() -> Bool:
	added = [-1, -8, -9, -16, IntOps.INT_MIN, 7, 0]
	holds_each(with_keys(HashMaps.empty_hash_map(), added), added)


-- Probing past the last slot continues at the first: 7 and 15 share the last
-- of eight slots.
pure func test_probing_wraps_past_the_last_slot() -> Bool:
	holds_each(with_keys(HashMaps.empty_hash_map(), [7, 15]), [7, 15])


-- Multiples of the initial slot count share a home slot; probing keeps them apart.
pure func test_colliding_keys_are_kept_apart() -> Bool:
	holds_each(with_keys(HashMaps.empty_hash_map(), [0, 8, 16, 24]), [0, 8, 16, 24])


pure func test_an_absent_key_is_none() -> Bool:
	map = with_keys(HashMaps.empty_hash_map(), [0, 8, 3])
	and(HashMaps.get(map, 16).is_none(), HashMaps.get(map, -3).is_none())


pure func test_update_preserves_shared_map_values() -> Bool:
	original = with_keys(HashMaps.empty_hash_map(), [7, 15])
	updated = HashMaps.set(original, 7, "changed")
	match (HashMaps.get(original, 7), HashMaps.get(updated, 7), HashMaps.get(original, 15), HashMaps.get(updated, 15)):
		(Some("7"), Some("changed"), Some("15"), Some("15")): True
		_: False


pure func test_record_keys_sharing_a_hash_stay_apart() -> Bool:
	var map: HashMaps.HashMap[Coordinate, String] = HashMaps.empty_hash_map()
	map = HashMaps.set(map, coordinate_at(1, 2), "a")
	map = HashMaps.set(map, coordinate_at(1, 3), "b")
	map = HashMaps.set(map, coordinate_at(2, 2), "c")
	map = HashMaps.set(map, coordinate_at(1, 3), "replaced")
	if IntOps.equals(HashMaps.values(map).length(), 3):
		match (HashMaps.get(map, coordinate_at(1, 2)), HashMaps.get(map, coordinate_at(1, 3)), HashMaps.get(map, coordinate_at(2, 2))):
			(Some("a"), Some("replaced"), Some("c")): HashMaps.get(map, coordinate_at(1, 4)).is_none()
			_: False
	else:
		False


-- 40 keys in four hash clusters pass three growths of the index (8 to 64
-- slots). Each keeps its value and its place in the order, and a replacement
-- made after the growths stays in place.
pure func test_colliding_record_keys_survive_growth() -> Bool:
	var map: HashMaps.HashMap[Coordinate, Int] = HashMaps.empty_hash_map()
	var expected: List[Int] = []
	for column in counting(4):
		for row in counting(10):
			value = (column * 100) + row
			map = HashMaps.set(map, coordinate_at(column, row), value)
			expected = expected.append(value)
	map = HashMaps.set(map, coordinate_at(2, 5), -1)
	expected = expected.set(25, -1)
	var associated: Bool = HashMaps.values(map) == expected
	for column in counting(4):
		for row in counting(10):
			if associated:
				associated = match (HashMaps.get(map, coordinate_at(column, row)), expected.get((column * 10) + row)):
					(Some(actual), Some(wanted)): actual == wanted
					_: False
	associated


tests: TestSuite = {
	description = "Blorp 2 insertion-ordered hash map",
	tests = [
		("updating preserves shared map values", test_update_preserves_shared_map_values),
		("an empty map holds nothing", test_an_empty_map_holds_nothing),
		("set then get returns each value", test_set_then_get_returns_each_value),
		("replacing a key keeps one entry", test_replacing_a_key_keeps_one_entry),
		("every key survives several growths", test_every_key_survives_several_growths),
		("growth and replacement preserve insertion order", test_growth_and_replacement_preserve_insertion_order),
		("a presized map holds its keys", test_a_presized_map_holds_its_keys),
		("negative keys have their own slots", test_negative_keys_have_their_own_slots),
		("probing wraps past the last slot", test_probing_wraps_past_the_last_slot),
		("colliding keys are kept apart", test_colliding_keys_are_kept_apart),
		("an absent key is none", test_an_absent_key_is_none),
		("record keys sharing a hash stay apart", test_record_keys_sharing_a_hash_stay_apart),
		("colliding record keys survive growth", test_colliding_record_keys_survive_growth),
	]
}
