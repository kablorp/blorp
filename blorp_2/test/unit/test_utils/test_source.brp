import:
	../../../src/utils/source:
		compiler_source,
		declared_label,
		label_text,
		ModuleStem,
		module_stem,
		SourceRole(CompilerRole, ModuleRole, InvalidRole),
		module_id,
		module_number,
		module_source,
		root_module_id,
		source_module,
		source_role,
	../../../src/utils/syntax: Span, same_span
	int as IntOps
	bool: and, not
	option: Option methods
	test: TestSuite


pure func test_reserved_roles_have_no_module_identity() -> Bool:
	match source_role(compiler_source()):
		CompilerRole: source_module(compiler_source()).is_none()
		ModuleRole: False
		InvalidRole: False


pure func test_repeated_compiler_source_preserves_reserved_identity() -> Bool:
	first = compiler_source()
	second = compiler_source()
	match (source_role(first), source_role(second)):
		(CompilerRole, CompilerRole):
			and(first == second, and(
				source_module(first).is_none(),
				and(source_module(second).is_none(), first != module_source(root_module_id())),
			))
		_: False


pure func test_module_source_roundtrip_preserves_inventory_identity() -> Bool:
	root = root_module_id()

	match module_id(IntOps.add(module_number(root), 1)):
		None:
			False
		Some(dependency):
			var passed: Bool = root != dependency
			for id in [root, dependency]:
				origin = module_source(id)
				if passed:
					passed = match source_role(origin):
						ModuleRole: True
						CompilerRole: False
						InvalidRole: False
				if passed:
					passed = origin != compiler_source()
				if passed:
					passed = match source_module(origin):
						None:
							False
						Some(actual): actual == id
			if passed:
				module_source(root) != module_source(dependency)
			else:
				False


pure func test_reissued_inventory_ordinal_has_the_same_identity() -> Bool:
	root = root_module_id()

	match module_id(module_number(root)):
		None:
			False
		Some(reissued):
			and(root == reissued, module_source(root) == module_source(reissued))


pure func test_invalid_module_ordinals_cannot_alias_reserved_sources() -> Bool:
	and(module_id(-1).is_none(), and(
		module_id(IntOps.INT_MAX).is_none(),
		module_id(IntOps.subtract(IntOps.INT_MAX, 1)).is_none(),
	))


pure func test_largest_module_ordinal_roundtrips_without_overflow() -> Bool:
	-- The compiler diagnostic source occupies the first positive source ID.
	largest = IntOps.subtract(IntOps.INT_MAX, 2)

	match module_id(largest):
		None:
			False
		Some(id):
			origin = module_source(id)
			match source_role(origin):
				CompilerRole: False
				InvalidRole: False
				ModuleRole:
					match source_module(origin):
						None:
							False
						Some(actual): and(id == actual, IntOps.equals(module_number(actual), largest))


pure func test_span_equality_preserves_source_and_both_offsets() -> Bool:
	span: Span = {
		source = module_source(root_module_id()),
		start = 4,
		end = 8
	}
	and(same_span(span, span), and(
		same_span(span, { span | source = compiler_source() }).not(),
		and(same_span(span, { span | start = 5 }).not(), same_span(span, { span | end = 9 }).not()),
	))


pure func test_span_equality_distinguishes_module_origins() -> Bool:
	match module_id(IntOps.add(module_number(root_module_id()), 1)):
		None:
			False
		Some(dependency):
			span: Span = {
				source = module_source(root_module_id()),
				start = 4,
				end = 8
			}
			same_span(span, { span | source = module_source(dependency) }).not()


-- The label a function `f` in the module at `path` would carry.
private pure func label_of(path: String) -> Option[String]:
	module_stem(path).map(pure func(stem: ModuleStem) -> String: label_text(declared_label(stem, "f")))


private pure func labelled(path: String, expected: String) -> Bool:
	match label_of(path):
		Some(text): text == expected
		None: False


private pure func unlabelled(path: String) -> Bool:
	label_of(path).is_none()


pure func test_stem_is_the_file_name_without_directories_or_extension() -> Bool:
	and(labelled("a/b/c.brp", "c.f"), labelled("./m.brp", "m.f"))


pure func test_stem_of_a_bare_name_is_the_name() -> Bool:
	labelled("c", "c.f")


pure func test_stem_drops_only_the_last_extension() -> Bool:
	and(labelled("x.test.brp", "x.test.f"), labelled("a.", "a.f"))


pure func test_stem_keeps_a_leading_dot_as_part_of_the_name() -> Bool:
	and(labelled(".hidden.brp", ".hidden.f"), and(labelled("dir/.hidden", ".hidden.f"), labelled("dir/.", "..f")))


-- A `*` in a name or directory never meets a `/` in the label, because the label
-- holds no directory.
pure func test_stem_with_stars_never_forms_a_comment_end() -> Bool:
	and(labelled("a*b.brp", "a*b.f"), labelled("a*/b*.brp", "b*.f"))


pure func test_a_path_without_a_file_name_has_no_stem() -> Bool:
	and(unlabelled(""), and(unlabelled("dir/"), unlabelled("a/b/")))


tests: TestSuite = {
	description = "Blorp 2 source identities",
	tests = [
		("reserved roles have no module identity", test_reserved_roles_have_no_module_identity),
		("repeated compiler source preserves reserved identity", test_repeated_compiler_source_preserves_reserved_identity),
		("module source roundtrip preserves inventory identity", test_module_source_roundtrip_preserves_inventory_identity),
		("reissued inventory ordinal has the same identity", test_reissued_inventory_ordinal_has_the_same_identity),
		("invalid module ordinals cannot alias reserved sources", test_invalid_module_ordinals_cannot_alias_reserved_sources),
		("largest module ordinal roundtrips without overflow", test_largest_module_ordinal_roundtrips_without_overflow),
		("span equality preserves source and both offsets", test_span_equality_preserves_source_and_both_offsets),
		("span equality distinguishes module origins", test_span_equality_distinguishes_module_origins),
		("stem is the file name without directories or extension", test_stem_is_the_file_name_without_directories_or_extension),
		("stem of a bare name is the name", test_stem_of_a_bare_name_is_the_name),
		("stem drops only the last extension", test_stem_drops_only_the_last_extension),
		("stem keeps a leading dot as part of the name", test_stem_keeps_a_leading_dot_as_part_of_the_name),
		("stem with stars never forms a comment end", test_stem_with_stars_never_forms_a_comment_end),
		("path without a file name has no stem", test_a_path_without_a_file_name_has_no_stem),
	]
}
