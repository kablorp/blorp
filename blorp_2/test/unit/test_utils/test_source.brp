import:
	../../../src/utils/source:
		compiler_source,
		SourceRole(CompilerRole, ModuleRole, InvalidRole),
		module_id,
		module_number,
		module_source,
		root_module_id,
		same_module,
		same_source,
		source_module,
		source_role,
	../../../src/utils/syntax: Span, same_span
	int as IntOps
	../../../src/utils/boolean: and, not
	option: is_none
	test: TestSuite


pure func test_reserved_roles_have_no_module_identity() -> Bool:
	match source_role(compiler_source()):
		CompilerRole: source_module(compiler_source()).is_none()
		ModuleRole: False
		InvalidRole: False


pure func test_repeated_compiler_source_preserves_reserved_identity() -> Bool:
	first = compiler_source()
	second = compiler_source()
	match (source_role(first), source_role(second)):
		(CompilerRole, CompilerRole):
			and(same_source(first, second), and(
				source_module(first).is_none(),
				and(source_module(second).is_none(), same_source(first, module_source(root_module_id())).not()),
			))
		_: False


pure func test_module_source_roundtrip_preserves_inventory_identity() -> Bool:
	root = root_module_id()

	match module_id(IntOps.add(module_number(root), 1)):
		None:
			False
		Some(dependency):
			var passed: Bool = same_module(root, dependency).not()
			for id in [root, dependency]:
				origin = module_source(id)
				if passed:
					passed = match source_role(origin):
						ModuleRole: True
						CompilerRole: False
						InvalidRole: False
				if passed:
					passed = same_source(origin, compiler_source()).not()
				if passed:
					passed = match source_module(origin):
						None:
							False
						Some(actual): same_module(actual, id)
			if passed:
				same_source(module_source(root), module_source(dependency)).not()
			else:
				False


pure func test_reissued_inventory_ordinal_has_the_same_identity() -> Bool:
	root = root_module_id()

	match module_id(module_number(root)):
		None:
			False
		Some(reissued):
			and(same_module(root, reissued), same_source(module_source(root), module_source(reissued)))


pure func test_invalid_module_ordinals_cannot_alias_reserved_sources() -> Bool:
	and(module_id(-1).is_none(), and(
		module_id(IntOps.INT_MAX).is_none(),
		module_id(IntOps.subtract(IntOps.INT_MAX, 1)).is_none(),
	))


pure func test_largest_module_ordinal_roundtrips_without_overflow() -> Bool:
	-- The compiler diagnostic source occupies the first positive source ID.
	largest = IntOps.subtract(IntOps.INT_MAX, 2)

	match module_id(largest):
		None:
			False
		Some(id):
			origin = module_source(id)
			match source_role(origin):
				CompilerRole: False
				InvalidRole: False
				ModuleRole:
					match source_module(origin):
						None:
							False
						Some(actual): and(same_module(id, actual), IntOps.equals(module_number(actual), largest))


pure func test_span_equality_preserves_source_and_both_offsets() -> Bool:
	span: Span = {
		source = module_source(root_module_id()),
		start = 4,
		end = 8
	}
	and(same_span(span, span), and(
		same_span(span, { span | source = compiler_source() }).not(),
		and(same_span(span, { span | start = 5 }).not(), same_span(span, { span | end = 9 }).not()),
	))


pure func test_span_equality_distinguishes_module_origins() -> Bool:
	match module_id(IntOps.add(module_number(root_module_id()), 1)):
		None:
			False
		Some(dependency):
			span: Span = {
				source = module_source(root_module_id()),
				start = 4,
				end = 8
			}
			same_span(span, { span | source = module_source(dependency) }).not()


tests: TestSuite = {
	description = "Blorp 2 source identities",
	tests = [
		("reserved roles have no module identity", test_reserved_roles_have_no_module_identity),
		("repeated compiler source preserves reserved identity", test_repeated_compiler_source_preserves_reserved_identity),
		("module source roundtrip preserves inventory identity", test_module_source_roundtrip_preserves_inventory_identity),
		("reissued inventory ordinal has the same identity", test_reissued_inventory_ordinal_has_the_same_identity),
		("invalid module ordinals cannot alias reserved sources", test_invalid_module_ordinals_cannot_alias_reserved_sources),
		("largest module ordinal roundtrips without overflow", test_largest_module_ordinal_roundtrips_without_overflow),
		("span equality preserves source and both offsets", test_span_equality_preserves_source_and_both_offsets),
		("span equality distinguishes module origins", test_span_equality_distinguishes_module_origins),
	]
}
