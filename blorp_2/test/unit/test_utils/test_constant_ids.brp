import:
	../../../src/utils/ids: constant_number, function_number, inventory_constants, inventory_functions, issue_inventory
	../../../src/utils/names: program_names, same_name
	../../../src/utils/source: ModuleId, foundation_prelude_module_id, module_source, root_module_id, same_module
	../../../src/utils/syntax: ExpressionBase(IntegerExpression), ParsedConstant, Span, TypeSyntax(AtomicType), Visibility(Public), WrittenName
	../declaration_inputs: sample_inventory
	int as IntOps
	../../../src/utils/boolean: and
	test: TestSuite


-- Repeated spelling is deliberate: declaration rows issue identity, not names.
private pure func declaration(module: ModuleId, value: Int) -> ParsedConstant:
	at: Span = { source = module_source(module), start = 10, end = 14 }
	name: WrittenName = { id = program_names().main, span = at }
	{
		module = module,
		visibility = Public,
		name = name,
		type_name = AtomicType(name),
		value = { base = IntegerExpression(value), base_span = at, applications = [], span = at },
	}


pure func test_constant_ids_are_dense_and_preserve_declarations() -> Bool:
	first = declaration(root_module_id(), 23)
	second = declaration(root_module_id(), 17)
	third = declaration(foundation_prelude_module_id(), 31)
	match inventory_constants(issue_inventory([], [], [], [], [first, second, third])):
		[one, two, three]:
			match (one.declaration.value.base, two.declaration.value.base, three.declaration.value.base):
				(IntegerExpression(first_value), IntegerExpression(second_value), IntegerExpression(third_value)):
					and(
						and(IntOps.equals(first_value, 23), and(IntOps.equals(second_value, 17), IntOps.equals(third_value, 31))),
						and(
							and(IntOps.equals(constant_number(one.id), 0), IntOps.equals(constant_number(two.id), 1)),
							and(IntOps.equals(constant_number(three.id), 2), same_module(three.declaration.module, foundation_prelude_module_id())),
						),
					)
				_: False
		_: False


pure func test_same_name_in_different_modules_does_not_merge_constant_ids() -> Bool:
	first = declaration(root_module_id(), 23)
	second = declaration(foundation_prelude_module_id(), 17)
	match inventory_constants(issue_inventory([], [], [], [], [first, second])):
		[one, two]:
			and(same_name(one.declaration.name.id, two.declaration.name.id), and(
				IntOps.equals(constant_number(one.id), 0),
				and(IntOps.equals(constant_number(two.id), 1), and(
					same_module(one.declaration.module, root_module_id()),
					same_module(two.declaration.module, foundation_prelude_module_id()),
				)),
			))
		_: False


pure func test_constant_and_function_ordinals_are_distinct_domains() -> Bool:
	functions = inventory_functions(sample_inventory()).map(pure func(row): row.declaration)
	inventory = issue_inventory(functions, [], [], [], [declaration(root_module_id(), 23)])
	match (inventory_functions(inventory), inventory_constants(inventory)):
		([function, _, _, _], [constant]): and(IntOps.equals(function_number(function.id), 0), IntOps.equals(constant_number(constant.id), 0))
		_: False


pure func test_empty_constant_inventory_has_no_rows() -> Bool:
	inventory_constants(issue_inventory([], [], [], [], [])).is_empty()


tests: TestSuite = {
	description = "Blorp 2 constant declaration identity",
	tests = [
		("dense constant IDs retain supplied declarations", test_constant_ids_are_dense_and_preserve_declarations),
		("same spelling across modules retains distinct identities", test_same_name_in_different_modules_does_not_merge_constant_ids),
		("constant and function ordinals have distinct domains", test_constant_and_function_ordinals_are_distinct_domains),
		("empty inventory has no constant rows", test_empty_constant_inventory_has_no_rows),
	]
}
