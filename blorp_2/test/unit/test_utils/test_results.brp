---
Tests for the first-error loops: both stop at the first failure, so a later
element that would fail differently never changes the result.
---
import:
	../../../src/utils/results: first_error, translated_list
	int: Int methods
	test: TestSuite


-- Rejects 3 and 5 with different messages, so the message names which element
-- stopped the loop.
private pure func rejection(value: Int) -> Option[String]:
	if value == 3:
		Some("three")
	else:
		if value == 5:
			Some("five")
		else:
			None


private pure func doubled_below_three(value: Int) -> Result[Int, String]:
	match rejection(value):
		Some(message): Err(message)
		None: Ok(value.multiply(2))


private pure func accepts_below_three(value: Int) -> Result[Void, String]:
	match rejection(value):
		Some(message): Err(message)
		None: Ok(void)


private pure func is_translated(result: Result[List[Int], String], expected: List[Int]) -> Bool:
	match result:
		Ok(values): values == expected
		Err(_): False


private pure func is_rejected(result: Result[Void, String], expected: String) -> Bool:
	match result:
		Ok(_): False
		Err(message): message == expected


private pure func is_rejected_list(result: Result[List[Int], String], expected: String) -> Bool:
	match result:
		Ok(_): False
		Err(message): message == expected


pure func test_translating_an_empty_list_succeeds() -> Bool:
	is_translated(translated_list([], doubled_below_three), [])


pure func test_translating_keeps_every_result_in_order() -> Bool:
	is_translated(translated_list([1, 2, 4], doubled_below_three), [2, 4, 8])


pure func test_translating_reports_the_first_failure() -> Bool:
	is_rejected_list(translated_list([1, 3, 4], doubled_below_three), "three")


-- 5 would fail with "five"; the loop must have stopped at 3.
pure func test_translating_stops_after_the_first_failure() -> Bool:
	is_rejected_list(translated_list([1, 3, 5], doubled_below_three), "three")


pure func test_checking_an_empty_list_succeeds() -> Bool:
	match first_error([], accepts_below_three):
		Ok(_): True
		Err(_): False


pure func test_checking_succeeds_when_every_value_passes() -> Bool:
	match first_error([1, 2, 4], accepts_below_three):
		Ok(_): True
		Err(_): False


pure func test_checking_reports_the_first_failure() -> Bool:
	is_rejected(first_error([1, 3, 4], accepts_below_three), "three")


-- 5 would fail with "five"; the loop must have stopped at 3.
pure func test_checking_stops_after_the_first_failure() -> Bool:
	is_rejected(first_error([1, 3, 5], accepts_below_three), "three")


tests: TestSuite = {
	description = "Blorp 2 first-error loops",
	tests = [
		("translating an empty list succeeds", test_translating_an_empty_list_succeeds),
		("translating keeps every result in order", test_translating_keeps_every_result_in_order),
		("translating reports the first failure", test_translating_reports_the_first_failure),
		("translating stops after the first failure", test_translating_stops_after_the_first_failure),
		("checking an empty list succeeds", test_checking_an_empty_list_succeeds),
		("checking succeeds when every value passes", test_checking_succeeds_when_every_value_passes),
		("checking reports the first failure", test_checking_reports_the_first_failure),
		("checking stops after the first failure", test_checking_stops_after_the_first_failure),
	]
}
