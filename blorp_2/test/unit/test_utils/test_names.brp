import:
	../../../src/utils/ids: inventory_functions
	../../../src/utils/source: module_source, root_module_id
	../../../src/lex/lex: lex
	../../../src/utils/names:
		NameId,
		NameTable,
		find_name,
		intern_name,
		name_spelling,
		program_names,
		same_name,
		same_name_table,
	../../../src/parse/assemble: parsed_contents
	../../../src/namespace/builtins: check_builtin_types
	../../../src/utils/syntax:
		ExpressionBase(NameExpression),
		ParsedBody(ParsedValueBody),
		ParsedFunction,
		TypeSyntax(AtomicType, AppliedType),
	../input: initial_names, parse
	option: is_none
	test: TestSuite


private pure func type_is_named(
	written: TypeSyntax,
	id: NameId,
	start: Int,
	end: Int,
) -> Bool:
	match written:
		AtomicType(name):
			same_name(name.id, id) and name.span.start == start and name.span.end == end
		_:
			False


private pure func base_of(function: ParsedFunction) -> Option[ExpressionBase]:
	match function.body:
		ParsedValueBody(value):
			Some(value.base)
		_:
			None


private pure func same_found(left: Option[NameId], right: Option[NameId]) -> Bool:
	match left:
		None:
			False
		Some(left):
			match right:
				None:
					False
				Some(right):
					same_name(left, right)


private pure func spells(names: NameTable, id: Option[NameId], expected: String) -> Bool:
	match id:
		None:
			False
		Some(id):
			name_spelling(names, id) == Some(expected)


pure func test_canonical_names_share_the_interning_authority() -> Bool:
	match initial_names():
		Err(_):
			False
		Ok(initial):
			names = intern_name(
				intern_name(initial.names, "main").names,
				"Int",
			).names
			same_found(
				find_name(names, "main"),
				Some(initial.special.main),
			) and same_found(
				find_name(names, "Int"),
				Some(initial.special.integer),
			) and same_found(
				find_name(names, "String"),
				Some(initial.special.string),
			) and name_spelling(
				names,
				initial.special.main,
			) == Some(
				"main",
			) and name_spelling(
				names,
				initial.special.integer,
			) == Some("Int") and name_spelling(names, initial.special.string) == Some("String")


pure func test_repeated_spelling_has_one_identity() -> Bool:
	initial = program_names()
	first = intern_name(initial.names, "identity")
	repeated = intern_name(first.names, "identity")
	case_variant = intern_name(repeated.names, "Identity")
	prefix_variant = intern_name(case_variant.names, "identity_more")
	same_found(
		find_name(first.names, "identity"),
		find_name(repeated.names, "identity"),
	) and not same_found(
		find_name(first.names, "identity"),
		find_name(case_variant.names, "Identity"),
	) and not same_found(
		find_name(first.names, "identity"),
		find_name(prefix_variant.names, "identity_more"),
	) and same_found(
		find_name(case_variant.names, "Identity"),
		find_name(
			intern_name(first.names, "Identity").names,
			"Identity",
		),
	) and spells(
		prefix_variant.names,
		find_name(prefix_variant.names, "identity"),
		"identity",
	) and spells(
		prefix_variant.names,
		find_name(prefix_variant.names, "Identity"),
		"Identity",
	) and spells(
		prefix_variant.names,
		find_name(prefix_variant.names, "identity_more"),
		"identity_more",
	)


pure func test_independent_extensions_keep_their_own_spellings() -> Bool:
	seed = program_names()
	left = intern_name(seed.names, "left")
	right = intern_name(seed.names, "right")

	match find_name(left.names, "left"):
		None:
			False
		Some(left_id):
			name_spelling(left.names, left_id) == Some("left") and spells(
				right.names,
				find_name(right.names, "right"),
				"right",
			) and name_spelling(seed.names, left_id) == None and find_name(right.names, "left").is_none()


pure func test_interning_returns_the_published_identity() -> Bool:
	initial = program_names()
	existing = intern_name(initial.names, "main")
	first = intern_name(existing.names, "first")
	repeated = intern_name(first.names, "first")
	second = intern_name(repeated.names, "second")
	(
		same_name(existing.id, initial.main)
		and name_spelling(existing.names, existing.id) == Some("main")
		and name_spelling(first.names, first.id) == Some("first")
		and same_name(first.id, repeated.id)
		and not same_name(first.id, second.id)
		and name_spelling(second.names, first.id) == Some("first")
		and name_spelling(second.names, second.id) == Some("second")
		and name_spelling(first.names, second.id) == None
	)


pure func test_returned_identity_belongs_to_its_extension() -> Bool:
	initial = program_names()
	left = intern_name(initial.names, "left")
	right = intern_name(initial.names, "right")
	(
		name_spelling(left.names, left.id) == Some("left")
		and name_spelling(right.names, right.id) == Some("right")
		and name_spelling(initial.names, left.id) == None
		and name_spelling(initial.names, right.id) == None
	)


pure func test_parser_shares_identity_across_roles_but_preserves_spans() -> Bool:
	source: String =
		|func Int(Int: Int) -> Int:
		|	Int
		|

	match lex(module_source(root_module_id()), source):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					program = parsed_contents(parsed)
					match check_builtin_types(parsed):
						Err(_): False
						Ok(initial):
							integer = initial.special.integer
							match inventory_functions(program.declarations).map(pure func(row): row.declaration):
								[function, ..._]:
									match function.parameters:
										[parameter]:
											match base_of(function):
												Some(NameExpression(value)):
													(
														same_name(function.function_name.id, integer)
														and same_name(parameter.name.id, integer)
														and type_is_named(
															parameter.type_name,
															integer,
															14,
															17,
														)
														and return_type_is_named(
															function.return_type,
															integer,
															22,
															25,
														)
														and same_name(value.id, integer)
														and function.function_name.span.start == 5
														and function.function_name.span.end == 8
														and parameter.name.span.start == 9
														and parameter.name.span.end == 12
														and value.span.start == 28
														and value.span.end == 31
													)
												_:
													False
										_:
											False
								_:
									False


pure func test_name_authority_compares_complete_spelling_mapping() -> Bool:
	seed = program_names().names
	left = intern_name(seed, "left").names
	right = intern_name(seed, "right").names
	(
		same_name_table(seed, seed)
		and same_name_table(left, intern_name(seed, "left").names)
		and not same_name_table(left, right)
		and not same_name_table(seed, left)
	)


tests: TestSuite = {
	description = "Blorp 2 name identities",
	tests = [
		(
			"parser shares identity across roles but preserves spans",
			test_parser_shares_identity_across_roles_but_preserves_spans,
		),
		(
			"canonical names share the interning authority",
			test_canonical_names_share_the_interning_authority,
		),
		("repeated spelling has one identity", test_repeated_spelling_has_one_identity),
		(
			"independent extensions keep their own spellings",
			test_independent_extensions_keep_their_own_spellings,
		),
		("interning returns the published identity", test_interning_returns_the_published_identity),
		("returned identity belongs to its extension", test_returned_identity_belongs_to_its_extension),
		("name authority compares complete spelling mapping", test_name_authority_compares_complete_spelling_mapping),
	]
}


private pure func return_type_is_named(written: Option[TypeSyntax], id: NameId, start: Int, end: Int) -> Bool:
	match written:
		Some(value): type_is_named(value, id, start, end)
		None: False
