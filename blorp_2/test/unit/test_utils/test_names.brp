import:
	../../../src/utils/ids: inventory_functions
	../../../src/utils/source: module_source, root_module_id
	../../../src/lex/lex: lex
	../../../src/utils/names:
		NameId,
		NameTable,
		contextual_words,
		foundation_words,
		intern_names,
		name_spelling,
		program_names,
		same_name,
		same_name_table,
	../../../src/parse/assemble: parsed_contents
	../../../src/namespace/builtins: check_builtin_types
	../../../src/utils/syntax:
		ExpressionBase(NameExpression),
		ParsedBody(ParsedValueBody),
		ParsedFunction,
		TypeSyntax(AtomicType, AppliedType),
	../input: initial_names, parse, existing_name
	option: is_none
	int as IntOps
	string as StringOps
	bool: and, not
	test: TestSuite


private pure func type_is_named(
	written: TypeSyntax,
	id: NameId,
	start: Int,
	end: Int,
) -> Bool:
	match written:
		AtomicType(name):
			and(same_name(name.id, id), and(IntOps.equals(name.span.start, start), IntOps.equals(name.span.end, end)))
		_:
			False


pure func test_callable_keyword_ids_belong_to_the_program_seed() -> Bool:
	seed = program_names()
	words = contextual_words(seed.names)
	interned = intern_names(seed.names, ["not", "and", "or"])
	match interned.ids:
		[negation, conjunction, disjunction]:
			and(
				and(
					same_name_table(seed.names, interned.names),
					and(same_name(negation, words.not_word), same_name(conjunction, words.and_word)),
				),
				and(
					same_name(disjunction, words.or_word),
					and(same_name(negation, conjunction).not(), same_name(conjunction, disjunction).not()),
				),
			)
		_: False


private pure func base_of(function: ParsedFunction) -> Option[ExpressionBase]:
	match function.body:
		ParsedValueBody(value):
			Some(value.base)
		_:
			None


private pure func same_found(left: Option[NameId], right: Option[NameId]) -> Bool:
	match left:
		None:
			False
		Some(left_id):
			match right:
				None:
					False
				Some(right_id):
					same_name(left_id, right_id)


private pure func spells(names: NameTable, id: Option[NameId], expected: String) -> Bool:
	match id:
		None:
			False
		Some(actual_id):
			match name_spelling(names, actual_id):
				Some(spelling): StringOps.equals(spelling, expected)
				None: False


pure func test_canonical_names_share_the_interning_authority() -> Bool:
	match initial_names():
		Err(_):
			False
		Ok(initial):
			names = intern_names(
				intern_names(initial.names, ["main"]).names,
				["Int"],
			).names
			and(
				and(
					same_found(
						existing_name(names, "main"),
						Some(initial.special.main),
					),
					and(
						same_found(
							existing_name(names, "Int"),
							Some(initial.special.integer),
						),
						same_found(
							existing_name(names, "String"),
							Some(initial.special.string),
						),
					),
				),
				and(
					spells(names, Some(initial.special.main), "main"),
					and(spells(names, Some(initial.special.integer), "Int"), spells(names, Some(initial.special.string), "String")),
				),
			)


pure func test_repeated_spelling_has_one_identity() -> Bool:
	initial = program_names()
	first = intern_names(initial.names, ["identity"])
	repeated = intern_names(first.names, ["identity"])
	case_variant = intern_names(repeated.names, ["Identity"])
	prefix_variant = intern_names(case_variant.names, ["identity_more"])
	and(
		and(
			same_found(
				existing_name(first.names, "identity"),
				existing_name(repeated.names, "identity"),
			),
			and(
				same_found(
					existing_name(first.names, "identity"),
					existing_name(case_variant.names, "Identity"),
				).not(),
				same_found(
					existing_name(first.names, "identity"),
					existing_name(prefix_variant.names, "identity_more"),
				).not(),
			),
		),
		and(
			and(
				same_found(
					existing_name(case_variant.names, "Identity"),
					existing_name(
						intern_names(first.names, ["Identity"]).names,
						"Identity",
					),
				),
				spells(
					prefix_variant.names,
					existing_name(prefix_variant.names, "identity"),
					"identity",
				),
			),
			and(
				spells(
					prefix_variant.names,
					existing_name(prefix_variant.names, "Identity"),
					"Identity",
				),
				spells(
					prefix_variant.names,
					existing_name(prefix_variant.names, "identity_more"),
					"identity_more",
				),
			),
		),
	)


pure func test_independent_extensions_keep_their_own_spellings() -> Bool:
	seed = program_names()
	left = intern_names(seed.names, ["left"])
	right = intern_names(seed.names, ["right"])

	match existing_name(left.names, "left"):
		None:
			False
		Some(left_id):
			and(
				and(
					spells(left.names, Some(left_id), "left"),
					spells(
						right.names,
						existing_name(right.names, "right"),
						"right",
					),
				),
				and(name_spelling(seed.names, left_id).is_none(), existing_name(right.names, "left").is_none()),
			)


pure func test_interning_returns_the_published_identity() -> Bool:
	initial = program_names()
	first = intern_names(initial.names, ["main", "first"])
	second = intern_names(first.names, ["first", "second"])

	match (first.ids, second.ids):
		([existing, first_id], [repeated, second_id]):
			and(
				and(
					and(same_name(existing, initial.main), spells(first.names, Some(existing), "main")),
					and(spells(first.names, Some(first_id), "first"), same_name(first_id, repeated)),
				),
				and(
					and(same_name(first_id, second_id).not(), spells(second.names, Some(first_id), "first")),
					and(spells(second.names, Some(second_id), "second"), name_spelling(first.names, second_id).is_none()),
				),
			)
		_:
			False


pure func test_returned_identity_belongs_to_its_extension() -> Bool:
	initial = program_names()
	left = intern_names(initial.names, ["left"])
	right = intern_names(initial.names, ["right"])

	match (left.ids, right.ids):
		([left_id], [right_id]):
			and(
				and(spells(left.names, Some(left_id), "left"), spells(right.names, Some(right_id), "right")),
				and(name_spelling(initial.names, left_id).is_none(), name_spelling(initial.names, right_id).is_none()),
			)
		_:
			False


pure func test_parser_shares_identity_across_roles_but_preserves_spans() -> Bool:
	source: String =
		|func Int(Int: Int) -> Int:
		|	Int
		|

	match lex(module_source(root_module_id()), source, program_names().names):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					program = parsed_contents(parsed)
					match check_builtin_types(parsed):
						Err(_): False
						Ok(foundation):
							integer = foundation.initial.special.integer
							match inventory_functions(program.declarations).map(pure func(row): row.declaration):
								[function, ..._]:
									match function.parameters:
										[parameter]:
											match base_of(function):
												Some(NameExpression(value)):
													and(
														and(
															and(same_name(function.function_name.id, integer), same_name(parameter.name.id, integer)),
															and(
																type_is_named(
																	parameter.type_name,
																	integer,
																	14,
																	17,
																),
																and(
																	return_type_is_named(
																		function.return_type,
																		integer,
																		22,
																		25,
																	),
																	same_name(value.id, integer),
																),
															),
														),
														and(
															and(
																IntOps.equals(function.function_name.span.start, 5),
																and(IntOps.equals(function.function_name.span.end, 8), IntOps.equals(parameter.name.span.start, 9)),
															),
															and(
																IntOps.equals(parameter.name.span.end, 12),
																and(IntOps.equals(value.span.start, 28), IntOps.equals(value.span.end, 31)),
															),
														),
													)
												_:
													False
										_:
											False
								_:
									False


private pure func numbered_spellings(count: Int) -> List[String]:
	var spellings: List[String] = []
	var position: Int = 0
	while IntOps.less_than(position, count):
		spellings = spellings.append("name".append_int(position))
		position = IntOps.add(position, 1)
	spellings


private pure func resolves_each(names: NameTable, spellings: List[String]) -> Bool:
	var resolved: Bool = True
	for spelling in spellings:
		if resolved:
			resolved = spells(names, existing_name(names, spelling), spelling)
	resolved


-- One spelling at a time, so each extension starts from a published table.
private pure func interned_one_by_one(names: NameTable, spellings: List[String]) -> NameTable:
	var table = names
	for spelling in spellings:
		table = intern_names(table, [spelling]).names
	table


pure func test_lookup_finds_exact_spellings_and_misses_near_ones() -> Bool:
	names = intern_names(program_names().names, ["left", "right"]).names
	and(
		and(
			spells(names, existing_name(names, "left"), "left"),
			and(spells(names, existing_name(names, "right"), "right"), existing_name(names, "lef").is_none()),
		),
		and(
			existing_name(names, "leftt").is_none(),
			and(existing_name(names, "Left").is_none(), existing_name(names, "").is_none()),
		),
	)


pure func test_lookup_survives_bucket_growth() -> Bool:
	-- 101 names outgrow the initial 31 buckets twice.
	spellings = numbered_spellings(100)
	names = intern_names(program_names().names, spellings).names
	and(
		and(resolves_each(names, spellings), same_name_table(names, interned_one_by_one(program_names().names, spellings))),
		and(spells(names, existing_name(names, "main"), "main"), existing_name(names, "name100").is_none()),
	)


pure func test_multilingual_names_reintern_after_growth() -> Bool:
	spellings = ["café", "cafe\u{301}", "東京", "مرحبا", "😀", "😀x"]
	base = intern_names(program_names().names, spellings).names
	-- The existing 100-name extension crosses both initial bucket-growth thresholds.
	extension = numbered_spellings(100)
	grown = intern_names(base, extension).names
	repeated = intern_names(grown, spellings).names
	var stable: Bool = True
	for spelling in spellings:
		if stable:
			stable = same_found(existing_name(base, spelling), existing_name(repeated, spelling))
	and(
		and(
			and(stable, resolves_each(repeated, spellings)),
			and(
				resolves_each(repeated, extension),
				and(same_name_table(grown, repeated), same_name_table(grown, interned_one_by_one(base, extension))),
			),
		),
		and(
			and(
				same_found(existing_name(repeated, "café"), existing_name(repeated, "cafe\u{301}")).not(),
				same_found(existing_name(repeated, "😀"), existing_name(repeated, "😀x")).not(),
			),
			and(
				existing_name(base, "name0").is_none(),
				and(existing_name(repeated, "caf").is_none(), existing_name(repeated, "東京x").is_none()),
			),
		),
	)


pure func test_colliding_spellings_keep_distinct_identities() -> Bool:
	-- "left" and "third" share a bucket of the initial 31; a lookup that
	-- trusted the bucket without comparing spellings would confuse them.
	names = intern_names(program_names().names, ["left", "third"]).names
	and(
		spells(names, existing_name(names, "left"), "left"),
		and(
			spells(names, existing_name(names, "third"), "third"),
			same_found(existing_name(names, "left"), existing_name(names, "third")).not(),
		),
	)


pure func test_identities_survive_extension_and_growth() -> Bool:
	base = intern_names(program_names().names, ["left"]).names
	extended = intern_names(base, numbered_spellings(100).append("right")).names
	and(
		and(
			same_found(existing_name(base, "left"), existing_name(extended, "left")),
			spells(extended, existing_name(base, "left"), "left"),
		),
		and(
			spells(extended, existing_name(extended, "right"), "right"),
			and(existing_name(base, "right").is_none(), resolves_each(extended, numbered_spellings(100))),
		),
	)


pure func test_interning_skips_known_and_repeated_spellings() -> Bool:
	seed = program_names()
	interned = intern_names(seed.names, ["left", "main", "left"])
	extended = interned.names
	ids_in_order = match interned.ids:
		[first, main, repeated]:
			and(
				same_found(Some(first), existing_name(extended, "left")),
				and(same_name(main, seed.main), same_name(repeated, first)),
			)
		_:
			False
	and(
		and(
			same_name_table(extended, interned_one_by_one(seed.names, ["left"])),
			same_found(existing_name(extended, "main"), Some(seed.main)),
		),
		and(spells(extended, existing_name(extended, "left"), "left"), ids_in_order),
	)


pure func test_seed_mints_each_contextual_word() -> Bool:
	names = program_names().names
	words = contextual_words(names)
	extended = intern_names(names, ["fixed", "fresh"]).names
	and(
		and(
			and(spells(names, Some(words.fixed_word), "fixed"), spells(names, Some(words.methods_word), "methods")),
			and(
				spells(names, Some(words.int_word), "Int"),
				and(spells(names, Some(words.float_word), "Float"), spells(names, Some(words.string_word), "String")),
			),
		),
		and(
			and(spells(names, Some(words.void_word), "Void"), spells(names, Some(words.list_word), "List")),
			and(
				spells(names, Some(words.tail_recursive_word), "tail_recursive"),
				and(
					same_found(existing_name(extended, "fixed"), Some(words.fixed_word)),
					same_found(existing_name(extended, "List"), Some(contextual_words(extended).list_word)),
				),
			),
		),
	)


pure func test_seed_mints_each_foundation_word_and_extensions_keep_them() -> Bool:
	names = program_names().names
	words = foundation_words(names)
	extended = intern_names(names, ["Option", "fresh"]).names
	and(
		and(
			and(spells(names, Some(words.bool_word), "Bool"), spells(names, Some(words.true_word), "True")),
			and(
				spells(names, Some(words.false_word), "False"),
				and(spells(names, Some(words.option_word), "Option"), spells(names, Some(words.some_word), "Some")),
			),
		),
		and(
			and(
				spells(names, Some(words.none_word), "None"),
				and(spells(names, Some(words.result_word), "Result"), spells(names, Some(words.ok_word), "Ok")),
			),
			and(
				spells(names, Some(words.err_word), "Err"),
				and(
					same_found(existing_name(extended, "Option"), Some(words.option_word)),
					same_found(existing_name(extended, "Err"), Some(foundation_words(extended).err_word)),
				),
			),
		),
	)


-- Check selects each canonical operator trait and its members by these IDs.
pure func test_seed_mints_each_canonical_operator_word() -> Bool:
	names = program_names().names
	words = foundation_words(names)
	and(
		and(
			and(spells(names, Some(words.equatable_word), "Equatable"), spells(names, Some(words.equals_word), "equals")),
			and(spells(names, Some(words.not_equals_word), "not_equals"), spells(names, Some(words.orderable_word), "Orderable")),
		),
		and(
			and(spells(names, Some(words.less_than_word), "less_than"), spells(names, Some(words.greater_than_word), "greater_than")),
			and(spells(names, Some(words.less_than_or_equal_word), "less_than_or_equal"), spells(names, Some(words.greater_than_or_equal_word), "greater_than_or_equal")),
		),
	)


pure func test_name_authority_compares_complete_spelling_mapping() -> Bool:
	seed = program_names().names
	left = intern_names(seed, ["left"]).names
	right = intern_names(seed, ["right"]).names
	and(
		and(same_name_table(seed, seed), same_name_table(left, intern_names(seed, ["left"]).names)),
		and(same_name_table(left, right).not(), same_name_table(seed, left).not()),
	)


tests: TestSuite = {
	description = "Blorp 2 name identities",
	tests = [
		(
			"parser shares identity across roles but preserves spans",
			test_parser_shares_identity_across_roles_but_preserves_spans,
		),
		(
			"canonical names share the interning authority",
			test_canonical_names_share_the_interning_authority,
		),
		("repeated spelling has one identity", test_repeated_spelling_has_one_identity),
		(
			"independent extensions keep their own spellings",
			test_independent_extensions_keep_their_own_spellings,
		),
		("interning returns the published identity", test_interning_returns_the_published_identity),
		("returned identity belongs to its extension", test_returned_identity_belongs_to_its_extension),
		("name authority compares complete spelling mapping", test_name_authority_compares_complete_spelling_mapping),
		("seed mints each contextual word", test_seed_mints_each_contextual_word),
		("callable keyword IDs belong to the program seed", test_callable_keyword_ids_belong_to_the_program_seed),
		("seed mints each foundation word", test_seed_mints_each_foundation_word_and_extensions_keep_them),
		("seed mints each canonical operator word", test_seed_mints_each_canonical_operator_word),
		("interning skips known and repeated spellings and returns each ID", test_interning_skips_known_and_repeated_spellings),
		("lookup finds exact spellings and misses near ones", test_lookup_finds_exact_spellings_and_misses_near_ones),
		("lookup survives bucket growth", test_lookup_survives_bucket_growth),
		("multilingual names reintern after growth", test_multilingual_names_reintern_after_growth),
		("colliding spellings keep distinct identities", test_colliding_spellings_keep_distinct_identities),
		("identities survive extension and growth", test_identities_survive_extension_and_growth),
	]
}


private pure func return_type_is_named(written: Option[TypeSyntax], id: NameId, start: Int, end: Int) -> Bool:
	match written:
		Some(value): type_is_named(value, id, start, end)
		None: False
