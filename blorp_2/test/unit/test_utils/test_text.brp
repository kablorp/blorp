import:
	../../../src/utils/text: concat
	string as StringOps
	test: TestCase, TestSuite


pure func test_concatenation_preserves_both_values() -> Bool:
	match StringOps.equals(concat("left", "right"), "leftright"):
		False: False
		True:
			match StringOps.equals(concat("", "right"), "right"):
				False: False
				True: StringOps.equals(concat("left", ""), "left")


pure func tests() -> TestSuite:
	test_case: TestCase = {
		name = "concatenation preserves both values",
		run = test_concatenation_preserves_both_values,
	}
	{
		description = "Blorp 2 text primitives",
		tests = [test_case]
	}
