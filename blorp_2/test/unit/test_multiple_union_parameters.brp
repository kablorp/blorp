import:
	../../src/check_model as Model
	../../src/declarations as Declaration
	../../src/source: module_source, root_module_id
	../../src/check: CheckedProgram, check, checked_functions, union_declaration_id
	../../src/check_errors as Errors
	../../src/check_render as Renderer
	../../src/lex: lex
	../../src/names: name_spelling
	../../src/assemble: parsed_contents
	../../src/specialize as Concrete
	../../src/syntax: Diagnostic, Span, TypeSyntax(AppliedType, AtomicType)
	../../src/text: concat
	input: check_failure, parse, setup_diagnostic, check_modules_failure
	module_input: PRIMITIVE_BASE, INTEGER_OPERATIONS
	test: TestSuite


private pure func payload_free(variants: List[List[Concrete.TypeRef]]) -> Bool:
	match variants:
		[[]]:
			True
		_:
			False


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source.concat("\n"))
	parsed ?= parse(tokens)
	check(parsed)
		.map_err(setup_diagnostic)


pure func test_two_union_parameters_accept_int_constructor_and_pattern() -> Bool:
	source: String =
		|fixed union Either[T, E]:
		|    Ok(T)
		|    Err(E)
		|pure func success() -> Either[Int, Int]:
		|    Ok(7)
		|pure func read(value: Either[Int, Int]) -> Int:
		|    match value:
		|        Ok(item): item
		|        Err(item): item
		|func main() -> Int:
		|    success().read()
	checked(source).is_ok()


pure func test_one_union_parameter_remains_accepted() -> Bool:
	source: String =
		|fixed union Box[T]:
		|    Box(T)
		|pure func box(value: Int) -> Box[Int]:
		|    Box(value)
		|pure func unbox[T](value: Box[T]) -> T:
		|    match value:
		|        Box(item): item
		|func main() -> Int:
		|    box(7).unbox()
	checked(source).is_ok()


private MAIN: String =
	|func main() -> Int:
	|	0

private MARKER: String =
	|fixed union Marker[A,B]:
	|	Only
	|

private TRI: String =
	|fixed union Tri[X,Y,Z]:
	|	Empty
	|


private pure func rejected(source: String) -> Option[Errors.CheckError]:
	check_failure(source.concat("\n"))


private pure func function_parameter(
	id: Model.TypeParameterId,
	owner: Int,
	position: Int,
) -> Bool:
	match Model.parameter_owner(id):
		Model.FunctionDeclaration(function):
			(
				Declaration.function_number(function) == owner
				and Model.parameter_position(id) == position
			)
		_:
			False


private pure func union_parameter(id: Model.TypeParameterId, owner: Int, position: Int) -> Bool:
	match Model.parameter_owner(id):
		Model.UnionDeclaration(declaration):
			(
				Declaration.union_number(declaration) == owner
				and Model.parameter_position(id) == position
			)
		_:
			False


private pure func span_is(value: Span, start: Int, end: Int) -> Bool:
	value.start == start and value.end == end


pure func test_union_duplicates_preserve_owner_positions_and_both_spans() -> Bool:
	prefix = "fixed union Pair[A,"

	match (
		rejected(
			prefix
				.concat("A]:\n\tOnly\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Errors.TypeDeclarationRejection(Errors.DuplicateTypeParameter(current, previous, first)):
					(
						union_parameter(current, 0, 1)
						and union_parameter(previous, 0, 0)
						and span_is(error.span, prefix.length(), prefix.length() + 1)
						and span_is(
							first,
							"fixed union Pair[".length(),
							"fixed union Pair[A".length(),
						)
					)
				_:
					False
		None:
			False


private pure func arity_is(arguments: String, actual: Int) -> Bool:
	prefix = MARKER.concat("pure func bad(value:")
	written = "Marker["
		.concat(arguments)
		.concat("]")

	match (
		rejected(
			prefix
				.concat(written)
				.concat(")->Int:\n\t0\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Errors.TypeTermRejection(Errors.UnionTypeArgumentCountMismatch(owner, 2, count)):
					(
						Declaration.union_number(owner) == 0
						and count == actual
						and span_is(error.span, prefix.length(), prefix.length() + written.length())
					)
				_:
					False
		None:
			False


pure func test_too_few_and_too_many_arguments_have_typed_counts() -> Bool:
	arity_is("Int", 1) and arity_is("Int,String,Int", 3) and arity_is("Missing", 1)


pure func test_bare_application_retains_required_count() -> Bool:
	prefix = MARKER.concat("pure func bad(value:")

	match (
		rejected(
			prefix
				.concat("Marker)->Int:\n\t0\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Errors.TypeTermRejection(Errors.MissingUnionTypeArguments(owner, 2)):
					(
						Declaration.union_number(owner) == 0
						and span_is(error.span, prefix.length(), prefix.length() + 6)
					)
				_:
					False
		None:
			False


pure func test_later_unknown_argument_type_has_its_own_span() -> Bool:
	prefix = MARKER.concat("pure func bad(value:Marker[Int,")

	match (
		rejected(
			prefix
				.concat("Missing])->Int:\n\t0\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Errors.TypeTermRejection(Errors.UnknownType(_)):
					span_is(error.span, prefix.length(), prefix.length() + 7)
				_:
					False
		None:
			False


private pure func single_capture(captures: List[Option[Model.BindingId]]) -> Option[Model.BindingId]:
	if captures.length() == 1:
		captures.get(0).and_then(pure func(capture): capture)
	else:
		None


private pure func constructed_parameter(
	function: Model.CheckedFunction,
	owner: Int,
	position: Int,
) -> Bool:
	match function.body:
		Model.CheckedValueBody(Model.ReturnExpression(value)):
			match (value.base, value.base_type):
				(Model.ReturnConstructedVariant(variant, [child]), Model.AppliedUnionType(union_id, [Model.ParameterType(a), Model.ParameterType(b), Model.ParameterType(c)])):
					match child.base_type:
						Model.ParameterType(payload):
							(
								function_parameter(payload, owner, position)
								and function_parameter(a, owner, 0)
								and function_parameter(b, owner, 1)
								and function_parameter(c, owner, 2)
								and Declaration.union_number(union_id) == 0
								and Declaration.union_number(Declaration.variant_owner(variant)) == 0
								and Declaration.variant_number(variant) == position
							)
						_: False
				_: False
		_: False

pure func test_three_payload_positions_keep_union_and_function_authorities() -> Bool:
	source: String =
		|fixed union Triple[A,B,C]:
		|    First(A)
		|    Second(B)
		|    Third(C)
		|pure func first[X,Y,Z](value:X)->Triple[X,Y,Z]:
		|    First(value)
		|pure func second[X,Y,Z](value:Y)->Triple[X,Y,Z]:
		|    Second(value)
		|pure func third[X,Y,Z](value:Z)->Triple[X,Y,Z]:
		|    Third(value)
		|pure func select[X,Y,Z](value:Triple[X,Y,Z],fallback:Z)->Z:
		|    match value:
		|        First(first): fallback
		|        Second(second): fallback
		|        Third(third): third
		|func main()->Int:
		|    0

	match checked(source):
		Ok(program):
			facts = checked_functions(program)

			match (facts.unions, facts.functions):
				([declaration], [first, second, third, selection, _]):
					match (declaration.variants.map(pure func(variant): variant.fields), selection.body, selection.bindings):
						([[a], [b], [c]], Model.CheckedMatchBody(matched), [_, _, first_binding, second_binding, third_binding]):
							match (
								(a.value_type, b.value_type, c.value_type),
								(
									first_binding.value_type,
									second_binding.value_type,
									third_binding.value_type,
									matched.arms,
								),
							):
								((Model.ParameterType(a), Model.ParameterType(b), Model.ParameterType(c)), (Model.ParameterType(x), Model.ParameterType(y), Model.ParameterType(z), [first_arm, second_arm, third_arm])):
									match (
										first_arm.pattern,
										second_arm.pattern,
										third_arm.pattern,
									):
										(Model.VariantCase(first_variant, first_captures), Model.VariantCase(second_variant, second_captures), Model.VariantCase(third_variant, third_captures)):
											match (single_capture(first_captures), single_capture(second_captures), single_capture(third_captures)):
												(Some(first_id), Some(second_id), Some(third_id)):
													(
														constructed_parameter(first, 0, 0)
														and constructed_parameter(second, 1, 1)
														and constructed_parameter(third, 2, 2)
														and union_parameter(a, 0, 0)
														and union_parameter(b, 0, 1)
														and union_parameter(c, 0, 2)
														and function_parameter(x, 3, 0)
														and function_parameter(y, 3, 1)
														and function_parameter(z, 3, 2)
														and Declaration.variant_number(first_variant) == 0
														and Declaration.variant_number(second_variant) == 1
														and Declaration.variant_number(third_variant) == 2
														and Declaration.union_number(
															Declaration.variant_owner(third_variant),
														) == 0
														and Model.binding_number(first_id) == 2
														and Model.binding_number(second_id) == 3
														and Model.binding_number(third_id) == 4
													)
												_: False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_unused_body_cannot_choose_a_rigid_union_parameter() -> Bool:
	match_body_prefix: String =
		|A:
		|	match value:
		|		Ok(item):item
		|		Err(item):
	declaration: String =
		|fixed union Either[X,Y]:
		|	Ok(X)
		|	Err(Y)
		|
	prefix = declaration.concat("pure func bad[A,B](value:Either[A,B])->")
	body_prefix = prefix.concat(match_body_prefix)

	match (
		rejected(
			body_prefix
				.concat("item\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
					match (mismatch.expected, mismatch.actual.value_type, mismatch.expected_site):
						(Model.ParameterType(expected), Model.ParameterType(actual), Errors.SourceAnnotation(site)):
							(
								function_parameter(expected, 0, 0)
								and function_parameter(actual, 0, 1)
								and span_is(site, prefix.length(), prefix.length() + 1)
								and span_is(
									error.span,
									body_prefix.length(),
									body_prefix.length() + 4,
								)
								and span_is(
									mismatch.actual.span,
									body_prefix.length(),
									body_prefix.length() + 4,
								)
							)
						_:
							False
				_:
					False
		None:
			False


pure func test_one_runtime_argument_infers_three_function_parameters() -> Bool:
	call_source: String =
		|pure func producer()->Tri[Int,String,Int]:
		|	Empty
		|pure func take[A,B,C](value:Tri[A,B,C])->Int:
		|	0
		|func main()->Int:
		|	take(producer())
	source = TRI.concat(call_source)

	match checked(source):
		Ok(program):
			match checked_functions(program).functions:
				[_, _, main]:
					match main.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.base:
								Model.ReturnCall(call, _):
									match call.target:
										Model.UserFunction(id, [Model.IntType, Model.StringType, Model.IntType]):
											match Concrete.specialize(program):
												Ok(concrete):
													(
														Declaration.function_number(id) == 1
														and Concrete.specialized_contents(
															concrete,
														).functions.length() == 3
													)
												Err(_):
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_conflict_before_unseen_parameter_retains_a_rigid_snapshot() -> Bool:
	producer_source: String =
		|pure func producer()->Marker[String,Int]:
		|	Only
		|pure func take[A,B](first:A,value:
	source: String =
		|)->Int:
		|	0
		|func main()->Int:
		|	take(7,
	declarations = MARKER.concat(producer_source)
	annotation = "Marker[A,B]"
	prefix = declarations
		.concat(annotation)
		.concat(source)

	match rejected(prefix.concat("producer())")):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
					match (
						(conflict.mismatch.expected, conflict.mismatch.actual.value_type),
						(
							conflict.previous.value_type,
							conflict.current.value_type,
							conflict.mismatch.expected_site,
						),
					):
						((Model.AppliedUnionType(expected_owner, [Model.IntType, Model.ParameterType(unseen)]), Model.AppliedUnionType(actual_owner, [Model.StringType, Model.IntType])), (Model.IntType, Model.StringType, Errors.SourceAnnotation(site))):
							(
								function_parameter(conflict.parameter, 1, 0)
								and function_parameter(unseen, 1, 1)
								and Declaration.union_number(expected_owner) == 0
								and Declaration.union_number(actual_owner) == 0
								and conflict.mismatch.argument_position == 1
								and span_is(
									conflict.previous.span,
									prefix.length() - 2,
									prefix.length() - 1,
								)
								and span_is(
									conflict.current.span,
									prefix.length(),
									prefix.length() + 10,
								)
								and span_is(
									conflict.mismatch.actual.span,
									prefix.length(),
									prefix.length() + 10,
								)
								and span_is(error.span, prefix.length(), prefix.length() + 10)
								and span_is(
									site,
									declarations.length(),
									declarations.length() + annotation.length(),
								)
							)
						_:
							False
				_:
					False
		None:
			False


pure func test_repeated_parameter_in_one_argument_conflicts_before_later_inference() -> Bool:
