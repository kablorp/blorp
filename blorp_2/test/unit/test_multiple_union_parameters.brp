pure func test_expected_result_does_not_fill_a_later_union_argument() -> Bool:
	prefix = MARKER.concat(
		"pure func empty[A,B](value:A)->Marker[A,B]:\n\tOnly\npure func use()->Marker[Int,String]:\n\t",
	)

	match (
		rejected(
			prefix
				.concat("empty(7)\n")
				.concat(MAIN),
