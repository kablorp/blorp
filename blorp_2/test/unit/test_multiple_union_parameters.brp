private pure func variant_return_matches(function: Concrete.ConcreteFunction) -> Bool:
	match (function.signature.return_type, function.body):
		(Concrete.UnionType(owner), Concrete.ConcreteValueBody(value)):
			match value.base:
				Concrete.ReturnVariant(variant):
					Concrete.union_number(
						owner,
					) == Concrete.union_number(Concrete.variant_owner(variant))
				_:
					False
		_:
			False


pure func test_phantom_keys_include_every_argument_and_nominal_owner() -> Bool:
	source = MARKER
		.concat(
			"fixed union Other[A,B]:\n\tOnly\npure func first()->Marker[Int,Int]:\n\tOnly\npure func second()->Marker[Int,String]:\n\tOnly\npure func third()->Marker[String,Int]:\n\tOnly\npure func other()->Other[Int,Int]:\n\tOnly\npure func again()->Marker[Int,Int]:\n\tOnly\n",
		)
		.concat(MAIN)

	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Ok(program):
			facts = Concrete.specialized_contents(program)

			match facts.functions:
				[first, second, third, other, again, _]:
					match (
						(
							first.signature.return_type,
							second.signature.return_type,
							third.signature.return_type,
						),
						(other.signature.return_type, again.signature.return_type),
					):
						((Concrete.UnionType(a), Concrete.UnionType(b), Concrete.UnionType(c)), (Concrete.UnionType(d), Concrete.UnionType(repeated))):
							(
								variant_return_matches(first)
								and variant_return_matches(second)
								and variant_return_matches(third)
								and variant_return_matches(other)
								and variant_return_matches(again)
								and facts.unions.length() == 4
								and Concrete.union_number(a) == 0
								and Concrete.union_number(b) == 1
								and Concrete.union_number(c) == 2
								and Concrete.union_number(d) == 3
								and Concrete.union_number(repeated) == 0
							)
						_:
							False
				_:
					False
		Err(_):
			False


private pure func call_target(function: Checked.CheckedFunction) -> Option[Checked.CallTarget]:
	match function.body:
		Checked.CheckedValueBody(value):
			match value.base:
				Checked.ReturnCall(call, _):
					Some(call.target)
				_:
					None
		_:
			None


private pure func concrete_target(
	function: Concrete.ConcreteFunction,
) -> Option[Concrete.CallTarget]:
	match function.body:
		Concrete.ConcreteValueBody(value):
			match value.base:
				Concrete.ReturnCall(call, _):
					Some(call.target)
				_:
					None
		_:
			None


pure func test_permuted_forwarding_preserves_caller_ids_and_concrete_target() -> Bool:
	source = MARKER.concat(
		"pure func first[L,R](value:Marker[L,R])->Marker[R,L]:\n\tOnly\npure func forward[X,Y](value:Marker[Y,X])->Marker[X,Y]:\n\tfirst(value)\npure func producer()->Marker[Int,String]:\n\tOnly\npure func witness()->Marker[String,Int]:\n\tOnly\nfunc main()->Int:\n\tsaved = forward(producer())\n\t0",
	)

	match checked(source):
		Ok(program):
			match Checked.checked_functions(program).functions:
				[_, forward, _, _, _]:
					match call_target(forward):
						Some(Checked.UserFunction(target, [Checked.ParameterType(y), Checked.ParameterType(x)])):
							match Concrete.specialize(program):
								Ok(concrete):
									match Concrete.specialized_contents(concrete).functions:
										[producer, witness, _, concrete_forward, concrete_first]:
											match (
												concrete_target(concrete_forward),
												concrete_first.signature.parameters,
											):
												(Some(Concrete.UserFunction(id)), [input]):
													(
														function_parameter(x, 1, 0)
														and function_parameter(y, 1, 1)
														and Checked.function_number(target) == 0
														and Concrete.function_number(id) == 4
														and Concrete.same_type(
															producer.signature.return_type,
															input,
														)
														and Concrete.same_type(
															concrete_forward.signature.return_type,
															concrete_first.signature.return_type,
														)
														and Concrete.same_type(
															concrete_forward.signature.return_type,
															witness.signature.return_type,
														)
														and Concrete.same_type(
															concrete_first.signature.return_type,
															witness.signature.return_type,
														)
														and not Concrete.same_type(
															producer.signature.return_type,
															concrete_forward.signature.return_type,
														)
													)
												_:
													False
										_:
											False
								Err(_):
									False
						_:
							False
				_:
					False
		Err(_):
			False


private pure func rejects_later_payload(source: String, start: Int, end: Int) -> Bool:
	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Err(error):
			match error.note:
				Some(UnionPayloadDeclaration(note)):
					(
						span_is(error.span, start, end)
						and span_is(
							note,
							"fixed union Result[T,E]:\n\tOk(T)\n\tErr(".length(),
							"fixed union Result[T,E]:\n\tOk(T)\n\tErr(E".length(),
						)
						and error.message == "specialized union payload must be Int"
						and error.help == "use Int for this payload; String and union payloads are not supported"
					)
				_:
					False
		Ok(_):
			False


pure func test_later_string_payload_rejects_even_when_only_first_variant_is_constructed() -> Bool:
	declaration = "fixed union Result[T,E]:\n\tOk(T)\n\tErr(E)\n"
	prefix = declaration.concat("pure func success()->")
	annotation = "Result[Int,String]"
	call_prefix = declaration.concat(
		"pure func make[E](value:E)->Result[Int,E]:\n\tOk(7)\nfunc main()->Int:\n\tsaved = ",
	)
	rejects_later_payload(
		prefix
			.concat(annotation)
			.concat(":\n\tOk(7)\n")
			.concat(MAIN),
		prefix.length(),
		prefix.length() + annotation.length(),
	) and rejects_later_payload(
		call_prefix.concat("make(42.to_string())\n\t0"),
		call_prefix.length(),
		call_prefix.length() + 4,
	)


pure func test_arity_renderer_uses_complete_typed_counts_without_rechecking() -> Bool:
	source = MARKER.concat(MAIN)

	match lex(source.concat("\n")).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			match Checked.check(parsed):
				Ok(program):
					match Checked.union_declaration_id(program, 0):
						Some(owner):
							location: Span = {
								start = 3,
								end = 14
							}
							diagnostic = Checked.render_check_error(
								parsed,
								{
									span = location,
									kind = Checked.UnionTypeArgumentCountMismatch(owner, 4, 3)
								},
							)
							missing = Checked.render_check_error(
								parsed,
								{
									span = location,
									kind = Checked.MissingUnionTypeArguments(owner, 4)
								},
							)
							(
								span_is(diagnostic.span, 3, 14)
								and diagnostic.note.is_none()
								and diagnostic.message == "union type argument count does not match its declaration"
								and diagnostic.help == "expected 4 type arguments, got 3; supply atomic types in declaration order"
								and missing.message == "generic union requires type arguments"
								and missing.help == "write 4 atomic type arguments in declaration order"
							)
						None:
							False
				Err(_):
					False
		Err(_):
			False


pure func test_declaration_and_application_lists_preserve_all_names_and_spans() -> Bool:
	before_three = "fixed union Plain:\n\tOnly\nfixed union One[A]:\n\tOnly\nfixed union Two[A,B]:\n\tOnly\n"
	header_prefix = before_three.concat("fixed union Three[")
	declarations = header_prefix.concat("A,B,C]:\n\tOnly\n")
	prefix = declarations.concat("pure func inspect(value:")
	annotation = "Three[ Int, String, Plain ]"
	source = prefix
		.concat(annotation)
		.concat(")->Int:\n\t0")

	match lex(source.concat("\n")).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			facts = parsed_contents(parsed)

			match (facts.unions, facts.functions):
				([plain, one, two, three], [function]):
					match (three.type_parameters, function.parameters):
						([a, b, c], [parameter]):
							match parameter.type_name:
								AppliedType(head, [first, second, last], whole):
									match (
										name_spelling(facts.names, head.id),
										name_spelling(facts.names, first.id),
										name_spelling(facts.names, second.id),
										name_spelling(facts.names, last.id),
									):
										(Some("Three"), Some("Int"), Some("String"), Some("Plain")):
											(
												plain.type_parameters.length() == 0
												and one.type_parameters.length() == 1
												and two.type_parameters.length() == 2
												and span_is(
													a.span,
													header_prefix.length(),
													header_prefix.length() + 1,
												)
												and span_is(
													b.span,
													header_prefix.length() + 2,
													header_prefix.length() + 3,
												)
												and span_is(
													c.span,
													header_prefix.length() + 4,
													header_prefix.length() + 5,
												)
												and span_is(
													head.span,
													prefix.length(),
													prefix.length() + 5,
												)
												and span_is(
													first.span,
													prefix.length() + 7,
													prefix.length() + 10,
												)
												and span_is(
													second.span,
													prefix.length() + 12,
													prefix.length() + 18,
												)
												and span_is(
													last.span,
													prefix.length() + 20,
													prefix.length() + 25,
												)
												and span_is(
													whole,
													prefix.length(),
													prefix.length() + annotation.length(),
												)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


private pure func parser_rejects(
	prefix: String,
	marked: String,
	suffix: String,
	message: String,
	help: String,
) -> Bool:
	match (
		lex(
			prefix
				.concat(marked)
				.concat(suffix),
		).and_then(pure func(tokens): parse(tokens))
	):
		Err(error):
			(
				span_is(error.span, prefix.length(), prefix.length() + marked.length())
				and error.message == message
				and error.help == help
				and error.note.is_none()
			)
		Ok(_):
			False


pure func test_empty_and_malformed_application_lists_reject_exactly() -> Bool:
	help = (
		"use an ASCII identifier starting with a letter or underscore; 'func', 'pure', "
		+ "'match', 'var', and lone '_' are reserved"
	)
	(
		parser_rejects(
			"pure func f(value:Pair[",
			"]",
			")->Int:\n\t0",
			"expected a type argument",
			help,
		)
		and parser_rejects(
			"pure func f(value:Pair[Int,",
			"]",
			")->Int:\n\t0",
			"expected a type argument",
			help,
		)
		and parser_rejects(
			"pure func f(value:Pair[Int,",
			",",
			"String])->Int:\n\t0",
			"expected a type argument",
			help,
		)
		and parser_rejects(
			"pure func f(value:Pair[Int ",
			"String",
			"])->Int:\n\t0",
			"expected ']' after the type arguments",
			"write comma-separated atomic type arguments, such as Result[Int, Int]",
		)
	)


pure func test_nested_later_type_argument_stays_rejected() -> Bool:
	parser_rejects(
		"pure func f(value:Pair[Int,Box",
		"[",
		"Int]])->Int:\n\t0",
		"nested type applications are not supported",
		(
			"use Int, String, a declared parameter, or an ordinary union as the written "
			+ "argument"
		),
	)


pure func test_third_concrete_payload_uses_the_third_argument() -> Bool:
	source = "fixed union Triple[A,B,C]:\n\tEmpty\n\tThird(C)\npure func third()->Triple[String,String,Int]:\n\tThird(11)\npure func read(value:Triple[String,String,Int])->Int:\n\tmatch value:\n\t\tEmpty:0\n\t\tThird(item):item\nfunc main()->Int:\n\tthird().read()"

	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Ok(program):
			facts = Concrete.specialized_contents(program)

			match (facts.unions, facts.functions):
				([declaration], [third, read, _]):
					match (
						declaration.variants,
						third.signature.return_type,
						read.signature.parameters,
						read.body,
					):
						([Concrete.NoPayload, Concrete.IntPayload], Concrete.UnionType(owner), [Concrete.UnionType(parameter)], Concrete.ConcreteMatchBody(matched)):
							match (read.bindings, matched.arms):
								([_, capture], [_, arm]):
									match (capture.value_type, arm.pattern):
										(Concrete.IntType, Concrete.VariantCase(variant, Concrete.BindIntPayload(binding))):
											(
												Concrete.union_number(owner) == 0
												and Concrete.union_number(parameter) == 0
												and Concrete.union_number(matched.owner) == 0
												and Concrete.union_number(
													Concrete.variant_owner(variant),
												) == 0
												and Concrete.variant_number(variant) == 1
												and Checked.binding_number(binding) == 1
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_conflict_renderer_spells_all_established_and_rigid_children() -> Bool:
	source = TRI
		.concat("pure func take[A,B](first:A,second:B)->Int:\n\t0\n")
		.concat(MAIN)

	match lex(source.concat("\n")).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			match Checked.check(parsed):
				Ok(program):
					match (
						Checked.union_declaration_id(program, 0),
						Checked.checked_functions(program).functions,
					):
						(Some(owner), [function, _]):
							match function.signature.type_parameters:
								[a, b]:
									location: Span = {
										start = 5,
										end = 15
									}
									error: Checked.CheckError = {
										span = location,
										kind = Checked.GenericArgumentConflict({
											parameter = a,
											previous = {
												value_type = Checked.IntType,
												span = location
											},
											current = {
												value_type = Checked.StringType,
												span = location
											},
											mismatch = {
												expected = Checked.AppliedUnionType(
													owner,
													[
														Checked.IntType,
														Checked.IntType,
														Checked.ParameterType(b),
													],
												),
												actual = {
													value_type = Checked.AppliedUnionType(
														owner,
														[
															Checked.IntType,
															Checked.StringType,
															Checked.IntType,
														],
													),
													span = location
												},
												argument_position = 0,
												expected_site = Checked.SourceAnnotation({
													start = 20,
													end = 30,
												})
											},
										})
									}
									diagnostic = Checked.render_check_error(parsed, error)
									(
										span_is(diagnostic.span, 5, 15)
										and diagnostic.note.is_none()
										and diagnostic.message == "argument type does not match the parameter type"
										and diagnostic.help == "use an expression of type Tri[Int, Int, B] here"
									)
								_:
									False
						_:
							False
				Err(_):
					False
		Err(_):
			False


pure func test_later_argument_prepares_a_nested_semantic_dependency() -> Bool:
	source: String =
		|fixed union Marker[A,B]:
		|    Only
		|pure func mark[T](value:T)->Marker[Int,T]:
		|    Only
		|func main()->Int:
		|    saved = mark(mark(7))
		|    0

	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Ok(program):
			facts = Concrete.specialized_contents(program)

			match (facts.unions, facts.functions):
				([inner_union, outer_union], [main, inner, outer]):
					match (main.bindings, inner.signature.parameters, outer.signature.parameters):
						([saved], [Concrete.IntType], [Concrete.UnionType(input)]):
							match (
								saved.value_type,
								inner.signature.return_type,
								outer.signature.return_type,
							):
								(Concrete.UnionType(saved_owner), Concrete.UnionType(inner_owner), Concrete.UnionType(outer_owner)):
									(
										inner_union.variants == [Concrete.NoPayload]
										and outer_union.variants == [Concrete.NoPayload]
										and Concrete.union_number(inner_owner) == 0
										and Concrete.union_number(outer_owner) == 1
										and Concrete.union_number(saved_owner) == 1
										and Concrete.union_number(input) == 0
										and variant_return_matches(inner)
										and variant_return_matches(outer)
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


