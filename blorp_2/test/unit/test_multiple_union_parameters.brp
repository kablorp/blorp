		(
			"later argument prepares a nested semantic dependency",
			test_later_argument_prepares_a_nested_semantic_dependency,
		),
		(
			"two union parameters accept int constructor and pattern",
			test_two_union_parameters_accept_int_constructor_and_pattern,
		),
		("one union parameter remains accepted", test_one_union_parameter_remains_accepted),
		(
			"union duplicates preserve owner positions and both spans",
			test_union_duplicates_preserve_owner_positions_and_both_spans,
		),
		(
			"too few and too many arguments have typed counts",
			test_too_few_and_too_many_arguments_have_typed_counts,
		),
		("bare application retains required count", test_bare_application_retains_required_count),
		(
			"later unknown argument type has its own span",
			test_later_unknown_argument_type_has_its_own_span,
		),
		(
			"three payload positions keep union and function authorities",
			test_three_payload_positions_keep_union_and_function_authorities,
		),
		(
			"unused body cannot choose a rigid union parameter",
			test_unused_body_cannot_choose_a_rigid_union_parameter,
		),
		(
			"one runtime argument infers three function parameters",
			test_one_runtime_argument_infers_three_function_parameters,
		),
		(
			"conflict before unseen parameter retains a rigid snapshot",
			test_conflict_before_unseen_parameter_retains_a_rigid_snapshot,
		),
		(
			"repeated parameter in one argument conflicts before later inference",
			test_repeated_parameter_in_one_argument_conflicts_before_later_inference,
		),
		(
			"conflicting children follow annotation order not parameter order",
			test_conflicting_children_follow_annotation_order_not_parameter_order,
		),
		(
			"agreeing children preserve the first candidate occurrence",
			test_agreeing_children_preserve_the_first_candidate_occurrence,
		),
		(
			"missing inference precedes an ordinary mismatch",
			test_missing_inference_precedes_an_ordinary_mismatch,
		),
		("conflict precedes an ordinary mismatch", test_conflict_precedes_an_ordinary_mismatch),
		(
			"later child error precedes structural conflict",
			test_later_child_error_precedes_structural_conflict,
		),
		(
			"expected result completes later union argument",
			test_expected_result_completes_a_later_union_argument,
		),
		(
			"phantom keys include every argument and nominal owner",
			test_phantom_keys_include_every_argument_and_nominal_owner,
		),
		(
			"permuted forwarding preserves caller ids and concrete target",
			test_permuted_forwarding_preserves_caller_ids_and_concrete_target,
		),
		(
			"unused later String payload gives the layout an obligation",
			test_unused_later_string_payload_gives_the_layout_an_obligation,
		),
		(
			"arity renderer uses complete typed counts without rechecking",
			test_arity_renderer_uses_complete_typed_counts_without_rechecking,
		),
		(
			"declaration and application lists preserve all names and spans",
			test_declaration_and_application_lists_preserve_all_names_and_spans,
		),
		(
			"empty and malformed application lists reject exactly",
			test_empty_and_malformed_application_lists_reject_exactly,
		),
		("nested later type argument parses", test_nested_later_type_argument_parses),
		(
			"third concrete payload uses the third argument",
			test_third_concrete_payload_uses_the_third_argument,
		),
		(
			"conflict renderer spells all established and rigid children",
			test_conflict_renderer_spells_all_established_and_rigid_children,
