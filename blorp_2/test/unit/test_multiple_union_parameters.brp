pure func test_later_child_error_precedes_structural_conflict() -> Bool:
	prefix = MARKER.concat(
		"pure func take[A](value:Marker[A,A],last:Int)->Int:\n\t0\npure func producer()->Marker[Int,String]:\n\tOnly\nfunc main()->Int:\n\ttake(producer(),",
