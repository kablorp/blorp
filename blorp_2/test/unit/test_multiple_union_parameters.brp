			"arity renderer uses complete typed counts without rechecking",
			test_arity_renderer_uses_complete_typed_counts_without_rechecking,
		),
		(
			"declaration and application lists preserve all names and spans",
			test_declaration_and_application_lists_preserve_all_names_and_spans,
