private pure func variant_return_matches(function: Concrete.ConcreteFunction) -> Bool:
	match (function.signature.return_type, function.body):
		(Concrete.UnionType(owner), Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
			match value.form:
				Concrete.ConstructVariant(variant, []):
					Concrete.union_number(
						owner,
					) == Concrete.union_number(Concrete.variant_owner(variant))
				_:
					False
		_:
			False


pure func test_phantom_keys_include_every_argument_and_nominal_owner() -> Bool:
	other_source: String =
		|fixed union Other[A,B]:
		|	Only
		|pure func first()->Marker[Int,Int]:
		|	Only
		|pure func second()->Marker[Int,String]:
		|	Only
		|pure func third()->Marker[String,Int]:
		|	Only
		|pure func other()->Other[Int,Int]:
		|	Only
		|pure func again()->Marker[Int,Int]:
		|	Only
		|
	source = MARKER
		.concat(other_source)
		.concat(
			|func main()->Int:
			|    a = first()
			|    b = second()
			|    c = third()
			|    d = other()
			|    e = again()
			|    0
		)

	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Ok(program):
			facts = Concrete.specialized_contents(program)

			match facts.functions:
				[_, first, second, third, other, again]:
					match (
						(
							first.signature.return_type,
							second.signature.return_type,
							third.signature.return_type,
						),
						(other.signature.return_type, again.signature.return_type),
					):
						((Concrete.UnionType(a), Concrete.UnionType(b), Concrete.UnionType(c)), (Concrete.UnionType(d), Concrete.UnionType(repeated))):
							(
								variant_return_matches(first)
								and variant_return_matches(second)
								and variant_return_matches(third)
								and variant_return_matches(other)
								and variant_return_matches(again)
								and facts.unions.length() == 4
								and Concrete.union_number(a) == 0
								and Concrete.union_number(b) == 1
								and Concrete.union_number(c) == 2
								and Concrete.union_number(d) == 3
								and Concrete.union_number(repeated) == 0
							)
						_:
							False
				_:
					False
		Err(_):
			False


private pure func call_target(function: Model.CheckedFunction) -> Option[Model.CallTarget]:
	match function.body:
		Model.CheckedValueBody(Model.ReturnExpression(value)):
			match value.base:
				Model.ReturnCall(call, _):
					Some(call.target)
				_:
					None
		_:
			None


private pure func concrete_target(
	function: Concrete.ConcreteFunction,
) -> Option[Concrete.CallTarget]:
	match function.body:
		Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
			match value.form:
				Concrete.InvokeFunction(call, _):
					Some(call.target)
				_:
					None
		_:
			None


pure func test_permuted_forwarding_preserves_caller_ids_and_concrete_target() -> Bool:
	forwarding_source: String =
		|pure func first[L,R](value:Marker[L,R])->Marker[R,L]:
		|	Only
		|pure func forward[X,Y](value:Marker[Y,X])->Marker[X,Y]:
		|	first(value)
		|pure func producer()->Marker[Int,String]:
		|	Only
		|pure func witness()->Marker[String,Int]:
		|	Only
		|func main()->Int:
		|	saved = forward(producer())
		|	compared = witness()
		|	0
	source = MARKER.concat(forwarding_source)

	match checked(source):
		Ok(program):
			match checked_functions(program).functions:
				[_, forward, _, _, _]:
					match call_target(forward):
						Some(Model.UserFunction(target, [Model.ParameterType(y), Model.ParameterType(x)])):
							match Concrete.specialize(program):
								Ok(concrete):
									match Concrete.specialized_contents(concrete).functions:
										[_, producer, concrete_forward, witness, concrete_first]:
											match (
												concrete_target(concrete_forward),
												concrete_first.signature.parameters,
											):
												(Some(Concrete.UserFunction(id)), [input]):
													(
														function_parameter(x, 1, 0)
														and function_parameter(y, 1, 1)
														and Declaration.function_number(target) == 0
														and Concrete.function_number(id) == 4
														and Concrete.same_type(
															producer.signature.return_type,
															input,
														)
														and Concrete.same_type(
															concrete_forward.signature.return_type,
															concrete_first.signature.return_type,
														)
														and Concrete.same_type(
															concrete_forward.signature.return_type,
															witness.signature.return_type,
														)
														and Concrete.same_type(
															concrete_first.signature.return_type,
															witness.signature.return_type,
														)
														and not Concrete.same_type(
															producer.signature.return_type,
															concrete_forward.signature.return_type,
														)
													)
												_:
													False
										_:
											False
								Err(_):
									False
						_:
							False
				_:
					False
		Err(_):
			False


private pure func admits_later_payload(source: String) -> Bool:
	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Ok(program):
			match Concrete.specialized_contents(program).unions:
				[row]:
					match row.variants:
						[[Concrete.IntType], [Concrete.StringType]]:
							match row.representation:
								Concrete.InlineOwningPayload:
									True
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_unused_later_string_payload_gives_the_layout_an_obligation() -> Bool:
	declaration: String =
		|fixed union Either[T,E]:
		|	Ok(T)
		|	Err(E)
		|
	written: String =
		|pure func success()->Either[Int,String]:
		|	Ok(7)
		|func main()->Int:
		|	unused = success()
		|	0
		|
	inferred: String =
		|pure func make[E](value:E)->Either[Int,E]:
		|	Ok(7)
		|func main()->Int:
		|	saved = make("42")
		|	0
		|
	(
		admits_later_payload(declaration.concat(written))
		and admits_later_payload(declaration.concat(inferred))
	)


pure func test_arity_renderer_uses_complete_typed_counts_without_rechecking() -> Bool:
	source = MARKER.concat(MAIN)

	match lex(module_source(root_module_id()), source.concat("\n")).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			match check(parsed):
				Ok(program):
					match union_declaration_id(program, 0):
						Some(owner):
							location: Span = {
								source = module_source(root_module_id()),
								start = 3,
								end = 14
							}
							diagnostic = Renderer.render_check_error(
								parsed,
								{
									span = location,
									kind = Errors.TypeTermRejection(Errors.UnionTypeArgumentCountMismatch(owner, 4, 3))
								},
							)
							missing = Renderer.render_check_error(
								parsed,
								{
									span = location,
									kind = Errors.TypeTermRejection(Errors.MissingUnionTypeArguments(owner, 4))
								},
							)
							(
								span_is(diagnostic.span, 3, 14)
								and diagnostic.note.is_none()
								and diagnostic.message == "union type argument count does not match its declaration"
								and diagnostic.help == "expected 4 type arguments, got 3; supply types in declaration order"
								and missing.message == "generic union requires type arguments"
								and missing.help == "write 4 type arguments in declaration order"
							)
						None:
							False
				Err(_):
					False
		Err(_):
			False


pure func test_declaration_and_application_lists_preserve_all_names_and_spans() -> Bool:
	before_three: String =
		|fixed union Plain:
		|	Only
		|fixed union One[A]:
		|	Only
		|fixed union Two[A,B]:
		|	Only
		|
	header_prefix = before_three.concat("fixed union Three[")
	declarations = header_prefix.concat("A,B,C]:\n\tOnly\n")
	prefix = declarations.concat("pure func inspect(value:")
	annotation = "Three[ Int, String, Plain ]"
	source = prefix
		.concat(annotation)
		.concat(")->Int:\n\t0")

	match lex(module_source(root_module_id()), source.concat("\n")).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			facts = parsed_contents(parsed)

			match (Declaration.inventory_unions(facts.declarations), Declaration.inventory_functions(facts.declarations).map(pure func(row): row.declaration)):
				([plain, one, two, three], [function]):
					match (three.type_parameters, function.parameters):
						([a, b, c], [parameter]):
							match parameter.type_name:
								AppliedType(head, [AtomicType(first), AtomicType(second), AtomicType(last)], whole):
									match (
										name_spelling(facts.names, head.id),
										name_spelling(facts.names, first.id),
										name_spelling(facts.names, second.id),
										name_spelling(facts.names, last.id),
									):
										(Some("Three"), Some("Int"), Some("String"), Some("Plain")):
											(
												plain.type_parameters.length() == 0
												and one.type_parameters.length() == 1
												and two.type_parameters.length() == 2
												and span_is(
													a.span,
													header_prefix.length(),
													header_prefix.length() + 1,
												)
												and span_is(
													b.span,
													header_prefix.length() + 2,
													header_prefix.length() + 3,
												)
												and span_is(
													c.span,
													header_prefix.length() + 4,
													header_prefix.length() + 5,
												)
												and span_is(
													head.span,
													prefix.length(),
													prefix.length() + 5,
												)
												and span_is(
													first.span,
													prefix.length() + 7,
													prefix.length() + 10,
												)
												and span_is(
													second.span,
													prefix.length() + 12,
													prefix.length() + 18,
												)
												and span_is(
													last.span,
													prefix.length() + 20,
													prefix.length() + 25,
												)
												and span_is(
													whole,
													prefix.length(),
													prefix.length() + annotation.length(),
												)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


private pure func parser_rejects(
	prefix: String,
	marked: String,
	suffix: String,
	message: String,
	help: String,
) -> Bool:
	match (
		lex(
			module_source(root_module_id()),
			prefix
				.concat(marked)
				.concat(suffix),
		).and_then(pure func(tokens): parse(tokens))
	):
		Err(error):
			(
				span_is(error.span, prefix.length(), prefix.length() + marked.length())
				and error.message == message
				and error.help == help
				and error.note.is_none()
			)
		Ok(_):
			False


pure func test_empty_and_malformed_application_lists_reject_exactly() -> Bool:
	help = (
		"use an ASCII identifier starting with a letter or underscore; 'func', 'pure', "
		+ "'match', 'var', and lone '_' are reserved"
	)
	(
		parser_rejects(
			"pure func f(value:Pair[",
			"]",
			")->Int:\n\t0",
			"expected a type argument",
			help,
		)
		and parser_rejects(
			"pure func f(value:Pair[Int,",
			"]",
			")->Int:\n\t0",
			"expected a type argument",
			help,
		)
		and parser_rejects(
			"pure func f(value:Pair[Int,",
			",",
			"String])->Int:\n\t0",
			"expected a type argument",
			help,
		)
		and parser_rejects(
			"pure func f(value:Pair[Int ",
			"String",
			"])->Int:\n\t0",
			"expected ']' after the type arguments",
			"write comma-separated type arguments, such as Result[Box[Int], Int]",
		)
	)


pure func test_nested_later_type_argument_parses() -> Bool:
	lex(module_source(root_module_id()), "pure func f(value:Pair[Int,Box[Int]])->Int:\n\t0\n")
		.and_then(pure func(tokens): parse(tokens))
		.is_ok()


pure func test_third_concrete_payload_uses_the_third_argument() -> Bool:
	source: String =
		|fixed union Triple[A,B,C]:
		|	Empty
		|	Third(C)
		|pure func third()->Triple[String,String,Int]:
		|	Third(11)
		|pure func read(value:Triple[String,String,Int])->Int:
		|	match value:
		|		Empty:0
		|		Third(item):item
		|func main()->Int:
		|	third().read()

	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Ok(program):
			facts = Concrete.specialized_contents(program)

			match (facts.unions, facts.functions):
				([declaration], [_, third, read]):
					match (
						declaration.variants,
						third.signature.return_type,
						read.signature.parameters,
						read.body,
					):
						([[], [Concrete.IntType]], Concrete.UnionType(owner), [Concrete.UnionType(parameter)], Concrete.ConcreteMatchBody(matched)):
							match (read.bindings, matched.arms):
								([_, capture], [_, arm]):
									match (capture.value_type, arm.pattern):
										(Concrete.IntType, Concrete.VariantCase(variant, captures)):
											match single_capture(captures):
												Some(binding):
													(
														Concrete.union_number(owner) == 0
														and Concrete.union_number(parameter) == 0
														and Concrete.union_number(matched.owner) == 0
														and Concrete.union_number(
															Concrete.variant_owner(variant),
														) == 0
														and Concrete.variant_number(variant) == 1
														and Model.binding_number(binding) == 1
													)
												None: False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_conflict_renderer_spells_all_established_and_rigid_children() -> Bool:
	take_source: String =
		|pure func take[A,B](first:A,second:B)->Int:
		|	0
		|
	source = TRI
		.concat(take_source)
		.concat(MAIN)

	match lex(module_source(root_module_id()), source.concat("\n")).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			match check(parsed):
				Ok(program):
					match (
						union_declaration_id(program, 0),
						checked_functions(program).functions,
					):
						(Some(owner), [function, _]):
							match function.signature.type_parameters:
								[a, b]:
									location: Span = {
										source = module_source(root_module_id()),
										start = 5,
										end = 15
									}
									error: Errors.CheckError = {
										span = location,
										kind = Errors.CallRejection(Errors.GenericArgumentConflict({
											parameter = a,
											previous = {
												value_type = Model.IntType,
												span = location
											},
											current = {
												value_type = Model.StringType,
												span = location
											},
											mismatch = {
												expected = Model.AppliedUnionType(
													owner,
													[
														Model.IntType,
														Model.IntType,
														Model.ParameterType(b),
													],
												),
												actual = {
													value_type = Model.AppliedUnionType(
														owner,
														[
															Model.IntType,
															Model.StringType,
															Model.IntType,
														],
													),
													span = location
												},
												argument_position = 0,
												expected_site = Errors.SourceAnnotation({
													source = module_source(root_module_id()),
													start = 20,
													end = 30,
												})
											},
										}))
									}
									diagnostic = Renderer.render_check_error(parsed, error)
									(
										span_is(diagnostic.span, 5, 15)
										and diagnostic.note.is_none()
										and diagnostic.message == "argument type does not match the parameter type"
										and diagnostic.help == "use an expression of type Tri[Int, Int, B] here"
									)
								_:
									False
						_:
							False
				Err(_):
					False
		Err(_):
			False


pure func test_later_argument_prepares_a_nested_semantic_dependency() -> Bool:
	source: String =
		|fixed union Marker[A,B]:
		|    Only
		|pure func mark[T](value:T)->Marker[Int,T]:
		|    Only
		|func main()->Int:
		|    saved = mark(mark(7))
		|    0

	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Ok(program):
			facts = Concrete.specialized_contents(program)

			match (facts.unions, facts.functions):
				([inner_union, outer_union], [main, inner, outer]):
					match (main.bindings, inner.signature.parameters, outer.signature.parameters):
						([saved], [Concrete.IntType], [Concrete.UnionType(input)]):
							match (
								saved.value_type,
								inner.signature.return_type,
								outer.signature.return_type,
							):
								(Concrete.UnionType(saved_owner), Concrete.UnionType(inner_owner), Concrete.UnionType(outer_owner)):
									(
										payload_free(inner_union.variants)
										and payload_free(outer_union.variants)
										and Concrete.union_number(inner_owner) == 0
										and Concrete.union_number(outer_owner) == 1
										and Concrete.union_number(saved_owner) == 1
										and Concrete.union_number(input) == 0
										and variant_return_matches(inner)
										and variant_return_matches(outer)
									)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


