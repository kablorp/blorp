	prefix = MARKER.concat(
		"pure func take[A](wrong:Int,value:Marker[A,A])->Int:\n\t0\npure func producer()->Marker[Int,String]:\n\tOnly\nfunc main()->Int:\n\ttake(8.to_string(),",
