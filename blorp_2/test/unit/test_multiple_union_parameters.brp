import:
	../../src/check as Checked
	../../src/lex: lex
	../../src/names: name_spelling
	../../src/parse: parsed_contents
	../../src/specialize as Concrete
	../../src/syntax:
		Diagnostic,
		DiagnosticNote(UnionPayloadDeclaration),
		Span,
		TypeSyntax(AppliedType),
	../../src/text: concat
	input: check_failure, parse, setup_diagnostic
	test: TestSuite


private pure func checked(source: String) -> Result[Checked.CheckedProgram, Diagnostic]:
	tokens ?= lex(source.concat("\n"))
	parsed ?= parse(tokens)
	Checked
		.check(parsed)
		.map_err(setup_diagnostic)


pure func test_two_union_parameters_accept_int_constructor_and_pattern() -> Bool:
	source: String =
		|fixed union Result[T, E]:
		|    Ok(T)
		|    Err(E)
		|pure func success() -> Result[Int, Int]:
		|    Ok(7)
		|pure func read(value: Result[Int, Int]) -> Int:
		|    match value:
		|        Ok(item): item
		|        Err(item): item
		|func main() -> Int:
		|    success().read()
	checked(source).is_ok()


pure func test_one_union_parameter_remains_accepted() -> Bool:
	source: String =
		|fixed union Box[T]:
		|    Box(T)
		|pure func box(value: Int) -> Box[Int]:
		|    Box(value)
		|pure func unbox[T](value: Box[T]) -> T:
		|    match value:
		|        Box(item): item
		|func main() -> Int:
		|    box(7).unbox()
	checked(source).is_ok()


private MAIN: String = "func main() -> Int:\n\t0"

private MARKER: String = "fixed union Marker[A,B]:\n\tOnly\n"

private TRI: String = "fixed union Tri[X,Y,Z]:\n\tEmpty\n"


private pure func rejected(source: String) -> Option[Checked.CheckError]:
	check_failure(source.concat("\n"))


private pure func function_parameter(
	id: Checked.TypeParameterId,
	owner: Int,
	position: Int,
) -> Bool:
	match Checked.parameter_owner(id):
		Checked.FunctionDeclaration(function):
			(
				Checked.function_number(function) == owner
				and Checked.parameter_position(id) == position
			)
		_:
			False


private pure func union_parameter(id: Checked.TypeParameterId, owner: Int, position: Int) -> Bool:
	match Checked.parameter_owner(id):
		Checked.UnionDeclaration(declaration):
			(
				Checked.union_number(declaration) == owner
				and Checked.parameter_position(id) == position
			)
		_:
			False


private pure func span_is(value: Span, start: Int, end: Int) -> Bool:
	value.start == start and value.end == end


pure func test_union_duplicates_preserve_owner_positions_and_both_spans() -> Bool:
	prefix = "fixed union Pair[A,"

	match (
		rejected(
			prefix
				.concat("A]:\n\tOnly\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Checked.DuplicateTypeParameter(current, previous, first):
					(
						union_parameter(current, 0, 1)
						and union_parameter(previous, 0, 0)
						and span_is(error.span, prefix.length(), prefix.length() + 1)
						and span_is(
							first,
							"fixed union Pair[".length(),
							"fixed union Pair[A".length(),
						)
					)
				_:
					False
		None:
			False


private pure func arity_is(arguments: String, actual: Int) -> Bool:
	prefix = MARKER.concat("pure func bad(value:")
	written = "Marker["
		.concat(arguments)
		.concat("]")

	match (
		rejected(
			prefix
				.concat(written)
				.concat(")->Int:\n\t0\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Checked.UnionTypeArgumentCountMismatch(owner, 2, count):
					(
						Checked.union_number(owner) == 0
						and count == actual
						and span_is(error.span, prefix.length(), prefix.length() + written.length())
					)
				_:
					False
		None:
			False


pure func test_too_few_and_too_many_arguments_have_typed_counts() -> Bool:
	arity_is("Int", 1) and arity_is("Int,String,Int", 3) and arity_is("Missing", 1)


pure func test_bare_application_retains_required_count() -> Bool:
	prefix = MARKER.concat("pure func bad(value:")

	match (
		rejected(
			prefix
				.concat("Marker)->Int:\n\t0\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Checked.MissingUnionTypeArguments(owner, 2):
					(
						Checked.union_number(owner) == 0
						and span_is(error.span, prefix.length(), prefix.length() + 6)
					)
				_:
					False
		None:
			False


pure func test_later_unknown_argument_type_has_its_own_span() -> Bool:
	prefix = MARKER.concat("pure func bad(value:Marker[Int,")

	match (
		rejected(
			prefix
				.concat("Missing])->Int:\n\t0\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Checked.UnknownType(_):
					span_is(error.span, prefix.length(), prefix.length() + 7)
				_:
					False
		None:
			False


private pure func constructed_parameter(
	function: Checked.CheckedFunction,
	owner: Int,
	position: Int,
) -> Bool:
	match function.body:
		Checked.CheckedValueBody(value):
			match (value.base_type, value.operations):
				(Checked.ParameterType(payload), [step]):
					match (step.operation, step.value_type):
						(Checked.ConstructVariant(variant), Checked.AppliedUnionType(union_id, [Checked.ParameterType(a), Checked.ParameterType(b), Checked.ParameterType(c)])):
							(
								function_parameter(payload, owner, position)
								and function_parameter(a, owner, 0)
								and function_parameter(b, owner, 1)
								and function_parameter(c, owner, 2)
								and Checked.union_number(union_id) == 0
								and Checked.union_number(Checked.variant_owner(variant)) == 0
								and Checked.variant_number(variant) == position
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_three_payload_positions_keep_union_and_function_authorities() -> Bool:
	source: String =
		|fixed union Triple[A,B,C]:
		|    First(A)
		|    Second(B)
		|    Third(C)
		|pure func first[X,Y,Z](value:X)->Triple[X,Y,Z]:
		|    First(value)
		|pure func second[X,Y,Z](value:Y)->Triple[X,Y,Z]:
		|    Second(value)
		|pure func third[X,Y,Z](value:Z)->Triple[X,Y,Z]:
		|    Third(value)
		|pure func select[X,Y,Z](value:Triple[X,Y,Z],fallback:Z)->Z:
		|    match value:
		|        First(first): fallback
		|        Second(second): fallback
		|        Third(third): third
		|func main()->Int:
		|    0

	match checked(source):
		Ok(program):
			facts = Checked.checked_functions(program)

			match (facts.unions, facts.functions):
				([declaration], [first, second, third, selection, _]):
					match (declaration.variants, selection.body, selection.bindings):
						([Some(a), Some(b), Some(c)], Checked.CheckedMatchBody(matched), [_, _, first_binding, second_binding, third_binding]):
							match (
								(a.value_type, b.value_type, c.value_type),
								(
									first_binding.value_type,
									second_binding.value_type,
									third_binding.value_type,
									matched.arms,
								),
							):
								((Checked.ParameterType(a), Checked.ParameterType(b), Checked.ParameterType(c)), (Checked.ParameterType(x), Checked.ParameterType(y), Checked.ParameterType(z), [first_arm, second_arm, third_arm])):
									match (
										first_arm.pattern,
										second_arm.pattern,
										third_arm.pattern,
									):
										(Checked.VariantCase(first_variant, Checked.BindPayload(first_id)), Checked.VariantCase(second_variant, Checked.BindPayload(second_id)), Checked.VariantCase(third_variant, Checked.BindPayload(third_id))):
											(
												constructed_parameter(first, 0, 0)
												and constructed_parameter(second, 1, 1)
												and constructed_parameter(third, 2, 2)
												and union_parameter(a, 0, 0)
												and union_parameter(b, 0, 1)
												and union_parameter(c, 0, 2)
												and function_parameter(x, 3, 0)
												and function_parameter(y, 3, 1)
												and function_parameter(z, 3, 2)
												and Checked.variant_number(first_variant) == 0
												and Checked.variant_number(second_variant) == 1
												and Checked.variant_number(third_variant) == 2
												and Checked.union_number(
													Checked.variant_owner(third_variant),
												) == 0
												and Checked.binding_number(first_id) == 2
												and Checked.binding_number(second_id) == 3
												and Checked.binding_number(third_id) == 4
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_unused_body_cannot_choose_a_rigid_union_parameter() -> Bool:
	declaration = "fixed union Result[X,Y]:\n\tOk(X)\n\tErr(Y)\n"
	prefix = declaration.concat("pure func bad[A,B](value:Result[A,B])->")
	body_prefix = prefix.concat("A:\n\tmatch value:\n\t\tOk(item):item\n\t\tErr(item):")

	match (
		rejected(
			body_prefix
				.concat("item\n")
				.concat(MAIN),
		)
	):
		Some(error):
			match error.kind:
				Checked.ExpressionTypeMismatch(mismatch):
					match (mismatch.expected, mismatch.actual.value_type, mismatch.expected_site):
						(Checked.ParameterType(expected), Checked.ParameterType(actual), Checked.SourceAnnotation(site)):
							(
								function_parameter(expected, 0, 0)
								and function_parameter(actual, 0, 1)
								and span_is(site, prefix.length(), prefix.length() + 1)
								and span_is(
									error.span,
									body_prefix.length(),
									body_prefix.length() + 4,
								)
								and span_is(
									mismatch.actual.span,
									body_prefix.length(),
									body_prefix.length() + 4,
								)
							)
						_:
							False
				_:
					False
		None:
			False


pure func test_one_runtime_argument_infers_three_function_parameters() -> Bool:
	source = TRI.concat(
		"pure func producer()->Tri[Int,String,Int]:\n\tEmpty\npure func take[A,B,C](value:Tri[A,B,C])->Int:\n\t0\nfunc main()->Int:\n\ttake(producer())",
	)

	match checked(source):
		Ok(program):
			match Checked.checked_functions(program).functions:
				[_, _, main]:
					match main.body:
						Checked.CheckedValueBody(value):
							match value.base:
								Checked.ReturnCall(call, _):
									match call.target:
										Checked.UserFunction(id, [Checked.IntType, Checked.StringType, Checked.IntType]):
											match Concrete.specialize(program):
												Ok(concrete):
													(
														Checked.function_number(id) == 1
														and Concrete.specialized_contents(
															concrete,
														).functions.length() == 3
													)
												Err(_):
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_conflict_before_unseen_parameter_retains_a_rigid_snapshot() -> Bool:
	declarations = MARKER.concat(
		"pure func producer()->Marker[String,Int]:\n\tOnly\npure func take[A,B](first:A,value:",
	)
	annotation = "Marker[A,B]"
	prefix = declarations
		.concat(annotation)
		.concat(")->Int:\n\t0\nfunc main()->Int:\n\ttake(7,")

	match rejected(prefix.concat("producer())")):
		Some(error):
			match error.kind:
				Checked.GenericArgumentConflict(conflict):
					match (
						(conflict.mismatch.expected, conflict.mismatch.actual.value_type),
						(
							conflict.previous.value_type,
							conflict.current.value_type,
							conflict.mismatch.expected_site,
						),
					):
						((Checked.AppliedUnionType(expected_owner, [Checked.IntType, Checked.ParameterType(unseen)]), Checked.AppliedUnionType(actual_owner, [Checked.StringType, Checked.IntType])), (Checked.IntType, Checked.StringType, Checked.SourceAnnotation(site))):
							(
								function_parameter(conflict.parameter, 1, 0)
								and function_parameter(unseen, 1, 1)
								and Checked.union_number(expected_owner) == 0
								and Checked.union_number(actual_owner) == 0
								and conflict.mismatch.argument_position == 1
								and span_is(
									conflict.previous.span,
									prefix.length() - 2,
									prefix.length() - 1,
								)
								and span_is(
									conflict.current.span,
									prefix.length(),
									prefix.length() + 10,
								)
								and span_is(
									conflict.mismatch.actual.span,
									prefix.length(),
									prefix.length() + 10,
								)
								and span_is(error.span, prefix.length(), prefix.length() + 10)
								and span_is(
									site,
									declarations.length(),
									declarations.length() + annotation.length(),
								)
							)
						_:
							False
				_:
					False
		None:
			False


pure func test_repeated_parameter_in_one_argument_conflicts_before_later_inference() -> Bool:
	declarations = TRI.concat(
		"pure func producer()->Tri[Int,String,Int]:\n\tEmpty\npure func repeated[A,B](value:",
	)
	annotation = "Tri[A,A,B]"
	prefix = declarations
		.concat(annotation)
		.concat(")->Int:\n\t0\nfunc main()->Int:\n\trepeated(")

	match rejected(prefix.concat("producer())")):
		Some(error):
			match error.kind:
				Checked.GenericArgumentConflict(conflict):
					match (
						(conflict.mismatch.expected, conflict.mismatch.actual.value_type),
						(
							conflict.previous.value_type,
							conflict.current.value_type,
							conflict.mismatch.expected_site,
						),
					):
						((Checked.AppliedUnionType(expected_owner, [Checked.IntType, Checked.IntType, Checked.ParameterType(unseen)]), Checked.AppliedUnionType(actual_owner, [Checked.IntType, Checked.StringType, Checked.IntType])), (Checked.IntType, Checked.StringType, Checked.SourceAnnotation(site))):
							(
								function_parameter(conflict.parameter, 1, 0)
								and function_parameter(unseen, 1, 1)
								and Checked.union_number(expected_owner) == 0
								and Checked.union_number(actual_owner) == 0
								and conflict.mismatch.argument_position == 0
								and span_is(
									conflict.previous.span,
									prefix.length(),
									prefix.length() + 10,
								)
								and span_is(
									conflict.current.span,
									prefix.length(),
									prefix.length() + 10,
								)
								and span_is(
									conflict.mismatch.actual.span,
									prefix.length(),
									prefix.length() + 10,
								)
								and span_is(error.span, prefix.length(), prefix.length() + 10)
								and span_is(
									site,
									declarations.length(),
									declarations.length() + annotation.length(),
								)
							)
						_:
							False
				_:
					False
		None:
			False


pure func test_conflicting_children_follow_annotation_order_not_parameter_order() -> Bool:
	prefix = MARKER.concat(
		"pure func producer()->Marker[String,String]:\n\tOnly\npure func take[A,B](first:A,second:B,value:Marker[B,A])->Int:\n\t0\nfunc main()->Int:\n\ttake(7,8,",
	)

	match rejected(prefix.concat("producer())")):
		Some(error):
			match error.kind:
				Checked.GenericArgumentConflict(conflict):
					(
						function_parameter(conflict.parameter, 1, 1)
						and conflict.mismatch.argument_position == 2
						and span_is(
							conflict.previous.span,
							prefix.length() - 2,
							prefix.length() - 1,
						)
						and span_is(error.span, prefix.length(), prefix.length() + 10)
					)
				_:
					False
		None:
			False


pure func test_agreeing_children_preserve_the_first_candidate_occurrence() -> Bool:
	prefix = MARKER.concat(
		"pure func agreeing()->Marker[Int,Int]:\n\tOnly\npure func disagreeing()->Marker[Int,String]:\n\tOnly\npure func take[A](first:A,agree:Marker[A,A],bad:Marker[A,A])->Int:\n\t0\nfunc main()->Int:\n\ttake(7,agreeing(),",
	)

	match rejected(prefix.concat("disagreeing())")):
		Some(error):
			match error.kind:
				Checked.GenericArgumentConflict(conflict):
					(
						function_parameter(conflict.parameter, 2, 0)
						and conflict.mismatch.argument_position == 2
						and span_is(
							conflict.previous.span,
							prefix.length() - 13,
							prefix.length() - 12,
						)
						and span_is(conflict.current.span, prefix.length(), prefix.length() + 13)
					)
				_:
					False
		None:
			False


pure func test_missing_inference_precedes_an_ordinary_mismatch() -> Bool:
	prefix = MARKER.concat(
		"pure func take[A,B](wrong:Int,value:Marker[A,A])->Int:\n\t0\npure func producer()->Marker[Int,Int]:\n\tOnly\nfunc main()->Int:\n\t",
	)

	match rejected(prefix.concat("take(8.to_string(),producer())")):
		Some(error):
			match error.kind:
				Checked.UninferableTypeParameter(parameter):
					(
						function_parameter(parameter, 0, 1)
						and span_is(error.span, prefix.length(), prefix.length() + 4)
					)
				_:
					False
		None:
			False


