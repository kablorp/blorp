pure func test_missing_inference_precedes_an_ordinary_mismatch() -> Bool:
	source: String =
		|pure func take[A,B](wrong:Int,value:Marker[A,A])->Int:
		|	0
		|pure func producer()->Marker[Int,Int]:
		|	Only
		|func main()->Int:
	prefix = "import:\n    int: to_string\n".concat(MARKER).concat(source + "\n\t")

	match check_modules_failure([
		{ source = (prefix.concat("take(8.to_string(),producer())")).concat("\n"), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.UninferableTypeParameter(parameter)):
					(
						function_parameter(parameter, 0, 1)
						and span_is(error.span, prefix.length(), prefix.length() + 4)
					)
				_:
					False
		None:
			False


