pure func test_expected_result_completes_a_later_union_argument() -> Bool:
	source: String =
		|pure func empty[A,B](value:A)->Marker[A,B]:
		|    Only
		|pure func use()->Marker[Int,String]:
		|    empty(7)
		|
	match checked(MARKER + source + MAIN):
		Ok(program):
			match checked_functions(program).functions.get(1):
				Some(function):
					match function.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.base:
								Model.ReturnCall(call, [_]):
									match call.target:
										Model.UserFunction(owner, [Model.IntType, Model.StringType]): Declaration.function_number(owner) == 0
										_: False
								_: False
						_: False
				None: False
		Err(_): False


