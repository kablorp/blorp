		),
		(
			"too few and too many arguments have typed counts",
			test_too_few_and_too_many_arguments_have_typed_counts,
		),
		("bare application retains required count", test_bare_application_retains_required_count),
		(
			"later unknown argument type has its own span",
			test_later_unknown_argument_type_has_its_own_span,
		),
		(
			"three payload positions keep union and function authorities",
			test_three_payload_positions_keep_union_and_function_authorities,
		),
		(
			"unused body cannot choose a rigid union parameter",
			test_unused_body_cannot_choose_a_rigid_union_parameter,
		),
		(
			"one runtime argument infers three function parameters",
			test_one_runtime_argument_infers_three_function_parameters,
