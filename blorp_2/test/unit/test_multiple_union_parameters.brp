			match error.kind:
				Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
					match (
						(conflict.mismatch.expected, conflict.mismatch.actual.value_type),
						(
							conflict.previous.value_type,
							conflict.current.value_type,
							conflict.mismatch.expected_site,
						),
					):
						((Model.AppliedUnionType(expected_owner, [Model.IntType, Model.IntType, Model.ParameterType(unseen)]), Model.AppliedUnionType(actual_owner, [Model.IntType, Model.StringType, Model.IntType])), (Model.IntType, Model.StringType, Errors.SourceAnnotation(site))):
							(
								function_parameter(conflict.parameter, 1, 0)
