import:
	../../src/emit/emit: emit
	../../src/lower/lower as Lower
	../../src/own/own as Own
	../../src/namespace/builtins as Builtins: RuntimeOperation(StringLength)
	../../src/specialize/specialize as Concrete
	../../src/utils/syntax: Entrypoint(NoArguments), EntryResult(IntegerExitStatus), FunctionExecution(OrdinaryCalls), entry_function
	../../src/verify/verify: verify
	ownership_inputs: InputIds, function, input_ids, integer, runtime, span
	test: TestSuite


private pure func literal(id: Lower.ValueId, bytes: String, at: Int) -> Lower.ValueDefinition:
	{
		id = id,
		value_type = Concrete.StringType,
		operation = Lower.StringValue(bytes),
		span = span(at)
	}


pure func test_literal_has_no_operand_use() -> Bool:
	match input_ids():
		Ok(ids):
			match (
				Own.last_uses(
					[literal(ids.first, "hello", 10), integer(ids.second, 0, 20)],
					ids.second,
				)
			):
				Ok(uses):
					Lower.value_number(ids.first) == 0 and uses == [None, Some(2)]
				Err(_):
					False
		Err(_):
			False


pure func test_unused_literal_gets_a_fresh_owner_and_immediate_drop() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match (
				Own.insert_function(
					function(
						[literal(ids.first, "unused", 10), integer(ids.second, 0, 20)],
						ids.second,
						[],
						Concrete.IntType,
					),
					[],
					[],
				)
			):
				Ok(output):
					match output.operations:
						[Own.DefineValue(value), Own.DropOwner(dropped, at), Own.DefineValue(_)]:
							match (value.operation, value.result):
								(Own.StringDefinition(bytes), Own.OwnedResult(owner)):
									(
										bytes == "unused"
										and Own.owner_number(owner) == 0
										and Own.owner_number(dropped) == 0
										and at.start == 10
									)
								_:
									False
						_:
							False
				Err(_):
					False


pure func test_literal_return_transfers_its_fresh_owner() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match Own.insert_function(
				function([literal(ids.first, "returned", 10)], ids.first, [], Concrete.StringType),
				[],
				[],
			):
				Ok(output):
					match (output.operations, output.tail):
						([Own.DefineValue(value)], Own.ReturnTail(Own.ReturnResult(Own.OwnedReturn(returned, transferred)))):
							match value.result:
								Own.OwnedResult(owner):
									(
										Lower.value_number(returned) == 0
										and Own.owner_number(owner) == 0
										and Own.owner_number(transferred) == 0
									)
								_:
									False
						_:
							False
				Err(_):
					False


pure func test_length_borrows_literal_until_its_final_use() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match (
				Own.insert_function(
					function(
						[
							literal(ids.first, "hello", 10),
							runtime(
								ids.second,
								Builtins.StringLength,
								[ids.first],
								Concrete.IntType,
								20,
							),
						],
						ids.second,
						[],
						Concrete.IntType,
					),
					[],
					[],
				)
			):
				Ok(output):
					match output.operations:
						[Own.DefineValue(_), Own.DefineValue(length), Own.DropOwner(owner, at)]:
							match length.operation:
								Own.CallDefinition(_, [Own.BorrowedArgument(borrow)]):
									match borrow.source:
										Own.OwnerBorrow(borrowed):
											(
												Lower.value_number(borrow.value) == 0
												and Own.owner_number(borrowed) == 0
												and Own.owner_number(owner) == 0
												and at.start == 20
											)
										_:
											False
								_:
									False
						_:
							False
				Err(_):
					False


private pure func owned_literal(
	id: Lower.ValueId,
	result: Own.ResultOwnership,
	at: Int,
) -> Own.OwnershipOperation:
	Own.DefineValue({
		id = id,
		value_type = Concrete.StringType,
		operation = Own.StringDefinition("hello"),
		result = result,
		span = span(at),
	})


private pure func owned_zero(id: Lower.ValueId, at: Int) -> Own.OwnershipOperation:
	Own.DefineValue({
		id = id,
		value_type = Concrete.IntType,
		operation = Own.IntegerDefinition(0),
		result = Own.UnmanagedResult,
		span = span(at),
	})


private pure func program(
	ids: InputIds,
	operations: List[Own.OwnershipOperation],
	returned: Lower.ValueId,
) -> Own.OwnershipProgram:
	{
		records = [],
		unions = [],
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
		functions = [
			{
				execution = OrdinaryCalls,
				signature = {
					parameters = [],
					return_type = Concrete.IntType
				},
				operations = operations,
				tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(returned)))
			},
		]
	}


private pure func rejects(input: Own.OwnershipProgram, message: String, at: Int) -> Bool:
	match verify(input):
		Err(error):
			(
				error.message == "ownership verification failed: " + message
				and error.span.start == at
				and error.span.end == at + 1
				and error.help == "report this compiler error with the input program"
			)
		Ok(_):
			False


pure func test_verifier_rejects_unmanaged_literal() -> Bool:
	match input_ids():
		Ok(ids):
			rejects(
				program(
					ids,
					[owned_literal(ids.first, Own.UnmanagedResult, 10), owned_zero(ids.second, 20)],
					ids.second,
				),
				"managed result requires an owner",
				10,
			)
		Err(_):
			False


pure func test_verifier_rejects_borrowed_literal() -> Bool:
	match input_ids():
		Ok(ids):
			rejects(
				program(
					ids,
					[owned_literal(
							ids.first,
							Own.BorrowedResult(Own.ParameterBorrow(ids.first)),
							10,
						), owned_zero(ids.second, 20)],
					ids.second,
				),
				"managed result requires an owner",
				10,
			)
		Err(_):
			False


pure func test_verifier_rejects_duplicate_literal_owner() -> Bool:
	match input_ids():
		Ok(ids):
			rejects(
				program(
					ids,
					[owned_literal(
							ids.first,
							Own.OwnedResult(Own.owner_id(0)),
							10,
						), owned_literal(
							ids.second,
							Own.OwnedResult(Own.owner_id(0)),
							20,
						), owned_zero(ids.third, 30)],
					ids.third,
				),
				"owner 0 is defined more than once",
				20,
			)
		Err(_):
			False


pure func test_verifier_rejects_leaked_literal_owner() -> Bool:
	match input_ids():
		Ok(ids):
			rejects(
				program(
					ids,
					[owned_literal(
							ids.first,
							Own.OwnedResult(Own.owner_id(0)),
							10,
						), owned_zero(ids.second, 20)],
					ids.second,
				),
				"owner 0 remains live at return",
				20,
			)
		Err(_):
			False


pure func test_verifier_derives_string_type_from_literal_operation() -> Bool:
	match input_ids():
		Ok(ids):
			rejects(
				program(ids, [Own.DefineValue({
							id = ids.first,
							value_type = Concrete.IntType,
							operation = Own.StringDefinition("bad type"),
							result = Own.UnmanagedResult,
							span = span(10),
						})], ids.first),
				"definition type does not match its operation",
				10,
			)
		Err(_):
			False


private pure func emits_literal(bytes: String, expected: String) -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			input = program(
				ids,
				[Own.DefineValue({
						id = ids.first,
						value_type = Concrete.StringType,
						operation = Own.StringDefinition(bytes),
						result = Own.OwnedResult(Own.owner_id(0)),
						span = span(10),
					}), Own.DropOwner(
						Own.owner_id(0),
						span(10),
					), owned_zero(ids.second, 20)],
				ids.second,
			)

			match verify(input).and_then(pure func(verified): emit(verified)):
				Ok(code):
					code.contains(expected)
				Err(_):
					False


pure func test_emission_preserves_escape_bytes_and_explicit_length() -> Bool:
	emits_literal(
		"\0" + "7\n\r\t\\\"??/",
		(
			"static const unsigned char blorp_bytes_0[]={0,55,10,13,9,92,34,63,63,47};struct "
			+ "blorp_string* const blorp_vl_0=blorp_string_from_bytes((const char "
			+ "*)blorp_bytes_0,INT64_C(10))"
		),
	)


pure func test_emission_projects_utf8_as_exact_array_bytes() -> Bool:
	emits_literal(
		"é😀",
		(
			"static const unsigned char blorp_bytes_0[]={195,169,240,159,152,128};struct "
			+ "blorp_string* const blorp_vl_0=blorp_string_from_bytes((const char "
			+ "*)blorp_bytes_0,INT64_C(6))"
		),
	)


pure func test_empty_literal_has_dummy_storage_and_zero_logical_length() -> Bool:
	emits_literal(
		"",
		(
			"static const unsigned char blorp_bytes_0[]={0};struct blorp_string* const "
			+ "blorp_vl_0=blorp_string_from_bytes((const char *)blorp_bytes_0,INT64_C(0))"
		),
	)


pure func test_long_literal_preserves_all_bytes_and_full_width_length() -> Bool:
	expected = "static const unsigned char blorp_bytes_0[]={" + "97,".repeat(4095) + (
		"97};struct blorp_string* const blorp_vl_0=blorp_string_from_bytes((const char "
		+ "*)blorp_bytes_0,INT64_C(4096))"
	)
	emits_literal(
		"a".repeat(4096),
		expected,
	)


pure func test_literal_backing_names_are_scoped_to_the_function() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			main = program(
				ids,
				[owned_literal(
						ids.first,
						Own.OwnedResult(Own.owner_id(0)),
						10,
					), Own.DropOwner(
						Own.owner_id(0),
						span(10),
					), owned_zero(ids.second, 20)],
				ids.second,
			)
			helper: Own.OwnedFunction = {
				execution = OrdinaryCalls,
				signature = {
					parameters = [],
					return_type = Concrete.StringType
				},
				operations = [Own.DefineValue({
						id = ids.first,
						value_type = Concrete.StringType,
						operation = Own.StringDefinition("A"),
						result = Own.OwnedResult(Own.owner_id(0)),
						span = span(10),
					})],
				tail = Own.ReturnTail(Own.ReturnResult(Own.OwnedReturn(ids.first, Own.owner_id(0))))
			}
			input = { main |
				entrypoint = NoArguments(ids.second_function, IntegerExitStatus),
				functions = [helper].concat(main.functions)
			}

			match verify(input).and_then(pure func(verified): emit(verified)):
				Ok(code):
					(
						code.contains(
							"blorp_f_0(void){static const unsigned char blorp_bytes_0[]={65};",
						)
						and code.contains((
								"blorp_f_1(void){static const unsigned char blorp_bytes_0[]={104,101,108,108,"
								+ "111};"
							))
					)
				Err(_):
					False


tests: TestSuite = {
	description = "Blorp 2 literal ownership and projection",
	tests = [
		("literal has no operand use", test_literal_has_no_operand_use),
		(
			"unused literal gets fresh owner and immediate drop",
			test_unused_literal_gets_a_fresh_owner_and_immediate_drop,
		),
		("literal return transfers fresh owner", test_literal_return_transfers_its_fresh_owner),
		(
			"length borrows literal through final use",
			test_length_borrows_literal_until_its_final_use,
		),
		("verifier rejects unmanaged literal", test_verifier_rejects_unmanaged_literal),
		("verifier rejects borrowed literal", test_verifier_rejects_borrowed_literal),
		("verifier rejects duplicate literal owner", test_verifier_rejects_duplicate_literal_owner),
		("verifier rejects leaked literal owner", test_verifier_rejects_leaked_literal_owner),
		(
			"verifier derives String type from operation",
			test_verifier_derives_string_type_from_literal_operation,
		),
		(
			"emission preserves bytes and explicit length",
			test_emission_preserves_escape_bytes_and_explicit_length,
		),
		(
			"emission projects UTF-8 as exact array bytes",
			test_emission_projects_utf8_as_exact_array_bytes,
		),
		(
			"empty literal has dummy storage and zero logical length",
			test_empty_literal_has_dummy_storage_and_zero_logical_length,
		),
		(
			"literal backing names are scoped to the function",
			test_literal_backing_names_are_scoped_to_the_function,
		),
		(
			"long literal preserves all bytes and full-width length",
			test_long_literal_preserves_all_bytes_and_full_width_length,
		),
	]
}
