import:
	../../src/names: program_names
	../../src/syntax:
		BindingSyntax(MutableBinding),
		ExpressionBase(IntegerExpression),
		LexedProgram,
		ParsedBinding,
		ParsedMatchArm,
		ParsedPattern(PatternWildcard),
		ParsedUnion,
		ParsedVariant,
		PayloadSyntax(NoPayloadSyntax, OnePayloadSyntax),
		Span,
		Token,
		TokenKind(IdentifierToken),
		ValueExpression,
		WrittenName,
		TypeParameterSyntax(NoTypeParameterSyntax),
	test: TestSuite


pure func test_token_update_preserves_original_payload_and_span() -> Bool:
	original: Token = {
		kind = IdentifierToken("main"),
		span = {
			start = 5,
			end = 9
		}
	}
	changed: Token = { original | kind = IdentifierToken("nope") }

	match original.kind:
		IdentifierToken(name):
			match changed.kind:
				IdentifierToken(changed_name):
					(
						name == "main"
						and changed_name == "nope"
						and original.span.start == 5
						and original.span.end == 9
						and changed.span.start == 5
						and changed.span.end == 9
					)
				_:
					False
		_:
			False


pure func test_published_tokens_are_independent_of_local_builder() -> Bool:
	first: Token = {
		kind = IdentifierToken("main"),
		span = {
			start = 0,
			end = 4
		}
	}
	var builder: List[Token] = [first]
	published: LexedProgram = {
		tokens = builder,
		end = {
			start = 4,
			end = 4
		}
	}
	builder = builder.append({
		kind = IdentifierToken("next"),
		span = {
			start = 5,
			end = 9
		},
	})
	(
		published.tokens.length() == 1
		and builder.length() == 2
		and published.end.start == 4
		and published.end.end == 4
	)


pure func test_union_publication_and_expression_updates_preserve_original() -> Bool:
	name: WrittenName = {
		id = program_names().main,
		span = {
			start = 12,
			end = 15
		}
	}
	variant: ParsedVariant = {
		name = name,
		payload = NoPayloadSyntax
	}
	var variants = [variant]
	published: ParsedUnion = {
		type_name = name,
		type_parameters = NoTypeParameterSyntax,
		variants = variants
	}
	variants = variants.append(
		{ variant |
			payload = OnePayloadSyntax(name),
			name = { name | span = {
					start = 20,
					end = 23
				} }
		},
	)
	original: ValueExpression = {
		base = IntegerExpression(42),
		base_span = {
			start = 21,
			end = 23
		},
		applications = [],
		span = {
			start = 21,
			end = 23
		}
	}
	changed: ValueExpression = { original | base = IntegerExpression(-42) }

	payloads_unchanged = match published.variants:
		[first]:
			match first.payload:
				NoPayloadSyntax:
					match variants:
						[_, second]:
							match second.payload:
								OnePayloadSyntax(field):
									field.span.start == 12 and field.span.end == 15
								_:
									False
						_:
							False
				_:
					False
		_:
			False

	match original.base:
		IntegerExpression(42):
			match changed.base:
				IntegerExpression(-42):
					(
						payloads_unchanged
						and published.variants.length() == 1
						and variants.length() == 2
						and published.variants
							.get(0)
							.map(pure func(variant): variant.name.span.start) == Some(12)
						and original.span.start == 21
						and original.span.end == 23
						and changed.span.start == 21
						and changed.span.end == 23
					)
				_:
					False
		_:
			False


pure func test_arm_binding_publication_is_independent_of_builder() -> Bool:
	span: Span = {
		start = 10,
		end = 12
	}
	value: ValueExpression = {
		base = IntegerExpression(42),
		base_span = span,
		applications = [],
		span = span
	}
	binding: ParsedBinding = {
		name = {
			id = program_names().main,
			span = span
		},
		mutability = MutableBinding,
		initializer = value
	}
	var bindings = [binding]
	arm: ParsedMatchArm = {
		pattern = PatternWildcard(span),
		bindings = bindings,
		body = value,
		span = span
	}
	bindings = bindings.append(binding)
	arm.bindings.length() == 1 and bindings.length() == 2 and arm.body.span.start == 10


tests: TestSuite = {
	description = "Blorp 2 syntax data",
	tests = [
		(
			"arm bindings publish independently of builder",
			test_arm_binding_publication_is_independent_of_builder,
		),
		(
			"published union and updated expression preserve original",
			test_union_publication_and_expression_updates_preserve_original,
		),
		("token update preserves original", test_token_update_preserves_original_payload_and_span),
		(
			"published tokens are independent of builder",
			test_published_tokens_are_independent_of_local_builder,
		),
	]
}
