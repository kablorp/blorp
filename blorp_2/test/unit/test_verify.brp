pure func test_rejects_payload_for_a_nullary_variant() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				VariantValue(variant):
					bad = DefineValue({
						id = ids.second,
						value_type = UnionType(ids.union_id),
						operation = ConstructDefinition(variant, ids.first),
						result = UnmanagedResult,
						span = span(20),
					})
					input = program(
						ids,
						[integer(ids.first, 7, 10), bad],
					)
					rejects(
						{ input | unions = ids.unions },
						"variant payload does not match its operation",
						20,
					)
				_:
					False


pure func test_sibling_arm_values_are_not_visible() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			callee: OwnedFunction = {
				signature = {
					purity = Pure,
					parameters = [IntType],
					return_type = IntType
				},
				operations = [DefineValue({
						id = ids.first,
						value_type = IntType,
						operation = ParameterDefinition(0),
						result = UnmanagedResult,
						span = span(10),
					})],
				tail = ReturnTail(UnmanagedReturn(ids.first))
			}

			match ids.union_value.operation:
				VariantValue(variant):
					main: OwnedFunction = {
						signature = {
							purity = Pure,
							parameters = [],
							return_type = IntType
						},
						operations = [DefineValue({
								id = ids.first,
								value_type = UnionType(ids.union_id),
								operation = VariantDefinition(variant),
								result = UnmanagedResult,
								span = span(10),
							})],
						tail = MatchTail({
							scrutinee = ids.first,
							owner = ids.union_id,
							arms = [
								{
									label = VariantLabel(variant),
									operations = [integer(ids.second, 7, 20)],
									result = UnmanagedReturn(ids.second)
								},
								{
									label = DefaultLabel,
									operations = [
										DefineValue({
											id = ids.third,
											value_type = IntType,
											operation = CallDefinition(
												{
													target = UserFunction(ids.entrypoint),
													span = span(30)
												},
												[UnmanagedArgument(ids.second)],
											),
											result = UnmanagedResult,
											span = span(30),
										}),
									],
									result = UnmanagedReturn(ids.third)
								},
							],
						})
					}
					rejects(
						{
							unions = ids.unions,
							entrypoint = ids.second_function,
							functions = [callee, main]
						},
						"value 1 is not defined before use",
						30,
					)
				_:
					False


pure func test_managed_prefix_is_rejected_even_after_drop() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				VariantValue(variant):
					main: OwnedFunction = {
						signature = {
							purity = Pure,
							parameters = [],
							return_type = IntType
						},
						operations = [
							integer(ids.first, 7, 10),
							string(ids),
							length(ids, 0),
							DropOwner(owner_id(0), span(35)),
							DefineValue({
								id = ids.fourth,
								value_type = UnionType(ids.union_id),
								operation = VariantDefinition(variant),
								result = UnmanagedResult,
								span = span(40),
							}),
						],
						tail = MatchTail({
							scrutinee = ids.fourth,
							owner = ids.union_id,
							arms = [
								{
									label = DefaultLabel,
									operations = [integer(ids.fifth, 0, 50)],
									result = UnmanagedReturn(ids.fifth)
								},
							],
						})
					}
					rejects(
						{
							unions = ids.unions,
							entrypoint = ids.entrypoint,
							functions = [main]
						},
						"managed value appears before a tail match",
						20,
					)
				_:
					False


pure func test_match_label_requires_its_variant_declaration() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				VariantValue(variant):
					main: OwnedFunction = {
						signature = {
							purity = Pure,
							parameters = [],
							return_type = IntType
						},
						operations = [DefineValue({
								id = ids.first,
								value_type = UnionType(ids.union_id),
								operation = VariantDefinition(variant),
								result = UnmanagedResult,
								span = span(10),
							})],
						tail = MatchTail({
							scrutinee = ids.first,
							owner = ids.union_id,
							arms = [
								{
									label = VariantLabel(ids.second_variant),
									operations = [integer(ids.second, 0, 20)],
									result = UnmanagedReturn(ids.second)
								},
							],
						})
					}
					rejects(
						{
							unions = [{variants = [NoPayload]}],
							entrypoint = ids.entrypoint,
							functions = [main]
						},
						"unknown variant identity",
						10,
					)
				_:
					False


pure func test_rejects_a_string_returning_entrypoint() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			entry: OwnedFunction = {
				signature = {
					purity = Pure,
					parameters = [],
					return_type = StringType
				},
				operations = [integer(ids.first, 7, 10), string(ids)],
				tail = ReturnTail(OwnedReturn(ids.second, owner_id(0)))
			}
			rejects(
				{
					unions = [],
					entrypoint = ids.entrypoint,
					functions = [entry]
				},
				"entrypoint must take no parameters and return Int",
				10,
			)


pure func test_rejects_an_entrypoint_with_a_parameter() -> Bool:
