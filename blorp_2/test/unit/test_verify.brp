import:
	../../src/lower: MatchLabel(DefaultLabel, VariantLabel), ValueId, ValueOperation(VariantValue)
	../../src/own:
		BorrowSource(ParameterBorrow, OwnerBorrow),
		OwnedArgument(UnmanagedArgument, BorrowedArgument),
		OwnedArm,
		OwnedFunction,
		OwnedTail(ReturnTail, MatchTail),
		OwnedValueOperation(
			ParameterDefinition, IntegerDefinition, VariantDefinition, CallDefinition,
			ConstructDefinition,
		),
		OwnershipOperation(DefineValue, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		owner_id,
	../../src/prelude: RuntimeOperation(IntToString, StringLength)
	../../src/specialize:
		CallTarget(RuntimeFunction, UserFunction),
		PayloadShape(NoPayload),
		TypeRef(IntType, StringType, UnionType),
		specialize,
	../../src/syntax: Purity(Pure)
	../../src/verify: verify
	ownership_inputs: InputIds, input_ids, span
	test: TestSuite


-- Hand-written ownership IR is intentionally independent of insertion.
private pure func integer(value: ValueId, number: Int, at: Int) -> OwnershipOperation:
	DefineValue({
		id = value,
		value_type = IntType,
		operation = IntegerDefinition(number),
		result = UnmanagedResult,
		span = span(at),
	})


private pure func string(ids: InputIds) -> OwnershipOperation:
	DefineValue({
		id = ids.second,
		value_type = StringType,
		operation = CallDefinition(
			{
				target = RuntimeFunction(IntToString),
				span = span(20)
			},
			[UnmanagedArgument(ids.first)],
		),
		result = OwnedResult(owner_id(0)),
		span = span(20),
	})


private pure func length(ids: InputIds, owner: Int) -> OwnershipOperation:
	DefineValue({
		id = ids.third,
		value_type = IntType,
		operation = CallDefinition(
			{
				target = RuntimeFunction(StringLength),
				span = span(30)
			},
			[BorrowedArgument({
					value = ids.second,
					source = OwnerBorrow(owner_id(owner)),
				})],
		),
		result = UnmanagedResult,
		span = span(30),
	})


private pure func program(ids: InputIds, operations: List[OwnershipOperation]) -> OwnershipProgram:
	{
		unions = [],
		entrypoint = ids.entrypoint,
		functions = [
			{
				signature = {
					purity = Pure,
					parameters = [],
					return_type = IntType
				},
				operations = operations,
				tail = ReturnTail(UnmanagedReturn(ids.third))
			},
		]
	}


private pure func rejects(input: OwnershipProgram, message: String, at: Int) -> Bool:
	match verify(input):
		Err(error):
			(
				error.message == "ownership verification failed: " + message
				and error.help == "report this compiler error with the input program"
				and error.span.start == at
				and error.span.end == at + 1
			)
		Ok(_):
			False


private pure func match_program(ids: InputIds, labels: List[MatchLabel]) -> OwnershipProgram:
	var arms: List[OwnedArm] = []

	for label in labels:
		arms = arms.append({
			label = label,
			operations = [],
			result = UnmanagedReturn(ids.second),
		})

	{
		unions = ids.unions,
		entrypoint = ids.entrypoint,
		functions = [
			{
				signature = {
					purity = Pure,
					parameters = [],
					return_type = IntType
				},
				operations = [DefineValue({
						id = ids.first,
						value_type = UnionType(ids.union_id),
						operation = VariantDefinition(ids.second_variant),
						result = UnmanagedResult,
						span = span(10),
					}), integer(ids.second, 7, 20)],
				tail = MatchTail({
					scrutinee = ids.first,
					owner = ids.union_id,
					arms = arms,
				})
			},
		]
	}


pure func test_rejects_a_match_without_arms() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			rejects(
				match_program(ids, []),
				"match has no arms",
				10,
			)


pure func test_rejects_a_match_missing_a_variant() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			rejects(
				match_program(ids, [VariantLabel(ids.second_variant)]),
				"match does not cover every variant",
				10,
			)


pure func test_rejects_a_repeated_match_variant() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			rejects(
				match_program(
					ids,
					[VariantLabel(ids.second_variant), VariantLabel(ids.second_variant)],
				),
				"match variant appears more than once",
				10,
			)


pure func test_rejects_a_repeated_match_default() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			rejects(
				match_program(
					ids,
					[DefaultLabel, DefaultLabel],
				),
				"match default appears more than once",
				10,
