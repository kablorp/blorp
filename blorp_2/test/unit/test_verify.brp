				verify(
					program(
						ids,
						[
							integer(ids.first, 7, 10),
							string(ids),
							length(ids, 0),
							DropOwner(owner_id(0), span(40)),
						],
					),
				)
			):
				Ok(_):
					True
				Err(_):
