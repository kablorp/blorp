			)


pure func test_rejects_a_match_default_after_complete_coverage() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				VariantValue(first):
					rejects(
						match_program(
							ids,
							[VariantLabel(first), VariantLabel(ids.second_variant), DefaultLabel],
						),
						"match default covers no remaining variants",
						10,
					)
				_:
					False


pure func test_accepts_a_match_with_all_variants() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				VariantValue(first):
					match (
						verify(
							match_program(
								ids,
								[VariantLabel(first), VariantLabel(ids.second_variant)],
							),
						)
					):
						Ok(_):
							True
						Err(_):
							False
				_:
					False


