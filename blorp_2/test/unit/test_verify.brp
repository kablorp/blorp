pure func test_rejects_returning_another_values_owner() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			entry: OwnedFunction = {
				signature = {
					purity = Pure,
					parameters = [],
					return_type = IntType
				},
				operations = [integer(ids.first, 0, 1)],
				tail = ReturnTail(UnmanagedReturn(ids.first))
			}
			other_string = DefineValue({
				id = ids.third,
				value_type = StringType,
				operation = CallDefinition(
					{
						target = RuntimeFunction(IntToString),
						span = span(30)
					},
					[UnmanagedArgument(ids.first)],
				),
				result = OwnedResult(owner_id(1)),
				span = span(30),
			})
			helper: OwnedFunction = {
				signature = {
					purity = Pure,
					parameters = [],
					return_type = StringType
				},
				operations = [
					integer(ids.first, 7, 10),
					string(ids),
					other_string,
					DropOwner(owner_id(0), span(40)),
				],
				tail = ReturnTail(OwnedReturn(ids.second, owner_id(1)))
			}
			rejects(
				{
					unions = [],
					entrypoint = ids.entrypoint,
					functions = [entry, helper]
				},
				"returned owner does not own the returned value",
				20,
			)


pure func test_rejects_an_empty_managed_match() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				VariantValue(variant):
					entry: OwnedFunction = {
						signature = {
							purity = Pure,
							parameters = [],
							return_type = IntType
						},
						operations = [integer(ids.first, 0, 1)],
						tail = ReturnTail(UnmanagedReturn(ids.first))
					}
					helper: OwnedFunction = {
						signature = {
							purity = Pure,
							parameters = [],
							return_type = StringType
						},
						operations = [DefineValue({
								id = ids.first,
								value_type = UnionType(ids.union_id),
								operation = VariantDefinition(variant),
								result = UnmanagedResult,
								span = span(10),
							})],
						tail = MatchTail({
							owner = ids.union_id,
							scrutinee = ids.first,
							arms = [],
						})
					}

					match (
						verify({
							unions = ids.unions,
							entrypoint = ids.entrypoint,
							functions = [entry, helper],
						})
					):
						Err(error):
							(
								error.message == "ownership verification failed: match has no arms"
								and error.help == "report this compiler error with the input program"
								and error.span == span(10)
							)
						Ok(_):
							False
				_:
					False


pure func test_acquired_owner_can_transfer_after_original_owner_is_dropped() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			entry: OwnedFunction = {
				signature = {
					purity = Pure,
					parameters = [],
					return_type = IntType
				},
				operations = [integer(ids.first, 0, 1)],
				tail = ReturnTail(UnmanagedReturn(ids.first))
			}
			helper: OwnedFunction = {
				signature = {
					purity = Pure,
					parameters = [],
					return_type = StringType
				},
				operations = [
					integer(ids.first, 7, 10),
					string(ids),
					AcquireOwner(
						owner_id(1),
						{
							value = ids.second,
							source = OwnerBorrow(owner_id(0))
						},
						span(30),
					),
					DropOwner(owner_id(0), span(40)),
				],
				tail = ReturnTail(OwnedReturn(ids.second, owner_id(1)))
			}

			match (
				verify({
					unions = [],
					entrypoint = ids.entrypoint,
					functions = [entry, helper],
				})
			):
				Ok(_):
					True
				Err(_):
					False


private pure func verifies_independent_cleanup(
	ids: InputIds,
	first_drop: Int,
	second_drop: Int,
) -> Bool:
	second_string = DefineValue({
		id = ids.fourth,
		value_type = StringType,
		operation = CallDefinition(
			{
				target = RuntimeFunction(IntToString),
				span = span(40)
			},
			[UnmanagedArgument(ids.first)],
		),
		result = OwnedResult(owner_id(1)),
		span = span(40),
	})

	match (
		verify(
			program(
				ids,
				[
					integer(ids.first, 7, 10),
					string(ids),
					length(ids, 0),
					second_string,
					DropOwner(owner_id(first_drop), span(50)),
					DropOwner(owner_id(second_drop), span(60)),
				],
			),
		)
	):
		Ok(_):
			True
		Err(_):
			False


pure func test_independent_owners_can_be_dropped_in_creation_order() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			verifies_independent_cleanup(ids, 0, 1)


pure func test_independent_owners_can_be_dropped_in_reverse_order() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			verifies_independent_cleanup(ids, 1, 0)


pure func test_acquisition_rejects_another_values_live_owner() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			other_string = DefineValue({
				id = ids.third,
				value_type = StringType,
				operation = CallDefinition(
					{
						target = RuntimeFunction(IntToString),
						span = span(30)
					},
					[UnmanagedArgument(ids.first)],
				),
				result = OwnedResult(owner_id(1)),
				span = span(30),
			})
			rejects(
				{
					unions = [],
					entrypoint = ids.entrypoint,
					functions = [
						{
							signature = {
								purity = Pure,
								parameters = [],
								return_type = IntType
							},
							operations = [
								integer(ids.first, 7, 10),
								string(ids),
								other_string,
								AcquireOwner(
									owner_id(2),
									{
										value = ids.second,
										source = OwnerBorrow(owner_id(1))
									},
									span(40),
								),
								DropOwner(owner_id(0), span(50)),
								DropOwner(owner_id(1), span(60)),
								DropOwner(owner_id(2), span(70)),
								integer(ids.fourth, 0, 80),
							],
							tail = ReturnTail(UnmanagedReturn(ids.fourth))
						},
					]
				},
				"owner 1 does not own value 1",
				40,
			)


private pure func arm_string(
	value: ValueId,
	argument: ValueId,
	owner: Int,
	at: Int,
) -> OwnershipOperation:
	DefineValue({
		id = value,
		value_type = StringType,
		operation = CallDefinition(
			{
				target = RuntimeFunction(IntToString),
				span = span(at)
			},
			[UnmanagedArgument(argument)],
		),
		result = OwnedResult(owner_id(owner)),
		span = span(at),
	})


private pure func managed_match_program(ids: InputIds, arms: List[OwnedArm]) -> OwnershipProgram:
	{
		unions = ids.unions,
		entrypoint = ids.entrypoint,
		functions = [
			{
				signature = {
					purity = Pure,
					parameters = [],
					return_type = IntType
				},
				operations = [integer(ids.first, 0, 1)],
				tail = ReturnTail(UnmanagedReturn(ids.first))
			},
			{
				signature = {
					purity = Pure,
					parameters = [],
					return_type = StringType
				},
				operations = [DefineValue({
						id = ids.first,
						value_type = UnionType(ids.union_id),
						operation = VariantDefinition(ids.second_variant),
						result = UnmanagedResult,
						span = span(10),
					}), integer(ids.second, 7, 20)],
				tail = MatchTail({
					scrutinee = ids.first,
					owner = ids.union_id,
					arms = arms,
				})
			},
		]
	}


private pure func managed_arms(ids: InputIds) -> List[OwnedArm]:
	[
		{
			label = VariantLabel(ids.second_variant),
			operations = [arm_string(ids.third, ids.second, 0, 30)],
			result = OwnedReturn(ids.third, owner_id(0))
		},
		{
			label = DefaultLabel,
			operations = [arm_string(ids.fourth, ids.second, 1, 40)],
			result = OwnedReturn(ids.fourth, owner_id(1))
		},
	]


pure func test_accepts_independent_managed_arm_transfers() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match verify(managed_match_program(ids, managed_arms(ids))):
				Ok(_):
					True
				Err(_):
					False


pure func test_rejects_a_missing_managed_arm_transfer() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[{ first | result = UnmanagedReturn(ids.third) }, second],
						),
						"managed return requires an owner transfer",
						30,
					)
				_:
					False


pure func test_rejects_an_arm_local_owner_leak() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			rejects(
				managed_match_program(
					ids,
					[
						{
							label = VariantLabel(ids.second_variant),
							operations = [
								arm_string(ids.third, ids.second, 0, 30),
								arm_string(ids.fourth, ids.second, 1, 40),
							],
							result = OwnedReturn(ids.fourth, owner_id(1))
						},
						{
							label = DefaultLabel,
							operations = [arm_string(ids.fifth, ids.second, 2, 50)],
							result = OwnedReturn(ids.fifth, owner_id(2))
						},
					],
				),
				"owner 0 remains live at return",
				40,
			)


pure func test_rejects_an_arm_local_double_drop() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[{ first | operations = first.operations.concat([
										DropOwner(owner_id(0), span(35)),
										DropOwner(owner_id(0), span(36)),
									]) }, second],
						),
						"owner 0 has already been discharged",
						36,
					)
				_:
					False


pure func test_rejects_an_arm_local_dead_borrow() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					dead_length = DefineValue({
						id = ids.fourth,
						value_type = IntType,
						operation = CallDefinition(
							{
								target = RuntimeFunction(StringLength),
								span = span(40)
							},
							[BorrowedArgument({
									value = ids.third,
									source = OwnerBorrow(owner_id(0)),
								})],
						),
						result = UnmanagedResult,
						span = span(40),
					})
					rejects(
						managed_match_program(
							ids,
							[
								{ first |
									operations = first.operations.concat(
										[DropOwner(owner_id(0), span(35)), dead_length],
									)
								},
								second,
							],
						),
						"borrow refers to discharged owner 0",
						40,
					)
				_:
					False


pure func test_rejects_a_sibling_arm_owner_transfer() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[first, { second | result = OwnedReturn(ids.fourth, owner_id(0)) }],
						),
						"owner 0 is not available in this match arm",
						40,
					)
				_:
					False


pure func test_rejects_a_sibling_arm_managed_value() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					bad_call = DefineValue({
						id = ids.fourth,
						value_type = IntType,
						operation = CallDefinition(
							{
								target = RuntimeFunction(StringLength),
								span = span(40)
							},
							[BorrowedArgument({
									value = ids.third,
									source = OwnerBorrow(owner_id(0)),
								})],
						),
						result = UnmanagedResult,
						span = span(40),
					})
					rejects(
						managed_match_program(
							ids,
							[first, { second | operations = [bad_call] }],
						),
						"value 2 is not defined before use",
						40,
					)
				_:
					False


pure func test_rejects_a_dropped_managed_arm_return() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[
								{ first |
									operations = first.operations.append(
										DropOwner(
											owner_id(0),
											span(35),
										),
									)
								},
								second,
							],
						),
						"return refers to discharged owner 0",
						30,
					)
				_:
					False


pure func test_rejects_reusing_a_sibling_owner_ordinal() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[
								first,
								{ second |
									operations = [arm_string(ids.fourth, ids.second, 0, 40)]
								},
							],
						),
						"owner 0 is defined more than once",
						40,
					)
				_:
					False


pure func test_rejects_reusing_a_sibling_value_ordinal() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[
								first,
								{ second |
									operations = [arm_string(ids.third, ids.second, 1, 40)]
								},
							],
						),
						"value identity is not the next function ordinal",
						40,
					)
				_:
					False


tests: TestSuite = {
	description = "Blorp 2 independent ownership verification",
	tests = [
		(
			"managed arm cannot reuse sibling owner ordinal",
			test_rejects_reusing_a_sibling_owner_ordinal,
		),
		(
			"managed arm cannot reuse sibling value ordinal",
			test_rejects_reusing_a_sibling_value_ordinal,
		),
		("managed arms transfer independently", test_accepts_independent_managed_arm_transfers),
		("managed arm requires transfer", test_rejects_a_missing_managed_arm_transfer),
		("managed arm rejects leaked owner", test_rejects_an_arm_local_owner_leak),
		("managed arm rejects double drop", test_rejects_an_arm_local_double_drop),
		("managed arm rejects dead borrow", test_rejects_an_arm_local_dead_borrow),
		("managed arm rejects sibling owner", test_rejects_a_sibling_arm_owner_transfer),
		("managed arm rejects sibling value", test_rejects_a_sibling_arm_managed_value),
		("managed arm rejects dropped return", test_rejects_a_dropped_managed_arm_return),
		("match requires arms", test_rejects_a_match_without_arms),
		("match requires complete variant coverage", test_rejects_a_match_missing_a_variant),
		("match rejects repeated variants", test_rejects_a_repeated_match_variant),
		("match rejects repeated defaults", test_rejects_a_repeated_match_default),
		("match default must follow variants", test_rejects_a_match_default_before_a_variant),
		(
			"match default must cover remaining variants",
			test_rejects_a_match_default_after_complete_coverage,
		),
		("match accepts all variants", test_accepts_a_match_with_all_variants),
		("match accepts reversed variants", test_accepts_a_match_with_variants_in_reverse_order),
		(
			"match accepts partial coverage and final default",
			test_accepts_a_partial_match_with_a_final_default,
		),
		("match accepts a default alone", test_accepts_a_default_only_match),
		(
			"acquired owner can transfer after original owner drops",
			test_acquired_owner_can_transfer_after_original_owner_is_dropped,
		),
		(
			"independent owners drop in creation order",
			test_independent_owners_can_be_dropped_in_creation_order,
		),
		(
			"independent owners drop in reverse order",
			test_independent_owners_can_be_dropped_in_reverse_order,
		),
		(
			"acquisition requires the exact value's live owner",
			test_acquisition_rejects_another_values_live_owner,
		),
		("managed match still requires arms", test_rejects_an_empty_managed_match),
		("entrypoint cannot return String", test_rejects_a_string_returning_entrypoint),
		("entrypoint cannot take a parameter", test_rejects_an_entrypoint_with_a_parameter),
		("returned owner must own the returned value", test_rejects_returning_another_values_owner),
		(
			"match label requires declared variant",
			test_match_label_requires_its_variant_declaration,
		),
		("call missing argument", test_rejects_call_with_missing_argument),
		("call wrong argument type", test_rejects_call_with_wrong_argument_type),
		("nullary variant cannot take payload", test_rejects_payload_for_a_nullary_variant),
		("sibling arm value cannot escape scope", test_sibling_arm_values_are_not_visible),
		(
			"dropped managed prefix still rejects match",
			test_managed_prefix_is_rejected_even_after_drop,
		),
		("accept exact borrow and cleanup", test_accepts_exact_borrow_and_cleanup),
		("missing drop", test_rejects_missing_drop),
		("double drop at second operation", test_rejects_double_drop_at_the_second_drop),
		("borrow after drop", test_rejects_borrow_after_drop),
		("unknown owner", test_rejects_unknown_owner),
		("wrong value owner", test_rejects_borrow_from_another_values_owner),
		("fabricated parameter borrow", test_rejects_fabricated_parameter_borrow),
		("duplicate owner identity", test_rejects_reusing_an_owner_identity),
		("negative owner identity", test_rejects_negative_owner_identity),
		("acquired owner keeps same value live", test_acquired_owner_keeps_the_same_value_live),
		("acquisition from dead owner", test_rejects_acquisition_from_a_dead_owner),
		("unowned managed call result", test_rejects_an_unowned_managed_call_result),
		("owner on unmanaged value", test_rejects_an_owner_on_an_unmanaged_value),
		("implicit managed argument", test_rejects_an_implicit_managed_argument),
		("value before definition", test_rejects_a_value_before_definition),
		(
			"borrowed return needs acquisition",
			test_borrowed_parameter_return_requires_an_acquisition,
		),
		("dropped return owner", test_rejects_returning_a_dropped_owner),
	]
}
