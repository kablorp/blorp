pure func test_borrowed_parameter_return_requires_an_acquisition() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			borrowed: OwnedFunction = {
				signature = {
					purity = Pure,
					parameters = [StringType],
					return_type = StringType
				},
				operations = [DefineValue({
						id = ids.first,
						value_type = StringType,
						operation = ParameterDefinition(0),
						result = BorrowedResult,
						span = span(10),
					})],
				tail = ReturnTail(UnmanagedReturn(ids.first))
			}
			rejects(
				{
					unions = [],
					entrypoint = ids.entrypoint,
					functions = [borrowed]
				},
				"managed return requires an owner transfer",
				10,
			)


