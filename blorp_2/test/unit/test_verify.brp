pure func test_acquired_owner_keeps_the_same_value_live() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match (
				verify(
					program(
						ids,
						[
							integer(ids.first, 7, 10),
							string(ids),
							AcquireOwner(
								owner_id(1),
								{
									value = ids.second,
									source = OwnerBorrow(owner_id(0))
								},
								span(25),
							),
							DropOwner(owner_id(0), span(26)),
							length(ids, 1),
							DropOwner(owner_id(1), span(40)),
						],
					),
				)
			):
				Ok(_):
					True
				Err(_):
					False


