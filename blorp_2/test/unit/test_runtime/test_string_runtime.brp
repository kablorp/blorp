import:
	../../../src/runtime/string_runtime: string_runtime
	test: TestSuite


-- These checks protect the emitted runtime contract. Native runtime tests
-- observe exact bytes and per-object lifetimes through allocator wrappers.
pure func test_string_is_one_atomic_managed_leaf() -> Bool:
	code = string_runtime()
	(
		code.contains("#include <stdatomic.h>\n")
		and code.contains("atomic_size_t references;")
		and code.contains("int64_t length;")
		and code.contains("char bytes[];")
		and code.contains("struct blorp_string {")
	)


pure func test_byte_constructor_has_explicit_length_and_inline_bytes() -> Bool:
	code = string_runtime()
	(
		code.contains("blorp_string_from_bytes(const char *bytes,int64_t length)")
		and code.contains("malloc(sizeof *result+(size_t)length+1)")
		and code.contains("memcpy(result->bytes,bytes,(size_t)length)")
		and code.contains("result->bytes[length]='\\0';")
	)


pure func test_signed_decimal_constructor_uses_shared_byte_constructor() -> Bool:
	code = string_runtime()
	(
		code.contains("BLORP_INT64_DECIMAL_CAPACITY=21")
		and code.contains("blorp_int_to_string(int64_t value)")
		and code.contains("snprintf(buffer,sizeof buffer,\"%\" PRId64,value)")
		and code.contains("return blorp_string_from_bytes(buffer,(int64_t)length);")
	)


pure func test_atomic_arc_and_borrowed_length_have_distinct_operations() -> Bool:
	code = string_runtime()
	(
		code.contains("blorp_string_retain(struct blorp_string *value)")
		and code.contains("atomic_fetch_add_explicit(&value->references,1,memory_order_relaxed)")
		and code.contains("blorp_string_release(struct blorp_string *value)")
		and code.contains("atomic_fetch_sub_explicit(&value->references,1,memory_order_acq_rel)==1")
		and code.contains("free(value);")
		and code.contains("blorp_string_length(const struct blorp_string *value)")
		and code.contains("return value->length;")
	)


tests: TestSuite = {
	description = "Blorp 2 String runtime C contract",
	tests = [
		("String is one atomic managed leaf", test_string_is_one_atomic_managed_leaf),
		(
			"byte constructor has explicit length and inline bytes",
			test_byte_constructor_has_explicit_length_and_inline_bytes,
		),
		(
			"signed decimal constructor uses shared byte construction",
			test_signed_decimal_constructor_uses_shared_byte_constructor,
		),
		(
			"atomic ARC and borrowed length have distinct operations",
			test_atomic_arc_and_borrowed_length_have_distinct_operations,
		),
	]
}
