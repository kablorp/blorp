import:
	../../../src/runtime/system: SYSTEM_CURRENT_DIRECTORY_RUNTIME, SYSTEM_READ_FILE_RUNTIME
	test: TestSuite


pure func test_current_directory_fragment_publishes_its_total_out_pointer_abi() -> Bool:
	(
		SYSTEM_CURRENT_DIRECTORY_RUNTIME.contains("uint8_t blorp_get_current_directory(struct blorp_string **result)")
		and not SYSTEM_CURRENT_DIRECTORY_RUNTIME.contains("struct blorp_Result")
	)


pure func test_read_file_fragment_publishes_borrowed_string_and_owned_out_pointer() -> Bool:
	(
		SYSTEM_READ_FILE_RUNTIME.contains("uint8_t blorp_read_file(const struct blorp_string *path,struct blorp_string **result)")
		and not SYSTEM_READ_FILE_RUNTIME.contains("struct blorp_Result")
	)


tests: TestSuite = {
	description = "Blorp 2 system runtime fragment",
	tests = [("read_file publishes target String out-pointer ABI", test_read_file_fragment_publishes_borrowed_string_and_owned_out_pointer), ("current directory publishes target String out-pointer ABI", test_current_directory_fragment_publishes_its_total_out_pointer_abi)]
}
