import:
	../../../src/runtime/system: SYSTEM_CURRENT_DIRECTORY_RUNTIME
	test: TestSuite


pure func test_current_directory_fragment_publishes_its_total_out_pointer_abi() -> Bool:
	(
		SYSTEM_CURRENT_DIRECTORY_RUNTIME.contains("uint8_t blorp_get_current_directory(struct blorp_string **result)")
		and not SYSTEM_CURRENT_DIRECTORY_RUNTIME.contains("struct blorp_Result")
	)


tests: TestSuite = {
	description = "Blorp 2 system runtime fragment",
	tests = [("current directory publishes target String out-pointer ABI", test_current_directory_fragment_publishes_its_total_out_pointer_abi)]
}
