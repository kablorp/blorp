import:
	../../../src/runtime/float: float_parse_runtime, float_runtime, float_string_runtime
	test: TestSuite


-- These observe the pure fragment boundary. Numeric behavior is observed by
-- normal-main native fixtures after the shared Float path is integrated.
pure func test_supported_binary64_model_is_explicit() -> Bool:
	code = float_runtime()
	(
		code.contains("DBL_MANT_DIG==53")
		and code.contains("DBL_MIN_EXP==(-1021)")
		and code.contains("DBL_MAX_EXP==1024")
		and code.contains("DBL_DECIMAL_DIG==17")
		and code.contains("DBL_HAS_SUBNORM==1")
		and code.contains("FLT_EVAL_METHOD==0")
		and code.contains("defined(__FAST_MATH__)")
		and code.contains("#pragma STDC FP_CONTRACT OFF")
	)


pure func test_arithmetic_fragment_needs_no_string_layout() -> Bool:
	code = float_runtime()
	(
		code.contains("double blorp_float_add(double first,double second)")
		and code.contains("double blorp_float_subtract(double first,double second)")
		and code.contains("double blorp_float_multiply(double first,double second)")
		and not code.contains("struct blorp_string")
		and not code.contains("malloc")
	)


pure func test_zero_divisors_have_explicit_positive_zero_guards() -> Bool:
	code = float_runtime()
	code.contains((
			"blorp_float_divide(double first,double second){return second==0.0?0.0:first/"
			+ "second;}"
		)) and code.contains((
			"blorp_float_remainder(double first,double second){return second==0.0?0.0:"
			+ "fmod(first,second);}"
		))


pure func test_nonfinite_formatting_has_canonical_bytes() -> Bool:
	code = float_string_runtime()
	(
		code.contains("isnan(value)")
		and code.contains("blorp_string_from_bytes(\"nan\",INT64_C(3))")
		and code.contains("blorp_string_from_bytes(\"-inf\",INT64_C(4))")
		and code.contains("blorp_string_from_bytes(\"inf\",INT64_C(3))")
	)


pure func test_finite_formatting_checks_full_width_round_trip() -> Bool:
	code = float_string_runtime()
	(
		code.contains("BLORP_FLOAT_TEXT_CAPACITY=64")
		and code.contains("BLORP_FLOAT_DEFAULT_PRECISION=6")
		and code.contains(
			"precision=BLORP_FLOAT_DEFAULT_PRECISION;precision<=DBL_DECIMAL_DIG;precision++",
		)
		and code.contains("\"%.*g\",precision,value")
		and code.contains("memcpy(&original_bits,&value,sizeof original_bits)")
		and code.contains("original_bits==parsed_bits")
		and code.contains("blorp_string_from_bytes(buffer,(int64_t)length)")
	)


pure func test_parser_borrows_counted_bytes_and_only_publishes_success() -> Bool:
	code = float_parse_runtime()
	(
		code.contains(
			"int blorp_string_parse_float(const struct blorp_string *value,double *result)",
		)
		and code.contains("end!=bytes+length||!isfinite(parsed)")
		and code.contains("*result=parsed;")
		and not code.contains("malloc")
		and not code.contains("retain")
		and not code.contains("release")
	)


pure func test_parser_gates_libc_with_complete_ascii_decimal() -> Bool:
	code = float_parse_runtime()
	(
		code.contains("byte>='0'&&byte<='9'")
		and code.contains("if(cursor!=length){return 0;}")
		and code.contains("double parsed=strtod(bytes,&end);")
		and not code.contains("isspace")
		and not code.contains("errno")
	)


pure func test_fragments_do_not_change_locale_or_rounding() -> Bool:
	code = float_runtime() + float_string_runtime() + float_parse_runtime()
	(
		not code.contains("setlocale")
		and not code.contains("fesetround")
		and not code.contains("getenv")
	)


tests: TestSuite = {
	description = "Blorp 2 Float runtime fragment contracts",
	tests = [
		("supported binary64 model is explicit", test_supported_binary64_model_is_explicit),
		("arithmetic needs no String layout", test_arithmetic_fragment_needs_no_string_layout),
		(
			"zero divisors return explicit positive zero",
			test_zero_divisors_have_explicit_positive_zero_guards,
		),
		("nonfinite formatting has canonical bytes", test_nonfinite_formatting_has_canonical_bytes),
		(
			"finite formatting checks full-width round trip",
			test_finite_formatting_checks_full_width_round_trip,
		),
		(
			"parser borrows bytes and publishes only success",
			test_parser_borrows_counted_bytes_and_only_publishes_success,
		),
		(
			"parser gates libc with complete ASCII decimal",
			test_parser_gates_libc_with_complete_ascii_decimal,
		),
		(
			"fragments preserve locale and rounding",
			test_fragments_do_not_change_locale_or_rounding,
		),
	]
}
