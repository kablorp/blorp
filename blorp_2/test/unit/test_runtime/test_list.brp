import:
	../../../src/lex/lex: lex
	../../../src/parse/parse: parse_module
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	system: read_file
	string: count
	../../../src/runtime/list:
		ListUpdate(AppendUpdate, SetUpdate, ConcatUpdate, SuffixUpdate), list_child_key, list_c_type,
		list_element_key, list_key_depth, list_root_allocation, list_runtime, list_slot_store,
		list_suffix, list_update_name, list_update_runtime, same_list_key
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic
	../compilation: compile
	../input: checked_source
	int as IntOps
	test: TestSuite


private pure func string_fragment() -> String:
	list_runtime(
		list_element_key(Concrete.StringType),
		"struct blorp_string*",
		"blorp_string_retain(element);",
		"blorp_string_release(element);",
	)


pure func test_argument_main_selects_the_shared_list_runtime_fragment() -> Bool:
	match compile("func main(arguments: List[String]) -> Int:\n    0\n"):
		Ok(output): output.contains(string_fragment())
		Err(_): False


pure func test_nullary_main_omits_list_runtime() -> Bool:
	match compile("func main() -> Int:\n    0\n"):
		Ok(output): not output.contains(string_fragment())
		Err(_): False


pure func test_reachable_union_payload_selects_list_runtime_without_argv() -> Bool:
	source: String =
		|union Maybe[T]:
		|    Empty
		|    Full(T)
		|pure func empty() -> Maybe[List[String]]:
		|    Empty
		|func main() -> Int:
		|    saved = empty()
		|    0
		|

	-- The reachable union's Full arm needs List destruction even when this
	-- program constructs Empty and neither receives argv nor calls get.
	match compile(source):
		Ok(output):
			output.contains("int main(void)") and output.contains(string_fragment())
		Err(_):
			False


private pure func nominal_types() -> Result[List[Concrete.TypeRef], Diagnostic]:
	source: String =
		|fixed record Stamp[T] { number: Int }
		|union Marker[T]:
		|    Empty
		|pure func first() -> Stamp[Int]:
		|    { number = 1 }
		|pure func second() -> Stamp[String]:
		|    { number = 2 }
		|pure func third() -> Marker[Int]:
		|    Empty
		|pure func fourth() -> Marker[String]:
		|    Empty
		|func main() -> Int:
		|    first_value = first()
		|    second_value = second()
		|    third_value = third()
		|    fourth_value = fourth()
		|    0
		|
	checked ?= checked_source(source)
	program ?= Concrete.specialize(checked)
	Ok(Concrete.specialized_contents(program).functions.filter_map(pure func(function):
		match function.signature.return_type:
			Concrete.RecordType(_) | Concrete.UnionType(_): Some(function.signature.return_type)
			_: None
	))


pure func test_flat_keys_preserve_all_primitive_types() -> Bool:
	values = [Concrete.VoidType, Concrete.IntType, Concrete.FloatType, Concrete.StringType]
	var valid = True
	for left in values:
		for right in values:
			keys_equal = same_list_key(list_element_key(left), list_element_key(right))
			semantic_equal = Concrete.same_type(left, right)
			valid = ((semantic_equal and keys_equal) or (not semantic_equal and not keys_equal)) and valid
	valid


pure func test_flat_keys_preserve_nominal_domains_and_phantom_instances() -> Bool:
	match nominal_types():
		Err(_): False
		Ok(values):
			match values:
				[record_first, record_second, union_first, union_second]:
					(
						not same_list_key(list_element_key(record_first), list_element_key(record_second))
						and not same_list_key(list_element_key(union_first), list_element_key(union_second))
						and not same_list_key(list_element_key(record_first), list_element_key(union_first))
					)
				_: False


pure func test_flat_key_equality_is_exact_semantic_type_equality() -> Bool:
	match nominal_types():
		Err(_): False
		Ok(nominals):
			terminals = [Concrete.VoidType, Concrete.IntType, Concrete.FloatType, Concrete.StringType].concat(nominals)
			values = terminals
				.concat(terminals.map(pure func(value): Concrete.ListType(value)))
				.concat(terminals.map(pure func(value): Concrete.ListType(Concrete.ListType(value))))
			var valid = True
			for left in values:
				for right in values:
					keys_equal = same_list_key(list_element_key(left), list_element_key(right))
					semantic_equal = Concrete.same_type(left, right)
					valid = ((semantic_equal and keys_equal) or (not semantic_equal and not keys_equal)) and valid
			valid


pure func test_child_keys_preserve_terminal_identity_and_remove_one_layer() -> Bool:
	match nominal_types():
		Err(_): False
		Ok(values):
			var valid = True
			for value in values:
				terminal = list_element_key(value)
				parent = list_element_key(Concrete.ListType(Concrete.ListType(value)))
				child = list_child_key(parent)
				valid = (
					IntOps.equals(list_key_depth(parent), 2)
					and IntOps.equals(list_key_depth(child), 1)
					and same_list_key(list_child_key(child), terminal)
					and same_list_key(list_child_key(terminal), terminal)
				) and valid
			valid


pure func test_key_projects_distinct_primitive_and_nested_c_names() -> Bool:
	(
		list_suffix(list_element_key(Concrete.VoidType)) == "0_v"
		and list_suffix(list_element_key(Concrete.IntType)) == "0_i"
		and list_suffix(list_element_key(Concrete.FloatType)) == "0_f"
		and list_suffix(list_element_key(Concrete.StringType)) == "0_s"
		and list_c_type(list_element_key(Concrete.ListType(Concrete.StringType))) == "struct blorp_l_1_s*"
	)


pure func test_repeat_clamps_before_conversion_and_checks_allocation_sizing() -> Bool:
	fragment = list_runtime(list_element_key(Concrete.IntType), "int64_t", "", "")
	(
		fragment.contains("count<=0?UINT64_C(0):(uint64_t)count")
		and fragment.contains("requested>(SIZE_MAX-sizeof(struct blorp_l_0_i))/sizeof(int64_t)")
		and IntOps.equals(fragment.split("=blorp_memory_allocate(").length(), 2)
		and not fragment.contains("-count")
	)


pure func test_repeat_acquires_each_slot_before_publishing_initialized_length() -> Bool:
	fragment = string_fragment()
	(
		fragment.contains("atomic_init(&result->references,1);result->length=0;")
		and fragment.contains("for(uint64_t index=0;index<requested;index++){blorp_string_retain(element);result->values[index]=element;result->length++;}return result;")
	)


pure func test_get_reports_presence_separately_and_acquires_the_result() -> Bool:
	fragment = string_fragment()
	(
		fragment.contains("int blorp_list_get_0_s(const struct blorp_l_0_s *value,int64_t index,struct blorp_string* *result)")
		and fragment.contains("if(index<0||index>=value->length)return 0;")
		and fragment.contains("element=value->values[index];blorp_string_retain(element);*result=element;return 1;")
		and not fragment.contains("return NULL")
	)


pure func test_final_root_drop_releases_each_initialized_occurrence() -> Bool:
	fragment = string_fragment()
	(
		fragment.contains("if(atomic_fetch_sub_explicit(&value->references,1,memory_order_acq_rel)!=1)return;")
		and fragment.contains("for(int64_t index=0;index<value->length;index++){struct blorp_string* element=value->values[index];(void)element;blorp_string_release(element);}blorp_memory_release(value);")
	)


pure func test_emission_deduplicates_repeated_elements_and_keeps_nested_suffixes() -> Bool:
	source: String =
		|pure func repeat[T](element: T, count: Int) -> List[T]:
		|    builtin("list.repeat")
		|func main() -> Int:
		|    first = repeat(1, 2)
		|    second = repeat(3, 4)
		|    outer = repeat(first, 2)
		|    other = repeat(second, 3)
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output):
			(
				IntOps.equals(output.split(" blorp_list_repeat_0_i(").length(), 2)
				and IntOps.equals(output.split(" blorp_list_repeat_1_i(").length(), 2)
				and output.contains("struct blorp_l_0_i* values[];")
				and output.contains("blorp_list_dup_0_i(element);result->values[index]=element;")
				and output.contains("blorp_list_drop_0_i(element);}blorp_memory_release(value);")
			)


pure func test_numeric_list_emits_root_helpers_without_string_runtime() -> Bool:
	source: String =
		|pure func repeat[T](element: T, count: Int) -> List[T]:
		|    builtin("list.repeat")
		|func main() -> Int:
		|    values = repeat(0, 2)
		|    outer = repeat(values, 2)
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output): output.contains("struct blorp_l_0_i{") and output.contains("struct blorp_l_1_i{") and not output.contains("struct blorp_string")


pure func test_void_list_emits_root_helpers_without_string_runtime() -> Bool:
	source: String =
		|pure func repeat[T](element: T, count: Int) -> List[T]:
		|    builtin("list.repeat")
		|func main() -> Int:
		|    values = repeat(void, 2)
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output): output.contains("struct blorp_l_0_v{") and not output.contains("struct blorp_string")


private pure func string_update(update: ListUpdate) -> String:
	list_update_runtime(update, Concrete.StringType, "struct blorp_string*", "blorp_string_retain(element);", "blorp_string_release(element);")


pure func test_update_names_project_from_the_element_key() -> Bool:
	(
		list_update_name(AppendUpdate, list_element_key(Concrete.IntType)) == "blorp_list_append_0_i"
		and list_update_name(SetUpdate, list_element_key(Concrete.StringType)) == "blorp_list_set_0_s"
		and list_update_name(ConcatUpdate, list_element_key(Concrete.ListType(Concrete.IntType))) == "blorp_list_concat_1_i"
	)


pure func test_append_checks_growth_once_then_acquires_every_stored_occurrence() -> Bool:
	fragment = string_update(AppendUpdate)
	(
		fragment.contains("struct blorp_l_0_s* blorp_list_append_0_s(const struct blorp_l_0_s *values,struct blorp_string* value){")
		and fragment.contains("if(count>=(uint64_t)INT64_MAX||count>=(SIZE_MAX-sizeof(struct blorp_l_0_s))/sizeof(struct blorp_string*))abort();")
		and IntOps.equals(fragment.split("=blorp_memory_allocate(").length(), 2)
		and fragment.contains("for(uint64_t index=0;index<count;index++){struct blorp_string* element=values->values[index];blorp_string_retain(element);result->values[index]=element;result->length++;}")
		and fragment.contains("struct blorp_string* element=value;blorp_string_retain(element);result->values[count]=element;result->length++;return result;}")
	)


pure func test_set_copies_every_slot_and_replaces_only_the_matching_index() -> Bool:
	fragment = string_update(SetUpdate)
	(
		fragment.contains("struct blorp_l_0_s* blorp_list_set_0_s(const struct blorp_l_0_s *values,int64_t index,struct blorp_string* value){")
		and IntOps.equals(fragment.split("=blorp_memory_allocate(").length(), 2)
		and fragment.contains("for(uint64_t slot=0;slot<count;slot++){struct blorp_string* element=(index>=0&&(uint64_t)index==slot)?value:values->values[slot];blorp_string_retain(element);result->values[slot]=element;result->length++;}return result;}")
		and not fragment.contains("return values")
	)


pure func test_concat_checks_combined_length_then_acquires_both_sides() -> Bool:
	fragment = string_update(ConcatUpdate)
	(
		fragment.contains("struct blorp_l_0_s* blorp_list_concat_0_s(const struct blorp_l_0_s *left,const struct blorp_l_0_s *right){")
		and fragment.contains("if(second>(uint64_t)INT64_MAX-first||first+second>(SIZE_MAX-sizeof(struct blorp_l_0_s))/sizeof(struct blorp_string*))abort();")
		and IntOps.equals(fragment.split("=blorp_memory_allocate(").length(), 2)
		and fragment.contains("for(uint64_t index=0;index<first;index++){struct blorp_string* element=left->values[index];blorp_string_retain(element);result->values[index]=element;result->length++;}")
		and fragment.contains("for(uint64_t index=0;index<second;index++){struct blorp_string* element=right->values[index];blorp_string_retain(element);result->values[first+index]=element;result->length++;}return result;}")
	)


pure func test_unmanaged_elements_are_copied_without_ownership_operations() -> Bool:
	fragment = list_update_runtime(AppendUpdate, Concrete.IntType, "int64_t", "", "")
	fragment.contains("{int64_t element=values->values[index];result->values[index]=element;result->length++;}int64_t element=value;result->values[count]=element;")


pure func test_update_helpers_exist_only_where_their_operation_is_called() -> Bool:
	source: String =
		|pure func repeat[T](element: T, count: Int) -> List[T]:
		|    builtin("list.repeat")
		|pure func append[T](values: List[T], value: T) -> List[T]:
		|    builtin("list.append")
		|func main() -> Int:
		|    values = repeat(1, 2)
		|    longer = append(values, 3)
		|    again = append(longer, 4)
		|    outer = append(repeat(values, 1), longer)
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output):
			(
				IntOps.equals(output.split(" blorp_list_append_0_i(").length(), 2)
				and IntOps.equals(output.split(" blorp_list_append_1_i(").length(), 2)
				and output.contains("struct blorp_l_0_i* element=values->values[index];blorp_list_dup_0_i(element);result->values[index]=element;")
				and not output.contains("blorp_list_set_")
				and not output.contains("blorp_list_concat_")
			)


pure func test_set_and_concat_helpers_exist_where_their_operations_are_called() -> Bool:
	source: String =
		|pure func repeat[T](element: T, count: Int) -> List[T]:
		|    builtin("list.repeat")
		|pure func set[T](values: List[T], index: Int, value: T) -> List[T]:
		|    builtin("list.set")
		|pure func concat[T](left: List[T], right: List[T]) -> List[T]:
		|    builtin("list.concat")
		|func main() -> Int:
		|    values = repeat(1, 2)
		|    changed = set(values, 0, 3)
		|    joined = concat(values, changed)
		|    0
		|
	int_key = list_element_key(Concrete.IntType)
	set_definition = " " + list_update_name(SetUpdate, int_key) + "("
	concat_definition = " " + list_update_name(ConcatUpdate, int_key) + "("
	match compile(source):
		Err(_): False
		Ok(output):
			(
				IntOps.equals(output.split(set_definition).length(), 2)
				and IntOps.equals(output.split(concat_definition).length(), 2)
				and not output.contains("blorp_list_append_")
			)


pure func test_repeat_only_programs_omit_update_helpers() -> Bool:
	source: String =
		|pure func repeat[T](element: T, count: Int) -> List[T]:
		|    builtin("list.repeat")
		|func main() -> Int:
		|    values = repeat(0, 2)
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output):
			not output.contains("blorp_list_append_") and not output.contains("blorp_list_set_") and not output.contains("blorp_list_concat_")


pure func test_root_allocation_and_slot_store_name_their_root() -> Bool:
	(
		list_root_allocation("struct blorp_l_0_i* const", "blorp_vl_3", "2")
			== "struct blorp_l_0_i* const blorp_vl_3=blorp_memory_allocate(sizeof *blorp_vl_3+(size_t)2*sizeof *blorp_vl_3->values);if(!blorp_vl_3)abort();atomic_init(&blorp_vl_3->references,1);blorp_vl_3->length=0;blorp_vl_3->capacity=(size_t)2;"
		and list_slot_store("blorp_vl_3", "1", "blorp_owner_2") == "blorp_vl_3->values[1]=blorp_owner_2;blorp_vl_3->length++;"
	)


pure func test_literal_is_one_inline_allocation_with_a_store_per_element() -> Bool:
	source: String =
		|pure func numbers() -> List[Int]:
		|    [1, 2, 3]
		|func main() -> Int:
		|    values = numbers()
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output):
			(
				output.contains("struct blorp_l_0_i* const blorp_vl_3=blorp_memory_allocate(sizeof *blorp_vl_3+(size_t)3*sizeof *blorp_vl_3->values);if(!blorp_vl_3)abort();atomic_init(&blorp_vl_3->references,1);blorp_vl_3->length=0;blorp_vl_3->values[0]=blorp_vl_0;blorp_vl_3->length++;blorp_vl_3->values[1]=blorp_vl_1;blorp_vl_3->length++;blorp_vl_3->values[2]=blorp_vl_2;blorp_vl_3->length++;(void)blorp_vl_3;")
				and IntOps.equals(output.split("blorp_list_repeat_0_i(").length(), 2)
				and not output.contains("blorp_list_append_")
			)


pure func test_managed_literal_stores_acquired_owners() -> Bool:
	source: String =
		|pure func text(value: Int) -> String:
		|    builtin("int.to_string")
		|pure func pair(value: String) -> List[String]:
		|    [value, value]
		|func main() -> Int:
		|    values = pair(text(42))
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output):
			(
				output.contains("struct blorp_l_0_s* const blorp_vl_1=blorp_memory_allocate(sizeof *blorp_vl_1+(size_t)2*sizeof *blorp_vl_1->values);")
				and output.contains("blorp_vl_1->values[0]=blorp_owner_0;blorp_vl_1->length++;blorp_vl_1->values[1]=blorp_owner_1;blorp_vl_1->length++;(void)blorp_vl_1;")
				-- One retain precedes each owner: both occurrences of the parameter are acquired.
				and output.contains("blorp_string_retain(blorp_vl_0);struct blorp_string* const blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;blorp_string_retain(blorp_vl_0);struct blorp_string* const blorp_owner_1=blorp_vl_0;(void)blorp_owner_1;struct blorp_l_0_s* const blorp_vl_1=blorp_memory_allocate(")
			)


pure func test_empty_literal_allocates_an_empty_root() -> Bool:
	source: String =
		|pure func none() -> List[Int]:
		|    []
		|func main() -> Int:
		|    values = none()
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output):
			output.contains("struct blorp_l_0_i* const blorp_vl_0=blorp_memory_allocate(sizeof *blorp_vl_0+(size_t)0*sizeof *blorp_vl_0->values);if(!blorp_vl_0)abort();atomic_init(&blorp_vl_0->references,1);blorp_vl_0->length=0;(void)blorp_vl_0;")



pure func test_suffix_copies_only_surviving_owned_occurrences() -> Bool:
	fragment = list_update_runtime(SuffixUpdate, Concrete.StringType,
		"struct blorp_string*", "blorp_string_retain(element);", "blorp_string_release(element);")
	(
		fragment.contains("const uint64_t count=(uint64_t)(values->length-start);")
		and fragment.contains("element=values->values[(uint64_t)start+index];blorp_string_retain(element);result->values[index]=element;result->length++;")
		and fragment.contains("blorp_memory_allocate(sizeof *result+(size_t)count*sizeof *result->values)")
		and not fragment.contains("blorp_list_drop_")
	)


pure func test_suffix_helper_is_deduplicated_for_repeated_rest_captures() -> Bool:
	source: String =
		|pure func rest(values: List[String]) -> List[String]:
		|    match values:
		|        []: []
		|        [_, ...remaining]: remaining
		|pure func another(values: List[String]) -> List[String]:
		|    match values:
		|        []: []
		|        [_, ...remaining]: remaining
		|func main() -> Int:
		|    first = rest(["a", "b"])
		|    second = another(["c", "d"])
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output):
			(
				output.count("blorp_list_suffix_0_s(const struct blorp_l_0_s *values,int64_t start)") == 1
				and output.count("=blorp_list_suffix_0_s(") == 2
			)


pure func test_wildcard_rest_omits_suffix_construction_and_helper() -> Bool:
	source: String =
		|pure func first(values: List[String]) -> String:
		|    match values:
		|        []: "empty"
		|        [item, ..._]: item
		|func main() -> Int:
		|    unused = first(["a", "b"])
		|    0
		|
	match compile(source):
		Err(_): False
		Ok(output): not output.contains("blorp_list_suffix_")


func test_changed_list_runtime_source_uses_target_grammar() -> Bool:
	match read_file("blorp_2/src/runtime/list.brp"):
		Err(_): False
		Ok(source):
			lex(module_source(root_module_id()), source, program_names().names)
				.and_then(pure func(tokens): parse_module(tokens, root_module_id())).is_ok()

tests: TestSuite = {
	description = "Blorp 2 concrete List runtime and derived helper keys",
	tests = [
		("List runtime source uses target grammar", test_changed_list_runtime_source_uses_target_grammar),
		("suffix copies surviving owned occurrences into a fresh root", test_suffix_copies_only_surviving_owned_occurrences),
		("repeated rest captures share exactly one suffix helper", test_suffix_helper_is_deduplicated_for_repeated_rest_captures),
		("wildcard rest omits suffix construction and helper", test_wildcard_rest_omits_suffix_construction_and_helper),
		("argument main selects shared runtime", test_argument_main_selects_the_shared_list_runtime_fragment),
		("nullary main omits list runtime", test_nullary_main_omits_list_runtime),
		("reachable union payload selects runtime without argv", test_reachable_union_payload_selects_list_runtime_without_argv),
		("keys preserve every primitive type", test_flat_keys_preserve_all_primitive_types),
		("keys distinguish nominal domains and phantom instances", test_flat_keys_preserve_nominal_domains_and_phantom_instances),
		("key equality equals semantic type equality", test_flat_key_equality_is_exact_semantic_type_equality),
		("child keys remove one layer without losing identity", test_child_keys_preserve_terminal_identity_and_remove_one_layer),
		("keys project primitive and nested C names", test_key_projects_distinct_primitive_and_nested_c_names),
		("repeat clamps count and checks allocation size", test_repeat_clamps_before_conversion_and_checks_allocation_sizing),
		("repeat acquires each initialized slot", test_repeat_acquires_each_slot_before_publishing_initialized_length),
		("get separates presence and owns its result", test_get_reports_presence_separately_and_acquires_the_result),
		("final drop releases every stored occurrence", test_final_root_drop_releases_each_initialized_occurrence),
		("emission deduplicates E and preserves nested helper suffixes", test_emission_deduplicates_repeated_elements_and_keeps_nested_suffixes),
		("numeric nested Lists omit String runtime", test_numeric_list_emits_root_helpers_without_string_runtime),
		("Void Lists omit String runtime", test_void_list_emits_root_helpers_without_string_runtime),
		("update names project from the element key", test_update_names_project_from_the_element_key),
		("append checks growth once and acquires each slot", test_append_checks_growth_once_then_acquires_every_stored_occurrence),
