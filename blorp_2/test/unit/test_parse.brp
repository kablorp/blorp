import:
	../../src/names: name_spelling
	../../src/parse: ParsedProgram, parse_prelude, parsed_contents
	../../src/syntax:
		BindingSyntax(MutableBinding),
		CallNotation(ReceiverCall),
		Diagnostic,
		ExpressionBase(IntegerExpression, NameExpression),
		FieldPattern(FieldName),
		ParameterList(EmptyParameters),
		ParsedBody(ParsedValueBody, ParsedMatchBody),
		ParsedFunction,
		ParsedPattern(PatternConstructor),
		PatternFields(OnePatternField),
		Purity(Impure),
		Symbol(
			FunctionKeyword, MatchKeyword, LeftParen, RightParen, Dot, Arrow, Colon, Newline,
			VarKeyword, Equals,
		),
		Token,
		TokenKind(IdentifierToken, SymbolToken, IntegerLiteral, Indentation),
		UnaryApplication,
		ValueExpression,
	input: parse
	test: TestSuite


private pure func value_of(function: ParsedFunction) -> Option[ValueExpression]:
	match function.body:
		ParsedValueBody(value):
			Some(value)
		_:
			None


private pure func base_of(function: ParsedFunction) -> Option[ExpressionBase]:
	value_of(function).map(pure func(value): value.base)


private pure func applications_of(function: ParsedFunction) -> Option[List[UnaryApplication]]:
	value_of(function).map(pure func(value): value.applications)


-- Construct the phase input directly so lexer changes cannot change this oracle.
private pure func program_tokens(function_name: String, return_type: String) -> List[Token]:
	[
		{
			kind = SymbolToken(FunctionKeyword),
			span = {
				start = 0,
				end = 4
			}
		},
		{
			kind = IdentifierToken(function_name),
			span = {
				start = 5,
				end = 9
			}
		},
		{
			kind = SymbolToken(LeftParen),
			span = {
				start = 9,
				end = 10
			}
		},
		{
			kind = SymbolToken(RightParen),
			span = {
				start = 10,
				end = 11
			}
		},
		{
			kind = SymbolToken(Arrow),
			span = {
				start = 12,
				end = 14
			}
		},
		{
			kind = IdentifierToken(return_type),
			span = {
				start = 15,
				end = 18
			}
		},
		{
			kind = SymbolToken(Colon),
			span = {
				start = 18,
				end = 19
			}
		},
		{
			kind = SymbolToken(Newline),
			span = {
				start = 19,
				end = 20
			}
		},
		{
			kind = Indentation(1),
			span = {
				start = 20,
				end = 21
			}
		},
		{
			kind = IntegerLiteral("0"),
			span = {
				start = 21,
				end = 22
			}
		},
		{
			kind = SymbolToken(Newline),
			span = {
				start = 22,
				end = 23
			}
		},
	]


private pure func rejects(
	result: Result[ParsedProgram, Diagnostic],
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match result:
		Err(diagnostic):
			(
				diagnostic.span.start == start
				and diagnostic.span.end == end
				and diagnostic.message == message
				and diagnostic.help == help
			)
		Ok(_):
			False


pure func test_unchecked_names_and_spans() -> Bool:
	match (
		parse({
			tokens = program_tokens("nope", "Foo"),
			end = {
				start = 23,
				end = 23
			},
		})
	):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					body_is_zero: Bool = match base_of(function):
						Some(IntegerExpression(0)):
							applications_of(
								function,
							).map(
								pure func(values): values.length(),
							) == Some(0)
						_:
							False

					parameters_empty: Bool = match function.parameters:
						EmptyParameters:
							True
						_:
							False

					(
						name_spelling(program.names, function.function_name.id) == Some("nope")
						and function.function_name.span.start == 5
						and function.function_name.span.end == 9
						and name_spelling(program.names, function.return_type.id) == Some("Foo")
						and function.return_type.span.start == 15
						and function.return_type.span.end == 18
						and body_is_zero
						and parameters_empty
						and function.purity == Impure
						and value_of(function).map(pure func(value): value.span.start) == Some(21)
						and value_of(function).map(pure func(value): value.span.end) == Some(22)
						and program.unions.length() == 0
						and program.end.start == 23
					)
				_:
					False


pure func test_optional_final_newline() -> Bool:
	match (
		parse({
			tokens = program_tokens("main", "Int").take(10),
			end = {
				start = 22,
				end = 22
			},
		})
	):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			program.functions.length() == 1


private pure func replace_and_reject(
	position: Int,
	kind: TokenKind,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match (
		program_tokens("main", "Int").set_index(
			position,
			{
				kind = kind,
				span = {
					start = start,
					end = end
				}
			},
		)
	):
		None:
			False
		Some(tokens):
			rejects(
				parse({
					tokens = tokens,
					end = {
						start = 23,
						end = 23
					},
				}),
				start,
				end,
				message,
				help,
			)


pure func test_parameter_annotation_is_required() -> Bool:
	replace_and_reject(
		3,
		IdentifierToken("x"),
		12,
		14,
		"expected ':' after the parameter name",
		"write a single parameter as name: Int",
	)


pure func test_bare_name_is_parsed_without_scope_resolution() -> Bool:
	match (
		program_tokens("main", "Int").set_index(
			9,
			{
				kind = IdentifierToken("x"),
				span = {
					start = 21,
					end = 22
				}
			},
		)
	):
		None:
			False
		Some(tokens):
			match (
				parse({
					tokens = tokens,
					end = {
						start = 23,
						end = 23
					},
				})
			):
				Err(_):
					False
				Ok(parsed):
					program = parsed_contents(parsed)

					match program.functions:
						[function]:
							match base_of(function):
								Some(NameExpression(name)):
									(
										name_spelling(program.names, name.id) == Some("x")
										and name.span.start == 21
										and name.span.end == 22
										and applications_of(
											function,
										).map(
											pure func(values): values.length(),
										) == Some(0)
									)
								_:
									False
						_:
							False


pure func test_trailing_input_is_rejected() -> Bool:
	rejects(
		parse({
			tokens = program_tokens("main", "Int").append({
				kind = IntegerLiteral("0"),
				span = {
					start = 23,
					end = 24
				},
			}),
			end = {
				start = 24,
				end = 24
			},
		}),
		23,
		24,
		"expected a function declaration at column 1",
		"start with func main() -> Int:",
	)


pure func test_missing_body_uses_explicit_eof_span() -> Bool:
	rejects(
		parse({
			tokens = program_tokens("main", "Int").take(9),
			end = {
				start = 21,
				end = 21
			},
		}),
		21,
		21,
		"expected a return expression",
		"use a literal, a parameter or variant name, or a call as the entire body",
	)


private pure func token(kind: TokenKind, start: Int, end: Int) -> Token:
	{
		kind = kind,
		span = {
			start = start,
			end = end
		}
	}


pure func test_ufcs_from_independent_token_spans() -> Bool:
	match (
		parse({
			tokens = program_tokens("main", "Int")
				.take(9)
				.append(token(IntegerLiteral("1"), 21, 22))
				.append(token(SymbolToken(Dot), 23, 24))
				.append(token(IdentifierToken("identity"), 25, 33))
				.append(token(SymbolToken(LeftParen), 34, 35))
				.append(token(SymbolToken(RightParen), 36, 37))
				.append(token(SymbolToken(Newline), 37, 38)),
			end = {
				start = 38,
				end = 38
			},
		})
	):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match base_of(function):
						Some(IntegerExpression(1)):
							match applications_of(function):
								Some([call]):
									(
										call.notation == ReceiverCall
										and name_spelling(
											program.names,
											call.callee.id,
										) == Some("identity")
										and call.callee.span.start == 25
										and call.callee.span.end == 33
										and program.end.start == 38
										and program.end.end == 38
									)
								_:
									False
						_:
							False
				_:
					False


private pure func parse_literal(spelling: String) -> Result[ParsedProgram, Diagnostic]:
	end = 21 + spelling.length()
	parse({
		tokens = program_tokens("main", "Int")
			.take(9)
			.append(token(IntegerLiteral(spelling), 21, end)),
		end = {
			start = end,
			end = end
		},
	})


private pure func literal_is(spelling: String, expected: Int) -> Bool:
	match parse_literal(spelling):
		Err(_):
			False
		Ok(parsed):
			match parsed_contents(parsed).functions:
				[function]:
					match base_of(function):
						Some(IntegerExpression(value)):
							(
								value == expected
								and applications_of(
									function,
								).map(
									pure func(values): values.length(),
								) == Some(0)
							)
						_:
							False
				_:
					False


private pure func rejects_literal(spelling: String, message: String, help: String) -> Bool:
	rejects(parse_literal(spelling), 21, 21 + spelling.length(), message, help)


pure func test_signed_literals_and_endpoints() -> Bool:
	(
		literal_is("42", 42)
		and literal_is("-42", -42)
		and literal_is("-0", 0)
		and literal_is("1000", 1000)
		and literal_is("9223372036854775807", 9223372036854775807)
		and literal_is("-9223372036854775808", -9223372036854775808)
	)


pure func test_literal_range_rejections_have_whole_token_spans() -> Bool:
	message = "integer literal is outside the Int64 range"
	help = "use a value from -9223372036854775808 to 9223372036854775807"
	(
		rejects_literal("9223372036854775808", message, help)
		and rejects_literal("-9223372036854775809", message, help)
		and rejects_literal("9999999999999999999999999999999999999999", message, help)
		and rejects_literal("-9999999999999999999999999999999999999999", message, help)
	)


pure func test_raw_token_spelling_is_validated() -> Bool:
	message = "invalid integer literal"
	help = "write decimal digits, optionally preceded by an adjacent '-'"
	(
		rejects_literal("", message, help)
		and rejects_literal("-", message, help)
		and rejects_literal("+1", message, help)
		and rejects_literal("1a", message, help)
		and rejects_literal(
			"00",
			"integer literals cannot have leading zeros",
			"write 0 or -0, or remove the leading zeros",
		)
		and rejects_literal(
			"-01",
			"integer literals cannot have leading zeros",
			"write 0 or -0, or remove the leading zeros",
		)
	)


private pure func match_tokens() -> List[Token]:
	program_tokens("main", "Int")
		.take(9)
		.concat([
			token(SymbolToken(MatchKeyword), 21, 26),
			token(IdentifierToken("Choice"), 27, 33),
			token(SymbolToken(Colon), 33, 34),
			token(SymbolToken(Newline), 34, 35),
			token(Indentation(2), 35, 37),
			token(IdentifierToken("Number"), 37, 43),
			token(SymbolToken(LeftParen), 43, 44),
			token(IdentifierToken("item"), 44, 48),
			token(SymbolToken(RightParen), 48, 49),
			token(SymbolToken(Colon), 49, 50),
			token(IntegerLiteral("42"), 51, 53),
			token(SymbolToken(Newline), 53, 54),
		])


pure func test_match_from_independent_tokens_preserves_structure_and_spans() -> Bool:
	match (
		parse({
			tokens = match_tokens(),
			end = {
				start = 54,
				end = 54
			},
		})
	):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)

			match program.functions:
				[function]:
					match function.body:
						ParsedMatchBody(body):
							scrutinee = match body.scrutinee.base:
								NameExpression(name):
									(
										name_spelling(program.names, name.id) == Some("Choice")
										and name.span.start == 27
										and name.span.end == 33
									)
								_:
									False

							match body.arms:
								[arm]:
									pattern = match arm.pattern:
										PatternConstructor(name, OnePatternField(FieldName(field)), span):
											(
												name_spelling(
													program.names,
													name.id,
												) == Some("Number")
												and name.span.start == 37
												and name.span.end == 43
												and name_spelling(
													program.names,
													field.id,
												) == Some("item")
												and field.span.start == 44
												and field.span.end == 48
												and span.start == 37
												and span.end == 49
											)
										_:
											False

									value = match arm.body.base:
										IntegerExpression(42):
											True
										_:
											False

									(
										scrutinee
										and pattern
										and value
										and body.keyword_span.start == 21
										and body.keyword_span.end == 26
										and body.span.start == 21
										and body.span.end == 53
										and body.scrutinee.span.start == 27
										and body.scrutinee.span.end == 33
										and body.scrutinee.applications.length() == 0
										and arm.span.start == 37
										and arm.span.end == 53
										and arm.body.span.start == 51
										and arm.body.span.end == 53
										and arm.body.applications.length() == 0
										and program.end.start == 54
										and program.end.end == 54
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_match_keyword_requires_a_space_before_the_expression() -> Bool:
	match match_tokens().set_index(
		10,
		token(IntegerLiteral("42"), 26, 28),
	):
		None:
			False
		Some(tokens):
			rejects(
				parse({
					tokens = tokens,
					end = {
						start = 54,
						end = 54
					},
				}),
				26,
				28,
				"expected a space after 'match'",
				"put a space between 'match' and the matched expression",
			)


pure func test_missing_match_arm_result_uses_explicit_eof_span() -> Bool:
	rejects(
		parse({
			tokens = match_tokens().take(19),
			end = {
				start = 50,
				end = 50
			},
		}),
		50,
		50,
		"expected a return expression",
		"use a literal, a parameter or variant name, or a call as the entire body",
	)


private pure func block_arm_tokens() -> List[Token]:
	match_tokens()
		.take(19)
		.concat([
			token(SymbolToken(Newline), 50, 51),
			token(Indentation(3), 51, 54),
			token(SymbolToken(VarKeyword), 54, 57),
			token(IdentifierToken("current"), 58, 65),
			token(SymbolToken(Equals), 66, 67),
			token(IdentifierToken("item"), 68, 72),
			token(SymbolToken(Newline), 72, 73),
			token(Indentation(3), 73, 76),
			token(IdentifierToken("current"), 76, 83),
			token(SymbolToken(Newline), 83, 84),
			token(Indentation(2), 84, 86),
			token(IdentifierToken("Empty"), 86, 91),
			token(SymbolToken(Colon), 91, 92),
			token(IntegerLiteral("0"), 93, 94),
		])


pure func test_block_arm_and_inline_sibling_from_direct_tokens() -> Bool:
	match (
		parse({
			tokens = block_arm_tokens(),
			end = {
				start = 94,
				end = 94
			},
		})
	):
		Err(_):
			False
		Ok(parsed):
			match parsed_contents(parsed).functions:
				[function]:
					match function.body:
						ParsedMatchBody(body):
							match body.arms:
								[first, second]:
									match first.bindings:
										[binding]:
											(
												binding.mutability == MutableBinding
												and binding.name.span.start == 58
												and binding.name.span.end == 65
												and binding.initializer.span.start == 68
												and binding.initializer.span.end == 72
												and first.span.start == 37
												and first.span.end == 83
												and first.body.span.start == 76
												and second.body.span.end == 94
												and second.bindings.length() == 0
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_block_arm_can_have_no_bindings() -> Bool:
	match (
		parse({
			tokens = block_arm_tokens()
				.take(21)
				.append(token(IntegerLiteral("42"), 54, 56)),
			end = {
				start = 56,
				end = 56
			},
		})
	):
		Err(_):
			False
		Ok(parsed):
			match parsed_contents(parsed).functions:
				[function]:
					match function.body:
						ParsedMatchBody(body):
							match body.arms:
								[arm]:
									(
										arm.bindings.length() == 0
										and arm.body.span.start == 54
										and arm.body.span.end == 56
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_block_arm_rejects_depth_two_and_four() -> Bool:
	var correct = True

	for depth in [2, 4]:
		tokens = block_arm_tokens().set(
			20,
			token(Indentation(depth), 51, 54),
		)
		correct = correct and rejects(
			parse({
				tokens = tokens,
				end = {
					start = 94,
					end = 94
				},
			}),
			51,
			54,
			"expected a match arm result indented three levels",
			"finish the arm with a value expression indented with three tabs or twelve spaces",
		)

	correct


pure func test_block_arm_missing_result_does_not_consume_sibling() -> Bool:
	tokens = block_arm_tokens()
		.take(26)
		.concat([
			token(Indentation(2), 73, 75),
			token(IdentifierToken("Empty"), 75, 80),
			token(SymbolToken(Colon), 80, 81),
			token(IntegerLiteral("0"), 82, 83),
		])
	rejects(
		parse({
			tokens = tokens,
			end = {
				start = 83,
				end = 83
			},
		}),
		73,
		75,
		"expected a match arm result indented three levels",
		"finish the arm with a value expression indented with three tabs or twelve spaces",
	)


pure func test_block_arm_missing_result_at_eof_after_initializer() -> Bool:
	rejects(
		parse({
			tokens = block_arm_tokens().take(25),
			end = {
				start = 72,
				end = 72
			},
		}),
		72,
		72,
		"expected a final expression after the arm bindings",
		"finish the arm with a value expression on its own indented line",
	)


pure func test_block_arm_missing_result_at_eof_after_newline() -> Bool:
	rejects(
		parse({
			tokens = block_arm_tokens().take(26),
			end = {
				start = 73,
				end = 73
			},
		}),
		73,
		73,
		"expected a match arm result indented three levels",
		"finish the arm with a value expression indented with three tabs or twelve spaces",
	)


-- Construct binding tokens directly so lexing cannot manufacture this shape.
private pure func binding_tokens() -> List[Token]:
	program_tokens("main", "Int").take(9) + [
		{
			kind = SymbolToken(VarKeyword),
			span = {
				start = 21,
				end = 24
			}
		},
		{
			kind = IdentifierToken("value"),
			span = {
				start = 25,
				end = 30
			}
		},
		{
			kind = SymbolToken(Equals),
			span = {
				start = 31,
				end = 32
			}
		},
		{
			kind = IntegerLiteral("42"),
			span = {
				start = 33,
				end = 35
			}
		},
		{
			kind = SymbolToken(Newline),
			span = {
				start = 35,
				end = 36
			}
		},
		{
			kind = Indentation(1),
			span = {
				start = 36,
				end = 37
			}
		},
		{
			kind = IdentifierToken("value"),
			span = {
				start = 37,
				end = 42
			}
		},
	]


pure func test_binding_prefix_from_direct_tokens() -> Bool:
	match (
		parse({
			tokens = binding_tokens(),
			end = {
				start = 42,
				end = 42
			},
		})
	):
		Err(_):
			False
		Ok(parsed):
			contents = parsed_contents(parsed)

			match contents.functions:
				[function]:
					match function.bindings:
						[binding]:
							match binding.mutability:
								MutableBinding:
									match binding.initializer.base:
										IntegerExpression(42):
											(
												name_spelling(
													contents.names,
													binding.name.id,
												) == Some("value")
												and binding.name.span.start == 25
												and binding.name.span.end == 30
												and binding.initializer.base_span.start == 33
												and binding.initializer.base_span.end == 35
												and value_of(
													function,
												).map(
													pure func(value): value.span.start,
												) == Some(37)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_binding_missing_initializer_from_direct_tokens() -> Bool:
	input = binding_tokens().take(12) + [
		{
			kind = SymbolToken(Newline),
			span = {
				start = 32,
				end = 33
			}
		},
	]
	rejects(
		parse({
			tokens = input,
			end = {
				start = 33,
				end = 33
			},
		}),
		32,
		33,
		"expected a binding initializer",
		"put one expression after '=' on the same line",
	)


pure func test_binding_requires_final_value_from_direct_tokens() -> Bool:
	rejects(
		parse({
			tokens = binding_tokens().take(13),
			end = {
				start = 35,
				end = 35
			},
		}),
		35,
		35,
		"expected a final expression after the bindings",
		"finish the function with a value expression or tail match",
	)


pure func test_prelude_entry_rejection_uses_prelude_declarations() -> Bool:
	match parse_prelude({
		tokens = [{
			kind = IdentifierToken("wrong"),
			span = { start = 0, end = 5 },
		}],
		end = { start = 5, end = 5 },
	}):
		Err(error):
			(
				error.span.start == 0 and error.span.end == 5
				and error.message == "expected a builtin prelude declaration"
				and error.help == "declare type Int = builtin, type String = builtin, or a pure function with a builtin(...) body"
			)
		Ok(_):
			False


