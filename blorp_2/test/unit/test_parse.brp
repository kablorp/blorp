import:
	../../src/parse: parse
	../../src/syntax:
		Diagnostic,
		ParsedProgram,
		ReturnExpression(ZeroExpression),
		Symbol(FunctionKeyword, LeftParen, RightParen, Arrow, Colon, Newline, Indent),
		Token,
		TokenKind(IdentifierToken, SymbolToken, ZeroLiteral),
	test: TestSuite


-- Construct the phase input directly so lexer changes cannot change this oracle.
private pure func program_tokens(function_name: String, return_type: String) -> List[Token]:
	[
		{
			kind = SymbolToken(FunctionKeyword),
			span = {
				start = 0,
				end = 4
			}
		},
		{
			kind = IdentifierToken(function_name),
			span = {
				start = 5,
				end = 9
			}
		},
		{
			kind = SymbolToken(LeftParen),
			span = {
				start = 9,
				end = 10
			}
		},
		{
			kind = SymbolToken(RightParen),
			span = {
				start = 10,
				end = 11
			}
		},
		{
			kind = SymbolToken(Arrow),
			span = {
				start = 12,
				end = 14
			}
		},
		{
			kind = IdentifierToken(return_type),
			span = {
				start = 15,
				end = 18
			}
		},
		{
			kind = SymbolToken(Colon),
			span = {
				start = 18,
				end = 19
			}
		},
		{
			kind = SymbolToken(Newline),
			span = {
				start = 19,
				end = 20
			}
		},
		{
			kind = SymbolToken(Indent),
			span = {
				start = 20,
				end = 21
			}
		},
		{
			kind = ZeroLiteral,
			span = {
				start = 21,
				end = 22
			}
		},
		{
			kind = SymbolToken(Newline),
			span = {
				start = 22,
				end = 23
			}
		},
	]


private pure func rejects(
	result: Result[ParsedProgram, Diagnostic],
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match result:
		Err(diagnostic):
			(
				diagnostic.span.start == start
				and diagnostic.span.end == end
				and diagnostic.message == message
				and diagnostic.help == help
			)
		Ok(_):
			False


pure func test_unchecked_names_and_spans() -> Bool:
	match (
		parse({
			tokens = program_tokens("nope", "Foo"),
			end = {
				start = 23,
				end = 23
			},
		})
	):
		Err(_):
			False
		Ok(program):
			match program.body:
				ZeroExpression:
					(
						program.function_name.spelling == "nope"
						and program.function_name.span.start == 5
						and program.function_name.span.end == 9
						and program.return_type.spelling == "Foo"
						and program.return_type.span.start == 15
						and program.return_type.span.end == 18
					)


pure func test_optional_final_newline() -> Bool:
	match (
		parse({
			tokens = program_tokens("main", "Int").take(10),
			end = {
				start = 22,
				end = 22
			},
		})
	):
		Err(_):
			False
		Ok(program):
			match program.body:
				ZeroExpression:
					(
						program.function_name.spelling == "main"
						and program.return_type.spelling == "Int"
					)


pure func test_parameters_are_rejected() -> Bool:
	match (
		program_tokens("main", "Int").set_index(
			3,
			{
				kind = IdentifierToken("x"),
				span = {
					start = 10,
					end = 11
				}
			},
		)
	):
		None:
			False
		Some(tokens):
			rejects(
				parse({
					tokens = tokens,
					end = {
						start = 23,
						end = 23
					},
				}),
				10,
				11,
				"expected ')' with no parameters",
				"write main() with no parameters",
			)


pure func test_wrong_body_token() -> Bool:
	match (
		program_tokens("main", "Int").set_index(
			9,
			{
				kind = IdentifierToken("x"),
				span = {
					start = 21,
					end = 22
				}
			},
		)
	):
		None:
			False
		Some(tokens):
			rejects(
				parse({
					tokens = tokens,
					end = {
						start = 23,
						end = 23
					},
				}),
				21,
				22,
				"expected the integer literal 0",
				"use 0 as the entire function body",
			)


pure func test_trailing_input_is_rejected() -> Bool:
	tokens: List[Token] = program_tokens("main", "Int").append({
		kind = ZeroLiteral,
		span = {
			start = 23,
			end = 24
		},
	})
	rejects(
		parse({
			tokens = tokens,
			end = {
				start = 24,
				end = 24
			},
		}),
		23,
		24,
		"unexpected input after the zero expression",
		"keep exactly one function with only 0 as its body and no extra blank lines",
	)


pure func test_missing_body_uses_explicit_eof_span() -> Bool:
	rejects(
		parse({
			tokens = program_tokens("main", "Int").take(9),
			end = {
				start = 21,
				end = 21
			},
		}),
		21,
		21,
		"expected the integer literal 0",
		"use 0 as the entire function body",
	)


tests: TestSuite = {
	description = "Blorp 2 parser",
	tests = [
		("unchecked names and spans", test_unchecked_names_and_spans),
		("optional final newline", test_optional_final_newline),
		("parameters are rejected", test_parameters_are_rejected),
		("wrong body token", test_wrong_body_token),
		("trailing input is rejected", test_trailing_input_is_rejected),
		("missing body uses explicit EOF span", test_missing_body_uses_explicit_eof_span),
	]
}
