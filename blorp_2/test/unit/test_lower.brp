import:
	../../src/lex: lex
	../../src/lower:
		LoweredProgram,
		LoweredTail(ReturnValue, MatchValue),
		ValueOperation(
			ParameterValue, IntegerValue, VariantValue, CallValue, ConstructValue, PayloadValue,
		),
		lower,
		lowered_functions,
		value_number,
	../../src/prelude: RuntimeOperation(StringLength)
	../../src/specialize:
		CallTarget(UserFunction, RuntimeFunction),
		TypeRef(IntType, StringType, UnionType),
		function_number,
		same_type,
		specialize,
	../../src/syntax: Diagnostic
	input: check, parse
	test: TestSuite


private pure func is_function(target: CallTarget, expected: Int) -> Bool:
	match target:
		UserFunction(id):
			function_number(id) == expected
		RuntimeFunction(_):
			False


-- Minimal parsed/checked fixtures preserve the seals. Tests invoke and inspect
-- lowering itself; neither C emission nor the CLI participates in this oracle.
private pure func fixture(source: String) -> Result[LoweredProgram, Diagnostic]:
	lexed ?= lex(source)
	parsed ?= parse(lexed)
	checked ?= check(parsed)
	specialize(checked).and_then(pure func(program): lower(program))


pure func test_reassignment_preserves_old_alias_and_call_result() -> Bool:
	match fixture(
		"pure func identity(value: Int) -> Int:\n\tvalue\npure func preserve() -> Int:\n\toriginal = 1\n\tvar current = original\n\tcurrent = identity(42)\n\toriginal\nfunc main() -> Int:\n\tpreserve()\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, preserve, _]:
					match preserve.definitions:
						[original, replacement, call]:
							match original.operation:
								IntegerValue(1):
									match replacement.operation:
										IntegerValue(42):
											match call.operation:
												CallValue(target, [argument]):
													match preserve.tail:
														ReturnValue(id):
															(
																value_number(original.id) == 0
																and value_number(
																	replacement.id,
																) == 1
																and value_number(call.id) == 2
																and value_number(argument) == 1
																and value_number(id) == 0
																and is_function(target.target, 0)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_self_assignment_aliases_the_same_value() -> Bool:
	match fixture("func main() -> Int:\n\tvar value = 42\n\tvalue = value\n\tvalue\n"):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.definitions:
						[value]:
							match function.tail:
								ReturnValue(id):
									value_number(value.id) == 0 and value_number(id) == 0
								_:
									False
						_:
							False
				_:
					False


pure func test_unused_calls_remain_in_source_order() -> Bool:
	match fixture(
		"func first() -> Int:\n\t1\nfunc second() -> Int:\n\t2\nfunc main() -> Int:\n\tunused = first()\n\tvar current = second()\n\tcurrent = second()\n\t0\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, _, function]:
					match function.definitions:
						[first, second, third, result]:
							match first.operation:
								CallValue(first, []):
									match second.operation:
										CallValue(second, []):
											match third.operation:
												CallValue(third, []):
													(
														is_function(first.target, 0)
														and is_function(second.target, 1)
														and is_function(third.target, 1)
														and value_number(result.id) == 3
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_parameter_shadowing_reads_the_original_value() -> Bool:
	match fixture(
		"pure func copy(value: Int) -> Int:\n\tvar value = value\n\told = value\n\tvalue = 42\n\told\nfunc main() -> Int:\n\tcopy(1)\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[copy, _]:
					match copy.definitions:
						[parameter, replacement]:
							match parameter.operation:
								ParameterValue(_):
									match copy.tail:
										ReturnValue(id):
											(
												value_number(id) == 0
												and value_number(replacement.id) == 1
												and parameter.span.start == 15
												and parameter.span.end == 20
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_match_branches_share_the_function_value_allocator() -> Bool:
	match fixture(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func unwrap(value: Value) -> Int:\n\tlocal = value\n\tmatch local:\n\t\tEmpty: 0\n\t\tNumber(local): local\nfunc main() -> Int:\n\t0\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[unwrap, _]:
					match unwrap.definitions:
						[parameter]:
							match unwrap.tail:
								MatchValue(matched):
									match matched.arms:
										[first, second]:
											match first.body.definitions:
												[literal]:
													match second.body.definitions:
														[projection]:
															match projection.operation:
																PayloadValue(source):
																	(
																		value_number(
																			parameter.id,
																		) == 0
																		and value_number(
																			matched.scrutinee,
																		) == 0
																		and value_number(
																			literal.id,
																		) == 1
																		and value_number(
																			projection.id,
																		) == 2
																		and value_number(
																			source,
																		) == 0
																		and value_number(
																			second.body.result,
																		) == 2
																	)
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_constructor_and_call_keep_each_intermediate_type_and_span() -> Bool:
	match fixture(
		"fixed union Value:\n\tNumber(Int)\npure func unwrap(value: Value) -> Int:\n\tmatch value:\n\t\tNumber(number): number\nfunc main() -> Int:\n\tNumber(42).unwrap()\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, main]:
					match main.definitions:
						[literal, construction, call]:
							match construction.value_type:
								UnionType(_):
									match construction.operation:
										ConstructValue(_, argument):
											match call.operation:
												CallValue(_, [receiver]):
													(
														same_type(literal.value_type, IntType)
														and same_type(call.value_type, IntType)
														and value_number(argument) == 0
														and value_number(receiver) == 1
														and literal.span.start == 138
														and literal.span.end == 140
														and construction.span.start == 131
														and construction.span.end == 137
														and call.span.start == 142
														and call.span.end == 148
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_full_width_alias_retains_the_original_value() -> Bool:
	match fixture(
		"func main() -> Int:\n\tvar current = -9223372036854775808\n\toriginal = current\n\tcurrent = 9223372036854775807\n\toriginal\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.definitions:
						[original, replacement]:
							match original.operation:
								IntegerValue(-9223372036854775808):
									match replacement.operation:
										IntegerValue(9223372036854775807):
											match function.tail:
												ReturnValue(id):
													(
														value_number(
															id,
														) == value_number(original.id)
														and value_number(
															replacement.id,
														) != value_number(original.id)
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_match_calls_stay_inside_their_selected_branches() -> Bool:
	match fixture(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\nfunc choose() -> Value:\n\tNumber(42)\nfunc empty_arm() -> Int:\n\t7\nfunc selected(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tmatch choose():\n\t\tEmpty: empty_arm()\n\t\tNumber(captured): selected(captured)\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, _, _, main]:
					match main.definitions:
						[scrutinee]:
							match scrutinee.operation:
								CallValue(choose, []):
									match main.tail:
										MatchValue(matched):
											match matched.arms:
												[empty, number]:
													match empty.body.definitions:
														[empty_value]:
															match empty_value.operation:
																CallValue(empty_call, []):
																	match number.body.definitions:
																		[payload, selected_value]:
																			match selected_value.operation:
																				CallValue(selected_call, [argument]):
																					(
																						is_function(
																							choose.target,
																							0,
																						)
																						and is_function(
																							empty_call.target,
																							1,
																						)
																						and is_function(
																							selected_call.target,
																							2,
																						)
																						and value_number(
																							argument,
																						) == value_number(
																							payload.id,
																						)
																						and value_number(
																							number.body.result,
																						) == value_number(
																							selected_value.id,
																						)
																					)
																				_:
																					False
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_block_arm_reassignment_preserves_payload_alias() -> Bool:
	prefix = "fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func identity(value: Int) -> Int:\n\tvalue\npure func inspect(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty: 0\n\t\tNumber(payload):\n\t\t\tvar current = payload\n\t\t\toriginal = current\n\t\t\tcurrent = identity("

	match fixture(prefix + "42)\n\t\t\toriginal\nfunc main() -> Int:\n\tinspect(Number(7))\n"):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, inspect, _]:
					match inspect.definitions:
						[parameter]:
							match inspect.tail:
								MatchValue(matched):
									match matched.arms:
										[_, number]:
											match number.body.definitions:
												[payload, replacement, call]:
													match payload.operation:
														PayloadValue(owner):
															match replacement.operation:
																IntegerValue(42):
																	match call.operation:
																		CallValue(target, [argument]):
																			(
																				value_number(
																					owner,
																				) == value_number(
																					parameter.id,
																				)
																				and value_number(
																					payload.id,
																				) == 2
																				and value_number(
																					replacement.id,
																				) == 3
																				and value_number(
																					call.id,
																				) == 4
																				and value_number(
																					argument,
																				) == 3
																				and value_number(
																					number.body.result,
																				) == 2
																				and is_function(
																					target.target,
																					0,
																				)
																				and same_type(
																					payload.value_type,
																					IntType,
																				)
																				and same_type(
																					replacement.value_type,
																					IntType,
																				)
																				and same_type(
																					call.value_type,
																					IntType,
																				)
																				and replacement.span.start == prefix.length()
																				and replacement.span.end == prefix.length() + 2
																				and call.span.start == prefix.length() - 9
																				and call.span.end == prefix.length() - 1
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_reassignment_does_not_change_sibling_outer_value() -> Bool:
	match fixture(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func inspect(value: Value) -> Int:\n\tvar current = 7\n\tmatch value:\n\t\tEmpty:\n\t\t\tcurrent = 42\n\t\t\tcurrent\n\t\tNumber(_):\n\t\t\toriginal = current\n\t\t\tcurrent = 1\n\t\t\toriginal\nfunc main() -> Int:\n\tinspect(Number(0))\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[inspect, _]:
					match inspect.definitions:
						[_, original]:
							match inspect.tail:
								MatchValue(matched):
									match matched.arms:
										[first, second]:
											match first.body.definitions:
												[first_replacement]:
													match second.body.definitions:
														[second_replacement]:
															(
																value_number(original.id) == 1
																and value_number(
																	first_replacement.id,
																) == 2
																and value_number(
																	second_replacement.id,
																) == 3
																and value_number(
																	first.body.result,
																) == 2
																and value_number(
																	second.body.result,
																) == 1
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_unused_calls_remain_ordered_inside_the_branch() -> Bool:
	match fixture(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\nfunc first() -> Int:\n\t1\nfunc second() -> Int:\n\t2\nfunc inspect(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty:\n\t\t\tunused = first()\n\t\t\tvar current = second()\n\t\t\tcurrent = first()\n\t\t\tcurrent\n\t\tNumber(payload): payload\nfunc main() -> Int:\n\tinspect(Empty)\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, _, inspect, _]:
					match inspect.definitions:
						[parameter]:
							match inspect.tail:
								MatchValue(matched):
									match matched.arms:
										[empty, number]:
											match empty.body.definitions:
												[first, second, third]:
													match first.operation:
														CallValue(first_call, []):
															match second.operation:
																CallValue(second_call, []):
																	match third.operation:
																		CallValue(third_call, []):
																			(
																				is_function(
																					first_call.target,
																					0,
																				)
																				and is_function(
																					second_call.target,
																					1,
																				)
																				and is_function(
																					third_call.target,
																					0,
																				)
																				and value_number(
																					parameter.id,
																				) == 0
																				and value_number(
																					first.id,
																				) == 1
																				and value_number(
																					second.id,
																				) == 2
																				and value_number(
																					third.id,
																				) == 3
																				and value_number(
																					empty.body.result,
																				) == 3
																				and number.body.definitions.length() == 1
																				and value_number(
																					number.body.result,
																				) == 4
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_managed_alias_uses_original_value_after_replacement() -> Bool:
	match fixture(
		"func main() -> Int:\n\tvar current = 7.to_string()\n\toriginal = current\n\tcurrent = 42.to_string()\n\toriginal.length()\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.definitions:
						[_, original, _, replacement, length]:
							match length.operation:
								CallValue(call, [argument]):
									match call.target:
										RuntimeFunction(StringLength):
											(
												same_type(original.value_type, StringType)
												and same_type(replacement.value_type, StringType)
												and value_number(
													argument,
												) == value_number(original.id)
												and value_number(
													argument,
												) != value_number(replacement.id)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_managed_self_assignment_creates_no_new_value() -> Bool:
	match fixture(
		"func main() -> Int:\n\tvar value = 7.to_string()\n\tvalue = value\n\tvalue.length()\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.definitions:
						[literal, string, length]:
							match string.operation:
								CallValue(_, [number]):
									match length.operation:
										CallValue(call, [receiver]):
											match call.target:
												RuntimeFunction(StringLength):
													match function.tail:
														ReturnValue(result):
															(
																value_number(literal.id) == 0
																and value_number(number) == 0
																and value_number(string.id) == 1
																and same_type(
																	string.value_type,
																	StringType,
																)
																and value_number(receiver) == 1
																and value_number(length.id) == 2
																and value_number(result) == 2
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_two_managed_aliases_share_the_computed_value() -> Bool:
	match fixture(
		"func main() -> Int:\n\tvalue = 7.to_string()\n\tfirst = value\n\tsecond = first\n\tunused = first.length()\n\tsecond.length()\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.definitions:
						[_, string, first_length, second_length]:
							match first_length.operation:
								CallValue(_, [first_receiver]):
									match second_length.operation:
										CallValue(_, [second_receiver]):
											match function.tail:
												ReturnValue(result):
													(
														value_number(string.id) == 1
														and same_type(string.value_type, StringType)
														and value_number(first_receiver) == 1
														and value_number(second_receiver) == 1
														and value_number(first_length.id) == 2
														and value_number(second_length.id) == 3
														and value_number(result) == 3
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_string_arm_computations_remain_branch_local() -> Bool:
	match fixture(
		"fixed union Choice:\n\tFirst\n\tSecond\npure func choose(choice: Choice) -> String:\n\tmatch choice:\n\t\tFirst: 7.to_string()\n\t\tSecond: 42.to_string()\nfunc main() -> Int:\n\tchoose(Second).length()\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[choose, _]:
					match choose.definitions:
						[parameter]:
							match choose.tail:
								MatchValue(matched):
									match matched.arms:
										[first, second]:
											match first.body.definitions:
												[first_number, first_string]:
													match second.body.definitions:
														[second_number, second_string]:
															match first_string.operation:
																CallValue(_, [first_argument]):
																	match second_string.operation:
																		CallValue(_, [second_argument]):
																			(
																				value_number(
																					parameter.id,
																				) == 0
																				and value_number(
																					first_number.id,
																				) == 1
																				and value_number(
																					first_string.id,
																				) == 2
																				and value_number(
																					first_argument,
																				) == 1
																				and value_number(
																					first.body.result,
																				) == 2
																				and value_number(
																					second_number.id,
																				) == 3
																				and value_number(
																					second_string.id,
																				) == 4
																				and value_number(
																					second_argument,
																				) == 3
																				and value_number(
																					second.body.result,
																				) == 4
																				and same_type(
																					first_string.value_type,
																					StringType,
																				)
																				and same_type(
																					second_string.value_type,
																					StringType,
																				)
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_string_alias_survives_a_replacement() -> Bool:
	match fixture(
		"fixed union Choice:\n\tFirst\n\tSecond\npure func choose(choice: Choice) -> String:\n\tmatch choice:\n\t\tFirst:\n\t\t\tunused = 99.to_string()\n\t\t\tvar current = 7.to_string()\n\t\t\toriginal = current\n\t\t\tcurrent = 42.to_string()\n\t\t\toriginal\n\t\tSecond: 42.to_string()\nfunc main() -> Int:\n\tchoose(First).length()\n",
	):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[choose, _]:
					match choose.tail:
						MatchValue(matched):
							match matched.arms:
								[first, _]:
									match first.body.definitions:
										[_, unused, _, original, _, replacement]:
											(
												value_number(unused.id) == 2
												and value_number(original.id) == 4
												and value_number(replacement.id) == 6
												and value_number(first.body.result) == 4
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


tests: TestSuite = {
