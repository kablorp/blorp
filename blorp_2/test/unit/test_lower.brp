import:
	../../src/source: module_source, root_module_id
	../../src/lex: lex
	../../src/lower:
		LoweredExit(ReturnValue),
		LoweredProgram, LoweredFunction,
		LoweredTail(ExitValue, MatchValue),
		ValueOperation(
			ParameterValue, IntegerValue, VariantValue, CallValue, ConstructValue, PayloadValue,
		),
		lower,
		lowered_functions,
		value_number,
	../../src/builtins as Builtins: RuntimeOperation(StringLength)
	../../src/specialize:
		CallTarget(UserFunction, RuntimeFunction), FunctionInstanceId,
		TypeRef(IntType, StringType, UnionType),
		function_number,
		same_type,
		specialize,
	../../src/syntax: Diagnostic
	input: check, parse, setup_diagnostic
	module_input: ModuleInput, PRIMITIVE_BASE, INTEGER_OPERATIONS, STRING_OPERATIONS, parse_modules_with_base
	test: TestSuite


private pure func returns_value(exit: LoweredExit, expected: Int) -> Bool:
	match exit:
		ReturnValue(id):
			value_number(id) == expected
		_:
			False


private pure func is_function(target: CallTarget, expected: Int) -> Bool:
	match target:
		UserFunction(id):
			function_number(id) == expected
		RuntimeFunction(_):
			False


private pure func is_string_length(functions: List[LoweredFunction], id: FunctionInstanceId) -> Bool:
	match functions.get(function_number(id)):
		Some(function):
			match (function.signature.parameters, function.definitions, function.tail):
				([StringType], [parameter, result], ExitValue(ReturnValue(returned))):
					match result.operation:
						CallValue(call, [argument]):
							match call.target:
								RuntimeFunction(Builtins.StringLength):
									(
										same_type(function.signature.return_type, IntType)
										and value_number(argument) == value_number(parameter.id)
										and value_number(returned) == value_number(result.id)
									)
								_:
									False
						_:
							False
				_:
					False
		None:
			False


-- Minimal parsed/checked fixtures preserve the seals. Tests invoke and inspect
-- lowering itself; neither C emission nor the CLI participates in this oracle.
private pure func fixture(source: String) -> Result[LoweredProgram, Diagnostic]:
	lexed ?= lex(module_source(root_module_id()), source)
	parsed ?= parse(lexed)
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialize(checked).and_then(pure func(program): lower(program))


private pure func fixture_modules(inputs: List[ModuleInput]) -> Result[LoweredProgram, Diagnostic]:
	parsed ?= parse_modules_with_base(inputs, PRIMITIVE_BASE)
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialize(checked).and_then(pure func(program): lower(program))


pure func test_reassignment_preserves_old_alias_and_call_result() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func preserve() -> Int:
		|	original = 1
		|	var current = original
		|	current = identity(42)
		|	original
		|func main() -> Int:
		|	preserve()
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, preserve, _]:
					match preserve.definitions:
						[original, replacement, call]:
							match original.operation:
								IntegerValue(1):
									match replacement.operation:
										IntegerValue(42):
											match call.operation:
												CallValue(target, [argument]):
													match preserve.tail:
														ExitValue(ReturnValue(id)):
															(
																value_number(original.id) == 0
																and value_number(
																	replacement.id,
																) == 1
																and value_number(call.id) == 2
																and value_number(argument) == 1
																and value_number(id) == 0
																and is_function(target.target, 2)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_self_assignment_aliases_the_same_value() -> Bool:
	source: String =
		|func main() -> Int:
		|	var value = 42
		|	value = value
		|	value
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.definitions:
						[value]:
							match function.tail:
								ExitValue(ReturnValue(id)):
									value_number(value.id) == 0 and value_number(id) == 0
								_:
									False
						_:
							False
				_:
					False


pure func test_unused_calls_remain_in_source_order() -> Bool:
	source: String =
		|func first() -> Int:
		|	1
		|func second() -> Int:
		|	2
		|func main() -> Int:
		|	unused = first()
		|	var current = second()
		|	current = second()
		|	0
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function, _, _]:
					match function.definitions:
						[first, second, third, result]:
							match first.operation:
								CallValue(first, []):
									match second.operation:
										CallValue(second, []):
											match third.operation:
												CallValue(third, []):
													(
														is_function(first.target, 1)
														and is_function(second.target, 2)
														and is_function(third.target, 2)
														and value_number(result.id) == 3
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_parameter_shadowing_reads_the_original_value() -> Bool:
	source: String =
		|pure func copy(value: Int) -> Int:
		|	var value = value
		|	old = value
		|	value = 42
		|	old
		|func main() -> Int:
		|	copy(1)
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, copy]:
					match copy.definitions:
						[parameter, replacement]:
							match parameter.operation:
								ParameterValue(_):
									match copy.tail:
										ExitValue(ReturnValue(id)):
											(
												value_number(id) == 0
												and value_number(replacement.id) == 1
												and parameter.span.start == 15
												and parameter.span.end == 20
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_match_branches_share_the_function_value_allocator() -> Bool:
	source: String =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|pure func unwrap(value: Value) -> Int:
		|	local = value
		|	match local:
		|		Empty: 0
		|		Number(local): local
		|func main() -> Int:
		|	unwrap(Number(0))
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, unwrap]:
					match unwrap.definitions:
						[parameter]:
							match unwrap.tail:
								MatchValue(matched):
									match matched.arms:
										[first, second]:
											match first.body.definitions:
												[literal]:
													match second.body.definitions:
														[projection]:
															match projection.operation:
																PayloadValue(_, source):
																	(
																		value_number(
																			parameter.id,
																		) == 0
																		and value_number(
																			matched.scrutinee,
																		) == 0
																		and value_number(
																			literal.id,
																		) == 1
																		and value_number(
																			projection.id,
																		) == 2
																		and value_number(
																			source,
																		) == 0
																		and returns_value(
																			second.body.exit,
																			2,
																		)
																	)
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_constructor_and_call_keep_each_intermediate_type_and_span() -> Bool:
	source: String =
		|fixed union Value:
		|	Number(Int)
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Number(number): number
		|func main() -> Int:
		|	Number(42).unwrap()
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[main, _]:
					match main.definitions:
						[literal, construction, call]:
							match construction.value_type:
								UnionType(_):
									match construction.operation:
										ConstructValue(_, [argument]):
											match call.operation:
												CallValue(_, [receiver]):
													(
														same_type(literal.value_type, IntType)
														and same_type(call.value_type, IntType)
														and value_number(argument) == 0
														and value_number(receiver) == 1
														and literal.span.start == 138
														and literal.span.end == 140
														and construction.span.start == 131
														and construction.span.end == 137
														and call.span.start == 142
														and call.span.end == 148
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_full_width_alias_retains_the_original_value() -> Bool:
	source: String =
		|func main() -> Int:
		|	var current = -9223372036854775808
		|	original = current
		|	current = 9223372036854775807
		|	original
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.definitions:
						[original, replacement]:
							match original.operation:
								IntegerValue(-9223372036854775808):
									match replacement.operation:
										IntegerValue(9223372036854775807):
											match function.tail:
												ExitValue(ReturnValue(id)):
													(
														value_number(
															id,
														) == value_number(original.id)
														and value_number(
															replacement.id,
														) != value_number(original.id)
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_match_calls_stay_inside_their_selected_branches() -> Bool:
	source: String =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|func choose() -> Value:
		|	Number(42)
		|func empty_arm() -> Int:
		|	7
		|func selected(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	match choose():
		|		Empty: empty_arm()
		|		Number(captured): selected(captured)
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[main, _, _, _]:
					match main.definitions:
						[scrutinee]:
							match scrutinee.operation:
								CallValue(choose, []):
									match main.tail:
										MatchValue(matched):
											match matched.arms:
												[empty, number]:
													match empty.body.definitions:
														[empty_value]:
															match empty_value.operation:
																CallValue(empty_call, []):
																	match number.body.definitions:
																		[payload, selected_value]:
																			match selected_value.operation:
																				CallValue(selected_call, [argument]):
																					(
																						is_function(
																							choose.target,
																							1,
																						)
																						and is_function(
																							empty_call.target,
																							2,
																						)
																						and is_function(
																							selected_call.target,
																							3,
																						)
																						and value_number(
																							argument,
																						) == value_number(
																							payload.id,
																						)
																						and returns_value(
																							number.body.exit,
																							value_number(
																								selected_value.id,
																							),
																						)
																					)
																				_:
																					False
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_block_arm_reassignment_preserves_payload_alias() -> Bool:
	prefix =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func inspect(value: Value) -> Int:
		|	match value:
		|		Empty: 0
		|		Number(payload):
		|			var current = payload
		|			original = current
		|			current = identity(

	match fixture(prefix + "42)\n\t\t\toriginal\nfunc main() -> Int:\n\tinspect(Number(7))\n"):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, inspect, _]:
					match inspect.definitions:
						[parameter]:
							match inspect.tail:
								MatchValue(matched):
									match matched.arms:
										[_, number]:
											match number.body.definitions:
												[payload, replacement, call]:
													match payload.operation:
														PayloadValue(_, owner):
															match replacement.operation:
																IntegerValue(42):
																	match call.operation:
																		CallValue(target, [argument]):
																			(
																				value_number(
																					owner,
																				) == value_number(
																					parameter.id,
																				)
																				and value_number(
																					payload.id,
																				) == 2
																				and value_number(
																					replacement.id,
																				) == 3
																				and value_number(
																					call.id,
																				) == 4
																				and value_number(
																					argument,
																				) == 3
																				and returns_value(
																					number.body.exit,
																					2,
																				)
																				and is_function(
																					target.target,
																					2,
																				)
																				and same_type(
																					payload.value_type,
																					IntType,
																				)
																				and same_type(
																					replacement.value_type,
																					IntType,
																				)
																				and same_type(
																					call.value_type,
																					IntType,
																				)
																				and replacement.span.start == prefix.length()
																				and replacement.span.end == prefix.length() + 2
																				and call.span.start == prefix.length() - 9
																				and call.span.end == prefix.length() - 1
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_reassignment_does_not_change_sibling_outer_value() -> Bool:
	source: String =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|pure func inspect(value: Value) -> Int:
		|	var current = 7
		|	match value:
		|		Empty:
		|			current = 42
		|			current
		|		Number(_):
		|			original = current
		|			current = 1
		|			original
		|func main() -> Int:
		|	inspect(Number(0))
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, inspect]:
					match inspect.definitions:
						[_, original]:
							match inspect.tail:
								MatchValue(matched):
									match matched.arms:
										[first, second]:
											match first.body.definitions:
												[first_replacement]:
													match second.body.definitions:
														[second_replacement]:
															(
																value_number(original.id) == 1
																and value_number(
																	first_replacement.id,
																) == 2
																and value_number(
																	second_replacement.id,
																) == 3
																and returns_value(
																	first.body.exit,
																	2,
																)
																and returns_value(
																	second.body.exit,
																	1,
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_unused_calls_remain_ordered_inside_the_branch() -> Bool:
	source: String =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|func first() -> Int:
		|	1
		|func second() -> Int:
		|	2
		|func inspect(value: Value) -> Int:
		|	match value:
		|		Empty:
		|			unused = first()
		|			var current = second()
		|			current = first()
		|			current
		|		Number(payload): payload
		|func main() -> Int:
		|	inspect(Empty)
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, inspect, _, _]:
					match inspect.definitions:
						[parameter]:
							match inspect.tail:
								MatchValue(matched):
									match matched.arms:
										[empty, number]:
											match empty.body.definitions:
												[first, second, third]:
													match first.operation:
														CallValue(first_call, []):
															match second.operation:
																CallValue(second_call, []):
																	match third.operation:
																		CallValue(third_call, []):
																			(
																				is_function(
																					first_call.target,
																					2,
																				)
																				and is_function(
																					second_call.target,
																					3,
																				)
																				and is_function(
																					third_call.target,
																					2,
																				)
																				and value_number(
																					parameter.id,
																				) == 0
																				and value_number(
																					first.id,
																				) == 1
																				and value_number(
																					second.id,
																				) == 2
																				and value_number(
																					third.id,
																				) == 3
																				and returns_value(
																					empty.body.exit,
																					3,
																				)
																				and number.body.definitions.length() == 1
																				and returns_value(
																					number.body.exit,
																					4,
																				)
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_managed_alias_uses_original_value_after_replacement() -> Bool:
	source: String =
		|import:
		|	int: Int
		|	string: String
		|func main() -> Int:
		|	var current = 7.to_string()
		|	original = current
		|	current = 42.to_string()
		|	original.length()
		|

	match fixture_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function, _, _]:
					match function.definitions:
						[_, original, _, replacement, length]:
							match length.operation:
								CallValue(call, [argument]):
									match call.target:
										UserFunction(id):
											(
												is_string_length(lowered_functions(program).functions, id)
												and same_type(original.value_type, StringType)
												and same_type(replacement.value_type, StringType)
												and value_number(
													argument,
												) == value_number(original.id)
												and value_number(
													argument,
												) != value_number(replacement.id)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_managed_self_assignment_creates_no_new_value() -> Bool:
	source: String =
		|import:
		|	int: Int
		|	string: String
		|func main() -> Int:
		|	var value = 7.to_string()
		|	value = value
		|	value.length()
		|

	match fixture_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function, _, _]:
					match function.definitions:
						[literal, string, length]:
							match string.operation:
								CallValue(_, [number]):
									match length.operation:
										CallValue(call, [receiver]):
											match call.target:
												UserFunction(id):
													match function.tail:
														ExitValue(ReturnValue(result)):
															(
																is_string_length(lowered_functions(program).functions, id)
															and value_number(literal.id) == 0
																and value_number(number) == 0
																and value_number(string.id) == 1
																and same_type(
																	string.value_type,
																	StringType,
																)
																and value_number(receiver) == 1
																and value_number(length.id) == 2
																and value_number(result) == 2
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_two_managed_aliases_share_the_computed_value() -> Bool:
	source: String =
		|import:
		|	int: Int
		|	string: String
		|func main() -> Int:
		|	value = 7.to_string()
		|	first = value
		|	second = first
		|	unused = first.length()
		|	second.length()
		|

	match fixture_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function, _, _]:
					match function.definitions:
						[_, string, first_length, second_length]:
							match first_length.operation:
								CallValue(_, [first_receiver]):
									match second_length.operation:
										CallValue(_, [second_receiver]):
											match function.tail:
												ExitValue(ReturnValue(result)):
													(
														value_number(string.id) == 1
														and same_type(string.value_type, StringType)
														and value_number(first_receiver) == 1
														and value_number(second_receiver) == 1
														and value_number(first_length.id) == 2
														and value_number(second_length.id) == 3
														and value_number(result) == 3
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_string_arm_computations_remain_branch_local() -> Bool:
	source: String =
		|import:
		|	int: Int
		|	string: String
		|fixed union Choice:
		|	First
		|	Second
		|pure func choose(choice: Choice) -> String:
		|	match choice:
		|		First: 7.to_string()
		|		Second: 42.to_string()
		|func main() -> Int:
		|	choose(Second).length()
		|

	match fixture_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, choose, _, _]:
					match choose.definitions:
						[parameter]:
							match choose.tail:
								MatchValue(matched):
									match matched.arms:
										[first, second]:
											match first.body.definitions:
												[first_number, first_string]:
													match second.body.definitions:
														[second_number, second_string]:
															match first_string.operation:
																CallValue(_, [first_argument]):
																	match second_string.operation:
																		CallValue(_, [second_argument]):
																			(
																				value_number(
																					parameter.id,
																				) == 0
																				and value_number(
																					first_number.id,
																				) == 1
																				and value_number(
																					first_string.id,
																				) == 2
																				and value_number(
																					first_argument,
																				) == 1
																				and returns_value(
																					first.body.exit,
																					2,
																				)
																				and value_number(
																					second_number.id,
																				) == 3
																				and value_number(
																					second_string.id,
																				) == 4
																				and value_number(
																					second_argument,
																				) == 3
																				and returns_value(
																					second.body.exit,
																					4,
																				)
																				and same_type(
																					first_string.value_type,
																					StringType,
																				)
																				and same_type(
																					second_string.value_type,
																					StringType,
																				)
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_string_alias_survives_a_replacement() -> Bool:
	source: String =
		|import:
		|	int: Int
		|	string: String
		|fixed union Choice:
		|	First
		|	Second
		|pure func choose(choice: Choice) -> String:
		|	match choice:
		|		First:
		|			unused = 99.to_string()
		|			var current = 7.to_string()
		|			original = current
		|			current = 42.to_string()
		|			original
		|		Second: 42.to_string()
		|func main() -> Int:
		|	choose(First).length()
		|

	match fixture_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, choose, _, _]:
					match choose.tail:
						MatchValue(matched):
							match matched.arms:
								[first, _]:
									match first.body.definitions:
										[_, unused, _, original, _, replacement]:
											(
												value_number(unused.id) == 2
												and value_number(original.id) == 4
												and value_number(replacement.id) == 6
												and returns_value(first.body.exit, 4)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


tests: TestSuite = {
	description = "Blorp 2 ordered value lowering",
	tests = [
		("arm String alias survives replacement", test_arm_string_alias_survives_a_replacement),
		(
			"String computations stay inside distinct arms",
			test_string_arm_computations_remain_branch_local,
		),
		(
			"managed self assignment creates no value",
			test_managed_self_assignment_creates_no_new_value,
		),
		("managed aliases share computed value", test_two_managed_aliases_share_the_computed_value),
		(
			"managed alias retains original value identity",
			test_managed_alias_uses_original_value_after_replacement,
		),
		(
			"block arm reassignment preserves payload alias",
			test_block_arm_reassignment_preserves_payload_alias,
		),
		(
			"arm reassignment preserves sibling outer value",
			test_arm_reassignment_does_not_change_sibling_outer_value,
		),
		(
			"arm unused calls remain ordered inside branch",
			test_arm_unused_calls_remain_ordered_inside_the_branch,
		),
		(
			"full width alias retains original value",
			test_full_width_alias_retains_the_original_value,
		),
		(
			"match calls stay in selected branches",
			test_match_calls_stay_inside_their_selected_branches,
		),
		(
			"reassignment preserves old alias and call result",
			test_reassignment_preserves_old_alias_and_call_result,
		),
		("self assignment aliases the same value", test_self_assignment_aliases_the_same_value),
		("unused calls remain in source order", test_unused_calls_remain_in_source_order),
		(
			"parameter shadowing reads the original value",
			test_parameter_shadowing_reads_the_original_value,
		),
		(
			"match branches share function allocator",
			test_match_branches_share_the_function_value_allocator,
		),
		(
			"constructor and call keep types and spans",
			test_constructor_and_call_keep_each_intermediate_type_and_span,
		),
	]
}
