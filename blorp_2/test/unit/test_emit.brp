import:
	../../src/check: check
	../../src/emit: emit
	../../src/lex: lex
	../../src/lower: lower
	../../src/parse: parse
	../../src/syntax: Diagnostic
	result: get_or
	test: TestSuite


pure func test_compact_c_from_ordered_program() -> Bool:
	emitted(
		"func main() -> Int:\n\t0\n",
	).get_or(
		"",
	) == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_0();}\n"


private pure func emits_literal(spelling: String, expected: String) -> Result[Bool, Diagnostic]:
	lexed ?= lex("func main() -> Int:\n\t" + spelling + "\n")
	parsed ?= parse(lexed)
	checked ?= check(parsed)
	lowered ?= lower(checked)
	Ok(
		emit(
			lowered,
		).get_or(
			"",
		) == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=" + expected + ";(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_0();}\n",
	)


pure func test_portable_signed_c_literals() -> Bool:
	(
		emits_literal("-42", "(-INT64_C(42))").get_or(False)
		and emits_literal("-0", "INT64_C(0)").get_or(False)
		and emits_literal("9223372036854775807", "INT64_C(9223372036854775807)").get_or(False)
		and emits_literal("-9223372036854775808", "INT64_MIN").get_or(False)
	)


private pure func emits_nominal_unions() -> Result[Bool, Diagnostic]:
	lexed ?= lex(
		"fixed union Choice:\n\tFirst\n\tSecond\nfixed union Other:\n\tFirst\n\tSecond\npure func unused(value: Choice) -> Other:\n\tSecond\nfunc main() -> Int:\n\t0\n",
	)
	parsed ?= parse(lexed)
	checked ?= check(parsed)
	lowered ?= lower(checked)
	Ok(
		emit(
			lowered,
		).get_or(
			"",
		) == "#include <stdint.h>\nenum blorp_u_0{blorp_v_0_0,blorp_v_0_1};enum blorp_u_1{blorp_v_1_0,blorp_v_1_1};enum blorp_u_1 blorp_f_0(enum blorp_u_0 blorp_p_0);int64_t blorp_f_1(void);enum blorp_u_1 blorp_f_0(enum blorp_u_0 blorp_p_0){const enum blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const enum blorp_u_1 blorp_vl_1=blorp_v_1_1;(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_1(void){const int64_t blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_1();}\n",
	)


pure func test_nominal_enum_types_constructors_and_unused_parameters() -> Bool:
	emits_nominal_unions().get_or(False)


private pure func emitted(source: String) -> Result[String, Diagnostic]:
	input ?= lex(source)
	parsed ?= parse(input)
	checked ?= check(parsed)
	lowered ?= lower(checked)
	emit(lowered)


pure func test_payload_match_saves_scrutinee_and_extracts_inside_case() -> Bool:
	emitted(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func unwrap(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty: 0\n\t\tNumber(number): number\nfunc main() -> Int:\n\tunwrap(Number(42))\n",
	).get_or(
		"",
	) == "#include <stdint.h>\nenum blorp_tag_0{blorp_v_0_0,blorp_v_0_1};struct blorp_u_0{enum blorp_tag_0 tag;int64_t payload;};int64_t blorp_f_0(struct blorp_u_0 blorp_p_0);int64_t blorp_f_1(void);int64_t blorp_f_0(struct blorp_u_0 blorp_p_0){const struct blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;switch(blorp_vl_0.tag){case blorp_v_0_0:{const int64_t blorp_vl_1=INT64_C(0);(void)blorp_vl_1;return blorp_vl_1;}case blorp_v_0_1:default:{const int64_t blorp_vl_2=blorp_vl_0.payload;(void)blorp_vl_2;return blorp_vl_2;}}}int64_t blorp_f_1(void){const int64_t blorp_vl_0=INT64_C(42);(void)blorp_vl_0;const struct blorp_u_0 blorp_vl_1=((struct blorp_u_0){.tag=blorp_v_0_1,.payload=blorp_vl_0});(void)blorp_vl_1;const int64_t blorp_vl_2=blorp_f_0(blorp_vl_1);(void)blorp_vl_2;return blorp_vl_2;}int main(void){return (int)blorp_f_1();}\n"


pure func test_scalar_whole_capture_saves_value_and_owns_default() -> Bool:
	match emitted(
		"fixed union Choice:\n\tFirst\n\tSecond\npure func copy(value: Choice) -> Choice:\n\tmatch value:\n\t\tcaptured: captured\nfunc main() -> Int:\n\t0\n",
	):
		Err(_):
			False
		Ok(code):
			code.contains((
					"const enum blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;"
					+ "switch(blorp_vl_0){default:{return blorp_vl_0;}}"
				))


tests: TestSuite = {
	description = "Blorp 2 C emission",
	tests = [
		(
			"payload match saves scrutinee and extracts inside case",
			test_payload_match_saves_scrutinee_and_extracts_inside_case,
		),
		(
			"scalar whole capture saves value and owns default",
			test_scalar_whole_capture_saves_value_and_owns_default,
		),
		(
			"nominal enums, constructors and unused parameter",
			test_nominal_enum_types_constructors_and_unused_parameters,
		),
		("compact C from ordered program", test_compact_c_from_ordered_program),
		("portable signed C literals", test_portable_signed_c_literals),
	]
}
