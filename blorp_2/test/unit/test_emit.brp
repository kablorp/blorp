import:
	../../src/check:
		CallTarget(RuntimeFunction, UserFunction),
		ParameterShape(NoParameter, OneParameter),
		TypeRef(IntType, StringType),
	../../src/emit: emit
	../../src/lex: lex
	../../src/lower: ValueId, lower
	../../src/own:
		BorrowSource(ParameterBorrow, OwnerBorrow),
		OwnedArguments(UnmanagedArgument, BorrowedArgument),
		OwnedFunction,
		OwnedTail(UnmanagedReturn, OwnedReturn),
		OwnedValueOperation(ParameterDefinition, IntegerDefinition, CallDefinition),
		OwnershipOperation(DefineValue, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, BorrowedResult, OwnedResult),
		own,
		owner_id,
	../../src/prelude: RuntimeOperation(IntToString, StringLength)
	../../src/string_runtime: string_runtime
	../../src/syntax: Diagnostic, Purity(Pure)
	../../src/verify: verify
	input: check, parse
	ownership_inputs: InputIds, input_ids, span
	result: get_or
	test: TestSuite


pure func test_compact_c_from_ordered_program() -> Bool:
	emitted(
		"func main() -> Int:\n\t0\n",
	).get_or(
		"",
	) == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_0();}\n"


private pure func emits_literal(spelling: String, expected: String) -> Result[Bool, Diagnostic]:
	lexed ?= lex("func main() -> Int:\n\t" + spelling + "\n")
	parsed ?= parse(lexed)
	checked ?= check(parsed)
	lowered ?= lower(checked)
	owned ?= own(lowered)
	verified ?= verify(owned)
	Ok(
		emit(
			verified,
		).get_or(
			"",
		) == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=" + expected + ";(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_0();}\n",
	)


pure func test_portable_signed_c_literals() -> Bool:
	(
		emits_literal("-42", "(-INT64_C(42))").get_or(False)
		and emits_literal("-0", "INT64_C(0)").get_or(False)
		and emits_literal("9223372036854775807", "INT64_C(9223372036854775807)").get_or(False)
		and emits_literal("-9223372036854775808", "INT64_MIN").get_or(False)
	)


private pure func emits_nominal_unions() -> Result[Bool, Diagnostic]:
	lexed ?= lex(
		"fixed union Choice:\n\tFirst\n\tSecond\nfixed union Other:\n\tFirst\n\tSecond\npure func unused(value: Choice) -> Other:\n\tSecond\nfunc main() -> Int:\n\t0\n",
	)
	parsed ?= parse(lexed)
	checked ?= check(parsed)
	lowered ?= lower(checked)
	owned ?= own(lowered)
	verified ?= verify(owned)
	Ok(
		emit(
			verified,
		).get_or(
			"",
		) == "#include <stdint.h>\nenum blorp_u_0{blorp_v_0_0,blorp_v_0_1};enum blorp_u_1{blorp_v_1_0,blorp_v_1_1};enum blorp_u_1 blorp_f_0(enum blorp_u_0 blorp_p_0);int64_t blorp_f_1(void);enum blorp_u_1 blorp_f_0(enum blorp_u_0 blorp_p_0){const enum blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const enum blorp_u_1 blorp_vl_1=blorp_v_1_1;(void)blorp_vl_1;return blorp_vl_1;}int64_t blorp_f_1(void){const int64_t blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_1();}\n",
	)


pure func test_nominal_enum_types_constructors_and_unused_parameters() -> Bool:
	emits_nominal_unions().get_or(False)


private pure func emitted(source: String) -> Result[String, Diagnostic]:
	input ?= lex(source)
	parsed ?= parse(input)
	checked ?= check(parsed)
	lowered ?= lower(checked)
	owned ?= own(lowered)
	verified ?= verify(owned)
	emit(verified)


pure func test_payload_match_saves_scrutinee_and_extracts_inside_case() -> Bool:
	emitted(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func unwrap(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty: 0\n\t\tNumber(number): number\nfunc main() -> Int:\n\tunwrap(Number(42))\n",
	).get_or(
		"",
	) == "#include <stdint.h>\nenum blorp_tag_0{blorp_v_0_0,blorp_v_0_1};struct blorp_u_0{enum blorp_tag_0 tag;int64_t payload;};int64_t blorp_f_0(struct blorp_u_0 blorp_p_0);int64_t blorp_f_1(void);int64_t blorp_f_0(struct blorp_u_0 blorp_p_0){const struct blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;switch(blorp_vl_0.tag){case blorp_v_0_0:{const int64_t blorp_vl_1=INT64_C(0);(void)blorp_vl_1;return blorp_vl_1;}case blorp_v_0_1:default:{const int64_t blorp_vl_2=blorp_vl_0.payload;(void)blorp_vl_2;return blorp_vl_2;}}}int64_t blorp_f_1(void){const int64_t blorp_vl_0=INT64_C(42);(void)blorp_vl_0;const struct blorp_u_0 blorp_vl_1=((struct blorp_u_0){.tag=blorp_v_0_1,.payload=blorp_vl_0});(void)blorp_vl_1;const int64_t blorp_vl_2=blorp_f_0(blorp_vl_1);(void)blorp_vl_2;return blorp_vl_2;}int main(void){return (int)blorp_f_1();}\n"


pure func test_scalar_whole_capture_saves_value_and_owns_default() -> Bool:
	match emitted(
		"fixed union Choice:\n\tFirst\n\tSecond\npure func copy(value: Choice) -> Choice:\n\tmatch value:\n\t\tcaptured: captured\nfunc main() -> Int:\n\t0\n",
	):
		Err(_):
			False
		Ok(code):
			code.contains((
					"const enum blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;"
					+ "switch(blorp_vl_0){default:{return blorp_vl_0;}}"
				))


pure func test_block_arm_emits_ordered_locals_inside_its_case() -> Bool:
	match emitted(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func inspect(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty: 0\n\t\tNumber(payload):\n\t\t\tvar current = payload\n\t\t\toriginal = current\n\t\t\tcurrent = 42\n\t\t\toriginal\nfunc main() -> Int:\n\tinspect(Number(7))\n",
	):
		Err(_):
			False
		Ok(code):
			code.contains((
					"case blorp_v_0_1:default:{const int64_t blorp_vl_2=blorp_vl_0.payload;"
					+ "(void)blorp_vl_2;const int64_t blorp_vl_3=INT64_C(42);(void)blorp_vl_3;return "
					+ "blorp_vl_2;}}}"
				))


private pure func emit_owned(program: OwnershipProgram) -> Result[String, Diagnostic]:
	verified ?= verify(program)
	emit(verified)


-- The runtime prefix has separate native tests. Only that unrelated prefix is
-- reused here: each complete declarations/functions/main suffix below is an
-- independent oracle for the supplied operations, including unwanted ARC calls.
private pure func emits_owned_program(program: OwnershipProgram, expected: String) -> Bool:
	emit_owned(program).get_or("") == string_runtime() + expected


private pure func integer_definition(id: ValueId, value: Int, at: Int) -> OwnershipOperation:
	DefineValue({
		id = id,
		value_type = IntType,
		operation = IntegerDefinition(value),
		result = UnmanagedResult,
		span = span(at)
	})


private pure func string_definition(
	id: ValueId,
	argument: ValueId,
	owner: Int,
	at: Int,
) -> OwnershipOperation:
	DefineValue({
		id = id,
		value_type = StringType,
		operation = CallDefinition(
			{ target = RuntimeFunction(IntToString), span = span(at) },
			UnmanagedArgument(argument),
		),
		result = OwnedResult(owner_id(owner)),
		span = span(at)
	})


private pure func length_definition(
	id: ValueId,
	argument: ValueId,
	owner: Int,
	at: Int,
) -> OwnershipOperation:
	DefineValue({
		id = id,
		value_type = IntType,
		operation = CallDefinition(
			{ target = RuntimeFunction(StringLength), span = span(at) },
			BorrowedArgument({ value = argument, source = OwnerBorrow(owner_id(owner)) }),
		),
		result = UnmanagedResult,
		span = span(at)
	})


private pure func main_function(operations: List[OwnershipOperation], result: ValueId) -> OwnedFunction:
	{
		signature = { purity = Pure, parameters = NoParameter, return_type = IntType },
		operations = operations,
		tail = UnmanagedReturn(result)
	}


private pure func borrowed_identity(ids: InputIds) -> OwnedFunction:
	{
		signature = { purity = Pure, parameters = OneParameter(StringType), return_type = StringType },
		operations = [
			DefineValue({
				id = ids.first,
				value_type = StringType,
				operation = ParameterDefinition,
				result = BorrowedResult,
				span = span(10)
			}),
			AcquireOwner(owner_id(0), { value = ids.first, source = ParameterBorrow }, span(20)),
		],
		tail = OwnedReturn(ids.first, owner_id(0))
	}


pure func test_verified_operations_emit_allocation_borrow_then_drop() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			emits_owned_program(
				{
					unions = [], entrypoint = ids.entrypoint,
					functions = [main_function([
						integer_definition(ids.first, 7, 10),
						string_definition(ids.second, ids.first, 0, 20),
						length_definition(ids.third, ids.second, 0, 30),
						DropOwner(owner_id(0), span(40)),
					], ids.third)]
				},
				"int64_t blorp_f_0(void);int64_t blorp_f_0(void){"
				+ "const int64_t blorp_vl_0=INT64_C(7);(void)blorp_vl_0;"
				+ "struct blorp_string* const blorp_vl_1=blorp_int_to_string(blorp_vl_0);"
				+ "(void)blorp_vl_1;struct blorp_string* const blorp_owner_0=blorp_vl_1;"
				+ "(void)blorp_owner_0;const int64_t blorp_vl_2=blorp_string_length(blorp_vl_1);"
				+ "(void)blorp_vl_2;blorp_string_release(blorp_owner_0);return blorp_vl_2;}"
				+ "int main(void){return (int)blorp_f_0();}\n",
			)


pure func test_borrowed_parameter_return_emits_retain_and_owner_transfer() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			emits_owned_program(
				{
					unions = [], entrypoint = ids.entrypoint,
					functions = [
						main_function([integer_definition(ids.first, 0, 10)], ids.first),
						borrowed_identity(ids),
					]
				},
				"int64_t blorp_f_0(void);struct blorp_string* blorp_f_1(struct blorp_string* blorp_p_0);"
				+ "int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(0);"
				+ "(void)blorp_vl_0;return blorp_vl_0;}"
				+ "struct blorp_string* blorp_f_1(struct blorp_string* blorp_p_0){"
				+ "struct blorp_string* const blorp_vl_0=blorp_p_0;(void)blorp_vl_0;"
				+ "blorp_string_retain(blorp_vl_0);struct blorp_string* const "
				+ "blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;return blorp_owner_0;}"
				+ "int main(void){return (int)blorp_f_0();}\n",
			)


pure func test_acquire_emits_value_retain_before_old_owner_drop_and_transfer() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			helper: OwnedFunction = {
				signature = { purity = Pure, parameters = NoParameter, return_type = StringType },
				operations = [
					integer_definition(ids.first, 7, 10),
					string_definition(ids.second, ids.first, 0, 20),
					AcquireOwner(
						owner_id(1),
						{ value = ids.second, source = OwnerBorrow(owner_id(0)) },
						span(30),
					),
					DropOwner(owner_id(0), span(40)),
				],
				tail = OwnedReturn(ids.second, owner_id(1))
			}
			emits_owned_program(
				{
					unions = [], entrypoint = ids.entrypoint,
					functions = [main_function([integer_definition(ids.first, 0, 1)], ids.first), helper]
				},
				"int64_t blorp_f_0(void);struct blorp_string* blorp_f_1(void);"
				+ "int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(0);"
				+ "(void)blorp_vl_0;return blorp_vl_0;}"
				+ "struct blorp_string* blorp_f_1(void){const int64_t blorp_vl_0=INT64_C(7);"
				+ "(void)blorp_vl_0;struct blorp_string* const blorp_vl_1=blorp_int_to_string(blorp_vl_0);"
				+ "(void)blorp_vl_1;struct blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"
				+ "blorp_string_retain(blorp_vl_1);struct blorp_string* const blorp_owner_1=blorp_vl_1;"
				+ "(void)blorp_owner_1;blorp_string_release(blorp_owner_0);return blorp_owner_1;}"
				+ "int main(void){return (int)blorp_f_0();}\n",
			)


pure func test_independent_owner_drops_emit_each_exact_operand_once() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			emits_owned_program(
				{
					unions = [], entrypoint = ids.entrypoint,
					functions = [main_function([
						integer_definition(ids.first, 7, 10),
						string_definition(ids.second, ids.first, 0, 20),
						string_definition(ids.third, ids.first, 1, 30),
						DropOwner(owner_id(1), span(40)),
						DropOwner(owner_id(0), span(50)),
					], ids.first)]
				},
				"int64_t blorp_f_0(void);int64_t blorp_f_0(void){"
				+ "const int64_t blorp_vl_0=INT64_C(7);(void)blorp_vl_0;"
				+ "struct blorp_string* const blorp_vl_1=blorp_int_to_string(blorp_vl_0);"
				+ "(void)blorp_vl_1;struct blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"
				+ "struct blorp_string* const blorp_vl_2=blorp_int_to_string(blorp_vl_0);"
				+ "(void)blorp_vl_2;struct blorp_string* const blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;"
				+ "blorp_string_release(blorp_owner_1);blorp_string_release(blorp_owner_0);return blorp_vl_0;}"
				+ "int main(void){return (int)blorp_f_0();}\n",
			)


pure func test_unused_owned_result_emits_immediate_release_without_retain() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			emits_owned_program(
				{
					unions = [], entrypoint = ids.entrypoint,
					functions = [main_function([
						integer_definition(ids.first, 7, 10),
						string_definition(ids.second, ids.first, 0, 20),
						DropOwner(owner_id(0), span(30)),
					], ids.first)]
				},
				"int64_t blorp_f_0(void);int64_t blorp_f_0(void){"
				+ "const int64_t blorp_vl_0=INT64_C(7);(void)blorp_vl_0;"
				+ "struct blorp_string* const blorp_vl_1=blorp_int_to_string(blorp_vl_0);"
				+ "(void)blorp_vl_1;struct blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"
				+ "blorp_string_release(blorp_owner_0);return blorp_vl_0;}"
				+ "int main(void){return (int)blorp_f_0();}\n",
			)


pure func test_repeated_borrows_emit_no_redundant_retain_or_release() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			emits_owned_program(
				{
					unions = [], entrypoint = ids.entrypoint,
					functions = [main_function([
						integer_definition(ids.first, 7, 10),
						string_definition(ids.second, ids.first, 0, 20),
						length_definition(ids.third, ids.second, 0, 30),
						length_definition(ids.fourth, ids.second, 0, 40),
						DropOwner(owner_id(0), span(50)),
					], ids.fourth)]
				},
				"int64_t blorp_f_0(void);int64_t blorp_f_0(void){"
				+ "const int64_t blorp_vl_0=INT64_C(7);(void)blorp_vl_0;"
				+ "struct blorp_string* const blorp_vl_1=blorp_int_to_string(blorp_vl_0);"
				+ "(void)blorp_vl_1;struct blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"
				+ "const int64_t blorp_vl_2=blorp_string_length(blorp_vl_1);(void)blorp_vl_2;"
				+ "const int64_t blorp_vl_3=blorp_string_length(blorp_vl_1);(void)blorp_vl_3;"
				+ "blorp_string_release(blorp_owner_0);return blorp_vl_3;}"
				+ "int main(void){return (int)blorp_f_0();}\n",
			)


pure func test_user_call_establishes_result_owner_before_releasing_argument_owner() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			called = DefineValue({
				id = ids.third,
				value_type = StringType,
				operation = CallDefinition(
					{ target = UserFunction(ids.second_function), span = span(30) },
					BorrowedArgument({ value = ids.second, source = OwnerBorrow(owner_id(0)) }),
				),
				result = OwnedResult(owner_id(1)),
				span = span(30)
			})
			emits_owned_program(
				{
					unions = [], entrypoint = ids.entrypoint,
					functions = [
						main_function([
							integer_definition(ids.first, 7, 10),
							string_definition(ids.second, ids.first, 0, 20),
							called,
							DropOwner(owner_id(0), span(40)),
							length_definition(ids.fourth, ids.third, 1, 50),
							DropOwner(owner_id(1), span(60)),
						], ids.fourth),
						borrowed_identity(ids),
					]
				},
				"int64_t blorp_f_0(void);struct blorp_string* blorp_f_1(struct blorp_string* blorp_p_0);"
				+ "int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(7);(void)blorp_vl_0;"
				+ "struct blorp_string* const blorp_vl_1=blorp_int_to_string(blorp_vl_0);"
				+ "(void)blorp_vl_1;struct blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"
				+ "struct blorp_string* const blorp_vl_2=blorp_f_1(blorp_vl_1);(void)blorp_vl_2;"
				+ "struct blorp_string* const blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;"
				+ "blorp_string_release(blorp_owner_0);"
				+ "const int64_t blorp_vl_3=blorp_string_length(blorp_vl_2);(void)blorp_vl_3;"
				+ "blorp_string_release(blorp_owner_1);return blorp_vl_3;}"
				+ "struct blorp_string* blorp_f_1(struct blorp_string* blorp_p_0){"
				+ "struct blorp_string* const blorp_vl_0=blorp_p_0;(void)blorp_vl_0;"
				+ "blorp_string_retain(blorp_vl_0);struct blorp_string* const blorp_owner_0=blorp_vl_0;"
				+ "(void)blorp_owner_0;return blorp_owner_0;}"
				+ "int main(void){return (int)blorp_f_0();}\n",
			)


tests: TestSuite = {
	description = "Blorp 2 C emission",
	tests = [
		("acquire retains the value before old-owner drop and transfer", test_acquire_emits_value_retain_before_old_owner_drop_and_transfer),
		("independent drops release each exact owner once", test_independent_owner_drops_emit_each_exact_operand_once),
		("unused result releases immediately without retain", test_unused_owned_result_emits_immediate_release_without_retain),
		("repeated borrows introduce no redundant ARC calls", test_repeated_borrows_emit_no_redundant_retain_or_release),
		("user call establishes result owner before argument release", test_user_call_establishes_result_owner_before_releasing_argument_owner),
		(
			"verified operations emit allocation, borrow, drop",
			test_verified_operations_emit_allocation_borrow_then_drop,
		),
		(
			"borrowed return emits retain and owner transfer",
			test_borrowed_parameter_return_emits_retain_and_owner_transfer,
		),
		(
			"block arm emits ordered locals inside its case",
			test_block_arm_emits_ordered_locals_inside_its_case,
		),
		(
			"payload match saves scrutinee and extracts inside case",
			test_payload_match_saves_scrutinee_and_extracts_inside_case,
		),
		(
			"scalar whole capture saves value and owns default",
			test_scalar_whole_capture_saves_value_and_owns_default,
		),
		(
			"nominal enums, constructors and unused parameter",
			test_nominal_enum_types_constructors_and_unused_parameters,
		),
		("compact C from ordered program", test_compact_c_from_ordered_program),
		("portable signed C literals", test_portable_signed_c_literals),
	]
}
