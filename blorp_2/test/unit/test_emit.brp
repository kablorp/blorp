import:
	../../src/check: check
	../../src/emit: emit
	../../src/lex: lex
	../../src/parse: parse
	../../src/syntax: Diagnostic
	result: get_or
	test: TestSuite


pure func test_compact_c_from_checked_program() -> Bool:
	match lex("func main() -> Int:\n\t0\n"):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					match check(parsed):
						Err(_):
							False
						Ok(program):
							emit(
								program,
							).get_or(
								"",
							) == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){return INT64_C(0);}int main(void){return (int)blorp_f_0();}\n"


private pure func emits_literal(spelling: String, expected: String) -> Result[Bool, Diagnostic]:
	lexed ?= lex("func main() -> Int:\n\t" + spelling + "\n")
	parsed ?= parse(lexed)
	checked ?= check(parsed)
	Ok(
		emit(
			checked,
		).get_or(
			"",
		) == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){return " + expected + ";}int main(void){return (int)blorp_f_0();}\n",
	)


pure func test_portable_signed_c_literals() -> Bool:
	(
		emits_literal("-42", "(-INT64_C(42))").get_or(False)
		and emits_literal("-0", "INT64_C(0)").get_or(False)
		and emits_literal("9223372036854775807", "INT64_C(9223372036854775807)").get_or(False)
		and emits_literal("-9223372036854775808", "INT64_MIN").get_or(False)
	)


private pure func emits_nominal_unions() -> Result[Bool, Diagnostic]:
	lexed ?= lex(
		"fixed union Choice:\n\tFirst\n\tSecond\nfixed union Other:\n\tFirst\n\tSecond\npure func unused(value: Choice) -> Other:\n\tSecond\nfunc main() -> Int:\n\t0\n",
	)
	parsed ?= parse(lexed)
	checked ?= check(parsed)
	Ok(
		emit(
			checked,
		).get_or(
			"",
		) == "#include <stdint.h>\nenum blorp_u_0{blorp_v_0_0,blorp_v_0_1};enum blorp_u_1{blorp_v_1_0,blorp_v_1_1};enum blorp_u_1 blorp_f_0(enum blorp_u_0 blorp_p_0);int64_t blorp_f_1(void);enum blorp_u_1 blorp_f_0(enum blorp_u_0 blorp_p_0){(void)blorp_p_0;return blorp_v_1_1;}int64_t blorp_f_1(void){return INT64_C(0);}int main(void){return (int)blorp_f_1();}\n",
	)


pure func test_nominal_enum_types_constructors_and_unused_parameters() -> Bool:
	emits_nominal_unions().get_or(False)


private pure func emitted(source: String) -> Result[String, Diagnostic]:
	input ?= lex(source)
	parsed ?= parse(input)
	checked ?= check(parsed)
	emit(checked)


pure func test_payload_match_saves_scrutinee_and_extracts_inside_case() -> Bool:
	emitted(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func unwrap(value: Value) -> Int:\n\tmatch value:\n\t\tEmpty: 0\n\t\tNumber(number): number\nfunc main() -> Int:\n\tunwrap(Number(42))\n",
	).get_or(
		"",
	) == "#include <stdint.h>\nenum blorp_tag_0{blorp_v_0_0,blorp_v_0_1};struct blorp_u_0{enum blorp_tag_0 tag;int64_t payload;};int64_t blorp_f_0(struct blorp_u_0 blorp_p_0);int64_t blorp_f_1(void);int64_t blorp_f_0(struct blorp_u_0 blorp_p_0){(void)blorp_p_0;struct blorp_u_0 blorp_m_0=blorp_p_0;switch(blorp_m_0.tag){case blorp_v_0_0:{return INT64_C(0);}case blorp_v_0_1:default:{const int64_t blorp_b_1=blorp_m_0.payload;(void)blorp_b_1;return blorp_b_1;}}}int64_t blorp_f_1(void){return blorp_f_0(((struct blorp_u_0){.tag=blorp_v_0_1,.payload=INT64_C(42)}));}int main(void){return (int)blorp_f_1();}\n"


pure func test_scalar_whole_capture_saves_value_and_owns_default() -> Bool:
	match emitted(
		"fixed union Choice:\n\tFirst\n\tSecond\npure func copy(value: Choice) -> Choice:\n\tmatch value:\n\t\tcaptured: captured\nfunc main() -> Int:\n\t0\n",
	):
		Err(_):
			False
		Ok(code):
			code.contains((
					"enum blorp_u_0 blorp_m_0=blorp_p_0;switch(blorp_m_0){default:{const enum "
					+ "blorp_u_0 blorp_b_0=blorp_m_0;"
				)) and code.contains("return blorp_b_0;")


tests: TestSuite = {
	description = "Blorp 2 C emission",
	tests = [
		(
			"payload match saves scrutinee and extracts inside case",
			test_payload_match_saves_scrutinee_and_extracts_inside_case,
		),
		(
			"scalar whole capture saves value and owns default",
			test_scalar_whole_capture_saves_value_and_owns_default,
		),
		(
			"nominal enums, constructors and unused parameter",
			test_nominal_enum_types_constructors_and_unused_parameters,
		),
		("compact C from checked program", test_compact_c_from_checked_program),
		("portable signed C literals", test_portable_signed_c_literals),
	]
}
