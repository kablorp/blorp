import:
	../../src/check: check
	../../src/emit: emit
	../../src/lex: lex
	../../src/parse: parse
	test: TestSuite


pure func test_compact_c_from_checked_program() -> Bool:
	match lex("func main() -> Int:\n\t0\n"):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					match check(parsed):
						Err(_):
							False
						Ok(program):
							emit(
								program,
							) == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){return INT64_C(0);}int main(void){return (int)blorp_f_0();}\n"


tests: TestSuite = {
	description = "Blorp 2 C emission",
	tests = [("compact C from checked program", test_compact_c_from_checked_program)]
}
