import:
	../../src/check: check
	../../src/emit: emit
	../../src/syntax: ReturnExpression(ZeroExpression)
	test: TestSuite


pure func test_compact_c_from_checked_program() -> Bool:
	match (
		check({
			function_name = {
				spelling = "main",
				span = {
					start = 5,
					end = 9
				}
			},
			return_type = {
				spelling = "Int",
				span = {
					start = 15,
					end = 18
				}
			},
			body = ZeroExpression,
		})
	):
		Err(_):
			False
		Ok(program):
			emit(program) == "int main(void){return 0;}\n"


tests: TestSuite = {
	description = "Blorp 2 C emission",
	tests = [("compact C from checked program", test_compact_c_from_checked_program)]
}
