import:
	../../src/check: check
	../../src/emit: emit
	../../src/lex: lex
	../../src/parse: parse
	../../src/syntax: Diagnostic
	result: get_or
	test: TestSuite


pure func test_compact_c_from_checked_program() -> Bool:
	match lex("func main() -> Int:\n\t0\n"):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					match check(parsed):
						Err(_):
							False
						Ok(program):
							emit(
								program,
							) == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){return INT64_C(0);}int main(void){return (int)blorp_f_0();}\n"


private pure func emits_literal(spelling: String, expected: String) -> Result[Bool, Diagnostic]:
	lexed ?= lex("func main() -> Int:\n\t" + spelling + "\n")
	parsed ?= parse(lexed)
	checked ?= check(parsed)
	Ok(
		emit(
			checked,
		) == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){return " + expected + ";}int main(void){return (int)blorp_f_0();}\n",
	)


pure func test_portable_signed_c_literals() -> Bool:
	(
		emits_literal("-42", "(-INT64_C(42))").get_or(False)
		and emits_literal("-0", "INT64_C(0)").get_or(False)
		and emits_literal("9223372036854775807", "INT64_C(9223372036854775807)").get_or(False)
		and emits_literal("-9223372036854775808", "INT64_MIN").get_or(False)
	)


tests: TestSuite = {
	description = "Blorp 2 C emission",
	tests = [
		("compact C from checked program", test_compact_c_from_checked_program),
		("portable signed C literals", test_portable_signed_c_literals),
	]
}
