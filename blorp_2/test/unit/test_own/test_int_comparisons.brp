import:
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../int_comparison_inputs: lowered_comparison
	../module_input: TEST_BASE
	test: TestSuite


pure func test_comparison_parameters_and_result_remain_unmanaged() -> Bool:
	match lowered_comparison(TEST_BASE):
		Err(_): False
		Ok(program):
			contents = Lower.lowered_functions(program)
			match contents.functions:
				[_, function]:
					match Own.insert_function(function, contents.unions, []):
						Err(_): False
						Ok(owned):
							match (owned.operations, owned.tail):
								([Own.DefineValue(left), Own.DefineValue(right), Own.DefineValue(result)], Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(returned)))):
									match (left.result, right.result, result.result, result.operation):
										(Own.UnmanagedResult, Own.UnmanagedResult, Own.UnmanagedResult, Own.CallDefinition(_, [Own.UnmanagedArgument(first), Own.UnmanagedArgument(second)])):
											Lower.value_number(first) == 0 and Lower.value_number(second) == 1 and Lower.value_number(returned) == 2
										_: False
								_: False
				_: False


tests: TestSuite = {
	description = "Signed Int comparison ownership",
	tests = [("comparison needs no owner acquisition or retirement", test_comparison_parameters_and_result_remain_unmanaged)]
}
