import:
	../../../src/check/check: check
	../../../src/load/load: load_program
	../../../src/lower/lower: lower
	../../../src/namespace/builtins as Builtins
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/utils/source: label_text
	../list_update_inputs: owned_source
	bool: Bool methods
	int: Int methods
	io: print_error
	list: List methods
	result: Result methods
	string: String methods
	test: TestSuite


private LIBRARY_ROOT: String = "blorp_2/standard_library"

-- Calls every rewritten List function: each appends in a different loop shape.
private LOOPS_FIXTURE: String = "blorp_2/test/e2e/fixtures/list/library_loops.brp"


-- Every operation of a block and the blocks nested in it.
private pure func flatten(operations: List[Own.OwnershipOperation]) -> List[Own.OwnershipOperation]:
	var all: List[Own.OwnershipOperation] = []
	for operation in operations:
		all = all.append(operation)
		match operation:
			Own.ExecuteLoop(loop): all = all.concat(flatten_loop_block(loop.body))
			Own.ExecuteJoin(join):
				for arm in join.arms:
					all = all.concat(flatten(arm.operations))
					match arm.exit:
						Own.TransferLoop(_, tail): all = all.concat(flatten_loop_tail(tail))
						Own.Yield(_): void
			_: void
	all


private pure func flatten_loop_block(block: Own.OwnedLoopBlock) -> List[Own.OwnershipOperation]:
	flatten(block.operations).concat(flatten_loop_tail(block.tail))


private pure func flatten_loop_tail(tail: Own.OwnedLoopTail) -> List[Own.OwnershipOperation]:
	var all: List[Own.OwnershipOperation] = []
	match tail:
		Own.ExitLoop(_): void
		Own.MatchLoop(matched):
			for arm in matched.arms:
				all = all.concat(flatten_loop_block(arm.body))
	all


private pure func is_list_append(target: Concrete.CallTarget) -> Bool:
	match target:
		Concrete.RuntimeFunction(Builtins.ListAppend(_)): True
		_: False


-- One entry per selected call, True when it takes its first argument's last
-- owner. A call that passes a fresh occurrence acquired for it still consumes
-- that occurrence, but the accumulator keeps its own, so the update copies.
private pure func first_argument_consumed(
	operations: List[Own.OwnershipOperation],
	selected: pure (Concrete.CallTarget) -> Bool,
) -> List[Bool]:
	all = flatten(operations)
	var acquired: List[Int] = []
	for operation in all:
		match operation:
			Own.AcquireOwner(owner, _, _): acquired = acquired.append(Own.owner_number(owner))
			_: void
	var consumed: List[Bool] = []
	for operation in all:
		match operation:
			Own.DefineValue(definition):
				match definition.operation:
					Own.CallDefinition(target, arguments):
						if selected(target):
							match arguments:
								[Own.ConsumedArgument(_, owner), ..._]: consumed = consumed.append(acquired.contains(Own.owner_number(owner)).not())
								_: consumed = consumed.append(False)
					_: void
			_: void
	consumed


-- Passes only when the function has at least `expected` selected calls and
-- every one consumes its accumulator.
private pure func all_consumed(consumed: List[Bool], expected: Int) -> Bool:
	(consumed.length() >= expected).and(consumed.all(pure func(taken: Bool): taken))


private func library_program() -> Result[Own.OwnershipProgram, String]:
	loaded ?= load_program(LOOPS_FIXTURE, LIBRARY_ROOT).map_err(pure func(failure): failure.diagnostic.message)
	checked ?= check(loaded.program).map_err(pure func(_): LOOPS_FIXTURE + " does not check")
	lowered ?= Concrete.specialize(checked).and_then(lower).map_err(pure func(error): error.message)
	Own.own(lowered).map_err(pure func(error): error.message)


-- Library functions have one owned instance per element type, labelled by
-- module and name; the fixture instantiates each at least once.
private func library_function_appends(name: String, expected: Int) -> Bool:
	match library_program():
		Err(message):
			print_error(message)
			False
		Ok(program):
			var seen = 0
			var consumed: Bool = True
			for function in program.functions:
				if label_text(function.label).starts_with("list." + name):
					seen = seen + 1
					consumed = consumed.and(all_consumed(first_argument_consumed(function.operations, is_list_append), expected))
			found = (seen > 0).and(consumed)
			if found.not():
				print_error("list." + name + ": " + seen.to_string() + " instances, an append borrows its accumulator or too few appends")
			found


func test_map_loop_append_consumes_its_accumulator() -> Bool:
	library_function_appends("map", 1)


func test_filter_branch_append_consumes_its_accumulator() -> Bool:
	library_function_appends("filter", 1)


func test_copy_range_match_arm_append_consumes_its_accumulator() -> Bool:
	library_function_appends("copy_range", 1)


func test_reverse_match_arm_append_consumes_its_accumulator() -> Bool:
	library_function_appends("reverse", 1)


-- `joined + separator` and `+ value` call String `add` with the accumulator or
-- its fresh result; every other call in `join` reads Ints or borrows the List.
func test_join_concatenations_consume_their_accumulator() -> Bool:
	match library_program():
		Err(message):
			print_error(message)
			False
		Ok(program):
			var seen = 0
			var concatenations = 0
			for function in program.functions:
				if label_text(function.label).starts_with("list.join"):
					seen = seen + 1
					consumed = first_argument_consumed(function.operations, pure func(_): True)
					concatenations = concatenations + consumed.filter(pure func(taken: Bool): taken).length()
			found = (seen > 0).and(concatenations >= 2 * seen)
			if found.not():
				print_error("list.join: " + seen.to_string() + " instances take " + concatenations.to_string() + " accumulators")
			found


-- The oracle must see a failure: reading the old List after the append keeps
-- the append's input borrowed, as a saved snapshot of an accumulator would.
pure func test_snapshot_read_after_append_is_not_consumed() -> Bool:
	body: String =
		|pure func collect() -> Int:
		|    var values: List[Int] = []
		|    var seen = 0
		|    while less_than(length(values), 12):
		|        before = values
		|        values = append(values, 7)
		|        seen = length(before)
		|    seen
		|func main() -> Int:
		|    collect()
		|
	match owned_source(body):
		Err(_): False
		Ok(program):
			var appends: List[Bool] = []
			for function in program.functions:
				appends = appends.concat(first_argument_consumed(function.operations, is_list_append))
			(appends.length() == 1).and(appends.any(pure func(taken: Bool): taken).not())


tests: TestSuite = {
	description = "List library loops append to a consumed accumulator",
	tests = [
		("map appends in a for loop and consumes the accumulator", test_map_loop_append_consumes_its_accumulator),
		("filter appends in an if branch and consumes the accumulator", test_filter_branch_append_consumes_its_accumulator),
		("copy_range appends in a match arm and consumes the accumulator", test_copy_range_match_arm_append_consumes_its_accumulator),
		("reverse appends in a match arm and consumes the accumulator", test_reverse_match_arm_append_consumes_its_accumulator),
		("join concatenates onto a consumed String accumulator", test_join_concatenations_consume_their_accumulator),
		("a snapshot read after an append keeps the accumulator borrowed", test_snapshot_read_after_append_is_not_consumed),
	]
}
