import:
	../../../src/check/model: decision_node_id, match_arm_id
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/namespace/builtins as Builtins
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/lex/lex: lex
	../../../src/utils/syntax: Diagnostic, FunctionExecution(SelfTailLoop), same_span
	../input: check, parse, setup_diagnostic
	../ownership_inputs: InputIds, input_ids, integer, parameter, span
	test: TestSuite


private pure func uses_equal(
	result: Result[List[Option[Int]], Diagnostic],
	expected: List[Option[Int]],
) -> Bool:
	match result:
		Ok(uses): uses == expected
		Err(_): False


private pure func loop(ids: InputIds) -> Lower.LoweredFunction:
	{
		signature = { parameters = [Concrete.IntType, Concrete.IntType], return_type = Concrete.IntType },
		steps = [
			Lower.Define(parameter(ids.first, Concrete.IntType)),
			Lower.Define({ parameter(ids.second, Concrete.IntType) | operation = Lower.ParameterValue(1) }),
			Lower.Loop({
				headers = [
					{ parameter = { id = ids.fourth, value_type = Concrete.IntType, span = span(10) }, initial = ids.first },
					{ parameter = { id = ids.fifth, value_type = Concrete.IntType, span = span(20) }, initial = ids.second },
				],
				result = { id = ids.third, value_type = Concrete.IntType, span = span(90) },
				carried = [],
				reads = [ids.first, ids.second],
				body = { steps = [], tail = Lower.ExitLoop(Lower.Recur([ids.fifth, ids.fourth], span(80))) },
			}),
		],
		result = ids.third,
	}


pure func test_permuted_arguments_remain_unmanaged() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			match Own.insert_function(loop(ids), ids.unions, []):
				Err(_): False
				Ok(owned):
					match (owned.operations, owned.result):
						([Own.DefineValue(first), Own.DefineValue(second), Own.ExecuteLoop(loop)], Own.UnmanagedReturn(result)):
							match (first.result, second.result, loop.body.operations, loop.body.tail):
								(Own.UnmanagedResult, Own.UnmanagedResult, [], Own.ExitLoop(Own.Recur([Own.UnmanagedReturn(left), Own.UnmanagedReturn(right)], occurrence))):
									(
										Lower.value_number(left) == 4
										and Lower.value_number(right) == 3
										and Lower.value_number(result) == 2
										and same_span(occurrence, span(80))
									)
								_: False
						_: False


pure func test_duplicate_operands_have_terminal_use() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			uses_equal(
				Own.exit_last_uses([Lower.Define(integer(ids.first, 1, 10)), Lower.Define(integer(ids.second, 2, 20)), Lower.Define(integer(ids.third, 7, 30))], Lower.Recur([ids.first, ids.first], span(80)), 0, 0),
				[Some(3), None, None],
			)


pure func test_permutation_operands_have_terminal_uses() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			uses_equal(
				Own.exit_last_uses([Lower.Define(integer(ids.first, 1, 10)), Lower.Define(integer(ids.second, 2, 20)), Lower.Define(integer(ids.third, 7, 30))], Lower.Recur([ids.second, ids.first], span(80)), 0, 0),
				[Some(3), Some(3), None],
			)


pure func test_arm_capture_has_terminal_use() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			uses_equal(
				Own.exit_last_uses([Lower.Define(integer(ids.third, 7, 30))], Lower.Recur([ids.first, ids.third], span(80)), 2, 2),
				[Some(1)],
			)


pure func test_zero_argument_backedge_has_no_result() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			function: Lower.LoweredFunction = {
				signature = { parameters = [], return_type = Concrete.IntType },
				steps = [Lower.Loop({
					headers = [],
					result = { id = ids.first, value_type = Concrete.IntType, span = span(90) },
					carried = [], reads = [],
					body = { steps = [], tail = Lower.ExitLoop(Lower.Recur([], span(80))) },
				})],
				result = ids.first,
			}
			match Own.insert_function(function, [], []):
				Err(_): False
				Ok(owned):
					match owned.operations:
						[Own.ExecuteLoop(loop)]:
							match loop.body.tail:
								Own.ExitLoop(Own.Recur([], occurrence)):
									loop.body.operations.is_empty() and same_span(occurrence, span(80)) and uses_equal(Own.exit_last_uses([], Lower.Recur([], span(80)), 0, 0), [])
								_: False
						_: False


-- These facts belong to Specialize's sole source-eligibility boundary. They
-- establish eligibility only; Check still owns whether source recursion is valid.
private pure func scalar_function() -> Concrete.ConcreteFunction:
	{
		execution = SelfTailLoop(span(90)),
		signature = { parameters = [Concrete.IntType, Concrete.IntType], return_type = Concrete.IntType },
		bindings = [], statements = [],
		body = Concrete.ConcreteValueBody(Concrete.RecurWith([], span(80))),
	}


private pure func rejects_managed(
	function: Concrete.ConcreteFunction,
	unions: List[Concrete.ConcreteUnion],
	records: List[Concrete.ConcreteRecord],
	start: Int,
) -> Bool:
	match Concrete.admit_scalar_loop(function, unions, records):
		Ok(_): False
		Err(error):
			(
				same_span(error.span, span(start))
				and error.message == "managed values in @tail_recursive functions are not supported yet"
				and error.help == "use an unmanaged helper, or remove @tail_recursive"
				and error.note.is_none()
			)


pure func test_managed_signature_rejects_at_annotation() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = scalar_function()
			rejects_managed({ original | signature = { original.signature | parameters = [Concrete.StringType, Concrete.IntType] } }, ids.unions, [], 90)


pure func test_managed_result_rejects_at_annotation() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = scalar_function()
			rejects_managed({ original | signature = { original.signature | return_type = Concrete.StringType } }, ids.unions, [], 90)


private pure func managed_initializer() -> Concrete.ConcreteExpr:
	{
		form = Concrete.InvokeFunction({ target = Concrete.RuntimeFunction(Builtins.IntToString), span = span(30) }, [{ form = Concrete.LiteralInteger(7), value_type = Concrete.IntType, span = span(29) }]),
		value_type = Concrete.StringType,
		span = span(30),
	}


pure func test_unused_managed_initializer_rejects_at_definition() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			rejects_managed({ scalar_function() | statements = [Concrete.DiscardExpression(managed_initializer())] }, ids.unions, [], 30)


pure func test_managed_arm_initializer_rejects_at_definition() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			rejects_managed({ scalar_function() | body = Concrete.ConcreteMatchBody({
				scrutinee = { form = Concrete.ConstructVariant(ids.second_variant, []), value_type = Concrete.UnionType(ids.union_id), span = span(20) },
				selection = { nodes = [Concrete.EnterArm(match_arm_id(0), [])], entry = decision_node_id(0) },
				arms = [{ id = match_arm_id(0), inputs = [], statements = [Concrete.DiscardExpression(managed_initializer())], body = Concrete.RecurWith([], span(80)) }],
			}) }, ids.unions, [], 30)


private pure func carrier_seed() -> Result[Concrete.SpecializedProgram, Diagnostic]:
	source: String =
		|fixed union Flag:
		|    Off
		|    On
		|pure func choose(flag: Flag) -> Int:
		|    var current = 0
		|    match flag:
		|        Off: current = 7
		|        On: void
		|    current
		|func main() -> Int:
		|    choose(Off)
		|
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	checked ?= check(parsed).map_err(setup_diagnostic)
	Concrete.specialize(checked)


pure func test_managed_join_carrier_rejects_at_its_own_origin_before_the_arm() -> Bool:
	match carrier_seed():
		Err(_): False
		Ok(program):
			contents = Concrete.specialized_contents(program)
			match contents.functions:
				[_, function]:
					match (function.bindings, function.statements):
						([parameter, carrier], [initialized, Concrete.DiscardExpression(value)]):
							match value.form:
								Concrete.Match(join):
									match join.arms:
										[first, second]:
											changed = { first | statements = [Concrete.DiscardExpression({ form = Concrete.LiteralString("arm"), value_type = Concrete.StringType, span = span(40) })] }
											rejects_managed({ function |
												execution = SelfTailLoop(span(90)),
												bindings = [parameter, { carrier | value_type = Concrete.StringType, span = span(31) }],
												statements = [initialized, Concrete.DiscardExpression({ value | form = Concrete.Match({ join | arms = [changed, second] }) })],
											}, contents.unions, contents.records, 31)
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Unmanaged recursive backedge ownership",
	tests = [
		("managed carried output rejects at its origin before its arm", test_managed_join_carrier_rejects_at_its_own_origin_before_the_arm),
		(
			"permuted arguments have no owners or fictitious result",
			test_permuted_arguments_remain_unmanaged,
		),
		("duplicate operands have a terminal use", test_duplicate_operands_have_terminal_use),
		(
			"permuted operands each have a terminal use",
			test_permutation_operands_have_terminal_uses,
		),
		("arm capture has a terminal use", test_arm_capture_has_terminal_use),
		("zero-argument backedge has no result", test_zero_argument_backedge_has_no_result),
		(
			"managed signature diagnostic at annotation",
			test_managed_signature_rejects_at_annotation,
		),
		("managed result diagnostic at annotation", test_managed_result_rejects_at_annotation),
		(
			"unused managed initializer diagnostic at definition",
			test_unused_managed_initializer_rejects_at_definition,
		),
		(
			"managed arm initializer diagnostic at definition",
			test_managed_arm_initializer_rejects_at_definition,
		),
	]
}
