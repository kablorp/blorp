import:
	../../../src/check/check: CheckedProgram, check, check_errors, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/model as Check
	../../../src/check/render: render_failure
	../../../src/utils/ids as Declaration
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, Purity(Pure), ParsedRuntimeOperation(IntegerEqualsBuiltin)
	../compilation: compile_modules
	../input: setup_diagnostic, singleton_check_error
	../module_input: TEST_BASE, parse_modules
	option: get_or
	test: TestSuite


-- The test foundation declares Bool as True, then False.
private SOURCE: String =
	|pure func compare(left: Int, right: Int) -> Bool:
	|    builtin("int.equals")
	|func main() -> Int:
	|    compared = compare(20, 22)
	|    0
	|


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules([{ source = source, targets = [] }])
	check(parsed).map_err(setup_diagnostic)


pure func test_checked_comparison_returns_designated_bool_with_int_parameters() -> Bool:
	match checked(SOURCE):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match (function.signature.return_type.value_type, function.body):
						(Check.UnionType(owner), Check.CheckedValueBody(Check.ReturnExpression(value))):
							match value.form:
								Check.InvokeFunction(call, [left, right]):
									match call.target:
										Check.RuntimeFunction(Builtins.IntEquals(boolean)):
											(Declaration.variant_number(boolean.true_variant) == 0
											and Declaration.variant_number(boolean.false_variant) == 1
											and Declaration.union_number(Declaration.variant_owner(boolean.true_variant)) == Declaration.union_number(owner)
											and Check.same_type(left.value_type, Check.IntType)
											and Check.same_type(right.value_type, Check.IntType))
										_: False
								_: False
						_: False
				_: False


pure func test_specialization_translates_bool_constructors_to_result_instance() -> Bool:
	match checked(SOURCE).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, function]:
					match function.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match (value.form, value.value_type):
								(Concrete.InvokeFunction(call, [_, _]), Concrete.UnionType(owner)):
									match call.target:
										Concrete.RuntimeFunction(Builtins.IntEquals(boolean)):
											(Concrete.variant_number(boolean.true_variant) == 0
											and Concrete.variant_number(boolean.false_variant) == 1
											and Concrete.union_number(Concrete.variant_owner(boolean.true_variant)) == Concrete.union_number(owner)
											and Concrete.union_number(Concrete.variant_owner(boolean.false_variant)) == Concrete.union_number(owner))
										_: False
								_: False
						_: False
				_: False


pure func test_ownership_keeps_numeric_comparison_unmanaged() -> Bool:
	match checked(SOURCE)
		.and_then(pure func(program): Concrete.specialize(program))
		.and_then(pure func(program): Lower.lower(program)):
		Err(_): False
		Ok(program):
			contents = Lower.lowered_functions(program)
			match contents.functions:
				[_, function]:
					match Own.insert_function(function, contents.unions, []):
						Err(_): False
						Ok(owned):
							match (owned.operations, owned.tail):
								([Own.DefineValue(left), Own.DefineValue(right), Own.DefineValue(result)], Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(returned)))):
									match (left.result, right.result, result.result, result.operation):
										(Own.UnmanagedResult, Own.UnmanagedResult, Own.UnmanagedResult, Own.CallDefinition(_, [Own.UnmanagedArgument(first), Own.UnmanagedArgument(second)])):
											Lower.value_number(first) == 0 and Lower.value_number(second) == 1 and Lower.value_number(returned) == 2
										_: False
								_: False
				_: False


-- True is the designated union's first variant, so equality selects tag 0.
pure func test_emission_uses_numeric_comparison_and_explicit_tags() -> Bool:
	match compile_modules([{ source = SOURCE, targets = [] }], TEST_BASE):
		Err(_): False
		Ok(output):
			(output.contains("(blorp_vl_0==blorp_vl_1)?blorp_v_0_0:blorp_v_0_1")
			and not output.contains("blorp_string_equals")
			and not output.contains("blorp_int_equals"))


pure func test_runtime_contract_is_pure_binary_int_to_designated_bool() -> Bool:
	operation: Builtins.RuntimeOperation[Int, Concrete.TypeRef] = Builtins.IntEquals({ true_variant = 17, false_variant = 29 })
	contract = Builtins.runtime_contract(operation)
	match (contract.purity, contract.parameters, contract.return_type):
		(Pure, [Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt), Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt)], Builtins.BooleanResult(boolean)):
			boolean.true_variant == 17 and boolean.false_variant == 29
		_: False


private pure func rejects_contract(source: String) -> Bool:
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					rendered = render_failure(failure)
					label = source.index_of("\"int.equals\"").get_or(-1)
					match singleton_check_error(check_errors(failure)):
						Some(error):
							match error.kind:
								Errors.BuiltinRejection(Errors.BuiltinContractMismatch(IntegerEqualsBuiltin)):
									(rendered.remaining.is_empty()
									and rendered.first.message == "builtin declaration does not match its runtime contract"
									and rendered.first.help == "declare a pure nongeneric function with two Int parameters returning Bool"
									and rendered.first.span.start == label
									and rendered.first.span.end == label + "\"int.equals\"".length()
									and rendered.first.note.is_none())
								_: False
						None: False


pure func test_checker_rejects_string_parameter_contract() -> Bool:
	source: String =
		|pure func compare(left: String, right: Int) -> Bool:
		|    builtin("int.equals")
		|func main() -> Int:
		|    0
		|
	rejects_contract(source)


-- Bool is an identity, not a shape: an equal-shaped union is still rejected.
pure func test_checker_rejects_comparison_into_an_ordinary_union() -> Bool:
	source: String =
		|fixed union Answer:
		|    Identical
		|    Different
		|pure func compare(left: Int, right: Int) -> Answer:
		|    builtin("int.equals")
		|func main() -> Int:
		|    0
		|
	rejects_contract(source)


pure func test_parser_rejects_constructor_arguments_after_the_label() -> Bool:
	source: String =
		|pure func compare(left: Int, right: Int) -> Bool:
		|    builtin("int.equals", True, False)
		|func main() -> Int:
		|    0
		|
	match checked(source):
		Ok(_): False
		Err(error):
			(error.message == "expected ')' after the builtin label"
			and error.help == "give the builtin one quoted label; Bool and Option results use the foundation's unions"
			and error.span.start == source.index_of("\"int.equals\"").get_or(-1) + "\"int.equals\"".length()
			and error.span.end == error.span.start + 1
			and error.note.is_none())


tests: TestSuite = {
	description = "Blorp 2 Int equality through the designated Bool",
	tests = [
		("checked designated Bool and numeric parameters", test_checked_comparison_returns_designated_bool_with_int_parameters),
		("specialized result instance constructors", test_specialization_translates_bool_constructors_to_result_instance),
		("unmanaged numeric comparison", test_ownership_keeps_numeric_comparison_unmanaged),
		("direct numeric C comparison", test_emission_uses_numeric_comparison_and_explicit_tags),
		("pure numeric runtime contract", test_runtime_contract_is_pure_binary_int_to_designated_bool),
		("reject String parameter contract", test_checker_rejects_string_parameter_contract),
		("reject comparison into an ordinary union", test_checker_rejects_comparison_into_an_ordinary_union),
		("parser rejects constructor arguments", test_parser_rejects_constructor_arguments_after_the_label),
	]
}
