							runtime(ids.fourth, Builtins.StringLength, [ids.second], IntType, 40),
						],
						ids.fourth,
						[],
						IntType,
					),
					[],
					[],
				)
			):
				Ok(output):
					match output.operations:
						[DefineValue(_), DefineValue(string), DefineValue(first), DefineValue(last), DropOwner(dropped, at)]:
							match output.result:
