					operation = VoidValue,
					span = span(40),
				},
				{
					id = ids.fifth,
					value_type = VoidType,
					operation = VoidValue,
					span = span(50),
				},
			)
			match last_uses(
				[Define(ids.union_value), join, Define(integer(ids.third, 7, 30))],
				ids.third,
			):
				Ok(uses):
					uses == [Some(1), None, Some(3)]
				Err(_):
					False


pure func test_join_continuation_cannot_read_an_arm_local_value() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			join = unary_join(ids, integer(ids.fourth, 7, 40), integer(ids.fifth, 9, 50))
			last_use_rejection(
				last_uses(
					[
						Define(ids.union_value),
						join,
						Define(runtime(ids.third, Builtins.IntToString, [ids.fourth], StringType, 30)),
					],
					ids.third,
				),
				"invalid value identity in ownership use analysis",
				span(30),
			)


-- A complete raw join introduces two values at one position. The seed's
-- two-member union supplies the scrutinee; its default arm covers both cases.
-- No source reassignment or multi-output source syntax is admitted by this test.
pure func test_join_outputs_have_separate_value_slots_at_one_step() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			steps: List[LoweredStep] = [
				Define(ids.union_value),
				Join({
					result = { id = ids.second, value_type = VoidType, span = span(20) },
					carried = [{ id = ids.third, value_type = IntType, span = span(21) }],
					selection = default_selection(ids.first),
					arms = [{
						id = match_arm_id(0),
						inputs = [],
						steps = [
							Define({
								id = ids.fifth,
								value_type = VoidType,
								operation = VoidValue,
								span = span(40),
							}),
							Define(integer(ids.sixth, 7, 50)),
						],
						exit = Lower.Yield({ value = ids.fifth, carried = [ids.sixth] }),
					}],
					reads = [ids.first],
				}),
				Define(runtime(ids.fourth, Builtins.IntAdd, [ids.third, ids.third], IntType, 30)),
			]
			match last_uses(steps, ids.fourth):
				Err(_): False
				Ok(uses):
					(
						steps.length() == 3 and block_value_count(steps) == 4
						and uses == [Some(1), None, Some(2), Some(3)]
					)


