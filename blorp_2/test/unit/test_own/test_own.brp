import:
	../../../src/check/model: match_arm_id, decision_node_id
	../../../src/utils/syntax: Diagnostic, Span, same_span
	../../../src/utils/source: compiler_source
	../../../src/lower/lower as Lower:
		LoweredStep(Define, Join, Loop),
		LoopExit(Recur, Break),
		LoopTail(MatchLoop),
		ValueDefinition,
		ValueOperation(CallValue, ConstructValue, VoidValue),
		lowered_functions,
		block_value_count,
		value_number,
	../../../src/own/own as Own:
		BorrowSource(ParameterBorrow, OwnerBorrow),
		OwnedArgument(BorrowedArgument),
		OwnedLoopTail,
		OwnedLoopExit,
		OwnedValueOperation(CallDefinition),
		OwnershipOperation(DefineValue, ExecuteLoop, AcquireOwner, DropOwner),
		ResultOwnership(BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		block_last_uses,
		exit_last_uses,
		insert_function,
		last_uses,
		owner_number,
	../../../src/namespace/builtins as Builtins: RuntimeOperation(IntToString, StringLength, IntAdd)
	../../../src/specialize/specialize as Concrete:
		CallTarget(UserFunction),
		TypeRef(IntType, StringType, UnionType, VoidType),
		function_number,
		value_needs_ownership,
	../ownership_inputs: InputIds, function, input_ids, integer, parameter, runtime, span
	../managed_union_inputs: lowered, NAMED_CALLBACK_SOURCE, NONCAPTURING_CALLBACK_SOURCE
	test: TestSuite


private pure func default_selection(value: Lower.ValueId) -> Lower.LoweredSelection:
	{ scrutinee = value, nodes = [Lower.EnterArm({ arm = match_arm_id(0), definitions = [], arguments = [] })], entry = decision_node_id(0) }


private pure func binary_selection(value: Lower.ValueId, owner: Concrete.UnionInstanceId, variant: Concrete.VariantInstanceId) -> Lower.LoweredSelection:
	{
		scrutinee = value,
		nodes = [
			Lower.EnterArm({ arm = match_arm_id(0), definitions = [], arguments = [] }),
			Lower.EnterArm({ arm = match_arm_id(1), definitions = [], arguments = [] }),
			Lower.TestVariant({ value_type = UnionType(owner), route = Concrete.MatchRoot }, variant, decision_node_id(0), decision_node_id(1)),
		],
		entry = decision_node_id(2),
	}


private pure func borrows_owner(
	operation: OwnedValueOperation,
	expected_value: Int,
	expected_owner: Int,
) -> Bool:
	match operation:
		CallDefinition(_, [BorrowedArgument(borrow)]):
			match borrow.source:
				OwnerBorrow(owner):
					(
						value_number(borrow.value) == expected_value
						and owner_number(owner) == expected_owner
					)
				_:
					False
		_:
			False


private pure func owns_result(result: ResultOwnership, expected_owner: Int) -> Bool:
	match result:
		OwnedResult(owner):
			owner_number(owner) == expected_owner
		_:
			False


pure func test_string_has_an_explicit_managed_leaf_plan() -> Bool:
	match value_needs_ownership(StringType, [], []):
		Ok(True):
			True
		_:
			False


pure func test_scalar_has_no_ownership() -> Bool:
	match value_needs_ownership(IntType, [], []):
		Ok(False):
			True
		_:
			False


pure func test_union_plan_requires_its_declaration() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match value_needs_ownership(UnionType(ids.union_id), ids.unions, []):
				Ok(False):
					match value_needs_ownership(UnionType(ids.union_id), [], []):
						Err(error):
							error.message == "internal compiler error: invalid union identity in ownership representation"
						_:
							False
				_:
					False


private pure func last_use_rejection(
	result: Result[List[Option[Int]], Diagnostic],
	message: String,
	expected_span: Span,
) -> Bool:
	match result:
		Err(error):
			(
				error.message == "internal compiler error: " + message
				and error.help == "report this compiler error with the input program"
				and same_span(error.span, expected_span)
				and error.note.is_none()
			)
		Ok(_):
			False


pure func test_last_use_records_repeated_call_operands_with_a_prefix_and_offset() -> Bool:
	source: String =
		|pure func helper(spare: Int, left: Int, right: Int) -> Int:
		|    spare
		|pure func caller(ignored: Int, spare: Int) -> Int:
		|    local = 7
		|    helper(spare, local, local)
		|func main() -> Int:
		|    caller(1, 2)
		|
	match lowered(source):
		Err(_):
			False
		Ok(program):
			lowered_functions(program).functions.any(pure func(function):
				match function.steps:
					[Define(ignored), Define(spare), Define(local), Define(call)]:
						match call.operation:
							CallValue(_, arguments):
								match block_last_uses([local, call].map(pure func(definition): Define(definition)), function.result, 2, 2):
									Ok(uses):
										definition_ids = [ignored, spare, local, call].map(
											pure func(definition): value_number(definition.id),
										)
										argument_ids = arguments.map(value_number)
										local_id = value_number(local.id)
										(
											definition_ids == [0, 1, 2, 3]
											and argument_ids == [value_number(spare.id), local_id, local_id]
											and uses == [Some(1), Some(2)]
										)
									Err(_):
										False
							_:
								False
					_:
						False
			)


pure func test_repeated_constructor_children_share_one_last_use_slot() -> Bool:
	source: String =
		|fixed union Pair:
		|    Pair(Int, Int)
		|pure func pair(value: Int) -> Pair:
		|    Pair(value, value)
		|func main() -> Int:
		|    unused = pair(7)
		|    0
		|
	match lowered(source):
		Err(_):
			False
		Ok(program):
			lowered_functions(program).functions.any(pure func(function):
				match function.steps:
					[Define(parameter), Define(construction)]:
						match construction.operation:
							ConstructValue(_, arguments):
								match last_uses(function.steps, function.result):
									Ok(uses):
										(
											arguments.map(value_number) == [
												value_number(parameter.id),
												value_number(parameter.id),
											]
											and uses == [Some(1), Some(2)]
										)
									Err(_):
										False
							_:
								False
					_:
						False
			)


pure func test_last_use_accepts_an_empty_block_returning_a_prefix() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match block_last_uses([], ids.second, 2, 3):
				Ok(uses):
					uses.is_empty()
				Err(_):
					False


-- Only the published external reads belong to the enclosing block. The
-- arm-local values follow its complete interval and never gain local slots.
private pure func unary_join(
	ids: InputIds,
	left: ValueDefinition,
	right: ValueDefinition,
) -> LoweredStep:
	Join({
		result = { id = ids.second, value_type = left.value_type, span = span(20) },
		carried = [],
		selection = binary_selection(ids.first, ids.union_id, ids.second_variant),
		arms = [
			{
				id = match_arm_id(0),
				inputs = [],
				steps = [Define(left)],
				exit = Lower.Yield({ value = left.id, carried = [] }),
			},
			{
				id = match_arm_id(1),
				inputs = [],
				steps = [Define(right)],
				exit = Lower.Yield({ value = right.id, carried = [] }),
			},
		],
		reads = [ids.first],
	})


pure func test_join_reads_and_continuation_keep_their_own_last_use_positions() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			join = unary_join(ids, integer(ids.fourth, 7, 40), integer(ids.fifth, 9, 50))
			match last_uses(
				[
					Define(ids.union_value),
					join,
					Define(runtime(ids.third, Builtins.IntToString, [ids.second], StringType, 30)),
				],
				ids.third,
			):
				Ok(uses):
					uses == [Some(1), Some(2), Some(3)]
				Err(_):
					False


pure func test_unused_void_join_keeps_a_value_slot_before_the_continuation() -> Bool:
