import:
	../../../src/utils/syntax: Diagnostic, Span, same_span
	../../../src/utils/source: compiler_source
	../../../src/lower/lower:
		LoweredExit(ReturnValue, RecurValues),
		LoweredTail(ExitValue, MatchValue),
		MatchLabel(DefaultLabel, VariantLabel),
		ValueOperation(CallValue, ConstructValue),
		lowered_functions,
		value_number,
	../../../src/own/own:
		BorrowSource(ParameterBorrow, OwnerBorrow),
		OwnedArgument(BorrowedArgument),
		OwnedExit(ReturnResult),
		OwnedTail(ReturnTail, MatchTail),
		OwnedValueOperation(CallDefinition),
		OwnershipOperation(DefineValue, AcquireOwner, DropOwner),
		ResultOwnership(BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		block_last_uses,
		exit_last_uses,
		insert_function,
		last_uses,
		owner_number,
	../../../src/namespace/builtins as Builtins: RuntimeOperation(IntToString, StringLength)
	../../../src/specialize/specialize:
		CallTarget(UserFunction),
		TypeRef(IntType, StringType, UnionType),
		ValueOwnership(NoOwnership, ManagedStringLeaf),
		specialize,
		value_ownership,
	../ownership_inputs: function, input_ids, integer, parameter, runtime, span
	../managed_union_inputs: lowered
	test: TestSuite


private pure func borrows_owner(
	operation: OwnedValueOperation,
	expected_value: Int,
	expected_owner: Int,
) -> Bool:
	match operation:
		CallDefinition(_, [BorrowedArgument(borrow)]):
			match borrow.source:
				OwnerBorrow(owner):
					(
						value_number(borrow.value) == expected_value
						and owner_number(owner) == expected_owner
					)
				_:
					False
		_:
			False


private pure func owns_result(result: ResultOwnership, expected_owner: Int) -> Bool:
	match result:
		OwnedResult(owner):
			owner_number(owner) == expected_owner
		_:
			False


pure func test_string_has_an_explicit_managed_leaf_plan() -> Bool:
	match value_ownership(StringType, [], []):
		Ok(ManagedStringLeaf):
			True
		_:
			False


pure func test_scalar_has_no_ownership() -> Bool:
	match value_ownership(IntType, [], []):
		Ok(NoOwnership):
			True
		_:
			False


pure func test_union_plan_requires_its_declaration() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match value_ownership(UnionType(ids.union_id), ids.unions, []):
				Ok(NoOwnership):
					match value_ownership(UnionType(ids.union_id), [], []):
						Err(error):
							error.message == "internal compiler error: invalid union identity in ownership representation"
						_:
							False
				_:
					False


private pure func last_use_rejection(
	result: Result[List[Option[Int]], Diagnostic],
	message: String,
	expected_span: Span,
) -> Bool:
	match result:
		Err(error):
			(
				error.message == "internal compiler error: " + message
				and error.help == "report this compiler error with the input program"
				and same_span(error.span, expected_span)
				and error.note.is_none()
			)
		Ok(_):
			False


pure func test_last_use_records_repeated_call_operands_with_a_prefix_and_offset() -> Bool:
	source: String =
		|pure func helper(spare: Int, left: Int, right: Int) -> Int:
		|    spare
		|pure func caller(ignored: Int, spare: Int) -> Int:
		|    local = 7
		|    helper(spare, local, local)
		|func main() -> Int:
		|    caller(1, 2)
		|
	match lowered(source):
		Err(_):
			False
		Ok(program):
			lowered_functions(program).functions.any(pure func(function):
				match function.definitions:
					[ignored, spare, local, call]:
						match call.operation:
							CallValue(_, arguments):
								match function.tail:
									ExitValue(ReturnValue(result)):
										match block_last_uses([local, call], result, 2, 2):
											Ok(uses):
												definition_ids = function.definitions.map(
													pure func(definition): value_number(definition.id),
												)
												argument_ids = arguments.map(value_number)
												local_id = value_number(local.id)
												(
													definition_ids == [0, 1, 2, 3]
													and argument_ids == [value_number(spare.id), local_id, local_id]
													and uses == [Some(1), Some(2)]
												)
											Err(_):
												False
									_:
										False
							_:
								False
					_:
						False
			)


pure func test_repeated_constructor_children_share_one_last_use_slot() -> Bool:
	source: String =
		|fixed union Pair:
		|    Pair(Int, Int)
		|pure func pair(value: Int) -> Pair:
		|    Pair(value, value)
		|func main() -> Int:
		|    unused = pair(7)
		|    0
		|
	match lowered(source):
		Err(_):
			False
		Ok(program):
			lowered_functions(program).functions.any(pure func(function):
				match function.definitions:
					[parameter, construction]:
						match construction.operation:
							ConstructValue(_, arguments):
								match function.tail:
									ExitValue(ReturnValue(result)):
										match last_uses(function.definitions, result):
											Ok(uses):
												(
													arguments.map(value_number) == [
														value_number(parameter.id),
														value_number(parameter.id),
													]
													and uses == [Some(1), Some(2)]
												)
											Err(_):
												False
									_:
										False
							_:
								False
					_:
						False
			)


