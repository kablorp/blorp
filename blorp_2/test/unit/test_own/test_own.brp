				[runtime(ids.fourth, Builtins.IntToString, [ids.third], StringType, 40)].map(pure func(definition): Define(definition)),
				ids.fourth,
				2,
				3,
			):
				Err(error):
					(
						error.message == "internal compiler error: invalid value identity in ownership use analysis"
						and error.help == "report this compiler error with the input program"
						and same_span(error.span, span(40))
					)
				_:
					False


pure func test_match_arms_drop_unused_owners_and_transfer_distinct_owners() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			input = {
				signature = { parameters = [], return_type = StringType },
				steps = [Loop({
					headers = [],
					result = { id = ids.first, value_type = StringType, span = span(90) },
					carried = [],
					body_reads = [],
					body = {
						steps = [Define({ ids.union_value | id = ids.second }), Define(integer(ids.third, 7, 20))],
						tail = MatchLoop({
							selection = binary_selection(ids.second, ids.union_id, ids.second_variant),
							arms = [
								{
									id = match_arm_id(0),
									inputs = [],
									body = {
										steps = [
											Define(runtime(ids.fourth, Builtins.IntToString, [ids.third], StringType, 30)),
											Define(runtime(ids.fifth, Builtins.IntToString, [ids.third], StringType, 40)),
										],
										tail = Lower.ExitLoop(Break({ value = ids.fifth, carried = [], span = span(80) }))
									}
								},
								{
									id = match_arm_id(1),
									inputs = [],
									body = {
										steps = [Define(runtime(ids.sixth, Builtins.IntToString, [ids.third], StringType, 50))],
										tail = Lower.ExitLoop(Break({ value = ids.sixth, carried = [], span = span(81) }))
									}
								},
							],
						})
					}
				})],
				result = ids.first
			}
			match insert_function(input, ids.unions, []):
				Ok(output):
					match output.operations:
						[ExecuteLoop(loop)]:
							match loop.body.tail:
								Own.MatchLoop(matched):
									match matched.arms:
										[first, second]:
											match (first.body.operations, first.body.tail, second.body.operations, second.body.tail):
												([DefineValue(unused), DropOwner(dropped, at), DefineValue(returned), AcquireOwner(acquired, _, _), DropOwner(retired, _)], Own.ExitLoop(Own.Break(left)), [DefineValue(other), AcquireOwner(other_acquired, _, _), DropOwner(other_retired, _)], Own.ExitLoop(Own.Break(right))):
													match (left.value, right.value):
														(OwnedReturn(value, owner), OwnedReturn(other_value, other_owner)):
															(
																owns_result(unused.result, 1)
																and owner_number(dropped) == 1
																and same_span(at, span(30))
																and owns_result(returned.result, 2)
																and value_number(value) == 4
																and owner_number(owner) == 3
																and owner_number(acquired) == 3
																and owner_number(retired) == 2
																and owns_result(other.result, 4)
																and value_number(other_value) == 5
																and owner_number(other_owner) == 5
																and owner_number(other_acquired) == 5
																and owner_number(other_retired) == 4
															)
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False

pure func test_named_callback_return_acquires_its_borrowed_string() -> Bool:
	callback_return_acquires_its_borrowed_string(NAMED_CALLBACK_SOURCE)


private pure func callback_return_acquires_its_borrowed_string(source: String) -> Bool:
	match lowered(source).and_then(Own.own):
		Err(_): False
		Ok(program):
			match program.functions:
				[_, identity, apply]:
					match apply.operations:
						[_, Own.DefineValue(invocation)]:
							selected = match invocation.operation:
								Own.CallDefinition(call, [_]):
									match call:
										UserFunction(id): function_number(id) == 1
										_: False
								_: False
							match (identity.operations, identity.result):
								([Own.DefineValue(parameter), Own.AcquireOwner(owner, borrow, _)], Own.OwnedReturn(value, returned)):
									match (parameter.operation, parameter.result, borrow.source):
										(Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(source)), Own.ParameterBorrow(acquired)):
											(
												selected and value_number(value) == value_number(parameter.id)
												and value_number(source) == value_number(acquired) and value_number(borrow.value) == value_number(parameter.id)
												and Own.owner_number(owner) == Own.owner_number(returned)
											)
										_: False
								_: False
						_: False
				_: False


pure func test_named_callback_invocation_transfers_the_owned_call_result() -> Bool:
	callback_invocation_transfers_the_owned_call_result(NAMED_CALLBACK_SOURCE)


private pure func callback_invocation_transfers_the_owned_call_result(source: String) -> Bool:
	match lowered(source).and_then(Own.own):
		Err(_): False
		Ok(program):
			match program.functions:
				[main, _, apply]:
					match main.operations:
						[_, Own.DefineValue(invocation), ..._]:
							selected = match invocation.operation:
								Own.CallDefinition(call, [_]):
									match call:
										UserFunction(id): function_number(id) == 2
										_: False
								_: False
							match (apply.operations, apply.result):
								([Own.DefineValue(parameter), Own.DefineValue(result)], Own.OwnedReturn(value, returned)):
									match (result.operation, result.result):
										(Own.CallDefinition(call, [Own.BorrowedArgument(borrow)]), Own.OwnedResult(owner)):
											match (call, borrow.source):
												(UserFunction(callback), Own.ParameterBorrow(source)):
													(
														selected and function_number(callback) == 1
														and value_number(source) == value_number(parameter.id) and value_number(value) == value_number(result.id)
														and Own.owner_number(owner) == Own.owner_number(returned)
													)
												_: False
										_: False
								_: False
						_: False
				_: False


pure func test_unused_named_callback_result_is_dropped_once() -> Bool:
	unused_callback_result_is_dropped_once(NAMED_CALLBACK_SOURCE)


private pure func unused_callback_result_is_dropped_once(source: String) -> Bool:
	match lowered(source).and_then(Own.own):
		Err(_): False
		Ok(program):
			match program.functions:
				[main, _, _]:
					match main.operations:
						[_, Own.DefineValue(result), ..._]:
							match (result.operation, result.result):
								(Own.CallDefinition(call, [_]), Own.OwnedResult(owner)):
									match call:
										UserFunction(id):
											function_number(id) == 2 and main.operations.filter(pure func(operation):
												match operation:
													Own.DropOwner(dropped, _): Own.owner_number(dropped) == Own.owner_number(owner)
													_: False
											).length() == 1
										_: False
								_: False
						_: False
				_: False


pure func test_lambda_return_acquires_its_borrowed_string() -> Bool:
	callback_return_acquires_its_borrowed_string(NONCAPTURING_CALLBACK_SOURCE)


pure func test_lambda_invocation_transfers_the_owned_call_result() -> Bool:
	callback_invocation_transfers_the_owned_call_result(NONCAPTURING_CALLBACK_SOURCE)


pure func test_unused_lambda_result_is_dropped_once() -> Bool:
	unused_callback_result_is_dropped_once(NONCAPTURING_CALLBACK_SOURCE)


tests: TestSuite = {
	description = "Blorp 2 ownership insertion",
	tests = [
		("lambda String return acquires its borrowed parameter", test_lambda_return_acquires_its_borrowed_string),
		("lambda invocation transfers its owned direct-call result", test_lambda_invocation_transfers_the_owned_call_result),
		("unused lambda result is dropped exactly once", test_unused_lambda_result_is_dropped_once),
		("unused named owned result is dropped exactly once", test_unused_named_callback_result_is_dropped_once),
		("named callback String return acquires borrowed parameter", test_named_callback_return_acquires_its_borrowed_string),
		("named invocation returns its owned direct-call result", test_named_callback_invocation_transfers_the_owned_call_result),
		(
			"repeated call uses preserve prefix and offset",
			test_last_use_records_repeated_call_operands_with_a_prefix_and_offset,
		),
		(
			"repeated constructor child uses one last-use slot",
			test_repeated_constructor_children_share_one_last_use_slot,
		),
		(
			"empty block may return a prefix",
			test_last_use_accepts_an_empty_block_returning_a_prefix,
		),
		(
			"join reads and continuation keep their own last-use positions",
			test_join_reads_and_continuation_keep_their_own_last_use_positions,
		),
		(
			"unused Void join retains its value slot",
			test_unused_void_join_keeps_a_value_slot_before_the_continuation,
		),
		(
			"join continuation cannot read an arm-local value",
			test_join_continuation_cannot_read_an_arm_local_value,
		),
		(
			"join outputs have separate value slots at one step",
			test_join_outputs_have_separate_value_slots_at_one_step,
		),
		(
			"definition cannot read itself",
			test_last_use_rejects_a_definition_reading_itself,
		),
		(
			"definition cannot read an existing later value",
			test_last_use_rejects_a_forward_read_of_an_existing_definition,
		),
		(
			"recur uses terminal position and local slots",
			test_recur_last_use_records_terminal_position_with_repeats_prefix_and_offset,
		),
		(
			"empty recur has no operands",
			test_recur_last_use_does_not_invent_an_empty_terminal_operand,
		),
		(
			"invalid recur uses explicit span",
			test_recur_last_use_rejects_a_sibling_at_the_explicit_terminal_span,
		),
		(
			"definition identity precedes operand validation",
			test_last_use_checks_definition_identity_before_its_operands,
		),
		(
			"first definition operand error precedes later errors",
			test_last_use_reports_the_first_operand_error_before_later_definitions_and_exit,
		),
		(
			"arm uses retain offsets and unmanaged prefix",
			test_arm_last_use_handles_offset_and_unmanaged_prefix,
		),
		(
			"arm may return an unmanaged prefix value",
			test_arm_last_use_accepts_returning_an_unmanaged_prefix_value,
		),
		(
			"arm use analysis rejects sibling values",
			test_arm_last_use_rejects_sibling_value_identity,
		),
		(
			"arm ownership drops unused and transfers distinct owners",
			test_match_arms_drop_unused_owners_and_transfer_distinct_owners,
		),
		(
			"last use leaves unused value unmarked",
			test_last_use_leaves_an_unused_definition_unmarked,
		),
		(
			"last use extends String through return",
			test_last_use_marks_a_returned_string_at_the_tail,
		),
		(
			"last use skips absent call operand",
			test_last_use_does_not_invent_a_zero_argument_operand,
		),
		(
			"last use rejects nonconsecutive IDs",
			test_last_use_rejects_nonconsecutive_definition_ids,
		),
		("last use rejects unknown argument ID", test_last_use_rejects_an_unknown_argument_id),
		("last use rejects unknown return ID", test_last_use_rejects_an_unknown_return_id),
		(
			"distinct owners drop at separate final uses",
			test_distinct_owners_drop_at_their_separate_final_uses,
		),
		("owned return drops other unused owner", test_owned_return_drops_a_different_unused_owner),
		(
			"repeated borrows never acquire owner",
			test_repeated_borrows_reuse_one_owner_without_acquisition,
		),
		("String has explicit managed leaf plan", test_string_has_an_explicit_managed_leaf_plan),
		("scalar has no ownership", test_scalar_has_no_ownership),
		("union plan requires declaration", test_union_plan_requires_its_declaration),
		(
			"last use includes final borrow and return",
			test_last_use_keeps_the_final_borrow_and_return,
		),
		(
			"length borrows exact owner then drops",
			test_length_borrows_the_exact_owner_then_drops_it,
		),
		("unused owned result drops immediately", test_unused_owned_result_is_dropped_immediately),
		("borrowed parameter is never dropped", test_borrowed_parameter_is_not_dropped),
		(
			"borrowed parameter return acquires owner",
			test_returning_a_borrowed_parameter_acquires_an_owner,
		),
		("owned return transfers without drop", test_owned_return_transfers_without_dropping),
		("replacement result precedes old drop", test_replacement_result_precedes_old_owner_drop),
		(
			"managed match prefix drops in selected arm",
			test_managed_match_prefix_drops_in_selected_arm,
		),
		("unused managed arm value drops", test_unused_managed_match_arm_value_is_dropped),
	]
}
