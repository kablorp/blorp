			match (
				insert_function(
					function(
						[
							integer(ids.first, 7, 10),
							runtime(ids.second, Builtins.IntToString, [ids.first], StringType, 20),
							replacement,
							runtime(ids.fourth, Builtins.StringLength, [ids.third], IntType, 40),
						],
						ids.fourth,
						[],
						IntType,
					),
					[],
					[],
				)
			):
				Ok(output):
					match output.operations:
						[DefineValue(_), DefineValue(_), DefineValue(result), DropOwner(old, _), DefineValue(_), DropOwner(current, _)]:
							match result.result:
