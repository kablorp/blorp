									(
										owns_result(string.result, 0)
										and borrows_owner(first.operation, 1, 0)
										and borrows_owner(last.operation, 1, 0)
										and owner_number(dropped) == 0
										and same_span(at, span(40))
										and value_number(result) == 3
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_length_borrows_the_exact_owner_then_drops_it() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			input = function(
				[
					integer(ids.first, 7, 10),
					runtime(ids.second, Builtins.IntToString, [ids.first], StringType, 20),
					runtime(ids.third, Builtins.StringLength, [ids.second], IntType, 30),
				],
				ids.third,
				[],
				IntType,
			)

			match insert_function(input, [], []):
				Ok(output):
					match output.operations:
						[DefineValue(_), DefineValue(string), DefineValue(length), DropOwner(dropped, at)]:
							match string.result:
								OwnedResult(created):
									match length.operation:
										CallDefinition(_, [BorrowedArgument(borrow)]):
											match borrow.source:
												OwnerBorrow(owner):
													(
														owner_number(created) == 0
														and owner_number(owner) == 0
														and owner_number(dropped) == 0
														and value_number(borrow.value) == 1
														and at.start == 30
													)
												_:
													False
