						[],
						IntType,
					),
					[],
					[],
				)
			):
				Ok(output):
					match output.operations:
						[DefineValue(_), DefineValue(_), DefineValue(result), DropOwner(old, _), DefineValue(_), DropOwner(current, _)]:
							match result.result:
								OwnedResult(acquired):
									(
										owner_number(old) == 0
										and owner_number(acquired) == 1
										and owner_number(current) == 1
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_managed_match_prefix_drops_in_selected_arm() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			input = {
				signature = { parameters = [], return_type = IntType },
				steps = [Loop({
					headers = [],
					result = { id = ids.first, value_type = IntType, span = span(90) },
					carried = [],
					body_reads = [],
					body = {
						steps = [
							Define({ ids.union_value | id = ids.second }),
							Define(integer(ids.third, 7, 10)),
							Define(runtime(ids.fourth, Builtins.IntToString, [ids.third], StringType, 20)),
						],
						tail = MatchLoop({
							selection = default_selection(ids.second),
							arms = [{
								id = match_arm_id(0),
								inputs = [],
								body = {
									steps = [],
									tail = Lower.ExitLoop(Break({ value = ids.third, carried = [], span = span(80) }))
								}
							}],
						})
					}
				})],
				result = ids.first
			}
			match insert_function(input, ids.unions, []):
				Ok(owned):
					match owned.operations:
						[ExecuteLoop(loop)]:
							-- The selected arm retires the unused iteration prefix.
							match (loop.body.operations, loop.body.tail):
								([DefineValue(_), DefineValue(_), DefineValue(_)], Own.MatchLoop(matched)):
									match matched.arms:
										[arm]:
											match (arm.body.operations, arm.body.tail):
												([DropOwner(owner, at)], Own.ExitLoop(Own.Break(outputs))):
													match outputs.value:
														UnmanagedReturn(returned):
															(
															owner_number(owner) == 0
															and same_span(at, span(20))
															and value_number(returned) == 2
														)
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False


