import:
	../../../src/verify/verify: verify
	../../../src/check/model as Checked: match_arm_number
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax:
		Entrypoint(NoArguments),
		FunctionExecution(SelfTailLoop),
		entry_function,
		same_span,
	int as IntOps
	list: find
	../managed_union_inputs: BOX_INPUTS, BOX_SOURCE, lowered, lowered_modules
	../module_input: INTEGER_OPERATIONS, ModuleInput, STRING_OPERATIONS
	../../../src/load/load: load_program
	../../../src/check/check: check, checked_functions
	../input: checked_source, setup_diagnostic
	system: read_file, temp_dir, write_file
	fs: temporary_directory, resource_path, message
	test: TestSuite


private pure func selected_payload_acquires(selection: Own.OwnedSelection, arm: Own.OwnedJoinArm, expected: Lower.ValueId) -> Bool:
	selection.nodes.any(pure func(node):
		match node:
			Own.EnterArm(edge):
				if match_arm_number(edge.arm) == match_arm_number(arm.id):
					match (edge.operations, edge.transfers, arm.inputs):
						([Own.DefineValue(payload), Own.AcquireOwner(acquired, borrow, _)], [Own.OwnedReturn(value, moved)], [Own.ManagedJoinParameter(input, canonical)]):
							match (payload.operation, payload.result, borrow.source):
								(Own.PayloadDefinition(_, source), Own.BorrowedResult(Own.PayloadBorrow(parent)), Own.PayloadBorrow(backing)):
									(
										same_value(source, expected)
										and same_value(parent, expected)
										and same_value(backing, expected)
										and same_value(value, payload.id)
										and same_value(borrow.value, payload.id)
										and same_owner(acquired, moved)
										and not same_owner(acquired, canonical)
										and not same_value(input.id, payload.id)
									)
								_: False
						_: False
				else:
					False
			_: False
	)


private pure func helper_arm_acquires(selection: Own.OwnedSelection, arm: Own.OwnedJoinArm, expected: Own.BorrowSource, construct: Bool) -> Bool:
	match expected:
		Own.PayloadBorrow(parent):
			selected = selected_payload_acquires(selection, arm, parent)
			match arm.inputs:
				[Own.ManagedJoinParameter(input, input_owner)]:
					if construct:
						match arm.exit:
							Own.Yield(arm_yield):
								match (arm.operations, arm_yield.transfer):
									([Own.AcquireOwner(acquired, borrow, _), Own.DefineValue(result), Own.DropOwner(dropped, _)], Own.OwnedReturn(returned, moved)):
										match (borrow.source, result.operation, result.result):
											(Own.OwnerBorrow(backing), Own.ConstructDefinition(_, [Own.OwnedPayload(value, transferred)]), Own.OwnedResult(owner)):
												(
													selected
													and same_owner(backing, input_owner)
													and same_owner(dropped, input_owner)
													and same_value(value, input.id)
													and same_value(borrow.value, input.id)
													and same_owner(acquired, transferred)
													and same_value(returned, result.id)
													and same_owner(owner, moved)
													and arm_yield.carried.is_empty()
												)
											_: False
									_: False
							Own.TransferLoop(_, _): False
					else:
						match arm.exit:
							Own.Yield(arm_yield):
								match (arm.operations, arm_yield.transfer):
									([], Own.OwnedReturn(value, moved)):
										(
											selected
											and same_value(value, input.id)
											and same_owner(input_owner, moved)
											and arm_yield.carried.is_empty()
										)
									_: False
							Own.TransferLoop(_, _): False
				_: False
		Own.ParameterBorrow(parameter):
			if construct:
				match arm.exit:
					Own.Yield(arm_yield):
						match (arm.operations, arm_yield.transfer):
							([Own.AcquireOwner(acquired, borrow, _), Own.DefineValue(result)], Own.OwnedReturn(value, moved)):
								match (borrow.source, result.operation, result.result):
									(Own.ParameterBorrow(source), Own.ConstructDefinition(_, [Own.OwnedPayload(stored, transferred)]), Own.OwnedResult(owner)):
										(
											same_value(source, parameter)
											and same_value(borrow.value, parameter)
											and same_value(stored, parameter)
											and same_owner(acquired, transferred)
											and same_value(value, result.id)
											and same_owner(owner, moved)
											and arm_yield.carried.is_empty()
										)
									_: False
							_: False
					Own.TransferLoop(_, _): False
			else:
				match arm.exit:
					Own.Yield(arm_yield):
						match (arm.operations, arm_yield.transfer):
							([Own.AcquireOwner(acquired, borrow, _)], Own.OwnedReturn(value, moved)):
								match borrow.source:
									Own.ParameterBorrow(source):
										(
											same_value(source, parameter)
											and same_value(borrow.value, parameter)
											and same_value(value, parameter)
											and same_owner(acquired, moved)
											and arm_yield.carried.is_empty()
										)
									_: False
							_: False
					Own.TransferLoop(_, _): False
		_: False

func test_library_helpers_acquire_selected_values_and_leave_predicate_inputs_borrowed() -> Bool:
	loaded = load_program("blorp_2/test/e2e/fixtures/generic/managed/option_result_helpers.brp", "blorp_2/standard_library").map_err(func(failure): failure.diagnostic.message)
	owned = loaded.and_then(pure func(input): check(input.program).map_err(pure func(failure): setup_diagnostic(failure).message))
		.and_then(pure func(input): Concrete.specialize(input).map_err(pure func(error): error.message))
		.and_then(pure func(input): Lower.lower(input).map_err(pure func(error): error.message))
		.and_then(pure func(input): Own.own(input).map_err(pure func(error): error.message))
	match owned:
		Err(error):
			print_error(error)
			False
		Ok(program):
			var selected = 0
			var predicates = 0
			var passed = True
			for function in program.functions:
				match (function.signature.parameters, function.signature.return_type, function.operations, function.result):
					(
						[Concrete.UnionType(_), Concrete.StringType], _,
						[Own.DefineValue(optional), Own.DefineValue(default), Own.ExecuteJoin(matched)],
						Own.OwnedReturn(function_result, function_owner),
					):
						selected = selected + 1
						output = match matched.result:
							Own.ManagedJoinParameter(joined, owner):
								same_value(joined.id, function_result) and same_owner(owner, function_owner)
							_: False
						construct = match function.signature.return_type:
							Concrete.UnionType(_): True
							_: False
						arms = match matched.arms:
							[some, none]:
								(
									helper_arm_acquires(matched.selection, some, Own.PayloadBorrow(optional.id), construct)
									and helper_arm_acquires(matched.selection, none, Own.ParameterBorrow(default.id), construct)
								)
							_: False
						passed = passed and output and matched.carried.is_empty() and parameter_scrutinee(matched.selection.scrutinee, optional.id) and arms
					(
						[Concrete.UnionType(_)], Concrete.UnionType(_),
						[Own.DefineValue(parameter), Own.ExecuteJoin(matched)],
						Own.UnmanagedReturn(function_result),
					):
						predicates = predicates + 1
						output = match matched.result:
							Own.UnmanagedJoinParameter(joined): same_value(joined.id, function_result)
							_: False
						arms = matched.arms.all(pure func(arm):
							match arm.exit:
								Own.Yield(arm_yield):
									match (arm.operations, arm_yield.transfer):
										([Own.DefineValue(value)], Own.UnmanagedReturn(returned)):
											match (value.operation, value.result):
												(Own.ConstructDefinition(_, []), Own.UnmanagedResult):
													same_value(value.id, returned) and arm_yield.carried.is_empty()
												_: False
										_: False
								Own.TransferLoop(_, _): False
						)
						passed = (
							passed
							and output
							and matched.carried.is_empty()
							and parameter_scrutinee(matched.selection.scrutinee, parameter.id)
							and matched.arms.length() == 2
							and arms
						)
					_: void
			passed and selected == 2 and predicates == 3


private pure func callback_arm_transfers(selection: Own.OwnedSelection, arm: Own.OwnedJoinArm, parent: Lower.ValueId) -> Bool:
	match arm.exit:
		Own.Yield(arm_yield):
			match (arm.inputs, arm.operations, arm_yield.transfer):
				([Own.ManagedJoinParameter(input, input_owner)], [Own.DefineValue(call), Own.DropOwner(input_drop, _), Own.AcquireOwner(acquired, borrow, _), Own.DefineValue(result), Own.DropOwner(dropped, _)], Own.OwnedReturn(returned, moved)):
					match ((call.operation, call.result, result.operation, result.result), borrow.source):
						((Own.CallDefinition(Concrete.UserFunction(_), [Own.BorrowedArgument(argument)]), Own.OwnedResult(child), Own.ConstructDefinition(_, [Own.OwnedPayload(value, transferred)]), Own.OwnedResult(owner)), Own.OwnerBorrow(backing)):
							match argument.source:
								Own.OwnerBorrow(input_backing):
									(
										selected_payload_acquires(selection, arm, parent)
										and same_value(argument.value, input.id)
										and same_owner(input_backing, input_owner)
										and same_owner(input_drop, input_owner)
										and same_value(value, call.id)
										and same_value(borrow.value, call.id)
										and same_owner(backing, child)
										and same_owner(dropped, child)
										and same_owner(acquired, transferred)
										and not same_owner(child, acquired)
										and not same_owner(child, owner)
										and not same_owner(acquired, owner)
										and same_value(returned, result.id)
										and same_owner(moved, owner)
									)
								_: False
						_: False
				_: False
		Own.TransferLoop(_, _): False

private func library_callback_ownership() -> Result[Bool, String]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-callback-ownership-") on error => message(error):
		source: String =
			|import:
			|    result as Results
			|pure func identity[T](value: T) -> T:
			|    value
			|func main() -> Int:
			|    argument: Result[String, String] = Err("bypass")
			|    unused = Results.map(argument, identity)
			|    0
			|
		path = directory.resource_path() + "/main.brp"
		written ?= write_file(path, source)
		loaded ?= load_program(path, "blorp_2/standard_library").map_err(func(failure): failure.diagnostic.message)
		checked ?= check(loaded.program).map_err(pure func(failure): setup_diagnostic(failure).message)
		concrete ?= Concrete.specialize(checked).map_err(pure func(error): error.message)
		lowered ?= Lower.lower(concrete).map_err(pure func(error): error.message)
		program ?= Own.own(lowered).map_err(pure func(error): error.message)
		main ?= program.functions.get(Concrete.function_number(entry_function(program.entrypoint))).to_result("missing main")
		calls = main.operations.filter(pure func(operation):
			match operation:
				Own.DefineValue(value):
					match value.operation:
						Own.CallDefinition(Concrete.UserFunction(_), _): True
						_: False
				_: False
		)
		match calls:
			[Own.DefineValue(call)]:
				match call.operation:
					Own.CallDefinition(Concrete.UserFunction(target), _):
						function ?= program.functions.get(Concrete.function_number(target)).to_result("missing map instance")
						match (function.signature.parameters, function.signature.return_type, function.operations, function.result):
							([Concrete.UnionType(input)], Concrete.UnionType(output), [Own.DefineValue(parameter), Own.ExecuteJoin(matched)], Own.OwnedReturn(function_result, function_owner)):
								output_matches = match matched.result:
									Own.ManagedJoinParameter(joined, owner): same_value(joined.id, function_result) and same_owner(owner, function_owner)
									_: False
								match (parameter.operation, parameter.result, matched.arms):
									(Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(borrowed)), [selected, bypassed]):
										Ok(
											Concrete.union_number(input) == Concrete.union_number(output)
											and same_value(parameter.id, borrowed) and parameter_scrutinee(matched.selection.scrutinee, parameter.id)
											and callback_arm_transfers(matched.selection, selected, parameter.id)
											and helper_arm_acquires(matched.selection, bypassed, Own.PayloadBorrow(parameter.id), True)
											and output_matches and matched.carried.is_empty()
										)
									_: Ok(False)
							_: Ok(False)
					_: Ok(False)
			_: Ok(False)


func test_library_callback_borrows_input_and_transfers_selected_or_bypassed_owners() -> Bool:
	library_callback_ownership().get_or(False)


private func query_ownership() -> Result[Bool, String]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-list-query-owners-") on error => message(error):
		source: String =
			|import:
			|    list: get_or, last
			|    int as IntOps
			|pure func escape() -> Option[String]:
			|    last([IntOps.to_string(42)])
			|func main() -> Int:
			|    selected = get_or(["value"], 0, "default")
			|    escaped = escape()
			|    0
			|
		path = directory.resource_path() + "/main.brp"
		written ?= write_file(path, source)
		loaded ?= load_program(path, "blorp_2/standard_library").map_err(func(failure): failure.diagnostic.message)
		checked ?= check(loaded.program).map_err(pure func(failure): setup_diagnostic(failure).message)
		concrete ?= Concrete.specialize(checked).map_err(pure func(error): error.message)
		lowered ?= Lower.lower(concrete).map_err(pure func(error): error.message)
		program ?= Own.own(lowered).map_err(pure func(error): error.message)
		verified ?= verify(program).map_err(pure func(error): error.message)
		var fallback = 0
		var escaped = 0
		var passed = True
		for function in program.functions:
			match (function.signature.parameters, function.signature.return_type, function.operations, function.result):
				([Concrete.ListType(Concrete.StringType), Concrete.IntType, Concrete.StringType], Concrete.StringType, [Own.DefineValue(values), Own.DefineValue(_), Own.DefineValue(default), Own.DefineValue(optional), Own.ExecuteJoin(matched), Own.DropOwner(retired, _)], Own.OwnedReturn(returned, transferred)):
					fallback = fallback + 1
					match (optional.result, matched.arms, matched.result):
						(Own.OwnedResult(parent), [some, none], Own.ManagedJoinParameter(joined, result_owner)):
							scrutinee = match matched.selection.scrutinee:
								Own.BorrowedArgument(borrow):
									match borrow.source:
										Own.OwnerBorrow(actual): same_owner(actual, parent) and same_value(borrow.value, optional.id)
										_: False
								_: False
							passed = (
								passed and scrutinee and matched.carried.is_empty()
								and same_owner(parent, retired)
								and same_value(joined.id, returned) and same_owner(result_owner, transferred)
								and not same_owner(parent, result_owner)
								and helper_arm_acquires(matched.selection, some, Own.PayloadBorrow(optional.id), False)
								and helper_arm_acquires(matched.selection, none, Own.ParameterBorrow(default.id), False)
							)
						_: passed = False
				([], Concrete.UnionType(_), _, Own.OwnedReturn(returned, transferred)):
					match function.operations.reverse():
						[Own.DropOwner(retired, _), Own.DefineValue(result), Own.DropOwner(original, _), Own.DefineValue(backing), Own.AcquireOwner(stored, source, _), Own.DefineValue(payload), ..._]:
							match (backing.result, result.operation, result.result):
								(Own.OwnedResult(parent), Own.CallDefinition(Concrete.UserFunction(_), [Own.BorrowedArgument(borrow)]), Own.OwnedResult(child)):
									match (payload.result, backing.operation, source.source):
										(Own.OwnedResult(initial), Own.ConstructListDefinition([Own.OwnedPayload(value, storage)]), Own.OwnerBorrow(origin)):
											match borrow.source:
												Own.OwnerBorrow(owner):
													escaped = escaped + 1
													passed = (
														passed and same_owner(parent, retired) and same_owner(parent, owner) and same_value(backing.id, borrow.value)
														and same_value(result.id, returned) and same_owner(child, transferred) and not same_owner(parent, child)
														and same_owner(initial, original) and same_owner(initial, origin)
														and same_value(payload.id, source.value) and same_value(payload.id, value)
														and same_owner(stored, storage) and not same_owner(initial, stored)
													)
												_: passed = False
										_: passed = False
								_: passed = False
						_: passed = False
				_: void
		Ok(passed and fallback == 1 and escaped == 1)


func test_list_queries_acquire_each_selected_return_before_retiring_its_container() -> Bool:
	query_ownership().get_or(False)


private FRESH_SOURCE: String =
	|import:
	|	int: Int methods_only
	|	string: String methods_only
	|fixed union Box[T]:
	|	Box(T)
	|pure func fresh() -> Box[String]:
	|	Box(42.to_string())
	|pure func unbox[T](value: Box[T]) -> T:
	|	match value:
	|		Box(payload): payload
	|func main() -> Int:
	|	unused = 0
	|	unbox(fresh()).length()
	|

private FRESH_INPUTS: List[ModuleInput] = [
	{
		source = FRESH_SOURCE,
		targets = [1, 2]
	},
	{
		source = INTEGER_OPERATIONS,
		targets = []
	},
	{
		source = STRING_OPERATIONS,
		targets = []
	},
]


private pure func same_value(left: Lower.ValueId, right: Lower.ValueId) -> Bool:
	IntOps.equals(
		Lower.value_number(left),
		Lower.value_number(right),
	)


private pure func same_owner(left: Own.OwnerId, right: Own.OwnerId) -> Bool:
	IntOps.equals(
		Own.owner_number(left),
		Own.owner_number(right),
	)


private pure func owns(result: Own.ResultOwnership, expected: Int) -> Bool:
	match result:
		Own.OwnedResult(owner):
			IntOps.equals(
				Own.owner_number(owner),
				expected,
			)
		_:
			False


private func contains_function(
	inputs: List[ModuleInput],
	accepts: pure (Own.OwnedFunction) -> Bool,
) -> Bool:
	match lowered_modules(inputs).and_then(pure func(program): Own.own(program)):
		Err(error):
			print_error(error.message)
			False
		Ok(program):
			program.functions.any(accepts)


private pure func constructor_transfers_child(function: Own.OwnedFunction) -> Bool:
	match function.operations:
		[Own.DefineValue(parameter), Own.AcquireOwner(child, borrow, _), Own.DefineValue(box)]:
			match box.operation:
				Own.ConstructDefinition(_, [Own.OwnedPayload(value, transferred)]):
					match box.result:
						Own.OwnedResult(parent):
							match function.result:
								Own.OwnedReturn(result, returned):
									IntOps.equals(
										Lower.value_number(value),
										Lower.value_number(parameter.id),
									) and IntOps.equals(
										Lower.value_number(borrow.value),
										Lower.value_number(value),
									) and IntOps.equals(
										Lower.value_number(result),
										Lower.value_number(box.id),
									) and IntOps.equals(
										Own.owner_number(child),
										0,
									) and IntOps.equals(
										Own.owner_number(transferred),
										Own.owner_number(child),
									) and IntOps.equals(
										Own.owner_number(parent),
										1,
									) and IntOps.equals(
										Own.owner_number(returned),
										Own.owner_number(parent),
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


func test_borrowed_child_acquisition_is_transferred_to_the_inline_owner() -> Bool:
	-- Read the real fixture so host CTFE cannot hide runtime compiler lifetimes.
	match read_file("blorp_2/test/e2e/fixtures/generic/managed/basic.brp"):
		Err(error):
			print_error(error)
			False
		Ok(source):
			match (
				lowered_modules([
					{
						source = source,
						targets = [1, 2]
					},
					{
						source = INTEGER_OPERATIONS,
						targets = []
					},
					{
						source = STRING_OPERATIONS,
						targets = []
					},
				]).and_then(pure func(program): Own.own(program))
			):
				Err(error):
					print_error(error.message)
					False
				Ok(program):
					program.functions.any(constructor_transfers_child)


func test_constant_source_has_the_same_child_transfer() -> Bool:
	match lowered_modules(BOX_INPUTS).and_then(pure func(program): Own.own(program)):
		Err(error):
			print_error(error.message)
			False
		Ok(program):
			program.functions.any(constructor_transfers_child)


private pure func fresh_acquires_child_before_dropping_original(function: Own.OwnedFunction) -> Bool:
	match function.operations:
		[Own.DefineValue(_), Own.DefineValue(text), Own.AcquireOwner(acquired, borrow, _), Own.DefineValue(box), Own.DropOwner(original, _)]:
			match (box.operation, borrow.source, function.result):
				(Own.ConstructDefinition(_, [Own.OwnedPayload(value, child)]), Own.OwnerBorrow(backing), Own.OwnedReturn(result, parent)):
					(
						same_value(value, text.id)
						and same_value(borrow.value, text.id)
						and same_value(result, box.id)
						and same_owner(child, acquired)
						and same_owner(backing, original)
						and Own.owner_number(original) == 0
						and Own.owner_number(child) == 1
						and Own.owner_number(parent) == 2
						and owns(text.result, 0)
						and owns(box.result, 2)
					)
				_: False
		_: False


func test_final_constructor_use_acquires_child_and_drops_original() -> Bool:
	contains_function(FRESH_INPUTS, fresh_acquires_child_before_dropping_original)


private pure func fresh_function(function: Lower.LoweredFunction) -> Bool:
	match function.steps:
		[Lower.Define(_), Lower.Define(_), Lower.Define(constructed)]:
			match constructed.operation:
				Lower.ConstructValue(_, [_]):
					True
				_:
					False
		_:
			False


private pure func later_use_input(program: Lower.LoweredProgram) -> Option[Lower.LoweredFunction]:
	contents = Lower.lowered_functions(program)

	match contents.functions.find(fresh_function):
		Some(function):
			match contents.functions.get(
				Concrete.function_number(entry_function(contents.entrypoint)),
			):
				Some(main):
					match main.steps:
						[Lower.Define(_), Lower.Define(_), Lower.Define(_), Lower.Define(length)]:
							match function.steps:
								[Lower.Define(integer), Lower.Define(text), Lower.Define(box)]:
									match length.operation:
										Lower.CallValue(call, _):
											Some(
												{ function |
													steps = [
														integer,
														text,
														box,
														{ length |
															operation = Lower.CallValue(
																call,
																[text.id],
															)
														},
													].map(pure func(definition): Lower.Define(definition))
												},
											)
										_:
											None
								_:
									None
						_:
							None
				_:
					None
		None:
			None


private pure func later_use_acquires(function: Own.OwnedFunction) -> Bool:
	match function.operations:
		[Own.DefineValue(_), Own.DefineValue(text), Own.AcquireOwner(child, borrow, _), Own.DefineValue(box), Own.DefineValue(length), Own.DropOwner(original, _)]:
			match box.operation:
				Own.ConstructDefinition(_, [Own.OwnedPayload(value, transferred)]):
					match borrow.source:
						Own.OwnerBorrow(source):
							(
								same_value(value, text.id)
								and same_value(borrow.value, text.id)
								and IntOps.equals(
									Own.owner_number(source),
									0,
								)
								and same_owner(source, original)
								and owns(text.result, 0)
								and IntOps.equals(
									Own.owner_number(child),
									1,
								)
								and same_owner(child, transferred)
								and owns(box.result, 2)
								and Concrete.same_type(length.value_type, Concrete.IntType)
							)
						_:
							False
				_:
					False
		_:
			False


func test_later_child_use_acquires_a_separate_obligation_before_construction() -> Bool:
	match lowered_modules(FRESH_INPUTS):
		Err(_):
			False
		Ok(program):
			match later_use_input(program):
				None:
					False
				Some(function):
					contents = Lower.lowered_functions(program)

					match Own.insert_function(function, contents.unions, contents.records):
						Err(error):
							print_error(error.message)
							False
						Ok(result):
							later_use_acquires(result)


func test_last_uses_keep_constructor_and_later_child_use_distinct() -> Bool:
	match lowered_modules(FRESH_INPUTS):
		Err(_):
			False
		Ok(program):
			match later_use_input(program):
				None:
					False
				Some(function):
					match Own.last_uses(function.steps, function.result):
						Ok(uses):
							-- Int is read at 1; String at 2 and 3; Box returns at 4.
							-- The appended length result is unused.
							uses == [Some(1), Some(3), Some(4), None]
						Err(error):
							print_error(error.message)
							False


private pure func parameter_scrutinee(argument: Own.OwnedArgument, expected: Lower.ValueId) -> Bool:
	match argument:
		Own.BorrowedArgument(borrow):
			match borrow.source:
				Own.ParameterBorrow(source):
					same_value(borrow.value, expected) and same_value(source, expected)
				_:
					False
		_:
			False


private pure func projection_borrows_immediate_parent(function: Own.OwnedFunction) -> Bool:
	match function.operations:
		[Own.DefineValue(parameter), Own.ExecuteJoin(matched)]:
			match (matched.arms, function.result):
				([arm], Own.OwnedReturn(_, _)):
					(
						parameter_scrutinee(matched.selection.scrutinee, parameter.id)
						and helper_arm_acquires(matched.selection, arm, Own.PayloadBorrow(parameter.id), False)
					)
				_: False
		_: False

func test_extraction_acquires_through_the_immediate_parent_value() -> Bool:
	contains_function(BOX_INPUTS, projection_borrows_immediate_parent)


private func contains_fixture(
	path: String,
	targets: List[Int],
	dependencies: List[ModuleInput],
	accepts: pure (Own.OwnedFunction) -> Bool,
) -> Bool:
	match read_file(path):
		Err(error):
			print_error(error)
			False
		Ok(source):
			contains_function(
				[
					{
						source = source,
						targets = targets
					},
				].concat(dependencies),
				accepts,
			)


private pure func nullary_owns(function: Own.OwnedFunction) -> Bool:
	match function.operations:
		[Own.DefineValue(value)]:
			match value.operation:
				Own.ConstructDefinition(_, []):
					match function.result:
						Own.OwnedReturn(result, owner):
							(
								same_value(result, value.id)
								and owns(value.result, 0)
								and IntOps.equals(
									Own.owner_number(owner),
									0,
								)
							)
						_:
							False
				_:
					False
		_:
			False


func test_payload_free_construct_has_the_uniform_aggregate_obligation() -> Bool:
	contains_fixture(
		"blorp_2/test/e2e/fixtures/generic/managed/nullary_variant.brp",
		[1, 2],
		[
			{
				source = INTEGER_OPERATIONS,
				targets = []
			},
			{
				source = STRING_OPERATIONS,
				targets = []
			},
		],
		nullary_owns,
	)


private pure func unmanaged_payload_owns(function: Own.OwnedFunction) -> Bool:
	match function.operations:
		[Own.DefineValue(parameter), Own.DefineValue(value)]:
			match value.operation:
				Own.ConstructDefinition(_, [Own.UnmanagedPayload(child)]):
					(
						same_value(child, parameter.id)
						and owns(value.result, 0)
						and Concrete.same_type(parameter.value_type, Concrete.IntType)
					)
				_:
					False
		_:
			False


func test_unmanaged_active_payload_still_has_the_aggregate_obligation() -> Bool:
	contains_fixture(
		"blorp_2/test/e2e/fixtures/generic/managed/unmanaged_variant.brp",
		[1, 2],
		[
			{
				source = INTEGER_OPERATIONS,
				targets = []
			},
			{
				source = STRING_OPERATIONS,
				targets = []
			},
		],
		unmanaged_payload_owns,
	)


func test_representation_query_names_the_inline_owned_layout() -> Bool:
	match lowered_modules(BOX_INPUTS):
		Err(_):
			False
		Ok(program):
			contents = Lower.lowered_functions(program)
			contents.functions.any(pure func(function):
				match function.signature.return_type:
					Concrete.UnionType(id):
						match Concrete.value_ownership(
							function.signature.return_type,
							contents.unions,
							contents.records,
						):
							Ok(Concrete.InlineOwnedFields(layout)):
								IntOps.equals(
									Concrete.union_number(layout),
									Concrete.union_number(id),
								)
							_:
								False
					_:
						False
			)


private pure func loop_rejects(source: String, signature: Bool) -> Bool:
	match checked_source(source):
		Err(_):
			False
		Ok(program):
			checked_functions(program).functions.any(pure func(function):
				match function.execution:
					SelfTailLoop(annotation):
						expected = if signature:
							Some(annotation)
						else:
							match function.statements.get(0):
								Some(Checked.InitializeBinding(_, first)):
									match first.form:
										Checked.InvokeFunction(call): Some(call.span)
										_: None
								_: None
						match (expected, Concrete.specialize(program)):
							(Some(at), Err(error)):
								(
									error.message == "managed values in @tail_recursive functions are not supported yet"
									and error.help == "use an unmanaged helper, or remove @tail_recursive"
									and same_span(error.span, at)
									and error.note.is_none()
								)
							_: False
					_:
						False
			)


func test_inline_owning_signature_is_rejected_at_the_loop_annotation() -> Bool:
	source: String =
		|fixed union Box[T]:
		|	Box(T)
		|@tail_recursive
		|pure func loop(value: Box[String]) -> Box[String]:
		|	loop(value)
		|func main() -> Int:
		|	unused = loop(Box("seed"))
		|	0
		|
	loop_rejects(source, True)


func test_inline_owning_intermediate_is_rejected_at_its_definition() -> Bool:
	source: String =
		|fixed union Choice[T]:
		|	Empty
		|	Text(T)
		|pure func empty() -> Choice[String]:
		|	Empty
		|@tail_recursive
		|pure func loop() -> Int:
		|	unused = empty()
		|	loop()
		|func main() -> Int:
		|	loop()
		|
	loop_rejects(source, False)


func test_unused_prefix_drops_before_tail_join() -> Bool:
	source: String =
		|import:
		|	int: Int methods_only
		|fixed union Box[T]:
		|	Box(T)
		|pure func inspect(value: Box[String]) -> String:
		|	unused = 42.to_string()
		|	match value:
		|		Box(payload): payload
		|func main() -> Int:
		|	unused = inspect(Box("seed"))
		|	0
		|

	match (
		lowered_modules([
			{
				source = source,
				targets = [1]
			},
			{
				source = INTEGER_OPERATIONS,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(program):
			contents = Lower.lowered_functions(program)
			contents.functions.any(pure func(function):
				match function.steps:
					[Lower.Define(_), Lower.Define(_), Lower.Define(text), Lower.Join(_)]:
						match Own.insert_function(function, contents.unions, contents.records):
							Ok(owned):
								match owned.operations:
									[Own.DefineValue(_), Own.DefineValue(_), Own.DefineValue(_), Own.DropOwner(prefix, at), Own.ExecuteJoin(matched)]:
										match matched.arms:
											[arm]:
												match arm.exit:
													Own.Yield(arm_yield):
														match (matched.selection.nodes, arm.inputs, arm.operations, arm_yield.transfer):
															([Own.EnterArm(edge)], [Own.ManagedJoinParameter(input, canonical)], [], Own.OwnedReturn(returned, transfer)):
																match edge.operations:
																	[Own.DefineValue(child), Own.AcquireOwner(acquired, borrow, _)]:
																		(
																			same_value(input.id, returned)
																			and same_value(borrow.value, child.id)
																			and same_owner(canonical, transfer)
																			and Own.owner_number(acquired) == 2
																			and Own.owner_number(prefix) == 0
																			and same_span(at, text.span)
																		)
																	_: False
															_: False
													Own.TransferLoop(_, _): False
											_:
												False
									_:
										False
							Err(_):
								False
					_:
						False
			)


private pure func aggregate_identity_acquires(function: Own.OwnedFunction) -> Bool:
	match (function.operations, function.result):
		([Own.DefineValue(parameter), Own.AcquireOwner(owner, borrow, _)], Own.OwnedReturn(result, returned)):
			match (parameter.value_type, parameter.result, borrow.source):
				(Concrete.UnionType(_), Own.BorrowedResult(Own.ParameterBorrow(parent)), Own.ParameterBorrow(source)):
					(
						same_value(result, parameter.id)
						and same_value(borrow.value, parameter.id)
						and same_value(parent, parameter.id)
						and same_value(source, parameter.id)
						and same_owner(owner, returned)
						and IntOps.equals(
							Own.owner_number(owner),
							0,
						)
					)
				_:
					False
		_:
			False


func test_aggregate_identity_acquires_an_independent_returned_owner() -> Bool:
	contains_fixture(
		"blorp_2/test/e2e/fixtures/generic/managed/shared_box.brp",
		[1, 2],
		[
			{
				source = INTEGER_OPERATIONS,
				targets = []
			},
			{
				source = STRING_OPERATIONS,
				targets = []
			},
		],
		aggregate_identity_acquires,
	)


private pure func unused_aggregate_drops(function: Own.OwnedFunction) -> Bool:
	match (function.operations, function.result):
		([Own.DefineValue(_), Own.DefineValue(text), Own.DefineValue(box), Own.DropOwner(child, _), Own.DropOwner(parent, _), Own.DefineValue(result)], Own.UnmanagedReturn(returned)):
			match box.value_type:
				Concrete.UnionType(_):
					owns(text.result, 0) and owns(box.result, 1) and IntOps.equals(
						Own.owner_number(child),
						0,
					) and IntOps.equals(
						Own.owner_number(parent),
						1,
					) and same_value(returned, result.id)
				_:
					False
		_:
			False


func test_unused_aggregate_drops_its_owner_after_the_call_argument_owner() -> Bool:
	contains_fixture(
		"blorp_2/test/e2e/fixtures/generic/managed/unused.brp",
		[1],
		[
			{
				source = INTEGER_OPERATIONS,
				targets = []
			},
		],
		unused_aggregate_drops,
	)


private pure func unused_constructor_retires_original_and_parent(function: Own.OwnedFunction) -> Bool:
	match (function.operations, function.result):
		([Own.DefineValue(_), Own.DefineValue(text), Own.AcquireOwner(child, borrow, _), Own.DefineValue(box), Own.DropOwner(original, _), Own.DropOwner(parent, _), Own.DefineValue(result)], Own.UnmanagedReturn(returned)):
			match box.operation:
				Own.ConstructDefinition(_, [Own.OwnedPayload(value, transferred)]):
					(
						same_value(value, text.id)
						and same_value(borrow.value, text.id)
						and owns(text.result, 0)
						and Own.owner_number(original) == 0
						and Own.owner_number(child) == 1
						and same_owner(child, transferred)
						and owns(box.result, 2)
						and Own.owner_number(parent) == 2
						and same_value(returned, result.id)
					)
				_: False
		_: False

func test_unused_constructor_retires_original_and_parent_obligations() -> Bool:
	match lowered_modules(FRESH_INPUTS):
		Err(_):
			False
		Ok(program):
			match later_use_input(program):
				Some(function):
					match function.steps:
						[Lower.Define(integer), Lower.Define(text), Lower.Define(box), Lower.Define(last)]:
							-- Reuse only this compilation's opaque identities and typed child.
							result = { last |
								operation = Lower.IntegerValue(0),
								value_type = Concrete.IntType
							}
							unused = { function |
								signature = { function.signature | return_type = Concrete.IntType },
								steps = [integer, text, box, result].map(pure func(definition): Lower.Define(definition)),
								result = result.id
							}
							contents = Lower.lowered_functions(program)

							match Own.insert_function(unused, contents.unions, contents.records):
								Ok(owned):
									unused_constructor_retires_original_and_parent(owned)
								Err(_):
									False
						_:
							False
				None:
					False


tests: TestSuite = {
	description = "Blorp 2 managed union ownership insertion",
	tests = [
		("List queries acquire selected returns before retiring their containers", test_list_queries_acquire_each_selected_return_before_retiring_its_container),
		(
			"library callback borrows input and transfers selected or bypassed owners",
			test_library_callback_borrows_input_and_transfers_selected_or_bypassed_owners,
		),
		(
			"library helpers acquire selected values and keep predicates borrowed",
			test_library_helpers_acquire_selected_values_and_leave_predicate_inputs_borrowed,
		),
		(
			"borrowed child acquisition transfers into the inline owner",
			test_borrowed_child_acquisition_is_transferred_to_the_inline_owner,
		),
		(
			"constant source has the same child transfer",
			test_constant_source_has_the_same_child_transfer,
		),
		(
			"final constructor use acquires child and drops original",
			test_final_constructor_use_acquires_child_and_drops_original,
		),
		(
			"later child use acquires a separate obligation",
			test_later_child_use_acquires_a_separate_obligation_before_construction,
		),
		(
			"last uses keep construction and later child use distinct",
			test_last_uses_keep_constructor_and_later_child_use_distinct,
		),
		(
			"extraction acquires through immediate parent ValueId",
			test_extraction_acquires_through_the_immediate_parent_value,
		),
		(
			"payload-free ConstructDefinition has uniform aggregate obligation",
			test_payload_free_construct_has_the_uniform_aggregate_obligation,
		),
		(
			"unmanaged active payload keeps aggregate obligation",
			test_unmanaged_active_payload_still_has_the_aggregate_obligation,
		),
		(
			"representation query names inline owned layout",
			test_representation_query_names_the_inline_owned_layout,
		),
		(
			"inline owning signature rejects at loop annotation",
			test_inline_owning_signature_is_rejected_at_the_loop_annotation,
		),
		(
			"inline owning intermediate rejects at its definition",
			test_inline_owning_intermediate_is_rejected_at_its_definition,
		),
		(
			"unused prefix drops before tail join",
			test_unused_prefix_drops_before_tail_join,
		),
		(
			"aggregate identity acquires independent returned owner",
			test_aggregate_identity_acquires_an_independent_returned_owner,
		),
		(
			"unused aggregate drops after call argument owner",
			test_unused_aggregate_drops_its_owner_after_the_call_argument_owner,
		),
		(
			"unused constructor retires original and parent obligations",
			test_unused_constructor_retires_original_and_parent_obligations,
		),
	]
}
