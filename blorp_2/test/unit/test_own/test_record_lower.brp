import:
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/lex/lex: lex
	../../../src/lower/lower:
		LoweredExit(ReturnValue),
		LoweredProgram,
		LoweredTail(ExitValue),
		ValueOperation(IntegerValue, CallValue, ConstructRecordValue, ReadRecordFieldValue),
		lower,
		lowered_functions,
		value_number,
	../../../src/own/own:
		OwnedExit(ReturnResult),
		OwnedTail(ReturnTail),
		OwnedValueOperation(
			IntegerDefinition, ConstructRecordDefinition, ReadRecordFieldDefinition,
		),
		OwnershipOperation(DefineValue),
		ResultOwnership(UnmanagedResult),
		ReturnTransfer(UnmanagedReturn),
		block_last_uses,
		own,
	../../../src/specialize/specialize: CallTarget(UserFunction), field_number, function_number, specialize
	../../../src/utils/syntax: Diagnostic
	../input: check, parse, setup_diagnostic
	test: TestSuite


private PAIR: String =
	|fixed record Pair { first: Int, second: Int }
	|


private pure func fixture(source: String) -> Result[LoweredProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialize(checked).and_then(pure func(program): lower(program))


pure func test_fields_evaluate_once_in_written_order_before_construction() -> Bool:
	source: String =
		|func observe(value: Int) -> Int:
		|	value
		|func make_pair() -> Pair:
		|	{ second = observe(9), first = observe(7) }
		|func main() -> Int:
		|	unused = make_pair()
		|	0
		|

	match fixture(PAIR + source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[main_function, make, _]:
					match make.definitions:
						[nine, second, seven, first, construction]:
							match (
								(
									nine.operation,
									second.operation,
									seven.operation,
									first.operation,
								),
								construction.operation,
							):
								((IntegerValue(nine_value), CallValue(second_call, [second_argument]), IntegerValue(seven_value), CallValue(first_call, [first_argument])), ConstructRecordValue(_, [right, left])):
									match (second_call.target, first_call.target):
										(UserFunction(second_target), UserFunction(first_target)):
											match main_function.definitions:
												[unused, zero]:
													match unused.operation:
														CallValue(_, []):
															(
																nine_value == 9
																and seven_value == 7
																and value_number(
																	second_argument,
																) == 0
																and value_number(
																	first_argument,
																) == 2
																and value_number(right.value) == 1
																and value_number(left.value) == 3
																and value_number(
																	construction.id,
																) == 4
																and field_number(right.field) == 1
																and field_number(left.field) == 0
																and function_number(
																	second_target,
																) == 2
																and function_number(
																	first_target,
																) == 2
																and value_number(zero.id) == 1
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_projection_receiver_is_evaluated_once() -> Bool:
	source: String =
		|pure func make_pair() -> Pair:
		|	{ first = 7, second = 9 }
		|func main() -> Int:
		|	make_pair().first
		|

	match fixture(PAIR + source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[main_function, _]:
					match main_function.definitions:
						[receiver, projected]:
							match (receiver.operation, projected.operation):
								(CallValue(_, []), ReadRecordFieldValue(field, source)):
									(
										value_number(receiver.id) == 0
										and value_number(source) == 0
										and value_number(projected.id) == 1
										and field_number(field) == 0
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_reassignment_preserves_record_alias_identity() -> Bool:
	source: String =
		|pure func make_pair() -> Pair:
		|	{ first = 7, second = 9 }
		|func main() -> Int:
		|	var current = make_pair()
		|	original = current
		|	current = { first = 1, second = 2 }
		|	original.first
		|

	match fixture(PAIR + source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[main_function, _]:
					match main_function.definitions:
						[original, _, _, replacement, projected]:
							match (replacement.operation, projected.operation):
								(ConstructRecordValue(_, _), ReadRecordFieldValue(_, source)):
									(
										value_number(original.id) == 0
										and value_number(replacement.id) == 3
										and value_number(source) == 0
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_last_uses_include_every_record_operand_and_projection() -> Bool:
	source: String =
		|pure func make_pair() -> Pair:
		|	{ second = 9, first = 7 }
		|func main() -> Int:
		|	make_pair().first
		|

	match fixture(PAIR + source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[main_function, make]:
					match (make.tail, main_function.tail):
						(ExitValue(ReturnValue(constructed)), ExitValue(ReturnValue(projected))):
							match (
								block_last_uses(make.definitions, constructed, 0, 0),
								block_last_uses(main_function.definitions, projected, 0, 0),
							):
								(Ok(make_uses), Ok(main_uses)):
									(
										make_uses == [Some(2), Some(2), Some(3)]
										and main_uses == [Some(1), Some(2)]
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_insertion_preserves_record_operations_without_owners() -> Bool:
	source: String =
		|pure func make_pair() -> Pair:
		|	{ first = -9223372036854775808, second = 9223372036854775807 }
		|func main() -> Int:
		|	make_pair().first
		|

	match fixture(PAIR + source).and_then(pure func(program): own(program)):
		Err(_):
			False
		Ok(program):
			match program.functions:
				[main_function, make]:
					match (
						make.operations,
						main_function.operations,
						make.tail,
						main_function.tail,
					):
						([DefineValue(low), DefineValue(high), DefineValue(constructed)], [DefineValue(_), DefineValue(projected)], ReturnTail(ReturnResult(UnmanagedReturn(_))), ReturnTail(ReturnResult(UnmanagedReturn(_)))):
							match (
								low.operation,
								high.operation,
								(
									constructed.operation,
									projected.operation,
									constructed.result,
									projected.result,
								),
							):
								(IntegerDefinition(low_value), IntegerDefinition(high_value), (ConstructRecordDefinition(_, [_, _]), ReadRecordFieldDefinition(_, _), UnmanagedResult, UnmanagedResult)):
									(
										low_value == -9223372036854775808
										and high_value == 9223372036854775807
									)
								_:
									False
						_:
							False
				_:
					False


tests: TestSuite = {
	description = "Fixed record lowering and ownership insertion",
	tests = [
		(
			"written field order exactly once including unused initializer",
			test_fields_evaluate_once_in_written_order_before_construction,
		),
		("projection receiver exactly once", test_projection_receiver_is_evaluated_once),
		(
			"whole record reassignment preserves old alias",
			test_reassignment_preserves_record_alias_identity,
		),
		("record operand last uses", test_last_uses_include_every_record_operand_and_projection),
		(
			"record insertion has no ownership operations",
			test_insertion_preserves_record_operations_without_owners,
		),
	]
}
