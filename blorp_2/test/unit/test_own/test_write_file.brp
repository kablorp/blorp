import:
	../../../src/check/model: match_arm_number
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: entry_function
	../file_write_inputs: FILE_WRITE_SOURCE, file_write_seed, file_write_seed_from_source
	../module_input: TEST_BASE
	test: TestSuite


pure func test_two_parameters_remain_borrowed_and_result_transfers() -> Bool:
	match file_write_seed(TEST_BASE):
		Err(_): False
		Ok(seed):
			match Own.insert_function(seed.query, Lower.lowered_functions(seed.lowered).unions, []):
				Err(_): False
				Ok(function):
					match (function.operations, function.result):
						([Own.DefineValue(path), Own.DefineValue(contents), Own.DefineValue(result)], Own.OwnedReturn(value, transferred)):
							match (result.operation, result.result):
								(Own.CallDefinition(_, [Own.BorrowedArgument(first), Own.BorrowedArgument(second)]), Own.OwnedResult(owner)):
									(Lower.value_number(first.value) == Lower.value_number(path.id)
										and Lower.value_number(second.value) == Lower.value_number(contents.id)
										and Lower.value_number(value) == Lower.value_number(result.id)
											and Own.owner_number(owner) == Own.owner_number(transferred))
								_: False
						_: False


private pure func escaped_function() -> Option[Own.OwnedFunction]:
	match file_write_seed(TEST_BASE):
		Err(_): None
		Ok(seed):
			match Own.own(seed.lowered):
				Err(_): None
				Ok(program): program.functions.get(Concrete.function_number(seed.escape))


pure func test_same_string_is_borrowed_twice_without_acquisition() -> Bool:
	match escaped_function():
		Some(function):
			match function.operations:
				[Own.DefineValue(path), Own.DefineValue(result), Own.ExecuteJoin(_), Own.DropOwner(_, _)]:
					match result.operation:
						Own.CallDefinition(_, [Own.BorrowedArgument(first), Own.BorrowedArgument(second)]):
							match (first.source, second.source):
								(Own.ParameterBorrow(first_source), Own.ParameterBorrow(second_source)):
									(Lower.value_number(first.value) == Lower.value_number(path.id)
										and Lower.value_number(second.value) == Lower.value_number(path.id)
										and Lower.value_number(first_source) == Lower.value_number(path.id)
										and Lower.value_number(second_source) == Lower.value_number(path.id))
								_: False
						_: False
				_: False
		None: False


pure func test_void_projection_is_unmanaged_and_error_acquires_before_parent_drop() -> Bool:
	match escaped_function():
		Some(function):
			match (function.operations, function.result):
				([_, Own.DefineValue(parent), Own.ExecuteJoin(matched), Own.DropOwner(dropped, _)], Own.OwnedReturn(joined, transferred)):
					match (parent.result, matched.result, matched.arms):
						(Own.OwnedResult(parent_owner), Own.ManagedJoinParameter(result, result_owner), [ok, error]):
							match (matched.selection.nodes, ok.inputs, error.inputs):
								([Own.EnterArm(error_edge), Own.EnterArm(ok_edge), Own.TestVariant(_, _, _, _)], [Own.UnmanagedJoinParameter(done)], [Own.ManagedJoinParameter(input, canonical)]):
									match (ok_edge.operations, ok_edge.transfers, ok.operations):
										([Own.DefineValue(projected)], [Own.UnmanagedReturn(ok_value)], [Own.DefineValue(_)]):
											match (projected.operation, projected.value_type, projected.result):
												(Own.PayloadDefinition(_, ok_source), Concrete.VoidType, Own.UnmanagedResult):
													match error.exit:
														Own.Yield(outputs):
															match (error_edge.operations, error_edge.transfers, outputs.transfer):
																([Own.DefineValue(child), Own.AcquireOwner(acquired, borrow, _)], [Own.OwnedReturn(selected, moved)], Own.OwnedReturn(value, returned)):
																	match (child.result, borrow.source):
																		(Own.BorrowedResult(Own.PayloadBorrow(source)), Own.PayloadBorrow(borrowed)):
																			(Own.owner_number(dropped) == Own.owner_number(parent_owner)
																				and Lower.value_number(joined) == Lower.value_number(result.id)
																				and Own.owner_number(transferred) == Own.owner_number(result_owner)
																				and Concrete.same_type(done.value_type, Concrete.VoidType) and Lower.value_number(ok_source) == Lower.value_number(parent.id)
																				and Lower.value_number(ok_value) == Lower.value_number(projected.id) and match_arm_number(ok_edge.arm) == match_arm_number(ok.id)
																				and match_arm_number(error_edge.arm) == match_arm_number(error.id) and error.operations.is_empty()
																				and Lower.value_number(source) == Lower.value_number(parent.id) and Lower.value_number(borrowed) == Lower.value_number(parent.id)
																				and Lower.value_number(borrow.value) == Lower.value_number(child.id) and Lower.value_number(selected) == Lower.value_number(child.id)
																				and Own.owner_number(acquired) == Own.owner_number(moved) and Own.owner_number(acquired) != Own.owner_number(canonical)
																				and Lower.value_number(input.id) != Lower.value_number(child.id)
																				and Lower.value_number(value) == Lower.value_number(input.id) and Own.owner_number(returned) == Own.owner_number(canonical)
																				and outputs.carried.is_empty())
																		_: False
																_: False
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False
		None: False


pure func test_ignored_result_drops_once() -> Bool:
	match file_write_seed(TEST_BASE).and_then(pure func(seed): Own.own(seed.lowered)):
		Err(_): False
		Ok(program):
			match program.functions.get(Concrete.function_number(entry_function(program.entrypoint))):
				Some(main):
					match main.operations.get(2):
						Some(Own.DefineValue(result)):
							match result.result:
								Own.OwnedResult(owner):
									main.operations.filter(pure func(operation):
										match operation:
											Own.DropOwner(dropped, _): Own.owner_number(dropped) == Own.owner_number(owner)
											_: False
									).length() == 1
								_: False
						_: False
				None: False


pure func test_duplicate_result_slots_acquire_separately() -> Bool:
	source = FILE_WRITE_SOURCE.replace("    escaped = escape(\"input\")\n", "    escaped = escape(\"input\")\n    copies = [unused, unused]\n")
	match file_write_seed_from_source(source, TEST_BASE).and_then(pure func(seed): Own.own(seed.lowered)):
		Err(_): False
		Ok(program):
			match program.functions.get(Concrete.function_number(entry_function(program.entrypoint))):
				None: False
				Some(main):
					main.operations.any(pure func(operation):
						match operation:
							Own.DefineValue(definition):
								match definition.operation:
									Own.ConstructListDefinition([Own.OwnedPayload(first, first_owner), Own.OwnedPayload(second, second_owner)]):
										(Lower.value_number(first) == Lower.value_number(second)
											and Own.owner_number(first_owner) != Own.owner_number(second_owner))
									_: False
							_: False
					)


tests: TestSuite = {
	description = "Blorp 2 file-write ownership",
	tests = [
		("two borrowed Strings return one owning Result", test_two_parameters_remain_borrowed_and_result_transfers),
		("same String supplies two live borrows", test_same_string_is_borrowed_twice_without_acquisition),
		("Void stays unmanaged and Err escapes before parent destruction", test_void_projection_is_unmanaged_and_error_acquires_before_parent_drop),
		("ignored mixed Result drops once", test_ignored_result_drops_once),
		("duplicate Result slots acquire distinct owners", test_duplicate_result_slots_acquire_separately),
	]
}
