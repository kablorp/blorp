import:
	../../../src/own/own as Own
	../module_input: test_base
	../void_string_result_inputs: lowered_result
	test: TestSuite


pure func test_void_does_not_acquire_but_error_string_does() -> Bool:
	match lowered_result(test_base()).and_then(Own.own):
		Err(_): False
		Ok(program):
			var void_payload = False
			var string_payload = False
			for function in program.functions:
				match function.operations:
					[Own.DefineValue(_), Own.DefineValue(constructed)]:
						match (constructed.operation, constructed.result):
							(Own.ConstructDefinition(_, [Own.UnmanagedPayload(_)]), Own.OwnedResult(_)): void_payload = True
							_: void
					[Own.DefineValue(_), Own.AcquireOwner(acquired, _, _), Own.DefineValue(constructed)]:
						match (constructed.operation, constructed.result):
							(Own.ConstructDefinition(_, [Own.OwnedPayload(_, transferred)]), Own.OwnedResult(_)):
								string_payload = Own.owner_number(acquired) == Own.owner_number(transferred)
							_: void
					_: void
			void_payload and string_payload


tests: TestSuite = {
	description = "Blorp 2 ordinary Void/String Result ownership",
	tests = [("Ok owns its Result without a child; Err acquires its String child", test_void_does_not_acquire_but_error_string_does)]
}
