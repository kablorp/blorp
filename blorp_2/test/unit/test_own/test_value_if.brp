import:
	../../../src/own/own as Own
	../join_inputs: join_function
	../value_if_inputs as Input
	test: TestSuite


private pure func independently_owned(source: String) -> Option[Bool]:
	program ?= Input.owned(source).to_option()
	function ?= join_function(program)
	var joins: List[Own.OwnedJoin] = []
	for operation in function.operations:
		match operation:
			Own.ExecuteJoin(join): joins = joins.append(join)
			_: void
	join ?= joins.get(0)
	unchanged ?= join.arms.get(1)
	match unchanged.exit:
		Own.Yield(outputs):
			match (outputs.carried, outputs.transfer):
				([Own.OwnedReturn(_, carrier_owner)], Own.OwnedReturn(_, result_owner)):
					Some(Own.owner_number(result_owner) != Own.owner_number(carrier_owner)
						and join.carried.length() == 1 and join.arms.length() == 2)
				_: None
		Own.TransferLoop(_, _): None


pure func test_aliased_result_and_carrier_acquire_independent_owners() -> Bool:
	independently_owned(Input.STRING_ALIAS).get_or(False) and independently_owned(Input.LIST_ALIAS).get_or(False)


tests: TestSuite = {
	description = "Blorp 2 value if ownership",
	tests = [("aliased result and carrier have distinct owners", test_aliased_result_and_carrier_acquire_independent_owners)]
}
