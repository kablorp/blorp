import:
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/lex/lex: lex
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, FunctionExecution(SelfTailLoop)
	../../../src/namespace/builtins as Runtime
	../ownership_inputs: InputIds, input_ids, runtime, span
	../compilation: compile
	../input: check, parse, setup_diagnostic
	test: TestSuite


-- Raw runtime loops exercise resources independently of scalar source admission.
private pure func string_loop(ids: InputIds, duplicate: Bool) -> Lower.LoweredFunction:
	read = if duplicate:
		ids.fourth
	else:
		ids.third
	local = if duplicate:
		ids.fifth
	else:
		ids.fourth
	carried: List[Lower.ValueParameter] = if duplicate:
		[{ id = ids.third, value_type = Concrete.StringType, span = span(21) }]
	else:
		[]
	carried_values: List[Lower.ValueId] = if duplicate:
		[local]
	else:
		[]
	{
		signature = { parameters = [], return_type = Concrete.IntType },
		steps = [
			Lower.Define({ id = ids.first, value_type = Concrete.StringType, operation = Lower.StringValue("PRE"), span = span(10) }),
			Lower.Loop({
				headers = [], result = { id = ids.second, value_type = Concrete.StringType, span = span(20) },
				carried = carried, reads = [],
				body = {
					steps = [Lower.Define({ id = local, value_type = Concrete.StringType, operation = Lower.StringValue("local"), span = span(30) })],
					tail = Lower.ExitLoop(Lower.Break({ value = local, carried = carried_values, span = span(40) }))
				}
			}),
			Lower.Define(runtime(read, Runtime.StringLength, [ids.first], Concrete.IntType, 50)),
		],
		result = read
	}


private pure func kept_pre_owner(
	pre: Own.OwnedDefinition,
	read: Own.OwnedDefinition,
	retired: Own.OwnerId,
) -> Bool:
	match (pre.result, read.operation):
		(Own.OwnedResult(owner), Own.CallDefinition(call, [Own.BorrowedArgument(borrow)])):
			match (call, borrow.source):
				(Concrete.RuntimeFunction(Runtime.StringLength), Own.OwnerBorrow(source)):
					(
						Own.owner_number(owner) == 0
						and Own.owner_number(source) == 0
						and Own.owner_number(retired) == 0
						and Lower.value_number(borrow.value) == Lower.value_number(pre.id)
					)
				_: False
		_: False


private pure func acquired_before_retirement(duplicate: Bool) -> Bool:
	expected_local_owner: Int = if duplicate:
		3
	else:
		2
	match input_ids():
		Err(_): False
		Ok(ids):
			match Own.insert_function(string_loop(ids, duplicate), [], []):
				Err(_): False
				Ok(function):
					pre_is_kept = match function.operations:
						[Own.DefineValue(pre), Own.ExecuteLoop(_), Own.DropOwner(_, _), Own.DefineValue(read), Own.DropOwner(retired, _)]:
							not duplicate and kept_pre_owner(pre, read, retired)
						[Own.DefineValue(pre), Own.ExecuteLoop(_), Own.DropOwner(_, _), Own.DropOwner(_, _), Own.DefineValue(read), Own.DropOwner(retired, _)]:
							duplicate and kept_pre_owner(pre, read, retired)
						_: False
					var valid = False
					for operation in function.operations:
						match operation:
							Own.ExecuteLoop(loop):
								match (loop.body.operations, loop.body.tail):
									([Own.DefineValue(local), Own.AcquireOwner(first, borrow, _), ...rest], Own.ExitLoop(Own.Break(outputs))):
										match (local.result, borrow.source, outputs.value):
											(Own.OwnedResult(old), Own.OwnerBorrow(source), Own.OwnedReturn(value, transferred)):
												valid = (
													Own.owner_number(old) == expected_local_owner
													and Own.owner_number(old) == Own.owner_number(source)
													and Own.owner_number(first) == Own.owner_number(transferred)
												)
												valid = valid and Own.owner_number(first) == Own.owner_number(old) + 1
												valid = valid and Lower.value_number(value) == Lower.value_number(local.id) and Own.owner_number(first) != Own.owner_number(old)
												match (rest, outputs.carried):
													([Own.DropOwner(retired, _)], []): valid = valid and not duplicate and Own.owner_number(retired) == Own.owner_number(old)
													([Own.AcquireOwner(second, again, _), Own.DropOwner(retired, _)], [Own.OwnedReturn(other, moved)]):
														valid = (
															valid
															and duplicate
															and Own.owner_number(second) == Own.owner_number(moved)
															and Own.owner_number(second) == Own.owner_number(first) + 1
														)
														valid = (
															valid
															and Own.owner_number(retired) == Own.owner_number(old)
															and Lower.value_number(other) == Lower.value_number(local.id)
															and Lower.value_number(again.value) == Lower.value_number(local.id)
														)
														match again.source:
															Own.OwnerBorrow(source): valid = valid and Own.owner_number(source) == Own.owner_number(old)
															_: valid = False
													_: valid = False
											_: valid = False
									_: valid = False
							_: void
					valid and pre_is_kept


pure func test_single_loop_output_acquires_before_local_retirement() -> Bool:
	acquired_before_retirement(False)


pure func test_duplicate_loop_outputs_acquire_before_local_retirement() -> Bool:
	acquired_before_retirement(True)


private STEP: String =
	|fixed union Step:
	|	Stop
	|	Once
	|

private PREFIX: String =
	|@tail_recursive
	|pure func walk(step: Step, left: Int, right: Int) -> Int:
	|	prefix = identity(left)
	|	var current = right
	|	current = prefix
	|	match step:
	|		Stop: current
	|		Once:
	|			saved = left
	|

private SUFFIX: String =
	|pure func identity(value: Int) -> Int:
	|	value
	|func main() -> Int:
	|	walk(Once, 7, 9)
	|


private pure func concrete(source: String) -> Result[Concrete.SpecializedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	checked ?= check(parsed).map_err(setup_diagnostic)
	Concrete.specialize(checked)


private pure func source(terminal: String) -> String:
	STEP + PREFIX + "\t\t\t" + terminal + "\n" + SUFFIX


pure func test_specialization_preserves_backedge_and_arguments() -> Bool:
	match concrete(source("walk(Stop, identity(current), identity(saved))")):
		Err(_):
			False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, function, _]:
					match function.execution:
						SelfTailLoop(annotation):
							match function.body:
								Concrete.ConcreteMatchBody(matched):
									match matched.arms:
										[base, recur]:
											match recur.body:
												Concrete.RecurWith([step, left, right], occurrence):
													match (step.form, left.form, right.form):
														(Concrete.ConstructVariant(_, []), Concrete.InvokeFunction(first, [_]), Concrete.InvokeFunction(second, [_])):
															match (
																first.target,
																second.target,
																base.body,
															):
																(Concrete.UserFunction(first_id), Concrete.UserFunction(second_id), Concrete.ReturnExpression(_)):
																	(
																		Concrete.function_number(
																			first_id,
																		) == 2
																		and Concrete.function_number(
																			second_id,
																		) == 2
																		and annotation.start == STEP.length()
																		and occurrence.end > occurrence.start
																	)
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


private pure func ordered_values(terminal: String) -> Bool:
	match concrete(source(terminal)).and_then(pure func(program): Lower.lower(program)):
		Err(_): False
		Ok(program):
			match Lower.lowered_functions(program).functions.map(pure func(function): function.steps):
				[_, [Lower.Define(step), Lower.Define(left), Lower.Define(right), Lower.Loop(loop)], _]:
					match (loop.body.steps, loop.body.tail):
						([Lower.Define(prefix)], Lower.MatchLoop(matched)):
							match ((step.operation, left.operation, right.operation), prefix.operation, matched.arms):
								((Lower.ParameterValue(0), Lower.ParameterValue(1), Lower.ParameterValue(2)), Lower.CallValue(_, [original]), [base, recur]):
									match (base.body.tail, recur.body.tail, recur.body.steps):
										(Lower.ExitLoop(Lower.Break(outputs)), Lower.ExitLoop(Lower.Recur([next_step, next_left, next_right], _)), [Lower.Define(variant), Lower.Define(first), Lower.Define(second)]):
											match (variant.operation, first.operation, second.operation):
												(Lower.ConstructValue(_, []), Lower.CallValue(_, [current]), Lower.CallValue(_, [saved])):
													(
														loop.headers.map(pure func(header): Lower.value_number(header.initial)) == [0, 1, 2]
														and loop.headers.map(pure func(header): Lower.value_number(header.parameter.id)) == [4, 5, 6]
														and Lower.value_number(loop.result.id) == 3
														and Lower.value_number(original) == 5
														and Lower.value_number(outputs.value) == 7
														and base.body.steps.is_empty()
														and Lower.value_number(current) == 7
														and Lower.value_number(saved) == 5
														and Lower.value_number(next_step) == 8
														and Lower.value_number(next_left) == 9
														and Lower.value_number(next_right) == 10
														and Lower.value_number(second.id) == 10
													)
												_: False
										_: False
								_: False
						_: False
				_: False

pure func test_direct_arguments_lower_once_in_order() -> Bool:
	ordered_values("walk(Stop, identity(current), identity(saved))")


pure func test_ufcs_arguments_lower_once_in_order() -> Bool:
	ordered_values("Stop.walk(identity(current), identity(saved))")


pure func test_ufcs_receiver_chain_lowers_before_explicit_arguments() -> Bool:
	helper: String =
		|pure func step_identity(step: Step) -> Step:
		|	step
		|
	terminal: String =
		|			Stop.step_identity().walk(identity(current), identity(saved))
		|
	program_source = STEP + PREFIX + terminal + helper + SUFFIX

	match concrete(program_source).and_then(pure func(program): Lower.lower(program)):
		Err(_):
			False
		Ok(program):
			match Lower.lowered_functions(program).functions.map(pure func(function): function.steps):
				[_, [_, _, _, Lower.Loop(loop)], _, _]:
					match loop.body.tail:
						Lower.MatchLoop(matched):
							match matched.arms:
								[_, recur]:
									match (recur.body.steps, recur.body.tail):
										([Lower.Define(variant), Lower.Define(receiver), Lower.Define(left), Lower.Define(right)], Lower.ExitLoop(Lower.Recur([next_step, next_left, next_right], _))):
											match (
												variant.operation,
												receiver.operation,
												left.operation,
												right.operation,
											):
												(Lower.ConstructValue(_, []), Lower.CallValue(step_call, [receiver_argument]), Lower.CallValue(left_call, [left_argument]), Lower.CallValue(right_call, [right_argument])):
													match (
														step_call,
														left_call,
														right_call,
													):
														(Concrete.UserFunction(step_id), Concrete.UserFunction(left_id), Concrete.UserFunction(right_id)):
															(
																Concrete.function_number(
																	step_id,
																) == 3
																and Concrete.function_number(
																	left_id,
																) == 2
																and Concrete.function_number(
																	right_id,
																) == 2
																and Lower.value_number(
																	receiver_argument,
																) == 8
																and Lower.value_number(
																	left_argument,
																) == 7
																and Lower.value_number(
																	right_argument,
																) == 5
																and Lower.value_number(
																	next_step,
																) == 9
																and Lower.value_number(
																	next_left,
																) == 10
																and Lower.value_number(
																	next_right,
																) == 11
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_prefix_and_snapshots_are_inside_loop() -> Bool:
	match compile(source("walk(Stop, identity(current), identity(saved))")):
		Err(_):
			False
		Ok(output):
			(
				output.contains("goto blorp_loop_3_header;blorp_loop_3_header:{const enum blorp_u_0 blorp_vl_4=blorp_h_4;(void)blorp_vl_4;")
				and output.contains("const int64_t blorp_vl_7=blorp_f_2(blorp_vl_5);")
				and output.contains("int64_t blorp_vl_3;enum blorp_u_0 blorp_h_4=blorp_vl_0;")
				and output.contains("}goto blorp_loop_3_break;blorp_loop_3_break:;(void)blorp_vl_3;return blorp_vl_3;}")
				and output.contains(
					"const enum blorp_u_0 blorp_loop_3_transfer_0=blorp_vl_8;"
					+ "const int64_t blorp_loop_3_transfer_1=blorp_vl_9;"
					+ "const int64_t blorp_loop_3_transfer_2=blorp_vl_10;"
					+ "blorp_h_4=blorp_loop_3_transfer_0;blorp_h_5=blorp_loop_3_transfer_1;"
					+ "blorp_h_6=blorp_loop_3_transfer_2;goto blorp_loop_3_header;",
				)
				and not output.contains("=blorp_f_1(blorp_vl_8")
			)


pure func test_zero_argument_main_emits_valid_loop() -> Bool:
	source: String =
		|@tail_recursive func main() -> Int:
		|	main()
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			(
				output.contains("int64_t blorp_f_0(void){int64_t blorp_vl_0;goto blorp_loop_0_header;"
					+ "blorp_loop_0_header:{goto blorp_loop_0_header;}goto blorp_loop_0_break;"
					+ "blorp_loop_0_break:;(void)blorp_vl_0;return blorp_vl_0;}")
				and output.contains("int main(void){blorp_memory_start();return blorp_memory_finish((int)blorp_f_0());}")
			)


private pure func compiles_loop(source: String) -> Bool:
	match compile(source):
		Err(_):
			False
		Ok(output):
			(
				output.count("blorp_loop_2_header:{") == 1
				and output.count("goto blorp_loop_2_header;") == 2
				and output.count("blorp_loop_2_break:;") == 1
				and output.count("blorp_f_1(") == 3
			)


pure func test_phantom_string_argument_is_unmanaged() -> Bool:
	source: String =
		|fixed union Marker[T]:
		|	Only
		|fixed union Step:
		|	Stop
		|	Once
		|@tail_recursive pure func loop(step: Step, marker: Marker[String]) -> Int:
		|	match step:
		|		Stop: 7
		|		Once: loop(Stop, marker)
		|func main() -> Int:
		|	loop(Once, Only)
		|

	match (
		concrete(source)
			.and_then(pure func(program): Lower.lower(program))
			.and_then(pure func(program): Own.own(program))
	):
		Err(_):
			False
		Ok(program):
			match program.functions:
				[_, function]:
					match function.operations:
						[Own.DefineValue(_), Own.DefineValue(_), Own.ExecuteLoop(_)]:
							compiles_loop(source)
						_:
							False
				_:
					False


tests: TestSuite = {
	description = "Self-tail phase contracts and C projection",
	tests = [
		("single Loop output acquires before retiring its local", test_single_loop_output_acquires_before_local_retirement),
		("duplicate Loop outputs acquire before retiring their local", test_duplicate_loop_outputs_acquire_before_local_retirement),
		(
			"UFCS receiver helper precedes explicit arguments exactly once",
			test_ufcs_receiver_chain_lowers_before_explicit_arguments,
		),
		(
			"specialization preserves explicit branch backedge",
			test_specialization_preserves_backedge_and_arguments,
		),
		(
			"direct next arguments lower once in source order",
			test_direct_arguments_lower_once_in_order,
		),
		("UFCS next arguments lower once in source order", test_ufcs_arguments_lower_once_in_order),
		(
			"parameter snapshots and prefix work occur inside loop",
			test_prefix_and_snapshots_are_inside_loop,
		),
		("zero-argument main loop keeps entry ABI", test_zero_argument_main_emits_valid_loop),
		(
			"phantom String type argument has no managed payload",
			test_phantom_string_argument_is_unmanaged,
		),
	]
}
