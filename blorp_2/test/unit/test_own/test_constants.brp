import:
	../../../src/lower/lower: value_number
	../../../src/own/own as Own
	../constant_inputs: TWICE, AGGREGATE_TWICE, owned
	test: TestSuite


pure func test_each_materialized_string_owns_and_drops_its_own_obligation() -> Bool:
	match owned(TWICE):
		Err(_): False
		Ok(program):
			match program.functions:
				[main]:
					var acquired: List[Int] = []
					var dropped: List[Int] = []
					for operation in main.operations:
						match operation:
							Own.DefineValue(definition):
								match (definition.operation, definition.result):
									(Own.StringDefinition(_), Own.OwnedResult(owner)): acquired = acquired.append(Own.owner_number(owner))
									_: continue
							Own.DropOwner(owner, _): dropped = dropped.append(Own.owner_number(owner))
							_: continue
					acquired == [0, 1] and dropped == [0, 1]
				_: False


pure func test_returned_constant_transfers_the_materialized_owner() -> Bool:
	source: String =
		|TEXT: String = "kept λ"
		|pure func text(value: Int) -> String:
		|    TEXT
		|func main() -> Int:
		|    ignored = text(0)
		|    0
		|
	match owned(source):
		Err(_): False
		Ok(program):
			program.functions.any(pure func(function):
				match function.result:
					Own.OwnedReturn(value, owner):
						function.operations.any(pure func(operation):
							match operation:
								Own.DefineValue(definition):
									match (definition.operation, definition.result):
										(Own.StringDefinition(_), Own.OwnedResult(created)):
											(
												Own.owner_number(owner) == Own.owner_number(created)
												and value_number(value) == value_number(definition.id)
											)
										_: False
								_: False
						)
					_: False
			)


pure func test_each_aggregate_transfers_its_child_and_drops_its_own_root() -> Bool:
	match owned(AGGREGATE_TWICE):
		Err(_): False
		Ok(program):
			match program.functions:
				[main]:
					var strings: List[Own.OwnedDefinition] = []
					var records: List[Own.OwnedDefinition] = []
					var drops: List[Own.OwnerId] = []
					var acquisitions: List[Own.OwnershipOperation] = []
					for operation in main.operations:
						match operation:
							Own.DefineValue(definition):
								match definition.operation:
									Own.StringDefinition("kept λ"): strings = strings.append(definition)
									Own.ConstructRecordDefinition(_, _): records = records.append(definition)
									_: void
							Own.DropOwner(owner, _): drops = drops.append(owner)
							Own.AcquireOwner(_, _, _): acquisitions = acquisitions.append(operation)
							_: void
					match (strings, records, (drops, acquisitions)):
						([first_child, second_child], [first, second], ([first_child_drop, first_drop, second_child_drop, second_drop], [Own.AcquireOwner(first_transfer_owner, first_borrow, _), Own.AcquireOwner(second_transfer_owner, second_borrow, _)])):
							match (first.result, second.result, first_child.result, second_child.result):
								(Own.OwnedResult(first_owner), Own.OwnedResult(second_owner), Own.OwnedResult(first_child_owner), Own.OwnedResult(second_child_owner)):
									match (first.operation, second.operation):
										(Own.ConstructRecordDefinition(_, [first_field]), Own.ConstructRecordDefinition(_, [second_field])):
											match (first_field.value, second_field.value):
												(Own.OwnedPayload(first_value, first_transfer), Own.OwnedPayload(second_value, second_transfer)):
													borrows_match = match (first_borrow.source, second_borrow.source):
														(Own.OwnerBorrow(left), Own.OwnerBorrow(right)): Own.owner_number(left) == Own.owner_number(first_child_owner) and Own.owner_number(right) == Own.owner_number(second_child_owner)
														_: False
													(value_number(first_value) == value_number(first_child.id) and value_number(second_value) == value_number(second_child.id)
														and Own.owner_number(first_transfer) == Own.owner_number(first_transfer_owner)
														and Own.owner_number(second_transfer) == Own.owner_number(second_transfer_owner)
														and value_number(first_borrow.value) == value_number(first_child.id) and value_number(second_borrow.value) == value_number(second_child.id)
														and borrows_match
														and Own.owner_number(first_child_drop) == Own.owner_number(first_child_owner) and Own.owner_number(second_child_drop) == Own.owner_number(second_child_owner)
														and Own.owner_number(first_owner) != Own.owner_number(second_owner)
														and Own.owner_number(first_drop) == Own.owner_number(first_owner)
														and Own.owner_number(second_drop) == Own.owner_number(second_owner))
												_: False
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Constant materialization ownership",
	tests = [
		("two String uses have independent owner obligations", test_each_materialized_string_owns_and_drops_its_own_obligation),
		("returning a constant transfers its use owner", test_returned_constant_transfers_the_materialized_owner),
		("aggregate reads transfer children and discharge independent roots", test_each_aggregate_transfers_its_child_and_drops_its_own_root),
	]
}
