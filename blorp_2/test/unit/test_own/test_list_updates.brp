		Ok(ids):
			definitions = [empty_list(ids.first, Concrete.StringType),
				runtime(ids.second, Builtins.ListConcat(Concrete.StringType), [ids.first, ids.first], Concrete.ListType(Concrete.StringType), 30)]
			match Own.insert_function(lowered_function(definitions, ids.second, [], Concrete.ListType(Concrete.StringType)), [], []):
				Err(_): False
				Ok(owned): consumed_updates(owned.operations).equals(0)


-- Bounds are established upstream; this isolates Own's third-argument guard.
-- It deliberately does not use the independent verifier as its oracle.
pure func test_set_third_payload_dependency_prevents_transfer() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			list_type: Concrete.TypeRef = Concrete.ListType(Concrete.StringType)
			definitions: List[Lower.ValueDefinition] = [
				child(ids.first),
				{ id = ids.second, value_type = list_type, operation = Lower.ConstructListValue([ids.first]), span = span(20) },
				{ id = ids.third, value_type = Concrete.StringType, operation = Lower.ListElementValue(0, ids.second), span = span(25) },
				integer(ids.fourth, 0, 26),
				runtime(ids.fifth, Builtins.ListSet(Concrete.StringType), [ids.second, ids.fourth, ids.third], list_type, 30),
			]
			match Own.insert_function(lowered_function(definitions, ids.fifth, [], list_type), [], []):
				Err(_): False
				Ok(owned):
					var guarded: Bool = False
					for operation in owned.operations:
						match operation:
							Own.DefineValue(definition):
								match definition.operation:
									Own.CallDefinition(Concrete.RuntimeFunction(Builtins.ListSet(_)), [Own.BorrowedArgument(left), Own.UnmanagedArgument(index), Own.BorrowedArgument(replacement)]):
										match replacement.source:
											Own.PayloadBorrow(parent): guarded = Lower.value_number(parent).equals(Lower.value_number(left.value)).and(Lower.value_number(index).equals(Lower.value_number(ids.fourth)))
											_: void
									_: void
							_: void
					guarded.and(consumed_updates(owned.operations).equals(0))


pure func test_set_captured_owner_stays_borrowed() -> Bool:
	body: String =
		|pure func collect() -> List[Int]:
		|    original = [1]
		|    var again: Bool = True
		|    while again:
		|        unused = set(original, 0, 2)
		|        again = False
		|    original
		|func main() -> Int:
		|    unused = collect()
		|    0
		|
	source_consumes(body, 0)


pure func test_concat_continuing_join_stays_borrowed() -> Bool:
	body: String =
		|func main() -> Int:
		|    original = [1]
		|    flag: Bool = True
		|    selected = if flag:
		|        concat(original, [2])
		|    else:
		|        original
		|    length(original)
		|
	source_consumes(body, 0)


tests: TestSuite = {
	description = "List update ownership insertion",
	tests = [
		("set local last use transfers first owner without old drop", test_set_local_transfers),
		("concat local last use transfers first owner without old drop", test_concat_local_transfers),
		("set parameter retains borrowed contract", test_set_parameter_borrows),
		("concat parameter retains borrowed contract", test_concat_parameter_borrows),
		("set later snapshot read prevents transfer", test_set_later_use_borrows),
		("concat later snapshot read prevents transfer", test_concat_later_use_borrows),
		("set loop accumulator transfers three-operand update", test_set_loop_transfers),
		("concat loop accumulator transfers first input", test_concat_loop_transfers),
		("concat same owner RHS prevents transfer", test_concat_same_owner_stays_borrowed),
		("set third argument payload dependency prevents transfer", test_set_third_payload_dependency_prevents_transfer),
		("set captured outer owner remains borrowed", test_set_captured_owner_stays_borrowed),
		("concat continuing join remains conservative", test_concat_continuing_join_stays_borrowed),
		("later snapshot use keeps its old List root borrowed", test_later_snapshot_read_keeps_input_borrowed),
		("captured outer-loop List stays borrowed", test_captured_outer_owner_stays_borrowed),
		("continuing join preserves enclosing List", test_continuing_join_keeps_enclosing_owner),
		("nearest nested loop consumes its own List", test_nearest_nested_loop_consumes_its_accumulator),
		("child derived from consumed List prevents transfer", test_dependent_child_keeps_root_borrowed),
		("RHS payload dependency prevents consuming its List root", test_rhs_payload_dependency_prevents_root_consumption),
		("nested payload List cannot transfer its ancestor owner", test_nested_payload_root_remains_borrowed),
		("last local use transfers List owner without a second drop", test_local_last_use_transfers_without_old_drop),
		("borrowed List parameter remains borrowed", test_parameter_keeps_borrowed_contract),
		("direct accumulator loop consumes its carried List", test_direct_loop_consumes_carried_list),
	]
}
