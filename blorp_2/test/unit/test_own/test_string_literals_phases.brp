import:
	../../../src/utils/names: program_names
	../../../src/check/check: CheckedProgram, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/model as Check
	../../../src/lex/lex: lex
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/parse/assemble: ParsedProgram
	../../../src/utils/source: module_source, root_module_id
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic
	../compilation: compile
	../input: check, check_failure, parse, setup_diagnostic
	../module_input: primitive_base, STRING_OPERATIONS, parse_modules_with_base
	test: TestSuite


private SOURCE: String =
	|pure func text() -> String:
	|    "é\u{1F600}"
	|func main() -> Int:
	|    unused = text()
	|    0
	|


private pure func parsed(source: String) -> Result[ParsedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parse(tokens)


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	input ?= parsed(source)
	check(input).map_err(setup_diagnostic)


pure func test_string_literal_rejects_an_int_return_expectation() -> Bool:
	prefix = "func main() -> Int:\n    "

	match check_failure(prefix + "\"é\"\n"):
		Some(error):
			match error.kind:
				Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
					match mismatch.expected_site:
						Errors.SourceAnnotation(annotation):
							(
								Check.same_type(mismatch.expected, Check.IntType)
								and Check.same_type(mismatch.actual.value_type, Check.StringType)
								and error.span.start == prefix.length()
								and error.span.end == prefix.length() + 4
								and mismatch.actual.span.start == prefix.length()
								and mismatch.actual.span.end == prefix.length() + 4
								and annotation.start == 15
								and annotation.end == 18
							)
						_:
							False
				_:
					False
		None:
			False


pure func test_string_literal_rejects_an_int_argument_expectation() -> Bool:
	header =
		|pure func take(first: Int, second: Int) -> Int:
		|    first
		|func main() -> Int:
		|
	prefix = header + "    take(0, "

	match check_failure(prefix + "\"é\")\n"):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					(
						Check.same_type(mismatch.expected, Check.IntType)
						and Check.same_type(mismatch.actual.value_type, Check.StringType)
						and mismatch.argument_position == 1
						and error.span.start == prefix.length()
						and error.span.end == prefix.length() + 4
						and mismatch.actual.span.start == prefix.length()
						and mismatch.actual.span.end == prefix.length() + 4
					)
				_:
					False
		None:
			False


pure func test_checked_literal_retains_decoded_bytes_and_string_type() -> Bool:
	match checked(SOURCE):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match function.body:
						Check.CheckedValueBody(Check.ReturnExpression(value)):
							match value.form:
								Check.LiteralString(bytes):
									(
										bytes == "é😀"
										and Check.same_type(value.value_type, Check.StringType)
										and value.span.start == 32
										and value.span.end == 45
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_concrete_literal_retains_decoded_bytes_and_string_type() -> Bool:
	match checked(SOURCE).and_then(pure func(program): Concrete.specialize(program)):
		Err(_):
			False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, function]:
					match function.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match value.form:
								Concrete.LiteralString(bytes):
									(
										bytes == "é😀"
										and Concrete.same_type(value.value_type, Concrete.StringType)
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_lowered_literal_is_a_single_value_definition() -> Bool:
	match (
		checked(SOURCE)
			.and_then(pure func(program): Concrete.specialize(program))
			.and_then(pure func(program): Lower.lower(program))
	):
		Err(_):
			False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, function]:
					match (function.steps, function.result):
						([Lower.Define(value)], returned):
							match value.operation:
								Lower.StringValue(bytes):
									(
										bytes == "é😀"
										and Concrete.same_type(
											value.value_type,
											Concrete.StringType,
										)
										and Lower.value_number(value.id) == 0
										and Lower.value_number(returned) == 0
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_copy_survives_literal_reassignment_with_exact_drops() -> Bool:
	source: String =
		|import:
		|    string: length
		|func main() -> Int:
		|    original = "kept"
		|    var current = original
		|    current = "replacement"
		|    original.length()
		|

	match (
		parse_modules_with_base(
			[
				{
					source = source,
					targets = [1]
				},
				{
					source = STRING_OPERATIONS,
					targets = []
				},
			],
			primitive_base(),
		)
			.and_then(pure func(parsed): check(parsed).map_err(setup_diagnostic))
			.and_then(pure func(program): Concrete.specialize(program))
			.and_then(pure func(program): Lower.lower(program))
			.and_then(pure func(program): Own.own(program))
	):
		Err(_):
			False
		Ok(program):
			match program.functions:
				[function, _]:
					match function.operations:
						[Own.DefineValue(original), Own.DefineValue(replacement), Own.DropOwner(replaced_owner, _), Own.DefineValue(length), Own.DropOwner(original_owner, _)]:
							match (original.operation, replacement.operation, length.operation):
								(Own.StringDefinition("kept"), Own.StringDefinition("replacement"), Own.CallDefinition(_, [Own.BorrowedArgument(borrow)])):
									(
										Own.owner_number(replaced_owner) == 1
										and Own.owner_number(original_owner) == 0
										and Lower.value_number(
											borrow.value,
										) == Lower.value_number(original.id)
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_managed_literal_prefix_drops_once_before_join() -> Bool:
	source: String =
		|fixed union Flag:
		|    Off
		|    On
		|pure func inspect(flag: Flag) -> Int:
		|    unused = "text"
		|    match flag:
		|        Off: 0
		|        On: 0
		|func main() -> Int:
		|    inspect(Off)
		|

	match compile(source):
		Err(_): False
		Ok(_):
			match checked(source).and_then(Concrete.specialize).and_then(Lower.lower).and_then(Own.own):
				Err(_): False
				Ok(program):
					program.functions.any(pure func(function):
						match (function.operations, function.result):
							([Own.DefineValue(parameter), Own.DefineValue(literal), Own.DropOwner(dropped, _), Own.ExecuteJoin(join)], Own.UnmanagedReturn(returned)):
								match (literal.operation, literal.result, join.selection.scrutinee):
									(Own.StringDefinition("text"), Own.OwnedResult(owner), Own.UnmanagedArgument(scrutinee)):
										match join.result:
											Own.UnmanagedJoinParameter(result):
												(
													Own.owner_number(dropped) == Own.owner_number(owner)
													and Lower.value_number(scrutinee) == Lower.value_number(parameter.id)
													and Lower.value_number(returned) == Lower.value_number(result.id)
													and join.arms.length() == 2
												)
											_: False
									_: False
							_: False
					)


pure func test_managed_literal_stays_rejected_in_tail_loop() -> Bool:
	source: String =
		|@tail_recursive pure func loop(value: Int) -> Int:
		|    unused = "text"
		|    loop(value)
		|func main() -> Int:
		|    loop(0)
		|

	match compile(source):
		Err(errors):
			(
				errors.first.message == "managed values in @tail_recursive functions are not supported yet"
				and errors.first.help == "use an unmanaged helper, or remove @tail_recursive"
			)
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 String literal phase facts",
	tests = [
		(
			"String literal rejects Int return expectation",
			test_string_literal_rejects_an_int_return_expectation,
		),
		(
			"String literal rejects Int argument expectation",
			test_string_literal_rejects_an_int_argument_expectation,
		),
		(
			"checked literal retains decoded bytes and String type",
			test_checked_literal_retains_decoded_bytes_and_string_type,
		),
		(
			"concrete literal retains decoded bytes and String type",
			test_concrete_literal_retains_decoded_bytes_and_string_type,
		),
		(
			"lowered literal is one value definition",
			test_lowered_literal_is_a_single_value_definition,
		),
		(
			"copy survives literal reassignment with exact drops",
			test_copy_survives_literal_reassignment_with_exact_drops,
		),
		(
			"managed literal prefix drops once before join",
			test_managed_literal_prefix_drops_once_before_join,
		),
		(
			"managed literal stays rejected in tail loop",
			test_managed_literal_stays_rejected_in_tail_loop,
		),
	]
}
