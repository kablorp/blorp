import:
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../join_inputs: MEASURE, NEST, PICK, function_text, join_function, owned
	test: TestSuite


private pure func inserted_text(source: String) -> String:
	match owned(source):
		Err(error):
			error.message
		Ok(program):
			match join_function(program):
				Some(function): function_text(function)
				None: "no join"


-- A prefix owner read only inside the join is dropped after it by the
-- enclosing block, never in an arm; the arm that yields the prefix value
-- acquires it again and moves that new owner.
pure func test_prefix_owner_read_in_an_arm_drops_after_the_join() -> Bool:
	inserted_text(PICK) == "v0, v1=o0, v2=o1 {v3=o2; yield v3/o2 | acquire o3(v1); yield v1/o3}, drop o0; return v2/o1"


-- Arm owners follow their block's owners: the outer arm's, then its inner
-- join's arms, then the next outer arm's.
pure func test_nested_join_owners_follow_their_enclosing_arm() -> Bool:
	inserted_text(NEST) == "v0, v1=o0, v2=o1 {v3=o2, v4=o3 {v5=o4; yield v5/o4 | acquire o5(v3); yield v3/o5}, drop o2; yield v4/o3 | acquire o6(v1); yield v1/o6}, drop o0; return v2/o1"


-- An unread managed join value is dropped right after the join.
pure func test_unread_join_value_drops_after_the_join() -> Bool:
	inserted_text(MEASURE) == "v0, v1=o0 {v3=o1; yield v3/o1 | v4=o2; yield v4/o2}, drop o0, v2; return v2"


tests: TestSuite = {
	description = "Ownership insertion for joins",
	tests = [
		("prefix owner read in an arm drops after the join", test_prefix_owner_read_in_an_arm_drops_after_the_join),
		("nested join owners follow their enclosing arm", test_nested_join_owners_follow_their_enclosing_arm),
		("unread join value drops after the join", test_unread_join_value_drops_after_the_join),
	]
}
