import:
	../../src/source: module_source, root_module_id, same_module
	../../src/lex: lex
	../../src/names: name_spelling
	../../src/assemble: ParsedProgram, ParsedContents, parsed_contents as program_contents
	input: parse
	../../src/syntax:
		ExpressionBase(RecordExpression),
		ParsedBody(ParsedValueBody),
		PostfixOperation(FieldAccess, ReceiverInvocation),
		Symbol(LeftBrace, RightBrace),
		TokenKind(SymbolToken),
	test: TestSuite


-- These assertions inspect root declarations in the complete program inventory.
private pure func root_contents(program: ParsedProgram) -> ParsedContents:
	contents = program_contents(program)
	{ contents |
		functions = contents.functions.filter(pure func(row): same_module(row.module, root_module_id())),
		records = contents.records.filter(pure func(row): same_module(row.module, root_module_id())),
	}


pure func test_brace_token_spans() -> Bool:
	match lex(module_source(root_module_id()), "{}"):
		Ok(tokens):
			match tokens.tokens:
				[opening, closing]:
					match opening.kind:
						SymbolToken(LeftBrace):
							match closing.kind:
								SymbolToken(RightBrace):
									(
										opening.span.start == 0
										and opening.span.end == 1
										and closing.span.start == 1
										and closing.span.end == 2
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_written_field_order_and_mixed_postfix() -> Bool:
	source: String =
		|fixed record Pair { first: Int, second: Int }
		|func main() -> Int:
		|	{ second = 9, first = 7 }.read().first
		|
	result = lex(module_source(root_module_id()), source).and_then(parse)

	match result:
		Ok(program):
			parsed = root_contents(program)

			match parsed.records:
				[declaration]:
					match parsed.functions:
						[function]:
							match function.body:
								ParsedValueBody(value):
									match value.base:
										RecordExpression([second, first]):
											match value.applications:
												[ReceiverInvocation(call), FieldAccess(field)]:
													(
														name_spelling(
															parsed.names,
															declaration.type_name.id,
														) == Some("Pair")
														and name_spelling(
															parsed.names,
															second.name.id,
														) == Some("second")
														and name_spelling(
															parsed.names,
															first.name.id,
														) == Some("first")
														and name_spelling(
															parsed.names,
															call.callee.id,
														) == Some("read")
														and name_spelling(
															parsed.names,
															field.id,
														) == Some("first")
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Record syntax",
	tests = [
		("brace tokens retain byte spans", test_brace_token_spans),
		(
			"literal fields and mixed postfix retain written order",
			test_written_field_order_and_mixed_postfix,
		),
	]
}
