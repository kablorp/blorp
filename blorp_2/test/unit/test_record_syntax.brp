import:
	../../src/lex: lex
	../../src/names: name_spelling
	../../src/parse: parse, parse_prelude, parsed_contents
	../../src/prelude: check_prelude
	../../src/syntax:
		ExpressionBase(RecordExpression),
		ParsedBody(ParsedValueBody),
		PostfixOperation(FieldAccess, ReceiverInvocation),
		Symbol(LeftBrace, RightBrace),
		TokenKind(SymbolToken),
	test: TestSuite


pure func test_brace_token_spans() -> Bool:
	match lex("{}"):
		Ok(tokens):
			match tokens.tokens:
				[opening, closing]:
					match opening.kind:
						SymbolToken(LeftBrace):
							match closing.kind:
								SymbolToken(RightBrace):
									(
										opening.span.start == 0
										and opening.span.end == 1
										and closing.span.start == 1
										and closing.span.end == 2
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_written_field_order_and_mixed_postfix() -> Bool:
	prelude_source: String =
		|type Int = builtin
		|type String = builtin
		|
	source: String =
		|fixed record Pair { first: Int, second: Int }
		|func main() -> Int:
		|	{ second = 9, first = 7 }.read().first
		|
	result = lex(prelude_source)
		.and_then(pure func(tokens): parse_prelude(tokens))
		.and_then(pure func(parsed): check_prelude(parsed))
		.and_then(
			pure func(prelude): lex(source).and_then(pure func(tokens): parse(tokens, prelude)),
		)

	match result:
		Ok(program):
			parsed = parsed_contents(program)

			match parsed.records:
				[declaration]:
					match parsed.functions:
						[function]:
							match function.body:
								ParsedValueBody(value):
									match value.base:
										RecordExpression([second, first]):
											match value.applications:
												[ReceiverInvocation(call), FieldAccess(field)]:
													(
														name_spelling(
															parsed.names,
															declaration.type_name.id,
														) == Some("Pair")
														and name_spelling(
															parsed.names,
															second.name.id,
														) == Some("second")
														and name_spelling(
															parsed.names,
															first.name.id,
														) == Some("first")
														and name_spelling(
															parsed.names,
															call.callee.id,
														) == Some("read")
														and name_spelling(
															parsed.names,
															field.id,
														) == Some("first")
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Record syntax",
	tests = [
		("brace tokens retain byte spans", test_brace_token_spans),
		(
			"literal fields and mixed postfix retain written order",
			test_written_field_order_and_mixed_postfix,
		),
	]
}
