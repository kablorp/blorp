import:
	../../src/check/check: check
	../../src/check/render: render_failure
	../../src/own/own as Own
	../../src/lower/lower as Lower
	../../src/namespace/builtins as Builtins
	../../src/specialize/specialize as Concrete
	../../src/utils/syntax: Diagnostic, Span, Entrypoint(NoArguments), EntryResult(IntegerExitStatus), entry_function
	../../src/utils/source: module_source, root_module_id
	./module_input: parse_modules
	int: Int methods_only
	bool: Bool methods_only
	result: Result methods_only
	string: String methods_only
	list: List methods_only


pure func lowered(source: String) -> Result[Lower.LoweredProgram, Diagnostic]:
	parsed ?= parse_modules([{ source = source, targets = [] }])
	checked ?= check(parsed).map_err(pure func(failure): render_failure(failure).first)
	concrete ?= Concrete.specialize(checked)
	Lower.lower(concrete)


fixed record InputIds {
	first: Lower.ValueId,
	second: Lower.ValueId,
	third: Lower.ValueId,
	fourth: Lower.ValueId,
	fifth: Lower.ValueId,
	entrypoint: Concrete.FunctionInstanceId
}


pure func span(start: Int) -> Span:
	{ source = module_source(root_module_id()), start = start, end = start.add(1) }


-- Mint opaque identities through lowering; this seed supplies no ownership facts.
pure func input_ids() -> Result[InputIds, Diagnostic]:
	source: String =
		|func main() -> Int:
		|    first = 1
		|    second = 2
		|    third = 3
		|    fourth = 4
		|    5
		|
	program ?= lowered(source).map(Lower.lowered_functions)
	match program.functions:
		[seed]:
			match seed.steps:
				[Lower.Define(first), Lower.Define(second), Lower.Define(third), Lower.Define(fourth), Lower.Define(fifth)]:
					Ok({ first = first.id, second = second.id, third = third.id, fourth = fourth.id, fifth = fifth.id, entrypoint = entry_function(program.entrypoint) })
				_: Err({ span = span(0), note = None, message = "expected five identity seed definitions", help = "fix List append test seed" })
		_: Err({ span = span(0), note = None, message = "expected one identity seed function", help = "fix List append test seed" })


pure func integer(id: Lower.ValueId, value: Int, start: Int) -> Lower.ValueDefinition:
	{ id = id, value_type = Concrete.IntType, operation = Lower.IntegerValue(value), span = span(start) }


pure func parameter(id: Lower.ValueId, value_type: Concrete.TypeRef) -> Lower.ValueDefinition:
	{ id = id, value_type = value_type, operation = Lower.ParameterValue(0), span = span(10) }


pure func runtime(
	id: Lower.ValueId, operation: Builtins.RuntimeOperation[Concrete.VariantInstanceId, Concrete.TypeRef],
	arguments: List[Lower.ValueId], value_type: Concrete.TypeRef, start: Int,
) -> Lower.ValueDefinition:
	{ id = id, value_type = value_type, operation = Lower.CallValue(Concrete.RuntimeFunction(operation), arguments), span = span(start) }


pure func lowered_function(
	definitions: List[Lower.ValueDefinition], result: Lower.ValueId,
	parameters: List[Concrete.TypeRef], return_type: Concrete.TypeRef,
) -> Lower.LoweredFunction:
	{ signature = { parameters = parameters, return_type = return_type }, steps = definitions.map(pure func(definition): Lower.Define(definition)), result = result }


UPDATE_DECLARATIONS: String =
	|pure func append[T](values: List[T], value: T) -> List[T]:
	|    builtin("list.append")
	|pure func set[T](values: List[T], index: Int, value: T) -> List[T]:
	|    builtin("list.set")
	|pure func concat[T](left: List[T], right: List[T]) -> List[T]:
	|    builtin("list.concat")
	|pure func length[T](values: List[T]) -> Int:
	|    builtin("list.length")
	|pure func less_than(left: Int, right: Int) -> Bool:
	|    builtin("int.less_than")
	|


pure func owned_source(body: String) -> Result[Own.OwnershipProgram, Diagnostic]:
	lowered(UPDATE_DECLARATIONS.add(body)).and_then(Own.own)


pure func empty_list(id: Lower.ValueId, element: Concrete.TypeRef) -> Lower.ValueDefinition:
	{ id = id, value_type = Concrete.ListType(element), operation = Lower.ConstructListValue([]), span = span(10) }


pure func child(id: Lower.ValueId) -> Lower.ValueDefinition:
	{ id = id, value_type = Concrete.StringType, operation = Lower.StringValue("child"), span = span(20) }


-- Independent verifier inputs: no ownership insertion supplies their oracle.
pure func raw_append(
	ids: InputIds, arguments: List[Own.OwnedArgument], after: List[Own.OwnershipOperation],
) -> Own.OwnershipProgram:
	values: Own.OwnedDefinition = {
		id = ids.first, value_type = Concrete.ListType(Concrete.StringType),
		operation = Own.ConstructListDefinition([]), result = Own.OwnedResult(Own.owner_id(0)), span = span(10)
	}
	item: Own.OwnedDefinition = {
		id = ids.second, value_type = Concrete.StringType,
		operation = Own.StringDefinition("child"), result = Own.OwnedResult(Own.owner_id(1)), span = span(20)
	}
	appended: Own.OwnedDefinition = {
		id = ids.third, value_type = Concrete.ListType(Concrete.StringType),
		operation = Own.CallDefinition(Concrete.RuntimeFunction(Builtins.ListAppend(Concrete.StringType)), arguments),
		result = Own.OwnedResult(Own.owner_id(2)), span = span(30)
	}
	worker: Own.OwnedFunction = {
		signature = { parameters = [], return_type = Concrete.ListType(Concrete.StringType) },
		operations = [Own.DefineValue(values), Own.DefineValue(item), Own.DefineValue(appended)].concat(after),
		result = Own.OwnedReturn(ids.third, Own.owner_id(2))
	}
	zero: Own.OwnedDefinition = {
		id = ids.first, value_type = Concrete.IntType, operation = Own.IntegerDefinition(0),
		result = Own.UnmanagedResult, span = span(50)
	}
	main: Own.OwnedFunction = {
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = [Own.DefineValue(zero)], result = Own.UnmanagedReturn(ids.first)
	}
	{ records = [], unions = [], functions = [main, worker], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }


pure func append_arguments(ids: InputIds) -> List[Own.OwnedArgument]:
	[Own.ConsumedArgument(ids.first, Own.owner_id(0)),
		Own.BorrowedArgument({ value = ids.second, source = Own.OwnerBorrow(Own.owner_id(1)) })]



private pure func tail_updates(tail: Own.OwnedLoopTail, consumed_only: Bool) -> Int:
	match tail:
		Own.ExitLoop(_): 0
		Own.MatchLoop(matched):
			var count = 0
			for arm in matched.arms:
				count = count.add(count_updates(arm.body.operations, consumed_only)).add(tail_updates(arm.body.tail, consumed_only))
			count


private pure func count_updates(operations: List[Own.OwnershipOperation], consumed_only: Bool) -> Int:
	var count = 0
	for operation in operations:
		match operation:
			Own.DefineValue(definition):
				match definition.operation:
					Own.CallDefinition(Concrete.RuntimeFunction(Builtins.ListAppend(_) | Builtins.ListSet(_) | Builtins.ListConcat(_)), arguments):
						match arguments.get(0):
							Some(Own.ConsumedArgument(_, _)): count = count.add(1)
							_:
								if consumed_only.not():
									count = count.add(1)
					_: void
			Own.ExecuteJoin(join):
				for arm in join.arms:
					count = count.add(count_updates(arm.operations, consumed_only))
			Own.ExecuteLoop(loop): count = count.add(count_updates(loop.body.operations, consumed_only)).add(tail_updates(loop.body.tail, consumed_only))
			_: void
	count


pure func consumed_updates(operations: List[Own.OwnershipOperation]) -> Int:
	count_updates(operations, True)


pure func program_updates(program: Own.OwnershipProgram) -> Int:
	var count = 0
	for function in program.functions:
		count = count.add(count_updates(function.operations, False))
	count


pure func program_consumed(program: Own.OwnershipProgram) -> Int:
	var count = 0
	for function in program.functions:
		count = count.add(consumed_updates(function.operations))
	count


private pure func tail_cleanup_valid(tail: Own.OwnedLoopTail) -> Bool:
	match tail:
		Own.ExitLoop(_): True
		Own.MatchLoop(matched):
			var valid: Bool = True
			for arm in matched.arms:
				valid = valid.and(no_consumed_drop(arm.body.operations)).and(tail_cleanup_valid(arm.body.tail))
			valid


-- Observe every ordinary block recursively, without depending on IR positions.
pure func no_consumed_drop(operations: List[Own.OwnershipOperation]) -> Bool:
	var valid: Bool = True
	for operation in operations:
		match operation:
			Own.DefineValue(definition):
				match definition.operation:
					Own.CallDefinition(Concrete.RuntimeFunction(Builtins.ListAppend(_) | Builtins.ListSet(_) | Builtins.ListConcat(_)), arguments):
						match arguments.get(0):
							Some(Own.ConsumedArgument(_, owner)):
								for later in operations:
									match later:
										Own.DropOwner(dropped, _): valid = valid.and(Own.owner_number(dropped).not_equals(Own.owner_number(owner)))
										_: void
							_: void
					_: void
			Own.ExecuteJoin(join):
				for arm in join.arms:
					valid = valid.and(no_consumed_drop(arm.operations))
			Own.ExecuteLoop(loop): valid = valid.and(no_consumed_drop(loop.body.operations)).and(tail_cleanup_valid(loop.body.tail))
			_: void
	valid


pure func raw_integer_append(ids: InputIds, consumed: Bool) -> Own.OwnershipProgram:
	program = raw_append(ids, [], [])
	match program.functions:
		[main, worker]:
			values: Own.OwnedDefinition = {
				id = ids.first, value_type = Concrete.ListType(Concrete.IntType),
				operation = Own.ConstructListDefinition([]), result = Own.OwnedResult(Own.owner_id(0)), span = span(10)
			}
			item: Own.OwnedDefinition = {
				id = ids.second, value_type = Concrete.IntType, operation = Own.IntegerDefinition(7),
				result = Own.UnmanagedResult, span = span(20)
			}
			left: Own.OwnedArgument = if consumed:
				Own.ConsumedArgument(ids.first, Own.owner_id(0))
			else:
				Own.BorrowedArgument({ value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) })
			appended: Own.OwnedDefinition = {
				id = ids.third, value_type = Concrete.ListType(Concrete.IntType),
				operation = Own.CallDefinition(Concrete.RuntimeFunction(Builtins.ListAppend(Concrete.IntType)), [left, Own.UnmanagedArgument(ids.second)]),
				result = Own.OwnedResult(Own.owner_id(1)), span = span(30)
			}
			cleanup: List[Own.OwnershipOperation] = if consumed:
				[]
			else:
				[Own.DropOwner(Own.owner_id(0), span(40))]
			{ program | functions = [main, {
				worker | signature = { parameters = [], return_type = Concrete.ListType(Concrete.IntType) },
				operations = [Own.DefineValue(values), Own.DefineValue(item), Own.DefineValue(appended)].concat(cleanup),
				result = Own.OwnedReturn(ids.third, Own.owner_id(1))
			}] }
		_: program


-- The raw set/concat programs define their contracts and obligations directly.
-- The unmanaged index is present in both seeds so callers share minted ids.
pure func raw_list_update(
	ids: InputIds, is_set: Bool, arguments: List[Own.OwnedArgument], after: List[Own.OwnershipOperation],
) -> Own.OwnershipProgram:
	base = raw_append(ids, [], [])
	list_type: Concrete.TypeRef = Concrete.ListType(Concrete.StringType)
	left: Own.OwnedDefinition = {
		id = ids.first, value_type = list_type, operation = Own.ConstructListDefinition([]),
		result = Own.OwnedResult(Own.owner_id(0)), span = span(10)
	}
	right: Own.OwnedDefinition = if is_set:
		{ id = ids.second, value_type = Concrete.StringType, operation = Own.StringDefinition("replacement"), result = Own.OwnedResult(Own.owner_id(1)), span = span(20) }
	else:
		{ id = ids.second, value_type = list_type, operation = Own.ConstructListDefinition([]), result = Own.OwnedResult(Own.owner_id(1)), span = span(20) }
	index: Own.OwnedDefinition = {
		id = ids.third, value_type = Concrete.IntType, operation = Own.IntegerDefinition(0),
		result = Own.UnmanagedResult, span = span(25)
	}
	target: Builtins.RuntimeOperation[Concrete.VariantInstanceId, Concrete.TypeRef] = if is_set:
		Builtins.ListSet(Concrete.StringType)
	else:
		Builtins.ListConcat(Concrete.StringType)
	updated: Own.OwnedDefinition = {
		id = ids.fourth, value_type = list_type, operation = Own.CallDefinition(Concrete.RuntimeFunction(target), arguments),
		result = Own.OwnedResult(Own.owner_id(2)), span = span(30)
	}
	match base.functions:
		[main, worker]:
			{ base | functions = [main, { worker | signature = { parameters = [], return_type = list_type },
				operations = [Own.DefineValue(left), Own.DefineValue(right), Own.DefineValue(index), Own.DefineValue(updated)].concat(after),
				result = Own.OwnedReturn(ids.fourth, Own.owner_id(2)) }] }
		_: base


pure func update_arguments(ids: InputIds, is_set: Bool, consumed: Bool) -> List[Own.OwnedArgument]:
	left: Own.OwnedArgument = if consumed:
		Own.ConsumedArgument(ids.first, Own.owner_id(0))
	else:
		Own.BorrowedArgument({ value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) })
	right: Own.OwnedArgument = Own.BorrowedArgument({ value = ids.second, source = Own.OwnerBorrow(Own.owner_id(1)) })
	if is_set:
		[left, Own.UnmanagedArgument(ids.third), right]
	else:
		[left, right]
