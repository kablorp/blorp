import:
	../../src/check:
		BindingOrigin(ParameterBinding, MatchCapture),
		CheckErrorKind(
			ArgumentCountMismatch, RecursiveCallChain, ImpureCall, ArgumentTypeMismatch,
			GenericArgumentConflict, UnsupportedPayloadAnnotation, NonExhaustiveMatch,
			UnreachableArm, UnknownConstructorPattern, PatternUnexpectedField, PatternMissingField,
			MatchRequiresUnion, ConstructorNeedsExpectedType, UnknownValue, UncallableBinding,
		),
		CheckedArm,
		CheckedBase(ReturnBinding),
		CheckedBody(CheckedMatchBody, CheckedValueBody),
		CheckedFunction,
		CheckedOperation(ConstructVariant),
		CheckedPattern(VariantCase, BindingCase),
		CheckedProgram,
		PayloadBinding(BindPayload),
		PayloadRule(IntegerPayload),
		PayloadShape(Payload),
		TypeRef(IntType),
		binding_number,
		checked_functions,
		same_type,
		union_number,
		variant_owner,
	../../src/lex: lex
	../../src/syntax: Diagnostic
	input: check, check_failure, parse, setup_diagnostic
	test: TestSuite


private VALUE: String = "fixed union Value:\n\tEmpty\n\tNumber(Int)\n"

private MAIN: String = "func main() -> Int:\n\t0\n"

private UNWRAP: String = "pure func unwrap(value: Value) -> Int:\n\t"

private IDENTITY: String = "pure func identity(value: Int) -> Int:\n\tvalue\n"


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	input ?= lex(source)
	parsed ?= parse(input)
	check(parsed).map_err(setup_diagnostic)


private pure func accepts(source: String) -> Bool:
	match checked(source):
		Ok(_):
			True
		Err(_):
			False


private pure func rejects(
	prefix: String,
	text: String,
	start: Int,
	end: Int,
	matches: pure (CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(prefix + text + MAIN):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length() + start
				and error.span.end == prefix.length() + end
				and matches(error.kind)
			)


pure func test_payload_shapes_and_contextual_constructor_owners() -> Bool:
	match checked(
		"fixed union Left:\n\tNumber(Int)\nfixed union Right:\n\tNumber(Int)\npure func left() -> Left:\n\tNumber(42)\npure func right() -> Right:\n\tNumber(-42)\n" + MAIN,
	):
		Err(_):
			False
		Ok(program):
			rows = checked_functions(program)

			match rows.unions:
				[first, second]:
					match first.variants:
						[Payload(first_type)]:
							match second.variants:
								[Payload(second_type)]:
									(
										same_type(first_type.value_type, IntType)
										and same_type(second_type.value_type, IntType)
										and constructor_owners(rows.functions)
									)
								_:
									False
						_:
							False
				_:
					False


private pure func constructor_owners(functions: List[CheckedFunction]) -> Bool:
	match functions:
		[left, right, _]:
			match left.body:
				CheckedValueBody(left):
					match right.body:
						CheckedValueBody(right):
							match left.operations.map(pure func(step): step.operation):
								[ConstructVariant(first)]:
									match right.operations.map(pure func(step): step.operation):
										[ConstructVariant(second)]:
											(
												union_number(variant_owner(first)) == 0
												and union_number(variant_owner(second)) == 1
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_parameter_and_arm_bindings_have_distinct_definitions_and_ids() -> Bool:
	match checked(
		"fixed union Value:\n\tNumber(Int)\n\tOther(Int)\n" + UNWRAP + "match value:\n\t\tNumber(item): item\n\t\tOther(item): item\n" + MAIN,
	):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match function.body:
						CheckedMatchBody(body):
							parameter = match body.scrutinee.base:
								ReturnBinding(id):
									binding_number(id) == 0
								_:
									False

							match body.arms:
								[first, second]:
									parameter and arm_binding(first, 1) and arm_binding(second, 2)
								_:
									False
						_:
							False
				_:
					False


private pure func arm_binding(arm: CheckedArm, expected: Int) -> Bool:
	match arm.pattern:
		VariantCase(_, BindPayload(definition)):
			match arm.body.base:
				ReturnBinding(read):
					binding_number(definition) == expected and binding_number(read) == expected
				_:
					False
		_:
			False


pure func test_whole_binding_shadows_parameter_and_returns_union() -> Bool:
	match checked(
		VALUE + "pure func copy(value: Value) -> Value:\n\tmatch value:\n\t\tvalue: value\n" + MAIN,
	):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match function.body:
						CheckedMatchBody(body):
							match body.arms:
								[arm]:
									match arm.pattern:
										BindingCase(id):
											match arm.body.base:
												ReturnBinding(read):
													(
														binding_number(id) == 1
														and binding_number(read) == 1
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_field_scope_shadowing_and_receiver_function_lookup() -> Bool:
	(
		accepts(
			VALUE + IDENTITY + UNWRAP + "match value:\n\t\tEmpty(): 0\n\t\tNumber(identity): identity.identity()\n" + MAIN,
		)
		and accepts(
			VALUE + UNWRAP + "match value:\n\t\tEmpty: 0\n\t\tNumber(Number): Number\n" + MAIN,
		)
		and accepts(
			VALUE + "pure func copy(Number: Value) -> Value:\n\tmatch Number:\n\t\tNumber: Number\n" + MAIN,
		)
		and accepts(
			VALUE + "fixed union Other:\n\tUnrelated\n" + UNWRAP + "match value:\n\t\tUnrelated: 0\n" + MAIN,
		)
	)


pure func test_bindings_cannot_call_or_leak_to_siblings() -> Bool:
	prefix = VALUE + IDENTITY + UNWRAP + "match value:\n\t\tEmpty: 0\n\t\tNumber(identity): "
	leak = VALUE + UNWRAP + "match value:\n\t\tNumber(item): item\n\t\tEmpty: "
	rejects(prefix, "identity(identity)\n", 0, 8, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			UncallableBinding(_, MatchCapture, _):
				True
			_:
				False
	) and rejects(leak, "item\n", 0, 4, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			UnknownValue(_):
				True
			_:
				False
	)


pure func test_expected_type_flows_through_function_and_constructor_spines() -> Bool:
	(
		accepts(
			VALUE + "pure func copy(value: Value) -> Value:\n\tvalue\npure func make() -> Value:\n\tcopy(Number(42)).copy()\n" + MAIN,
		)
		and accepts(
			VALUE + "fixed union Other:\n\tNumber(Int)\npure func convert(value: Value) -> Other:\n\tmatch value:\n\t\tEmpty: Number(0)\n\t\tNumber(number): Number(number)\n" + MAIN,
		)
	)


pure func test_constructor_scrutinee_needs_context_not_function_result() -> Bool:
	prefix = VALUE + "pure func copy() -> Value:\n\tmatch "
	(
		rejects(prefix, "Number(42):\n\t\twhole: whole\n", 0, 6, pure func(
			kind: CheckErrorKind,
		) -> Bool:
			match kind:
				ConstructorNeedsExpectedType(_):
					True
				_:
					False
		)
		and rejects(prefix, "Empty:\n\t\twhole: whole\n", 0, 5, pure func(
			kind: CheckErrorKind,
		) -> Bool:
			match kind:
				ConstructorNeedsExpectedType(_):
					True
				_:
					False
		)
	)


pure func test_int_scrutinee_is_rejected_even_with_wildcard() -> Bool:
	rejects(VALUE + UNWRAP + "match ", "42:\n\t\t_: 0\n", 0, 2, pure func(
		kind: CheckErrorKind,
	) -> Bool:
		match kind:
			MatchRequiresUnion(_):
				True
			_:
				False
	)


pure func test_pattern_arity_and_constructor_shadowing() -> Bool:
	prefix = VALUE + UNWRAP + "match value:\n\t\t"
	shadow = VALUE + "pure func unwrap(Number: Value) -> Int:\n\tmatch Number:\n\t\tEmpty: 0\n\t\t"
	rejects(prefix, "Number(): 0\n\t\tEmpty: 0\n", 0, 8, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			PatternMissingField(_, _):
				True
			_:
				False
	) and rejects(prefix, "Number: 0\n\t\tEmpty: 0\n", 0, 6, pure func(
		kind: CheckErrorKind,
	) -> Bool:
		match kind:
			PatternMissingField(_, _):
				True
			_:
				False
	) and rejects(prefix, "Empty(_): 0\n\t\tNumber(_): 0\n", 0, 8, pure func(
		kind: CheckErrorKind,
	) -> Bool:
		match kind:
			PatternUnexpectedField(_):
				True
			_:
				False
	) and rejects(shadow, "Number(item): item\n", 0, 12, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			UnknownConstructorPattern(_, _):
				True
			_:
				False
	)


pure func test_usefulness_checks_variants_and_whole_catchalls() -> Bool:
	prefix = VALUE + UNWRAP + "match value:\n\t\tNumber(first): first\n\t\t"
	catchall = VALUE + UNWRAP + "match value:\n\t\twhole: 0\n\t\t"
	covered = VALUE + UNWRAP + "match value:\n\t\tEmpty: 0\n\t\tNumber(_): 0\n\t\t"
	help = "remove this arm; earlier arms already cover all values it could match"
	(
		rejects(prefix, "Number(second): second\n\t\tEmpty: 0\n", 0, 14, pure func(
			kind: CheckErrorKind,
		) -> Bool:
			match kind:
				UnreachableArm:
					True
				_:
					False
		)
		and rejects(catchall, "Empty: 0\n", 0, 5, pure func(kind: CheckErrorKind) -> Bool:
			match kind:
				UnreachableArm:
					True
				_:
					False
		)
		and rejects(covered, "_: 0\n", 0, 1, pure func(kind: CheckErrorKind) -> Bool:
			match kind:
				UnreachableArm:
					True
				_:
					False
		)
	)


pure func test_missing_coverage_uses_keyword_span_and_payload_witness() -> Bool:
	prefix = VALUE + UNWRAP
	rejects(prefix, "match value:\n\t\tEmpty: 0\n", 0, 5, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			NonExhaustiveMatch(_):
				True
			_:
				False
	)


pure func test_payload_type_and_value_mismatches() -> Bool:
	prefix = "fixed union Value:\n\tNumber("
	argument = VALUE + "pure func empty() -> Value:\n\tEmpty\npure func make() -> Value:\n\t"
	rejects(prefix, "Float)\n", 0, 5, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			UnsupportedPayloadAnnotation(_, IntegerPayload):
				True
			_:
				False
	) and rejects(argument, "Number(empty())\n", 0, 6, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ArgumentTypeMismatch(_):
				True
			_:
				False
	)


pure func test_purity_and_cycles_include_construction_arguments_and_hidden_arms() -> Bool:
	argument = VALUE + "func impure() -> Int:\n\t42\npure func make() -> Value:\n\tNumber("
	arm = VALUE + "func impure(value: Int) -> Int:\n\tvalue\n" + UNWRAP + "match value:\n\t\tEmpty: 0\n\t\tNumber(item): "
	cycle = VALUE + UNWRAP + "match value:\n\t\tEmpty: 0\n\t\tNumber(item): "
	scrutinee = VALUE + "pure func copy(value: Value) -> Value:\n\tmatch "
	rejects(argument, "impure())\n", 0, 6, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ImpureCall(_, _):
				True
			_:
				False
	) and rejects(arm, "impure(item)\n", 0, 6, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ImpureCall(_, _):
				True
			_:
				False
	) and rejects(cycle, "unwrap(Number(item))\n", 0, 6, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			RecursiveCallChain:
				True
			_:
				False
	) and rejects(scrutinee, "copy(value):\n\t\twhole: whole\n", 0, 4, pure func(
		kind: CheckErrorKind,
	) -> Bool:
		match kind:
			RecursiveCallChain:
				True
			_:
				False
	)


pure func test_function_contract_diagnostics_precede_base_and_purity() -> Bool:
	prefix = VALUE + "func impure() -> Int:\n\t0\n" + UNWRAP + "match value:\n\t\tEmpty: 0\n\t\tNumber(_): "
	rejects(prefix, "impure(missing)\n", 0, 6, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ArgumentCountMismatch(_):
				True
			_:
				False
	)


tests: TestSuite = {
	description = "Blorp 2 match and payload checking",
	tests = [
		(
			"payload shapes and contextual constructor owners",
			test_payload_shapes_and_contextual_constructor_owners,
		),
		(
			"parameter and arm bindings have distinct roles and ids",
			test_parameter_and_arm_bindings_have_distinct_definitions_and_ids,
		),
		(
			"whole binding shadows parameter and returns union",
			test_whole_binding_shadows_parameter_and_returns_union,
		),
		(
			"field shadowing and receiver function lookup",
			test_field_scope_shadowing_and_receiver_function_lookup,
		),
		("bindings cannot call or leak to siblings", test_bindings_cannot_call_or_leak_to_siblings),
		(
			"expected type flows through function and constructor spines",
			test_expected_type_flows_through_function_and_constructor_spines,
		),
		(
			"constructor scrutinee needs context not function result",
			test_constructor_scrutinee_needs_context_not_function_result,
		),
		(
			"Int scrutinee rejected even with wildcard",
			test_int_scrutinee_is_rejected_even_with_wildcard,
		),
		("pattern arity and constructor shadowing", test_pattern_arity_and_constructor_shadowing),
		(
			"usefulness checks variants and whole catchalls",
			test_usefulness_checks_variants_and_whole_catchalls,
		),
		(
			"missing coverage keyword span and payload witness",
			test_missing_coverage_uses_keyword_span_and_payload_witness,
		),
		("payload type and value mismatches", test_payload_type_and_value_mismatches),
		(
			"purity and cycles include construction arguments and hidden arms",
			test_purity_and_cycles_include_construction_arguments_and_hidden_arms,
		),
		(
			"function diagnostics precede base and purity",
			test_function_contract_diagnostics_precede_base_and_purity,
		),
	]
}
