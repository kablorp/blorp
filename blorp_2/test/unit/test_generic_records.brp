import:
	../../src/check_errors as Errors
	../../src/check_model as Model
	../../src/check as API
	../../src/check_render: render_failure
	../../src/declarations as Declaration
	../../src/lex: lex
	../../src/names: name_spelling
	../../src/assemble: parsed_contents
	../../src/source: module_source, root_module_id, same_source
	../../src/specialize as Concrete
	../../src/syntax: Diagnostic
	input: check_failure, parse, setup_diagnostic
	module_input: PRIMITIVE_BASE, parse_modules_with_base
	test: TestSuite


private BOX: String =
	|fixed record Box[T] { value: T }
	|pure func box[T](value: T) -> Box[T]:
	|    { value = value }
	|pure func unbox[T](value: Box[T]) -> T:
	|    value.value
	|

private MAIN: String =
	|func main() -> Int:
	|    0
	|

private BOTH: String =
	|func main() -> Int:
	|    text = unbox(box("42"))
	|    unbox(box(7))
	|

private PHANTOM: String =
	|fixed record Marker[A, B] { value: Int }
	|pure func first() -> Marker[Int, String]:
	|    { value = 7 }
	|pure func second() -> Marker[String, Int]:
	|    { value = 9 }
	|pure func read[A, B](value: Marker[A, B]) -> Int:
	|    value.value
	|func main() -> Int:
	|    unused = read(first())
	|    read(second())
	|


private pure func checked(source: String) -> Result[API.CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source)
	program ?= parse(tokens)
	API.check(program).map_err(setup_diagnostic)


private pure func specialized(source: String) -> Result[Concrete.SpecializedContents, Diagnostic]:
	program ?= checked(source)
	concrete ?= Concrete.specialize(program)
	Ok(Concrete.specialized_contents(concrete))


pure func test_ordered_record_parameters_retain_spans_and_names() -> Bool:
	written: String =
		|fixed record Pair[A, B] { first: A, second: B }
		|func main() -> Int:
		|    0
		|
	match lex(module_source(root_module_id()), written).and_then(parse):
		Ok(program):
			contents = parsed_contents(program)
			match contents.records:
				[declaration]:
					match declaration.type_parameters:
						[first, second]:
							(
								name_spelling(contents.names, first.id) == Some("A")
								and name_spelling(contents.names, second.id) == Some("B")
								and first.span.start == 18 and first.span.end == 19
								and second.span.start == 21 and second.span.end == 22
							)
						_: False
				_: False
		Err(_): False


pure func test_box_and_unbox_check_with_distinct_rigid_owners() -> Bool:
	match checked(BOX + "func main() -> Int:\n    unbox(box(7))\n"):
		Ok(program):
			contents = API.checked_functions(program)
			match (contents.records, contents.functions):
				([declaration], [box, unbox, _]):
					match (declaration.type_parameters, box.signature.type_parameters, unbox.signature.type_parameters):
						([record_parameter], [box_parameter], [unbox_parameter]):
							match (Model.parameter_owner(record_parameter), unbox.body):
								(Model.RecordDeclaration(owner), Model.CheckedValueBody(Model.ReturnExpression(value))):
									match value.operations:
										[step]:
											(
												Declaration.record_number(owner) == 0
												and Model.parameter_position(record_parameter) == 0
												and not Model.same_type(Model.ParameterType(record_parameter), Model.ParameterType(box_parameter))
												and Model.same_type(step.value_type, Model.ParameterType(unbox_parameter))
											)
										_: False
								_: False
						_: False
				_: False
		Err(_): False


pure func test_same_reader_uses_each_actual_concrete_receiver() -> Bool:
	match specialized(BOX + BOTH):
		Ok(program):
			var count = 0
			var valid = True
			for function in program.functions:
				match (function.signature.parameters, function.body):
					([Concrete.RecordType(owner)], Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
						for step in value.operations:
							match step.operation:
								Concrete.ReadRecordField(field):
									count = count + 1
									valid = valid and Concrete.record_number(owner) == Concrete.record_number(Concrete.field_owner(field))
								_: void
					_: void
			program.records.length() == 2 and count == 2 and valid
		Err(_): False


pure func test_phantom_arguments_keep_distinct_inline_instances() -> Bool:
	match specialized(PHANTOM):
		Ok(program):
			match program.records:
				[first, second]:
					match (first.representation, second.representation):
						(Concrete.InlineRecord, Concrete.InlineRecord):
							match (first.fields, second.fields):
								([Concrete.IntType], [Concrete.IntType]): True
								_: False
						_: False
				_: False
		Err(_): False


pure func test_partial_record_literal_solves_the_receiving_call() -> Bool:
	source: String =
		|fixed record Box[T] { value: T }
		|pure func inspect[T](value: Box[T]) -> Int:
		|    7
		|func main() -> Int:
		|    inspect({ value = 7 })
		|
	match checked(source):
		Ok(program):
			match API.checked_functions(program).functions:
				[_, main_function]:
					match main_function.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.base:
								Model.ReturnCall(call, [literal]):
									match (call.target, literal.base_type):
										(Model.UserFunction(_, [Model.IntType]), Model.AppliedRecordType(_, [Model.IntType])): True
										_: False
								_: False
						_: False
				_: False
		Err(_): False


pure func test_partial_unique_ufcs_and_nested_fields() -> Bool:
	source: String =
		|fixed record Box[T] { value: T }
		|fixed record Outer[T] { inner: Box[T] }
		|pure func inspect[T](value: Outer[T]) -> Int:
		|    7
		|func main() -> Int:
		|    { inner = { value = "42" } }.inspect()
		|
	checked(source).is_ok()


pure func test_expected_result_passes_through_nested_calls() -> Bool:
	source: String =
		|fixed record Marker[T] { value: Int }
		|pure func marker[T]() -> Marker[T]:
		|    { value = 7 }
		|pure func identity[T](value: T) -> T:
		|    value
		|pure func concrete() -> Marker[String]:
		|    identity(marker())
		|func main() -> Int:
		|    concrete().value
		|
	specialized(source).is_ok()


pure func test_contextless_and_unowned_identity_literals_reject() -> Bool:
	prefix: String =
		|fixed record Box[T] { value: T }
		|pure func identity[T](value: T) -> T:
		|    value
		|func main() -> Int:
		|
	match (check_failure(prefix + "    identity({ value = 7 }).value\n"), check_failure(prefix + "    { value = 7 }.value\n")):
		(Some(first), Some(second)):
			match (first.kind, second.kind):
				(Errors.RecordRejection(Errors.RecordNeedsExpectedType), Errors.RecordRejection(Errors.RecordNeedsExpectedType)): True
				_: False
		_: False


private MARKER: String =
	|fixed record Marker[T] { value: Int }
	|pure func marker[T]() -> Marker[T]:
	|    { value = 7 }
	|pure func outer(first: Int, second: Int) -> Int:
	|    first
	|


pure func test_projection_preserves_deferred_child_before_later_name_error() -> Bool:
	exact_rejection(MARKER + "func main() -> Int:\n    outer(marker().value, ", "missing", ")\n",
		"unknown value", "use this function's parameter name, a declared variant, or a call", pure func(kind):
			match kind:
				Errors.ValueRejection(Errors.UnknownValue(_)): True
				_: False
	)


private pure func first_function_parameter(kind: Errors.CheckErrorKind) -> Bool:
	match kind:
		Errors.CallRejection(Errors.UninferableTypeParameter(parameter)):
			match Model.parameter_owner(parameter):
				Model.FunctionDeclaration(owner): Declaration.function_number(owner) == 0 and Model.parameter_position(parameter) == 0
				_: False
		_: False


pure func test_int_projection_does_not_erase_phantom_ambiguity() -> Bool:
	exact_rejection(MARKER + "func main() -> Int:\n    ", "marker", "().value\n",
		"cannot infer the type parameter from the argument", "pass a value whose type determines the declared type parameter; use a concrete helper when no argument can determine it", first_function_parameter)


pure func test_all_field_children_freeze_before_ordinary_mismatch() -> Bool:
	prefix: String =
		|fixed union Choice[T]:
		|    Empty
		|fixed record Pair { first: String, second: Int }
		|pure func create[T]() -> Choice[T]:
		|    Empty
		|pure func inspect(value: Pair) -> Int:
		|    7
		|func main() -> Int:
		|
	exact_rejection(prefix + "    inspect({ first = 7, second = ", "create", "() })\n",
		"cannot infer the type parameter from the argument", "pass a value whose type determines the declared type parameter; use a concrete helper when no argument can determine it", first_function_parameter)


pure func test_shared_field_parameter_conflict_follows_written_order() -> Bool:
	prefix: String =
		|fixed record Pair[T] { first: T, second: T }
		|pure func inspect[T](value: Pair[T]) -> Int:
		|    7
		|func main() -> Int:
		|
	before = prefix + "    inspect({ second = 7, first = "
	exact_rejection(before, "\"bad\"", " })\n", "record field requires Int", "use an expression of type Int here", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordFieldTypeMismatch(_, actual, expected)): Model.same_type(actual.value_type, Model.StringType) and Model.same_type(expected.value_type, Model.IntType)
			_: False
	)


pure func test_field_child_errors_follow_written_order() -> Bool:
	prefix: String =
		|fixed record Pair[T] { first: T, second: T }
		|pure func inspect[T](value: Pair[T]) -> Int:
		|    7
		|func main() -> Int:
		|
	before = prefix + "    inspect({ second = "
	exact_rejection(before, "missing_second", ", first = missing_first })\n", "unknown value", "use this function's parameter name, a declared variant, or a call", pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.UnknownValue(_)): True
			_: False
	)


private pure func exact_rejection(prefix: String, marked: String, suffix: String, message: String, help: String, matches: pure (Errors.CheckErrorKind) -> Bool) -> Bool:
	source = prefix + marked + suffix
	match check_failure(source):
		Some(error):
			match lex(module_source(root_module_id()), source).and_then(parse):
				Ok(program):
					match API.check(program):
						Err(failure):
							diagnostic = render_failure(failure).first
							(
								same_source(error.span.source, module_source(root_module_id())) and error.span.start == prefix.length() and error.span.end == prefix.length() + marked.length()
								and matches(error.kind) and diagnostic.message == message and diagnostic.help == help
							)
						Ok(_): False
				Err(_): False
		None: False


pure func test_missing_arguments_have_exact_typed_diagnostic() -> Bool:
	exact_rejection("fixed record Box[T] { value: T }\npure func bad(value: ", "Box", ") -> Int:\n    0\n" + MAIN,
		"generic record requires one type argument", "write a concrete or symbolic application, such as Box[Int] or Box[T]", pure func(kind):
			match kind:
				Errors.TypeTermRejection(Errors.MissingRecordTypeArguments(owner, 1)): Declaration.record_number(owner) == 0
				_: False
	)


private pure func arity_rejected(written: String, count: Int) -> Bool:
	exact_rejection("fixed record Pair[A, B] { first: A, second: B }\npure func bad(value: ", written, ") -> Int:\n    0\n" + MAIN,
		"record type argument count does not match its declaration", "expected 2 type arguments, got " + count.to_string() + "; supply types in declaration order", pure func(kind):
			match kind:
				Errors.TypeTermRejection(Errors.RecordTypeArgumentCountMismatch(owner, 2, actual)): Declaration.record_number(owner) == 0 and actual == count
				_: False
	)


pure func test_application_arity_precedes_child_type_resolution() -> Bool:
	arity_rejected("Pair[Int]", 1) and arity_rejected("Pair[Int, String, Int]", 3) and arity_rejected("Pair[Missing]", 1)


pure func test_duplicate_record_parameter_owners_and_spans() -> Bool:
	prefix = "fixed record Pair[A, "
	exact_rejection(prefix, "A", "] { first: A }\n" + MAIN,
		"duplicate type parameter name", "choose a distinct name for each type parameter, such as A and B", pure func(kind):
			match kind:
				Errors.TypeDeclarationRejection(Errors.DuplicateTypeParameter(current, previous, first)):
					match (Model.parameter_owner(current), Model.parameter_owner(previous)):
						(Model.RecordDeclaration(owner), Model.RecordDeclaration(other)):
							Declaration.record_number(owner) == 0 and Declaration.record_number(other) == 0 and Model.parameter_position(current) == 1 and Model.parameter_position(previous) == 0 and first.start == 18 and first.end == 19
						_: False
				_: False
	)


pure func test_record_parameter_cannot_shadow_builtin_type() -> Bool:
	exact_rejection("fixed record Box[", "Int", "] { value: Int }\n" + MAIN,
		"type parameter conflicts with a type name", "choose a distinct type parameter name, such as T", pure func(kind):
			match kind:
				Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)): True
				_: False
	)


pure func test_nongeneric_record_application_has_exact_diagnostic() -> Bool:
	exact_rejection("fixed record Plain { value: Int }\npure func bad(value: ", "Plain[Int]", ") -> Int:\n    0\n" + MAIN,
		"ordinary record does not accept a type argument", "remove the type argument from this record type", pure func(kind):
			match kind:
				Errors.TypeTermRejection(Errors.OrdinaryRecordApplied(owner)): Declaration.record_number(owner) == 0
				_: False
	)


pure func test_unreachable_growing_record_substitution_rejects() -> Bool:
	prefix: String =
		|pure func loop[T](value: T) -> Int:
		|
	match_kind = pure func(kind: Errors.CheckErrorKind) -> Bool:
		match kind:
			Errors.RecursionRejection(Errors.GrowingRecursiveInstantiation): True
			_: False
	before = BOX + prefix + "    "
	message = "recursive calls grow type arguments without bound"
	help = "pass recursive type arguments unchanged, permute them, or reset them to concrete types"
	(
		exact_rejection(before, "loop", "(box(value))\n" + MAIN, message, help, match_kind)
		and exact_rejection(before, "loop", "(box(value))\nfunc main() -> Int:\n    loop(7)\n", message, help, match_kind)
	)


pure func test_finite_record_parameter_permutation_and_reset_remain_allowed() -> Bool:
	source: String =
		|pure func swap[A, B](first: A, second: B) -> Int:
		|    swap(second, first)
		|pure func reset[T](value: Box[T]) -> Int:
		|    reset(box(7))
		|func main() -> Int:
		|    unused = swap(7, "42")
		|    reset(box("42"))
		|
	specialized(BOX + source).is_ok()


private pure func recursive_record_rejected(prefix: String, marked: String, suffix: String) -> Bool:
	exact_rejection(prefix, marked, suffix, "recursive aggregate types are not supported yet", "use finite record and union fields until recursive data is supported", pure func(kind):
		match kind:
			Errors.TypeDeclarationRejection(Errors.RecursiveAggregateType(_)): True
			_: False
	)


pure func test_recursive_record_applications_reject_even_unused() -> Bool:
	(
		recursive_record_rejected("fixed record Node[T] { child: ", "Node[T]", " }\n" + MAIN)
		and recursive_record_rejected("fixed record Box[T] { value: T }\nfixed record Loop[T] { value: ", "Box[Loop[T]]", " }\n" + MAIN)
	)


pure func test_void_and_float_instances_derive_storage_from_fields() -> Bool:
	source: String =
		|func main() -> Int:
		|    unused_void = box(void)
		|    unused_float = box(1.5)
		|    0
		|
	match specialized(BOX + source):
		Ok(program):
			match program.records:
				[first, second]:
					match (first.fields, first.representation, second.fields, second.representation):
						([Concrete.VoidType], Concrete.ManagedRecord, [Concrete.FloatType], Concrete.InlineRecord): True
						_: False
				_: False
		Err(_): False


pure func test_list_field_concrete_rejection_does_not_depend_on_literal() -> Bool:
	source: String =
		|fixed record Values[T] { values: List[T] }
		|pure func produce() -> Values[Int]:
		|    produce()
		|pure func pass(value: Values[Int]) -> Values[Int]:
		|    value
		|func main() -> Int:
		|    unused = pass(produce())
		|    0
		|
	typed = match check_failure(source):
		Some(error):
			match error.kind:
				Errors.TypeTermRejection(Errors.UnsupportedListElement): True
				_: False
		None: False
	match checked(source):
		Err(error):
			(
				typed and error.message == "List currently supports only String elements"
				and error.help == "use List[String]; other concrete element types are not supported yet"
				and error.span.start == 66 and error.span.end == 77
				and same_source(error.span.source, module_source(root_module_id()))
			)
		Ok(_): False


pure func test_list_string_field_remains_supported() -> Bool:
	source: String =
		|fixed record Values[T] { values: List[T] }
		|pure func wrap[T](value: List[T]) -> Values[T]:
		|    { values = value }
		|func main(arguments: List[String]) -> Int:
		|    unused = wrap(arguments)
		|    0
		|
	specialized(source).is_ok()


pure func test_applied_record_equality_keeps_order_owner_and_nesting() -> Bool:
	source: String =
		|fixed record Pair[A, B] { first: A, second: B }
		|fixed record Other[A, B] { first: A, second: B }
		|
	match checked(source + MAIN):
		Ok(program):
			match (API.record_declaration_id(program, 0), API.record_declaration_id(program, 1)):
				(Some(owner), Some(other)):
					forward = Model.AppliedRecordType(owner, [Model.IntType, Model.StringType])
					reverse = Model.AppliedRecordType(owner, [Model.StringType, Model.IntType])
					(
						Model.same_type(forward, forward) and not Model.same_type(forward, reverse)
						and not Model.same_type(forward, Model.AppliedRecordType(other, [Model.IntType, Model.StringType]))
						and not Model.same_type(Model.AppliedRecordType(owner, [forward, Model.IntType]), Model.AppliedRecordType(owner, [reverse, Model.IntType]))
					)
				_: False
		Err(_): False


pure func test_unused_generic_field_rejects_a_concrete_value_for_rigid_parameter() -> Bool:
	prefix: String =
		|fixed record Box[T] { value: T }
		|pure func bad[T](value: T) -> Box[T]:
		|
	exact_rejection(prefix + "    { value = ", "7", " }\n" + MAIN, "record field requires T", "use an expression of type T here", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordFieldTypeMismatch(_, actual, expected)):
				match (actual.value_type, expected.value_type):
					(Model.IntType, Model.ParameterType(parameter)):
						match Model.parameter_owner(parameter):
							Model.FunctionDeclaration(owner): Declaration.function_number(owner) == 0
							_: False
					_: False
			_: False
	)


pure func test_generic_record_import_keeps_declaration_identity() -> Bool:
	root: String =
		|import:
		|    ./library: Box, box, unbox
		|func main() -> Int:
		|    unbox(box(7))
		|
	match parse_modules_with_base([{ source = root, targets = [1] }, { source = BOX, targets = [] }], PRIMITIVE_BASE):
		Ok(parsed):
			match API.check(parsed):
				Ok(program): Concrete.specialize(program).is_ok()
				Err(_): False
		Err(_): False


pure func test_nested_union_constructor_shares_record_inference_slots() -> Bool:
	source: String =
		|fixed union Choice[T]:
		|    Empty
		|    Value(T)
		|fixed record Box[T] { value: T }
		|pure func inspect[T](value: Box[Choice[T]]) -> Int:
		|    7
		|func main() -> Int:
		|    inspect({ value = Value(7) })
		|
	specialized(source).is_ok()


pure func test_unknown_generic_field_annotation_has_exact_diagnostic() -> Bool:
	exact_rejection("fixed record Box[T] { value: ", "Missing", " }\n" + MAIN,
		"unknown type", "declare or import this type; builtin types and declared type parameters are also available", pure func(kind):
			match kind:
				Errors.TypeTermRejection(Errors.UnknownType(_)): True
				_: False
	)


pure func test_nominal_argument_mismatch_renders_complete_record_type() -> Bool:
	prefix: String =
		|fixed record Box[T] { value: T }
		|pure func bad(value: Box[Int]) -> Box[String]:
		|
	exact_rejection(prefix + "    ", "value", "\n" + MAIN, "expression does not match the expected type", "use an expression of type Box[String] here", pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
				match (mismatch.expected, mismatch.actual.value_type):
					(Model.AppliedRecordType(owner, [Model.StringType]), Model.AppliedRecordType(actual, [Model.IntType])):
						Declaration.record_number(owner) == 0 and Declaration.record_number(actual) == 0
					_: False
			_: False
	)


pure func test_partial_record_application_occurs_check_keeps_finite_origin() -> Bool:
	declarations: String =
		|fixed record Box[T] { value: Int }
		|fixed record Pair[A, B] { value: Int }
		|pure func create[T]() -> Pair[T, Box[T]]:
		|    { value = 7 }
		|pure func repeated[T](value: Pair[T, T]) -> Int:
		|    7
		|func main() -> Int:
		|
	before_call = declarations + "    "
	exact_rejection(before_call + "repeated(", "create()", ")\n", "inferred type would contain itself", "pass a value with a finite type, or use a concrete helper", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.InfiniteTypeArgument(infinite)):
				owner_matches = match Model.parameter_owner(infinite.parameter):
					Model.FunctionDeclaration(owner): Declaration.function_number(owner) == 1 and Model.parameter_position(infinite.parameter) == 0
					_: False
				snapshot_matches = match infinite.recursive_type:
					Model.AppliedRecordType(owner, [Model.ParameterType(parameter)]): Declaration.record_number(owner) == 0 and Model.same_parameter(parameter, infinite.parameter)
					_: False
				owner_matches and snapshot_matches and infinite.call_span.start == before_call.length() and infinite.call_span.end == before_call.length() + "repeated".length() and same_source(infinite.call_span.source, module_source(root_module_id()))
			_: False
	)


pure func test_record_child_solution_cannot_supply_a_sibling_literal_owner() -> Bool:
	prefix: String =
		|fixed record Pair { first: Int }
		|fixed record Box[T] { value: T }
		|pure func make_pair() -> Pair:
		|    { first = 7 }
		|pure func inspect[T](left: Box[T], right: T) -> Int:
		|    0
		|func main() -> Int:
		|    inspect({ value = make_pair() },${" "}
	exact_rejection(
		prefix,
		"{ first = 7 }",
		")\n",
		"record literal needs an expected record type",
		"pass the literal to a concrete record parameter or return it from a helper declaring that record",
		pure func(kind):
			match kind:
				Errors.RecordRejection(Errors.RecordNeedsExpectedType): True
				_: False
	)


pure func test_record_child_solution_cannot_supply_a_sibling_constructor_owner() -> Bool:
	prefix: String =
		|fixed union Choice:
		|    First
		|fixed record Box[T] { value: T }
		|pure func make_choice() -> Choice:
		|    First
		|pure func inspect[T](left: Box[T], right: T) -> Int:
		|    0
		|func main() -> Int:
		|    inspect({ value = make_choice() },${" "}
	exact_rejection(
		prefix,
		"First",
		")\n",
		"constructor needs an expected union type",
		"pass an already-typed union value or call a concrete helper returning the union",
		pure func(kind):
			match kind:
				Errors.ConstructorRejection(Errors.ConstructorNeedsExpectedType(_)): True
				_: False
	)


private pure func explicit_result_context_publishes_sibling_type(source: String) -> Bool:
	match checked(source):
		Err(_): False
		Ok(program):
			match API.checked_functions(program).functions.get(2):
				None: False
				Some(function):
					match function.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.base:
								Model.ReturnCall(call, [_, sibling]):
									match call.target:
										Model.UserFunction(target, [argument]):
											(
												Declaration.function_number(target) == 1
												and Model.same_type(argument, function.signature.return_type.value_type)
												and Model.same_type(sibling.base_type, argument)
												and sibling.operations.is_empty()
											)
										_: False
								_: False
						_: False


pure func test_explicit_record_result_context_keeps_nominal_sibling_hint() -> Bool:
	source: String =
		|fixed record Pair { first: Int }
		|fixed record Box[T] { value: T }
		|pure func make_pair() -> Pair:
		|    { first = 7 }
		|pure func inspect[T](left: Box[T], right: T) -> T:
		|    right
		|pure func selected() -> Pair:
		|    inspect({ value = make_pair() }, { first = 7 })
		|func main() -> Int:
		|    0
		|
	explicit_result_context_publishes_sibling_type(source)


pure func test_explicit_union_result_context_keeps_nominal_sibling_hint() -> Bool:
	source: String =
		|fixed union Choice:
		|    First
		|fixed record Box[T] { value: T }
		|pure func make_choice() -> Choice:
		|    First
		|pure func inspect[T](left: Box[T], right: T) -> T:
		|    right
		|pure func selected() -> Choice:
		|    inspect({ value = make_choice() }, First)
		|func main() -> Int:
		|    0
		|
	explicit_result_context_publishes_sibling_type(source)


tests: TestSuite = {
	description = "Generic records and partial contextual literals",
	tests = [
		("explicit record result keeps sibling nominal hint", test_explicit_record_result_context_keeps_nominal_sibling_hint),
		("explicit union result keeps sibling nominal hint", test_explicit_union_result_context_keeps_nominal_sibling_hint),
		("record child cannot establish sibling literal owner", test_record_child_solution_cannot_supply_a_sibling_literal_owner),
		("record child cannot establish sibling constructor owner", test_record_child_solution_cannot_supply_a_sibling_constructor_owner),
		("ordered parameter syntax and spans", test_ordered_record_parameters_retain_spans_and_names),
		("record occurs keeps finite origin", test_partial_record_application_occurs_check_keeps_finite_origin),
		("unknown generic field type", test_unknown_generic_field_annotation_has_exact_diagnostic),
		("nominal mismatch complete record type", test_nominal_argument_mismatch_renders_complete_record_type),
		("applied equality preserves owner order and nesting", test_applied_record_equality_keeps_order_owner_and_nesting),
		("unused rigid field mismatch", test_unused_generic_field_rejects_a_concrete_value_for_rigid_parameter),
		("imported generic record identity", test_generic_record_import_keeps_declaration_identity),
		("nested union field shares inference slots", test_nested_union_constructor_shares_record_inference_slots),
		("rigid record and function owner identities", test_box_and_unbox_check_with_distinct_rigid_owners),
		("same reader uses each concrete instance", test_same_reader_uses_each_actual_concrete_receiver),
		("phantom keys remain distinct and inline", test_phantom_arguments_keep_distinct_inline_instances),
		("partial literal infers its receiving call", test_partial_record_literal_solves_the_receiving_call),
		("partial unique UFCS and nested fields", test_partial_unique_ufcs_and_nested_fields),
		("result context through nested calls", test_expected_result_passes_through_nested_calls),
		("contextless identity and field read reject", test_contextless_and_unowned_identity_literals_reject),
		("projection preserves child ordering", test_projection_preserves_deferred_child_before_later_name_error),
		("projection retains phantom ambiguity", test_int_projection_does_not_erase_phantom_ambiguity),
		("freeze all children before field mismatch", test_all_field_children_freeze_before_ordinary_mismatch),
		("shared field conflict follows written order", test_shared_field_parameter_conflict_follows_written_order),
		("child errors follow written order", test_field_child_errors_follow_written_order),
		("missing type arguments", test_missing_arguments_have_exact_typed_diagnostic),
		("type argument arity before child names", test_application_arity_precedes_child_type_resolution),
		("duplicate parameter owners and both spans", test_duplicate_record_parameter_owners_and_spans),
		("parameter type-name collision", test_record_parameter_cannot_shadow_builtin_type),
		("nongeneric application rejection", test_nongeneric_record_application_has_exact_diagnostic),
		("unused generic growth rejection", test_unreachable_growing_record_substitution_rejects),
		("permutation and concrete reset", test_finite_record_parameter_permutation_and_reset_remain_allowed),
		("unused recursive record rejection", test_recursive_record_applications_reject_even_unused),
		("Float and Void concrete storage", test_void_and_float_instances_derive_storage_from_fields),
		("List[Int] field rejects without literal", test_list_field_concrete_rejection_does_not_depend_on_literal),
		("List[String] field accepted", test_list_string_field_remains_supported),
	]
}
