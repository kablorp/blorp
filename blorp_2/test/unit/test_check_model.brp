import:
	../../src/check_model:
		TypeParameterOwner(FunctionDeclaration, UnionDeclaration, RecordDeclaration),
		TypeRef(
			VoidType, IntType, FloatType, StringType, ListType, RecordType, UnionType,
			AppliedUnionType, AppliedRecordType, ParameterType,
		),
		binding_id,
		binding_number,
		field_id,
		field_number,
		field_owner,
		parameter_position,
		same_parameter,
		same_type,
		same_types,
		type_parameter_id,
	../../src/declarations: function_id, record_id, record_number, union_id
	test: TestSuite


private pure func function_parameter(function: Int, position: Int) -> TypeRef:
	ParameterType(type_parameter_id(FunctionDeclaration(function_id(function)), position))


-- One representative of every TypeRef form; equal positions denote equal types.
private pure func representatives() -> List[TypeRef]:
	[
		VoidType,
		IntType,
		FloatType,
		StringType,
		ListType(StringType),
		ListType(function_parameter(0, 0)),
		RecordType(record_id(0)),
		RecordType(record_id(1)),
		UnionType(union_id(0)),
		UnionType(union_id(1)),
		AppliedUnionType(union_id(2), [IntType]),
		AppliedUnionType(union_id(2), [StringType]),
		AppliedUnionType(union_id(2), [IntType, IntType]),
		AppliedUnionType(union_id(3), [IntType]),
		AppliedRecordType(record_id(2), [IntType]),
		AppliedRecordType(record_id(2), [StringType]),
		AppliedRecordType(record_id(2), [IntType, StringType]),
		AppliedRecordType(record_id(2), [StringType, IntType]),
		AppliedRecordType(record_id(3), [IntType]),
		function_parameter(0, 0),
		function_parameter(0, 1),
		function_parameter(1, 0),
		ParameterType(type_parameter_id(UnionDeclaration(union_id(0)), 0)),
		ParameterType(type_parameter_id(RecordDeclaration(record_id(0)), 0)),
	]


pure func test_type_equality_is_structural_and_distinguishes_every_form() -> Bool:
	left_types = representatives()
	right_types = representatives()
	var correct = True
	var left_position = 0

	for left in left_types:
		var right_position = 0

		for right in right_types:
			correct = correct and same_type(left, right) == (left_position == right_position)
			right_position = right_position + 1

		left_position = left_position + 1

	correct


pure func test_parameter_identity_compares_owner_kind_owner_and_position() -> Bool:
	function_first = type_parameter_id(FunctionDeclaration(function_id(0)), 0)
	union_first = type_parameter_id(UnionDeclaration(union_id(0)), 0)
	(
		same_parameter(function_first, type_parameter_id(FunctionDeclaration(function_id(0)), 0))
		and not same_parameter(function_first, union_first)
		and not same_parameter(function_first, type_parameter_id(FunctionDeclaration(function_id(0)), 1))
		and parameter_position(type_parameter_id(UnionDeclaration(union_id(4)), 2)) == 2
	)


pure func test_checked_identities_retain_their_components() -> Bool:
	field = field_id(record_id(3), 1)
	(
		record_number(field_owner(field)) == 3
		and field_number(field) == 1
		and binding_number(binding_id(5)) == 5
	)


pure func test_type_vectors_preserve_empty_length_and_order() -> Bool:
	(
		same_types([], [])
		and not same_types([], [IntType])
		and not same_types([IntType], [])
		and not same_types([IntType], [IntType, StringType])
		and not same_types([IntType, StringType], [IntType])
		and same_types([IntType, StringType], [IntType, StringType])
		and not same_types([IntType, StringType], [StringType, IntType])
	)


pure func test_type_vectors_compare_nested_nominal_owners() -> Bool:
	first = AppliedRecordType(record_id(0), [
		AppliedUnionType(union_id(0), [ListType(function_parameter(0, 0))]),
		StringType,
	])
	equal = AppliedRecordType(record_id(0), [
		AppliedUnionType(union_id(0), [ListType(function_parameter(0, 0))]),
		StringType,
	])
	other_union = AppliedRecordType(record_id(0), [
		AppliedUnionType(union_id(1), [ListType(function_parameter(0, 0))]),
		StringType,
	])
	other_parameter = AppliedRecordType(record_id(0), [
		AppliedUnionType(union_id(0), [ListType(function_parameter(1, 0))]),
		StringType,
	])
	other_record = AppliedRecordType(record_id(1), [
		AppliedUnionType(union_id(0), [ListType(function_parameter(0, 0))]),
		StringType,
	])
	(
		same_types([first, VoidType], [equal, VoidType])
		and not same_types([first, VoidType], [other_union, VoidType])
		and not same_types([first, VoidType], [other_parameter, VoidType])
		and not same_types([first, VoidType], [other_record, VoidType])
		and not same_types([first, VoidType], [equal, StringType])
	)


tests: TestSuite = {
	description = "Blorp 2 checked program model",
	tests = [
		("type vectors preserve empty length and order", test_type_vectors_preserve_empty_length_and_order),
		("type vectors compare nested nominal owners", test_type_vectors_compare_nested_nominal_owners),
		(
			"type equality is structural and distinguishes every form",
			test_type_equality_is_structural_and_distinguishes_every_form,
		),
		(
			"parameter identity compares owner kind, owner and position",
			test_parameter_identity_compares_owner_kind_owner_and_position,
		),
		("checked identities retain their components", test_checked_identities_retain_their_components),
	]
}
