import:
	../../src/utils/names: program_names
	../../src/lex/lex: lex
	../../src/parse/assemble: ParsedAssembly, ParsedProgram, SealFailure(MalformedBundle, ImportCycle), append_module, assembly_names, begin_program, seal_program
	../../src/parse/parse: parse_module
	../../src/utils/source:
		compiler_source, ModuleId, ModuleKind(FoundationTypesModule, FoundationPreludeModule, LibraryModule, UserModule),
		module_id, module_source, root_module_id,
	../../src/utils/syntax: Diagnostic, LexedProgram, diagnostic
	int as IntOps
	option: to_result
	result: and_then, map


-- A test foundation: the base declarations, and what the test prelude selects
-- from the base. User modules see base types only through the prelude, as in
-- the configured target library.
fixed record TestFoundation {
	types: String,
	prelude_selections: String
}


-- The complete foundation contract: the five primitive heads and the three
-- designated unions the foundation check requires.
FOUNDATION_TYPES: String =
	|type Int = builtin
	|type Float = builtin
	|type String = builtin
	|type Void = builtin
	|type List[T] = builtin
	|fixed union Bool:
	|    True
	|    False
	|fixed union Option[A]:
	|    Some(A)
	|    None
	|fixed union Result[Value, Error]:
	|    Ok(Value)
	|    Err(Error)
	|


-- Raw downstream phase tests see only the primitives: their prelude selects no
-- designated union, so test programs may declare their own unions freely.
PRIMITIVE_BASE: TestFoundation = { types = FOUNDATION_TYPES, prelude_selections = "Int, Float, String, Void, List" }


-- Namespace tests also exercise the ordinary nominal base declarations.
TEST_BASE: TestFoundation = {
	types = FOUNDATION_TYPES,
	prelude_selections = "Int, Float, String, Void, List, Bool(True, False), Option(Some, None), Result(Ok, Err)"
}


fixed record ModuleInput {
	source: String,
	targets: List[Int]
}


private pure func invalid_identity() -> Diagnostic:
	{
		span = { source = compiler_source(), start = 0, end = 0 },
		note = None,
		message = "invalid test module inventory",
		help = "supply module ordinals from this explicit input list and one resolved target per written import"
	}


private pure func append_input(assembly: ParsedAssembly, input: ModuleInput, position: Int, role: ModuleKind) -> Result[ParsedAssembly, Diagnostic]:
	module ?= module_id(position).to_result(invalid_identity())
	tokens ?= lex(module_source(module), input.source, assembly_names(assembly))
	parsed ?= parse_module(tokens, module)
	var resolved: Result[List[ModuleId], Diagnostic] = Ok([])
	for ordinal in input.targets:
		resolved = resolved.and_then(pure func(targets): module_id(ordinal).to_result(invalid_identity()).map(pure func(target): targets.append(target)))
	targets ?= resolved
	append_module(assembly, parsed, targets, role)


-- The test prelude's source: one import of the base.
pure func prelude_source(foundation: TestFoundation) -> String:
	"import:\n    _base: " + foundation.prelude_selections + "\n"


-- The base at `position`, then the prelude after it.
private pure func append_foundation(assembly: ParsedAssembly, position: Int, types: String, prelude: ModuleInput) -> Result[ParsedProgram, Diagnostic]:
	base ?= append_input(assembly, { source = types, targets = [] }, position, FoundationTypesModule)
	complete ?= append_input(base, prelude, IntOps.add(position, 1), FoundationPreludeModule)
	sealed(complete)


-- Sealing as the loader does. A cycle is reported at its closing import; the
-- loader's own text, with display paths, is tested in `test_load`.
pure func sealed(assembly: ParsedAssembly) -> Result[ParsedProgram, Diagnostic]:
	match seal_program(assembly):
		Ok(program): Ok(program)
		Err(MalformedBundle(error)): Err(error)
		Err(ImportCycle(_, closing)): Err(diagnostic(closing, "import cycle among the test modules", "remove one import of the cycle"))


-- Already resolved edges preserve user declaration ordinals. The test prelude
-- adds no operation functions; production defaults have separate e2e tests.
-- Inputs from position `first_library` on are library modules, which do not
-- receive the prelude. An input's target is another input's position; only the
-- prelude may also name the base, which follows the inputs, so a missing
-- target never binds to the foundation.
private pure func parse_in_roles(inputs: List[ModuleInput], types: String, prelude: ModuleInput, first_library: Int) -> Result[ParsedProgram, Diagnostic]:
	var valid_targets = True
	for input in inputs:
		for ordinal in input.targets:
			valid_targets = valid_targets and IntOps.greater_than_or_equal(ordinal, 0) and IntOps.less_than(ordinal, inputs.length())
	for ordinal in prelude.targets:
		valid_targets = valid_targets and IntOps.greater_than_or_equal(ordinal, 0) and IntOps.less_than_or_equal(ordinal, inputs.length())
	targets ?= if valid_targets:
		Ok(void)
	else:
		Err(invalid_identity())
	var assembly: Result[ParsedAssembly, Diagnostic] = Ok(begin_program())
	var position: Int = 0
	for input in inputs:
		ordinal = position
		role = if IntOps.less_than(position, first_library):
			UserModule
		else:
			LibraryModule
		assembly = assembly.and_then(pure func(builder): append_input(builder, input, ordinal, role))
		position = IntOps.add(position, 1)
	complete ?= assembly
	append_foundation(complete, position, types, prelude)


-- The prelude of `foundation`: one import of the base, which follows the inputs.
private pure func foundation_prelude(inputs: List[ModuleInput], foundation: TestFoundation) -> ModuleInput:
	{ source = prelude_source(foundation), targets = [inputs.length()] }


pure func parse_modules_with_base(inputs: List[ModuleInput], foundation: TestFoundation) -> Result[ParsedProgram, Diagnostic]:
	parse_in_roles(inputs, foundation.types, foundation_prelude(inputs, foundation), inputs.length())


pure func parse_modules(inputs: List[ModuleInput]) -> Result[ParsedProgram, Diagnostic]:
	parse_modules_with_base(inputs, TEST_BASE)


pure func parse_modules_with_libraries(inputs: List[ModuleInput], first_library: Int) -> Result[ParsedProgram, Diagnostic]:
	parse_in_roles(inputs, TEST_BASE.types, foundation_prelude(inputs, TEST_BASE), first_library)


-- The same, with a prelude of the test's own over the test base.
pure func parse_modules_with_prelude(inputs: List[ModuleInput], first_library: Int, prelude: ModuleInput) -> Result[ParsedProgram, Diagnostic]:
	parse_in_roles(inputs, TEST_BASE.types, prelude, first_library)


-- Callers select these small source inputs explicitly, together with their edges.
INTEGER_OPERATIONS: String =
	|pure func to_string(value: Int) -> String:
	|    builtin("int.to_string")
	|pure func add(left: Int, right: Int) -> Int:
	|    builtin("int.add")
	|


STRING_OPERATIONS: String =
	|pure func length(value: String) -> Int:
	|    builtin("string.length")
	|


FLOAT_OPERATIONS: String =
	|pure func to_string(value: Float) -> String:
	|    builtin("float.to_string")
	|


-- Source-only phase tests have no implicit operation dependencies.
pure func parse_root(input: LexedProgram) -> Result[ParsedProgram, Diagnostic]:
	assembly = begin_program()
	parsed ?= parse_module(input, root_module_id())
	root ?= append_module(assembly, parsed, [], UserModule)
	append_foundation(root, 1, PRIMITIVE_BASE.types, { source = prelude_source(PRIMITIVE_BASE), targets = [1] })
