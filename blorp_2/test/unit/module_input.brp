import:
	../../src/lex: lex
	../../src/parse:
		ParsedAssembly,
		ParsedProgram,
		append_module,
		assembly_names,
		begin_program,
		parse_module,
		seal_program,
	../../src/source: COMPILER_SOURCE, ModuleId, module_id, module_source
	../../src/syntax: Diagnostic
	input: checked_prelude
	int as IntOps
	option: to_result


fixed record ModuleInput {
	source: String,
	targets: List[Int]
}


private pure func invalid_identity() -> Diagnostic:
	{
		span = { source = COMPILER_SOURCE, start = 0, end = 0 },
		note = None,
		message = "invalid test module identity",
		help = "supply nonnegative module ordinals in source inventory order"
	}


private pure func append_input(assembly: ParsedAssembly, input: ModuleInput, position: Int) -> Result[ParsedAssembly, Diagnostic]:
	module ?= module_id(position).to_result(invalid_identity())
	tokens ?= lex(module_source(module), input.source)
	parsed ?= parse_module(tokens, module, assembly_names(assembly))
	var targets: List[ModuleId] = []
	var failure: Option[Diagnostic] = None
	for ordinal in input.targets:
		match module_id(ordinal):
			None:
				failure = Some(invalid_identity())
				break
			Some(target):
				targets = targets.append(target)
	valid ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)
	append_module(assembly, parsed, targets)


-- Tests supply already resolved edges, so this helper performs no path lookup.
pure func parse_modules(inputs: List[ModuleInput]) -> Result[ParsedProgram, Diagnostic]:
	prelude ?= checked_prelude()
	var assembly = begin_program(prelude)
	var position: Int = 0
	var failure: Option[Diagnostic] = None
	for input in inputs:
		match append_input(assembly, input, position):
			Err(error):
				failure = Some(error)
				break
			Ok(linked):
				assembly = linked
		position = IntOps.add(position, 1)
	valid ?= match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)
	seal_program(assembly)
