import:
	int as IntOps
	string as StringOps
	bool: not
	../../../src/utils/ids: FunctionRow, inventory_functions
	../../../src/utils/source:
		SourceId,
		module_source,
		root_module_id,
		same_module,
		same_source,
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/syntax: ParsedBody(ParsedValueBody), ParsedFunction, Span
	../module_input: parse_modules
	test: TestSuite


private pure func exact_span(span: Span, origin: SourceId, start: Int, end: Int) -> Bool:
	match same_source(span.source, origin):
		False: False
		True:
			match IntOps.equals(span.start, start):
				False: False
				True:
					IntOps.equals(span.end, end)


private pure func keeps_origin(function: ParsedFunction, origin: SourceId) -> Bool:
	match function.body:
		ParsedValueBody(value):
			match exact_span(function.function_name.span, origin, 5, 9):
				False: False
				True:
					match exact_span(value.base_span, origin, 21, 23):
						False: False
						True:
							exact_span(value.span, origin, 21, 34)
		_:
			False


pure func test_parser_composed_spans_keep_the_module_origin() -> Bool:
	source: String =
		|func main() -> Int:
		|	42.identity()
		|
	match parse_modules([{ source = source, targets = [] }, { source = source, targets = [] }]):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)
			match (program.modules, inventory_functions(program.declarations).map(pure func(row: FunctionRow) -> ParsedFunction: row.declaration)):
				([root, dependency, _, _], [root_function, dependency_function]):
					root_origin = module_source(root.module)
					dependency_origin = module_source(dependency.module)
					var valid: Bool = same_module(root.module, root_module_id())
					if valid:
						valid = same_module(root_function.module, root.module)
					if valid:
						valid = same_module(dependency_function.module, dependency.module)
					if valid:
						valid = not(same_source(root_origin, dependency_origin))
					if valid:
						valid = keeps_origin(root_function, root_origin)
					if valid:
						valid = keeps_origin(dependency_function, dependency_origin)
					if valid:
						valid = exact_span(root.end, root_origin, StringOps.length(source), StringOps.length(source))
					if valid:
						valid = exact_span(dependency.end, dependency_origin, StringOps.length(source), StringOps.length(source))
					if valid:
						valid = exact_span(program.end, root_origin, StringOps.length(source), StringOps.length(source))
					valid
				_:
					False


tests: TestSuite = {
	description = "Blorp 2 parser source provenance",
	tests = [
		("parser composed spans keep the module origin", test_parser_composed_spans_keep_the_module_origin),
	]
}
