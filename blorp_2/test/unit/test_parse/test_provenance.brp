import:
	../../../src/utils/declarations: inventory_functions
	../../../src/utils/source:
		SourceId,
		module_source,
		root_module_id,
		same_module,
		same_source,
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/syntax: ParsedBody(ParsedValueBody), ParsedFunction, Span
	../module_input: parse_modules
	test: TestSuite


private pure func exact_span(span: Span, origin: SourceId, start: Int, end: Int) -> Bool:
	same_source(span.source, origin) and span.start == start and span.end == end


private pure func keeps_origin(function: ParsedFunction, origin: SourceId) -> Bool:
	match function.body:
		ParsedValueBody(value):
			(
				exact_span(function.function_name.span, origin, 5, 9)
				and exact_span(value.base_span, origin, 21, 23)
				and exact_span(value.span, origin, 21, 34)
			)
		_:
			False


pure func test_parser_composed_spans_keep_the_module_origin() -> Bool:
	source: String =
		|func main() -> Int:
		|	42.identity()
		|
	match parse_modules([{ source = source, targets = [] }, { source = source, targets = [] }]):
		Err(_):
			False
		Ok(parsed):
			program = parsed_contents(parsed)
			match (program.modules, inventory_functions(program.declarations).map(pure func(row): row.declaration)):
				([root, dependency, _, _], [root_function, dependency_function]):
					root_origin = module_source(root.module)
					dependency_origin = module_source(dependency.module)
					(
						same_module(root.module, root_module_id())
						and same_module(root_function.module, root.module)
						and same_module(dependency_function.module, dependency.module)
						and not same_source(root_origin, dependency_origin)
						and keeps_origin(root_function, root_origin)
						and keeps_origin(dependency_function, dependency_origin)
						and exact_span(root.end, root_origin, source.length(), source.length())
						and exact_span(dependency.end, dependency_origin, source.length(), source.length())
						and exact_span(program.end, root_origin, source.length(), source.length())
					)
				_:
					False


tests: TestSuite = {
	description = "Blorp 2 parser source provenance",
	tests = [
		("parser composed spans keep the module origin", test_parser_composed_spans_keep_the_module_origin),
	]
}
