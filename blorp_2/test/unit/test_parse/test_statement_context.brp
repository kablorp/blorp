import:
	../../../src/lex/lex: lex
	../../../src/parse/parse: ParsedModule, parse_module
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: Diagnostic
	test: TestSuite


private HEADER: String = "func main() -> Int:\n"

private LOOP_ONLY_HELP: String = "move `break` into a `while` or `for` body, or remove it"

private VALUE_HELP: String = "write the `if` or `match` as a statement on its own line, or move `break` out of it"

private NO_PROPAGATION_MESSAGE: String = "`?=` cannot be used inside a loop body"

private NO_PROPAGATION_HELP: String = "bind it before the loop, or use `match` inside the loop"

private BLOCK_PROPAGATION_MESSAGE: String = "`?=` cannot be used inside an `if` or `match` block"

private BLOCK_PROPAGATION_HELP: String = "match on the Result or Option in place, or move the block into its own function and use `?=` at its top"


private pure func parse_source(source: String) -> Result[ParsedModule, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parse_module(tokens, root_module_id())


private pure func accepts(source: String) -> Bool:
	parse_source(source).is_ok()


private pure func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
	match parse_source(source):
		Err(diagnostic):
			diagnostic.span.start == start and diagnostic.span.end == end and diagnostic.message == message and diagnostic.help == help
		Ok(_):
			False


-- Host 5.3: `break` and `continue` need an enclosing loop body; a function
-- body starts a new context, and a loop's context ends with its body.
pure func test_loop_controls_need_a_loop() -> Bool:
	(
		rejects(HEADER + "\tbreak\n\t0\n", 21, 26, "`break` can only be used inside a loop", LOOP_ONLY_HELP)
		and rejects(HEADER + "\tcontinue\n\t0\n", 21, 29, "`continue` can only be used inside a loop", "move `continue` into a `while` or `for` body, or remove it")
		and rejects(HEADER + "\twhile True:\n\t\tx = 1\n\tbreak\n\t0\n", 42, 47, "`break` can only be used inside a loop", LOOP_ONLY_HELP)
		and rejects(HEADER + "\tif True:\n\t\tbreak\n\t0\n", 32, 37, "`break` can only be used inside a loop", LOOP_ONLY_HELP)
	)


-- Statement-position `if` and `match` inside a loop body keep its context.
pure func test_loop_controls_inside_statement_blocks_are_accepted() -> Bool:
	(
		accepts(HEADER + "\twhile True:\n\t\tbreak\n\t0\n")
		and accepts(HEADER + "\tfor x in [1]:\n\t\tif True:\n\t\t\tbreak\n\t\telse:\n\t\t\tcontinue\n\t0\n")
		and accepts(HEADER + "\twhile True:\n\t\tmatch 1:\n\t\t\t_:\n\t\t\t\tbreak\n\t0\n")
		and accepts(HEADER + "\twhile True:\n\t\tfor y in [1]:\n\t\t\tbreak\n\t\tcontinue\n\t0\n")
	)


-- Owner rule: an `if` or `match` used as a value within a loop is no place
-- for a loop control; a loop nested inside it starts a loop context again.
pure func test_loop_controls_inside_value_blocks_are_rejected() -> Bool:
	(
		rejects(HEADER + "\twhile True:\n\t\tx = if True:\n\t\t\tbreak\n\t\telse:\n\t\t\t1\n\t0\n", 51, 56, "`break` cannot be used inside an `if` or `match` used as a value", VALUE_HELP)
		and rejects(HEADER + "\twhile True:\n\t\tx = match 1:\n\t\t\t_:\n\t\t\t\tcontinue\n\t0\n", 58, 66, "`continue` cannot be used inside an `if` or `match` used as a value", "write the `if` or `match` as a statement on its own line, or move `continue` out of it")
		and accepts(HEADER + "\twhile True:\n\t\tx = if True:\n\t\t\twhile True:\n\t\t\t\tbreak\n\t\t\t1\n\t\telse:\n\t\t\t2\n\t0\n")
	)


-- Owner rule: an `if` or `match` inside a header is used as a value, even
-- when the header's own `if` or `match` is a statement.
pure func test_loop_controls_inside_header_values_are_rejected() -> Bool:
	message = "`break` cannot be used inside an `if` or `match` used as a value"
	(
		rejects(HEADER + "\twhile True:\n\t\tif if True:\n\t\t\tbreak\n\t\telse:\n\t\t\tTrue\n\t\t:\n\t\t\tvoid\n\t0\n", 50, 55, message, VALUE_HELP)
		and rejects(HEADER + "\twhile True:\n\t\tmatch match x:\n\t\t\t_: break\n\t\t:\n\t\t\t_: void\n\t0\n", 56, 61, message, VALUE_HELP)
		and rejects(HEADER + "\twhile True:\n\t\tif f(if True:\n\t\t\tbreak\n\t\telse:\n\t\t\tTrue\n\t\t):\n\t\t\tvoid\n\t0\n", 52, 57, message, VALUE_HELP)
		and rejects(HEADER + "\twhile True:\n\t\tif False:\n\t\t\tvoid\n\t\telse if f(if True:\n\t\t\tbreak\n\t\telse:\n\t\t\tTrue\n\t\t):\n\t\t\tvoid\n\t0\n", 77, 82, message, VALUE_HELP)
		and rejects(HEADER + "\tfor x in [1]:\n\t\tmatch f(match x:\n\t\t\t_: continue\n\t\t):\n\t\t\t_: void\n\t0\n", 60, 68, "`continue` cannot be used inside an `if` or `match` used as a value", "write the `if` or `match` as a statement on its own line, or move `continue` out of it")
		and rejects(HEADER + "\twhile True:\n\t\tmatch 1:\n\t\t\t_: if f(if True:\n\t\t\t\tbreak\n\t\t\telse:\n\t\t\t\tTrue\n\t\t\t):\n\t\t\t\tvoid\n\t0\n", 68, 73, message, VALUE_HELP)
	)


-- A loop nested in a loop reads its `while` condition under the outer
-- loop's context, so a value `if` there is still a value position.
pure func test_loop_controls_inside_nested_while_condition_are_rejected() -> Bool:
	rejects(HEADER + "\tfor y in [1]:\n\t\twhile if True:\n\t\t\tbreak\n\t\telse:\n\t\t\tTrue\n\t\t:\n\t\t\tvoid\n\t0\n", 55, 60, "`break` cannot be used inside an `if` or `match` used as a value", VALUE_HELP)


-- The same for a nested `for` iterable.
pure func test_loop_controls_inside_nested_for_iterable_are_rejected() -> Bool:
	rejects(HEADER + "\twhile True:\n\t\tfor x in if True:\n\t\t\tbreak\n\t\telse:\n\t\t\t[1]\n\t\t:\n\t\t\tvoid\n\t0\n", 56, 61, "`break` cannot be used inside an `if` or `match` used as a value", VALUE_HELP)


-- An initializer on the next line is a value position like one on the
-- binding's line.
pure func test_loop_controls_inside_next_line_initializer_are_rejected() -> Bool:
	rejects(HEADER + "\twhile True:\n\t\tx =\n\t\t\tif True:\n\t\t\t\tbreak\n\t\t\telse:\n\t\t\t\t1\n\t0\n", 55, 60, "`break` cannot be used inside an `if` or `match` used as a value", VALUE_HELP)


-- A value's context ends with it: the statement's own blocks and the next
-- line are back in the loop body.
pure func test_loop_body_resumes_after_a_value_if_or_match() -> Bool:
	(
		accepts(HEADER + "\twhile True:\n\t\tif f(if True:\n\t\t\tTrue\n\t\telse:\n\t\t\tFalse\n\t\t):\n\t\t\tbreak\n\t0\n")
		and accepts(HEADER + "\tfor x in [1]:\n\t\tmatch f(match x:\n\t\t\t_: 1\n\t\t):\n\t\t\t_: break\n\t0\n")
		and accepts(HEADER + "\twhile True:\n\t\tx = if True:\n\t\t\t1\n\t\telse:\n\t\t\t2\n\t\tbreak\n\t0\n")
	)


-- Host 5.3: `?=` is invalid anywhere inside a loop body, however nested;
-- it is fine before and after the loop.
pure func test_propagation_is_rejected_inside_loops() -> Bool:
	(
		rejects(HEADER + "\twhile True:\n\t\tx ?= find(1)\n\t0\n", 37, 39, NO_PROPAGATION_MESSAGE, NO_PROPAGATION_HELP)
		and rejects(HEADER + "\tfor a in [1]:\n\t\tif True:\n\t\t\tx ?= find(1)\n\t0\n", 51, 53, NO_PROPAGATION_MESSAGE, NO_PROPAGATION_HELP)
		and rejects(HEADER + "\twhile True:\n\t\ty = if True:\n\t\t\tx ?= find(1)\n\t\t\t1\n\t\telse:\n\t\t\t2\n\t0\n", 53, 55, NO_PROPAGATION_MESSAGE, NO_PROPAGATION_HELP)
		and accepts(HEADER + "\ta ?= find(1)\n\twhile True:\n\t\tbreak\n\tb ?= find(2)\n\tb\n")
	)


pure func test_propagation_is_rejected_in_statement_if() -> Bool:
	source: String =
		|func main() -> Int:
		|    if False:
		|        value ?= Some(1)
		|    0
		|
	rejects(source, 48, 50, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_statement_match() -> Bool:
	source: String =
		|func main() -> Int:
		|    match 1:
		|        _:
		|            value ?= Some(1)
		|            void
		|    0
		|
	rejects(source, 62, 64, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_tail_match_arm() -> Bool:
	source: String =
		|func main() -> Int:
		|    match 1:
		|        _:
		|            value ?= Some(1)
		|            0
		|
	rejects(source, 62, 64, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_nested_arm_block() -> Bool:
	source: String =
		|func main() -> Int:
		|    match 1:
		|        _:
		|            if True:
		|                value ?= Some(1)
		|            0
		|
	rejects(source, 87, 89, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_value_if() -> Bool:
	source: String =
		|func main() -> Int:
		|    result = if True:
		|        value ?= Some(1)
		|        1
		|    else:
		|        2
		|    0
		|
	rejects(source, 56, 58, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_value_match() -> Bool:
	source: String =
		|func main() -> Int:
		|    result = match 1:
		|        _:
		|            value ?= Some(1)
		|            1
		|    0
		|
	rejects(source, 71, 73, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_else_block() -> Bool:
	source: String =
		|func main() -> Int:
		|    if True:
		|        void
		|    else:
		|        value ?= Some(1)
		|    0
		|
	rejects(source, 70, 72, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_else_if_block() -> Bool:
	source: String =
		|func main() -> Int:
		|    if True:
		|        void
		|    else if False:
		|        value ?= Some(1)
		|    else:
		|        void
		|    0
		|
	rejects(source, 79, 81, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_inline_match_arm() -> Bool:
	source: String =
		|func main() -> Int:
		|    match 1:
		|        _: value ?= Some(1)
		|    0
		|
	rejects(source, 50, 52, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_while_condition() -> Bool:
	source: String =
		|func main() -> Int:
		|    while if True:
		|        value ?= Some(1)
		|        True
		|    else:
		|        False
		|    :
		|        void
		|    0
		|
	rejects(source, 53, 55, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_propagation_is_rejected_in_for_iterable() -> Bool:
	source: String =
		|func main() -> Int:
		|    for item in match 1:
		|        _:
		|            value ?= Some(1)
		|            [1]
		|    :
		|        void
		|    0
		|
	rejects(source, 74, 76, BLOCK_PROPAGATION_MESSAGE, BLOCK_PROPAGATION_HELP)


pure func test_top_level_propagation_after_if_is_accepted() -> Bool:
	source: String =
		|func main() -> Int:
		|    first ?= Some(1)
		|    if True:
		|        void
		|    else if False:
		|        void
		|    else:
		|        void
		|    second ?= Some(2)
		|    0
		|
	accepts(source)


pure func test_top_level_propagation_after_match_is_accepted() -> Bool:
	source: String =
		|func main() -> Int:
		|    first ?= Some(1)
		|    match 1:
		|        _: void
		|    second ?= Some(2)
		|    0
		|
	accepts(source)


pure func test_break_after_function_if_still_needs_a_loop() -> Bool:
	source: String =
		|func main() -> Int:
		|    if True:
		|        void
		|    break
		|    0
		|
	rejects(source, 50, 55, "`break` can only be used inside a loop", "move `break` into a `while` or `for` body, or remove it")


pure func test_break_after_function_match_still_needs_a_loop() -> Bool:
	source: String =
		|func main() -> Int:
		|    match 1:
		|        _: void
		|    break
		|    0
		|
	rejects(source, 53, 58, "`break` can only be used inside a loop", "move `break` into a `while` or `for` body, or remove it")


pure func test_continue_after_function_if_still_needs_a_loop() -> Bool:
	source: String =
		|func main() -> Int:
		|    if True:
		|        void
		|    continue
		|    0
		|
	rejects(source, 50, 58, "`continue` can only be used inside a loop", "move `continue` into a `while` or `for` body, or remove it")


pure func test_continue_after_function_match_still_needs_a_loop() -> Bool:
	source: String =
		|func main() -> Int:
		|    match 1:
		|        _: void
		|    continue
		|    0
		|
	rejects(source, 53, 61, "`continue` can only be used inside a loop", "move `continue` into a `while` or `for` body, or remove it")


pure func test_lambda_block_keeps_its_propagation_rejection() -> Bool:
	source: String =
		|func main() -> Int:
		|    callback = func():
		|        if True:
		|            value ?= Some(1)
		|        0
		|    0
		|
	rejects(source, 78, 80, "`?=` cannot be used inside a lambda body", "match on the Result or Option inside the lambda, or bind the value before the lambda")


tests: TestSuite = {
	description = "Blorp 2 statement context",
	tests = [
		("loop controls need a loop", test_loop_controls_need_a_loop),
		("loop controls inside statement blocks are accepted", test_loop_controls_inside_statement_blocks_are_accepted),
		("loop controls inside value blocks are rejected", test_loop_controls_inside_value_blocks_are_rejected),
		("loop controls inside header values are rejected", test_loop_controls_inside_header_values_are_rejected),
		("loop controls inside a nested while condition are rejected", test_loop_controls_inside_nested_while_condition_are_rejected),
		("loop controls inside a nested for iterable are rejected", test_loop_controls_inside_nested_for_iterable_are_rejected),
		("loop controls inside a next-line initializer are rejected", test_loop_controls_inside_next_line_initializer_are_rejected),
		("loop body resumes after a value if or match", test_loop_body_resumes_after_a_value_if_or_match),
		("propagation is rejected inside loops", test_propagation_is_rejected_inside_loops),
		("propagation is rejected in statement if", test_propagation_is_rejected_in_statement_if),
		("propagation is rejected in statement match", test_propagation_is_rejected_in_statement_match),
		("propagation is rejected in tail match arm", test_propagation_is_rejected_in_tail_match_arm),
		("propagation is rejected in nested arm block", test_propagation_is_rejected_in_nested_arm_block),
		("propagation is rejected in value if", test_propagation_is_rejected_in_value_if),
		("propagation is rejected in value match", test_propagation_is_rejected_in_value_match),
		("propagation is rejected in else block", test_propagation_is_rejected_in_else_block),
		("propagation is rejected in else if block", test_propagation_is_rejected_in_else_if_block),
		("propagation is rejected in inline match arm", test_propagation_is_rejected_in_inline_match_arm),
		("propagation is rejected in while condition", test_propagation_is_rejected_in_while_condition),
		("propagation is rejected in for iterable", test_propagation_is_rejected_in_for_iterable),
		("top-level propagation after if is accepted", test_top_level_propagation_after_if_is_accepted),
		("top-level propagation after match is accepted", test_top_level_propagation_after_match_is_accepted),
		("break after function if needs a loop", test_break_after_function_if_still_needs_a_loop),
		("break after function match needs a loop", test_break_after_function_match_still_needs_a_loop),
		("continue after function if needs a loop", test_continue_after_function_if_still_needs_a_loop),
		("continue after function match needs a loop", test_continue_after_function_match_still_needs_a_loop),
		("lambda block keeps its propagation rejection", test_lambda_block_keeps_its_propagation_rejection),
	]
}
