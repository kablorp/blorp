import:
	string as StringOps
	int as IntOps
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: ParsedBody(ParsedBuiltinBody), ParsedRuntimeOperation(WriteFileBuiltin)
	../module_input: parse_modules
	test: TestSuite


pure func test_write_file_label_preserves_its_span() -> Bool:
	header = "func query(path: String, contents: String) -> Result[Void, String]:\n    builtin("
	source: String =
		|func query(path: String, contents: String) -> Result[Void, String]:
		|    builtin("system.write_file")
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program):
			match inventory_functions(parsed_contents(program).declarations).get(0):
				Some(row):
					match row.declaration.body:
						ParsedBuiltinBody(WriteFileBuiltin, span):
							match same_source(span.source, module_source(root_module_id())):
								False: False
								True:
									match IntOps.equals(span.start, StringOps.length(header)):
										False: False
										True:
											match IntOps.equals(span.end, IntOps.add(StringOps.length(header), StringOps.length("\"system.write_file\""))):
												False: False
												True:
													row.declaration.statements.is_empty()
						_: False
				None: False


tests: TestSuite = {
	description = "Blorp 2 file-write label",
	tests = [
		("write_file label preserves its source span", test_write_file_label_preserves_its_span),
	]
}
