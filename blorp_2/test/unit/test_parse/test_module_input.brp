import:
    ../../../src/check/check: check, checked_functions
    ../../../src/check/model as Checked
    ../../../src/utils/ids: function_number, inventory_functions, inventory_unions
    ../../../src/lex/lex: lex
    ../../../src/utils/names: same_name, program_names
    ../../../src/parse/assemble: parsed_contents
    ../../../src/utils/source: module_number, module_source, root_module_id, same_source, compiler_source
    ../module_input: PRIMITIVE_BASE, parse_modules_with_base, parse_root
    option: is_none
    result: and_then
    test: TestSuite


private ROOT: String =
    |func main() -> Int:
    |    0
    |


pure func test_root_only_has_no_operation_modules() -> Bool:
    match lex(module_source(root_module_id()), ROOT, program_names().names).and_then(parse_root):
        Err(_): False
        Ok(program):
            contents = parsed_contents(program)
            -- The foundation's Bool, Option and Result are the only unions.
            contents.modules.length() == 3 and inventory_functions(contents.declarations).length() == 1 and inventory_unions(contents.declarations).length() == 3


pure func test_root_import_requires_explicit_dependency_inputs() -> Bool:
    source: String =
        |import:
        |    int: Int
        |func main() -> Int:
        |    0
        |
    match lex(module_source(root_module_id()), source, program_names().names).and_then(parse_root):
        Ok(_): False
        Err(error):
            (
                error.message == "source bundle does not supply exactly one target per import"
                and error.help == "load each module once in inventory order and supply every import target"
                and same_source(error.span.source, compiler_source())
                and error.span.start == 0 and error.span.end == 0 and error.note.is_none()
            )


pure func test_written_module_spelling_uses_only_supplied_source() -> Bool:
    root: String =
        |import:
        |    int: answer
        |func main() -> Int:
        |    answer()
        |
    supplied: String =
        |pure func answer() -> Int:
        |    99
        |
    match parse_modules_with_base([
        { source = root, targets = [1] },
        { source = supplied, targets = [] },
    ], PRIMITIVE_BASE):
        Err(_): False
        Ok(program):
            contents = parsed_contents(program)
            contents.modules.length() == 4 and inventory_functions(contents.declarations).length() == 2 and check(program).is_ok()


pure func test_missing_target_cannot_bind_to_appended_foundation() -> Bool:
    root: String =
        |import:
        |    ./missing: answer
        |func main() -> Int:
        |    0
        |
    match parse_modules_with_base([
        { source = root, targets = [1] },
    ], PRIMITIVE_BASE):
        Ok(_): False
        Err(error):
            (
                error.message == "invalid test module inventory"
                and error.help == "supply module ordinals from this explicit input list and one resolved target per written import"
                and same_source(error.span.source, compiler_source())
                and error.span.start == 0 and error.span.end == 0 and error.note.is_none()
            )


pure func test_same_spelled_functions_keep_their_defining_modules() -> Bool:
    root: String =
        |import:
        |    ./left: left
        |    ./right: right
        |func main() -> Int:
        |    left()
        |
    left: String =
        |pure func left() -> Int:
        |    answer()
        |pure func answer() -> Int:
        |    1
        |
    right: String =
        |pure func right() -> Int:
        |    answer()
        |pure func answer() -> Int:
        |    2
        |
    match parse_modules_with_base([
        { source = root, targets = [1, 2] },
        { source = left, targets = [] },
        { source = right, targets = [] },
    ], PRIMITIVE_BASE):
        Err(_): False
        Ok(program):
            parsed = parsed_contents(program)
            match inventory_functions(parsed.declarations).map(pure func(row): row.declaration):
                [_, _, left_answer, _, right_answer]:
                    match check(program):
                        Err(_): False
                        Ok(checked):
                            match checked_functions(checked).functions:
                                [_, left_function, _, right_function, _]:
                                    (
                                        same_name(left_answer.function_name.id, right_answer.function_name.id)
                                        and module_number(left_answer.module) == 1 and module_number(right_answer.module) == 2
                                        and calls(left_function, 2) and calls(right_function, 4)
                                    )
                                _: False
                _: False


private pure func calls(function: Checked.CheckedFunction, ordinal: Int) -> Bool:
    match Checked.function_calls(function):
        [call]:
            ordinary = call.operands.all(pure func(operand):
                match operand:
                    Checked.ValueOperand(_): True
                    Checked.CallableOperand(_, _, _): False
            )
            match (call.target, ordinary):
                (Checked.UserFunction(id, []), True): function_number(id) == ordinal
                _: False
        _: False


tests: TestSuite = {
    description = "Blorp 2 explicit unit module inputs",
    tests = [
        ("root only has no operation modules", test_root_only_has_no_operation_modules),
        ("root import requires explicit dependency inputs", test_root_import_requires_explicit_dependency_inputs),
        ("written spelling uses supplied source", test_written_module_spelling_uses_only_supplied_source),
        ("missing target cannot bind to foundation", test_missing_target_cannot_bind_to_appended_foundation),
        ("same spelling preserves defining modules", test_same_spelled_functions_keep_their_defining_modules),
    ]
}
