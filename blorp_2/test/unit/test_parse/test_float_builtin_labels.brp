import:
	result: and_then, is_ok
	../../../src/utils/syntax: Diagnostic, LexedProgram
	../../../src/lex/lex: lex
	../../../src/parse/parse: ParsedModule, parse_module
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	test: TestSuite


private pure func accepts(source: String) -> Bool:
	lex(module_source(root_module_id()), source, program_names().names)
		.and_then(pure func(tokens: LexedProgram) -> Result[ParsedModule, Diagnostic]: parse_module(tokens, root_module_id()))
		.is_ok()


pure func test_copy_sign_label_is_accepted() -> Bool:
	source: String =
		|pure func copy_sign(value: Float, sign: Float) -> Float:
		|    builtin("float.copysign")
		|func main() -> Int:
		|    0
		|
	accepts(source)


pure func test_equality_label_is_accepted() -> Bool:
	source: String =
		|pure func equal(first: Float, second: Float) -> Bool:
		|    builtin("float.equals")
		|
	accepts(source)


pure func test_ordering_label_is_accepted() -> Bool:
	source: String =
		|pure func ordered(first: Float, second: Float) -> Bool:
		|    builtin("float.less_than")
		|
	accepts(source)


pure func test_nan_label_is_accepted() -> Bool:
	source: String =
		|pure func nan(value: Float) -> Bool:
		|    builtin("float.is_nan")
		|
	accepts(source)


pure func test_finite_label_is_accepted() -> Bool:
	source: String =
		|pure func finite(value: Float) -> Bool:
		|    builtin("float.is_finite")
		|
	accepts(source)


tests: TestSuite = {
	description = "Blorp 2 required Float builtin labels",
	tests = [
		("copy sign label is accepted", test_copy_sign_label_is_accepted),
		("equality label is accepted", test_equality_label_is_accepted),
		("ordering label is accepted", test_ordering_label_is_accepted),
		("NaN label is accepted", test_nan_label_is_accepted),
		("finite label is accepted", test_finite_label_is_accepted),
	]
}
