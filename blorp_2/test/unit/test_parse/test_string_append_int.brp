import:
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: ParsedBody(ParsedBuiltinBody), ParsedRuntimeOperation(StringAppendIntBuiltin)
	../module_input: parse_modules
	test: TestSuite


pure func test_integer_append_label_preserves_its_quoted_span() -> Bool:
	header = "pure func append_number(text: String, number: Int) -> String:\n    builtin("
	source: String =
		|pure func append_number(text: String, number: Int) -> String:
		|    builtin("string.append_int")
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program):
			match inventory_functions(parsed_contents(program).declarations).get(0):
				Some(row):
					match row.declaration.body:
						ParsedBuiltinBody(StringAppendIntBuiltin, at):
							(at.source == module_source(root_module_id())
								and at.start == header.length()
								and at.end == header.length() + "\"string.append_int\"".length())
						_: False
				None: False


tests: TestSuite = {
	description = "Blorp 2 integer append label acceptance",
	tests = [("integer append accepts its quoted operation span", test_integer_append_label_preserves_its_quoted_span)]
}
