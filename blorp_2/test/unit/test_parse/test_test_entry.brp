import:
    ../../../src/lex/lex: lex
    ../../../src/parse/parse: parse_module
    ../../../src/parse/assemble:
        ParsedAssembly, ParsedProgram, append_module, assembly_names, begin_program,
        parsed_contents, prepare_test_entry, seal_program
    ../../../src/utils/ids: function_number, inventory_functions
    ../../../src/utils/names: name_spelling, same_name
    ../../../src/utils/source:
        ModuleId, ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule),
        compiler_source, foundation_types_module_id, module_id, module_source, root_module_id, same_module, same_source
    ../../../src/utils/syntax:
        Diagnostic, source_bundle_error, ExpressionBase(QualifiedApplication, NameExpression),
        ParsedBody(ParsedValueBody), TypeSyntax(QualifiedType)
    option: is_none, to_result, get_or
    test: TestSuite


private pure func append_source(assembly: ParsedAssembly, source: String, id: ModuleId, targets: List[ModuleId], role: ModuleKind) -> Result[ParsedAssembly, Diagnostic]:
    tokens ?= lex(module_source(id), source, assembly_names(assembly))
    parsed ?= parse_module(tokens, id)
    append_module(assembly, parsed, targets, role)


private pure func bundle(root: String, targets: List[ModuleId]) -> Result[ParsedAssembly, Diagnostic]:
    types ?= module_id(1).to_result(source_bundle_error("test types missing"))
    prelude ?= module_id(2).to_result(source_bundle_error("test prelude missing"))
    library ?= module_id(3).to_result(source_bundle_error("test library missing"))
    first ?= append_source(begin_program(), root, root_module_id(), targets, UserModule)
    second ?= append_source(first, "", types, [], FoundationTypesModule)
    third ?= append_source(second, "", prelude, [], FoundationPreludeModule)
    append_source(third, "func run_suite() -> Int:\n    0\n", library, [], LibraryModule)


private pure func prepared(source: String, targets: List[ModuleId]) -> Option[ParsedProgram]:
    match module_id(3):
        None: None
        Some(library):
            match bundle(source, targets):
                Err(_): None
                Ok(assembly):
                    match prepare_test_entry(assembly, library, foundation_types_module_id()):
                        Err(_): None
                        Ok(ready):
                            match seal_program(ready):
                                Err(_): None
                                Ok(program): Some(program)


pure func test_entry_issues_normal_identity_and_preserves_application_declarations() -> Bool:
    source = "pure func tests() -> Int:\n    1\nfunc main() -> Int:\n    7\n"
    match prepared(source, []):
        None: False
        Some(program):
            parsed = parsed_contents(program)
            rows = inventory_functions(parsed.declarations)
            match rows:
                [factory, main, entry, helper]:
                    (
                        function_number(factory.id) == 0 and function_number(main.id) == 1
                        and function_number(entry.id) == 2 and function_number(helper.id) == 3
                        and same_name(parsed.entrypoint, entry.declaration.function_name.id)
                        and name_spelling(parsed.names, main.declaration.function_name.id) == Some("main")
                        and same_module(entry.declaration.module, root_module_id())
                        and parsed.modules.length() == 4
                    )
                _: False


pure func test_entry_preserves_existing_alias_and_import_selections() -> Bool:
    match module_id(3):
        None: False
        Some(library):
            match prepared("import:\n    test as Existing: run_suite\npure func tests() -> Int:\n    1\n", [library]):
                None: False
                Some(program):
                    parsed = parsed_contents(program)
                    match parsed.modules.get(0):
                        None: False
                        Some(root):
                            match root.imports:
                                [request, base]:
                                    match request.module_alias:
                                        None: False
                                        Some(library_alias):
                                            name_spelling(parsed.names, library_alias.id) == Some("Existing") and request.symbols.length() == 1 and same_module(request.target, library) and same_module(base.target, foundation_types_module_id())
                                _: False


pure func test_entry_anchors_implicit_suite_to_real_root_end() -> Bool:
    source = "pure func tests() -> Int:\n    1\n"
    match prepared(source, []):
        None: False
        Some(program):
            parsed = parsed_contents(program)
            match inventory_functions(parsed.declarations).get(1):
                None: False
                Some(entry):
                    match entry.declaration.body:
                        ParsedValueBody(value):
                            match value.base:
                                QualifiedApplication(_, [argument]):
                                    match argument.base:
                                        NameExpression(name):
                                            same_source(name.span.source, module_source(root_module_id())) and name.span.start == source.length() and name.span.end == source.length() and same_source(value.span.source, module_source(root_module_id())) and value.span.start == source.length()
                                        _: False
                                _: False
                        _: False


pure func test_entry_rejects_foundation_as_library_authority() -> Bool:
    match (bundle("", []), module_id(1)):
        (Ok(assembly), Some(foundation)):
            match prepare_test_entry(assembly, foundation, foundation):
                Err(error): error.message == "test entry requires the configured test library module" and error.help == "load each module once in inventory order and supply every import target" and same_source(error.span.source, compiler_source()) and error.note.is_none()
                Ok(_): False
        _: False


pure func test_entry_qualifies_integer_through_existing_base_alias() -> Bool:
    source = "import:\n    _base as Base: Int\npure func tests() -> Int:\n    1\n"
    match prepared(source, [foundation_types_module_id()]):
        None: False
        Some(program):
            parsed = parsed_contents(program)
            match (parsed.modules.get(0), inventory_functions(parsed.declarations).get(1)):
                (Some(root), Some(entry)):
                    match (root.imports, entry.declaration.return_type):
                        ([base, _], Some(QualifiedType(returned, [], _))):
                            match base.module_alias:
                                Some(base_alias):
                                    (
                                        same_module(base.target, foundation_types_module_id()) and base.symbols.length() == 1
                                        and same_name(base_alias.id, returned.module.id)
                                        and name_spelling(parsed.names, returned.module.id) == Some("Base")
                                        and name_spelling(parsed.names, returned.name.id) == Some("Int")
                                    )
                                None: False
                        _: False
                _: False


tests: TestSuite = {
    description = "Blorp 2 typed test entry assembly",
    tests = [
        ("entry issues normal identity and preserves application declarations", test_entry_issues_normal_identity_and_preserves_application_declarations),
        ("entry preserves existing alias and import selections", test_entry_preserves_existing_alias_and_import_selections),
        ("entry anchors implicit suite to real root end", test_entry_anchors_implicit_suite_to_real_root_end),
        ("entry rejects foundation as library authority", test_entry_rejects_foundation_as_library_authority),
        ("entry qualifies integer through existing base alias", test_entry_qualifies_integer_through_existing_base_alias),
    ]
}
