import:
    ../../../src/lex/lex: lex
    ../../../src/parse/parse: ParsedModule, module_contents, module_names, parse_module
    ../../../src/utils/names: name_spelling, program_names
    ../../../src/utils/source: module_source, root_module_id, same_source
    ../../../src/utils/syntax: Diagnostic, ParsedRecord, Visibility(Public, Private)
    option: is_none
    bool: and, not
    string: String methods
    int: Int methods
    test: TestSuite


private pure func parsed(source: String) -> Result[ParsedModule, Diagnostic]:
    match lex(module_source(root_module_id()), source, program_names().names):
        Err(error): Err(error)
        Ok(tokens): parse_module(tokens, root_module_id())


private pure func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
    match parsed(source):
        Ok(_): False
        Err(error):
            and(
                and(same_source(error.span.source, module_source(root_module_id())), and(error.span.start == start, error.span.end == end)),
                and(and(error.message == message, error.help == help), error.note.is_none()),
            )


private pure func is_private(declaration: ParsedRecord) -> Bool:
    match declaration.visibility:
        Public: False
        Private(_): True


-- `record` and `fixed record` both declare a record, public or private, in
-- source order; only the second records that it was written `fixed`.
pure func test_record_and_fixed_record_declare_records() -> Bool:
    source = "record First { a: Int }\nprivate record Second { b: Int }\nfixed record Third { c: Int }\nprivate fixed record Fourth { d: Int }\n"
    match parsed(source):
        Err(_): False
        Ok(module):
            names = module_names(module)
            match module_contents(module).records:
                [first, second, third, fourth]:
                    and(
                        and(
                            and(name_spelling(names, first.type_name.id) == Some("First"), first.is_private().not()),
                            and(name_spelling(names, second.type_name.id) == Some("Second"), second.is_private()),
                        ),
                        and(
                            and(name_spelling(names, third.type_name.id) == Some("Third"), third.is_private().not()),
                            and(name_spelling(names, fourth.type_name.id) == Some("Fourth"), fourth.is_private()),
                        ),
                    ).and(and(first.fixed.not(), second.fixed.not())).and(and(third.fixed, fourth.fixed))
                _: False


-- A fixed record is stored inline at one known size, so it has no type
-- parameters; the whole written list is reported.
pure func test_fixed_record_rejects_type_parameters() -> Bool:
    rejects("fixed record Pair[A, B] { first: A, second: B }\n", 17, 23,
        "a fixed record cannot declare type parameters",
        "remove fixed to declare an ordinary generic record, or remove the type parameters")


pure func test_record_declares_type_parameters() -> Bool:
    match parsed("record Pair[A, B] { first: A, second: B }\n"):
        Err(_): False
        Ok(module):
            match module_contents(module).records:
                [declaration]: declaration.type_parameters.length() == 2
                _: False


pure func test_record_header_requires_a_name() -> Bool:
    rejects("record { value: Int }\n", 7, 8,
        "expected a record type name",
        "use an ASCII identifier starting with a letter or underscore; keywords and lone '_' are reserved")


pure func test_record_header_requires_a_brace() -> Bool:
    rejects("record Pair\n", 11, 12,
        "expected '{' after the record type name",
        "write record Name { field: Int }")


pure func test_imports_precede_records() -> Bool:
    rejects("record Pair { first: Int }\nimport:\n    io: print\n", 27, 33,
        "imports must precede declarations",
        "move every import: block before the module's functions, unions, and records")


tests: TestSuite = {
    description = "Blorp 2 record declarations",
    tests = [
        ("record and fixed record declare records", test_record_and_fixed_record_declare_records),
        ("fixed record rejects type parameters", test_fixed_record_rejects_type_parameters),
        ("record declares type parameters", test_record_declares_type_parameters),
        ("record header requires a name", test_record_header_requires_a_name),
        ("record header requires a brace", test_record_header_requires_a_brace),
        ("imports precede records", test_imports_precede_records),
    ]
}
