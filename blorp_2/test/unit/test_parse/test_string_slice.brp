import:
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: ParsedBody(ParsedBuiltinBody), ParsedRuntimeOperation(StringSliceBuiltin)
	../module_input: parse_modules
	test: TestSuite


func test_slice_builtin_label_is_accepted() -> Bool:
	source: String =
		|pure func slice_text(value: String, start: Int, end: Int) -> Option[String]:
		|    builtin("string.slice")
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(error):
			print_error(error.message)
			print_error(error.help)
			print_error(error.span.start.to_string() + ".." + error.span.end.to_string())
			False
		Ok(program):
			match inventory_functions(parsed_contents(program).declarations).get(0):
				Some(row):
					match row.declaration.body:
						ParsedBuiltinBody(StringSliceBuiltin, span):
							same_source(span.source, module_source(root_module_id())) and span.start == 89 and span.end == 103
						_: False
				None: False


tests: TestSuite = {
	description = "Checked String slice label acceptance",
	tests = [
		("string.slice accepts the checked slice declaration", test_slice_builtin_label_is_accepted),
	]
}
