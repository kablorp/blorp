import:
	../../../src/lex/lex: lex
	../../../src/parse/parse: ParsedModule, module_contents, parse_module
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax:
		Diagnostic,
		ExpressionBase(IntegerExpression, NameExpression, RangeExpression),
		ParsedBody(ParsedValueBody),
		ValueExpression,
	test: TestSuite


private HEADER: String = "func main() -> Int:\n"


private pure func parse_source(source: String) -> Result[ParsedModule, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parse_module(tokens, root_module_id())


private pure func main_value(source: String) -> Option[ValueExpression]:
	match parse_source(source):
		Ok(parsed):
			match module_contents(parsed).functions.get(0).map(pure func(function): function.body):
				Some(ParsedValueBody(value)):
					Some(value)
				_:
					None
		Err(_):
			None


-- `low..high` is one value spanning both operands; each operand keeps its
-- own postfix operations.
pure func test_range_spans_both_operands() -> Bool:
	match main_value(HEADER + "\t0..count.length()\n"):
		Some(value):
			match value.base:
				RangeExpression(low, high):
					match (low.base, high.base):
						(IntegerExpression(0), NameExpression(_)):
							high.applications.length() == 1 and value.span.start == 21 and value.span.end == 38 and value.applications.length() == 0
						_:
							False
				_:
					False
		None:
			False


pure func test_range_needs_an_end() -> Bool:
	match parse_source(HEADER + "\t0..\n"):
		Err(diagnostic):
			diagnostic.span.start == 24 and diagnostic.message == "expected the range's end after '..'" and diagnostic.help == "write low..high with a value on each side of '..'"
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 range syntax",
	tests = [
		("range spans both operands", test_range_spans_both_operands),
		("range needs an end", test_range_needs_an_end),
	]
}
