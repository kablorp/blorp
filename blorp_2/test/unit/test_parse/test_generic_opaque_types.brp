---
An opaque declaration may name type parameters, as a record does. Its
conversions take no written type arguments: the operand and the expected
type supply them.
---
import:
	../../../src/lex/lex: lex
	../../../src/parse/parse: ParsedModule, module_contents, module_names, parse_module
	../../../src/utils/names: name_spelling, program_names
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: Diagnostic
	bool: and
	option: is_none
	string: String methods
	int: Int methods
	test: TestSuite


private pure func parsed(source: String) -> Result[ParsedModule, Diagnostic]:
	match lex(module_source(root_module_id()), source, program_names().names):
		Err(error): Err(error)
		Ok(tokens): parse_module(tokens, root_module_id())


-- The diagnostic covers exactly `marked`, which follows `prefix`.
private pure func rejects(prefix: String, marked: String, rest: String, message: String, help: String) -> Bool:
	match parsed("${prefix}${marked}${rest}"):
		Ok(_): False
		Err(error):
			and(
				and(same_source(error.span.source, module_source(root_module_id())), and(error.span.start == prefix.length(), error.span.end == prefix.length().add(marked.length()))),
				and(and(error.message == message, error.help == help), error.note.is_none()),
			)


pure func test_opaque_declaration_names_its_parameters() -> Bool:
	match parsed("opaque type Pair[K, V] = List[K]\n"):
		Err(_): False
		Ok(module):
			names = module_names(module)
			match module_contents(module).opaques:
				[pair]:
					match pair.type_parameters:
						[first, second]: and(name_spelling(names, first.id) == Some("K"), name_spelling(names, second.id) == Some("V"))
						_: False
				_: False


pure func test_nongeneric_opaque_declaration_has_no_parameters() -> Bool:
	match parsed("opaque type Name = String\n"):
		Err(_): False
		Ok(module):
			match module_contents(module).opaques:
				[name]: name.type_parameters.is_empty()
				_: False


pure func test_a_missing_equals_teaches_both_forms() -> Bool:
	rejects(
		"opaque type Box[V] ",
		"List",
		"[V]\n",
		"expected '=' after the opaque type name",
		"write opaque type Name = Underlying, or opaque type Name[T] = Underlying",
	)


pure func test_written_conversion_arguments_get_a_targeted_hint() -> Bool:
	rejects(
		"func main() -> Int:\n    into_opaque Box",
		"[",
		"Int](7)\n",
		"opaque conversions take no type arguments",
		"write into_opaque Name(value) or from_opaque Name(value); the value and the expected type supply the arguments",
	)


tests: TestSuite = {
	description = "Generic opaque type syntax",
	tests = [
		("an opaque declaration names its type parameters", test_opaque_declaration_names_its_parameters),
		("a nongeneric opaque declaration has no type parameters", test_nongeneric_opaque_declaration_has_no_parameters),
		("a missing '=' teaches the nongeneric and generic forms", test_a_missing_equals_teaches_both_forms),
		("written conversion type arguments get a targeted hint", test_written_conversion_arguments_get_a_targeted_hint),
	],
}
