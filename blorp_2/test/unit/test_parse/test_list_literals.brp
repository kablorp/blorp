import:
	../../../src/lex/lex: lex
	../../../src/parse/parse: ParsedModule, module_contents, parse_module
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax:
		Diagnostic,
		ExpressionBase(ListExpression),
		ParsedBody(ParsedValueBody),
		ValueExpression,
	test: TestSuite


private HEADER: String = "func main() -> Int:\n"


private pure func parse_source(source: String) -> Result[ParsedModule, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parse_module(tokens, root_module_id())


private pure func main_value(source: String) -> Option[ValueExpression]:
	match parse_source(source):
		Ok(parsed):
			match module_contents(parsed).functions.get(0).map(pure func(function): function.body):
				Some(ParsedValueBody(value)):
					Some(value)
				_:
					None
		Err(_):
			None


private pure func element_count(source: String) -> Option[Int]:
	match main_value(source):
		Some(value):
			match value.base:
				ListExpression(elements):
					Some(elements.length())
				_:
					None
		None:
			None


-- `[]`, `[a, b]` and `[a, b,]` are list literals spanning their brackets.
pure func test_list_literals_hold_their_elements() -> Bool:
	source: String =
		|	[
		|		1,
		|		[2],
		|	]
		|

	(
		element_count(HEADER + "\t[]\n") == Some(0)
		and element_count(HEADER + "\t[1, 2,]\n") == Some(2)
		and element_count(HEADER + source) == Some(2)
	)


pure func test_list_literal_span_covers_the_brackets() -> Bool:
	match main_value(HEADER + "\t[1, 2].length()\n"):
		Some(value):
			value.base_span.start == 21 and value.base_span.end == 27 and value.applications.length() == 1
		None:
			False


pure func test_list_elements_are_separated_by_commas() -> Bool:
	match parse_source(HEADER + "\t[1 2]\n"):
		Err(diagnostic):
			diagnostic.span.start == 24 and diagnostic.message == "expected ']' after the list elements" and diagnostic.help == "separate elements with commas, then close the list with ']'"
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 list literal syntax",
	tests = [
		("list literals hold their elements", test_list_literals_hold_their_elements),
		("list literal span covers the brackets", test_list_literal_span_covers_the_brackets),
		("list elements are separated by commas", test_list_elements_are_separated_by_commas),
	]
}
