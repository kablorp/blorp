import:
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: ParsedBody(ParsedBuiltinBody), ParsedRuntimeOperation(ReadFileBuiltin)
	../module_input: parse_modules
	test: TestSuite


pure func test_read_file_label_preserves_its_span() -> Bool:
	header = "func query(path: String) -> Result[String, String]:\n    builtin("
	source: String =
		|func query(path: String) -> Result[String, String]:
		|    builtin("system.read_file")
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program):
			match inventory_functions(parsed_contents(program).declarations).get(0):
				Some(row):
					match row.declaration.body:
						ParsedBuiltinBody(ReadFileBuiltin, span):
							(
								same_source(span.source, module_source(root_module_id()))
								and span.start == header.length()
								and span.end == header.length() + "\"system.read_file\"".length()
								and row.declaration.statements.is_empty()
							)
						_: False
				None: False


tests: TestSuite = {
	description = "Blorp 2 file-read label",
	tests = [
		("read_file label preserves its source span", test_read_file_label_preserves_its_span),
	]
}
