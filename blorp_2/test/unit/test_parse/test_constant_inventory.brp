import:
	int as IntOps
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: constant_number, function_number, inventory_constants, inventory_functions
	../../../src/utils/names: name_spelling
	../../../src/utils/source: module_id, module_source, root_module_id, same_module, same_source
	../../../src/utils/syntax: ExpressionBase(IntegerExpression)
	../module_input: parse_modules
	test: TestSuite


pure func test_sealed_program_has_one_constant_inventory_across_modules() -> Bool:
	root: String =
		|import:
		|    ./answer as Answers
		|ROOT: Int = 11
		|func main() -> Int:
		|    0
		|
	leaf: String =
		|FIRST: Int = 23
		|pure func helper() -> Int:
		|    1
		|SECOND: Int = 17
		|
	match (parse_modules([{ source = root, targets = [1] }, { source = leaf, targets = [] }]), module_id(1)):
		(Ok(program), Some(target)):
			contents = parsed_contents(program)
			match (inventory_constants(contents.declarations), inventory_functions(contents.declarations)):
				([one, two, three], [main, helper]):
					match (one.declaration.value.base, two.declaration.value.base, three.declaration.value.base):
						(IntegerExpression(first_value), IntegerExpression(second_value), IntegerExpression(third_value)):
							var valid: Bool = IntOps.equals(first_value, 11)
							if valid:
								valid = IntOps.equals(second_value, 23)
							if valid:
								valid = IntOps.equals(third_value, 17)
							if valid:
								valid = IntOps.equals(constant_number(one.id), 0)
							if valid:
								valid = IntOps.equals(constant_number(two.id), 1)
							if valid:
								valid = IntOps.equals(constant_number(three.id), 2)
							if valid:
								valid = IntOps.equals(function_number(main.id), 0)
							if valid:
								valid = IntOps.equals(function_number(helper.id), 1)
							if valid:
								valid = match name_spelling(contents.names, one.declaration.name.id):
									Some("ROOT"): True
									_: False
							if valid:
								valid = match name_spelling(contents.names, two.declaration.name.id):
									Some("FIRST"): True
									_: False
							if valid:
								valid = match name_spelling(contents.names, three.declaration.name.id):
									Some("SECOND"): True
									_: False
							if valid:
								valid = same_module(one.declaration.module, root_module_id())
							if valid:
								valid = same_module(two.declaration.module, target)
							if valid:
								valid = same_module(three.declaration.module, target)
							if valid:
								valid = same_source(one.declaration.name.span.source, module_source(root_module_id()))
							if valid:
								valid = same_source(two.declaration.name.span.source, module_source(target))
							if valid:
								valid = same_source(three.declaration.name.span.source, module_source(target))
							valid
						_: False
				_: False
		_: False


tests: TestSuite = {
	description = "Blorp 2 sealed constant inventory",
	tests = [
		("assembly issues each constant once across modules", test_sealed_program_has_one_constant_inventory_across_modules),
	]
}
