import:
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/syntax:
		ParsedBody(ParsedBuiltinBody),
		ParsedRuntimeOperation(SystemBuiltin),
		SystemOperation(FsOpenRead, FsNextLines, FsClose),
	../module_input: parse_modules
	test: TestSuite


-- The label is spelled out here, so the test does not follow system_operation_label.
-- Parsing a label does not check the signature, so every label shares one.
private pure func label_parses_to(label: String, expected: SystemOperation) -> Bool:
	source = "func operate(path: String) -> Result[Void, Int]:\n    builtin(\"${label}\")\nfunc main() -> Int:\n    0\n"
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program):
			match inventory_functions(parsed_contents(program).declarations).get(0):
				Some(row):
					match row.declaration.body:
						ParsedBuiltinBody(SystemBuiltin(parsed), _): parsed == expected
						_: False
				None: False


pure func test_open_read_label() -> Bool:
	label_parses_to("fs.open_read", FsOpenRead)


pure func test_next_lines_label() -> Bool:
	label_parses_to("fs.next_lines", FsNextLines)


pure func test_close_label() -> Bool:
	label_parses_to("fs.close", FsClose)


tests: TestSuite = {
	description = "Blorp 2 fs line labels",
	tests = [
		("fs.open_read parses to FsOpenRead", test_open_read_label),
		("fs.next_lines parses to FsNextLines", test_next_lines_label),
		("fs.close parses to FsClose", test_close_label),
	]
}
