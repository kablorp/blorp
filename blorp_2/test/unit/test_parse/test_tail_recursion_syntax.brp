import:
	../../../src/utils/source: module_source, root_module_id, same_module
	../../../src/lex/lex: lex
	../../../src/parse/assemble: parsed_contents as program_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/syntax: Diagnostic, ParsedBody(ParsedBuiltinBody), Symbol(AtSign), TokenKind(SymbolToken, IdentifierToken)
	../input: parse
	option: is_none
	test: TestSuite


private pure func accepts_annotation(prefix: String) -> Bool:
	match lex(
		module_source(root_module_id()),
		prefix + "pure func main() -> Int:\n\tmain()\n",
	).and_then(
		pure func(tokens): parse(tokens),
	):
		Err(_):
			False
		Ok(program):
			functions = inventory_functions(program_contents(program).declarations)
				.filter(pure func(row): same_module(row.declaration.module, root_module_id()))
			match functions:
				[row]:
					match row.declaration.tail_annotation:
						Some(span):
							span.start == 0 and span.end == 15
						None:
							False
				_:
					False


pure func test_same_line_annotation() -> Bool:
	accepts_annotation("@tail_recursive ")


pure func test_standalone_annotation() -> Bool:
	accepts_annotation("@tail_recursive\n")


pure func test_at_and_identifier_tokens() -> Bool:
	match lex(module_source(root_module_id()), "@tail_recursive"):
		Err(_):
			False
		Ok(program):
			match program.tokens:
				[at, name, _]:
					match at.kind:
						SymbolToken(AtSign):
							match name.kind:
								IdentifierToken("tail_recursive"):
									(
										at.span.start == 0
										and at.span.end == 1
										and name.span.start == 1
										and name.span.end == 15
									)
								_:
									False
						_:
							False
				_:
					False


private pure func rejects(
	source: String,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match lex(module_source(root_module_id()), source).and_then(pure func(tokens): parse(tokens)):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == start
				and error.span.end == end
				and error.message == message
				and error.help == help
			)


pure func test_unknown_annotation() -> Bool:
	rejects(
		"@other func main() -> Int:\n\t0\n",
		0,
		6,
		"unknown function annotation",
		"use @tail_recursive before a function declaration",
	)


pure func test_duplicate_annotation() -> Bool:
	rejects(
		"@tail_recursive\n@tail_recursive\nfunc main() -> Int:\n\tmain()\n",
		16,
		17,
		"multiple function annotations are not supported",
		"write @tail_recursive only once before a function",
	)


pure func test_unknown_second_annotation() -> Bool:
	source: String =
		|@tail_recursive
		|@other
		|func main() -> Int:
		|	main()
		|
	rejects(
		source,
		16,
		17,
		"multiple function annotations are not supported",
		"write @tail_recursive only once before a function",
	)


pure func test_annotation_after_pure() -> Bool:
	source: String =
		|pure @tail_recursive func main() -> Int:
		|	main()
		|
	rejects(
		source,
		5,
		6,
		"misplaced function annotation",
		"put @tail_recursive before the optional pure and func keywords at column 1",
	)


pure func test_annotation_after_func() -> Bool:
	source: String =
		|func @tail_recursive main() -> Int:
		|	main()
		|
	rejects(
		source,
		5,
		6,
		"misplaced function annotation",
		"put @tail_recursive before the optional pure and func keywords at column 1",
	)


pure func test_argument_bearing_annotation() -> Bool:
	rejects(
		"@tail_recursive() func main() -> Int:\n\tmain()\n",
		15,
		16,
		"@tail_recursive takes no arguments",
		"write @tail_recursive before the optional pure and func keywords",
	)


pure func test_dangling_annotation() -> Bool:
	rejects(
		"@tail_recursive\n",
		0,
		15,
		"@tail_recursive has no function declaration",
		"put a function declaration immediately after @tail_recursive",
	)


pure func test_annotation_on_union() -> Bool:
	rejects(
		"@tail_recursive\nfixed union Flag:\n\tOnly\n",
		16,
		21,
		"@tail_recursive requires a function declaration",
		"put @tail_recursive before the optional pure and func keywords",
	)


pure func test_annotation_in_body() -> Bool:
	rejects(
		"func main() -> Int:\n\t@tail_recursive\n",
		21,
		22,
		"misplaced function annotation",
		"put @tail_recursive before the optional pure and func keywords at column 1",
	)


pure func test_builtin_annotation_parses_for_semantic_validation() -> Bool:
	source = "@tail_recursive\npure func helper(value: String) -> Int:\n\tbuiltin(\"string.length\")\n"
	match lex(module_source(root_module_id()), source).and_then(parse):
		Err(_): False
		Ok(program):
			functions = inventory_functions(program_contents(program).declarations)
				.filter(pure func(row): same_module(row.declaration.module, root_module_id()))
			match functions:
				[row]:
					match (row.declaration.tail_annotation, row.declaration.body):
						(Some(span), ParsedBuiltinBody(_, _)): span.start == 0 and span.end == 15
						_: False
				_: False


pure func test_annotation_name_is_an_identifier() -> Bool:
	match lex(
		module_source(root_module_id()),
		"func tail_recursive() -> Int:\n\t7\nfunc main() -> Int:\n\ttail_recursive()\n",
	).and_then(
		pure func(tokens): parse(tokens),
	):
		Err(_):
			False
		Ok(program):
			functions = inventory_functions(program_contents(program).declarations)
				.filter(pure func(row): same_module(row.declaration.module, root_module_id()))
			match functions:
				[helper, main]:
					helper.declaration.tail_annotation.is_none() and main.declaration.tail_annotation.is_none()
				_:
					False


tests: TestSuite = {
	description = "Tail-recursion annotation syntax",
	tests = [
		("same-line annotation span", test_same_line_annotation),
		("standalone annotation span", test_standalone_annotation),
		("at sign and unreserved annotation name tokens", test_at_and_identifier_tokens),
		("unknown annotation diagnostic", test_unknown_annotation),
		("duplicate annotation diagnostic", test_duplicate_annotation),
		("unknown second annotation diagnostic", test_unknown_second_annotation),
		("annotation after pure diagnostic", test_annotation_after_pure),
		("annotation after func diagnostic", test_annotation_after_func),
		("argument-bearing annotation diagnostic", test_argument_bearing_annotation),
		("dangling annotation diagnostic", test_dangling_annotation),
		("annotation requires a function", test_annotation_on_union),
		("misplaced annotation diagnostic", test_annotation_in_body),
		("builtin annotation syntax retained", test_builtin_annotation_parses_for_semantic_validation),
		("annotation spelling remains an identifier", test_annotation_name_is_an_identifier),
	]
}
