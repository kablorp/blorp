import:
	../../../src/lex/lex: lex
	../../../src/parse/parse: ParsedModule, module_contents, parse_module
	../../../src/utils/names: name_spelling, program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax:
		Diagnostic,
		ExpressionBase(IntegerExpression, StringExpression),
		ParsedStatement(BindingStatement),
		TypeSyntax(AtomicType),
		Visibility(Private, Public),
	test: TestSuite


private MAIN: String = "func main() -> Int:\n\t0\n"

private INDENTED_VALUE_HELP: String = "put the value on the same line as '=', or alone on the next line indented one level"


private pure func parse_source(source: String) -> Result[ParsedModule, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parse_module(tokens, root_module_id())


private pure func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
	match parse_source(source):
		Err(diagnostic):
			diagnostic.span.start == start and diagnostic.span.end == end and diagnostic.message == message and diagnostic.help == help
		Ok(_):
			False


-- `NAME: Type = value` rows keep their name, type, value and visibility.
pure func test_constants_keep_name_type_value_and_visibility() -> Bool:
	match parse_source("LIMIT: Int = 7\nprivate TEXT: String = \"a\"\n" + MAIN):
		Err(_):
			False
		Ok(parsed):
			contents = module_contents(parsed)

			match contents.constants:
				[limit, text]:
					match (limit.visibility, limit.type_name, limit.value.base):
						(Public, AtomicType(_), IntegerExpression(7)):
							match (text.visibility, text.value.base):
								(Private(_), StringExpression("a")):
									(
										name_spelling(contents.names, limit.name.id) == Some("LIMIT")
										and limit.name.span.start == 0 and limit.name.span.end == 5
										and contents.functions.length() == 1
									)
								_:
									False
						_:
							False
				_:
					False


-- The value may stand alone on the next line, indented; its Dedent ends the
-- declaration.
pure func test_constant_value_may_be_a_pipe_string_on_the_next_line() -> Bool:
	match parse_source("TEXT: String =\n\t|one\n\t|two\n\n" + MAIN):
		Err(_):
			False
		Ok(parsed):
			match module_contents(parsed).constants.map(pure func(constant): constant.value.base):
				[StringExpression("one\ntwo")]:
					module_contents(parsed).functions.length() == 1
				_:
					False


pure func test_binding_value_may_be_on_the_next_line() -> Bool:
	match parse_source("func main() -> Int:\n\tvalue =\n\t\t7\n\tvalue\n"):
		Err(_):
			False
		Ok(parsed):
			match module_contents(parsed).functions.get(0).map(pure func(function): function.statements):
				Some([BindingStatement(binding)]):
					match binding.initializer.base:
						IntegerExpression(7):
							True
						_:
							False
				_:
					False


pure func test_next_line_value_is_one_expression() -> Bool:
	(
		rejects("func main() -> Int:\n\tvalue =\n\t\t7\n\t\t8\n\tvalue\n", 35, 36, "expected one expression after '='", INDENTED_VALUE_HELP)
		and rejects("LIMIT: Int =\n7\n" + MAIN, 13, 14, "expected an indented value after '='", INDENTED_VALUE_HELP)
	)


pure func test_constant_needs_type_and_equals() -> Bool:
	(
		rejects("LIMIT: = 7\n" + MAIN, 7, 8, "expected the constant's type after ':'", "use an ASCII identifier starting with a letter or underscore; 'func', 'pure', 'match', 'var', and lone '_' are reserved")
		and rejects("LIMIT: Int 7\n" + MAIN, 11, 12, "expected '=' after the constant type", "write NAME: Type = value")
	)


tests: TestSuite = {
	description = "Blorp 2 module constants",
	tests = [
		("constants keep name, type, value and visibility", test_constants_keep_name_type_value_and_visibility),
		("constant value may be a pipe string on the next line", test_constant_value_may_be_a_pipe_string_on_the_next_line),
		("binding value may be on the next line", test_binding_value_may_be_on_the_next_line),
		("next-line value is one expression", test_next_line_value_is_one_expression),
		("constant needs type and equals", test_constant_needs_type_and_equals),
	]
}
