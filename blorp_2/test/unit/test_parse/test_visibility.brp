import:
	../../../src/lex/lex: lex
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_functions, inventory_records, inventory_unions
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: Visibility(Public, Private)
	../input: parse
	test: TestSuite


private MAIN: String = "func main() -> Int:\n\t0\n"


private pure func private_at(visibility: Visibility, start: Int) -> Bool:
	match visibility:
		Private(span):
			span.start == start and span.end == start + "private".length()
		Public:
			False


private pure func is_public(visibility: Visibility) -> Bool:
	match visibility:
		Public:
			True
		Private(_):
			False


-- `private` precedes a function, record or union; the row keeps the
-- keyword's span so checking can point at it.
pure func test_private_keyword_span_is_kept_on_each_declaration_kind() -> Bool:
	declaration_source: String =
		|private pure func answer() -> Int:
		|	42
		|private record Pair { first: Int }
		|private union Choice:
		|	One
		|

	source = declaration_source + MAIN

	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(_):
			False
		Ok(parsed):
			declarations = parsed_contents(parsed).declarations
			root_functions = inventory_functions(declarations).filter(pure func(row): row.declaration.module == root_module_id())
			match (root_functions, inventory_records(declarations).filter(pure func(row): row.declaration.module == root_module_id()), inventory_unions(declarations).filter(pure func(row): row.module == root_module_id())):
				([answer, main], [pair], [choice]):
					(
						private_at(answer.declaration.visibility, 0)
						and is_public(main.declaration.visibility)
						and private_at(pair.declaration.visibility, 39)
						and private_at(choice.visibility, 80)
					)
				_:
					False


pure func test_private_cannot_precede_a_builtin_type() -> Bool:
	match lex(module_source(root_module_id()), "private type Int = builtin\n" + MAIN, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(diagnostic):
			(
				diagnostic.span.start == 0 and diagnostic.span.end == 7
				and diagnostic.message == "builtin type declarations cannot be private"
				and diagnostic.help == "remove private; builtin types belong to the foundation module"
			)
		Ok(_):
			False


-- `private type` is rejected as private only in the builtin form; any other
-- `type` line reports what the ordinary builtin-type parser finds.
pure func test_private_type_alias_reports_the_unknown_builtin_type() -> Bool:
	match lex(module_source(root_module_id()), "private type Alias = Int\n" + MAIN, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(diagnostic):
			diagnostic.span.start == 13 and diagnostic.span.end == 18 and diagnostic.message == "unknown builtin type"
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 declaration visibility",
	tests = [
		("private keyword span is kept on each declaration kind", test_private_keyword_span_is_kept_on_each_declaration_kind),
		("private cannot precede a builtin type", test_private_cannot_precede_a_builtin_type),
		("private type alias reports the unknown builtin type", test_private_type_alias_reports_the_unknown_builtin_type),
	]
}
