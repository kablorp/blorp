import:
	../../../src/parse/assemble: ParsedProgram, ParsedContents, parsed_contents as program_contents
	../../../src/utils/ids: inventory_functions, inventory_unions
	../../../src/lex/lex: lex
	../../../src/utils/names: NameTable, name_spelling, program_names
	../../../src/parse/parse: parse_module
	../../../src/utils/source: module_source, root_module_id, same_module
	../../../src/utils/syntax:
		BindingSyntax(MutableBinding),
		Diagnostic,
		ExpressionBase(IntegerExpression, NameExpression),
		ParsedBody(ParsedValueBody, ParsedMatchBody),
		ParsedFunction,
		ParsedMatch,
		ParsedMatchArm,
		ParsedPattern(PatternConstructor, PatternName, PatternWildcard),
		PatternHead(BareHead),
		ParsedStatement(BindingStatement),
		PostfixOperation(ReceiverInvocation),
		Purity(Impure),
		TokenKind(IntegerLiteral),
		TypeSyntax(AtomicType),
		ValueExpression,
	../input: parse
	test: TestSuite


private HEADER: String = "func main() -> Int:\n"

-- The arm's pattern starts at 37, its colon is at 49 and an inline value at 51.
private MATCH_ARM: String = "func main() -> Int:\n\tmatch Choice:\n\t\tNumber(item):"

private ARM_BINDING: String = MATCH_ARM + "\n\t\t\tvar current = item"


private pure func parse_source(source: String) -> Result[ParsedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parse(tokens)


-- Project root syntax for assertions without changing the published inventory.
private pure func root_functions(contents: ParsedContents) -> List[ParsedFunction]:
	inventory_functions(contents.declarations)
		.filter(pure func(row): same_module(row.declaration.module, root_module_id()))
		.map(pure func(row): row.declaration)


private pure func only_function(source: String) -> Option[ParsedFunction]:
	match parse_source(source):
		Ok(parsed):
			match root_functions(program_contents(parsed)):
				[function]:
					Some(function)
				_:
					None
		Err(_):
			None


private pure func only_match(source: String) -> Option[ParsedMatch]:
	match only_function(source):
		Some(function):
			match function.body:
				ParsedMatchBody(body):
					Some(body)
				_:
					None
		None:
			None


private pure func value_of(function: ParsedFunction) -> Option[ValueExpression]:
	match function.body:
		ParsedValueBody(value):
			Some(value)
		_:
			None


-- An arm's value, when its block ends with one.
private pure func arm_value_start(arm: ParsedMatchArm) -> Option[Int]:
	arm.block.value.map(pure func(value): value.span.start)


private pure func arm_value_end(arm: ParsedMatchArm) -> Option[Int]:
	arm.block.value.map(pure func(value): value.span.end)


private pure func arm_integer(arm: ParsedMatchArm, expected: Int) -> Bool:
	match arm.block.value:
		Some(value):
			is_integer(value, expected)
		None:
			False


private pure func is_integer(value: ValueExpression, expected: Int) -> Bool:
	match value.base:
		IntegerExpression(actual):
			actual == expected
		_:
			False


private pure func diagnostic_is(
	result: Result[ParsedProgram, Diagnostic],
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match result:
		Err(diagnostic):
			(
				diagnostic.span.start == start
				and diagnostic.span.end == end
				and diagnostic.message == message
				and diagnostic.help == help
			)
		Ok(_):
			False


private pure func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
	diagnostic_is(parse_source(source), start, end, message, help)


private pure func return_type_is_foo(function: ParsedFunction, names: NameTable) -> Bool:
	match function.return_type:
		Some(AtomicType(name)):
			name_spelling(names, name.id) == Some("Foo") and name.span.start == 15 and name.span.end == 18
		_:
			False


pure func test_unchecked_names_and_spans() -> Bool:
	match parse_source("func nope() -> Foo:\n\t0\n"):
		Err(_):
			False
		Ok(parsed):
			program = program_contents(parsed)

			match root_functions(program):
				[function]:
					match value_of(function):
						Some(value):
							(
								name_spelling(program.names, function.function_name.id) == Some("nope")
								and function.function_name.span.start == 5
								and function.function_name.span.end == 9
								and return_type_is_foo(function, program.names)
								and function.parameters.length() == 0
								and function.purity == Impure
								and is_integer(value, 0)
								and value.applications.length() == 0
								and value.span.start == 21
								and value.span.end == 22
								and inventory_unions(program.declarations).filter(pure func(row): same_module(row.module, root_module_id())).length() == 0
								and program.end.start == 23
							)
						None:
							False
				_:
					False


pure func test_optional_final_newline() -> Bool:
	only_function(HEADER + "\t0").is_some()


pure func test_parameter_annotation_is_required() -> Bool:
	rejects("func main(x) -> Int:\n\t0", 11, 12, "expected ':' after the parameter name", "write each parameter as name: Type")


pure func test_bare_name_is_parsed_without_scope_resolution() -> Bool:
	match parse_source(HEADER + "\tx\n"):
		Err(_):
			False
		Ok(parsed):
			program = program_contents(parsed)

			match root_functions(program).get(0).and_then(pure func(function): value_of(function)):
				Some(value):
					match value.base:
						NameExpression(name):
							(
								name_spelling(program.names, name.id) == Some("x")
								and name.span.start == 21
								and name.span.end == 22
								and value.applications.length() == 0
							)
						_:
							False
				None:
					False


pure func test_trailing_input_is_rejected() -> Bool:
	rejects(HEADER + "\t0\n0", 23, 24, "expected a function declaration at column 1", "start with func main() -> Int:")


pure func test_missing_body_uses_explicit_eof_span() -> Bool:
	(
		rejects(HEADER, 20, 20, "expected an indented block", "indent the lines of the block under its header")
		and rejects(HEADER + "\tx(", 23, 23, "expected a return expression", "use a literal, a parameter or variant name, or a call as the entire body")
	)


pure func test_ufcs_from_spaced_tokens() -> Bool:
	match parse_source(HEADER + "\t1 . identity ( )\n"):
		Err(_):
			False
		Ok(parsed):
			program = program_contents(parsed)

			match root_functions(program).get(0).and_then(pure func(function): value_of(function)):
				Some(value):
					match value.applications:
						[ReceiverInvocation(call)]:
							(
								is_integer(value, 1)
								and call.arguments.length() == 0
								and name_spelling(program.names, call.callee.id) == Some("identity")
								and call.callee.span.start == 25
								and call.callee.span.end == 33
								and call.span.end == 37
								and value.span.end == 37
								and program.end.start == 38
							)
						_:
							False
				None:
					False


private pure func literal_is(spelling: String, expected: Int) -> Bool:
	match only_function(HEADER + "\t" + spelling).and_then(pure func(function): value_of(function)):
		Some(value):
			is_integer(value, expected)
		None:
			False


private pure func rejects_literal(spelling: String, message: String, help: String) -> Bool:
	rejects(HEADER + "\t" + spelling, 21, 21 + spelling.length(), message, help)


pure func test_signed_literals_and_endpoints() -> Bool:
	(
		literal_is("42", 42)
		and literal_is("-42", -42)
		and literal_is("-0", 0)
		and literal_is("1000", 1000)
		and literal_is("9223372036854775807", 9223372036854775807)
		and literal_is("-9223372036854775808", -9223372036854775808)
	)


pure func test_literal_range_rejections_have_whole_token_spans() -> Bool:
	message = "integer literal is outside the Int64 range"
	help = "use a value from -9223372036854775808 to 9223372036854775807"
	(
		rejects_literal("9223372036854775808", message, help)
		and rejects_literal("-9223372036854775809", message, help)
		and rejects_literal("9999999999999999999999999999999999999999", message, help)
		and rejects_literal("-9999999999999999999999999999999999999999", message, help)
	)


-- Parsing validates every integer spelling it receives, including spellings
-- the lexer never produces, so the lexed literal at 21 is replaced here.
private pure func rejects_integer_spelling(spelling: String) -> Bool:
	match lex(module_source(root_module_id()), HEADER + "\t0", program_names().names):
		Err(_):
			False
		Ok(program):
			match program.tokens.get(9):
				Some(token):
					tokens = program.tokens.set(9, { token | kind = IntegerLiteral(spelling) })
					diagnostic_is(
						parse({ program | tokens = tokens }),
						21,
						22,
						"invalid integer literal",
						"write decimal digits, optionally preceded by an adjacent '-'",
					)
				None:
					False


pure func test_integer_spelling_is_validated() -> Bool:
	(
		rejects_integer_spelling("")
		and rejects_integer_spelling("-")
		and rejects_integer_spelling("+1")
		and rejects_integer_spelling("1a")
		and rejects_literal("00", "integer literals cannot have leading zeros", "write 0 or -0, or remove the leading zeros")
		and rejects_literal("-01", "integer literals cannot have leading zeros", "write 0 or -0, or remove the leading zeros")
	)


private pure func first_pattern(source: String) -> Option[ParsedPattern]:
	only_match(source).and_then(pure func(body): body.arms.get(0)).map(pure func(arm): arm.pattern)


pure func test_optional_pattern_field_distinguishes_absent_from_discarded() -> Bool:
	match first_pattern(HEADER + "\tmatch Choice:\n\t\tNumber(): 42\n"):
		Some(PatternConstructor(_, [], absent_span)):
			match first_pattern(HEADER + "\tmatch Choice:\n\t\tNumber(_): 42\n"):
				Some(PatternConstructor(_, [PatternWildcard(field_span)], discarded_span)):
					(
						absent_span.start == 37
						and absent_span.end == 45
						and field_span.start == 44
						and field_span.end == 45
						and discarded_span.start == 37
						and discarded_span.end == 46
					)
				_:
					False
		_:
			False


pure func test_match_preserves_structure_names_and_spans() -> Bool:
	match parse_source(MATCH_ARM + " 42\n"):
		Err(_):
			False
		Ok(parsed):
			program = program_contents(parsed)

			match root_functions(program).get(0).map(pure func(function): function.body):
				Some(ParsedMatchBody(body)):
					match body.arms:
						[arm]:
							match arm.pattern:
								PatternConstructor(BareHead(name), [PatternName(field)], span):
									(
										body.scrutinee.base_span.start == 27
										and body.scrutinee.span.end == 33
										and name_spelling(program.names, name.id) == Some("Number")
										and name_spelling(program.names, field.id) == Some("item")
										and field.span.start == 44
										and field.span.end == 48
										and span.start == 37
										and span.end == 49
										and arm_integer(arm, 42)
										and body.keyword_span.start == 21
										and body.keyword_span.end == 26
										and body.span.start == 21
										and body.span.end == 53
										and arm.span.start == 37
										and arm.span.end == 53
										and arm_value_start(arm) == Some(51)
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_match_keyword_requires_a_space_before_the_expression() -> Bool:
	rejects(HEADER + "\tmatch-1:\n\t\t_: 0", 26, 28, "expected a space after 'match'", "put a space between 'match' and the matched expression")


pure func test_missing_match_arm_result_uses_explicit_eof_span() -> Bool:
	rejects(
		MATCH_ARM,
		50,
		50,
		"expected an indented match arm result",
		"put the arm's statements and final value on lines indented deeper than its pattern",
	)


pure func test_block_arm_and_inline_sibling() -> Bool:
	match only_match(ARM_BINDING + "\n\t\t\tcurrent\n\t\tEmpty: 0"):
		Some(body):
			match body.arms:
				[first, second]:
					match first.block.statements:
						[BindingStatement(binding)]:
							(
								binding.mutability == MutableBinding
								and binding.name.span.start == 58
								and binding.name.span.end == 65
								and binding.initializer.span.start == 68
								and binding.initializer.span.end == 72
								and first.span.start == 37
								and first.span.end == 83
								and arm_value_start(first) == Some(76)
								and arm_value_end(second) == Some(94)
								and second.block.statements.length() == 0
							)
						_:
							False
				_:
					False
		None:
			False


pure func test_block_arm_can_have_no_bindings() -> Bool:
	match only_match(MATCH_ARM + "\n\t\t\t42"):
		Some(body):
			match body.arms:
				[arm]:
					arm.block.statements.length() == 0 and arm_value_start(arm) == Some(54) and arm_value_end(arm) == Some(56)
				_:
					False
		None:
			False


pure func test_block_arm_is_a_deeper_level() -> Bool:
	(
		rejects(
			MATCH_ARM + "\n\t\t42",
			53,
			55,
			"expected an indented match arm result",
			"put the arm's statements and final value on lines indented deeper than its pattern",
		)
		and parse_source(MATCH_ARM + "\n\t\t\t\t42").is_ok()
	)


-- An arm block may end after a statement: it parses with no value, and the
-- checker decides whether that is allowed where the match stands.
private pure func first_arm_has_no_value(source: String) -> Bool:
	match only_match(source):
		Some(body):
			match body.arms.get(0):
				Some(arm):
					arm.block.value.is_none() and arm.block.statements.length() == 1
				None:
					False
		None:
			False


pure func test_block_arm_without_final_value_parses() -> Bool:
	(
		first_arm_has_no_value(ARM_BINDING + "\n\t\tEmpty: 0")
		and first_arm_has_no_value(ARM_BINDING)
		and first_arm_has_no_value(ARM_BINDING + "\n")
	)


pure func test_binding_prefix() -> Bool:
	match only_function(HEADER + "\tvar value = 42\n\tvalue"):
		Some(function):
			match function.statements:
				[BindingStatement(binding)]:
					(
						binding.mutability == MutableBinding
						and is_integer(binding.initializer, 42)
						and binding.name.span.start == 25
						and binding.name.span.end == 30
						and binding.initializer.base_span.start == 33
						and binding.initializer.base_span.end == 35
						and value_of(function).map(pure func(value): value.span.start) == Some(37)
					)
				_:
					False
		None:
			False


pure func test_binding_requires_initializer_and_final_value() -> Bool:
	(
		rejects(HEADER + "\tvar value =\n\t0", 34, 35, "expected an indented value after '='", "put the value on the same line as '=', or alone on the next line indented one level")
		and rejects(
			HEADER + "\tvar value = 42",
			35,
			35,
			"expected a final expression after the bindings",
			"finish the function with a value expression or tail match",
		)
		and rejects(HEADER + "\tvalue = 1 2\n\tvalue", 31, 32, "expected a newline after the binding", "put each statement on its own line")
	)


pure func test_match_before_a_value_is_a_statement() -> Bool:
	parse_source(HEADER + "\tmatch Choice:\n\t\t_: 0\n\t1").is_ok()


pure func test_lines_outside_a_block_cannot_be_indented() -> Bool:
	help = "indent a line only to open the block of a header ending in ':'; otherwise align it with the line above"
	(
		rejects(HEADER + "\tvalue = 1\n\t\tvalue", 31, 33, "unexpected indentation", help)
		and rejects(HEADER + "\tprint(1)\n\t\t0", 30, 32, "unexpected indentation", help)
		and rejects("fixed union V:\n\tA\n\t\tB", 18, 20, "unexpected indentation", help)
	)


pure func test_builtin_body_is_the_whole_function() -> Bool:
	help = "use builtin as the entire function body; put other work in an ordinary wrapper function"
	(
		rejects(HEADER + "\tx = 1\n\tbuiltin(\"int.add\")", 28, 35, "builtin must be the entire function body", help)
		and rejects(HEADER + "\tbuiltin(\"int.add\")\n\t0", 21, 28, "builtin must be the entire function body", help)
	)


pure func test_annotation_name_must_touch_its_at_sign() -> Bool:
	(
		rejects("@ tail_recursive\nfunc main() -> Int:\n\t0", 0, 16, "unknown function annotation", "use @tail_recursive before a function declaration")
		and only_function("@tail_recursive\nfunc main() -> Int:\n\tmain()").is_some()
	)


pure func test_module_declaration_rejection_retains_exact_source() -> Bool:
	match lex(module_source(root_module_id()), "wrong", program_names().names):
		Err(_):
			False
		Ok(tokens):
			match parse_module(tokens, root_module_id()):
				Err(error):
					(
						error.span.start == 0
						and error.span.end == 5
						and error.message == "expected a function declaration at column 1"
						and error.help == "start with func main() -> Int:"
						and error.note.is_none()
					)
				Ok(_):
					False


tests: TestSuite = {
	description = "Blorp 2 parser",
	tests = [
		("optional field absent versus discarded", test_optional_pattern_field_distinguishes_absent_from_discarded),
		("module declaration rejection retains exact source", test_module_declaration_rejection_retains_exact_source),
		("block arm and inline sibling", test_block_arm_and_inline_sibling),
		("block arm may have zero bindings", test_block_arm_can_have_no_bindings),
		("block arm is a deeper level", test_block_arm_is_a_deeper_level),
		("block arm without final value parses", test_block_arm_without_final_value_parses),
		("binding prefix", test_binding_prefix),
		("binding requires initializer and final value", test_binding_requires_initializer_and_final_value),
		("match preserves structure, names and spans", test_match_preserves_structure_names_and_spans),
		("match keyword requires a following space", test_match_keyword_requires_a_space_before_the_expression),
		("missing match arm result uses explicit EOF", test_missing_match_arm_result_uses_explicit_eof_span),
		("match before a value is a statement", test_match_before_a_value_is_a_statement),
		("lines outside a block cannot be indented", test_lines_outside_a_block_cannot_be_indented),
		("builtin body is the whole function", test_builtin_body_is_the_whole_function),
		("signed literals and endpoints", test_signed_literals_and_endpoints),
		("range rejection spans cover whole token", test_literal_range_rejections_have_whole_token_spans),
		("integer spelling is validated", test_integer_spelling_is_validated),
		("UFCS from spaced tokens", test_ufcs_from_spaced_tokens),
		("unchecked names and spans", test_unchecked_names_and_spans),
		("optional final newline", test_optional_final_newline),
		("parameter annotation is required", test_parameter_annotation_is_required),
		("bare name is parsed without resolving scope", test_bare_name_is_parsed_without_scope_resolution),
		("trailing input is rejected", test_trailing_input_is_rejected),
		("missing body uses explicit EOF span", test_missing_body_uses_explicit_eof_span),
		("annotation name must touch its at sign", test_annotation_name_must_touch_its_at_sign),
	]
}
