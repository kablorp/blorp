import:
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: ParsedBody(ParsedBuiltinBody), ParsedRuntimeOperation(IntegerLessThanBuiltin)
	../module_input: parse_modules
	test: TestSuite


func test_less_than_label_is_accepted_with_its_span() -> Bool:
	source: String =
		|pure func compare(left: Int, right: Int) -> Bool:
		|    builtin("int.less_than")
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(error):
			print_error(error.message)
			print_error(error.help)
			print_error(error.span.start.to_string() + ".." + error.span.end.to_string())
			False
		Ok(program):
			match inventory_functions(parsed_contents(program).declarations).get(0):
				Some(row):
					match row.declaration.body:
						ParsedBuiltinBody(IntegerLessThanBuiltin, span):
							same_source(span.source, module_source(root_module_id())) and span.start == 62 and span.end == 77
						_: False
				None: False


pure func test_constructor_arguments_after_the_label_are_rejected() -> Bool:
	source: String =
		|pure func compare(left: Int, right: Int) -> Bool:
		|    builtin("int.less_than", True, False)
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Ok(_): False
		Err(error):
			(error.message == "expected ')' after the builtin label"
				and error.help == "give the builtin one quoted label; Bool and Option results use the foundation's unions"
				and error.span.start == 77 and error.span.end == 78 and error.note.is_none())


tests: TestSuite = {
	description = "Signed Int ordering label admission",
	tests = [
		("int.less_than accepts an ordinary comparison declaration", test_less_than_label_is_accepted_with_its_span),
		("constructor arguments do not configure Bool tags", test_constructor_arguments_after_the_label_are_rejected),
	]
}
