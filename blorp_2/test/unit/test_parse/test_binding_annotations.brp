import:
	../../../src/lex/lex: lex
	../../../src/parse/parse: ParsedModule, module_contents, parse_module
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax:
		BindingSyntax(ImmutableBinding, MutableBinding),
		Diagnostic,
		ParsedStatement(BindingStatement),
		TypeSyntax(AppliedType, AtomicType),
	test: TestSuite


private pure func parse_source(source: String) -> Result[ParsedModule, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parse_module(tokens, root_module_id())


-- `name: Type = value` keeps the written type on the binding.
pure func test_annotated_bindings_keep_their_written_type() -> Bool:
	match parse_source("func main() -> Int:\n\tsizes: List[Int] = sizes\n\tvar count: Int = 0\n\tplain = 1\n\t0\n"):
		Err(_):
			False
		Ok(parsed):
			match module_contents(parsed).functions.get(0).map(pure func(function): function.statements):
				Some([BindingStatement(sizes), BindingStatement(count), BindingStatement(plain)]):
					match (sizes.annotation, count.annotation, plain.annotation, count.mutability):
						(Some(AppliedType(_, [_], span)), Some(AtomicType(_)), None, MutableBinding):
							span.start == 28 and span.end == 37
						_:
							False
				_:
					False


pure func test_annotation_needs_a_type() -> Bool:
	match parse_source("func main() -> Int:\n\tsizes: = 1\n\t0\n"):
		Err(diagnostic):
			(
				diagnostic.span.start == 28 and diagnostic.span.end == 29
				and diagnostic.message == "expected the binding's type after ':'"
				and diagnostic.help == "use an ASCII identifier starting with a letter or underscore; keywords and lone '_' are reserved"
			)
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 binding type annotations",
	tests = [
		("annotated bindings keep their written type", test_annotated_bindings_keep_their_written_type),
		("annotation needs a type", test_annotation_needs_a_type),
	]
}
