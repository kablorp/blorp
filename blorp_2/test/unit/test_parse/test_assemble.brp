import:
	../../../src/parse/assemble:
		ParsedAssembly,
		ParsedProgram,
		append_module,
		assembly_names,
		begin_program,
		SealFailure(MalformedBundle, ImportCycle),
		parsed_contents,
		seal_program,
	../../../src/lex/lex: lex
	../../../src/utils/ids: function_number, inventory_functions, inventory_opaques, inventory_records, inventory_unions, opaque_number, record_number, union_number, variant_number, variant_owner
	../../../src/utils/names: NameTable, program_names
	../../../src/parse/parse: ParsedModule, parse_module
	../../../src/utils/source:
		compiler_source,
		ModuleId,
		ModuleKind(UserModule, FoundationTypesModule, FoundationPreludeModule, LibraryModule),
		module_id,
		module_number,
		module_source,
		root_module_id,
	../../../src/utils/syntax: Diagnostic, DiagnosticNote(PreviousDeclaration), Visibility(Public, Private), source_bundle_error
	../module_input: sealed
	test: TestSuite


private BUNDLE_HELP: String = "load each module once in inventory order and supply every import target"


private pure func parse_at(source: String, module: ModuleId, names: NameTable) -> Result[ParsedModule, Diagnostic]:
	tokens ?= lex(module_source(module), source, names)
	parse_module(tokens, module)


private pure func bundle_error_is(result: Result[ParsedAssembly, Diagnostic], message: String) -> Bool:
	match result:
		Err(error):
			error.message == message and error.help == BUNDLE_HELP and error.span.source == compiler_source()
		Ok(_):
			False


private pure func append_root(source: String, targets: List[ModuleId]) -> Result[ParsedAssembly, Diagnostic]:
	assembly = begin_program()
	parsed ?= parse_at(source, root_module_id(), assembly_names(assembly))
	append_module(assembly, parsed, targets, UserModule, "fixture.brp")


pure func test_sealing_requires_root_and_complete_targets() -> Bool:
	empty = match seal_program(begin_program()):
		Err(MalformedBundle(error)):
			error.message == "source bundle has no root module" and error.span.source == compiler_source()
		_:
			False
	-- The root imports module 3; the foundation follows at 1 and 2.
	missing = match module_id(3):
		Some(target):
			match append_root("import:\n    ./helper: answer\n", [target]):
				Ok(assembly):
					match assemble_roles(assembly, [FoundationTypesModule, FoundationPreludeModule], 1):
						Err(error):
							error.message == "source bundle is missing an imported module" and error.help == BUNDLE_HELP
						Ok(_):
							False
				Err(_):
					False
		None:
			False
	empty and missing


pure func test_assembly_rejects_a_repeated_module_import() -> Bool:
	source: String =
		|import:
		|    ./one: a
		|    ./one as One
		|
	match module_id(1):
		Some(target):
			match append_root(source, [target, target]):
				Err(error):
					noted = match error.note:
						Some(PreviousDeclaration(first)): first.start == 12
						_: False
					(
						noted and error.message == "module imported more than once"
						and error.help == "combine the alias and the selected names into one import, such as path as Alias: name"
						and error.span.start == 25 and error.span.end == 37
					)
				Ok(_):
					False
		None:
			False


-- `helper` imports the root back: sealing reports the cycle at that import.
pure func test_sealing_rejects_an_import_cycle() -> Bool:
	match (module_id(1), module_id(2), module_id(3)):
		(Some(helper), Some(types), Some(prelude)):
			match append_root("import:\n    ./helper: answer\n", [helper]):
				Ok(root):
					match parse_at("import:\n    ./main: run\n", helper, assembly_names(root)):
						Ok(parsed):
							match append_module(root, parsed, [root_module_id()], UserModule, "fixture.brp"):
								Ok(assembly):
									match foundation(assembly, types, prelude):
										Ok(complete):
											match seal_program(complete):
												Err(ImportCycle([first, second, third], closing)):
													first == root_module_id() and second == helper and third == root_module_id() and closing.source == module_source(helper) and closing.start == 12 and closing.end == 23
												_: False
										Err(_): False
								Err(_): False
						Err(_): False
				Err(_): False
		_:
			False


-- Each user module's first edge is its prelude, so a prelude that imports a
-- user module closes a cycle at that import.
pure func test_sealing_rejects_a_cycle_through_the_prelude() -> Bool:
	match (module_id(1), module_id(2)):
		(Some(types), Some(prelude)):
			match append_root("func main() -> Int:\n    0\n", []):
				Ok(root):
					match parse_at("-- module\n", types, assembly_names(root)):
						Ok(base):
							match append_module(root, base, [], FoundationTypesModule, "fixture.brp"):
								Ok(typed):
									match parse_at("import:\n    ./main: main\n", prelude, assembly_names(typed)):
										Ok(parsed):
											match append_module(typed, parsed, [root_module_id()], FoundationPreludeModule, "fixture.brp"):
												Ok(complete):
													match seal_program(complete):
														Err(ImportCycle([first, second, third], closing)):
															first == root_module_id() and second == prelude and third == root_module_id() and closing.source == module_source(prelude) and closing.start == 12 and closing.end == 24
														_: False
												Err(_): False
										Err(_): False
								Err(_): False
						Err(_): False
				Err(_): False
		_:
			False


-- Adds a parsed row while preserving the assembly's spelling authority.
private pure func append_at(assembly: ParsedAssembly, source: String, module: ModuleId, targets: List[ModuleId], role: ModuleKind) -> Result[ParsedAssembly, Diagnostic]:
	parsed ?= parse_at(source, module, assembly_names(assembly))
	append_module(assembly, parsed, targets, role, "fixture.brp")


private pure func implicit_cycle_assembly(types: ModuleId, prelude: ModuleId, user: ModuleId) -> Result[ParsedAssembly, Diagnostic]:
	root ?= append_root("-- root\n", [])
	typed ?= append_at(root, "-- types\n", types, [], FoundationTypesModule)
	base ?= append_at(typed, "import:\n    ./user: main\n", prelude, [user], FoundationPreludeModule)
	append_at(base, "-- user\n", user, [], UserModule)


-- The prelude imports a second user module. That user's implicit prelude edge
-- closes the cycle, so its end span, rather than a written import, is the site.
pure func test_sealing_reports_an_implicit_edge_closing_a_cycle() -> Bool:
	match (module_id(1), module_id(2), module_id(3)):
		(Some(types), Some(prelude), Some(user)):
			built = implicit_cycle_assembly(types, prelude, user)
			match built:
				Ok(assembly):
					match seal_program(assembly):
						Err(ImportCycle([first, second, third], closing)):
							(
								first == prelude and second == user and third == prelude
								and closing.source == module_source(user) and closing.start == 8 and closing.end == 8
							)
						_: False
				Err(_): False
		_: False


private pure func diamond_assembly(left: ModuleId, right: ModuleId, shared: ModuleId, types: ModuleId, prelude: ModuleId) -> Result[ParsedAssembly, Diagnostic]:
	source: String =
		|import:
		|    ./left: left
		|    ./right: right
		|

	root ?= append_root(source, [left, right])
	first ?= append_at(root, "import:\n    ./shared: shared\n", left, [shared], LibraryModule)
	second ?= append_at(first, "import:\n    ./shared: shared\n", right, [shared], LibraryModule)
	modules ?= append_at(second, "-- shared\n", shared, [], LibraryModule)
	foundation(modules, types, prelude)


-- Shared dependencies are completed once, not mistaken for an active cycle.
-- Imports precede their importers; root/load and source-import order are stable.
pure func test_sealing_orders_a_diamond_once() -> Bool:
	match (module_id(1), module_id(2), module_id(3)):
		(Some(left), Some(right), Some(shared)):
			match (module_id(4), module_id(5)):
				(Some(types), Some(prelude)):
					match diamond_assembly(left, right, shared, types, prelude):
						Ok(assembly):
							match seal_program(assembly):
								Ok(program): parsed_contents(program).dependency_order.map(pure func(row): module_number(row.module)) == [5, 3, 1, 2, 0, 4]
								Err(_): False
						Err(_): False
				_: False
		_: False


-- The old recursive seal overflowed the host stack around 2,350 modules.
private STRESS_MODULES: Int = 3000


-- A chain whose last row either ends, or imports the supplied closing target.
private pure func stress_chain(closing: List[ModuleId]) -> Result[ParsedAssembly, Diagnostic]:
	var assembly: Result[ParsedAssembly, Diagnostic] = Ok(begin_program())
	for ordinal in 0..STRESS_MODULES:
		match (assembly, module_id(ordinal), module_id(ordinal + 1)):
			(Ok(built), Some(module), Some(next)):
				targets = if ordinal + 1 == STRESS_MODULES:
					closing
				else:
					[next]
				source = if targets.is_empty():
					"-- last\n"
				else:
					"import:\n    ./next: run\n"
				role = if ordinal == 0:
					UserModule
				else:
					LibraryModule
				assembly = append_at(built, source, module, targets, role)
			(Err(_), _, _): void
			_: assembly = Err(source_bundle_error("invalid stress module identity"))
	built ?= assembly
	types ?= module_id(STRESS_MODULES).to_result(source_bundle_error("invalid stress types identity"))
	prelude ?= module_id(STRESS_MODULES + 1).to_result(source_bundle_error("invalid stress prelude identity"))
	foundation(built, types, prelude)


pure func test_sealing_reports_a_cycle_through_thousands_of_modules() -> Bool:
	match stress_chain([root_module_id()]):
		Ok(assembly):
			match seal_program(assembly):
				Err(ImportCycle(cycle, closing)):
					var ordered = cycle.length() == STRESS_MODULES + 1
					for ordinal in 0..STRESS_MODULES:
						ordered = ordered and cycle.get(ordinal).map(pure func(module): module_number(module)) == Some(ordinal)
					(
						ordered and cycle.last().map(pure func(module): module_number(module)) == Some(0)
						and closing.source == module_source(module_id(STRESS_MODULES - 1).get_or(root_module_id()))
						and closing.start == 12 and closing.end == 23
					)
				_: False
		Err(_): False


pure func test_sealing_orders_a_chain_through_thousands_of_modules() -> Bool:
	match stress_chain([]):
		Ok(assembly):
			match seal_program(assembly):
				Ok(program):
					order = parsed_contents(program).dependency_order.map(pure func(row): module_number(row.module))
					var expected = [STRESS_MODULES + 1]
					for offset in 0..STRESS_MODULES:
						expected = expected.append(STRESS_MODULES - offset - 1)
					order == expected.append(STRESS_MODULES)
				Err(_): False
		Err(_): False


pure func test_assembly_requires_one_target_per_import() -> Bool:
	message = "source bundle does not supply exactly one target per import"
	(
		bundle_error_is(append_root("import:\n    ./helper: answer\n", []), message)
		and bundle_error_is(append_root("func main() -> Int:\n    0\n", [root_module_id()]), message)
	)


pure func test_assembly_links_each_import_to_its_target_in_order() -> Bool:
	source: String =
		|import:
		|    ./one: a
		|    ./two: b
		|

	match (module_id(1), module_id(2)):
		(Some(first), Some(second)):
			match append_root(source, [second, first]):
				Ok(root):
					match assemble_roles(root, [FoundationTypesModule, FoundationPreludeModule], 1):
						Ok(program):
							match parsed_contents(program).modules.get(0).map(pure func(row): row.imports):
								Some([one, two]):
									(
										one.target == second
										and two.target == first
										and one.span.start == 12
										and two.span.start == 25
									)
								_:
									False
						Err(_):
							False
				Err(_):
					False
		_:
			False


pure func test_assembly_rejects_stale_name_authority() -> Bool:
	assembly = begin_program()

	match (parse_at("func first() -> Int:\n    1\n", root_module_id(), assembly_names(assembly)), module_id(1)):
		(Ok(first), Some(next_id)):
			match (append_module(assembly, first, [], UserModule, "fixture.brp"), parse_at("func second() -> Int:\n    2\n", next_id, assembly_names(assembly))):
				(Ok(extended), Ok(stale)):
					bundle_error_is(append_module(extended, stale, [], UserModule, "fixture.brp"), "parsed module does not extend this source bundle's name authority")
				_:
					False
		_:
			False


pure func test_assembly_rejects_wrong_module_identity() -> Bool:
	assembly = begin_program()

	match module_id(1):
		Some(other):
			match parse_at("func main() -> Int:\n    0\n", other, assembly_names(assembly)):
				Ok(parsed):
					bundle_error_is(append_module(assembly, parsed, [], UserModule, "fixture.brp"), "parsed module does not have the next source bundle identity")
				Err(_):
					False
		None:
			False


-- A comment-only base and prelude at `types` and `prelude`.
private pure func foundation(assembly: ParsedAssembly, types: ModuleId, prelude: ModuleId) -> Result[ParsedAssembly, Diagnostic]:
	base ?= parse_at("-- module\n", types, assembly_names(assembly))
	typed ?= append_module(assembly, base, [], FoundationTypesModule, "fixture.brp")
	scope ?= parse_at("-- module\n", prelude, assembly_names(typed))
	append_module(typed, scope, [], FoundationPreludeModule, "fixture.brp")


-- Appends one comment-only module per role, in inventory order, then seals.
private pure func assemble_roles(assembly: ParsedAssembly, roles: List[ModuleKind], ordinal: Int) -> Result[ParsedProgram, Diagnostic]:
	match roles:
		[]:
			sealed(assembly)
		[role, ...remaining]:
			id ?= module_id(ordinal).to_result({ span = { source = compiler_source(), start = 0, end = 0 }, note = None, message = "test inventory too large", help = "test setup" })
			parsed ?= parse_at("-- module\n", id, assembly_names(assembly))
			next ?= append_module(assembly, parsed, [], role, "fixture.brp")
			assemble_roles(next, remaining, ordinal + 1)


private pure func roles_reject(roles: List[ModuleKind], message: String, source_ordinal: Int) -> Bool:
	match assemble_roles(begin_program(), roles, 0):
		Ok(_):
			False
		Err(error):
			(
				error.message == message
				and error.span.source == module_source(module_id(source_ordinal).get_or(root_module_id()))
				and error.span.start == 10
				and error.span.end == 10
				and error.help == BUNDLE_HELP
			)


pure func test_sealing_requires_designated_types_role() -> Bool:
	roles_reject([UserModule, FoundationPreludeModule], "source bundle has no foundation types module", 0)


pure func test_sealing_requires_designated_prelude_role() -> Bool:
	roles_reject([UserModule, FoundationTypesModule], "source bundle has no foundation prelude module", 0)


pure func test_sealing_rejects_duplicate_types_role() -> Bool:
	roles_reject([UserModule, FoundationTypesModule, FoundationTypesModule, FoundationPreludeModule], "source bundle has more than one foundation types module", 2)


pure func test_sealing_rejects_duplicate_prelude_role() -> Bool:
	roles_reject([UserModule, FoundationTypesModule, FoundationPreludeModule, FoundationPreludeModule], "source bundle has more than one foundation prelude module", 3)


pure func test_sealing_requires_user_root_role() -> Bool:
	roles_reject([FoundationTypesModule, UserModule, FoundationPreludeModule], "source bundle root must be a user module", 0)


pure func test_sealing_publishes_actual_designated_module_identities() -> Bool:
	match assemble_roles(begin_program(), [UserModule, LibraryModule, FoundationPreludeModule, FoundationTypesModule], 0):
		Err(_):
			False
		Ok(program):
			contents = parsed_contents(program)

			match (module_id(2), module_id(3)):
				(Some(prelude), Some(types)):
					(
						contents.foundation.prelude == prelude
						and contents.foundation.types == types
						and contents.modules.length() == 4
						and module_number(contents.modules.get(1).map(pure func(row): row.module).get_or(root_module_id())) == 1
					)
				_:
					False


pure func test_builtin_declarations_record_their_module() -> Bool:
	match append_root("type Int = builtin\ntype Void = builtin\n", []):
		Err(_):
			False
		Ok(assembly):
			match assemble_roles(assembly, [FoundationTypesModule, FoundationPreludeModule], 1):
				Err(_):
					False
				Ok(program):
					declarations = parsed_contents(program).builtin_types
					(
						declarations.length() == 2
						and declarations.all(pure func(row): row.module == root_module_id())
					)


pure func test_sealing_publishes_ids_for_complete_syntax_inventory() -> Bool:
	source: String =
		|record Box { value: Int }
		|union Choice:
		|    First
		|    Second(Int)
		|func main() -> Int:
		|    0
		|
	match append_root(source, []):
		Err(_): False
		Ok(assembly):
			match assemble_roles(assembly, [FoundationTypesModule, FoundationPreludeModule], 1):
				Err(_): False
				Ok(program):
					inventory = parsed_contents(program).declarations
					match (inventory_functions(inventory), inventory_records(inventory), inventory_unions(inventory)):
						([function], [record_row], [union_row]):
							match union_row.variants:
								[first, second]:
									(
										function_number(function.id) == 0 and record_number(record_row.id) == 0 and union_number(union_row.id) == 0
										and variant_number(first.id) == 0 and variant_number(second.id) == 1
										and union_number(variant_owner(first.id)) == 0 and union_number(variant_owner(second.id)) == 0
										and function.declaration.module == root_module_id()
										and record_row.declaration.module == root_module_id() and union_row.module == root_module_id()
										and first.declaration.fields.is_empty() and second.declaration.fields.length() == 1
									)
								_: False
						_: False


pure func test_sealing_issues_opaque_rows_once_across_modules() -> Bool:
	root_source = "opaque type Shared = Int\nprivate opaque type Hidden = List[Int]\n"
	match (append_root(root_source, []), module_id(1)):
		(Ok(root), Some(helper)):
			match append_at(root, "opaque type Shared = Float\n", helper, [], UserModule):
				Err(_): False
				Ok(assembly):
					match assemble_roles(assembly, [FoundationTypesModule, FoundationPreludeModule], 2):
						Err(_): False
						Ok(program):
							match inventory_opaques(parsed_contents(program).declarations):
								[first, second, third]:
									match (first.declaration.visibility, second.declaration.visibility, third.declaration.visibility):
										(Public, Private(private_span), Public):
											(
												[opaque_number(first.id), opaque_number(second.id), opaque_number(third.id)] == [0, 1, 2]
												and first.declaration.module == root_module_id()
												and second.declaration.module == root_module_id()
												and third.declaration.module == helper
												and private_span.source == module_source(root_module_id())
												and private_span.start == 25
												and first.declaration.type_name.span.start == 12
												and third.declaration.type_name.span.start == 12
											)
										_: False
								_: False
		_: False


tests: TestSuite = {
	description = "Blorp 2 program assembly",
	tests = [
		("sealing requires root and complete targets", test_sealing_requires_root_and_complete_targets),
		("assembly rejects a repeated module import", test_assembly_rejects_a_repeated_module_import),
		("sealing rejects an import cycle", test_sealing_rejects_an_import_cycle),
		("sealing rejects a cycle through the prelude", test_sealing_rejects_a_cycle_through_the_prelude),
		("sealing reports an implicit edge closing a cycle", test_sealing_reports_an_implicit_edge_closing_a_cycle),
		("sealing orders a diamond once", test_sealing_orders_a_diamond_once),
		("sealing reports a cycle through thousands of modules", test_sealing_reports_a_cycle_through_thousands_of_modules),
		("sealing orders a chain through thousands of modules", test_sealing_orders_a_chain_through_thousands_of_modules),
		("assembly requires one target per import", test_assembly_requires_one_target_per_import),
		("assembly links imports to targets in order", test_assembly_links_each_import_to_its_target_in_order),
		("assembly rejects stale name authority", test_assembly_rejects_stale_name_authority),
		("assembly rejects wrong module identity", test_assembly_rejects_wrong_module_identity),
		("sealing requires types role", test_sealing_requires_designated_types_role),
		("sealing requires prelude role", test_sealing_requires_designated_prelude_role),
		("sealing rejects duplicate types role", test_sealing_rejects_duplicate_types_role),
		("sealing rejects duplicate prelude role", test_sealing_rejects_duplicate_prelude_role),
		("sealing requires user root", test_sealing_requires_user_root_role),
		("sealing publishes designated IDs", test_sealing_publishes_actual_designated_module_identities),
		("builtin declarations record their module", test_builtin_declarations_record_their_module),
		("sealing publishes issued IDs for complete syntax", test_sealing_publishes_ids_for_complete_syntax_inventory),
		("sealing issues opaque rows once across modules", test_sealing_issues_opaque_rows_once_across_modules),
	]
}
