import:
    ../../../src/lex/lex: lex
    ../../../src/parse/parse: parse_module
    ../../../src/parse/assemble:
        ModuleImport, ParsedAssembly, ParsedContents, SealFailure(MalformedBundle, ImportCycle), append_module, assembly_names, begin_program,
        parsed_contents, prepare_test_entry, seal_program
    ../../../src/utils/ids: function_number, inventory_functions
    ../../../src/utils/names: NameId, NameTable, name_spelling, same_name
    ../../../src/utils/source:
        ModuleId, ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule),
        SourceId, module_id, module_source, root_module_id, same_module, same_source
    ../../../src/utils/syntax:
        Diagnostic, ExpressionBase(NameExpression, QualifiedName, QualifiedApplication, ListExpression),
        ParsedBody(ParsedValueBody), Span, ValueExpression, source_bundle_error
    bool: and
    int: Int methods
    list: List methods
    option: Option methods
    test: TestSuite


private SUITE_HELP: String = "tests: TestSuite = { description = ..., tests = [...] }"


-- The loader's order: the first root at 0, the base at 1, the prelude at 2,
-- then the later root at 3, and the configured test library after them.
private LATER_ROOT_ORDINAL: Int = 3
private LIBRARY_ORDINAL: Int = 4
-- The bundle has five modules, so no row has this ordinal.
private ABSENT_ORDINAL: Int = 9
-- The first root, the base, the prelude, the later root and the library.
private BUNDLE_MODULES: Int = 5


private pure func ordinal_module(ordinal: Int) -> ModuleId:
    module_id(ordinal).get_or(root_module_id())


private pure func append_source(assembly: ParsedAssembly, source: String, id: ModuleId, targets: List[ModuleId], role: ModuleKind) -> Result[ParsedAssembly, Diagnostic]:
    tokens ?= lex(module_source(id), source, assembly_names(assembly))
    parsed ?= parse_module(tokens, id)
    append_module(assembly, parsed, targets, role, "fixture.brp")


-- `root` imports `targets`; `later` is a user module that is a test suite
-- root only when `grouped` names it.
private pure func prepared(root: String, targets: List[ModuleId], later: String, grouped: List[ModuleId]) -> Result[ParsedContents, Diagnostic]:
    first ?= append_source(begin_program(), root, root_module_id(), targets, UserModule)
    second ?= append_source(first, "", ordinal_module(1), [], FoundationTypesModule)
    third ?= append_source(second, "", ordinal_module(2), [], FoundationPreludeModule)
    fourth ?= append_source(third, later, ordinal_module(LATER_ROOT_ORDINAL), [], UserModule)
    fifth ?= append_source(fourth, "", ordinal_module(LIBRARY_ORDINAL), [], LibraryModule)
    ready ?= prepare_test_entry(fifth, grouped, ordinal_module(LIBRARY_ORDINAL), ordinal_module(1))
    match seal_program(ready):
        Ok(program): Ok(parsed_contents(program))
        Err(MalformedBundle(error)): Err(error)
        Err(ImportCycle(_, _)): Err(source_bundle_error("unexpected import cycle"))


private pure func spelled(names: NameTable, id: NameId, expected: String) -> Bool:
    name_spelling(names, id) == Some(expected)


private pure func aliased(request: ModuleImport, expected: NameId) -> Bool:
    match request.module_alias:
        Some(written): same_name(written.id, expected)
        None: False


-- The value body of the synthesized entry, the function the program enters.
private pure func entry_body(parsed: ParsedContents) -> Option[ValueExpression]:
    var body: Option[ValueExpression] = None
    for row in inventory_functions(parsed.declarations):
        if same_name(row.declaration.function_name.id, parsed.entrypoint):
            match row.declaration.body:
                ParsedValueBody(value): body = Some(value)
                _: body = None
    body


-- `<library>.run_suite_result(suite)` whose suite operand is located at `end`
-- of the root `origin`; yields that operand's base.
private pure func suite_run(names: NameTable, run: ValueExpression, origin: SourceId, end: Int) -> Option[ExpressionBase]:
    match run.base:
        QualifiedApplication(runner, [suite]):
            if and(spelled(names, runner.name.id, "run_suite_result"), and(same_source(suite.span.source, origin), and(suite.span.start == end, suite.span.end == end))):
                Some(suite.base)
            else:
                None
        _: None


-- Root 0's constant runs first through its own name, then the later root's
-- through an import under an alias no source can write, each located at its
-- own root's end, and one status call receives their results.
pure func test_two_roots_run_both_suites_in_order() -> Bool:
    root = "tests: Int = 1\n"
    later = "tests: Int = 2\n\n"
    match prepared(root, [], later, [ordinal_module(LATER_ROOT_ORDINAL)]):
        Err(_): False
        Ok(parsed):
            match (entry_body(parsed), parsed.modules.get(0)):
                (Some(body), Some(root_row)):
                    match body.base:
                        QualifiedApplication(status, [argument]):
                            match argument.base:
                                ListExpression([own, grouped]):
                                    match (suite_run(parsed.names, own, module_source(root_module_id()), root.length()), suite_run(parsed.names, grouped, module_source(ordinal_module(LATER_ROOT_ORDINAL)), later.length())):
                                        (Some(NameExpression(own_name)), Some(QualifiedName(qualified))):
                                            imported = root_row.imports.any(pure func(request): and(same_module(request.target, ordinal_module(LATER_ROOT_ORDINAL)), aliased(request, qualified.module.id)))
                                            and(
                                                and(spelled(parsed.names, status.name.id, "suites_exit_status"), spelled(parsed.names, own_name.id, "tests")),
                                                and(and(spelled(parsed.names, qualified.module.id, "<suite 1>"), spelled(parsed.names, qualified.name.id, "tests")), imported),
                                            )
                                        _: False
                                _: False
                        _: False
                _: False


-- A single input is a list of one, so there is one code path.
pure func test_one_root_runs_a_list_of_one() -> Bool:
    root = "tests: Int = 1\n"
    match prepared(root, [], "", []):
        Err(_): False
        Ok(parsed):
            match entry_body(parsed):
                Some(body):
                    match body.base:
                        QualifiedApplication(_, [argument]):
                            match argument.base:
                                ListExpression([own]): suite_run(parsed.names, own, module_source(root_module_id()), root.length()).is_some()
                                _: False
                        _: False
                None: False


-- The root's own import of a later root keeps its alias, so the module is
-- imported once and the entry names it as the root wrote it.
pure func test_an_imported_later_root_keeps_the_root_alias() -> Bool:
    root = "import:\n    ./fixture as Other\ntests: Int = 1\n"
    later = "tests: Int = 2\n"
    match prepared(root, [ordinal_module(LATER_ROOT_ORDINAL)], later, [ordinal_module(LATER_ROOT_ORDINAL)]):
        Err(_): False
        Ok(parsed):
            later_imports = match parsed.modules.get(0):
                Some(root_row): root_row.imports.filter(pure func(request): same_module(request.target, ordinal_module(LATER_ROOT_ORDINAL)))
                None: []
            match (entry_body(parsed), later_imports):
                (Some(body), [request]):
                    match body.base:
                        QualifiedApplication(_, [argument]):
                            match argument.base:
                                ListExpression([_, grouped]):
                                    match suite_run(parsed.names, grouped, module_source(ordinal_module(LATER_ROOT_ORDINAL)), later.length()):
                                        Some(QualifiedName(qualified)): and(spelled(parsed.names, qualified.module.id, "Other"), aliased(request, qualified.module.id))
                                        _: False
                                _: False
                        _: False
                _: False


private pure func rejects(root: String, targets: List[ModuleId], later: String, origin: SourceId, start: Int, end: Int, message: String, help: String) -> Bool:
    match prepared(root, targets, later, [ordinal_module(LATER_ROOT_ORDINAL)]):
        Ok(_): False
        Err(error):
            and(
                and(same_source(error.span.source, origin), and(error.span.start == start, error.span.end == end)),
                and(and(error.message == message, error.help == help), error.note.is_none()),
            )


pure func test_a_tests_function_is_rejected_at_its_name() -> Bool:
    rejects(
        "pure func tests() -> Int:\n    1\n", [], "tests: Int = 2\n", module_source(root_module_id()), 10, 15,
        "test suite must be a constant, not a function", "declare ${SUITE_HELP} instead",
    )


pure func test_a_later_root_without_tests_is_rejected_at_its_end() -> Bool:
    later = "pure func helper() -> Int:\n    1\n"
    rejects(
        "tests: Int = 1\n", [], later, module_source(ordinal_module(LATER_ROOT_ORDINAL)), later.length(), later.length(),
        "test suite file declares no tests constant", "declare ${SUITE_HELP} in this file",
    )


-- An imported `tests` is not declared by the root, so it is not a suite.
pure func test_an_imported_tests_is_not_a_suite() -> Bool:
    root = "import:\n    ./fixture: tests\n"
    rejects(
        root, [ordinal_module(LATER_ROOT_ORDINAL)], "tests: Int = 2\n", module_source(root_module_id()), root.length(), root.length(),
        "test suite file declares no tests constant", "declare ${SUITE_HELP} in this file",
    )


-- A grouped root without a row is an internal fault; it must not replace the
-- user-facing discovery error already found at the first root.
pure func test_a_root_discovery_error_survives_a_missing_later_root() -> Bool:
    root = "pure func helper() -> Int:\n    1\n"
    match prepared(root, [], "", [ordinal_module(ABSENT_ORDINAL)]):
        Ok(_): False
        Err(error):
            and(
                and(error.message == "test suite file declares no tests constant", error.help == "declare ${SUITE_HELP} in this file"),
                and(same_source(error.span.source, module_source(root_module_id())), error.span.start == root.length()),
            )


-- The entry is an ordinary root function issued after the root's own, with
-- the next function identity, and it becomes the program's entrypoint; the
-- user's `main` keeps its name.
pure func test_the_entry_follows_the_root_functions_and_is_the_entrypoint() -> Bool:
    match prepared("tests: Int = 1\nfunc main() -> Int:\n    7\n", [], "", []):
        Err(_): False
        Ok(parsed):
            match inventory_functions(parsed.declarations):
                [main, entry]:
                    and(
                        and(
                            and(function_number(main.id) == 0, function_number(entry.id) == 1),
                            and(spelled(parsed.names, main.declaration.function_name.id, "main"), same_name(parsed.entrypoint, entry.declaration.function_name.id)),
                        ),
                        and(same_module(entry.declaration.module, root_module_id()), parsed.modules.length() == BUNDLE_MODULES),
                    )
                _: False


tests: TestSuite = {
    description = "Blorp 2 grouped test entry assembly",
    tests = [
        ("two roots run both suites in order", test_two_roots_run_both_suites_in_order),
        ("one root runs a list of one", test_one_root_runs_a_list_of_one),
        ("an imported later root keeps the root alias", test_an_imported_later_root_keeps_the_root_alias),
        ("a tests function is rejected at its name", test_a_tests_function_is_rejected_at_its_name),
        ("a later root without tests is rejected at its end", test_a_later_root_without_tests_is_rejected_at_its_end),
        ("an imported tests is not a suite", test_an_imported_tests_is_not_a_suite),
        ("a root discovery error survives a missing later root", test_a_root_discovery_error_survives_a_missing_later_root),
        ("the entry follows the root functions and is the entrypoint", test_the_entry_follows_the_root_functions_and_is_the_entrypoint),
    ]
}
