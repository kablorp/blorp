import:
	../../../src/lex/lex: lex
	../../../src/parse/parse: ParsedModule, parse_module
	../../../src/utils/names: program_names
	../../../src/utils/source: ModuleId, module_id, module_source, root_module_id, same_source
	../../../src/utils/syntax: Diagnostic
	test: TestSuite


private HEADER: String = "func main() -> Int:\n"


private pure func parse_source(source: String, module: ModuleId) -> Result[ParsedModule, Diagnostic]:
	tokens ?= lex(module_source(module), source, program_names().names)
	parse_module(tokens, module)


private pure func rejects(
	source: String, module: ModuleId, start: Int, end: Int, message: String, help: String,
) -> Bool:
	match parse_source(source, module):
		Ok(_): False
		Err(error):
			(
				same_source(error.span.source, module_source(module))
				and error.span.start == start and error.span.end == end
				and error.message == message and error.help == help and error.note.is_none()
			)


private pure func reserved(prefix: String, word: String, suffix: String, module: ModuleId) -> Bool:
	rejects(prefix + word + suffix, module, prefix.length(), prefix.length() + word.length(),
		"`" + word + "` is a reserved keyword and cannot be used as a name",
		"choose another identifier such as `" + word + "_name`",
	)


pure func test_function_name_quotes_the_written_reserved_word() -> Bool:
	reserved("pure func ", "where", "() -> Int:\n\t0\n", root_module_id())


pure func test_type_name_quotes_an_unparsed_reserved_word() -> Bool:
	reserved("fixed union ", "from", ":\n\tOnly\n", root_module_id())


pure func test_parameter_name_quotes_the_written_reserved_word() -> Bool:
	reserved("func apply(", "select", ": Int) -> Int:\n\t0\n", root_module_id())


pure func test_immutable_binding_quotes_the_written_reserved_word() -> Bool:
	reserved(HEADER + "    ", "where", " = 1\n    0\n", root_module_id())


pure func test_mutable_binding_quotes_the_written_reserved_word() -> Bool:
	reserved(HEADER + "\tvar ", "in", " = 1\n\t0\n", root_module_id())


pure func test_propagating_binding_quotes_the_written_reserved_word() -> Bool:
	reserved(HEADER + "\t", "in", " ?= find()\n\t0\n", root_module_id())


pure func test_reserved_name_at_eof_keeps_the_full_word_span() -> Bool:
	reserved("func ", "where", "", root_module_id())


pure func test_reserved_name_after_multibyte_text_uses_byte_offsets() -> Bool:
	prefix: String =
		|func main() -> Int:
		|    text = "é☀"
		|
	reserved(prefix + "    ", "where", " = 1\n    0\n", root_module_id())


pure func test_distinct_module_texts_quote_their_own_reserved_word() -> Bool:
	match module_id(7):
		None: False
		Some(dependency):
			first = reserved("func ", "where", "() -> Int:\n\t0\n", root_module_id())
			second = reserved("func ", "debug", "() -> Int:\n\t0\n", dependency)
			first and second


pure func test_unparsed_reserved_word_does_not_become_a_function_keyword() -> Bool:
	rejects("where answer() -> Int:\n\t0\n", root_module_id(), 0, 5,
		"expected a function declaration at column 1", "start with func main() -> Int:",
	)


pure func test_at_sign_keeps_precedence_over_the_identifier_error() -> Bool:
	rejects("func @() -> Int:\n\t0\n", root_module_id(), 5, 6,
		"misplaced function annotation", "put @tail_recursive before the optional pure and func keywords at column 1",
	)


pure func test_lone_underscore_keeps_the_identifier_error() -> Bool:
	rejects("func _() -> Int:\n\t0\n", root_module_id(), 5, 6,
		"expected a function name", "use an ASCII identifier starting with a letter or underscore; keywords and lone '_' are reserved",
	)


pure func test_callable_keywords_remain_reserved_outside_function_names() -> Bool:
	["not", "and", "or"].all(pure func(word):
		(reserved("func apply(", word, ": Int) -> Int:\n\t0\n", root_module_id())
			and reserved("fixed record ", word, " { value: Int }\n", root_module_id())
			and reserved(HEADER + "\tvar ", word, " = 1\n\t0\n", root_module_id())
			and reserved(HEADER + "\tvalue.", word, "\n", root_module_id()))
	)


tests: TestSuite = {
	description = "Blorp 2 reserved-name source diagnostics",
	tests = [
		("function name quotes its reserved word", test_function_name_quotes_the_written_reserved_word),
		("type name quotes its unparsed reserved word", test_type_name_quotes_an_unparsed_reserved_word),
		("parameter name quotes its reserved word", test_parameter_name_quotes_the_written_reserved_word),
		("immutable binding quotes its reserved word", test_immutable_binding_quotes_the_written_reserved_word),
		("mutable binding quotes its reserved word", test_mutable_binding_quotes_the_written_reserved_word),
		("propagating binding quotes its reserved word", test_propagating_binding_quotes_the_written_reserved_word),
		("reserved name at EOF keeps its span", test_reserved_name_at_eof_keeps_the_full_word_span),
		("reserved name after UTF-8 uses byte offsets", test_reserved_name_after_multibyte_text_uses_byte_offsets),
		("module texts quote their own word", test_distinct_module_texts_quote_their_own_reserved_word),
		("unparsed keyword does not act as func", test_unparsed_reserved_word_does_not_become_a_function_keyword),
		("at sign keeps diagnostic precedence", test_at_sign_keeps_precedence_over_the_identifier_error),
		("underscore keeps identifier error", test_lone_underscore_keeps_the_identifier_error),
		("callable keywords keep other reserved-name rules", test_callable_keywords_remain_reserved_outside_function_names),
	]
}
