import:
	string as StringOps
	int as IntOps
	io: print_error
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: ParsedBody(ParsedBuiltinBody), ParsedRuntimeOperation(StringConcatBuiltin)
	../module_input: parse_modules
	test: TestSuite


func test_string_add_label_is_accepted_at_its_exact_span() -> Bool:
	header = "pure func concatenate(left: String, right: String) -> String:\n    builtin("
	source: String =
		|pure func concatenate(left: String, right: String) -> String:
		|    builtin("string.add")
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(error):
			print_error(StringOps.add(StringOps.add(error.message, "\nhelp: "), error.help))
			print_error(StringOps.add(StringOps.add(IntOps.to_string(error.span.start), ".."), IntOps.to_string(error.span.end)))
			False
		Ok(program):
			match inventory_functions(parsed_contents(program).declarations).get(0):
				Some(row):
					match row.declaration.body:
						ParsedBuiltinBody(StringConcatBuiltin, at):
							match same_source(at.source, module_source(root_module_id())):
								False: False
								True:
									match IntOps.equals(at.start, StringOps.length(header)):
										False: False
										True:
											IntOps.equals(at.end, IntOps.add(StringOps.length(header), StringOps.length("\"string.add\"")))
						_: False
				None: False


tests: TestSuite = {
	description = "Blorp 2 String concat label acceptance",
	tests = [("string.add accepts its quoted operation span", test_string_add_label_is_accepted_at_its_exact_span)]
}
