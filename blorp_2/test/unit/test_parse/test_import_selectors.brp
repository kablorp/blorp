import:
    ../input: existing_name
    ../../../src/lex/lex: lex
    ../../../src/utils/names: name_spelling, program_names
    ../../../src/parse/parse:
        ImportSelection(NamedSelection, ConstructorSelection, MethodsOnlySelection),
        module_imports, module_names, parse_module
    ../../../src/utils/source: module_source, root_module_id, same_source
    option: is_none, is_some
    result: and_then
    test: TestSuite


private pure func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
    origin = module_source(root_module_id())
    match lex(origin, source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
        Ok(_): False
        Err(error):
            (
                same_source(error.span.source, origin) and error.span.start == start and error.span.end == end
                and error.message == message and error.help == help and error.note.is_none()
            )


pure func test_mixed_selectors_retain_category_names_and_modifier_span() -> Bool:
    source: String =
        |import:
        |    ./ops: Foo, Foo(First, methods_only), Foo(), Foo methods_only, methods_only
        |
    origin = module_source(root_module_id())
    match lex(origin, source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
        Err(_): False
        Ok(parsed):
            names = module_names(parsed)
            match module_imports(parsed):
                [request]:
                    -- Keep independent selector matches: the host compiler misbinds
                    -- nested payloads in one parallel list pattern.
                    ordinary = match request.symbols.get(0):
                        Some(NamedSelection(name)):
                            name_spelling(names, name.id) == Some("Foo") and name.span.start == 19 and name.span.end == 22
                        _: False
                    constructors = match request.symbols.get(1):
                        Some(ConstructorSelection(name, [first, contextual])):
                            (
                                name_spelling(names, name.id) == Some("Foo")
                                and name_spelling(names, first.id) == Some("First")
                                and name_spelling(names, contextual.id) == Some("methods_only")
                            )
                        _: False
                    empty = match request.symbols.get(2):
                        Some(ConstructorSelection(name, [])): name_spelling(names, name.id) == Some("Foo")
                        _: False
                    methods = match request.symbols.get(3):
                        Some(MethodsOnlySelection(name, modifier)):
                            (
                                name_spelling(names, name.id) == Some("Foo")
                                and modifier.start == 61 and modifier.end == 73 and same_source(modifier.source, origin)
                            )
                        _: False
                    contextual = match request.symbols.get(4):
                        Some(NamedSelection(name)): name_spelling(names, name.id) == Some("methods_only")
                        _: False
                    ordinary and constructors and empty and methods and contextual and request.symbols.length() == 5
                _: False


pure func test_constructor_names_share_the_published_authority() -> Bool:
    source: String =
        |import:
        |    ./ops: Foo(First, Second)
        |
    match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
        Err(_): False
        Ok(parsed):
            names = module_names(parsed)
            match module_imports(parsed):
                [request]:
                    match request.symbols:
                        [ConstructorSelection(type_name, [first, second])]:
                            (
                                name_spelling(names, type_name.id) == Some("Foo")
                                and name_spelling(names, first.id) == Some("First")
                                and name_spelling(names, second.id) == Some("Second")
                            )
                        _: False
                _: False


private pure func retains_first_constructor(suffix: String) -> Bool:
    source = "import:\n    ./ops: Foo(First), " + suffix + "\n"
    match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
        Err(_): False
        Ok(parsed):
            names = module_names(parsed)
            match module_imports(parsed):
                [request]:
                    match request.symbols.get(0):
                        Some(ConstructorSelection(_, [first])): name_spelling(names, first.id) == Some("First")
                        _: False
                _: False

pure func test_constructor_then_name() -> Bool:
    retains_first_constructor("Foo")

pure func test_constructor_then_empty_selection() -> Bool:
    retains_first_constructor("Foo()")

pure func test_constructor_then_methods_only() -> Bool:
    retains_first_constructor("Foo methods_only")


pure func test_mixed_selector_names_are_all_in_authority() -> Bool:
    source = "import:\n    ./ops: Foo, Foo(First, methods_only), Foo(), Foo methods_only, methods_only\n"
    match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
        Err(_): False
        Ok(parsed):
            names = module_names(parsed)
            existing_name(names, "First").is_some() and existing_name(names, "methods_only").is_some()


pure func test_constructor_selection_cannot_combine_with_modifier() -> Bool:
    rejects("import:\n    ops: Foo(First) methods_only\n", 28, 40,
        "constructor selection cannot be combined with methods_only",
        "write Foo(First) to import the type and constructors, or Foo methods_only to import only methods")


pure func test_modifier_cannot_repeat() -> Bool:
    rejects("import:\n    ops: Foo methods_only methods_only\n", 34, 46,
        "methods_only must appear once after a type name",
        "write ops: Foo methods_only without constructors or another modifier")


pure func test_modifier_cannot_precede_constructor_selection() -> Bool:
    rejects("import:\n    ops: Foo methods_only(First)\n", 33, 34,
        "methods_only cannot include constructor selection",
        "write Foo(First) to import the type and constructors, or Foo methods_only to import only methods")


pure func test_empty_module_is_valid_syntax() -> Bool:
    match lex(module_source(root_module_id()), "", program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
        Err(_): False
        Ok(parsed): module_imports(parsed).length() == 0


pure func test_comment_only_module_is_valid_syntax() -> Bool:
    source: String =
        |-- No operations are implemented yet.
        |
        |    -- Comments have no layout meaning.
        |
    match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
        Err(_): False
        Ok(parsed): module_imports(parsed).length() == 0


tests: TestSuite = {
    description = "Blorp 2 typed import selectors",
    tests = [
        ("mixed selectors retain categories and modifier span", test_mixed_selectors_retain_category_names_and_modifier_span),
        ("constructor names share published authority", test_constructor_names_share_the_published_authority),
        ("constructor then named selection", test_constructor_then_name),
        ("constructor then empty selection", test_constructor_then_empty_selection),
        ("constructor then methods_only", test_constructor_then_methods_only),
        ("mixed selector name table", test_mixed_selector_names_are_all_in_authority),
        ("constructor selection rejects modifier", test_constructor_selection_cannot_combine_with_modifier),
        ("modifier rejects repetition", test_modifier_cannot_repeat),
        ("modifier rejects constructors", test_modifier_cannot_precede_constructor_selection),
        ("empty module parses", test_empty_module_is_valid_syntax),
        ("comment-only module parses", test_comment_only_module_is_valid_syntax),
    ]
}
