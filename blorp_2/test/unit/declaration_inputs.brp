import:
	../../src/utils/declarations: DeclarationInventory, issue_inventory
	../../src/utils/names: intern_name, program_names
	../../src/utils/source: foundation_prelude_module_id, module_source, root_module_id
	../../src/utils/syntax:
		ExpressionBase(IntegerExpression),
		ParsedBody(ParsedValueBody),
		ParsedFunction,
		ParsedRecord,
		ParsedUnion,
		ParsedVariant,
		Purity(Impure),
		Span,


-- Direct syntax fixtures exercise the actual identity producer without parsing
-- or semantic checking. Every ID refers to one of these supplied declarations.
pure func sample_inventory() -> DeclarationInventory:
	var names = program_names().names
	var functions: List[ParsedFunction] = []
	var records: List[ParsedRecord] = []
	var unions: List[ParsedUnion] = []
	for position in 0..4:
		module = if position < 2:
			root_module_id()
		else:
			foundation_prelude_module_id()
		span: Span = { source = module_source(module), start = (position % 2) * 40 + 10, end = (position % 2) * 40 + 11 }
		function_name = intern_name(names, "function" + position.to_string())
		names = function_name.names
		functions = functions.append({
			module = module,
			tail_annotation = None,
			purity = Impure,
			function_name = { id = function_name.id, span = span },
			type_parameters = [],
			parameters = [],
			return_type = None,
			statements = [],
			body = ParsedValueBody({ base = IntegerExpression(0), base_span = span, applications = [], span = span }),
		})
		record_name = intern_name(names, "Record" + position.to_string())
		names = record_name.names
		records = records.append({
			module = module,
			type_name = { id = record_name.id, span = span },
			type_parameters = [],
			fields = [],
		})
	for position in 0..5:
		module = if position < 2:
			root_module_id()
		else:
			foundation_prelude_module_id()
		start = if position < 2:
			position * 40 + 30
		else:
			(position - 2) * 40
		span: Span = { source = module_source(module), start = start, end = start + 1 }
		union_name = intern_name(names, "Union" + position.to_string())
		names = union_name.names
		var variants: List[ParsedVariant] = []
		for variant_position in 0..3:
			variant_name = intern_name(names, "Variant" + variant_position.to_string())
			names = variant_name.names
			variants = variants.append({ name = { id = variant_name.id, span = span }, fields = [] })
		unions = unions.append({
			module = module,
			type_name = { id = union_name.id, span = span },
			type_parameters = [],
			variants = variants,
		})
	issue_inventory(functions, records, unions)
