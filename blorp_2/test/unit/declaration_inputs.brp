import:
	../../src/utils/ids: DeclarationInventory, issue_inventory
	../../src/utils/names: intern_names, program_names
	../../src/utils/source: foundation_prelude_module_id, module_source, root_module_id
	../../src/utils/syntax:
		Visibility(Public),
		ExpressionBase(IntegerExpression),
		ParsedBody(ParsedValueBody),
		ParsedFunction,
		ParsedRecord,
		ParsedUnion,
		ParsedVariant,
		Purity(Impure),
		Span,
	int as IntOps
	string as StringOps


-- Direct syntax fixtures exercise the actual identity producer without parsing
-- or semantic checking. Every ID refers to one of these supplied declarations.
pure func sample_inventory() -> DeclarationInventory:
	var names = program_names().names
	var functions: List[ParsedFunction] = []
	var records: List[ParsedRecord] = []
	var unions: List[ParsedUnion] = []
	for position in [0, 1, 2, 3]:
		module = if IntOps.less_than(position, 2):
			root_module_id()
		else:
			foundation_prelude_module_id()
		span: Span = { source = module_source(module), start = IntOps.add(IntOps.multiply(IntOps.remainder(position, 2), 40), 10), end = IntOps.add(IntOps.multiply(IntOps.remainder(position, 2), 40), 11) }
		-- One-spelling batches: each `ids` is exactly this declaration's ID.
		function_name = intern_names(names, [StringOps.add("function", position.to_string())])
		names = function_name.names
		match function_name.ids:
			[function_id]:
				functions = functions.append({
					module = module,
					visibility = Public,
					tail_annotation = None,
					purity = Impure,
					function_name = { id = function_id, span = span },
					type_parameters = [],
					parameters = [],
					return_type = None,
					statements = [],
					body = ParsedValueBody({ base = IntegerExpression(0), base_span = span, applications = [], span = span }),
				})
			_:
				void
		record_name = intern_names(names, [StringOps.add("Record", position.to_string())])
		names = record_name.names
		match record_name.ids:
			[record_id]:
				records = records.append({
					module = module,
					visibility = Public,
					type_name = { id = record_id, span = span },
					type_parameters = [],
					fields = [],
				})
			_:
				void
	for position in [0, 1, 2, 3, 4]:
		module = if IntOps.less_than(position, 2):
			root_module_id()
		else:
			foundation_prelude_module_id()
		start = if IntOps.less_than(position, 2):
			IntOps.add(IntOps.multiply(position, 40), 30)
		else:
			IntOps.multiply(IntOps.subtract(position, 2), 40)
		span: Span = { source = module_source(module), start = start, end = IntOps.add(start, 1) }
		union_name = intern_names(names, [StringOps.add("Union", position.to_string())])
		names = union_name.names
		var variants: List[ParsedVariant] = []
		for variant_position in [0, 1, 2]:
			variant_name = intern_names(names, [StringOps.add("Variant", variant_position.to_string())])
			names = variant_name.names
			match variant_name.ids:
				[variant_id]:
					variants = variants.append({ name = { id = variant_id, span = span }, fields = [] })
				_:
					void
		match union_name.ids:
			[union_id]:
				unions = unions.append({
					module = module,
					visibility = Public,
					type_name = { id = union_id, span = span },
					type_parameters = [],
					variants = variants,
				})
			_:
				void
	issue_inventory(functions, records, unions, [], [])
