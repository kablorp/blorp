import:
    dict as D
    int: INT_MAX, INT_MIN
    bool: and
    test: TestSuite


-- Every Flat shares one hash, so only equality tells the keys apart.
record Flat { id: Int }

implements Equatable for Flat:
    pure func equals(left: Self, right: Self) -> Bool:
        left.id == right.id

implements Hashable for Flat:
    pure func hash(value: Self) -> Int:
        7

implements D.DictKey for Flat


-- The keys 0..count-1 set to ten times themselves.
private pure func counting(count: Int) -> D.Dict[Int, Int]:
    var dict: D.Dict[Int, Int] = D.empty()
    for key in 0..count:
        dict = D.set(dict, key, key * 10)
    dict


private pure func test_set_keeps_first_position_and_replaces_value() -> Bool:
    var dict: D.Dict[Int, Int] = D.empty()
    dict = D.set(dict, 5, 50)
    dict = D.set(dict, 1, 10)
    dict = D.set(dict, 9, 90)
    dict = D.set(dict, 1, 11)
    and(D.keys(dict) == [5, 1, 9], D.values(dict) == [50, 11, 90])


private pure func test_remove_then_set_goes_last() -> Bool:
    var dict = counting(4)
    dict = D.remove(dict, 1)
    first = D.keys(dict) == [0, 2, 3]
    dict = D.set(dict, 1, 99)
    and(first, and(D.keys(dict) == [0, 2, 3, 1], D.values(dict) == [0, 20, 30, 99]))


private pure func test_missing_key_reads_and_removes() -> Bool:
    dict = counting(3)
    removed = D.remove(dict, 42)
    and(and(D.get_or(dict, 42, -1) == -1, D.contains(dict, 42) == False), and(D.length(removed) == 3, D.keys(removed) == [0, 1, 2]))


private pure func test_update_leaves_earlier_copy_unchanged() -> Bool:
    original = counting(3)
    changed = D.set(D.remove(original, 0), 7, 70)
    and(and(D.keys(original) == [0, 1, 2], D.length(original) == 3), D.keys(changed) == [1, 2, 7])


private pure func test_growth_keeps_every_entry_in_order() -> Bool:
    dict = counting(300)
    var intact: Bool = D.length(dict) == 300
    for key in 0..300:
        intact = and(intact, D.get_or(dict, key, -1) == key * 10)
    and(intact, D.keys(dict).length() == 300)


private pure func test_removing_every_key_then_reusing_the_dict() -> Bool:
    var dict = counting(50)
    for key in 0..50:
        dict = D.remove(dict, key)
    emptied = and(D.length(dict) == 0, D.keys(dict).length() == 0)
    dict = D.set(dict, 7, 1)
    and(emptied, and(D.keys(dict) == [7], D.get_or(dict, 7, -1) == 1))


private pure func test_compaction_after_many_removals_keeps_survivors() -> Bool:
    var dict = counting(40)
    for key in 0..30:
        dict = D.remove(dict, key)
    var intact: Bool = D.length(dict) == 10
    for key in 30..40:
        intact = and(intact, D.get_or(dict, key, -1) == key * 10)
    and(intact, D.get_or(dict, 5, -1) == -1)


private pure func test_strides_of_1024_and_7_and_minimum_int() -> Bool:
    var dict: D.Dict[Int, Int] = D.empty()
    for i in 0..200:
        dict = D.set(dict, i * 1024, i)
    for i in 0..200:
        dict = D.set(dict, i * 7 + 1, -i)
    dict = D.set(dict, INT_MIN, 5)
    var intact: Bool = and(D.length(dict) == 401, D.get_or(dict, INT_MIN, 0) == 5)
    for i in 1..200:
        intact = and(intact, D.get_or(dict, i * 1024, -1) == i)
    intact


-- Correctness only: a lookup of an absent key ends. The cost of those lookups is
-- bounded by fixtures/dict/absent_sequential_keys.brp.
private pure func test_absent_sequential_keys_are_not_found() -> Bool:
    dict = counting(2000)
    var absent: Bool = True
    for key in 2000..4000:
        absent = and(absent, D.contains(dict, key) == False)
    absent


private pure func test_string_keys_keep_order_and_replace() -> Bool:
    var dict: D.Dict[String, Int] = D.empty()
    dict = D.set(dict, "beta", 2)
    dict = D.set(dict, "alpha", 1)
    dict = D.set(dict, "beta", 3)
    dict = D.remove(dict, "alpha")
    dict = D.set(dict, "alpha", 5)
    and(and(D.keys(dict) == ["beta", "alpha"], D.values(dict) == [3, 5]), D.get_or(dict, "absent", -1) == -1)


private pure func test_colliding_keys_are_told_apart_by_equality() -> Bool:
    var dict: D.Dict[Flat, Int] = D.empty()
    for id in 0..40:
        dict = D.set(dict, { id = id }, id * 2)
    for id in 0..20:
        dict = D.remove(dict, { id = id * 2 })
    var intact: Bool = D.length(dict) == 20
    for id in 0..40:
        expected = if id % 2 == 0:
            -1
        else:
            id * 2
        intact = and(intact, D.get_or(dict, { id = id }, -1) == expected)
    intact


-- The keys `first`..`first + count - 1` in order, each set to ten times itself.
private pure func holds_run(dict: D.Dict[Int, Int], first: Int, count: Int) -> Bool:
    var intact: Bool = and(D.length(dict) == count, D.keys(dict).length() == count)
    var index = 0
    for key in D.keys(dict):
        intact = and(intact, and(key == first + index, D.get_or(dict, key, -1) == key * 10))
        index = index + 1
    and(intact, D.values(dict).length() == count)


-- Removes the oldest of 16 entries one by one across the compaction trigger and
-- checks the survivors, in order, after every removal. A rebuild is not visible
-- through keys, values or length; where it happens is pinned by the strict
-- allocation count of fixtures/dict/compaction_boundary.brp.
private pure func test_compaction_boundary_holds_survivors_at_every_step() -> Bool:
    var dict = counting(16)
    var intact: Bool = True
    for removed in 0..12:
        dict = D.remove(dict, removed)
        intact = and(intact, holds_run(dict, removed + 1, 15 - removed))
    intact


-- Fewer dead entries than MINIMUM_COMPACTION, however few survive, keep the
-- survivors; the e2e fixture above pins that none rebuilds.
private pure func test_removals_below_the_compaction_minimum_keep_survivors() -> Bool:
    var dict = counting(8)
    for removed in 0..7:
        dict = D.remove(dict, removed)
    and(holds_run(dict, 7, 1), D.get_or(dict, 3, -1) == -1)


-- Removing the oldest key and setting a new one, many times, keeps a sliding run.
private pure func test_churn_keeps_a_sliding_run() -> Bool:
    var dict = counting(10)
    for cycle in 0..500:
        dict = D.set(D.remove(dict, cycle), cycle + 10, (cycle + 10) * 10)
    holds_run(dict, 500, 10)


-- n sets after with_capacity(n) leave the keys, values and lookups intact.
private pure func filled_after_capacity(count: Int) -> Bool:
    var dict: D.Dict[Int, Int] = D.with_capacity(count)
    for key in 0..count:
        dict = D.set(dict, key, key * 10)
    holds_run(dict, 0, count)


private pure func test_with_capacity_of_zero_and_five_then_filling() -> Bool:
    and(filled_after_capacity(0), and(filled_after_capacity(5), filled_after_capacity(40)))


-- A request beyond what fits in an index is only a hint: the Dict still works.
private pure func test_with_capacity_of_a_huge_or_negative_count_returns_a_working_dict() -> Bool:
    huge: D.Dict[Int, Int] = D.with_capacity(INT_MAX)
    negative: D.Dict[Int, Int] = D.with_capacity(INT_MIN)
    grown = D.set(D.set(huge, 3, 30), 4, 40)
    reused = D.set(negative, 1, 10)
    and(and(D.is_empty(huge), D.is_empty(negative)), and(D.keys(grown) == [3, 4], D.keys(reused) == [1]))


private pure func test_is_empty_and_entries() -> Bool:
    var dict: D.Dict[String, Int] = D.empty()
    before = D.is_empty(dict)
    dict = D.set(D.set(D.set(dict, "b", 2), "a", 1), "c", 3)
    dict = D.set(D.remove(dict, "a"), "a", 9)
    in_order = match D.entries(dict):
        [(first, one), (second, two), (third, three)]: and(and(first == "b", one == 2), and(and(second == "c", two == 3), and(third == "a", three == 9)))
        _: False
    and(and(before, D.is_empty(dict) == False), in_order)


private pure func test_bool_keys() -> Bool:
    var dict: D.Dict[Bool, String] = D.empty()
    dict = D.set(D.set(dict, True, "yes"), False, "no")
    dict = D.set(dict, True, "again")
    both: List[Bool] = [True, False]
    and(and(D.keys(dict) == both, D.get_or(dict, True, "") == "again"), D.get_or(D.remove(dict, False), False, "gone") == "gone")


private pure func test_equality_ignores_order() -> Bool:
    forward = counting(30)
    var backward: D.Dict[Int, Int] = D.empty()
    for index in 0..30:
        backward = D.set(backward, 29 - index, (29 - index) * 10)
    and(forward == backward, D.keys(forward) != D.keys(backward))


private pure func test_equality_compares_values_keys_and_lengths() -> Bool:
    base = counting(5)
    other_value = D.set(base, 3, 0)
    other_key = D.set(D.remove(base, 3), 99, 30)
    shorter = D.remove(base, 4)
    longer = D.set(base, 5, 50)
    different = or_any([other_value == base, other_key == base, shorter == base, longer == base, base != base])
    and(different == False, base == counting(5))


-- A removed-and-restored key compares like one never removed.
private pure func test_equality_ignores_removal_history() -> Bool:
    var churned = counting(20)
    for key in 0..12:
        churned = D.set(D.remove(churned, key), key, key * 10)
    churned == counting(20)


private pure func or_any(flags: List[Bool]) -> Bool:
    flags.any(pure func(flag: Bool): flag)


tests: TestSuite = {
    description = "Dict: order, removal, growth, collisions, equality and value semantics",
    tests = [
        ("set keeps the first position and replaces the value", test_set_keeps_first_position_and_replaces_value),
        ("remove then set goes last", test_remove_then_set_goes_last),
        ("a missing key reads as absent and removes nothing", test_missing_key_reads_and_removes),
        ("an update leaves an earlier copy unchanged", test_update_leaves_earlier_copy_unchanged),
        ("growth keeps every entry in order", test_growth_keeps_every_entry_in_order),
        ("removing every key then reusing the Dict", test_removing_every_key_then_reusing_the_dict),
        ("compaction after many removals keeps the survivors", test_compaction_after_many_removals_keeps_survivors),
        ("strides of 1024 and 7 and the minimum Int", test_strides_of_1024_and_7_and_minimum_int),
        ("absent sequential keys are not found", test_absent_sequential_keys_are_not_found),
        ("String keys keep order and replace", test_string_keys_keep_order_and_replace),
        ("colliding keys are told apart by equality", test_colliding_keys_are_told_apart_by_equality),
        ("the compaction boundary holds the survivors at every step", test_compaction_boundary_holds_survivors_at_every_step),
        ("removals below the compaction minimum keep the survivors", test_removals_below_the_compaction_minimum_keep_survivors),
        ("churn keeps a sliding run", test_churn_keeps_a_sliding_run),
        ("with_capacity of 0, 5 and 40 then that many sets", test_with_capacity_of_zero_and_five_then_filling),
        ("with_capacity of INT_MAX or INT_MIN returns a working Dict", test_with_capacity_of_a_huge_or_negative_count_returns_a_working_dict),
        ("is_empty and entries follow insertion order", test_is_empty_and_entries),
        ("Bool keys", test_bool_keys),
        ("equality ignores order", test_equality_ignores_order),
        ("equality compares values, keys and lengths", test_equality_compares_values_keys_and_lengths),
        ("equality ignores removal history", test_equality_ignores_removal_history),
    ]
}
