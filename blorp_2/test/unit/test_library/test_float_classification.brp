import:
    float as FloatOps
    bool: and
    test: TestSuite


private pure func classification_is(value: Float, expected_nan: Bool, expected_finite: Bool) -> Bool:
    and(FloatOps.is_nan(value) == expected_nan, FloatOps.is_finite(value) == expected_finite)


private pure func infinity() -> Float:
    FloatOps.multiply(1.0e308, 10.0)


private pure func nan() -> Float:
    value = infinity()
    FloatOps.subtract(value, value)


private pure func test_positive_zero_is_finite() -> Bool:
    classification_is(0.0, False, True)


private pure func test_negative_zero_is_finite() -> Bool:
    classification_is(-0.0, False, True)


private pure func test_positive_one_is_finite() -> Bool:
    classification_is(1.0, False, True)


private pure func test_negative_one_is_finite() -> Bool:
    classification_is(-1.0, False, True)


private pure func test_maximum_finite_value_is_finite() -> Bool:
    classification_is(1.7976931348623157e308, False, True)


private pure func test_negative_maximum_finite_value_is_finite() -> Bool:
    classification_is(-1.7976931348623157e308, False, True)


private pure func test_minimum_normal_value_is_finite() -> Bool:
    classification_is(2.2250738585072014e-308, False, True)


private pure func test_minimum_subnormal_value_is_finite() -> Bool:
    classification_is(5e-324, False, True)


private pure func test_negative_minimum_subnormal_value_is_finite() -> Bool:
    classification_is(-5e-324, False, True)


private pure func test_positive_infinity_is_neither_finite_nor_nan() -> Bool:
    classification_is(infinity(), False, False)


private pure func test_negative_infinity_is_neither_finite_nor_nan() -> Bool:
    classification_is(FloatOps.copysign(infinity(), -1.0), False, False)


private pure func test_nan_is_not_finite() -> Bool:
    classification_is(nan(), True, False)


private pure func test_sign_copied_nan_is_not_finite() -> Bool:
    classification_is(FloatOps.copysign(nan(), -1.0), True, False)


tests: TestSuite = {
    description = "Ordinary Float classification",
    tests = [
        ("positive zero is finite", test_positive_zero_is_finite),
        ("negative zero is finite", test_negative_zero_is_finite),
        ("positive one is finite", test_positive_one_is_finite),
        ("negative one is finite", test_negative_one_is_finite),
        ("maximum finite value is finite", test_maximum_finite_value_is_finite),
        ("negative maximum finite value is finite", test_negative_maximum_finite_value_is_finite),
        ("minimum normal value is finite", test_minimum_normal_value_is_finite),
        ("minimum subnormal value is finite", test_minimum_subnormal_value_is_finite),
        ("negative minimum subnormal value is finite", test_negative_minimum_subnormal_value_is_finite),
        ("positive infinity is neither finite nor NaN", test_positive_infinity_is_neither_finite_nor_nan),
        ("negative infinity is neither finite nor NaN", test_negative_infinity_is_neither_finite_nor_nan),
        ("NaN is not finite", test_nan_is_not_finite),
        ("sign-copied NaN is not finite", test_sign_copied_nan_is_not_finite),
    ]
}
