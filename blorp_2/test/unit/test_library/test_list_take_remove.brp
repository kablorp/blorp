import:
	../../../src/load/load: load_program
	../../../src/check/check: check
	../input: setup_diagnostic
	test: TestSuite


-- Actual configured target module; no duplicated implementation source.
private func admits(fixture: String) -> Bool:
	match load_program("blorp_2/test/e2e/fixtures/list/" + fixture + ".brp", "blorp_2/standard_library"):
		Err(failure):
			print_error(failure.diagnostic.message)
			False
		Ok(loaded):
			match check(loaded.program):
				Err(failure):
					print_error(setup_diagnostic(failure).message)
					False
				Ok(_): True


tests: TestSuite = {
	description = "Target ordinary List take/remove admission",
	tests = [
		("supplement fixtures admit before their phase assertions", func():
			bounds = admits("supplement/bounds")
			predicates = admits("supplement/predicates")
			managed = admits("supplement/managed")
			bounds and predicates and managed
		),
		("take named and receiver imports admit Int and extreme counts", func(): admits("take_int")),
		("remove named and receiver imports admit checked Int results", func(): admits("remove_int")),
		("take/remove admit managed records and nested List children", func(): admits("take_remove_managed")),
		("take/remove preserve the Void element type", func(): admits("take_remove_void")),
	]
}
