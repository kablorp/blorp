import:
	../../../src/load/load: load_program
	../../../src/check/check: check
	../input: setup_diagnostic
	fs: IOError, resource_path, temporary_directory
	system: temp_dir, write_file
	test: TestSuite


-- This is user code: it receives the maintained target prelude and declares
-- distinct functions with the same spellings as the explicit target Bool API.
private USER_HELPER: String =
	|pure func not(value: Bool) -> Bool:
	|    match value:
	|        True: False
	|        False: True
	|pure func and(left: Bool, right: Bool) -> Bool:
	|    match left:
	|        True: right
	|        False: False
	|pure func or(left: Bool, right: Bool) -> Bool:
	|    match left:
	|        True: True
	|        False: right
	|

private USER_CALLER: String =
	|import:
	|    ./boolean as Boolean: not, and, or
	|pure func main() -> Int:
	|    value = and(True.not(), or(Boolean.not(False), False))
	|    match value:
	|        True: 1
	|        False: 0
	|


-- The production loader parses actual target files, including prelude.brp;
-- no synthetic test foundation supplies the namespace being checked.
private func checks_fixture(fixture: String) -> Bool:
	match load_program(fixture, "blorp_2/standard_library"):
		Err(failure):
			print_error(failure.diagnostic.message)
			False
		Ok(loaded):
			match check(loaded.program):
				Err(failure):
					print_error(setup_diagnostic(failure).message)
					False
				Ok(_): True


func test_explicit_target_functions_check_with_the_actual_library() -> Bool:
	checks_fixture("blorp_2/test/e2e/fixtures/boolean_functions/main.brp")


private func write_user_modules(directory: String) -> Result[Bool, String]:
	helper ?= write_file(directory + "/boolean.brp", USER_HELPER)
	caller = directory + "/main.brp"
	main ?= write_file(caller, USER_CALLER)
	Ok(checks_fixture(caller))


private func scoped_user_modules() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-bool-"):
		match write_user_modules(directory.resource_path()):
			Ok(passed): Ok(passed)
			Err(error):
				print_error(error)
				Ok(False)


func test_user_helper_and_its_selected_functions_check_with_the_actual_prelude() -> Bool:
	match scoped_user_modules():
		Ok(passed): passed
		Err(error):
			print_error(error.to_string())
			False


tests: TestSuite = {
	description = "Explicit Bool functions under the maintained target prelude",
	tests = [
		("explicit target Bool calls check through the actual library", test_explicit_target_functions_check_with_the_actual_library),
		("a user helper and its selected Bool calls check through the actual prelude", test_user_helper_and_its_selected_functions_check_with_the_actual_prelude),
	],
}
