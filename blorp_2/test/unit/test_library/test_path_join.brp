import:
	../../../src/load/load: load_program
	../../../src/check/check: check
	../input: setup_diagnostic
	test: TestSuite


-- Load the actual target module through its configured library, then check its
-- pure caller. No host path function supplies the behavior under test.
private func checks_fixture(fixture: String) -> Bool:
	match load_program(fixture, "blorp_2/standard_library_temp"):
		Err(failure):
			print_error(failure.diagnostic.message)
			False
		Ok(loaded):
			match check(loaded.program):
				Err(failure):
					print_error(setup_diagnostic(failure).message)
					False
				Ok(_):
					True


func test_target_join_can_be_called_from_a_pure_function() -> Bool:
	checks_fixture("blorp_2/test/e2e/fixtures/path_join/arguments.brp")


func test_counted_alias_fixture_uses_the_same_pure_target_join() -> Bool:
	checks_fixture("blorp_2/test/e2e/fixtures/path_join/counted_aliases.brp")


tests: TestSuite = {
	description = "Blorp 2 target path join purity and checking",
	tests = [
		("actual target join is callable from pure source", test_target_join_can_be_called_from_a_pure_function),
		("counted alias fixture checks through actual target join", test_counted_alias_fixture_uses_the_same_pure_target_join),
	]
}
