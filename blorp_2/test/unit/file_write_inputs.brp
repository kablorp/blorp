import:
	../../src/check/check: CheckedProgram, check
	../../src/lower/lower as Lower
	../../src/namespace/builtins as Builtins
	../../src/specialize/specialize as Concrete
	../../src/utils/source: compiler_source
	../../src/utils/syntax: Diagnostic, entry_function
	./file_read_inputs: called_function
	./input: setup_diagnostic
	./module_input: TestFoundation, parse_modules_with_base
	option: to_result


FILE_WRITE_SOURCE: String =
	|func query(path: String, contents: String) -> Result[Void, String]:
	|    builtin("system.write_file")
	|func escape(path: String) -> String:
	|    match query(path, path):
	|        Ok(done): "written"
	|        Err(error): error
	|func main() -> Int:
	|    unused = query("input", "contents")
	|    escaped = escape("input")
	|    0
	|


fixed record FileWriteSeed {
	lowered: Lower.LoweredProgram,
	query: Lower.LoweredFunction,
	escape: Concrete.FunctionInstanceId,
	constructors: Builtins.DesignatedResult[Concrete.VariantInstanceId]
}


pure func checked_file_write(foundation: TestFoundation) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules_with_base([{ source = FILE_WRITE_SOURCE, targets = [] }], foundation)
	check(parsed).map_err(setup_diagnostic)


pure func file_write_seed(foundation: TestFoundation) -> Result[FileWriteSeed, Diagnostic]:
	file_write_seed_from_source(FILE_WRITE_SOURCE, foundation)


pure func file_write_seed_from_source(source: String, foundation: TestFoundation) -> Result[FileWriteSeed, Diagnostic]:
	parsed ?= parse_modules_with_base([{ source = source, targets = [] }], foundation)
	checked ?= check(parsed).map_err(setup_diagnostic)
	concrete ?= Concrete.specialize(checked)
	lowered ?= Lower.lower(concrete)
	contents = Lower.lowered_functions(lowered)
	missing: Diagnostic = { span = { source = compiler_source(), start = 0, end = 0 }, message = "invalid file-write seed", help = "retain query and escape calls in main", note = None }
	main ?= contents.functions.get(Concrete.function_number(entry_function(contents.entrypoint))).to_result(missing)
	match main.steps.filter(pure func(definition): called_function(definition).is_ok()):
		[query_call, escape_call, ...remaining]:
			query_id ?= called_function(query_call)
			escape_id ?= called_function(escape_call)
			query ?= contents.functions.get(Concrete.function_number(query_id)).to_result(missing)
			match query.steps:
				[Lower.Define(_), Lower.Define(_), Lower.Define(result)]:
					match result.operation:
						Lower.CallValue(call, [_, _]):
							match call.target:
								Concrete.RuntimeFunction(Builtins.WriteFile(constructors)):
									Ok({ lowered = lowered, query = query, escape = escape_id, constructors = constructors })
								_: Err(missing)
						_: Err(missing)
				_: Err(missing)
		_: Err(missing)
