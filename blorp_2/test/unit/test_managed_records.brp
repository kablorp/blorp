import:
	../../src/lex: lex
	../../src/lower as Lower
	../../src/own as Own
	../../src/source: module_source, root_module_id
	../../src/specialize as Concrete
	../../src/syntax: Diagnostic, FunctionExecution(OrdinaryCalls), Span
	../../src/verify: verify
	input: check, parse, setup_diagnostic
	test: TestSuite


private PAIR: String =
	|fixed record Pair { left: String, right: String }
	|pure func make() -> Pair:
	|	text = "42"
	|	{ left = text, right = text }
	|


private pure func lowered(source: String) -> Result[Lower.LoweredFunctions, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source)
	parsed ?= parse(tokens)
	checked ?= check(parsed).map_err(setup_diagnostic)
	program ?= Concrete
		.specialize(checked)
		.and_then(pure func(program): Lower.lower(program))
	Ok(Lower.lowered_functions(program))


pure func test_each_stored_occurrence_acquires_a_distinct_owner() -> Bool:
	match lowered(PAIR + "func main() -> Int:\n\tunused = make()\n\t0\n"):
		Ok(program):
			match program.functions:
				[_, make]:
					match Own.insert_function(make, program.unions, program.records):
						Ok(owned):
							match owned.operations:
								[Own.DefineValue(text), Own.AcquireOwner(left, left_borrow, _), Own.AcquireOwner(right, right_borrow, _), Own.DefineValue(aggregate), Own.DropOwner(original, _)]:
									match aggregate.operation:
										Own.ConstructRecordDefinition(_, [first, second]):
											match (
												first.value,
												second.value,
												aggregate.result,
												owned.tail,
											):
												(Own.OwnedPayload(first_value, first_owner), Own.OwnedPayload(second_value, second_owner), Own.OwnedResult(root), Own.ReturnTail(Own.ReturnResult(Own.OwnedReturn(result, returned)))):
													(
														Lower.value_number(
															first_value,
														) == Lower.value_number(text.id)
														and Lower.value_number(
															second_value,
														) == Lower.value_number(text.id)
														and Own.owner_number(original) == 0
														and Own.owner_number(left) == 1
														and Own.owner_number(right) == 2
														and Own.owner_number(first_owner) == 1
														and Own.owner_number(second_owner) == 2
														and Own.owner_number(root) == 3
														and Own.owner_number(returned) == 3
														and Lower.value_number(
															result,
														) == Lower.value_number(aggregate.id)
														and Lower.value_number(
															left_borrow.value,
														) == Lower.value_number(right_borrow.value)
													)
												_:
													False
										_:
											False
								_:
									False
						Err(_):
							False
				_:
					False
		Err(_):
			False


pure func test_unused_projection_acquires_before_parent_drop_and_drops_itself() -> Bool:
	match lowered(PAIR + "func main() -> Int:\n\tunused = make().left\n\t0\n"):
		Ok(program):
			match program.functions:
				[main_function, _]:
					match Own.insert_function(main_function, program.unions, program.records):
						Ok(owned):
							match owned.operations:
								[Own.DefineValue(parent), Own.DefineValue(child), Own.AcquireOwner(acquired, borrowed, _), Own.DropOwner(parent_owner, _), Own.DropOwner(child_owner, _), Own.DefineValue(_)]:
									match (child.result, borrowed.source):
										(Own.BorrowedResult(Own.PayloadBorrow(source)), Own.PayloadBorrow(acquire_parent)):
											(
												Lower.value_number(
													source,
												) == Lower.value_number(parent.id)
												and Lower.value_number(
													acquire_parent,
												) == Lower.value_number(parent.id)
												and Lower.value_number(
													borrowed.value,
												) == Lower.value_number(child.id)
												and Own.owner_number(acquired) == 1
												and Own.owner_number(parent_owner) == 0
												and Own.owner_number(child_owner) == 1
											)
										_:
											False
								_:
									False
						Err(_):
							False
				_:
					False
		Err(_):
			False


pure func test_nested_numeric_projection_uses_acquired_parent_owner() -> Bool:
	source: String =
		|fixed record Inner { number: Int, text: String }
		|fixed record Outer { inner: Inner }
		|pure func inner() -> Inner:
		|	{ number = 7, text = "42" }
		|pure func outer() -> Outer:
		|	{ inner = inner() }
		|func main() -> Int:
		|	outer().inner.number
		|

	match lowered(source):
		Ok(program):
			match program.functions:
				[main_function, _, _]:
					match Own.insert_function(main_function, program.unions, program.records):
						Ok(owned):
							match owned.operations:
								[Own.DefineValue(_), Own.DefineValue(child), Own.AcquireOwner(_, _, _), Own.DropOwner(_, _), Own.DefineValue(number), Own.DropOwner(parent_owner, _)]:
									match number.operation:
										Own.ReadRecordFieldDefinition(_, Own.BorrowedArgument(parent)):
											match parent.source:
												Own.OwnerBorrow(owner):
													(
														Lower.value_number(
															parent.value,
														) == Lower.value_number(child.id)
														and Own.owner_number(owner) == 1
														and Own.owner_number(parent_owner) == 1
													)
												_:
													False
										_:
											False
								_:
									False
						Err(_):
							False
				_:
					False
		Err(_):
			False


private fixed record RawRecord {
	program: Own.OwnershipProgram,
	first: Lower.ValueId,
	parent: Lower.ValueId,
	child: Lower.ValueId,
	field: Concrete.FieldInstanceId,
	aggregate: Concrete.RecordInstanceId,
	span: Span
}


-- The parser/lowerer only supplies sealed identities. Ownership operations and
-- their expected invariants below are constructed independently of insertion.
private pure func raw_record() -> Result[RawRecord, Diagnostic]:
	seed ?= lowered(PAIR + "func main() -> Int:\n\tunused = make().left\n\t0\n")

	match seed.functions:
		[main_function, make]:
			match (main_function.definitions, make.definitions):
				([first, parent, child], [_, constructed]):
					match constructed.operation:
						Lower.ConstructRecordValue(aggregate, [left, right]):
							span = first.span
							text = Own.DefineValue({
								id = first.id,
								value_type = Concrete.StringType,
								operation = Own.StringDefinition("42"),
								result = Own.OwnedResult(Own.owner_id(0)),
								span = span,
							})
							borrow = {
								value = first.id,
								source = Own.OwnerBorrow(Own.owner_id(0))
							}
							operations = [
								text,
								Own.AcquireOwner(
									Own.owner_id(1),
									borrow,
									span,
								),
								Own.AcquireOwner(
									Own.owner_id(2),
									borrow,
									span,
								),
								Own.DefineValue({
									id = parent.id,
									value_type = Concrete.RecordType(aggregate),
									operation = Own.ConstructRecordDefinition(
										aggregate,
										[
											{
												field = left.field,
												value = Own.OwnedPayload(
													first.id,
													Own.owner_id(1),
												)
											},
											{
												field = right.field,
												value = Own.OwnedPayload(
													first.id,
													Own.owner_id(2),
												)
											},
										],
									),
									result = Own.OwnedResult(Own.owner_id(3)),
									span = span,
								}),
								Own.DropOwner(
									Own.owner_id(0),
									span,
								),
								Own.DefineValue({
									id = child.id,
									value_type = Concrete.StringType,
									operation = Own.ReadRecordFieldDefinition(
										left.field,
										Own.BorrowedArgument({
											value = parent.id,
											source = Own.OwnerBorrow(Own.owner_id(3)),
										}),
									),
									result = Own.BorrowedResult(Own.PayloadBorrow(parent.id)),
									span = span,
								}),
								Own.AcquireOwner(
									Own.owner_id(4),
									{
										value = child.id,
										source = Own.PayloadBorrow(parent.id)
									},
									span,
								),
								Own.DropOwner(
									Own.owner_id(3),
									span,
								),
							]
							main: Own.OwnedFunction = {
								execution = OrdinaryCalls,
								signature = {
									parameters = [],
									return_type = Concrete.IntType
								},
								operations = [Own.DefineValue({
										id = first.id,
										value_type = Concrete.IntType,
										operation = Own.IntegerDefinition(0),
										result = Own.UnmanagedResult,
										span = span,
									})],
								tail = Own.ReturnTail(
									Own.ReturnResult(Own.UnmanagedReturn(first.id)),
								)
							}
							helper: Own.OwnedFunction = {
								execution = OrdinaryCalls,
								signature = {
									parameters = [],
									return_type = Concrete.StringType
								},
								operations = operations,
								tail = Own.ReturnTail(
									Own.ReturnResult(Own.OwnedReturn(child.id, Own.owner_id(4))),
								)
							}
							Ok({
								program = {
									records = seed.records,
									unions = seed.unions,
									functions = [main, helper],
									entrypoint = seed.entrypoint
								},
								first = first.id,
								parent = parent.id,
								child = child.id,
								field = left.field,
								aggregate = aggregate,
								span = span,
							})
						_:
							Err({
								span = first.span,
								note = None,
								message = "aggregate seed shape",
								help = "fix test seed",
							})
				_:
					Err({
						span = {
							source = module_source(root_module_id()),
							start = 0,
							end = 0
						},
						note = None,
						message = "aggregate seed definitions",
						help = "fix test seed",
					})
		_:
			Err({
				span = {
					source = module_source(root_module_id()),
					start = 0,
					end = 0
				},
				note = None,
				message = "aggregate seed functions",
				help = "fix test seed",
			})


private pure func verify_mutated(
	change: pure (RawRecord, Own.OwnedFunction) -> Own.OwnedFunction,
	message: String,
) -> Bool:
	match raw_record():
		Ok(raw):
			match raw.program.functions:
				[main, helper]:
					match (
						verify(
							{ raw.program | functions = [main, change(raw, helper)] },
						)
					):
						Err(error):
							error.message == "ownership verification failed: " + message
						Ok(_):
							False
				_:
					False
		Err(_):
			False


pure func test_raw_verifier_accepts_independent_projected_escape() -> Bool:
	match raw_record():
		Ok(raw):
			verify(raw.program).is_ok()
		Err(_):
			False


pure func test_raw_verifier_rejects_duplicate_slot_transfer() -> Bool:
	verify_mutated(pure func(raw, helper):
		operations = helper.operations.map(pure func(operation):
			match operation:
				Own.DefineValue(definition):
					match definition.operation:
						Own.ConstructRecordDefinition(owner, [left, right]):
							Own.DefineValue(
								{ definition | operation = Own.ConstructRecordDefinition(
										owner,
										[left, { right | value = Own.OwnedPayload(
													raw.first,
													Own.owner_id(1),
												) }],
									) },
							)
						_:
							operation
				_:
					operation
		)
		{ helper | operations = operations }
	, "payload owner has already been discharged")


pure func test_raw_verifier_rejects_early_parent_drop() -> Bool:
	verify_mutated(pure func(_, helper):
		match helper.operations:
			[text, left, right, parent, original_drop, child, acquired, parent_drop]:
				{ helper |
					operations = [
						text,
						left,
						right,
						parent,
						original_drop,
						child,
						parent_drop,
						acquired,
					]
				}
			_:
				helper
	, "borrow refers to discharged owner 3")


pure func test_raw_verifier_rejects_projection_acquire_before_definition() -> Bool:
	verify_mutated(pure func(_, helper):
		match helper.operations:
			[text, left, right, parent, original_drop, child, acquired, parent_drop]:
				{ helper |
					operations = [
						text,
						left,
						right,
						parent,
						original_drop,
						acquired,
						child,
						parent_drop,
					]
				}
			_:
				helper
	, "value 2 is not defined before use")


pure func test_raw_verifier_rejects_leaked_record_root() -> Bool:
	verify_mutated(pure func(_, helper):
		operations = helper.operations.filter(pure func(operation):
			match operation:
				Own.DropOwner(owner, _):
					Own.owner_number(owner) != 3
				_:
					True
		)
		{ helper | operations = operations }
	, "owner 3 remains live at return")


pure func test_raw_verifier_rejects_wrong_projection_parent() -> Bool:
	verify_mutated(pure func(raw, helper):
		operations = helper.operations.map(pure func(operation):
			match operation:
				Own.DefineValue(definition):
					match definition.operation:
						Own.ReadRecordFieldDefinition(_, _):
							Own.DefineValue(
								{ definition |
									result = Own.BorrowedResult(Own.PayloadBorrow(raw.first))
								},
							)
						_:
							operation
				_:
					operation
		)
		{ helper | operations = operations }
	, "payload borrow has the wrong parent value")


pure func test_raw_verifier_rejects_unmanaged_slot_for_managed_child() -> Bool:
	verify_mutated(pure func(raw, helper):
		operations = helper.operations.map(pure func(operation):
			match operation:
				Own.DefineValue(definition):
					match definition.operation:
						Own.ConstructRecordDefinition(owner, [left, right]):
							Own.DefineValue(
								{ definition | operation = Own.ConstructRecordDefinition(
										owner,
										[{ left | value = Own.UnmanagedPayload(raw.first) }, right],
									) },
							)
						_:
							operation
				_:
					operation
		)
		{ helper | operations = operations }
	, "managed payload requires an owner transfer")


private pure func numeric_parent_is_live(drop_before_read: Bool) -> Bool:
	source: String =
		|fixed record Inner { number: Int, text: String }
		|fixed record Outer { inner: Inner }
		|pure func read(value: Outer) -> Int:
		|	value.inner.number
		|pure func inner() -> Inner:
		|	{ number = 7, text = "42" }
		|pure func outer() -> Outer:
		|	{ inner = inner() }
		|func main() -> Int:
		|	read(outer())
		|

	match lowered(source):
		Ok(seed):
			match seed.functions:
				[main_seed, outer_seed, read_seed, inner_seed]:
					match read_seed.definitions:
						[parent, child, number]:
							match (
								parent.value_type,
								child.value_type,
								child.operation,
								number.operation,
							):
								(Concrete.RecordType(outer), Concrete.RecordType(inner), Lower.ReadRecordFieldValue(inner_field, _), Lower.ReadRecordFieldValue(number_field, _)):
									span = parent.span
									parameter = Own.DefineValue({
										id = parent.id,
										value_type = Concrete.RecordType(outer),
										operation = Own.ParameterDefinition(0),
										result = Own.BorrowedResult(Own.ParameterBorrow(parent.id)),
										span = span,
									})
									projected = Own.DefineValue({
										id = child.id,
										value_type = Concrete.RecordType(inner),
										operation = Own.ReadRecordFieldDefinition(
											inner_field,
											Own.BorrowedArgument({
												value = parent.id,
												source = Own.ParameterBorrow(parent.id),
											}),
										),
										result = Own.BorrowedResult(Own.PayloadBorrow(parent.id)),
										span = span,
									})
									acquired = Own.AcquireOwner(
										Own.owner_id(0),
										{
											value = child.id,
											source = Own.PayloadBorrow(parent.id)
										},
										span,
									)
									dropped = Own.DropOwner(
										Own.owner_id(0),
										span,
									)
									copied = Own.DefineValue({
										id = number.id,
										value_type = Concrete.IntType,
										operation = Own.ReadRecordFieldDefinition(
											number_field,
											Own.BorrowedArgument({
												value = child.id,
												source = Own.OwnerBorrow(Own.owner_id(0)),
											}),
										),
										result = Own.UnmanagedResult,
										span = span,
									})

									operations = if drop_before_read:
										[parameter, projected, acquired, dropped, copied]
									else:
										[parameter, projected, acquired, copied, dropped]

									helper: Own.OwnedFunction = {
										execution = OrdinaryCalls,
										signature = read_seed.signature,
										operations = operations,
										tail = Own.ReturnTail(
											Own.ReturnResult(Own.UnmanagedReturn(number.id)),
										)
									}
									main: Own.OwnedFunction = {
										execution = OrdinaryCalls,
										signature = main_seed.signature,
										operations = [Own.DefineValue({
												id = parent.id,
												value_type = Concrete.IntType,
												operation = Own.IntegerDefinition(0),
												result = Own.UnmanagedResult,
												span = span,
											})],
										tail = Own.ReturnTail(
											Own.ReturnResult(Own.UnmanagedReturn(parent.id)),
										)
									}

									match (
										verify({
											records = seed.records,
											unions = seed.unions,
											functions = [main, helper],
											entrypoint = seed.entrypoint,
										})
									):
										Ok(_):
											not drop_before_read
										Err(error):
											(
												drop_before_read
												and error.message == "ownership verification failed: borrow refers to discharged owner 0"
											)
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_raw_numeric_projection_accepts_acquired_backing() -> Bool:
	numeric_parent_is_live(False)


pure func test_raw_numeric_projection_rejects_dropped_backing() -> Bool:
	numeric_parent_is_live(True)


pure func test_projected_call_uses_child_owner_after_parent_drop() -> Bool:
	source: String =
		|pure func length(value: String) -> Int:
		|	builtin("string.length")
		|func main() -> Int:
		|	make().left.length()
		|

	match lowered(PAIR + source):
		Ok(program):
			match program.functions:
				[main_function, _, _]:
					match Own.insert_function(main_function, program.unions, program.records):
						Ok(owned):
							match owned.operations:
								[Own.DefineValue(_), Own.DefineValue(child), Own.AcquireOwner(_, _, _), Own.DropOwner(parent, _), Own.DefineValue(called), Own.DropOwner(acquired, _)]:
									match called.operation:
										Own.CallDefinition(_, [Own.BorrowedArgument(argument)]):
											match argument.source:
												Own.OwnerBorrow(owner):
													(
														Lower.value_number(
															argument.value,
														) == Lower.value_number(child.id)
														and Own.owner_number(parent) == 0
														and Own.owner_number(owner) == 1
														and Own.owner_number(acquired) == 1
													)
												_:
													False
										_:
											False
								_:
									False
						Err(_):
							False
				_:
					False
		Err(_):
			False


pure func test_raw_verifier_rejects_double_record_drop() -> Bool:
	verify_mutated(pure func(raw, helper):
		{ helper | operations = helper.operations.append(Own.DropOwner(Own.owner_id(3), raw.span)) }
	, "owner 3 has already been discharged")


pure func test_raw_verifier_rejects_borrowed_child_escape() -> Bool:
	verify_mutated(pure func(raw, helper):
		{ helper | tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(raw.child))) }
	, "managed return requires an owner transfer")


pure func test_raw_verifier_rejects_dropped_child_return() -> Bool:
	verify_mutated(pure func(raw, helper):
		{ helper | operations = helper.operations.append(Own.DropOwner(Own.owner_id(4), raw.span)) }
	, "return refers to discharged owner 4")


pure func test_raw_verifier_rejects_recursive_record_layout() -> Bool:
	match raw_record():
		Ok(raw):
			cycle = {
				fields = [Concrete.RecordType(raw.aggregate)],
				representation = Concrete.ManagedRecord
			}

			match verify({ raw.program | records = [cycle] }):
				Err(error):
					error.message == "ownership verification failed: recursive aggregate layout is unsupported"
				Ok(_):
					False
		Err(_):
			False


pure func test_raw_verifier_rejects_record_union_layout_cycle() -> Bool:
	source: String =
		|fixed union Box[T]:
		|	Full(T)
		|pure func boxed() -> Box[Pair]:
		|	Full(make())
		|func main() -> Int:
		|	unused = boxed()
		|	0
		|

	match lowered(PAIR + source):
		Ok(seed):
			match seed.functions:
				[main_seed, boxed, make]:
					match (
						boxed.signature.return_type,
						make.signature.return_type,
						main_seed.definitions,
					):
						(Concrete.UnionType(union_id), Concrete.RecordType(record_id), [first, _]):
							cycle = {
								fields = [Concrete.UnionType(union_id)],
								representation = Concrete.ManagedRecord
							}
							union_layout = {
								variants = [[Concrete.RecordType(record_id)]],
								representation = Concrete.InlineOwningPayload
							}
							main: Own.OwnedFunction = {
								execution = OrdinaryCalls,
								signature = main_seed.signature,
								operations = [Own.DefineValue({
										id = first.id,
										value_type = Concrete.IntType,
										operation = Own.IntegerDefinition(0),
										result = Own.UnmanagedResult,
										span = first.span,
									})],
								tail = Own.ReturnTail(
									Own.ReturnResult(Own.UnmanagedReturn(first.id)),
								)
							}

							match verify({
								records = [cycle],
								unions = [union_layout],
								functions = [main],
								entrypoint = seed.entrypoint,
							}):
								Err(error):
									error.message == "ownership verification failed: recursive aggregate layout is unsupported"
								Ok(_):
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_void_record_has_a_root_obligation_without_child_obligations() -> Bool:
	source: String =
		|fixed record Unit { empty: Void }
		|pure func identity(value: Unit) -> Unit:
		|	value
		|func main() -> Int:
		|	unused = identity({ empty = void })
		|	0
		|

	match lowered(source):
		Ok(seed):
			match seed.functions:
				[main_seed, identity]:
					match identity.signature.return_type:
						Concrete.RecordType(record_id):
							match Concrete.value_ownership(
								identity.signature.return_type,
								seed.unions,
								seed.records,
							):
								Ok(Concrete.ManagedRecordRoot(root)):
									match Own.insert_function(main_seed, seed.unions, seed.records):
										Ok(owned):
											match owned.operations:
												[Own.DefineValue(_), Own.DefineValue(constructed), Own.DefineValue(_), Own.DropOwner(_, _), Own.DropOwner(_, _), Own.DefineValue(_)]:
													match constructed.operation:
														Own.ConstructRecordDefinition(_, [field]):
															match field.value:
																Own.UnmanagedPayload(_):
																	Concrete.record_number(
																		root,
																	) == Concrete.record_number(
																		record_id,
																	)
																_:
																	False
														_:
															False
												_:
													False
										Err(_):
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Managed aggregate ownership boundaries",
	tests = [
		("raw cross record union cycle", test_raw_verifier_rejects_record_union_layout_cycle),
