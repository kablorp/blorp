			test_projected_call_uses_child_owner_after_parent_drop,
		),
		("raw record double drop", test_raw_verifier_rejects_double_record_drop),
		("raw borrowed child escape", test_raw_verifier_rejects_borrowed_child_escape),
		("raw dropped child return", test_raw_verifier_rejects_dropped_child_return),
		("raw cyclic layout", test_raw_verifier_rejects_recursive_record_layout),
		(
			"raw numeric read accepts acquired parent",
			test_raw_numeric_projection_accepts_acquired_backing,
		),
		(
			"raw numeric read rejects dropped parent",
			test_raw_numeric_projection_rejects_dropped_backing,
		),
		(
			"each stored occurrence acquires a distinct owner",
			test_each_stored_occurrence_acquires_a_distinct_owner,
		),
		(
			"unused projection acquires then drops after its parent",
			test_unused_projection_acquires_before_parent_drop_and_drops_itself,
		),
		(
			"numeric projection uses acquired nested owner",
			test_nested_numeric_projection_uses_acquired_parent_owner,
		),
		("raw projected escape", test_raw_verifier_accepts_independent_projected_escape),
		("raw duplicate slot transfer", test_raw_verifier_rejects_duplicate_slot_transfer),
		("raw early parent drop", test_raw_verifier_rejects_early_parent_drop),
		(
			"raw acquire before child definition",
			test_raw_verifier_rejects_projection_acquire_before_definition,
		),
		("raw leaked aggregate root", test_raw_verifier_rejects_leaked_record_root),
		("raw wrong projection parent", test_raw_verifier_rejects_wrong_projection_parent),
		(
