import:
	../../../src/runtime/memory: MEMORY_RUNTIME
	../../../src/emit/emit: emit
	../../../src/lower/lower as Lower
	../../../src/own/own as Owned
	../../../src/namespace/builtins as Builtins: RuntimeOperation(IntToString)
	../../../src/specialize/specialize as Concrete
	../../../src/runtime/string: string_runtime
	../../../src/utils/syntax:
		Diagnostic,
		Entrypoint(NoArguments), EntryResult(IntegerExitStatus),
		FunctionExecution(OrdinaryCalls),
		entry_function,
	../../../src/utils/text: concat
	../../../src/verify/verify: verify
	../managed_union_inputs: lowered, lowered_modules
	../module_input: INTEGER_OPERATIONS, STRING_OPERATIONS
	option: to_result
	../ownership_inputs: InputIds, input_ids, span
	result: get_or
	system: read_file
	test: TestSuite


private BOX_SEED: String =
	|fixed union Box[T]:
	|    Box(T)
	|pure func inspect(value: Box[Int]) -> Int:
	|    match value:
	|        Box(item): item
	|func main() -> Int:
	|    unused = inspect(Box(0))
	|    0
	|

private CHOICE_SEED: String =
	|fixed union Choice[T]:
	|    Left(T)
	|    Right(T)
	|pure func inspect(value: Choice[Int]) -> Int:
	|    match value:
	|        Left(item): item
	|        Right(item): item
	|func main() -> Int:
	|    unused = inspect(Left(0))
	|    0
	|

private MIXED_SEED: String =
	|fixed union Mixed[T]:
	|    Text(T)
	|    Empty
	|    Number(Int)
	|pure func inspect(value: Mixed[Int]) -> Int:
	|    match value:
	|        Text(item): item
	|        Empty: 0
	|        Number(item): item
	|func main() -> Int:
	|    unused = inspect(Text(0))
	|    0
	|

private NESTED_SEED: String =
	|fixed union Box[T]:
	|    Box(T)
	|pure func inner(value: Box[Int]) -> Int:
	|    match value:
	|        Box(item): item
	|pure func outer(value: Box[Box[Int]]) -> Box[Int]:
	|    match value:
	|        Box(item): item
	|func main() -> Int:
	|    unused = inner(Box(0))
	|    nested = outer(Box(Box(0)))
	|    0
	|

-- These are independent complete C oracles. No emitter naming or storage
-- helper builds expected text. Only the separately tested runtime prefix is
-- reused; equality includes every declaration, helper, function and entrypoint.
private MAIN_DECL: String = "int64_t blorp_f_0(void);"


private pure func expected_main_body() -> String:
	"int64_t blorp_f_0(void){const int64_t "
		.concat("blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return ")
		.concat("blorp_vl_0;}")


private ENTRYPOINT: String = "int main(void){blorp_memory_start();return blorp_memory_finish((int)blorp_f_0());}\n"


private pure func expected_box_c() -> String:
	"enum blorp_tag_0{blorp_v_0_0};struct blorp_u_0{enum "
		.concat("blorp_tag_0 tag;union{struct{struct blorp_string* blorp_uf_0;} blorp_up_0;}")
		.concat("payload;};")
		.concat(
			"void blorp_union_dup_0(struct blorp_u_0 value){"
				.concat("switch(value.tag){case blorp_v_0_0:")
				.concat("blorp_string_retain(value.payload.blorp_up_0.blorp_uf_0);break;}}"),
		)
		.concat(
			"void blorp_union_drop_0(struct blorp_u_0 value){"
				.concat("switch(value.tag){case blorp_v_0_0:blorp_string_release(")
				.concat("value.payload.blorp_up_0.blorp_uf_0);break;}}"),
		)


private pure func expected_choice_c() -> String:
	"enum blorp_tag_0{blorp_v_0_0,blorp_v_0_1};struct "
		.concat("blorp_u_0{enum blorp_tag_0 tag;union{struct{struct ")
		.concat("blorp_string* blorp_uf_0;} blorp_up_0;struct{struct blorp_string* ")
		.concat("blorp_uf_0;} blorp_up_1;}payload;};")
		.concat(
			"void blorp_union_dup_0(struct blorp_u_0 value){"
				.concat("switch(value.tag){case blorp_v_0_0:")
				.concat("blorp_string_retain(value.payload.blorp_up_0.blorp_uf_0);break;")
				.concat("case blorp_v_0_1:")
				.concat("blorp_string_retain(value.payload.blorp_up_1.blorp_uf_0);break;}}"),
		)
		.concat(
			"void blorp_union_drop_0(struct blorp_u_0 value){"
				.concat("switch(value.tag){case blorp_v_0_0:blorp_string_release(")
				.concat("value.payload.blorp_up_0.blorp_uf_0);break;case ")
				.concat("blorp_v_0_1:")
				.concat("blorp_string_release(value.payload.blorp_up_1.blorp_uf_0);break;}}"),
		)


private pure func expected_mixed_c() -> String:
	"enum blorp_tag_0{blorp_v_0_0,blorp_v_0_1,blorp_v_0_2};"
		.concat("struct blorp_u_0{enum blorp_tag_0 tag;union{struct{struct ")
		.concat("blorp_string* blorp_uf_0;} blorp_up_0;struct{int64_t blorp_uf_0;} blorp_up_2;}payload;};")
		.concat(
			"void blorp_union_dup_0(struct blorp_u_0 value){"
				.concat("switch(value.tag){case blorp_v_0_0:")
				.concat("blorp_string_retain(value.payload.blorp_up_0.blorp_uf_0);break;")
				.concat("case blorp_v_0_1:break;")
				.concat("case blorp_v_0_2:break;}}"),
		)
		.concat(
			"void blorp_union_drop_0(struct blorp_u_0 value){"
				.concat("switch(value.tag){case blorp_v_0_0:blorp_string_release(")
				.concat("value.payload.blorp_up_0.blorp_uf_0);break;case blorp_v_0_1:break;")
				.concat("case blorp_v_0_2:break;}}"),
		)


private pure func expected_outer_c() -> String:
	"enum blorp_tag_1{blorp_v_1_0};struct blorp_u_1{enum "
		.concat("blorp_tag_1 tag;union{struct{struct blorp_u_0 blorp_uf_0;} blorp_up_0;}")
		.concat("payload;};")
		.concat(
			"void blorp_union_dup_1(struct blorp_u_1 value){"
				.concat("switch(value.tag){case blorp_v_1_0:")
				.concat("blorp_union_dup_0(value.payload.blorp_up_0.blorp_uf_0);break;}}"),
		)
		.concat(
			"void blorp_union_drop_1(struct blorp_u_1 value){"
				.concat("switch(value.tag){case blorp_v_1_0:")
				.concat("blorp_union_drop_0(value.payload.blorp_up_0.blorp_uf_0);break;}}"),
		)


private fixed record EmitIds {
	values: InputIds,
	owner: Concrete.UnionInstanceId,
	variants: List[Concrete.VariantInstanceId]
}


private pure func seed_error() -> Diagnostic:
	{
		span = span(0),
		note = None,
		message = "missing managed union emission identity seed",
		help = "fix the emission test seed"
	}


-- Lowering mints opaque identities only. Every tested layout and ownership
-- operation below is supplied directly; own() never supplies an expected fact.
private pure func seed(source: String, function_index: Int) -> Result[EmitIds, Diagnostic]:
	ids ?= input_ids()
	input ?= lowered(source)
	function ?= Lower.lowered_functions(input).functions
		.get(function_index + 1)
		.to_result(seed_error())

	match function.tail:
		Lower.MatchValue(matched):
			var variants: List[Concrete.VariantInstanceId] = []

			for arm in matched.arms:
				match arm.label:
					Lower.VariantLabel(id):
						variants = variants.append(id)
					Lower.DefaultLabel:
						void

			Ok({
				values = ids,
				owner = matched.owner,
				variants = variants,
			})
		_:
			Err(seed_error())


private pure func boxed_layout() -> Concrete.ConcreteUnion:
	{
		variants = [[Concrete.StringType]],
		representation = Concrete.InlineOwningPayload
	}


private pure func mixed_layout() -> Concrete.ConcreteUnion:
	{
		variants = [[Concrete.StringType], [], [Concrete.IntType]],
		representation = Concrete.InlineOwningPayload
	}


private pure func definition(
	id: Lower.ValueId,
	value_type: Concrete.TypeRef,
	operation: Owned.OwnedValueOperation,
	result: Owned.ResultOwnership,
) -> Owned.OwnershipOperation:
	Owned.DefineValue({
		id = id,
		value_type = value_type,
		operation = operation,
		result = result,
		span = span(10),
	})


private pure func integer(id: Lower.ValueId, number: Int) -> Owned.OwnershipOperation:
	definition(
		id,
		Concrete.IntType,
		Owned.IntegerDefinition(number),
		Owned.UnmanagedResult,
	)


private pure func parameter(
	id: Lower.ValueId,
	value_type: Concrete.TypeRef,
) -> Owned.OwnershipOperation:
	definition(
		id,
		value_type,
		Owned.ParameterDefinition(0),
		Owned.BorrowedResult(Owned.ParameterBorrow(id)),
	)


private pure func acquire(
	owner: Int,
	id: Lower.ValueId,
	source: Owned.BorrowSource,
) -> Owned.OwnershipOperation:
	Owned.AcquireOwner(
		Owned.owner_id(owner),
		{
			value = id,
			source = source
		},
		span(20),
	)


private pure func string(id: Lower.ValueId, argument: Lower.ValueId) -> Owned.OwnershipOperation:
	definition(
		id,
		Concrete.StringType,
		Owned.CallDefinition(
			Concrete.RuntimeFunction(Builtins.IntToString),
			[Owned.UnmanagedArgument(argument)],
		),
		Owned.OwnedResult(Owned.owner_id(0)),
	)


private pure func function(
	parameters: List[Concrete.TypeRef],
	return_type: Concrete.TypeRef,
	operations: List[Owned.OwnershipOperation],
	tail: Owned.OwnedTail,
) -> Owned.OwnedFunction:
	{
		execution = OrdinaryCalls,
		signature = {
			parameters = parameters,
			return_type = return_type
		},
		operations = operations,
		tail = tail
	}


private pure func main_function(ids: InputIds) -> Owned.OwnedFunction:
	function(
		[],
		Concrete.IntType,
		[integer(ids.first, 0)],
		Owned.ReturnTail(Owned.ReturnResult(Owned.UnmanagedReturn(ids.first))),
	)


private pure func returned(id: Lower.ValueId, owner: Int) -> Owned.OwnedTail:
	Owned.ReturnTail(Owned.ReturnResult(Owned.OwnedReturn(id, Owned.owner_id(owner))))


private pure func exact(
	ids: InputIds,
	layouts: List[Concrete.ConcreteUnion],
	functions: List[Owned.OwnedFunction],
	prefix: String,
	expected: String,
) -> Bool:
	input: Owned.OwnershipProgram = {
		records = [],
		unions = layouts,
		functions = functions,
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus)
	}
	verify(input)
		.and_then(emit)
		.get_or("") == MEMORY_RUNTIME + prefix.concat(expected)


private pure func unused_catalog(layouts: List[Concrete.ConcreteUnion], expected: String) -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			exact(
				ids,
				layouts,
				[main_function(ids)],
				string_runtime(),
				expected
					.concat(MAIN_DECL)
					.concat(expected_main_body())
					.concat(ENTRYPOINT),
			)


pure func test_string_layout_and_helpers_include_the_runtime_for_an_unused_catalog() -> Bool:
	unused_catalog([boxed_layout()], expected_box_c())


private pure func typed_alias_case() -> Result[Bool, Diagnostic]:
	seed ?= seed(BOX_SEED, 0)
	ids = seed.values
	value_type = Concrete.UnionType(seed.owner)
	helper = function(
		[value_type],
		Concrete.IntType,
		[parameter(ids.first, value_type), acquire(
				0,
				ids.first,
				Owned.ParameterBorrow(ids.first),
			), Owned.DropOwner(
				Owned.owner_id(0),
				span(30),
			), integer(ids.second, 0)],
		Owned.ReturnTail(Owned.ReturnResult(Owned.UnmanagedReturn(ids.second))),
	)
	expected = expected_box_c()
		.concat(MAIN_DECL)
		.concat("int64_t blorp_f_1(struct blorp_u_0 blorp_p_0);")
		.concat(expected_main_body())
		.concat(
			"int64_t blorp_f_1(struct blorp_u_0 blorp_p_0){const ".concat(
				"struct blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;",
			),
		)
		.concat(
			"blorp_union_dup_0(blorp_vl_0);const struct blorp_u_0 "
				.concat("blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;")
				.concat("blorp_union_drop_0(blorp_owner_0);"),
		)
		.concat(
			"const int64_t blorp_vl_1=INT64_C(0);(void)blorp_vl_1;".concat("return blorp_vl_1;}"),
		)
		.concat(ENTRYPOINT)
	Ok(
		exact(
			ids,
			[boxed_layout()],
			[main_function(ids), helper],
			string_runtime(),
			expected,
		),
	)


pure func test_union_acquire_and_drop_use_a_struct_owner_alias() -> Bool:
	typed_alias_case().get_or(False)


private pure func final_child_case() -> Result[Bool, Diagnostic]:
	seed ?= seed(BOX_SEED, 0)
	boxed ?= seed.variants
		.get(0)
		.to_result(seed_error())
	ids = seed.values
	value_type = Concrete.UnionType(seed.owner)
	helper = function(
		[],
		value_type,
		[integer(ids.first, 7), string(ids.second, ids.first), definition(
				ids.third,
				value_type,
				Owned.ConstructDefinition(
					boxed, [Owned.OwnedPayload(
						ids.second,
						Owned.owner_id(0),
					)]),
				Owned.OwnedResult(Owned.owner_id(1)),
			)],
		returned(
			ids.third,
			1,
		),
	)
	expected = expected_box_c()
		.concat(MAIN_DECL)
		.concat("struct blorp_u_0 blorp_f_1(void);")
		.concat(expected_main_body())
		.concat(
			"struct blorp_u_0 blorp_f_1(void){const int64_t ".concat(
				"blorp_vl_0=INT64_C(7);(void)blorp_vl_0;",
			),
		)
		.concat(
			"struct blorp_string* const "
				.concat("blorp_vl_1=blorp_int_to_string(blorp_vl_0);")
				.concat("(void)blorp_vl_1;struct blorp_string* const ")
				.concat("blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"),
		)
		.concat(
			"const struct blorp_u_0 blorp_vl_2=((struct blorp_u_0){"
				.concat(".tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_owner_0}});")
				.concat("(void)blorp_vl_2;"),
		)
		.concat(
			"const struct blorp_u_0 blorp_owner_1=blorp_vl_2;".concat(
				"(void)blorp_owner_1;return blorp_owner_1;}",
			),
		)
		.concat(ENTRYPOINT)
	Ok(
		exact(
			ids,
			[boxed_layout()],
			[main_function(ids), helper],
			string_runtime(),
			expected,
		),
	)


pure func test_final_owned_child_constructs_from_its_owner_without_extra_arc_work() -> Bool:
	final_child_case().get_or(False)


private pure func borrowed_child_case() -> Result[Bool, Diagnostic]:
	seed ?= seed(BOX_SEED, 0)
	boxed ?= seed.variants
		.get(0)
		.to_result(seed_error())
	ids = seed.values
	value_type = Concrete.UnionType(seed.owner)
	helper = function(
		[Concrete.StringType],
		value_type,
		[parameter(ids.first, Concrete.StringType), acquire(
				0,
				ids.first,
				Owned.ParameterBorrow(ids.first),
			), definition(
				ids.second,
				value_type,
				Owned.ConstructDefinition(
					boxed, [Owned.OwnedPayload(
						ids.first,
						Owned.owner_id(0),
					)]),
				Owned.OwnedResult(Owned.owner_id(1)),
			)],
		returned(
			ids.second,
			1,
		),
	)
	expected = expected_box_c()
		.concat(MAIN_DECL)
		.concat("struct blorp_u_0 blorp_f_1(struct blorp_string* ".concat("blorp_p_0);"))
		.concat(expected_main_body())
		.concat(
			"struct blorp_u_0 blorp_f_1(struct blorp_string* "
				.concat("blorp_p_0){struct blorp_string* const ")
				.concat("blorp_vl_0=blorp_p_0;(void)blorp_vl_0;"),
		)
		.concat(
			"blorp_string_retain(blorp_vl_0);struct blorp_string* ".concat(
				"const blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;",
			),
		)
		.concat(
			"const struct blorp_u_0 blorp_vl_1=((struct blorp_u_0){"
				.concat(".tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_owner_0}});")
				.concat("(void)blorp_vl_1;"),
		)
		.concat(
			"const struct blorp_u_0 blorp_owner_1=blorp_vl_1;".concat(
				"(void)blorp_owner_1;return blorp_owner_1;}",
			),
		)
		.concat(ENTRYPOINT)
	Ok(
		exact(
			ids,
			[boxed_layout()],
			[main_function(ids), helper],
			string_runtime(),
			expected,
		),
	)


pure func test_borrowed_string_parameter_is_acquired_before_constructor_transfer() -> Bool:
	borrowed_child_case().get_or(False)


private pure func projected_child_case() -> Result[Bool, Diagnostic]:
	seed ?= seed(BOX_SEED, 0)
	boxed ?= seed.variants
		.get(0)
		.to_result(seed_error())
	field ?= Concrete.variant_field(boxed, 0, [boxed_layout()], span(0))
	ids = seed.values
	helper = function(
		[Concrete.UnionType(seed.owner)],
		Concrete.StringType,
		[parameter(
				ids.first,
				Concrete.UnionType(seed.owner),
			)],
		Owned.MatchTail({
			scrutinee = Owned.BorrowedArgument({ value = ids.first, source = Owned.ParameterBorrow(ids.first) }),
			owner = seed.owner,
			arms = [
				{
					label = Lower.VariantLabel(boxed),
					operations = [definition(
							ids.second,
							Concrete.StringType,
							Owned.PayloadDefinition(field, ids.first),
							Owned.BorrowedResult(Owned.PayloadBorrow(ids.first)),
						), acquire(
							0,
							ids.second,
							Owned.PayloadBorrow(ids.first),
						)],
					exit = Owned.ReturnResult(Owned.OwnedReturn(ids.second, Owned.owner_id(0)))
				},
			],
		}),
	)
	expected = expected_box_c()
		.concat(MAIN_DECL)
		.concat("struct blorp_string* blorp_f_1(struct blorp_u_0 ".concat("blorp_p_0);"))
		.concat(expected_main_body())
		.concat(
			"struct blorp_string* blorp_f_1(struct blorp_u_0 "
				.concat("blorp_p_0){const struct blorp_u_0 blorp_vl_0=blorp_p_0;")
				.concat("(void)blorp_vl_0;"),
		)
		.concat(
			"switch(blorp_vl_0.tag){case blorp_v_0_0:default:{struct "
				.concat("blorp_string* const blorp_vl_1=blorp_vl_0.payload.blorp_")
				.concat("up_0.blorp_uf_0;(void)blorp_vl_1;"),
		)
		.concat(
			"blorp_string_retain(blorp_vl_1);struct blorp_string* "
				.concat("const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;")
				.concat("return blorp_owner_0;}}}"),
		)
		.concat(ENTRYPOINT)
	Ok(
		exact(
			ids,
			[boxed_layout()],
			[main_function(ids), helper],
			string_runtime(),
			expected,
		),
	)


pure func test_selected_payload_is_acquired_inside_its_arm_before_owned_return() -> Bool:
	projected_child_case().get_or(False)


pure func test_two_managed_variants_touch_only_their_matching_payload_slot() -> Bool:
	unused_catalog(
		[
			{
				variants = [[Concrete.StringType], [Concrete.StringType]],
				representation = Concrete.InlineOwningPayload
			},
		],
		expected_choice_c(),
	)


private pure func nullary_case() -> Result[Bool, Diagnostic]:
	seed ?= seed(MIXED_SEED, 0)
	empty ?= seed.variants
		.get(1)
		.to_result(seed_error())
	ids = seed.values
	value_type = Concrete.UnionType(seed.owner)
	helper = function(
		[],
		value_type,
		[definition(
				ids.first,
				value_type,
				Owned.ConstructDefinition(empty, []),
				Owned.OwnedResult(Owned.owner_id(0)),
			)],
		returned(ids.first, 0),
	)
	expected = expected_mixed_c()
		.concat(MAIN_DECL)
		.concat("struct blorp_u_0 blorp_f_1(void);")
		.concat(expected_main_body())
		.concat(
			"struct blorp_u_0 blorp_f_1(void){const struct blorp_u_0 "
				.concat("blorp_vl_0=((struct blorp_u_0){.tag=blorp_v_0_1});")
				.concat("(void)blorp_vl_0;"),
		)
		.concat(
			"const struct blorp_u_0 blorp_owner_0=blorp_vl_0;".concat(
				"(void)blorp_owner_0;return blorp_owner_0;}",
			),
		)
		.concat(ENTRYPOINT)
	Ok(
		exact(
			ids,
			[mixed_layout()],
			[main_function(ids), helper],
			string_runtime(),
			expected,
		),
	)


pure func test_nullary_variant_keeps_the_aggregate_owner_without_child_work() -> Bool:
	nullary_case().get_or(False)


private pure func integer_variant_case() -> Result[Bool, Diagnostic]:
	seed ?= seed(MIXED_SEED, 0)
	number ?= seed.variants
		.get(2)
		.to_result(seed_error())
	ids = seed.values
	value_type = Concrete.UnionType(seed.owner)
	helper = function(
		[],
		value_type,
		[integer(ids.first, 9), definition(
				ids.second,
				value_type,
				Owned.ConstructDefinition(
					number, [Owned.UnmanagedPayload(ids.first)]),
				Owned.OwnedResult(Owned.owner_id(0)),
			)],
		returned(
			ids.second,
			0,
		),
	)
	expected = expected_mixed_c()
		.concat(MAIN_DECL)
		.concat("struct blorp_u_0 blorp_f_1(void);")
		.concat(expected_main_body())
		.concat(
			"struct blorp_u_0 blorp_f_1(void){const int64_t ".concat(
				"blorp_vl_0=INT64_C(9);(void)blorp_vl_0;",
			),
		)
		.concat(
			"const struct blorp_u_0 blorp_vl_1=((struct blorp_u_0){"
				.concat(".tag=blorp_v_0_2,.payload.blorp_up_2={.blorp_uf_0=blorp_vl_0}});")
				.concat("(void)blorp_vl_1;"),
		)
		.concat(
			"const struct blorp_u_0 blorp_owner_0=blorp_vl_1;".concat(
				"(void)blorp_owner_0;return blorp_owner_0;}",
			),
		)
		.concat(ENTRYPOINT)
	Ok(
		exact(
			ids,
			[mixed_layout()],
			[main_function(ids), helper],
			string_runtime(),
			expected,
		),
	)


pure func test_integer_variant_keeps_the_aggregate_owner_without_child_work() -> Bool:
	integer_variant_case().get_or(False)


private pure func nested_case() -> Result[Bool, Diagnostic]:
	child ?= seed(NESTED_SEED, 0)
	parent ?= seed(NESTED_SEED, 1)
	boxed ?= child.variants
		.get(0)
		.to_result(seed_error())
	wrapped ?= parent.variants
		.get(0)
		.to_result(seed_error())
	ids = child.values
	child_type = Concrete.UnionType(child.owner)
	parent_type = Concrete.UnionType(parent.owner)
	layouts: List[Concrete.ConcreteUnion] = [
		boxed_layout(),
		{
			variants = [[child_type]],
			representation = Concrete.InlineOwningPayload
		},
	]
	helper = function(
		[],
		parent_type,
		[integer(ids.first, 7), string(ids.second, ids.first), definition(
				ids.third,
				child_type,
				Owned.ConstructDefinition(
					boxed, [Owned.OwnedPayload(
						ids.second,
						Owned.owner_id(0),
					)]),
				Owned.OwnedResult(Owned.owner_id(1)),
			), definition(
				ids.fourth,
				parent_type,
				Owned.ConstructDefinition(
					wrapped, [Owned.OwnedPayload(
						ids.third,
						Owned.owner_id(1),
					)]),
				Owned.OwnedResult(Owned.owner_id(2)),
			)],
		returned(
			ids.fourth,
			2,
		),
	)
	expected = expected_box_c()
		.concat("\n")
		.concat(expected_outer_c())
		.concat(MAIN_DECL)
		.concat("struct blorp_u_1 blorp_f_1(void);")
		.concat(expected_main_body())
		.concat(
			"struct blorp_u_1 blorp_f_1(void){const int64_t ".concat(
				"blorp_vl_0=INT64_C(7);(void)blorp_vl_0;",
			),
		)
		.concat(
			"struct blorp_string* const "
				.concat("blorp_vl_1=blorp_int_to_string(blorp_vl_0);")
				.concat("(void)blorp_vl_1;struct blorp_string* const ")
				.concat("blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"),
		)
		.concat(
			"const struct blorp_u_0 blorp_vl_2=((struct blorp_u_0){"
				.concat(".tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_owner_0}});")
				.concat("(void)blorp_vl_2;const struct blorp_u_0 ")
				.concat("blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;"),
		)
		.concat(
			"const struct blorp_u_1 blorp_vl_3=((struct blorp_u_1){"
				.concat(".tag=blorp_v_1_0,.payload.blorp_up_0={.blorp_uf_0=blorp_owner_1}});")
				.concat("(void)blorp_vl_3;const struct blorp_u_1 ")
				.concat("blorp_owner_2=blorp_vl_3;(void)blorp_owner_2;return ")
				.concat("blorp_owner_2;}"),
		)
		.concat(ENTRYPOINT)
	Ok(
		exact(
			ids,
			layouts,
			[main_function(ids), helper],
			string_runtime(),
			expected,
		),
	)


pure func test_nested_helpers_precede_parents_and_delegate_one_child_obligation() -> Bool:
	nested_case().get_or(False)


private pure func arm_owner_case() -> Result[Bool, Diagnostic]:
	seed ?= seed(CHOICE_SEED, 0)
	left ?= seed.variants
		.get(0)
		.to_result(seed_error())
	right ?= seed.variants
		.get(1)
		.to_result(seed_error())
	ids = seed.values
	value_type = Concrete.UnionType(seed.owner)
	layout: Concrete.ConcreteUnion = {
		variants = [[Concrete.StringType], [Concrete.StringType]],
		representation = Concrete.InlineOwningPayload
	}
	left_field ?= Concrete.variant_field(left, 0, [layout], span(0))
	right_field ?= Concrete.variant_field(right, 0, [layout], span(0))
	helper = function(
		[value_type],
		Concrete.StringType,
		[parameter(ids.first, value_type)],
		Owned.MatchTail({
			scrutinee = Owned.BorrowedArgument({ value = ids.first, source = Owned.ParameterBorrow(ids.first) }),
			owner = seed.owner,
			arms = [
				{
					label = Lower.VariantLabel(left),
					operations = [definition(
							ids.second,
							Concrete.StringType,
							Owned.PayloadDefinition(left_field, ids.first),
							Owned.BorrowedResult(Owned.PayloadBorrow(ids.first)),
						), acquire(
							0,
							ids.second,
							Owned.PayloadBorrow(ids.first),
						)],
					exit = Owned.ReturnResult(Owned.OwnedReturn(ids.second, Owned.owner_id(0)))
				},
				{
					label = Lower.VariantLabel(right),
					operations = [acquire(
							1,
							ids.first,
							Owned.ParameterBorrow(ids.first),
						), Owned.DropOwner(
							Owned.owner_id(1),
							span(30),
						), definition(
							ids.third,
							Concrete.StringType,
							Owned.PayloadDefinition(right_field, ids.first),
							Owned.BorrowedResult(Owned.PayloadBorrow(ids.first)),
						), acquire(
							2,
							ids.third,
							Owned.PayloadBorrow(ids.first),
						)],
					exit = Owned.ReturnResult(Owned.OwnedReturn(ids.third, Owned.owner_id(2)))
				},
			],
		}),
	)
	expected = expected_choice_c()
		.concat(MAIN_DECL)
		.concat("struct blorp_string* blorp_f_1(struct blorp_u_0 ".concat("blorp_p_0);"))
		.concat(expected_main_body())
		.concat(
			"struct blorp_string* blorp_f_1(struct blorp_u_0 "
				.concat("blorp_p_0){const struct blorp_u_0 blorp_vl_0=blorp_p_0;")
				.concat("(void)blorp_vl_0;switch(blorp_vl_0.tag){"),
		)
		.concat(
			"case blorp_v_0_0:{struct blorp_string* const "
				.concat("blorp_vl_1=blorp_vl_0.payload.blorp_up_0.blorp_uf_0;")
				.concat("(void)blorp_vl_1;blorp_string_retain(blorp_vl_1);struct ")
				.concat("blorp_string* const blorp_owner_0=blorp_vl_1;")
				.concat("(void)blorp_owner_0;return blorp_owner_0;}"),
		)
		.concat(
			"case blorp_v_0_1:default:{blorp_union_dup_0(blorp_vl_0);"
				.concat("const struct blorp_u_0 blorp_owner_1=blorp_vl_0;")
				.concat("(void)blorp_owner_1;blorp_union_drop_0(blorp_owner_1);"),
		)
		.concat(
			"struct blorp_string* const "
				.concat("blorp_vl_2=blorp_vl_0.payload.blorp_up_1.blorp_uf_0;")
				.concat("(void)blorp_vl_2;blorp_string_retain(blorp_vl_2);struct ")
				.concat("blorp_string* const blorp_owner_2=blorp_vl_2;")
				.concat("(void)blorp_owner_2;return blorp_owner_2;}}}"),
		)
		.concat(ENTRYPOINT)
	Ok(
		exact(
			ids,
			[layout],
			[main_function(ids), helper],
			string_runtime(),
			expected,
		),
	)


pure func test_owner_type_projection_keeps_global_arm_ids_and_different_storage_types() -> Bool:
	arm_owner_case().get_or(False)


private pure func function_owner_case() -> Result[Bool, Diagnostic]:
	seed ?= seed(BOX_SEED, 0)
	ids = seed.values
	string_identity = function(
		[Concrete.StringType],
		Concrete.StringType,
		[parameter(ids.first, Concrete.StringType), acquire(
				0,
				ids.first,
				Owned.ParameterBorrow(ids.first),
			)],
		returned(
			ids.first,
			0,
		),
	)
	union_identity = function(
		[Concrete.UnionType(seed.owner)],
		Concrete.UnionType(seed.owner),
		[parameter(
				ids.first,
				Concrete.UnionType(seed.owner),
			), acquire(
				0,
				ids.first,
				Owned.ParameterBorrow(ids.first),
			)],
		returned(
			ids.first,
			0,
		),
	)
	expected = expected_box_c()
		.concat(MAIN_DECL)
		.concat(
			"struct blorp_string* blorp_f_1(struct blorp_string* "
				.concat("blorp_p_0);struct blorp_u_0 blorp_f_2(struct blorp_u_0 ")
				.concat("blorp_p_0);"),
		)
		.concat(expected_main_body())
		.concat(
			"struct blorp_string* blorp_f_1(struct blorp_string* "
				.concat("blorp_p_0){struct blorp_string* const ")
				.concat("blorp_vl_0=blorp_p_0;(void)blorp_vl_0;")
				.concat("blorp_string_retain(blorp_vl_0);struct blorp_string* ")
				.concat("const blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;")
				.concat("return blorp_owner_0;}"),
		)
		.concat(
			"struct blorp_u_0 blorp_f_2(struct blorp_u_0 blorp_p_0){"
				.concat("const struct blorp_u_0 blorp_vl_0=blorp_p_0;")
				.concat("(void)blorp_vl_0;blorp_union_dup_0(blorp_vl_0);const ")
				.concat("struct blorp_u_0 blorp_owner_0=blorp_vl_0;")
				.concat("(void)blorp_owner_0;return blorp_owner_0;}"),
		)
		.concat(ENTRYPOINT)
	Ok(
		exact(
			ids,
			[boxed_layout()],
			[main_function(ids), string_identity, union_identity],
			string_runtime(),
			expected,
		),
	)


pure func test_owner_type_projection_restarts_for_each_function() -> Bool:
	function_owner_case().get_or(False)


pure func test_unmanaged_union_output_has_no_owning_helpers_or_string_runtime() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			expected = "enum blorp_tag_0{blorp_v_0_0};struct blorp_u_0{enum "
				.concat("blorp_tag_0 tag;union{struct{int64_t blorp_uf_0;} blorp_up_0;}payload;};")
				.concat(MAIN_DECL)
				.concat(expected_main_body())
				.concat(ENTRYPOINT)
			exact(
				ids,
				[
					{
						variants = [[Concrete.IntType]],
						representation = Concrete.InlineUnmanaged
					},
				],
				[main_function(ids)],
				"#include <stdint.h>\n",
				expected,
			)


-- This dynamic input prevents host CTFE from replacing the stage-lifetime
-- probe. Exact raw-IR ownership oracles above remain independent of own().
func test_dynamic_fixture_reaches_emission_without_host_lifetime_leaks() -> Bool:
	match read_file("blorp_2/test/e2e/fixtures/generic/managed/basic.brp"):
		Err(error):
			print_error(error)
			False
		Ok(source):
			match (
				lowered_modules([
					{
						source = source,
						targets = [1, 2]
					},
					{
						source = INTEGER_OPERATIONS,
						targets = []
					},
					{
						source = STRING_OPERATIONS,
						targets = []
					},
				])
					.and_then(pure func(program): Owned.own(program))
					.and_then(verify)
					.and_then(emit)
			):
				Err(error):
					print_error(error.message)
					False
				Ok(_):
					True


tests: TestSuite = {
	description = "Blorp 2 managed union emission",
	tests = [
		(
			"String helpers and unused catalog include runtime",
			test_string_layout_and_helpers_include_the_runtime_for_an_unused_catalog,
		),
		(
			"union acquire and drop use a struct owner alias",
			test_union_acquire_and_drop_use_a_struct_owner_alias,
		),
		(
			"final owned child transfers without extra ARC work",
			test_final_owned_child_constructs_from_its_owner_without_extra_arc_work,
		),
		(
			"borrowed String acquires before construction",
			test_borrowed_string_parameter_is_acquired_before_constructor_transfer,
		),
		(
			"selected payload acquires inside its returning arm",
			test_selected_payload_is_acquired_inside_its_arm_before_owned_return,
		),
		(
			"managed variants touch only matching payload slots",
			test_two_managed_variants_touch_only_their_matching_payload_slot,
		),
		(
			"nullary variant has a uniform aggregate owner",
			test_nullary_variant_keeps_the_aggregate_owner_without_child_work,
		),
		(
			"Int active variant retains uniform aggregate obligation",
			test_integer_variant_keeps_the_aggregate_owner_without_child_work,
		),
		(
			"nested helpers precede parents and delegate child work",
			test_nested_helpers_precede_parents_and_delegate_one_child_obligation,
		),
		(
			"global arm owner IDs preserve different storage types",
			test_owner_type_projection_keeps_global_arm_ids_and_different_storage_types,
		),
		(
			"owner type projection restarts per function",
			test_owner_type_projection_restarts_for_each_function,
		),
		(
			"unmanaged output omits owning helpers and runtime",
			test_unmanaged_union_output_has_no_owning_helpers_or_string_runtime,
		),
		(
			"dynamic fixture emission lifetime",
			test_dynamic_fixture_reaches_emission_without_host_lifetime_leaks,
		),
	]
}
