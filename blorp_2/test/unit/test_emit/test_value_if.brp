import:
	../../../src/emit/emit: emit
	../../../src/verify/verify: verify
	../value_if_inputs as Input
	test: TestSuite


pure func test_string_and_list_value_ifs_emit_through_verified_joins() -> Bool:
	(Input.owned(Input.STRING_ALIAS).and_then(verify).and_then(emit).is_ok()
		and Input.owned(Input.LIST_ALIAS).and_then(verify).and_then(emit).is_ok())


tests: TestSuite = {
	description = "Blorp 2 value if emission",
	tests = [("verified String and List joins emit", test_string_and_list_value_ifs_emit_through_verified_joins)]
}
