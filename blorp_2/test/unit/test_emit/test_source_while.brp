import:
	../../../src/emit/emit: emit
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: entry_function
	../../../src/verify/verify: verify
	../source_while_inputs as Input
	test: TestSuite


private pure func source_loop(step: Lower.LoweredStep) -> Option[Lower.LoweredLoop]:
	match step:
		Lower.Loop(loop): Some(loop)
		_: None


private pure func snapshot_facts() -> Option[Bool]:
	lowered ?= Input.lowered(Input.HEADER_SWAP).to_option()
	contents = Lower.lowered_functions(lowered)
	function ?= contents.functions.get(Concrete.function_number(entry_function(contents.entrypoint)))
	step ?= function.steps.get(3)
	loop ?= source_loop(step)
	first ?= loop.headers.get(0)
	second ?= loop.headers.get(1)
	third ?= loop.headers.get(2)
	code ?= Own.own(lowered).and_then(verify).and_then(emit).to_option()
	first_id = Lower.value_number(first.parameter.id).to_string()
	second_id = Lower.value_number(second.parameter.id).to_string()
	third_id = Lower.value_number(third.parameter.id).to_string()
	root = "blorp_loop_" + Lower.value_number(loop.result.id).to_string()
	first_capture ?= code.index_of(root + "_transfer_0=blorp_vl_" + second_id + ";")
	second_capture ?= code.index_of(root + "_transfer_1=blorp_vl_" + first_id + ";")
	last_capture ?= code.index_of(root + "_transfer_2=")
	first_assignment ?= code.index_of("blorp_h_" + first_id + "=" + root + "_transfer_0;")
	Some(code.contains(root + "_header:{")
		and code.contains("blorp_vl_" + first_id + "=blorp_h_" + first_id + ";")
		and code.contains("blorp_vl_" + second_id + "=blorp_h_" + second_id + ";")
		and first_capture < second_capture and second_capture < last_capture and last_capture < first_assignment
		and code.contains("blorp_h_" + first_id + "=" + root + "_transfer_0;blorp_h_" + second_id + "=" + root + "_transfer_1;blorp_h_" + third_id + "=" + root + "_transfer_2;goto " + root + "_header;")
		and code.contains("goto " + root + "_break;") and code.contains(root + "_break:;"))


pure func test_source_loop_uses_common_snapshot_and_cross_header_transfer() -> Bool:
	snapshot_facts().get_or(False)


pure func test_source_loop_with_mortal_and_borrowed_pre_emits() -> Bool:
	Input.lowered(Input.MANAGED_LOCAL).and_then(Own.own).and_then(verify).and_then(emit).is_ok()


tests: TestSuite = {
	description = "Blorp 2 source while emission",
	tests = [
		("common loop snapshots precede cross header assignment", test_source_loop_uses_common_snapshot_and_cross_header_transfer),
		("borrowed PRE and mortal iteration aliases emit", test_source_loop_with_mortal_and_borrowed_pre_emits),
	]
}
