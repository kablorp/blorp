import:
	../../../src/emit/emit: emit
	../../../src/verify/verify: verify
	../constant_inputs: TWICE, owned
	test: TestSuite


pure func test_used_strings_materialize_twice_and_unused_constant_is_absent() -> Bool:
	match owned(TWICE).and_then(pure func(program): verify(program)).and_then(pure func(program): emit(program)):
		Err(_): False
		Ok(output):
			(output.split("blorp_string_from_bytes((const char *)blorp_bytes_").length() == 3
				and not output.contains("{97,98,115,101,110,116}"))


tests: TestSuite = {
	description = "Constant materialization emission",
	tests = [("only use sites allocate String literals", test_used_strings_materialize_twice_and_unused_constant_is_absent)],
}
