import:
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic
	../../../src/verify/verify: verify
	../../../src/emit/emit: emit
	../input: checked_source
	test: TestSuite


private SOURCE: String =
	|pure func saved(callback: () -> Int) -> () -> Int:
	|    func() -> Int: callback()
	|pure func answer() -> Int:
	|    42
	|func main() -> Int:
	|    callback: () -> Int = answer
	|    returned: () -> Int = saved(callback)
	|    returned()


private pure func owned() -> Result[Own.OwnershipProgram, Diagnostic]:
	checked ?= checked_source(SOURCE)
	concrete ?= Concrete.specialize(checked)
	lowered ?= Lower.lower(concrete)
	Own.own(lowered)


pure func test_emission_uses_typed_ops_and_exact_object_pointer_adapters() -> Bool:
	match owned().and_then(verify).and_then(emit):
		Err(_): False
		Ok(output): (
			output.contains("void* environment;")
				and output.contains(" (*invoke)(void* environment")
				and output.contains(".ops->invoke(")
				and output.contains("value.ops->retain(value.environment);")
				and output.contains("value.ops->drop(value.environment);")
				and output.contains("const struct blorp_co_")
			)


tests: TestSuite = {
	description = "Blorp 2 stored callable emission",
	tests = [("emission uses typed ops and exact object-pointer adapters", test_emission_uses_typed_ops_and_exact_object_pointer_adapters)],
}
