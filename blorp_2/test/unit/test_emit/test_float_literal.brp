import:
	../../../src/emit/float_literal: c_float_literal
	float as FloatOps
	string: parse_float, equals
	test: TestSuite


pure func test_positive_zero() -> Bool:
	equals(c_float_literal(0.0), "0x0p+0")


pure func test_negative_zero() -> Bool:
	equals(c_float_literal(parse_float("-0.0").get_or(1.0)), "-0x0p+0")


pure func test_whole_value() -> Bool:
	equals(c_float_literal(1.0), "0x1.0000000000000p+0")


pure func test_fraction_preserves_all_bits() -> Bool:
	equals(c_float_literal(0.1), "0x1.999999999999ap-4")


pure func test_negative_fraction() -> Bool:
	equals(c_float_literal(-1.5), "-0x1.8000000000000p+0")


pure func test_large_exponent() -> Bool:
	value = parse_float("1e20").get_or(0.0)
	equals(c_float_literal(value), "0x1.5af1d78b58c40p+66")


pure func test_smallest_normal() -> Bool:
	value = parse_float("2.2250738585072014e-308").get_or(0.0)
	equals(c_float_literal(value), "0x1.0000000000000p-1022")


pure func test_smallest_subnormal() -> Bool:
	value = parse_float("4.9406564584124654e-324").get_or(0.0)
	equals(c_float_literal(value), "0x1.0000000000000p-1074")


pure func test_largest_subnormal() -> Bool:
	value = parse_float("2.225073858507201e-308").get_or(0.0)
	equals(c_float_literal(value), "0x1.ffffffffffffep-1023")


pure func test_largest_finite() -> Bool:
	value = parse_float("1.7976931348623157e308").get_or(0.0)
	equals(c_float_literal(value), "0x1.fffffffffffffp+1023")


pure func test_adjacent_value() -> Bool:
	value = parse_float("1.0000000000000002").get_or(0.0)
	equals(c_float_literal(value), "0x1.0000000000001p+0")


pure func test_underflow_preserves_zero_sign() -> Bool:
	value = parse_float("-1e-9999").get_or(1.0)
	equals(c_float_literal(value), "-0x0p+0")


pure func test_nonfinite_projection_is_total() -> Bool:
	positive = parse_float("inf").get_or(0.0)
	negative = parse_float("-inf").get_or(0.0)
	nan = FloatOps.subtract(positive, positive)
	(
		equals(c_float_literal(positive), "INFINITY")
		and equals(c_float_literal(negative), "(-INFINITY)")
		and equals(c_float_literal(nan), "NAN")
	)


tests: TestSuite = {
	description = "Blorp 2 exact Float C literals",
	tests = [
		("positive zero", test_positive_zero),
		("negative zero", test_negative_zero),
		("whole Float value", test_whole_value),
		("fraction preserves all bits", test_fraction_preserves_all_bits),
		("negative fraction", test_negative_fraction),
		("large exponent", test_large_exponent),
		("smallest normal", test_smallest_normal),
		("smallest subnormal", test_smallest_subnormal),
		("largest subnormal", test_largest_subnormal),
		("largest finite", test_largest_finite),
		("adjacent value", test_adjacent_value),
		("underflow preserves zero sign", test_underflow_preserves_zero_sign),
		("nonfinite projection is total", test_nonfinite_projection_is_total),
	]
}
