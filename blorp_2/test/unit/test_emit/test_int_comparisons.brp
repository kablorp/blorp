import:
	../compilation: compile_modules
	../int_comparison_inputs: COMPARISON_SOURCE
	../module_input: TestFoundation, test_base
	test: TestSuite


private pure func emits(source: String, foundation: TestFoundation, condition: String) -> Bool:
	match compile_modules([{ source = source, targets = [] }], foundation):
		Err(_): False
		Ok(output):
			output.contains(condition) and not output.contains("blorp_int_less_than(")


pure func test_less_than_emits_a_signed_comparison_and_actual_tags() -> Bool:
	emits(COMPARISON_SOURCE, test_base(), "(blorp_vl_0<blorp_vl_1)?blorp_v_0_0:blorp_v_0_1")


pure func test_reordered_bool_uses_the_designated_constructor_tags() -> Bool:
	foundation = { test_base() | types = test_base().types.replace("    True\n    False", "    False\n    True") }
	emits(COMPARISON_SOURCE, foundation, "(blorp_vl_0<blorp_vl_1)?blorp_v_0_1:blorp_v_0_0")


pure func test_existing_integer_equality_emission_is_unchanged() -> Bool:
	emits(COMPARISON_SOURCE.replace("int.less_than", "int.equals"), test_base(), "(blorp_vl_0==blorp_vl_1)?blorp_v_0_0:blorp_v_0_1")


pure func test_unused_comparison_emits_no_comparison_or_helper() -> Bool:
	source = COMPARISON_SOURCE.replace("    compared = compare(20, 22)\n", "")
	match compile_modules([{ source = source, targets = [] }], test_base()):
		Err(_): False
		Ok(output): not output.contains("(blorp_vl_0<blorp_vl_1)?") and not output.contains("blorp_int_less_than(")


pure func test_existing_string_equality_emission_is_unchanged() -> Bool:
	source = (COMPARISON_SOURCE.replace("int.less_than", "string.equals")
		.replace("left: Int, right: Int", "left: String, right: String")
		.replace("compare(20, 22)", "compare(\"left\", \"right\")"))
	emits(source, test_base(), "blorp_string_equals(blorp_vl_0,blorp_vl_1)?blorp_v_0_0:blorp_v_0_1")


tests: TestSuite = {
	description = "Signed Int comparison emission",
	tests = [
		("signed comparison selects True instead of assuming C Bool tags", test_less_than_emits_a_signed_comparison_and_actual_tags),
		("constructor order does not change truth values", test_reordered_bool_uses_the_designated_constructor_tags),
		("integer equality retains its emitted comparison", test_existing_integer_equality_emission_is_unchanged),
		("String equality retains its emitted comparison", test_existing_string_equality_emission_is_unchanged),
		("unused comparison selects no helper or predicate", test_unused_comparison_emits_no_comparison_or_helper),
	]
}
