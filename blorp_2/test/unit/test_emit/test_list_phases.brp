						[parameter, _]:
							match parameter.operation:
								Lower.ParameterValue(0): Concrete.same_type(parameter.value_type, Concrete.ListType(Concrete.StringType))
								_: False
						_: False
				_: False


pure func test_list_root_has_separate_ownership_plan() -> Bool:
	match Concrete.value_ownership(Concrete.ListType(Concrete.StringType), [], []):
		Ok(Concrete.ManagedListRoot): True
		_: False


pure func test_returning_borrowed_list_acquires_then_transfers_root() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			list_type = Concrete.ListType(Concrete.StringType)
			lowered = function([parameter(ids.first, list_type)], ids.first, [list_type], list_type)
			match Own.insert_function(lowered, [], []):
				Ok(function):
					match (function.operations, function.tail):
						([Own.DefineValue(parameter), Own.AcquireOwner(owner, borrow, _)], Own.ReturnTail(Own.ReturnResult(Own.OwnedReturn(returned, transferred)))):
							match (parameter.result, borrow.source):
								(Own.BorrowedResult(Own.ParameterBorrow(source)), Own.ParameterBorrow(dependency)): Lower.value_number(source) == 0 and Lower.value_number(dependency) == 0 and Lower.value_number(borrow.value) == 0 and Lower.value_number(returned) == 0 and Own.owner_number(owner) == Own.owner_number(transferred)
								_: False
						_: False
				Err(_): False


private pure func definition(ids: InputIds, value_type: Concrete.TypeRef) -> Own.OwnershipOperation:
	Own.DefineValue({ id = ids.first, value_type = value_type, operation = Own.ParameterDefinition(0), result = Own.BorrowedResult(Own.ParameterBorrow(ids.first)), span = span(10) })


private pure func zero(ids: InputIds) -> Own.OwnedFunction:
	{ execution = OrdinaryCalls, signature = { parameters = [], return_type = Concrete.IntType }, operations = [Own.DefineValue({ id = ids.first, value_type = Concrete.IntType, operation = Own.IntegerDefinition(0), result = Own.UnmanagedResult, span = span(1) })], tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.first))) }


private pure func list_identity(ids: InputIds, acquire: Bool) -> Own.OwnedFunction:
	list_type = Concrete.ListType(Concrete.StringType)
	operations = if acquire:
		[definition(ids, list_type), Own.AcquireOwner(Own.owner_id(0), { value = ids.first, source = Own.ParameterBorrow(ids.first) }, span(10))]
	else:
		[definition(ids, list_type)]
	{ execution = OrdinaryCalls, signature = { parameters = [list_type], return_type = list_type }, operations = operations, tail = Own.ReturnTail(Own.ReturnResult(Own.OwnedReturn(ids.first, Own.owner_id(0)))) }


pure func test_verifier_independently_accepts_acquired_list_transfer() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): verify({ records = [], unions = [], functions = [zero(ids), list_identity(ids, True)], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }).is_ok()


