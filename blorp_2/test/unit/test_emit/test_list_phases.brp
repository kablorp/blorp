import:
	../../../src/check/check: CheckedProgram, check, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/model as Check
	../../../src/utils/ids as Declaration
	../../../src/emit/emit: emit
	../../../src/lex/lex: lex
	../../../src/lower/lower as Lower
	../../../src/utils/names: same_name, program_names
	../../../src/own/own as Own
	../../../src/parse/parse: parse_module
	../../../src/namespace/builtins as Builtins: check_builtin_types, render_builtin_type_error
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, Entrypoint(NoArguments, WithArguments), EntryResult(IntegerExitStatus), entry_function, FunctionExecution(OrdinaryCalls)
	../../../src/verify/verify: verify
	../input: check_failure, initial_names, setup_diagnostic
	option: get_or
	../module_input: PRIMITIVE_BASE, TEST_BASE, parse_modules_with_base
	../ownership_inputs: InputIds, input_ids, parameter, function, span
	test: TestSuite


private SOURCE: String =
	|fixed union Box[T]:
	|    Full(T)
	|pure func identity[T](value: List[T]) -> List[T]:
	|    value
	|pure func unbox(value: Box[List[String]]) -> List[String]:
	|    match value:
	|        Full(values): values
	|func main(arguments: List[String]) -> Int:
	|    saved = identity(arguments)
	|    unpacked = unbox(Full(saved))
	|    0
	|


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules_with_base([{ source = source, targets = [] }], PRIMITIVE_BASE)
	check(parsed).map_err(setup_diagnostic)


pure func test_prelude_publishes_distinct_list_constructor_identity() -> Bool:
	match initial_names():
		Ok(initial):
			special = initial.special
			not same_name(special.list, special.string) and not same_name(special.list, special.integer)
		Err(_): False


pure func test_missing_list_constructor_has_exact_diagnostic() -> Bool:
	source = "type Int = builtin\ntype Float = builtin\ntype String = builtin\ntype Void = builtin\n"
	match parse_modules_with_base([{ source = "func main() -> Int:\n    0\n", targets = [] }], { PRIMITIVE_BASE | types = source }).and_then(pure func(value): check_builtin_types(value).map_err(render_builtin_type_error)):
		Err(error): error.message == "missing List builtin declaration" and error.help == "add type List[T] = builtin to _base.brp" and error.span.start == source.length() and error.span.end == source.length()
		Ok(_): False


pure func test_builtin_list_declaration_requires_exact_unary_arity() -> Bool:
	prefix = TEST_BASE.types + "type List[T"
	match lex(module_source(root_module_id()), prefix + ", U] = builtin\n", program_names().names).and_then(pure func(tokens): parse_module(tokens, root_module_id())):
		Err(error): error.message == "List requires exactly one type parameter" and error.help == "write type List[T] = builtin" and error.span.start == prefix.length() and error.span.end == prefix.length() + 1
		Ok(_): False


pure func test_checker_accepts_argument_main_once() -> Bool:
	match checked("func main(renamed: List[String]) -> Int:\n    0\n"):
		Err(_): False
		Ok(program):
			facts = checked_functions(program)
			match (facts.entrypoint, facts.functions):
				(WithArguments(entry, _), [function]):
					Declaration.function_number(entry) == 0 and function.signature.type_parameters.is_empty() and Check.same_type(function.signature.parameters.get(0).map(pure func(value): value.value_type).get_or(Check.IntType), Check.ListType(Check.StringType))
				_: False


pure func test_list_structural_equality_recurses_into_element() -> Bool:
	Check.same_type(Check.ListType(Check.StringType), Check.ListType(Check.StringType)) and not Check.same_type(Check.ListType(Check.StringType), Check.ListType(Check.IntType)) and not Concrete.same_type(Concrete.ListType(Concrete.StringType), Concrete.ListType(Concrete.IntType))


pure func test_generic_list_argument_infers_element_and_substitutes_result() -> Bool:
	match checked(SOURCE):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions.get(2):
				Some(main):
					match main.statements:
						[Check.InitializeBinding(_, value), Check.InitializeBinding(_, _)]:
							match value.form:
								Check.InvokeFunction(call, [_]):
									match call.target:
										Check.UserFunction(_, [Check.StringType]): Check.same_type(value.value_type, Check.ListType(Check.StringType))
										_: False
								_: False
						_: False
				None: False


private pure func runtime_body(function: Check.CheckedFunction) -> Option[Builtins.RuntimeOperation[Declaration.VariantId, Check.TypeRef]]:
	match function.body:
		Check.CheckedValueBody(Check.ReturnExpression(value)):
			match value.form:
				Check.InvokeFunction(call, _):
					match call.target:
						Check.RuntimeFunction(operation): Some(operation)
						_: None
				_: None
		_: None


pure func test_generic_list_length_header_carries_its_rigid_element() -> Bool:
	source: String =
		|pure func count[T](values: List[T]) -> Int:
		|    builtin("list.length")
		|func main() -> Int:
		|    0
		|
	match checked(source):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[count, _]:
					parameters = count.signature.parameters.map(pure func(value): value.value_type)
					accepted_element = match count.signature.type_parameters:
						[element]: Check.same_types(parameters, [Check.ListType(Check.ParameterType(element))])
						_: False
					accepted_operation = match runtime_body(count):
						Some(Builtins.ListLength(element)):
							Check.same_types(parameters, [Check.ListType(element)])
						_: False
					accepted_element and accepted_operation and Check.same_type(count.signature.return_type.value_type, Check.IntType)
				_: False


pure func test_generic_list_get_header_preserves_its_result_element() -> Bool:
	source: String =
		|fixed union Maybe[T]:
		|    Missing
		|    Present(T)
		|pure func item[T](values: List[T], index: Int) -> Maybe[T]:
		|    builtin("list.get", Present, Missing)
		|func main() -> Int:
		|    0
		|
	match checked(source):
		Err(_): False
		Ok(program):
			facts = checked_functions(program)
			match facts.functions:
				[item, _]:
					match item.signature.type_parameters:
						[element]:
							parameters = item.signature.parameters.map(pure func(value): value.value_type)
							accepted_parameters = Check.same_types(parameters, [Check.ListType(Check.ParameterType(element)), Check.IntType])
							accepted_result = match facts.unions:
								[declaration]: Check.same_type(item.signature.return_type.value_type, Check.AppliedUnionType(declaration.id, [Check.ParameterType(element)]))
								_: False
							accepted_operation = match runtime_body(item):
								Some(Builtins.ListGet(actual, roles)):
									accepted_roles = match facts.unions:
										[declaration]:
											match declaration.variants:
												[missing, present]:
													Check.same_variant(roles.present, present.id) and Check.same_variant(roles.absent, missing.id)
												_: False
										_: False
									Check.same_type(actual, Check.ParameterType(element)) and accepted_roles
								_: False
							accepted_parameters and accepted_result and accepted_operation
						_: False
				_: False


pure func test_signature_only_list_prepares_nested_nominal_elements() -> Bool:
	source: String =
		|fixed record Entry { number: Int, text: String }
		|fixed record Box[T] { value: T }
		|fixed union Maybe[T]:
		|    Missing
		|    Present(T)
		|pure func empty() -> Maybe[List[List[Box[Entry]]]]:
		|    Missing
		|func main() -> Int:
		|    saved = empty()
		|    0
		|
	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			facts = Concrete.specialized_contents(program)
			match facts.records:
				[entry, box]:
					entry_fields = match entry.fields:
						[Concrete.IntType, Concrete.StringType]: True
						_: False
					entry_root = match entry.representation:
						Concrete.ManagedRecord: True
						Concrete.InlineRecord: False
					box_child = match box.fields:
						[Concrete.RecordType(child)]:
							match facts.records.get(Concrete.record_number(child)):
								Some(child_layout):
									match child_layout.fields:
										[Concrete.IntType, Concrete.StringType]: True
										_: False
								None: False
						_: False
					box_root = match box.representation:
						Concrete.ManagedRecord: True
						Concrete.InlineRecord: False
					stored_element = match facts.unions:
						[layout]:
							match layout.variants:
								[[], [Concrete.ListType(Concrete.ListType(Concrete.RecordType(child)))]]:
									match facts.records.get(Concrete.record_number(child)):
										Some(child_layout):
											match child_layout.fields:
												[actual]:
													match box.fields:
														[expected]: Concrete.same_type(actual, expected)
														_: False
												_: False
										None: False
								_: False
						_: False
					entry_fields and entry_root and box_child and box_root and stored_element
				_: False


pure func test_concrete_list_element_known_by_substitution_is_accepted() -> Bool:
	source: String =
		|fixed union Maybe[T]:
		|    None
		|    Some(T)
		|pure func empty[T](ignored: T) -> Maybe[List[T]]:
		|    None
		|func main() -> Int:
		|    ignored = empty(7)
		|    0
		|
	match checked(source):
		Err(_): False
		Ok(program):
			facts = checked_functions(program)
			match facts.functions.get(1):
				Some(main):
					match main.statements:
						[Check.InitializeBinding(_, value)]:
							match facts.unions:
								[declaration]: Check.same_type(value.value_type, Check.AppliedUnionType(declaration.id, [Check.ListType(Check.IntType)]))
								_: False
						_: False
				None: False



pure func test_list_type_name_cannot_be_a_generic_parameter() -> Bool:
	match check_failure("pure func identity[List](value: List) -> List:\n    value\nfunc main() -> Int:\n    0\n"):
		Some(error):
			match error.kind:
				Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)): True
				_: False
		None: False


pure func test_specialization_translates_accepted_entrypoint_and_list_layout() -> Bool:
	match checked(SOURCE).and_then(pure func(value): Concrete.specialize(value)):
		Err(_): False
		Ok(program):
			facts = Concrete.specialized_contents(program)
			match (facts.entrypoint, facts.unions):
				(WithArguments(entry, _), [layout]):
					match (layout.variants, layout.representation):
						([[Concrete.ListType(Concrete.StringType)]], Concrete.InlineOwningPayload): Concrete.function_number(entry) == 0
						_: False
				_: False


pure func test_entrypoint_translation_uses_its_instance_identity() -> Bool:
	match checked(SOURCE):
		Err(_): False
		Ok(accepted):
			declaration = entry_function(checked_functions(accepted).entrypoint)
			match Concrete.specialize(accepted):
				Err(_): False
				Ok(program):
					facts = Concrete.specialized_contents(program)
					instance = entry_function(facts.entrypoint)
					match facts.functions.get(Concrete.function_number(instance)):
						Some(main):
							match (facts.entrypoint, main.signature.parameters):
								(WithArguments(_, _), [Concrete.ListType(Concrete.StringType)]):
									(
										Declaration.function_number(declaration) != Concrete.function_number(instance)
										and Concrete.same_type(main.signature.return_type, Concrete.IntType)
									)
								_: False
						None: False


pure func test_specialization_accepts_list_element_known_only_inside_generic_body() -> Bool:
	source: String =
		|fixed union Maybe[T]:
		|    Empty
		|    Full(T)
		|pure func make[T](witness: T) -> Maybe[List[T]]:
		|    Empty
		|pure func hide[T](witness: T) -> Int:
		|    unused = make(witness)
		|    0
		|func main() -> Int:
		|    hide(42)
		|
	match checked(source).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			match Concrete.specialized_contents(program).unions:
				[layout]:
					fields = match layout.variants:
						[[], [Concrete.ListType(Concrete.IntType)]]: True
						_: False
					owning = match layout.representation:
						Concrete.InlineOwningPayload: True
						Concrete.InlineUnmanaged: False
					fields and owning
				_: False



pure func test_list_nested_generic_dependency_growth_is_rejected_early() -> Bool:
	prefix: String =
		|pure func make[T](value: T) -> List[T]:
		|    make(value)
		|pure func grow[T](value: T) -> Int:
		|
	suffix: String =
		|func main() -> Int:
		|    grow("x")
		|
	source = prefix + "    grow(make(value))\n" + suffix
	match checked(source):
		Err(error):
			(
				error.message == "recursive calls grow type arguments without bound"
				and error.help == "pass recursive type arguments unchanged, permute them, or reset them to concrete types"
				and same_source(error.span.source, module_source(root_module_id()))
				and error.span.start == prefix.length() + 4
				and error.span.end == prefix.length() + 8
			)
		Ok(_): False


pure func test_lowering_preserves_argument_borrow_type() -> Bool:
