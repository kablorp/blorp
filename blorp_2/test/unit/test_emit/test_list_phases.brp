		Ok(ids):
			match verify({ records = [], unions = [], functions = [zero(ids), list_identity(ids, False)], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }):
				Err(error): error.message == "ownership verification failed: owner 0 is not defined"
				Ok(_): False


pure func test_verifier_rejects_forged_argument_convention() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			match verify({ records = [], unions = [], functions = [zero(ids)], entrypoint = WithArguments(ids.entrypoint, IntegerExitStatus) }):
				Err(error): error.message == "ownership verification failed: entrypoint signature does not match its accepted argument and result conventions"
				Ok(_): False


pure func test_verifier_accepts_numeric_list_in_unused_signature() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			list_type = Concrete.ListType(Concrete.IntType)
			unused: Own.OwnedFunction = {
				execution = OrdinaryCalls,
				signature = { parameters = [list_type], return_type = Concrete.IntType },
				operations = [
					definition(ids, list_type),
					Own.DefineValue({ id = ids.second, value_type = Concrete.IntType, operation = Own.IntegerDefinition(0), result = Own.UnmanagedResult, span = span(20) }),
				],
				tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.second)))
			}
			verify({ records = [], unions = [], functions = [zero(ids), unused], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }).is_ok()


private fixed record NestedSeed {
	ids: InputIds,
	unions: List[Concrete.ConcreteUnion],
	variant: Concrete.VariantInstanceId,
	field: Concrete.VariantFieldInstanceId,
	lowered: Lower.LoweredFunction
}


private pure func nested_seed() -> Result[NestedSeed, Diagnostic]:
	ids ?= input_ids()
	checked ?= checked(SOURCE)
	concrete ?= Concrete.specialize(checked)
	program ?= Lower.lower(concrete)
	facts = Lower.lowered_functions(program)
	match facts.functions:
		[_, _, unbox]:
			match unbox.tail:
				Lower.MatchValue(matched):
					match matched.arms:
						[arm]:
							match arm.label:
								Lower.VariantLabel(variant):
									field ?= Concrete.variant_field(variant, 0, facts.unions, span(0))
									Ok({ ids = ids, unions = facts.unions, variant = variant, field = field, lowered = unbox })
								_: Err({ span = span(0), note = None, message = "expected Box variant", help = "fix phase identity seed" })
						_: Err({ span = span(0), note = None, message = "expected one Box arm", help = "fix phase identity seed" })
				_: Err({ span = span(0), note = None, message = "expected Box match", help = "fix phase identity seed" })
		_: Err({ span = span(0), note = None, message = "expected three concrete roots", help = "fix phase identity seed" })


pure func test_nested_list_payload_acquires_borrow_and_transfers_its_root() -> Bool:
	match nested_seed():
		Err(_): False
		Ok(seed):
			match Own.insert_function(seed.lowered, seed.unions, []):
				Err(_): False
				Ok(function):
					match function.tail:
						Own.MatchTail(matched):
							match matched.arms:
								[arm]:
									match (arm.operations, arm.exit):
										([Own.DefineValue(payload), Own.AcquireOwner(owner, borrow, _)], Own.ReturnResult(Own.OwnedReturn(returned, transferred))):
											match (payload.result, borrow.source):
												(Own.BorrowedResult(Own.PayloadBorrow(parent)), Own.PayloadBorrow(dependency)): Concrete.same_type(payload.value_type, Concrete.ListType(Concrete.StringType)) and Lower.value_number(parent) == Lower.value_number(dependency) and Lower.value_number(returned) == Lower.value_number(payload.id) and Own.owner_number(owner) == Own.owner_number(transferred)
												_: False
										_: False
								_: False
						_: False


private pure func nested_projection(seed: NestedSeed, acquire: Bool) -> Own.OwnedFunction:
	ids = seed.ids
	union_type = Concrete.UnionType(Concrete.variant_owner(seed.variant))
	parameter = definition(ids, union_type)
	child: Own.OwnershipOperation = Own.DefineValue({ id = ids.second, value_type = Concrete.ListType(Concrete.StringType), operation = Own.PayloadDefinition(seed.field, ids.first), result = Own.BorrowedResult(Own.PayloadBorrow(ids.first)), span = span(20) })
	operations = if acquire:
		[child, Own.AcquireOwner(Own.owner_id(0), { value = ids.second, source = Own.PayloadBorrow(ids.first) }, span(20))]
	else:
		[child]
	matched: Own.OwnedMatch = { scrutinee = Own.BorrowedArgument({ value = ids.first, source = Own.ParameterBorrow(ids.first) }), owner = Concrete.variant_owner(seed.variant), arms = [{ label = Lower.VariantLabel(seed.variant), operations = operations, exit = Own.ReturnResult(Own.OwnedReturn(ids.second, Own.owner_id(0))) }] }
	{ execution = OrdinaryCalls, signature = { parameters = [union_type], return_type = Concrete.ListType(Concrete.StringType) }, operations = [parameter], tail = Own.MatchTail(matched) }


pure func test_verifier_independently_accepts_acquired_nested_list_projection() -> Bool:
	match nested_seed():
		Err(_): False
		Ok(seed): verify({ records = [], unions = seed.unions, functions = [zero(seed.ids), nested_projection(seed, True)], entrypoint = NoArguments(seed.ids.entrypoint, IntegerExitStatus) }).is_ok()


pure func test_verifier_rejects_nested_list_return_without_acquisition() -> Bool:
	match nested_seed():
		Err(_): False
		Ok(seed):
			match verify({ records = [], unions = seed.unions, functions = [zero(seed.ids), nested_projection(seed, False)], entrypoint = NoArguments(seed.ids.entrypoint, IntegerExitStatus) }):
				Err(error): error.message == "ownership verification failed: owner 0 is not defined"
				Ok(_): False


pure func test_inline_list_union_acquisition_and_drop_emit_root_dispatch() -> Bool:
	match nested_seed():
		Err(_): False
		Ok(seed):
			ids = seed.ids
			union_type = Concrete.UnionType(Concrete.variant_owner(seed.variant))
			borrow: Own.BorrowedValue = { value = ids.first, source = Own.ParameterBorrow(ids.first) }
			cleanup: Own.OwnedFunction = { execution = OrdinaryCalls, signature = { parameters = [union_type], return_type = Concrete.IntType }, operations = [definition(ids, union_type), Own.AcquireOwner(Own.owner_id(0), borrow, span(20)), Own.DropOwner(Own.owner_id(0), span(30)), Own.DefineValue({ id = ids.second, value_type = Concrete.IntType, operation = Own.IntegerDefinition(0), result = Own.UnmanagedResult, span = span(40) })], tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.second))) }
			program: Own.OwnershipProgram = { records = [], unions = seed.unions, functions = [zero(ids), cleanup], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }
			match verify(program).and_then(emit):
				Ok(output): output.contains("blorp_list_dup_0_s(value.payload.blorp_up_0.blorp_uf_0)") and output.contains("blorp_list_drop_0_s(value.payload.blorp_up_0.blorp_uf_0)") and output.contains("blorp_union_dup_0(blorp_vl_0)") and output.contains("blorp_union_drop_0(blorp_owner_0)")
				Err(_): False


pure func test_option_list_cleanup_dispatches_present_and_empty_cases() -> Bool:
	source: String =
		|fixed union Option[T]:
		|    Some(T)
		|    None
		|pure func present(values: List[String]) -> Option[List[String]]:
		|    Some(values)
		|pure func empty() -> Option[List[String]]:
		|    None
		|pure func copy(value: Option[List[String]]) -> Option[List[String]]:
		|    value
		|func main(arguments: List[String]) -> Int:
		|    present_list = copy(present(arguments))
		|    empty_list = copy(empty())
		|    0
		|
	result = checked(source)
		.and_then(pure func(value): Concrete.specialize(value))
		.and_then(pure func(value): Lower.lower(value))
		.and_then(pure func(value): Own.own(value))
		.and_then(verify)
		.and_then(emit)
	match result:
		Ok(output):
			(
				output.contains("void blorp_union_dup_0(struct blorp_u_0 value){switch(value.tag){case blorp_v_0_0:blorp_list_dup_0_s(value.payload.blorp_up_0.blorp_uf_0);break;case blorp_v_0_1:break;}}")
				and output.contains("void blorp_union_drop_0(struct blorp_u_0 value){switch(value.tag){case blorp_v_0_0:blorp_list_drop_0_s(value.payload.blorp_up_0.blorp_uf_0);break;case blorp_v_0_1:break;}}")
				and output.contains("blorp_union_dup_0(blorp_vl_0)")
				and output.contains("blorp_union_drop_0(blorp_owner_0)")
				and output.contains("blorp_union_drop_0(blorp_owner_1)")
			)
		Err(_): False


pure func test_verifier_rejects_nullary_convention_for_borrowed_list_parameter() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			entry = { zero(ids) | signature = { parameters = [Concrete.ListType(Concrete.StringType)], return_type = Concrete.IntType }, operations = [definition(ids, Concrete.ListType(Concrete.StringType)), Own.DefineValue({ id = ids.second, value_type = Concrete.IntType, operation = Own.IntegerDefinition(0), result = Own.UnmanagedResult, span = span(20) })], tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.second))) }
			match verify({ records = [], unions = [], functions = [entry], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }):
				Err(error): error.message == "ownership verification failed: entrypoint signature does not match its accepted argument and result conventions"
				Ok(_): False


pure func test_verifier_accepts_numeric_list_union_child() -> Bool:
	match nested_seed():
		Err(_): False
		Ok(seed):
			layout: Concrete.ConcreteUnion = { variants = [[Concrete.ListType(Concrete.IntType)]], representation = Concrete.InlineOwningPayload }
			verify({ records = [], unions = [layout], functions = [zero(seed.ids)], entrypoint = NoArguments(seed.ids.entrypoint, IntegerExitStatus) }).is_ok()


tests: TestSuite = {
	description = "Blorp 2 explicit List phase contracts",
	tests = [
		("prelude owns List identity", test_prelude_publishes_distinct_list_constructor_identity),
		("prelude requires List declaration", test_missing_list_constructor_has_exact_diagnostic),
		("List builtin declaration is unary", test_builtin_list_declaration_requires_exact_unary_arity),
		("checker publishes accepted argument convention", test_checker_accepts_argument_main_once),
		("List equality is structural", test_list_structural_equality_recurses_into_element),
		("generic List inference and substitution", test_generic_list_argument_infers_element_and_substitutes_result),
		("generic List length header carries rigid element", test_generic_list_length_header_carries_its_rigid_element),
		("generic List get header preserves result element", test_generic_list_get_header_preserves_its_result_element),
		("signature-only List prepares nested nominal elements", test_signature_only_list_prepares_nested_nominal_elements),
		("known concrete List substitution is accepted", test_concrete_list_element_known_by_substitution_is_accepted),
		("List cannot become a rigid parameter name", test_list_type_name_cannot_be_a_generic_parameter),
		("specialization carries ABI and owning List child", test_specialization_translates_accepted_entrypoint_and_list_layout),
		("entrypoint translates between distinct identity domains", test_entrypoint_translation_uses_its_instance_identity),
		("generic body specializes numeric List payload", test_specialization_accepts_list_element_known_only_inside_generic_body),
		("List nesting rejects growing generic recursion", test_list_nested_generic_dependency_growth_is_rejected_early),
		("lowering preserves List parameter", test_lowering_preserves_argument_borrow_type),
		("List root has a distinct ownership plan", test_list_root_has_separate_ownership_plan),
		("borrowed List return acquires then transfers", test_returning_borrowed_list_acquires_then_transfers_root),
		("verifier accepts independent acquired List return", test_verifier_independently_accepts_acquired_list_transfer),
		("verifier rejects unacquired List return", test_verifier_rejects_list_transfer_without_acquisition),
		("verifier rejects forged argument convention", test_verifier_rejects_forged_argument_convention),
		("nested List projection acquires and transfers", test_nested_list_payload_acquires_borrow_and_transfers_its_root),
		("verifier accepts independently acquired nested List", test_verifier_independently_accepts_acquired_nested_list_projection),
		("verifier rejects nested List without acquisition", test_verifier_rejects_nested_list_return_without_acquisition),
		("inline union dup and drop dispatch to List root", test_inline_list_union_acquisition_and_drop_emit_root_dispatch),
		("Option List cleanup covers Some and None", test_option_list_cleanup_dispatches_present_and_empty_cases),
		("verifier rejects nullary ABI for borrowed List", test_verifier_rejects_nullary_convention_for_borrowed_list_parameter),
		("verifier accepts numeric List union child", test_verifier_accepts_numeric_list_union_child),
		("verifier accepts numeric List in unused signature", test_verifier_accepts_numeric_list_in_unused_signature),
	]
}
