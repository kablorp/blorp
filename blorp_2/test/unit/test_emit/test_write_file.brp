import:
	../../../src/emit/emit: emit
	../../../src/own/own: own
	../../../src/utils/syntax: Diagnostic
	../../../src/verify/verify: verify
	../file_write_inputs: file_write_seed
	../module_input: test_base, TestFoundation
	./test_builtin_functions: emitted_sources
	test: TestSuite


-- Query has two parameters (ids0/1) and one Result (id2), with only this union.
private OK_VALUE: String = "((struct blorp_u_0){.tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=(uint8_t)0}})"
private ERR_VALUE: String = "((struct blorp_u_0){.tag=blorp_v_0_1,.payload.blorp_up_1={.blorp_uf_0=blorp_runtime_2}})"


private pure func emitted_write_file(foundation: TestFoundation) -> Result[String, Diagnostic]:
	seed ?= file_write_seed(foundation)
	owned ?= own(seed.lowered)
	verified ?= verify(owned)
	emit(verified)


pure func test_write_file_emits_one_call_with_distinct_payload_roles() -> Bool:
	match emitted_write_file(test_base()):
		Err(_): False
		Ok(code):
			(code.contains("struct blorp_string *blorp_runtime_2=NULL;")
				and code.split("=blorp_write_file(").length() == 2
				and code.contains("=blorp_write_file(blorp_vl_0,blorp_vl_1,&blorp_runtime_2);")
				and code.contains("blorp_runtime_2_ok?" + OK_VALUE + ":" + ERR_VALUE)
				and code.contains("blorp_union_drop_0(")
				and not code.contains("blorp_string_retain(blorp_runtime_")
				and not code.contains("blorp_string_release(blorp_runtime_"))


pure func test_reversed_result_uses_actual_tags_and_payloads() -> Bool:
	foundation = { test_base() | types = test_base().types.replace("    Ok(Value)\n    Err(Error)", "    Err(Error)\n    Ok(Value)") }
	match emitted_write_file(foundation):
		Err(_): False
		Ok(code):
			ok = OK_VALUE.replace("blorp_v_0_0", "blorp_v_0_1").replace("blorp_up_0", "blorp_up_1")
			error = ERR_VALUE.replace("blorp_v_0_1", "blorp_v_0_0").replace("blorp_up_1", "blorp_up_0")
			code.contains("blorp_runtime_2_ok?" + ok + ":" + error)


pure func test_unused_declaration_selects_no_helper() -> Bool:
	source: String =
		|func query(path: String, contents: String) -> Result[Void, String]:
		|    builtin("system.write_file")
		|func main() -> Int:
		|    0
		|
	match emitted_sources([{ source = source, targets = [] }]):
		Err(_): False
		Ok(code): not code.contains("blorp_write_file")


tests: TestSuite = {
	description = "Blorp 2 file-write C emission",
	tests = [
		("one call transfers only the Err scratch", test_write_file_emits_one_call_with_distinct_payload_roles),
		("reversed tags preserve Void/String roles", test_reversed_result_uses_actual_tags_and_payloads),
		("unused declaration selects no native fragment", test_unused_declaration_selects_no_helper),
	]
}
