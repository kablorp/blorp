import:
	../../../src/emit/emit: emit
	../../../src/own/own: own
	../../../src/utils/syntax: Diagnostic
	../../../src/verify/verify: verify
	../current_directory_inputs: current_directory_seed
	../module_input: TEST_BASE, TestFoundation
	./test_builtin_functions: emitted_sources
	test: TestSuite


-- This fixture instantiates only Result[String, String], whose first value is id 0.
private FIRST_PAYLOAD: String = "((struct blorp_u_0){.tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_runtime_0}})"
private SECOND_PAYLOAD: String = "((struct blorp_u_0){.tag=blorp_v_0_1,.payload.blorp_up_1={.blorp_uf_0=blorp_runtime_0}})"


private pure func emitted_directory(foundation: TestFoundation) -> Result[String, Diagnostic]:
	seed ?= current_directory_seed(foundation)
	owned ?= own(seed.lowered)
	verified ?= verify(owned)
	emit(verified)


pure func test_current_directory_emits_one_call_and_transfers_its_scratch() -> Bool:
	match emitted_directory(TEST_BASE):
		Err(_): False
		Ok(code):
			(
				code.split("=blorp_get_current_directory(").length() == 2
				and code.contains("blorp_runtime_0_ok?" + FIRST_PAYLOAD + ":" + SECOND_PAYLOAD)
				and code.contains("blorp_union_drop_0(")
				and not code.contains("blorp_string_retain(blorp_runtime_")
				and not code.contains("blorp_string_release(blorp_runtime_")
			)


pure func test_reversed_result_emits_the_actual_designated_tags() -> Bool:
	foundation = { TEST_BASE | types = TEST_BASE.types.replace(
		"    Ok(Value)\n    Err(Error)", "    Err(Error)\n    Ok(Value)",
	) }
	match emitted_directory(foundation):
		Err(_): False
		Ok(code): code.contains("blorp_runtime_0_ok?" + SECOND_PAYLOAD + ":" + FIRST_PAYLOAD)


pure func test_ignored_native_result_still_selects_string_runtime() -> Bool:
	source: String =
		|func query() -> Result[String, String]:
		|    builtin("system.get_current_directory")
		|func main() -> Int:
		|    unused = query()
		|    0
		|
	match emitted_sources([{ source = source, targets = [] }]):
		Err(_): False
		Ok(code):
			(
				code.contains("struct blorp_string {")
				and code.contains("=blorp_get_current_directory(")
				and code.contains("blorp_union_drop_0(")
			)


pure func test_unused_declaration_does_not_select_current_directory_helper() -> Bool:
	source: String =
		|func query() -> Result[String, String]:
		|    builtin("system.get_current_directory")
		|func main() -> Int:
		|    0
		|
	match emitted_sources([{ source = source, targets = [] }]):
		Err(_): False
		Ok(code): not code.contains("blorp_get_current_directory")


tests: TestSuite = {
	description = "Blorp 2 current-directory C emission",
	tests = [
		("normal tags transfer one fresh scratch", test_current_directory_emits_one_call_and_transfers_its_scratch),
		("reversed tags retain designated roles", test_reversed_result_emits_the_actual_designated_tags),
		("ignored native result selects String ABI", test_ignored_native_result_still_selects_string_runtime),
		("unused declaration selects no native helper", test_unused_declaration_does_not_select_current_directory_helper),
	]
}
