import:
	../../../src/runtime/string: STRING_SLICE_RUNTIME
	../string_slice_inputs: SLICE_DECLARATION
	./test_builtin_functions: emitted_sources
	test: TestSuite


pure func test_slice_emits_one_helper_call_and_transfers_scratch() -> Bool:
	wrapper: String =
		|pure func wrapper(value: String) -> Option[String]:
		|    slice_text(value, 0, 2)
		|func main() -> Int:
		|    unused = wrapper("é")
		|    0
		|
	match emitted_sources([{ source = SLICE_DECLARATION + wrapper, targets = [] }]):
		Err(_): False
		Ok(code):
			(
				code.contains(STRING_SLICE_RUNTIME)
				and code.split("uint8_t blorp_string_slice(").length() == 2
				and code.split("=blorp_string_slice(").length() == 2
				and code.contains("struct blorp_string *blorp_runtime_3=NULL;const uint8_t blorp_runtime_3_some=blorp_string_slice(blorp_vl_0,blorp_vl_1,blorp_vl_2,&blorp_runtime_3);")
				and not code.contains("blorp_string_retain(blorp_runtime_3)")
				and not code.contains("blorp_string_release(blorp_runtime_3)")
			)


pure func test_unused_slice_declaration_emits_no_helper() -> Bool:
	match emitted_sources([{ source = SLICE_DECLARATION + "func main() -> Int:\n    0\n", targets = [] }]):
		Err(_): False
		Ok(code): not code.contains("blorp_string_slice")


tests: TestSuite = {
	description = "Blorp 2 String slice emission",
	tests = [
		("ordinary wrapper reaches one helper and transfers its scratch once", test_slice_emits_one_helper_call_and_transfers_scratch),
		("unused slice declaration emits no fragment", test_unused_slice_declaration_emits_no_helper),
	]
}
