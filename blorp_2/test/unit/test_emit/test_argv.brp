import:
	../compilation: compile, compile_modules
	../module_input: STRING_OPERATIONS, TEST_BASE
	test: TestSuite


private ARGUMENT_PREFIX: String =
	"int main(int argc,char **argv){struct blorp_l_0_s *const blorp_arguments=blorp_list_from_argv(argc,argv);if(blorp_arguments==NULL){fputs(\"error: command-line argument is not valid UTF-8\\nhelp: pass UTF-8 encoded arguments\\n\",stderr);return 1;}"


pure func test_int_main_rejects_before_call_and_releases_success() -> Bool:
	source: String =
		|func main(arguments: List[String]) -> Int:
		|    17
		|

	match compile(source):
		Err(_): False
		Ok(output):
			output.ends_with(ARGUMENT_PREFIX +
				"const int64_t blorp_result=blorp_f_0(blorp_arguments);blorp_list_drop_0_s(blorp_arguments);return (int)blorp_result;}\n")


pure func test_void_main_rejects_before_call_and_releases_success() -> Bool:
	source: String =
		|func main(arguments: List[String]) -> Void:
		|    void
		|

	match compile(source):
		Err(_): False
		Ok(output):
			output.ends_with(ARGUMENT_PREFIX +
				"(void)blorp_f_0(blorp_arguments);blorp_list_drop_0_s(blorp_arguments);return 0;}\n")


pure func test_no_argument_int_main_retains_its_projection() -> Bool:
	source: String =
		|func main() -> Int:
		|    17
		|

	match compile(source):
		Err(_): False
		Ok(output):
			(output.ends_with("int main(void){return (int)blorp_f_0();}\n")
				and not output.contains("blorp_list_from_argv")
				and not output.contains("blorp_utf8_is_valid"))


pure func test_no_argument_void_main_retains_its_projection() -> Bool:
	source: String =
		|func main() -> Void:
		|    void
		|

	match compile(source):
		Err(_): False
		Ok(output):
			(output.ends_with("int main(void){(void)blorp_f_0();return 0;}\n")
				and not output.contains("blorp_list_from_argv")
				and not output.contains("blorp_utf8_is_valid"))


pure func test_string_main_without_arguments_has_only_the_string_family() -> Bool:
	source: String =
		|import:
		|    string: length
		|func main() -> Int:
		|    "é".length()
		|

	match compile_modules([
		{ source = source, targets = [1] },
		{ source = STRING_OPERATIONS, targets = [] },
	], TEST_BASE):
		Err(_): False
		Ok(output):
			(output.contains("uint8_t blorp_utf8_is_valid(const char *bytes,size_t length)")
				and output.contains("=blorp_string_length(")
				and output.ends_with("int main(void){return (int)blorp_f_0();}\n")
				and not output.contains("blorp_list_from_argv")
				and not output.contains("command-line argument is not valid UTF-8"))


tests: TestSuite = {
	description = "Blorp 2 argv admission wrapper",
	tests = [
		("Int wrapper rejects before language call and preserves success", test_int_main_rejects_before_call_and_releases_success),
		("Void wrapper rejects before language call and preserves success", test_void_main_rejects_before_call_and_releases_success),
		("no-argument Int main retains its projection", test_no_argument_int_main_retains_its_projection),
		("no-argument Void main retains its projection", test_no_argument_void_main_retains_its_projection),
		("String family remains unconditional without argv", test_string_main_without_arguments_has_only_the_string_family),
	]
}
