import:
	../../../src/utils/names: program_names
	../../../src/emit/emit: aggregate_runtime, emit
	../../../src/lex/lex: lex
	../../../src/lower/lower: lower
	../../../src/own/own: own
	../../../src/utils/source: module_source, root_module_id
	../../../src/specialize/specialize: specialize
	../../../src/utils/syntax: Diagnostic
	../../../src/verify/verify: VerifiedProgram, verify
	../input: check, parse, setup_diagnostic
	test: TestSuite


private pure func verified(source: String) -> Result[VerifiedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	checked ?= check(parsed).map_err(setup_diagnostic)
	lowered ?= specialize(checked).and_then(pure func(program): lower(program))
	owned ?= own(lowered)
	verify(owned)


private pure func emitted(source: String) -> Result[String, Diagnostic]:
	verified(source).and_then(emit)


pure func test_nominal_struct_layout_and_by_value_signature() -> Bool:
	source: String =
		|fixed record Pair { first: Int, second: Int }
		|fixed record Other { first: Int, second: Int }
		|pure func make_pair() -> Pair:
		|	{ first = 1, second = 2 }
		|pure func make() -> Other:
		|	{ second = 9, first = 7 }
		|pure func read(value: Other) -> Int:
		|	value.first
		|func main() -> Int:
		|	unused = make_pair()
		|	read(make())
		|

	match emitted(source):
		Err(_):
			False
		Ok(code):
			(
				code.contains("struct blorp_r_0{int64_t blorp_rf_0_0;int64_t blorp_rf_0_1;};")
				and code.contains("struct blorp_r_1{int64_t blorp_rf_1_0;int64_t blorp_rf_1_1;};")
				and code.contains("blorp_r_0 blorp_f_1(void);")
				and code.contains("int64_t blorp_f_3(blorp_r_1 blorp_p_0);")
				and code.contains("const int64_t blorp_vl_0=INT64_C(9);")
				and code.contains("const int64_t blorp_vl_1=INT64_C(7);")
				and code.contains(
					"((struct blorp_r_1){.blorp_rf_1_1=blorp_vl_0,.blorp_rf_1_0=blorp_vl_1})",
				)
				and code.contains("blorp_vl_0.blorp_rf_1_0")
				and not code.contains("=blorp_memory_allocate(")
				and not code.contains("retain")
				and code.contains("void blorp_record_drop_0(blorp_r_0 value){(void)value;}")
				and code.contains("void blorp_record_drop_1(blorp_r_1 value){(void)value;}")
			)


pure func test_full_width_record_literals_use_portable_c_constants() -> Bool:
	source: String =
		|fixed record Pair { first: Int, second: Int }
		|pure func make() -> Pair:
		|	{ first = -9223372036854775808, second = 9223372036854775807 }
		|func main() -> Int:
		|	unused = make()
		|	0
		|

	match emitted(source):
		Err(_):
			False
		Ok(code):
			(
				code.contains("const int64_t blorp_vl_0=INT64_MIN;")
				and code.contains("const int64_t blorp_vl_1=INT64_C(9223372036854775807);")
				and code.contains("const blorp_r_0 blorp_vl_0=blorp_f_1();")
			)


pure func test_final_release_visits_both_stored_occurrences_and_frees_root_once() -> Bool:
	source: String =
		|fixed record Pair { left: String, right: String }
		|pure func make() -> Pair:
		|	text = "42"
		|	{ left = text, right = text }
		|func main() -> Int:
		|	unused = make()
		|	0
		|

	match verified(source).and_then(aggregate_runtime):
		Ok(code):
			code.contains((
					"void blorp_record_dup_0(blorp_r_0 value){(void)atomic_fetch_add_explicit(&value-"
					+ ">references,UINT64_C(1),memory_order_relaxed);}"
				)) and code.contains((
					"void blorp_record_drop_0(blorp_r_0 value){if(atomic_fetch_sub_explicit(&value-"
					+ ">references,UINT64_C(1),memory_order_acq_rel)!=UINT64_C(1))return;"
					+ "blorp_string_release(value->blorp_rf_0_0);blorp_string_release(value-"
					+ ">blorp_rf_0_1);blorp_memory_release(value);}"
				)) and code.contains(
				"value->blorp_rf_0_0=fields.blorp_rf_0_0;value->blorp_rf_0_1=fields.blorp_rf_0_1;",
			)
		Err(_):
			False


pure func test_void_record_root_uses_atomic_headers_without_string_runtime() -> Bool:
	source: String =
		|fixed record Unit { empty: Void }
		|pure func make() -> Unit:
		|	{ empty = void }
		|func main() -> Int:
		|	unused = make()
		|	0
		|

	match emitted(source):
		Ok(code):
			(
				code.contains("#include <stdlib.h>\n#include <stdatomic.h>\n")
				and code.contains("uint8_t blorp_rf_0_0;")
				and code.contains("memory_order_acq_rel)!=UINT64_C(1))return;blorp_memory_release(value);}")
				and not code.contains("blorp_string_from_bytes")
			)
		Err(_):
			False


pure func test_record_union_definition_dependencies_are_ordered() -> Bool:
	source: String =
		|fixed union Box[T]:
		|	Full(T)
		|fixed record Inner { number: Int }
		|fixed record Outer { boxed: Box[Inner] }
		|pure func inner() -> Inner:
		|	{ number = 7 }
		|pure func outer() -> Outer:
		|	{ boxed = Full(inner()) }
		|func main() -> Int:
		|	unused = outer()
		|	0
		|

	match verified(source).and_then(aggregate_runtime):
		Ok(code):
			match (
				code.index_of("struct blorp_r_0{"),
				code.index_of("struct blorp_u_0{"),
				code.index_of("struct blorp_r_1{"),
			):
				(Some(inner), Some(boxed), Some(outer)):
					inner < boxed and boxed < outer
				_:
					False
		Err(_):
			False


pure func test_no_aggregate_fragment_is_empty() -> Bool:
	match verified("func main() -> Int:\n\t0\n").and_then(aggregate_runtime):
		Ok(code):
			code == ""
		Err(_):
			False


tests: TestSuite = {
	description = "Fixed record C emission",
	tests = [
		(
			"final release destroys every occurrence once",
			test_final_release_visits_both_stored_occurrences_and_frees_root_once,
		),
		(
			"Void root uses atomic headers without String runtime",
			test_void_record_root_uses_atomic_headers_without_string_runtime,
		),
		(
			"mixed definition dependencies are ordered",
			test_record_union_definition_dependencies_are_ordered,
		),
		("empty aggregate fragment", test_no_aggregate_fragment_is_empty),
		(
			"nominal struct layout and by value calls",
			test_nominal_struct_layout_and_by_value_signature,
		),
		(
			"portable full width fields and unused initializer",
			test_full_width_record_literals_use_portable_c_constants,
		),
	]
}
