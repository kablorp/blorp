			)


pure func test_repeated_borrows_emit_no_redundant_retain_or_release() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			emits_owned_program(
				{
					records = [],
					unions = [],
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [
						main_function(
							[
								integer_definition(ids.first, 7, 10),
								string_definition(ids.second, ids.first, 0, 20),
								length_definition(ids.third, ids.second, 0, 30),
								length_definition(ids.fourth, ids.second, 0, 40),
								DropOwner(owner_id(0), span(50)),
							],
							ids.fourth,
						),
					]
				},
				(
					"int64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t "
					+ "blorp_vl_0=INT64_C(7);(void)blorp_vl_0;struct blorp_string* const "
					+ "blorp_vl_1=blorp_int_to_string(blorp_vl_0);(void)blorp_vl_1;struct "
					+ "blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;const int64_t "
					+ "blorp_vl_2=blorp_string_length(blorp_vl_1);(void)blorp_vl_2;const int64_t "
					+ "blorp_vl_3=blorp_string_length(blorp_vl_1);(void)blorp_vl_3;"
					+ "blorp_string_release(blorp_owner_0);return blorp_vl_3;}\n"
				) + "static int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n",
			)


pure func test_user_call_establishes_result_owner_before_releasing_argument_owner() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			called = DefineValue({
				id = ids.third,
				value_type = StringType,
				operation = CallDefinition(
					UserFunction(ids.second_function),
					[BorrowedArgument({
							value = ids.second,
							source = OwnerBorrow(owner_id(0)),
						})],
				),
				result = OwnedResult(owner_id(1)),
				span = span(30),
			})
			emits_owned_program(
				{
					records = [],
					unions = [],
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [
						main_function(
							[
								integer_definition(ids.first, 7, 10),
								string_definition(ids.second, ids.first, 0, 20),
								called,
								DropOwner(owner_id(0), span(40)),
								length_definition(ids.fourth, ids.third, 1, 50),
								DropOwner(owner_id(1), span(60)),
							],
							ids.fourth,
						),
						borrowed_identity(ids),
					]
				},
				(
					"int64_t blorp_f_0(void);struct blorp_string* blorp_f_1(struct blorp_string* "
					+ "blorp_p_0);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(7);"
					+ "(void)blorp_vl_0;struct blorp_string* const blorp_vl_1=blorp_int_to_string(blorp"
					+ "_vl_0);(void)blorp_vl_1;struct blorp_string* const blorp_owner_0=blorp_vl_1;"
					+ "(void)blorp_owner_0;struct blorp_string* const blorp_vl_2=blorp_f_1(blorp_vl_1);"
					+ "(void)blorp_vl_2;struct blorp_string* const blorp_owner_1=blorp_vl_2;"
					+ "(void)blorp_owner_1;blorp_string_release(blorp_owner_0);const int64_t "
					+ "blorp_vl_3=blorp_string_length(blorp_vl_2);(void)blorp_vl_3;"
					+ "blorp_string_release(blorp_owner_1);return blorp_vl_3;}\nstruct blorp_string* "
					+ "blorp_f_1(struct blorp_string* blorp_p_0){struct blorp_string* const "
					+ "blorp_vl_0=blorp_p_0;(void)blorp_vl_0;blorp_string_retain(blorp_vl_0);struct "
					+ "blorp_string* const blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;return "
					+ "blorp_owner_0;}\n"
				) + "static int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n",
			)


pure func test_raw_managed_match_transfers_inside_cases_and_caller_drops() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			main: OwnedFunction = {
				signature = {
					parameters = [],
					return_type = IntType
				},
				operations = [
					DefineValue({
						id = ids.first,
						value_type = StringType,
						operation = CallDefinition(
							UserFunction(ids.second_function),
							[],
						),
						result = OwnedResult(owner_id(0)),
						span = span(10),
					}),
					length_definition(ids.second, ids.first, 0, 20),
					DropOwner(owner_id(0), span(20)),
				],
				result = UnmanagedReturn(ids.second)
			}
			helper: OwnedFunction = {
				signature = {
					parameters = [],
					return_type = StringType
				},
				operations = [DefineValue({
						id = ids.first,
						value_type = UnionType(ids.union_id),
						operation = ConstructDefinition(ids.second_variant, []),
						result = UnmanagedResult,
						span = span(10),
					}), integer_definition(ids.second, 7, 20), ExecuteJoin({
					result = ManagedJoinParameter({ id = ids.third, value_type = StringType, span = span(30) }, owner_id(0)),
					carried = [],
					entering = [],
					selection = Selection.branches(UnmanagedArgument(ids.first), ids.second_variant),
					arms = [
						{
							id = Model.match_arm_id(0), inputs = [],
							operations = [string_definition(ids.fourth, ids.second, 1, 30)],
							exit = Own.Yield({ transfer = OwnedReturn(ids.fourth, owner_id(1)), carried = [] })
						},
						{
							id = Model.match_arm_id(1), inputs = [],
							operations = [string_definition(ids.fifth, ids.second, 2, 40)],
							exit = Own.Yield({ transfer = OwnedReturn(ids.fifth, owner_id(2)), carried = [] })
						},
					],
				})],
				result = OwnedReturn(ids.third, owner_id(0))
			}
			emits_owned_program(
				{
					records = [],
					unions = ids.unions,
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [main, helper]
				},
				(
					"enum blorp_u_0{blorp_v_0_0,blorp_v_0_1};int64_t blorp_f_0(void);struct blorp_string* "
					+ "blorp_f_1(void);int64_t blorp_f_0(void){struct blorp_string* const "
					+ "blorp_vl_0=blorp_f_1();(void)blorp_vl_0;struct blorp_string* const "
					+ "blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;const int64_t blorp_vl_1=blorp_string_length(bl"
					+ "orp_vl_0);(void)blorp_vl_1;blorp_string_release(blorp_owner_0);return blorp_vl_1;}\nstruct "
					+ "blorp_string* blorp_f_1(void){const enum blorp_u_0 "
					+ "blorp_vl_0=blorp_v_0_1;(void)blorp_vl_0;const int64_t "
					+ "blorp_vl_1=INT64_C(7);(void)blorp_vl_1;struct blorp_string* "
					+ "blorp_vl_2;goto blorp_selection_2_node_2;blorp_selection_2_node_0:{goto blorp_selection_2_arm_0;}blorp_selection_2_node_1:{goto blorp_selection_2_arm_1;}blorp_selection_2_node_2:{if(blorp_vl_0==blorp_v_0_1)goto blorp_selection_2_node_0;goto blorp_selection_2_node_1;}blorp_selection_2_arm_0:{struct blorp_string* const "
					+ "blorp_vl_3=blorp_int_to_string(blorp_vl_1);(void)blorp_vl_3;struct blorp_string* const "
					+ "blorp_owner_1=blorp_vl_3;(void)blorp_owner_1;blorp_vl_2=blorp_owner_1;goto blorp_selection_2_done;}blorp_selection_2_arm_1:{struct"
					+ " blorp_string* const blorp_vl_4=blorp_int_to_string(blorp_vl_1);(void)blorp_vl_4;struct "
					+ "blorp_string* const blorp_owner_2=blorp_vl_4;(void)blorp_owner_2;blorp_vl_2=blorp_owner_2;goto blorp_selection_2_done;}blorp_selection_2_done:;(void)blorp_vl_2;struct blorp_string* const "
					+ "blorp_owner_0=blorp_vl_2;(void)blorp_owner_0;return blorp_owner_0;}\nstatic int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint main(void){blorp_memory_start();return blorp_program_finish("
					+ "(int)blorp_f_0());}\n"
				),
			)

pure func test_arm_only_string_work_emits_runtime_and_exact_cleanup() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			main: OwnedFunction = {
				signature = {
					parameters = [],
					return_type = IntType
				},
				operations = [DefineValue({
						id = ids.first,
						value_type = UnionType(ids.union_id),
						operation = ConstructDefinition(ids.second_variant, []),
						result = UnmanagedResult,
						span = span(10),
					}), integer_definition(ids.second, 7, 20), ExecuteJoin({
					result = UnmanagedJoinParameter({ id = ids.third, value_type = IntType, span = span(30) }),
					carried = [],
					entering = [],
					selection = Selection.direct(UnmanagedArgument(ids.first)),
					arms = [
						{
							id = Model.match_arm_id(0), inputs = [],
							operations = [
								string_definition(ids.fourth, ids.second, 0, 30),
								DropOwner(owner_id(0), span(30)),
							],
							exit = Own.Yield({ transfer = UnmanagedReturn(ids.second), carried = [] })
						},
					],
				})],
				result = UnmanagedReturn(ids.third)
			}
			emits_owned_program(
				{
					records = [],
					unions = ids.unions,
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [main]
				},
				(
					"enum blorp_u_0{blorp_v_0_0,blorp_v_0_1};int64_t blorp_f_0(void);int64_t "
					+ "blorp_f_0(void){const enum blorp_u_0 blorp_vl_0=blorp_v_0_1;(void)blorp_vl_0;const int64_t "
					+ "blorp_vl_1=INT64_C(7);(void)blorp_vl_1;int64_t blorp_vl_2;goto blorp_selection_2_node_0;blorp_selection_2_node_0:{goto blorp_selection_2_arm_0;}blorp_selection_2_arm_0:{struct"
					+ " blorp_string* const blorp_vl_3=blorp_int_to_string(blorp_vl_1);(void)blorp_vl_3;struct "
					+ "blorp_string* const blorp_owner_0=blorp_vl_3;(void)blorp_owner_0;blorp_string_release(blorp_"
					+ "owner_0);blorp_vl_2=blorp_vl_1;goto blorp_selection_2_done;}blorp_selection_2_done:;(void)blorp_vl_2;return blorp_vl_2;}\nstatic int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint "
					+ "main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n"
				),
			)

pure func test_zero_header_loop_has_storage_and_a_shared_return() -> Bool:
	source =
		|@tail_recursive pure func spin() -> Int:
		|	spin()
		|func main() -> Int:
		|	spin()
		|
	expected = (
		MEMORY_RUNTIME + "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_1(void);"
		+ "int64_t blorp_f_0(void){const int64_t blorp_vl_0=blorp_f_1();(void)blorp_vl_0;return blorp_vl_0;}\n"
		+ "int64_t blorp_f_1(void){int64_t blorp_vl_0;goto blorp_loop_0_header;blorp_loop_0_header:{goto blorp_loop_0_header;}goto blorp_loop_0_break;blorp_loop_0_break:;(void)blorp_vl_0;return blorp_vl_0;}\n"
		+ "static int blorp_program_finish(int status){return blorp_memory_finish(status);}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n"
	)
	emitted_minimal(source).get_or("") == expected


pure func test_loop_managed_output_acquires_before_retirement_and_publication() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			caller = main_function([
				DefineValue({
					id = ids.first,
					value_type = StringType,
					operation = CallDefinition(UserFunction(ids.second_function), []),
					result = OwnedResult(owner_id(0)),
					span = span(10),
				}),
				length_definition(ids.second, ids.first, 0, 20),
				DropOwner(owner_id(0), span(20)),
			], ids.second)
			helper: OwnedFunction = {
				signature = { parameters = [], return_type = StringType },
				operations = [Own.ExecuteLoop({
					entry_acquisitions = [],
					headers = [],
					result = ManagedJoinParameter({ id = ids.first, value_type = StringType, span = span(10) }, owner_id(0)),
					carried = [],
					body = {
						operations = [
							integer_definition(ids.second, 7, 20),
							string_definition(ids.third, ids.second, 1, 30),
							AcquireOwner(owner_id(2), { value = ids.third, source = OwnerBorrow(owner_id(1)) }, span(40)),
							DropOwner(owner_id(1), span(40)),
						],
						tail = Own.ExitLoop(Own.Break({ value = OwnedReturn(ids.third, owner_id(2)), carried = [], span = span(40) })),
					},
				})],
				result = OwnedReturn(ids.first, owner_id(0)),
			}
			expected = (
				"int64_t blorp_f_0(void);struct blorp_string* blorp_f_1(void);int64_t "
				+ "blorp_f_0(void){struct blorp_string* const "
				+ "blorp_vl_0=blorp_f_1();(void)blorp_vl_0;struct blorp_string* const "
				+ "blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;const int64_t blorp_vl_1=blorp_string_lengt"
				+ "h(blorp_vl_0);(void)blorp_vl_1;blorp_string_release(blorp_owner_0);return "
				+ "blorp_vl_1;}\nstruct blorp_string* blorp_f_1(void){struct blorp_string* blorp_vl_0;goto blorp_loop_0_header;"
				+ "blorp_loop_0_header:{const int64_t blorp_vl_1=INT64_C(7);(void)blorp_vl_1;struct blorp_string* const "
				+ "blorp_vl_2=blorp_int_to_string(blorp_vl_1);(void)blorp_vl_2;struct blorp_string* const "
				+ "blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;blorp_string_retain(blorp_vl_2);struct "
				+ "blorp_string* const blorp_owner_2=blorp_vl_2;(void)blorp_owner_2;blorp_string_release(bl"
				+ "orp_owner_1);struct blorp_string* const blorp_loop_0_transfer_0=blorp_owner_2;"
				+ "blorp_vl_0=blorp_loop_0_transfer_0;goto blorp_loop_0_break;}goto blorp_loop_0_break;"
				+ "blorp_loop_0_break:;(void)blorp_vl_0;struct blorp_string* const"
				+ " blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;return blorp_owner_0;}\nstatic int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint "
				+ "main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n"
			)
			emits_owned_program({ records = [], unions = [], functions = [caller, helper], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }, expected)

pure func test_named_callback_uses_the_existing_direct_string_abi() -> Bool:
	match emitted(NAMED_CALLBACK_SOURCE):
		Err(_): False
		Ok(code): callback_uses_the_existing_direct_string_abi(code)


private pure func callback_uses_the_existing_direct_string_abi(code: String) -> Bool:
	(
		code.contains("struct blorp_string* blorp_f_1(struct blorp_string* blorp_p_0);")
		and code.contains("struct blorp_string* blorp_f_2(struct blorp_string* blorp_p_0);")
		and code.contains(
			"struct blorp_string* blorp_f_1(struct blorp_string* blorp_p_0){"
			+ "struct blorp_string* const blorp_vl_0=blorp_p_0;(void)blorp_vl_0;"
			+ "blorp_string_retain(blorp_vl_0);struct blorp_string* const blorp_owner_0=blorp_vl_0;"
			+ "(void)blorp_owner_0;return blorp_owner_0;}"
		)
		and code.contains("struct blorp_string* const blorp_vl_1=blorp_f_1(blorp_vl_0);")
	)


pure func test_lambda_uses_the_existing_direct_string_abi() -> Bool:
	match emitted(NONCAPTURING_CALLBACK_SOURCE):
		Err(_): False
		Ok(code):
			(
				callback_uses_the_existing_direct_string_abi(code)
				and code.contains("int64_t blorp_f_0(void);")
				and not code.contains("blorp_p_1") and not code.contains("(*")
				and not code.contains("struct blorp_r_") and not code.contains("struct blorp_u_")
			)


tests: TestSuite = {
	description = "Blorp 2 C emission",
	tests = [
		("lambda uses direct String ABI without callable or environment parameters", test_lambda_uses_the_existing_direct_string_abi),
		("named callback uses ordinary String ABI and direct selected target", test_named_callback_uses_the_existing_direct_string_abi),
		("zero-header loop has separate storage and shared return", test_zero_header_loop_has_storage_and_a_shared_return),
		("managed loop output acquires before retirement and publication", test_loop_managed_output_acquires_before_retirement_and_publication),
		(
			"mixed call arguments preserve order and value identity",
			test_mixed_call_arguments_preserve_order_and_value_identity,
		),
		(
			"raw managed match transfers and caller cleanup",
			test_raw_managed_match_transfers_inside_cases_and_caller_drops,
		),
		(
			"arm-only Strings emit runtime and cleanup",
			test_arm_only_string_work_emits_runtime_and_exact_cleanup,
		),
		(
			"acquire retains the value before old-owner drop and transfer",
			test_acquire_emits_value_retain_before_old_owner_drop_and_transfer,
		),
		(
			"independent drops release each exact owner once",
			test_independent_owner_drops_emit_each_exact_operand_once,
		),
		(
			"unused result releases immediately without retain",
			test_unused_owned_result_emits_immediate_release_without_retain,
		),
		(
			"repeated borrows introduce no redundant ARC calls",
			test_repeated_borrows_emit_no_redundant_retain_or_release,
		),
		(
			"user call establishes result owner before argument release",
			test_user_call_establishes_result_owner_before_releasing_argument_owner,
		),
		(
			"verified operations emit allocation, borrow, drop",
			test_verified_operations_emit_allocation_borrow_then_drop,
		),
		(
			"borrowed return emits retain and owner transfer",
			test_borrowed_parameter_return_emits_retain_and_owner_transfer,
		),
		(
			"block arm emits ordered locals inside shared body",
			test_block_arm_emits_ordered_locals_inside_shared_body,
		),
		(
			"payload match projects on edge and enters shared body",
			test_payload_match_projects_on_edge_and_enters_shared_body,
		),
		(
			"scalar wildcard reads scrutinee in shared body",
			test_scalar_wildcard_reads_scrutinee_in_shared_body,
		),
		(
			"nominal enums, constructors and unused parameter",
			test_nominal_enum_types_constructors_and_unused_parameters,
		),
		("compact C from ordered program", test_compact_c_from_ordered_program),
		("portable signed C literals", test_portable_signed_c_literals),
	]
}


-- Formatting assertions isolate emission from the separately tested default scope.
private pure func emitted_minimal(source: String) -> Result[String, Diagnostic]:
	parsed ?= parse_modules_with_base([
		{ source = source, targets = [] },
	], primitive_base())
	checked ?= check(parsed).map_err(setup_diagnostic)
	lowered ?= specialize(checked).and_then(pure func(program): lower(program))
	owned ?= own(lowered)
	verified ?= verify(owned)
	emit(verified)
