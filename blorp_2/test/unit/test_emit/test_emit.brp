import:
	../../../src/check/model as Model
	../test_verify/selection_inputs as Selection
	../../../src/runtime/memory: MEMORY_RUNTIME
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/emit/emit: emit
	../../../src/lex/lex: lex
	../../../src/lower/lower: ValueId, lower
	../../../src/own/own as Own:
		BorrowSource(ParameterBorrow, OwnerBorrow),
		OwnedArgument(UnmanagedArgument, BorrowedArgument),
		OwnedFunction,
		OwnedJoinParameter(UnmanagedJoinParameter, ManagedJoinParameter),
		OwnedValueOperation(
			ParameterDefinition, IntegerDefinition, CallDefinition, ConstructDefinition,
		),
		OwnershipOperation(DefineValue, ExecuteJoin, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		own,
		owner_id,
	../../../src/namespace/builtins as Builtins: RuntimeOperation(IntToString, StringLength)
	../../../src/specialize/specialize:
		CallTarget(RuntimeFunction, UserFunction),
		TypeRef(IntType, StringType, UnionType),
		specialize,
	../../../src/runtime/string: string_runtime
	../../../src/utils/syntax: Diagnostic, Entrypoint(NoArguments), EntryResult(IntegerExitStatus), entry_function
	../../../src/verify/verify: verify
	../input: check, parse, setup_diagnostic
	../module_input: primitive_base, parse_modules_with_base, ModuleInput, INTEGER_OPERATIONS
	../managed_union_inputs: NAMED_CALLBACK_SOURCE, NONCAPTURING_CALLBACK_SOURCE
	../ownership_inputs: InputIds, input_ids, span
	result: get_or
	test: TestSuite


pure func test_compact_c_from_ordered_program() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|
	emitted_minimal(source).get_or(
		"",
	) == MEMORY_RUNTIME + "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return blorp_vl_0;}\nstatic int blorp_program_finish(int status){return blorp_memory_finish(status);}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n"


private pure func emits_literal(spelling: String, expected: String) -> Result[Bool, Diagnostic]:
	parsed ?= parse_modules_with_base([
		{ source = "func main() -> Int:\n\t" + spelling + "\n", targets = [] },
	], primitive_base())
	checked ?= check(parsed).map_err(setup_diagnostic)
	lowered ?= specialize(checked).and_then(pure func(program): lower(program))
	owned ?= own(lowered)
	verified ?= verify(owned)
	Ok(
		emit(
			verified,
		).get_or(
			"",
		) == MEMORY_RUNTIME + "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=" + expected + ";(void)blorp_vl_0;return blorp_vl_0;}\nstatic int blorp_program_finish(int status){return blorp_memory_finish(status);}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n",
	)


pure func test_portable_signed_c_literals() -> Bool:
	(
		emits_literal("-42", "(-INT64_C(42))").get_or(False)
		and emits_literal("-0", "INT64_C(0)").get_or(False)
		and emits_literal("9223372036854775807", "INT64_C(9223372036854775807)").get_or(False)
		and emits_literal("-9223372036854775808", "INT64_MIN").get_or(False)
	)


private pure func emits_nominal_unions() -> Result[Bool, Diagnostic]:
	source: String =
		|fixed union Choice:
		|	First
		|	Second
		|fixed union Other:
		|	Alpha
		|	Beta
		|pure func unused(value: Choice) -> Other:
		|	Beta
		|func main() -> Int:
		|	result = unused(First)
		|	0
		|
	lexed ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(lexed)
	checked ?= check(parsed).map_err(setup_diagnostic)
	lowered ?= specialize(checked).and_then(pure func(program): lower(program))
	owned ?= own(lowered)
	verified ?= verify(owned)
	Ok(
		emit(
			verified,
		).get_or(
			"",
		) == MEMORY_RUNTIME + "#include <stdint.h>\nenum blorp_u_0{blorp_v_0_0,blorp_v_0_1};\nenum blorp_u_1{blorp_v_1_0,blorp_v_1_1};int64_t blorp_f_0(void);enum blorp_u_0 blorp_f_1(enum blorp_u_1 blorp_p_0);int64_t blorp_f_0(void){const enum blorp_u_1 blorp_vl_0=blorp_v_1_0;(void)blorp_vl_0;const enum blorp_u_0 blorp_vl_1=blorp_f_1(blorp_vl_0);(void)blorp_vl_1;const int64_t blorp_vl_2=INT64_C(0);(void)blorp_vl_2;return blorp_vl_2;}\nenum blorp_u_0 blorp_f_1(enum blorp_u_1 blorp_p_0){const enum blorp_u_1 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;const enum blorp_u_0 blorp_vl_1=blorp_v_0_1;(void)blorp_vl_1;return blorp_vl_1;}\nstatic int blorp_program_finish(int status){return blorp_memory_finish(status);}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n",
	)


pure func test_nominal_enum_types_constructors_and_unused_parameters() -> Bool:
	emits_nominal_unions().get_or(False)


private pure func emitted(source: String) -> Result[String, Diagnostic]:
	input ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(input)
	checked ?= check(parsed).map_err(setup_diagnostic)
	lowered ?= specialize(checked).and_then(pure func(program): lower(program))
	owned ?= own(lowered)
	verified ?= verify(owned)
	emit(verified)


private pure func emitted_modules(inputs: List[ModuleInput]) -> Result[String, Diagnostic]:
	parsed ?= parse_modules_with_base(inputs, primitive_base())
	checked ?= check(parsed).map_err(setup_diagnostic)
	lowered ?= specialize(checked).and_then(pure func(program): lower(program))
	owned ?= own(lowered)
	verified ?= verify(owned)
	emit(verified)


pure func test_mixed_call_arguments_preserve_order_and_value_identity() -> Bool:
	source: String =
		|import:
		|	int: Int methods
		|pure func choose(first: String, second: Int, third: String, fourth: Int) -> Int:
		|	fourth
		|func main() -> Int:
		|	choose(7.to_string(), 11, 9.to_string(), 13)
		|

	match emitted_modules([
		{ source = source, targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(code):
			code.contains(
				"const int64_t blorp_vl_6=blorp_f_2(blorp_vl_1,blorp_vl_2,blorp_vl_4,blorp_vl_5);",
			)


pure func test_payload_match_projects_on_edge_and_enters_shared_body() -> Bool:
	source: String =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Empty: 0
		|		Number(number): number
		|func main() -> Int:
		|	unwrap(Number(42))
		|
	emitted(
		source,
	).get_or(
		"",
	) == MEMORY_RUNTIME + "#include <stdint.h>\nenum blorp_tag_0{blorp_v_0_0,blorp_v_0_1};struct blorp_u_0{enum blorp_tag_0 tag;union{struct{int64_t blorp_uf_0;} blorp_up_1;}payload;};int64_t blorp_f_0(void);int64_t blorp_f_1(struct blorp_u_0 blorp_p_0);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(42);(void)blorp_vl_0;const struct blorp_u_0 blorp_vl_1=((struct blorp_u_0){.tag=blorp_v_0_1,.payload.blorp_up_1={.blorp_uf_0=blorp_vl_0}});(void)blorp_vl_1;const int64_t blorp_vl_2=blorp_f_1(blorp_vl_1);(void)blorp_vl_2;return blorp_vl_2;}\nint64_t blorp_f_1(struct blorp_u_0 blorp_p_0){const struct blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;int64_t blorp_vl_1;int64_t blorp_vl_4;goto blorp_selection_1_node_2;blorp_selection_1_node_0:{const int64_t blorp_vl_2=blorp_vl_0.payload.blorp_up_1.blorp_uf_0;(void)blorp_vl_2;blorp_vl_4=blorp_vl_2;goto blorp_selection_1_arm_1;}blorp_selection_1_node_1:{goto blorp_selection_1_arm_0;}blorp_selection_1_node_2:{if((blorp_vl_0).tag==blorp_v_0_0)goto blorp_selection_1_node_1;goto blorp_selection_1_node_0;}blorp_selection_1_arm_0:{const int64_t blorp_vl_3=INT64_C(0);(void)blorp_vl_3;blorp_vl_1=blorp_vl_3;goto blorp_selection_1_done;}blorp_selection_1_arm_1:{(void)blorp_vl_4;blorp_vl_1=blorp_vl_4;goto blorp_selection_1_done;}blorp_selection_1_done:;(void)blorp_vl_1;return blorp_vl_1;}\nstatic int blorp_program_finish(int status){return blorp_memory_finish(status);}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n"


pure func test_scalar_wildcard_reads_scrutinee_in_shared_body() -> Bool:
	source: String =
		|fixed union Choice:
		|	First
		|	Second
		|pure func copy(value: Choice) -> Choice:
		|	match value:
		|		_: value
		|func main() -> Int:
		|	result = copy(First)
		|	0
		|

	match emitted(source):
		Err(_):
			False
		Ok(code):
			code.contains((
					"const enum blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;"
					+ "enum blorp_u_0 blorp_vl_1;goto blorp_selection_1_node_0;blorp_selection_1_node_0:{goto blorp_selection_1_arm_0;}blorp_selection_1_arm_0:{"
					+ "blorp_vl_1=blorp_vl_0;goto blorp_selection_1_done;}blorp_selection_1_done:;(void)blorp_vl_1;return blorp_vl_1;}"
				))


pure func test_block_arm_emits_ordered_locals_inside_shared_body() -> Bool:
	source: String =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|pure func inspect(value: Value) -> Int:
		|	match value:
		|		Empty: 0
		|		Number(payload):
		|			var current = payload
		|			original = current
		|			current = 42
		|			original
		|func main() -> Int:
		|	inspect(Number(7))
		|

	match emitted(source):
		Err(_):
			False
		Ok(code):
			code.contains((
					"blorp_selection_1_node_0:{const int64_t blorp_vl_2=blorp_vl_0.payload."
					+ "blorp_up_1.blorp_uf_0;(void)blorp_vl_2;blorp_vl_4=blorp_vl_2;goto blorp_selection_1_arm_1;}"
				)) and code.contains((
					"blorp_selection_1_arm_1:{(void)blorp_vl_4;const int64_t blorp_vl_5=INT64_C(42);"
					+ "(void)blorp_vl_5;blorp_vl_1=blorp_vl_4;goto blorp_selection_1_done;}"
					+ "blorp_selection_1_done:;(void)blorp_vl_1;return blorp_vl_1;}"
				))


private pure func emit_owned(program: OwnershipProgram) -> Result[String, Diagnostic]:
	verified ?= verify(program)
	emit(verified)


-- The runtime prefix has separate native tests. Only that unrelated prefix is
-- reused here: each complete declarations/functions/main suffix below is an
-- independent oracle for the supplied operations, including unwanted ARC calls.
private pure func emits_owned_program(program: OwnershipProgram, expected: String) -> Bool:
	emit_owned(program).get_or("") == MEMORY_RUNTIME + string_runtime() + expected


private pure func integer_definition(id: ValueId, value: Int, at: Int) -> OwnershipOperation:
	DefineValue({
		id = id,
		value_type = IntType,
		operation = IntegerDefinition(value),
		result = UnmanagedResult,
		span = span(at),
	})


private pure func string_definition(
	id: ValueId,
	argument: ValueId,
	owner: Int,
	at: Int,
) -> OwnershipOperation:
	DefineValue({
		id = id,
		value_type = StringType,
		operation = CallDefinition(
			RuntimeFunction(Builtins.IntToString),
			[UnmanagedArgument(argument)],
		),
		result = OwnedResult(owner_id(owner)),
		span = span(at),
	})


private pure func length_definition(
	id: ValueId,
	argument: ValueId,
	owner: Int,
	at: Int,
) -> OwnershipOperation:
	DefineValue({
		id = id,
		value_type = IntType,
		operation = CallDefinition(
			RuntimeFunction(Builtins.StringLength),
			[BorrowedArgument({
					value = argument,
					source = OwnerBorrow(owner_id(owner)),
				})],
		),
		result = UnmanagedResult,
		span = span(at),
	})


private pure func main_function(
	operations: List[OwnershipOperation],
	result: ValueId,
) -> OwnedFunction:
	{
		signature = {
			parameters = [],
			return_type = IntType
		},
		operations = operations,
		result = UnmanagedReturn(result)
	}


private pure func borrowed_identity(ids: InputIds) -> OwnedFunction:
	{
		signature = {
			parameters = [StringType],
			return_type = StringType
		},
		operations = [
			DefineValue({
				id = ids.first,
				value_type = StringType,
				operation = ParameterDefinition(0),
				result = BorrowedResult(ParameterBorrow(ids.first)),
				span = span(10),
			}),
			AcquireOwner(
				owner_id(0),
				{
					value = ids.first,
					source = ParameterBorrow(ids.first)
				},
				span(20),
			),
		],
		result = OwnedReturn(ids.first, owner_id(0))
	}


pure func test_verified_operations_emit_allocation_borrow_then_drop() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			emits_owned_program(
				{
					records = [],
					unions = [],
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [
						main_function(
							[
								integer_definition(ids.first, 7, 10),
								string_definition(ids.second, ids.first, 0, 20),
								length_definition(ids.third, ids.second, 0, 30),
								DropOwner(owner_id(0), span(40)),
							],
							ids.third,
						),
					]
				},
				(
					"int64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t "
					+ "blorp_vl_0=INT64_C(7);(void)blorp_vl_0;struct blorp_string* const "
					+ "blorp_vl_1=blorp_int_to_string(blorp_vl_0);(void)blorp_vl_1;struct "
					+ "blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;const int64_t "
					+ "blorp_vl_2=blorp_string_length(blorp_vl_1);(void)blorp_vl_2;"
					+ "blorp_string_release(blorp_owner_0);return blorp_vl_2;}\n"
				) + "static int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n",
			)


pure func test_borrowed_parameter_return_emits_retain_and_owner_transfer() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			emits_owned_program(
				{
					records = [],
					unions = [],
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [
						main_function([integer_definition(ids.first, 0, 10)], ids.first),
						borrowed_identity(ids),
					]
				},
				(
					"int64_t blorp_f_0(void);struct blorp_string* blorp_f_1(struct blorp_string* "
					+ "blorp_p_0);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(0);"
					+ "(void)blorp_vl_0;return blorp_vl_0;}\nstruct blorp_string* blorp_f_1(struct "
					+ "blorp_string* blorp_p_0){struct blorp_string* const blorp_vl_0=blorp_p_0;"
					+ "(void)blorp_vl_0;blorp_string_retain(blorp_vl_0);struct blorp_string* const "
					+ "blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;return blorp_owner_0;}\n"
				) + "static int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n",
			)


pure func test_acquire_emits_value_retain_before_old_owner_drop_and_transfer() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			helper: OwnedFunction = {
				signature = {
					parameters = [],
					return_type = StringType
				},
				operations = [
					integer_definition(ids.first, 7, 10),
					string_definition(ids.second, ids.first, 0, 20),
					AcquireOwner(
						owner_id(1),
						{
							value = ids.second,
							source = OwnerBorrow(owner_id(0))
						},
						span(30),
					),
					DropOwner(owner_id(0), span(40)),
				],
				result = OwnedReturn(ids.second, owner_id(1))
			}
			emits_owned_program(
				{
					records = [],
					unions = [],
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [
						main_function([integer_definition(ids.first, 0, 1)], ids.first),
						helper,
					]
				},
				(
					"int64_t blorp_f_0(void);struct blorp_string* blorp_f_1(void);int64_t "
					+ "blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return "
					+ "blorp_vl_0;}\nstruct blorp_string* blorp_f_1(void){const int64_t "
					+ "blorp_vl_0=INT64_C(7);(void)blorp_vl_0;struct blorp_string* const "
					+ "blorp_vl_1=blorp_int_to_string(blorp_vl_0);(void)blorp_vl_1;struct "
					+ "blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"
					+ "blorp_string_retain(blorp_vl_1);struct blorp_string* const "
					+ "blorp_owner_1=blorp_vl_1;(void)blorp_owner_1;blorp_string_release(blorp_owner_0)"
					+ ";return blorp_owner_1;}\n"
				) + "static int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n",
			)


pure func test_independent_owner_drops_emit_each_exact_operand_once() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			emits_owned_program(
				{
					records = [],
					unions = [],
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [
						main_function(
							[
								integer_definition(ids.first, 7, 10),
								string_definition(ids.second, ids.first, 0, 20),
								string_definition(ids.third, ids.first, 1, 30),
								DropOwner(owner_id(1), span(40)),
								DropOwner(owner_id(0), span(50)),
							],
							ids.first,
						),
					]
				},
				(
					"int64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t "
					+ "blorp_vl_0=INT64_C(7);(void)blorp_vl_0;struct blorp_string* const "
					+ "blorp_vl_1=blorp_int_to_string(blorp_vl_0);(void)blorp_vl_1;struct "
					+ "blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;struct "
					+ "blorp_string* const blorp_vl_2=blorp_int_to_string(blorp_vl_0);(void)blorp_vl_2;"
					+ "struct blorp_string* const blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;"
					+ "blorp_string_release(blorp_owner_1);blorp_string_release(blorp_owner_0);return "
					+ "blorp_vl_0;}\n"
				) + "static int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n",
			)


