import:
	../../../src/runtime/string_concat: STRING_CONCAT_RUNTIME
	../string_concat_inputs: CONCAT_SOURCE
	./test_builtin_functions: emitted_sources
	test: TestSuite


pure func test_reachable_concat_emits_one_helper_and_ordered_call() -> Bool:
	match emitted_sources([{ source = CONCAT_SOURCE, targets = [] }]):
		Err(_): False
		Ok(code):
			(
				code.contains(STRING_CONCAT_RUNTIME)
				and code.split("struct blorp_string *blorp_string_concat(").length() == 2
				and code.split("=blorp_string_concat(").length() == 2
				and code.contains("=blorp_string_concat(blorp_vl_0,blorp_vl_1);")
			)


pure func test_unused_concat_declaration_selects_no_helper() -> Bool:
	source: String =
		|pure func concatenate(left: String, right: String) -> String:
		|    builtin("string.add")
		|func main() -> Int:
		|    0
		|
	match emitted_sources([{ source = source, targets = [] }]):
		Err(_): False
		Ok(code): not code.contains("blorp_string_concat")


tests: TestSuite = {
	description = "Blorp 2 String concat emission",
	tests = [
		("reachable call emits exact fragment once and keeps argument order", test_reachable_concat_emits_one_helper_and_ordered_call),
		("unreachable declaration selects no fragment", test_unused_concat_declaration_selects_no_helper),
	]
}
