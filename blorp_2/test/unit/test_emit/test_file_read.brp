import:
	../../../src/emit/emit: emit
	../../../src/own/own: own
	../../../src/utils/syntax: Diagnostic
	../../../src/verify/verify: verify
	../file_read_inputs: file_read_seed
	../module_input: test_base, TestFoundation
	./test_builtin_functions: emitted_sources
	test: TestSuite


-- This fixture instantiates only Result[String, String], whose query parameter is id 0 and result is id 1.
private FIRST_PAYLOAD: String = "((struct blorp_u_0){.tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_runtime_1}})"
private SECOND_PAYLOAD: String = "((struct blorp_u_0){.tag=blorp_v_0_1,.payload.blorp_up_1={.blorp_uf_0=blorp_runtime_1}})"


private pure func emitted_file_read(foundation: TestFoundation) -> Result[String, Diagnostic]:
	seed ?= file_read_seed(foundation)
	owned ?= own(seed.lowered)
	verified ?= verify(owned)
	emit(verified)


pure func test_file_read_emits_one_call_and_transfers_its_scratch() -> Bool:
	match emitted_file_read(test_base()):
		Err(_): False
		Ok(code):
			(
				code.split("=blorp_read_file(").length() == 2
				and code.contains("blorp_runtime_1_ok?" + FIRST_PAYLOAD + ":" + SECOND_PAYLOAD)
				and code.contains("blorp_union_drop_0(")
				and not code.contains("blorp_string_retain(blorp_runtime_")
				and not code.contains("blorp_string_release(blorp_runtime_")
			)


pure func test_reversed_result_emits_the_actual_designated_tags() -> Bool:
	foundation = { test_base() | types = test_base().types.replace(
		"    Ok(Value)\n    Err(Error)", "    Err(Error)\n    Ok(Value)",
	) }
	match emitted_file_read(foundation):
		Err(_): False
		Ok(code): code.contains("blorp_runtime_1_ok?" + SECOND_PAYLOAD + ":" + FIRST_PAYLOAD)


pure func test_ignored_native_result_still_selects_string_runtime() -> Bool:
	source: String =
		|func query(path: String) -> Result[String, String]:
		|    builtin("system.read_file")
		|func main() -> Int:
		|    unused = query("input")
		|    0
		|
	match emitted_sources([{ source = source, targets = [] }]):
		Err(_): False
		Ok(code):
			(
				code.contains("struct blorp_string {")
				and code.contains("=blorp_read_file(")
				and code.contains("blorp_union_drop_0(")
			)


pure func test_unused_declaration_does_not_select_file_read_helper() -> Bool:
	source: String =
		|func query(path: String) -> Result[String, String]:
		|    builtin("system.read_file")
		|func main() -> Int:
		|    0
		|
	match emitted_sources([{ source = source, targets = [] }]):
		Err(_): False
		Ok(code): not code.contains("blorp_read_file")


tests: TestSuite = {
	description = "Blorp 2 file-read C emission",
	tests = [
		("normal tags transfer one fresh scratch", test_file_read_emits_one_call_and_transfers_its_scratch),
		("reversed tags retain designated roles", test_reversed_result_emits_the_actual_designated_tags),
		("ignored native result selects String ABI", test_ignored_native_result_still_selects_string_runtime),
		("unused declaration selects no native helper", test_unused_declaration_does_not_select_file_read_helper),
	]
}
