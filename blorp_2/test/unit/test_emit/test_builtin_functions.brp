import:
	../test_verify/selection_inputs as Selection
	../../../src/runtime/memory: MEMORY_RUNTIME
	../../../src/check/model as Model
	../../../src/check/check: CheckedProgram, check, checked_functions
	../../../src/utils/ids: function_number, inventory_functions
	../../../src/emit/emit: emit
	../../../src/lower/lower: lower, value_number
	../../../src/own/own as Own
	../../../src/parse/assemble: parsed_contents
	../../../src/namespace/builtins as Builtins:
		PrimitiveType(BuiltinInt),
		RuntimeOperation(IntAdd, IntToString, StringLength),
		RuntimeResult(ValueResult),
		BuiltinTypeErrorKind(FoundationFunctions),
		check_builtin_types,
		runtime_contract,
	../../../src/utils/source: module_id, module_source, same_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax:
		Entrypoint(NoArguments),
		EntryResult(IntegerExitStatus),
		Diagnostic,
		ParsedBody(ParsedBuiltinBody),
		ParsedRuntimeOperation(IntegerAddBuiltin),
		Purity(Pure),
	../../../src/verify/verify: verify
	../input: setup_diagnostic
	../module_input: ModuleInput, primitive_base, test_base, parse_modules, parse_modules_with_base
	../ownership_inputs: InputIds, input_ids, span
	../string_integer_inputs: STRING_INTEGER_SOURCE
	int as IntOps
	test: TestSuite


private ROOT: String =
	|import:
	|    ./int: add
	|func main() -> Int:
	|    add(20, 22)
	|


private ADD: String =
	|pure func add(first: Int, second: Int) -> Int:
	|    builtin("int.add")
	|


private pure func checked_add(helper: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules([
		{
			source = ROOT,
			targets = [1]
		},
		{
			source = helper,
			targets = []
		},
	])
	check(parsed)
		.map_err(setup_diagnostic)


private pure func owned_sources(
	sources: List[ModuleInput],
) -> Result[Own.OwnershipProgram, Diagnostic]:
	parsed ?= parse_modules(sources)
	checked ?= check(parsed)
		.map_err(setup_diagnostic)
	concrete ?= Concrete.specialize(checked)
	lowered ?= lower(concrete)
	Own.own(lowered)


pure func emitted_sources(sources: List[ModuleInput]) -> Result[String, Diagnostic]:
	owned ?= owned_sources(sources)
	verified ?= verify(owned)
	emit(verified)


pure func test_module_builtin_add_is_accepted() -> Bool:
	match (
		parse_modules([
			{
				source = ROOT,
				targets = [1]
			},
			{
				source = ADD,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(parsed):
			check(parsed)
				.is_ok()


pure func test_parser_publishes_typed_builtin_and_source_span() -> Bool:
	match (
		(
			parse_modules(
				[
					{
						source = ADD,
						targets = []
					},
				],
			),
			module_id(0),
		)
	):
		(Ok(program), Some(module)):
			match inventory_functions(parsed_contents(program).declarations).map(pure func(row): row.declaration):
				[function]:
					match function.body:
						ParsedBuiltinBody(IntegerAddBuiltin, occurrence):
							start = "pure func add(first: Int, second: Int) -> Int:\n    builtin(".length()
							(
								same_source(occurrence.source, module_source(module))
								and occurrence.start == start
								and occurrence.end == start + "\"int.add\"".length()
								and function.statements.is_empty()
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_binary_runtime_contract_is_complete() -> Bool:
	operation: RuntimeOperation[Void, Concrete.TypeRef] = Builtins.IntAdd
	contract = runtime_contract(operation)
	result_matches = match contract.return_type:
		ValueResult(Builtins.PrimitiveRuntimeType(BuiltinInt)): True
		_: False
	parameters_match = match contract.parameters:
		[Builtins.PrimitiveRuntimeType(BuiltinInt), Builtins.PrimitiveRuntimeType(BuiltinInt)]: True
		_: False
	(
		contract.purity == Pure
		and parameters_match
		and result_matches
	)


pure func test_foundation_builtin_function_uses_ordinary_parser_and_rejects_at_role_boundary() -> Bool:
	root: String =
		|func main() -> Int:
		|    0
		|
	match parse_modules_with_base([{ source = root, targets = [] }], { test_base() | types = test_base().types + ADD }):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			match (inventory_functions(parsed.declarations).get(1).map(pure func(row): row.declaration), check_builtin_types(program)):
				(Some(function), Err(error)):
					match (function.body, error.kind):
						(ParsedBuiltinBody(IntegerAddBuiltin, occurrence), FoundationFunctions):
							same_source(occurrence.source, module_source(parsed.foundation.types)) and error.span.start == test_base().types.length() + "pure func ".length()
						_: False
				_: False


pure func test_unknown_builtin_label_is_rejected_before_checking() -> Bool:
	source: String =
		|pure func add(first: Int, second: Int) -> Int:
		|    builtin("int.unknown")
		|
	start = "pure func add(first: Int, second: Int) -> Int:\n    builtin(".length()

	match (
		parse_modules(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == start
				and error.span.end == start + "\"int.unknown\"".length()
				and error.message == "unknown builtin operation"
				and error.help == "use int.equals, int.less_than, int.add, int.subtract, int.multiply, int.divide, int.remainder, int.to_string, float.add, float.subtract, float.multiply, float.divide, float.remainder, float.to_string, float.copysign, float.equals, float.less_than, float.is_nan, float.is_finite, string.length, string.add, string.append_int, string.print, string.print_error, string.parse_int, string.parse_float, string.byte_at, string.from_codepoint, string.slice, system.get_current_directory, system.read_file, system.write_file, string.equals, list.repeat, list.length, list.get, list.append, list.set or list.concat"
			)


pure func test_builtin_body_cannot_have_a_trailing_expression() -> Bool:
	source: String =
		|pure func add(first: Int, second: Int) -> Int:
		|    builtin("int.add").length()
		|
	start = "pure func add(first: Int, second: Int) -> Int:\n    builtin(\"int.add\")".length()

	match (
		parse_modules(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == start
				and error.span.end == start + 1
				and error.message == "expected a newline after the return expression"
				and error.help == "put each declaration on a new line"
			)


pure func test_builtin_rejects_prefix_bindings() -> Bool:
	helper: String =
		|pure func add(first: Int, second: Int) -> Int:
		|    local = first
		|    builtin("int.add")
		|
	start = "pure func add(first: Int, second: Int) -> Int:\n    local = first\n    ".length()

	match (
		parse_modules(
			[
				{
					source = helper,
					targets = []
				},
			],
		)
	):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == start
				and error.span.end == start + "builtin".length()
				and error.message == "builtin must be the entire function body"
				and error.help == (
					"use builtin as the entire function body; put other work in an ordinary wrapper "
					+ "function"
				)
			)


pure func test_checked_builtin_reads_its_ordered_parameter_identities() -> Bool:
	match checked_add(ADD):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions.get(1):
				Some(function):
					match function.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(first), Model.ValueOperand(second)]:
											match (call.target, first.form, second.form):
												(Model.RuntimeFunction(Builtins.IntAdd), Model.ReadBinding(first_id), Model.ReadBinding(second_id)):
													(
														Model.binding_number(first_id) == 0
														and Model.binding_number(second_id) == 1
														and function.bindings.length() == 2
														and function.statements.is_empty()
														and Model.same_type(
															value.value_type,
															Model.IntType,
														)
													)
												_:
													False
										_: False
								_:
									False
						_:
							False
				None:
					False


pure func test_specialization_keeps_binary_runtime_contract() -> Bool:
	contract = Concrete.runtime_signature(Builtins.IntAdd)

	match checked_add(ADD).and_then(pure func(checked): Concrete.specialize(checked)):
		Err(_):
			False
		Ok(program):
			match Concrete.specialized_contents(program).functions.get(1):
				Some(function):
					match function.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match value.form:
								Concrete.InvokeFunction(call, [_, _]):
									match (
										call.target,
										contract.parameters,
										function.signature.parameters,
									):
										(Concrete.RuntimeFunction(Builtins.IntAdd), [Concrete.IntType, Concrete.IntType], [Concrete.IntType, Concrete.IntType]):
											Concrete.same_type(
												contract.return_type,
												Concrete.IntType,
											)
										_:
											False
								_:
									False
						_:
							False
				None:
					False


private pure func owned_add(
	ids: InputIds,
	arguments: List[Own.OwnedArgument],
) -> Own.OwnershipProgram:
	{
		records = [],
		unions = [],
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
		functions = [
			{
				signature = {
					parameters = [],
					return_type = Concrete.IntType
				},
				operations = [
					Own.DefineValue({
						id = ids.first,
						value_type = Concrete.IntType,
						operation = Own.IntegerDefinition(20),
						result = Own.UnmanagedResult,
						span = span(10),
					}),
					Own.DefineValue({
						id = ids.second,
						value_type = Concrete.IntType,
						operation = Own.IntegerDefinition(22),
						result = Own.UnmanagedResult,
						span = span(20),
					}),
					Own.DefineValue({
						id = ids.third,
						value_type = Concrete.IntType,
						operation = Own.CallDefinition(
							Concrete.RuntimeFunction(Builtins.IntAdd),
							arguments,
						),
						result = Own.UnmanagedResult,
						span = span(30),
					}),
				],
				result = Own.UnmanagedReturn(ids.third)
			},
		]
	}


pure func test_verifier_accepts_two_unmanaged_runtime_arguments() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			verify(
				owned_add(
					ids,
					[Own.UnmanagedArgument(ids.first), Own.UnmanagedArgument(ids.second)],
				),
			).is_ok()


pure func test_verifier_rejects_a_missing_runtime_argument() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match verify(owned_add(ids, [Own.UnmanagedArgument(ids.first)])):
				Ok(_):
					False
				Err(error):
					(
						error.span.start == 30
						and error.span.end == 31
						and error.message == "ownership verification failed: call is missing its argument"
						and error.help == "report this compiler error with the input program"
					)


pure func test_emitter_includes_portable_addition_only_for_runtime_calls() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match (
				verify(
					owned_add(
						ids,
						[Own.UnmanagedArgument(ids.first), Own.UnmanagedArgument(ids.second)],
					),
				).and_then(pure func(program): emit(program))
			):
				Err(_):
					False
				Ok(code):
					(
						code.contains("uint64_t sum=(uint64_t)first+(uint64_t)second;")
						and code.contains(
							"sum<=INT64_MAX?(int64_t)sum:-INT64_C(1)-(int64_t)(UINT64_MAX-sum)",
						)
						and code.contains("blorp_int_add(blorp_vl_0,blorp_vl_1)")
						and not code.contains("blorp_int_to_string")
					)


pure func test_label_selects_operation_for_a_renamed_local_function() -> Bool:
	source: String =
		|pure func combine(first: Int, second: Int) -> Int:
		|    builtin("int.add")
		|func main() -> Int:
		|    combine(20, 22)
		|

	match (
		parse_modules(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Err(_):
					False
				Ok(program):
					match checked_functions(program).functions.get(0):
						Some(function):
							match function.body:
								Model.CheckedValueBody(Model.ReturnExpression(value)):
									match value.form:
										Model.InvokeFunction(call):
											match call.operands:
												[Model.ValueOperand(_), Model.ValueOperand(_)]:
													match call.target:
														Model.RuntimeFunction(Builtins.IntAdd):
															True
														_:
															False
												_: False
										_:
											False
								_:
									False
						None:
							False


