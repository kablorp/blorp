pure func test_verifier_checks_second_runtime_argument_type() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = owned_add(
				ids,
				[Own.UnmanagedArgument(ids.first), Own.UnmanagedArgument(ids.second)],
			)

			match original.functions:
				[function]:
					wrong = { function |
						signature = {
							parameters = [Concrete.StringType],
							return_type = Concrete.IntType
						},
						operations = [
							Own.DefineValue({
								id = ids.first,
								value_type = Concrete.IntType,
								operation = Own.IntegerDefinition(20),
								result = Own.UnmanagedResult,
								span = span(10),
							}),
							Own.DefineValue({
								id = ids.second,
								value_type = Concrete.StringType,
								operation = Own.ParameterDefinition(0),
								result = Own.BorrowedResult(Own.ParameterBorrow(ids.second)),
								span = span(20),
							}),
							Own.DefineValue({
								id = ids.third,
								value_type = Concrete.IntType,
								operation = Own.CallDefinition(
									Concrete.RuntimeFunction(Builtins.IntAdd),
									[Own.UnmanagedArgument(ids.first), Own.BorrowedArgument({
											value = ids.second,
											source = Own.ParameterBorrow(ids.second),
										})],
								),
								result = Own.UnmanagedResult,
								span = span(30),
							}),
						]
					}

					match (
						verify(
							{ original | functions = [function, wrong] },
						)
					):
						Ok(_):
							False
						Err(error):
							(
								error.span.start == 30
								and error.span.end == 31
								and error.message == "ownership verification failed: call argument type does not match its contract"
								and error.help == "report this compiler error with the input program"
							)
				_:
					False


private UNARY_ROOT: String =
	|import:
	|    ./string: count, to_string
	|func main() -> Int:
	|    count(42.to_string())
	|


private UNARY_HELPER: String =
	|pure func count(value: String) -> Int:
	|    builtin("string.length")
	|pure func to_string(value: Int) -> String:
	|    builtin("int.to_string")
	|


private pure func borrows_parameter(function: Own.OwnedFunction) -> Bool:
	match function.operations:
		[Own.DefineValue(parameter), Own.DefineValue(result)]:
			match (parameter.operation, parameter.result, result.operation):
				(Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(source)), Own.CallDefinition(call, [Own.BorrowedArgument(argument)])):
					match (call, argument.source, result.result):
						(Concrete.RuntimeFunction(Builtins.StringLength), Own.ParameterBorrow(argument_source), Own.UnmanagedResult):
							(
								value_number(source) == value_number(parameter.id)
								and value_number(argument.value) == value_number(parameter.id)
								and value_number(argument_source) == value_number(parameter.id)
								and Concrete.same_type(parameter.value_type, Concrete.StringType)
								and Concrete.same_type(result.value_type, Concrete.IntType)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_unary_module_builtin_preserves_managed_parameter_borrow() -> Bool:
	match (
		owned_sources([
			{
				source = UNARY_ROOT,
				targets = [1]
			},
			{
				source = UNARY_HELPER,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(program):
			match program.functions:
				[caller, _, helper]:
					var dropped = False

					for operation in caller.operations:
						match operation:
							Own.DropOwner(owner, _):
								dropped = dropped or Own.owner_number(owner) == 0
							_:
								void

					borrows_parameter(helper) and dropped and verify(program).is_ok()
				_:
					False


pure func test_unary_module_builtin_emits_caller_cleanup() -> Bool:
	match (
		emitted_sources([
			{
				source = UNARY_ROOT,
				targets = [1]
			},
			{
				source = UNARY_HELPER,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(code):
			(
				code.contains("blorp_string_length(blorp_vl_0)")
				and code.contains("blorp_string_release(blorp_owner_0);")
				and not code.contains("blorp_int_add")
			)


pure func test_module_builtin_transfers_its_fresh_string_result() -> Bool:
	root: String =
		|import:
		|    ./int: format, length
		|func main() -> Int:
		|    format(42).length()
		|
	helper: String =
		|pure func format(value: Int) -> String:
		|    builtin("int.to_string")
		|pure func length(value: String) -> Int:
		|    builtin("string.length")
		|
	sources: List[ModuleInput] = [
		{
			source = root,
			targets = [1]
		},
		{
			source = helper,
			targets = []
		},
	]

	match parse_modules(sources).and_then(pure func(parsed): check(parsed)
			.map_err(setup_diagnostic)):
		Err(_):
			False
		Ok(checked):
			var checked_result = False

			match checked_functions(checked).functions.get(1):
				Some(function):
					match function.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(argument)]:
											match (call.target, argument.form):
												(Model.RuntimeFunction(Builtins.IntToString), Model.ReadBinding(parameter)):
													checked_result = (
														Model.same_type(
															value.value_type,
															Model.StringType,
														)
														and Model.same_type(
															argument.value_type,
															Model.IntType,
														)
														and Model.binding_number(parameter) == 0
													)
												_:
													void
										_: void
								_:
									void
						_:
							void
				None:
					void

			match owned_sources(sources):
				Err(_):
					False
				Ok(program):
					match program.functions:
						[caller, helper, _]:
							match (caller.operations, helper.operations, helper.result):
								([Own.DefineValue(_), Own.DefineValue(formatted), Own.DefineValue(_), Own.DropOwner(dropped, _)], [Own.DefineValue(parameter), Own.DefineValue(result)], Own.OwnedReturn(value, transferred)):
									match (
										parameter.operation,
										result.operation,
										result.result,
										formatted.result,
									):
										(Own.ParameterDefinition(0), Own.CallDefinition(call, [Own.UnmanagedArgument(argument)]), Own.OwnedResult(created), Own.OwnedResult(caller_owner)):
											match call:
												Concrete.RuntimeFunction(Builtins.IntToString):
													(
														checked_result
														and Concrete.same_type(
															result.value_type,
															Concrete.StringType,
														)
														and value_number(
															argument,
														) == value_number(parameter.id)
														and value_number(
															value,
														) == value_number(result.id)
														and Own.owner_number(
															created,
														) == Own.owner_number(transferred)
														and Own.owner_number(
															caller_owner,
														) == Own.owner_number(dropped)
														and verify(program).is_ok()
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False


pure func test_imported_builtin_call_keeps_ordinary_declaration_identity() -> Bool:
	match checked_add(ADD):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions.get(0):
				None:
					False
				Some(caller):
					match Model.function_calls(caller):
						[call]:
							ordinary = call.operands.all(pure func(operand):
								match operand:
									Model.ValueOperand(_): True
									Model.CallableOperand(_, _, _): False
							)
							match (call.target, ordinary):
								(Model.UserFunction(id, []), True):
									function_number(id) == 1
								_:
									False
						_:
							False


pure func test_addition_helper_is_absent_without_runtime_calls() -> Bool:
	source: String =
		|func main() -> Int:
		|    42
		|

	-- Exact minimal output requires only primitive types, with no nominal catalog.
	code = parse_modules_with_base([{ source = source, targets = [] }], primitive_base())
		.and_then(pure func(parsed): check(parsed).map_err(setup_diagnostic))
		.and_then(pure func(program): Concrete.specialize(program))
		.and_then(lower)
		.and_then(pure func(program): Own.own(program))
		.and_then(verify)
		.and_then(emit)
	match code:
		Err(_):
			False
		Ok(code):
			code == MEMORY_RUNTIME + "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(42);(void)blorp_vl_0;return blorp_vl_0;}int main(void){blorp_memory_start();return blorp_memory_finish((int)blorp_f_0());}\n"


pure func test_emitter_finds_runtime_addition_inside_a_match_arm() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = owned_add(
				ids,
				[Own.UnmanagedArgument(ids.first), Own.UnmanagedArgument(ids.third)],
			)

			match original.functions:
				[function]:
					matched = { function |
						operations = [Own.DefineValue({
								id = ids.first,
								value_type = Concrete.UnionType(ids.union_id),
								operation = Own.ConstructDefinition(ids.second_variant, []),
								result = Own.UnmanagedResult,
								span = span(1),
							}), Own.ExecuteJoin({
							result = Own.UnmanagedJoinParameter({ id = ids.second, value_type = Concrete.IntType, span = span(30) }),
							carried = [],
							entering = [],
							selection = Selection.direct(Own.UnmanagedArgument(ids.first)),
							arms = [
								{
									id = Model.match_arm_id(0), inputs = [],
									operations = [
										Own.DefineValue({
											id = ids.third,
											value_type = Concrete.IntType,
											operation = Own.IntegerDefinition(20),
											result = Own.UnmanagedResult,
											span = span(10),
										}),
										Own.DefineValue({
											id = ids.fourth,
											value_type = Concrete.IntType,
											operation = Own.IntegerDefinition(22),
											result = Own.UnmanagedResult,
											span = span(20),
										}),
										Own.DefineValue({
											id = ids.fifth,
											value_type = Concrete.IntType,
											operation = Own.CallDefinition(
												Concrete.RuntimeFunction(Builtins.IntAdd),
												[
													Own.UnmanagedArgument(ids.third),
													Own.UnmanagedArgument(ids.fourth),
												],
											),
											result = Own.UnmanagedResult,
											span = span(30),
										}),
									],
									exit = Own.Yield({ transfer = Own.UnmanagedReturn(ids.fifth), carried = [] })
								},
							],
						})],
						result = Own.UnmanagedReturn(ids.second)
					}

					match verify({ original |
							unions = ids.unions,
							functions = [matched]
						}).and_then(pure func(program): emit(program)):
						Err(_):
							False
						Ok(code):
							(
								code.contains("static int64_t blorp_int_add(")
								and code.contains("blorp_int_add(blorp_vl_2,blorp_vl_3)")
							)
				_:
					False


pure func test_unused_builtin_declaration_omits_its_runtime_helper() -> Bool:
	source = ADD + "func main() -> Int:\n    42\n"

	match (
		emitted_sources(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Err(_):
			False
		Ok(code):
			(
				not code.contains("blorp_int_add")
				and not code.contains("blorp_f_1")
				and code.contains("return blorp_memory_finish((int)blorp_f_0());")
			)


pure func test_byte_at_emission_selects_some_zero_by_status() -> Bool:
	match emitted_sources([{ source = STRING_INTEGER_SOURCE, targets = [] }]):
		Err(_): False
		Ok(output):
			(
				output.contains("int64_t blorp_runtime_2=0;const uint8_t blorp_runtime_2_some=blorp_string_byte_at(blorp_vl_0,blorp_vl_1,&blorp_runtime_2);")
				and output.contains("blorp_vl_2=blorp_runtime_2_some?((struct blorp_u_")
				and output.contains(".blorp_uf_0=blorp_runtime_2")
				and IntOps.equals(output.count("_some=blorp_string_byte_at("), 1)
			)


pure func test_encoder_emission_moves_one_fresh_root_into_some() -> Bool:
	match emitted_sources([{ source = STRING_INTEGER_SOURCE, targets = [] }]):
		Err(_): False
		Ok(output):
			(
				output.contains("struct blorp_string *blorp_runtime_1=NULL;const uint8_t blorp_runtime_1_some=blorp_string_from_codepoint(blorp_vl_0,&blorp_runtime_1);")
				and output.contains("blorp_vl_1=blorp_runtime_1_some?((struct blorp_u_")
				and output.contains(".blorp_uf_0=blorp_runtime_1")
				and IntOps.equals(output.count("_some=blorp_string_from_codepoint("), 1)
				and IntOps.equals(output.count("blorp_string_retain(blorp_runtime_1)"), 0)
				and IntOps.equals(output.count("blorp_string_release(blorp_runtime_1)"), 0)
			)


