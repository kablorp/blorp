import:
	../compilation: compile
	../join_inputs: PICK
	test: TestSuite


private WIDTH: String =
	|fixed union Shape:
	|	Circle(Int)
	|	Square(Int)
	|pure func width(shape: Shape) -> Int:
	|	w = match shape:
	|		Circle(r): r
	|		Square(s): s
	|	w
	|func main() -> Int:
	|	width(Square(4))
	|


private pure func emits(source: String, expected: String) -> Bool:
	match compile(source):
		Ok(output): output.contains(expected)
		Err(_): False


-- The join's local is the only non-const value local: declared before the
-- switch, assigned in each braced case, which then breaks; the last arm is
-- also `default` so every path assigns it.
pure func test_bound_int_match_assigns_its_local_in_each_case() -> Bool:
	emits(
		WIDTH,
		"int64_t blorp_f_1(struct blorp_u_0 blorp_p_0){const struct blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;int64_t blorp_vl_1;switch(blorp_vl_0.tag){case blorp_v_0_0:{const int64_t blorp_vl_2=blorp_vl_0.payload.blorp_up_0.blorp_uf_0;(void)blorp_vl_2;blorp_vl_1=blorp_vl_2;break;}case blorp_v_0_1:default:{const int64_t blorp_vl_3=blorp_vl_0.payload.blorp_up_1.blorp_uf_0;(void)blorp_vl_3;blorp_vl_1=blorp_vl_3;break;}}(void)blorp_vl_1;return blorp_vl_1;}",
	)


-- A managed arm moves its owner into the join's local, which the join's own
-- owner takes over after the switch; the prefix String drops after it.
pure func test_managed_join_moves_arm_owners_into_its_own_owner() -> Bool:
	emits(
		PICK,
		"struct blorp_string* blorp_vl_2;switch(blorp_vl_0){case blorp_v_0_0:{static const unsigned char blorp_bytes_3[]={102,114,101,115,104};struct blorp_string* const blorp_vl_3=blorp_string_from_bytes((const char *)blorp_bytes_3,INT64_C(5));(void)blorp_vl_3;struct blorp_string* const blorp_owner_2=blorp_vl_3;(void)blorp_owner_2;blorp_vl_2=blorp_owner_2;break;}case blorp_v_0_1:default:{blorp_string_retain(blorp_vl_1);struct blorp_string* const blorp_owner_3=blorp_vl_1;(void)blorp_owner_3;blorp_vl_2=blorp_owner_3;break;}}(void)blorp_vl_2;struct blorp_string* const blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;blorp_string_release(blorp_owner_0);return blorp_owner_1;}",
	)


tests: TestSuite = {
	description = "C emission for joins",
	tests = [
		("bound Int match assigns its local in each case", test_bound_int_match_assigns_its_local_in_each_case),
		("managed join moves arm owners into its own owner", test_managed_join_moves_arm_owners_into_its_own_owner),
	]
}
