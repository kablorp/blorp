import:
	../compilation: compile
	../join_inputs: PICK
	test: TestSuite


private WIDTH: String =
	|fixed union Shape:
	|	Circle(Int)
	|	Square(Int)
	|pure func width(shape: Shape) -> Int:
	|	w = match shape:
	|		Circle(r): r
	|		Square(s): s
	|	w
	|func main() -> Int:
	|	width(Square(4))
	|


private pure func emits(source: String, expected: String) -> Bool:
	match compile(source):
		Ok(output): output.contains(expected)
		Err(_): False


-- Selection edges assign canonical inputs, then each shared body assigns the
-- join result once and reaches the ordinary continuation.
pure func test_bound_int_match_assigns_its_local_in_each_case() -> Bool:
	emits(WIDTH, (
		"int64_t blorp_f_1(struct blorp_u_0 blorp_p_0){const struct blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;"
		+ "int64_t blorp_vl_1;int64_t blorp_vl_4;int64_t blorp_vl_5;goto blorp_selection_1_node_2;"
		+ "blorp_selection_1_node_0:{const int64_t blorp_vl_2=blorp_vl_0.payload.blorp_up_1.blorp_uf_0;(void)blorp_vl_2;blorp_vl_5=blorp_vl_2;goto blorp_selection_1_arm_1;}"
		+ "blorp_selection_1_node_1:{const int64_t blorp_vl_3=blorp_vl_0.payload.blorp_up_0.blorp_uf_0;(void)blorp_vl_3;blorp_vl_4=blorp_vl_3;goto blorp_selection_1_arm_0;}"
		+ "blorp_selection_1_node_2:{if((blorp_vl_0).tag==blorp_v_0_0)goto blorp_selection_1_node_1;goto blorp_selection_1_node_0;}"
		+ "blorp_selection_1_arm_0:{(void)blorp_vl_4;blorp_vl_1=blorp_vl_4;goto blorp_selection_1_done;}"
		+ "blorp_selection_1_arm_1:{(void)blorp_vl_5;blorp_vl_1=blorp_vl_5;goto blorp_selection_1_done;}"
		+ "blorp_selection_1_done:;(void)blorp_vl_1;return blorp_vl_1;}"
	))


-- A managed arm transfers its owner into the join, whose owner alias is
-- established only at the common continuation; the prefix then retires.
pure func test_managed_join_moves_arm_owners_into_its_own_owner() -> Bool:
	emits(PICK, (
		"struct blorp_string* blorp_vl_2;goto blorp_selection_2_node_2;"
		+ "blorp_selection_2_node_0:{goto blorp_selection_2_arm_1;}blorp_selection_2_node_1:{goto blorp_selection_2_arm_0;}"
		+ "blorp_selection_2_node_2:{if(blorp_vl_0==blorp_v_0_0)goto blorp_selection_2_node_1;goto blorp_selection_2_node_0;}"
		+ "blorp_selection_2_arm_0:{static const unsigned char blorp_bytes_3[]={102,114,101,115,104};struct blorp_string* const blorp_vl_3=blorp_string_from_bytes((const char *)blorp_bytes_3,INT64_C(5));(void)blorp_vl_3;struct blorp_string* const blorp_owner_2=blorp_vl_3;(void)blorp_owner_2;blorp_vl_2=blorp_owner_2;goto blorp_selection_2_done;}"
		+ "blorp_selection_2_arm_1:{blorp_string_retain(blorp_vl_1);struct blorp_string* const blorp_owner_3=blorp_vl_1;(void)blorp_owner_3;blorp_vl_2=blorp_owner_3;goto blorp_selection_2_done;}"
		+ "blorp_selection_2_done:;(void)blorp_vl_2;struct blorp_string* const blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;blorp_string_release(blorp_owner_0);return blorp_owner_1;}"
	))


pure func test_same_type_carriers_assign_each_selected_edge_in_binding_order() -> Bool:
	source: String =
		|fixed union Choice:
		|    Yes
		|    No
		|pure func choose(choice: Choice) -> Int:
		|    var left = 11
		|    var right = 22
		|    match choice:
		|        Yes:
		|            right = 202
		|            left = 101
		|        No: void
		|    left
		|func main() -> Int:
		|    choose(Yes)
		|
	match compile(source):
		Err(_): False
		Ok(output):
			(
				output.contains("uint8_t blorp_vl_3;int64_t blorp_vl_4;int64_t blorp_vl_5;goto")
				and output.contains("blorp_vl_3=blorp_vl_8;blorp_vl_4=blorp_vl_7;blorp_vl_5=blorp_vl_6;goto blorp_selection_3_done;")
				and output.contains("blorp_vl_3=blorp_vl_9;blorp_vl_4=blorp_vl_1;blorp_vl_5=blorp_vl_2;goto blorp_selection_3_done;")
			)


tests: TestSuite = {
	description = "C emission for joins",
	tests = [
		("same-type carrier assignments follow binding order", test_same_type_carriers_assign_each_selected_edge_in_binding_order),
		("bound Int match assigns its local in each case", test_bound_int_match_assigns_its_local_in_each_case),
		("managed join moves arm owners into its own owner", test_managed_join_moves_arm_owners_into_its_own_owner),
	]
}
