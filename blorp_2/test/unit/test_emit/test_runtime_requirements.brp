import:
	../../../src/emit/emit: INTEGER_ADD_RUNTIME, INTEGER_ARITHMETIC_RUNTIME
	../../../src/runtime/float: float_parse_runtime, float_runtime, float_string_runtime
	../../../src/runtime/system: SYSTEM_CURRENT_DIRECTORY_RUNTIME
	../../../src/runtime/string:
		string_equals_runtime, string_parse_int_runtime, string_print_runtime, string_runtime, STRING_SLICE_RUNTIME, STRING_PRINT_ERROR_RUNTIME
	../compilation: compile_modules
	../module_input: test_base
	test: TestSuite


-- One C fragment per helper family the emitter selects, taken from the
-- functions and constants that supply it.
fixed record RuntimeHelper {
	label: String,
	fragment: String
}


private pure func runtime_helpers() -> List[RuntimeHelper]:
	[
		{ label = "string prelude", fragment = string_runtime() },
		{ label = "float prelude", fragment = float_runtime() },
		{ label = "float formatting", fragment = float_string_runtime() },
		{ label = "float parsing", fragment = float_parse_runtime() },
		{ label = "integer addition", fragment = INTEGER_ADD_RUNTIME },
		{ label = "integer arithmetic", fragment = INTEGER_ARITHMETIC_RUNTIME },
		{ label = "string output", fragment = string_print_runtime() },
		{ label = "string error output", fragment = STRING_PRINT_ERROR_RUNTIME },
		{ label = "integer parsing", fragment = string_parse_int_runtime() },
		{ label = "string equality", fragment = string_equals_runtime() },
		{ label = "string slicing", fragment = STRING_SLICE_RUNTIME },
		{ label = "current directory", fragment = SYSTEM_CURRENT_DIRECTORY_RUNTIME },
	]


-- The helper families present in the C emitted for one program, in table order.
private pure func helpers_in(source: String) -> Result[List[String], String]:
	match compile_modules([{ source = source, targets = [] }], test_base()):
		Err(_):
			Err("program did not compile")
		Ok(output):
			var present: List[String] = []

			for helper in runtime_helpers():
				if output.contains(helper.fragment):
					present = present.append(helper.label)

			Ok(present)


private pure func selects_exactly(source: String, expected: List[String]) -> Bool:
	match helpers_in(source):
		Ok(present):
			present == expected
		Err(_):
			False


pure func test_addition_selects_only_the_addition_helper() -> Bool:
	source: String =
		|pure func add(left: Int, right: Int) -> Int:
		|    builtin("int.add")
		|func main() -> Int:
		|    add(1, 2)
		|

	selects_exactly(source, ["integer addition"])


pure func test_subtraction_selects_the_arithmetic_helpers() -> Bool:
	source: String =
		|pure func subtract(left: Int, right: Int) -> Int:
		|    builtin("int.subtract")
		|func main() -> Int:
		|    subtract(3, 1)
		|

	selects_exactly(source, ["integer arithmetic"])


pure func test_multiplication_selects_the_arithmetic_helpers() -> Bool:
	source: String =
		|pure func multiply(left: Int, right: Int) -> Int:
		|    builtin("int.multiply")
		|func main() -> Int:
		|    multiply(3, 2)
		|

	selects_exactly(source, ["integer arithmetic"])


pure func test_division_selects_the_arithmetic_helpers() -> Bool:
	source: String =
		|pure func divide(left: Int, right: Int) -> Int:
		|    builtin("int.divide")
		|func main() -> Int:
		|    divide(6, 2)
		|

	selects_exactly(source, ["integer arithmetic"])


pure func test_remainder_selects_the_arithmetic_helpers() -> Bool:
	source: String =
		|pure func remainder(left: Int, right: Int) -> Int:
		|    builtin("int.remainder")
		|func main() -> Int:
		|    remainder(7, 4)
		|

	selects_exactly(source, ["integer arithmetic"])


pure func test_print_selects_the_string_prelude_and_output() -> Bool:
	source: String =
		|func print(value: String) -> Void:
		|    builtin("string.print")
		|func main() -> Int:
		|    print("text")
		|    0
		|

	selects_exactly(source, ["string prelude", "string output"])


private ERROR_DECLARATION: String =
	|func print_error(message: String) -> Void:
	|    builtin("string.print_error")
	|


pure func test_stderr_only_selects_stderr_fragment() -> Bool:
	selects_exactly(ERROR_DECLARATION + "func main() -> Int:\n    print_error(\"text\")\n    0\n",
		["string prelude", "string error output"])


pure func test_unused_stderr_declaration_selects_nothing() -> Bool:
	selects_exactly(ERROR_DECLARATION + "func main() -> Int:\n    0\n", [])


pure func test_both_outputs_select_both_fragments() -> Bool:
	source: String =
		|func print(value: String) -> Void:
		|    builtin("string.print")
		|func main() -> Int:
		|    print("out")
		|    print_error("err")
		|    0
		|
	selects_exactly(ERROR_DECLARATION + source, ["string prelude", "string output", "string error output"])


pure func test_integer_parsing_selects_the_string_prelude_and_parser() -> Bool:
	source: String =
		|pure func parse(text: String) -> Option[Int]:
		|    builtin("string.parse_int")
		|func main() -> Int:
		|    saved = parse("1")
		|    0
		|

	selects_exactly(source, ["string prelude", "integer parsing"])


pure func test_equality_selects_the_string_prelude_and_comparison() -> Bool:
	source: String =
		|pure func equal(left: String, right: String) -> Bool:
		|    builtin("string.equals")
		|func main() -> Int:
		|    saved = equal("a", "b")
		|    0
		|

	selects_exactly(source, ["string prelude", "string equality"])


pure func test_float_arithmetic_selects_only_the_float_prelude() -> Bool:
	source: String =
		|pure func add(first: Float, second: Float) -> Float:
		|    builtin("float.add")
		|func main() -> Int:
		|    saved = add(1.25, 2.0)
		|    0
		|

	selects_exactly(source, ["float prelude"])


pure func test_float_formatting_selects_both_preludes_and_the_formatter() -> Bool:
	source: String =
		|pure func format(value: Float) -> String:
		|    builtin("float.to_string")
		|func main() -> Int:
		|    saved = format(1.25)
		|    0
		|

	selects_exactly(source, ["string prelude", "float prelude", "float formatting"])


pure func test_float_parsing_selects_both_preludes_and_the_parser() -> Bool:
	source: String =
		|pure func parse(text: String) -> Option[Float]:
		|    builtin("string.parse_float")
		|func main() -> Int:
		|    saved = parse("1.25")
		|    0
		|

	selects_exactly(source, ["string prelude", "float prelude", "float parsing"])


-- A phantom type argument keeps its record although no value of it is built, so
-- the record's String field alone selects the prelude.
pure func test_phantom_record_string_field_selects_the_string_prelude() -> Bool:
	source: String =
		|union Token[T]:
		|    Present
		|fixed record Entry { text: String }
		|fixed record Tokens { entry_token: Token[Entry] }
		|pure func make_tokens() -> Tokens:
		|    { entry_token = Present }
		|pure func score[T](value: Token[T]) -> Int:
		|    match value:
		|        Present: 7
		|func main() -> Int:
		|    score(make_tokens().entry_token)
		|

	selects_exactly(source, ["string prelude"])


pure func test_phantom_record_float_field_selects_the_float_prelude() -> Bool:
	source: String =
		|union Token[T]:
		|    Present
		|fixed record Reading { value: Float }
		|fixed record Tokens { reading_token: Token[Reading] }
		|pure func make_tokens() -> Tokens:
		|    { reading_token = Present }
		|pure func score[T](value: Token[T]) -> Int:
		|    match value:
		|        Present: 7
		|func main() -> Int:
		|    score(make_tokens().reading_token)
		|

	selects_exactly(source, ["float prelude"])


pure func test_union_string_payload_selects_the_string_prelude() -> Bool:
	source: String =
		|union Message:
		|    Text(String)
		|    Empty
		|pure func idle() -> Message:
		|    Empty
		|pure func size(message: Message) -> Int:
		|    match message:
		|        Text(_): 1
		|        Empty: 0
		|func main() -> Int:
		|    size(idle())
		|

	selects_exactly(source, ["string prelude"])


-- Lowering defines every parameter as a value of its type, so no signature scan
-- is needed: an entrypoint's unused String arguments alone select the prelude.
pure func test_unused_string_parameter_selects_the_string_prelude() -> Bool:
	source: String =
		|func main(arguments: List[String]) -> Int:
		|    0
		|

	selects_exactly(source, ["string prelude"])


tests: TestSuite = {
	description = "Blorp 2 runtime requirement selection",
	tests = [
		("stderr selects only its fragment", test_stderr_only_selects_stderr_fragment),
		("unused stderr selects nothing", test_unused_stderr_declaration_selects_nothing),
		("both outputs select both fragments", test_both_outputs_select_both_fragments),
		("addition selects only the addition helper", test_addition_selects_only_the_addition_helper),
		("subtraction selects the integer arithmetic helpers", test_subtraction_selects_the_arithmetic_helpers),
		("multiplication selects the integer arithmetic helpers", test_multiplication_selects_the_arithmetic_helpers),
		("division selects the integer arithmetic helpers", test_division_selects_the_arithmetic_helpers),
		("remainder selects the integer arithmetic helpers", test_remainder_selects_the_arithmetic_helpers),
		("print selects the String prelude and the output helper", test_print_selects_the_string_prelude_and_output),
		("integer parsing selects the String prelude and the parser", test_integer_parsing_selects_the_string_prelude_and_parser),
		("string equality selects the String prelude and the comparison", test_equality_selects_the_string_prelude_and_comparison),
		("float arithmetic selects only the Float prelude", test_float_arithmetic_selects_only_the_float_prelude),
		("float formatting selects both preludes and the formatter", test_float_formatting_selects_both_preludes_and_the_formatter),
		("float parsing selects both preludes and the parser", test_float_parsing_selects_both_preludes_and_the_parser),
		("a phantom record's String field selects the String prelude", test_phantom_record_string_field_selects_the_string_prelude),
		("a phantom record's Float field selects the Float prelude", test_phantom_record_float_field_selects_the_float_prelude),
		("a union's String payload selects the String prelude", test_union_string_payload_selects_the_string_prelude),
		("an unused String parameter selects the String prelude", test_unused_string_parameter_selects_the_string_prelude),
	]
}
