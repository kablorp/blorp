import:
	../../src/lex: lex
	../../src/names: NameTable, name_spelling
	../../src/parse:
		ImportOrigin(RelativeImport, LibraryImport),
		ImportSelection(NamedSelection),
		ParsedModule, ParsedProgram,
		append_module,
		assembly_names,
		begin_program,
		module_imports,
		module_names,
		parse_module,
		parsed_contents,
		seal_program,
	../../src/source: COMPILER_SOURCE, ModuleKind(UserModule, FoundationTypesModule, FoundationPreludeModule, LibraryModule), ModuleId, module_id, module_source, root_module_id, same_module, same_source
	../../src/syntax: Diagnostic, Token
	module_input: parse_modules
	test: TestSuite


pure func test_relative_import_path_is_lexed() -> Bool:
	source: String =
		|import:
		|    ./helper: answer
		|func main() -> Int:
		|    answer()
		|
	match lex(module_source(root_module_id()), source):
		Ok(_):
			True
		Err(_):
			False


private pure func root_module(source: String) -> Result[ParsedModule, Diagnostic]:
	assembly = begin_program()
	tokens ?= lex(module_source(root_module_id()), source)
	parse_module(tokens, root_module_id(), assembly_names(assembly))


pure func test_relative_paths_retain_components_and_selectors() -> Bool:
	source: String =
		|import:
		|    ./near/helper: answer, other
		|    ../../shared/helper: third
		|
	match root_module(source):
		Err(_):
			False
		Ok(parsed):
			names = module_names(parsed)
			match module_imports(parsed):
				[first, second]:
					match ((first.path.origin, second.path.origin), (first.path.parts, first.symbols, second.path.parts, second.symbols)):
						((RelativeImport(0), RelativeImport(2)), ([near, helper], [NamedSelection(answer), NamedSelection(other)], [shared, parent_helper], [NamedSelection(third)])):
							(
								(
								    name_spelling(names, near) == Some("near")
								    and name_spelling(names, helper) == Some("helper")
								    and name_spelling(names, shared) == Some("shared")
								    and name_spelling(names, parent_helper) == Some("helper")
								    and name_spelling(names, answer.id) == Some("answer")
								    and name_spelling(names, other.id) == Some("other")
								    and name_spelling(names, third.id) == Some("third")
								    and first.span.start == 12 and first.span.end == 40
								    and answer.span.start == 27 and answer.span.end == 33
								    and same_source(first.span.source, module_source(root_module_id()))
								)
							)
						_:
							False
				_:
					False


pure func test_bare_library_path_retains_origin_and_selection_spans() -> Bool:
	source: String =
		|import:
		|    int: add
		|func main() -> Int:
		|    add(20, 22)
		|
	match root_module(source):
		Err(_):
			False
		Ok(parsed):
			names = module_names(parsed)
			match module_imports(parsed):
				[request]:
					match (request.path.origin, request.path.parts, request.symbols):
						(LibraryImport, [integer], [NamedSelection(add)]):
							(
								(
								    name_spelling(names, integer) == Some("int")
								    and name_spelling(names, add.id) == Some("add")
								    and request.span.start == 12 and request.span.end == 20
								    and add.span.start == 17 and add.span.end == 20
								    and same_source(add.span.source, module_source(root_module_id()))
								)
							)
						_:
							False
				_:
					False


pure func test_nested_library_path_retains_named_components() -> Bool:
	source: String =
		|import:
		|    numbers/int: add, other
		|
	match root_module(source):
		Err(_):
			False
		Ok(parsed):
			names = module_names(parsed)
			match module_imports(parsed):
				[request]:
					match (request.path.origin, request.path.parts, request.symbols):
						(LibraryImport, [numbers, integer], [NamedSelection(add), NamedSelection(other)]):
							(
								(
								    name_spelling(names, numbers) == Some("numbers")
								    and name_spelling(names, integer) == Some("int")
								    and name_spelling(names, add.id) == Some("add")
								    and name_spelling(names, other.id) == Some("other")
								)
							)
						_:
							False
				_:
					False


pure func test_imports_and_declarations_keep_module_ownership() -> Bool:
	main: String =
		|import:
		|    ./helper: answer
		|func main() -> Int:
		|    answer()
		|
	helper: String =
		|pure func answer() -> Int:
		|    42
		|
	match parse_modules([{ source = main, targets = [1] }, { source = helper, targets = [] }]):
		Err(_):
			False
		Ok(program):
			contents = parsed_contents(program)
			match (contents.modules.get(0), contents.modules.get(1), contents.functions):
				(Some(root), Some(dependency), [main_function, answer_function]):
					match root.imports:
						[request]:
							(
								(
								    same_module(root.module, root_module_id())
								    and same_module(main_function.module, root.module)
								    and same_module(answer_function.module, dependency.module)
								    and same_module(request.target, dependency.module)
								    and same_source(answer_function.function_name.span.source, module_source(dependency.module))
								)
							)
						_:
							False
				_:
					False


pure func test_sealing_requires_root_and_complete_targets() -> Bool:
	empty = match seal_program(begin_program()):
		Err(error): error.message == "source bundle has no root module" and same_source(error.span.source, COMPILER_SOURCE)
		_: False
	missing = match (root_module("import:\n    ./helper: answer\n"), module_id(3)):
		(Ok(parsed), Some(target)):
			match append_module(begin_program(), parsed, [target], UserModule).and_then(seal_program):
				Err(error):
					(
						error.message == "source bundle is missing an imported module"
						and same_source(error.span.source, COMPILER_SOURCE)
						and error.help == "load each module once in inventory order and supply every import target"
					)
				_: False
		_: False
	empty and missing


pure func test_assembly_rejects_wrong_target_count() -> Bool:
	match parse_modules([{ source = "import:\n    ./helper: answer\n", targets = [] }]):
		Err(error):
			(
				(
				    error.message == "source bundle does not supply exactly one target per import"
				    and error.help == "load each module once in inventory order and supply every import target"
				)
			)
		_:
			False


private pure func parse_at(source: String, module: ModuleId, names: NameTable) -> Result[ParsedModule, Diagnostic]:
	tokens ?= lex(module_source(module), source)
	parse_module(tokens, module, names)


private pure func succeeded(result: Result[Bool, Diagnostic]) -> Bool:
	match result:
		Ok(value):
			value
		Err(_):
			False


private pure func rejects_stale_extension(next_id: ModuleId) -> Result[Bool, Diagnostic]:
	assembly = begin_program()
	first ?= parse_at("func first() -> Int:\n    1\n", root_module_id(), assembly_names(assembly))
	extended ?= append_module(assembly, first, [], UserModule)
	stale ?= parse_at("func second() -> Int:\n    2\n", next_id, assembly_names(assembly))
	Ok(match append_module(extended, stale, [], UserModule):
		Err(error):
			error.message == "parsed module does not extend this source bundle's name authority"
		_:
			False
	)


pure func test_assembly_rejects_stale_name_authority() -> Bool:
	match module_id(1):
		None:
			False
		Some(next_id):
			succeeded(rejects_stale_extension(next_id))


private pure func rejects_wrong_identity(other: ModuleId) -> Result[Bool, Diagnostic]:
	assembly = begin_program()
	parsed ?= parse_at("func main() -> Int:\n    0\n", other, assembly_names(assembly))
	Ok(match append_module(assembly, parsed, [], UserModule):
		Err(error):
			error.message == "parsed module does not have the next source bundle identity"
		_:
			False
	)


pure func test_assembly_rejects_wrong_module_identity() -> Bool:
	match module_id(1):
		None:
			False
		Some(other):
			succeeded(rejects_wrong_identity(other))


private pure func rejects_wrong_source(other: ModuleId) -> Result[Bool, Diagnostic]:
	assembly = begin_program()
	tokens ?= lex(module_source(root_module_id()), "func main() -> Int:\n    0\n")
	wrong_end = { tokens | end = { tokens.end | source = module_source(other) } }
	Ok(match parse_module(wrong_end, root_module_id(), assembly_names(assembly)):
		Err(error):
			error.message == "parsed module's source does not match its module identity"
		_:
			False
	)


pure func test_parsing_rejects_wrong_source_origin() -> Bool:
	match module_id(1):
		None:
			False
		Some(other):
			succeeded(rejects_wrong_source(other))


private pure func rejects_mixed_source(other: ModuleId) -> Result[Bool, Diagnostic]:
	assembly = begin_program()
	tokens ?= lex(module_source(root_module_id()), "func main() -> Int:\n    0\n")
	var mixed: List[Token] = []
	for token in tokens.tokens:
		mixed = mixed.append({ token | span = { token.span | source = module_source(other) } })
	Ok(match parse_module({ tokens | tokens = mixed }, root_module_id(), assembly_names(assembly)):
		Err(error):
			error.message == "parsed module's source does not match its module identity"
		_:
			False
	)


pure func test_parsing_rejects_mixed_token_origins() -> Bool:
	match module_id(1):
		None:
			False
		Some(other):
			succeeded(rejects_mixed_source(other))


private pure func assemble_roles(roles: List[ModuleKind]) -> Result[ParsedProgram, Diagnostic]:
	var assembly = begin_program()
	var ordinal = 0
	var failure: Option[Diagnostic] = None
	for role in roles:
		match module_id(ordinal):
			None:
				failure = Some({ span = { source = COMPILER_SOURCE, start = 0, end = 0 }, note = None, message = "test inventory too large", help = "test setup" })
			Some(id):
				match parse_at("-- module\n", id, assembly_names(assembly)):
					Err(error): failure = Some(error)
					Ok(parsed):
						match append_module(assembly, parsed, [], role):
							Err(error): failure = Some(error)
							Ok(next): assembly = next
		ordinal = ordinal + 1
	match failure:
		Some(error): Err(error)
		None: seal_program(assembly)


private pure func roles_reject(roles: List[ModuleKind], message: String, source_ordinal: Int) -> Bool:
	match assemble_roles(roles):
		Ok(_): False
		Err(error):
		    (
		        error.message == message
		        and same_source(error.span.source, module_source(module_id(source_ordinal).get_or(root_module_id())))
		        and error.span.start == 10 and error.span.end == 10
		        and error.help == "load each module once in inventory order and supply every import target"
		    )


pure func test_sealing_requires_designated_types_role() -> Bool:
	roles_reject([UserModule, FoundationPreludeModule], "source bundle has no foundation types module", 0)


pure func test_sealing_requires_designated_prelude_role() -> Bool:
	roles_reject([UserModule, FoundationTypesModule], "source bundle has no foundation prelude module", 0)


pure func test_sealing_rejects_duplicate_types_role() -> Bool:
	roles_reject([UserModule, FoundationTypesModule, FoundationTypesModule, FoundationPreludeModule], "source bundle has more than one foundation types module", 2)


pure func test_sealing_rejects_duplicate_prelude_role() -> Bool:
	roles_reject([UserModule, FoundationTypesModule, FoundationPreludeModule, FoundationPreludeModule], "source bundle has more than one foundation prelude module", 3)


pure func test_sealing_requires_user_root_role() -> Bool:
	roles_reject([FoundationTypesModule, UserModule, FoundationPreludeModule], "source bundle root must be a user module", 0)


pure func test_sealing_publishes_actual_designated_module_identities() -> Bool:
	match assemble_roles([UserModule, LibraryModule, FoundationPreludeModule, FoundationTypesModule]):
		Err(_): False
		Ok(program):
			contents = parsed_contents(program)
			match (module_id(2), module_id(3)):
				(Some(prelude), Some(types)): same_module(contents.foundation.prelude, prelude) and same_module(contents.foundation.types, types)
				_: False


tests: TestSuite = {
	description = "Blorp 2 import syntax",
	tests = [
		("sealing requires types role", test_sealing_requires_designated_types_role),
		("sealing requires prelude role", test_sealing_requires_designated_prelude_role),
		("sealing rejects duplicate types role", test_sealing_rejects_duplicate_types_role),
		("sealing rejects duplicate prelude role", test_sealing_rejects_duplicate_prelude_role),
		("sealing requires user root", test_sealing_requires_user_root_role),
		("sealing publishes designated IDs", test_sealing_publishes_actual_designated_module_identities),
		("relative import path is lexed", test_relative_import_path_is_lexed),
		("relative paths retain components and selectors", test_relative_paths_retain_components_and_selectors),
		("bare library path retains origin and selection spans", test_bare_library_path_retains_origin_and_selection_spans),
		("nested library path retains named components", test_nested_library_path_retains_named_components),
		("imports and declarations keep module ownership", test_imports_and_declarations_keep_module_ownership),
		("sealing requires root and complete targets", test_sealing_requires_root_and_complete_targets),
		("assembly rejects wrong target count", test_assembly_rejects_wrong_target_count),
		("assembly rejects stale name authority", test_assembly_rejects_stale_name_authority),
		("assembly rejects wrong module identity", test_assembly_rejects_wrong_module_identity),
		("parsing rejects wrong source origin", test_parsing_rejects_wrong_source_origin),
		("parsing rejects mixed token origins", test_parsing_rejects_mixed_token_origins),
	]
}
