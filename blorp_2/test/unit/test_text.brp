import:
	../../src/text: concat, equals
	test: TestSuite


pure func test_exact_equality_without_traits() -> Bool:
	(
		equals("", "")
		and equals("same", "same")
		and not equals("", "x")
		and not equals("x", "")
		and not equals("prefix", "pre")
		and not equals("pre", "prefix")
		and not equals("same", "sane")
		and equals("é", "é")
		and not equals("é", "ê")
	)


pure func test_concatenation_preserves_both_values() -> Bool:
	(
		concat("left", "right") == "leftright"
		and concat("", "right") == "right"
		and concat("left", "") == "left"
	)


tests: TestSuite = {
	description = "Blorp 2 text primitives",
	tests = [
		("exact equality without traits", test_exact_equality_without_traits),
		("concatenation preserves both values", test_concatenation_preserves_both_values),
	]
}
