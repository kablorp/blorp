import:
	../../src/lower as Lower
	../../src/own as Own
	../../src/prelude as Prelude: RuntimeOperation(StringPrint, StringLength)
	../../src/specialize as Concrete
	../../src/syntax: FunctionExecution(OrdinaryCalls), Entrypoint(NoArguments), entry_function
	../../src/verify: verify
	ownership_inputs: InputIds, function, input_ids, integer, runtime, span
	test: TestSuite


private pure func unmanaged(result: Own.ResultOwnership) -> Bool:
	match result:
		Own.UnmanagedResult:
			True
		_:
			False


private pure func unit(id: Lower.ValueId) -> Lower.ValueDefinition:
	{
		id = id,
		value_type = Concrete.VoidType,
		operation = Lower.VoidValue,
		span = span(10)
	}


private pure func text(id: Lower.ValueId) -> Lower.ValueDefinition:
	{
		id = id,
		value_type = Concrete.StringType,
		operation = Lower.StringValue("hello"),
		span = span(10)
	}


pure func test_unit_has_no_operand_use() -> Bool:
	match input_ids():
		Ok(ids):
			match (
				Own.last_uses(
					[unit(ids.first), integer(ids.second, 0, 20)],
					ids.second,
				)
			):
				Ok(uses):
					uses == [None, Some(2)]
				Err(_):
					False
		Err(_):
			False


pure func test_unit_introduces_no_owner_or_drop() -> Bool:
	match input_ids():
		Ok(ids):
			match (
				Own.insert_function(
					function(
						[unit(ids.first), integer(ids.second, 0, 20)],
						ids.second,
						[],
						Concrete.IntType,
					),
					[],
					[],
				)
			):
				Ok(output):
					match output.operations:
						[Own.DefineValue(unit), Own.DefineValue(_)]:
							match (unit.operation, unit.result):
								(Own.VoidDefinition, Own.UnmanagedResult):
									True
								_:
									False
						_:
							False
				Err(_):
					False
		Err(_):
			False


pure func test_print_is_a_last_use_of_its_borrowed_string() -> Bool:
	match input_ids():
		Ok(ids):
			match (
				Own.last_uses(
					[
						text(ids.first),
						runtime(ids.second, Prelude.StringPrint, [ids.first], Concrete.VoidType, 20),
						integer(ids.third, 0, 30),
					],
					ids.third,
				)
			):
				Ok(uses):
					uses == [Some(1), None, Some(3)]
				Err(_):
					False
		Err(_):
			False


pure func test_print_borrows_and_drops_string_only_after_the_call() -> Bool:
	match input_ids():
		Ok(ids):
			match (
				Own.insert_function(
					function(
						[
							text(ids.first),
							runtime(ids.second, Prelude.StringPrint, [ids.first], Concrete.VoidType, 20),
							integer(ids.third, 0, 30),
						],
						ids.third,
						[],
						Concrete.IntType,
					),
					[],
					[],
				)
			):
				Ok(output):
					match output.operations:
						[Own.DefineValue(_), Own.DefineValue(printed), Own.DropOwner(dropped, at), Own.DefineValue(_)]:
							match printed.operation:
								Own.CallDefinition(_, [Own.BorrowedArgument(borrow)]):
									match borrow.source:
										Own.OwnerBorrow(owner):
											(
												Lower.value_number(borrow.value) == 0
												and Own.owner_number(
													owner,
												) == Own.owner_number(dropped)
												and at.start == 20
												and unmanaged(printed.result)
											)
										_:
											False
								_:
									False
						_:
							False
				Err(_):
					False
		Err(_):
			False


pure func test_a_string_alias_stays_live_after_print() -> Bool:
	match input_ids():
		Ok(ids):
			match (
				Own.insert_function(
					function(
						[
							text(ids.first),
							runtime(ids.second, Prelude.StringPrint, [ids.first], Concrete.VoidType, 20),
							runtime(ids.third, Prelude.StringLength, [ids.first], Concrete.IntType, 30),
						],
						ids.third,
						[],
						Concrete.IntType,
					),
					[],
					[],
				)
			):
				Ok(output):
					match output.operations:
						[Own.DefineValue(_), Own.DefineValue(_), Own.DefineValue(length), Own.DropOwner(_, at)]:
							match length.operation:
								Own.CallDefinition(_, [Own.BorrowedArgument(borrow)]):
									Lower.value_number(borrow.value) == 0 and at.start == 30
								_:
									False
						_:
							False
				Err(_):
					False
		Err(_):
			False


private pure func program(ids: InputIds, definition: Own.OwnedDefinition) -> Own.OwnershipProgram:
	{
		records = [],
		unions = [],
		entrypoint = NoArguments(ids.entrypoint),
		functions = [
			{
				execution = OrdinaryCalls,
				signature = {
					parameters = [],
					return_type = Concrete.IntType
				},
				operations = [Own.DefineValue(definition), Own.DefineValue({
						id = ids.second,
						value_type = Concrete.IntType,
						operation = Own.IntegerDefinition(0),
						result = Own.UnmanagedResult,
						span = span(20),
					})],
				tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.second)))
			},
		]
	}


private pure func rejects_unit(
	value_type: Concrete.TypeRef,
	result: Own.ResultOwnership,
	message: String,
) -> Bool:
	match input_ids():
		Ok(ids):
			match (
				verify(
					program(
						ids,
						{
							id = ids.first,
							value_type = value_type,
							operation = Own.VoidDefinition,
							result = result,
							span = span(10)
						},
					),
				)
			):
				Err(error):
					(
						error.message == "ownership verification failed: " + message
						and error.help == "report this compiler error with the input program"
						and error.span.start == 10
						and error.span.end == 11
					)
				Ok(_):
					False
		Err(_):
			False


pure func test_verifier_rejects_an_owned_unit() -> Bool:
	rejects_unit(
		Concrete.VoidType,
		Own.OwnedResult(Own.owner_id(0)),
		"unmanaged value carries an ownership obligation",
	)


pure func test_verifier_rejects_a_borrowed_unit() -> Bool:
	match input_ids():
		Ok(ids):
			rejects_unit(
				Concrete.VoidType,
				Own.BorrowedResult(Own.ParameterBorrow(ids.first)),
				"unmanaged value carries an ownership obligation",
			)
		Err(_):
			False


private pure func rejects_print(
	argument_type: Concrete.TypeRef,
	result_type: Concrete.TypeRef,
	message: String,
) -> Bool:
	match input_ids():
		Ok(ids):
			input = program(
				ids,
				{
					id = ids.first,
					value_type = argument_type,
					operation = Own.IntegerDefinition(0),
					result = Own.UnmanagedResult,
					span = span(10)
				},
			)
			functions = input.functions.map(pure func(
				function: Own.OwnedFunction,
			) -> Own.OwnedFunction:
				{ function | operations = function.operations.append(Own.DefineValue({
						id = ids.third,
						value_type = result_type,
						operation = Own.CallDefinition(
							{
								target = Concrete.RuntimeFunction(Prelude.StringPrint),
								span = span(30)
							},
							[Own.UnmanagedArgument(ids.first)],
						),
						result = Own.UnmanagedResult,
						span = span(30),
					})) }
			)

			match verify({ input | functions = functions }):
				Err(error):
					(
						error.message == "ownership verification failed: " + message
						and error.help == "report this compiler error with the input program"
						and error.span.start == 30
						and error.span.end == 31
					)
				Ok(_):
					False
		Err(_):
			False


pure func test_verifier_rejects_a_print_argument_with_the_wrong_type() -> Bool:
	rejects_print(
		Concrete.IntType,
		Concrete.VoidType,
		"call argument type does not match its contract",
	)


pure func test_verifier_rejects_a_print_result_with_the_wrong_type() -> Bool:
	match input_ids():
		Ok(ids):
			owner = Own.owner_id(0)
			input = program(
				ids,
				{
					id = ids.first,
					value_type = Concrete.StringType,
					operation = Own.StringDefinition("hello"),
					result = Own.OwnedResult(owner),
					span = span(10)
				},
			)
			functions = input.functions.map(pure func(
				function: Own.OwnedFunction,
			) -> Own.OwnedFunction:
				{ function | operations = function.operations.append(Own.DefineValue({
						id = ids.third,
						value_type = Concrete.IntType,
						operation = Own.CallDefinition(
							{
								target = Concrete.RuntimeFunction(Prelude.StringPrint),
								span = span(30)
							},
							[Own.BorrowedArgument({
									value = ids.first,
									source = Own.OwnerBorrow(owner),
								})],
						),
						result = Own.UnmanagedResult,
						span = span(30),
					})) }
			)

			match verify({ input | functions = functions }):
				Err(error):
					(
						error.message == "ownership verification failed: call result type does not match its contract"
						and error.help == "report this compiler error with the input program"
						and error.span.start == 30
						and error.span.end == 31
					)
				Ok(_):
					False
		Err(_):
			False


pure func test_verifier_rejects_a_wrongly_typed_unit() -> Bool:
	rejects_unit(
		Concrete.IntType,
		Own.UnmanagedResult,
		"definition type does not match its operation",
	)


pure func test_verifier_accepts_an_unmanaged_unused_unit() -> Bool:
	match input_ids():
		Ok(ids):
			verify(
				program(
					ids,
					{
						id = ids.first,
						value_type = Concrete.VoidType,
						operation = Own.VoidDefinition,
						result = Own.UnmanagedResult,
						span = span(10)
					},
				),
			).is_ok()
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp 2 unit and print ownership boundaries",
	tests = [
		("unit has no operand use", test_unit_has_no_operand_use),
		("unit creates no owner or drop", test_unit_introduces_no_owner_or_drop),
		("print is String last use", test_print_is_a_last_use_of_its_borrowed_string),
		(
			"print borrows until call then drops",
			test_print_borrows_and_drops_string_only_after_the_call,
		),
		("String alias stays live after print", test_a_string_alias_stays_live_after_print),
		("verifier rejects owned unit", test_verifier_rejects_an_owned_unit),
		("verifier rejects borrowed unit", test_verifier_rejects_a_borrowed_unit),
		(
			"verifier rejects malformed print argument",
			test_verifier_rejects_a_print_argument_with_the_wrong_type,
		),
		(
			"verifier rejects malformed print result",
			test_verifier_rejects_a_print_result_with_the_wrong_type,
		),
		("verifier rejects wrongly typed unit", test_verifier_rejects_a_wrongly_typed_unit),
		("verifier accepts unmanaged unused unit", test_verifier_accepts_an_unmanaged_unused_unit),
	]
}
