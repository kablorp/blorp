import:
	compilation: compile
	test: TestSuite


pure func test_boolean_roles_use_selected_ordinary_union() -> Bool:
	source: String =
		|fixed union Decision:
		|    Different
		|    Same
		|pure func equal(left: String, right: String) -> Decision:
		|    builtin("string.equals", Same, Different)
		|pure func choose(left: String, right: String) -> Int:
		|    match equal(left, right):
		|        Same: 42
		|        Different: 0
		|func main() -> Int:
		|    choose("add", "add")
		|

	match compile(source):
		Ok(output):
			output.contains("blorp_string_equals")
		Err(_):
			False


pure func test_integer_arithmetic_operations_have_closed_contracts() -> Bool:
	source: String =
		|pure func subtract(left: Int, right: Int) -> Int:
		|    builtin("int.subtract")
		|pure func multiply(left: Int, right: Int) -> Int:
		|    builtin("int.multiply")
		|pure func divide(left: Int, right: Int) -> Int:
		|    builtin("int.divide")
		|pure func remainder(left: Int, right: Int) -> Int:
		|    builtin("int.remainder")
		|func main() -> Int:
		|    subtract(multiply(divide(84, 2), 2), remainder(84, 43))
		|

	match compile(source):
		Ok(output):
			(
				output.contains("blorp_int_subtract")
				and output.contains("blorp_int_multiply")
				and output.contains("blorp_int_divide")
				and output.contains("blorp_int_remainder")
			)
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp 2 calculator operation contracts",
	tests = [
		("ordinary Boolean roles", test_boolean_roles_use_selected_ordinary_union),
		("closed integer arithmetic", test_integer_arithmetic_operations_have_closed_contracts),
		("local function shadows prelude fallback", test_local_function_shadows_prelude_fallback),
	]
}


pure func test_local_function_shadows_prelude_fallback() -> Bool:
	source: String =
		|pure func to_string(text: String) -> String:
		|    text
		|func main() -> Int:
		|    length(to_string("kept"))
		|

	match compile(source):
		Ok(_):
			True
		Err(_):
			False
