import:
	../../../src/namespace/namespace: Origin(Declared, Imported), TypeHead(OpaqueHead), build_namespace, named_type
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_opaques, opaque_number
	../../../src/utils/source: module_id, root_module_id, same_module
	../../../src/utils/syntax: Visibility(Private, Public)
	../input: existing_name
	../module_input: primitive_base, parse_modules_with_base
	test: TestSuite


pure func test_imported_opaque_head_retains_issued_identity_and_owner() -> Bool:
	root: String =
		|import:
		|    ./id: Id
		|private opaque type Hidden = Int
		|func main() -> Int:
		|    0
		|
	id: String =
		|opaque type Id = Int
		|
	match parse_modules_with_base([{ source = root, targets = [1] }, { source = id, targets = [] }], primitive_base()):
		Err(_): False
		Ok(program):
			contents = parsed_contents(program)
			match (build_namespace(program), inventory_opaques(contents.declarations), module_id(1), (existing_name(contents.names, "Id"), existing_name(contents.names, "Hidden"))):
				(Ok(namespace), [hidden, declared], Some(owner), (Some(id_name), Some(hidden_name))):
					match (named_type(namespace, root_module_id(), id_name), named_type(namespace, owner, id_name), named_type(namespace, root_module_id(), hidden_name)):
						(Some(imported), Some(original), Some(private_type)):
							match ((imported.head, imported.origin), (original.head, original.origin), (private_type.head, private_type.origin), (declared.declaration.visibility, hidden.declaration.visibility)):
								((OpaqueHead(imported_id), Imported), (OpaqueHead(original_id), Declared(Public)), (OpaqueHead(hidden_id), Declared(Private(_))), (Public, Private(_))):
									(
										opaque_number(imported_id) == opaque_number(declared.id)
										and opaque_number(original_id) == opaque_number(declared.id)
										and opaque_number(hidden_id) == opaque_number(hidden.id)
										and opaque_number(imported_id) != opaque_number(hidden_id)
										and same_module(declared.declaration.module, owner)
										and same_module(hidden.declaration.module, root_module_id())
									)
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 opaque namespace identity",
	tests = [("import retains the issued opaque ID and original module", test_imported_opaque_head_retains_issued_identity_and_owner)]
}
