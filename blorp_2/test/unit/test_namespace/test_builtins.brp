import:
    ../input: existing_name
    ../../../src/utils/ids: inventory_unions
    ../../../src/lex/lex: lex
    ../../../src/utils/names: NameTable, NameId, same_name, program_names
    ../../../src/parse/assemble:
        ParsedProgram,
        append_module,
        assembly_names,
        begin_program,
        parsed_contents,
        seal_program,
    ../../../src/parse/parse: parse_module
    ../../../src/namespace/builtins:
        BuiltinTypeErrorKind(MissingBuiltinType, DuplicateBuiltinType, BuiltinOutsideFoundation, FoundationImports, FoundationFunctions, FoundationTypeConflict),
        BuiltinTypeRole(IntegerType, StringType, FloatType, VoidType, ListType),
        check_builtin_types, render_builtin_type_error
    ../../../src/utils/source:
        ModuleId, ModuleKind(UserModule, FoundationTypesModule, FoundationPreludeModule),
        foundation_prelude_module_id, foundation_types_module_id, module_id, module_source, root_module_id, same_source
    ../../../src/utils/syntax: Diagnostic
    option: to_result, is_none
    ../../../src/utils/text: concat
    test: TestSuite


private TYPES: String =
    |type Int = builtin
    |type Float = builtin
    |type String = builtin
    |type Void = builtin
    |type List[T] = builtin
    |


private pure func program(base: String, root: String, prelude: String, base_targets: List[Int]) -> Result[ParsedProgram, Diagnostic]:
    setup: Diagnostic = { span = { source = module_source(root_module_id()), start = 0, end = 0 }, note = None, message = "test setup", help = "test setup" }
    base_id = foundation_types_module_id()
    prelude_id = foundation_prelude_module_id()
    initial = begin_program()
    root_tokens ?= lex(module_source(root_module_id()), root, assembly_names(initial))
    root_parsed ?= parse_module(root_tokens, root_module_id())
    root_assembly ?= append_module(initial, root_parsed, [], UserModule)
    base_tokens ?= lex(module_source(base_id), base, assembly_names(root_assembly))
    base_parsed ?= parse_module(base_tokens, base_id)
    var targets: List[ModuleId] = []
    var failure: Option[Diagnostic] = None
    for target in base_targets:
        match module_id(target):
            Some(id): targets = targets.append(id)
            None: failure = Some(setup)
    valid ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    base_assembly ?= append_module(root_assembly, base_parsed, targets, FoundationTypesModule)
    prelude_tokens ?= lex(module_source(prelude_id), prelude, assembly_names(base_assembly))
    prelude_parsed ?= parse_module(prelude_tokens, prelude_id)
    complete ?= append_module(base_assembly, prelude_parsed, [], FoundationPreludeModule)
    seal_program(complete)


private pure func same_role(left: BuiltinTypeRole, right: BuiltinTypeRole) -> Bool:
    match (left, right):
        (IntegerType, IntegerType) | (StringType, StringType) | (FloatType, FloatType) | (VoidType, VoidType) | (ListType, ListType): True
        _: False


private pure func same_error_kind(left: BuiltinTypeErrorKind, right: BuiltinTypeErrorKind) -> Bool:
    match (left, right):
        (MissingBuiltinType(a), MissingBuiltinType(b)): same_role(a, b)
        (DuplicateBuiltinType(a), DuplicateBuiltinType(b)): same_role(a, b)
        (FoundationTypeConflict(a), FoundationTypeConflict(b)): same_role(a, b)
        (BuiltinOutsideFoundation, BuiltinOutsideFoundation) | (FoundationImports, FoundationImports) | (FoundationFunctions, FoundationFunctions): True
        _: False


private pure func spelling_is(names: NameTable, spelling: String, expected: NameId) -> Bool:
    match existing_name(names, spelling):
        Some(actual): same_name(actual, expected)
        None: False


private pure func rejected(base: String, kind: BuiltinTypeErrorKind, message: String, help: String) -> Bool:
    match program(base, "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Ok(_): False
                Err(error):
                    rendered = render_builtin_type_error(error)
                    (
                        same_error_kind(error.kind, kind) and rendered.message == message and rendered.help == help
                        and rendered.note.is_none() and same_source(error.span.source, module_source(parsed_contents(parsed).foundation.types))
                    )


pure func test_one_primitive_authority_uses_complete_program_names() -> Bool:
    match program(TYPES, "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Err(_): False
                Ok(initial):
                    names = parsed_contents(parsed).names
                    (
                        spelling_is(names, "Int", initial.special.integer)
                        and spelling_is(names, "Float", initial.special.float)
                        and spelling_is(names, "String", initial.special.string)
                        and spelling_is(names, "Void", initial.special.unit)
                        and spelling_is(names, "List", initial.special.list)
                        and same_name(initial.special.main, parsed_contents(parsed).entrypoint)
                    )


pure func test_builtin_roles_are_distinct_in_reverse_declaration_order() -> Bool:
    reversed: String =
        |type List[T] = builtin
        |type Void = builtin
        |type String = builtin
        |type Float = builtin
        |type Int = builtin
        |
    match program(reversed, "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Err(_): False
                Ok(initial):
                    names = parsed_contents(parsed).names
                    (
                        spelling_is(names, "Int", initial.special.integer)
                        and spelling_is(names, "Float", initial.special.float)
                        and spelling_is(names, "String", initial.special.string)
                        and spelling_is(names, "Void", initial.special.unit)
                        and spelling_is(names, "List", initial.special.list)
                    )


pure func test_missing_int_has_typed_error_and_teaching_diagnostic() -> Bool:
    rejected("", MissingBuiltinType(IntegerType), "missing Int builtin declaration", "add type Int = builtin to _base.brp")


pure func test_missing_string_has_typed_error_and_teaching_diagnostic() -> Bool:
    rejected("type Int = builtin\n", MissingBuiltinType(StringType), "missing String builtin declaration", "add type String = builtin to _base.brp")


pure func test_missing_void_has_typed_error() -> Bool:
    rejected("type Int = builtin\ntype String = builtin\n", MissingBuiltinType(VoidType), "missing Void builtin declaration", "add type Void = builtin to _base.brp")


pure func test_missing_float_has_typed_error() -> Bool:
    rejected("type Int = builtin\ntype String = builtin\ntype Void = builtin\n", MissingBuiltinType(FloatType), "missing Float builtin declaration", "add type Float = builtin to _base.brp")


pure func test_missing_list_has_typed_error() -> Bool:
    rejected("type Int = builtin\ntype String = builtin\ntype Void = builtin\ntype Float = builtin\n", MissingBuiltinType(ListType), "missing List builtin declaration", "add type List[T] = builtin to _base.brp")


pure func test_duplicate_int_has_typed_error() -> Bool:
    rejected(TYPES.concat("type Int = builtin\n"), DuplicateBuiltinType(IntegerType), "duplicate builtin type declaration", "declare type Int = builtin exactly once")


pure func test_duplicate_float_has_typed_error() -> Bool:
    rejected(TYPES.concat("type Float = builtin\n"), DuplicateBuiltinType(FloatType), "duplicate builtin type declaration", "declare type Float = builtin exactly once")


pure func test_duplicate_string_has_typed_error() -> Bool:
    rejected(TYPES.concat("type String = builtin\n"), DuplicateBuiltinType(StringType), "duplicate builtin type declaration", "declare type String = builtin exactly once")


pure func test_duplicate_void_has_typed_error() -> Bool:
    rejected(TYPES.concat("type Void = builtin\n"), DuplicateBuiltinType(VoidType), "duplicate builtin type declaration", "declare type Void = builtin exactly once")


pure func test_duplicate_list_has_typed_error() -> Bool:
    rejected(TYPES.concat("type List[T] = builtin\n"), DuplicateBuiltinType(ListType), "duplicate builtin type declaration", "declare type List[T] = builtin exactly once")


pure func test_builtin_declaration_outside_foundation_is_rejected_at_its_name() -> Bool:
    match program(TYPES, "type Int = builtin\nfunc main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Ok(_): False
                Err(error):
                    (
                        same_error_kind(error.kind, BuiltinOutsideFoundation) and same_source(error.span.source, module_source(root_module_id()))
                        and error.span.start == 5 and error.span.end == 8
                        and render_builtin_type_error(error).help == "remove this declaration; builtin types are supplied by _base.brp under --library-root"
                    )


pure func test_foundation_cannot_declare_functions() -> Bool:
    rejected(TYPES.concat("pure func helper() -> Int:\n    0\n"), FoundationFunctions,
        "foundation types cannot declare functions", "move functions to a library operation module and select its methods in prelude.brp")


pure func test_foundation_cannot_import_modules() -> Bool:
    match program("import:\n    ./ops: helper\n".concat(TYPES), "func main() -> Int:\n    0\n", "", [0]):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Ok(_): False
                Err(error):
                    (
                        same_error_kind(error.kind, FoundationImports) and error.span.start == 12 and error.span.end == 25
                        and render_builtin_type_error(error).message == "foundation types cannot import modules"
                    )


pure func test_ordinary_base_unions_are_preserved() -> Bool:
    unions: String =
        |fixed union Bool:
        |    True
        |    False
        |fixed union Option[A]:
        |    Some(A)
        |    None
        |fixed union Result[Value, Error]:
        |    Ok(Value)
        |    Err(Error)
        |
    match program(TYPES.concat(unions), "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Err(_): False
                Ok(_): inventory_unions(parsed_contents(parsed).declarations).length() == 3 and parsed_contents(parsed).builtin_types.length() == 5


private pure func foundation_nominal_conflict_rejected(prefix: String, name: String, suffix: String, role: BuiltinTypeRole) -> Bool:
    base = TYPES.concat(prefix).concat(name).concat(suffix)
    match program(base, "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Ok(_): False
                Err(error):
                    rendered = render_builtin_type_error(error)
                    (
                        same_error_kind(error.kind, FoundationTypeConflict(role))
                        and same_source(error.span.source, module_source(parsed_contents(parsed).foundation.types))
                        and error.span.start == TYPES.length() + prefix.length()
                        and error.span.end == TYPES.length() + prefix.length() + name.length()
                        and rendered.message == "foundation type conflicts with a builtin declaration"
                        and rendered.help == "remove or rename this fixed union or record; ".concat(name).concat(" is owned by its builtin declaration")
                        and rendered.note.is_none()
                    )

pure func test_foundation_record_cannot_redeclare_builtin_type() -> Bool:
    foundation_nominal_conflict_rejected("fixed record ", "Float", " { value: Int }\n", FloatType)

pure func test_foundation_union_cannot_redeclare_builtin_type() -> Bool:
    foundation_nominal_conflict_rejected("fixed union ", "Int", ":\n    Value\n", IntegerType)


private pure func first_error_kind(base: String, targets: List[Int], expected: BuiltinTypeErrorKind) -> Bool:
    match program(base, "func main() -> Int:\n    0\n", "", targets):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Ok(_): False
                Err(error): same_error_kind(error.kind, expected)


-- The checks run in a fixed order and report the first failure, so a module
-- with several problems always gets the same diagnostic.
pure func test_foundation_functions_take_precedence_over_imports() -> Bool:
    base = "import:\n    ./ops: helper\n".concat(TYPES).concat("pure func helper() -> Int:\n    0\n")
    first_error_kind(base, [0], FoundationFunctions)


pure func test_missing_builtin_takes_precedence_over_nominal_conflict() -> Bool:
    base = "type Int = builtin\ntype String = builtin\ntype Float = builtin\ntype List[T] = builtin\nfixed record Float { value: Int }\n"
    first_error_kind(base, [], MissingBuiltinType(VoidType))


tests: TestSuite = {
    description = "Blorp 2 foundation builtin authority",
    tests = [
        ("one authority uses complete names", test_one_primitive_authority_uses_complete_program_names),
        ("builtin roles remain distinct in reverse declaration order", test_builtin_roles_are_distinct_in_reverse_declaration_order),
        ("missing Int diagnostic", test_missing_int_has_typed_error_and_teaching_diagnostic),
        ("missing String diagnostic", test_missing_string_has_typed_error_and_teaching_diagnostic),
        ("missing Void diagnostic", test_missing_void_has_typed_error),
        ("missing Float diagnostic", test_missing_float_has_typed_error),
        ("missing List diagnostic", test_missing_list_has_typed_error),
        ("duplicate Int diagnostic", test_duplicate_int_has_typed_error),
        ("duplicate Float diagnostic", test_duplicate_float_has_typed_error),
        ("duplicate String diagnostic", test_duplicate_string_has_typed_error),
        ("duplicate Void diagnostic", test_duplicate_void_has_typed_error),
        ("duplicate List diagnostic", test_duplicate_list_has_typed_error),
        ("builtin outside foundation", test_builtin_declaration_outside_foundation_is_rejected_at_its_name),
        ("foundation functions rejected", test_foundation_cannot_declare_functions),
        ("foundation imports rejected", test_foundation_cannot_import_modules),
        ("ordinary base unions retained", test_ordinary_base_unions_are_preserved),
        ("foundation record cannot redeclare builtin", test_foundation_record_cannot_redeclare_builtin_type),
        ("foundation union cannot redeclare builtin", test_foundation_union_cannot_redeclare_builtin_type),
        ("foundation functions precede imports", test_foundation_functions_take_precedence_over_imports),
        ("missing builtin precedes nominal conflict", test_missing_builtin_takes_precedence_over_nominal_conflict),
    ]
}
