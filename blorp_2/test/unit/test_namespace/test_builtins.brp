    rejected(source, MissingBuiltinType(ListType), "missing List builtin declaration", "add type List[T] = builtin to _base.brp")


pure func test_duplicate_int_has_typed_error() -> Bool:
    rejected(TYPES.concat("type Int = builtin\n"), DuplicateBuiltinType(IntegerType), "duplicate builtin type declaration", "declare type Int = builtin exactly once")


pure func test_duplicate_float_has_typed_error() -> Bool:
    rejected(TYPES.concat("type Float = builtin\n"), DuplicateBuiltinType(FloatType), "duplicate builtin type declaration", "declare type Float = builtin exactly once")


pure func test_duplicate_string_has_typed_error() -> Bool:
    rejected(TYPES.concat("type String = builtin\n"), DuplicateBuiltinType(StringType), "duplicate builtin type declaration", "declare type String = builtin exactly once")


pure func test_duplicate_void_has_typed_error() -> Bool:
    rejected(TYPES.concat("type Void = builtin\n"), DuplicateBuiltinType(VoidType), "duplicate builtin type declaration", "declare type Void = builtin exactly once")


pure func test_duplicate_list_has_typed_error() -> Bool:
    rejected(TYPES.concat("type List[T] = builtin\n"), DuplicateBuiltinType(ListType), "duplicate builtin type declaration", "declare type List[T] = builtin exactly once")


pure func test_builtin_declaration_outside_foundation_is_rejected_at_its_name() -> Bool:
    source: String =
        |type Int = builtin
        |func main() -> Int:
        |    0
        |

    match program(TYPES, source, "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Ok(_): False
                Err(error):
                    (
                        same_error_kind(error.kind, BuiltinOutsideFoundation) and same_source(error.span.source, module_source(root_module_id()))
                        and error.span.start == 5 and error.span.end == 8
                        and render_builtin_type_error(error).help == "remove this declaration; builtin types are supplied by _base.brp under --library-root"
                    )


pure func test_foundation_cannot_declare_functions() -> Bool:
    rejected(TYPES.concat("pure func helper() -> Int:\n    0\n"), FoundationFunctions,
        "foundation types cannot declare functions", "move functions to a library operation module and select its methods in prelude.brp")


pure func test_foundation_cannot_import_modules() -> Bool:
    match program("import:\n    ./ops: helper\n".concat(TYPES), "func main() -> Int:\n    0\n", "", [0]):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Ok(_): False
                Err(error):
                    (
                        same_error_kind(error.kind, FoundationImports) and error.span.start == 12 and error.span.end == 25
                        and render_builtin_type_error(error).message == "foundation types cannot import modules"
                    )


pure func test_ordinary_base_unions_are_preserved() -> Bool:
    match program(TYPES.concat(UNIONS), "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Err(_): False
                Ok(_): inventory_unions(parsed_contents(parsed).declarations).length() == 3 and parsed_contents(parsed).builtin_types.length() == 5


-- The foundation union of this spelling, found by its published name.
private pure func foundation_union(parsed: ParsedProgram, spelling: String) -> Option[UnionRow]:
    contents = parsed_contents(parsed)
    var found: Option[UnionRow] = None
    match existing_name(contents.names, spelling):
        Some(name):
            for row in inventory_unions(contents.declarations):
                if same_name(row.type_name.id, name):
                    found = Some(row)
        None: void
    found


-- `variant` is the variant at `position` of the foundation union `spelling`.
private pure func is_variant(parsed: ParsedProgram, variant: VariantId, spelling: String, position: Int) -> Bool:
    match foundation_union(parsed, spelling):
        Some(row): union_number(variant_owner(variant)) == union_number(row.id) and variant_number(variant) == position
        None: False


pure func test_designation_names_each_constructor_of_the_foundation_unions() -> Bool:
    match program(TYPES.concat(UNIONS), "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Err(_): False
                Ok(foundation):
                    unions = foundation.designated
                    (
                        is_variant(parsed, unions.boolean.true_variant, "Bool", 0) and is_variant(parsed, unions.boolean.false_variant, "Bool", 1)
                        and is_variant(parsed, unions.option.some, "Option", 0) and is_variant(parsed, unions.option.none, "Option", 1)
                        and is_variant(parsed, unions.result.ok, "Result", 0) and is_variant(parsed, unions.result.err, "Result", 1)
                    )


-- Constructors are designated by name; declaration order stays the layout.
pure func test_designation_follows_names_not_declaration_order() -> Bool:
    reversed: String =
        |fixed union Result[Value, Error]:
        |    Err(Error)
        |    Ok(Value)
        |fixed union Option[A]:
        |    None
        |    Some(A)
        |fixed union Bool:
        |    False
        |    True
        |
    match program(TYPES.concat(reversed), "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Err(_): False
                Ok(foundation):
                    unions = foundation.designated
                    (
                        is_variant(parsed, unions.boolean.true_variant, "Bool", 1) and is_variant(parsed, unions.boolean.false_variant, "Bool", 0)
                        and is_variant(parsed, unions.option.some, "Option", 1) and is_variant(parsed, unions.option.none, "Option", 0)
                        and is_variant(parsed, unions.result.ok, "Result", 1) and is_variant(parsed, unions.result.err, "Result", 0)
                    )


-- A same-named union outside the foundation is an ordinary declaration.
pure func test_user_bool_is_not_the_designated_bool() -> Bool:
    root: String =
        |fixed union Bool:
        |    True
        |    False
        |func main() -> Int:
        |    0
        |
    match program(TYPES.concat(UNIONS), root, "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Err(_): False
                Ok(foundation):
                    match (inventory_unions(parsed_contents(parsed).declarations).get(0), foundation_union(parsed, "Bool")):
                        (Some(user), Some(_)):
                            owner = variant_owner(foundation.designated.boolean.true_variant)
                            union_number(user.id) == 0 and union_number(owner) != union_number(user.id) and is_variant(parsed, foundation.designated.boolean.true_variant, "Bool", 0)
                        _: False


-- A user module cannot redeclare Bool: the prelude already exposes the
-- designated one, so the existing type-conflict rule rejects it.
pure func test_user_module_cannot_redeclare_the_designated_bool() -> Bool:
    root: String =
        |fixed union Bool:
        |    Yes
        |    No
        |func main() -> Int:
        |    0
        |
    match parse_modules([{ source = root, targets = [] }]):
        Err(_): False
        Ok(parsed):
            match check(parsed):
                Ok(_): False
                Err(failure):
                    rendered = render_failure(failure).first
                    (
                        check_errors(failure).remaining.is_empty()
                        and rendered.message == "Bool is provided by the prelude"
                        and rendered.help == "give this type another name; the prelude's type Bool is always in scope"
                        and same_source(rendered.span.source, module_source(root_module_id()))
                        and rendered.span.start == 12 and rendered.span.end == 16
                    )


private pure func designation_rejected(base: String, start: Int, end: Int, kind: BuiltinTypeErrorKind, message: String, help: String) -> Bool:
    match program(base, "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Ok(_): False
                Err(error):
                    rendered = render_builtin_type_error(error)
                    (
                        same_error_kind(error.kind, kind)
                        and same_source(error.span.source, module_source(parsed_contents(parsed).foundation.types))
                        and error.span.start == start and error.span.end == end
                        and rendered.message == message and rendered.help == help and rendered.note.is_none()
                    )


private BOOL_SHAPE: String = "fixed union Bool with exactly the variants True and False"
private OPTION_SHAPE: String = "fixed union Option[A] with exactly the variants Some(A) and None"
private RESULT_SHAPE: String = "fixed union Result[Value, Error] with exactly the variants Ok(Value) and Err(Error)"


pure func test_missing_bool_is_reported_at_the_foundation_end() -> Bool:
    base = TYPES.concat(OPTION).concat(RESULT)
    designation_rejected(base, base.length(), base.length(), MissingDesignatedUnion(BoolUnion), "missing Bool union declaration", "add ".concat(BOOL_SHAPE).concat(" to _base.brp"))


pure func test_missing_option_is_reported_at_the_foundation_end() -> Bool:
    base = TYPES.concat(BOOL).concat(RESULT)
    designation_rejected(base, base.length(), base.length(), MissingDesignatedUnion(OptionUnion), "missing Option union declaration", "add ".concat(OPTION_SHAPE).concat(" to _base.brp"))


pure func test_missing_result_is_reported_at_the_foundation_end() -> Bool:
    base = TYPES.concat(BOOL).concat(OPTION)
    designation_rejected(base, base.length(), base.length(), MissingDesignatedUnion(ResultUnion), "missing Result union declaration", "add ".concat(RESULT_SHAPE).concat(" to _base.brp"))


-- `declaration` replaces the well-formed union of its role; the error names it.
private pure func malformed(role: DesignatedUnionRole, declaration: String, spelling: String, shape: String) -> Bool:
    base = match role:
        BoolUnion: TYPES.concat(OPTION).concat(RESULT).concat(declaration)
        OptionUnion: TYPES.concat(BOOL).concat(RESULT).concat(declaration)
        ResultUnion: TYPES.concat(BOOL).concat(OPTION).concat(declaration)
    start = base.length() - declaration.length() + "fixed union ".length()
    designation_rejected(base, start, start + spelling.length(), MalformedDesignatedUnion(role),
        "foundation union ".concat(spelling).concat(" does not have its designated shape"), "declare it as ".concat(shape))


pure func test_bool_with_a_payload_is_malformed() -> Bool:
    source: String =
        |fixed union Bool:
        |    True(Int)
        |    False
        |

    malformed(BoolUnion, source, "Bool", BOOL_SHAPE)

pure func test_bool_with_a_third_variant_is_malformed() -> Bool:
    source: String =
        |fixed union Bool:
        |    True
        |    False
        |    Unknown
        |

    malformed(BoolUnion, source, "Bool", BOOL_SHAPE)

pure func test_bool_with_other_constructor_names_is_malformed() -> Bool:
    source: String =
        |fixed union Bool:
        |    Yes
        |    No
        |

    malformed(BoolUnion, source, "Bool", BOOL_SHAPE)

pure func test_generic_bool_is_malformed() -> Bool:
    source: String =
        |fixed union Bool[A]:
        |    True
        |    False
        |

    malformed(BoolUnion, source, "Bool", BOOL_SHAPE)

pure func test_nongeneric_option_is_malformed() -> Bool:
    source: String =
        |fixed union Option:
        |    Some(Int)
        |    None
        |

    malformed(OptionUnion, source, "Option", OPTION_SHAPE)

pure func test_option_payload_must_be_its_parameter() -> Bool:
    source: String =
        |fixed union Option[A]:
        |    Some(Int)
        |    None
        |

    malformed(OptionUnion, source, "Option", OPTION_SHAPE)

pure func test_option_none_must_be_empty() -> Bool:
    source: String =
        |fixed union Option[A]:
        |    Some(A)
        |    None(A)
        |

    malformed(OptionUnion, source, "Option", OPTION_SHAPE)

pure func test_option_some_takes_exactly_one_payload() -> Bool:
    source: String =
        |fixed union Option[A]:
        |    Some(A, A)
        |    None
        |

    malformed(OptionUnion, source, "Option", OPTION_SHAPE)

pure func test_result_payloads_follow_parameter_order() -> Bool:
    source: String =
        |fixed union Result[Value, Error]:
        |    Ok(Error)
        |    Err(Value)
        |

    malformed(ResultUnion, source, "Result", RESULT_SHAPE)

pure func test_result_requires_two_parameters() -> Bool:
    source: String =
        |fixed union Result[Value]:
        |    Ok(Value)
        |    Err(Value)
        |

    malformed(ResultUnion, source, "Result", RESULT_SHAPE)


-- The base owns its builtin names, so the namespace reports a base union or
-- record of the same name as a second declaration of that type.
private pure func foundation_nominal_conflict_rejected(prefix: String, name: String, suffix: String) -> Bool:
    base = TYPES.concat(UNIONS).concat(prefix).concat(name).concat(suffix)
    match program(base, "func main() -> Int:\n    0\n", "", []):
        Err(_): False
        Ok(parsed):
            match check(parsed):
                Ok(_): False
                Err(failure):
                    rendered = render_failure(failure).first
                    start = TYPES.length() + UNIONS.length() + prefix.length()
                    declared_at = match TYPES.index_of("type ".concat(name)):
                        Some(at): at + "type ".length()
                        None: -1
                    noted = match rendered.note:
                        Some(PreviousDeclaration(previous)): previous.start == declared_at
                        _: False
                    (
                        noted
                        and same_source(rendered.span.source, module_source(parsed_contents(parsed).foundation.types))
                        and rendered.span.start == start
                        and rendered.span.end == start + name.length()
                        and rendered.message == "duplicate type name"
                        and rendered.help == "give each type in a module a distinct name"
                    )

pure func test_foundation_record_cannot_redeclare_builtin_type() -> Bool:
    foundation_nominal_conflict_rejected("fixed record ", "Float", " { value: Int }\n")

pure func test_foundation_union_cannot_redeclare_builtin_type() -> Bool:
    foundation_nominal_conflict_rejected("fixed union ", "Int", ":\n    Value\n")


private pure func first_error_kind(base: String, targets: List[Int], expected: BuiltinTypeErrorKind) -> Bool:
    match program(base, "func main() -> Int:\n    0\n", "", targets):
        Err(_): False
        Ok(parsed):
            match check_builtin_types(parsed):
                Ok(_): False
                Err(error): same_error_kind(error.kind, expected)


-- The checks run in a fixed order and report the first failure, so a module
-- with several problems always gets the same diagnostic.
pure func test_foundation_functions_take_precedence_over_imports() -> Bool:
    base = "import:\n    ./ops: helper\n".concat(TYPES).concat("pure func helper() -> Int:\n    0\n")
    first_error_kind(base, [0], FoundationFunctions)


pure func test_missing_builtin_takes_precedence_over_nominal_conflict() -> Bool:
    base: String =
        |type Int = builtin
        |type String = builtin
        |type Float = builtin
        |type List[T] = builtin
        |fixed record Float { value: Int }
        |
    first_error_kind(base, [], MissingBuiltinType(VoidType))


tests: TestSuite = {
    description = "Blorp 2 foundation builtin authority",
    tests = [
        ("one authority uses complete names", test_one_primitive_authority_uses_complete_program_names),
        ("builtin roles remain distinct in reverse declaration order", test_builtin_roles_are_distinct_in_reverse_declaration_order),
        ("missing Int diagnostic", test_missing_int_has_typed_error_and_teaching_diagnostic),
        ("missing String diagnostic", test_missing_string_has_typed_error_and_teaching_diagnostic),
        ("missing Void diagnostic", test_missing_void_has_typed_error),
        ("missing Float diagnostic", test_missing_float_has_typed_error),
        ("missing List diagnostic", test_missing_list_has_typed_error),
        ("duplicate Int diagnostic", test_duplicate_int_has_typed_error),
        ("duplicate Float diagnostic", test_duplicate_float_has_typed_error),
        ("duplicate String diagnostic", test_duplicate_string_has_typed_error),
        ("duplicate Void diagnostic", test_duplicate_void_has_typed_error),
        ("duplicate List diagnostic", test_duplicate_list_has_typed_error),
        ("builtin outside foundation", test_builtin_declaration_outside_foundation_is_rejected_at_its_name),
        ("foundation functions rejected", test_foundation_cannot_declare_functions),
        ("foundation imports rejected", test_foundation_cannot_import_modules),
        ("ordinary base unions retained", test_ordinary_base_unions_are_preserved),
        ("designation names each foundation constructor", test_designation_names_each_constructor_of_the_foundation_unions),
        ("designation follows names not order", test_designation_follows_names_not_declaration_order),
        ("user Bool is not designated", test_user_bool_is_not_the_designated_bool),
        ("user module cannot redeclare Bool", test_user_module_cannot_redeclare_the_designated_bool),
        ("missing Bool diagnostic", test_missing_bool_is_reported_at_the_foundation_end),
        ("missing Option diagnostic", test_missing_option_is_reported_at_the_foundation_end),
        ("missing Result diagnostic", test_missing_result_is_reported_at_the_foundation_end),
        ("Bool payload rejected", test_bool_with_a_payload_is_malformed),
        ("Bool third variant rejected", test_bool_with_a_third_variant_is_malformed),
        ("Bool constructor names required", test_bool_with_other_constructor_names_is_malformed),
        ("generic Bool rejected", test_generic_bool_is_malformed),
        ("nongeneric Option rejected", test_nongeneric_option_is_malformed),
        ("Option payload is its parameter", test_option_payload_must_be_its_parameter),
        ("Option None is empty", test_option_none_must_be_empty),
        ("Option Some has one payload", test_option_some_takes_exactly_one_payload),
        ("Result payloads follow parameters", test_result_payloads_follow_parameter_order),
        ("Result has two parameters", test_result_requires_two_parameters),
        ("foundation record cannot redeclare builtin", test_foundation_record_cannot_redeclare_builtin_type),
        ("foundation union cannot redeclare builtin", test_foundation_union_cannot_redeclare_builtin_type),
        ("foundation functions precede imports", test_foundation_functions_take_precedence_over_imports),
        ("missing builtin precedes nominal conflict", test_missing_builtin_takes_precedence_over_nominal_conflict),
    ]
}
