import:
	../../../src/utils/ids: function_number, inventory_functions, inventory_records, inventory_unions, record_number, union_number, variant_number, variant_owner
	../../../src/check/check: check, checked_functions
	../../../src/check/signatures: validate_signatures
	../../../src/check/types: validate_declarations, validate_finite_declarations
	../../../src/namespace/builtins: PrimitiveType(BuiltinInt, BuiltinFloat, BuiltinString, BuiltinVoid)
	../../../src/utils/names: find_name, same_name
	../../../src/namespace/namespace:
		FunctionOrigin(ImportedFunction),
		ImportProblem(RepeatedModuleImport, MissingImportedFunction),
		NamespaceProblem(ImportSelectionFailure, ImportedFunctionNameConflict, DuplicateFunctionName),
		TypeCandidate(PrimitiveCandidate, ListCandidate, UnionCandidate, RecordCandidate),
		build_namespace,
		function_candidate,
		local_function,
		same_type_candidate,
		type_candidate,
		variant_candidates,
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/source: module_id, root_module_id, same_module, same_source, module_source
	../module_input: parse_modules
	../declaration_inputs: sample_inventory
	test: TestSuite


pure func test_candidate_equality_distinguishes_every_kind_and_nominal_owner() -> Bool:
	inventory = sample_inventory()
	match (inventory_records(inventory), inventory_unions(inventory)):
		([first_record, second_record, _, _], [first_union, second_union, _, _, _]):
			candidates: List[TypeCandidate] = [
				PrimitiveCandidate(BuiltinInt),
				PrimitiveCandidate(BuiltinFloat),
				PrimitiveCandidate(BuiltinString),
				PrimitiveCandidate(BuiltinVoid),
				ListCandidate,
				UnionCandidate(first_union.id),
				UnionCandidate(second_union.id),
				RecordCandidate(first_record.id),
				RecordCandidate(second_record.id),
			]
			var correct = True
			for left_position in 0..candidates.length():
				for right_position in 0..candidates.length():
					match candidates.get(left_position):
						None: correct = False
						Some(left):
							match candidates.get(right_position):
								None: correct = False
								Some(right):
									expected = left_position == right_position
									correct = correct and same_type_candidate(left, right) == expected
									correct = correct and same_type_candidate(right, left) == expected
			correct
		_: False


pure func test_selected_functions_preserve_identity_and_import_origin() -> Bool:
	main: String =
		|import:
		|    ./helper: answer
		|func main() -> Int:
		|    answer()
		|
	helper: String =
		|pure func answer() -> Int:
		|    42
		|pure func hidden() -> Int:
		|    7
		|
	match parse_modules([{ source = main, targets = [1] }, { source = helper, targets = [] }]):
		Err(_):
			False
		Ok(program):
			parsed = parsed_contents(program)
			match build_namespace(program):
				Err(_): False
				Ok(namespace):
					match (find_name(parsed.names, "answer"), find_name(parsed.names, "hidden"), module_id(1)):
						(Some(answer), Some(hidden), Some(dependency)):
							match (function_candidate(namespace, root_module_id(), answer), local_function(namespace, dependency, answer)):
								(Some(imported), Some(local)):
									match imported.origin:
										ImportedFunction(span):
											(
												function_number(imported.function) == 1 and function_number(local) == 1
													and span.start == 22 and span.end == 28
													and same_source(span.source, module_source(root_module_id()))
													and local_function(namespace, root_module_id(), answer).is_none()
													and function_candidate(namespace, root_module_id(), hidden).is_none()
											)
										_:
											False
								_:
									False
						_:
							False


pure func test_same_named_imports_from_different_owners_fail_publication() -> Bool:
	main: String =
		|import:
		|    ./left: answer
		|    ./right: answer
		|func main() -> Int:
		|    answer()
		|
	helper = "pure func answer() -> Int:\n    42\n"
	match parse_modules([{ source = main, targets = [1, 2] }, { source = helper, targets = [] }, { source = helper, targets = [] }]):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			match (build_namespace(program), inventory_functions(parsed.declarations), find_name(parsed.names, "answer")):
				(Err(failure), [_, left, right], Some(answer)):
					match failure.first:
						ImportedFunctionNameConflict(written, previous):
							(
								failure.remaining.is_empty() and same_name(written.id, answer)
								and function_number(left.id) == 1 and function_number(right.id) == 2
								and written.span.start == 40 and written.span.end == 46
								and previous.start == 20 and previous.end == 26
								and same_source(written.span.source, module_source(root_module_id()))
								and same_source(previous.source, written.span.source)
							)
						_: False
				_: False

pure func test_types_and_variants_stay_local_to_the_defining_module() -> Bool:
	main = "import:\n    ./helper: make\nfunc main() -> Int:\n    0\n"
	helper: String =
		|fixed union Choice:
		|    One(Int)
		|pure func make() -> Choice:
		|    One(42)
		|
	match parse_modules([{ source = main, targets = [1] }, { source = helper, targets = [] }]):
		Err(_):
			False
		Ok(program):
			parsed = parsed_contents(program)
			match build_namespace(program):
				Err(_): False
				Ok(namespace):
					match (find_name(parsed.names, "Choice"), find_name(parsed.names, "One"), module_id(1)):
						(Some(choice), Some(one), Some(dependency)):
							match (type_candidate(namespace, dependency, choice), variant_candidates(namespace, dependency, one)):
								(Some(UnionCandidate(owner)), [variant]):
									(
										union_number(owner) == 0 and union_number(variant_owner(variant)) == 0
											and variant_number(variant) == 0
											and type_candidate(namespace, root_module_id(), choice).is_none()
											and variant_candidates(namespace, root_module_id(), one).length() == 0
									)
								_:
									False
						_:
							False


pure func test_imported_functions_are_not_reexported() -> Bool:
	main = "import:\n    ./facade: answer\nfunc main() -> Int:\n    0\n"
	facade = "import:\n    ./helper: answer\n"
	helper = "pure func answer() -> Int:\n    42\n"
	-- First prove the facade's own successful scope, then reject re-export.
	facade_scope = match parse_modules([
		{ source = "func main() -> Int:\n    0\n", targets = [] },
		{ source = facade, targets = [2] }, { source = helper, targets = [] },
	]):
		Err(_): False
		Ok(program):
			match (build_namespace(program), find_name(parsed_contents(program).names, "answer"), module_id(1)):
				(Ok(namespace), Some(answer), Some(facade_id)):
					match function_candidate(namespace, facade_id, answer):
						Some(candidate):
							function_number(candidate.function) == 1 and function_candidate(namespace, root_module_id(), answer).is_none()
						None: False
				_: False
	match parse_modules([{ source = main, targets = [1] }, { source = facade, targets = [2] }, { source = helper, targets = [] }]):
		Err(_): False
		Ok(program):
			match (build_namespace(program), module_id(1)):
				(Err(failure), Some(facade_id)):
					match failure.first:
						ImportSelectionFailure(MissingImportedFunction(target, written)):
							(
								facade_scope and failure.remaining.is_empty() and same_module(target, facade_id)
								and written.span.start == 22 and written.span.end == 28
								and same_source(written.span.source, module_source(root_module_id()))
							)
						_: False
				_: False

pure func test_import_problems_preserve_repeated_missing_and_type_facts() -> Bool:
	main: String =
		|import:
		|    ./helper: Choice, missing
		|    ./again: answer
		|func main() -> Int:
		|    0
		|
	helper: String =
		|fixed union Choice:
		|    One
		|pure func answer() -> Int:
		|    42
		|
	match parse_modules([{ source = main, targets = [1, 1] }, { source = helper, targets = [] }]):
		Err(_): False
		Ok(program):
			match build_namespace(program):
				Err(failure):
					match (failure.first, failure.remaining):
						(ImportSelectionFailure(MissingImportedFunction(first, _)), [ImportSelectionFailure(RepeatedModuleImport(second, previous, current))]):
							same_module(first, second) and previous.start == 12 and current.start == 42
						_: False
				Ok(_): False

pure func test_duplicate_target_functions_fail_publication_before_local_duplicates() -> Bool:
	main = "import:\n    ./helper: answer\nfunc main() -> Int:\n    0\n"
	helper = "pure func answer() -> Int:\n    42\npure func answer() -> Int:\n    7\n"
	match parse_modules([{ source = main, targets = [1] }, { source = helper, targets = [] }]):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			match (build_namespace(program), inventory_functions(parsed.declarations)):
				(Err(failure), [_, first, second]):
					match (failure.first, failure.remaining):
						(ImportedFunctionNameConflict(written, previous), [DuplicateFunctionName(duplicate, first_site)]):
							(
								function_number(first.id) == 1 and function_number(second.id) == 2
								and same_name(written.id, first.declaration.function_name.id)
								and same_name(written.id, second.declaration.function_name.id)
								and written.span.start == 22 and written.span.end == 28
								and previous.start == written.span.start and previous.end == written.span.end
								and same_source(previous.source, written.span.source)
								and duplicate.span.start == second.declaration.function_name.span.start
								and first_site.start == first.declaration.function_name.span.start
								and same_source(duplicate.span.source, second.declaration.function_name.span.source)
								and same_source(first_site.source, first.declaration.function_name.span.source)
							)
						_: False
				_: False

pure func test_issued_ids_survive_signatures_bodies_and_nominal_checking() -> Bool:
	main: String =
		|import:
		|    ./helper: Choice(Number), Box, answer
		|func main() -> Int:
		|    answer(Number(42))
		|
	helper: String =
		|fixed record Box { value: Int }
		|fixed union Choice:
		|    Number(Int)
		|pure func answer(value: Choice) -> Int:
		|    match value:
		|        Number(number): number
		|
	match parse_modules([{ source = main, targets = [1] }, { source = helper, targets = [] }]):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			inventory = parsed.declarations
			match build_namespace(program):
				Err(_): False
				Ok(namespace):
					match validate_declarations(parsed, namespace):
						Err(_): False
						Ok(declarations):
							match validate_finite_declarations(declarations):
								Err(_): False
								Ok(_):
									match (validate_signatures(parsed, namespace, declarations.unions), check(program)):
										(Ok(signatures), Ok(checked)):
											accepted = checked_functions(checked)
											(
												inventory_functions(inventory).map(pure func(row): function_number(row.id)) == signatures.functions.map(pure func(row): function_number(row.id))
												and inventory_functions(inventory).map(pure func(row): function_number(row.id)) == accepted.functions.map(pure func(row): function_number(row.id))
												and inventory_records(inventory).map(pure func(row): record_number(row.id)) == accepted.records.map(pure func(row): record_number(row.id))
												and inventory_unions(inventory).map(pure func(row): union_number(row.id)) == accepted.unions.map(pure func(row): union_number(row.id))
												and inventory_unions(inventory).map(pure func(row): row.variants.map(pure func(variant): variant_number(variant.id))) == accepted.unions.map(pure func(row): row.variants.map(pure func(variant): variant_number(variant.id)))
											)
										_: False


tests: TestSuite = {
	description = "Blorp 2 complete module namespaces",
	tests = [
		("candidate equality distinguishes every kind and nominal owner", test_candidate_equality_distinguishes_every_kind_and_nominal_owner),
		("issued IDs survive signatures bodies and nominal checking", test_issued_ids_survive_signatures_bodies_and_nominal_checking),
		("selected functions preserve identity and import origin", test_selected_functions_preserve_identity_and_import_origin),
		("same named imports from different owners fail publication", test_same_named_imports_from_different_owners_fail_publication),
		("types and variants stay local to the defining module", test_types_and_variants_stay_local_to_the_defining_module),
		("imported functions are not reexported", test_imported_functions_are_not_reexported),
		("import problems preserve repeated missing and type facts", test_import_problems_preserve_repeated_missing_and_type_facts),
		("duplicate target functions fail publication before local duplicates", test_duplicate_target_functions_fail_publication_before_local_duplicates),
	]
}
