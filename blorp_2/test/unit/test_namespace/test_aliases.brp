import:
	../input: existing_name
	../../../src/utils/ids: function_number
	../../../src/namespace/namespace:
		Namespace,
		ImportProblem(PrivateImportSelection, RepeatedModuleAlias, ModuleAliasNameConflict),
		NamespaceProblem(ImportSelectionFailure),
		QualifiedLookup(ExportedDeclaration, PrivateDeclaration, NoDeclaration),
		TypeCandidate(RecordCandidate),
		build_namespace,
		exported_functions,
		local_function,
		module_alias,
		qualified_function,
		qualified_type,
		qualified_variant,
	../../../src/parse/assemble: parsed_contents
	../../../src/parse/parse: ImportOrigin(RelativeImport)
	../../../src/utils/names: NameId
	../../../src/utils/source: ModuleId, module_id, root_module_id, same_module
	../module_input: parse_modules
	int as IntOps
	test: TestSuite


private HELPER: String =
	|fixed union Shape:
	|    Circle(Int)
	|private fixed record Pair { first: Int }
	|pure func answer() -> Int:
	|    42
	|private pure func hidden() -> Int:
	|    7
	|pure func visible() -> Int:
	|    hidden()
	|


private pure func program_with(main: String) -> Result[Void, Void]:
	match parse_modules([{ source = main, targets = [1] }, { source = HELPER, targets = [] }]):
		Err(_): Err(void)
		Ok(_): Ok(void)


pure func test_alias_row_names_the_importing_module_and_its_target() -> Bool:
	main: String =
		|import:
		|    ./helper as H
		|func main() -> Int:
		|    H.answer()
		|
	match parse_modules([{ source = main, targets = [1] }, { source = HELPER, targets = [] }]):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			match build_namespace(program):
				Err(_): False
				Ok(namespace):
					match (existing_name(parsed.names, "H"), module_id(1)):
						(Some(alias_name), Some(helper)):
							match module_alias(namespace, root_module_id(), alias_name):
								Some(row):
									path = match row.path.origin:
										RelativeImport(parents): IntOps.equals(parents, 0) and IntOps.equals(row.path.parts.length(), 1)
										_: False
									(
										same_module(row.module, root_module_id()) and same_module(row.target, helper) and path
										and module_alias(namespace, helper, alias_name).is_none()
									)
								None: False
						_: False


pure func test_qualified_lookups_distinguish_exported_private_and_missing() -> Bool:
	main: String =
		|import:
		|    ./helper as H
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = main, targets = [1] }, { source = HELPER, targets = [] }]):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			match build_namespace(program):
				Err(_): False
				Ok(namespace):
					match (existing_name(parsed.names, "answer"), existing_name(parsed.names, "hidden"), existing_name(parsed.names, "Circle"), module_id(1)):
						(Some(answer), Some(hidden), Some(circle), Some(helper)):
							match (existing_name(parsed.names, "Pair"), existing_name(parsed.names, "Shape")):
								(Some(pair), Some(shape)): qualified_lookups_agree(namespace, helper, answer, hidden, circle, pair, shape)
								_: False
						_: False


private pure func qualified_lookups_agree(namespace: Namespace, helper: ModuleId, answer: NameId, hidden: NameId, circle: NameId, pair: NameId, shape: NameId) -> Bool:
	exported_function = match qualified_function(namespace, helper, answer):
		ExportedDeclaration(_): True
		_: False
	private_function = match qualified_function(namespace, helper, hidden):
		PrivateDeclaration(_): True
		_: False
	missing_function = match qualified_function(namespace, helper, shape):
		NoDeclaration: True
		_: False
	exported_variant = match qualified_variant(namespace, helper, circle):
		ExportedDeclaration(_): True
		_: False
	private_type = match qualified_type(namespace, helper, pair):
		PrivateDeclaration(_): True
		_: False
	exported_type = match qualified_type(namespace, helper, shape):
		ExportedDeclaration(_): True
		_: False
	-- A private function stays visible inside its own module.
	local = local_function(namespace, helper, hidden).is_some()
	-- The root declares none of these itself.
	not_root = match qualified_function(namespace, root_module_id(), answer):
		NoDeclaration: True
		_: False
	exported_function and private_function and missing_function and exported_variant and private_type and exported_type and local and not_root


-- The first namespace problem of `main` against HELPER, with the span start
-- expected at `prefix`'s length.
private pure func first_problem(main: String) -> Option[NamespaceProblem]:
	match parse_modules([{ source = main, targets = [1] }, { source = HELPER, targets = [] }]):
		Err(_): None
		Ok(program):
			match build_namespace(program):
				Ok(_): None
				Err(failure): Some(failure.first)


pure func test_selecting_a_private_function_is_rejected_at_the_selection() -> Bool:
	prefix = "import:\n    ./helper: "
	main = prefix + "hidden" + "\nfunc main() -> Int:\n    hidden()\n"
	match first_problem(main):
		Some(ImportSelectionFailure(PrivateImportSelection(name, path))):
			IntOps.equals(name.span.start, prefix.length()) and IntOps.equals(path.parts.length(), 1)
		_: False


pure func test_selecting_a_private_type_is_rejected_at_the_selection() -> Bool:
	prefix = "import:\n    ./helper: "
	main = prefix + "Pair" + "\nfunc main() -> Int:\n    0\n"
	match first_problem(main):
		Some(ImportSelectionFailure(PrivateImportSelection(name, _))): IntOps.equals(name.span.start, prefix.length())
		_: False


pure func test_alias_reusing_a_selected_name_is_rejected() -> Bool:
	prefix = "import:\n    ./helper as "
	main = prefix + "answer" + ": answer\nfunc main() -> Int:\n    answer()\n"
	match first_problem(main):
		Some(ImportSelectionFailure(ModuleAliasNameConflict(name, previous))):
			IntOps.equals(name.span.start, prefix.length()) and IntOps.equals(previous.start, IntOps.add(prefix.length(), 8))
		_: False


pure func test_alias_reusing_a_local_declaration_is_rejected() -> Bool:
	prefix = "import:\n    ./helper as "
	main = prefix + "answer" + "\npure func answer() -> Int:\n    1\nfunc main() -> Int:\n    answer()\n"
	match first_problem(main):
		Some(ImportSelectionFailure(ModuleAliasNameConflict(name, _))): IntOps.equals(name.span.start, prefix.length())
		_: False


pure func test_repeated_alias_across_two_modules_is_rejected() -> Bool:
	other: String =
		|pure func other() -> Int:
		|    1
		|
	prefix = "import:\n    ./helper as H\n    ./other as "
	main = prefix + "H" + "\nfunc main() -> Int:\n    0\n"
	match parse_modules([{ source = main, targets = [1, 2] }, { source = HELPER, targets = [] }, { source = other, targets = [] }]):
		Err(_): False
		Ok(program):
			match build_namespace(program):
				Ok(_): False
				Err(failure):
					match failure.first:
						ImportSelectionFailure(RepeatedModuleAlias(name, previous)):
							IntOps.equals(name.span.start, prefix.length()) and IntOps.equals(previous.start, "import:\n    ./helper as ".length())
						_: False


-- Method selection binds only what the namespace exports; a private function
-- of the target is not among them even though it stays locally visible.
pure func test_exported_functions_omit_private_declarations() -> Bool:
	main: String =
		|import:
		|    ./helper: answer
		|func main() -> Int:
		|    answer()
		|
	match parse_modules([{ source = main, targets = [1] }, { source = HELPER, targets = [] }]):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			match build_namespace(program):
				Err(_): False
				Ok(namespace):
					match (existing_name(parsed.names, "hidden"), module_id(1)):
						(Some(hidden), Some(helper)):
							exported = exported_functions(namespace, helper)
							var hidden_exported = False
							for function in exported:
								match local_function(namespace, helper, hidden):
									Some(declared): hidden_exported = hidden_exported or IntOps.equals(function_number(function), function_number(declared))
									None: void
							IntOps.equals(exported.length(), 2) and not hidden_exported and local_function(namespace, helper, hidden).is_some()
						_: False


tests: TestSuite = {
	description = "Module alias rows and visibility at selection",
	tests = [
		("alias row names its importing module and target", test_alias_row_names_the_importing_module_and_its_target),
		("qualified lookups distinguish exported, private and missing", test_qualified_lookups_distinguish_exported_private_and_missing),
		("selecting a private function is rejected", test_selecting_a_private_function_is_rejected_at_the_selection),
		("selecting a private type is rejected", test_selecting_a_private_type_is_rejected_at_the_selection),
		("alias reusing a selected name is rejected", test_alias_reusing_a_selected_name_is_rejected),
		("alias reusing a local declaration is rejected", test_alias_reusing_a_local_declaration_is_rejected),
		("repeated alias across two modules is rejected", test_repeated_alias_across_two_modules_is_rejected),
		("exported functions omit private declarations", test_exported_functions_omit_private_declarations),
	]
}
