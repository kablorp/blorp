import:
	../../../src/namespace/builtins as Builtins
	../../../src/utils/syntax: Purity(Pure)
	test: TestSuite


pure func test_comparison_contract_carries_actual_bool_constructors() -> Bool:
	operation: Builtins.RuntimeOperation[Int, Int] = Builtins.IntLessThan({ true_variant = 17, false_variant = 29 })
	contract = Builtins.runtime_contract(operation)
	match (contract.purity, contract.parameters, contract.return_type):
		(Pure, [Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt), Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt)], Builtins.BooleanResult(boolean)):
			boolean.true_variant == 17 and boolean.false_variant == 29
		_: False


tests: TestSuite = {
	description = "Signed Int comparison runtime contract",
	tests = [("pure two-Int comparison carries designated Bool IDs", test_comparison_contract_carries_actual_bool_constructors)]
}
