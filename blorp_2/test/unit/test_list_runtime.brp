import:
	../../src/list_runtime: list_runtime
	compilation: compile
	test: TestSuite


pure func test_argument_main_selects_the_shared_list_runtime_fragment() -> Bool:
	match compile("func main(arguments: List[String]) -> Int:\n    0\n"):
		Ok(output): output.contains(list_runtime())
		Err(_): False


pure func test_nullary_main_omits_list_runtime() -> Bool:
	match compile("func main() -> Int:\n    0\n"):
		Ok(output): not output.contains(list_runtime())
		Err(_): False


tests: TestSuite = {
	description = "Blorp 2 concrete String-list runtime selection",
	tests = [
		("argument main selects shared runtime", test_argument_main_selects_the_shared_list_runtime_fragment),
		("nullary main omits list runtime", test_nullary_main_omits_list_runtime),
	]
}
