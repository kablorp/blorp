import:
	../../src/check/check: check
	../../src/lower/lower: LoweredProgram, lower
	../../src/own/own: OwnershipProgram, own
	../../src/specialize/specialize: SpecializedProgram, specialize
	../../src/utils/syntax: Diagnostic
	./input: setup_diagnostic
	./module_input: test_base, parse_modules_with_base


STRING_ALIAS: String =
	|pure func choose(flag: Bool) -> String:
	|    var held = text(1)
	|    old = held
	|    result: String = if flag:
	|        held = text(7)
	|        old
	|    else:
	|        held
	|    result
	|pure func text(value: Int) -> String:
	|    builtin("int.to_string")
	|func main() -> Int:
	|    unused = choose(True)
	|    0
	|


LIST_ALIAS: String =
	|pure func choose(flag: Bool) -> List[String]:
	|    var held: List[String] = ["old"]
	|    old = held
	|    result: List[String] = if flag:
	|        held = ["new"]
	|        old
	|    else:
	|        held
	|    result
	|func main() -> Int:
	|    unused = choose(True)
	|    0
	|


pure func concrete(source: String) -> Result[SpecializedProgram, Diagnostic]:
	parsed ?= parse_modules_with_base([{ source = source, targets = [] }], test_base())
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialize(checked)


pure func lowered(source: String) -> Result[LoweredProgram, Diagnostic]:
	concrete(source).and_then(lower)


pure func owned(source: String) -> Result[OwnershipProgram, Diagnostic]:
	lowered(source).and_then(own)
