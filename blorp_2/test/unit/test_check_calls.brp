import:
	../../src/check: check_errors
	../../src/check_errors:
		ExpectedTypeSite(SourceAnnotation),
		CallError(ArgumentCountMismatch, ArgumentTypeMismatch, ImpureCall),
		CheckErrorKind(CallRejection),
	../../src/check_model: TypeRef(IntType, StringType), same_type
	../../src/text: concat
	input: check, checked_source, rejects_at, singleton_check_error
	module_input: PRIMITIVE_BASE, INTEGER_OPERATIONS, parse_modules_with_base
	test: TestSuite


pure func test_pure_caller_rejects_default_impure_callee() -> Bool:
	source: String =
		|pure func main() -> Int:
		|	one()
		|func one() -> Int:
		|	1
		|
	rejects_at(source, 26, 29, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_transitive_pure_chain_rejects_its_impure_edge() -> Bool:
	source: String =
		|pure func main() -> Int:
		|	answer()
		|pure func answer() -> Int:
		|	one()
		|func one() -> Int:
		|	1
		|
	rejects_at(source, 63, 66, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_unreachable_pure_caller_rejects_impure_callee() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|pure func helper() -> Int:
		|	one()
		|func one() -> Int:
		|	1
		|
	rejects_at(source, 51, 54, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_call_requires_its_parameter_argument() -> Bool:
	source: String =
		|func identity(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	identity()
		|
	rejects_at(source, 62, 70, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ArgumentCountMismatch(_)):
				True
			_:
				False
	)


pure func test_zero_parameter_call_rejects_argument() -> Bool:
	source: String =
		|func one() -> Int:
		|	1
		|func main() -> Int:
		|	one(1)
		|
	rejects_at(source, 43, 46, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ArgumentCountMismatch(_)):
				True
			_:
				False
	)


pure func test_pure_argument_call_uses_containing_function() -> Bool:
	source: String =
		|func one() -> Int:
		|	1
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func main() -> Int:
		|	identity(one())
		|
	rejects_at(source, 103, 106, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_impure_caller_can_pass_impure_call_to_pure_function() -> Bool:
	source: String =
		|func one() -> Int:
		|	1
		|pure func identity(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	identity(one())
		|

	match checked_source(source):
		Ok(_):
			True
		Err(_):
			False


pure func test_pure_caller_rejects_impure_unary_wrapper() -> Bool:
	source: String =
		|func identity(value: Int) -> Int:
		|	value
		|pure func main() -> Int:
		|	identity(1)
		|
	rejects_at(source, 67, 75, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_pure_caller_checks_outer_wrapper_after_pure_inner() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|func impure(value: Int) -> Int:
		|	value
		|pure func main() -> Int:
		|	impure(identity(1))
		|
	rejects_at(source, 111, 117, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_outer_wrapper_arity_is_checked_after_valid_inner() -> Bool:
	source: String =
		|func one() -> Int:
		|	1
		|pure func identity(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	one(identity(1))
		|
	rejects_at(source, 89, 92, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ArgumentCountMismatch(_)):
				True
			_:
				False
	)


pure func test_typed_second_argument_mismatch() -> Bool:
	prefix = "import:\n\tint: to_string\npure func first(left: Int, right: Int) -> Int:\n\tleft\nfunc main() -> Int:\n\tfirst(7, "
	argument = "8.to_string()"

	match (
		parse_modules_with_base([
			{ source = prefix
				.concat(argument)
				.concat(")\n"), targets = [1] },
			{ source = INTEGER_OPERATIONS, targets = [] },
		], PRIMITIVE_BASE)
	):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					match singleton_check_error(check_errors(failure)):
						None:
							False
						Some(error):
							match error.kind:
								CallRejection(ArgumentTypeMismatch(mismatch)):
									match mismatch.expected_site:
										SourceAnnotation(annotation):
											(
												same_type(mismatch.expected, IntType)
												and same_type(
													mismatch.actual.value_type,
													StringType,
												)
												and error.span.start == prefix.length()
												and error.span.end == prefix.length() + argument.length()
												and mismatch.argument_position == 1
												and mismatch.actual.span.start == prefix.length()
												and mismatch.actual.span.end == prefix.length() + argument.length()
												and annotation.start == "import:\n\tint: to_string\npure func first(left: Int, right: ".length()
												and annotation.end == annotation.start + 3
											)
										_:
											False
								_:
									False


tests: TestSuite = {
	description = "Blorp 2 call contracts",
	tests = [
		("typed second argument mismatch", test_typed_second_argument_mismatch),
		(
			"outer wrapper arity is checked after valid inner",
			test_outer_wrapper_arity_is_checked_after_valid_inner,
		),
		(
			"pure caller checks the outer wrapper after pure inner",
			test_pure_caller_checks_outer_wrapper_after_pure_inner,
		),
		(
			"impure caller may pass impure call to pure function",
			test_impure_caller_can_pass_impure_call_to_pure_function,
		),
		("pure caller rejects impure unary wrapper", test_pure_caller_rejects_impure_unary_wrapper),
		("one-parameter call requires an argument", test_call_requires_its_parameter_argument),
		("zero-parameter call rejects an argument", test_zero_parameter_call_rejects_argument),
		(
			"argument purity uses the containing function",
			test_pure_argument_call_uses_containing_function,
		),
		(
			"pure caller rejects default impure callee",
			test_pure_caller_rejects_default_impure_callee,
		),
		(
			"transitive pure chain rejects its impure edge",
			test_transitive_pure_chain_rejects_its_impure_edge,
		),
		(
			"unreachable pure caller rejects impure callee",
			test_unreachable_pure_caller_rejects_impure_callee,
		),
	]
}
