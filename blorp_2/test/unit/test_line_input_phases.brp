import:
	compilation: compile
	test: TestSuite


pure func test_list_get_returns_owned_ordinary_optional_string() -> Bool:
	source: String =
		|fixed union Line[T]:
		|    End
		|    Read(T)
		|pure func read(values: List[String], index: Int) -> Line[String]:
		|    builtin("list.get", Read, End)
		|func main(values: List[String]) -> Int:
		|    line = read(values, 0)
		|    0
		|

	match compile(source):
		Ok(output):
			output.contains("blorp_string_list_get")
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp 2 ordinary union input results",
	tests = [
		("owned optional String input", test_list_get_returns_owned_ordinary_optional_string),
	]
}
