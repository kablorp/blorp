import:
	compilation: compile
	test: TestSuite


pure func test_line_input_returns_owned_ordinary_optional_string() -> Bool:
	source: String =
		|fixed union Line[T]:
		|    End
		|    Read(T)
		|func read() -> Line[String]:
		|    builtin("io.read_line", Read, End)
		|func main() -> Int:
		|    line = read()
		|    0
		|

	match compile(source):
		Ok(output):
			output.contains("blorp_io_read_line")
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp 2 ordinary union input results",
	tests = [
		("owned optional String input", test_line_input_returns_owned_ordinary_optional_string),
	]
}
