import:
	../../src/lex: lex
	../../src/syntax:
		Span,
		Symbol(
			PureKeyword, FunctionKeyword, MatchKeyword, Wildcard, LeftParen, RightParen, Dot, Arrow,
			Colon, Newline, VarKeyword, Equals,
		),
		TokenKind(IdentifierToken, SymbolToken, IntegerLiteral, Indentation),
	test: TestSuite


private HEADER: String = "func main() -> Int:\n"

private HEADER_TOKENS: String = "func@0:4\nname=main@5:9\n(@9:10\n)@10:11\n->@12:14\nname=Int@15:18\n:@18:19\nLF@19:20\n"


pure func span_text(span: Span) -> String:
	"".append_int(span.start) + ":" + "".append_int(span.end)


pure func trace(source: String) -> String:
	match lex(source):
		Err(diagnostic):
			"error@" + span_text(
				diagnostic.span,
			) + "\n" + diagnostic.message + "\n" + diagnostic.help
		Ok(program):
			var text: String = ""

			for token in program.tokens:
				kind: String = match token.kind:
					IdentifierToken(name):
						"name=" + name
					IntegerLiteral(value):
						"integer=" + value
					Indentation(depth):
						"indent=" + "".append_int(depth)
					SymbolToken(symbol):
						match symbol:
							PureKeyword:
								"pure"
							FunctionKeyword:
								"func"
							VarKeyword:
								"var"
							Equals:
								"="
							MatchKeyword:
								"match"
							Wildcard:
								"_"
							LeftParen:
								"("
							RightParen:
								")"
							Dot:
								"."
							Arrow:
								"->"
							Colon:
								":"
							Newline:
								"LF"

				text += kind + "@" + span_text(token.span) + "\n"

			text + "EOF@" + span_text(program.end)


pure func test_tab_indented_program() -> Bool:
	trace(
		HEADER + "\t0\n",
	) == HEADER_TOKENS + "indent=1@20:21\ninteger=0@21:22\nLF@22:23\nEOF@23:23"


pure func test_space_indented_program_without_final_lf() -> Bool:
	trace(HEADER + "    0") == HEADER_TOKENS + "indent=1@20:24\ninteger=0@24:25\nEOF@25:25"


pure func test_newline_at_line_start() -> Bool:
	trace("\n") == "LF@0:1\nEOF@1:1"


pure func test_indent_ends_at_eof() -> Bool:
	trace("    ") == "indent=1@0:4\nEOF@4:4"


pure func test_empty_input() -> Bool:
	trace("") == "EOF@0:0"


pure func test_raw_decimal_run_preserves_spelling() -> Bool:
	trace(
		HEADER + "\t00\n",
	) == HEADER_TOKENS + "indent=1@20:21\ninteger=00@21:23\nLF@23:24\nEOF@24:24"


pure func test_mixed_indentation_diagnostic() -> Bool:
	trace(
		HEADER + "\t 0\n",
	) == "error@20:22\ninvalid indentation\nuse tabs only, or spaces in groups of four; do not mix tabs and spaces"


pure func test_cr_line_ending_diagnostic() -> Bool:
	trace(
		"\r",
	) == "error@0:1\nonly LF line endings are supported\nreplace CRLF or CR line endings with LF"


pure func test_pure_keyword_and_maximal_identifier() -> Bool:
	trace("pure purex") == "pure@0:4\nname=purex@5:10\nEOF@10:10"


pure func test_multiple_argument_diagnostic() -> Bool:
	trace(
		HEADER + "\tone(0, 1)",
	) == "error@26:27\nonly zero or one parameter or argument is supported\nuse at most one typed parameter and one call argument"


pure func test_dot_separates_receiver_and_function_name() -> Bool:
	trace("1.identity()") == "integer=1@0:1\n.@1:2\nname=identity@2:10\n(@10:11\n)@11:12\nEOF@12:12"


pure func test_signed_runs_and_arrow_have_independent_tokens() -> Bool:
	trace(
		"-> -42 -0 42.identity()",
	) == "->@0:2\ninteger=-42@3:6\ninteger=-0@7:9\ninteger=42@10:12\n.@12:13\nname=identity@13:21\n(@21:22\n)@22:23\nEOF@23:23"


pure func test_minus_requires_adjacent_digits() -> Bool:
	expected = "error@0:1\nexpected decimal digits immediately after '-'\nwrite a signed integer such as -42; '-' is not an operator"
	trace("-") == expected and trace("- 1") == expected and trace("-value") == expected


pure func test_match_wildcard_depth_and_prefix_identifiers() -> Bool:
	trace(
		"match _ _name matchx\n\t\tNumber(x): x",
	) == "match@0:5\n_@6:7\nname=_name@8:13\nname=matchx@14:20\nLF@20:21\nindent=2@21:23\nname=Number@23:29\n(@29:30\nname=x@30:31\n)@31:32\n:@32:33\nname=x@34:35\nEOF@35:35"


pure func test_space_depth_two_and_invalid_prefixes() -> Bool:
	(
		trace("        ") == "indent=2@0:8\nEOF@8:8"
		and trace(
			" ",
		) == "error@0:1\ninvalid indentation\nuse tabs only, or spaces in groups of four; do not mix tabs and spaces"
		and trace(
			"    \t",
		) == "error@0:5\ninvalid indentation\nuse tabs only, or spaces in groups of four; do not mix tabs and spaces"
	)


pure func test_binding_symbols_and_var_word_boundary() -> Bool:
	trace(
		"var value=42\nvariable",
	) == "var@0:3\nname=value@4:9\n=@9:10\ninteger=42@10:12\nLF@12:13\nname=variable@13:21\nEOF@21:21"


tests: TestSuite = {
	description = "Blorp 2 lexer",
	tests = [
		("binding symbols and var word boundary", test_binding_symbols_and_var_word_boundary),
		(
			"match wildcard depth and prefix identifiers",
			test_match_wildcard_depth_and_prefix_identifiers,
		),
		("space depth two and invalid prefixes", test_space_depth_two_and_invalid_prefixes),
		("dot separates receiver and function name", test_dot_separates_receiver_and_function_name),
		("multiple argument diagnostic", test_multiple_argument_diagnostic),
		("pure keyword and maximal identifier", test_pure_keyword_and_maximal_identifier),
		("tab-indented program", test_tab_indented_program),
		("space-indented program without final LF", test_space_indented_program_without_final_lf),
		("newline at line start", test_newline_at_line_start),
		("indent ends at EOF", test_indent_ends_at_eof),
		("empty input", test_empty_input),
		("raw decimal run preserves spelling", test_raw_decimal_run_preserves_spelling),
		(
			"signed runs and arrow have independent tokens",
			test_signed_runs_and_arrow_have_independent_tokens,
		),
		("minus requires adjacent digits", test_minus_requires_adjacent_digits),
		("mixed indentation diagnostic", test_mixed_indentation_diagnostic),
		("CR line ending diagnostic", test_cr_line_ending_diagnostic),
	]
}
