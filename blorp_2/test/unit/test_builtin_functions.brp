pure func test_verifier_checks_second_runtime_argument_type() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = owned_add(
				ids,
				[Own.UnmanagedArgument(ids.first), Own.UnmanagedArgument(ids.second)],
			)

			match original.functions:
				[function]:
					wrong = { function |
						signature = {
							parameters = [Concrete.StringType],
							return_type = Concrete.IntType
						},
						operations = [
							Own.DefineValue({
								id = ids.first,
								value_type = Concrete.IntType,
								operation = Own.IntegerDefinition(20),
								result = Own.UnmanagedResult,
								span = span(10),
							}),
							Own.DefineValue({
								id = ids.second,
								value_type = Concrete.StringType,
								operation = Own.ParameterDefinition(0),
								result = Own.BorrowedResult(Own.ParameterBorrow(ids.second)),
								span = span(20),
							}),
							Own.DefineValue({
								id = ids.third,
								value_type = Concrete.IntType,
								operation = Own.CallDefinition(
									{
										target = Concrete.RuntimeFunction(Prelude.IntAdd),
										span = span(30)
									},
									[Own.UnmanagedArgument(ids.first), Own.BorrowedArgument({
											value = ids.second,
											source = Own.ParameterBorrow(ids.second),
										})],
								),
								result = Own.UnmanagedResult,
								span = span(30),
							}),
						]
					}

					match (
						verify(
							{ original | functions = [function, wrong] },
						)
					):
						Ok(_):
							False
						Err(error):
							(
								error.span.start == 30
								and error.span.end == 31
								and error.message == "ownership verification failed: call argument type does not match its contract"
								and error.help == "report this compiler error with the input program"
							)
				_:
					False


private UNARY_ROOT: String =
	|import:
	|    ./string: count
	|func main() -> Int:
	|    count(42.to_string())
	|

private UNARY_HELPER: String =
	|pure func count(value: String) -> Int:
	|    builtin("string.length")
	|


private pure func borrows_parameter(function: Own.OwnedFunction) -> Bool:
	match function.operations:
		[Own.DefineValue(parameter), Own.DefineValue(result)]:
			match (parameter.operation, parameter.result, result.operation):
				(Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(source)), Own.CallDefinition(call, [Own.BorrowedArgument(argument)])):
					match (call.target, argument.source, result.result):
						(Concrete.RuntimeFunction(Prelude.StringLength), Own.ParameterBorrow(argument_source), Own.UnmanagedResult):
							(
								value_number(source) == value_number(parameter.id)
								and value_number(argument.value) == value_number(parameter.id)
								and value_number(argument_source) == value_number(parameter.id)
								and Concrete.same_type(parameter.value_type, Concrete.StringType)
								and Concrete.same_type(result.value_type, Concrete.IntType)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_unary_module_builtin_preserves_managed_parameter_borrow() -> Bool:
	match (
		owned_sources([
			{
				source = UNARY_ROOT,
				targets = [1]
			},
			{
				source = UNARY_HELPER,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(program):
			match program.functions:
				[caller, helper]:
					var dropped = False

					for operation in caller.operations:
						match operation:
							Own.DropOwner(owner, _):
								dropped = dropped or Own.owner_number(owner) == 0
							_:
								void

					borrows_parameter(helper) and dropped and verify(program).is_ok()
				_:
					False


pure func test_unary_module_builtin_emits_caller_cleanup() -> Bool:
	match (
		emitted_sources([
			{
				source = UNARY_ROOT,
				targets = [1]
			},
			{
				source = UNARY_HELPER,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(code):
			(
				code.contains("blorp_string_length(blorp_vl_0)")
				and code.contains("blorp_string_release(blorp_owner_0);")
				and not code.contains("blorp_int_add")
			)


pure func test_module_builtin_transfers_its_fresh_string_result() -> Bool:
	root: String =
		|import:
		|    ./int: format
		|func main() -> Int:
		|    format(42).length()
		|
	helper: String =
		|pure func format(value: Int) -> String:
		|    builtin("int.to_string")
		|
	sources: List[ModuleInput] = [
		{
			source = root,
			targets = [1]
		},
		{
			source = helper,
			targets = []
		},
	]

	match parse_modules(sources).and_then(pure func(parsed): Checked
			.check(parsed)
			.map_err(setup_diagnostic)):
		Err(_):
			False
		Ok(checked):
			var checked_result = False

			match Checked.checked_functions(checked).functions.get(1):
				Some(function):
					match function.body:
						Checked.CheckedValueBody(Checked.ReturnExpression(value)):
							match value.base:
								Checked.ReturnCall(call, [argument]):
									match (call.target, argument.base):
										(Checked.RuntimeFunction(Prelude.IntToString), Checked.ReturnBinding(parameter)):
											checked_result = (
												Checked.same_type(
													value.base_type,
													Checked.StringType,
												)
												and Checked.same_type(
													argument.base_type,
													Checked.IntType,
												)
												and Checked.binding_number(parameter) == 0
											)
										_:
											void
								_:
									void
						_:
							void
				None:
					void

			match owned_sources(sources):
				Err(_):
					False
				Ok(program):
					match program.functions:
						[caller, helper]:
							match (caller.operations, helper.operations, helper.tail):
								([Own.DefineValue(_), Own.DefineValue(formatted), Own.DefineValue(_), Own.DropOwner(dropped, _)], [Own.DefineValue(parameter), Own.DefineValue(result)], Own.ReturnTail(Own.ReturnResult(Own.OwnedReturn(value, transferred)))):
									match (
										parameter.operation,
										result.operation,
										result.result,
										formatted.result,
									):
										(Own.ParameterDefinition(0), Own.CallDefinition(call, [Own.UnmanagedArgument(argument)]), Own.OwnedResult(created), Own.OwnedResult(caller_owner)):
											match call.target:
												Concrete.RuntimeFunction(Prelude.IntToString):
													(
														checked_result
														and Concrete.same_type(
															result.value_type,
															Concrete.StringType,
														)
														and value_number(
															argument,
														) == value_number(parameter.id)
														and value_number(
															value,
														) == value_number(result.id)
														and Own.owner_number(
															created,
														) == Own.owner_number(transferred)
														and Own.owner_number(
															caller_owner,
														) == Own.owner_number(dropped)
														and verify(program).is_ok()
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False


pure func test_imported_builtin_call_keeps_ordinary_declaration_identity() -> Bool:
	match checked_add(ADD):
		Err(_):
			False
		Ok(program):
			match Checked.checked_functions(program).functions.get(0):
				None:
					False
				Some(caller):
					match Checked.function_calls(caller):
						[call]:
							match call.target:
								Checked.UserFunction(id, []):
									function_number(id) == 1
								_:
									False
						_:
							False


pure func test_builtin_signature_error_precedes_unrelated_caller_body() -> Bool:
	root: String =
		|import:
		|    ./int: add
		|func main() -> Int:
		|    missing()
		|
	helper: String =
		|pure func add(first: Int, second: String) -> Int:
		|    builtin("int.add")
		|

	match (
		parse_modules([
			{
				source = root,
				targets = [1]
			},
			{
				source = helper,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(parsed):
			match Checked.check(parsed):
				Ok(_):
					False
				Err(failure):
					match Checked.check_errors(failure).first.kind:
						Checked.BuiltinContractMismatch(Prelude.IntAdd):
							True
						_:
							False


pure func test_addition_helper_is_absent_without_runtime_calls() -> Bool:
	source: String =
		|func main() -> Int:
		|    42
		|

	match (
		emitted_sources(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Err(_):
			False
		Ok(code):
			code == "#include <stdint.h>\nint64_t blorp_f_0(void);int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(42);(void)blorp_vl_0;return blorp_vl_0;}int main(void){return (int)blorp_f_0();}\n"


pure func test_emitter_finds_runtime_addition_inside_a_match_arm() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = owned_add(
				ids,
				[Own.UnmanagedArgument(ids.first), Own.UnmanagedArgument(ids.second)],
			)

			match original.functions:
				[function]:
					matched = { function |
						operations = [Own.DefineValue({
								id = ids.first,
								value_type = Concrete.UnionType(ids.union_id),
								operation = Own.VariantDefinition(ids.second_variant),
								result = Own.UnmanagedResult,
								span = span(1),
							})],
						tail = Own.MatchTail({
							scrutinee = ids.first,
							owner = ids.union_id,
							arms = [
								{
									label = DefaultLabel,
									operations = [
										Own.DefineValue({
											id = ids.second,
											value_type = Concrete.IntType,
											operation = Own.IntegerDefinition(20),
											result = Own.UnmanagedResult,
											span = span(10),
										}),
										Own.DefineValue({
											id = ids.third,
											value_type = Concrete.IntType,
											operation = Own.IntegerDefinition(22),
											result = Own.UnmanagedResult,
											span = span(20),
										}),
										Own.DefineValue({
											id = ids.fourth,
											value_type = Concrete.IntType,
											operation = Own.CallDefinition(
												{
													target = Concrete.RuntimeFunction(Prelude.IntAdd),
													span = span(30)
												},
												[
													Own.UnmanagedArgument(ids.second),
													Own.UnmanagedArgument(ids.third),
												],
											),
											result = Own.UnmanagedResult,
											span = span(30),
										}),
									],
									exit = Own.ReturnResult(Own.UnmanagedReturn(ids.fourth))
								},
							],
						})
					}

					match verify({ original |
							unions = ids.unions,
							functions = [matched]
						}).and_then(pure func(program): emit(program)):
						Err(_):
							False
						Ok(code):
							(
								code.contains("static int64_t blorp_int_add(")
								and code.contains("blorp_int_add(blorp_vl_1,blorp_vl_2)")
							)
				_:
					False


pure func test_unused_builtin_declaration_keeps_its_required_helper() -> Bool:
	source = ADD + "func main() -> Int:\n    42\n"

	match (
		emitted_sources(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Err(_):
			False
		Ok(code):
			(
				code.contains("static int64_t blorp_int_add(")
				and code.contains("blorp_int_add(blorp_vl_0,blorp_vl_1)")
			)


