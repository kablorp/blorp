pure func test_builtin_rejects_prefix_bindings() -> Bool:
	helper: String =
		|pure func add(first: Int, second: Int) -> Int:
		|    local = first
		|    builtin("int.add")
		|
	start = "pure func add(first: Int, second: Int) -> Int:\n    local = first\n    ".length()

	match (
		parse_modules(
			[
				{
					source = helper,
					targets = []
				},
			],
		)
	):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == start
				and error.span.end == start + "builtin".length()
				and error.message == "builtin must be the entire function body"
				and error.help == (
					"use builtin as the entire function body; put other work in an ordinary wrapper "
					+ "function"
				)
			)


pure func test_builtin_rejects_tail_annotation() -> Bool:
	match checked_add("@tail_recursive\n" + ADD):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == 0
				and error.span.end == "@tail_recursive".length()
				and error.message == "builtin bodies cannot have a tail-recursion annotation"
				and error.help == "remove @tail_recursive from the builtin declaration"
			)


pure func test_checked_builtin_reads_its_ordered_parameter_identities() -> Bool:
	match checked_add(ADD):
		Err(_):
			False
		Ok(program):
			match Checked.checked_functions(program).functions.get(1):
				Some(function):
					match function.body:
						Checked.CheckedValueBody(Checked.ReturnExpression(value)):
							match value.base:
								Checked.ReturnCall(call, [first, second]):
									match (call.target, first.base, second.base):
										(Checked.RuntimeFunction(Prelude.IntAdd), Checked.ReturnBinding(first_id), Checked.ReturnBinding(second_id)):
											(
												Checked.binding_number(first_id) == 0
												and Checked.binding_number(second_id) == 1
												and function.bindings.length() == 2
												and function.statements.is_empty()
												and Checked.same_type(
													value.base_type,
													Checked.IntType,
												)
											)
										_:
											False
								_:
									False
						_:
							False
				None:
					False


pure func test_specialization_keeps_binary_runtime_contract() -> Bool:
	contract = Concrete.runtime_signature(Prelude.IntAdd)

	match checked_add(ADD).and_then(pure func(checked): Concrete.specialize(checked)):
		Err(_):
			False
		Ok(program):
			match Concrete.specialized_contents(program).functions.get(1):
				Some(function):
					match function.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match value.base:
								Concrete.ReturnCall(call, [_, _]):
									match (
										call.target,
										contract.parameters,
										function.signature.parameters,
									):
										(Concrete.RuntimeFunction(Prelude.IntAdd), [Concrete.IntType, Concrete.IntType], [Concrete.IntType, Concrete.IntType]):
											Concrete.same_type(
												contract.return_type,
												Concrete.IntType,
											)
										_:
											False
								_:
									False
						_:
							False
				None:
					False


private pure func owned_add(
	ids: InputIds,
	arguments: List[Own.OwnedArgument],
) -> Own.OwnershipProgram:
	{
		records = [],
		unions = [],
		entrypoint = ids.entrypoint,
		functions = [
			{
				execution = OrdinaryCalls,
				signature = {
					parameters = [],
					return_type = Concrete.IntType
				},
				operations = [
					Own.DefineValue({
						id = ids.first,
						value_type = Concrete.IntType,
						operation = Own.IntegerDefinition(20),
						result = Own.UnmanagedResult,
						span = span(10),
					}),
					Own.DefineValue({
						id = ids.second,
						value_type = Concrete.IntType,
						operation = Own.IntegerDefinition(22),
						result = Own.UnmanagedResult,
						span = span(20),
					}),
					Own.DefineValue({
						id = ids.third,
						value_type = Concrete.IntType,
						operation = Own.CallDefinition(
							{
								target = Concrete.RuntimeFunction(Prelude.IntAdd),
								span = span(30)
							},
							arguments,
						),
						result = Own.UnmanagedResult,
						span = span(30),
					}),
				],
				tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.third)))
			},
		]
	}


pure func test_verifier_accepts_two_unmanaged_runtime_arguments() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			verify(
				owned_add(
					ids,
					[Own.UnmanagedArgument(ids.first), Own.UnmanagedArgument(ids.second)],
				),
			).is_ok()


pure func test_verifier_rejects_a_missing_runtime_argument() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match verify(owned_add(ids, [Own.UnmanagedArgument(ids.first)])):
				Ok(_):
					False
				Err(error):
					(
						error.span.start == 30
						and error.span.end == 31
						and error.message == "ownership verification failed: call is missing its argument"
						and error.help == "report this compiler error with the input program"
					)


pure func test_emitter_includes_portable_addition_only_for_runtime_calls() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match (
				verify(
					owned_add(
						ids,
						[Own.UnmanagedArgument(ids.first), Own.UnmanagedArgument(ids.second)],
					),
				).and_then(pure func(program): emit(program))
			):
				Err(_):
					False
				Ok(code):
					(
						code.contains("uint64_t sum=(uint64_t)first+(uint64_t)second;")
						and code.contains(
							"sum<=INT64_MAX?(int64_t)sum:-INT64_C(1)-(int64_t)(UINT64_MAX-sum)",
						)
						and code.contains("blorp_int_add(blorp_vl_0,blorp_vl_1)")
						and not code.contains("blorp_int_to_string")
					)


