import:
	../../src/check as Checked
	../../src/check_render: render_failure
	../../src/declarations: function_number
	../../src/emit: emit
	../../src/lex: lex
	../../src/lower: MatchLabel(DefaultLabel), lower, value_number
	../../src/own as Own
	../../src/parse: parse_prelude, parsed_contents
	../../src/prelude as Prelude:
		PrimitiveType(BuiltinInt),
		RuntimeOperation(IntAdd, IntToString, StringLength),
		RuntimeResult(PrimitiveResult),
		check_prelude,
		runtime_contract,
	../../src/source: PRELUDE_SOURCE, module_id, module_source, same_source
	../../src/specialize as Concrete
	../../src/syntax:
		Diagnostic,
		FunctionExecution(OrdinaryCalls),
		ParsedBody(ParsedBuiltinBody),
		ParsedRuntimeOperation(IntegerAddBuiltin),
		Purity(Pure),
	../../src/verify: verify
	input: setup_diagnostic
	module_input: ModuleInput, parse_modules
	ownership_inputs: InputIds, input_ids, span
	test: TestSuite


private ROOT: String =
	|import:
	|    ./int: add
	|func main() -> Int:
	|    add(20, 22)
	|

private ADD: String =
	|pure func add(first: Int, second: Int) -> Int:
	|    builtin("int.add")
	|


private pure func checked_add(helper: String) -> Result[Checked.CheckedProgram, Diagnostic]:
	parsed ?= parse_modules([
		{
			source = ROOT,
			targets = [1]
		},
		{
			source = helper,
			targets = []
		},
	])
	Checked
		.check(parsed)
		.map_err(setup_diagnostic)


private pure func owned_sources(
	sources: List[ModuleInput],
) -> Result[Own.OwnershipProgram, Diagnostic]:
	parsed ?= parse_modules(sources)
	checked ?= Checked
		.check(parsed)
		.map_err(setup_diagnostic)
	concrete ?= Concrete.specialize(checked)
	lowered ?= lower(concrete)
	Own.own(lowered)


private pure func emitted_sources(sources: List[ModuleInput]) -> Result[String, Diagnostic]:
	owned ?= owned_sources(sources)
	verified ?= verify(owned)
	emit(verified)


private pure func rejects_header(header: String) -> Bool:
	helper = header + "\n    builtin(\"int.add\")\n"
	label = header.length() + "\n    builtin(".length()

	match (
		parse_modules([
			{
				source = ROOT,
				targets = [1]
			},
			{
				source = helper,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(parsed):
			match (Checked.check(parsed), module_id(1)):
				(Err(failure), Some(helper_module)):
					diagnostics = render_failure(failure)
					error = diagnostics.first
					(
						diagnostics.remaining.is_empty()
						and same_source(error.span.source, module_source(helper_module))
						and error.span.start == label
						and error.span.end == label + "\"int.add\"".length()
						and error.note.is_none()
						and error.message == "builtin declaration does not match its runtime contract"
						and error.help == "declare a pure function with two Int parameters returning Int"
					)
				_:
					False


pure func test_module_builtin_add_is_accepted() -> Bool:
	match (
		parse_modules([
			{
				source = ROOT,
				targets = [1]
			},
			{
				source = ADD,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(parsed):
			Checked
				.check(parsed)
				.is_ok()


pure func test_parser_publishes_typed_builtin_and_source_span() -> Bool:
	match (
		(
			parse_modules(
				[
					{
						source = ADD,
						targets = []
					},
				],
			),
			module_id(0),
		)
	):
		(Ok(program), Some(module)):
			match parsed_contents(program).functions:
				[function]:
					match function.body:
						ParsedBuiltinBody(IntegerAddBuiltin, occurrence):
							start = "pure func add(first: Int, second: Int) -> Int:\n    builtin(".length()
							(
								same_source(occurrence.source, module_source(module))
								and occurrence.start == start
								and occurrence.end == start + "\"int.add\"".length()
								and function.statements.is_empty()
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_binary_runtime_contract_is_complete() -> Bool:
	operation: RuntimeOperation[Void] = Prelude.IntAdd
	contract = runtime_contract(operation)
	result_matches = match contract.return_type:
		PrimitiveResult(BuiltinInt): True
		_: False
	(
		contract.purity == Pure
		and contract.parameters == [BuiltinInt, BuiltinInt]
		and result_matches
	)


pure func test_prelude_and_module_share_binary_builtin_syntax() -> Bool:
	source = "type Int = builtin\ntype String = builtin\ntype Void = builtin\ntype Float = builtin\n" + ADD

	match lex(PRELUDE_SOURCE, source).and_then(pure func(tokens): parse_prelude(tokens)):
		Err(_):
			False
		Ok(parsed):
			check_prelude(parsed).is_ok()


pure func test_unknown_builtin_label_is_rejected_before_checking() -> Bool:
	source: String =
		|pure func add(first: Int, second: Int) -> Int:
		|    builtin("int.unknown")
		|
	start = "pure func add(first: Int, second: Int) -> Int:\n    builtin(".length()

	match (
		parse_modules(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == start
				and error.span.end == start + "\"int.unknown\"".length()
				and error.message == "unknown builtin operation"
				and error.help == "use int.add, int.subtract, int.multiply, int.divide, int.remainder, int.to_string, float.add, float.subtract, float.multiply, float.divide, float.remainder, float.to_string, string.length, string.print, string.parse_int, string.parse_float, string.equals or io.read_line"
			)


pure func test_builtin_body_cannot_have_a_trailing_expression() -> Bool:
	source: String =
		|pure func add(first: Int, second: Int) -> Int:
		|    builtin("int.add").length()
		|
	start = "pure func add(first: Int, second: Int) -> Int:\n    builtin(\"int.add\")".length()

	match (
		parse_modules(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == start
				and error.span.end == start + 1
				and error.message == "expected a newline after the return expression"
				and error.help == "put each declaration on a new line"
			)


pure func test_builtin_rejects_impurity() -> Bool:
	rejects_header("func add(first: Int, second: Int) -> Int:")


pure func test_builtin_rejects_zero_parameters() -> Bool:
	rejects_header("pure func add() -> Int:")


pure func test_builtin_rejects_one_parameter() -> Bool:
	rejects_header("pure func add(first: Int) -> Int:")


pure func test_builtin_rejects_extra_parameter() -> Bool:
	rejects_header("pure func add(first: Int, second: Int, third: Int) -> Int:")


pure func test_builtin_rejects_wrong_first_type() -> Bool:
	rejects_header("pure func add(first: String, second: Int) -> Int:")


pure func test_builtin_rejects_wrong_second_type() -> Bool:
	rejects_header("pure func add(first: Int, second: String) -> Int:")


pure func test_builtin_rejects_wrong_result_type() -> Bool:
