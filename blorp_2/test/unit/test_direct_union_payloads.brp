private pure func union_cycle(prefix: String, annotation: String, suffix: String, owner: Int) -> Bool:
	exact_error(prefix, annotation, suffix,
		"recursive aggregate types are not supported yet", "use finite record and union fields until recursive data is supported",
		pure func(kind):
			match kind:
				Errors.TypeDeclarationRejection(Errors.RecursiveAggregateType(Model.UnionType(id))): Declaration.union_number(id) == owner
				_: False
	)


pure func test_unused_self_union_cycle_rejects_at_written_edge() -> Bool:
	union_cycle("fixed union Node:\n    Next(", "Node", ")\n" + MAIN, 0)


pure func test_reachable_self_union_cycle_rejects_before_body() -> Bool:
	union_cycle("fixed union Node:\n    Next(", "Node", ")\nfunc produce() -> Node:\n    produce()\nfunc main() -> Int:\n    unused = produce()\n    0\n", 0)


pure func test_unused_mutual_union_cycle_rejects_closing_edge() -> Bool:
