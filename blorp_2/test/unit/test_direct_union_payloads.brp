private pure func symbolic_list_admission(element: String) -> Bool:
	prefix: String =
		|fixed union Values[T]:
		|    Items(
	annotation = "List[T]"
	source = prefix + annotation + ")\nfunc produce() -> Values[" + element + "]:\n    produce()\nfunc pass(value: Values[" + element + "]) -> Values[" + element + "]:\n    value\nfunc main() -> Int:\n    unused = pass(produce())\n    0\n"
	match specialized(source):
		Err(error):
			(
				element == "Int"
				and error.message == "List currently supports only String elements"
				and error.help == "use List[String]; other concrete element types are not supported yet"
				and error.span.start == prefix.length()
				and error.span.end == prefix.length() + annotation.length()
				and same_source(error.span.source, module_source(root_module_id()))
			)
		Ok(_): element == "String"


pure func test_no_literal_int_list_producer_rejects_at_written_payload() -> Bool:
	symbolic_list_admission("Int")


pure func test_no_literal_string_list_producer_has_supported_layout() -> Bool:
	symbolic_list_admission("String")


private pure func primitive_layout(annotation: String, argument: String, expected: Concrete.TypeRef) -> Bool:
	direct: String =
		|fixed union Envelope:
		|    Empty
		|    Item(${annotation})
		|pure func make(value: ${annotation}) -> Envelope:
		|    Item(value)
		|func main() -> Int:
		|    unused = make(${argument})
		|    0
		|
	generic: String =
		|fixed union Envelope[T]:
		|    Empty
		|    Item(T)
		|pure func make(value: ${annotation}) -> Envelope[${annotation}]:
		|    Item(value)
		|func main() -> Int:
		|    unused = make(${argument})
		|    0
		|
	match (specialized(direct), specialized(generic)):
		(Ok(left), Ok(right)):
			match (left.unions, right.unions):
				([first], [second]):
					representation = match (expected, first.representation, second.representation):
						(Concrete.StringType, Concrete.InlineOwningPayload, Concrete.InlineOwningPayload): True
						(Concrete.IntType, Concrete.InlineUnmanaged, Concrete.InlineUnmanaged): True
						(Concrete.FloatType, Concrete.InlineUnmanaged, Concrete.InlineUnmanaged): True
						(Concrete.VoidType, Concrete.InlineUnmanaged, Concrete.InlineUnmanaged): True
						_: False
					match (first.variants, second.variants):
						([[], [a]], [[], [b]]):
							representation and Concrete.same_type(a, expected) and Concrete.same_type(b, expected)
						_: False
				_: False
		_: False


pure func test_direct_and_generic_string_layouts_agree() -> Bool:
	primitive_layout("String", "\"42\"", Concrete.StringType)


pure func test_direct_and_generic_float_layouts_agree() -> Bool:
	primitive_layout("Float", "2.5", Concrete.FloatType)


pure func test_direct_and_generic_void_layouts_keep_unary_tag() -> Bool:
	primitive_layout("Void", "void", Concrete.VoidType)


private pure func parser_error(prefix: String, marked: String, suffix: String, message: String, help: String) -> Bool:
	match lex(module_source(root_module_id()), prefix + marked + suffix).and_then(parse):
		Err(error):
			(
				error.message == message and error.help == help
				and error.span.start == prefix.length() and error.span.end == prefix.length() + marked.length()
				and same_source(error.span.source, module_source(root_module_id()))
			)
		Ok(_): False


