import:
	../../src/check_model as Model
	../../src/check_errors as Errors
	../../src/check as API
	../../src/check_render: render_failure
	../../src/declarations as Declaration
	../../src/lex: lex
	../../src/lower as Lower
	../../src/own as Own
	../../src/assemble: parsed_contents
	../../src/source: module_id, module_source, root_module_id, same_source
	../../src/specialize as Concrete
	../../src/syntax: Diagnostic, TypeSyntax(AtomicType, AppliedType), type_span
	../../src/verify: verify
	input: check_failure, parse, setup_diagnostic
	module_input: PRIMITIVE_BASE, parse_modules_with_base
	test: TestSuite


private MAIN: String =
	|func main() -> Int:
	|    0
	|

private ENVELOPE: String =
	|fixed union Envelope:
	|    Empty
	|    Item(

private BOX: String =
	|fixed record Box[T] { value: T }
	|


private pure func checked(source: String) -> Result[API.CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source)
	parsed ?= parse(tokens)
	API.check(parsed).map_err(setup_diagnostic)


private pure func specialized(source: String) -> Result[Concrete.SpecializedContents, Diagnostic]:
	program ?= checked(source)
	concrete ?= Concrete.specialize(program)
	Ok(Concrete.specialized_contents(concrete))


private pure func exact_error(
	prefix: String,
	annotation: String,
	suffix: String,
	message: String,
	help: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match lex(module_source(root_module_id()), prefix + annotation + suffix).and_then(parse):
		Ok(parsed):
			match API.check(parsed):
				Err(failure):
					errors = API.check_errors(failure)
					diagnostic = render_failure(failure).first
					(
						errors.remaining.is_empty()
						and matches(errors.first.kind)
						and same_source(errors.first.span.source, module_source(root_module_id()))
						and errors.first.span.start == prefix.length()
						and errors.first.span.end == prefix.length() + annotation.length()
						and diagnostic.message == message and diagnostic.help == help
						and diagnostic.span.start == errors.first.span.start
						and diagnostic.span.end == errors.first.span.end
						and same_source(diagnostic.span.source, errors.first.span.source)
					)
				Ok(_): False
		Err(_): False


pure func test_nested_payload_ast_retains_complete_and_inner_spans() -> Bool:
	prefix = BOX + ENVELOPE
	annotation = "Box[List[String]]"
	match lex(module_source(root_module_id()), prefix + annotation + ")\n" + MAIN).and_then(parse):
		Ok(program):
			match parsed_contents(program).unions:
				[envelope]:
					match envelope.variants:
						[_, item]:
							match item.fields:
								[AppliedType(_, [AppliedType(_, [AtomicType(text)], list_span)], whole)]:
									(
										whole.start == prefix.length()
										and whole.end == prefix.length() + annotation.length()
										and list_span.start == prefix.length() + 4
										and list_span.end == whole.end - 1
										and text.span.start == prefix.length() + 9
										and text.span.end == text.span.start + 6
										and same_source(whole.source, module_source(root_module_id()))
									)
								_: False
						_: False
				_: False
		Err(_): False


private pure func direct_payload(annotation: String, expected: Model.TypeRef) -> Bool:
	match checked(ENVELOPE + annotation + ")\n" + MAIN):
		Ok(program):
			match API.checked_functions(program).unions:
				[envelope]:
					match envelope.variants.map(pure func(variant): variant.fields):
						[[], [payload]]:
							(
								Model.same_type(payload.value_type, expected)
								and payload.span.start == ENVELOPE.length()
								and payload.span.end == ENVELOPE.length() + annotation.length()
								and same_source(payload.span.source, module_source(root_module_id()))
							)
						_: False
				_: False
		Err(_): False


pure func test_direct_string_publishes_complete_type_use() -> Bool:
	direct_payload("String", Model.StringType)


pure func test_direct_float_publishes_complete_type_use() -> Bool:
	direct_payload("Float", Model.FloatType)


pure func test_direct_void_is_a_payload_separate_from_nullary() -> Bool:
	direct_payload("Void", Model.VoidType)


pure func test_direct_list_string_publishes_complete_element_type() -> Bool:
	direct_payload("List[String]", Model.ListType(Model.StringType))


pure func test_nested_rigid_payload_keeps_union_owned_parameter() -> Bool:
	source: String =
		|fixed record Box[T] { value: T }
		|fixed union Option[T]:
		|    Some(T)
		|    None
		|fixed union Nested[T, Other]:
		|    Item(Box[Option[T]])
		|    Alternative(Other)
		|func main() -> Int:
		|    0
		|
	match checked(source):
		Ok(program):
			match (API.checked_functions(program).records, API.checked_functions(program).unions):
				([box], [option, nested]):
					match (box.type_parameters, option.type_parameters, nested.type_parameters, nested.variants.map(pure func(variant): variant.fields)):
						([record_parameter], [option_parameter], [parameter, other], [[item], [alternative]]):
							match item.value_type:
								Model.AppliedRecordType(record_owner, [Model.AppliedUnionType(option_owner, [Model.ParameterType(actual)])]):
									(
										Declaration.record_number(record_owner) == 0
										and Declaration.union_number(option_owner) == 0
										and Model.same_type(Model.ParameterType(actual), Model.ParameterType(parameter))
										and Model.same_type(alternative.value_type, Model.ParameterType(other))
										and not Model.same_type(Model.ParameterType(actual), Model.ParameterType(record_parameter))
										and not Model.same_type(Model.ParameterType(actual), Model.ParameterType(option_parameter))
									)
								_: False
						_: False
				_: False
		Err(_): False


pure func test_imported_same_spelling_payload_uses_its_declaration_module() -> Bool:
	root: String =
		|import:
		|    first: First
		|    second: Second
		|func main() -> Int:
		|    0
		|
	first: String =
		|fixed record Value { text: String }
		|fixed union First:
		|    Item(Value)
		|
	second: String =
		|fixed record Value { number: Int }
		|fixed union Second:
		|    Item(Value)
		|
	match parse_modules_with_base([
		{ source = root, targets = [1, 2] },
		{ source = first, targets = [] },
		{ source = second, targets = [] },
	], PRIMITIVE_BASE).and_then(pure func(parsed): API.check(parsed).map_err(setup_diagnostic)):
		Ok(program):
			match API.checked_functions(program).unions:
				[first, second]:
					match (first.variants.map(pure func(variant): variant.fields), second.variants.map(pure func(variant): variant.fields), module_id(1), module_id(2)):
						([[left]], [[right]], Some(first_module), Some(second_module)):
							match (left.value_type, right.value_type):
								(Model.RecordType(left_owner), Model.RecordType(right_owner)):
									(
										Declaration.record_number(left_owner) == 0
										and Declaration.record_number(right_owner) == 1
										and same_source(left.span.source, module_source(first_module))
										and same_source(right.span.source, module_source(second_module))
										and not Model.same_type(left.value_type, right.value_type)
									)
								_: False
						_: False
				_: False
		Err(_): False


