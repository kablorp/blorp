		("empty payload parentheses teach nullary and unary forms", test_empty_payload_parentheses_teach_nullary_and_unary_forms),
		("multiple fields accept top level comma", test_multiple_payloads_accept_top_level_comma),
		("one payload accepts multiple nested type arguments", test_one_payload_accepts_multiple_nested_type_arguments),
		("missing union arguments keep nominal owner", test_missing_union_arguments_keep_nominal_owner),
		("wrong union arity precedes unknown argument", test_wrong_union_arity_precedes_unknown_argument),
		("ordinary union application keeps whole span", test_ordinary_union_application_keeps_whole_span),
		("nested rigid substitution publishes int and string children", test_nested_rigid_substitution_publishes_int_and_string_children),
		("direct and generic inline record representations agree", test_direct_and_generic_inline_record_representations_agree),
		("direct and generic managed record representations agree", test_direct_and_generic_managed_record_representations_agree),
		("direct string lowering and borrow acquisition preserve child", test_direct_string_lowering_and_borrow_acquisition_preserve_child),
		("direct managed record lowering and acquisition preserve child", test_direct_managed_record_lowering_and_acquisition_preserve_child),
		("nested payload AST spans", test_nested_payload_ast_retains_complete_and_inner_spans),
		("direct String TypeUse", test_direct_string_publishes_complete_type_use),
		("direct Float TypeUse", test_direct_float_publishes_complete_type_use),
		("direct Void Some versus None", test_direct_void_is_a_payload_separate_from_nullary),
		("direct List[String] TypeUse", test_direct_list_string_publishes_complete_element_type),
		("nested rigid declaration owners", test_nested_rigid_payload_keeps_union_owned_parameter),
		("imported same-spelling module owners", test_imported_same_spelling_payload_uses_its_declaration_module),
		("unknown payload exact diagnostic", test_unknown_payload_uses_ordinary_annotation_diagnostic),
		("function spelling is not a type", test_function_spelling_is_not_a_payload_type),
		("missing record arguments", test_missing_record_arguments_keep_owner_and_name_span),
		("record arity before argument error", test_wrong_record_arity_precedes_unknown_argument),
		("ordinary record application", test_ordinary_record_application_keeps_full_span),
		("nonapplicable payload head span", test_nonapplicable_payload_keeps_head_span),
		("direct List[Int] element diagnostic", test_direct_list_int_rejects_at_element_span),
		("unused self union cycle", test_unused_self_union_cycle_rejects_at_written_edge),
		("reachable self union cycle", test_reachable_self_union_cycle_rejects_before_body),
		("unused mutual union cycle", test_unused_mutual_union_cycle_rejects_closing_edge),
		("reachable mutual union cycle", test_reachable_mutual_union_cycle_rejects_before_specialization),
		("nested cycle full payload span", test_nested_applied_self_cycle_uses_whole_payload_span),
		("union-record cycle root order", test_union_record_cycle_keeps_record_root_priority),
		("record cycle diagnostic priority", test_old_record_cycle_wins_over_earlier_union_cycle),
		("finite forward nominal references", test_finite_forward_union_record_references_are_accepted),
		("no-literal List[Int] written admission", test_no_literal_int_list_producer_rejects_at_written_payload),
		("no-literal List[String] control", test_no_literal_string_list_producer_has_supported_layout),
		("direct/generic String slots", test_direct_and_generic_string_layouts_agree),
		("direct/generic Float slots", test_direct_and_generic_float_layouts_agree),
		("direct/generic Void slots", test_direct_and_generic_void_layouts_keep_unary_tag),
	]
}
