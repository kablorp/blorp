pure func test_nested_rigid_substitution_publishes_int_and_string_children() -> Bool:
	source: String =
		|fixed record Box[T] { value: T }
		|fixed union Option[T]:
		|    Some(T)
		|    None
		|fixed union Nested[T, Other]:
		|    Item(Box[Option[T]])
		|    Alternative(Other)
		|pure func make[T](value: T) -> Nested[T, Int]:
		|    Item({ value = Some(value) })
		|func main() -> Int:
		|    first = make(7)
		|    second = make("42")
		|    0
		|
	match specialized(source):
		Ok(program):
			var integer = 0
			var string = 0
			for row in program.records:
				match row.fields:
					[Concrete.UnionType(owner)]:
						match program.unions.get(Concrete.union_number(owner)):
							Some(option):
								match option.variants:
									[[Concrete.IntType], []]: integer = integer + 1
									[[Concrete.StringType], []]: string = string + 1
									_: void
							_: void
					_: void
			integer == 1 and string == 1 and program.records.length() == 2 and program.unions.length() == 4
		Err(_): False


private pure func record_layout_pair(field: String, value: String, managed: Bool) -> Bool:
	direct: String =
		|fixed record Row { value: ${field} }
		|fixed union Envelope:
		|    Item(Row)
		|pure func make(value: Row) -> Envelope:
		|    Item(value)
		|func main() -> Int:
		|    unused = make({ value = ${value} })
		|    0
		|
	generic: String =
		|fixed record Row { value: ${field} }
		|fixed union Envelope[T]:
		|    Item(T)
		|pure func make(value: Row) -> Envelope[Row]:
		|    Item(value)
		|func main() -> Int:
		|    unused = make({ value = ${value} })
		|    0
		|
	match (specialized(direct), specialized(generic)):
		(Ok(left), Ok(right)):
			match (left.records, right.records, left.unions, right.unions):
				([a], [b], [first], [second]):
					match (first.variants, second.variants):
						([[Concrete.RecordType(left_owner)]], [[Concrete.RecordType(right_owner)]]):
							representation = match (a.representation, b.representation, first.representation, second.representation):
								(Concrete.InlineRecord, Concrete.InlineRecord, Concrete.InlineUnmanaged, Concrete.InlineUnmanaged): not managed
								(Concrete.ManagedRecord, Concrete.ManagedRecord, Concrete.InlineOwningPayload, Concrete.InlineOwningPayload): managed
								_: False
							fields = match (a.fields, b.fields):
								([Concrete.IntType], [Concrete.IntType]): not managed
								([Concrete.StringType], [Concrete.StringType]): managed
								_: False
							(
								representation and fields
								and Concrete.record_number(left_owner) == 0
								and Concrete.record_number(right_owner) == 0
							)
						_: False
				_: False
		_: False


pure func test_direct_and_generic_inline_record_representations_agree() -> Bool:
	record_layout_pair("Int", "7", False)


pure func test_direct_and_generic_managed_record_representations_agree() -> Bool:
	record_layout_pair("String", "\"42\"", True)


private pure func owned_producer(field: String, declaration: String, argument: String, is_record: Bool) -> Bool:
	tail: String =
		|fixed union Envelope:
		|    Item(${field})
		|pure func make(value: ${field}) -> Envelope:
		|    Item(value)
		|func main() -> Int:
		|    unused = make(${argument})
		|    0
		|
	source = declaration + tail
	match checked(source).and_then(pure func(program): Concrete.specialize(program)).and_then(pure func(program): Lower.lower(program)):
		Ok(lowered):
			var lower_valid = False
			for function in Lower.lowered_functions(lowered).functions:
				match function.definitions:
					[parameter, constructed]:
						match constructed.operation:
							Lower.ConstructValue(variant, [child]):
								child_type = match parameter.value_type:
									Concrete.StringType: not is_record
									Concrete.RecordType(_): is_record
									_: False
								lower_valid = (
									child_type and Lower.value_number(child) == Lower.value_number(parameter.id)
									and Concrete.variant_number(variant) == 0
									and Concrete.same_type(constructed.value_type, function.signature.return_type)
								)
							_: void
					_: void
			match Own.own(lowered):
				Ok(owned):
					var owned_valid = False
					for function in owned.functions:
						match function.operations:
							[Own.DefineValue(parameter), Own.AcquireOwner(child, borrow, _), Own.DefineValue(constructed)]:
								match (constructed.operation, constructed.result, function.tail):
									(Own.ConstructDefinition(_, [Own.OwnedPayload(value, transferred)]), Own.OwnedResult(parent), Own.ReturnTail(Own.ReturnResult(Own.OwnedReturn(result, returned)))):
										owned_valid = (
											Lower.value_number(value) == Lower.value_number(parameter.id)
											and Lower.value_number(borrow.value) == Lower.value_number(value)
											and Own.owner_number(transferred) == Own.owner_number(child)
											and Own.owner_number(returned) == Own.owner_number(parent)
											and Lower.value_number(result) == Lower.value_number(constructed.id)
										)
									_: void
							_: void
					lower_valid and owned_valid and verify(owned).is_ok()
				Err(_): False
		Err(_): False


pure func test_direct_string_lowering_and_borrow_acquisition_preserve_child() -> Bool:
	owned_producer("String", "", "\"42\"", False)


pure func test_direct_managed_record_lowering_and_acquisition_preserve_child() -> Bool:
	owned_producer("Row", "fixed record Row { text: String }\n", "{ text = \"42\" }", True)


private pure func string_list_layout(source: String) -> Bool:
	match specialized(source):
		Ok(program):
			match program.unions:
				[envelope]:
					match (envelope.variants, envelope.representation):
						([[], [Concrete.ListType(Concrete.StringType)]], Concrete.InlineOwningPayload): True
						_: False
				_: False
		Err(_): False


pure func test_direct_and_generic_string_list_layouts_agree() -> Bool:
	direct: String =
		|fixed union Envelope:
		|    Empty
		|    Item(List[String])
		|pure func make(value: List[String]) -> Envelope:
		|    Item(value)
		|func main(arguments: List[String]) -> Int:
		|    unused = make(arguments)
		|    0
		|
	generic: String =
		|fixed union Envelope[T]:
		|    Empty
		|    Item(T)
		|pure func make(value: List[String]) -> Envelope[List[String]]:
		|    Item(value)
		|func main(arguments: List[String]) -> Int:
		|    unused = make(arguments)
		|    0
		|
	string_list_layout(direct) and string_list_layout(generic)


private pure func nested_owning_layout(source: String) -> Bool:
	match specialized(source):
		Ok(program):
			match program.unions:
				[inner, outer]:
					match (inner.variants, inner.representation, outer.variants, outer.representation):
						([[Concrete.StringType]], Concrete.InlineOwningPayload, [[Concrete.UnionType(child)]], Concrete.InlineOwningPayload):
							Concrete.union_number(child) == 0
						_: False
				_: False
		Err(_): False


pure func test_direct_and_generic_nested_owning_union_layouts_agree() -> Bool:
	direct: String =
		|fixed union Inner:
		|    Text(String)
		|fixed union Outer:
		|    Item(Inner)
		|pure func make(value: Inner) -> Outer:
		|    Item(value)
		|func main() -> Int:
		|    unused = make(Text("42"))
		|    0
		|
	generic: String =
		|fixed union Inner:
		|    Text(String)
		|fixed union Outer[T]:
		|    Item(T)
		|pure func make(value: Inner) -> Outer[Inner]:
		|    Item(value)
		|func main() -> Int:
		|    unused = make(Text("42"))
		|    0
		|
	nested_owning_layout(direct) and nested_owning_layout(generic)


tests: TestSuite = {
	description = "Direct ordinary unary union payloads",
