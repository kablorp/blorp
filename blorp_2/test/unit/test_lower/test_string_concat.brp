import:
	../../../src/check/check: check
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../../../src/utils/source: module_source, root_module_id, same_source
	../input: setup_diagnostic
	../module_input: parse_modules
	../string_concat_inputs: CONCAT_SOURCE
	test: TestSuite


pure func test_concat_lowering_preserves_operands_span_and_result() -> Bool:
	expected_source = module_source(root_module_id())
	expected_start = "pure func concatenate(left: String, right: String) -> String:\n    builtin(".length()
	expected_end = expected_start + "\"string.add\"".length()
	match parse_modules([{ source = CONCAT_SOURCE, targets = [] }])
		.and_then(pure func(parsed): check(parsed).map_err(setup_diagnostic))
		.and_then(Concrete.specialize).and_then(Lower.lower):
		Err(_): False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, function]:
					match function.steps:
						[Lower.Define(left), Lower.Define(right), Lower.Define(result)]:
							match (left.operation, right.operation, result.operation):
								(Lower.ParameterValue(0), Lower.ParameterValue(1), Lower.CallValue(call, [left_id, right_id])):
									match call.target:
										Concrete.RuntimeFunction(Builtins.StringConcat):
											(
												Lower.value_number(left_id) == Lower.value_number(left.id)
												and Lower.value_number(right_id) == Lower.value_number(right.id)
												and Concrete.same_type(result.value_type, Concrete.StringType)
												and same_source(call.span.source, expected_source)
												and same_source(result.span.source, expected_source)
												and call.span.start == expected_start and call.span.end == expected_end
												and result.span.start == expected_start and result.span.end == expected_end
											)
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 String concat lowering",
	tests = [("ordered operands and source occurrence survive lowering", test_concat_lowering_preserves_operands_span_and_result)]
}
