import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../run_to_files_inputs: PROCESS_HEADER, process_seed
	../module_input: test_base
	int: Int methods
	string: String methods
	bool: Bool methods
	test: TestSuite


pure func test_ordered_five_operands_and_operator_span_are_preserved() -> Bool:
	match process_seed(test_base()):
		Err(_): False
		Ok(seed):
			match seed.query.steps:
				[Lower.Define(program), Lower.Define(arguments), Lower.Define(out), Lower.Define(err), Lower.Define(timeout), Lower.Define(result)]:
					match result.operation:
						Lower.CallValue(Concrete.RuntimeFunction(Builtins.RunToFiles(_)), [first, second, third, fourth, fifth]):
							Lower.value_number(first).equals(Lower.value_number(program.id))
								.and(Lower.value_number(second).equals(Lower.value_number(arguments.id)))
								.and(Lower.value_number(third).equals(Lower.value_number(out.id)))
								.and(Lower.value_number(fourth).equals(Lower.value_number(err.id)))
								.and(Lower.value_number(fifth).equals(Lower.value_number(timeout.id)))
								.and(result.span.start.equals(PROCESS_HEADER.length()))
								.and(result.span.end.equals(PROCESS_HEADER.length().add("\"process.run_to_files\"".length())))
						_: False
				_: False


tests: TestSuite = {
	description = "Process builtin lowering",
	tests = [("five operand identities and builtin span", test_ordered_five_operands_and_operator_span_are_preserved)]
}
