import:
	../../../src/lower/lower as Lower
	../../../src/specialize/specialize as Concrete
	../../../src/namespace/builtins as Builtins
	../current_directory_inputs: current_directory_seed
	../module_input: test_base
	test: TestSuite


pure func test_current_directory_lowers_complete_zero_argument_call() -> Bool:
	match current_directory_seed(test_base()):
		Err(_): False
		Ok(seed):
			match seed.query.steps:
				[Lower.Define(result)]:
					match (result.value_type, result.operation):
						(Concrete.UnionType(owner), Lower.CallValue(call, [])):
							match call:
								Concrete.RuntimeFunction(Builtins.GetCurrentDirectory(designated)):
									(
										Concrete.union_number(owner) == Concrete.union_number(Concrete.variant_owner(designated.ok))
										and Concrete.union_number(owner) == Concrete.union_number(Concrete.variant_owner(designated.err))
										and result.span.start == 52 and result.span.end == 82
									)
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 runtime Result lowering",
	tests = [("current directory preserves its concrete call and source span", test_current_directory_lowers_complete_zero_argument_call)]
}
