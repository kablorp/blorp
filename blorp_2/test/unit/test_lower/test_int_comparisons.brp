import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../int_comparison_inputs: lowered_comparison
	../module_input: TEST_BASE
	test: TestSuite


pure func test_lowering_keeps_ordered_int_parameters_and_bool_result() -> Bool:
	match lowered_comparison(TEST_BASE):
		Err(_): False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, function]:
					match function.steps:
						[Lower.Define(left), Lower.Define(right), Lower.Define(result)]:
							match (left.operation, right.operation, result.operation, result.value_type):
								(Lower.ParameterValue(0), Lower.ParameterValue(1), Lower.CallValue(call, [first, second]), Concrete.UnionType(owner)):
									match call:
										Concrete.RuntimeFunction(Builtins.IntLessThan(boolean)):
											Lower.value_number(first) == Lower.value_number(left.id) and Lower.value_number(second) == Lower.value_number(right.id) and Concrete.union_number(owner) == Concrete.union_number(Concrete.variant_owner(boolean.true_variant))
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Signed Int comparison lowering",
	tests = [("ordered Int operands retain the designated Bool result", test_lowering_keeps_ordered_int_parameters_and_bool_result)]
}
