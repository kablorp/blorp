import:
	../../../src/lower/lower as Lower
	../../../src/specialize/specialize as Concrete
	../module_input: test_base
	../void_string_result_inputs: lowered_result
	test: TestSuite


pure func test_constructors_keep_one_actual_payload() -> Bool:
	match lowered_result(test_base()):
		Err(_): False
		Ok(program):
			functions = Lower.lowered_functions(program).functions
			var void_payload = False
			var string_payload = False
			for function in functions:
				match function.steps:
					[Lower.Define(parameter), Lower.Define(constructed)]:
						match (parameter.value_type, constructed.operation):
							(Concrete.VoidType, Lower.ConstructValue(id, [value])):
								void_payload = Concrete.variant_number(id) == 0 and Lower.value_number(value) == Lower.value_number(parameter.id)
							(Concrete.StringType, Lower.ConstructValue(id, [value])):
								string_payload = Concrete.variant_number(id) == 1 and Lower.value_number(value) == Lower.value_number(parameter.id)
							_: void
					_: void
			void_payload and string_payload


tests: TestSuite = {
	description = "Blorp 2 ordinary Void/String Result lowering",
	tests = [("both ordinary constructors keep their actual payload operand", test_constructors_keep_one_actual_payload)]
}
