import:
	../../../src/utils/ids: inventory_functions
	../../../src/check/check: CheckedProgram, check, check_errors, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/model as Check
	../../../src/check/render: render_failure
	../../../src/lower/lower as Lower
	../../../src/parse/assemble: ParsedProgram, parsed_contents
	../../../src/namespace/builtins as Builtins
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, ExpressionBase(FloatExpression), ParsedBody(ParsedValueBody)
	../compilation: compile, compile_modules
	float as FloatOps
	../input: setup_diagnostic
	../module_input: PRIMITIVE_BASE, STRING_OPERATIONS, TEST_BASE, parse_modules, parse_modules_with_base
	test: TestSuite


private pure func literal_source(literal: String) -> String:
	header: String =
		|pure func number() -> Float:
		|
	tail: String =
		|func main() -> Int:
		|    saved = number()
		|    0
		|
	header + "    " + literal + "\n" + tail


private pure func emits_literal(literal: String, expected: String) -> Bool:
	match compile(literal_source(literal)):
		Ok(output):
			output.contains(expected) and output.contains("DBL_MANT_DIG==53")
		Err(_):
			False


pure func test_fraction_reaches_exact_c_bits() -> Bool:
	emits_literal("0.1", "0x1.999999999999ap-4")


pure func test_negative_zero_reaches_signed_c_zero() -> Bool:
	emits_literal("-0.0", "-0x0p+0")


pure func test_subnormal_reaches_exact_c_exponent() -> Bool:
	emits_literal("5e-324", "0x1.0000000000000p-1074")


pure func test_inferred_generic_float_argument_and_return() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|    value
		|pure func number() -> Float:
		|    identity(1.25)
		|func main() -> Int:
		|    saved = number()
		|    0
		|

	match compile(source):
		Ok(output):
			output.contains("double") and output.contains("0x1.4000000000000p+0")
		Err(_):
			False


pure func test_empty_generic_float_payload_still_selects_binary64_guard() -> Bool:
	source: String =
		|fixed union Maybe[T]:
		|    Empty
		|    Full(T)
		|pure func empty() -> Maybe[Float]:
		|    Empty
		|func main() -> Int:
		|    saved = empty()
		|    0
		|

	match compile(source):
		Ok(output):
			output.contains("double") and output.contains("DBL_HAS_SUBNORM==1")
		Err(_):
			False


private pure func emits_binary_call(operation: String) -> Bool:
	header: String =
		|pure func calculate(first: Float, second: Float) -> Float:
		|
	tail: String =
		|func main() -> Int:
		|    saved = calculate(1.25, 2.0)
		|    0
		|
	source = header + "    builtin(\"float." + operation + "\")\n" + tail

	match compile(source):
		Ok(output):
			output.contains("=blorp_float_" + operation + "(")
		Err(_):
			False


pure func test_add_uses_closed_float_contract() -> Bool:
	emits_binary_call("add")


pure func test_subtract_uses_closed_float_contract() -> Bool:
	emits_binary_call("subtract")


pure func test_multiply_uses_closed_float_contract() -> Bool:
	emits_binary_call("multiply")


pure func test_divide_uses_closed_float_contract() -> Bool:
	emits_binary_call("divide")


pure func test_remainder_uses_closed_float_contract() -> Bool:
	emits_binary_call("remainder")


pure func test_format_selects_fresh_string_runtime() -> Bool:
	source: String =
		|import:
		|    string: length
		|pure func format_number(value: Float) -> String:
		|    builtin("float.to_string")
		|func main() -> Int:
		|    length(format_number(0.1))
		|

	match (
		compile_modules(
			[
				{
					source = source,
					targets = [1]
				},
				{
					source = STRING_OPERATIONS,
					targets = []
				},
			],
			PRIMITIVE_BASE,
		)
	):
		Ok(output):
			(
				output.contains("=blorp_float_to_string(")
				and output.contains("BLORP_FLOAT_DEFAULT_PRECISION=6")
				and output.contains("blorp_string_release")
			)
		Err(_):
			False


pure func test_parse_float_returns_the_designated_option() -> Bool:
	source: String =
		|pure func parse_number(text: String) -> Option[Float]:
		|    builtin("string.parse_float")
		|pure func consume(text: String) -> Int:
		|    match parse_number(text):
		|        Some(value): 0
		|        None: 1
		|func main() -> Int:
		|    consume("6.5")
		|

	match compile_modules([{ source = source, targets = [] }], TEST_BASE):
		Ok(output):
			(
				output.contains("double blorp_runtime_")
				and output.contains("=blorp_string_parse_float(")
			)
		Err(_):
			False


pure func test_integer_only_program_has_no_float_runtime() -> Bool:
	match compile("func main() -> Int:\n    42\n"):
		Ok(output):
			not output.contains("blorp_float_") and not output.contains("DBL_MANT_DIG")
		Err(_):
			False


private pure func parsed_number() -> Result[ParsedProgram, Diagnostic]:
	parse_modules(
		[
			{
				source = literal_source("-0.0"),
				targets = []
			},
		],
	)


private pure func checked_number() -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parsed_number()
	check(parsed)
		.map_err(setup_diagnostic)


pure func test_parser_carries_native_signed_zero_once() -> Bool:
	match parsed_number():
		Err(_):
			False
		Ok(program):
			match inventory_functions(parsed_contents(program).declarations).map(pure func(row): row.declaration):
				[number, _]:
					match number.body:
						ParsedValueBody(value):
							match value.base:
								FloatExpression(number):
									FloatOps.equals(number, 0.0) and FloatOps.less_than(
										FloatOps.copysign(1.0, number),
										0.0,
									) and value.applications.is_empty()
								_:
									False
						_:
							False
				_:
					False


pure func test_checker_publishes_float_leaf_and_type() -> Bool:
	match checked_number():
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[number, _]:
					match number.body:
						Check.CheckedValueBody(Check.ReturnExpression(value)):
							match value.form:
								Check.LiteralFloat(number):
									(
										Check.same_type(value.value_type, Check.FloatType)
										and FloatOps.less_than(
											FloatOps.copysign(1.0, number),
											0.0,
										)
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_specialization_preserves_unboxed_native_leaf() -> Bool:
	match checked_number().and_then(pure func(program): Concrete.specialize(program)):
		Err(_):
			False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, number]:
					match number.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match value.form:
								Concrete.LiteralFloat(number):
									(
										Concrete.same_type(value.value_type, Concrete.FloatType)
										and FloatOps.less_than(
											FloatOps.copysign(1.0, number),
											0.0,
										)
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_lowering_publishes_one_float_definition() -> Bool:
	match (
		checked_number()
			.and_then(pure func(program): Concrete.specialize(program))
			.and_then(pure func(program): Lower.lower(program))
	):
		Err(_):
			False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, number]:
					match (number.definitions, number.tail):
						([definition], Lower.ExitValue(Lower.ReturnValue(returned))):
							match definition.operation:
								Lower.FloatValue(number):
									(
										Concrete.same_type(
											definition.value_type,
											Concrete.FloatType,
										)
										and Lower.value_number(
											definition.id,
										) == Lower.value_number(returned)
										and FloatOps.less_than(
											FloatOps.copysign(1.0, number),
											0.0,
										)
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_checker_never_coerces_int_into_float() -> Bool:
	source: String =
		|pure func number() -> Float:
		|    1
		|func main() -> Int:
		|    0
		|

	match (
		parse_modules(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Err(_):
			False
		Ok(program):
			match check(program):
				Ok(_):
					False
				Err(failure):
					error = check_errors(failure).first
					rendered = render_failure(failure).first

					match error.kind:
						Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
							(
								Check.same_type(mismatch.expected, Check.FloatType)
								and Check.same_type(mismatch.actual.value_type, Check.IntType)
								and rendered.message == "expression does not match the expected type"
								and rendered.help == "use an expression of type Float here"
								and rendered.span.start == "pure func number() -> Float:\n    ".length()
								and rendered.span.end == "pure func number() -> Float:\n    1".length()
								and same_source(
									rendered.span.source,
									module_source(root_module_id()),
								)
							)
						_:
							False


pure func test_arithmetic_only_source_selects_no_string_float_fragment() -> Bool:
	source: String =
		|pure func add(first: Float, second: Float) -> Float:
		|    builtin("float.add")
		|func main() -> Int:
		|    saved = add(1.25, 2.0)
		|    0
		|

	match compile(source):
		Ok(output):
			(
				output.contains("DBL_MANT_DIG==53")
				and not output.contains("BLORP_FLOAT_TEXT_CAPACITY")
				and not output.contains("blorp_string_parse_float")
			)
		Err(_):
			False


pure func test_checked_parse_option_uses_float_payload_not_int() -> Bool:
	source: String =
		|pure func parse_number(text: String) -> Option[Float]:
		|    builtin("string.parse_float")
		|func main() -> Int:
		|    parsed = parse_number("1.25")
		|    0
		|

	match (
		parse_modules(
			[
				{
					source = source,
					targets = []
				},
			],
		)
			.and_then(pure func(program): check(program)
					.map_err(setup_diagnostic))
			.and_then(pure func(program): Concrete.specialize(program))
	):
		Err(_):
			False
		Ok(program):
			contents = Concrete.specialized_contents(program)

			match contents.functions:
				[_, parser]:
					match parser.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match value.form:
								Concrete.InvokeFunction(call, [_]):
									match call.target:
										Concrete.RuntimeFunction(Builtins.StringParseFloat(option)):
											owner = Concrete.variant_owner(option.some)

											match contents.unions.get(Concrete.union_number(owner)):
												Some(layout):
													match (layout.variants, layout.representation):
														([[Concrete.FloatType], []], Concrete.InlineUnmanaged):
															(
																Concrete.variant_number(
																	option.some,
																) == 0
																and Concrete.variant_number(
																	option.none,
																) == 1
																and Concrete.union_number(
																	owner,
																) == Concrete.union_number(
																	Concrete.variant_owner(
																		option.none,
																	),
																)
																and Concrete.same_type(
																	value.value_type,
																	Concrete.UnionType(owner),
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


private BASE_TYPES: String =
	|type Int = builtin
	|type String = builtin
	|type Void = builtin
	|


private pure func foundation_rejects(
	source: String,
	expected_kind: Builtins.BuiltinTypeErrorKind,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	root: String =
		|func main() -> Int:
		|    parsed = parse_number("1.25")
		|    0
		|
	match parse_modules_with_base([
		{ source = root, targets = [] },
	], { PRIMITIVE_BASE | types = source }):
		Err(_): False
		Ok(program):
			match Builtins.check_builtin_types(program):
				Ok(_): False
				Err(failure):
					error = Builtins.render_builtin_type_error(failure)
					kind_matches = match (failure.kind, expected_kind):
						(Builtins.MissingBuiltinType(Builtins.FloatType), Builtins.MissingBuiltinType(Builtins.FloatType)): True
						(Builtins.DuplicateBuiltinType(Builtins.FloatType), Builtins.DuplicateBuiltinType(Builtins.FloatType)): True
						_: False
					(
						kind_matches
						and same_source(
							error.span.source,
							module_source(parsed_contents(program).foundation.types),
						)
						and error.span.start == start
						and error.span.end == end
						and error.message == message
						and error.help == help
						and error.note.is_none()
					)


pure func test_float_foundation_role_is_required_without_fallback() -> Bool:
	foundation_rejects(
		BASE_TYPES,
		Builtins.MissingBuiltinType(Builtins.FloatType),
		BASE_TYPES.length(),
		BASE_TYPES.length(),
		"missing Float builtin declaration",
		"add type Float = builtin to _base.brp",
	)


pure func test_duplicate_float_foundation_role_has_exact_occurrence() -> Bool:
	prefix = BASE_TYPES + "type Float = builtin\n"
	foundation_rejects(
		prefix + "type Float = builtin\n",
		Builtins.DuplicateBuiltinType(Builtins.FloatType),
		prefix.length() + 5,
		prefix.length() + 10,
		"duplicate builtin type declaration",
		"declare type Float = builtin exactly once",
	)


private fixed union RejectionKind:
	MainType
	RuntimeContract


private pure func check_rejects(
	source: String,
	kind: RejectionKind,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match (
		parse_modules(
			[
				{
					source = source,
					targets = []
				},
			],
		)
	):
		Err(_):
			False
		Ok(program):
			match check(program):
				Ok(_):
					False
				Err(failure):
					errors = check_errors(failure)
					rendered = render_failure(failure)

					kind_matches = match (errors.first.kind, kind):
						(Errors.SignatureRejection(Errors.MainReturnType(Check.FloatType)), MainType):
							True
						(Errors.BuiltinRejection(Errors.BuiltinContractMismatch(_)), RuntimeContract):
							True
						_:
							False

					(
						kind_matches
						and errors.remaining.is_empty()
						and rendered.remaining.is_empty()
						and same_source(rendered.first.span.source, module_source(root_module_id()))
						and rendered.first.span.start == start
						and rendered.first.span.end == end
						and rendered.first.message == message
						and rendered.first.help == help
						and rendered.first.note.is_none()
					)


pure func test_float_main_is_rejected_before_body() -> Bool:
	source: String =
		|func main() -> Float:
		|    0.0
		|
	check_rejects(
		source,
		MainType,
		15,
		20,
		"main must return Int or Void",
		"return an Int exit status, or omit the return type for exit status 0",
	)


pure func test_direct_float_record_field_is_inline() -> Bool:
	source: String =
		|fixed record Point { value: Float }
		|pure func make() -> Point:
		|    { value = 2.5 }
		|func main() -> Int:
		|    unused = make().value
		|    0
		|

	match compile(source):
		Ok(_):
			True
		Err(_):
			False


pure func test_direct_float_union_payload_publishes_float_type() -> Bool:
	source: String =
		|fixed union Raw:
		|    Full(Float)
		|func main() -> Int:
		|    0
		|
	match parse_modules_with_base([{ source = source, targets = [] }], PRIMITIVE_BASE):
		Ok(parsed):
			match check(parsed):
				Ok(program):
					match checked_functions(program).unions:
						[raw, _, _, _]:
							match raw.variants:
								[variant]:
									match variant.fields:
										[payload]:
											Check.same_type(payload.value_type, Check.FloatType)
										_:
											False
								_: False
						_: False
				Err(_): False
		Err(_): False


private pure func rejects_runtime(header: String, label: String, help: String) -> Bool:
	tail: String =
		|func main() -> Int:
		|    0
		|
	prefix = header + "\n    builtin("
	check_rejects(
		prefix + label + ")\n" + tail,
		RuntimeContract,
		prefix.length(),
		prefix.length() + label.length(),
		"builtin declaration does not match its runtime contract",
		help,
	)


pure func test_float_binary_contract_rejects_int_parameter() -> Bool:
	rejects_runtime(
		"pure func add(first: Int, second: Float) -> Float:",
		"\"float.add\"",
		"declare a pure function with two Float parameters returning Float",
	)


pure func test_float_formatter_contract_rejects_int_parameter() -> Bool:
	rejects_runtime(
		"pure func format_number(value: Int) -> String:",
		"\"float.to_string\"",
		"declare a pure function with one Float parameter returning String",
	)


pure func test_parse_float_checker_rejects_int_option_payload() -> Bool:
	prefix: String =
		|pure func parse_number(text: String) -> Option[Int]:
		|
	tail: String =
		|func main() -> Int:
		|    0
		|
	body = "    builtin("
	label = "\"string.parse_float\""
	start = prefix.length() + body.length()
	check_rejects(
		prefix + body + label + ")\n" + tail,
		RuntimeContract,
		start,
		start + label.length(),
		"builtin declaration does not match its runtime contract",
		"declare a pure nongeneric function with one String parameter returning Option[Float]",
	)


tests: TestSuite = {
	description = "Blorp 2 Float producer-to-consumer boundary",
	tests = [
		(
			"Float foundation role required without fallback",
			test_float_foundation_role_is_required_without_fallback,
		),
		(
			"duplicate Float foundation has exact occurrence",
			test_duplicate_float_foundation_role_has_exact_occurrence,
		),
		("Float main rejected before body", test_float_main_is_rejected_before_body),
		("direct Float record field stays out of scope", test_direct_float_record_field_is_inline),
		(
			"direct Float union payload accepted",
			test_direct_float_union_payload_publishes_float_type,
		),
		("Float binary rejects Int parameter", test_float_binary_contract_rejects_int_parameter),
		(
			"Float formatter rejects Int parameter",
			test_float_formatter_contract_rejects_int_parameter,
		),
		(
			"parse Float checker rejects Int payload",
			test_parse_float_checker_rejects_int_option_payload,
		),
		("parser carries native signed zero once", test_parser_carries_native_signed_zero_once),
		("checker publishes Float leaf and type", test_checker_publishes_float_leaf_and_type),
		(
			"specialization preserves native Float leaf",
			test_specialization_preserves_unboxed_native_leaf,
		),
		("lowering publishes one Float definition", test_lowering_publishes_one_float_definition),
		("checker never coerces Int into Float", test_checker_never_coerces_int_into_float),
		(
			"arithmetic-only source has no String Float fragment",
			test_arithmetic_only_source_selects_no_string_float_fragment,
		),
		(
			"parse Option uses concrete Float payload",
			test_checked_parse_option_uses_float_payload_not_int,
		),
		("fraction reaches exact C bits", test_fraction_reaches_exact_c_bits),
		("negative zero reaches signed C zero", test_negative_zero_reaches_signed_c_zero),
		("subnormal reaches exact C exponent", test_subnormal_reaches_exact_c_exponent),
		(
			"inferred generic Float argument and return",
			test_inferred_generic_float_argument_and_return,
		),
		(
			"empty generic Float payload selects binary64 guard",
			test_empty_generic_float_payload_still_selects_binary64_guard,
		),
		("add uses closed Float contract", test_add_uses_closed_float_contract),
		("subtract uses closed Float contract", test_subtract_uses_closed_float_contract),
		("multiply uses closed Float contract", test_multiply_uses_closed_float_contract),
		("divide uses closed Float contract", test_divide_uses_closed_float_contract),
		("remainder uses closed Float contract", test_remainder_uses_closed_float_contract),
		("format selects fresh String runtime", test_format_selects_fresh_string_runtime),
		(
			"parse Float returns the designated Option",
			test_parse_float_returns_the_designated_option,
		),
		(
			"integer-only program has no Float runtime",
			test_integer_only_program_has_no_float_runtime,
		),
	]
}
