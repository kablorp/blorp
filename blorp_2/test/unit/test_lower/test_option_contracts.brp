import:
	../../../src/check/model as Model
	../../../src/check/check: CheckFailure, CheckedProgram, check, check_errors, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/render: render_failure
	../../../src/utils/ids: union_number, variant_number, variant_owner
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, ParsedRuntimeOperation(StringParseIntBuiltin, ListGetBuiltin, StringByteAtBuiltin, StringFromCodepointBuiltin)
	../../../src/utils/text: concat
	../input: setup_diagnostic
	../module_input: parse_modules
	../string_integer_inputs: STRING_INTEGER_SOURCE, BYTE_LABEL_START, ENCODER_LABEL_START
	int as IntOps
	test: TestSuite


-- The test foundation declares Option[A] as Some(A), then None.
private HEADER: String = "pure func parse_number(text: String) -> Option[Int]:"
private LABEL: String = "\"string.parse_int\""
private MAIN: String =
	|func main() -> Int:
	|    0
	|
private PARSE_MAIN: String =
	|func main() -> Int:
	|    parsed = parse_number("42")
	|    0
	|
private READ_MAIN: String =
	|func main(arguments: List[String]) -> Int:
	|    read = read_text(arguments, 0)
	|    0
	|
private BODY: String = "\n    builtin(\"string.parse_int\")\n"
private READ_HEADER: String = "pure func read_text(values: List[String], index: Int) -> Option[String]:"
private READ_LABEL: String = "\"list.get\""
private READ_BODY: String = "\n    builtin(\"list.get\")\n"
private PARSE_HELP: String = "declare a pure nongeneric function with one String parameter returning Option[Int]"
private READ_HELP: String = "declare a pure function with List[E] and Int parameters returning Option[E]"


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules([{ source = source, targets = [] }])
	check(parsed).map_err(setup_diagnostic)


private pure func rejected(source: String) -> Option[CheckFailure]:
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): None
		Ok(parsed):
			match check(parsed):
				Err(failure): Some(failure)
				Ok(_): None


private pure func rendered_is(failure: CheckFailure, start: Int, end: Int, message: String, help: String) -> Bool:
	rendered = render_failure(failure)
	(
		check_errors(failure).remaining.is_empty()
		and rendered.remaining.is_empty()
		and same_source(rendered.first.span.source, module_source(root_module_id()))
		and rendered.first.span.start == start and rendered.first.span.end == end
		and rendered.first.message == message and rendered.first.help == help
		and rendered.first.note.is_none()
	)


pure func test_checked_parse_carries_the_designated_option_constructors() -> Bool:
	match checked(HEADER + BODY + PARSE_MAIN):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions.get(0):
				Some(function):
					match (function.signature.return_type.value_type, function.body):
						(Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(owner)), [Model.IntType]), Model.CheckedValueBody(Model.ReturnExpression(value))):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(argument)]:
											match call.target:
												Model.RuntimeFunction(Builtins.StringParseInt(option)):
													(
														union_number(variant_owner(option.some)) == union_number(owner)
														and union_number(variant_owner(option.none)) == union_number(owner)
														and variant_number(option.some) == 0 and variant_number(option.none) == 1
														and Model.same_type(argument.value_type, Model.StringType)
														and function.signature.type_parameters.is_empty()
													)
												_: False
										_: False
								_: False
						_: False
				None: False


pure func test_specialization_translates_option_constructors_to_one_concrete_layout() -> Bool:
	match checked(HEADER + BODY + PARSE_MAIN).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			contents = Concrete.specialized_contents(program)
			match contents.functions.get(1):
				Some(function):
					match (function.signature.return_type, function.body):
						(Concrete.UnionType(owner), Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
							match value.form:
								Concrete.InvokeFunction(call, [_]):
									match call.target:
										Concrete.RuntimeFunction(Builtins.StringParseInt(option)):
											match contents.unions.get(Concrete.union_number(owner)):
												Some(layout):
													match (Concrete.union_variants(layout), layout):
														([[Concrete.IntType], []], Concrete.PlainCases(_)):
															Concrete.union_number(Concrete.variant_owner(option.some)) == Concrete.union_number(owner) and Concrete.union_number(Concrete.variant_owner(option.none)) == Concrete.union_number(owner) and Concrete.variant_number(option.some) == 0 and Concrete.variant_number(option.none) == 1
														_: False
												None: False
										_: False
								_: False
						_: False
				None: False


pure func test_lowering_preserves_borrow_input_and_option_constructors() -> Bool:
	match checked(HEADER + BODY + PARSE_MAIN).and_then(pure func(program): Concrete.specialize(program)).and_then(pure func(program): Lower.lower(program)):
		Err(_): False
		Ok(program):
			match Lower.lowered_functions(program).functions.get(1):
				Some(function):
					match function.steps:
						[Lower.Define(parameter), Lower.Define(result)]:
							match (parameter.operation, result.operation, result.value_type, function.result):
								(Lower.ParameterValue(0), Lower.CallValue(call, [argument]), Concrete.UnionType(owner), returned):
									match call:
										Concrete.RuntimeFunction(Builtins.StringParseInt(option)):
											Lower.value_number(argument) == Lower.value_number(parameter.id) and Lower.value_number(returned) == Lower.value_number(result.id) and Concrete.union_number(Concrete.variant_owner(option.some)) == Concrete.union_number(owner) and Concrete.variant_number(option.some) == 0 and Concrete.variant_number(option.none) == 1
										_: False
								_: False
						_: False
				None: False


private pure func rejects_parse(declarations: String, header: String) -> Bool:
	start = declarations.length() + header.length() + "\n    builtin(".length()
	match rejected(declarations + header + BODY + MAIN):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.BuiltinRejection(Errors.BuiltinContractMismatch(StringParseIntBuiltin)):
					rendered_is(failure, start, start + LABEL.length(), "builtin declaration does not match its runtime contract", PARSE_HELP)
				_: False
		None: False


pure func test_impure_parse_declaration_is_rejected_before_use() -> Bool:
	rejects_parse("", "func parse_number(text: String) -> Option[Int]:")

pure func test_wrong_parse_parameter_type_is_rejected_before_use() -> Bool:
	rejects_parse("", "pure func parse_number(text: Int) -> Option[Int]:")

pure func test_missing_parse_parameter_is_rejected_before_use() -> Bool:
	rejects_parse("", "pure func parse_number() -> Option[Int]:")

pure func test_extra_parse_parameter_is_rejected_before_use() -> Bool:
	rejects_parse("", "pure func parse_number(text: String, extra: Int) -> Option[Int]:")

pure func test_generic_builtin_wrapper_is_rejected_before_use() -> Bool:
	rejects_parse("", "pure func parse_number[T](text: String) -> Option[Int]:")

pure func test_parse_requires_the_int_payload() -> Bool:
	rejects_parse("", "pure func parse_number(text: String) -> Option[String]:")

pure func test_primitive_parse_result_is_rejected() -> Bool:
	rejects_parse("", "pure func parse_number(text: String) -> Int:")

-- Option is an identity: a union of the same shape is not the designated one.
pure func test_parse_into_an_ordinary_union_is_rejected() -> Bool:
	source: String =
		|union Maybe[T]:
		|    Present(T)
		|    Missing
		|

	rejects_parse(source, "pure func parse_number(text: String) -> Maybe[Int]:")


pure func test_constructor_arguments_have_exact_parser_diagnostic() -> Bool:
	prefix = HEADER + "\n    builtin(" + LABEL
	match parse_modules([{ source = prefix + ", Some, None)\n" + MAIN, targets = [] }]):
		Err(error):
			error.span.start == prefix.length() and error.span.end == prefix.length() + 1 and error.message == "expected ')' after the builtin label" and error.help == "give the builtin one quoted label; Bool and Option results use the foundation's unions"
		Ok(_): False


pure func test_list_get_checked_constructors_belong_to_string_application() -> Bool:
	match checked(READ_HEADER + READ_BODY + MAIN):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions.get(0):
				Some(function):
					match (function.signature.return_type.value_type, function.body):
						(Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(owner)), [Model.StringType]), Model.CheckedValueBody(Model.ReturnExpression(value))):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(_), Model.ValueOperand(_)]:
											match call.target:
												Model.RuntimeFunction(Builtins.ListGet(Model.StringType, option)):
													union_number(variant_owner(option.some)) == union_number(owner) and union_number(variant_owner(option.none)) == union_number(owner) and variant_number(option.some) == 0 and variant_number(option.none) == 1 and function.signature.parameters.length() == 2 and function.signature.type_parameters.is_empty()
												_: False
										_: False
								_: False
						_: False
				None: False


pure func test_list_get_specializes_to_inline_owning_string_layout() -> Bool:
	match checked(READ_HEADER + READ_BODY + READ_MAIN).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			contents = Concrete.specialized_contents(program)
			match contents.functions.get(1):
				Some(function):
					match function.signature.return_type:
						Concrete.UnionType(owner):
							match contents.unions.get(Concrete.union_number(owner)):
								Some(layout):
									match (Concrete.union_variants(layout), layout):
										([[Concrete.StringType], []], Concrete.OwningCases(_)): True
										_: False
								None: False
						_: False
				None: False


private pure func rejects_read_header(declarations: String, header: String) -> Bool:
	start = declarations.length() + header.length() + "\n    builtin(".length()
	match rejected(declarations + header + READ_BODY + MAIN):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.BuiltinRejection(Errors.BuiltinContractMismatch(ListGetBuiltin)):
					rendered_is(failure, start, start + READ_LABEL.length(), "builtin declaration does not match its runtime contract", READ_HELP)
				_: False
		None: False


pure func test_impure_list_get_declaration_is_rejected_before_use() -> Bool:
	rejects_read_header("", "func read_text(values: List[String], index: Int) -> Option[String]:")

pure func test_list_get_parameter_is_rejected_before_use() -> Bool:
	rejects_read_header("", "func read_text(unused: Int) -> Option[String]:")

pure func test_generic_list_get_missing_parameters_is_rejected_before_use() -> Bool:
	rejects_read_header("", "func read_text[T]() -> Option[String]:")

-- Option is an identity for list.get too: a same-shaped union is not the designated one.
pure func test_list_get_into_an_ordinary_union_is_rejected() -> Bool:
	source: String =
		|union Maybe[T]:
		|    Present(T)
		|    Missing
		|

	rejects_read_header(source, "pure func read_text(values: List[String], index: Int) -> Maybe[String]:")

pure func test_list_get_requires_the_element_payload() -> Bool:
	rejects_read_header("", "pure func read_text(values: List[String], index: Int) -> Option[Int]:")


pure func test_pure_caller_can_invoke_list_get_wrapper() -> Bool:
	caller = "pure func lookup(values: List[String]) -> Option[String]:\n    read_text(values, 0)\n"
	checked(READ_HEADER + READ_BODY + caller + MAIN).is_ok()



private BYTE_HELP: String = "declare a pure nongeneric function with String and Int parameters returning Option[Int]"
private ENCODER_HELP: String = "declare a pure nongeneric function with one Int parameter returning Option[String]"


private pure func rejects_string_api(header: String, label: String, operation: ParsedRuntimeOperation, help: String) -> Bool:
	prefix = header.concat("\n    builtin(")
	quoted = "\"".concat(label).concat("\"")
	match rejected(prefix.concat(quoted).concat(")\n").concat(MAIN)):
		None: False
		Some(failure):
			kind_matches = match (check_errors(failure).first.kind, operation):
				(Errors.BuiltinRejection(Errors.BuiltinContractMismatch(StringByteAtBuiltin)), StringByteAtBuiltin) | (Errors.BuiltinRejection(Errors.BuiltinContractMismatch(StringFromCodepointBuiltin)), StringFromCodepointBuiltin): True
				_: False
			kind_matches and rendered_is(failure, prefix.length(), IntOps.add(prefix.length(), quoted.length()), "builtin declaration does not match its runtime contract", help)


pure func test_string_integer_builtins_require_purity() -> Bool:
	(
		rejects_string_api("func read(value: String, index: Int) -> Option[Int]:", "string.byte_at", StringByteAtBuiltin, BYTE_HELP)
		and rejects_string_api("func encode(value: Int) -> Option[String]:", "string.from_codepoint", StringFromCodepointBuiltin, ENCODER_HELP)
	)

pure func test_string_integer_builtins_require_exact_arity() -> Bool:
	(
		rejects_string_api("pure func read(value: String) -> Option[Int]:", "string.byte_at", StringByteAtBuiltin, BYTE_HELP)
		and rejects_string_api("pure func encode() -> Option[String]:", "string.from_codepoint", StringFromCodepointBuiltin, ENCODER_HELP)
		and rejects_string_api("pure func read(value: String, index: Int, extra: Int) -> Option[Int]:", "string.byte_at", StringByteAtBuiltin, BYTE_HELP)
		and rejects_string_api("pure func encode(value: Int, extra: Int) -> Option[String]:", "string.from_codepoint", StringFromCodepointBuiltin, ENCODER_HELP)
	)

pure func test_string_integer_builtins_require_parameter_types() -> Bool:
	(
		rejects_string_api("pure func read(value: Int, index: Int) -> Option[Int]:", "string.byte_at", StringByteAtBuiltin, BYTE_HELP)
		and rejects_string_api("pure func read(value: String, index: String) -> Option[Int]:", "string.byte_at", StringByteAtBuiltin, BYTE_HELP)
		and rejects_string_api("pure func encode(value: String) -> Option[String]:", "string.from_codepoint", StringFromCodepointBuiltin, ENCODER_HELP)
	)

pure func test_string_integer_builtins_require_payload_types() -> Bool:
	(
		rejects_string_api("pure func read(value: String, index: Int) -> Option[Float]:", "string.byte_at", StringByteAtBuiltin, BYTE_HELP)
		and rejects_string_api("pure func encode(value: Int) -> Option[Int]:", "string.from_codepoint", StringFromCodepointBuiltin, ENCODER_HELP)
	)

pure func test_string_integer_builtins_reject_generic_headers() -> Bool:
	(
		rejects_string_api("pure func read[T](value: String, index: Int) -> Option[Int]:", "string.byte_at", StringByteAtBuiltin, BYTE_HELP)
		and rejects_string_api("pure func encode[T](value: Int) -> Option[String]:", "string.from_codepoint", StringFromCodepointBuiltin, ENCODER_HELP)
	)

pure func test_string_integer_builtins_reject_same_shaped_ordinary_unions() -> Bool:
	declaration = "union Maybe[T]:\n    Present(T)\n    Missing\n"
	(
		rejects_string_api(declaration.concat("pure func read(value: String, index: Int) -> Maybe[Int]:"), "string.byte_at", StringByteAtBuiltin, BYTE_HELP)
		and rejects_string_api(declaration.concat("pure func encode(value: Int) -> Maybe[String]:"), "string.from_codepoint", StringFromCodepointBuiltin, ENCODER_HELP)
	)


pure func test_encoder_checked_result_carries_designated_string_option() -> Bool:
	match checked(STRING_INTEGER_SOURCE):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions.get(1):
				Some(function):
					match (function.signature.return_type.value_type, function.body):
						(Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(owner)), [Model.StringType]), Model.CheckedValueBody(Model.ReturnExpression(value))):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(argument)]:
											match call.target:
												Model.RuntimeFunction(Builtins.StringFromCodepoint(option)):
													(
														Model.same_type(argument.value_type, Model.IntType)
														and IntOps.equals(union_number(variant_owner(option.some)), union_number(owner))
														and IntOps.equals(union_number(variant_owner(option.none)), union_number(owner))
														and IntOps.equals(variant_number(option.some), 0)
														and IntOps.equals(variant_number(option.none), 1)
													)
												_: False
										_: False
								_: False
						_: False
				None: False


private pure func concrete_option_matches(option: Builtins.DesignatedOption[Concrete.VariantInstanceId], value_type: Concrete.TypeRef) -> Bool:
	match value_type:
		Concrete.UnionType(owner):
			(
				IntOps.equals(Concrete.union_number(Concrete.variant_owner(option.some)), Concrete.union_number(owner))
				and IntOps.equals(Concrete.union_number(Concrete.variant_owner(option.none)), Concrete.union_number(owner))
				and IntOps.equals(Concrete.variant_number(option.some), 0)
				and IntOps.equals(Concrete.variant_number(option.none), 1)
			)
		_: False


pure func test_string_integer_specialization_preserves_constructors_and_layouts() -> Bool:
	match checked(STRING_INTEGER_SOURCE).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			contents = Concrete.specialized_contents(program)
			match contents.functions:
				[_, byte, encoder]:
					match (byte.body, encoder.body):
						(Concrete.ConcreteValueBody(Concrete.ReturnExpression(byte_value)), Concrete.ConcreteValueBody(Concrete.ReturnExpression(encoded))):
							match (byte_value.form, encoded.form):
								(Concrete.InvokeFunction(byte_call, [_, _]), Concrete.InvokeFunction(encoder_call, [_])):
									match (byte_call.target, encoder_call.target):
										(Concrete.RuntimeFunction(Builtins.StringByteAt(byte_option)), Concrete.RuntimeFunction(Builtins.StringFromCodepoint(string_option))):
											match (contents.unions.get(Concrete.union_number(Concrete.variant_owner(byte_option.some))), contents.unions.get(Concrete.union_number(Concrete.variant_owner(string_option.some)))):
												(Some(byte_layout), Some(string_layout)):
													match (Concrete.union_variants(byte_layout), byte_layout, Concrete.union_variants(string_layout), string_layout):
														([[Concrete.IntType], []], Concrete.PlainCases(_), [[Concrete.StringType], []], Concrete.OwningCases(_)):
															concrete_option_matches(byte_option, byte.signature.return_type) and concrete_option_matches(string_option, encoder.signature.return_type)
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False


pure func test_string_integer_lowering_preserves_operands_constructors_and_spans() -> Bool:
	match checked(STRING_INTEGER_SOURCE).and_then(pure func(program): Concrete.specialize(program)).and_then(pure func(program): Lower.lower(program)):
		Err(_): False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, byte, encoder]:
					match (byte.steps, encoder.steps, byte.result, encoder.result):
						([Lower.Define(text), Lower.Define(index), Lower.Define(byte_result)], [Lower.Define(scalar), Lower.Define(encoded)], byte_return, encoder_return):
							match ((text.operation, index.operation, scalar.operation), byte_result.operation, encoded.operation):
								((Lower.ParameterValue(0), Lower.ParameterValue(1), Lower.ParameterValue(0)), Lower.CallValue(byte_call, [text_arg, index_arg]), Lower.CallValue(encoder_call, [scalar_arg])):
									match (byte_call, encoder_call):
										(Concrete.RuntimeFunction(Builtins.StringByteAt(byte_option)), Concrete.RuntimeFunction(Builtins.StringFromCodepoint(string_option))):
											(
												IntOps.equals(Lower.value_number(text_arg), Lower.value_number(text.id))
												and IntOps.equals(Lower.value_number(index_arg), Lower.value_number(index.id))
												and IntOps.equals(Lower.value_number(scalar_arg), Lower.value_number(scalar.id))
												and IntOps.equals(Lower.value_number(byte_return), Lower.value_number(byte_result.id))
												and IntOps.equals(Lower.value_number(encoder_return), Lower.value_number(encoded.id))
												and concrete_option_matches(byte_option, byte_result.value_type)
												and concrete_option_matches(string_option, encoded.value_type)
												and same_source(byte_result.span.source, module_source(root_module_id()))
												and same_source(encoded.span.source, module_source(root_module_id()))
												and IntOps.equals(byte_result.span.start, BYTE_LABEL_START)
												and IntOps.equals(byte_result.span.end, IntOps.add(BYTE_LABEL_START, "\"string.byte_at\"".length()))
												and IntOps.equals(encoded.span.start, ENCODER_LABEL_START)
												and IntOps.equals(encoded.span.end, IntOps.add(ENCODER_LABEL_START, "\"string.from_codepoint\"".length()))
											)
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 designated Option builtin contracts",
	tests = [
		("String integer builtins require purity", test_string_integer_builtins_require_purity),
		("String integer builtins require exact arity", test_string_integer_builtins_require_exact_arity),
		("String integer builtins require parameter types", test_string_integer_builtins_require_parameter_types),
		("String integer builtins require payload types", test_string_integer_builtins_require_payload_types),
		("String integer builtins reject generic headers", test_string_integer_builtins_reject_generic_headers),
		("String integer builtins require the designated Option", test_string_integer_builtins_reject_same_shaped_ordinary_unions),
		("checked encoder carries designated String Option", test_encoder_checked_result_carries_designated_string_option),
		("String integer specialization preserves constructors and layouts", test_string_integer_specialization_preserves_constructors_and_layouts),
		("String integer lowering preserves operands constructors and spans", test_string_integer_lowering_preserves_operands_constructors_and_spans),
		("checked parse carries designated Option constructors", test_checked_parse_carries_the_designated_option_constructors),
		("specialization translates Option constructors to concrete layout", test_specialization_translates_option_constructors_to_one_concrete_layout),
		("lowering preserves input and Option constructors", test_lowering_preserves_borrow_input_and_option_constructors),
		("impure declaration rejected before use", test_impure_parse_declaration_is_rejected_before_use),
		("wrong parameter type rejected before use", test_wrong_parse_parameter_type_is_rejected_before_use),
		("missing parameter rejected before use", test_missing_parse_parameter_is_rejected_before_use),
		("extra parameter rejected before use", test_extra_parse_parameter_is_rejected_before_use),
		("generic builtin wrapper rejected before use", test_generic_builtin_wrapper_is_rejected_before_use),
		("parse requires the Int payload", test_parse_requires_the_int_payload),
		("primitive parse result rejected", test_primitive_parse_result_is_rejected),
		("parse into an ordinary union rejected", test_parse_into_an_ordinary_union_is_rejected),
		("constructor arguments exact parser diagnostic", test_constructor_arguments_have_exact_parser_diagnostic),
		("list get constructors belong to String application", test_list_get_checked_constructors_belong_to_string_application),
		("list get specializes to owning String layout", test_list_get_specializes_to_inline_owning_string_layout),
		("impure list get declaration rejected before use", test_impure_list_get_declaration_is_rejected_before_use),
		("list get parameter rejected before use", test_list_get_parameter_is_rejected_before_use),
		("generic list get missing parameters rejects before use", test_generic_list_get_missing_parameters_is_rejected_before_use),
		("list get into an ordinary union rejected", test_list_get_into_an_ordinary_union_is_rejected),
		("list get requires the element payload", test_list_get_requires_the_element_payload),
		("pure caller can invoke list get wrapper", test_pure_caller_can_invoke_list_get_wrapper),
	]
}
