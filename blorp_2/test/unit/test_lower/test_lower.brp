		|	second = first
		|	unused = first.length()
		|	second.length()
		|

	match fixture_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function, _, _]:
					match function.steps:
						[Define(_), Define(string), Define(first_length), Define(second_length)]:
							match first_length.operation:
								CallValue(_, [first_receiver]):
									match second_length.operation:
										CallValue(_, [second_receiver]):
											result = function.result
											(
												value_number(string.id) == 1
												and same_type(string.value_type, StringType)
												and value_number(first_receiver) == 1
												and value_number(second_receiver) == 1
												and value_number(first_length.id) == 2
												and value_number(second_length.id) == 3
												and value_number(result) == 3
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_string_arm_computations_remain_branch_local() -> Bool:
	source: String =
		|import:
		|	int: Int methods
		|	string: String methods
		|union Choice:
		|	First
		|	Second
		|pure func choose(choice: Choice) -> String:
		|	match choice:
		|		First: 7.to_string()
		|		Second: 42.to_string()
		|func main() -> Int:
		|	choose(Second).length()
		|

	match fixture_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, choose, _, _]:
					match choose.steps:
						[Define(parameter), Join(_)]:
							match lowered_tail_join(choose):
								Some(matched):
									match matched.arms:
										[first, second]:
											match first.steps:
												[Define(first_number), Define(first_string)]:
													match second.steps:
														[Define(second_number), Define(second_string)]:
															match first_string.operation:
																CallValue(_, [first_argument]):
																	match second_string.operation:
																		CallValue(_, [second_argument]):
																			(
																				value_number(
																					parameter.id,
																				) == 0
																				and value_number(
																					first_number.id,
																				) == 2
																				and value_number(
																					first_string.id,
																				) == 3
																				and value_number(
																					first_argument,
																				) == 2
																				and yields_value(
																					first,
																					3,
																				)
																				and value_number(
																					second_number.id,
																				) == 4
																				and value_number(
																					second_string.id,
																				) == 5
																				and value_number(
																					second_argument,
																				) == 4
																				and yields_value(
																					second,
																					5,
																				)
																				and same_type(
																					first_string.value_type,
																					StringType,
																				)
																				and same_type(
																					second_string.value_type,
																					StringType,
																				)
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_string_alias_survives_a_replacement() -> Bool:
	source: String =
		|import:
		|	int: Int methods
		|	string: String methods
		|union Choice:
		|	First
		|	Second
		|pure func choose(choice: Choice) -> String:
		|	match choice:
		|		First:
		|			unused = 99.to_string()
		|			var current = 7.to_string()
		|			original = current
		|			current = 42.to_string()
		|			original
		|		Second: 42.to_string()
		|func main() -> Int:
		|	choose(First).length()
		|

	match fixture_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, choose, _, _]:
					match lowered_tail_join(choose):
						Some(matched):
							match matched.arms:
								[first, _]:
									match first.steps:
										[Define(_), Define(unused), Define(_), Define(original), Define(_), Define(replacement)]:
											(
												value_number(unused.id) == 3
												and value_number(original.id) == 5
												and value_number(replacement.id) == 7
												and yields_value(first, 5)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


