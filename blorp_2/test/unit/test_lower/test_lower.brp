pure func test_named_static_argument_is_erased_before_lowering() -> Bool:
	match fixture(NAMED_CALLBACK_SOURCE):
		Err(_): False
		Ok(program): static_argument_is_erased_before_lowering(lowered_functions(program).functions)


private pure func static_argument_is_erased_before_lowering(functions: List[LoweredFunction]) -> Bool:
	functions.any(pure func(function):
		match (function.signature.parameters, function.steps, function.result):
			([StringType], [Define(parameter), Define(result)], returned):
				match (parameter.operation, result.operation):
					(ParameterValue(0), CallValue(call, [argument])):
						(
							value_number(parameter.id) == 0 and value_number(argument) == 0
							and value_number(returned) == value_number(result.id)
							and same_type(result.value_type, StringType)
							and calls_with_values(result, functions, 1, [0])
							and is_function(call, 1)
						)
					_: False
			_: False
	)


pure func test_lambda_string_parameter_is_dense_without_an_environment() -> Bool:
	match fixture(NONCAPTURING_CALLBACK_SOURCE):
		Err(_): False
		Ok(program):
			contents = lowered_functions(program)
			match contents.functions:
				[_, lambda, _]:
					match (lambda.signature.parameters, lambda.steps, lambda.result):
						([StringType], [Define(parameter)], returned):
							match parameter.operation:
								ParameterValue(0):
									(
										static_argument_is_erased_before_lowering(contents.functions)
										and contents.records.is_empty() and contents.unions.is_empty()
										and same_type(lambda.signature.return_type, StringType)
										and value_number(parameter.id) == 0 and value_number(returned) == 0
									)
								_: False
						_: False
				_: False


pure func test_loop_rebinds_prefix_and_batches_terminal_values() -> Bool:
	source =
		|union State:
		|	Stop
		|	Go
		|	Repeat
		|pure func identity(value: Int) -> Int:
		|	value
		|@tail_recursive pure func loop(state: State, left: Int, right: Int) -> Int:
		|	observed = identity(left)
		|	match state:
		|		Stop: observed
		|		Go: loop(Stop, right, left)
		|		Repeat: loop(Stop, left, left)
		|func main() -> Int:
		|	loop(Go, 1, 2)
		|
	match fixture(source):
		Err(_): False
		Ok(program):
			match lowered_functions(program).functions:
				[_, function, _]:
					match function.steps:
						[Define(state), Define(left), Define(right), Lower.Loop(loop)]:
							match (loop.headers, loop.body.steps, loop.body.tail):
								([state_h, left_h, right_h], [Define(observed)], Lower.MatchLoop(matched)):
									match (observed.operation, matched.arms):
										(CallValue(call, [operand]), [stopped, swapped, repeated]):
											match (stopped.body.tail, swapped.body.tail, repeated.body.tail):
												(Lower.ExitLoop(Lower.Break(output)), Lower.ExitLoop(Lower.Recur(swap, swap_span)), Lower.ExitLoop(Lower.Recur(duplicate, duplicate_span))):
													arm_shapes = match ((swapped.body.steps, repeated.body.steps), matched.selection.nodes):
														(([Define(swap_state)], [Define(duplicate_state)]), [Lower.EnterArm(repeated_edge), Lower.EnterArm(swapped_edge), Lower.TestVariant(_, go, go_yes, go_no), Lower.EnterArm(stopped_edge), Lower.TestVariant(_, stop, stop_yes, stop_no)]):
															match (swap_state.operation, duplicate_state.operation):
																(ConstructValue(first_stop, []), ConstructValue(second_stop, [])):
																	(value_number(swap_state.id) == 8 and value_number(duplicate_state.id) == 9
																	and same_type(swap_state.value_type, state.value_type) and same_type(duplicate_state.value_type, state.value_type)
																	and Concrete.variant_number(stop) == 0 and Concrete.variant_number(go) == 1
																	and Checked.match_arm_number(stopped_edge.arm) == Checked.match_arm_number(stopped.id)
																	and Checked.match_arm_number(swapped_edge.arm) == Checked.match_arm_number(swapped.id)
																	and Checked.match_arm_number(repeated_edge.arm) == Checked.match_arm_number(repeated.id)
																	and Checked.decision_node_number(go_yes) == 1 and Checked.decision_node_number(go_no) == 0
																	and Checked.decision_node_number(stop_yes) == 3 and Checked.decision_node_number(stop_no) == 2
																	and Checked.decision_node_number(matched.selection.entry) == 4
																	and stopped.inputs.is_empty() and swapped.inputs.is_empty() and repeated.inputs.is_empty()
																	and stopped_edge.arguments.is_empty() and swapped_edge.arguments.is_empty() and repeated_edge.arguments.is_empty()
																	and Concrete.variant_number(first_stop) == 0 and Concrete.variant_number(second_stop) == 0
																	and Concrete.union_number(Concrete.variant_owner(first_stop)) == 0 and Concrete.union_number(Concrete.variant_owner(second_stop)) == 0)
																_: False
														_: False
													(
														arm_shapes and value_number(state.id) == 0
														and value_number(left.id) == 1 and value_number(right.id) == 2
														and value_number(loop.result.id) == 3 and value_number(function.result) == 3
														and same_type(loop.result.value_type, IntType) and loop.carried.is_empty()
														and [state_h.initial, left_h.initial, right_h.initial].map(value_number) == [0, 1, 2]
														and [state_h.parameter.id, left_h.parameter.id, right_h.parameter.id].map(value_number) == [4, 5, 6]
														and same_type(state_h.parameter.value_type, state.value_type)
														and same_type(left_h.parameter.value_type, IntType) and same_type(right_h.parameter.value_type, IntType)
														and same_span(state_h.parameter.span, state.span) and same_span(left_h.parameter.span, left.span) and same_span(right_h.parameter.span, right.span)
														and loop.reads.map(value_number) == [0, 1, 2]
														and value_number(observed.id) == 7 and value_number(operand) == 5 and is_function(call, 2)
														and observed.span.start == 171 and observed.span.end == 179
														and output.span.start == 208 and output.span.end == 216
														and value_number(matched.selection.scrutinee) == 4 and value_number(output.value) == 7 and output.carried.is_empty()
														and stopped.body.steps.is_empty() and swap.map(value_number) == [8, 6, 5] and duplicate.map(value_number) == [9, 5, 5]
														and loop.result.span.start == 83 and loop.result.span.end == 98
														and swap_span.start == 223 and swap_span.end == 246
														and duplicate_span.start == 257 and duplicate_span.end == 279
													)
												_: False
										_: False
								_: False
						_: False
				_: False


pure func test_zero_header_loop_keeps_a_separate_primary_result() -> Bool:
	source =
		|@tail_recursive pure func spin() -> Int:
		|	spin()
		|func main() -> Int:
		|	spin()
		|
	match fixture(source):
		Err(_): False
		Ok(program):
			match lowered_functions(program).functions:
				[_, function]:
					match function.steps:
						[Lower.Loop(loop)]:
							match loop.body.tail:
								Lower.ExitLoop(Lower.Recur(arguments, span)):
									(loop.headers.is_empty() and loop.carried.is_empty() and loop.reads.is_empty()
									and loop.body.steps.is_empty() and arguments.is_empty()
									and value_number(loop.result.id) == 0 and value_number(function.result) == 0
									and same_type(loop.result.value_type, IntType) and span.start == 42 and span.end == 48)
								_: False
						_: False
				_: False

tests: TestSuite = {
	description = "Blorp 2 ordered value lowering",
	tests = [
		("lambda String parameter is dense with no environment layout", test_lambda_string_parameter_is_dense_without_an_environment),
		("named static callback is an ordinary one-data-argument lowered call", test_named_static_argument_is_erased_before_lowering),
		("loop headers rebind prefix and batch swap/duplicate edges", test_loop_rebinds_prefix_and_batches_terminal_values),
		("zero-header loop keeps a separate primary result", test_zero_header_loop_keeps_a_separate_primary_result),
		("empty call argument leaves the UFCS receiver intact", test_empty_call_argument_preserves_the_waiting_receiver),
		("scalar definition keeps exact identity type and span", test_scalar_definition_preserves_its_identity_type_and_span),
		("nested UFCS and next statement preserve every definition", test_nested_ufcs_arguments_and_next_statement_keep_exact_definitions),
		("arm String alias survives replacement", test_arm_string_alias_survives_a_replacement),
		(
			"String computations stay inside distinct arms",
			test_string_arm_computations_remain_branch_local,
		),
		(
			"managed self assignment creates no value",
			test_managed_self_assignment_creates_no_new_value,
		),
		("managed aliases share computed value", test_two_managed_aliases_share_the_computed_value),
		(
			"managed alias retains original value identity",
			test_managed_alias_uses_original_value_after_replacement,
		),
		(
			"block arm reassignment preserves payload alias",
			test_block_arm_reassignment_preserves_payload_alias,
		),
		(
			"arm reassignment preserves sibling outer value",
			test_arm_reassignment_does_not_change_sibling_outer_value,
		),
		(
			"arm unused calls remain ordered inside branch",
			test_arm_unused_calls_remain_ordered_inside_the_branch,
		),
		(
			"full width alias retains original value",
			test_full_width_alias_retains_the_original_value,
		),
		(
			"match calls stay in selected branches",
			test_match_calls_stay_inside_their_selected_branches,
		),
		(
			"reassignment preserves old alias and call result",
			test_reassignment_preserves_old_alias_and_call_result,
		),
		("self assignment aliases the same value", test_self_assignment_aliases_the_same_value),
		("unused calls remain in source order", test_unused_calls_remain_in_source_order),
		(
			"parameter initializer reads the original value",
			test_parameter_initializer_reads_the_original_value,
		),
		(
			"match branches share function allocator",
			test_match_branches_share_the_function_value_allocator,
		),
		(
			"constructor and call keep types and spans",
			test_constructor_and_call_keep_each_intermediate_type_and_span,
		),
		(
			"chain definitions keep the callee anchor of each call",
			test_chain_definitions_keep_the_callee_anchor_of_each_call,
		),
	]
}
