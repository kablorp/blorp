import:
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/lex/lex: lex
	../../../src/lower/lower as Lower:
		LoweredStep(Define, Join),
		JoinArm,
		LoweredProgram, LoweredFunction, ValueDefinition, ValueId,
		ValueOperation(
			ParameterValue, IntegerValue, CallValue, ConstructValue,
		),
		lower,
		lowered_functions,
		value_number,
	../../../src/namespace/builtins as Builtins: RuntimeOperation(StringLength)
	../../../src/specialize/specialize as Concrete:
		CallTarget(UserFunction, RuntimeFunction), FunctionInstanceId,
		TypeRef(IntType, StringType, UnionType),
		function_number,
		same_type,
		specialize,
	../../../src/utils/syntax: Diagnostic, same_span
	int as IntOps
	../../../src/check/model as Checked
	./selection_inputs: selected_field
	../managed_union_inputs: NAMED_CALLBACK_SOURCE, NONCAPTURING_CALLBACK_SOURCE, lowered_tail_join
	../input: check, parse, setup_diagnostic
	../module_input: ModuleInput, primitive_base, INTEGER_OPERATIONS, STRING_OPERATIONS, parse_modules_with_base
	test: TestSuite


private pure func returns_value(value: ValueId, expected: Int) -> Bool:
	value_number(value) == expected

private pure func yields_value(arm: JoinArm, expected: Int) -> Bool:
	match arm.exit:
		Lower.Yield(outputs): value_number(outputs.value) == expected
		Lower.TransferLoop(_, _): False


private pure func is_function(target: CallTarget, expected: Int) -> Bool:
	match target:
		UserFunction(id):
			function_number(id) == expected
		RuntimeFunction(_):
			False


private pure func is_string_length(functions: List[LoweredFunction], id: FunctionInstanceId) -> Bool:
	match functions.get(function_number(id)):
		Some(function):
			match (function.signature.parameters, function.steps, function.result):
				([StringType], [Define(parameter), Define(result)], returned):
					match result.operation:
						CallValue(call, [argument]):
							match call:
								RuntimeFunction(Builtins.StringLength):
									(
										same_type(function.signature.return_type, IntType)
										and value_number(argument) == value_number(parameter.id)
										and value_number(returned) == value_number(result.id)
									)
								_:
									False
						_:
							False
				_:
					False
		None:
			False


-- Minimal parsed/checked fixtures preserve the seals. Tests invoke and inspect
-- lowering itself; neither C emission nor the CLI participates in this oracle.
private pure func fixture(source: String) -> Result[LoweredProgram, Diagnostic]:
	lexed ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(lexed)
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialize(checked).and_then(pure func(program): lower(program))


private pure func definition_has_position(definition: ValueDefinition, expected: Int, start: Int, end: Int) -> Bool:
	(
		value_number(definition.id) == expected
		and same_type(definition.value_type, IntType)
		and definition.span.start == start
		and definition.span.end == end
		and same_source(definition.span.source, module_source(root_module_id()))
	)


private pure func calls_with_values(definition: ValueDefinition, functions: List[LoweredFunction], arity: Int, expected: List[Int]) -> Bool:
	match definition.operation:
		CallValue(call, arguments):
			match call:
				UserFunction(id):
					match functions.get(function_number(id)):
						Some(function):
							function.signature.parameters.length() == arity and arguments.map(value_number) == expected
						None:
							False
				RuntimeFunction(_):
					False
		_:
			False


pure func test_scalar_definition_preserves_its_identity_type_and_span() -> Bool:
	source: String =
		|func main() -> Int:
		|	42
		|
	match fixture(source):
		Err(_): False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.steps:
						[Define(literal)]:
							match literal.operation:
								IntegerValue(42):
									returned = returns_value(function.result, 0)
									definition_has_position(literal, 0, 21, 23) and returned
								_:
									False
						_:
							False
				_:
					False


pure func test_nested_ufcs_arguments_and_next_statement_keep_exact_definitions() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func combine(left: Int, right: Int) -> Int:
		|	right
		|func main() -> Int:
		|	result = identity(10).combine(identity(identity(20)))
		|	next = identity(30)
		|	result
		|
	match fixture(source):
		Err(_): False
		Ok(program):
			functions = lowered_functions(program).functions
			match functions:
				[function, _, _]:
					match function.steps:
						[Define(ten), Define(receiver), Define(twenty), Define(inner), Define(outer), Define(combined), Define(thirty), Define(following)]:
							first_literal = match ten.operation:
								IntegerValue(10): True
								_: False
							second_literal = match twenty.operation:
								IntegerValue(20): True
								_: False
							last_literal = match thirty.operation:
								IntegerValue(30): True
								_: False
							order = (
								definition_has_position(ten, 0, 141, 143)
								and definition_has_position(receiver, 1, 132, 140)
								and definition_has_position(twenty, 2, 171, 173)
								and definition_has_position(inner, 3, 162, 170)
								and definition_has_position(outer, 4, 153, 161)
								and definition_has_position(combined, 5, 145, 152)
								and definition_has_position(thirty, 6, 194, 196)
								and definition_has_position(following, 7, 185, 193)
							)
							arguments = (
								calls_with_values(receiver, functions, 1, [0])
								and calls_with_values(inner, functions, 1, [2])
								and calls_with_values(outer, functions, 1, [3])
								and calls_with_values(combined, functions, 2, [1, 4])
								and calls_with_values(following, functions, 1, [6])
							)
							returned = returns_value(function.result, 5)
							first_literal and second_literal and last_literal and order and arguments and returned
						_:
							False
				_:
					False


pure func test_empty_call_argument_preserves_the_waiting_receiver() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func combine(left: Int, right: Int) -> Int:
		|	right
		|pure func one() -> Int:
		|	1
		|func main() -> Int:
		|	identity(11).combine(one())
		|
	match fixture(source):
		Err(_): False
		Ok(program):
			functions = lowered_functions(program).functions
			match functions:
				[function, _, _, _]:
					match function.steps:
						[Define(literal), Define(receiver), Define(argument), Define(result)]:
							integer = match literal.operation:
								IntegerValue(11): True
								_: False
							returned = returns_value(function.result, 3)
							(
								integer and returned
								and calls_with_values(receiver, functions, 1, [0])
								and calls_with_values(argument, functions, 0, [])
								and calls_with_values(result, functions, 2, [1, 2])
								and definition_has_position(literal, 0, 159, 161)
								and definition_has_position(receiver, 1, 150, 158)
								and definition_has_position(argument, 2, 171, 174)
								and definition_has_position(result, 3, 163, 170)
							)
						_:
							False
				_:
					False


private pure func fixture_modules(inputs: List[ModuleInput]) -> Result[LoweredProgram, Diagnostic]:
	parsed ?= parse_modules_with_base(inputs, primitive_base())
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialize(checked).and_then(pure func(program): lower(program))


pure func test_reassignment_preserves_old_alias_and_call_result() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func preserve() -> Int:
		|	original = 1
		|	var current = original
		|	current = identity(42)
		|	original
		|func main() -> Int:
		|	preserve()
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, preserve, _]:
					match preserve.steps:
						[Define(original), Define(replacement), Define(call)]:
							match original.operation:
								IntegerValue(1):
									match replacement.operation:
										IntegerValue(42):
											match call.operation:
												CallValue(target, [argument]):
													id = preserve.result
													(
														value_number(original.id) == 0
														and value_number(
															replacement.id,
														) == 1
														and value_number(call.id) == 2
														and value_number(argument) == 1
														and value_number(id) == 0
														and is_function(target, 2)
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_self_assignment_aliases_the_same_value() -> Bool:
	source: String =
		|func main() -> Int:
		|	var value = 42
		|	value = value
		|	value
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.steps:
						[Define(value)]:
							id = function.result
							value_number(value.id) == 0 and value_number(id) == 0
						_:
							False
				_:
					False


pure func test_unused_calls_remain_in_source_order() -> Bool:
	source: String =
		|func first() -> Int:
		|	1
		|func second() -> Int:
		|	2
		|func main() -> Int:
		|	unused = first()
		|	var current = second()
		|	current = second()
		|	0
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function, _, _]:
					match function.steps:
						[Define(first), Define(second), Define(third), Define(result)]:
							match first.operation:
								CallValue(first, []):
									match second.operation:
										CallValue(second, []):
											match third.operation:
												CallValue(third, []):
													(
														is_function(first, 1)
														and is_function(second, 2)
														and is_function(third, 2)
														and value_number(result.id) == 3
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_parameter_initializer_reads_the_original_value() -> Bool:
	source: String =
		|pure func copy(input: Int) -> Int:
		|	var value = input
		|	old = value
		|	value = 42
		|	old
		|func main() -> Int:
		|	copy(1)
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, copy]:
					match copy.steps:
						[Define(parameter), Define(replacement)]:
							match parameter.operation:
								ParameterValue(_):
									id = copy.result
									(
										value_number(id) == 0
										and value_number(replacement.id) == 1
										and parameter.span.start == 15
										and parameter.span.end == 20
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_match_branches_share_the_function_value_allocator() -> Bool:
	source: String =
		|union Value:
		|	Empty
		|	Number(Int)
		|pure func unwrap(value: Value) -> Int:
		|	local = value
		|	match local:
		|		Empty: 0
		|		Number(payload): payload
		|func main() -> Int:
		|	unwrap(Number(0))
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, unwrap]:
					match unwrap.steps:
						[Define(parameter), Join(_)]:
							match lowered_tail_join(unwrap):
								Some(matched):
									match matched.arms:
										[first, second]:
											match first.steps:
												[Define(literal)]:
													match (second.steps, second.inputs):
														([], [projection]):
															match selected_field(matched.selection, second.id):
																Some(projected):
																	projection_source = projected.parent
																	edge_order = value_number(projected.parameter.id) == 2
																	(
																		value_number(
																			parameter.id,
																		) == 0 and edge_order
																		and value_number(
																			matched.selection.scrutinee,
																		) == 0
																		and value_number(
																			literal.id,
																		) == 3
																		and value_number(
																			projection.id,
																		) == 4
																		and value_number(
																			projection_source,
																		) == 0
																		and yields_value(
																			second,
																			4,
																		)
																	)
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_constructor_and_call_keep_each_intermediate_type_and_span() -> Bool:
	source: String =
		|union Value:
		|	Number(Int)
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Number(number): number
		|func main() -> Int:
		|	Number(42).unwrap()
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[main, _]:
					match main.steps:
						[Define(literal), Define(construction), Define(call)]:
							match construction.value_type:
								UnionType(_):
									match construction.operation:
										ConstructValue(_, [argument]):
											match call.operation:
												CallValue(_, [receiver]):
													(
														same_type(literal.value_type, IntType)
														and same_type(call.value_type, IntType)
														and value_number(argument) == 0
														and value_number(receiver) == 1
														and literal.span.start == 138
														and literal.span.end == 140
														and construction.span.start == 131
														and construction.span.end == 137
														and call.span.start == 142
														and call.span.end == 148
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_full_width_alias_retains_the_original_value() -> Bool:
	source: String =
		|func main() -> Int:
		|	var current = -9223372036854775808
		|	original = current
		|	current = 9223372036854775807
		|	original
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.steps:
						[Define(original), Define(replacement)]:
							match original.operation:
								IntegerValue(-9223372036854775808):
									match replacement.operation:
										IntegerValue(9223372036854775807):
											id = function.result
											(
												value_number(
													id,
												) == value_number(original.id)
												and value_number(
													replacement.id,
												) != value_number(original.id)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_match_calls_stay_inside_their_selected_branches() -> Bool:
	source: String =
		|union Value:
		|	Empty
		|	Number(Int)
		|func choose() -> Value:
		|	Number(42)
		|func empty_arm() -> Int:
		|	7
		|func selected(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	match choose():
		|		Empty: empty_arm()
		|		Number(captured): selected(captured)
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[main, _, _, _]:
					match main.steps:
						[Define(scrutinee), Join(_)]:
							match scrutinee.operation:
								CallValue(choose, []):
									match lowered_tail_join(main):
										Some(matched):
											match matched.arms:
												[empty, number]:
													match empty.steps:
														[Define(empty_value)]:
															match empty_value.operation:
																CallValue(empty_call, []):
																	match (number.inputs, number.steps):
																		([payload], [Define(selected_value)]):
																			match selected_value.operation:
																				CallValue(selected_call, [argument]):
																					(
																						is_function(
																							choose,
																							1,
																						)
																						and is_function(
																							empty_call,
																							2,
																						)
																						and is_function(
																							selected_call,
																							3,
																						)
																						and value_number(
																							argument,
																						) == value_number(
																							payload.id,
																						)
																						and yields_value(
																							number,
																							value_number(
																								selected_value.id,
																							),
																						)
																					)
																				_:
																					False
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_block_arm_reassignment_preserves_payload_alias() -> Bool:
	prefix =
		|union Value:
		|	Empty
		|	Number(Int)
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func inspect(value: Value) -> Int:
		|	match value:
		|		Empty: 0
		|		Number(payload):
		|			var current = payload
		|			original = current
		|			current = identity(

	match fixture(prefix + "42)\n\t\t\toriginal\nfunc main() -> Int:\n\tinspect(Number(7))\n"):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, inspect, _]:
					match inspect.steps:
						[Define(parameter), Join(_)]:
							match lowered_tail_join(inspect):
								Some(matched):
									match matched.arms:
										[_, number]:
											match (number.inputs, number.steps):
												([payload], [Define(replacement), Define(call)]):
													match selected_field(matched.selection, number.id):
														Some(projected):
															owner = projected.parent
															match replacement.operation:
																IntegerValue(42):
																	match call.operation:
																		CallValue(target, [argument]):
																			(
																				value_number(
																					owner,
																				) == value_number(
																					parameter.id,
																				)
																				and value_number(
																					payload.id,
																				) == 4
																				and value_number(
																					replacement.id,
																				) == 5
																				and value_number(
																					call.id,
																				) == 6
																				and value_number(
																					argument,
																				) == 5
																				and yields_value(
																					number,
																					4,
																				)
																				and is_function(
																					target,
																					2,
																				)
																				and same_type(
																					payload.value_type,
																					IntType,
																				)
																				and same_type(
																					replacement.value_type,
																					IntType,
																				)
																				and same_type(
																					call.value_type,
																					IntType,
																				)
																				and replacement.span.start == prefix.length()
																				and replacement.span.end == prefix.length() + 2
																				and call.span.start == prefix.length() - 9
																				and call.span.end == prefix.length() - 1
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_reassignment_does_not_change_sibling_outer_value() -> Bool:
	source: String =
		|union Value:
		|	Empty
		|	Number(Int)
		|pure func inspect(value: Value) -> Int:
		|	var current = 7
		|	match value:
		|		Empty:
		|			current = 42
		|			current
		|		Number(_):
		|			original = current
		|			current = 1
		|			original
		|func main() -> Int:
		|	inspect(Number(0))
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, inspect]:
					match inspect.steps:
						[Define(_), Define(original), Join(_)]:
							match lowered_tail_join(inspect):
								Some(matched):
									match matched.arms:
										[first, second]:
											match first.steps:
												[Define(first_replacement)]:
													match second.steps:
														[Define(second_replacement)]:
															(
																value_number(original.id) == 1
																and value_number(
																	first_replacement.id,
																) == 3
																and value_number(
																	second_replacement.id,
																) == 4
																and yields_value(
																	first,
																	3,
																)
																and yields_value(
																	second,
																	1,
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_arm_unused_calls_remain_ordered_inside_the_branch() -> Bool:
	source: String =
		|union Value:
		|	Empty
		|	Number(Int)
		|func first() -> Int:
		|	1
		|func second() -> Int:
		|	2
		|func inspect(value: Value) -> Int:
		|	match value:
		|		Empty:
		|			unused = first()
		|			var current = second()
		|			current = first()
		|			current
		|		Number(payload): payload
		|func main() -> Int:
		|	inspect(Empty)
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, inspect, _, _]:
					match inspect.steps:
						[Define(parameter), Join(_)]:
							match lowered_tail_join(inspect):
								Some(matched):
									match matched.arms:
										[empty, number]:
											match empty.steps:
												[Define(first), Define(second), Define(third)]:
													match first.operation:
														CallValue(first_call, []):
															match second.operation:
																CallValue(second_call, []):
																	match third.operation:
																		CallValue(third_call, []):
																			(
																				is_function(
																					first_call,
																					2,
																				)
																				and is_function(
																					second_call,
																					3,
																				)
																				and is_function(
																					third_call,
																					2,
																				)
																				and value_number(
																					parameter.id,
																				) == 0
																				and value_number(
																					first.id,
																				) == 3
																				and value_number(
																					second.id,
																				) == 4
																				and value_number(
																					third.id,
																				) == 5
																				and yields_value(
																					empty,
																					5,
																				)
																				and number.steps.is_empty() and number.inputs.length() == 1
																				and yields_value(
																					number,
																					6,
																				)
																			)
																		_:
																			False
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_managed_alias_uses_original_value_after_replacement() -> Bool:
	source: String =
		|import:
		|	int: Int methods
		|	string: String methods
		|func main() -> Int:
		|	var current = 7.to_string()
		|	original = current
		|	current = 42.to_string()
		|	original.length()
		|

	match fixture_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	]):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[function, _, _]:
					match function.steps:
						[Define(_), Define(original), Define(_), Define(replacement), Define(length)]:
							match length.operation:
								CallValue(call, [argument]):
									match call:
										UserFunction(id):
											(
												is_string_length(lowered_functions(program).functions, id)
												and same_type(original.value_type, StringType)
												and same_type(replacement.value_type, StringType)
												and value_number(
													argument,
												) == value_number(original.id)
												and value_number(
													argument,
												) != value_number(replacement.id)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


