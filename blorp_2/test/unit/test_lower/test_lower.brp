import:
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/lex/lex: lex
	../../../src/lower/lower:
		LoweredStep(Define),
		LoweredExit(ReturnValue),
		LoweredProgram, LoweredFunction, ValueDefinition,
		LoweredTail(ExitValue, MatchValue),
		ValueOperation(
			ParameterValue, IntegerValue, CallValue, ConstructValue, PayloadValue,
		),
		lower,
		lowered_functions,
		value_number,
	../../../src/namespace/builtins as Builtins: RuntimeOperation(StringLength)
	../../../src/specialize/specialize:
		CallTarget(UserFunction, RuntimeFunction), FunctionInstanceId,
		TypeRef(IntType, StringType, UnionType),
		function_number,
		same_type,
		specialize,
	../../../src/utils/syntax: Diagnostic
	int as IntOps
	../managed_union_inputs: NAMED_CALLBACK_SOURCE
	../input: check, parse, setup_diagnostic
	../module_input: ModuleInput, PRIMITIVE_BASE, INTEGER_OPERATIONS, STRING_OPERATIONS, parse_modules_with_base
	test: TestSuite


private pure func returns_value(exit: LoweredExit, expected: Int) -> Bool:
	match exit:
		ReturnValue(id):
			value_number(id) == expected
		_:
			False


private pure func is_function(target: CallTarget, expected: Int) -> Bool:
	match target:
		UserFunction(id):
			function_number(id) == expected
		RuntimeFunction(_):
			False


private pure func is_string_length(functions: List[LoweredFunction], id: FunctionInstanceId) -> Bool:
	match functions.get(function_number(id)):
		Some(function):
			match (function.signature.parameters, function.steps, function.tail):
				([StringType], [Define(parameter), Define(result)], ExitValue(ReturnValue(returned))):
					match result.operation:
						CallValue(call, [argument]):
							match call.target:
								RuntimeFunction(Builtins.StringLength):
									(
										same_type(function.signature.return_type, IntType)
										and value_number(argument) == value_number(parameter.id)
										and value_number(returned) == value_number(result.id)
									)
								_:
									False
						_:
							False
				_:
					False
		None:
			False


-- Minimal parsed/checked fixtures preserve the seals. Tests invoke and inspect
-- lowering itself; neither C emission nor the CLI participates in this oracle.
private pure func fixture(source: String) -> Result[LoweredProgram, Diagnostic]:
	lexed ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(lexed)
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialize(checked).and_then(pure func(program): lower(program))


private pure func definition_has_position(definition: ValueDefinition, expected: Int, start: Int, end: Int) -> Bool:
	(
		value_number(definition.id) == expected
		and same_type(definition.value_type, IntType)
		and definition.span.start == start
		and definition.span.end == end
		and same_source(definition.span.source, module_source(root_module_id()))
	)


private pure func calls_with_values(definition: ValueDefinition, functions: List[LoweredFunction], arity: Int, expected: List[Int]) -> Bool:
	match definition.operation:
		CallValue(call, arguments):
			match call.target:
				UserFunction(id):
					match functions.get(function_number(id)):
						Some(function):
							function.signature.parameters.length() == arity and arguments.map(value_number) == expected
						None:
							False
				RuntimeFunction(_):
					False
		_:
			False


pure func test_scalar_definition_preserves_its_identity_type_and_span() -> Bool:
	source: String =
		|func main() -> Int:
		|	42
		|
	match fixture(source):
		Err(_): False
		Ok(program):
			match lowered_functions(program).functions:
				[function]:
					match function.steps:
						[Define(literal)]:
							match literal.operation:
								IntegerValue(42):
									returned = match function.tail:
										ExitValue(exit): returns_value(exit, 0)
										MatchValue(_): False
									definition_has_position(literal, 0, 21, 23) and returned
								_:
									False
						_:
							False
				_:
					False


pure func test_nested_ufcs_arguments_and_next_statement_keep_exact_definitions() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func combine(left: Int, right: Int) -> Int:
		|	right
		|func main() -> Int:
		|	result = identity(10).combine(identity(identity(20)))
		|	next = identity(30)
		|	result
		|
	match fixture(source):
		Err(_): False
		Ok(program):
			functions = lowered_functions(program).functions
			match functions:
				[function, _, _]:
					match function.steps:
						[Define(ten), Define(receiver), Define(twenty), Define(inner), Define(outer), Define(combined), Define(thirty), Define(following)]:
							first_literal = match ten.operation:
								IntegerValue(10): True
								_: False
							second_literal = match twenty.operation:
								IntegerValue(20): True
								_: False
							last_literal = match thirty.operation:
								IntegerValue(30): True
								_: False
							order = (
								definition_has_position(ten, 0, 141, 143)
								and definition_has_position(receiver, 1, 132, 140)
								and definition_has_position(twenty, 2, 171, 173)
								and definition_has_position(inner, 3, 162, 170)
								and definition_has_position(outer, 4, 153, 161)
								and definition_has_position(combined, 5, 145, 152)
								and definition_has_position(thirty, 6, 194, 196)
								and definition_has_position(following, 7, 185, 193)
							)
							arguments = (
								calls_with_values(receiver, functions, 1, [0])
								and calls_with_values(inner, functions, 1, [2])
								and calls_with_values(outer, functions, 1, [3])
								and calls_with_values(combined, functions, 2, [1, 4])
								and calls_with_values(following, functions, 1, [6])
							)
							returned = match function.tail:
								ExitValue(exit): returns_value(exit, 5)
								MatchValue(_): False
							first_literal and second_literal and last_literal and order and arguments and returned
						_:
							False
				_:
					False


pure func test_empty_call_argument_preserves_the_waiting_receiver() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func combine(left: Int, right: Int) -> Int:
		|	right
		|pure func one() -> Int:
		|	1
		|func main() -> Int:
		|	identity(11).combine(one())
		|
	match fixture(source):
		Err(_): False
		Ok(program):
			functions = lowered_functions(program).functions
			match functions:
				[function, _, _, _]:
					match function.steps:
						[Define(literal), Define(receiver), Define(argument), Define(result)]:
							integer = match literal.operation:
								IntegerValue(11): True
								_: False
							returned = match function.tail:
								ExitValue(exit): returns_value(exit, 3)
								MatchValue(_): False
							(
								integer and returned
								and calls_with_values(receiver, functions, 1, [0])
								and calls_with_values(argument, functions, 0, [])
								and calls_with_values(result, functions, 2, [1, 2])
								and definition_has_position(literal, 0, 159, 161)
								and definition_has_position(receiver, 1, 150, 158)
								and definition_has_position(argument, 2, 171, 174)
								and definition_has_position(result, 3, 163, 170)
							)
						_:
							False
				_:
					False


private pure func fixture_modules(inputs: List[ModuleInput]) -> Result[LoweredProgram, Diagnostic]:
	parsed ?= parse_modules_with_base(inputs, PRIMITIVE_BASE)
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialize(checked).and_then(pure func(program): lower(program))


pure func test_reassignment_preserves_old_alias_and_call_result() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func preserve() -> Int:
		|	original = 1
		|	var current = original
		|	current = identity(42)
		|	original
		|func main() -> Int:
		|	preserve()
		|

	match fixture(source):
		Err(_):
			False
		Ok(program):
			match lowered_functions(program).functions:
				[_, preserve, _]:
					match preserve.steps:
						[Define(original), Define(replacement), Define(call)]:
							match original.operation:
								IntegerValue(1):
									match replacement.operation:
										IntegerValue(42):
											match call.operation:
												CallValue(target, [argument]):
													match preserve.tail:
														ExitValue(ReturnValue(id)):
															(
																value_number(original.id) == 0
																and value_number(
																	replacement.id,
																) == 1
																and value_number(call.id) == 2
																and value_number(argument) == 1
																and value_number(id) == 0
																and is_function(target.target, 2)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_self_assignment_aliases_the_same_value() -> Bool:
	source: String =
		|func main() -> Int:
		|	var value = 42
		|	value = value
		|	value
		|

