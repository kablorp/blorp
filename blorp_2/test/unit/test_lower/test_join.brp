import:
	../../../src/lower/lower as Lower:
		JoinArm,
		LoweredFunction,
		LoweredJoin,
		LoweredStep(Define, Join, Loop),
		ValueOperation(ParameterValue, StringValue),
		lowered_functions,
		value_number,
	../../../src/specialize/specialize as Concrete
	./selection_inputs: selected_field
	../managed_union_inputs: lowered, lowered_tail_join
	test: TestSuite


private SHAPE: String =
	|union Shape:
	|	Circle(Int)
	|	Square(Int)
	|


-- The first lowered function that defines a join, with that join.
private fixed record FoundJoin {
	function: LoweredFunction,
	position: Int,
	join: LoweredJoin
}


private pure func first_join(source: String) -> Option[FoundJoin]:
	match lowered(source):
		Err(_):
			None
		Ok(program):
			var found: Option[FoundJoin] = None
			for function in lowered_functions(program).functions:
				var position = 0
				for step in function.steps:
					match step:
						Join(join):
							if found.is_none():
								found = Some({ function = function, position = position, join = join })
						Define(_) | Loop(_):
							void
					position = position + 1
			found


private pure func ids(steps: List[LoweredStep]) -> List[Int]:
	var values: List[Int] = []
	for step in steps:
		match step:
			Define(definition): values = values.append(value_number(definition.id))
			Join(join):
				values = values.append(value_number(join.result.id))
				for parameter in join.carried:
					values = values.append(value_number(parameter.id))
			Loop(loop):
				values = values.append(value_number(loop.result.id))
				for parameter in loop.carried:
					values = values.append(value_number(parameter.id))
	values


private pure func yields(arm: JoinArm) -> Option[Int]:
	match arm.exit:
		Lower.Yield(outputs): Some(value_number(outputs.value))
		Lower.TransferLoop(_, _): None


private pure func projects(join: LoweredJoin, arm: JoinArm, expected_edge: Int) -> Bool:
	match (selected_field(join.selection, arm.id), arm.inputs, arm.exit):
		(Some(projected), [input], Lower.Yield(outputs)):
			value_number(projected.parent) == 0 and value_number(projected.parameter.id) == expected_edge and arm.steps.is_empty() and value_number(outputs.value) == value_number(input.id)
		_: False


-- The join's own value keeps its place in the block, whose values stay one
-- interval; edge values follow it, then canonical arm inputs and bodies.
pure func test_bound_match_lowers_to_a_join_numbered_after_its_block() -> Bool:
	body: String =
		|pure func width(shape: Shape) -> Int:
		|	w = match shape:
		|		Circle(r): r
		|		Square(s): s
		|	w
		|func main() -> Int:
		|	width(Square(4))
		|

	source = SHAPE + body
	match first_join(source):
		None:
			False
		Some(found):
			returned = value_number(found.function.result)

			match found.join.arms:
				[first, second]:
					empty_yields = match (first.exit, second.exit):
						(Lower.Yield(first_yield), Lower.Yield(second_yield)): first_yield.carried.is_empty() and second_yield.carried.is_empty()
						_: False
					(
						ids(found.function.steps) == [0, 1]
						and found.position == 1
						and found.join.carried.is_empty()
						and empty_yields
						and value_number(found.join.selection.scrutinee) == 0
						and returned == 1
						and ids(first.steps) == []
						and yields(first) == Some(4)
						and first.inputs.map(pure func(input): value_number(input.id)) == [4]
						and projects(found.join, first, 3)
						and ids(second.steps) == []
						and yields(second) == Some(5)
						and second.inputs.map(pure func(input): value_number(input.id)) == [5]
						and projects(found.join, second, 2)
					)
				_:
					False


-- A join inside an arm numbers its own arms after that arm's interval, and
-- the next arm of the outer join follows the nested join's arms.
pure func test_nested_join_arms_follow_their_enclosing_arm() -> Bool:
	body: String =
		|pure func width(shape: Shape) -> Int:
		|	w = match shape:
		|		Circle(r):
		|			inner = match shape:
		|				Circle(_): r
		|				Square(s): s
		|			inner
		|		Square(s): s
		|	w
		|func main() -> Int:
		|	width(Square(4))
		|

	source = SHAPE + body
	match first_join(source):
		None:
			False
		Some(found):
			match found.join.arms:
				[first, second]:
					nested = match first.steps:
						[Join(join)]:
							match join.arms:
								[left, right]:
									(
										value_number(join.result.id) == 5
										and yields(first) == Some(5)
										and ids(left.steps) == []
										and yields(left) == Some(4)
										and ids(right.steps) == []
										and yields(right) == Some(7) and right.inputs.map(pure func(input): value_number(input.id)) == [7]
									)
								_:
									False
						_:
							False

					ids(first.steps) == [5] and first.inputs.map(pure func(input): value_number(input.id)) == [4] and nested and ids(second.steps) == [] and yields(second) == Some(8)
				_:
					False


-- A join in a tail match's prefix precedes the tail arms' values.
pure func test_prefix_join_arms_precede_tail_arms() -> Bool:
	body: String =
		|pure func width(shape: Shape) -> Int:
		|	w = match shape:
		|		Circle(r): r
		|		Square(s): s
		|	match shape:
		|		Circle(_): w
		|		Square(s): s
		|func main() -> Int:
		|	width(Square(4))
		|

	source = SHAPE + body
	match first_join(source):
		None:
			False
		Some(found):
			match lowered_tail_join(found.function):
				Some(matched):
					match matched.arms:
						[first, second]:
							(
								ids(found.function.steps) == [0, 1, 2]
								and ids(first.steps) == []
								and ids(second.steps) == [] and second.inputs.map(pure func(input): value_number(input.id)) == [8]
							)
						_:
							False
				_:
					False


-- A statement match is a Void join whose value nothing reads.
pure func test_statement_match_is_a_void_join() -> Bool:
	source: String =
		|union Choice:
		|	Yes
		|	No
		|pure func choose(choice: Choice) -> Int:
		|	match choice:
		|		Yes:
		|			kept = "yes"
		|		No: void
		|	0
		|func main() -> Int:
		|	choose(Yes)
		|
	match first_join(source):
		None:
			False
		Some(found):
			match found.join.arms:
				[first, second]:
					stored = match first.steps:
						[Define(text), Define(unit)]:
							match text.operation:
								StringValue(bytes): bytes == "yes" and yields(first) == Some(value_number(unit.id))
								_: False
						_:
							False

					found.position == 1 and stored and second.steps.length() == 1
				_:
					False


pure func test_statement_join_publishes_the_new_binding_version_and_unchanged_edge() -> Bool:
	source: String =
		|union Choice:
		|    Yes
		|    No
		|pure func choose(flag: Choice) -> Int:
		|    var total = 1
		|    match flag:
		|        Yes: total = 7
		|        No: void
		|    total
		|func main() -> Int:
		|    choose(Yes)
		|
	match first_join(source):
		None: False
		Some(found):
			match (found.join.carried, found.join.arms, found.function.result):
				([total], [changed, unchanged], returned):
					match (changed.exit, unchanged.exit):
						(Lower.Yield(changed_yield), Lower.Yield(unchanged_yield)):
							(
								found.function.steps.length() == 3
								and ids(found.function.steps) == [0, 1, 2, 3]
								and value_number(found.join.result.id) == 2
								and Concrete.same_type(found.join.result.value_type, Concrete.VoidType)
								and value_number(total.id) == 3
								and Concrete.same_type(total.value_type, Concrete.IntType)
								and value_number(returned) == 3
								and found.join.reads.map(value_number) == [0, 1]
								and ids(changed.steps) == [4, 5] and value_number(changed_yield.value) == 5
								and changed_yield.carried.map(value_number) == [4]
								and ids(unchanged.steps) == [6] and value_number(unchanged_yield.value) == 6
								and unchanged_yield.carried.map(value_number) == [1]
							)
						_: False
				_: False


pure func test_same_type_carriers_keep_binding_order_despite_reversed_writes() -> Bool:
	source: String =
		|union Choice:
		|    Yes
		|    No
		|pure func choose(choice: Choice) -> Int:
		|    var left = 11
		|    var right = 22
		|    match choice:
		|        Yes:
		|            right = 202
		|            left = 101
		|        No: void
		|    left
		|func main() -> Int:
		|    choose(Yes)
		|
	match first_join(source):
		None: False
		Some(found):
			match found.join.arms:
				[changed, unchanged]:
					match (changed.exit, unchanged.exit):
						(Lower.Yield(changed_yield), Lower.Yield(unchanged_yield)):
							(
								ids(found.function.steps) == [0, 1, 2, 3, 4, 5]
								and found.join.carried.map(pure func(parameter): value_number(parameter.id)) == [4, 5]
								and changed_yield.carried.map(value_number) == [7, 6]
								and unchanged_yield.carried.map(value_number) == [1, 2]
								and found.join.reads.map(value_number) == [0, 1, 2]
							)
						_: False
				_: False


pure func test_assignment_target_overrides_its_rhs_join_updated_version() -> Bool:
	source: String =
		|union Choice:
		|    Yes
		|    No
		|pure func choose(choice: Choice) -> Int:
		|    var total = 1
		|    total = match choice:
		|        Yes:
		|            total = 7
		|            9
		|        No: 3
		|    total
		|func main() -> Int:
		|    choose(Yes)
		|
	match first_join(source):
		None: False
		Some(found):
			match (found.function.result, found.join.arms):
				(returned, [changed, unchanged]):
					match (changed.exit, unchanged.exit):
						(Lower.Yield(changed_yield), Lower.Yield(unchanged_yield)):
							(
								value_number(returned) == 2
								and value_number(found.join.result.id) == 2
								and found.join.carried.map(pure func(parameter): value_number(parameter.id)) == [3]
								and value_number(changed_yield.value) == 5 and changed_yield.carried.map(value_number) == [4]
								and value_number(unchanged_yield.value) == 6 and unchanged_yield.carried.map(value_number) == [1]
							)
						_: False
				_: False


pure func test_final_nested_join_updates_the_outer_arm_carrier() -> Bool:
	source: String =
		|union Choice:
		|    Yes
		|    No
		|pure func choose(outer: Choice, inner: Choice) -> Int:
		|    var total = 1
		|    match outer:
		|        Yes: match inner:
		|            Yes: total = 7
		|            No: void
		|        No: void
		|    total
		|func main() -> Int:
		|    choose(Yes, Yes)
		|
	match first_join(source):
		None: False
		Some(found):
			match (found.join.arms, found.function.result):
				([changed, unchanged], returned):
					match (changed.exit, unchanged.exit):
						(Lower.Yield(changed_yield), Lower.Yield(unchanged_yield)):
							match changed.steps:
								[Join(inner)]:
									(
										value_number(returned) == 4 and value_number(found.join.result.id) == 3
										and found.join.carried.map(pure func(parameter): value_number(parameter.id)) == [4]
										and ids(changed.steps) == [5, 6]
										and changed_yield.carried.map(value_number) == [6]
										and unchanged_yield.carried.map(value_number) == [2]
										and inner.carried.map(pure func(parameter): value_number(parameter.id)) == [6]
										and found.join.reads.map(value_number) == [0, 1, 2, 2]
									)
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Joins lowered from bound and statement matches",
	tests = [
		("same-type carriers preserve binding order", test_same_type_carriers_keep_binding_order_despite_reversed_writes),
		("assignment target overrides the RHS join map", test_assignment_target_overrides_its_rhs_join_updated_version),
		("final nested join updates its outer carrier", test_final_nested_join_updates_the_outer_arm_carrier),
		("statement join publishes versions and its unchanged edge", test_statement_join_publishes_the_new_binding_version_and_unchanged_edge),
		("bound match numbers its arms after the block", test_bound_match_lowers_to_a_join_numbered_after_its_block),
		("nested join arms follow their enclosing arm", test_nested_join_arms_follow_their_enclosing_arm),
		("prefix join arms precede tail arms", test_prefix_join_arms_precede_tail_arms),
		("statement match is a Void join", test_statement_match_is_a_void_join),
	]
}
