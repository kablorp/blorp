import:
	../../../src/lower/lower:
		JoinArm,
		LoweredExit(ReturnValue),
		LoweredFunction,
		LoweredJoin,
		LoweredTail(ExitValue, MatchValue),
		LoweredStep(Define, Join),
		ValueOperation(ParameterValue, PayloadValue, StringValue),
		lowered_functions,
		value_number,
	../../../src/specialize/specialize as Concrete
	../managed_union_inputs: lowered
	test: TestSuite


private SHAPE: String =
	|fixed union Shape:
	|	Circle(Int)
	|	Square(Int)
	|


-- The first lowered function that defines a join, with that join.
private fixed record FoundJoin {
	function: LoweredFunction,
	position: Int,
	join: LoweredJoin
}


private pure func first_join(source: String) -> Option[FoundJoin]:
	match lowered(source):
		Err(_):
			None
		Ok(program):
			var found: Option[FoundJoin] = None
			for function in lowered_functions(program).functions:
				var position = 0
				for step in function.steps:
					match step:
						Join(join):
							if found.is_none():
								found = Some({ function = function, position = position, join = join })
						_:
							void
					position = position + 1
			found


private pure func ids(steps: List[LoweredStep]) -> List[Int]:
	var values: List[Int] = []
	for step in steps:
		match step:
			Define(definition): values = values.append(value_number(definition.id))
			Join(join):
				values = values.append(value_number(join.result.id))
				for parameter in join.carried:
					values = values.append(value_number(parameter.id))
	values


private pure func yields(arm: JoinArm) -> Int:
	value_number(arm.value)


private pure func projects(arm: JoinArm) -> Bool:
	match arm.steps:
		[Define(definition)]:
			match definition.operation:
				PayloadValue(_, scrutinee):
					value_number(scrutinee) == 0
				_:
					False
		_:
			False


-- The join's own value keeps its place in the block, whose values stay one
-- interval; each arm's values follow the whole block, in arm order.
pure func test_bound_match_lowers_to_a_join_numbered_after_its_block() -> Bool:
	body: String =
		|pure func width(shape: Shape) -> Int:
		|	w = match shape:
		|		Circle(r): r
		|		Square(s): s
		|	w
		|func main() -> Int:
		|	width(Square(4))
		|

	source = SHAPE + body
	match first_join(source):
		None:
			False
		Some(found):
			returned = match found.function.tail:
				ExitValue(ReturnValue(value)):
					value_number(value)
				_:
					-1

			match found.join.arms:
				[first, second]:
					(
						ids(found.function.steps) == [0, 1]
						and found.position == 1
						and found.join.carried.is_empty() and first.carried.is_empty() and second.carried.is_empty()
						and value_number(found.join.scrutinee) == 0
						and returned == 1
						and ids(first.steps) == [2]
						and yields(first) == 2
						and projects(first)
						and ids(second.steps) == [3]
						and yields(second) == 3
						and projects(second)
					)
				_:
					False


-- A join inside an arm numbers its own arms after that arm's interval, and
-- the next arm of the outer join follows the nested join's arms.
pure func test_nested_join_arms_follow_their_enclosing_arm() -> Bool:
	body: String =
		|pure func width(shape: Shape) -> Int:
		|	w = match shape:
		|		Circle(r):
		|			inner = match shape:
		|				Circle(_): r
		|				Square(s): s
		|			inner
		|		Square(s): s
		|	w
		|func main() -> Int:
		|	width(Square(4))
		|

	source = SHAPE + body
	match first_join(source):
		None:
			False
		Some(found):
			match found.join.arms:
				[first, second]:
					nested = match first.steps:
						[Define(_), Join(join)]:
							match join.arms:
								[left, right]:
									(
										value_number(join.result.id) == 3
										and yields(first) == 3
										and ids(left.steps) == []
										and yields(left) == 2
										and ids(right.steps) == [4]
										and yields(right) == 4
									)
								_:
									False
						_:
							False

					ids(first.steps) == [2, 3] and nested and ids(second.steps) == [5]
				_:
					False


-- A join in a tail match's prefix precedes the tail arms' values.
pure func test_prefix_join_arms_precede_tail_arms() -> Bool:
	body: String =
		|pure func width(shape: Shape) -> Int:
		|	w = match shape:
		|		Circle(r): r
		|		Square(s): s
		|	match shape:
		|		Circle(_): w
		|		Square(s): s
		|func main() -> Int:
		|	width(Square(4))
		|

	source = SHAPE + body
	match first_join(source):
		None:
			False
		Some(found):
			match found.function.tail:
				MatchValue(matched):
					match matched.arms:
						[first, second]:
							(
								ids(found.function.steps) == [0, 1]
								and ids(first.body.steps) == []
								and ids(second.body.steps) == [4]
							)
						_:
							False
				_:
					False


-- A statement match is a Void join whose value nothing reads.
pure func test_statement_match_is_a_void_join() -> Bool:
	source: String =
		|fixed union Choice:
		|	Yes
		|	No
		|pure func choose(choice: Choice) -> Int:
		|	match choice:
		|		Yes:
		|			kept = "yes"
		|		No: void
		|	0
		|func main() -> Int:
		|	choose(Yes)
		|
	match first_join(source):
		None:
			False
		Some(found):
			match found.join.arms:
				[first, second]:
					stored = match first.steps:
						[Define(text), Define(unit)]:
							match text.operation:
								StringValue(bytes): bytes == "yes" and yields(first) == value_number(unit.id)
								_: False
						_:
							False

					found.position == 1 and stored and second.steps.length() == 1
				_:
					False


pure func test_statement_join_publishes_the_new_binding_version_and_unchanged_edge() -> Bool:
	source: String =
		|fixed union Choice:
		|    Yes
		|    No
		|pure func choose(flag: Choice) -> Int:
		|    var total = 1
		|    match flag:
		|        Yes: total = 7
		|        No: void
		|    total
		|func main() -> Int:
		|    choose(Yes)
		|
	match first_join(source):
		None: False
		Some(found):
			match (found.join.carried, found.join.arms, found.function.tail):
				([total], [changed, unchanged], ExitValue(ReturnValue(returned))):
					(
						found.function.steps.length() == 3
						and ids(found.function.steps) == [0, 1, 2, 3]
						and value_number(found.join.result.id) == 2
						and Concrete.same_type(found.join.result.value_type, Concrete.VoidType)
						and value_number(total.id) == 3
						and Concrete.same_type(total.value_type, Concrete.IntType)
						and value_number(returned) == 3
						and found.join.reads.map(value_number) == [0, 1]
						and ids(changed.steps) == [4, 5] and value_number(changed.value) == 5
						and changed.carried.map(value_number) == [4]
						and ids(unchanged.steps) == [6] and value_number(unchanged.value) == 6
						and unchanged.carried.map(value_number) == [1]
					)
				_: False


pure func test_same_type_carriers_keep_binding_order_despite_reversed_writes() -> Bool:
	source: String =
		|fixed union Choice:
		|    Yes
		|    No
		|pure func choose(choice: Choice) -> Int:
		|    var left = 11
		|    var right = 22
		|    match choice:
		|        Yes:
		|            right = 202
		|            left = 101
		|        No: void
		|    left
		|func main() -> Int:
		|    choose(Yes)
		|
	match first_join(source):
		None: False
		Some(found):
			match found.join.arms:
				[changed, unchanged]:
					(
						ids(found.function.steps) == [0, 1, 2, 3, 4, 5]
						and found.join.carried.map(pure func(parameter): value_number(parameter.id)) == [4, 5]
						and changed.carried.map(value_number) == [7, 6]
						and unchanged.carried.map(value_number) == [1, 2]
						and found.join.reads.map(value_number) == [0, 1, 2]
					)
				_: False


pure func test_assignment_target_overrides_its_rhs_join_updated_version() -> Bool:
	source: String =
		|fixed union Choice:
		|    Yes
		|    No
		|pure func choose(choice: Choice) -> Int:
		|    var total = 1
		|    total = match choice:
		|        Yes:
		|            total = 7
		|            9
		|        No: 3
		|    total
		|func main() -> Int:
		|    choose(Yes)
		|
	match first_join(source):
		None: False
		Some(found):
			match (found.function.tail, found.join.arms):
				(ExitValue(ReturnValue(returned)), [changed, unchanged]):
					(
						value_number(returned) == 2
						and value_number(found.join.result.id) == 2
						and found.join.carried.map(pure func(parameter): value_number(parameter.id)) == [3]
						and value_number(changed.value) == 5 and changed.carried.map(value_number) == [4]
						and value_number(unchanged.value) == 6 and unchanged.carried.map(value_number) == [1]
					)
				_: False


pure func test_final_nested_join_updates_the_outer_arm_carrier() -> Bool:
	source: String =
		|fixed union Choice:
		|    Yes
		|    No
		|pure func choose(outer: Choice, inner: Choice) -> Int:
		|    var total = 1
		|    match outer:
		|        Yes: match inner:
		|            Yes: total = 7
		|            No: void
		|        No: void
		|    total
		|func main() -> Int:
		|    choose(Yes, Yes)
		|
	match first_join(source):
		None: False
		Some(found):
			match (found.join.arms, found.function.tail):
				([changed, unchanged], ExitValue(ReturnValue(returned))):
					match changed.steps:
						[Join(inner)]:
							(
								value_number(returned) == 4 and value_number(found.join.result.id) == 3
								and found.join.carried.map(pure func(parameter): value_number(parameter.id)) == [4]
								and ids(changed.steps) == [5, 6]
								and changed.carried.map(value_number) == [6]
								and unchanged.carried.map(value_number) == [2]
								and inner.carried.map(pure func(parameter): value_number(parameter.id)) == [6]
								and found.join.reads.map(value_number) == [0, 1, 2, 2]
							)
						_: False
				_: False


tests: TestSuite = {
	description = "Joins lowered from bound and statement matches",
	tests = [
		("same-type carriers preserve binding order", test_same_type_carriers_keep_binding_order_despite_reversed_writes),
		("assignment target overrides the RHS join map", test_assignment_target_overrides_its_rhs_join_updated_version),
		("final nested join updates its outer carrier", test_final_nested_join_updates_the_outer_arm_carrier),
		("statement join publishes versions and its unchanged edge", test_statement_join_publishes_the_new_binding_version_and_unchanged_edge),
		("bound match numbers its arms after the block", test_bound_match_lowers_to_a_join_numbered_after_its_block),
		("nested join arms follow their enclosing arm", test_nested_join_arms_follow_their_enclosing_arm),
		("prefix join arms precede tail arms", test_prefix_join_arms_precede_tail_arms),
		("statement match is a Void join", test_statement_match_is_a_void_join),
	]
}
