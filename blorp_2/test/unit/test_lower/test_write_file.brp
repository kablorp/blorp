import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../../../src/utils/source: same_source, module_source, root_module_id
	../file_write_inputs: file_write_seed
	../module_input: TEST_BASE
	test: TestSuite


private pure func preserves_query(query: Lower.LoweredFunction) -> Bool:
	label_start = "func query(path: String, contents: String) -> Result[Void, String]:\n    builtin(".length()
	label_end = label_start + "\"system.write_file\"".length()
	match query.definitions:
		[path, contents, result]:
			match (path.operation, contents.operation, result.operation, result.value_type):
				(Lower.ParameterValue(0), Lower.ParameterValue(1), Lower.CallValue(call, [first, second]), Concrete.UnionType(owner)):
					match call.target:
						Concrete.RuntimeFunction(Builtins.WriteFile(constructors)):
							(Lower.value_number(first) == Lower.value_number(path.id)
								and Lower.value_number(second) == Lower.value_number(contents.id)
								and Concrete.union_number(owner) == Concrete.union_number(Concrete.variant_owner(constructors.ok))
								and same_source(call.span.source, module_source(root_module_id()))
								and same_source(result.span.source, module_source(root_module_id()))
								and call.span.start == label_start and call.span.end == label_end
								and result.span.start == label_start and result.span.end == label_end)
						_: False
				_: False
		_: False


pure func test_write_file_lowering_keeps_both_arguments_and_span() -> Bool:
	match file_write_seed(TEST_BASE):
		Err(_): False
		Ok(seed): preserves_query(seed.query)


pure func test_equal_but_wrong_call_and_result_spans_reject() -> Bool:
	match file_write_seed(TEST_BASE):
		Err(_): False
		Ok(seed):
			match seed.query.definitions:
				[path, contents, result]:
					match result.operation:
						Lower.CallValue(call, arguments):
							shifted = { call.span | start = call.span.start + 1, end = call.span.end + 1 }
							changed = { result | span = shifted, operation = Lower.CallValue({ call | span = shifted }, arguments) }
							not preserves_query({ seed.query | definitions = [path, contents, changed] })
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 file-write lowering",
	tests = [
		("write_file preserves two operands and their literal source occurrence", test_write_file_lowering_keeps_both_arguments_and_span),
		("equal but shifted call and result spans reject", test_equal_but_wrong_call_and_result_spans_reject),
	]
}
