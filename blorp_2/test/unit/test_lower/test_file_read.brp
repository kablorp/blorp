import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../../../src/utils/source: same_source, module_source, root_module_id
	../file_read_inputs: file_read_seed
	../module_input: test_base
	test: TestSuite


pure func test_read_file_lowering_keeps_one_path_and_call_span() -> Bool:
	label_start = "func query(path: String) -> Result[String, String]:\n    builtin(".length()
	label_end = label_start + "\"system.read_file\"".length()
	match file_read_seed(test_base()):
		Err(_): False
		Ok(seed):
			match seed.query.steps:
				[Lower.Define(parameter), Lower.Define(result)]:
					match (parameter.operation, result.operation, result.value_type):
						(Lower.ParameterValue(0), Lower.CallValue(call, [path]), Concrete.UnionType(owner)):
							match call:
								Concrete.RuntimeFunction(Builtins.ReadFile(constructors)):
									(
										Lower.value_number(path) == Lower.value_number(parameter.id)
										and Concrete.union_number(owner) == Concrete.union_number(Concrete.variant_owner(constructors.ok))
										and same_source(result.span.source, module_source(root_module_id()))
										and result.span.start == label_start and result.span.end == label_end
									)
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 file-read lowering",
	tests = [("read_file preserves operand and source occurrence", test_read_file_lowering_keeps_one_path_and_call_span)]
}
