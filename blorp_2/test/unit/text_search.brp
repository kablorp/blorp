import:
	bool: Bool methods
	int: Int methods
	option: Option methods
	string: String methods


-- Match emitted bytes using the target library's existing byte API.
pure func occurrences(text: String, pattern: String) -> Int:
	var position: Int = 0
	var count: Int = 0
	while position.add(pattern.length()).less_than_or_equal(text.length()):
		var matches: Bool = True
		for index in 0..pattern.length():
			match (text.byte_at(position.add(index)), pattern.byte_at(index)):
				(Some(actual), Some(expected)): matches = matches.and(actual.equals(expected))
				_: matches = False
		if matches:
			count = count.add(1)
		position = position.add(1)
	count


pure func has_text(text: String, pattern: String) -> Bool:
	occurrences(text, pattern).greater_than(0)


-- The first position at or after `start` where `pattern` begins.
pure func find_text(text: String, pattern: String, start: Int) -> Option[Int]:
	var position: Int = start
	var found: Option[Int] = None
	while found.is_none().and(position.add(pattern.length()).less_than_or_equal(text.length())):
		match text.slice(position, position.add(pattern.length())):
			Some(window):
				if window == pattern:
					found = Some(position)
			None: void
		position = position.add(1)
	found


pure func ends_with(text: String, suffix: String) -> Bool:
	match text.slice(text.length().subtract(suffix.length()), text.length()):
		Some(tail): tail == suffix
		None: False
