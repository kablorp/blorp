import:
	bool: Bool methods
	int: Int methods
	option: Option methods
	string: String methods


-- Match emitted bytes using the target library's existing byte API.
pure func occurrences(text: String, pattern: String) -> Int:
	var position: Int = 0
	var count: Int = 0
	while position + (pattern.length()) <= (text.length()):
		var matches: Bool = True
		for index in 0..pattern.length():
			match (text.byte_at(position + index), pattern.byte_at(index)):
				(Some(actual), Some(expected)): matches = matches.and(actual.equals(expected))
				_: matches = False
		if matches:
			count = count + 1
		position = position + 1
	count


pure func has_text(text: String, pattern: String) -> Bool:
	occurrences(text, pattern) > 0


-- The first position at or after `start` where `pattern` begins.
pure func find_text(text: String, pattern: String, start: Int) -> Option[Int]:
	var position: Int = start
	var found: Option[Int] = None
	while found.is_none().and(position + (pattern.length()) <= (text.length())):
		match text.slice(position, position + (pattern.length())):
			Some(window):
				if window == pattern:
					found = Some(position)
			None: void
		position = position + 1
	found


pure func ends_with(text: String, suffix: String) -> Bool:
	match text.slice(text.length() - (suffix.length()), text.length()):
		Some(tail): tail == suffix
		None: False


-- `text` with its first `pattern` replaced; unchanged when `pattern` is absent,
-- which makes the test that expected a change fail.
pure func replace_first(text: String, pattern: String, replacement: String) -> String:
	match find_text(text, pattern, 0):
		None: text
		Some(start):
			head = text.slice(0, start).get_or("")
			tail = text.slice(start + (pattern.length()), text.length()).get_or("")
			head + replacement + tail
