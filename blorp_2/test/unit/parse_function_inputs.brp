import:
	../../src/utils/syntax: ParsedFunction, ParsedFunctionGroup(FreeFunction, ImplementationGroup)


-- Existing parser observers ask about ordinary functions. This transient test
-- view does not copy or retain a second production declaration authority.
pure func free_functions(groups: List[ParsedFunctionGroup]) -> List[ParsedFunction]:
	var functions: List[ParsedFunction] = []
	for group in groups:
		match group:
			FreeFunction(function): functions = functions.append(function)
			ImplementationGroup(_, _): void
	functions
