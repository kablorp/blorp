import:
	../../src/source: module_source, root_module_id
	../../src/check as Checked
	../../src/lex: lex
	../../src/specialize as Concrete
	../../src/syntax: Diagnostic
	input: check, parse, setup_diagnostic
	test: TestSuite


private PAIR: String =
	|fixed record Pair { first: Int, second: Int }
	|

private OTHER: String =
	|fixed record Other { first: Int, second: Int }
	|

private MAIN: String =
	|func main() -> Int:
	|	0
	|


private pure func specialized(source: String) -> Result[Concrete.SpecializedContents, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source)
	parsed ?= parse(tokens)
	checked ?= check(parsed).map_err(setup_diagnostic)
	program ?= Concrete.specialize(checked)
	Ok(Concrete.specialized_contents(program))


pure func test_second_record_field_uses_its_concrete_owner() -> Bool:
	helper: String =
		|pure func make_other() -> Other:
		|	{ second = 9, first = 7 }
		|pure func read_other(value: Other) -> Int:
		|	value.first
		|

	match specialized(PAIR + OTHER + helper + MAIN):
		Ok(program):
			match program.functions:
				[make, read, _]:
					match make.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match value.base:
								Concrete.ReturnRecord(owner, [second, first]):
									match read.body:
										Concrete.ConcreteValueBody(Concrete.ReturnExpression(projected)):
											match projected.operations:
												[step]:
													match step.operation:
														Concrete.ReadRecordField(field):
															(
																program.records.length() == 2
																and Concrete.record_number(
																	owner,
																) == 1
																and Concrete.record_number(
																	Concrete.field_owner(
																		second.field,
																	),
																) == 1
																and Concrete.field_number(
																	second.field,
																) == 1
																and Concrete.field_number(
																	first.field,
																) == 0
																and Concrete.record_number(
																	Concrete.field_owner(
																		field,
																	),
																) == 1
																and Concrete.field_number(
																	field,
																) == 0
																and Concrete.same_type(
																	step.value_type,
																	Concrete.IntType,
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_generic_function_specializes_for_nominal_record() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|	value
		|pure func make() -> Pair:
		|	{ first = 7, second = 9 }
		|func main() -> Int:
		|	identity(make()).first
		|

	match specialized(PAIR + source):
		Ok(program):
			match program.functions:
				[_, _, identity]:
					match identity.signature.parameters:
						[Concrete.RecordType(owner)]:
							Concrete.record_number(owner) == 0 and Concrete.same_type(
								identity.signature.return_type,
								Concrete.RecordType(owner),
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_calls_inside_record_fields_are_collected() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|	value
		|pure func make() -> Pair:
		|	{ second = identity(9), first = identity(7) }
		|

	match specialized(PAIR + source + MAIN):
		Ok(program):
			match program.functions:
				[make, _, identity]:
					match make.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match value.base:
								Concrete.ReturnRecord(_, [second, first]):
									match second.value.base:
										Concrete.ReturnCall(call, [_]):
											match first.value.base:
												Concrete.ReturnCall(other_call, [_]):
													match call.target:
														Concrete.UserFunction(id):
															match other_call.target:
																Concrete.UserFunction(other):
																	(
																		Concrete.function_number(
																			id,
																		) == 2
																		and Concrete.function_number(
																			other,
																		) == 2
																		and identity.signature.parameters.length() == 1
																		and Concrete.same_type(
																			identity.signature.return_type,
																			Concrete.IntType,
																		)
																	)
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_record_payload_in_generic_union_has_concrete_record_identity() -> Bool:
	prefix: String =
		|fixed union Box[T]:
		|	Value(T)
		|pure func make_pair() -> Pair:
		|	{ first = 7, second = 9 }
		|pure func boxed() -> Box[Pair]:
		|	Value(make_pair())
		|

	match specialized(PAIR + prefix + MAIN):
		Ok(program):
			match program.unions:
				[boxed]:
					match boxed.variants:
						[Some(Concrete.RecordType(owner))]:
							Concrete.record_number(owner) == 0
						_:
							False
				_:
					False
		_:
			False


pure func test_full_width_field_values_survive_specialization() -> Bool:
	source: String =
		|pure func make() -> Pair:
		|	{ first = -9223372036854775808, second = 9223372036854775807 }
		|

	match specialized(PAIR + source + MAIN):
		Ok(program):
			match program.functions:
				[make, _]:
					match make.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match value.base:
								Concrete.ReturnRecord(_, [first, second]):
									match first.value.base:
										Concrete.ReturnInteger(low):
											match second.value.base:
												Concrete.ReturnInteger(high):
													(
														low == -9223372036854775808
														and high == 9223372036854775807
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Concrete fixed records",
	tests = [
		(
			"second record field retains concrete owner",
			test_second_record_field_uses_its_concrete_owner,
		),
		(
			"generic identity specializes for nominal record",
			test_generic_function_specializes_for_nominal_record,
		),
		(
			"record children contribute generic call requests",
			test_calls_inside_record_fields_are_collected,
		),
		(
			"generic union record payload retains concrete identity",
			test_record_payload_in_generic_union_has_concrete_record_identity,
		),
		(
			"full-width field values survive specialization",
			test_full_width_field_values_survive_specialization,
		),
	]
}
