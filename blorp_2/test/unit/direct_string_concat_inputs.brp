-- Source calls distinguish builtin declarations from ordinary borrowed wrappers.
CONCAT_DECLARATION: String =
	|pure func concatenate(left: String, right: String) -> String:
	|    builtin("string.add")
	|


DIRECT_CONCAT: String =
	|pure func caller(left: String, right: String) -> String:
	|    concatenate(left, right)
	|func main() -> Int:
	|    unused = caller("left", "right")
	|    0
	|


RECEIVER_CONCAT: String =
	|pure func caller(left: String, right: String) -> String:
	|    left.concatenate(right)
	|func main() -> Int:
	|    unused = caller("left", "right")
	|    0
	|


WRAPPED_CONCAT: String =
	|pure func wrapper(left: String, right: String) -> String:
	|    concatenate(left, right)
	|pure func caller(left: String, right: String) -> String:
	|    wrapper(left, right)
	|func main() -> Int:
	|    unused = caller("left", "right")
	|    0
	|


NAMED_CONCAT: String =
	|pure func apply(callback: pure (String, String) -> String, left: String, right: String) -> String:
	|    callback(left, right)
	|pure func caller(left: String, right: String) -> String:
	|    apply(concatenate, left, right)
	|func main() -> Int:
	|    unused = caller("left", "right")
	|    0
	|


STORED_CONCAT: String =
	|pure func stored() -> pure (String, String) -> String:
	|    concatenate
	|pure func caller(callback: pure (String, String) -> String, left: String, right: String) -> String:
	|    callback(left, right)
	|func main() -> Int:
	|    callback = stored()
	|    unused = callback("left", "right")
	|    0
	|
