import:
	../../src/utils/source: module_source, root_module_id
	../../src/lex/lex: lex
	../../src/lower/lower:
		LoweredExit(ReturnValue),
		LoweredFunction,
		LoweredTail(ExitValue, MatchValue),
		MatchLabel(VariantLabel),
		ValueDefinition,
		ValueId,
		ValueOperation(IntegerValue, ParameterValue, CallValue, ConstructRecordValue),
		lower,
		lowered_functions,
	../../src/namespace/builtins as Builtins: RuntimeOperation
	../../src/specialize/specialize:
		CallTarget(RuntimeFunction, UserFunction),
		ConcreteRecord,
		ConcreteUnion,
		FieldInstanceId,
		FunctionInstanceId,
		RecordInstanceId,
		TypeRef(IntType, UnionType),
		UnionInstanceId,
		VariantInstanceId,
		specialize,
	../../src/utils/syntax: Diagnostic, FunctionExecution(OrdinaryCalls), Span, Entrypoint(NoArguments), entry_function
	./input: check, setup_diagnostic
	./module_input: PRIMITIVE_BASE, parse_modules_with_base


fixed record InputIds {
	first: ValueId,
	second: ValueId,
	third: ValueId,
	fourth: ValueId,
	fifth: ValueId,
	entrypoint: FunctionInstanceId,
	second_function: FunctionInstanceId,
	union_id: UnionInstanceId,
	second_variant: VariantInstanceId,
	union_value: ValueDefinition,
	unions: List[ConcreteUnion]
}


-- Mint opaque source/value identities through their actual authorities.
-- Every phase test below constructs its own typed input; this seed supplies no
-- ownership operations and is never used as a verifier oracle.
private pure func seed_function_id(
	definition: ValueDefinition,
) -> Result[FunctionInstanceId, Diagnostic]:
	match definition.operation:
		CallValue(call, _):
			match call.target:
				UserFunction(id):
					Ok(id)
				_:
					Err({
						span = definition.span,
						note = None,
						message = "expected user call seed",
						help = "fix ownership test seed",
					})
		_:
			Err({
				span = definition.span,
				note = None,
				message = "expected call seed",
				help = "fix ownership test seed",
			})


private pure func seed_variant(function: LoweredFunction) -> Result[VariantInstanceId, Diagnostic]:
	match function.tail:
		MatchValue(matched):
			match matched.arms:
				[_, arm]:
					match arm.label:
						VariantLabel(id):
							Ok(id)
						_:
							Err({
								span = span(0),
								note = None,
								message = "expected variant seed",
								help = "fix ownership test seed",
							})
				_:
					Err({
						span = span(0),
						note = None,
						message = "expected two seed arms",
						help = "fix ownership test seed",
					})
		_:
			Err({
				span = span(0),
				note = None,
				message = "expected match seed",
				help = "fix ownership test seed",
			})


pure func input_ids() -> Result[InputIds, Diagnostic]:
	source: String =
		|fixed union Flag:
		|	Off
		|	On
		|pure func use(value: Flag) -> Int:
		|	match value:
		|		Off: 0
		|		On: 0
		|func main() -> Int:
		|	unused = use(Off)
		|	third = 2
		|	fourth = 3
		|	4
		|
	parsed ?= parse_modules_with_base([{ source = source, targets = [] }], PRIMITIVE_BASE)
	checked ?= check(parsed).map_err(setup_diagnostic)
	lowered ?= specialize(checked).and_then(pure func(program): lower(program))
	program = lowered_functions(lowered)

	match program.functions:
		[function, seed]:
			second_variant ?= seed_variant(seed)

			match function.definitions:
				[first, second, third, fourth, fifth]:
					second_function ?= seed_function_id(second)

					match first.value_type:
						UnionType(id):
							Ok({
								first = first.id,
								second = second.id,
								third = third.id,
								fourth = fourth.id,
								fifth = fifth.id,
								entrypoint = entry_function(program.entrypoint),
								second_function = second_function,
								union_id = id,
								second_variant = second_variant,
								union_value = first,
								unions = program.unions,
							})
						_:
							Err({
								span = first.span,
								note = None,
								message = "expected union seed",
								help = "fix the ownership test seed",
							})
				_:
					Err({
						span = {
							source = module_source(root_module_id()),
							start = 0,
							end = 0
						},
						note = None,
						message = "expected five seed values",
						help = "fix the ownership test seed",
					})
		_:
			Err({
				span = {
					source = module_source(root_module_id()),
					start = 0,
					end = 0
				},
				note = None,
				message = "expected one seed function",
				help = "fix the ownership test seed",
			})


pure func span(start: Int) -> Span:
	{
		source = module_source(root_module_id()),
		start = start,
		end = start + 1
	}


pure func integer(id: ValueId, value: Int, start: Int) -> ValueDefinition:
	{
		id = id,
		value_type = IntType,
		operation = IntegerValue(value),
		span = span(start)
	}


pure func parameter(id: ValueId, value_type: TypeRef) -> ValueDefinition:
	{
		id = id,
		value_type = value_type,
		operation = ParameterValue(0),
		span = span(10)
	}


pure func runtime(
	id: ValueId,
	operation: RuntimeOperation[VariantInstanceId, TypeRef],
	arguments: List[ValueId],
	value_type: TypeRef,
	start: Int,
) -> ValueDefinition:
	{
		id = id,
		value_type = value_type,
		operation = CallValue(
			{
				target = RuntimeFunction(operation),
				span = span(start)
			},
			arguments,
		),
		span = span(start)
	}


pure func function(
	definitions: List[ValueDefinition],
	result: ValueId,
	parameters: List[TypeRef],
	return_type: TypeRef,
) -> LoweredFunction:
	{
		execution = OrdinaryCalls,
		signature = {
			parameters = parameters,
			return_type = return_type
		},
		definitions = definitions,
		tail = ExitValue(ReturnValue(result))
	}


fixed record RecordIds {
	first: ValueId,
	second: ValueId,
	third: ValueId,
	fourth: ValueId,
	fifth: ValueId,
	entrypoint: FunctionInstanceId,
	helper: FunctionInstanceId,
	record_id: RecordInstanceId,
	other_record: RecordInstanceId,
	first_field: FieldInstanceId,
	second_field: FieldInstanceId,
	other_field: FieldInstanceId,
	records: List[ConcreteRecord]
}


-- A separate producer-issued seed supplies record identities, never ownership facts.
pure func record_ids() -> Result[RecordIds, Diagnostic]:
	source: String =
		|fixed record Pair { first: Int, second: Int }
		|fixed record Other { first: Int, second: Int }
		|func main() -> Int:
		|	first = 1
		|	second = 2
		|	third = 3
		|	fourth = 4
		|	unused = make_pair()
		|	unused_other = make_other()
		|	5
		|pure func make_pair() -> Pair:
		|	{ first = 7, second = 9 }
		|pure func make_other() -> Other:
		|	{ first = 1, second = 2 }
		|
	parsed ?= parse_modules_with_base([{ source = source, targets = [] }], PRIMITIVE_BASE)
	checked ?= check(parsed).map_err(setup_diagnostic)
	lowered ?= specialize(checked).and_then(pure func(program): lower(program))
	program = lowered_functions(lowered)

	match program.functions:
		[main_function, pair, other]:
			match main_function.definitions:
				[first, second, third, fourth, fifth, _, _]:
					helper ?= seed_function_id(fifth)

					match pair.definitions:
						[_, _, constructed]:
							match other.definitions:
								[_, _, other_constructed]:
									match constructed.operation:
										ConstructRecordValue(owner, [left, right]):
											match other_constructed.operation:
												ConstructRecordValue(other_owner, [other_field, _]):
													Ok({
														first = first.id,
														second = second.id,
														third = third.id,
														fourth = fourth.id,
														fifth = fifth.id,
														entrypoint = entry_function(program.entrypoint),
														helper = helper,
														record_id = owner,
														other_record = other_owner,
														first_field = left.field,
														second_field = right.field,
														other_field = other_field.field,
														records = program.records,
													})
												_:
													Err(record_seed_error())
										_:
											Err(record_seed_error())
								_:
									Err(record_seed_error())
						_:
							Err(record_seed_error())
				_:
					Err(record_seed_error())
		_:
			Err(record_seed_error())


private pure func record_seed_error() -> Diagnostic:
	{
		span = span(0),
		note = None,
		message = "invalid record identity seed",
		help = "fix the record test seed"
	}
