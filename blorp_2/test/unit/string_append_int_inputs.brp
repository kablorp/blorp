APPEND_DECLARATION: String =
	|pure func append_number(text: String, number: Int) -> String:
	|    builtin("string.append_int")
	|


DIRECT_APPEND: String =
	|pure func caller(text: String, number: Int) -> String:
	|    append_number(text, number)
	|func main() -> Int:
	|    unused = caller("value=", -7)
	|    0
	|


RECEIVER_APPEND: String =
	|pure func caller(text: String, number: Int) -> String:
	|    text.append_number(number)
	|func main() -> Int:
	|    unused = caller("value=", -7)
	|    0
	|


WRAPPED_APPEND: String =
	|pure func wrapper(text: String, number: Int) -> String:
	|    append_number(text, number)
	|pure func caller(text: String, number: Int) -> String:
	|    wrapper(text, number)
	|func main() -> Int:
	|    unused = caller("value=", -7)
	|    0
	|


NAMED_APPEND: String =
	|pure func apply(callback: pure (String, Int) -> String, text: String, number: Int) -> String:
	|    callback(text, number)
	|pure func caller(text: String, number: Int) -> String:
	|    apply(append_number, text, number)
	|func main() -> Int:
	|    unused = caller("value=", -7)
	|    0
	|


STORED_APPEND: String =
	|pure func stored() -> pure (String, Int) -> String:
	|    append_number
	|func main() -> Int:
	|    callback = stored()
	|    unused = callback("value=", -7)
	|    0
	|


-- A real loop condition, mixed concat/decimal body and fresh recur batch.
MIXED_LOOP: String =
	|pure func concatenate(left: String, right: String) -> String:
	|    builtin("string.add")
	|pure func less_than(left: Int, right: Int) -> Bool:
	|    builtin("int.less_than")
	|pure func increment(left: Int, right: Int) -> Int:
	|    builtin("int.add")
	|pure func run() -> String:
	|    var output = ""
	|    var index = 0
	|    while less_than(index, 3):
	|        output = concatenate(output, "value=")
	|        output = append_number(output, index)
	|        output = concatenate(output, "\n")
	|        index = increment(index, 1)
	|    output
	|func main() -> Int:
	|    unused = run()
	|    0
	|
