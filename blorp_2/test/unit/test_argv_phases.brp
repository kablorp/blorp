import:
	compilation: compile
	test: TestSuite


private pure func rejects(source: String, message: String, help: String, start: Int, end: Int) -> Bool:
	match compile(source):
		Ok(_): False
		Err(errors):
			errors.remaining.is_empty() and errors.first.message == message and errors.first.help == help and errors.first.span.start == start and errors.first.span.end == end


pure func test_argument_main_builds_and_releases_argv_list() -> Bool:
	source: String =
		|func main(arguments: List[String]) -> Int:
		|    0
		|
	match compile(source):
		Ok(output):
			output.contains("int main(int argc,char **argv)") and output.contains("blorp_string_list_from_argv(argc,argv)") and output.contains("blorp_string_list_release(blorp_arguments)")
		Err(_): False


pure func test_nullary_main_keeps_original_c_entrypoint() -> Bool:
	match compile("func main() -> Int:\n    42\n"):
		Ok(output): output.contains("int main(void){return (int)") and not output.contains("blorp_string_list_from_argv")
		Err(_): False


pure func test_argument_list_passes_through_generic_helper() -> Bool:
	source: String =
		|pure func identity[T](values: List[T]) -> List[T]:
		|    values
		|func main(arguments: List[String]) -> Int:
		|    saved = identity(arguments)
		|    0
		|
	match compile(source):
		Ok(output): output.contains("blorp_string_list_retain") and output.contains("blorp_string_list_release")
		Err(_): False


pure func test_wrong_main_parameter_has_teaching_diagnostic() -> Bool:
	prefix = "func main(value: "
	rejects(prefix + "Int) -> Int:\n    0\n", "main parameter must have type List[String]", "declare main() -> Int: or main(arguments: List[String]) -> Int:", prefix.length(), prefix.length() + 3)


pure func test_unsupported_concrete_list_element_is_rejected_early() -> Bool:
	prefix = "pure func invalid(values: List["
	rejects(prefix + "Int]) -> Int:\n    0\nfunc main() -> Int:\n    0\n", "List currently supports only String elements", "use List[String]; other concrete element types are not supported yet", prefix.length(), prefix.length() + 3)


pure func test_list_type_requires_one_argument() -> Bool:
	prefix = "func main(arguments: "
	rejects(prefix + "List) -> Int:\n    0\n", "List requires one type argument", "write List[String] for a list of Strings", prefix.length(), prefix.length() + 4)


tests: TestSuite = {
	description = "Blorp 2 typed argv entrypoint",
	tests = [
		("argument main owns argv list", test_argument_main_builds_and_releases_argv_list),
		("nullary main preserves wrapper", test_nullary_main_keeps_original_c_entrypoint),
		("generic helper preserves List element type", test_argument_list_passes_through_generic_helper),
		("wrong main parameter teaches argv signature", test_wrong_main_parameter_has_teaching_diagnostic),
		("unsupported concrete List element is rejected", test_unsupported_concrete_list_element_is_rejected_early),
		("bare List requires element type", test_list_type_requires_one_argument),
	]
}
