-- Source only: each owner runs its real producer and retains its own projection.
private CALL_LEAF: String = "7"


pure func call_source(depth: Int) -> String:
	var value = CALL_LEAF
	for _ in 0..depth:
		value = "keep(" + value + ")"
	"pure func keep(value: Int) -> Int:\n    value\nfunc main() -> Int:\n    " + value + "\n"


pure func applied_type_source(depth: Int) -> String:
	var annotation = "Int"
	var value = "7"
	for _ in 0..depth:
		annotation = "Box[Wrap[" + annotation + "]]"
		value = "{ value = Full(" + value + ") }"
	declarations: String =
		|fixed record Box[T] { value: T }
		|fixed union Wrap[T]:
		|    Full(T)
		|
	declarations + "pure func consume(value: " + annotation + ") -> Int:\n    7\nfunc main() -> Int:\n    consume(" + value + ")\n"
