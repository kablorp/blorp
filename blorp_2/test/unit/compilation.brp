import:
	../../src/main: compile as compile_program
	../../src/load: SourceInputs
	../../src/lex: lex
	../../src/source: module_source, root_module_id
	../../src/syntax: Diagnostics, singleton_diagnostic
	input: parse
	module_input: ModuleInput, parse_modules_with_base
	result: map_err


-- Test orchestration uses the production parser and pure compilation pipeline.
pure func compile(source: String) -> Result[String, Diagnostics]:
	lexed ?= lex(module_source(root_module_id()), source).map_err(singleton_diagnostic)
	parsed ?= parse(lexed).map_err(singleton_diagnostic)
	compile_program(parsed)


pure func compile_modules(inputs: List[ModuleInput], base: String) -> Result[String, Diagnostics]:
	parsed ?= parse_modules_with_base(inputs, base).map_err(singleton_diagnostic)
	compile_program(parsed)


pure func diagnostic_sources(path: String, source: String) -> SourceInputs:
	{
		modules = [{ path = path, contents = source }]
	}
