import:
	../../src/main:
		CompilationDiagnostic(PreludeDiagnostics, ProgramDiagnostics),
		compile as compile_inputs,
	../../src/syntax: Diagnostics
	input: TEST_PRELUDE
	result: map_err


-- Most phase/pipeline assertions inspect a diagnostic's contents. Tests of
-- source attribution call compile_inputs with both explicit inputs instead.
pure func compile(source: String) -> Result[String, Diagnostics]:
	compile_inputs({
		prelude = TEST_PRELUDE,
		program = source,
	}).map_err(pure func(error: CompilationDiagnostic) -> Diagnostics:
		match error:
			PreludeDiagnostics(diagnostic):
				diagnostic
			ProgramDiagnostics(diagnostic):
				diagnostic
	)
