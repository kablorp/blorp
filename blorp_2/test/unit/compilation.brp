import:
	../../src/main:
		CompilationDiagnostic(PreludeDiagnostic, ProgramDiagnostic),
		compile as compile_inputs,
	../../src/syntax: Diagnostic
	input: TEST_PRELUDE
	result: map_err


-- Most phase/pipeline assertions inspect a diagnostic's contents. Tests of
-- source attribution call compile_inputs with both explicit inputs instead.
pure func compile(source: String) -> Result[String, Diagnostic]:
	compile_inputs({
		prelude = TEST_PRELUDE,
		program = source,
	}).map_err(pure func(error: CompilationDiagnostic) -> Diagnostic:
		match error:
			PreludeDiagnostic(diagnostic):
				diagnostic
			ProgramDiagnostic(diagnostic):
				diagnostic
	)
