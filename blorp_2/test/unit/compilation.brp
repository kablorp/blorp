import:
	../../src/utils/names: program_names
	../../src/main: compile as compile_program
	../../src/load/load: SourceInputs
	../../src/lex/lex: lex
	../../src/utils/source: module_source, root_module_id
	../../src/utils/syntax: Diagnostics, singleton_diagnostic
	./input: parse
	./module_input: ModuleInput, TestFoundation, parse_modules_with_base
	result: map_err


-- Test orchestration uses the production parser and pure compilation pipeline.
pure func compile(source: String) -> Result[String, Diagnostics]:
	lexed ?= lex(module_source(root_module_id()), source, program_names().names).map_err(singleton_diagnostic)
	parsed ?= parse(lexed).map_err(singleton_diagnostic)
	compile_program(parsed)


pure func compile_modules(inputs: List[ModuleInput], foundation: TestFoundation) -> Result[String, Diagnostics]:
	parsed ?= parse_modules_with_base(inputs, foundation).map_err(singleton_diagnostic)
	compile_program(parsed)


pure func diagnostic_sources(path: String, source: String) -> SourceInputs:
	{
		modules = [{ path = path, contents = source }]
	}
