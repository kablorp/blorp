import:
	test: TestSuite
	../test_lex/test_lex: trace


-- A trace without its spans: one token kind per word.
private pure func shape(source: String) -> String:
	var result: String = ""

	for line in trace(source).split("\n"):
		kind = match line.split("@").get(0):
			Some(found):
				found
			None:
				""
		result = if result == "":
			kind
		else:
			result + " " + kind
	result


-- Host 2.5: a block lambda inside a call, its closing bracket on its own
-- line at the base indentation. The `)` follows the block's DEDENT.
pure func test_colon_ended_line_inside_brackets_opens_a_block() -> Bool:
	source: String =
		|func f() -> Int:
		|	ys = xs.map(func(x):
		|		y = x
		|		y
		|	)
		|	0
		|
	shape(source) == "func name=f ( ) -> name=Int : LF INDENT name=ys = name=xs . name=map ( func ( name=x ) : LF INDENT name=y = name=x LF name=y LF DEDENT ) LF integer=0 LF DEDENT EOF"


-- A closing bracket on the block's last line stays inside the block; the
-- DEDENT comes with the next line.
pure func test_closing_bracket_does_not_close_the_block() -> Bool:
	source: String =
		|func f() -> Int:
		|	ys = xs.map(func(x):
		|		x)
		|	0
		|
	shape(source) == "func name=f ( ) -> name=Int : LF INDENT name=ys = name=xs . name=map ( func ( name=x ) : LF INDENT name=x ) LF DEDENT integer=0 LF DEDENT EOF"


-- Inside a bracketed block, deeper brackets make line breaks trivia again,
-- and a line indented deeper than the block's level opens an ordinary one.
pure func test_deeper_brackets_inside_a_block_are_trivia() -> Bool:
	source: String =
		|f(func(x):
		|	g(x,
		|		1)
		|	x)
		|
	shape(source) == "name=f ( func ( name=x ) : LF INDENT name=g ( name=x , integer=1 ) LF name=x ) LF DEDENT EOF"


-- A second `:`-ended line at a deeper bracket depth opens a nested block.
-- Closing brackets on their own lines close each block by its base.
pure func test_nested_bracketed_blocks_close_by_base() -> Bool:
	source: String =
		|f(func(x):
		|	g(func(y):
		|		y
		|	)
		|	x
		|)
		|z
		|
	shape(source) == "name=f ( func ( name=x ) : LF INDENT name=g ( func ( name=y ) : LF INDENT name=y LF DEDENT ) LF name=x LF DEDENT ) LF name=z LF EOF"


-- As in the host, a closing bracket on a nested block's last line leaves
-- the bracket depth below the nested block's group, so the following line
-- breaks are trivia until a dedent closes the blocks.
pure func test_closing_bracket_on_a_nested_last_line_suspends_layout() -> Bool:
	source: String =
		|f(func(x):
		|	g(func(y):
		|		y)
		|	x)
		|z
		|
	shape(source) == "name=f ( func ( name=x ) : LF INDENT name=g ( func ( name=y ) : LF INDENT name=y ) name=x ) LF DEDENT DEDENT name=z LF EOF"


-- After a block closes, the enclosing brackets are still open, so line
-- breaks there are trivia again until the bracket closes.
pure func test_breaks_are_trivia_again_after_the_block_closes() -> Bool:
	source: String =
		|f(func(x):
		|	x
		|, 1
		|, 2)
		|
	shape(source) == "name=f ( func ( name=x ) : LF INDENT name=x LF DEDENT , integer=1 , integer=2 ) LF EOF"


-- A `:` inside brackets at a depth where a block is already open does not
-- open another: the break is just the block's significant line end.
pure func test_colon_at_an_open_depth_opens_no_second_block() -> Bool:
	source: String =
		|f(func(x):
		|	match x:
		|		_: x
		|	x)
		|
	shape(source) == "name=f ( func ( name=x ) : LF INDENT match name=x : LF INDENT _ : name=x LF DEDENT name=x ) LF DEDENT EOF"


-- The end of the input closes an open bracketed block like any level.
pure func test_end_of_input_closes_an_open_block() -> Bool:
	shape("f(func(x):\n\tx") == "name=f ( func ( name=x ) : LF INDENT name=x LF DEDENT EOF"


-- The pilot's own source: a `match` continuation inside `Ok(` whose arms
-- are two levels deeper than the block's base, the `Ok(` line.
pure func test_block_lines_may_be_deeper_than_one_level() -> Bool:
	source: String =
		|f(
		|	match x:
		|		A: 1
		|)
		|
	deeper: String =
		|g(
		|	Ok(
		|		match x:
		|			A: 1
		|	)
		|)
		|
	(
		shape(source) == "name=f ( match name=x : LF INDENT name=A : integer=1 LF DEDENT ) LF EOF"
		and shape(deeper) == "name=g ( name=Ok ( match name=x : LF INDENT name=A : integer=1 LF DEDENT ) ) LF EOF"
	)


-- Host L2 case 3: a line at the block's bracket depth indented strictly
-- between the block's base and its level closes the block, with no INDENT
-- of its own.
pure func test_line_between_base_and_block_level_closes_the_block() -> Bool:
	shape("f(func(x):\n\t\t\ty\n\t)\n") == "name=f ( func ( name=x ) : LF INDENT name=y LF DEDENT ) LF EOF"


-- Without a `:`, a break inside brackets is trivia as before.
pure func test_breaks_without_a_colon_stay_trivia() -> Bool:
	shape("f(1,\n\t2)\n") == "name=f ( integer=1 , integer=2 ) LF EOF"


tests: TestSuite = {
	description = "Blorp 2 bracketed blocks",
	tests = [
		("colon-ended line inside brackets opens a block", test_colon_ended_line_inside_brackets_opens_a_block),
		("closing bracket does not close the block", test_closing_bracket_does_not_close_the_block),
		("deeper brackets inside a block are trivia", test_deeper_brackets_inside_a_block_are_trivia),
		("nested bracketed blocks close by base", test_nested_bracketed_blocks_close_by_base),
		("closing bracket on a nested last line suspends layout", test_closing_bracket_on_a_nested_last_line_suspends_layout),
		("breaks are trivia again after the block closes", test_breaks_are_trivia_again_after_the_block_closes),
		("colon at an open depth opens no second block", test_colon_at_an_open_depth_opens_no_second_block),
		("end of input closes an open block", test_end_of_input_closes_an_open_block),
		("breaks without a colon stay trivia", test_breaks_without_a_colon_stay_trivia),
		("block lines may be deeper than one level", test_block_lines_may_be_deeper_than_one_level),
		("line between base and block level closes the block", test_line_between_base_and_block_level_closes_the_block),
	]
}
