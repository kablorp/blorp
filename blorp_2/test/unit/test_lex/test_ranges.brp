import:
	test: TestSuite
	../test_lex/test_lex: trace


-- Two adjacent dots are one range symbol; an integer before them keeps its
-- digits, and a Float keeps its fraction.
pure func test_adjacent_dots_are_one_symbol() -> Bool:
	trace("a..b") == "name=a@0:1\n..@1:3\nname=b@3:4\nLF@4:4\nEOF@4:4"


pure func test_integer_before_dots_is_not_a_float() -> Bool:
	trace("0..n") == "integer=0@0:1\n..@1:3\nname=n@3:4\nLF@4:4\nEOF@4:4"


pure func test_float_before_dots_keeps_its_fraction() -> Bool:
	trace("1.5..2.0") == "float=1.5@0:3\n..@3:5\nfloat=2.0@5:8\nLF@8:8\nEOF@8:8"


-- Three dots are the spread symbol; a fourth is an ordinary dot after it.
pure func test_three_dots_are_the_spread_symbol() -> Bool:
	trace("...rest ....") == "...@0:3\nname=rest@3:7\n...@8:11\n.@11:12\nLF@12:12\nEOF@12:12"


pure func test_single_dot_remains_a_dot() -> Bool:
	trace("a.b") == "name=a@0:1\n.@1:2\nname=b@2:3\nLF@3:3\nEOF@3:3"


tests: TestSuite = {
	description = "Blorp 2 range symbol",
	tests = [
		("adjacent dots are one symbol", test_adjacent_dots_are_one_symbol),
		("integer before dots is not a float", test_integer_before_dots_is_not_a_float),
		("float before dots keeps its fraction", test_float_before_dots_keeps_its_fraction),
		("three dots are the spread symbol", test_three_dots_are_the_spread_symbol),
		("single dot remains a dot", test_single_dot_remains_a_dot),
	]
}
