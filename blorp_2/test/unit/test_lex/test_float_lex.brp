import:
	test: TestSuite
	../test_lex/test_lex: trace


pure func test_fraction_is_one_counted_token() -> Bool:
	trace("1.25") == "float=1.25@0:4\nLF@4:4\nEOF@4:4"


pure func test_exponent_is_one_counted_token() -> Bool:
	trace("1e2") == "float=1e2@0:3\nLF@3:3\nEOF@3:3"


pure func test_negative_signed_exponent_is_one_token() -> Bool:
	trace("-1.25E-20") == "float=-1.25E-20@0:9\nLF@9:9\nEOF@9:9"


pure func test_positive_exponent_sign_is_part_of_token() -> Bool:
	trace("0e+2") == "float=0e+2@0:4\nLF@4:4\nEOF@4:4"


pure func test_negative_zero_preserves_spelling() -> Bool:
	trace("-0.0") == "float=-0.0@0:4\nLF@4:4\nEOF@4:4"


pure func test_integer_ufcs_keeps_dot_separate() -> Bool:
	trace("1.identity()") == "integer=1@0:1\n.@1:2\nname=identity@2:10\n(@10:11\n)@11:12\nLF@12:12\nEOF@12:12"


pure func test_float_ufcs_keeps_second_dot_separate() -> Bool:
	trace("1.0.identity()") == "float=1.0@0:3\n.@3:4\nname=identity@4:12\n(@12:13\n)@13:14\nLF@14:14\nEOF@14:14"


pure func test_missing_exponent_digits_reports_complete_literal() -> Bool:
	trace("1.0e+") == "error@0:5\nexpected decimal digits in Float exponent\nwrite a decimal Float such as 1.0, 0.5 or 1e2; an exponent needs at least one digit"


pure func test_missing_unsigned_exponent_digits_reports_complete_literal() -> Bool:
	trace("1e") == "error@0:2\nexpected decimal digits in Float exponent\nwrite a decimal Float such as 1.0, 0.5 or 1e2; an exponent needs at least one digit"


pure func test_float_token_preserves_noncanonical_leading_zero_for_parser() -> Bool:
	trace("01.5") == "float=01.5@0:4\nLF@4:4\nEOF@4:4"


tests: TestSuite = {
	description = "Blorp 2 Float lexical boundaries",
	tests = [
		("fraction is one counted token", test_fraction_is_one_counted_token),
		("exponent is one counted token", test_exponent_is_one_counted_token),
		("negative signed exponent is one token", test_negative_signed_exponent_is_one_token),
		("positive exponent sign belongs to token", test_positive_exponent_sign_is_part_of_token),
		("negative zero preserves spelling", test_negative_zero_preserves_spelling),
		("integer UFCS keeps dot separate", test_integer_ufcs_keeps_dot_separate),
		("Float UFCS keeps second dot separate", test_float_ufcs_keeps_second_dot_separate),
		("missing signed exponent digits reports full literal", test_missing_exponent_digits_reports_complete_literal),
		("missing exponent digits reports full literal", test_missing_unsigned_exponent_digits_reports_complete_literal),
		("leading zero spelling reaches parser", test_float_token_preserves_noncanonical_leading_zero_for_parser),
	]
}
