import:
	string as StringOps
	int as IntOps
	option as OptionOps
	../../../src/utils/boolean: not
	../../../src/utils/names: NameId, name_spelling, program_names, same_name, same_name_table
	../../../src/lex/lex: lex
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax:
		LexedProgram,
		Span,
		Symbol(
			AtSign, Wildcard, LeftParen, RightParen, Dot, Arrow, Colon, Newline, Indent, Dedent,
			Comma, Equals, EqualsEquals, NotEquals, QuestionEquals, LeftBracket, RightBracket, LeftBrace, RightBrace,
			Bar, Slash, Star, Plus, DotDot, Ellipsis,
		),
		Spacing(Adjacent, Spaced),
		TokenKind(IdentifierToken, KeywordToken, SymbolToken, IntegerLiteral, FloatLiteral, QuotedString, PipeString, StringStart, StringSegment, InterpolationOpen, InterpolationClose, StringEnd, CharLiteral),
	test: TestSuite


private HEADER: String = "func main() -> Int:\n"

private HEADER_TOKENS: String = "func@0:4\nname=main@5:9\n(@9:10\n)@10:11\n->@12:14\nname=Int@15:18\n:@18:19\nLF@19:20\n"


pure func span_text(span: Span) -> String:
	StringOps.add(StringOps.add(IntOps.to_string(span.start), ":"), IntOps.to_string(span.end))


pure func trace(source: String) -> String:
	match lex(module_source(root_module_id()), source, program_names().names):
		Err(diagnostic):
			var text: String = StringOps.add("error@", span_text(diagnostic.span))
			text = StringOps.add(text, "\n")
			text = StringOps.add(text, diagnostic.message)
			text = StringOps.add(text, "\n")
			StringOps.add(text, diagnostic.help)
		Ok(program):
			var text: String = ""

			for token in program.tokens:
				kind: String = match token.kind:
					IdentifierToken(id):
						match name_spelling(program.names, id):
							Some(name):
								StringOps.add("name=", name)
							None:
								"name=?"
					IntegerLiteral(value):
						StringOps.add("integer=", value)
					FloatLiteral(value):
						StringOps.add("float=", value)
					QuotedString(value):
						StringOps.add("quoted=", value)
					PipeString(value):
						StringOps.add("pipe=", value)
					StringStart(_): "string-start"
					StringSegment(value): StringOps.add("segment=", value)
					InterpolationOpen: "hole-open"
					InterpolationClose: "hole-close"
					StringEnd: "string-end"
					CharLiteral:
						"char"
					KeywordToken(_):
						OptionOps.get_or(StringOps.slice(program.source_text, token.span.start, token.span.end), "")
					SymbolToken(symbol):
						match symbol:
							AtSign:
								"@"
							EqualsEquals: "=="
							NotEquals: "!="
							Equals:
								"="
							QuestionEquals:
								"?="
							Wildcard:
								"_"
							LeftParen:
								"("
							RightParen:
								")"
							LeftBracket:
								"["
							RightBracket:
								"]"
							LeftBrace:
								"{"
							RightBrace:
								"}"
							Bar:
								"|"
							Comma:
								","
							Dot:
								"."
							DotDot:
								".."
							Ellipsis:
								"..."
							Slash:
								"/"
							Plus:
								"+"
							Star:
								"*"
							Arrow:
								"->"
							Colon:
								":"
							Newline:
								"LF"
							Indent:
								"INDENT"
							Dedent:
								"DEDENT"

				line: String = StringOps.add(StringOps.add(StringOps.add(kind, "@"), span_text(token.span)), "\n")
				text = StringOps.add(text, line)

			StringOps.add(StringOps.add(text, "EOF@"), span_text(program.end))


pure func test_tab_indented_program() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|
	StringOps.equals(trace(source), StringOps.add(HEADER_TOKENS, "INDENT@20:21\ninteger=0@21:22\nLF@22:23\nDEDENT@23:23\nEOF@23:23"))


pure func test_space_indented_program_without_final_lf() -> Bool:
	StringOps.equals(trace(StringOps.add(HEADER, "    0")), StringOps.add(HEADER_TOKENS, "INDENT@20:24\ninteger=0@24:25\nLF@25:25\nDEDENT@25:25\nEOF@25:25"))


pure func test_blank_newline_has_no_layout_token() -> Bool:
	StringOps.equals(trace("\n"), "EOF@1:1")


pure func test_whitespace_at_eof_has_no_layout_token() -> Bool:
	StringOps.equals(trace("    "), "EOF@4:4")


pure func test_empty_input() -> Bool:
	StringOps.equals(trace(""), "EOF@0:0")


pure func test_raw_decimal_run_preserves_spelling() -> Bool:
	StringOps.equals(trace(StringOps.add(HEADER, "\t00\n")), StringOps.add(HEADER_TOKENS, "INDENT@20:21\ninteger=00@21:23\nLF@23:24\nDEDENT@24:24\nEOF@24:24"))


pure func test_mixed_indentation_diagnostic() -> Bool:
	StringOps.equals(trace(StringOps.add(HEADER, "\t 0\n")), "error@20:22\ninvalid indentation\nuse tabs only, or spaces in groups of four; do not mix tabs and spaces")


pure func test_cr_line_ending_diagnostic() -> Bool:
	StringOps.equals(trace("\r"), "error@0:1\nonly LF line endings are supported\nreplace CRLF or CR line endings with LF")


pure func test_pure_keyword_and_maximal_identifier() -> Bool:
	StringOps.equals(trace("pure purex"), "pure@0:4\nname=purex@5:10\nLF@10:10\nEOF@10:10")


pure func test_comma_separates_arguments() -> Bool:
	StringOps.equals(trace("7, 9"), "integer=7@0:1\n,@1:2\ninteger=9@3:4\nLF@4:4\nEOF@4:4")


pure func test_dot_separates_receiver_and_function_name() -> Bool:
	StringOps.equals(trace("1.identity()"), "integer=1@0:1\n.@1:2\nname=identity@2:10\n(@10:11\n)@11:12\nLF@12:12\nEOF@12:12")


-- `?=` is one token; a lone `?` is still no character of the language.


pure func test_question_equals_is_one_token() -> Bool:
	match StringOps.equals(trace("x ?= y"), "name=x@0:1\n?=@2:4\nname=y@5:6\nLF@6:6\nEOF@6:6"):
		False: False
		True:
			StringOps.equals(trace("x ? y"), "error@2:3\nunsupported character\nuse ASCII function declarations and numeric literals, parameter names, or calls; keep -> adjacent")


pure func test_signed_runs_and_arrow_have_independent_tokens() -> Bool:
	StringOps.equals(trace("-> -42 -0 42.identity()"), "->@0:2\ninteger=-42@3:6\ninteger=-0@7:9\ninteger=42@10:12\n.@12:13\nname=identity@13:21\n(@21:22\n)@22:23\nLF@23:23\nEOF@23:23")


pure func test_minus_requires_adjacent_digits() -> Bool:
	expected = "error@0:1\nexpected decimal digits immediately after '-'\nwrite a signed number such as -42 or -0.5; '-' is not an operator"
	match StringOps.equals(trace("-"), expected):
		False: False
		True:
			match StringOps.equals(trace("- 1"), expected):
				False: False
				True:
					StringOps.equals(trace("-value"), expected)


pure func test_match_wildcard_and_prefix_identifiers() -> Bool:
	StringOps.equals(trace("match _ _name matchx:\n\tNumber(x): x"), "match@0:5\n_@6:7\nname=_name@8:13\nname=matchx@14:20\n:@20:21\nLF@21:22\nINDENT@22:23\nname=Number@23:29\n(@29:30\nname=x@30:31\n)@31:32\n:@32:33\nname=x@34:35\nLF@35:35\nDEDENT@35:35\nEOF@35:35")


pure func test_space_levels_and_invalid_prefixes() -> Bool:
	match StringOps.equals(trace("a:\n    b:\n        0"), "name=a@0:1\n:@1:2\nLF@2:3\nINDENT@3:7\nname=b@7:8\n:@8:9\nLF@9:10\nINDENT@10:18\ninteger=0@18:19\nLF@19:19\nDEDENT@19:19\nDEDENT@19:19\nEOF@19:19"):
		False: False
		True:
			match StringOps.equals(trace(" 0"), "error@0:1\ninvalid indentation\nuse tabs only, or spaces in groups of four; do not mix tabs and spaces"):
				False: False
				True:
					StringOps.equals(trace("    \t0"), "error@0:5\ninvalid indentation\nuse tabs only, or spaces in groups of four; do not mix tabs and spaces")


-- Each Dedent spans the indentation prefix of the line that closes its level.


pure func test_dedents_close_each_level_at_the_shallower_line() -> Bool:
	match StringOps.equals(trace("a:\n\tb:\n\t\tc\n\td\ne"), "name=a@0:1\n:@1:2\nLF@2:3\nINDENT@3:4\nname=b@4:5\n:@5:6\nLF@6:7\nINDENT@7:9\nname=c@9:10\nLF@10:11\nDEDENT@11:12\nname=d@12:13\nLF@13:14\nDEDENT@14:14\nname=e@14:15\nLF@15:15\nEOF@15:15"):
		False: False
		True:
			StringOps.equals(trace("a:\n\tb:\n\t\tc\nd"), "name=a@0:1\n:@1:2\nLF@2:3\nINDENT@3:4\nname=b@4:5\n:@5:6\nLF@6:7\nINDENT@7:9\nname=c@9:10\nLF@10:11\nDEDENT@11:11\nDEDENT@11:11\nname=d@11:12\nLF@12:12\nEOF@12:12")


-- Trailing whitespace without a final LF is trivia: the end of the source
-- closes the open levels with empty spans there.


pure func test_closing_dedents_are_empty_at_eof_after_trailing_whitespace() -> Bool:
	match StringOps.equals(trace("a:\n\tb\n\t"), "name=a@0:1\n:@1:2\nLF@2:3\nINDENT@3:4\nname=b@4:5\nLF@5:6\nDEDENT@7:7\nEOF@7:7"):
		False: False
		True:
			StringOps.equals(trace("a:\n    b\n        "), "name=a@0:1\n:@1:2\nLF@2:3\nINDENT@3:7\nname=b@7:8\nLF@8:9\nDEDENT@17:17\nEOF@17:17")


-- As in the host, a deeper line opens its level whatever the step; a
-- dedent must land on an open level.


pure func test_indentation_may_open_several_levels_at_once() -> Bool:
	match StringOps.equals(trace("a:\n\t\tb"), "name=a@0:1\n:@1:2\nLF@2:3\nINDENT@3:5\nname=b@5:6\nLF@6:6\nDEDENT@6:6\nEOF@6:6"):
		False: False
		True:
			StringOps.equals(trace("a:\n        b"), "name=a@0:1\n:@1:2\nLF@2:3\nINDENT@3:11\nname=b@11:12\nLF@12:12\nDEDENT@12:12\nEOF@12:12")


pure func test_dedent_must_land_on_an_open_level() -> Bool:
	help = "indent every line of a block by the same amount, and dedent only to the indentation of an enclosing block (a tab counts as 4 columns)"
	match StringOps.equals(trace("a:\n\t\tb\n\tc"), StringOps.add("error@7:8\ninconsistent indentation\n", help)):
		False: False
		True:
			StringOps.equals(trace("a:\n\tb\n\t\t\tc\n\t\td"), StringOps.add("error@11:13\ninconsistent indentation\n", help))


private pure func spacing_of(source: String) -> List[String]:
	match lex(module_source(root_module_id()), source, program_names().names):
		Err(_):
			[]
		Ok(program):
			var names: List[String] = []

			for token in program.tokens:
				name = match token.spacing:
					Adjacent:
						"adjacent"
					Spaced:
						"spaced"
				names = names.append(name)

			names


pure func test_spacing_records_whether_a_space_precedes_each_token() -> Bool:
	match spacing_of("f (x) @y"):
		["adjacent", "spaced", "adjacent", "adjacent", "spaced", "adjacent", "adjacent"]:
			match spacing_of("a:\n\tb"):
				["adjacent", "adjacent", "adjacent", "adjacent", "spaced", "adjacent", "adjacent"]: True
				_: False
		_: False


pure func test_dot_after_integer_needs_a_name_or_fraction_digits() -> Bool:
	missing = "Float literals need digits after the decimal point\nwrite 1.0; otherwise use a UFCS function call after '.'"
	match StringOps.equals(trace("1."), StringOps.add("error@0:2\n", missing)):
		False: False
		True:
			match StringOps.equals(trace("(1.)"), StringOps.add("error@1:3\n", missing)):
				False: False
				True:
					match StringOps.equals(trace("1..f"), "integer=1@0:1\n..@1:3\nname=f@3:4\nLF@4:4\nEOF@4:4"):
						False: False
						True:
							match StringOps.equals(trace("1. f"), "integer=1@0:1\n.@1:2\nname=f@3:4\nLF@4:4\nEOF@4:4"):
								False: False
								True:
									StringOps.equals(trace("1.5."), "float=1.5@0:3\n.@3:4\nLF@4:4\nEOF@4:4")


pure func test_binding_symbols_and_var_word_boundary() -> Bool:
	StringOps.equals(trace("var value=42\nvariable"), "var@0:3\nname=value@4:9\n=@9:10\ninteger=42@10:12\nLF@12:13\nname=variable@13:21\nLF@21:21\nEOF@21:21")


-- A bar after a token is the record update bar; a bar first on a code line
-- starts a pipe String.


pure func test_record_update_bar_preserves_its_token_span() -> Bool:
	StringOps.equals(trace("x |"), "name=x@0:1\n|@2:3\nLF@3:3\nEOF@3:3")


pure func test_builtin_label_preserves_bytes_and_span() -> Bool:
	match lex(module_source(root_module_id()), "\"int.to_string\"", program_names().names):
		Ok(program):
			match program.tokens:
				[token, _]:
					match token.kind:
						QuotedString(value):
							match StringOps.equals(value, "int.to_string"):
								False: False
								True:
									match IntOps.equals(token.span.start, 0):
										False: False
										True:
											IntOps.equals(token.span.end, 15)
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_builtin_label_rejects_newline_escape_and_non_ascii() -> Bool:
	match StringOps.equals(trace("\"abc\n"), "error@4:5\nString literals must stay on one line\nclose the quote before LF; write \\n for a newline byte"):
		False: False
		True:
			match StringOps.equals(trace("\"abc\\n\""), "quoted=abc\\n@0:7\nLF@7:7\nEOF@7:7"):
				False: False
				True:
					StringOps.equals(trace("\"abcé\""), "quoted=abcé@0:7\nLF@7:7\nEOF@7:7")


pure func test_builtin_label_requires_closing_quote() -> Bool:
	StringOps.equals(trace("\"abc"), "error@0:4\nunterminated String literal\nadd a closing double quote on the same line")


pure func test_brackets_preserve_independent_token_spans() -> Bool:
	StringOps.equals(trace("[T]"), "[@0:1\nname=T@1:2\n]@2:3\nLF@3:3\nEOF@3:3")


pure func test_braces_preserve_record_field_token_spans() -> Bool:
	StringOps.equals(trace("{first=7}"), "{@0:1\nname=first@1:6\n=@6:7\ninteger=7@7:8\n}@8:9\nLF@9:9\nEOF@9:9")


-- The IDs of a lexed program's identifier tokens, in source order.


private pure func identifier_ids(program: LexedProgram) -> List[NameId]:
	var ids: List[NameId] = []
	for token in program.tokens:
		match token.kind:
			IdentifierToken(id):
				ids = ids.append(id)
			_:
				void
	ids


private ECHO_SOURCE: String = "func echo(value: Int) -> Int:\n    value\n"


pure func test_one_spelling_lexes_to_one_identity() -> Bool:
	match lex(module_source(root_module_id()), ECHO_SOURCE, program_names().names):
		Err(_):
			False
		Ok(program):
			match identifier_ids(program):
				[function, parameter, parameter_type, return_type, value]:
					match same_name(parameter, value):
						False: False
						True:
							match same_name(parameter_type, return_type):
								False: False
								True:
									match not(same_name(function, parameter)):
										False: False
										True:
											match not(same_name(parameter, parameter_type)):
												False: False
												True:
													match name_spelling(program.names, parameter):
														Some("value"):
															match name_spelling(program.names, parameter_type):
																Some("Int"):
																	True
																_: False
														_: False
				_:
					False


-- Each spelling of the first source keeps its ID and spelling in the second
-- source's table; only new spellings get new IDs.
private pure func extends_without_renumbering(first: LexedProgram, second: LexedProgram) -> Bool:
	var kept: Bool = same_name_table(second.base_names, first.names)
	for id in identifier_ids(first):
		kept = match kept:
			False: False
			True:
				match (name_spelling(second.names, id), name_spelling(first.names, id)):
					(Some(actual), Some(expected)): StringOps.equals(actual, expected)
					(None, None): True
					_: False
	match identifier_ids(second):
		[function, parameter, parameter_type, return_type, value]:
			match kept:
				False: False
				True:
					match same_name(parameter, value):
						False: False
						True:
							match same_name(parameter_type, return_type):
								False: False
								True:
									match name_spelling(second.names, function):
										Some("twice"):
											match name_spelling(first.names, function):
												None:
													match name_spelling(second.names, parameter):
														Some("value"):
															True
														_: False
												_: False
										_: False
		_:
			False


pure func test_sequential_sources_share_and_extend_identities() -> Bool:
	match lex(module_source(root_module_id()), ECHO_SOURCE, program_names().names):
		Err(_):
			False
		Ok(first):
			match lex(module_source(root_module_id()), "func twice(value: Int) -> Int:\n    value\n", first.names):
				Err(_):
					False
				Ok(second):
					match (identifier_ids(first), identifier_ids(second)):
						([_, first_value, first_int, _, _], [_, second_value, second_int, _, _]):
							match extends_without_renumbering(first, second):
								False: False
								True:
									match same_name(first_value, second_value):
										False: False
										True:
											same_name(first_int, second_int)
						_:
							False


tests: TestSuite = {
	description = "Blorp 2 lexer",
	tests = [
		("braces preserve record field token spans", test_braces_preserve_record_field_token_spans),
		(
			"brackets preserve independent token spans",
			test_brackets_preserve_independent_token_spans,
		),
		(
			"quoted token rejects newline and preserves escapes and UTF-8",
			test_builtin_label_rejects_newline_escape_and_non_ascii,
		),
		("builtin label requires a closing quote", test_builtin_label_requires_closing_quote),
		("builtin label preserves bytes and span", test_builtin_label_preserves_bytes_and_span),
		("binding symbols and var word boundary", test_binding_symbols_and_var_word_boundary),
		("record update bar preserves its token span", test_record_update_bar_preserves_its_token_span),
		("match wildcard and prefix identifiers", test_match_wildcard_and_prefix_identifiers),
		("space levels and invalid prefixes", test_space_levels_and_invalid_prefixes),
		("dedents close each level at the shallower line", test_dedents_close_each_level_at_the_shallower_line),
		("indentation may open several levels at once", test_indentation_may_open_several_levels_at_once),
		("dedent must land on an open level", test_dedent_must_land_on_an_open_level),
		("closing dedents are empty at EOF after trailing whitespace", test_closing_dedents_are_empty_at_eof_after_trailing_whitespace),
		("spacing records a preceding space", test_spacing_records_whether_a_space_precedes_each_token),
		("dot after integer needs a name or fraction digits", test_dot_after_integer_needs_a_name_or_fraction_digits),
		("dot separates receiver and function name", test_dot_separates_receiver_and_function_name),
		("comma separates arguments", test_comma_separates_arguments),
		("pure keyword and maximal identifier", test_pure_keyword_and_maximal_identifier),
		("tab-indented program", test_tab_indented_program),
		("space-indented program without final LF", test_space_indented_program_without_final_lf),
		("blank LF has no layout token", test_blank_newline_has_no_layout_token),
		("whitespace at EOF has no layout token", test_whitespace_at_eof_has_no_layout_token),
		("empty input", test_empty_input),
		("raw decimal run preserves spelling", test_raw_decimal_run_preserves_spelling),
		(
			"question equals is one token",
			test_question_equals_is_one_token,
		),
		(
			"signed runs and arrow have independent tokens",
			test_signed_runs_and_arrow_have_independent_tokens,
		),
		("minus requires adjacent digits", test_minus_requires_adjacent_digits),
		("mixed indentation diagnostic", test_mixed_indentation_diagnostic),
		("CR line ending diagnostic", test_cr_line_ending_diagnostic),
		("one spelling lexes to one identity", test_one_spelling_lexes_to_one_identity),
		("sequential sources share and extend identities", test_sequential_sources_share_and_extend_identities),
	]
}
