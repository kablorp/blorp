import:
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/lex/lex: lex
	../../../src/utils/text as Text
	string as StringOps
	int as IntOps
	option: is_none
	test: TestSuite
	../test_lex/test_lex: trace


private pure func rejects(
	source: String,
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names):
		Ok(_):
			False
		Err(error):
			match IntOps.equals(error.span.start, start):
				False: False
				True:
					match IntOps.equals(error.span.end, end):
						False: False
						True:
							match StringOps.equals(error.message, message):
								False: False
								True:
									match StringOps.equals(error.help, help):
										False: False
										True:
											error.note.is_none()


pure func test_empty_and_blank_sources_have_only_eof() -> Bool:
	match StringOps.equals(trace(""), "EOF@0:0"):
		False: False
		True:
			StringOps.equals(trace("\n\n\n"), "EOF@3:3")


pure func test_leading_and_trailing_blank_lines_preserve_spans() -> Bool:
	StringOps.equals(trace("\n\n0\n\n"), "integer=0@2:3\nLF@3:4\nEOF@5:5")


pure func test_whitespace_only_lines_ignore_incidental_indentation() -> Bool:
	StringOps.equals(trace("\t \n \t\n    "), "EOF@10:10")


pure func test_comment_prefix_is_an_ordinary_line_comment() -> Bool:
	StringOps.equals(trace("--\n----\n"), "EOF@8:8")


pure func test_comment_indentation_does_not_change_layout() -> Bool:
	StringOps.equals(trace("0\n--\n\t\t --\n\t1\n"), "integer=0@0:1\nLF@1:2\nINDENT@11:12\ninteger=1@12:13\nLF@13:14\nDEDENT@14:14\nEOF@14:14")


pure func test_inline_comment_keeps_newline_and_accepts_eof() -> Bool:
	StringOps.equals(trace("0--\n1--"), "integer=0@0:1\nLF@3:4\ninteger=1@4:5\nLF@7:7\nEOF@7:7")


pure func test_comments_do_not_join_code_lines() -> Bool:
	StringOps.equals(trace("one--x\n(two)"), "name=one@0:3\nLF@6:7\n(@7:8\nname=two@8:11\n)@11:12\nLF@12:12\nEOF@12:12")


pure func test_arrow_and_signed_integer_keep_precedence() -> Bool:
	StringOps.equals(trace("-> -42--42\n-0"), "->@0:2\ninteger=-42@3:6\nLF@10:11\ninteger=-0@11:13\nLF@13:13\nEOF@13:13")


pure func test_comment_may_contain_ascii_punctuation_and_tab() -> Bool:
	StringOps.equals(trace("-- \t@#\"\\{}[]+-=*/\n0"), "integer=0@18:19\nLF@19:19\nEOF@19:19")


pure func test_comment_accepts_ascii_range_endpoints() -> Bool:
	match StringOps.from_codepoint(0):
		None: False
		Some(nul_text):
			match StringOps.from_codepoint(127):
				None: False
				Some(del_text):
					source = Text.concat(
						Text.concat("--", nul_text),
						Text.concat(del_text, "\n0"),
					)
					StringOps.equals(trace(source), "integer=0@5:6\nLF@6:6\nEOF@6:6")

pure func test_cr_in_comment_retains_original_error_span() -> Bool:
	rejects(
		"--a\r\n",
		3,
		4,
		"only LF line endings are supported",
		"replace CRLF or CR line endings with LF",
	)


pure func test_non_ascii_in_comment_is_rejected_at_its_first_byte() -> Bool:
	rejects("--é", 2, 3, "unsupported byte in comment", "use ASCII bytes in single-line comments")


pure func test_error_after_trivia_uses_original_source_offsets() -> Bool:
	rejects(
		"--x\n\n  0",
		5,
		7,
		"invalid indentation",
		"use tabs only, or spaces in groups of four; do not mix tabs and spaces",
	)


pure func test_inline_comment_does_not_hide_later_bad_indentation() -> Bool:
	rejects(
		"0--x\n\t 1",
		5,
		7,
		"invalid indentation",
		"use tabs only, or spaces in groups of four; do not mix tabs and spaces",
	)


pure func test_final_comment_does_not_require_newline() -> Bool:
	StringOps.equals(trace("\t -- final"), "EOF@10:10")


tests: TestSuite = {
	description = "Blorp 2 lexical trivia",
	tests = [
		("empty and blank sources have only EOF", test_empty_and_blank_sources_have_only_eof),
		(
			"leading and trailing blanks retain spans",
			test_leading_and_trailing_blank_lines_preserve_spans,
		),
		(
			"whitespace-only lines ignore indentation",
			test_whitespace_only_lines_ignore_incidental_indentation,
		),
		(
			"comment prefix has ordinary line behavior",
			test_comment_prefix_is_an_ordinary_line_comment,
		),
		(
			"comment indentation leaves layout unchanged",
			test_comment_indentation_does_not_change_layout,
		),
		(
			"inline comments keep LF and allow EOF",
			test_inline_comment_keeps_newline_and_accepts_eof,
		),
		("comments cannot join code lines", test_comments_do_not_join_code_lines),
		("arrow and signed integer precedence", test_arrow_and_signed_integer_keep_precedence),
		(
			"comment accepts ASCII punctuation and tab",
			test_comment_may_contain_ascii_punctuation_and_tab,
		),
		("CR inside comment keeps its byte span", test_cr_in_comment_retains_original_error_span),
		("comment accepts NUL and DEL bytes", test_comment_accepts_ascii_range_endpoints),
		(
			"non-ASCII comment byte is rejected",
			test_non_ascii_in_comment_is_rejected_at_its_first_byte,
		),
		(
			"error after trivia keeps source offsets",
			test_error_after_trivia_uses_original_source_offsets,
		),
		(
			"inline comment cannot hide bad indentation",
			test_inline_comment_does_not_hide_later_bad_indentation,
		),
		("final comment needs no LF", test_final_comment_does_not_require_newline),
	]
}
