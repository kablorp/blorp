import:
	string as StringOps
	../../../src/utils/names: program_names
	system: read_file
	io: print
	../../../src/lex/lex: lex
	../../../src/runtime/string: string_equals_runtime, string_parse_int_runtime, string_print_runtime, string_runtime, STRING_SLICE_RUNTIME, STRING_PRINT_ERROR_RUNTIME
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: TokenKind(PipeString)
	test: TestSuite


-- The pilot's runtime C text is written as raw pipe Strings. The pilot's
-- lexer must read those literals to the same bytes the host compiles them
-- to, or the emitted runtime would differ between host and pilot builds.
private STRING_RUNTIME_SOURCE: String = "blorp_2/src/runtime/string.brp"


private pure func pipe_values(source: String) -> List[String]:
	match lex(module_source(root_module_id()), source, program_names().names):
		Err(_):
			[]
		Ok(program):
			var values: List[String] = []

			for token in program.tokens:
				match token.kind:
					PipeString(value):
						values = values.append(value)
					_:
						void

			values


func test_string_runtime_literals_round_trip() -> Bool:
	match read_file(STRING_RUNTIME_SOURCE):
		Err(error):
			print(error)
			False
		Ok(source):
			match pipe_values(source):
				[actual_runtime, actual_slice, actual_error, actual_print, actual_parse, actual_equals]:
					match StringOps.equals(actual_runtime, string_runtime()):
						False: False
						True:
							match StringOps.equals(actual_slice, STRING_SLICE_RUNTIME):
								False: False
								True:
									match StringOps.equals(actual_error, STRING_PRINT_ERROR_RUNTIME):
										False: False
										True:
											match StringOps.equals(actual_print, string_print_runtime()):
												False: False
												True:
													match StringOps.equals(actual_parse, string_parse_int_runtime()):
														False: False
														True:
															StringOps.equals(actual_equals, string_equals_runtime())
				_: False


tests: TestSuite = {
	description = "Blorp 2 runtime text round trip",
	tests = [
		("string runtime literals lex to the host-compiled bytes", test_string_runtime_literals_round_trip),
	]
}
