import:
	test: TestSuite
	../test_lex/test_lex: trace
	../../../src/lex/lex: lex
	../../../src/utils/names: program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: TokenKind(SymbolToken), keyword_spelling


-- Every word the host reserves is a symbol token; longer or prefixed
-- spellings, and the words the host leaves as names, remain identifiers.
pure func test_expression_words_are_symbols() -> Bool:
	trace("if else and or not") == "if@0:2\nelse@3:7\nand@8:11\nor@12:14\nnot@15:18\nLF@18:18\nEOF@18:18"


pure func test_loop_words_are_symbols() -> Bool:
	trace("while for in break continue") == "while@0:5\nfor@6:9\nin@10:12\nbreak@13:18\ncontinue@19:27\nLF@27:27\nEOF@27:27"


pure func test_declaration_words_are_symbols() -> Bool:
	(
		trace("import type private record union") == "import@0:6\ntype@7:11\nprivate@12:19\nrecord@20:26\nunion@27:32\nLF@32:32\nEOF@32:32"
		and trace("builtin as opaque into_opaque from_opaque") == "builtin@0:7\nas@8:10\nopaque@11:17\ninto_opaque@18:29\nfrom_opaque@30:41\nLF@41:41\nEOF@41:41"
	)


-- The host reserves these for forms this compiler does not read.
pure func test_unread_form_words_are_symbols() -> Bool:
	(
		trace("alias debug detach foreign from implements") == "alias@0:5\ndebug@6:11\ndetach@12:18\nforeign@19:26\nfrom@27:31\nimplements@32:42\nLF@42:42\nEOF@42:42"
		and trace("resource select trait try where") == "resource@0:8\nselect@9:15\ntrait@16:21\ntry@22:25\nwhere@26:31\nLF@31:31\nEOF@31:31"
	)


pure func test_unreserved_words_remain_identifiers() -> Bool:
	(
		trace("iffy _if in2 format") == "name=iffy@0:4\nname=_if@5:8\nname=in2@9:12\nname=format@13:19\nLF@19:19\nEOF@19:19"
		and trace("after concurrent on sealed with") == "name=after@0:5\nname=concurrent@6:16\nname=on@17:19\nname=sealed@20:26\nname=with@27:31\nLF@31:31\nEOF@31:31"
		and trace("fixed methods_only tail_recursive raw True") == "name=fixed@0:5\nname=methods_only@6:18\nname=tail_recursive@19:33\nname=raw@34:37\nname=True@38:42\nLF@42:42\nEOF@42:42"
	)


-- `keyword_spelling` is the inverse of the lexer's keyword table: every
-- reserved spelling lexes to the symbol that spells it back.
pure func test_keyword_spellings_round_trip() -> Bool:
	spellings = [
		"func", "pure", "match", "var", "void", "if", "else", "and", "or", "not", "while", "for", "in", "break",
		"continue", "import", "type", "private", "record", "union", "builtin", "as", "opaque", "into_opaque",
		"from_opaque", "alias", "debug", "detach", "foreign", "from", "implements", "resource", "select", "trait",
		"try", "where",
	]
	spellings.all(pure func(spelling): lexes_to_keyword(spelling))


private pure func lexes_to_keyword(spelling: String) -> Bool:
	match lex(module_source(root_module_id()), spelling, program_names().names):
		Err(_):
			False
		Ok(program):
			match program.tokens:
				[first, _]:
					match first.kind:
						SymbolToken(symbol):
							keyword_spelling(symbol) == Some(spelling)
						_:
							False
				_:
					False


tests: TestSuite = {
	description = "Blorp 2 reserved words",
	tests = [
		("expression words are symbols", test_expression_words_are_symbols),
		("loop words are symbols", test_loop_words_are_symbols),
		("declaration words are symbols", test_declaration_words_are_symbols),
		("unread form words are symbols", test_unread_form_words_are_symbols),
		("unreserved words remain identifiers", test_unreserved_words_remain_identifiers),
		("keyword spellings round-trip", test_keyword_spellings_round_trip),
	]
}
