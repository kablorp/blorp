import:
    ./test_lex: trace
    bool: and
    list: List methods
    test: TestSuite


-- The two-byte forms win over their one-byte prefixes, and adjacency needs no
-- spaces on either side.
pure func test_ordering_symbols_have_exact_spans() -> Bool:
    trace("a<b a>b a<=b a>=b") == "name=a@0:1\n<@1:2\nname=b@2:3\nname=a@4:5\n>@5:6\nname=b@6:7\nname=a@8:9\n<=@9:11\nname=b@11:12\nname=a@13:14\n>=@14:16\nname=b@16:17\nLF@17:17\nEOF@17:17"


-- `->` is recognized before `>`, and `<-1` is `<` followed by a negative literal.
pure func test_arrow_and_negative_literals_are_unaffected() -> Bool:
    and(
        trace("-> a<-1 a>-1") == "->@0:2\nname=a@3:4\n<@4:5\ninteger=-1@5:7\nname=a@8:9\n>@9:10\ninteger=-1@10:12\nLF@12:12\nEOF@12:12",
        trace("a->b") == "name=a@0:1\n->@1:3\nname=b@3:4\nLF@4:4\nEOF@4:4",
    )


-- A hole lexes ordinary code tokens; text, Chars, pipe strings and comments
-- keep angle brackets as their contents.
pure func test_literals_and_comments_keep_angle_brackets() -> Bool:
    pipe: String =
        |x =
        |    |a < b >= c
        |
    and(
        and(
            trace("\"$".add("{a < b}\"")) =="string-start@0:1\nhole-open@1:3\nname=a@3:4\n<@5:6\nname=b@7:8\nhole-close@8:9\nstring-end@9:10\nLF@10:10\nEOF@10:10",
            trace("\"a <= b\" '<' -- x >= y") == "quoted=a <= b@0:8\nchar@9:12\nLF@22:22\nEOF@22:22",
        ),
        trace(pipe) == "name=x@0:1\n=@2:3\nLF@3:4\nINDENT@4:8\npipe=a < b >= c@8:19\nLF@19:20\nDEDENT@20:20\nEOF@20:20",
    )


pure func test_lambda_arrow_spelling_teaches_both_forms() -> Bool:
    and(
        trace("a => b") == "error@2:4\n'=>' is not an operator\nwrite '>=' to compare, or 'func(x): expr' for a lambda",
        trace("a=>b") == "error@1:3\n'=>' is not an operator\nwrite '>=' to compare, or 'func(x): expr' for a lambda",
    )


pure func test_reversed_at_most_spelling_is_rejected() -> Bool:
    trace("a =< b") == "error@2:4\n'=<' is not an operator\nwrite '<='"


pure func test_angle_inequality_spelling_is_rejected() -> Bool:
    trace("a <> b") == "error@2:4\n'<>' is not an operator\nwrite '!=' for inequality"


-- No other spelling changes: equality and assignment keep their tokens, and a
-- doubled angle is two ordinary tokens for the parser to reject.
pure func test_neighbouring_spellings_keep_their_tokens() -> Bool:
    and(
        trace("a==b c=d e<<f g>>h") == "name=a@0:1\n==@1:3\nname=b@3:4\nname=c@5:6\n=@6:7\nname=d@7:8\nname=e@9:10\n<@10:11\n<@11:12\nname=f@12:13\nname=g@14:15\n>@15:16\n>@16:17\nname=h@17:18\nLF@18:18\nEOF@18:18",
        trace("a<==b >==c") == "name=a@0:1\n<=@1:3\n=@3:4\nname=b@4:5\n>=@6:8\n=@8:9\nname=c@9:10\nLF@10:10\nEOF@10:10",
    )


tests: TestSuite = {
    description = "ordering operator punctuation",
    tests = [
        ("ordering symbols have exact spans", test_ordering_symbols_have_exact_spans),
        ("arrow and negative literals are unaffected", test_arrow_and_negative_literals_are_unaffected),
        ("literals and comments keep angle brackets", test_literals_and_comments_keep_angle_brackets),
        ("'=>' teaches comparison and lambda forms", test_lambda_arrow_spelling_teaches_both_forms),
        ("'=<' teaches '<='", test_reversed_at_most_spelling_is_rejected),
        ("'<>' teaches '!='", test_angle_inequality_spelling_is_rejected),
        ("neighbouring spellings keep their tokens", test_neighbouring_spellings_keep_their_tokens),
    ]
}
