import:
	string as StringOps
	int as IntOps
	../../../src/utils/names: program_names
	../../../src/lex/lex: lex
	../../../src/utils/source: module_source, root_module_id
	test: TestSuite
	../test_lex/test_lex: trace


private ONE_CHARACTER: String = "Char literals hold one character"

private ONE_CHARACTER_HELP: String = "write one character or one escape between single quotes, such as 'a' or '\\n'"


private pure func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names):
		Ok(_):
			False
		Err(error):
			match IntOps.equals(error.span.start, start):
				False: False
				True:
					match IntOps.equals(error.span.end, end):
						False: False
						True:
							match StringOps.equals(error.message, message):
								False: False
								True:
									StringOps.equals(error.help, help)


-- A Char literal token spans its quotes and one character or escape pair;
-- it carries no contents until a Char type reads them.
pure func test_char_literal_holds_one_character() -> Bool:
	StringOps.equals(trace("'a' 'é'"), "char@0:3\nchar@4:8\nLF@8:8\nEOF@8:8")


pure func test_escape_pairs_span_two_bytes() -> Bool:
	StringOps.equals(trace("'\\n' '\\'' '\\\\' '\\0'"), "char@0:4\nchar@5:9\nchar@10:14\nchar@15:19\nLF@19:19\nEOF@19:19")


pure func test_empty_quotes_are_rejected() -> Bool:
	rejects("''", 0, 2, ONE_CHARACTER, ONE_CHARACTER_HELP)


pure func test_two_characters_are_rejected() -> Bool:
	rejects("'ab'", 0, 3, ONE_CHARACTER, ONE_CHARACTER_HELP)


pure func test_unterminated_char_is_rejected_at_the_line_end() -> Bool:
	match rejects("'a", 0, 2, "unterminated Char literal", "add the closing single quote on the same line"):
		False: False
		True:
			match rejects("'a\n'", 0, 2, "unterminated Char literal", "add the closing single quote on the same line"):
				False: False
				True:
					rejects("'\\", 0, 2, "unterminated Char literal", "add the closing single quote on the same line")


pure func test_control_byte_in_char_is_rejected() -> Bool:
	rejects("'\t'", 1, 2, "unsupported raw byte in Char literal", "use a printable character or a fixed escape such as '\\t'")


tests: TestSuite = {
	description = "Blorp 2 Char literal tokens",
	tests = [
		("char literal holds one character", test_char_literal_holds_one_character),
		("escape pairs span two bytes", test_escape_pairs_span_two_bytes),
		("empty quotes are rejected", test_empty_quotes_are_rejected),
		("two characters are rejected", test_two_characters_are_rejected),
		("unterminated char is rejected at the line end", test_unterminated_char_is_rejected_at_the_line_end),
		("control byte in char is rejected", test_control_byte_in_char_is_rejected),
	]
}
