import:
	string as StringOps
	int as IntOps
	../../../src/utils/names: program_names
	../../../src/lex/lex: lex
	../../../src/utils/source: module_source, root_module_id
	test: TestSuite
	../test_lex/test_lex: trace
	../../../src/utils/text as Text
	-- TODO: missing byte-input/encoding boundary; target String is valid UTF-8.
	-- bytes as BytesOps


-- The host reads `${` in a quoted String as interpolation; the source under
-- test is built from two halves.
private pure func opener() -> String:
	Text.concat("$", "{")


-- A continuation byte with no lead is invalid UTF-8 wherever it appears.
-- TODO: deferred until a byte-input/encoding boundary can supply invalid UTF-8.
-- private pure func lone_continuation_byte() -> String:
-- 	BytesOps.bytes(1).set_index(0, 128).to_string()


private pure func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names):
		Ok(_):
			False
		Err(error):
			match IntOps.equals(error.span.start, start):
				False: False
				True:
					match IntOps.equals(error.span.end, end):
						False: False
						True:
							match StringOps.equals(error.message, message):
								False: False
								True: StringOps.equals(error.help, help)


-- A `|` first on a code line starts a pipe String: each line's text after
-- its marker, joined with LF, with no escapes. The token ends before the
-- last line's LF, which remains the line's Newline.
pure func test_pipe_lines_join_with_lf() -> Bool:
	StringOps.equals(trace("|a\n|b\n"), "pipe=a\nb@0:5\nLF@5:6\nEOF@6:6")


pure func test_trailing_empty_marker_line_ends_the_value_with_lf() -> Bool:
	StringOps.equals(trace("|a\n|\n"), "pipe=a\n@0:4\nLF@4:5\nEOF@5:5")


pure func test_double_marker_is_one_bar() -> Bool:
	StringOps.equals(trace("||a\n"), "pipe=|a@0:3\nLF@3:4\nEOF@4:4")


pure func test_backslashes_quotes_and_tabs_are_verbatim() -> Bool:
	StringOps.equals(trace("|a\\n\"\t'\n"), "pipe=a\\n\"\t'@0:7\nLF@7:8\nEOF@8:8")


pure func test_empty_pipe_line_at_end_of_source() -> Bool:
	StringOps.equals(trace("|"), "pipe=@0:1\nLF@1:1\nEOF@1:1")


pure func test_marker_indentation_must_match_the_first_line() -> Bool:
	StringOps.equals(trace("|a\n\t|b"), "pipe=a@0:2\nLF@2:3\nINDENT@3:4\npipe=b@4:6\nLF@6:6\nDEDENT@6:6\nEOF@6:6")


-- The same indentation width with different bytes is not a continuation;
-- the one-space line is then an ordinary line with invalid indentation.
pure func test_continuation_needs_the_same_indentation_bytes() -> Bool:
	rejects("f\n\t|a\n |b", 6, 7, "invalid indentation", "use tabs only, or spaces in groups of four; do not mix tabs and spaces")


pure func test_pipe_string_may_follow_a_header_line() -> Bool:
	StringOps.equals(trace("f\n\t|a\n\t|b\n"), "name=f@0:1\nLF@1:2\nINDENT@2:3\npipe=a\nb@3:9\nLF@9:10\nDEDENT@10:10\nEOF@10:10")


-- `raw` alone on a line, followed by a marker line, starts a raw pipe String:
-- `||` stays two bytes and `${` is text.
pure func test_raw_block_keeps_double_markers_and_openers() -> Bool:
	source = Text.concat(Text.concat("raw\n\t|#a\n\t||b", opener()), "\n\t|\n")
	StringOps.equals(trace(source), Text.concat(Text.concat("pipe=#a\n|b", opener()), "\n@0:18\nLF@18:19\nEOF@19:19"))


pure func test_raw_word_without_marker_line_is_an_identifier() -> Bool:
	StringOps.equals(trace("raw\n0"), "name=raw@0:3\nLF@3:4\ninteger=0@4:5\nLF@5:5\nEOF@5:5")


pure func test_raw_word_may_carry_trailing_spaces() -> Bool:
	StringOps.equals(trace("raw  \n|a\n"), "pipe=a@0:8\nLF@8:9\nEOF@9:9")


pure func test_pipe_interpolation_has_flat_source_located_tokens() -> Bool:
	StringOps.equals(trace(Text.concat(Text.concat("|a", opener()), "b}\n")), "string-start@0:1\nsegment=a@1:2\nhole-open@2:4\nname=b@4:5\nhole-close@5:6\nstring-end@6:6\nLF@6:7\nEOF@7:7")


pure func test_control_byte_in_a_pipe_line_is_rejected() -> Bool:
	rejects("|a\u{1}\n", 2, 3, "unsupported raw byte in String literal", "use printable text and fixed escapes for control bytes")


pure func test_cr_in_a_pipe_line_is_rejected() -> Bool:
	rejects("|a\r\n", 2, 3, "unsupported raw byte in String literal", "use printable text and fixed escapes for control bytes")


-- TODO: deferred until a byte-input/encoding boundary can supply invalid UTF-8.
-- pure func test_invalid_utf8_in_a_pipe_line_is_rejected() -> Bool:
-- 	rejects(Text.concat("|a", lone_continuation_byte()), 2, 3, "invalid UTF-8 in String literal", "use valid UTF-8 text or a Unicode escape such as \\u{E9}; surrogate code points are not Unicode scalars")


tests: TestSuite = {
	description = "Blorp 2 pipe String literals",
	tests = [
		("pipe lines join with LF", test_pipe_lines_join_with_lf),
		("trailing empty marker line ends the value with LF", test_trailing_empty_marker_line_ends_the_value_with_lf),
		("double marker is one bar", test_double_marker_is_one_bar),
		("backslashes, quotes and tabs are verbatim", test_backslashes_quotes_and_tabs_are_verbatim),
		("empty pipe line at end of source", test_empty_pipe_line_at_end_of_source),
		("marker indentation must match the first line", test_marker_indentation_must_match_the_first_line),
		("continuation needs the same indentation bytes", test_continuation_needs_the_same_indentation_bytes),
		("pipe string may follow a header line", test_pipe_string_may_follow_a_header_line),
		("raw block keeps double markers and openers", test_raw_block_keeps_double_markers_and_openers),
		("raw word without marker line is an identifier", test_raw_word_without_marker_line_is_an_identifier),
		("raw word may carry trailing spaces", test_raw_word_may_carry_trailing_spaces),
		("pipe interpolation has flat source located tokens", test_pipe_interpolation_has_flat_source_located_tokens),
		("control byte in a pipe line is rejected", test_control_byte_in_a_pipe_line_is_rejected),
		("CR in a pipe line is rejected", test_cr_in_a_pipe_line_is_rejected),
		-- TODO: missing byte-input/encoding boundary; deferred, not counted.
		-- ("invalid UTF-8 in a pipe line is rejected", test_invalid_utf8_in_a_pipe_line_is_rejected),
	]
}
