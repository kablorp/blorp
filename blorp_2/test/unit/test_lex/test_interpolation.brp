import:
	../../../src/lex/lex: lex
	../../../src/utils/names: name_spelling, program_names
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: TokenKind(IdentifierToken)
	../../../src/utils/text as Text: concat
	option: get_or
	test: TestSuite


private pure func opener() -> String:
	Text.concat("$", "{")


pure func test_quoted_hole_identifiers_use_the_normal_name_table() -> Bool:
	source = "\"a".concat(opener()).concat("value}b\"")
	match lex(module_source(root_module_id()), source, program_names().names):
		Err(_): False
		Ok(program):
			var found: Bool = False
			for token in program.tokens:
				match token.kind:
					IdentifierToken(id):
						found = name_spelling(program.names, id) == Some("value") and token.span.start == 4 and token.span.end == 9
					_: void
			found


pure func test_pipe_holes_keep_original_line_offsets() -> Bool:
	source = "|a".concat(opener()).concat("value}\n|b").concat(opener()).concat("other}")
	match lex(module_source(root_module_id()), source, program_names().names):
		Err(_): False
		Ok(program):
			var names: List[String] = []
			var starts: List[Int] = []
			for token in program.tokens:
				match token.kind:
					IdentifierToken(id):
						names = names.append(name_spelling(program.names, id).get_or(""))
						starts = starts.append(token.span.start)
					_: void
			names == ["value", "other"] and starts == [4, 15]


tests: TestSuite = {
	description = "Blorp 2 interpolation token boundaries",
	tests = [
		("quoted hole identifiers use the normal name table", test_quoted_hole_identifiers_use_the_normal_name_table),
		("pipe holes keep original line offsets", test_pipe_holes_keep_original_line_offsets),
	]
}
