import:
	./test_lex: trace
	../../../src/lex/lex: lex
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/names: program_names
	../../../src/utils/syntax: Symbol(EqualsEquals, NotEquals), TokenKind(SymbolToken)
	test: TestSuite


pure func test_adjacent_equality_punctuation() -> Bool:
	trace("a==b!=c") == "name=a@0:1\n==@1:3\nname=b@3:4\n!=@4:6\nname=c@6:7\nLF@7:7\nEOF@7:7"


pure func test_assignment_and_propagation_remain_distinct() -> Bool:
	trace("x=1?=2==3!=4") == "name=x@0:1\n=@1:2\ninteger=1@2:3\n?=@3:5\ninteger=2@5:6\n==@6:8\ninteger=3@8:9\n!=@9:11\ninteger=4@11:12\nLF@12:12\nEOF@12:12"


pure func test_comments_strings_and_chars_do_not_make_operators() -> Bool:
	trace("\"==!=\" '!' -- == !=\n") == "quoted===!=@0:6\nchar@7:10\nLF@19:20\nEOF@20:20"


pure func test_interpolation_has_ordinary_equality_tokens() -> Bool:
	match lex(module_source(root_module_id()), "\"$" + "{a==b} !=\"", program_names().names):
		Err(_): False
		Ok(program):
			operators = program.tokens.filter(pure func(token):
				match token.kind:
					SymbolToken(EqualsEquals) | SymbolToken(NotEquals): True
					_: False
			)
			match operators:
				[token]: token.span.start == 4 and token.span.end == 6
				_: False


pure func test_lone_and_separated_exclamation_are_located_errors() -> Bool:
	["!", "! ="].all(pure func(source):
		trace(source) == "error@0:1\nunsupported character\nuse ASCII function declarations and numeric literals, parameter names, or calls; keep -> adjacent"
	)


pure func test_eof_and_extra_equals_preserve_token_boundaries() -> Bool:
	trace("===!==") == "==@0:2\n=@2:3\n!=@3:5\n=@5:6\nLF@6:6\nEOF@6:6"


tests: TestSuite = {
	description = "equality operator punctuation",
	tests = [
		("adjacent equality symbols have exact spans", test_adjacent_equality_punctuation),
		("assignment and propagation remain distinct", test_assignment_and_propagation_remain_distinct),
		("comments strings and chars preserve punctuation", test_comments_strings_and_chars_do_not_make_operators),
		("interpolation has ordinary equality tokens", test_interpolation_has_ordinary_equality_tokens),
		("lone and separated exclamation diagnostics", test_lone_and_separated_exclamation_are_located_errors),
		("EOF and extra equals token boundaries", test_eof_and_extra_equals_preserve_token_boundaries),
	]
}
