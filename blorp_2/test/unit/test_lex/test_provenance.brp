import:
	../../../src/lex/lex: lex
	../../../src/utils/source:
		COMPILER_SOURCE,
		SourceId,
		module_id,
		module_number,
		module_source,
		root_module_id,
		same_source,
	../../../src/utils/syntax: Span
	test: TestSuite


private pure func exact_span(span: Span, origin: SourceId, start: Int, end: Int) -> Bool:
	same_source(span.source, origin) and span.start == start and span.end == end


private pure func with_module_origins(check: pure (SourceId, SourceId) -> Bool) -> Bool:
	match module_id(module_number(root_module_id()) + 1):
		None:
			False
		Some(dependency):
			check(module_source(root_module_id()), module_source(dependency))


pure func test_identical_module_bytes_have_distinct_origins() -> Bool:
	with_module_origins(pure func(first_origin: SourceId, second_origin: SourceId) -> Bool:
		match lex(first_origin, "42"):
			Err(_):
				False
			Ok(first):
				match lex(second_origin, "42"):
					Err(_):
						False
					Ok(second):
						match first.tokens:
							[first_token, _]:
								match second.tokens:
									[second_token, _]:
										(
											not same_source(first_token.span.source, second_token.span.source)
											and exact_span(first_token.span, first_origin, 0, 2)
											and exact_span(second_token.span, second_origin, 0, 2)
											and exact_span(first.end, first_origin, 2, 2)
											and exact_span(second.end, second_origin, 2, 2)
										)
									_:
										False
							_:
								False
	)


pure func test_lexical_errors_keep_the_explicit_origin() -> Bool:
	with_module_origins(pure func(first_origin: SourceId, second_origin: SourceId) -> Bool:
		var passed = True

		for origin in [first_origin, second_origin, COMPILER_SOURCE]:
			passed = passed and match lex(origin, "42$"):
				Err(error):
					(
						exact_span(error.span, origin, 2, 3)
						and error.message == "unsupported character"
						and error.help == "use ASCII function declarations and numeric literals, parameter names, or calls; keep -> adjacent"
					)
				Ok(_):
					False

		passed
	)


pure func test_empty_source_keeps_its_origin_at_eof() -> Bool:
	match lex(COMPILER_SOURCE, ""):
		Err(_):
			False
		Ok(program):
			program.tokens.length() == 0 and exact_span(program.end, COMPILER_SOURCE, 0, 0)




tests: TestSuite = {
	description = "Blorp 2 source provenance",
	tests = [
		("identical module bytes have distinct origins", test_identical_module_bytes_have_distinct_origins),
		("lexical errors keep the explicit origin", test_lexical_errors_keep_the_explicit_origin),
		("empty source keeps its origin at eof", test_empty_source_keeps_its_origin_at_eof),
	]
}
