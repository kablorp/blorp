import:
	../../src/check_model as Model
	../../src/check: CheckedProgram, check, check_errors, checked_functions
	../../src/check_errors as Errors
	../../src/check_render: render_failure
	../../src/declarations as Declaration
	../../src/lower as Lower
	../../src/own as Own
	../../src/builtins as Builtins
	../../src/source: module_source, root_module_id, same_source
	../../src/specialize as Concrete
	../../src/syntax:
		Diagnostic,
		FunctionExecution(OrdinaryCalls),
		Entrypoint(NoArguments),
		EntryResult(IntegerExitStatus),
	../../src/verify: verify
	input: setup_diagnostic
	list: set_index
	module_input: parse_modules
	ownership_inputs: InputIds, input_ids, span
	test: TestSuite


private UNION: String =
	|fixed union Answer:
	|    Different
	|    Identical
	|
private HEADER: String = "pure func compare(left: String, right: String) -> Answer:"
private LABEL: String = "\"string.equals\""
private BODY: String = "\n    builtin(\"string.equals\", Identical, Different)\n"
private MAIN: String =
	|func main() -> Int:
	|    0
	|
private COMPARISON_MAIN: String =
	|func main() -> Int:
	|    compared = compare("left", "right")
	|    0
	|


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules([{ source = source, targets = [] }])
	check(parsed).map_err(setup_diagnostic)


pure func test_checked_comparison_preserves_explicit_reversed_roles() -> Bool:
	match checked(UNION + HEADER + BODY + COMPARISON_MAIN):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match (function.signature.return_type.value_type, function.body):
						(Model.UnionType(owner), Model.CheckedValueBody(Model.ReturnExpression(value))):
							match value.base:
								Model.ReturnCall(call, [left, right]):
									match call.target:
										Model.RuntimeFunction(Builtins.StringEquals(roles)):
											Declaration.union_number(Declaration.variant_owner(roles.equal)) == Declaration.union_number(owner) and Declaration.union_number(Declaration.variant_owner(roles.different)) == Declaration.union_number(owner) and Declaration.variant_number(roles.equal) == 1 and Declaration.variant_number(roles.different) == 0 and Model.same_type(left.base_type, Model.StringType) and Model.same_type(right.base_type, Model.StringType)
										_: False
								_: False
						_: False
				_: False


pure func test_specialized_comparison_has_two_empty_unmanaged_roles() -> Bool:
	match checked(UNION + HEADER + BODY + COMPARISON_MAIN).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			contents = Concrete.specialized_contents(program)
			match contents.functions:
				[_, function]:
					match (function.signature.return_type, function.body):
						(Concrete.UnionType(owner), Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
							match (value.form, contents.unions.get(Concrete.union_number(owner))):
								(Concrete.InvokeFunction(call, [_, _]), Some(layout)):
									match (call.target, layout.variants, layout.representation):
										(Concrete.RuntimeFunction(Builtins.StringEquals(roles)), [[], []], Concrete.InlineUnmanaged):
											Concrete.union_number(Concrete.variant_owner(roles.equal)) == Concrete.union_number(owner) and Concrete.union_number(Concrete.variant_owner(roles.different)) == Concrete.union_number(owner) and Concrete.variant_number(roles.equal) == 1 and Concrete.variant_number(roles.different) == 0
										_: False
								_: False
						_: False
				_: False


pure func test_comparison_borrows_both_inputs_without_acquisition() -> Bool:
	match checked(UNION + HEADER + BODY + COMPARISON_MAIN).and_then(pure func(program): Concrete.specialize(program)).and_then(pure func(program): Lower.lower(program)):
		Err(_): False
		Ok(program):
			contents = Lower.lowered_functions(program)
			match contents.functions:
				[_, function]:
					match Own.insert_function(function, contents.unions, []):
						Err(_): False
						Ok(function):
							match (function.operations, function.tail):
								([Own.DefineValue(left), Own.DefineValue(right), Own.DefineValue(result)], Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(returned)))):
									match (left.result, right.result, result.operation, result.result):
										(Own.BorrowedResult(Own.ParameterBorrow(left_source)), Own.BorrowedResult(Own.ParameterBorrow(right_source)), Own.CallDefinition(_, [Own.BorrowedArgument(left_argument), Own.BorrowedArgument(right_argument)]), Own.UnmanagedResult):
											match (left_argument.source, right_argument.source):
												(Own.ParameterBorrow(left_borrow), Own.ParameterBorrow(right_borrow)):
													Lower.value_number(left_source) == 0 and Lower.value_number(right_source) == 1 and Lower.value_number(left_borrow) == 0 and Lower.value_number(right_borrow) == 1 and Lower.value_number(left_argument.value) == 0 and Lower.value_number(right_argument.value) == 1 and Lower.value_number(returned) == 2
												_: False
										_: False
								_: False
				_: False


private fixed union DiagnosticSite:
	BuiltinLabel
	EqualRole
	DifferentRole


private fixed union RoleError:
	PayloadError
	CoverageError
	OwnerError


private pure func rejects_roles(declaration: String, equal: String, different: String, expected: RoleError, site: DiagnosticSite, message: String, help: String) -> Bool:
	prefix = declaration + HEADER + "\n    builtin(" + LABEL
	(start, length) = match site:
		BuiltinLabel: (declaration.length() + HEADER.length() + "\n    builtin(".length(), LABEL.length())
		EqualRole: (prefix.length() + 2, equal.length())
		DifferentRole: (prefix.length() + 2 + equal.length() + 2, different.length())
	match parse_modules([{ source = prefix + ", " + equal + ", " + different + ")\n" + MAIN, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					kind_matches = match (check_errors(failure).first.kind, expected):
						(Errors.BuiltinRejection(Errors.BuiltinBooleanPayload), PayloadError): True
						(Errors.BuiltinRejection(Errors.BuiltinRoleCoverage), CoverageError): True
						(Errors.BuiltinRejection(Errors.BuiltinRoleNotInResult(_, Model.UnionType(_))), OwnerError): True
						_: False
					rendered = render_failure(failure)
					kind_matches and check_errors(failure).remaining.is_empty() and rendered.remaining.is_empty() and same_source(rendered.first.span.source, module_source(root_module_id())) and rendered.first.span.start == start and rendered.first.span.end == start + length and rendered.first.message == message and rendered.first.help == help and rendered.first.note.is_none()


pure func test_checker_rejects_payload_on_equal_role() -> Bool:
	declaration: String =
		|fixed union Answer:
		|    Different
		|    Identical(Int)
		|
	rejects_roles(declaration, "Identical", "Different", PayloadError, EqualRole, "comparison constructors must be empty", "declare two empty variants and bind the equal constructor first and the different constructor second")


pure func test_checker_rejects_payload_on_different_role() -> Bool:
	declaration: String =
		|fixed union Answer:
		|    Different(Int)
		|    Identical
		|
	rejects_roles(declaration, "Identical", "Different", PayloadError, DifferentRole, "comparison constructors must be empty", "declare two empty variants and bind the equal constructor first and the different constructor second")


pure func test_checker_rejects_comparison_role_from_other_owner() -> Bool:
	other: String =
		|fixed union Other:
		|    Elsewhere
		|
	rejects_roles(UNION + other, "Elsewhere", "Different", OwnerError, EqualRole, "builtin constructor does not belong to its result type", "import or declare this constructor in the annotated result union")


pure func test_checker_rejects_extra_comparison_variant() -> Bool:
	rejects_roles(UNION + "    Extra\n", "Identical", "Different", CoverageError, BuiltinLabel, "builtin constructors must cover the complete result union", "bind two distinct constructors and declare exactly those two variants")


pure func test_checker_rejects_duplicate_comparison_role() -> Bool:
	rejects_roles(UNION, "Identical", "Identical", CoverageError, BuiltinLabel, "builtin constructors must cover the complete result union", "bind two distinct constructors and declare exactly those two variants")


private fixed record Seed {
	ids: InputIds,
	roles: Builtins.BooleanRoles[Concrete.VariantInstanceId],
	other_roles: Builtins.BooleanRoles[Concrete.VariantInstanceId],
	unions: List[Concrete.ConcreteUnion]
}


private pure func seed_error() -> Diagnostic:
	{ span = span(0), note = None, message = "invalid comparison identity seed", help = "fix the comparison test seed" }


private pure func comparison_roles(function: Lower.LoweredFunction) -> Result[Builtins.BooleanRoles[Concrete.VariantInstanceId], Diagnostic]:
	match function.definitions:
		[_, _, result]:
			match result.operation:
				Lower.CallValue(call, [_, _]):
					match call.target:
						Concrete.RuntimeFunction(Builtins.StringEquals(roles)): Ok(roles)
						_: Err(seed_error())
				_: Err(seed_error())
		_: Err(seed_error())


-- Identity minting stops at Lower IR; raw verification below never consumes
-- an ownership inserter's result or repair.
private pure func seed() -> Result[Seed, Diagnostic]:
	other: String =
		|fixed union Other:
		|    No
		|    Yes
		|pure func compare_other(left: String, right: String) -> Other:
		|    builtin("string.equals", Yes, No)
		|
	ids ?= input_ids()
	main: String =
		|func main() -> Int:
		|    first = compare("left", "right")
		|    second = compare_other("left", "right")
		|    0
		|
	checked ?= checked(UNION + HEADER + BODY + other + main)
	concrete ?= Concrete.specialize(checked)
	lowered ?= Lower.lower(concrete)
	contents = Lower.lowered_functions(lowered)
	match contents.functions:
		[_, comparison, other]:
			roles ?= comparison_roles(comparison)
			other_roles ?= comparison_roles(other)
			Ok({ ids = ids, roles = roles, other_roles = other_roles, unions = contents.unions })
		_: Err(seed_error())


private pure func definition(id: Lower.ValueId, value_type: Concrete.TypeRef, operation: Own.OwnedValueOperation, result: Own.ResultOwnership, at: Int) -> Own.OwnershipOperation:
	Own.DefineValue({ id = id, value_type = value_type, operation = operation, result = result, span = span(at) })


private pure func raw(seed: Seed, roles: Builtins.BooleanRoles[Concrete.VariantInstanceId]) -> Own.OwnershipProgram:
	ids = seed.ids
	entry: Own.OwnedFunction = {
		execution = OrdinaryCalls,
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = [definition(ids.first, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 1)],
		tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.first)))
	}
	call: Concrete.ConcreteCall = { target = Concrete.RuntimeFunction(Builtins.StringEquals(roles)), span = span(30) }
	comparison: Own.OwnedFunction = {
		execution = OrdinaryCalls,
		signature = { parameters = [Concrete.StringType, Concrete.StringType], return_type = Concrete.IntType },
		operations = [
			definition(ids.first, Concrete.StringType, Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(ids.first)), 10),
			definition(ids.second, Concrete.StringType, Own.ParameterDefinition(1), Own.BorrowedResult(Own.ParameterBorrow(ids.second)), 20),
			definition(ids.third, Concrete.UnionType(Concrete.variant_owner(roles.equal)), Own.CallDefinition(call, [Own.BorrowedArgument({ value = ids.first, source = Own.ParameterBorrow(ids.first) }), Own.BorrowedArgument({ value = ids.second, source = Own.ParameterBorrow(ids.second) })]), Own.UnmanagedResult, 30),
			definition(ids.fourth, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 50),
		],
		tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.fourth)))
	}
	{ records = [], unions = seed.unions, functions = [entry, comparison], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }


private pure func rejects(program: Own.OwnershipProgram, message: String) -> Bool:
	match verify(program):
		Err(error): error.message == "ownership verification failed: " + message and error.help == "report this compiler error with the input program" and same_source(error.span.source, module_source(root_module_id())) and error.span.start == 30 and error.span.end == 31 and error.note.is_none()
		Ok(_): False


pure func test_raw_comparison_with_two_borrowed_inputs_is_valid() -> Bool:
	match seed():
		Ok(seed): verify(raw(seed, seed.roles)).is_ok()
		Err(_): False


pure func test_verifier_rejects_comparison_role_from_other_owner() -> Bool:
	match seed():
		Ok(seed): rejects(raw(seed, { equal = seed.roles.equal, different = seed.other_roles.different }), "runtime comparison roles do not cover one result union")
		Err(_): False


private pure func rejects_layout(seed: Seed, variants: List[List[Concrete.TypeRef]], message: String) -> Bool:
	program = raw(seed, seed.roles)
	owner = Concrete.union_number(Concrete.variant_owner(seed.roles.equal))
	match seed.unions.set_index(owner, { variants = variants, representation = Concrete.InlineUnmanaged }):
		Some(unions): rejects({ program | unions = unions }, message)
		None: False


pure func test_verifier_rejects_unknown_comparison_ordinal() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[]], "unknown variant identity")
		Err(_): False


pure func test_verifier_rejects_comparison_payload() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[], [Concrete.IntType]], "variant field count does not match its operation")
		Err(_): False


pure func test_verifier_rejects_extra_comparison_variant() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[], [], []], "runtime comparison roles do not cover one result union")
		Err(_): False


pure func test_verifier_rejects_duplicate_comparison_role() -> Bool:
	match seed():
		Ok(seed): rejects(raw(seed, { equal = seed.roles.equal, different = seed.roles.equal }), "runtime comparison roles do not cover one result union")
		Err(_): False


tests: TestSuite = {
	description = "Independent ordinary Bool comparison contracts",
	tests = [
		("checked comparison preserves reversed explicit roles", test_checked_comparison_preserves_explicit_reversed_roles),
		("specialized comparison has empty unmanaged roles", test_specialized_comparison_has_two_empty_unmanaged_roles),
		("comparison borrows both inputs without acquisition", test_comparison_borrows_both_inputs_without_acquisition),
		("checker rejects equal payload", test_checker_rejects_payload_on_equal_role),
		("checker rejects different payload", test_checker_rejects_payload_on_different_role),
		("checker rejects wrong comparison owner", test_checker_rejects_comparison_role_from_other_owner),
		("checker rejects extra comparison variant", test_checker_rejects_extra_comparison_variant),
		("checker rejects duplicate comparison role", test_checker_rejects_duplicate_comparison_role),
		("raw comparison with borrowed inputs valid", test_raw_comparison_with_two_borrowed_inputs_is_valid),
		("verifier rejects wrong comparison owner", test_verifier_rejects_comparison_role_from_other_owner),
		("verifier rejects unknown comparison ordinal", test_verifier_rejects_unknown_comparison_ordinal),
		("verifier rejects comparison payload", test_verifier_rejects_comparison_payload),
		("verifier rejects extra comparison variant", test_verifier_rejects_extra_comparison_variant),
		("verifier rejects duplicate comparison role", test_verifier_rejects_duplicate_comparison_role),
	]
}
