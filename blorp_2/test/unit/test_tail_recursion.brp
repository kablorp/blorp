import:
	compilation: compile
	test: TestSuite


private WALK: String =
	|fixed union Step:
	|	Stop
	|	Once
	|@tail_recursive
	|pure func walk(step: Step, left: Int, right: Int) -> Int:
	|	match step:
	|		Stop: right
	|		Once: walk(Stop, right, left)
	|func main() -> Int:
	|	walk(Once, 7, 9)
	|


pure func test_direct_self_tail_emits_loop() -> Bool:
	match compile(WALK):
		Err(_):
			False
		Ok(output):
			output.contains("while (1)") and output.contains("continue;")


tests: TestSuite = {
	description = "Guaranteed self-tail recursion",
	tests = [("direct self tail emits a loop", test_direct_self_tail_emits_loop)]
}
