pure func test_method_visibility_is_owned_by_importing_scope() -> Bool:
	root: String =
		|import:
		|    ./ops: Int
		|    ./helper: answer
		|func main() -> Int:
		|    answer().number()
		|
	helper: String =
		|import:
		|    ./ops: number
		|pure func answer() -> Int:
		|    number(42)
		|
	accepts([
		{
			source = root,
			targets = [1, 2]
		},
		{
			source = OPS,
			targets = []
		},
		{
			source = helper,
			targets = [1]
		},
	])


