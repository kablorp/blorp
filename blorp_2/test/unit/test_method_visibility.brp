import:
	../../src/check/check_model as Model
	../../src/utils/declarations as Declaration
	../../src/check/check: check, check_errors, checked_functions
	../../src/check/check_errors as Errors
	../../src/check/check_render: render_failure
	../../src/lex/lex: lex
	../../src/namespace/namespace: ImportProblem(AmbiguousImportSelection, MissingImportedType, AmbiguousImportedType)
	../../src/parse/assemble: ParsedAssembly, ParsedProgram, append_module, assembly_names, begin_program, seal_program
	../../src/parse/parse: parse_module
	../../src/utils/source: ModuleId, ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule), module_id, module_source, root_module_id, same_source
	../../src/utils/syntax: Diagnostic, same_span
	option: to_result
	module_input: ModuleInput, TEST_BASE, parse_modules
	input: setup_diagnostic
	test: TestSuite


private pure func accepts(inputs: List[ModuleInput]) -> Bool:
	match parse_modules(inputs):
		Err(_):
			False
		Ok(parsed):
			check(parsed)
				.is_ok()


private pure func rejects(
	inputs: List[ModuleInput],
	expected: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match parse_modules(inputs):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					expected(check_errors(failure).first.kind)


private pure func import_diagnostic_is(
	inputs: List[ModuleInput],
	expected: pure (ImportProblem) -> Bool,
	message: String,
	help: String,
	start: Int,
	end: Int,
) -> Bool:
	match parse_modules(inputs):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					error = check_errors(failure).first
					match error.kind:
						Errors.ImportRejection(Errors.ImportRejected(problem)):
							diagnostic = render_failure(failure).first
							(
								expected(problem)
								and same_span(error.span, {source = module_source(root_module_id()), start = start, end = end})
								and same_span(diagnostic.span, error.span)
								and diagnostic.message == message
								and diagnostic.help == help
							)
						_: False


private OPS: String =
	|pure func number(value: Int) -> Int:
	|    value
	|


pure func test_type_selection_enables_receiver_call() -> Bool:
	root: String =
		|import:
		|    ./ops: Int
		|func main() -> Int:
		|    42.number()
		|
	accepts([
		{
			source = root,
			targets = [1]
		},
		{
			source = OPS,
			targets = []
		},
	])


pure func test_type_selection_does_not_enable_direct_call() -> Bool:
	root: String =
		|import:
		|    ./ops: Int
		|func main() -> Int:
		|    number(42)
		|
	rejects([
		{
			source = root,
			targets = [1]
		},
		{
			source = OPS,
			targets = []
		},
	], pure func(kind):
		match kind:
			Errors.CallRejection(Errors.UnknownFunction(_)):
				True
			_:
				False
	)


