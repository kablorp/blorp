import:
	../../src/check/check: check
	../../src/lower/lower: LoweredProgram, lower
	../../src/specialize/specialize: SpecializedProgram, specialize
	../../src/utils/syntax: Diagnostic
	./input: setup_diagnostic
	./module_input: TestFoundation, parse_modules_with_base


MIXED_RESULT_SOURCE: String =
	|pure func succeed(value: Void) -> Result[Void, String]:
	|    Ok(value)
	|pure func fail(value: String) -> Result[Void, String]:
	|    Err(value)
	|func main() -> Int:
	|    success = succeed(void)
	|    failure = fail("error")
	|    0
	|


pure func specialized_result(foundation: TestFoundation) -> Result[SpecializedProgram, Diagnostic]:
	parsed ?= parse_modules_with_base([{ source = MIXED_RESULT_SOURCE, targets = [] }], foundation)
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialize(checked)


pure func lowered_result(foundation: TestFoundation) -> Result[LoweredProgram, Diagnostic]:
	concrete ?= specialized_result(foundation)
	lower(concrete)
