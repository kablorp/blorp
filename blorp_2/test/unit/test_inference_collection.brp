import:
	../../src/declarations as Declaration
	../../src/source: module_source, root_module_id
	../../src/check: check, checked_functions
	../../src/check_errors as Errors
	../../src/check_model as Checker
	../../src/lex: lex
	../../src/text: concat
	input: check_failure, parse, check_modules_failure
	int as IntOps
	module_input: PRIMITIVE_BASE, INTEGER_OPERATIONS
	test: TestSuite


private pure func wide_source(width: Int, distinct: Bool) -> String:
	consume_source: String =
		|]:
		|	Only
		|pure func consume[
	producer_source: String =
		|])->Int:
		|	0
		|pure func producer()->Wide[
	source: String =
		|]:
		|	Only
		|func main()->Int:
		|	consume(producer())
		|
	var names: String = ""
	var expected: String = ""
	var actual: String = ""
	var integer: Bool = True

	for position in 0..width:
		separator = if IntOps.equals(position, 0):
			""
		else:
			","

		names = names
			.concat(separator)
			.concat("P")
			.concat(IntOps.to_string(position))
		expected = expected
			.concat(separator)
			.concat("T")

		if distinct:
			expected = expected.concat(IntOps.to_string(position))

		value = if integer or not distinct:
			"Int"
		else:
			"String"

		actual = actual
			.concat(separator)
			.concat(value)
		integer = not integer

	parameters = if distinct:
		expected
	else:
		"T"

	"fixed union Wide["
		.concat(names)
		.concat(consume_source)
		.concat(parameters)
		.concat("](value:Wide[")
		.concat(expected)
		.concat(producer_source)
		.concat(actual)
		.concat(source)


private pure func inferred_arguments(source: String) -> Option[List[Checker.TypeRef]]:
	match lex(module_source(root_module_id()), source).and_then(pure func(tokens): parse(tokens)):
		Err(_):
			None
		Ok(parsed):
			match check(parsed):
				Err(_):
					None
				Ok(program):
					match checked_functions(program).functions:
						[_, _, main]:
							match main.body:
								Checker.CheckedValueBody(Checker.ReturnExpression(value)):
									match value.form:
										Checker.InvokeFunction(call, _):
											match call.target:
												Checker.UserFunction(id, arguments):
													if IntOps.equals(
														Declaration.function_number(id),
														0,
													):
														Some(arguments)
													else:
														None
												_:
													None
										_:
											None
								_:
									None
						_:
							None


private pure func repeated_width(width: Int) -> Bool:
	match inferred_arguments(wide_source(width, False)):
		Some([Checker.IntType]):
			True
		_:
			False


pure func test_sixteen_structural_constraints_infer_one_complete_argument() -> Bool:
	repeated_width(16)


pure func test_sixty_four_structural_constraints_infer_one_complete_argument() -> Bool:
	repeated_width(64)


pure func test_two_hundred_fifty_six_constraints_infer_one_complete_argument() -> Bool:
	repeated_width(256)


pure func test_distinct_slots_keep_ordered_mixed_arguments() -> Bool:
	match inferred_arguments(wide_source(16, True)):
		Some(arguments):
			var integer: Bool = True
			var correct = IntOps.equals(arguments.length(), 16)

			for argument in arguments:
				expected = if integer:
					Checker.IntType
				else:
					Checker.StringType

				correct = correct and Checker.same_type(argument, expected)
				integer = not integer

			correct
		None:
			False


private pure func owned_parameter(parameter: Checker.TypeParameterId, position: Int) -> Bool:
	match Checker.parameter_owner(parameter):
		Checker.FunctionDeclaration(owner):
			IntOps.equals(
				Declaration.function_number(owner),
				0,
			) and IntOps.equals(
				Checker.parameter_position(parameter),
				position,
			)
		_:
			False


pure func test_nominal_mismatch_does_not_constrain_its_children() -> Bool:
	prefix: String =
		|fixed union Pair[A,B]:
		|	Only
		|fixed union Other[A,B]:
		|	OnlyOther
		|pure func take[T](value:Pair[T,T],last:T)->T:
		|	last
		|pure func producer()->Other[Int,String]:
		|	OnlyOther
		|func main()->Int:
		|	take(

	match check_failure(prefix.concat("producer(),7)\n")):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					match (mismatch.expected, mismatch.actual.value_type):
						(Checker.AppliedUnionType(expected_owner, [Checker.IntType, Checker.IntType]), Checker.AppliedUnionType(actual_owner, [Checker.IntType, Checker.StringType])):
							(
								Declaration.union_number(expected_owner) == 0
								and Declaration.union_number(actual_owner) == 1
								and mismatch.argument_position == 0
								and mismatch.actual.span.start == prefix.length()
							)
						_:
							False
				_:
					False
		None:
			False


pure func test_first_origin_and_unseen_rigid_snapshot_survive_an_agreeing_child() -> Bool:
	source: String =
		|)->Int:
		|	0
		|pure func producer()->Tri[Int,String,Int]:
		|	Only
		|func main()->Int:
		|	take(7.to_string(),
	declarations: String =
		|import:
		|    int: to_string
		|fixed union Tri[X,Y,Z]:
		|	Only
		|pure func take[A,B](ordinary:Int,seed:A,value:
	annotation = "Tri[A,A,B]"
	prefix = declarations
		.concat(annotation)
		.concat(source)
	actual_start = IntOps.add(prefix.length(), 2)

	match check_modules_failure([
		{ source = prefix.concat("7,producer())\n"), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
					match (
						conflict.mismatch.expected,
						conflict.mismatch.actual.value_type,
						conflict.mismatch.expected_site,
					):
						(Checker.AppliedUnionType(expected_owner, [Checker.IntType, Checker.IntType, Checker.ParameterType(unseen)]), Checker.AppliedUnionType(actual_owner, [Checker.IntType, Checker.StringType, Checker.IntType]), Errors.SourceAnnotation(site)):
							(
								owned_parameter(conflict.parameter, 0)
								and owned_parameter(unseen, 1)
								and Declaration.union_number(expected_owner) == 0
								and Declaration.union_number(actual_owner) == 0
								and Checker.same_type(conflict.previous.value_type, Checker.IntType)
								and Checker.same_type(
									conflict.current.value_type,
									Checker.StringType,
								)
								and conflict.previous.span.start == prefix.length()
								and conflict.previous.span.end == IntOps.add(prefix.length(), 1)
								and conflict.current.span.start == actual_start
								and conflict.current.span.end == IntOps.add(actual_start, 10)
								and conflict.mismatch.actual.span.start == actual_start
								and conflict.mismatch.actual.span.end == IntOps.add(
									actual_start,
									10,
								)
								and error.span.start == actual_start
								and error.span.end == IntOps.add(actual_start, 10)
								and conflict.mismatch.argument_position == 2
								and site.start == declarations.length()
								and site.end == IntOps.add(
									declarations.length(),
									annotation.length(),
								)
							)
						_:
							False
				_:
					False
		None:
			False


pure func test_later_child_error_still_precedes_a_structural_conflict() -> Bool:
	prefix: String =
		|fixed union Pair[X,Y]:
		|	Only
		|pure func take[A](value:Pair[A,A],last:Int)->Int:
		|	0
		|pure func producer()->Pair[Int,String]:
		|	Only
		|func main()->Int:
		|	take(producer(),

	match check_failure(prefix.concat("missing)\n")):
		Some(error):
			match error.kind:
				Errors.ValueRejection(Errors.UnknownValue(_)):
					(
						error.span.start == prefix.length()
						and error.span.end == IntOps.add(prefix.length(), 7)
					)
				_:
					False
		None:
			False


pure func test_missing_slot_still_precedes_an_ordinary_mismatch() -> Bool:
	declarations_source: String =
		|import:
		|    int: to_string
		|fixed union Pair[X,Y]:
		|	Only
		|pure func take[A,B](value:Pair[A,A],last:Int)->Int:
		|	0
		|pure func producer()->Pair[Int,Int]:
		|	Only
		|func main()->Int:
	declarations = declarations_source + "\n\t"

	match check_modules_failure([
		{ source = declarations.concat("take(producer(),7.to_string())\n"), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.UninferableTypeParameter(parameter)):
					(
						owned_parameter(parameter, 1)
						and error.span.start == declarations.length()
						and error.span.end == IntOps.add(declarations.length(), 4)
					)
				_:
					False
		None:
			False


tests: TestSuite = {
	description = "Inference collection contracts",
	tests = [
		(
			"sixteen structural constraints infer one complete argument",
			test_sixteen_structural_constraints_infer_one_complete_argument,
		),
		(
			"sixty four structural constraints infer one complete argument",
			test_sixty_four_structural_constraints_infer_one_complete_argument,
		),
		(
			"two hundred fifty six constraints infer one complete argument",
			test_two_hundred_fifty_six_constraints_infer_one_complete_argument,
		),
		(
			"distinct slots keep ordered mixed arguments",
			test_distinct_slots_keep_ordered_mixed_arguments,
		),
		(
			"nominal mismatch does not constrain its children",
			test_nominal_mismatch_does_not_constrain_its_children,
		),
		(
			"first origin and unseen rigid snapshot survive an agreeing child",
			test_first_origin_and_unseen_rigid_snapshot_survive_an_agreeing_child,
		),
		(
			"later child error still precedes a structural conflict",
			test_later_child_error_still_precedes_a_structural_conflict,
		),
		(
			"missing slot still precedes an ordinary mismatch",
			test_missing_slot_still_precedes_an_ordinary_mismatch,
		),
	]
}
