	rejects_arm("\t\tEmpty: 0\n\t\tNumber(payload):\n\t\t\tvar local = payload\n\t\t\tvar ", "local", " = 42\n\t\t\tlocal\n", pure func(
		kind: CheckErrorKind,
	) -> Bool:
