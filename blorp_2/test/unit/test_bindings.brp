	rejects_arm("\t\tEmpty: 0\n\t\tNumber(payload):\n\t\t\tvar local = value\n\t\t\tlocal = ", "payload", "\n\t\t\t0\n", pure func(
		kind: CheckErrorKind,
	) -> Bool:
