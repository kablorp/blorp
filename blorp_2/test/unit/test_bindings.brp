import:
	../../src/check:
		BindingMutability(Immutable, Mutable),
		BindingOrigin(ParameterBinding, BodyLocal, MatchCapture),
		CheckErrorKind(
			UnknownValue, DuplicateLocal, ImmutableAssignment, ExpressionTypeMismatch,
			RecursiveCallChain, ImpureCall, ConstructorNeedsExpectedType, UncallableBinding,
		),
		CheckedAssignment(InitializeBinding, ReassignBinding),
		CheckedBase(ReturnBinding),
		CheckedBody(CheckedValueBody, CheckedMatchBody),
		TypeRef(IntType, UnionType),
		binding_number,
		check_errors,
		checked_functions,
		same_type,
	../../src/lex: lex
	../../src/syntax: Diagnostic
	input: check, check_failure, parse, setup_diagnostic, singleton_check_error
	result: get_or
	test: TestSuite


private pure func accepts(source: String) -> Bool:
	match checked(source):
		Ok(_):
			True
		Err(_):
			False


private pure func checked(source: String) -> Result[Void, Diagnostic]:
	lexed ?= lex(source)
	parsed ?= parse(lexed)
	accepted ?= check(parsed).map_err(setup_diagnostic)
	Ok(void)


private pure func rejects(
	body: String,
	start: Int,
	end: Int,
	matches: pure (CheckErrorKind) -> Bool,
) -> Bool:
	prefix = "func main() -> Int:\n\t"

	match check_failure(prefix + body):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length() + start
				and error.span.end == prefix.length() + end
				and matches(error.kind)
			)


pure func test_immutable_and_mutable_bindings() -> Bool:
	accepts(
		"pure func identity(value: Int) -> Int:\n\tvalue\npure func preserve() -> Int:\n\toriginal = 1\n\tvar current = original\n\tcurrent = identity(42)\n\toriginal\nfunc main() -> Int:\n\tpreserve()\n",
	)


pure func test_initializer_reads_previous_parameter_scope() -> Bool:
	accepts(
		"pure func preserve(value: Int) -> Int:\n\tvar value = value\n\tvalue = value\n\tvalue\nfunc main() -> Int:\n\tpreserve(42)\n",
	)


pure func test_immutable_assignment_is_rejected() -> Bool:
	rejects("value = 1\n\tvalue = 2\n\tvalue\n", 11, 16, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ImmutableAssignment(_):
				True
			_:
				False
	)


pure func test_duplicate_mutable_declaration_is_rejected() -> Bool:
	rejects("var value = 1\n\tvar value = 2\n\tvalue\n", 19, 24, pure func(
		kind: CheckErrorKind,
	) -> Bool:
		match kind:
			DuplicateLocal(_):
				True
			_:
				False
	)


pure func test_unknown_self_initializer_is_rejected() -> Bool:
	rejects("value = value\n\tvalue\n", 8, 13, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			UnknownValue(_):
				True
			_:
				False
	)


pure func test_unused_impure_initializer_is_rejected() -> Bool:
	match check_failure(
		"func effect() -> Int:\n\t1\npure func main() -> Int:\n\tunused = effect()\n\t0\n",
	):
		None:
			False
		Some(error):
			(
				match error.kind:
					ImpureCall(_, _):
						True
					_:
						False
				and error.span.start == 60
				and error.span.end == 66
			)


pure func test_unused_recursive_initializer_is_rejected() -> Bool:
	match check_failure("func main() -> Int:\n\tunused = main()\n\t0\n"):
		None:
			False
		Some(error):
			(
				match error.kind:
					RecursiveCallChain:
						True
					_:
						False
				and error.span.start == 30
				and error.span.end == 34
			)


private pure func test_binding_definitions_own_origin_mutability_type_and_span_result(

) -> Result[Bool, Diagnostic]:
	lexed ?= lex(
		"pure func copy(value: Int) -> Int:\n\tvar value = value\n\told = value\n\tvalue = 42\n\told\nfunc main() -> Int:\n\tcopy(1)\n",
	)
	parsed ?= parse(lexed)
	program ?= check(parsed).map_err(setup_diagnostic)
	Ok(
		match checked_functions(program).functions:
			[copy, _]:
				match copy.bindings:
					[parameter, mutable, old]:
						match copy.assignments:
							[InitializeBinding(current_id, current), InitializeBinding(old_id, previous_value), ReassignBinding(reassigned, _)]:
								match current.base:
									ReturnBinding(parameter_id):
										match previous_value.base:
											ReturnBinding(alias_id):
												(
													same_origin(
														parameter.origin,
														ParameterBinding(0),
													)
													and parameter.mutability == Immutable
													and parameter.span.start == 15
													and parameter.span.end == 20
													and same_origin(mutable.origin, BodyLocal)
													and mutable.mutability == Mutable
													and mutable.span.start == 40
													and mutable.span.end == 45
													and same_origin(old.origin, BodyLocal)
													and old.mutability == Immutable
													and same_type(old.value_type, IntType)
													and binding_number(parameter_id) == 0
													and binding_number(current_id) == 1
													and binding_number(old_id) == 2
													and binding_number(alias_id) == 1
													and binding_number(reassigned) == 1
													and same_type(current.base_type, IntType)
												)
											_:
												False
									_:
										False
							_:
								False
					_:
						False
			_:
				False
	)


pure func test_union_local_and_reassignment_use_the_established_type() -> Bool:
	accepts(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func number() -> Value:\n\tNumber(1)\npure func copy(value: Value) -> Value:\n\tvar current = value\n\told = current\n\tcurrent = Number(42)\n\told\nfunc main() -> Int:\n\t0\n",
	)


private pure func test_reassignment_rejects_a_different_type_result() -> Result[Bool, Diagnostic]:
	prefix = "fixed union Value:\n\tEmpty\npure func value() -> Value:\n\tEmpty\nfunc main() -> Int:\n\tvar current = value()\n\tcurrent = 1\n\t0\n"
	lexed ?= lex(prefix)
	parsed ?= parse(lexed)
	Ok(
		match check(parsed):
			Ok(_):
				False
			Err(failure):
				match singleton_check_error(check_errors(failure)):
					None:
						False
					Some(error):
						(
							match error.kind:
								ExpressionTypeMismatch(_):
									True
								_:
									False
							and error.span.start == 115
							and error.span.end == 116
						)
	)


private pure func test_new_union_local_requires_a_receiving_type_result(

) -> Result[Bool, Diagnostic]:
	lexed ?= lex("fixed union Value:\n\tEmpty\nfunc main() -> Int:\n\tvalue = Empty\n\t0\n")
	parsed ?= parse(lexed)
	Ok(
		match check(parsed):
			Ok(_):
				False
			Err(failure):
				match singleton_check_error(check_errors(failure)):
					None:
						False
					Some(error):
						(
							match error.kind:
								ConstructorNeedsExpectedType(_):
									True
								_:
									False
							and error.span.start == 55
							and error.span.end == 60
						)
	)


pure func test_binding_definitions_own_origin_mutability_type_and_span() -> Bool:
	test_binding_definitions_own_origin_mutability_type_and_span_result().get_or(False)


pure func test_reassignment_rejects_a_different_type() -> Bool:
	test_reassignment_rejects_a_different_type_result().get_or(False)


pure func test_new_union_local_requires_a_receiving_type() -> Bool:
	test_new_union_local_requires_a_receiving_type_result().get_or(False)


pure func test_body_local_shadows_direct_unary_function() -> Bool:
	match check_failure(
		"pure func identity(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tidentity = 1\n\tidentity(1)\n",
	):
		None:
			False
		Some(error):
			(
				match error.kind:
					UncallableBinding(_, _, _):
						True
					_:
						False
				and error.span.start == 81
				and error.span.end == 89
			)


pure func test_body_local_shadows_direct_zero_argument_function() -> Bool:
	match check_failure(
		"pure func identity(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tidentity = 1\n\tidentity()\n",
	):
		None:
			False
		Some(error):
			(
				match error.kind:
					UncallableBinding(_, _, _):
						True
					_:
						False
				and error.span.start == 81
				and error.span.end == 89
			)


pure func test_body_local_does_not_shadow_ufcs_function() -> Bool:
	accepts(
		"pure func identity(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tidentity = 1\n\tidentity.identity()\n",
	)


private ARM_PREFIX: String = "fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func inspect(value: Value) -> Int:\n\tmatch value:\n"


private pure func rejects_arm(
	before: String,
	spelling: String,
	after: String,
	matches: pure (CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(
		ARM_PREFIX + before + spelling + after + "func main() -> Int:\n\tinspect(Number(7))\n",
	):
		None:
			False
		Some(error):
			(
				error.span.start == ARM_PREFIX.length() + before.length()
				and error.span.end == ARM_PREFIX.length() + before.length() + spelling.length()
				and matches(error.kind)
			)


pure func test_arm_local_mutation_is_pure() -> Bool:
	accepts(
		ARM_PREFIX + "\t\tEmpty: 0\n\t\tNumber(payload):\n\t\t\tvar current = payload\n\t\t\toriginal = current\n\t\t\tcurrent = 42\n\t\t\toriginal\nfunc main() -> Int:\n\tinspect(Number(7))\n",
	)


pure func test_arm_var_initializer_reads_capture_before_shadowing() -> Bool:
	accepts(
		ARM_PREFIX + "\t\tEmpty: 0\n\t\tNumber(payload):\n\t\t\tvar payload = payload\n\t\t\tpayload = 42\n\t\t\tpayload\nfunc main() -> Int:\n\tinspect(Number(7))\n",
	)


pure func test_arm_var_can_shadow_an_enclosing_body_local() -> Bool:
	accepts(
		"fixed union Value:\n\tEmpty\n\tNumber(Int)\npure func inspect(value: Value) -> Int:\n\tlocal = 7\n\tmatch value:\n\t\tEmpty:\n\t\t\tvar local = local\n\t\t\tlocal = 42\n\t\t\tlocal\n\t\tNumber(_): local\nfunc main() -> Int:\n\tinspect(Empty)\n",
	)


pure func test_sibling_arms_can_declare_the_same_local_name() -> Bool:
	accepts(
		ARM_PREFIX + "\t\tEmpty:\n\t\t\tvar local = 0\n\t\t\tlocal\n\t\tNumber(payload):\n\t\t\tvar local = payload\n\t\t\tlocal\nfunc main() -> Int:\n\tinspect(Number(7))\n",
	)


pure func test_arm_local_does_not_escape_to_a_sibling() -> Bool:
	rejects_arm("\t\tEmpty:\n\t\t\tlocal = 0\n\t\t\tlocal\n\t\tNumber(_): ", "local", "\n", pure func(
		kind: CheckErrorKind,
	) -> Bool:
		match kind:
			UnknownValue(_):
				True
			_:
				False
	)


pure func test_arm_capture_assignment_is_rejected() -> Bool:
	rejects_arm("\t\tEmpty: 0\n\t\tNumber(payload):\n\t\t\t", "payload", " = 42\n\t\t\tpayload\n", pure func(
		kind: CheckErrorKind,
	) -> Bool:
		match kind:
			ImmutableAssignment(_):
				True
			_:
				False
