import:
	../../src/check/check: check
	../../src/check/constants: constant_annotations, validate_constants
	../../src/check/declarations: validate_declarations
	../../src/check/errors: CheckError
	../../src/check/model: CheckedConstant
	../../src/namespace/namespace: Namespace
	../../src/parse/assemble: ParsedProgram, parsed_contents
	../../src/lower/lower as Lower
	../../src/own/own as Own
	../../src/specialize/specialize as Concrete
	../../src/utils/syntax: Diagnostic
	./input: prepare_signatures, accepted_traits, setup_diagnostic
	./module_input: parse_modules


-- Two uses materialize independently. The unused constant must create nothing.
TWICE: String =
	|private UNUSED: String = "absent"
	|private TEXT: String = "kept λ"
	|func main() -> Int:
	|    first = TEXT
	|    second = TEXT
	|    0
	|


AGGREGATE_TWICE: String =
	|fixed record Box { text: String }
	|VALUE: Box = { text = "kept λ" }
	|func main() -> Int:
	|    first = VALUE
	|    second = VALUE
	|    0
	|


NAMED_CALLBACK: String =
	|pure func identity[T](value: T) -> T:
	|    value
	|CALLBACK: pure (Int) -> Int = identity
	|func main() -> Int:
	|    saved = CALLBACK
	|    0
	|


pure func concrete(source: String) -> Result[Concrete.SpecializedProgram, Diagnostic]:
	parsed ?= parse_modules([{ source = source, targets = [] }])
	checked ?= check(parsed).map_err(setup_diagnostic)
	Concrete.specialize(checked)


pure func lowered(source: String) -> Result[Lower.LoweredProgram, Diagnostic]:
	concrete(source).and_then(pure func(program): Lower.lower(program))


pure func owned(source: String) -> Result[Own.OwnershipProgram, Diagnostic]:
	lowered(source).and_then(pure func(program): Own.own(program))


-- Phase observers see actual declaration rows, including unused initializers.
pure func admitted_constants(program: ParsedProgram, namespace: Namespace) -> Result[List[CheckedConstant], CheckError]:
	parsed = parsed_contents(program)
	declarations ?= validate_declarations(parsed, namespace)
	annotations ?= constant_annotations(parsed, namespace)
	prepared ?= prepare_signatures(program, namespace)
	signatures = prepared.signatures
	traits ?= accepted_traits(program, namespace, prepared)
	validate_constants(parsed, namespace, annotations, declarations.records, declarations.unions, signatures.functions, traits)
