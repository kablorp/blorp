import:
	../../src/check/check: check
	../../src/lower/lower as Lower
	../../src/own/own as Own
	../../src/specialize/specialize as Concrete
	../../src/utils/syntax: Diagnostic
	./input: setup_diagnostic
	./module_input: parse_modules


-- Two uses materialize independently. The unused constant must create nothing.
TWICE: String =
	|private UNUSED: String = "absent"
	|private TEXT: String = "kept λ"
	|func main() -> Int:
	|    first = TEXT
	|    second = TEXT
	|    0
	|


pure func concrete(source: String) -> Result[Concrete.SpecializedProgram, Diagnostic]:
	parsed ?= parse_modules([{ source = source, targets = [] }])
	checked ?= check(parsed).map_err(setup_diagnostic)
	Concrete.specialize(checked)


pure func lowered(source: String) -> Result[Lower.LoweredProgram, Diagnostic]:
	concrete(source).and_then(pure func(program): Lower.lower(program))


pure func owned(source: String) -> Result[Own.OwnershipProgram, Diagnostic]:
	lowered(source).and_then(pure func(program): Own.own(program))
