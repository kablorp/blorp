		|    ./owner: Foo
		|func main() -> Int:
		|    0
		|
	last: String =
		|import:
		|    ./owner: Foo
		|    ./operations: Foo methods_only
		|func main() -> Int:
		|    0
		|
	reordered_methods_valid(
		first,
		[1, 2],
	) and reordered_methods_valid(
		last,
		[2, 1],
	)


