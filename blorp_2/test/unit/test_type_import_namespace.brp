import:
	../../src/declarations: record_number, union_number, variant_number, variant_owner
	../../src/names: find_name
	../../src/namespace:
		ImportProblem(
			AmbiguousImportSelection, AmbiguousImportedType, MissingImportedType, MethodTypeNotVisible,
			MissingImportedFunction, ImportedTypeConflict, RepeatedImportedVariant,
		),
		Namespace,
		TypeCandidate(PrimitiveCandidate, ListCandidate, UnionCandidate, RecordCandidate),
		build_namespace,
		function_candidates,
		import_problems,
		method_selection_requests,
		same_type_candidate,
		type_candidates,
		variant_candidates,
	../../src/lex: lex
	../../src/parse:
		ParsedAssembly, ParsedProgram, append_module, assembly_names,
		begin_program, parse_module, parsed_contents, seal_program,
	../../src/prelude: PrimitiveType(BuiltinInt)
	../../src/source:
		COMPILER_SOURCE, ModuleId, ModuleKind(FoundationTypesModule, FoundationPreludeModule, LibraryModule, UserModule),
		module_id, module_source, root_module_id, same_module,
	../../src/syntax: Diagnostic
	module_input: ModuleInput, TEST_BASE, parse_modules
	int as IntOps
	option: to_result
	result: and_then, map
	test: TestSuite


private fixed record NamespaceInput {
	program: ParsedProgram,
	namespace: Namespace
}


private fixed record RoleModuleInput {
	source: String,
	targets: List[Int],
	role: ModuleKind
}


private INVENTORY_ERROR: Diagnostic = {
	span = { source = COMPILER_SOURCE, start = 0, end = 0 },
	note = None,
	message = "invalid namespace test inventory",
	help = "supply nonnegative module ordinals and one target for each written import"
}


private pure func append_role_module(
	assembly: ParsedAssembly,
	input: RoleModuleInput,
	position: Int,
) -> Result[ParsedAssembly, Diagnostic]:
	module ?= module_id(position).to_result(INVENTORY_ERROR)
	tokens ?= lex(module_source(module), input.source)
	parsed ?= parse_module(tokens, module, assembly_names(assembly))
	var resolved: Result[List[ModuleId], Diagnostic] = Ok([])
	for ordinal in input.targets:
		resolved = resolved.and_then(pure func(targets): module_id(ordinal).to_result(INVENTORY_ERROR).map(pure func(target): targets.append(target)))
	targets ?= resolved
	append_module(assembly, parsed, targets, input.role)


private pure func role_namespace(inputs: List[RoleModuleInput]) -> Result[NamespaceInput, Diagnostic]:
	var assembly: Result[ParsedAssembly, Diagnostic] = Ok(begin_program())
	var position: Int = 0
	for input in inputs:
		ordinal = position
		assembly = assembly.and_then(pure func(builder): append_role_module(builder, input, ordinal))
		position = IntOps.add(position, 1)
	complete ?= assembly
	program ?= seal_program(complete)
	Ok({ program = program, namespace = build_namespace(program) })


private pure func namespace_input(inputs: List[ModuleInput]) -> Result[NamespaceInput, Diagnostic]:
	program ?= parse_modules(inputs)
	Ok({
		program = program,
		namespace = build_namespace(program),
	})


private pure func candidates(
	input: NamespaceInput,
	ordinal: Int,
	spelling: String,
) -> List[TypeCandidate]:
	match (module_id(ordinal), find_name(parsed_contents(input.program).names, spelling)):
		(Some(module), Some(name)):
			type_candidates(input.namespace, module, name)
		_:
			[]


private pure func same_visible_type(
	input: NamespaceInput,
	left: Int,
	right: Int,
	spelling: String,
) -> Bool:
	match (candidates(input, left, spelling), candidates(input, right, spelling)):
		([first], [second]):
			same_type_candidate(first, second)
		_:
			False


pure func test_bare_record_import_retains_owner_and_publishes_method_request() -> Bool:
	root: String =
		|import:
		|    ./foo: Foo
		|func main() -> Int:
		|    0
		|
	owner: String =
		|fixed record Foo { value: Int }
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match (
				candidates(input, 0, "Foo"),
				method_selection_requests(input.namespace),
				module_id(1),
			):
				([RecordCandidate(receiver)], [request], Some(target)):
					(
						record_number(receiver) == 0
						and same_visible_type(input, 0, 1, "Foo")
						and same_module(request.module, root_module_id())
						and same_module(request.target, target)
						and same_type_candidate(request.receiver, RecordCandidate(receiver))
						and request.name.span.start == 19
						and request.name.span.end == 22
						and import_problems(input.namespace).is_empty()
					)
				_:
					False


