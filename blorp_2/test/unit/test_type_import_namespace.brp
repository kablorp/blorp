		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = "",
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match (candidates(input, 0, "Int"), candidates(input, 0, "List")):
				([PrimitiveCandidate(BuiltinInt)], [ListCandidate]):
					(
						same_visible_type(input, 0, 1, "Int")
						and method_selection_requests(input.namespace).length() == 2
						and import_problems(input.namespace).is_empty()
					)
				_:
					False


