				targets = [1]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match find_name(parsed_contents(input.program).names, "One"):
				Some(name):
					(
						same_visible_type(input, 0, 1, "Choice")
						and variant_candidates(input.namespace, root_module_id(), name).is_empty()
					)
				None:
					False


