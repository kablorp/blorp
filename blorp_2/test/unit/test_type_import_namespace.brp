			},
			{
				source = forward,
				targets = [3]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match find_name(parsed_contents(input.program).names, "One"):
				Some(name):
					(
						variant_candidates(input.namespace, root_module_id(), name).length() == 1
						and import_problems(input.namespace).is_empty()
					)
				None:
					False


