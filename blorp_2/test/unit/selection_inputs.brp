-- Pure unit observers read identities established by Check and Specialize.
-- A final nullary exhaustive entry has no tag; callers test its exclusions.
import:
	../../src/check/model as Checked
	../../src/specialize/specialize as Concrete
	../../src/utils/ids: VariantId


pure func checked_arm_variant(selection: Checked.CheckedSelection, arm: Checked.MatchArmId) -> Option[VariantId]:
	var found: Option[VariantId] = None
	for node in selection.nodes:
		match node:
			Checked.EnterArm(id, arguments):
				if Checked.match_arm_number(id) == Checked.match_arm_number(arm):
					for argument in arguments:
						match argument:
							Checked.BorrowPlace(place):
								match place.route:
									Checked.UnionField(_, variant, _): found = Some(variant)
									_: void
							Checked.CopyListSuffix(_, _): void
			Checked.TestVariant(_, variant, yes, _):
				match selection.nodes.get(Checked.decision_node_number(yes)):
					Some(Checked.EnterArm(id, _)):
						if Checked.match_arm_number(id) == Checked.match_arm_number(arm):
							found = Some(variant)
					_: void
			_: void
	found


pure func concrete_arm_variant(selection: Concrete.ConcreteSelection, arm: Checked.MatchArmId) -> Option[Concrete.VariantInstanceId]:
	var found: Option[Concrete.VariantInstanceId] = None
	for node in selection.nodes:
		match node:
			Concrete.EnterArm(id, arguments):
				if Checked.match_arm_number(id) == Checked.match_arm_number(arm):
					for argument in arguments:
						match argument:
							Concrete.BorrowPlace(place):
								match place.route:
									Concrete.UnionField(_, field): found = Some(Concrete.variant_field_variant(field))
									_: void
							Concrete.CopyListSuffix(_, _): void
			Concrete.TestVariant(_, variant, yes, _):
				match selection.nodes.get(Checked.decision_node_number(yes)):
					Some(Concrete.EnterArm(id, _)):
						if Checked.match_arm_number(id) == Checked.match_arm_number(arm):
							found = Some(variant)
					_: void
			_: void
	found
