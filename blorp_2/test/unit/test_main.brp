import:
	../../src/main: compile
	test: TestSuite


pure func test_complete_pipeline_emits_c() -> Bool:
	match compile("func main() -> Int:\n\t0\n"):
		Ok(output):
			output == "int main(void){return 0;}\n"
		Err(_):
			False


pure func test_lexical_error_precedes_semantic_check() -> Bool:
	match compile("func nope() -> Foo:\n\t1\n"):
		Err(diagnostic):
			(
				diagnostic.span.start == 21
				and diagnostic.span.end == 22
				and diagnostic.message == "only the integer literal 0 is supported"
				and diagnostic.help == "use the single character 0 as the function body"
			)
		Ok(_):
			False


pure func test_semantic_error_survives_pipeline() -> Bool:
	match compile("func nope() -> Int:\n\t0\n"):
		Err(diagnostic):
			(
				diagnostic.span.start == 5
				and diagnostic.span.end == 9
				and diagnostic.message == "expected exactly one main function"
				and diagnostic.help == "name the entrypoint main"
			)
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 compile pipeline",
	tests = [
		("complete pipeline emits C", test_complete_pipeline_emits_c),
		("lexical error precedes semantic check", test_lexical_error_precedes_semantic_check),
		("semantic error survives pipeline", test_semantic_error_survives_pipeline),
	]
}
