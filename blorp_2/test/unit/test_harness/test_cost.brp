import:
	../../e2e/cost:
		CompilationCost, CostLimits,
		InstructionCheck(RequiredInstructions, DisabledInstructions),
		ResourcePolicy(EnforceLimits, RecordInitialBootstrapDebt),
		ResourceVerdict(ResourceChecksPassed, InitialBootstrapDebt),
		assess_resource_limits, check_limits, format_cost, format_initial_bootstrap_debt,
		parse_allocations, parse_instruction_check, parse_instructions, parse_resource_policy
	test: TestSuite


pure func test_complete_allocation_report() -> Bool:
	match parse_allocations("blorp: leak check: 81 allocs, 81 releases, 0 leaked, 0 bytes\n"):
		Ok(count):
			count == 81
		Err(_):
			False


pure func test_missing_allocation_report_keeps_its_exact_error() -> Bool:
	match parse_allocations(""):
		Err(error): error == "missing compiler allocation report"
		Ok(_): False


pure func test_allocation_report_must_be_complete_and_clean() -> Bool:
	(
		parse_allocations("").is_err()
		and parse_allocations(
			"blorp: leak check: 0 allocs, 0 releases, 0 leaked, 0 bytes\n",
		).is_err()
		and parse_allocations(
			"blorp: leak check: -1 allocs, -1 releases, 0 leaked, 0 bytes\n",
		).is_err()
		and parse_allocations(
			"blorp: leak check: 81 allocs, 80 releases, 1 leaked, 34 bytes\n",
		).is_err()
		and parse_allocations(
			"blorp: leak check: 81 allocs, 80 releases, 0 leaked, 0 bytes\n",
		).is_err()
		and parse_allocations(
			"blorp: leak check: 81 allocs, 81 releases, 0 leaked, 0 bytes\nextra\n",
		).is_err()
	)


pure func test_retired_instructions_report() -> Bool:
	match parse_instructions(
		"0.00 real 0.00 user 0.00 sys\n       12345  instructions retired\n1024 peak memory footprint\n",
	):
		Ok(count):
			count == 12345
		Err(_):
			False


pure func test_instructions_cannot_be_missing_or_ambiguous() -> Bool:
	(
		parse_instructions("").is_err()
		and parse_instructions("0 instructions retired\n").is_err()
		and parse_instructions("-1 instructions retired\n").is_err()
		and parse_instructions("abc instructions retired\n").is_err()
		and parse_instructions("10 instructions retired\n11 instructions retired\n").is_err()
	)


pure func test_each_cost_limit_is_enforced() -> Bool:
	limits: CostLimits = {
		allocations = 81,
		instructions = 12345
	}
	at_limit: CompilationCost = {
		allocations = 81,
		instructions = Some(12345)
	}
	over_allocations: CompilationCost = {
		allocations = 82,
		instructions = Some(12345)
	}
	over_instructions: CompilationCost = {
		allocations = 81,
		instructions = Some(12346)
	}
	(
		check_limits(at_limit, limits).is_ok()
		and check_limits(over_allocations, limits).is_err()
		and check_limits(over_instructions, limits).is_err()
	)


pure func test_missing_instruction_setting_requires_measurement() -> Bool:
	match parse_instruction_check(None):
		Ok(RequiredInstructions): True
		_: False


pure func test_explicit_required_setting_requires_measurement() -> Bool:
	match parse_instruction_check(Some("required")):
		Ok(RequiredInstructions): True
		_: False


pure func test_explicit_disabled_setting_disables_measurement() -> Bool:
	match parse_instruction_check(Some("disabled")):
		Ok(DisabledInstructions): True
		_: False


private pure func rejects_setting(value: String) -> Bool:
	match parse_instruction_check(Some(value)):
		Err(error): error == "BLORP_2_INSTRUCTION_CHECK must be 'required' or 'disabled'; unset it to require retired-instruction counters"
		Ok(_): False


pure func test_empty_instruction_setting_is_an_exact_error() -> Bool:
	rejects_setting("")


pure func test_unknown_instruction_settings_are_exact_errors() -> Bool:
	rejects_setting("auto") and rejects_setting("disable") and rejects_setting("Disabled") and rejects_setting(" required ")


pure func test_disabled_instructions_still_enforce_allocation_limit() -> Bool:
	limits: CostLimits = { allocations = 81, instructions = 12345 }
	at_limit: CompilationCost = { allocations = 81, instructions = None }
	over_limit: CompilationCost = { allocations = 82, instructions = None }
	match check_limits(over_limit, limits):
		Err(error): check_limits(at_limit, limits).is_ok() and error == "compiler allocations exceeded limit: 82 > 81"
		Ok(_): False


pure func test_instruction_limit_failure_preserves_exact_counter() -> Bool:
	match check_limits({ allocations = 81, instructions = Some(12346) }, { allocations = 81, instructions = 12345 }):
		Err(error): error == "compiler retired instructions exceeded limit: 12346 > 12345"
		Ok(_): False


pure func test_measured_cost_format_has_both_counters_and_limits() -> Bool:
	format_cost({ allocations = 81, instructions = Some(12345) }, { allocations = 100, instructions = 20000 }) == "allocations=81/100; instructions=12345/20000"


pure func test_disabled_cost_format_does_not_invent_a_counter() -> Bool:
	format_cost({ allocations = 81, instructions = None }, { allocations = 100, instructions = 20000 }) == "allocations=81/100; instructions=disabled"


pure func test_missing_instruction_counter_keeps_exact_error() -> Bool:
	match parse_instructions("0.00 real 0.00 user 0.00 sys\n"):
		Err(error): error == "expected exactly one retired-instruction counter from macOS /usr/bin/time -l"
		Ok(_): False


pure func test_disabled_instructions_do_not_relax_allocation_reports() -> Bool:
	match parse_allocations("blorp: leak check: 81 allocs, 80 releases, 0 leaked, 0 bytes\n"):
		Err(error): error == "compiler allocation and release counters disagree"
		Ok(_): False


pure func test_resource_policy_defaults_to_enforcement() -> Bool:
	match parse_resource_policy(None):
		Ok(EnforceLimits): True
		_: False


pure func test_explicit_resource_enforcement() -> Bool:
	match parse_resource_policy(Some("enforce-limits")):
		Ok(EnforceLimits): True
		_: False


pure func test_initial_bootstrap_debt_requires_exact_opt_in() -> Bool:
	match parse_resource_policy(Some("record-initial-bootstrap-debt")):
		Ok(RecordInitialBootstrapDebt): True
		_: False


private pure func rejects_resource_policy(value: String) -> Bool:
	match parse_resource_policy(Some(value)):
		Err(error): error == "BLORP_2_RESOURCE_POLICY must be 'enforce-limits' or 'record-initial-bootstrap-debt'; unset it to enforce resource limits"
		Ok(_): False


pure func test_invalid_resource_policies_keep_exact_error() -> Bool:
	rejects_resource_policy("") and rejects_resource_policy("record") and rejects_resource_policy("Enforce-Limits") and rejects_resource_policy(" record-initial-bootstrap-debt ")


pure func test_policy_preserves_strict_allocation_error() -> Bool:
	match assess_resource_limits(EnforceLimits, { allocations = 82, instructions = Some(12346) }, { allocations = 81, instructions = 12345 }):
		Err(error): error == "compiler allocations exceeded limit: 82 > 81"
		Ok(_): False


pure func test_policy_preserves_strict_instruction_error() -> Bool:
	match assess_resource_limits(EnforceLimits, { allocations = 81, instructions = Some(12346) }, { allocations = 81, instructions = 12345 }):
		Err(error): error == "compiler retired instructions exceeded limit: 12346 > 12345"
		Ok(_): False


pure func test_both_policies_pass_costs_at_limits() -> Bool:
	cost: CompilationCost = { allocations = 81, instructions = Some(12345) }
	limits: CostLimits = { allocations = 81, instructions = 12345 }
	match assess_resource_limits(EnforceLimits, cost, limits):
		Ok(ResourceChecksPassed):
			match assess_resource_limits(RecordInitialBootstrapDebt, cost, limits):
				Ok(ResourceChecksPassed): True
				_: False
		_: False


pure func test_debt_retains_both_counters_limits_and_original_error() -> Bool:
	match assess_resource_limits(RecordInitialBootstrapDebt, { allocations = 82, instructions = Some(12346) }, { allocations = 81, instructions = 12345 }):
		Ok(InitialBootstrapDebt(cost, limits, reason)):
			cost.allocations == 82 and cost.instructions == Some(12346) and limits.allocations == 81 and limits.instructions == 12345 and reason == "compiler allocations exceeded limit: 82 > 81"
		_: False


pure func test_instruction_debt_keeps_its_original_error() -> Bool:
	match assess_resource_limits(RecordInitialBootstrapDebt, { allocations = 81, instructions = Some(12346) }, { allocations = 81, instructions = 12345 }):
		Ok(InitialBootstrapDebt(cost, limits, reason)):
			cost.allocations == 81 and cost.instructions == Some(12346) and limits.allocations == 81 and limits.instructions == 12345 and reason == "compiler retired instructions exceeded limit: 12346 > 12345"
		_: False


pure func test_unmeasured_debt_does_not_invent_instructions() -> Bool:
	match assess_resource_limits(RecordInitialBootstrapDebt, { allocations = 82, instructions = None }, { allocations = 81, instructions = 12345 }):
		Ok(InitialBootstrapDebt(cost, limits, reason)):
			cost.allocations == 82 and cost.instructions.is_none() and limits.instructions == 12345 and reason == "compiler allocations exceeded limit: 82 > 81"
		_: False


pure func test_debt_record_preserves_every_value_and_original_reason() -> Bool:
	format_initial_bootstrap_debt(
		{ allocations = 82, instructions = Some(12346) }, { allocations = 81, instructions = 12345 },
		"compiler allocations exceeded limit: 82 > 81",
	) == "BLORP2_RESOURCE_RESULT status=FAIL policy=record-initial-bootstrap-debt allocations=82 allocation_limit=81 instructions=12346 instruction_limit=12345 reason=compiler allocations exceeded limit: 82 > 81"


pure func test_unmeasured_debt_record_still_preserves_instruction_limit() -> Bool:
	format_initial_bootstrap_debt(
		{ allocations = 82, instructions = None }, { allocations = 81, instructions = 12345 },
		"compiler allocations exceeded limit: 82 > 81",
	) == "BLORP2_RESOURCE_RESULT status=FAIL policy=record-initial-bootstrap-debt allocations=82 allocation_limit=81 instructions=unmeasured instruction_limit=12345 reason=compiler allocations exceeded limit: 82 > 81"


tests: TestSuite = {
	description = "Blorp 2 compilation cost reports",
	tests = [
		("missing allocation report keeps exact error", test_missing_allocation_report_keeps_its_exact_error),
		("complete allocation report", test_complete_allocation_report),
		(
			"allocation report must be complete and clean",
			test_allocation_report_must_be_complete_and_clean,
		),
		("retired instructions report", test_retired_instructions_report),
		(
			"instructions cannot be missing or ambiguous",
			test_instructions_cannot_be_missing_or_ambiguous,
		),
		("each cost limit is enforced", test_each_cost_limit_is_enforced),
		("missing instruction setting requires measurement", test_missing_instruction_setting_requires_measurement),
		("explicit required setting requires measurement", test_explicit_required_setting_requires_measurement),
		("explicit disabled setting disables measurement", test_explicit_disabled_setting_disables_measurement),
		("empty instruction setting is an exact error", test_empty_instruction_setting_is_an_exact_error),
		("unknown instruction settings are exact errors", test_unknown_instruction_settings_are_exact_errors),
		("disabled instructions retain allocation limit", test_disabled_instructions_still_enforce_allocation_limit),
		("instruction limit failure preserves exact counter", test_instruction_limit_failure_preserves_exact_counter),
		("measured cost format has both counters and limits", test_measured_cost_format_has_both_counters_and_limits),
		("disabled cost format invents no counter", test_disabled_cost_format_does_not_invent_a_counter),
		("missing instruction counter keeps exact error", test_missing_instruction_counter_keeps_exact_error),
		("disabled instructions retain clean allocation reports", test_disabled_instructions_do_not_relax_allocation_reports),
		("resource policy defaults to enforcement", test_resource_policy_defaults_to_enforcement),
		("explicit resource enforcement", test_explicit_resource_enforcement),
		("initial bootstrap debt requires exact opt in", test_initial_bootstrap_debt_requires_exact_opt_in),
		("invalid resource policies keep exact error", test_invalid_resource_policies_keep_exact_error),
		("policy preserves strict allocation error", test_policy_preserves_strict_allocation_error),
		("policy preserves strict instruction error", test_policy_preserves_strict_instruction_error),
		("both policies pass costs at limits", test_both_policies_pass_costs_at_limits),
		("debt retains both counters limits and original error", test_debt_retains_both_counters_limits_and_original_error),
		("instruction debt keeps original error", test_instruction_debt_keeps_its_original_error),
		("unmeasured debt invents no instructions", test_unmeasured_debt_does_not_invent_instructions),
		("debt record preserves every value and reason", test_debt_record_preserves_every_value_and_original_reason),
		("unmeasured debt record preserves instruction limit", test_unmeasured_debt_record_still_preserves_instruction_limit),
	]
}
