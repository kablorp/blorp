import:
	../../e2e/harness: NativeCase, argv_case, native_case, native_command, verify_native_case_result
	process: ProcessExit(Exited, Signaled, TimedOut), ProcessResult, ProcessStdin(BytesStdin)
	test: TestSuite


private pure func expected_case() -> NativeCase:
	native_case("exact bytes", "20\n22\n", 0, "42\0\n")


private pure func actual_result(exit: ProcessExit, stdout: String, stderr: String) -> ProcessResult:
	{
		exit = exit,
		stdout = stdout.to_bytes(),
		stderr = stderr.to_bytes()
	}


private pure func has_error(actual: ProcessResult, expected: String) -> Bool:
	match verify_native_case_result(expected_case(), actual):
		Ok(_):
			False
		Err(error):
			error == expected


pure func test_exact_bytes_pass() -> Bool:
	verify_native_case_result(expected_case(), actual_result(Exited(0), "42\0\n", "")).is_ok()


pure func test_exit_status_mismatch_is_distinct() -> Bool:
	has_error(actual_result(Exited(1), "42\0\n", ""), "expected exit 0, got exit 1")


pure func test_signal_cannot_pass_as_an_exit_status() -> Bool:
	has_error(actual_result(Signaled(9), "42\0\n", ""), "expected exit 0, got signal 9")


pure func test_timeout_cannot_pass_as_an_exit_status() -> Bool:
	has_error(actual_result(TimedOut, "42\0\n", ""), "expected exit 0, got timeout")


pure func test_missing_stdout_newline_is_rejected() -> Bool:
	has_error(actual_result(Exited(0), "42\0", ""), "stdout: expected hex 3432000a, got 343200")


pure func test_stdout_after_nul_is_observed() -> Bool:
	has_error(actual_result(Exited(0), "42\0x\n", ""), "stdout: expected hex 3432000a, got 343200780a")


pure func test_stdout_utf8_bytes_are_observed() -> Bool:
	expected = native_case("Unicode", "", 0, "é🙂\n")
	verify_native_case_result(expected, actual_result(Exited(0), "é🙂\n", "")).is_ok()


pure func test_stderr_mismatch_is_distinct() -> Bool:
	has_error(actual_result(Exited(0), "42\0\n", "x\0\n"), "stderr: expected hex , got 78000a")


pure func test_explicit_stderr_bytes_are_supported() -> Bool:
	expected = { expected_case() | stderr = "x\0\n".to_bytes() }
	verify_native_case_result(expected, actual_result(Exited(0), "42\0\n", "x\0\n")).is_ok()


pure func test_command_preserves_stdin_bytes() -> Bool:
	expected = native_case("stdin bytes", "20\0\n22", 0, "42\n")
	request = native_command("/fixture/program", expected)

	match request.stdin:
		BytesStdin(input):
			request.program == "/fixture/program" and request.args.is_empty() and input == "20\0\n22".to_bytes()
		_:
			False


pure func test_empty_input_is_explicit_eof() -> Bool:
	match native_command("/fixture/program", native_case("EOF", "", 1, "missing input\n")).stdin:
		BytesStdin(input):
			input.length() == 0
		_:
			False


pure func test_command_has_no_implicit_timeout() -> Bool:
	native_command("/fixture/program", expected_case()).timeout.is_none()


pure func test_command_passes_explicit_arguments() -> Bool:
	expected = argv_case("argv", ["20", "22"], 0, "42\n")
	request = native_command("/fixture/program", expected)
	request.program == "/fixture/program" and request.args == ["20", "22"]


pure func test_argument_boundaries_preserve_empty_spaces_and_unicode() -> Bool:
	arguments = ["", "two words", "\"quoted\"", "é🙂", "line\nbreak", "carriage\rreturn"]
	native_command("/fixture/program", argv_case("argument bytes", arguments, 0, "")).args == arguments


pure func test_argv_case_has_empty_byte_input() -> Bool:
	expected = argv_case("argv only", ["42"], 0, "42\n")
	match native_command("/fixture/program", expected).stdin:
		BytesStdin(input):
			input.length() == 0 and expected.arguments == ["42"]
		_:
			False


pure func test_arguments_and_stdin_are_independent() -> Bool:
	expected = { native_case("both inputs", "x\0" + "123", 0, "") | arguments = ["argument"] }
	request = native_command("/fixture/program", expected)
	match request.stdin:
		BytesStdin(input):
			request.args == ["argument"] and input == ("x\0" + "123").to_bytes()
		_:
			False


tests: TestSuite = {
	description = "Blorp 2 native case assertions",
	tests = [
		("exact bytes pass", test_exact_bytes_pass),
		("exit status mismatch is distinct", test_exit_status_mismatch_is_distinct),
		("signal cannot pass as an exit status", test_signal_cannot_pass_as_an_exit_status),
		("timeout cannot pass as an exit status", test_timeout_cannot_pass_as_an_exit_status),
		("missing stdout newline is rejected", test_missing_stdout_newline_is_rejected),
		("stdout after NUL is observed", test_stdout_after_nul_is_observed),
		("stdout UTF-8 bytes are observed", test_stdout_utf8_bytes_are_observed),
		("stderr mismatch is distinct", test_stderr_mismatch_is_distinct),
		("explicit stderr bytes are supported", test_explicit_stderr_bytes_are_supported),
		("command preserves stdin bytes", test_command_preserves_stdin_bytes),
		("empty input is explicit EOF", test_empty_input_is_explicit_eof),
		("command has no implicit timeout", test_command_has_no_implicit_timeout),
		("command passes explicit arguments", test_command_passes_explicit_arguments),
		("argument boundaries preserve empty spaces and Unicode", test_argument_boundaries_preserve_empty_spaces_and_unicode),
		("argv case has empty byte input", test_argv_case_has_empty_byte_input),
		("arguments and stdin are independent", test_arguments_and_stdin_are_independent),
	]
}
