import:
    ../../e2e/self_hosted_reports: verify_accounting
    result: Result methods
    list: List methods
    string: String methods
    bool: not, and
    test: TestSuite


pure func test_balanced_reports_respect_zero_and_positive_policies() -> Bool:
    zero = "blorp: leak check: 0 allocs, 0 releases, 0 leaked, 0 bytes\n"
    positive = "blorp: leak check: 7 allocs, 7 releases, 0 leaked, 0 bytes\n"
    verify_accounting(zero, False).is_ok().and(verify_accounting(zero, True).is_ok().not()).and(
        verify_accounting(positive, True).is_ok(),
    )


pure func test_malformed_unbalanced_and_extra_reports_fail() -> Bool:
    reports: List[String] = [
        "",
        "blorp: leak check: 7 allocs, 6 releases, 0 leaked, 0 bytes\n",
        "blorp: leak check: 7 allocs, 7 releases, 1 leaked, 8 bytes\n",
        "blorp: leak check: 07 allocs, 07 releases, 0 leaked, 0 bytes\n",
        "blorp: leak check: -1 allocs, -1 releases, 0 leaked, 0 bytes\n",
        "blorp: leak check: 9223372036854775808 allocs, 9223372036854775808 releases, 0 leaked, 0 bytes\n",
        "blorp: leak check: x allocs, x releases, 0 leaked, 0 bytes\n",
        "blorp: leak check: 1 allocs, 1 releases, 0 leaked, 0 bytes",
        "extra\nblorp: leak check: 1 allocs, 1 releases, 0 leaked, 0 bytes\n",
        "blorp: leak check: 1 allocs, 1 releases, 0 leaked, 0 bytes\nextra\n",
        "blorp: leak check: 1 allocs, 1 releases, 0 leaked, 0 bytes\nblorp: leak check: 1 allocs, 1 releases, 0 leaked, 0 bytes\n",
    ]
    reports.all(pure func(report: String): verify_accounting(report, False).is_ok().not())


tests: TestSuite = {
    description = "Self-hosted e2e accounting reports",
    tests = [
        ("zero and positive policies accept only their accounting reports", test_balanced_reports_respect_zero_and_positive_policies),
        ("missing malformed unbalanced extra and duplicate reports reject", test_malformed_unbalanced_and_extra_reports_fail),
    ]
}
