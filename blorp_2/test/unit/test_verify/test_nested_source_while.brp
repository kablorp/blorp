import:
	../../../src/check/model as Model
	./selection_inputs as Selection
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Entrypoint(NoArguments), EntryResult(IntegerExitStatus), same_span
	../../../src/verify/verify: verify
	../ownership_inputs: InputIds, input_ids, span
	../source_while_inputs as Input
	../nested_while_inputs as Nested
	test: TestSuite


private union NestedFault:
	ValidNestedEdges
	DischargePreOnInnerBackedge
	DischargePreOnInnerExit


private pure func integer(id: Lower.ValueId, value: Int, at: Int) -> Own.OwnershipOperation:
	Own.DefineValue({
		id = id, value_type = Concrete.IntType, operation = Own.IntegerDefinition(value),
		result = Own.UnmanagedResult, span = span(at),
	})


-- Only nominal/value identities and layouts come from the ordinary seed.
-- Every nested ownership operation and edge here is independent of Own.
private pure func raw_program(ids: InputIds, fault: NestedFault) -> Own.OwnershipProgram:
	var recur_operations = [integer(ids.sixth, 11, 60)]
	var break_operations = [integer(ids.seventh, 42, 70)]
	match fault:
		ValidNestedEdges: void
		DischargePreOnInnerBackedge:
			recur_operations = recur_operations.append(Own.DropOwner(Own.owner_id(0), span(75)))
		DischargePreOnInnerExit:
			break_operations = break_operations.append(Own.DropOwner(Own.owner_id(0), span(75)))
	inner: Own.OwnedLoop = {
		entry_acquisitions = [],
		headers = [],
		result = Own.UnmanagedJoinParameter({ id = ids.fifth, value_type = Concrete.IntType, span = span(50) }),
		carried = [],
		body = {
			operations = [],
			tail = Own.MatchLoop({
				selection = Selection.branches(Own.UnmanagedArgument(ids.first), ids.second_variant),
				arms = [
					{
						id = Model.match_arm_id(0), inputs = [],
						body = { operations = recur_operations, tail = Own.ExitLoop(Own.Recur([], span(80))) },
					},
					{
						id = Model.match_arm_id(1), inputs = [],
						body = { operations = break_operations, tail = Own.ExitLoop(Own.Break({ value = Own.UnmanagedReturn(ids.seventh), carried = [], span = span(80) })) },
					},
				],
			}),
		},
	}
	{
		records = [], unions = ids.unions,
		functions = [
			{
				parameters = [Own.ManagedParameter({ value_type = Concrete.UnionType(ids.union_id), owned = False })], return_type = Concrete.IntType,
				operations = [
					Own.DefineValue({
						id = ids.first, value_type = Concrete.UnionType(ids.union_id),
						operation = Own.ParameterDefinition(0), result = Own.UnmanagedResult, span = span(10),
					}),
					integer(ids.second, 7, 20),
					Own.DefineValue({
						id = ids.third, value_type = Concrete.StringType,
						operation = Own.CallDefinition(Concrete.RuntimeFunction(Builtins.IntToString), [Own.UnmanagedArgument(ids.second)]),
						result = Own.OwnedResult(Own.owner_id(0)), span = span(30),
					}),
					Own.ExecuteLoop({
						entry_acquisitions = [],
						headers = [],
						result = Own.UnmanagedJoinParameter({ id = ids.fourth, value_type = Concrete.IntType, span = span(40) }),
						carried = [],
						body = {
							operations = [Own.ExecuteLoop(inner)],
							tail = Own.ExitLoop(Own.Break({ value = Own.UnmanagedReturn(ids.fifth), carried = [], span = span(90) })),
						},
					}),
					Own.DropOwner(Own.owner_id(0), span(95)),
				],
				result = Own.UnmanagedReturn(ids.fourth),
			},
			{
				parameters = [], return_type = Concrete.IntType,
				operations = [integer(ids.first, 0, 1)], result = Own.UnmanagedReturn(ids.first),
			},
		],
		entrypoint = NoArguments(ids.second_function, IntegerExitStatus),
	}


pure func test_raw_nested_edges_preserve_grandparent_pre() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): verify(raw_program(ids, ValidNestedEdges)).is_ok()


private pure func rejects_nested_pre_discharge(fault: NestedFault) -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			baseline = verify(raw_program(ids, ValidNestedEdges)).is_ok()
			match verify(raw_program(ids, fault)):
				Ok(_): False
				Err(error):
					(baseline and same_span(error.span, span(80))
						and error.message == "ownership verification failed: loop edge discharges a captured owner"
						and error.help == "report this compiler error with the input program"
						and error.note.is_none())


pure func test_raw_inner_backedge_cannot_retire_grandparent_pre() -> Bool:
	rejects_nested_pre_discharge(DischargePreOnInnerBackedge)


pure func test_raw_inner_exit_cannot_retire_grandparent_pre() -> Bool:
	rejects_nested_pre_discharge(DischargePreOnInnerExit)


pure func test_source_nested_ownership_verifies() -> Bool:
	Input.lowered(Nested.MANAGED_PRE).and_then(Own.own).and_then(verify).is_ok()


tests: TestSuite = {
	description = "Blorp 2 nested scalar while verification",
	tests = [
		("raw nested edges preserve grandparent PRE", test_raw_nested_edges_preserve_grandparent_pre),
		("raw inner backedge cannot retire grandparent PRE", test_raw_inner_backedge_cannot_retire_grandparent_pre),
		("raw inner exit cannot retire grandparent PRE", test_raw_inner_exit_cannot_retire_grandparent_pre),
		("source nested ownership verifies", test_source_nested_ownership_verifies),
	]
}
