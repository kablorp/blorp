		Err(_): False
		Ok(ids): verify(raw_list_update(ids, is_set, update_arguments(ids, is_set, True), [Own.DropOwner(Own.owner_id(1), span(40))])).is_ok()


pure func test_consumed_set_verifies() -> Bool:
