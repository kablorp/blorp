private pure func update_stale_borrow_rejects(is_set: Bool) -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			stale: Own.OwnedDefinition = { id = ids.fifth, value_type = Concrete.IntType,
				operation = Own.CallDefinition(Concrete.RuntimeFunction(Builtins.ListLength(Concrete.StringType)), [Own.BorrowedArgument({ value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) })]), result = Own.UnmanagedResult, span = span(40) }
			rejects(raw_list_update(ids, is_set, update_arguments(ids, is_set, True), [Own.DefineValue(stale)]), "borrow refers to discharged owner 0", 40)


