pure func test_concat_same_owner_rhs_rejects_after_discharge() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			arguments = [Own.ConsumedArgument(ids.first, Own.owner_id(0)), Own.BorrowedArgument({ value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) })]
			rejects(raw_list_update(ids, False, arguments, [Own.DropOwner(Own.owner_id(1), span(40))]), "borrow refers to discharged owner 0", 30)


private pure func counted_alias_program(ids: InputIds, consumed: Bool) -> Own.OwnershipProgram:
	counted_alias: Own.BorrowedValue = { value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) }
	arguments = update_arguments(ids, False, consumed).set(1, Own.BorrowedArgument({ value = ids.first, source = Own.OwnerBorrow(Own.owner_id(1)) }))
	cleanup = if consumed:
		[Own.DropOwner(Own.owner_id(1), span(40))]
	else:
		[Own.DropOwner(Own.owner_id(0), span(40)), Own.DropOwner(Own.owner_id(1), span(41))]
	program = raw_list_update(ids, False, arguments, cleanup)
	functions = program.functions.map(pure func(function) -> Own.OwnedFunction:
		var operations: List[Own.OwnershipOperation] = []
		for operation in function.operations:
			match operation:
				Own.DefineValue(definition):
					if Lower.value_number(definition.id).equals(Lower.value_number(ids.second)):
						-- Preserve the contiguous value ordinal while acquiring another owner of the first value.
						operations = operations.append(Own.DefineValue({ definition | value_type = Concrete.IntType, operation = Own.IntegerDefinition(0), result = Own.UnmanagedResult }))
						operations = operations.append(Own.AcquireOwner(Own.owner_id(1), counted_alias, span(20)))
					else:
						operations = operations.append(operation)
				_: operations = operations.append(operation)
		{ function | operations = operations }
	)
	{ program | functions = functions }


pure func test_concat_independent_counted_alias_verifies() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): verify(counted_alias_program(ids, True)).is_ok()


pure func test_concat_borrowed_counted_alias_control_verifies() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): verify(counted_alias_program(ids, False)).is_ok()


tests: TestSuite = {
	description = "List update independent ownership verification",
	tests = [
		("concat borrowed counted alias raw control is well formed", test_concat_borrowed_counted_alias_control_verifies),
		("raw consumed set verifies all three typed operands", test_consumed_set_verifies),
		("raw consumed concat transfers only left owner", test_consumed_concat_verifies),
		("set third argument cannot consume replacement owner", test_set_third_argument_cannot_consume),
		("set requires its third argument before transfer", test_set_missing_third_argument_rejects),
		("concat rejects extra argument before transfer", test_concat_extra_argument_rejects),
		("set index contract rejects wrong type", test_set_wrong_index_type_rejects),
		("set first argument requires its own counted owner", test_set_wrong_owner_rejects),
		("concat first argument requires its own counted owner", test_concat_wrong_owner_rejects),
		("set old owner cannot be dropped again", test_set_old_drop_rejects),
		("concat old owner cannot be dropped again", test_concat_old_drop_rejects),
		("set later stale left borrow rejects", test_set_stale_borrow_rejects),
		("concat later stale left borrow rejects", test_concat_stale_borrow_rejects),
		("concat same owner RHS rejects after first discharge", test_concat_same_owner_rhs_rejects_after_discharge),
		("concat distinct counted alias remains valid after discharge", test_concat_independent_counted_alias_verifies),
		("consumed List accepts unmanaged Int element", test_consumed_list_with_unmanaged_integer_verifies),
		("unadmitted List runtime target cannot consume", test_wrong_runtime_target_rejected),
		("same owner cannot be consumed by two calls", test_duplicate_owner_consumption_rejected),
		("consumption requires the owner of this List value", test_wrong_counted_owner_rejected),
		("selection edge rejects append before a dependent projection can escape", test_selection_edge_cannot_append_a_projected_child),
		("raw consumed append transfers input and returns fresh owner", test_independent_consuming_append_verifies),
		("transferred List cannot be dropped again", test_trailing_old_owner_drop_rejected),
		("element position cannot consume an owner", test_second_operand_cannot_be_consumed),
		("consumed operand must match List element contract", test_wrong_list_element_type_rejected),
		("later borrow of transferred List is rejected", test_stale_list_borrow_rejected),
	]
}
