import:
	../../../src/check/check: check
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/namespace/builtins as Builtins
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, FunctionExecution(OrdinaryCalls), Entrypoint(NoArguments), EntryResult(IntegerExitStatus), entry_function
	../../../src/verify/verify: verify
	../input: setup_diagnostic
	list: set_index
	../module_input: parse_modules
	../ownership_inputs: InputIds, function, input_ids, integer, parameter, runtime, span
	test: TestSuite


private fixed record Seed {
	ids: InputIds,
	parse_function: Lower.LoweredFunction,
	integer_option: Builtins.DesignatedOption[Concrete.VariantInstanceId],
	string_option: Builtins.DesignatedOption[Concrete.VariantInstanceId],
	string_field: Concrete.VariantFieldInstanceId,
	unions: List[Concrete.ConcreteUnion]
}


private pure func seed_error() -> Diagnostic:
	{
		span = span(0),
		note = None,
		message = "invalid Option ownership identity seed",
		help = "fix the Option ownership test seed"
	}


private pure func parse_option(function: Lower.LoweredFunction) -> Result[Builtins.DesignatedOption[Concrete.VariantInstanceId], Diagnostic]:
	match function.steps:
		[Lower.Define(_), Lower.Define(result)]:
			match result.operation:
				Lower.CallValue(call, [_]):
					match call.target:
						Concrete.RuntimeFunction(Builtins.StringParseInt(option)): Ok(option)
						_: Err(seed_error())
				_: Err(seed_error())
		_: Err(seed_error())


-- This producer supplies opaque identities and Lower IR only. Every verifier
-- input below independently declares its operations, owners and borrow edges.
private pure func seed() -> Result[Seed, Diagnostic]:
	source: String =
		|pure func parse_number(text: String) -> Option[Int]:
		|    builtin("string.parse_int")
		|pure func read_text(values: List[String], index: Int) -> Option[String]:
		|    builtin("list.get")
		|func main(arguments: List[String]) -> Int:
		|    parsed = parse_number("42")
		|    read = read_text(arguments, 0)
		|    0
		|
	ids ?= input_ids()
	parsed ?= parse_modules([{ source = source, targets = [] }])
	checked ?= check(parsed).map_err(setup_diagnostic)
	concrete ?= Concrete.specialize(checked)
	lowered ?= Lower.lower(concrete)
	contents = Lower.lowered_functions(lowered)
	match contents.functions:
		[_, parser, reader]:
			integer_option ?= parse_option(parser)
			match reader.steps:
				[Lower.Define(_), Lower.Define(_), Lower.Define(result)]:
					match result.operation:
						Lower.CallValue(call, [_, _]):
							match call.target:
								Concrete.RuntimeFunction(Builtins.ListGet(_, string_option)):
									string_field ?= Concrete.variant_field(string_option.some, 0, contents.unions, span(0))
									Ok({ ids = ids, parse_function = parser, integer_option = integer_option, string_option = string_option, string_field = string_field, unions = contents.unions })
								_: Err(seed_error())
						_: Err(seed_error())
				_: Err(seed_error())
		_: Err(seed_error())


private pure func result_type(option: Builtins.DesignatedOption[Concrete.VariantInstanceId]) -> Concrete.TypeRef:
	Concrete.UnionType(Concrete.variant_owner(option.some))


pure func test_option_int_has_no_ownership() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			match Concrete.value_ownership(result_type(seed.integer_option), seed.unions, []):
				Ok(Concrete.NoOwnership): True
				_: False


pure func test_option_string_has_inline_owned_fields() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			match Concrete.value_ownership(result_type(seed.string_option), seed.unions, []):
				Ok(Concrete.InlineOwnedFields(owner)):
					Concrete.union_number(owner) == Concrete.union_number(Concrete.variant_owner(seed.string_option.some))
				_: False


pure func test_parse_last_uses_include_borrow_and_unmanaged_return() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			match seed.parse_function.tail:
				Lower.ExitValue(Lower.ReturnValue(returned)):
					match Own.last_uses(seed.parse_function.steps, returned):
						Ok(uses): uses == [Some(1), Some(2)]
						Err(_): False
				_: False


pure func test_parse_borrows_parameter_without_acquiring_result() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			match Own.insert_function(seed.parse_function, seed.unions, []):
				Err(_): False
				Ok(function):
					match (function.operations, function.tail):
						([Own.DefineValue(parameter), Own.DefineValue(result)], Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(returned)))):
							match (parameter.result, result.operation, result.result):
								(Own.BorrowedResult(Own.ParameterBorrow(source)), Own.CallDefinition(_, [Own.BorrowedArgument(argument)]), Own.UnmanagedResult):
									match argument.source:
										Own.ParameterBorrow(borrowed):
											Lower.value_number(source) == Lower.value_number(parameter.id) and Lower.value_number(borrowed) == Lower.value_number(parameter.id) and Lower.value_number(argument.value) == Lower.value_number(parameter.id) and Lower.value_number(returned) == Lower.value_number(result.id)
										_: False
								_: False
						_: False


pure func test_parse_owned_input_drops_after_final_borrow() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			ids = seed.ids
			input: Lower.ValueDefinition = { id = ids.first, value_type = Concrete.StringType, operation = Lower.StringValue("42"), span = span(10) }
			lowered = function([input, runtime(ids.second, Builtins.StringParseInt(seed.integer_option), [ids.first], result_type(seed.integer_option), 30), integer(ids.third, 0, 50)], ids.third, [], Concrete.IntType)
			match Own.insert_function(lowered, seed.unions, []):
				Ok(function):
					match function.operations:
						[Own.DefineValue(input), Own.DefineValue(parsed), Own.DropOwner(dropped, at), Own.DefineValue(_)]:
							match (input.result, parsed.operation, parsed.result):
								(Own.OwnedResult(owner), Own.CallDefinition(_, [Own.BorrowedArgument(argument)]), Own.UnmanagedResult):
									match argument.source:
										Own.OwnerBorrow(borrowed): Own.owner_number(owner) == 0 and Own.owner_number(borrowed) == 0 and Own.owner_number(dropped) == 0 and at.start == 30 and Lower.value_number(argument.value) == 0
										_: False
								_: False
						_: False
				Err(_): False


private pure func read_function(seed: Seed, returned: Bool) -> Lower.LoweredFunction:
	ids = seed.ids
	list_type = Concrete.ListType(Concrete.StringType)
	read = runtime(ids.third, Builtins.ListGet(Concrete.StringType, seed.string_option), [ids.first, ids.second], result_type(seed.string_option), 30)
	inputs = [parameter(ids.first, list_type), integer(ids.second, 0, 20), read]
	if returned:
		function(inputs, ids.third, [list_type], result_type(seed.string_option))
	else:
		function(inputs.append(integer(ids.fourth, 0, 50)), ids.fourth, [list_type], Concrete.IntType)


pure func test_unused_list_get_fresh_owner_is_dropped_once() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			match Own.insert_function(read_function(seed, False), seed.unions, []):
				Ok(function):
					match function.operations:
						[Own.DefineValue(_), Own.DefineValue(_), Own.DefineValue(read), Own.DropOwner(owner, at), Own.DefineValue(_)]:
							match (read.operation, read.result):
								(Own.CallDefinition(_, [Own.BorrowedArgument(_), Own.UnmanagedArgument(_)]), Own.OwnedResult(fresh)): Own.owner_number(fresh) == 0 and Own.owner_number(owner) == 0 and at.start == 30
								_: False
						_: False
				Err(_): False


pure func test_returned_list_get_transfers_fresh_owner() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			match Own.insert_function(read_function(seed, True), seed.unions, []):
				Ok(function):
					match (function.operations, function.tail):
						([Own.DefineValue(_), Own.DefineValue(_), Own.DefineValue(read)], Own.ReturnTail(Own.ReturnResult(Own.OwnedReturn(value, owner)))):
							match read.result:
								Own.OwnedResult(fresh): Own.owner_number(fresh) == 0 and Own.owner_number(owner) == 0 and Lower.value_number(value) == Lower.value_number(read.id)
								_: False
						_: False
				Err(_): False


private pure func child_function(seed: Seed) -> Lower.LoweredFunction:
	ids = seed.ids
	option = seed.string_option
	{
		execution = OrdinaryCalls,
		signature = { parameters = [result_type(option)], return_type = Concrete.StringType },
		steps = [parameter(ids.first, result_type(option))].map(pure func(definition): Lower.Define(definition)),
		tail = Lower.MatchValue({
			scrutinee = ids.first,
			owner = Concrete.variant_owner(option.some),
			arms = [
				{ label = Lower.VariantLabel(option.none), body = { steps = [{ id = ids.second, value_type = Concrete.StringType, operation = Lower.StringValue("fallback"), span = span(20) }].map(pure func(definition): Lower.Define(definition)), exit = Lower.ReturnValue(ids.second) } },
				{ label = Lower.VariantLabel(option.some), body = { steps = [{ id = ids.third, value_type = Concrete.StringType, operation = Lower.PayloadValue(seed.string_field, ids.first), span = span(30) }].map(pure func(definition): Lower.Define(definition)), exit = Lower.ReturnValue(ids.third) } },
			]
		})
	}


pure func test_returned_child_acquires_only_its_selected_arm_borrow() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			match Own.insert_function(child_function(seed), seed.unions, []):
				Err(_): False
				Ok(function):
					match (function.operations, function.tail):
						([Own.DefineValue(_)], Own.MatchTail(matched)):
							match matched.arms:
								[absent, present]:
									match (absent.operations, absent.exit, present.operations, present.exit):
										([Own.DefineValue(fallback)], Own.ReturnResult(Own.OwnedReturn(_, fallback_owner)), [Own.DefineValue(child), Own.AcquireOwner(owner, borrow, at)], Own.ReturnResult(Own.OwnedReturn(returned, transferred))):
											match (fallback.result, child.result, borrow.source):
												(Own.OwnedResult(fresh), Own.BorrowedResult(Own.PayloadBorrow(parent)), Own.PayloadBorrow(source)):
													Own.owner_number(fresh) == 0 and Own.owner_number(fallback_owner) == 0 and Own.owner_number(owner) == 1 and Own.owner_number(transferred) == 1 and Lower.value_number(parent) == 0 and Lower.value_number(source) == 0 and Lower.value_number(borrow.value) == 2 and Lower.value_number(returned) == 2 and at.start == 30
												_: False
										_: False
								_: False
						_: False


pure func test_owned_list_get_prefix_drops_in_each_arm() -> Bool:
	match seed():
		Err(_):
			False
		Ok(seed):
			ids = seed.ids
			list_type = Concrete.ListType(Concrete.StringType)
			option = seed.integer_option
			owned: Lower.LoweredFunction = {
				execution = OrdinaryCalls,
				signature = {
					parameters = [list_type, result_type(option)],
					return_type = Concrete.IntType
				},
				steps = [
					parameter(ids.first, list_type),
					{ parameter(ids.second, result_type(option)) |
						operation = Lower.ParameterValue(1)
					},
					integer(ids.third, 0, 20),
					runtime(
						ids.fourth,
						Builtins.ListGet(Concrete.StringType, seed.string_option),
						[ids.first, ids.third],
						result_type(seed.string_option),
						30,
					),
					integer(ids.fifth, 0, 50),
				].map(pure func(definition): Lower.Define(definition)),
				tail = Lower.MatchValue({
					scrutinee = ids.second,
					owner = Concrete.variant_owner(option.some),
					arms = [
						{
							label = Lower.VariantLabel(option.none),
							body = {
								steps = [],
								exit = Lower.ReturnValue(ids.fifth)
							}
						},
						{
							label = Lower.VariantLabel(option.some),
							body = {
								steps = [],
								exit = Lower.ReturnValue(ids.fifth)
							}
						},
					],
				})
			}

			match Own.insert_function(owned, seed.unions, []):
				Err(_):
					False
				Ok(inserted):
					match inserted.tail:
						Own.MatchTail(matched):
							matched.arms.all(pure func(arm):
								match (arm.operations, arm.exit):
									([Own.DropOwner(owner, at)], Own.ReturnResult(Own.UnmanagedReturn(returned))):
										(
											Own.owner_number(owner) == 0
											and at.start == 30
											and Lower.value_number(
												returned,
											) == Lower.value_number(ids.fifth)
										)
									_:
										False
							)
						_:
							False


private pure func define(id: Lower.ValueId, value_type: Concrete.TypeRef, operation: Own.OwnedValueOperation, result: Own.ResultOwnership, at: Int) -> Own.OwnershipOperation:
	Own.DefineValue({ id = id, value_type = value_type, operation = operation, result = result, span = span(at) })


private pure func raw_function(operations: List[Own.OwnershipOperation], tail: Own.OwnedTail, parameters: List[Concrete.TypeRef], return_type: Concrete.TypeRef) -> Own.OwnedFunction:
	{ execution = OrdinaryCalls, signature = { parameters = parameters, return_type = return_type }, operations = operations, tail = tail }


private pure func raw_program(seed: Seed, tested: Own.OwnedFunction) -> Own.OwnershipProgram:
	ids = seed.ids
	entry = raw_function([define(ids.first, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 1)], Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.first))), [], Concrete.IntType)
	{ records = [], unions = seed.unions, functions = [entry, tested], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }


private pure func raw_parse(seed: Seed, option: Builtins.DesignatedOption[Concrete.VariantInstanceId], value_type: Concrete.TypeRef, result: Own.ResultOwnership, argument: Own.OwnedArgument) -> Own.OwnershipProgram:
	ids = seed.ids
	call: Concrete.ConcreteCall = { target = Concrete.RuntimeFunction(Builtins.StringParseInt(option)), span = span(30) }
	raw_program(seed, raw_function([
		define(ids.first, Concrete.StringType, Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(ids.first)), 10),
		define(ids.second, value_type, Own.CallDefinition(call, [argument]), result, 30),
		define(ids.third, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 50),
	], Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.third))), [Concrete.StringType], Concrete.IntType))


private pure func parse_argument(seed: Seed) -> Own.OwnedArgument:
	Own.BorrowedArgument({ value = seed.ids.first, source = Own.ParameterBorrow(seed.ids.first) })


private pure func valid_parse(seed: Seed) -> Own.OwnershipProgram:
	raw_parse(seed, seed.integer_option, result_type(seed.integer_option), Own.UnmanagedResult, parse_argument(seed))


private pure func rejects(program: Own.OwnershipProgram, message: String, at: Int) -> Bool:
	match verify(program):
		Err(error):
			error.message == "ownership verification failed: " + message and error.help == "report this compiler error with the input program" and same_source(error.span.source, module_source(root_module_id())) and error.span.start == at and error.span.end == at + 1 and error.note.is_none()
		Ok(_): False


pure func test_raw_parse_borrow_and_unmanaged_result_are_valid() -> Bool:
	match seed():
		Ok(seed): verify(valid_parse(seed)).is_ok()
		Err(_): False


-- Option[Int] and Option[String] are distinct concrete instances.
pure func test_verifier_rejects_option_constructors_from_different_instances() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			option = { some = seed.integer_option.some, none = seed.string_option.none }
			rejects(raw_parse(seed, option, result_type(option), Own.UnmanagedResult, parse_argument(seed)), "runtime Option constructors do not cover one result union", 30)


pure func test_verifier_rejects_swapped_option_constructors() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			option = { some = seed.integer_option.none, none = seed.integer_option.some }
			rejects(raw_parse(seed, option, result_type(option), Own.UnmanagedResult, parse_argument(seed)), "variant field count does not match its operation", 30)


pure func test_verifier_rejects_reused_option_constructor() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			option = { some = seed.integer_option.some, none = seed.integer_option.some }
			rejects(raw_parse(seed, option, result_type(option), Own.UnmanagedResult, parse_argument(seed)), "variant field count does not match its operation", 30)


pure func test_verifier_rejects_unknown_option_owner() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			program = valid_parse(seed)
			rejects({ program | unions = [] }, "unknown variant owner", 30)


private pure func rejects_layout(seed: Seed, variants: List[List[Concrete.TypeRef]], message: String) -> Bool:
	program = valid_parse(seed)
	owner = Concrete.union_number(Concrete.variant_owner(seed.integer_option.some))
	match seed.unions.set_index(owner, { variants = variants, representation = Concrete.InlineUnmanaged }):
		Some(unions): rejects({ program | unions = unions }, message, 30)
		None: False


pure func test_verifier_rejects_unknown_option_constructor_ordinal() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[Concrete.IntType]], "unknown variant identity")
		Err(_): False


pure func test_verifier_rejects_wrong_runtime_payload_type() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[Concrete.VoidType], []], "variant payload does not match its operation")
		Err(_): False


pure func test_verifier_rejects_uncovered_runtime_variant() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[Concrete.IntType], [], []], "runtime Option constructors do not cover one result union")
		Err(_): False


pure func test_verifier_rejects_wrong_parse_result_type() -> Bool:
	match seed():
		Ok(seed): rejects(raw_parse(seed, seed.integer_option, Concrete.IntType, Own.UnmanagedResult, parse_argument(seed)), "call result type does not match its contract", 30)
		Err(_): False


pure func test_verifier_rejects_owned_option_int_result() -> Bool:
	match seed():
		Ok(seed): rejects(raw_parse(seed, seed.integer_option, result_type(seed.integer_option), Own.OwnedResult(Own.owner_id(0)), parse_argument(seed)), "unmanaged value carries an ownership obligation", 30)
		Err(_): False


pure func test_verifier_rejects_borrowed_option_int_result() -> Bool:
	match seed():
		Ok(seed): rejects(raw_parse(seed, seed.integer_option, result_type(seed.integer_option), Own.BorrowedResult(Own.ParameterBorrow(seed.ids.first)), parse_argument(seed)), "unmanaged value carries an ownership obligation", 30)
		Err(_): False


pure func test_verifier_rejects_unmanaged_parse_string_argument() -> Bool:
	match seed():
		Ok(seed): rejects(raw_parse(seed, seed.integer_option, result_type(seed.integer_option), Own.UnmanagedResult, Own.UnmanagedArgument(seed.ids.first)), "managed call argument requires an owner-dependent borrow", 30)
		Err(_): False


pure func test_verifier_rejects_parse_borrow_after_input_drop() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			ids = seed.ids
			call: Concrete.ConcreteCall = { target = Concrete.RuntimeFunction(Builtins.StringParseInt(seed.integer_option)), span = span(30) }
			tested = raw_function([
				define(ids.first, Concrete.StringType, Own.StringDefinition("42"), Own.OwnedResult(Own.owner_id(0)), 10),
				Own.DropOwner(Own.owner_id(0), span(20)),
				define(ids.second, result_type(seed.integer_option), Own.CallDefinition(call, [Own.BorrowedArgument({ value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) })]), Own.UnmanagedResult, 30),
				define(ids.third, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 50),
			], Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.third))), [], Concrete.IntType)
			rejects(raw_program(seed, tested), "borrow refers to discharged owner 0", 30)


private pure func read_arguments(seed: Seed) -> List[Own.OwnedArgument]:
	[Own.BorrowedArgument({ value = seed.ids.first, source = Own.ParameterBorrow(seed.ids.first) }), Own.UnmanagedArgument(seed.ids.second)]


private pure func raw_read_call(seed: Seed, option: Builtins.DesignatedOption[Concrete.VariantInstanceId], arguments: List[Own.OwnedArgument], value_type: Concrete.TypeRef, result: Own.ResultOwnership, drops: List[Own.OwnershipOperation]) -> Own.OwnershipProgram:
	ids = seed.ids
	list_type = Concrete.ListType(Concrete.StringType)
	call: Concrete.ConcreteCall = { target = Concrete.RuntimeFunction(Builtins.ListGet(Concrete.StringType, option)), span = span(30) }
	operations = [
		define(ids.first, list_type, Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(ids.first)), 10),
		define(ids.second, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 20),
		define(ids.third, value_type, Own.CallDefinition(call, arguments), result, 30)
	] + drops + [define(ids.fourth, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 50)]
	raw_program(seed, raw_function(operations, Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.fourth))), [list_type], Concrete.IntType))


private pure func raw_read(seed: Seed, result: Own.ResultOwnership, drops: List[Own.OwnershipOperation]) -> Own.OwnershipProgram:
	raw_read_call(seed, seed.string_option, read_arguments(seed), result_type(seed.string_option), result, drops)


-- Keep the rest of a valid get program fixed while varying one call fact.
private pure func changed_read(seed: Seed, option: Builtins.DesignatedOption[Concrete.VariantInstanceId], arguments: List[Own.OwnedArgument], value_type: Concrete.TypeRef) -> Own.OwnershipProgram:
	raw_read_call(seed, option, arguments, value_type, Own.OwnedResult(Own.owner_id(0)), [Own.DropOwner(Own.owner_id(0), span(40))])


pure func test_raw_read_fresh_result_and_single_drop_are_valid() -> Bool:
	match seed():
		Ok(seed): verify(raw_read(seed, Own.OwnedResult(Own.owner_id(0)), [Own.DropOwner(Own.owner_id(0), span(40))])).is_ok()
		Err(_): False


pure func test_verifier_rejects_wrong_list_get_list_argument() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			arguments = [Own.UnmanagedArgument(seed.ids.second), Own.UnmanagedArgument(seed.ids.second)]
			rejects(changed_read(seed, seed.string_option, arguments, result_type(seed.string_option)), "call argument type does not match its contract", 30)


pure func test_verifier_rejects_wrong_list_get_index_argument() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			argument: Own.OwnedArgument = Own.BorrowedArgument({ value = seed.ids.first, source = Own.ParameterBorrow(seed.ids.first) })
			rejects(changed_read(seed, seed.string_option, [argument, argument], result_type(seed.string_option)), "call argument type does not match its contract", 30)


pure func test_verifier_rejects_unmanaged_list_get_argument() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			arguments = [Own.UnmanagedArgument(seed.ids.first), Own.UnmanagedArgument(seed.ids.second)]
			rejects(changed_read(seed, seed.string_option, arguments, result_type(seed.string_option)), "managed call argument requires an owner-dependent borrow", 30)


pure func test_verifier_rejects_wrong_list_get_result_type() -> Bool:
	match seed():
		Err(_): False
		Ok(seed): rejects(changed_read(seed, seed.string_option, read_arguments(seed), Concrete.IntType), "call result type does not match its contract", 30)


pure func test_verifier_rejects_swapped_list_get_constructors() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			option = { some = seed.string_option.none, none = seed.string_option.some }
			rejects(changed_read(seed, option, read_arguments(seed), result_type(seed.string_option)), "variant field count does not match its operation", 30)


pure func test_list_get_last_uses_include_root_borrow_and_index() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			function = read_function(seed, True)
			-- Definitions 0 and 1 are the root and index; get at position 2
			-- uses both. Its fresh result is then used by return at position 3.
			match Own.last_uses(function.steps, seed.ids.third):
				Ok(uses): uses == [Some(2), Some(2), Some(3)]
				Err(_): False


pure func test_verifier_rejects_unmanaged_list_get_result() -> Bool:
	match seed():
		Ok(seed): rejects(raw_read(seed, Own.UnmanagedResult, []), "managed result requires an owner", 30)
		Err(_): False


pure func test_verifier_rejects_borrowed_list_get_result() -> Bool:
	match seed():
		Ok(seed): rejects(raw_read(seed, Own.BorrowedResult(Own.ParameterBorrow(seed.ids.first)), []), "managed result requires an owner", 30)
		Err(_): False


pure func test_verifier_rejects_undropped_list_get_result() -> Bool:
	match seed():
		Ok(seed): rejects(raw_read(seed, Own.OwnedResult(Own.owner_id(0)), []), "owner 0 remains live at return", 50)
		Err(_): False


pure func test_verifier_rejects_double_drop_of_list_get_result() -> Bool:
	match seed():
		Ok(seed): rejects(raw_read(seed, Own.OwnedResult(Own.owner_id(0)), [Own.DropOwner(Own.owner_id(0), span(40)), Own.DropOwner(Own.owner_id(0), span(45))]), "owner 0 has already been discharged", 45)
		Err(_): False


private pure func raw_child(seed: Seed, acquire: Bool, transfer: Bool) -> Own.OwnershipProgram:
	ids = seed.ids
	option = seed.string_option
	borrow: Own.BorrowedValue = { value = ids.third, source = Own.PayloadBorrow(ids.first) }
	no_acquisition: List[Own.OwnershipOperation] = []
	acquisition = if acquire:
		[Own.AcquireOwner(Own.owner_id(1), borrow, span(30))]
	else:
		no_acquisition
	returned = if transfer:
		Own.OwnedReturn(ids.third, Own.owner_id(1))
	else:
		Own.UnmanagedReturn(ids.third)
	matched: Own.OwnedMatch = {
		scrutinee = Own.BorrowedArgument({ value = ids.first, source = Own.ParameterBorrow(ids.first) }),
		owner = Concrete.variant_owner(option.some),
		arms = [
			{ label = Lower.VariantLabel(option.none), operations = [define(ids.second, Concrete.StringType, Own.StringDefinition("fallback"), Own.OwnedResult(Own.owner_id(0)), 20)], exit = Own.ReturnResult(Own.OwnedReturn(ids.second, Own.owner_id(0))) },
			{ label = Lower.VariantLabel(option.some), operations = [define(ids.third, Concrete.StringType, Own.PayloadDefinition(seed.string_field, ids.first), Own.BorrowedResult(Own.PayloadBorrow(ids.first)), 30)] + acquisition, exit = Own.ReturnResult(returned) },
		]
	}
	parameter = define(ids.first, result_type(option), Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(ids.first)), 10)
	raw_program(seed, raw_function([parameter], Own.MatchTail(matched), [result_type(option)], Concrete.StringType))


pure func test_raw_selected_child_acquisition_and_transfer_are_valid() -> Bool:
	match seed():
		Ok(seed): verify(raw_child(seed, True, True)).is_ok()
		Err(_): False


pure func test_verifier_rejects_child_transfer_without_acquisition() -> Bool:
	match seed():
		Ok(seed): rejects(raw_child(seed, False, True), "owner 1 is not defined", 30)
		Err(_): False


pure func test_verifier_rejects_unmanaged_borrowed_child_return() -> Bool:
	match seed():
		Ok(seed): rejects(raw_child(seed, False, False), "managed return requires an owner transfer", 30)
		Err(_): False


pure func test_verifier_accepts_dropped_list_get_before_unmanaged_match() -> Bool:
	match seed():
		Err(_):
			False
		Ok(seed):
			ids = seed.ids
			list_type = Concrete.ListType(Concrete.StringType)
			option = seed.integer_option
			call: Concrete.ConcreteCall = {
				target = Concrete.RuntimeFunction(Builtins.ListGet(Concrete.StringType, seed.string_option)),
				span = span(30)
			}
			matched: Own.OwnedMatch = {
				scrutinee = Own.UnmanagedArgument(ids.second),
				owner = Concrete.variant_owner(option.some),
				arms = [
					{
						label = Lower.VariantLabel(option.none),
						operations = [],
						exit = Own.ReturnResult(Own.UnmanagedReturn(ids.fifth))
					},
					{
						label = Lower.VariantLabel(option.some),
						operations = [],
						exit = Own.ReturnResult(Own.UnmanagedReturn(ids.fifth))
					},
				]
			}
			owned = raw_function(
				[
					define(
						ids.first,
						list_type,
						Own.ParameterDefinition(0),
						Own.BorrowedResult(Own.ParameterBorrow(ids.first)),
						10,
					),
					define(
						ids.second,
						result_type(option),
						Own.ParameterDefinition(1),
						Own.UnmanagedResult,
						15,
					),
					define(
						ids.third,
						Concrete.IntType,
						Own.IntegerDefinition(0),
						Own.UnmanagedResult,
						20,
					),
					define(
						ids.fourth,
						result_type(seed.string_option),
						Own.CallDefinition(
							call,
							[Own.BorrowedArgument({
									value = ids.first,
									source = Own.ParameterBorrow(ids.first),
								}), Own.UnmanagedArgument(ids.third)],
						),
						Own.OwnedResult(Own.owner_id(0)),
						30,
					),
					Own.DropOwner(
						Own.owner_id(0),
						span(40),
					),
					define(
						ids.fifth,
						Concrete.IntType,
						Own.IntegerDefinition(0),
						Own.UnmanagedResult,
						50,
					),
				],
				Own.MatchTail(matched),
				[list_type, result_type(option)],
				Concrete.IntType,
			)
			verify(raw_program(seed, owned)).is_ok()


-- Independently construct the ownership boundary; never repair Own.own output.
private pure func raw_encoder(seed: Seed, result: Own.ResultOwnership) -> Own.OwnershipProgram:
	ids = seed.ids
	call: Concrete.ConcreteCall = { target = Concrete.RuntimeFunction(Builtins.StringFromCodepoint(seed.string_option)), span = span(30) }
	raw_program(seed, raw_function([
		define(ids.first, Concrete.IntType, Own.IntegerDefinition(233), Own.UnmanagedResult, 10),
		define(ids.second, result_type(seed.string_option), Own.CallDefinition(call, [Own.UnmanagedArgument(ids.first)]), result, 30),
		Own.DropOwner(Own.owner_id(0), span(40)),
		define(ids.third, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 50),
	], Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.third))), [], Concrete.IntType))


pure func test_verifier_requires_a_fresh_encoder_result_owner() -> Bool:
	match seed():
		Err(_): False
		Ok(seed):
			(
				verify(raw_encoder(seed, Own.OwnedResult(Own.owner_id(0)))).is_ok()
				and rejects(raw_encoder(seed, Own.UnmanagedResult), "managed result requires an owner", 30)
			)


tests: TestSuite = {
	description = "Independent Option ownership insertion and verification",
	tests = [
		("encoder requires a fresh result owner", test_verifier_requires_a_fresh_encoder_result_owner),
		("Option Int has no ownership", test_option_int_has_no_ownership),
		("Option String owns inline fields", test_option_string_has_inline_owned_fields),
		("parse last uses include borrow and return", test_parse_last_uses_include_borrow_and_unmanaged_return),
		("parse borrows parameter without result acquisition", test_parse_borrows_parameter_without_acquiring_result),
		("parse owned input drops after final borrow", test_parse_owned_input_drops_after_final_borrow),
		("unused list get fresh owner drops once", test_unused_list_get_fresh_owner_is_dropped_once),
		("returned list get transfers fresh owner", test_returned_list_get_transfers_fresh_owner),
		("returned child acquires selected arm borrow", test_returned_child_acquires_only_its_selected_arm_borrow),
		("owned list get prefix drops in each arm", test_owned_list_get_prefix_drops_in_each_arm),
		("raw parse borrow and unmanaged result valid", test_raw_parse_borrow_and_unmanaged_result_are_valid),
		("Option constructors require one instance", test_verifier_rejects_option_constructors_from_different_instances),
		("Option constructors reject swapped constructors", test_verifier_rejects_swapped_option_constructors),
		("Option constructors reject a reused constructor", test_verifier_rejects_reused_option_constructor),
		("Option constructor owner must exist", test_verifier_rejects_unknown_option_owner),
		("Option constructor ordinal must exist", test_verifier_rejects_unknown_option_constructor_ordinal),
		("Option constructor payload must match", test_verifier_rejects_wrong_runtime_payload_type),
		("Option constructors cover every variant", test_verifier_rejects_uncovered_runtime_variant),
		("parse result type matches contract", test_verifier_rejects_wrong_parse_result_type),
		("Option Int cannot carry owner", test_verifier_rejects_owned_option_int_result),
		("Option Int cannot carry borrow", test_verifier_rejects_borrowed_option_int_result),
		("parse String argument requires borrow", test_verifier_rejects_unmanaged_parse_string_argument),
		("parse borrow cannot outlive input owner", test_verifier_rejects_parse_borrow_after_input_drop),
		("raw read fresh result and single drop valid", test_raw_read_fresh_result_and_single_drop_are_valid),
		("list get list argument matches contract", test_verifier_rejects_wrong_list_get_list_argument),
		("list get index argument matches contract", test_verifier_rejects_wrong_list_get_index_argument),
		("list get root argument requires borrow", test_verifier_rejects_unmanaged_list_get_argument),
		("list get result type matches contract", test_verifier_rejects_wrong_list_get_result_type),
		("list get constructors preserve payload meaning", test_verifier_rejects_swapped_list_get_constructors),
		("list get last uses include root and index", test_list_get_last_uses_include_root_borrow_and_index),
		("list get cannot be unmanaged", test_verifier_rejects_unmanaged_list_get_result),
		("list get cannot borrow fresh result", test_verifier_rejects_borrowed_list_get_result),
		("list get owner cannot remain live", test_verifier_rejects_undropped_list_get_result),
		("list get owner cannot drop twice", test_verifier_rejects_double_drop_of_list_get_result),
		("raw selected child acquisition valid", test_raw_selected_child_acquisition_and_transfer_are_valid),
		("child transfer needs acquisition", test_verifier_rejects_child_transfer_without_acquisition),
		("borrowed child return needs owner transfer", test_verifier_rejects_unmanaged_borrowed_child_return),
		("dropped list get permits unmanaged match", test_verifier_accepts_dropped_list_get_before_unmanaged_match),
	]
}
