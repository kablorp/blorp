pure func test_set_with_a_list_index_argument_is_rejected() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			tested = update_function(ids, Builtins.ListSet(Concrete.IntType), [borrowed_list(ids), borrowed_list(ids), Own.UnmanagedArgument(ids.second)])
			rejects(program(ids, tested, ids.records, ids.unions), "ownership verification failed: call argument type does not match its contract", span(30))


