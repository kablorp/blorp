-- A literal of two Int values typed as List[element]; the owned root is dropped once.
private pure func literal_function(ids: MembershipIds, element: Concrete.TypeRef, payloads: List[Own.StoredPayload]) -> Own.OwnedFunction:
	{
		execution = OrdinaryCalls,
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = [integer(ids.first, 0), integer(ids.second, 1), Own.DefineValue({
			id = ids.third, value_type = Concrete.ListType(element),
			operation = Own.ConstructListDefinition(payloads),
			result = Own.OwnedResult(Own.owner_id(0)), span = span(30)
		}), Own.DropOwner(Own.owner_id(0), span(31)), integer(ids.fourth, 40)],
		tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.fourth)))
	}


pure func test_valid_int_literal_keeps_single_drop() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			tested = literal_function(ids, Concrete.IntType, [Own.UnmanagedPayload(ids.first), Own.UnmanagedPayload(ids.second)])
			verify(program(ids, tested, ids.records, ids.unions)).is_ok()


pure func test_empty_literal_is_valid() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids): verify(program(ids, literal_function(ids, Concrete.IntType, []), ids.records, ids.unions)).is_ok()


pure func test_literal_element_must_match_its_list_type() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			tested = literal_function(ids, Concrete.StringType, [Own.UnmanagedPayload(ids.first)])
			rejects(program(ids, tested, ids.records, ids.unions), "ownership verification failed: list element type does not match its List", span(30))


pure func test_literal_list_type_requires_element_membership() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			tested = literal_function(ids, Concrete.RecordType(ids.record_id), [])
			rejects(program(ids, tested, [], ids.unions), "internal compiler error: invalid record identity in ownership representation", span(30))


pure func test_union_list_field_requires_record_membership() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			unions: List[Concrete.ConcreteUnion] = [{ variants = [[], [Concrete.ListType(Concrete.RecordType(ids.record_id))]], representation = Concrete.InlineOwningPayload }]
			rejects(program(ids, integer_function(ids.first), [], unions), "ownership verification failed: unknown record layout", compiler_span())


pure func test_union_list_payload_may_close_a_nominal_cycle() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			unions: List[Concrete.ConcreteUnion] = [{ variants = [[], [Concrete.ListType(Concrete.UnionType(ids.union_id))]], representation = Concrete.InlineOwningPayload }]
			verify(program(ids, integer_function(ids.first), ids.records, unions)).is_ok()


private pure func get_function(ids: MembershipIds, element: Concrete.TypeRef, option: Builtins.DesignatedOption[Concrete.VariantInstanceId]) -> Own.OwnedFunction:
	base = parameter_function(ids, Concrete.IntType)
	{ base |
		operations = [list_parameter(ids, Concrete.IntType), integer(ids.second, 15), Own.DefineValue({
			id = ids.third, value_type = Concrete.UnionType(ids.union_id),
			operation = Own.CallDefinition(
				{ target = Concrete.RuntimeFunction(Builtins.ListGet(element, option)), span = span(20) },
				[Own.BorrowedArgument({ value = ids.first, source = Own.ParameterBorrow(ids.first) }), Own.UnmanagedArgument(ids.second)],
			),
			result = Own.UnmanagedResult, span = span(30)
		}), integer(ids.fourth, 40)],
		tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.fourth)))
	}


private pure func integer_option_layout() -> List[Concrete.ConcreteUnion]:
	[{ variants = [[Concrete.IntType], []], representation = Concrete.InlineUnmanaged }]


pure func test_get_contract_validates_element_before_option_constructors() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			option: Builtins.DesignatedOption[Concrete.VariantInstanceId] = { some = ids.first_variant, none = ids.second_variant }
			rejects(
				program(ids, get_function(ids, Concrete.RecordType(ids.record_id), option), [], integer_option_layout()),
				"internal compiler error: invalid record identity in ownership representation", span(20),
			)


pure func test_valid_get_contract_keeps_option_constructors() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			option: Builtins.DesignatedOption[Concrete.VariantInstanceId] = { some = ids.first_variant, none = ids.second_variant }
			verify(program(ids, get_function(ids, Concrete.IntType, option), ids.records, integer_option_layout())).is_ok()


pure func test_known_get_element_preserves_unknown_role_owner_diagnostic() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			option: Builtins.DesignatedOption[Concrete.VariantInstanceId] = { some = ids.first_variant, none = ids.second_variant }
			rejects(
				program(ids, get_function(ids, Concrete.IntType, option), ids.records, []),
				"ownership verification failed: unknown variant owner", span(20),
			)


pure func test_known_get_element_still_rejects_wrong_constructor_field_count() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			option: Builtins.DesignatedOption[Concrete.VariantInstanceId] = { some = ids.second_variant, none = ids.first_variant }
			rejects(
				program(ids, get_function(ids, Concrete.IntType, option), ids.records, integer_option_layout()),
				"ownership verification failed: variant field count does not match its operation", span(20),
			)


pure func test_known_get_element_still_rejects_wrong_payload_type() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			option: Builtins.DesignatedOption[Concrete.VariantInstanceId] = { some = ids.first_variant, none = ids.second_variant }
			unions: List[Concrete.ConcreteUnion] = [{ variants = [[Concrete.FloatType], []], representation = Concrete.InlineUnmanaged }]
			rejects(
				program(ids, get_function(ids, Concrete.IntType, option), ids.records, unions),
				"ownership verification failed: variant payload does not match its operation", span(20),
			)


pure func test_mixed_list_catalogues_may_close_a_cycle() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			records: List[Concrete.ConcreteRecord] = [{ fields = [Concrete.ListType(Concrete.UnionType(ids.union_id))], representation = Concrete.ManagedRecord }]
			unions: List[Concrete.ConcreteUnion] = [{ variants = [[], [Concrete.ListType(Concrete.RecordType(ids.record_id))]], representation = Concrete.InlineOwningPayload }]
			verify(program(ids, integer_function(ids.first), records, unions)).is_ok()


pure func test_signature_preflight_keeps_last_invalid_type_policy() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			base = integer_function(ids.first)
			tested = { base | signature = { parameters = [Concrete.RecordType(ids.record_id), Concrete.UnionType(ids.union_id)], return_type = Concrete.IntType } }
			rejects(program(ids, tested, [], []), "internal compiler error: invalid union identity in ownership representation", compiler_span())


pure func test_unused_result_signature_requires_record_membership() -> Bool:
	match membership_ids():
		Err(_): False
		Ok(ids):
			base = integer_function(ids.first)
			tested = { base | signature = { parameters = [], return_type = Concrete.ListType(Concrete.RecordType(ids.record_id)) } }
			rejects(program(ids, tested, [], ids.unions), "internal compiler error: invalid record identity in ownership representation", compiler_span())


tests: TestSuite = {
	description = "Raw List element membership",
	tests = [
		("all membership identities are issued by the seed", test_identity_seed_is_valid),
		("Void List membership is valid", test_void_list_is_valid),
		("Int List membership is valid", test_int_list_is_valid),
		("Float List membership is valid", test_float_list_is_valid),
		("String List membership is valid", test_string_list_is_valid),
		("nested List membership is valid", test_nested_list_is_valid),
		("finite record List membership is valid", test_finite_record_list_is_valid),
		("inline union List membership is valid", test_inline_union_list_is_valid),
		("owning union List membership is valid", test_owning_union_list_is_valid),
		("unused signature requires record membership", test_unused_list_signature_requires_record_membership),
		("unused signature requires union membership", test_unused_list_signature_requires_union_membership),
		("nested signature requires record membership", test_nested_list_signature_requires_record_membership),
		("deep signature requires union membership", test_deep_list_signature_requires_union_membership),
		("union List field holds finite record", test_union_list_field_can_hold_a_finite_record),
		("record List field requires nested union membership", test_record_list_field_requires_nested_union_membership),
		("record List field may close a nominal cycle", test_record_list_field_may_close_a_nominal_cycle),
		("unused definition requires nested record membership", test_unused_definition_requires_nested_record_membership),
		("known member keeps operation mismatch checking", test_known_list_member_does_not_hide_operation_mismatch),
		("value ordinal precedes nested membership", test_value_ordinal_precedes_nested_membership),
		("match arm definition requires record membership", test_match_arm_definition_requires_record_membership),
		("unused length result validates runtime E", test_unused_length_result_still_validates_runtime_element),
		("length validates nested runtime E", test_length_contract_validates_nested_runtime_element),
		("valid length contract remains valid", test_valid_length_contract_remains_valid),
		("repeat validates E before argument mismatch", test_repeat_contract_validates_element_before_argument_mismatch),
		("valid repeat contract keeps single drop", test_valid_repeat_contract_keeps_single_drop),
		("append contract validates E before arguments", test_append_contract_validates_element_before_arguments),
		("valid append contract keeps single drop", test_valid_append_contract_keeps_single_drop),
		("append without its value argument is rejected", test_append_without_its_value_argument_is_rejected),
		("set contract validates E before arguments", test_set_contract_validates_element_before_arguments),
		("valid set contract keeps single drop", test_valid_set_contract_keeps_single_drop),
		("set with a List index is rejected", test_set_with_a_list_index_argument_is_rejected),
		("concat contract validates E before arguments", test_concat_contract_validates_element_before_arguments),
		("valid concat contract keeps single drop", test_valid_concat_contract_keeps_single_drop),
		("valid Int literal keeps single drop", test_valid_int_literal_keeps_single_drop),
		("empty literal is valid", test_empty_literal_is_valid),
		("literal element must match its List type", test_literal_element_must_match_its_list_type),
		("literal List type requires element membership", test_literal_list_type_requires_element_membership),
		("union List field requires record membership", test_union_list_field_requires_record_membership),
		("union List payload may close a nominal cycle", test_union_list_payload_may_close_a_nominal_cycle),
		("get validates E before Option constructors", test_get_contract_validates_element_before_option_constructors),
		("valid get keeps Option constructors", test_valid_get_contract_keeps_option_constructors),
		("known get E preserves unknown role owner diagnostic", test_known_get_element_preserves_unknown_role_owner_diagnostic),
		("known get E rejects wrong role field count", test_known_get_element_still_rejects_wrong_constructor_field_count),
		("known get E rejects wrong payload type", test_known_get_element_still_rejects_wrong_payload_type),
		("mixed List catalogues may close a cycle", test_mixed_list_catalogues_may_close_a_cycle),
		("signature preflight keeps last invalid type", test_signature_preflight_keeps_last_invalid_type_policy),
		("unused result signature requires record membership", test_unused_result_signature_requires_record_membership),
	]
}
