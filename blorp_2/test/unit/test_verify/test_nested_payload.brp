import:
	../../../src/check/model as Model
	./selection_inputs as Selection
	../../../src/utils/names: program_names
	../../../src/check/check: check
	../../../src/lex/lex: lex
	../../../src/lower/lower as Lower
	../../../src/own/own as Owned
	../../../src/utils/source: compiler_source, module_source, root_module_id
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax:
		Diagnostic,
		Entrypoint(NoArguments), EntryResult(IntegerExitStatus),
		Span,
		entry_function,
	../../../src/verify/verify: verify
	../input: parse, setup_diagnostic
	../ownership_inputs: InputIds, input_ids, span
	../managed_union_inputs: lowered_tail_join
	test: TestSuite


private record LayoutIds {
	inner: Concrete.UnionInstanceId,
	another_inner: Concrete.UnionInstanceId,
	outer: Concrete.UnionInstanceId,
	first: Concrete.VariantInstanceId,
	first_field: Concrete.VariantFieldInstanceId,
	second: Concrete.VariantInstanceId,
	second_field: Concrete.VariantFieldInstanceId,
	other: Concrete.VariantInstanceId,
	other_field: Concrete.VariantFieldInstanceId,
	record_id: Concrete.RecordInstanceId,
	unions: List[Concrete.ConcreteUnion],
	records: List[Concrete.ConcreteRecord]
}


private pure func seed_field(join: Lower.LoweredJoin, arm: Int) -> Result[Concrete.VariantFieldInstanceId, Diagnostic]:
	var found: Option[Concrete.VariantFieldInstanceId] = None
	for node in join.selection.nodes:
		match node:
			Lower.EnterArm(edge):
				if Model.match_arm_number(edge.arm) == arm:
					match edge.definitions:
						[Lower.BorrowUnionField(_, field, _)]: found = Some(field)
						_: void
			_: void
	match found:
		Some(field): Ok(field)
		None: Err({ span = span(0), note = None, message = "missing projection identity seed", help = "fix seed" })


-- The seed mints opaque identities through lowering. All tested ownership
-- operations and layouts below are independently constructed, never inserted.
private pure func layout_ids() -> Result[LayoutIds, Diagnostic]:
	source: String =
		|union Box[T]:
		|	Box(T)
		|union Choice[A,B]:
		|	Left(A)
		|	Right(B)
		|union Other[A,B]:
		|	OtherLeft(A)
		|	OtherRight(B)
		|union OtherBox[T]:
		|	Wrap(T)
		|record Pair { first: Int, second: Int }
		|pure func first(value: Choice[Box[Int],Box[Int]]) -> Box[Int]:
		|	match value:
		|		Left(item): item
		|		Right(item): item
		|pure func other(value: Other[Box[Int],Box[Int]]) -> Box[Int]:
		|	match value:
		|		OtherLeft(item): item
		|		OtherRight(item): item
		|pure func pair() -> Pair:
		|	{ first = 7, second = 9 }
		|pure func other_box(value: OtherBox[Int]) -> OtherBox[Int]:
		|	value
		|func main() -> Int:
		|	first_value = first(Left(Box(0)))
		|	other_value = other(OtherLeft(Box(0)))
		|	point = pair()
		|	boxed = other_box(Wrap(0))
		|	0
		|
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	checked ?= check(parsed)
		.map_err(setup_diagnostic)
	concrete ?= Concrete.specialize(checked)
	lowered ?= Lower.lower(concrete)
	program = Lower.lowered_functions(lowered)

	match program.functions:
		[_, first, other, pair, other_box]:
			match (
				lowered_tail_join(first),
				lowered_tail_join(other),
				pair.signature.return_type,
				other_box.signature.return_type,
			):
				(Some(matched), Some(another), Concrete.RecordType(record_id), Concrete.UnionType(another_inner)):
					first_field ?= seed_field(matched, 0)
					second_field ?= seed_field(matched, 1)
					other_field ?= seed_field(another, 0)
					match first.signature.return_type:
						Concrete.UnionType(inner):
							first_variant = Concrete.variant_field_variant(first_field)
							Ok({ inner = inner, another_inner = another_inner,
								outer = Concrete.variant_owner(first_variant), first = first_variant, first_field = first_field,
								second = Concrete.variant_field_variant(second_field), second_field = second_field,
								other = Concrete.variant_field_variant(other_field), other_field = other_field,
								record_id = record_id, records = program.records, unions = program.unions })
						_: Err({ span = span(0), note = None, message = "missing variant seed", help = "fix seed" })
				_:
					Err({
						span = span(0),
						note = None,
						message = "missing match seed",
						help = "fix seed",
					})
		_:
			Err({
				span = span(0),
				note = None,
				message = "missing function seed",
				help = "fix seed",
			})


private pure func main_function(ids: InputIds) -> Owned.OwnedFunction:
	{
		parameters = [], return_type = Concrete.IntType,
		operations = [Owned.DefineValue({
				id = ids.first,
				operation = Owned.IntegerDefinition(0),
				value_type = Concrete.IntType,
				result = Owned.UnmanagedResult,
				span = span(0),
			})],
		result = Owned.UnmanagedReturn(ids.first)
	}


private pure func projection_program(ids: InputIds, layout: LayoutIds) -> Owned.OwnershipProgram:
	{
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
		records = layout.records,
		unions = layout.unions,
		functions = [
			main_function(ids),
			{
				parameters = [ManagedParameter({ value_type = Concrete.UnionType(layout.outer), owned = False }), ManagedParameter({ value_type = Concrete.UnionType(layout.outer), owned = False })], return_type = Concrete.UnionType(layout.inner),
				operations = [Owned.DefineValue({
						id = ids.first,
						operation = Owned.ParameterDefinition(0),
						value_type = Concrete.UnionType(layout.outer),
						result = Owned.UnmanagedResult,
						span = span(10),
					}), Owned.DefineValue({
						id = ids.second,
						operation = Owned.ParameterDefinition(1),
						value_type = Concrete.UnionType(layout.outer),
						result = Owned.UnmanagedResult,
						span = span(11),
					}), Owned.ExecuteJoin({
					result = Owned.UnmanagedJoinParameter({ id = ids.third, value_type = Concrete.UnionType(layout.inner), span = span(40) }),
					carried = [],
					entering = [],
					selection = { scrutinee = Owned.UnmanagedArgument(ids.first), entry = Model.decision_node_id(2), nodes = [
						Owned.EnterArm({ arm = Model.match_arm_id(0), operations = [Owned.DefineValue({ id = ids.fourth, operation = Owned.PayloadDefinition(layout.first_field, ids.first), value_type = Concrete.UnionType(layout.inner), result = Owned.UnmanagedResult, span = span(20) })], transfers = [Owned.UnmanagedReturn(ids.fourth)] }),
						Owned.EnterArm({ arm = Model.match_arm_id(1), operations = [Owned.DefineValue({ id = ids.fifth, operation = Owned.PayloadDefinition(layout.second_field, ids.first), value_type = Concrete.UnionType(layout.inner), result = Owned.UnmanagedResult, span = span(30) })], transfers = [Owned.UnmanagedReturn(ids.fifth)] }),
						Owned.TestVariant({ value_type = Concrete.UnionType(layout.outer), route = Concrete.MatchRoot }, layout.first, Model.decision_node_id(0), Model.decision_node_id(1)),
					] },
					arms = [
						{ id = Model.match_arm_id(0), inputs = [Owned.UnmanagedJoinParameter({ id = ids.sixth, value_type = Concrete.UnionType(layout.inner), span = span(20) })], operations = [], exit = Owned.Yield({ transfer = Owned.UnmanagedReturn(ids.sixth), carried = [] }) },
						{ id = Model.match_arm_id(1), inputs = [Owned.UnmanagedJoinParameter({ id = ids.seventh, value_type = Concrete.UnionType(layout.inner), span = span(30) })], operations = [], exit = Owned.Yield({ transfer = Owned.UnmanagedReturn(ids.seventh), carried = [] }) },
					],
				})],
				result = Owned.UnmanagedReturn(ids.third),
			},
		]
	}


private pure func rejects(input: Owned.OwnershipProgram, message: String, location: Span) -> Bool:
	match verify(input):
		Err(error):
			(
				error.message == "ownership verification failed: " + message
				and error.help == "report this compiler error with the input program"
				and error.span.start == location.start
				and error.span.end == location.end
				and error.note.is_none()
			)
		Ok(_):
			False


private pure func replace_projection(
	input: Owned.OwnershipProgram,
	operation: Owned.OwnedValueOperation,
	value_type: Concrete.TypeRef,
) -> Owned.OwnershipProgram:
	functions = input.functions.map(pure func(function):
		operations = function.operations.map(pure func(step):
			match step:
				Owned.ExecuteJoin(join):
					selection = join.selection
					nodes = selection.nodes.map(pure func(node):
						match node:
							Owned.EnterArm(edge):
								if Model.match_arm_number(edge.arm) == 0:
									operations = edge.operations.map(pure func(item):
										match item:
											Owned.DefineValue(definition): Owned.DefineValue({ definition | operation = operation, value_type = value_type })
											_: item
									)
									Owned.EnterArm({ edge | operations = operations })
								else:
									node
							_: node
					)
					Owned.ExecuteJoin({ join | selection = { selection | nodes = nodes } })
				_: step
		)
		{ function | operations = operations }
	)
	{ input | functions = functions }


pure func test_accepts_precise_unmanaged_projection() -> Bool:
	match (input_ids(), layout_ids()):
		(Ok(ids), Ok(layout)):
			verify(projection_program(ids, layout)).is_ok()
		_:
			False


private pure func rejects_projection(
	choose_field: pure (LayoutIds) -> Concrete.VariantFieldInstanceId,
	second_source: Bool,
	wrong_type: Bool,
) -> Bool:
	match (input_ids(), layout_ids()):
		(Ok(ids), Ok(layout)):
			source = if second_source:
				ids.second
			else:
				ids.first

			value_type = if wrong_type:
				Concrete.UnionType(layout.another_inner)
			else:
				Concrete.UnionType(layout.inner)

			input = replace_projection(
				projection_program(ids, layout),
				Owned.PayloadDefinition(choose_field(layout), source),
				value_type,
			)

			message = if second_source:
				"selection edge contains an operation outside its local projections"
			else if wrong_type:
				"definition type does not match its operation"
			else:
				"payload projection does not belong to this match arm"
			at = if second_source:
				span(10)
			else:
				span(20)
			rejects(input, message, at)
		_:
			False


pure func test_rejects_sibling_variant_with_identical_payload_type() -> Bool:
	rejects_projection(
		pure func(layout): layout.second_field,
		False,
		False,
	)


pure func test_rejects_equal_shaped_other_variant_owner() -> Bool:
	rejects_projection(
		pure func(layout): layout.other_field,
		False,
		False,
	)


pure func test_rejects_another_scrutinee_of_the_same_union_type() -> Bool:
	rejects_projection(
		pure func(layout): layout.first_field,
		True,
		False,
	)


pure func test_rejects_wrong_declared_projection_type() -> Bool:
	rejects_projection(
		pure func(layout): layout.first_field,
		False,
		True,
	)


private pure func rejects_layout(
	payload: pure (LayoutIds) -> Concrete.TypeRef,
	first_row: Bool,
	expected: String,
) -> Bool:
	match (input_ids(), layout_ids()):
		(Ok(ids), Ok(layout)):
			row: Concrete.ConcreteUnion = Concrete.PlainCases([[], [payload(layout)]])

			unions = if first_row:
				[row]
			else:
				layout.unions.append(row)

			rejects(
				{ projection_program(ids, layout) |
					functions = [main_function(ids)],
					unions = unions
				},
				expected,
				{
					source = compiler_source(),
					start = 0,
					end = 0
				},
			)
		_:
			False


pure func test_rejects_false_unmanaged_summary_for_unused_string() -> Bool:
	rejects_layout(
		pure func(_): Concrete.StringType,
		False,
		"union ownership summary does not match its payloads",
	)


-- A self payload is admitted only under the boxed representation.
pure func test_rejects_unused_self_union_payload() -> Bool:
	rejects_layout(
		pure func(layout): Concrete.UnionType(layout.inner),
		True,
		"recursive union payload requires the boxed representation",
	)


-- An acyclic by-value reference to a later layout is valid; definition
-- order belongs to the emitter.
pure func test_accepts_unused_forward_union_payload() -> Bool:
	match (input_ids(), layout_ids()):
		(Ok(ids), Ok(layout)):
			input = projection_program(ids, layout)
			verify(
				{ input |
					functions = [main_function(ids)],
					unions = [
						Concrete.PlainCases([[Concrete.UnionType(layout.outer)]]),
						Concrete.PlainCases([[]]),
					]
				},
			).is_ok()
		_:
			False


pure func test_rejects_out_of_range_union_payload() -> Bool:
	rejects_layout(
		pure func(layout): Concrete.UnionType(Concrete.variant_owner(layout.other)),
		True,
		"union payload must reference a supported layout",
	)


pure func test_rejects_unknown_record_payload() -> Bool:
	match (input_ids(), layout_ids()):
		(Ok(ids), Ok(layout)):
			input = projection_program(ids, layout)
			rejects(
				{ input |
					functions = [main_function(ids)],
					records = [],
					unions = [
						Concrete.PlainCases([[Concrete.RecordType(layout.record_id)]]),
					]
				},
				"union payload must reference a supported layout",
				{
					source = compiler_source(),
					start = 0,
					end = 0
				},
			)
		_:
			False


pure func test_accepts_unused_known_record_payload() -> Bool:
	match (input_ids(), layout_ids()):
		(Ok(ids), Ok(layout)):
			input = projection_program(ids, layout)
			verify({ input |
					functions = [main_function(ids)],
					unions = layout.unions.append(Concrete.PlainCases([[Concrete.RecordType(layout.record_id)]]))
				}).is_ok()
		_:
			False


pure func test_rejects_projection_from_a_nullary_selected_variant() -> Bool:
	match (input_ids(), layout_ids()):
		(Ok(ids), Ok(layout)):
			input = projection_program(ids, layout)
			unions = [
				Concrete.PlainCases([[Concrete.IntType]]),
				Concrete.PlainCases([[], [Concrete.UnionType(layout.inner)]]),
				Concrete.PlainCases([
						[Concrete.UnionType(layout.inner)],
						[Concrete.UnionType(layout.inner)],
					]),
				Concrete.PlainCases([[Concrete.IntType]]),
			]
			rejects({ input | unions = unions }, "unknown variant field identity", span(20))
		_:
			False


pure func test_constructor_rejects_equal_shaped_nominal_child() -> Bool:
	match (input_ids(), layout_ids()):
		(Ok(ids), Ok(layout)):
			function: Owned.OwnedFunction = {
				parameters = [ManagedParameter({ value_type = Concrete.UnionType(layout.another_inner), owned = False })], return_type = Concrete.UnionType(layout.outer),
				operations = [Owned.DefineValue({
						id = ids.first,
						operation = Owned.ParameterDefinition(0),
						value_type = Concrete.UnionType(layout.another_inner),
						result = Owned.UnmanagedResult,
						span = span(10),
					}), Owned.DefineValue({
						id = ids.second,
						operation = Owned.ConstructDefinition(
							layout.first,
							[Owned.UnmanagedPayload(ids.first)],
						),
						value_type = Concrete.UnionType(layout.outer),
						result = Owned.UnmanagedResult,
						span = span(20),
					})],
				result = Owned.UnmanagedReturn(ids.second)
			}
			rejects(
				{ projection_program(ids, layout) | functions = [main_function(ids), function] },
				"variant payload does not match its operation",
				span(20),
			)
		_:
			False


tests: TestSuite = {
	description = "Independent nested union layout and projection verification",
	tests = [
		(
			"nullary selected variant has no projection",
			test_rejects_projection_from_a_nullary_selected_variant,
		),
		(
			"constructor rejects equal shaped nominal child",
			test_constructor_rejects_equal_shaped_nominal_child,
		),
		("precise unmanaged projection", test_accepts_precise_unmanaged_projection),
		(
			"wrong sibling with identical payload",
			test_rejects_sibling_variant_with_identical_payload_type,
		),
		("wrong equal shaped variant owner", test_rejects_equal_shaped_other_variant_owner),
		("wrong same typed scrutinee", test_rejects_another_scrutinee_of_the_same_union_type),
		("wrong declared projection type", test_rejects_wrong_declared_projection_type),
		(
			"false unmanaged summary for unused String after nullary variant",
			test_rejects_false_unmanaged_summary_for_unused_string,
		),
		("unused self union dependency", test_rejects_unused_self_union_payload),
		("unused forward union dependency accepted", test_accepts_unused_forward_union_payload),
		("out of range union dependency", test_rejects_out_of_range_union_payload),
		("unknown record payload", test_rejects_unknown_record_payload),
		("known unused record payload", test_accepts_unused_known_record_payload),
	]
}
