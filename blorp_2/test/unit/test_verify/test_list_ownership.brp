import:
	../../../src/own/own as Own
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Entrypoint(NoArguments), EntryResult(IntegerExitStatus), FunctionExecution(OrdinaryCalls)
	../../../src/utils/text: concat
	../../../src/verify/verify: verify
	int as IntOps
	../ownership_inputs: InputIds, input_ids, span
	test: TestSuite


-- The seed mints identities only. These operations are constructed independently
-- of ownership insertion, so verification cannot rely on that pass being right.
private pure func list_function(ids: InputIds, result: Own.ResultOwnership, cleanup: List[Own.OwnershipOperation]) -> Own.OwnedFunction:
	{
		execution = OrdinaryCalls,
		signature = { parameters = [Concrete.ListType(Concrete.StringType)], return_type = Concrete.IntType },
		operations = [Own.DefineValue({
			id = ids.first,
			value_type = Concrete.ListType(Concrete.StringType),
			operation = Own.ParameterDefinition(0),
			result = result,
			span = span(10)
		})].concat(cleanup).append(Own.DefineValue({
			id = ids.second,
			value_type = Concrete.IntType,
			operation = Own.IntegerDefinition(0),
			result = Own.UnmanagedResult,
			span = span(40)
		})),
		tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.second)))
	}


private pure func program(ids: InputIds, tested: Own.OwnedFunction) -> Own.OwnershipProgram:
	entry: Own.OwnedFunction = {
		execution = OrdinaryCalls,
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = [Own.DefineValue({
			id = ids.first,
			value_type = Concrete.IntType,
			operation = Own.IntegerDefinition(0),
			result = Own.UnmanagedResult,
			span = span(0)
		})],
		tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.first)))
	}
	{ records = [], unions = [], functions = [entry, tested], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }


private pure func borrowed_parameter(ids: InputIds) -> Own.ResultOwnership:
	Own.BorrowedResult(Own.ParameterBorrow(ids.first))


private pure func acquire_and_drop(ids: InputIds) -> List[Own.OwnershipOperation]:
	[
		Own.AcquireOwner(Own.owner_id(0), { value = ids.first, source = Own.ParameterBorrow(ids.first) }, span(20)),
		Own.DropOwner(Own.owner_id(0), span(25)),
	]


private pure func rejects(program: Own.OwnershipProgram, message: String, at: Int) -> Bool:
	match verify(program):
		Err(error):
			(error.message == "ownership verification failed: ".concat(message)
				and error.help == "report this compiler error with the input program"
				and same_source(error.span.source, module_source(root_module_id()))
				and error.span.start == at and error.span.end == IntOps.add(at, 1)
				and error.note.is_none())
		Ok(_): False


pure func test_independent_borrowed_list_and_single_drop_are_valid() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			(verify(program(ids, list_function(ids, borrowed_parameter(ids), []))).is_ok()
				and verify(program(ids, list_function(ids, borrowed_parameter(ids), acquire_and_drop(ids)))).is_ok())


pure func test_list_parameter_cannot_be_unmanaged() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): rejects(program(ids, list_function(ids, Own.UnmanagedResult, [])), "managed parameter must be borrowed", 10)


pure func test_list_parameter_cannot_create_fresh_owner() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): rejects(program(ids, list_function(ids, Own.OwnedResult(Own.owner_id(0)), [])), "managed parameter must be borrowed", 10)


pure func test_list_parameter_borrow_source_must_match() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			wrong_source = Own.BorrowedResult(Own.ParameterBorrow(ids.second))
			rejects(program(ids, list_function(ids, wrong_source, [])), "managed parameter has the wrong borrow source", 10)


pure func test_list_owner_cannot_be_dropped_twice() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			cleanup = acquire_and_drop(ids).append(Own.DropOwner(Own.owner_id(0), span(30)))
			rejects(program(ids, list_function(ids, borrowed_parameter(ids), cleanup)), "owner 0 has already been discharged", 30)


tests: TestSuite = {
	description = "Independent List root ownership verification",
	tests = [
		("borrowed list and single root drop are valid", test_independent_borrowed_list_and_single_drop_are_valid),
		("list parameter cannot be unmanaged", test_list_parameter_cannot_be_unmanaged),
		("list parameter cannot create fresh owner", test_list_parameter_cannot_create_fresh_owner),
		("list parameter borrow identity must match", test_list_parameter_borrow_source_must_match),
		("list root owner cannot drop twice", test_list_owner_cannot_be_dropped_twice),
	]
}
