import:
	../../../src/check/check: check
	../../../src/check/render: render_failure
	../../../src/specialize/specialize: specialize
	../../../src/lower/lower: lower
	../../../src/own/own: own
	../../../src/verify/verify: verify
	../test_check/test_traits: parse_equatable_fixture
	test: TestSuite


-- A real accepted singleton union with both retained and erased payload slots.
-- Its ordinary right selector has no possible mismatching tag.
func test_singleton_equality_reaches_independent_ownership_verification() -> Bool:
	requirements: String =
		|trait Equatable:
		|    pure func equals(left: Self, right: Self) -> Bool
		|
	provider: String =
		|import:
		|    _base: Int, Void, Bool(False), Equatable
		|fixed union Single:
		|    Value(Int, Void)
		|implements Equatable for Int:
		|    pure func equals(left: Self, right: Self) -> Bool:
		|        builtin("int.equals")
		|implements Equatable for Void:
		|    pure func equals(left: Self, right: Self) -> Bool:
		|        False
		|pure func single() -> Single:
		|    Value(7, void)
		|
	main_source: String =
		|import:
		|    int: equals, single
		|func main() -> Int:
		|    match equals(single(), single()):
		|        False: 23
		|        True: 0
		|
	match parse_equatable_fixture(main_source, provider, requirements):
		Err(error):
			print("parse setup: " + error.message)
			False
		Ok(parsed):
			match check(parsed):
				Err(failure):
					print("Check setup: " + render_failure(failure).first.message)
					False
				Ok(checked):
					match specialize(checked):
						Err(error):
							print("Specialize setup: " + error.message)
							False
						Ok(concrete):
							match lower(concrete):
								Err(error):
									print("Lower setup: " + error.message)
									False
								Ok(lowered):
									match own(lowered):
										Err(error):
											print("Own setup: " + error.message)
											False
										Ok(owned):
											match verify(owned):
												Err(error):
													print("Verify rejection: " + error.message)
													print("Verify help: " + error.help)
													False
												Ok(_): True


tests: TestSuite = {
	description = "Blorp 2 independently verified structural equality selectors",
	tests = [
		("singleton equality verifies retained and erased payloads", test_singleton_equality_reaches_independent_ownership_verification),
	]
}
