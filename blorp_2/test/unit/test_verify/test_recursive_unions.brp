import:
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/utils/source: compiler_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, Span, Entrypoint(NoArguments), EntryResult(IntegerExitStatus), FunctionExecution(OrdinaryCalls), entry_function, same_span
	../../../src/utils/text: concat
	../../../src/verify/verify: verify
	../input: check, setup_diagnostic
	../module_input: primitive_base, parse_modules_with_base
	../ownership_inputs: defined_value_at, span
	option: to_result
	test: TestSuite


private record RecursiveIds {
	first: Lower.ValueId,
	entrypoint: Concrete.FunctionInstanceId,
	record_id: Concrete.RecordInstanceId,
	union_id: Concrete.UnionInstanceId,
	later_union_id: Concrete.UnionInstanceId,
	records: List[Concrete.ConcreteRecord],
	unions: List[Concrete.ConcreteUnion],
	owned: Own.OwnershipProgram
}


private pure func seed_error(message: String) -> Diagnostic:
	{
		span = span(0), note = None,
		message = "invalid recursive union identity seed: ".concat(message),
		help = "fix the recursive union verification test setup"
	}


-- One real producer issues the identities; malformed layouts below are built
-- by hand around them and never come from the specializer.
private pure func recursive_ids() -> Result[RecursiveIds, Diagnostic]:
	source: String =
		|union Nat:
		|    Zero
		|    Succ(Nat)
		|record Holder { value: Nat }
		|union Wrap:
		|    Empty
		|    Full(Nat)
		|pure func make() -> Holder:
		|    { value = Succ(Zero) }
		|pure func wrap() -> Wrap:
		|    Full(Zero)
		|func main() -> Int:
		|    unused = make()
		|    other = wrap()
		|    0
		|
	parsed ?= parse_modules_with_base([{ source = source, targets = [] }], primitive_base())
	checked ?= check(parsed).map_err(setup_diagnostic)
	lowered ?= Concrete.specialize(checked).and_then(Lower.lower)
	owned ?= Own.own(lowered)
	program = Lower.lowered_functions(lowered)
	entrypoint = entry_function(program.entrypoint)
	main ?= program.functions.get(Concrete.function_number(entrypoint)).to_result(seed_error("entrypoint row is missing"))
	first ?= defined_value_at(main.steps, 0, seed_error("first value is missing"))
	second ?= defined_value_at(main.steps, 1, seed_error("second value is missing"))
	holder ?= match first.value_type:
		Concrete.RecordType(id): Ok(id)
		_: Err(seed_error("make does not return the record"))
	wrap ?= match second.value_type:
		Concrete.UnionType(id): Ok(id)
		_: Err(seed_error("wrap does not return the later union"))
	layout ?= program.records.get(Concrete.record_number(holder)).to_result(seed_error("record layout is missing"))
	match Concrete.record_fields(layout):
		[Concrete.UnionType(nat)]:
			if Concrete.union_number(nat) == 0 and Concrete.union_number(wrap) == 1:
				Ok({
					first = first.id, entrypoint = entrypoint, record_id = holder, union_id = nat, later_union_id = wrap,
					records = program.records, unions = program.unions, owned = owned
				})
			else:
				Err(seed_error("union instances are not ordered Nat then Wrap"))
		_: Err(seed_error("record does not hold the union"))


private pure func integer_main(id: Lower.ValueId) -> Own.OwnedFunction:
	{
		parameters = [], return_type = Concrete.IntType,
		operations = [Own.DefineValue({
			id = id, value_type = Concrete.IntType,
			operation = Own.IntegerDefinition(0), result = Own.UnmanagedResult, span = span(10)
		})],
		result = Own.UnmanagedReturn(id)
	}


private pure func program(
	ids: RecursiveIds,
	records: List[Concrete.ConcreteRecord],
	unions: List[Concrete.ConcreteUnion],
) -> Own.OwnershipProgram:
	{
		records = records, unions = unions,
		functions = [integer_main(ids.first)],
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus)
	}


private pure func compiler_span() -> Span:
	{ source = compiler_source(), start = 0, end = 0 }


private pure func rejects(input: Own.OwnershipProgram, message: String) -> Bool:
	match verify(input):
		Err(error):
			(
				error.message == "ownership verification failed: ".concat(message)
				and error.help == "report this compiler error with the input program"
				and same_span(error.span, compiler_span()) and error.note.is_none()
			)
		Ok(_): False


private pure func nat_variants(ids: RecursiveIds) -> List[List[Concrete.TypeRef]]:
	[[], [Concrete.UnionType(ids.union_id)]]


pure func test_real_boxed_nat_program_verifies() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids): verify(ids.owned).is_ok()


pure func test_boxed_self_payload_layout_is_accepted_alone() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids): verify(program(ids, [], [Concrete.BoxedCases(nat_variants(ids))])).is_ok()


pure func test_self_payload_under_an_inline_representation_is_rejected() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			(
				rejects(program(ids, [], [Concrete.OwningCases(nat_variants(ids))]), "recursive union payload requires the boxed representation")
				and rejects(program(ids, [], [Concrete.PlainCases(nat_variants(ids))]), "recursive union payload requires the boxed representation")
			)


pure func test_boxed_layout_without_a_self_payload_is_rejected() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			boxed: Concrete.ConcreteUnion = Concrete.BoxedCases([[], [Concrete.IntType]])
			rejects(program(ids, [], [boxed]), "boxed union representation requires a self-referencing payload")


pure func test_two_self_payloads_in_one_variant_are_rejected() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			tree: Concrete.ConcreteUnion = Concrete.BoxedCases([[], [Concrete.UnionType(ids.union_id), Concrete.UnionType(ids.union_id)]])
			rejects(program(ids, [], [tree]), "boxed union variant may store at most one self-reference")


-- Both edges of this cycle are pointers (managed record, boxed union).
pure func test_boxed_union_may_close_a_cycle_through_a_managed_record() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			records: List[Concrete.ConcreteRecord] = [Concrete.CountedFields([Concrete.UnionType(ids.union_id)])]
			looped: Concrete.ConcreteUnion = Concrete.BoxedCases([[Concrete.RecordType(ids.record_id)], [Concrete.UnionType(ids.union_id)]])
			verify(program(ids, records, [looped])).is_ok()


-- A managed record's field is a pointer edge, so it may hold its own layout.
pure func test_managed_record_may_hold_itself() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			records: List[Concrete.ConcreteRecord] = [Concrete.CountedFields([Concrete.RecordType(ids.record_id)])]
			verify(program(ids, records, [])).is_ok()


-- Two inline unions holding each other by value have no finite storage.
pure func test_inline_unions_holding_each_other_form_a_by_value_cycle() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			first: Concrete.ConcreteUnion = Concrete.OwningCases([[Concrete.UnionType(ids.later_union_id)]])
			second: Concrete.ConcreteUnion = Concrete.OwningCases([[Concrete.UnionType(ids.union_id)]])
			rejects(program(ids, [], [first, second]), "aggregate layouts form a by-value cycle")


-- An inline record inside an inline union inside that record is by value twice.
pure func test_inline_record_and_union_form_a_by_value_cycle() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			records: List[Concrete.ConcreteRecord] = [Concrete.InlineFields([Concrete.IntType, Concrete.UnionType(ids.union_id)])]
			holder: Concrete.ConcreteUnion = Concrete.PlainCases([[Concrete.RecordType(ids.record_id)]])
			-- Records are walked first, so the cycle closes before the record's
			-- storage summary is checked.
			rejects(program(ids, records, [holder]), "aggregate layouts form a by-value cycle")


-- Direct mutual recursion has no admitted layout: a boxed union must hold
-- its own layout, and neither of these does.
pure func test_direct_mutual_boxed_layouts_are_rejected() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			first: Concrete.ConcreteUnion = Concrete.BoxedCases([[Concrete.UnionType(ids.later_union_id)]])
			second: Concrete.ConcreteUnion = Concrete.BoxedCases([[Concrete.UnionType(ids.union_id)]])
			rejects(program(ids, [], [first, second]), "boxed union representation requires a self-referencing payload")


pure func test_record_holding_a_boxed_union_must_be_managed() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			inline: List[Concrete.ConcreteRecord] = [Concrete.InlineFields([Concrete.UnionType(ids.union_id)])]
			(
				verify(program(ids, ids.records, ids.unions)).is_ok()
				and rejects(program(ids, inline, ids.unions), "record storage summary does not match its fields")
			)


pure func test_owning_first_field_does_not_hide_a_later_unknown_union_payload() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			valid: Concrete.ConcreteUnion = Concrete.OwningCases([[Concrete.StringType]])
			invalid: Concrete.ConcreteUnion = Concrete.OwningCases([[Concrete.StringType, Concrete.UnionType(ids.later_union_id)]])
			(
				verify(ids.owned).is_ok()
				and verify(program(ids, [], [valid])).is_ok()
				and rejects(
					program(ids, [], [invalid]),
					"union payload must reference a supported layout",
				)
			)


pure func test_unused_owning_union_validates_a_later_callable_signature_member() -> Bool:
	match recursive_ids():
		Err(_): False
		Ok(ids):
			layout: Concrete.ConcreteUnion = Concrete.OwningCases([[
					Concrete.StringType,
					Concrete.ListType(Concrete.CallableType(
						[Concrete.RecordType(ids.record_id)],
						Concrete.IntType,
					)),
				]])
			if (
				verify(ids.owned).is_ok()
				and verify(program(ids, ids.records, [layout])).is_ok()
			):
				match verify(program(ids, [], [layout])):
					Ok(_): False
					Err(error): (
						error.message == "internal compiler error: invalid record identity in ownership representation"
						and error.help == "report this compiler error with the input program"
						and same_span(error.span, { source = compiler_source(), start = 0, end = 0 })
						and error.note.is_none()
					)
			else:
				False


tests: TestSuite = {
	description = "Blorp 2 recursive union layout verification",
	tests = [
		("real boxed Nat program verifies", test_real_boxed_nat_program_verifies),
		("boxed self payload layout accepted alone", test_boxed_self_payload_layout_is_accepted_alone),
		("self payload under an inline representation rejected", test_self_payload_under_an_inline_representation_is_rejected),
		("boxed layout without a self payload rejected", test_boxed_layout_without_a_self_payload_is_rejected),
		("two self payloads in one variant rejected", test_two_self_payloads_in_one_variant_are_rejected),
		("boxed union may close a cycle through a managed record", test_boxed_union_may_close_a_cycle_through_a_managed_record),
		("managed record may hold itself", test_managed_record_may_hold_itself),
		("inline unions holding each other form a by-value cycle", test_inline_unions_holding_each_other_form_a_by_value_cycle),
		("inline record and union form a by-value cycle", test_inline_record_and_union_form_a_by_value_cycle),
		("direct mutual boxed layouts rejected", test_direct_mutual_boxed_layouts_are_rejected),
		("record holding a boxed union must be managed", test_record_holding_a_boxed_union_must_be_managed),
		(
			"owning first field does not hide a later unknown union payload",
			test_owning_first_field_does_not_hide_a_later_unknown_union_payload,
		),
		(
			"unused owning union validates a later callable signature member",
			test_unused_owning_union_validates_a_later_callable_signature_member,
		),
	]
}
