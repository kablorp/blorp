import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, entry_function, Entrypoint(NoArguments), EntryResult(IntegerExitStatus)
	../../../src/verify/verify: verify
	../../../src/utils/source: same_source
	../file_read_inputs: FileReadSeed, file_read_seed, file_read_seed_from_source, called_function
	../module_input: test_base
	../ownership_inputs: InputIds, input_ids, span
	test: TestSuite


private pure func raw_result(
	ids: InputIds,
	constructors: Builtins.DesignatedResult[Concrete.VariantInstanceId],
	ownership: Own.ResultOwnership,
	drops: List[Own.OwnershipOperation],
	unions: List[Concrete.ConcreteUnion],
) -> Own.OwnershipProgram:
	call: Concrete.CallTarget = Concrete.RuntimeFunction(Builtins.ReadFile(constructors))
	result: Own.OwnedDefinition = {
		id = ids.second,
		value_type = Concrete.UnionType(Concrete.variant_owner(constructors.ok)),
		operation = Own.CallDefinition(call, [Own.BorrowedArgument({ value = ids.first, source = Own.ParameterBorrow(ids.first) })]), result = ownership, span = span(30)
	}
	path: Own.OwnedDefinition = {
		id = ids.first, value_type = Concrete.StringType,
		operation = Own.ParameterDefinition(0), result = Own.BorrowedResult(Own.ParameterBorrow(ids.first)), span = span(20)
	}
	zero: Own.OwnedDefinition = {
		id = ids.third, value_type = Concrete.IntType,
		operation = Own.IntegerDefinition(0), result = Own.UnmanagedResult, span = span(50)
	}
	function: Own.OwnedFunction = {
		parameters = [Own.ManagedParameter({ value_type = Concrete.StringType, owned = False })], return_type = Concrete.IntType,
		operations = [Own.DefineValue(path), Own.DefineValue(result)].concat(drops).append(Own.DefineValue(zero)),
		result = Own.UnmanagedReturn(ids.third)
	}
	main: Own.OwnedFunction = {
		parameters = [], return_type = Concrete.IntType,
		operations = [Own.DefineValue({ zero | id = ids.first })],
		result = Own.UnmanagedReturn(ids.first)
	}
	{ records = [], unions = unions, functions = [main, function], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }


private pure func rejection_is(error: Diagnostic, message: String, at: Int) -> Bool:
	(
		error.message == "ownership verification failed: " + message
		and error.help == "report this compiler error with the input program"
		and same_source(error.span.source, span(at).source)
		and error.span.start == at and error.span.end == at + 1
		and error.note.is_none()
	)


private pure func rejects(program: Own.OwnershipProgram, message: String, at: Int) -> Bool:
	match verify(program):
		Ok(_): False
		Err(error): rejection_is(error, message, at)


private pure func valid_result(seed: FileReadSeed, ids: InputIds) -> Own.OwnershipProgram:
	raw_result(ids, seed.constructors, Own.OwnedResult(Own.owner_id(0)), [Own.DropOwner(Own.owner_id(0), span(40))], Lower.lowered_functions(seed.lowered).unions)


pure func test_unknown_user_target_rejects_at_the_call_anchor() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			result: Own.OwnedDefinition = {
				id = ids.first,
				value_type = Concrete.IntType,
				operation = Own.CallDefinition(
					Concrete.UserFunction(ids.second_function),
					[],
				),
				result = Own.UnmanagedResult,
				span = span(30)
			}
			function: Own.OwnedFunction = {
				parameters = [], return_type = Concrete.IntType,
				operations = [Own.DefineValue(result)],
				result = Own.UnmanagedReturn(ids.first)
			}
			program: Own.OwnershipProgram = {
				records = [],
				unions = [],
				functions = [function],
				entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus)
			}
			rejects(program, "unknown called function", 30)


pure func test_raw_result_has_one_owner_and_drop() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)): verify(valid_result(seed, ids)).is_ok()
		_: False


pure func test_verifier_rejects_wrong_error_payload() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			program = valid_result(seed, ids)
			wrong: List[Concrete.ConcreteUnion] = [Concrete.OwningCases([[Concrete.StringType], [Concrete.IntType]])]
			rejects({ program | unions = wrong }, "variant payload does not match its operation", 30)
		_: False


pure func test_verifier_rejects_duplicate_result_constructor() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			program = raw_result(ids, { seed.constructors | err = seed.constructors.ok },
				Own.OwnedResult(Own.owner_id(0)), [Own.DropOwner(Own.owner_id(0), span(40))],
				Lower.lowered_functions(seed.lowered).unions)
			rejects(program, "runtime Result constructors do not cover one result union", 30)
		_: False


pure func test_verifier_rejects_unmanaged_result() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			rejects(raw_result(ids, seed.constructors, Own.UnmanagedResult, [], Lower.lowered_functions(seed.lowered).unions), "managed result requires an owner", 30)
		_: False


pure func test_verifier_rejects_missing_result_drop() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			rejects(raw_result(ids, seed.constructors, Own.OwnedResult(Own.owner_id(0)), [], Lower.lowered_functions(seed.lowered).unions), "owner 0 remains live at return", 50)
		_: False


pure func test_verifier_rejects_missing_result_constructor() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			program = valid_result(seed, ids)
			missing: List[Concrete.ConcreteUnion] = [Concrete.OwningCases([[Concrete.StringType]])]
			rejects({ program | unions = missing }, "unknown variant identity", 30)
		_: False


pure func test_verifier_rejects_duplicate_result_drop() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			drops = [Own.DropOwner(Own.owner_id(0), span(40)), Own.DropOwner(Own.owner_id(0), span(41))]
			program = raw_result(ids, seed.constructors, Own.OwnedResult(Own.owner_id(0)), drops,
				Lower.lowered_functions(seed.lowered).unions)
			rejects(program, "owner 0 has already been discharged", 41)
		_: False


func test_verifier_rejects_cross_owner_error_constructor() -> Bool:
	source: String =
		|fixed union Other:
		|    Outside(String)
		|func query(path: String) -> Result[String, String]:
		|    builtin("system.read_file")
		|func escape(path: String) -> String:
		|    match query(path):
		|        Ok(contents): contents
		|        Err(error): error
		|pure func make_other() -> Other:
		|    Outside("x")
		|func main() -> Int:
		|    unused = query("input")
		|    escaped = escape("input")
		|    other_value = make_other()
		|    0
		|
	match (file_read_seed_from_source(source, test_base()), input_ids()):
		(Err(error), _):
			print_error("cross-owner fixture: " + error.message)
			print_error(error.help)
			False
		(Ok(seed), Ok(ids)):
			contents = Lower.lowered_functions(seed.lowered)
			match contents.functions.get(Concrete.function_number(entry_function(contents.entrypoint))):
				Some(main):
					result_owner = Concrete.union_number(Concrete.variant_owner(seed.constructors.ok))
					other_calls = main.steps.filter(pure func(step):
						match step:
							Lower.Define(definition):
								match definition.value_type:
									Concrete.UnionType(owner): Concrete.union_number(owner) != result_owner
									_: False
							_: False
					)
					match other_calls:
						[other_call]:
							match called_function(other_call).map(pure func(id): contents.functions.get(Concrete.function_number(id))):
								Ok(Some(maker)):
									match maker.steps:
										[Lower.Define(_), Lower.Define(other_definition)]:
											match other_definition.operation:
												Lower.ConstructValue(constructor, [_]):
													program = raw_result(ids, { seed.constructors | err = constructor },
														Own.OwnedResult(Own.owner_id(0)), [Own.DropOwner(Own.owner_id(0), span(40))], contents.unions)
													match verify(program):
														Err(error): rejection_is(error, "runtime Result constructors do not cover one result union", 30)
														Ok(_): False
												_: False
										_: False
								_: False
						_: False
				None: False
		_: False


private pure func replace_call(program: Own.OwnershipProgram, arguments: List[Own.OwnedArgument], value_type: Concrete.TypeRef) -> Own.OwnershipProgram:
	match program.functions:
		[main, function]:
			match function.operations:
				[Own.DefineValue(path), Own.DefineValue(result), ...remaining]:
					match result.operation:
						Own.CallDefinition(call, _):
							changed = { result | operation = Own.CallDefinition(call, arguments), value_type = value_type }
							{ program | functions = [main, { function | operations = [Own.DefineValue(path), Own.DefineValue(changed)].concat(remaining) }] }
						_: program
				_: program
		_: program


pure func test_verifier_rejects_wrong_success_payload() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			program = valid_result(seed, ids)
			wrong: List[Concrete.ConcreteUnion] = [Concrete.OwningCases([[Concrete.IntType], [Concrete.StringType]])]
			rejects({ program | unions = wrong }, "variant payload does not match its operation", 30)
		_: False


pure func test_verifier_rejects_missing_and_extra_path_operands() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			program = valid_result(seed, ids)
			borrow = Own.BorrowedArgument({ value = ids.first, source = Own.ParameterBorrow(ids.first) })
			value_type = Concrete.UnionType(Concrete.variant_owner(seed.constructors.ok))
			(
				rejects(replace_call(program, [], value_type), "call is missing its argument", 30)
				and rejects(replace_call(program, [borrow, borrow], value_type), "call has an unexpected argument", 30)
			)
		_: False


pure func test_verifier_rejects_wrong_call_result_type() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			arguments = [Own.BorrowedArgument({ value = ids.first, source = Own.ParameterBorrow(ids.first) })]
			rejects(replace_call(valid_result(seed, ids), arguments, Concrete.IntType), "call result type does not match its contract", 30)
		_: False


pure func test_verifier_rejects_non_string_path_operand() -> Bool:
	match (file_read_seed(test_base()), input_ids()):
		(Ok(seed), Ok(ids)):
			program = valid_result(seed, ids)
			match program.functions:
				[main, function]:
					match function.operations:
						[Own.DefineValue(parameter), ...remaining]:
							wrong = { parameter | value_type = Concrete.IntType, result = Own.UnmanagedResult }
							changed = { function | parameters = [Own.UnmanagedParameter(Concrete.IntType)], operations = [Own.DefineValue(wrong)].concat(remaining) }
							rejects({ program | functions = [main, changed] }, "call argument type does not match its contract", 30)
						_: False
				_: False
		_: False


tests: TestSuite = {
	description = "Blorp 2 independent Result verification",
	tests = [
		("unknown user target keeps the call anchor", test_unknown_user_target_rejects_at_the_call_anchor),
		("wrong success payload rejects", test_verifier_rejects_wrong_success_payload),
		("missing and extra path operands reject", test_verifier_rejects_missing_and_extra_path_operands),
		("wrong call return type rejects", test_verifier_rejects_wrong_call_result_type),
		("non-String path operand rejects", test_verifier_rejects_non_string_path_operand),
		("raw Result owner and drop are valid", test_raw_result_has_one_owner_and_drop),
		("Result error payload must match", test_verifier_rejects_wrong_error_payload),
		("missing Result constructor rejects", test_verifier_rejects_missing_result_constructor),
		("duplicate Result drop rejects", test_verifier_rejects_duplicate_result_drop),
		("Result constructors must be distinct", test_verifier_rejects_duplicate_result_constructor),
		("Result must own its String", test_verifier_rejects_unmanaged_result),
		("Result owner must be dropped", test_verifier_rejects_missing_result_drop),
		("Result error constructor must share its owner", test_verifier_rejects_cross_owner_error_constructor),
	]
}
