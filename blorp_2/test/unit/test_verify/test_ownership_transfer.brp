import:
	../../../src/check/model as Model
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/utils/source: same_source
	../../../src/utils/syntax: Diagnostic, Entrypoint(NoArguments), EntryResult(IntegerExitStatus), entry_function
	../../../src/verify/verify: verify
	../list_update_inputs: lowered, owned_source, span
	int: Int methods
	bool: Bool methods
	string: String methods
	list: List methods
	option: Option methods
	result: Result methods
	test: TestSuite


fixed record TransferIds {
	first: Lower.ValueId,
	second: Lower.ValueId,
	third: Lower.ValueId,
	fourth: Lower.ValueId,
	fifth: Lower.ValueId,
	sixth: Lower.ValueId,
	seventh: Lower.ValueId,
	eighth: Lower.ValueId,
	entrypoint: Concrete.FunctionInstanceId
}


-- Mint opaque identities through lowering; this seed supplies no ownership facts.
private pure func transfer_ids() -> Result[TransferIds, Diagnostic]:
	source: String =
		|func main() -> Int:
		|    first = 1
		|    second = 2
		|    third = 3
		|    fourth = 4
		|    fifth = 5
		|    sixth = 6
		|    seventh = 7
		|    eighth = 8
		|    9
		|
	program ?= lowered(source).map(Lower.lowered_functions)
	failure: Diagnostic = { span = span(0), note = None, message = "expected nine identity seed definitions", help = "fix the ownership transfer test seed" }
	match program.functions:
		[seed]:
			match seed.steps:
				[Lower.Define(first), Lower.Define(second), Lower.Define(third), Lower.Define(fourth), Lower.Define(fifth), Lower.Define(sixth), Lower.Define(seventh), Lower.Define(eighth), Lower.Define(_)]:
					Ok({
						first = first.id, second = second.id, third = third.id, fourth = fourth.id,
						fifth = fifth.id, sixth = sixth.id, seventh = seventh.id, eighth = eighth.id,
						entrypoint = entry_function(program.entrypoint),
					})
				_: Err(failure)
		_: Err(failure)


private pure func rejects(program: Own.OwnershipProgram, message: String, at: Int) -> Bool:
	match verify(program):
		Ok(_): False
		Err(error):
			error.message.equals("ownership verification failed: ".add(message))
				.and(error.help.equals("report this compiler error with the input program"))
				.and(same_source(error.span.source, span(at).source))
				.and(error.span.start.equals(at)).and(error.span.end.equals(at.add(1)))
				.and(error.note.is_none())


private pure func list_type() -> Concrete.TypeRef:
	Concrete.ListType(Concrete.IntType)


private pure func empty_list(id: Lower.ValueId, owner: Int, at: Int) -> Own.OwnershipOperation:
	Own.DefineValue({ id = id, value_type = list_type(), operation = Own.ConstructListDefinition([]), result = Own.OwnedResult(Own.owner_id(owner)), span = span(at) })


private pure func integer(id: Lower.ValueId, value: Int, at: Int) -> Own.OwnershipOperation:
	Own.DefineValue({ id = id, value_type = Concrete.IntType, operation = Own.IntegerDefinition(value), result = Own.UnmanagedResult, span = span(at) })


private pure func length_of(id: Lower.ValueId, list: Lower.ValueId, owner: Int, at: Int) -> Own.OwnershipOperation:
	argument: Own.OwnedArgument = Own.BorrowedArgument({ value = list, source = Own.OwnerBorrow(Own.owner_id(owner)) })
	Own.DefineValue({ id = id, value_type = Concrete.IntType, operation = Own.CallDefinition(Concrete.RuntimeFunction(Builtins.ListLength(Concrete.IntType)), [argument]), result = Own.UnmanagedResult, span = span(at) })


private pure func header(id: Lower.ValueId, owner: Int, initial: Own.ReturnTransfer, at: Int) -> Own.OwnedLoopHeader:
	{ parameter = Own.ManagedJoinParameter({ id = id, value_type = list_type(), span = span(at) }, Own.owner_id(owner)), initial = initial }


private pure func program_with(ids: TransferIds, worker: Own.OwnedFunction) -> Own.OwnershipProgram:
	main: Own.OwnedFunction = {
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = [integer(ids.first, 0, 1)], result = Own.UnmanagedReturn(ids.first)
	}
	{ records = [], unions = [], functions = [main, worker], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }


-- One raw contract per fault. Its accepted form: v0 and v1 own fresh Lists;
-- the loop header takes v0's owner 0 with no entry acquisition, reads its own
-- header in the body and drops it at the break; the continuation drops only
-- owner 1. The loop body's values and owners follow the block (v4, owner 2).
private fixed union HeaderFault:
	NoFault
	AcquiredOwnerTransfers
	DropAfterLoop
	ReadAfterLoop
	DropInBody
	ReadInBody
	NotItsInitial
	TakenTwice
	AcquiresFromTaken


private pure func header_program(ids: TransferIds, fault: HeaderFault) -> Own.OwnershipProgram:
	var prefix: List[Own.OwnershipOperation] = [empty_list(ids.first, 0, 10), empty_list(ids.second, 1, 11)]
	var acquisitions: List[Own.OwnerAcquisition] = []
	var headers = [header(ids.fifth, 2, Own.OwnedReturn(ids.first, Own.owner_id(0)), 40)]
	var body: List[Own.OwnershipOperation] = [length_of(ids.sixth, ids.fifth, 2, 45), Own.DropOwner(Own.owner_id(2), span(46))]
	var after: List[Own.OwnershipOperation] = [integer(ids.fourth, 0, 60), Own.DropOwner(Own.owner_id(1), span(61))]
	match fault:
		NoFault: void
		AcquiredOwnerTransfers:
			-- Owner 1 is an acquisition of v0 made before the loop, as a
			-- projection's owner is; the header takes it and owner 0 drops later.
			prefix = [empty_list(ids.first, 0, 10), Own.AcquireOwner(Own.owner_id(1), { value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) }, span(11)), integer(ids.second, 0, 12)]
			headers = [header(ids.fifth, 2, Own.OwnedReturn(ids.first, Own.owner_id(1)), 40)]
			after = [integer(ids.fourth, 0, 60), Own.DropOwner(Own.owner_id(0), span(61))]
		DropAfterLoop: after = after.append(Own.DropOwner(Own.owner_id(0), span(62)))
		ReadAfterLoop: after = [length_of(ids.fourth, ids.first, 0, 60), Own.DropOwner(Own.owner_id(1), span(61))]
		DropInBody: body = [Own.DropOwner(Own.owner_id(0), span(44))].concat(body)
		ReadInBody: body = [length_of(ids.sixth, ids.first, 0, 45), Own.DropOwner(Own.owner_id(2), span(46))]
		NotItsInitial: headers = [header(ids.fifth, 2, Own.OwnedReturn(ids.first, Own.owner_id(1)), 40)]
		TakenTwice:
			headers = headers.append(header(ids.sixth, 3, Own.OwnedReturn(ids.first, Own.owner_id(0)), 41))
			body = [length_of(ids.seventh, ids.fifth, 2, 45), Own.DropOwner(Own.owner_id(2), span(46)), Own.DropOwner(Own.owner_id(3), span(47))]
		AcquiresFromTaken:
			acquisitions = [{ owner = Own.owner_id(2), borrow = { value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) } }]
			headers = [header(ids.fifth, 3, Own.OwnedReturn(ids.first, Own.owner_id(0)), 40), header(ids.sixth, 4, Own.OwnedReturn(ids.first, Own.owner_id(2)), 41)]
			body = [length_of(ids.seventh, ids.fifth, 3, 45), Own.DropOwner(Own.owner_id(3), span(46)), Own.DropOwner(Own.owner_id(4), span(47))]
	result = match body.get(0):
		Some(Own.DefineValue(definition)): definition.id
		_: ids.sixth
	loop: Own.OwnedLoop = {
		entry_acquisitions = acquisitions,
		headers = headers,
		result = Own.UnmanagedJoinParameter({ id = ids.third, value_type = Concrete.IntType, span = span(30) }),
		carried = [],
		body = { operations = body, tail = Own.ExitLoop(Own.Break({ value = Own.UnmanagedReturn(result), carried = [], span = span(50) })) },
	}
	program_with(ids, {
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = prefix.append(Own.ExecuteLoop(loop)).concat(after),
		result = Own.UnmanagedReturn(ids.fourth),
	})


private pure func header_rejects(fault: HeaderFault, message: String, at: Int) -> Bool:
	match transfer_ids():
		Err(_): False
		Ok(ids): verify(header_program(ids, NoFault)).is_ok().and(rejects(header_program(ids, fault), message, at))


pure func test_header_takes_a_dying_owner() -> Bool:
	match transfer_ids():
		Err(_): False
		Ok(ids): verify(header_program(ids, NoFault)).is_ok()


pure func test_acquired_owner_transfers_by_membership_not_origin() -> Bool:
	match transfer_ids():
		Err(_): False
		Ok(ids): verify(header_program(ids, AcquiredOwnerTransfers)).is_ok()


pure func test_taken_owner_cannot_drop_after_the_loop() -> Bool:
	header_rejects(DropAfterLoop, "owner 0 has already been discharged", 62)


pure func test_taken_owner_cannot_be_read_after_the_loop() -> Bool:
	header_rejects(ReadAfterLoop, "borrow refers to discharged owner 0", 60)


pure func test_taken_owner_cannot_drop_in_the_body() -> Bool:
	header_rejects(DropInBody, "owner 0 has already been discharged", 44)


pure func test_taken_owner_cannot_be_read_in_the_body() -> Bool:
	header_rejects(ReadInBody, "borrow refers to discharged owner 0", 45)


pure func test_taken_owner_must_own_its_initial() -> Bool:
	header_rejects(NotItsInitial, "owner 1 does not own value 0", 40)


pure func test_two_headers_cannot_take_one_owner() -> Bool:
	header_rejects(TakenTwice, "owner 0 has already been discharged", 41)


pure func test_entry_acquisition_cannot_borrow_a_taken_owner() -> Bool:
	header_rejects(AcquiresFromTaken, "borrow refers to discharged owner 0", 30)


-- A loop in a yielding arm may take only an owner entering its join. With
-- `takes_entering`, owner 0 enters and the loop's header takes it; otherwise
-- the continuation keeps owner 0 and drops it after the join.
private pure func arm_loop_program(ids: TransferIds, takes_entering: Bool) -> Own.OwnershipProgram:
	loop: Own.OwnedLoop = {
		entry_acquisitions = [],
		headers = [header(ids.fifth, 1, Own.OwnedReturn(ids.first, Own.owner_id(0)), 40)],
		result = Own.UnmanagedJoinParameter({ id = ids.fourth, value_type = Concrete.IntType, span = span(30) }),
		carried = [],
		body = {
			operations = [length_of(ids.sixth, ids.fifth, 1, 45), Own.DropOwner(Own.owner_id(1), span(46))],
			tail = Own.ExitLoop(Own.Break({ value = Own.UnmanagedReturn(ids.sixth), carried = [], span = span(50) })),
		},
	}
	entering: List[Own.OwnerId] = if takes_entering:
		[Own.owner_id(0)]
	else:
		[]
	join: Own.OwnedJoin = {
		result = Own.UnmanagedJoinParameter({ id = ids.third, value_type = Concrete.IntType, span = span(20) }),
		carried = [],
		entering = entering,
		selection = {
			scrutinee = Own.UnmanagedArgument(ids.second),
			entry = Model.decision_node_id(0),
			nodes = [Own.EnterArm({ arm = Model.match_arm_id(0), operations = [], transfers = [] })],
		},
		arms = [{ id = Model.match_arm_id(0), inputs = [], operations = [Own.ExecuteLoop(loop)], exit = Own.Yield({ transfer = Own.UnmanagedReturn(ids.fourth), carried = [] }) }],
	}
	var operations = [empty_list(ids.first, 0, 10), integer(ids.second, 7, 11), Own.ExecuteJoin(join)]
	if takes_entering.not():
		operations = operations.append(Own.DropOwner(Own.owner_id(0), span(61)))
	program_with(ids, {
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = operations,
		result = Own.UnmanagedReturn(ids.third),
	})


pure func test_loop_in_a_yielding_arm_takes_an_entering_owner() -> Bool:
	match transfer_ids():
		Err(_): False
		Ok(ids): verify(arm_loop_program(ids, True)).is_ok()


pure func test_loop_in_a_yielding_arm_cannot_take_a_non_entering_owner() -> Bool:
	match transfer_ids():
		Err(_): False
		Ok(ids): rejects(arm_loop_program(ids, False), "join arm discharges owner 0, which does not enter its join", 20)


-- One raw contract per join fault. Its accepted form: v0 and v1 own fresh
-- Lists, owners 0 and 1; owner 0 enters the join on Int v2, whose one arm
-- reads v0 and drops owner 0; the continuation defines v4 and drops owner 1.
-- The arm's value v5 follows the block's values. `StoresEntering` is a second
-- accepted form: the arm discharges owner 0 by storing v0 in a new List.
private fixed union JoinFault:
	NoJoinFault
	StoresEntering
	StoresNonEntering
	InactiveEntering
	RepeatedEntering
	UnknownEntering
	DropAfterJoin
	ReadAfterJoin
	LeavesEnteringLive
	DischargesNonEntering
	EdgeDischargesEntering


private pure func join_program(ids: TransferIds, fault: JoinFault) -> Own.OwnershipProgram:
	var prefix: List[Own.OwnershipOperation] = [empty_list(ids.first, 0, 10), empty_list(ids.second, 1, 11), integer(ids.third, 7, 12)]
	var entering = [Own.owner_id(0)]
	var edge: List[Own.OwnershipOperation] = []
	var arm: List[Own.OwnershipOperation] = [length_of(ids.sixth, ids.first, 0, 45), Own.DropOwner(Own.owner_id(0), span(46))]
	var after: List[Own.OwnershipOperation] = [integer(ids.fifth, 0, 60), Own.DropOwner(Own.owner_id(1), span(61))]
	match fault:
		NoJoinFault: void
		InactiveEntering: prefix = prefix.append(Own.DropOwner(Own.owner_id(0), span(13)))
		RepeatedEntering: entering = entering.append(Own.owner_id(0))
		UnknownEntering: entering = entering.append(Own.owner_id(7))
		DropAfterJoin: after = after.append(Own.DropOwner(Own.owner_id(0), span(62)))
		ReadAfterJoin: after = [length_of(ids.fifth, ids.first, 0, 60), Own.DropOwner(Own.owner_id(1), span(61))]
		LeavesEnteringLive: arm = [length_of(ids.sixth, ids.first, 0, 45)]
		DischargesNonEntering: arm = arm.append(Own.DropOwner(Own.owner_id(1), span(47)))
		EdgeDischargesEntering: edge = [Own.DropOwner(Own.owner_id(0), span(15))]
		StoresEntering: arm = stored_in_list(ids, ids.first, 0)
		StoresNonEntering: arm = stored_in_list(ids, ids.second, 1).append(Own.DropOwner(Own.owner_id(0), span(48)))
	yielded = match fault:
		StoresEntering | StoresNonEntering: ids.seventh
		_: ids.sixth
	join: Own.OwnedJoin = {
		result = Own.UnmanagedJoinParameter({ id = ids.fourth, value_type = Concrete.IntType, span = span(20) }),
		carried = [],
		entering = entering,
		selection = {
			scrutinee = Own.UnmanagedArgument(ids.third),
			entry = Model.decision_node_id(0),
			nodes = [Own.EnterArm({ arm = Model.match_arm_id(0), operations = edge, transfers = [] })],
		},
		arms = [{ id = Model.match_arm_id(0), inputs = [], operations = arm, exit = Own.Yield({ transfer = Own.UnmanagedReturn(yielded), carried = [] }) }],
	}
	program_with(ids, {
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = prefix.append(Own.ExecuteJoin(join)).concat(after),
		result = Own.UnmanagedReturn(ids.fourth),
	})


-- An arm that stores `stored`, with its owner, as the one element of a new
-- List v5 (owner 2), measures it as v6 and drops the new List.
private pure func stored_in_list(ids: TransferIds, stored: Lower.ValueId, owner: Int) -> List[Own.OwnershipOperation]:
	nested: Concrete.TypeRef = Concrete.ListType(list_type())
	borrow: Own.OwnedArgument = Own.BorrowedArgument({ value = ids.sixth, source = Own.OwnerBorrow(Own.owner_id(2)) })
	[
		Own.DefineValue({ id = ids.sixth, value_type = nested, operation = Own.ConstructListDefinition([Own.OwnedPayload(stored, Own.owner_id(owner))]), result = Own.OwnedResult(Own.owner_id(2)), span = span(45) }),
		Own.DefineValue({ id = ids.seventh, value_type = Concrete.IntType, operation = Own.CallDefinition(Concrete.RuntimeFunction(Builtins.ListLength(list_type())), [borrow]), result = Own.UnmanagedResult, span = span(46) }),
		Own.DropOwner(Own.owner_id(2), span(47)),
	]


private pure func join_rejects(fault: JoinFault, message: String, at: Int) -> Bool:
	match transfer_ids():
		Err(_): False
		Ok(ids): verify(join_program(ids, NoJoinFault)).is_ok().and(rejects(join_program(ids, fault), message, at))


pure func test_join_takes_an_entering_owner() -> Bool:
	match transfer_ids():
		Err(_): False
		Ok(ids): verify(join_program(ids, NoJoinFault)).is_ok()


pure func test_arm_may_store_an_entering_owner() -> Bool:
	match transfer_ids():
		Err(_): False
		Ok(ids): verify(join_program(ids, StoresEntering)).is_ok()


pure func test_arm_cannot_store_a_non_entering_owner() -> Bool:
	join_rejects(StoresNonEntering, "join arm discharges owner 1, which does not enter its join", 20)


pure func test_entering_owner_must_be_live_at_the_join() -> Bool:
	join_rejects(InactiveEntering, "owner 0 has already been discharged", 20)


pure func test_entering_owner_cannot_repeat() -> Bool:
	join_rejects(RepeatedEntering, "owner 0 has already been discharged", 20)


pure func test_entering_owner_must_be_defined() -> Bool:
	join_rejects(UnknownEntering, "owner 7 is not defined", 20)


pure func test_entering_owner_cannot_drop_after_the_join() -> Bool:
	join_rejects(DropAfterJoin, "owner 0 has already been discharged", 62)


pure func test_entering_owner_cannot_be_read_after_the_join() -> Bool:
	join_rejects(ReadAfterJoin, "borrow refers to discharged owner 0", 60)


pure func test_arm_cannot_leave_an_entering_owner_live() -> Bool:
	join_rejects(LeavesEnteringLive, "join arm leaves entering owner 0 live", 20)


pure func test_arm_cannot_discharge_a_non_entering_owner() -> Bool:
	join_rejects(DischargesNonEntering, "join arm discharges owner 1, which does not enter its join", 20)


pure func test_selection_edge_cannot_discharge_an_entering_owner() -> Bool:
	join_rejects(EdgeDischargesEntering, "selection edge contains an operation outside its local projections", 12)


-- Rewrites every join's arms in these operations and the blocks nested in them.
private pure func map_joins(operations: List[Own.OwnershipOperation], change: pure (Own.OwnedJoin) -> Own.OwnedJoin) -> List[Own.OwnershipOperation]:
	operations.map(pure func(operation):
		match operation:
			Own.ExecuteJoin(join):
				arms = join.arms.map(pure func(arm): { arm | operations = map_joins(arm.operations, change) })
				Own.ExecuteJoin(change({ join | arms = arms }))
			Own.ExecuteLoop(loop): Own.ExecuteLoop({ loop | body = map_loop_joins(loop.body, change) })
			_: operation
	)


private pure func map_loop_joins(block: Own.OwnedLoopBlock, change: pure (Own.OwnedJoin) -> Own.OwnedJoin) -> Own.OwnedLoopBlock:
	tail: Own.OwnedLoopTail = match block.tail:
		Own.ExitLoop(_): block.tail
		Own.MatchLoop(matched): Own.MatchLoop({ matched | arms = matched.arms.map(pure func(arm): { arm | body = map_loop_joins(arm.body, change) }) })
	{ operations = map_joins(block.operations, change), tail = tail }


-- A `break` arm retires an entering owner at its edge; a second drop there
-- discharges it twice.
private pure func drop_entering_again(join: Own.OwnedJoin) -> Own.OwnedJoin:
	match join.entering:
		[owner, ..._]:
			{ join | arms = join.arms.map(pure func(arm):
				match arm.exit:
					Own.TransferLoop(_, _): { arm | operations = arm.operations.append(Own.DropOwner(owner, span(77))) }
					Own.Yield(_): arm
			) }
		[]: join


pure func test_abrupt_arm_cannot_discharge_an_entering_owner_twice() -> Bool:
	body: String =
		|pure func collect() -> List[Int]:
		|    var values: List[Int] = []
		|    while less_than(length(values), 12):
		|        if less_than(length(values), 3):
		|            values = append(values, 1)
		|        else:
		|            break
		|    values
		|func main() -> Int:
		|    unused = collect()
		|    0
		|
	match owned_source(body):
		Err(_): False
		Ok(program):
			changed = program.functions.map(pure func(function): { function | operations = map_joins(function.operations, drop_entering_again) })
			var entered: List[Int] = []
			for function in changed:
				for operation in function.operations:
					match operation:
						Own.ExecuteLoop(loop):
							match loop.body.tail:
								Own.MatchLoop(matched):
									for arm in matched.arms:
										for nested in arm.body.operations:
											match nested:
												Own.ExecuteJoin(join): entered = entered.concat(join.entering.map(pure func(owner): Own.owner_number(owner)))
												_: void
								Own.ExitLoop(_): void
						_: void
			match entered:
				[owner]: verify(program).is_ok().and(rejects({ program | functions = changed }, "owner ${owner.to_string()} has already been discharged", 77))
				_: False


tests: TestSuite = {
	description = "Loop entry and join ownership transfer verification",
	tests = [
		("a header takes a dying owner without an entry acquisition", test_header_takes_a_dying_owner),
		("an acquired owner transfers by membership, not origin", test_acquired_owner_transfers_by_membership_not_origin),
		("a taken owner cannot be dropped after the loop", test_taken_owner_cannot_drop_after_the_loop),
		("a taken owner cannot be read after the loop", test_taken_owner_cannot_be_read_after_the_loop),
		("a taken owner cannot be dropped in the loop body", test_taken_owner_cannot_drop_in_the_body),
		("a taken owner cannot be read in the loop body", test_taken_owner_cannot_be_read_in_the_body),
		("a taken owner must own its header initial", test_taken_owner_must_own_its_initial),
		("two headers cannot take one owner", test_two_headers_cannot_take_one_owner),
		("an entry acquisition cannot borrow a taken owner", test_entry_acquisition_cannot_borrow_a_taken_owner),
		("a loop in a yielding arm takes an entering owner", test_loop_in_a_yielding_arm_takes_an_entering_owner),
		("a loop in a yielding arm cannot take a non-entering owner", test_loop_in_a_yielding_arm_cannot_take_a_non_entering_owner),
		("a join takes an entering owner its arm discharges", test_join_takes_an_entering_owner),
		("a join arm may store an entering owner", test_arm_may_store_an_entering_owner),
		("a join arm cannot store a non-entering owner", test_arm_cannot_store_a_non_entering_owner),
		("an entering owner must be live at the join", test_entering_owner_must_be_live_at_the_join),
		("an entering owner cannot repeat", test_entering_owner_cannot_repeat),
		("an entering owner must be defined", test_entering_owner_must_be_defined),
		("an entering owner cannot be dropped after the join", test_entering_owner_cannot_drop_after_the_join),
		("an entering owner cannot be read after the join", test_entering_owner_cannot_be_read_after_the_join),
		("a join arm cannot leave an entering owner live", test_arm_cannot_leave_an_entering_owner_live),
		("a join arm cannot discharge a non-entering owner", test_arm_cannot_discharge_a_non_entering_owner),
		("a selection edge cannot discharge an entering owner", test_selection_edge_cannot_discharge_an_entering_owner),
		("an abrupt arm cannot discharge an entering owner twice", test_abrupt_arm_cannot_discharge_an_entering_owner_twice),
	]
}
