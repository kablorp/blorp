import:
	../../../src/utils/names: program_names
	../../../src/check/model as Model
	../../../src/check/errors as Errors
	../../../src/check/check as API
	../../../src/check/render: render_failure
	../../../src/utils/ids as Declaration
	../../../src/lex/lex: lex
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/source: module_source, root_module_id
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, DiagnosticNote(PreviousDeclaration), ParsedBody(ParsedMatchBody), ParsedPattern(PatternConstructor, PatternName, PatternWildcard), TypeSyntax(AppliedType, AtomicType), type_span
	../../../src/verify/verify: verify
	../compilation: compile
	../input: check_failure, parse, setup_diagnostic
	../managed_union_inputs: lowered, lowered_tail_join
	test: TestSuite


private MAIN: String =
	|func main() -> Int:
	|    0
	|

private PAIR: String =
	|union Pair[A, B]:
	|    Pair(A, B)
	|

private MIXED: String =
	|union Mixed:
	|    Empty
	|    Fields(Int, Float, String, Void)
	|

private AMBIGUITY_MESSAGE: String = "cannot infer the type parameter from the argument"
private AMBIGUITY_HELP: String = "pass a value whose type determines the declared type parameter; use a concrete helper when no argument can determine it"


private pure func checked(source: String) -> Result[API.CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	API.check(parsed).map_err(setup_diagnostic)


private pure func specialized(source: String) -> Result[Concrete.SpecializedContents, Diagnostic]:
	program ?= checked(source)
	concrete ?= Concrete.specialize(program)
	Ok(Concrete.specialized_contents(concrete))


private pure func exact_rejection(
	prefix: String,
	marked: String,
	suffix: String,
	message: String,
	help: String,
	accepts: pure (Errors.CheckError) -> Bool,
) -> Bool:
	source = prefix + marked + suffix
	match lex(module_source(root_module_id()), source, program_names().names).and_then(parse):
		Ok(program):
			match API.check(program):
				Err(failure):
					errors = API.check_errors(failure)
					error = errors.first
					rendered = render_failure(failure).first
					note_matches = match error.kind:
						Errors.BindingRejection(Errors.LocalBindingConflict(previous, _)):
							match rendered.note:
								Some(PreviousDeclaration(note)):
									note.source == previous.span.source and note.start == previous.span.start and note.end == previous.span.end
								_: False
						_: rendered.note.is_none()
					(
						errors.remaining.is_empty() and note_matches
						and accepts(error)
						and error.span.source == module_source(root_module_id())
						and error.span.start == prefix.length()
						and error.span.end == prefix.length() + marked.length()
						and rendered.message == message
						and rendered.help == help
						and rendered.span.source == error.span.source
						and rendered.span.start == error.span.start
						and rendered.span.end == error.span.end
					)
				Ok(_): False
		Err(_): False


pure func test_declaration_fields_preserve_nested_type_spans() -> Bool:
	prefix: String =
		|record Box[T] { value: T }
		|union Fields:
		|    Pair(Int,${" "}
	annotation = "Box[List[String]]"
	match lex(module_source(root_module_id()), prefix + annotation + ")\n" + MAIN, program_names().names).and_then(parse):
		Ok(program):
			match Declaration.inventory_unions(parsed_contents(program).declarations):
				[declaration, _, _, _]:
					match declaration.variants:
						[variant]:
							match variant.declaration.fields:
								[AtomicType(_), AppliedType(_, [AppliedType(_, [AtomicType(text)], inner)], outer)]:
									(
										outer.start == prefix.length()
										and outer.end == prefix.length() + annotation.length()
										and inner.start == outer.start + 4
										and inner.end == outer.end - 1
										and text.span.start == outer.start + 9
										and text.span.end == outer.end - 2
										and outer.source == module_source(root_module_id())
									)
								_: False
						_: False
				_: False
		Err(_): False


pure func test_generic_constructor_publishes_union_base_and_rigid_children() -> Bool:
	source: String =
		|pure func make[T](value: T) -> Pair[T, Int]:
		|    Pair(value, 7)
		|
	match checked(PAIR + source + MAIN):
		Ok(program):
			match API.checked_functions(program).functions:
				[make, _]:
					match make.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match (value.form, value.value_type, make.signature.type_parameters):
								(Model.ConstructVariant(variant, [first, second]), Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(owner)), [Model.ParameterType(parameter), Model.IntType]), [declared]):
									(
										Declaration.union_number(owner) == 0
										and Declaration.union_number(Declaration.variant_owner(variant)) == 0
										and Declaration.variant_number(variant) == 0
										and Model.same_parameter(parameter, declared)
										and Model.same_type(first.value_type, Model.ParameterType(declared))
										and Model.same_type(second.value_type, Model.IntType)
									)
								_: False
						_: False
				_: False
		Err(_): False


private pure func constructor_count(actual: Int, spelling: String) -> Bool:
	prefix: String =
		|union Fields:
		|    Pair(Int, String)
		|pure func bad() -> Fields:
		|${"    "}
	exact_rejection(prefix, "Pair", spelling + "\n" + MAIN,
		"constructor field count does not match its declaration",
		"expected 2 fields, got " + actual.to_string() + "; pass one expression per declared field",
		pure func(error):
			match error.kind:
				Errors.ConstructorRejection(Errors.ConstructorFieldCountMismatch(owner, 2, count)):
					count == actual and Declaration.variant_number(owner) == 0
				_: False
	)


pure func test_constructor_requires_every_field() -> Bool:
	constructor_count(1, "(7)")


pure func test_constructor_rejects_extra_field() -> Bool:
	constructor_count(3, "(7, \"x\", 9)")


pure func test_bare_nonempty_constructor_reports_zero_fields() -> Bool:
	constructor_count(0, "")


private pure func pattern_count(actual: Int, pattern: String) -> Bool:
	prefix: String =
		|union Fields:
		|    Pair(Int, String)
		|pure func bad(value: Fields) -> Int:
		|    match value:
		|${"        "}
	exact_rejection(prefix, pattern, ": 0\n" + MAIN,
		"constructor pattern field count does not match its declaration",
		"expected 2 fields, got " + actual.to_string() + "; write one name or '_' per declared field",
		pure func(error):
			match error.kind:
				Errors.MatchRejection(Errors.PatternFieldCountMismatch(owner, 2, count)):
					count == actual and Declaration.variant_number(owner) == 0
				_: False
	)


pure func test_pattern_requires_every_positional_field() -> Bool:
	pattern_count(1, "Pair(item)")


pure func test_pattern_rejects_extra_position() -> Bool:
	pattern_count(3, "Pair(_, _, _)")


pure func test_duplicate_pattern_binding_has_second_span_and_prior_note() -> Bool:
	prefix: String =
		|union Fields:
		|    Pair(Int, Int)
		|pure func bad(value: Fields) -> Int:
		|    match value:
		|        Pair(item,${" "}
	exact_rejection(prefix, "item", "): item\n" + MAIN,
		"`item` is already a local in this function",
		"choose a different name for this binding",
		pure func(error):
			match error.kind:
				Errors.BindingRejection(Errors.LocalBindingConflict(previous, _)):
					previous.span.start == prefix.length() - 6 and previous.span.end == prefix.length() - 2
				_: False
	)


pure func test_second_field_mismatch_keeps_annotation_and_actual_origins() -> Bool:
	declaration: String =
		|union Fields:
		|    Pair(Int,${" "}
	annotation = "String"
	middle: String =
		|)
		|pure func bad() -> Fields:
		|${"    "}
	prefix = declaration + annotation + middle
	exact_rejection(prefix, "Pair", "(7, 8)\n" + MAIN,
		"argument type does not match the parameter type",
		"use an expression of type String here",
		pure func(error):
			match error.kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					match mismatch.expected_site:
						Errors.SourceAnnotation(expected):
							(
								mismatch.argument_position == 1
								and Model.same_type(mismatch.expected, Model.StringType)
								and Model.same_type(mismatch.actual.value_type, Model.IntType)
								and mismatch.actual.span.start == prefix.length() + 8
								and mismatch.actual.span.end == prefix.length() + 9
								and expected.start == declaration.length()
								and expected.end == declaration.length() + annotation.length()
								and expected.source == module_source(root_module_id())
							)
						_: False
				_: False
	)


private pure func first_function_ambiguity(error: Errors.CheckError) -> Bool:
	match error.kind:
		Errors.CallRejection(Errors.UninferableTypeParameter(parameter)):
			match Model.parameter_owner(parameter):
				Model.FunctionDeclaration(owner):
					Declaration.function_number(owner) == 0 and Model.parameter_position(parameter) == 0
				_: False
		_: False


pure func test_all_constructor_children_freeze_before_earlier_ordinary_mismatch() -> Bool:
	prefix: String =
		|union Choice[T]:
		|    Empty
		|union Fields:
		|    Pair(String, Int)
		|pure func create[T]() -> Choice[T]:
		|    Empty
		|pure func inspect(value: Fields) -> Int:
		|    7
		|func main() -> Int:
		|    inspect(Pair(7,${" "}
	exact_rejection(prefix, "create", "()))\n", AMBIGUITY_MESSAGE, AMBIGUITY_HELP, first_function_ambiguity)


pure func test_deferred_projection_preserves_later_name_error_priority() -> Bool:
	prefix: String =
		|record Marker[T] { value: Int }
		|union Fields:
		|    Pair(Int, Int)
		|pure func marker[T]() -> Marker[T]:
		|    { value = 7 }
		|pure func inspect(value: Fields) -> Int:
		|    7
		|func main() -> Int:
		|    inspect(Pair(marker().value,${" "}
	exact_rejection(prefix, "missing", "))\n", "unknown value",
		"use this function's parameter name, a declared variant, or a call",
		pure func(error):
			match error.kind:
				Errors.ValueRejection(Errors.UnknownValue(_)): True
				_: False
	)


pure func test_partial_nominal_head_infers_all_constructor_fields() -> Bool:
	source: String =
		|pure func inspect[T](value: Pair[T, Int]) -> Int:
		|    7
		|func main() -> Int:
		|    inspect(Pair("x", 7))
		|
	match checked(PAIR + source):
		Ok(program):
			match API.checked_functions(program).functions:
				[_, main]:
					match main.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(argument)]:
											match (call.target, argument.value_type):
												(Model.UserFunction(_, [Model.StringType]), Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(_)), [Model.StringType, Model.IntType])): True
												_: False
										_: False
								_: False
						_: False
				_: False
		Err(_): False


-- One direct self-reference beside other fields is the admitted unary shape.
pure func test_nonfirst_field_self_reference_is_admitted_even_unused() -> Bool:
	source: String =
		|union Loop:
		|    Pair(Int, Loop)
		|
	checked(source + MAIN).is_ok()


pure func test_nonfirst_field_nested_cycle_retains_full_written_span() -> Bool:
	prefix: String =
		|record Box[T] { value: T }
		|union Loop[T]:
		|    Pair(Int,${" "}
	exact_rejection(prefix, "Box[Loop[T]]", ")\n" + MAIN,
		"recursive aggregate types are not supported yet",
		"use finite record and union fields; recursion is supported through a record field, a List element or one direct self payload of a non-generic union, such as Next(Node)",
		pure func(error):
			match error.kind:
				Errors.TypeDeclarationRejection(Errors.RecursiveAggregateType(_)): True
				_: False
	)


private pure func nonfirst_list(element: String, expected: Model.TypeRef, concrete: Concrete.TypeRef, called: Bool) -> Bool:
	prefix: String =
		|union Values[T]:
		|    Items(Int,${" "}
	annotation = "List[T]"
	functions: String =
		|)
		|func produce() -> Values[${element}]:
		|    produce()
		|func pass(value: Values[${element}]) -> Values[${element}]:
		|    value
		|func main() -> Int:
		|
	body = if called:
		"    unused = pass(produce())\n    0\n"
	else:
		"    0\n"
	source = prefix + annotation + functions + body
	match checked(source):
		Err(_): False
		Ok(accepted):
			typed = match API.checked_functions(accepted).unions:
				[values, _, _, _]:
					match API.checked_functions(accepted).functions:
						[produce, pass, _]:
							match values.type_parameters:
								[parameter]:
									match values.variants:
										[variant]:
											match pass.signature.parameters:
												[input]:
													match variant.fields:
														[first, second]:
															(
																Model.same_type(first.value_type, Model.IntType)
																and Model.same_type(second.value_type, Model.ListType(Model.ParameterType(parameter)))
																and Model.same_type(produce.signature.return_type.value_type, Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(values.id)), [expected]))
																and Model.same_type(input.value_type, produce.signature.return_type.value_type)
																and Model.same_type(pass.signature.return_type.value_type, input.value_type)
															)
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False
			match Concrete.specialize(accepted):
				Err(_): False
				Ok(specialized):
					program = Concrete.specialized_contents(specialized)
					if called:
						match program.unions:
							[row]:
								match Concrete.union_variants(row):
									[[Concrete.IntType, Concrete.ListType(actual)]]:
										match row:
											Concrete.OwningCases(_): typed and Concrete.same_type(actual, concrete)
											_: False
									_: False
							_: False
					else:
						typed and program.unions.is_empty()


pure func test_nonfirst_list_int_no_literal_producer_prepares_complete_layout() -> Bool:
	nonfirst_list("Int", Model.IntType, Concrete.IntType, True)


pure func test_unused_nonfirst_concrete_list_keeps_checked_type_without_layout() -> Bool:
	nonfirst_list("Int", Model.IntType, Concrete.IntType, False)


pure func test_unused_nonfirst_symbolic_list_does_not_prepare_a_concrete_layout() -> Bool:
	source: String =
		|union Values[T]:
		|    Items(Int, List[T])
		|pure func pass[T](value: Values[T]) -> Values[T]:
		|    value
		|func main() -> Int:
		|    0
		|
	match specialized(source):
		Ok(program): program.unions.is_empty()
		Err(_): False


pure func test_nonfirst_list_string_no_literal_producer_prepares_layout() -> Bool:
	nonfirst_list("String", Model.StringType, Concrete.StringType, True)


pure func test_wildcard_keeps_the_second_same_typed_field_ordinal() -> Bool:
	source: String =
		|union Fields:
		|    Pair(String, String)
		|pure func right(value: Fields) -> String:
		|    match value:
		|        Pair(_, payload): payload
		|func main() -> Int:
		|    unused = right(Pair("left", "right"))
		|    0
		|
	match lowered(source):
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, right]:
					match (right.steps, lowered_tail_join(right)):
						([Lower.Define(parameter), Lower.Join(_)], Some(matched)):
							match (matched.selection.nodes, matched.arms):
								([Lower.EnterArm(edge)], [arm]):
									match arm.exit:
										Lower.Yield(outputs):
											match (edge.definitions, edge.arguments, arm.inputs):
												([Lower.BorrowUnionField(child, field, receiver)], [argument], [input]):
													match parameter.value_type:
														Concrete.UnionType(scrutinee_owner):
															selected = Concrete.variant_field_variant(field)
															(
																Concrete.variant_field_number(field) == 1
																and Concrete.union_number(Concrete.variant_owner(selected)) == Concrete.union_number(scrutinee_owner)
																and Lower.value_number(receiver) == Lower.value_number(parameter.id)
																and Lower.value_number(argument) == Lower.value_number(child.id)
																and Lower.value_number(outputs.value) == Lower.value_number(input.id)
																and Concrete.same_type(child.value_type, Concrete.StringType)
																and Concrete.same_type(input.value_type, Concrete.StringType)
															)
														_: False
												_: False
										Lower.TransferLoop(_, _): False
								_: False
						_: False
				_: False
		Err(_): False


pure func test_duplicate_borrowed_child_gets_fresh_owner_for_each_slot() -> Bool:
	source: String =
		|union Fields:
		|    Pair(String, String)
		|pure func make(value: String) -> Fields:
		|    Pair(value, value)
		|func main() -> Int:
		|    unused = make("x")
		|    0
		|
	match lowered(source).and_then(Own.own):
		Ok(program):
			valid = verify(program).is_ok()
			match program.functions:
				[_, make]:
					match make.operations:
						[Own.DefineValue(parameter), Own.AcquireOwner(first, first_borrow, _), Own.AcquireOwner(second, second_borrow, _), Own.DefineValue(constructed)]:
							match (constructed.operation, constructed.result, make.result):
								(Own.ConstructDefinition(_, [Own.OwnedPayload(a, a_owner), Own.OwnedPayload(b, b_owner)]), Own.OwnedResult(parent), Own.OwnedReturn(returned, returned_owner)):
									(
										valid
										and Lower.value_number(a) == Lower.value_number(parameter.id)
										and Lower.value_number(b) == Lower.value_number(parameter.id)
										and Lower.value_number(first_borrow.value) == Lower.value_number(a)
										and Lower.value_number(second_borrow.value) == Lower.value_number(b)
										and Own.owner_number(first) == Own.owner_number(a_owner)
										and Own.owner_number(second) == Own.owner_number(b_owner)
										and Own.owner_number(first) != Own.owner_number(second)
										and Own.owner_number(parent) != Own.owner_number(first)
										and Own.owner_number(parent) != Own.owner_number(second)
										and Own.owner_number(returned_owner) == Own.owner_number(parent)
										and Lower.value_number(returned) == Lower.value_number(constructed.id)
									)
								_: False
						_: False
				_: False
		Err(_): False


pure func test_duplicate_owned_child_is_acquired_twice_before_original_drop() -> Bool:
	source: String =
		|union Fields:
		|    Pair(String, String)
		|pure func identity(value: String) -> String:
		|    value
		|pure func make(value: String) -> Fields:
		|    text = identity(value)
		|    Pair(text, text)
		|func main() -> Int:
		|    unused = make("x")
		|    0
		|
	match lowered(source).and_then(Own.own):
		Ok(program):
			valid = verify(program).is_ok()
			program.functions.any(pure func(function):
				match function.operations:
					[Own.DefineValue(_), Own.DefineValue(text), Own.AcquireOwner(first, first_borrow, _), Own.AcquireOwner(second, second_borrow, _), Own.DefineValue(constructed), Own.DropOwner(dropped, _)]:
						match (text.result, constructed.operation):
							(Own.OwnedResult(original), Own.ConstructDefinition(_, [Own.OwnedPayload(a, a_owner), Own.OwnedPayload(b, b_owner)])):
								(
									valid
									and Lower.value_number(a) == Lower.value_number(text.id)
									and Lower.value_number(b) == Lower.value_number(text.id)
									and Lower.value_number(first_borrow.value) == Lower.value_number(text.id)
									and Lower.value_number(second_borrow.value) == Lower.value_number(text.id)
									and Own.owner_number(first) == Own.owner_number(a_owner)
									and Own.owner_number(second) == Own.owner_number(b_owner)
									and Own.owner_number(first) != Own.owner_number(second)
									and Own.owner_number(first) != Own.owner_number(original)
									and Own.owner_number(second) != Own.owner_number(original)
									and Own.owner_number(dropped) == Own.owner_number(original)
								)
							_: False
					_: False
			)
		Err(_): False


pure func test_concrete_mixed_fields_keep_every_position_and_representation() -> Bool:
	source: String =
		|pure func make() -> Mixed:
		|    Fields(7, 2.5, "x", void)
		|func main() -> Int:
		|    unused = make()
		|    0
		|
	match specialized(MIXED + source):
		Ok(program):
			match program.unions:
				[row]:
					match (Concrete.union_variants(row), row):
						([[], [Concrete.IntType, Concrete.FloatType, Concrete.StringType, Concrete.VoidType]], Concrete.OwningCases(_)): True
						_: False
				_: False
		Err(_): False


pure func test_nullary_between_nonempty_variants_keeps_c_member_ordinals() -> Bool:
	source: String =
		|union Fields:
		|    First(Int)
		|    Empty
		|    Pair(Int, Int)
		|pure func make() -> Fields:
		|    Pair(7, 9)
		|func main() -> Int:
		|    unused = make()
		|    0
		|
	match compile(source):
		Ok(output):
			(
				output.contains("struct{int64_t blorp_uf_0;} blorp_up_0;")
				and output.contains("struct{int64_t blorp_uf_0;int64_t blorp_uf_1;} blorp_up_2;")
				and not output.contains("blorp_up_1")
				and not output.contains("struct{}")
				and output.contains(".payload.blorp_up_2={.blorp_uf_0=blorp_vl_0,.blorp_uf_1=blorp_vl_1}")
			)
		Err(_): False


pure func test_nonfirst_string_and_float_fields_select_headers() -> Bool:
	source: String =
		|union Fields:
		|    Pair(Int, Float, String)
		|func produce() -> Fields:
		|    produce()
		|func main() -> Int:
		|    unused = produce()
		|    0
		|
	match compile(source):
		Ok(output):
			(
				output.contains("#include <math.h>")
				and output.contains("struct blorp_string")
				and output.contains("double blorp_uf_1;struct blorp_string* blorp_uf_2;")
				and output.contains("blorp_string_retain(value.payload.blorp_up_0.blorp_uf_2)")
				and output.contains("blorp_string_release(value.payload.blorp_up_0.blorp_uf_2)")
			)
		Err(_): False


pure func test_nonfirst_list_and_record_dependencies_emit_before_parent() -> Bool:
	source: String =
		|record Child { text: String }
		|union Fields:
		|    Pair(Int, Child, List[String])
		|func produce() -> Fields:
		|    produce()
		|func main() -> Int:
		|    unused = produce()
		|    0
		|
	match compile(source):
		Ok(output):
			ordered = match (output.index_of("struct blorp_r_0{"), output.index_of("struct blorp_u_0{")):
				(Some(child), Some(parent)): child < parent
				_: False
			(
				ordered and output.contains("blorp_r_0 blorp_uf_1;struct blorp_l_0_s* blorp_uf_2;")
				and output.contains("blorp_record_dup_0(value.payload.blorp_up_0.blorp_uf_1)")
				and output.contains("blorp_list_dup_0_s(value.payload.blorp_up_0.blorp_uf_2)")
				and output.contains("blorp_list_drop_0_s(value.payload.blorp_up_0.blorp_uf_2)")
			)
		Err(_): False


pure func test_nested_fields_substitute_simultaneously_between_three_rigid_owners() -> Bool:
	source: String =
		|record Box[T] { value: T }
		|union Wrapper[T]:
		|    Pair(Box[T], T)
		|pure func make[T](value: T) -> Wrapper[T]:
		|    Pair({ value = value }, value)
		|func main() -> Int:
		|    unused = make(7)
		|    0
		|
	match checked(source):
		Ok(program):
			facts = API.checked_functions(program)
			match (facts.records, facts.unions, facts.functions):
				([record_declaration], [union_declaration, _, _, _], [make, _]):
					match (record_declaration.type_parameters, union_declaration.type_parameters, make.signature.type_parameters):
						([record_parameter], [union_parameter], [caller_parameter]):
							owners_distinct = (
								not Model.same_parameter(record_parameter, union_parameter)
								and not Model.same_parameter(record_parameter, caller_parameter)
								and not Model.same_parameter(union_parameter, caller_parameter)
								and Model.parameter_position(record_parameter) == 0
								and Model.parameter_position(union_parameter) == 0
								and Model.parameter_position(caller_parameter) == 0
							)
							match make.body:
								Model.CheckedValueBody(Model.ReturnExpression(value)):
									match (value.form, value.value_type):
										(Model.ConstructVariant(_, [first, second]), Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(_)), [Model.ParameterType(result_parameter)])):
											match (first.form, first.value_type):
												(Model.ConstructRecord(owner, [field]), Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(applied_owner)), [Model.ParameterType(field_parameter)])):
													(
														owners_distinct
														and Declaration.record_number(owner) == 0
														and Declaration.record_number(applied_owner) == 0
														and Model.same_parameter(result_parameter, caller_parameter)
														and Model.same_parameter(field_parameter, caller_parameter)
														and Model.same_type(field.value.value_type, Model.ParameterType(caller_parameter))
														and Model.same_type(second.value_type, Model.ParameterType(caller_parameter))
													)
												_: False
										_: False
								_: False
						_: False
				_: False
		Err(_): False


tests: TestSuite = {
	description = "Ordered union fields across compiler phases",
	tests = [
		("nested fields preserve three rigid authorities", test_nested_fields_substitute_simultaneously_between_three_rigid_owners),
		("declaration fields retain nested type spans", test_declaration_fields_preserve_nested_type_spans),
		("constructor publishes complete rigid field facts", test_generic_constructor_publishes_union_base_and_rigid_children),
		("constructor requires every field", test_constructor_requires_every_field),
		("constructor rejects extra field", test_constructor_rejects_extra_field),
		("bare nonempty constructor counts zero fields", test_bare_nonempty_constructor_reports_zero_fields),
		("pattern requires every field", test_pattern_requires_every_positional_field),
		("pattern rejects extra field", test_pattern_rejects_extra_position),
		("duplicate binder preserves previous occurrence", test_duplicate_pattern_binding_has_second_span_and_prior_note),
		("second mismatch retains annotation and actual spans", test_second_field_mismatch_keeps_annotation_and_actual_origins),
		("all children freeze before ordinary mismatch", test_all_constructor_children_freeze_before_earlier_ordinary_mismatch),
		("deferred projection preserves later name priority", test_deferred_projection_preserves_later_name_error_priority),
		("partial nominal head infers constructor fields", test_partial_nominal_head_infers_all_constructor_fields),
		("unused nonfirst self reference admitted", test_nonfirst_field_self_reference_is_admitted_even_unused),
		("nonfirst nested cycle has whole written span", test_nonfirst_field_nested_cycle_retains_full_written_span),
		("nonfirst List[Int] producer prepares complete layout", test_nonfirst_list_int_no_literal_producer_prepares_complete_layout),
		("unused nonfirst List[Int] keeps checked type without layout", test_unused_nonfirst_concrete_list_keeps_checked_type_without_layout),
		("unused symbolic List does not prepare layout", test_unused_nonfirst_symbolic_list_does_not_prepare_a_concrete_layout),
		("nonfirst List[String] producer prepares layout", test_nonfirst_list_string_no_literal_producer_prepares_layout),
		("wildcard retains second same-typed ordinal", test_wildcard_keeps_the_second_same_typed_field_ordinal),
		("borrowed duplicate has one fresh owner per slot", test_duplicate_borrowed_child_gets_fresh_owner_for_each_slot),
		("owned duplicate acquires both slots before drop", test_duplicate_owned_child_is_acquired_twice_before_original_drop),
		("mixed concrete fields preserve positions", test_concrete_mixed_fields_keep_every_position_and_representation),
		("nullary between payload variants preserves C ordinal", test_nullary_between_nonempty_variants_keeps_c_member_ordinals),
		("nonfirst String and Float select runtime headers", test_nonfirst_string_and_float_fields_select_headers),
		("nonfirst List and record dependencies emit", test_nonfirst_list_and_record_dependencies_emit_before_parent),
	]
}
