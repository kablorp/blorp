import:
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/utils/source: compiler_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, Span
	../../../src/verify/verify: verify
	../managed_union_inputs: lowered
	test: TestSuite


private SOURCE: String =
	|fixed union Choice[A, B]:
	|	Number(Int)
	|	Text(A)
	|	Empty(B)
	|fixed record Holder { value: Choice[String, Void] }
	|pure func make() -> Holder:
	|	{ value = Number(7) }
	|pure func inspect(parent: Holder) -> String:
	|	projected = parent.value
	|	match projected:
	|		Number(number): "number"
	|		Text(text): text
	|		Empty(ignored): "empty"
	|func main() -> Int:
	|	unused = inspect(make())
	|	0
	|


private fixed union RawCase:
	Live
	DroppedNumber
	DroppedText
	DroppedVoid
	DroppedTag
	NumberCopiedBeforeDrop
	VoidCopiedBeforeDrop
	AcquireAfterDrop
	UnmanagedTag


private pure func span(at: Int) -> Span:
	{
		source = compiler_source(),
		start = at,
		end = at + 1
	}


private pure func seed_error() -> Diagnostic:
	{
		span = {
			source = compiler_source(),
			start = 0,
			end = 1
		},
		note = None,
		message = "invalid acquired-scrutinee identity seed",
		help = "fix test setup"
	}


private pure func raw_arm(
	arm: Lower.LoweredArm,
	scrutinee: Lower.ValueId,
	position: Int,
	case: RawCase,
) -> Result[Own.OwnedArm, Diagnostic]:
	at = span(20 + position * 10)
	owner = Own.owner_id(position + 2)

	drop_before = match case:
		DroppedNumber:
			position == 0
		DroppedText:
			position == 1
		DroppedVoid:
			position == 2
		_:
			False

	drop_after = match case:
		NumberCopiedBeforeDrop:
			position == 0
		VoidCopiedBeforeDrop:
			position == 2
		AcquireAfterDrop:
			position == 1
		_:
			False

	var operations: List[Own.OwnershipOperation] = []
	var returned_borrow: Option[Own.BorrowedValue] = None
	var invalid = False

	for definition in arm.body.definitions:
		match definition.operation:
			Lower.PayloadValue(variant, _):
				if drop_before:
					operations = operations.append(Own.DropOwner(Own.owner_id(1), at))

				result = match definition.value_type:
					Concrete.StringType:
						Own.BorrowedResult(Own.PayloadBorrow(scrutinee))
					_:
						Own.UnmanagedResult

				operations = operations.append(Own.DefineValue({
					id = definition.id,
					value_type = definition.value_type,
					operation = Own.PayloadDefinition(variant, scrutinee),
					result = result,
					span = at,
				}))

				if drop_after:
					operations = operations.append(Own.DropOwner(Own.owner_id(1), at))

				match definition.value_type:
					Concrete.StringType:
						returned_borrow = Some({
							value = definition.id,
							source = Own.PayloadBorrow(scrutinee),
						})
					_:
						void
			Lower.StringValue(bytes):
				operations = operations.append(Own.DefineValue({
					id = definition.id,
					value_type = Concrete.StringType,
					operation = Own.StringDefinition(bytes),
					result = Own.OwnedResult(owner),
					span = at,
				}))
			_:
				invalid = True

	if invalid:
		Err(seed_error())
	else:
		match arm.body.exit:
			Lower.ReturnValue(returned):
				match returned_borrow:
					Some(borrow):
						operations = operations.append(Own.AcquireOwner(owner, borrow, at))
					None:
						void

				if not (drop_before or drop_after):
					operations = operations.append(Own.DropOwner(Own.owner_id(1), at))

				Ok({
					label = arm.label,
					operations = operations,
					exit = Own.ReturnResult(Own.OwnedReturn(returned, owner)),
				})
			_:
				Err(seed_error())


private pure func raw_match(
	function: Lower.LoweredFunction,
	matched: Lower.LoweredMatch,
	case: RawCase,
) -> Result[Own.OwnedFunction, Diagnostic]:
	match (function.definitions, matched.arms):
		([parent, projected], [number, text, empty]):
			match projected.operation:
				Lower.ReadRecordFieldValue(field, _):
					first ?= raw_arm(number, projected.id, 0, case)
					second ?= raw_arm(text, projected.id, 1, case)
					third ?= raw_arm(empty, projected.id, 2, case)
					var prefix: List[Own.OwnershipOperation] = [
						Own.DefineValue({
							id = parent.id,
							value_type = parent.value_type,
							operation = Own.ParameterDefinition(0),
							result = Own.BorrowedResult(Own.ParameterBorrow(parent.id)),
							span = span(10),
						}),
						Own.AcquireOwner(
							Own.owner_id(0),
							{
								value = parent.id,
								source = Own.ParameterBorrow(parent.id)
							},
							span(10),
						),
						Own.DefineValue({
							id = projected.id,
							value_type = projected.value_type,
							operation = Own.ReadRecordFieldDefinition(
								field,
								Own.BorrowedArgument({
									value = parent.id,
									source = Own.OwnerBorrow(Own.owner_id(0)),
								}),
							),
							result = Own.BorrowedResult(Own.PayloadBorrow(parent.id)),
							span = span(11),
						}),
						Own.AcquireOwner(
							Own.owner_id(1),
							{
								value = projected.id,
								source = Own.PayloadBorrow(parent.id)
							},
							span(11),
						),
						Own.DropOwner(
							Own.owner_id(0),
							span(11),
						),
					]

					match case:
						DroppedTag:
							prefix = prefix.append(Own.DropOwner(Own.owner_id(1), span(11)))
						_:
							void

					argument = match case:
						UnmanagedTag:
							Own.UnmanagedArgument(projected.id)
						_:
							Own.BorrowedArgument({
								value = projected.id,
								source = Own.OwnerBorrow(Own.owner_id(1)),
							})

					Ok({
						execution = function.execution,
						signature = function.signature,
						operations = prefix,
						tail = Own.MatchTail({
							scrutinee = argument,
							owner = matched.owner,
							arms = [first, second, third],
						}),
					})
				_:
					Err(seed_error())
		_:
			Err(seed_error())


private pure func raw_function(
	function: Lower.LoweredFunction,
	seed: Lower.LoweredFunctions,
	case: RawCase,
) -> Result[Own.OwnedFunction, Diagnostic]:
	match function.tail:
		Lower.MatchValue(matched):
			raw_match(function, matched, case)
		_:
			Own.insert_function(function, seed.unions, seed.records)


-- Prefix o0 is deliberately retired before the match. The only permitted
-- backing for every payload read and escaped String is the acquired o1.
private pure func raw_program(case: RawCase) -> Result[Own.OwnershipProgram, Diagnostic]:
	lowered ?= lowered(SOURCE)
	seed = Lower.lowered_functions(lowered)
	var functions: List[Own.OwnedFunction] = []
	var invalid: Option[Diagnostic] = None

	for function in seed.functions:
		match raw_function(function, seed, case):
			Ok(function):
				functions = functions.append(function)
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok({
				records = seed.records,
				unions = seed.unions,
				functions = functions,
				entrypoint = seed.entrypoint,
			})


private pure func rejects(case: RawCase, message: String, at: Int) -> Bool:
	match raw_program(case):
		Err(_):
			False
		Ok(program):
			match verify(program):
				Ok(_):
					False
				Err(error):
					(
						error.message == "ownership verification failed: " + message
						and error.help == "report this compiler error with the input program"
						and error.span.start == at
						and error.span.end == at + 1
					)


pure func test_acquired_scrutinee_survives_retired_ancestor() -> Bool:
	raw_program(Live)
		.and_then(pure func(program): verify(program))
		.is_ok()


pure func test_int_payload_checks_actual_scrutinee_lifetime() -> Bool:
	rejects(DroppedNumber, "borrow refers to discharged owner 1", 20)


pure func test_string_payload_checks_actual_scrutinee_lifetime() -> Bool:
	rejects(DroppedText, "borrow refers to discharged owner 1", 30)


pure func test_void_payload_checks_actual_scrutinee_lifetime() -> Bool:
	rejects(DroppedVoid, "borrow refers to discharged owner 1", 40)


pure func test_tag_read_checks_actual_scrutinee_lifetime() -> Bool:
	rejects(DroppedTag, "borrow refers to discharged owner 1", 11)


pure func test_managed_scrutinee_requires_explicit_borrow() -> Bool:
	rejects(UnmanagedTag, "managed match scrutinee requires an owner-dependent borrow", 11)


pure func test_copied_int_payload_survives_scrutinee_drop() -> Bool:
	raw_program(NumberCopiedBeforeDrop)
		.and_then(pure func(program): verify(program))
		.is_ok()


pure func test_copied_void_payload_survives_scrutinee_drop() -> Bool:
	raw_program(VoidCopiedBeforeDrop)
		.and_then(pure func(program): verify(program))
		.is_ok()


pure func test_returned_child_must_acquire_before_scrutinee_drop() -> Bool:
	rejects(AcquireAfterDrop, "borrow refers to discharged owner 1", 30)


tests: TestSuite = {
	description = "acquired match scrutinee verification",
	tests = [
		("copied Int survives scrutinee drop", test_copied_int_payload_survives_scrutinee_drop),
		("copied Void survives scrutinee drop", test_copied_void_payload_survives_scrutinee_drop),
		(
			"child acquire requires actual live scrutinee",
			test_returned_child_must_acquire_before_scrutinee_drop,
		),
		(
			"acquired scrutinee survives retired ancestor",
			test_acquired_scrutinee_survives_retired_ancestor,
		),
		(
			"Int payload validates actual scrutinee",
			test_int_payload_checks_actual_scrutinee_lifetime,
		),
		(
			"String payload validates actual scrutinee",
			test_string_payload_checks_actual_scrutinee_lifetime,
		),
		(
			"Void payload validates actual scrutinee",
			test_void_payload_checks_actual_scrutinee_lifetime,
		),
		("tag read validates actual scrutinee", test_tag_read_checks_actual_scrutinee_lifetime),
		(
			"managed scrutinee requires explicit borrow",
			test_managed_scrutinee_requires_explicit_borrow,
		),
	]
}
