import:
	../ownership_inputs: borrowed_rows
	../../../src/check/model as Model
	./selection_inputs as Selection
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/utils/source: compiler_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, Span
	../../../src/verify/verify: verify
	../managed_union_inputs: lowered, lowered_tail_join
	../ownership_inputs: InputIds, input_ids
	test: TestSuite


private SOURCE: String =
	|union Choice[A, B]:
	|	Number(Int)
	|	Text(A)
	|	Empty(B)
	|record Holder { value: Choice[String, Void] }
	|pure func make() -> Holder:
	|	{ value = Number(7) }
	|pure func inspect(parent: Holder) -> String:
	|	projected = parent.value
	|	match projected:
	|		Number(number): "number"
	|		Text(text): text
	|		Empty(ignored): "empty"
	|func main() -> Int:
	|	unused = inspect(make())
	|	0
	|


private union RawCase:
	Live
	DroppedNumber
	DroppedText
	DroppedVoid
	DroppedTag
	NumberCopiedBeforeDrop
	VoidCopiedBeforeDrop
	AcquireAfterDrop
	UnmanagedTag


private pure func span(at: Int) -> Span:
	{
		source = compiler_source(),
		start = at,
		end = at + 1
	}


private pure func seed_error() -> Diagnostic:
	{
		span = {
			source = compiler_source(),
			start = 0,
			end = 1
		},
		note = None,
		message = "invalid acquired-scrutinee identity seed",
		help = "fix test setup"
	}


private pure func raw_arm(
	arm: Lower.JoinArm,
	position: Int,
	case: RawCase,
) -> Result[Own.OwnedLoopArm, Diagnostic]:
	at = span(20 + position * 10)
	owner = Own.owner_id(position * 2 + 4)
	acquired = Own.owner_id(position * 2 + 5)
	var inputs: List[Own.OwnedJoinParameter] = []
	for input in arm.inputs:
		classified = match input.value_type:
			Concrete.StringType: Own.ManagedJoinParameter(input, owner)
			_: Own.UnmanagedJoinParameter(input)
		inputs = inputs.append(classified)
	var operations: List[Own.OwnershipOperation] = [Own.DropOwner(Own.owner_id(2), at)]
	var invalid = False
	for step in arm.steps:
		match step:
			Lower.Define(definition):
				match definition.operation:
					Lower.StringValue(bytes):
						operations = operations.append(Own.DefineValue({
							id = definition.id, value_type = Concrete.StringType,
							operation = Own.StringDefinition(bytes), result = Own.OwnedResult(owner), span = at
						}))
					_: invalid = True
			_: invalid = True
	if invalid:
		Err(seed_error())
	else:
		match arm.exit:
			Lower.TransferLoop(_, _): Err(seed_error())
			Lower.Yield(outputs):
				operations = operations.concat([
					Own.AcquireOwner(acquired, { value = outputs.value, source = Own.OwnerBorrow(owner) }, at),
					Own.DropOwner(owner, at),
				])
				Ok({ id = arm.id, inputs = inputs, body = {
					operations = operations,
					tail = Own.ExitLoop(Own.Break({ value = Own.OwnedReturn(outputs.value, acquired), carried = [], span = at }))
				} })


private pure func raw_selection(
	selection: Lower.LoweredSelection,
	argument: Own.OwnedArgument,
	root: Lower.ValueId,
	case: RawCase,
) -> Result[Own.OwnedSelection, Diagnostic]:
	var nodes: List[Own.OwnedDecisionNode] = []
	var invalid: Option[Diagnostic] = None
	for node in selection.nodes:
		match node:
			Lower.TestVariant(place, variant, yes, no): nodes = nodes.append(Own.TestVariant(place, variant, yes, no))
			Lower.TestListLength(_, _, _, _) | Lower.TestStringBytes(_, _, _, _): invalid = Some(seed_error())
			Lower.EnterArm(edge):
				position = Model.match_arm_number(edge.arm)
				at = span(20 + position * 10)
				drop_before = match case:
					DroppedNumber: position == 0
					DroppedText: position == 1
					DroppedVoid: position == 2
					_: False
				var operations: List[Own.OwnershipOperation] = []
				if drop_before:
					operations = operations.append(Own.DropOwner(Own.owner_id(2), at))
				for definition in edge.definitions:
					match definition:
						Lower.BorrowUnionField(value, field, _):
							result = match value.value_type:
								Concrete.StringType: Own.BorrowedResult(Own.PayloadBorrow(root))
								_: Own.UnmanagedResult
							operations = operations.append(Own.DefineValue({ id = value.id, value_type = value.value_type, operation = Own.PayloadDefinition(field, root), result = result, span = at }))
							match value.value_type:
								Concrete.StringType:
									match case:
										AcquireAfterDrop: operations = operations.append(Own.DropOwner(Own.owner_id(2), at))
										_: void
									operations = operations.append(Own.AcquireOwner(Own.owner_id(3), { value = value.id, source = Own.PayloadBorrow(root) }, at))
								_: void
						Lower.BorrowRecordField(_, _, _) | Lower.BorrowListElement(_, _, _) | Lower.CopyListSuffix(_, _, _): invalid = Some(seed_error())
				transfers = edge.arguments.map(pure func(value):
					if position == 1:
						Own.OwnedReturn(value, Own.owner_id(3))
					else:
						Own.UnmanagedReturn(value)
				)
				nodes = nodes.append(Own.EnterArm({ arm = edge.arm, operations = operations, transfers = transfers }))
	match invalid:
		Some(error): Err(error)
		None: Ok({ scrutinee = argument, entry = selection.entry, nodes = nodes })


private pure func raw_match(
	function: Lower.LoweredFunction,
	seed: Lower.LoweredFunctions,
	matched: Lower.LoweredJoin,
	values: InputIds,
	case: RawCase,
) -> Result[Own.OwnedFunction, Diagnostic]:
	match (function.steps, matched.arms):
		([Lower.Define(parent), Lower.Define(projected), Lower.Join(_)], [number, text, empty]):
			match projected.operation:
				Lower.ReadRecordFieldValue(field, _):
					first ?= raw_arm(number, 0, case)
					second ?= raw_arm(text, 1, case)
					third ?= raw_arm(empty, 2, case)
					var prefix: List[Own.OwnershipOperation] = [
						Own.AcquireOwner(
							Own.owner_id(1),
							{
								value = values.first,
								source = Own.ParameterBorrow(values.first)
							},
							span(10),
						),
						Own.DefineValue({
							id = values.third,
							value_type = projected.value_type,
							operation = Own.ReadRecordFieldDefinition(
								field,
								Own.BorrowedArgument({
									value = values.first,
									source = Own.OwnerBorrow(Own.owner_id(1)),
								}),
							),
							result = Own.BorrowedResult(Own.PayloadBorrow(values.first)),
							span = span(11),
						}),
						Own.AcquireOwner(
							Own.owner_id(2),
							{
								value = values.third,
								source = Own.PayloadBorrow(values.first)
							},
							span(11),
						),
						Own.DropOwner(
							Own.owner_id(1),
							span(11),
						),
					]

					match case:
						DroppedTag:
							prefix = prefix.append(Own.DropOwner(Own.owner_id(2), span(11)))
						_:
							void

					argument = match case:
						UnmanagedTag:
							Own.UnmanagedArgument(values.third)
						_:
							Own.BorrowedArgument({
								value = values.third,
								source = Own.OwnerBorrow(Own.owner_id(2)),
							})

					selection ?= raw_selection(matched.selection, argument, values.third, case)
					Ok({
						parameters = borrowed_rows(function.signature.parameters, seed.unions, seed.records), return_type = function.signature.return_type,
						operations = [Own.DefineValue({
								id = values.first,
								value_type = parent.value_type,
								operation = Own.ParameterDefinition(0),
								result = Own.BorrowedResult(Own.ParameterBorrow(values.first)),
								span = span(10),
							}), Own.ExecuteLoop({
								entry_acquisitions = [],
								headers = [],
								result = Own.ManagedJoinParameter({ id = values.second, value_type = Concrete.StringType, span = span(50) }, Own.owner_id(0)),
								carried = [],
								body = {
									operations = prefix,
									tail = Own.MatchLoop({
										selection = selection,
										arms = [first, second, third],
									}),
								},
							})],
						result = Own.OwnedReturn(values.second, Own.owner_id(0)),
					})
				_:
					Err(seed_error())
		_:
			Err(seed_error())


private pure func raw_function(
	function: Lower.LoweredFunction,
	seed: Lower.LoweredFunctions,
	values: InputIds,
	case: RawCase,
) -> Result[Own.OwnedFunction, Diagnostic]:
	match lowered_tail_join(function):
		Some(matched):
			raw_match(function, seed, matched, values, case)
		_:
			Own.insert_function(function, seed.unions, seed.records)


-- Loop-local o1 is retired before the match. The acquired o2 is the
-- backing for every payload read and escaped String; P owns o0 outside.
private pure func raw_program(case: RawCase) -> Result[Own.OwnershipProgram, Diagnostic]:
	ids ?= input_ids()
	lowered ?= lowered(SOURCE)
	seed = Lower.lowered_functions(lowered)
	var functions: List[Own.OwnedFunction] = []
	var invalid: Option[Diagnostic] = None

	for function in seed.functions:
		match raw_function(function, seed, ids, case):
			Ok(function):
				functions = functions.append(function)
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok({
				records = seed.records,
				unions = seed.unions,
				functions = functions,
				entrypoint = seed.entrypoint,
			})


private pure func rejects(case: RawCase, message: String, at: Int) -> Bool:
	match raw_program(case):
		Err(_):
			False
		Ok(program):
			match verify(program):
				Ok(_):
					False
				Err(error):
					(
						error.message == "ownership verification failed: " + message
						and error.help == "report this compiler error with the input program"
						and error.span.start == at
						and error.span.end == at + 1
					)


pure func test_acquired_scrutinee_survives_retired_ancestor() -> Bool:
	raw_program(Live)
		.and_then(pure func(program): verify(program))
		.is_ok()


pure func test_int_payload_checks_actual_scrutinee_lifetime() -> Bool:
	rejects(DroppedNumber, "selection edge contains an operation outside its local projections", 11)


pure func test_string_payload_checks_actual_scrutinee_lifetime() -> Bool:
	rejects(DroppedText, "selection edge contains an operation outside its local projections", 11)


pure func test_void_payload_checks_actual_scrutinee_lifetime() -> Bool:
	rejects(DroppedVoid, "selection edge contains an operation outside its local projections", 11)


pure func test_tag_read_checks_actual_scrutinee_lifetime() -> Bool:
	rejects(DroppedTag, "borrow refers to discharged owner 2", 11)


pure func test_managed_scrutinee_requires_explicit_borrow() -> Bool:
	rejects(UnmanagedTag, "managed match scrutinee requires an owner-dependent borrow", 11)


pure func test_copied_int_payload_survives_scrutinee_drop() -> Bool:
	raw_program(NumberCopiedBeforeDrop)
		.and_then(pure func(program): verify(program))
		.is_ok()


pure func test_copied_void_payload_survives_scrutinee_drop() -> Bool:
	raw_program(VoidCopiedBeforeDrop)
		.and_then(pure func(program): verify(program))
		.is_ok()


pure func test_returned_child_must_acquire_before_scrutinee_drop() -> Bool:
	rejects(AcquireAfterDrop, "selection edge contains an operation outside its local projections", 11)


tests: TestSuite = {
	description = "acquired match scrutinee verification",
	tests = [
		("copied Int survives scrutinee drop", test_copied_int_payload_survives_scrutinee_drop),
		("copied Void survives scrutinee drop", test_copied_void_payload_survives_scrutinee_drop),
		(
			"child acquire requires actual live scrutinee",
			test_returned_child_must_acquire_before_scrutinee_drop,
		),
		(
			"acquired scrutinee survives retired ancestor",
			test_acquired_scrutinee_survives_retired_ancestor,
		),
		(
			"Int payload validates actual scrutinee",
			test_int_payload_checks_actual_scrutinee_lifetime,
		),
		(
			"String payload validates actual scrutinee",
			test_string_payload_checks_actual_scrutinee_lifetime,
		),
		(
			"Void payload validates actual scrutinee",
			test_void_payload_checks_actual_scrutinee_lifetime,
		),
		("tag read validates actual scrutinee", test_tag_read_checks_actual_scrutinee_lifetime),
		(
			"managed scrutinee requires explicit borrow",
			test_managed_scrutinee_requires_explicit_borrow,
		),
	]
}
