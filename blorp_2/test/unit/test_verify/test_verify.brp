pure func test_rejects_acquiring_from_a_sibling_arm_owner() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[
								first,
								{ second | body = { second.body | operations = second.body.operations.append(
										AcquireOwner(
											owner_id(5),
											{
												value = ids.fifth,
												source = OwnerBorrow(owner_id(1))
											},
											span(45),
										),
									) } },
							],
						),
						"owner 1 is not available in this match arm",
						45,
					)
				_:
					False


pure func test_rejects_a_dropped_owner_in_the_second_arm() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[
								first,
								{ second | body = { second.body | operations = second.body.operations.append(
										DropOwner(
											owner_id(4),
											span(45),
										),
									) } },
							],
						),
						"loop transfer refers to a discharged owner",
						40,
					)
				_:
					False


pure func test_reports_the_absolute_leaked_owner_in_the_second_arm() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[
								first,
								{ second | body = { second.body | operations = second.body.operations.append(
										AcquireOwner(
											owner_id(5),
											{
												value = ids.fifth,
												source = OwnerBorrow(owner_id(4))
											},
											span(45),
										),
									) } },
							],
						),
						"owner 5 remains live at yield",
						40,
					)
				_:
					False


pure func test_accepts_acquisition_and_transfer_in_the_second_arm() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					match (
						verify(
							managed_match_program(
								ids,
								[
									first,
									{ second | body = { second.body | operations = second.body.operations.concat([
											AcquireOwner(
												owner_id(5),
												{
													value = ids.fifth,
													source = OwnerBorrow(owner_id(4))
												},
												span(45),
											),
											DropOwner(owner_id(4), span(46)),
										]), tail = Own.ExitLoop(Break({ value = OwnedReturn(ids.fifth, owner_id(5)), carried = [], span = span(40) })) } },
								],
							),
						)
					):
						Ok(_):
							True
						Err(_):
							False
				_:
					False


pure func test_accepts_different_value_and_owner_counts_between_arms() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					match (
						verify(
							managed_match_program(
								ids,
								[
									{ first | body = { first.body | operations = [arm_string(ids.fourth, ids.second, 1, 30),
											arm_string(ids.fifth, ids.second, 2, 35),
											AcquireOwner(owner_id(3), { value = ids.fifth, source = OwnerBorrow(owner_id(2)) }, span(35)),
											DropOwner(owner_id(2), span(36)),
											DropOwner(owner_id(1), span(36)),
										], tail = Own.ExitLoop(Break({ value = OwnedReturn(ids.fifth, owner_id(3)), carried = [], span = span(40) })) } },
									{ second | body = { second.body | operations = [arm_string(ids.sixth, ids.second, 4, 40), AcquireOwner(owner_id(5), { value = ids.sixth, source = OwnerBorrow(owner_id(4)) }, span(40)), DropOwner(owner_id(4), span(40))], tail = Own.ExitLoop(Break({ value = OwnedReturn(ids.sixth, owner_id(5)), carried = [], span = span(50) })) } },
								],
							),
						)
					):
						Ok(_):
							True
						Err(_):
							False
				_:
					False


pure func test_verifier_rejects_missing_acquisition_in_insertion_output() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			borrowed = function([parameter(ids.first, StringType)], ids.first, [StringType], StringType)
			match insert_function(borrowed, [], []):
				Err(_): False
				Ok(inserted):
					match inserted.operations:
						[definition, AcquireOwner(_, _, _)]:
							main: OwnedFunction = {
								parameters = [], return_type = IntType,
								operations = [integer(ids.first, 0, 50)],
								result = UnmanagedReturn(ids.first)
							}
							input: OwnershipProgram = {
								records = [],
								unions = [],
								functions = [main, inserted],
								entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus)
							}
							-- Keep insertion's exact owner transfer but omit its acquisition.
							-- The verifier must reject actual operations independently of policy.
							verify(input).is_ok() and rejects(
								{ input | functions = [main, { inserted | operations = [definition] }] },
								"owner 0 is not defined",
								10,
							)
						_: False


pure func test_named_managed_callback_product_verifies() -> Bool:
	lowered(NAMED_CALLBACK_SOURCE).and_then(Own.own).and_then(verify).is_ok()


pure func test_named_callback_verifier_requires_the_return_acquisition() -> Bool:
	callback_verifier_requires_the_return_acquisition(NAMED_CALLBACK_SOURCE)


private pure func callback_verifier_requires_the_return_acquisition(source: String) -> Bool:
	match lowered(source).and_then(Own.own):
		Err(_): False
		Ok(program):
			match program.functions:
				[main, identity, apply]:
					match (main.operations, apply.operations, identity.operations):
						([_, Own.DefineValue(main_call), ..._], [_, Own.DefineValue(callback)], [definition, Own.AcquireOwner(owner, _, _) ]):
							selected = match (main_call.operation, callback.operation):
								(Own.CallDefinition(main_target, [_]), Own.CallDefinition(callback_target, [_])):
									match (main_target, callback_target):
										(UserFunction(apply_id), UserFunction(identity_id)): function_number(apply_id) == 2 and function_number(identity_id) == 1
										_: False
								_: False
							match (definition, identity.result):
								(Own.DefineValue(parameter), Own.OwnedReturn(_, returned)):
									-- Preserve issued IDs/transfer/spans; remove only the selected target's acquisition.
									corrupt = { program | functions = [main, { identity | operations = [definition] }, apply] }
									match verify(corrupt):
										Err(error):
											(
												selected and Own.owner_number(owner) == 0 and Own.owner_number(returned) == 0
												and error.message == "ownership verification failed: owner 0 is not defined"
												and error.help == "report this compiler error with the input program"
												and same_span(error.span, parameter.span) and error.note.is_none()
												and verify(program).is_ok()
											)
										Ok(_): False
								_: False
						_: False
				_: False


pure func test_lambda_managed_callback_product_verifies() -> Bool:
	lowered(NONCAPTURING_CALLBACK_SOURCE).and_then(Own.own).and_then(verify).is_ok()


pure func test_lambda_callback_verifier_requires_the_return_acquisition() -> Bool:
	callback_verifier_requires_the_return_acquisition(NONCAPTURING_CALLBACK_SOURCE)


