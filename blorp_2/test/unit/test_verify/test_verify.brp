pure func test_rejects_borrow_from_another_values_owner() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			other = DefineValue({
				id = ids.third,
				value_type = StringType,
				operation = CallDefinition(
					RuntimeFunction(Builtins.IntToString),
					[UnmanagedArgument(ids.first)],
				),
				result = OwnedResult(owner_id(1)),
				span = span(25),
			})
			wrong_borrow = DefineValue({
				id = ids.fourth,
				value_type = IntType,
				operation = CallDefinition(
					RuntimeFunction(Builtins.StringLength),
					[BorrowedArgument({
							value = ids.third,
							source = OwnerBorrow(owner_id(0)),
						})],
				),
				result = UnmanagedResult,
				span = span(30),
			})
			rejects(
				program(
					ids,
					[integer(ids.first, 7, 10), string(ids), other, wrong_borrow],
				),
				"owner 0 does not own value 2",
				30,
			)


