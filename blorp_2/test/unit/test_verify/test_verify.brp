pure func test_rejects_payload_for_a_nullary_variant() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				ConstructValue(variant, []):
					bad = DefineValue({
						id = ids.second,
						value_type = UnionType(ids.union_id),
						operation = ConstructDefinition(variant, [UnmanagedPayload(ids.first)]),
						result = UnmanagedResult,
						span = span(20),
					})
					input = program(
						ids,
						[integer(ids.first, 7, 10), bad],
					)
					rejects(
						{ input | unions = ids.unions },
						"variant field count does not match its operation",
						20,
					)
				_:
					False


pure func test_sibling_arm_values_are_not_visible() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			callee: OwnedFunction = {
				parameters = [Own.UnmanagedParameter(IntType)], return_type = IntType,
				operations = [DefineValue({
						id = ids.first,
						value_type = IntType,
						operation = ParameterDefinition(0),
						result = UnmanagedResult,
						span = span(10),
					})],
				result = UnmanagedReturn(ids.first)
			}

			match ids.union_value.operation:
				ConstructValue(variant, []):
					main: OwnedFunction = {
						parameters = [], return_type = IntType,
						operations = [DefineValue({
								id = ids.first,
								value_type = UnionType(ids.union_id),
								operation = ConstructDefinition(variant, []),
								result = UnmanagedResult,
								span = span(10),
							})].append(ExecuteLoop({
							entry_acquisitions = [],
							headers = [],
							result = UnmanagedJoinParameter({ id = ids.second, value_type = IntType, span = span(90) }),
							carried = [],
							body = {
								operations = [],
								tail = MatchLoop({
									selection = Selection.branches(UnmanagedArgument(ids.first), variant),
									arms = [
										{ id = Model.match_arm_id(0), inputs = [], body = { operations = [integer(ids.third, 7, 20)], tail = Own.ExitLoop(Break({ value = UnmanagedReturn(ids.third), carried = [], span = span(20) })) } },
										{ id = Model.match_arm_id(1), inputs = [], body = { operations = [
												DefineValue({
													id = ids.fourth,
													value_type = IntType,
													operation = CallDefinition(
														UserFunction(ids.entrypoint),
														[UnmanagedArgument(ids.third)],
													),
													result = UnmanagedResult,
													span = span(30),
												}),
											], tail = Own.ExitLoop(Break({ value = UnmanagedReturn(ids.fourth), carried = [], span = span(30) })) } },
									],

								}),
							},
						})),
						result = UnmanagedReturn(ids.second)
					}
					rejects(
						{
							records = [],
							unions = ids.unions,
							entrypoint = NoArguments(ids.second_function, IntegerExitStatus),
							functions = [callee, main]
						},
						"value 2 is not defined before use",
						30,
					)
				_:
					False


pure func test_discharged_managed_prefix_allows_unmanaged_match() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				ConstructValue(variant, []):
					main: OwnedFunction = {
						parameters = [], return_type = IntType,
						operations = [
							integer(ids.first, 7, 10),
							string(ids),
							length(ids, 0),
							DropOwner(owner_id(0), span(35)),
							DefineValue({
								id = ids.fourth,
								value_type = UnionType(ids.union_id),
								operation = ConstructDefinition(variant, []),
								result = UnmanagedResult,
								span = span(40),
							}),
						].append(ExecuteLoop({
							entry_acquisitions = [],
							headers = [],
							result = UnmanagedJoinParameter({ id = ids.fifth, value_type = IntType, span = span(90) }),
							carried = [],
							body = {
								operations = [],
								tail = MatchLoop({
									selection = Selection.direct(UnmanagedArgument(ids.fourth)),
									arms = [
										{ id = Model.match_arm_id(0), inputs = [], body = { operations = [integer(ids.sixth, 0, 50)], tail = Own.ExitLoop(Break({ value = UnmanagedReturn(ids.sixth), carried = [], span = span(50) })) } },
									],

								}),
							},
						})),
						result = UnmanagedReturn(ids.fifth)
					}
					verify({
						records = [],
						unions = ids.unions,
						entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
						functions = [main],
					}).is_ok()
				_:
					False


pure func test_match_test_requires_its_variant_declaration() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				ConstructValue(variant, []):
					main: OwnedFunction = {
						parameters = [], return_type = IntType,
						operations = [DefineValue({
								id = ids.first,
								value_type = UnionType(ids.union_id),
								operation = ConstructDefinition(variant, []),
								result = UnmanagedResult,
								span = span(10),
							})].append(ExecuteLoop({
							entry_acquisitions = [],
							headers = [],
							result = UnmanagedJoinParameter({ id = ids.second, value_type = IntType, span = span(90) }),
							carried = [],
							body = {
								operations = [],
								tail = MatchLoop({
									selection = Selection.branches(UnmanagedArgument(ids.first), ids.second_variant),
									arms = [
										{ id = Model.match_arm_id(0), inputs = [], body = { operations = [integer(ids.third, 0, 20)], tail = Own.ExitLoop(Break({ value = UnmanagedReturn(ids.third), carried = [], span = span(20) })) } },
									],

								}),
							},
						})),
						result = UnmanagedReturn(ids.second)
					}
					rejects(
						{
							records = [],
							unions = [
								PlainCases([[]]),
							],
							entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
							functions = [main]
						},
						"unknown variant identity",
						10,
					)
				_:
					False


