				result = OwnedReturn(ids.second, owner_id(1))
			}
			rejects(
				{
					records = [],
					unions = [],
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [entry, helper]
				},
				"returned owner does not own the returned value",
