private pure func arm_string(
	value: ValueId,
	argument: ValueId,
	owner: Int,
	at: Int,
) -> OwnershipOperation:
	DefineValue({
		id = value,
		value_type = StringType,
		operation = CallDefinition(
			RuntimeFunction(Builtins.IntToString),
			[UnmanagedArgument(argument)],
		),
		result = OwnedResult(owner_id(owner)),
		span = span(at),
	})


private pure func managed_match_program(ids: InputIds, arms: List[OwnedLoopArm]) -> OwnershipProgram:
	{
		records = [],
		unions = ids.unions,
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
		functions = [
			{
				parameters = [], return_type = IntType,
				operations = [integer(ids.first, 0, 1)],
				result = UnmanagedReturn(ids.first)
			},
			{
				parameters = [], return_type = StringType,
				operations = [DefineValue({
						id = ids.first,
						value_type = UnionType(ids.union_id),
						operation = ConstructDefinition(ids.second_variant, []),
						result = UnmanagedResult,
						span = span(10),
					}), integer(ids.second, 7, 20)].append(ExecuteLoop({
					entry_acquisitions = [],
					headers = [],
					result = ManagedJoinParameter({ id = ids.third, value_type = StringType, span = span(90) }, owner_id(0)),
					carried = [],
					body = {
						operations = [],
						tail = MatchLoop({
							selection = Selection.branches(UnmanagedArgument(ids.first), ids.second_variant),
							arms = arms,

						}),
					},
				})),
				result = OwnedReturn(ids.third, owner_id(0))
			},
		]
	}


private pure func managed_arms(ids: InputIds) -> List[OwnedLoopArm]:
	[
		{ id = Model.match_arm_id(0), inputs = [], body = { operations = [arm_string(ids.fourth, ids.second, 1, 30), AcquireOwner(owner_id(2), { value = ids.fourth, source = OwnerBorrow(owner_id(1)) }, span(30)), DropOwner(owner_id(1), span(30))], tail = Own.ExitLoop(Break({ value = OwnedReturn(ids.fourth, owner_id(2)), carried = [], span = span(30) })) } },
		{ id = Model.match_arm_id(1), inputs = [], body = { operations = [arm_string(ids.fifth, ids.second, 3, 40), AcquireOwner(owner_id(4), { value = ids.fifth, source = OwnerBorrow(owner_id(3)) }, span(40)), DropOwner(owner_id(3), span(40))], tail = Own.ExitLoop(Break({ value = OwnedReturn(ids.fifth, owner_id(4)), carried = [], span = span(40) })) } },
	]


-- Each raw managed Loop edge acquires its outgoing occurrence before retiring
-- the original local; sibling owner ordinals include that complete edge batch.
pure func test_accepts_independent_managed_arm_transfers() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match verify(managed_match_program(ids, managed_arms(ids))):
				Ok(_):
					True
				Err(_):
					False


pure func test_rejects_a_missing_managed_arm_transfer() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match managed_arms(ids):
				[first, second]:
					rejects(
						managed_match_program(
							ids,
							[{ first | body = { first.body | tail = Own.ExitLoop(Break({ value = UnmanagedReturn(ids.fourth), carried = [], span = span(30) })) } }, second],
						),
						"managed yield requires an owner transfer",
						30,
					)
				_:
					False


