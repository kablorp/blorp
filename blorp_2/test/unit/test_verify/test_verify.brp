							], tail = Own.ExitLoop(Break({ value = OwnedReturn(ids.fifth, owner_id(3)), carried = [], span = span(40) })) } },
						{ id = Model.match_arm_id(1), inputs = [], body = { operations = [arm_string(ids.sixth, ids.second, 4, 50), AcquireOwner(owner_id(5), { value = ids.sixth, source = OwnerBorrow(owner_id(4)) }, span(50)), DropOwner(owner_id(4), span(50))], tail = Own.ExitLoop(Break({ value = OwnedReturn(ids.sixth, owner_id(5)), carried = [], span = span(50) })) } },
					],
				),
				"owner 1 remains live at yield",
				40,
			)


