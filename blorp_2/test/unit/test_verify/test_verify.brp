			)


pure func test_rejects_an_empty_managed_match() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match ids.union_value.operation:
				ConstructValue(variant, []):
					entry: OwnedFunction = {
						parameters = [], return_type = IntType,
						operations = [integer(ids.first, 0, 1)],
						result = UnmanagedReturn(ids.first)
					}
					helper: OwnedFunction = {
						parameters = [], return_type = StringType,
						operations = [DefineValue({
								id = ids.first,
								value_type = UnionType(ids.union_id),
								operation = ConstructDefinition(variant, []),
								result = UnmanagedResult,
								span = span(10),
							})].append(ExecuteLoop({
							entry_acquisitions = [],
							headers = [],
							result = ManagedJoinParameter({ id = ids.second, value_type = StringType, span = span(90) }, owner_id(0)),
							carried = [],
							body = {
								operations = [],
								tail = MatchLoop({
									selection = { scrutinee = UnmanagedArgument(ids.first), nodes = [], entry = Model.decision_node_id(0) },
									arms = [],

								}),
							},
						})),
						result = OwnedReturn(ids.second, owner_id(0))
