pure func test_borrowed_parameter_return_requires_an_acquisition() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			borrowed: OwnedFunction = {
				parameters = [Own.ManagedParameter({ value_type = StringType, owned = False })], return_type = StringType,
				operations = [DefineValue({
						id = ids.first,
						value_type = StringType,
						operation = ParameterDefinition(0),
						result = BorrowedResult(ParameterBorrow(ids.first)),
						span = span(10),
					})],
				result = UnmanagedReturn(ids.first)
			}
			rejects(
				{
					records = [],
					unions = [],
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
					functions = [borrowed]
				},
				"managed return requires an owner transfer",
				10,
			)


