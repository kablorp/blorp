private pure func rejects_arm_drop(
	id: Int,
	arm_index: Int,
	before_definition: Bool,
	message: String,
) -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			arms = managed_arms(ids)

			match arms.get(arm_index):
				None:
					False
				Some(arm):
					drop = DropOwner(owner_id(id), span(45))

					operations = if before_definition:
						[drop].concat(arm.body.operations)
					else:
						arm.body.operations.append(drop)

					rejects(
						managed_match_program(
							ids,
							arms.set(arm_index, { arm | body = { arm.body | operations = operations } }),
						),
						message,
						45,
					)


pure func test_rejects_negative_owner_lookup_before_the_first_arm_definition() -> Bool:
	rejects_arm_drop(-1, 0, True, "owner -1 is not defined")


pure func test_rejects_negative_owner_lookup_before_the_second_arm_definition() -> Bool:
	rejects_arm_drop(-1, 1, True, "owner -1 is not defined")


pure func test_rejects_future_owner_lookup_before_the_first_arm_definition() -> Bool:
	rejects_arm_drop(2, 0, True, "owner 2 is not defined")


pure func test_rejects_missing_owner_lookup_before_the_second_arm_definition() -> Bool:
	rejects_arm_drop(3, 1, True, "owner 3 is not defined")


pure func test_rejects_future_owner_lookup_after_the_second_arm_definition() -> Bool:
	rejects_arm_drop(5, 1, False, "owner 5 is not defined")


