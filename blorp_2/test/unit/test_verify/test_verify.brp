		Err(_): False
		Ok(ids): verify(match_program(ids, Selection.direct(UnmanagedArgument(ids.first)), [Model.match_arm_id(0)])).is_ok()


pure func test_rejects_a_non_dense_terminal_arm_identity() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			selection: Own.OwnedSelection = { scrutinee = UnmanagedArgument(ids.first), nodes = [Own.EnterArm({ arm = Model.match_arm_id(9), operations = [], transfers = [] })], entry = Model.decision_node_id(0) }
			rejects(match_program(ids, selection, [Model.match_arm_id(9)]), "selection arm identity is not its source ordinal", 10)


pure func test_accepts_exact_borrow_and_cleanup() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match (
				verify(
					program(
						ids,
						[
							integer(ids.first, 7, 10),
							string(ids),
							length(ids, 0),
							DropOwner(owner_id(0), span(40)),
						],
					),
				)
			):
				Ok(_):
					True
				Err(_):
					False


