import:
	../../../src/check/model as Model
	./selection_inputs as Selection
	../../../src/lower/lower: ValueId, ValueOperation(ConstructValue)
	../../../src/own/own as Own:
		BorrowSource(ParameterBorrow, OwnerBorrow),
		OwnedArgument(UnmanagedArgument, BorrowedArgument),
		OwnedLoopArm,
		OwnedFunction,
		OwnedLoopTail(MatchLoop),
		OwnedLoopExit(Break),
		OwnedJoinParameter(UnmanagedJoinParameter, ManagedJoinParameter),
		OwnedValueOperation(
			ParameterDefinition, IntegerDefinition, CallDefinition,
			ConstructDefinition,
		),
		OwnershipOperation(DefineValue, ExecuteLoop, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, BorrowedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		StoredPayload(UnmanagedPayload),
		insert_function,
		owner_id,
	../../../src/namespace/builtins as Builtins: RuntimeOperation(IntToString, StringLength)
	../../../src/specialize/specialize:
		CallTarget(RuntimeFunction, UserFunction),
		TypeRef(IntType, StringType, UnionType),
		function_number,
		ConcreteUnion(PlainCases),
		specialize,
	../../../src/utils/syntax: same_span, Entrypoint(NoArguments), EntryResult(IntegerExitStatus), entry_function
	../../../src/verify/verify: verify
	../managed_union_inputs: lowered, NAMED_CALLBACK_SOURCE, NONCAPTURING_CALLBACK_SOURCE
	../ownership_inputs: InputIds, function, input_ids, parameter, span
	test: TestSuite


-- Hand-written ownership IR is intentionally independent of insertion.
private pure func integer(value: ValueId, number: Int, at: Int) -> OwnershipOperation:
	DefineValue({
		id = value,
		value_type = IntType,
		operation = IntegerDefinition(number),
		result = UnmanagedResult,
		span = span(at),
	})


private pure func string(ids: InputIds) -> OwnershipOperation:
	DefineValue({
		id = ids.second,
		value_type = StringType,
		operation = CallDefinition(
			RuntimeFunction(Builtins.IntToString),
			[UnmanagedArgument(ids.first)],
		),
		result = OwnedResult(owner_id(0)),
		span = span(20),
	})


private pure func length(ids: InputIds, owner: Int) -> OwnershipOperation:
	DefineValue({
		id = ids.third,
		value_type = IntType,
		operation = CallDefinition(
			RuntimeFunction(Builtins.StringLength),
			[BorrowedArgument({
					value = ids.second,
					source = OwnerBorrow(owner_id(owner)),
				})],
		),
		result = UnmanagedResult,
		span = span(30),
	})


private pure func program(ids: InputIds, operations: List[OwnershipOperation]) -> OwnershipProgram:
	{
		records = [],
		unions = [],
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
		functions = [
			{
				parameters = [], return_type = IntType,
				operations = operations,
				result = UnmanagedReturn(ids.third)
			},
		]
	}


private pure func rejects(input: OwnershipProgram, message: String, at: Int) -> Bool:
	match verify(input):
		Err(error):
			(
				error.message == "ownership verification failed: " + message
				and error.help == "report this compiler error with the input program"
				and error.span.start == at
				and error.span.end == at + 1
			)
		Ok(_):
			False


private pure func match_program(
	ids: InputIds,
	selection: Own.OwnedSelection,
	identities: List[Model.MatchArmId],
) -> OwnershipProgram:
	arms = identities.map(pure func(identity) -> Own.OwnedLoopArm: {
		id = identity, inputs = [], body = { operations = [],
			tail = Own.ExitLoop(Break({ value = UnmanagedReturn(ids.second), carried = [], span = span(20) })) }
	})
	{
		records = [], unions = ids.unions,
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
		functions = [{ parameters = [], return_type = IntType,
			operations = [DefineValue({ id = ids.first, value_type = UnionType(ids.union_id), operation = ConstructDefinition(ids.second_variant, []), result = UnmanagedResult, span = span(10) }), integer(ids.second, 7, 20), ExecuteLoop({
				entry_acquisitions = [],
				headers = [], result = UnmanagedJoinParameter({ id = ids.third, value_type = IntType, span = span(90) }), carried = [],
				body = { operations = [], tail = MatchLoop({ selection = selection, arms = arms }) }
			})], result = UnmanagedReturn(ids.third)
		}]
	}


pure func test_rejects_a_match_without_an_entry_node() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): rejects(match_program(ids, { scrutinee = UnmanagedArgument(ids.first), nodes = [], entry = Model.decision_node_id(0) }, []), "selection entry is not a node", 10)


pure func test_rejects_a_match_missing_its_fallback_edge() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = Selection.branches(UnmanagedArgument(ids.first), ids.second_variant)
			nodes = original.nodes.map(pure func(node):
				match node:
					Own.TestVariant(place, variant, yes, _): Own.TestVariant(place, variant, yes, Model.decision_node_id(99))
					_: node
			)
			selection = { original | nodes = nodes }
			rejects(match_program(ids, selection, [Model.match_arm_id(0), Model.match_arm_id(1)]), "selection successor is not an earlier node", 10)


pure func test_rejects_an_unreachable_match_decision() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = Selection.branches(UnmanagedArgument(ids.first), ids.second_variant)
			rejects(match_program(ids, { original | entry = Model.decision_node_id(0) }, [Model.match_arm_id(0), Model.match_arm_id(1)]), "selection contains an unreachable node", 10)


pure func test_rejects_a_repeated_canonical_match_arm() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): rejects(match_program(ids, Selection.direct(UnmanagedArgument(ids.first)), [Model.match_arm_id(0), Model.match_arm_id(0)]), "selection arm identity appears more than once", 10)


pure func test_rejects_a_match_with_a_forward_successor() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = Selection.branches(UnmanagedArgument(ids.first), ids.second_variant)
			nodes = original.nodes.map(pure func(node):
				match node:
					Own.TestVariant(place, variant, _, no): Own.TestVariant(place, variant, Model.decision_node_id(2), no)
					_: node
			)
			selection = { original | nodes = nodes }
			rejects(match_program(ids, selection, [Model.match_arm_id(0), Model.match_arm_id(1)]), "selection successor is not an earlier node", 10)


pure func test_rejects_a_canonical_arm_without_an_incoming_edge() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): rejects(match_program(ids, Selection.branches(UnmanagedArgument(ids.first), ids.second_variant), [Model.match_arm_id(0), Model.match_arm_id(1), Model.match_arm_id(2)]), "selection arm has no incoming edge", 10)


pure func test_accepts_a_match_with_all_variants() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			match ids.union_value.operation:
				ConstructValue(first, []): verify(match_program(ids, Selection.branches(UnmanagedArgument(ids.first), first), [Model.match_arm_id(0), Model.match_arm_id(1)])).is_ok()
				_: False


pure func test_accepts_a_match_with_variants_in_reverse_order() -> Bool:
