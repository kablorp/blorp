import:
	../../../src/own/own as Own
	../../../src/verify/verify: verify
	../../../src/utils/source: compiler_source
	../../../src/utils/syntax: Span, same_span
	../join_inputs: with_operations
	../value_if_inputs as Input
	test: TestSuite


private RESULT_SPAN: Span = { source = compiler_source(), start = 20, end = 21 }


pure func test_inserted_string_and_list_value_ifs_verify() -> Bool:
	(Input.owned(Input.STRING_ALIAS).and_then(verify).is_ok()
		and Input.owned(Input.LIST_ALIAS).and_then(verify).is_ok())


pure func test_value_if_managed_result_cannot_lose_its_owner() -> Bool:
	match Input.owned(Input.STRING_ALIAS):
		Err(_): False
		Ok(program):
			broken = with_operations(program, pure func(operations):
				operations.map(pure func(operation):
					match operation:
						Own.ExecuteJoin(join):
							parameter = { Own.join_parameter(join.result) | span = RESULT_SPAN }
							Own.ExecuteJoin({ join | result = Own.UnmanagedJoinParameter(parameter) })
						_: operation
				)
			)
			match verify(broken):
				Ok(_): False
				Err(error):
					(error.message == "ownership verification failed: managed result requires an owner"
						and error.help == "report this compiler error with the input program"
						and same_span(error.span, RESULT_SPAN) and error.note.is_none())


tests: TestSuite = {
	description = "Blorp 2 value if ownership verification",
	tests = [
		("inserted String and List value ifs verify", test_inserted_string_and_list_value_ifs_verify),
		("managed result requires its owner", test_value_if_managed_result_cannot_lose_its_owner),
	]
}
