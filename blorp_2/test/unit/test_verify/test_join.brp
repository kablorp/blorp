import:
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/utils/source: compiler_source, module_source, root_module_id
	../../../src/utils/syntax: Span, same_span
	../../../src/verify/verify: verify
	../join_inputs: COUNT, MEASURE, NEST, PICK, ORDINARY_PICK, join_function, map_join_arms, owned, with_operations
	test: TestSuite


private SPAN: Span = {
	source = compiler_source(),
	start = 0,
	end = 0
}


private pure func accepted(source: String) -> Bool:
	match owned(source):
		Err(_): False
		Ok(program): verify(program).is_ok()


pure func test_inserted_joins_are_verified() -> Bool:
	accepted(PICK) and accepted(NEST) and accepted(MEASURE)


private RESULT_SPAN: Span = { SPAN | start = 20, end = 21 }


private pure func rewrite_joins(
	program: Own.OwnershipProgram,
	rewrite: pure (Own.OwnedJoin) -> Own.OwnedJoin,
) -> Own.OwnershipProgram:
	with_operations(program, pure func(operations):
		operations.map(pure func(operation):
			match operation:
				Own.ExecuteJoin(join): Own.ExecuteJoin(rewrite(join))
				_: operation
		)
	)


private pure func rejected_at(program: Own.OwnershipProgram, message: String, at: Span) -> Bool:
	match verify(program):
		Ok(_): False
		Err(error):
			(
				error.message == "ownership verification failed: " + message
				and error.help == "report this compiler error with the input program"
				and error.note.is_none() and same_span(error.span, at)
			)


private pure func managed_parameter_rejected(source: String) -> Bool:
	match owned(source):
		Err(_): False
		Ok(program):
			changed = rewrite_joins(program, pure func(join):
				parameter = { Own.join_parameter(join.result) | span = RESULT_SPAN }
				{ join | result = Own.UnmanagedJoinParameter(parameter) }
			)
			verify(program).is_ok() and rejected_at(changed, "managed result requires an owner", RESULT_SPAN)


pure func test_string_join_parameter_cannot_be_unmanaged() -> Bool:
	source: String =
		|fixed union Choice:
		|	Yes
		|	No
		|pure func pick(choice: Choice) -> String:
		|	label = match choice:
		|		Yes: "fresh"
		|		No: "other"
		|	label
		|func main() -> Int:
		|	unused = pick(Yes)
		|	0
		|
	managed_parameter_rejected(source)


pure func test_list_join_parameter_cannot_be_unmanaged() -> Bool:
	source: String =
		|fixed union Choice:
		|	Yes
		|	No
		|pure func pick(choice: Choice) -> List[String]:
		|	label = match choice:
		|		Yes: ["fresh"]
		|		No: ["other"]
		|	label
		|func main() -> Int:
		|	unused = pick(Yes)
		|	0
		|
	managed_parameter_rejected(source)


pure func test_managed_record_join_parameter_cannot_be_unmanaged() -> Bool:
	source: String =
		|fixed record TextBox { text: String }
		|pure func box(text: String) -> TextBox:
		|	{ text = text }
		|
		|fixed union Choice:
		|	Yes
		|	No
		|pure func pick(choice: Choice) -> TextBox:
		|	label = match choice:
		|		Yes: box("fresh")
		|		No: box("other")
		|	label
		|func main() -> Int:
		|	unused = pick(Yes)
		|	0
		|
	managed_parameter_rejected(source)


pure func test_owning_union_join_parameter_cannot_be_unmanaged() -> Bool:
	source: String =
		|fixed union Parcel:
		|	Packed(String)
		|pure func pack(text: String) -> Parcel:
		|	Packed(text)
		|
		|fixed union Choice:
		|	Yes
		|	No
		|pure func pick(choice: Choice) -> Parcel:
		|	label = match choice:
		|		Yes: pack("fresh")
		|		No: pack("other")
		|	label
		|func main() -> Int:
		|	unused = pick(Yes)
		|	0
		|
	managed_parameter_rejected(source)


pure func test_primitive_join_parameter_cannot_be_managed() -> Bool:
	match owned(COUNT):
		Err(_): False
		Ok(program):
			changed = rewrite_joins(program, pure func(join):
				parameter = { Own.join_parameter(join.result) | span = RESULT_SPAN }
				{ join | result = Own.ManagedJoinParameter(parameter, Own.owner_id(0)) }
			)
			rejected_at(changed, "unmanaged value carries an ownership obligation", RESULT_SPAN)


-- These raw mutations keep PICK's original unary producer as the accepted input.
private pure func rejects_pick_join(
	rewrite: pure (Own.OwnedJoin) -> Own.OwnedJoin,
	message: String,
) -> Bool:
	match owned(PICK):
		Err(_): False
		Ok(program): rejected_at(rewrite_joins(program, rewrite), message, RESULT_SPAN)


pure func test_join_result_cannot_repeat_a_prefix_value_identity() -> Bool:
	rewrite = pure func(join: Own.OwnedJoin) -> Own.OwnedJoin:
		match (join.result, join.arms):
			(Own.ManagedJoinParameter(parameter, owner), [_, enclosing]):
				match yielded(enclosing):
					Some(value): { join | result = Own.ManagedJoinParameter({ parameter | id = value, span = RESULT_SPAN }, owner) }
					None: join
			_: join
	rejects_pick_join(rewrite, "value identity is not the next function ordinal")


pure func test_join_result_cannot_repeat_a_prefix_owner_identity() -> Bool:
	rewrite = pure func(join: Own.OwnedJoin) -> Own.OwnedJoin:
		parameter = { Own.join_parameter(join.result) | span = RESULT_SPAN }
		{ join | result = Own.ManagedJoinParameter(parameter, Own.owner_id(0)) }
	rejects_pick_join(rewrite, "owner 0 is defined more than once")


pure func test_join_parameter_owner_must_be_the_next_ordinal() -> Bool:
	rewrite = pure func(join: Own.OwnedJoin) -> Own.OwnedJoin:
		parameter = { Own.join_parameter(join.result) | span = RESULT_SPAN }
		{ join | result = Own.ManagedJoinParameter(parameter, Own.owner_id(2)) }
	rejects_pick_join(rewrite, "owner identity is not the next function ordinal")


pure func test_join_arm_cannot_read_a_new_output() -> Bool:
	match owned(PICK):
		Err(_): False
		Ok(program):
			changed = rewrite_joins(program, pure func(join):
				value = Own.join_parameter(join.result).id
				borrow: Own.BorrowedValue = { value = value, source = Own.OwnerBorrow(Own.owner_id(1)) }
				arms = rewrite_arm(join.arms, 1, pure func(arm, _): { arm | operations = [Own.AcquireOwner(Own.owner_id(3), borrow, SPAN)] })
				{ join | arms = arms }
			)
			rejected_at(changed, "value 2 is not defined before use", SPAN)


pure func test_join_result_value_must_be_the_next_ordinal() -> Bool:
	rewrite = pure func(join: Own.OwnedJoin) -> Own.OwnedJoin:
		match (join.result, join.arms):
			(Own.ManagedJoinParameter(parameter, owner), [fresh, _]):
				match yielded(fresh):
					Some(value): { join | result = Own.ManagedJoinParameter({ parameter | id = value, span = RESULT_SPAN }, owner) }
					None: join
			_: join
	rejects_pick_join(rewrite, "value identity is not the next function ordinal")


pure func test_raw_join_carried_outputs_require_fresh_value_identities() -> Bool:
	rewrite = pure func(join: Own.OwnedJoin) -> Own.OwnedJoin:
		parameter = { Own.join_parameter(join.result) | span = RESULT_SPAN }
		output = Own.ManagedJoinParameter(parameter, Own.owner_id(1))
		{ join | result = output, carried = [output] }
	rejects_pick_join(rewrite, "value identity is not the next function ordinal")


pure func test_raw_join_carried_transfers_require_the_parameter_arity() -> Bool:
	rewrite = pure func(join: Own.OwnedJoin) -> Own.OwnedJoin:
		parameter = { Own.join_parameter(join.result) | span = RESULT_SPAN }
		arms = join.arms.map(pure func(arm):
			match arm.exit:
				Own.Yield(outputs): { arm | exit = Own.Yield({ outputs | carried = [outputs.transfer] }) }
				Own.TransferLoop(_, _): arm
		)
		{ join | result = Own.ManagedJoinParameter(parameter, Own.owner_id(1)), arms = arms }
	rejects_pick_join(rewrite, "join arm carries the wrong number of values")


-- PICK's join function with its arms rewritten, verified as raw IR.
private pure func rejects_pick_arms(
	rewrite: pure (List[Own.OwnedJoinArm]) -> List[Own.OwnedJoinArm],
	message: String,
) -> Bool:
	match owned(PICK):
		Err(_):
			False
		Ok(program):
			rejected(with_operations(program, pure func(operations): map_join_arms(operations, rewrite)), message)


private pure func rejected(program: Own.OwnershipProgram, message: String) -> Bool:
	match verify(program):
		Ok(_): False
		Err(error): error.message == "ownership verification failed: " + message


private pure func transferred_value(transfer: Own.ReturnTransfer) -> Lower.ValueId:
	match transfer:
		Own.UnmanagedReturn(value): value
		Own.OwnedReturn(value, _): value


private pure func yielded(arm: Own.OwnedJoinArm) -> Option[Lower.ValueId]:
	match arm.exit:
		Own.Yield(outputs): Some(transferred_value(outputs.transfer))
		Own.TransferLoop(_, _): None


-- Rewrites one arm, given the value it yields.
private pure func rewrite_arm(
	arms: List[Own.OwnedJoinArm],
	selected: Int,
	rewrite: pure (Own.OwnedJoinArm, Lower.ValueId) -> Own.OwnedJoinArm,
) -> List[Own.OwnedJoinArm]:
	arms.map_indexed(pure func(index, arm): rewrite_selected(arm, index == selected, rewrite))


private pure func rewrite_selected(
	arm: Own.OwnedJoinArm,
	selected: Bool,
	rewrite: pure (Own.OwnedJoinArm, Lower.ValueId) -> Own.OwnedJoinArm,
) -> Own.OwnedJoinArm:
	if selected:
		match yielded(arm):
			Some(value): rewrite(arm, value)
			None: arm
	else:
		arm


-- PICK's `No` arm yields `kept`, value 1, whose prefix owner is 0. Moving
-- that owner instead of acquiring would leave the arms' edges disagreeing.
pure func test_yield_of_a_prefix_owner_without_acquisition_is_rejected() -> Bool:
	rejects_pick_arms(
		pure func(arms): rewrite_arm(arms, 1, pure func(arm, kept): { arm | operations = [], exit = Own.Yield({ transfer = Own.OwnedReturn(kept, Own.owner_id(0)), carried = [] }) }),
		"yield must transfer an owner made in its arm, not owner 0",
	)


pure func test_managed_yield_without_an_owner_is_rejected() -> Bool:
	rejects_pick_arms(
		pure func(arms): rewrite_arm(arms, 1, pure func(arm, kept): { arm | operations = [], exit = Own.Yield({ transfer = Own.UnmanagedReturn(kept), carried = [] }) }),
		"managed yield requires an owner transfer",
	)


-- The `Yes` arm makes owner 2, then yields an acquired `kept` without
-- dropping owner 2.
pure func test_arm_owner_leaked_across_a_yield_is_rejected() -> Bool:
	rejects_pick_arms(pure func(arms): leaked(arms), "owner 2 remains live at yield")


private pure func leaked(arms: List[Own.OwnedJoinArm]) -> List[Own.OwnedJoinArm]:
	match arms:
		[fresh, reacquired]:
			[{ fresh | operations = fresh.operations.concat(reacquired.operations), exit = reacquired.exit }, reacquired]
		_:
			arms


-- Dropping the prefix owner in one arm only would leave the join's edges
-- with different live prefixes.
pure func test_prefix_owner_dropped_in_one_arm_is_rejected() -> Bool:
	rejects_pick_arms(
		pure func(arms): rewrite_arm(arms, 1, pure func(arm, _): { arm | operations = arm.operations.append(Own.DropOwner(Own.owner_id(0), SPAN)) }),
		"owner 0 is discharged before its join",
	)


private pure func without_drop(operations: List[Own.OwnershipOperation], owner: Int) -> List[Own.OwnershipOperation]:
	operations.filter(pure func(operation): not drops(operation, owner))


private pure func drops(operation: Own.OwnershipOperation, owner: Int) -> Bool:
	match operation:
		Own.DropOwner(id, _): Own.owner_number(id) == owner
		_: False


-- MEASURE drops its unread join value; without that drop it stays live.
pure func test_undischarged_join_value_is_rejected() -> Bool:
	match owned(MEASURE):
		Err(_): False
		Ok(program): rejected(with_operations(program, pure func(operations): without_drop(operations, 0)), "owner 0 remains live at return")


pure func test_ordinary_tail_join_requires_parent_cleanup_before_return() -> Bool:
	match owned(ORDINARY_PICK):
		Err(_): False
		Ok(program):
			match join_function(program):
				None: False
				Some(function):
					match function.operations:
						[Own.DefineValue(_), Own.DefineValue(_), Own.ExecuteJoin(join), Own.DropOwner(_, _)]:
							(verify(program).is_ok()
							and rejected_at(
								with_operations(program, pure func(operations): without_drop(operations, 0)),
								"owner 0 remains live at return",
								Own.join_parameter(join.result).span,
							))
						_: False


-- Rewrites every arm of COUNT's join, verified as raw IR.
private pure func rejects_count_arms(
	rewrite: pure (List[Own.OwnedJoinArm]) -> List[Own.OwnedJoinArm],
	message: String,
) -> Bool:
	match owned(COUNT):
		Err(_):
			False
		Ok(program):
			rejected(with_operations(program, pure func(operations): map_join_arms(operations, rewrite)), message)


-- PICK's join matches on `kept`, a String, instead of its Choice.
pure func test_join_scrutinee_of_another_type_is_rejected() -> Bool:
	match owned(PICK):
		Err(_):
			False
		Ok(program):
			changed = with_operations(program, pure func(operations): operations.map(pure func(operation): string_scrutinee(operation)))
			-- The String literal in PICK owns this source span.
			expected_span: Span = { source = module_source(root_module_id()), start = 79, end = 85 }
			rejected_at(changed, "pattern root type does not match its scrutinee", expected_span)


private pure func string_scrutinee(operation: Own.OwnershipOperation) -> Own.OwnershipOperation:
	match operation:
		Own.ExecuteJoin(join):
			match join.arms.get(1):
				Some(arm):
					match yielded(arm):
						Some(value):
							-- PICK keeps this String's prefix owner 0 live until after the join.
							borrow: Own.BorrowedValue = { value = value, source = Own.OwnerBorrow(Own.owner_id(0)) }
							Own.ExecuteJoin({ join | selection = { join.selection | scrutinee = Own.BorrowedArgument(borrow) } })
						None: operation
				None: operation
		_: operation


-- PICK's `Yes` arm yields the Choice scrutinee, value 0, into a String join.
pure func test_yield_of_another_type_is_rejected() -> Bool:
	match owned(PICK):
		Err(_):
			False
		Ok(program):
			rejected(with_operations(program, pure func(operations): operations.map(pure func(operation): choice_yield(operation))), "yield type does not match its join")


private pure func choice_yield(operation: Own.OwnershipOperation) -> Own.OwnershipOperation:
	match operation:
		Own.ExecuteJoin(join):
			scrutinee = match join.selection.scrutinee:
				Own.UnmanagedArgument(value): value
				Own.BorrowedArgument(borrow): borrow.value
				Own.ConsumedArgument(value, _): value
			arms = rewrite_arm(join.arms, 0, pure func(arm, _): { arm | exit = Own.Yield({ transfer = Own.UnmanagedReturn(scrutinee), carried = [] }) })
			Own.ExecuteJoin({ join | arms = arms })
		_: operation


pure func test_unmanaged_yield_moving_an_owner_is_rejected() -> Bool:
	rejects_count_arms(
		pure func(arms): rewrite_arm(arms, 0, pure func(arm, number): { arm | exit = Own.Yield({ transfer = Own.OwnedReturn(number, Own.owner_id(0)), carried = [] }) }),
		"unmanaged yield cannot transfer an owner",
	)


-- The `Yes` arm's owner 2 owns "fresh", value 3, not `kept`.
pure func test_yield_moving_another_values_owner_is_rejected() -> Bool:
	match owned(PICK):
		Err(_):
			False
		Ok(program):
			match join_arms(program):
				[_, reacquired]:
					match yielded(reacquired):
						None: False
						Some(value):
							rejects_pick_arms(
								pure func(arms): rewrite_arm(arms, 0, pure func(arm, _): { arm | exit = Own.Yield({ transfer = Own.OwnedReturn(value, Own.owner_id(2)), carried = [] }) }),
								"yielded owner does not own the yielded value",
							)
				_:
					False


private pure func join_arms(program: Own.OwnershipProgram) -> List[Own.OwnedJoinArm]:
	var arms: List[Own.OwnedJoinArm] = []
	for function in program.functions:
		for operation in function.operations:
			match operation:
				Own.ExecuteJoin(join): arms = join.arms
				_:
					void
	arms


pure func test_yield_of_a_dropped_owner_is_rejected() -> Bool:
	rejects_pick_arms(
		pure func(arms): rewrite_arm(arms, 0, pure func(arm, _): { arm | operations = arm.operations.append(Own.DropOwner(Own.owner_id(2), SPAN)) }),
		"yield refers to discharged owner 2",
	)


-- `Yes` stores `kept` in a fresh `Full`, acquiring an owner for the payload.
private WRAP: String =
	|fixed union Choice:
	|	Yes
	|	No
	|fixed union Box:
	|	Full(String)
	|	Empty
	|pure func empty() -> Box:
	|	Empty
	|pure func wrap(choice: Choice) -> Box:
	|	kept = "kept"
	|	var boxed = empty()
	|	boxed = match choice:
	|		Yes: Full(kept)
	|		No: Empty
	|	boxed
	|func main() -> Int:
	|	unused = wrap(Yes)
	|	0
	|


-- Storing the prefix owner 0 itself would discharge it inside a join arm.
private pure func stores_prefix_owner(operation: Own.OwnershipOperation) -> Own.OwnershipOperation:
	match operation:
		Own.DefineValue(definition):
			match definition.operation:
				Own.ConstructDefinition(variant, payloads):
					stored = payloads.map(pure func(payload): prefix_payload(payload))
					Own.DefineValue({ definition | operation = Own.ConstructDefinition(variant, stored) })
				_:
					operation
		_:
			operation


private pure func prefix_payload(payload: Own.StoredPayload) -> Own.StoredPayload:
	match payload:
		Own.OwnedPayload(value, _): Own.OwnedPayload(value, Own.owner_id(0))
		Own.UnmanagedPayload(_): payload


pure func test_payload_storing_a_prefix_owner_in_a_join_arm_is_rejected() -> Bool:
	match owned(WRAP):
		Err(_):
			False
		Ok(program):
			rejected(
				with_operations(program, pure func(operations): map_join_arms(operations, pure func(arms): arms.map(pure func(arm): { arm | operations = arm.operations.map(pure func(operation): stores_prefix_owner(operation)) }))),
				"owner 0 is discharged before its join",
			)


tests: TestSuite = {
	description = "Verification of join edges",
	tests = [
		("ordinary tail join requires parent cleanup", test_ordinary_tail_join_requires_parent_cleanup_before_return),
		("inserted joins are verified", test_inserted_joins_are_verified),
		("String output cannot be unmanaged", test_string_join_parameter_cannot_be_unmanaged),
		("List output cannot be unmanaged", test_list_join_parameter_cannot_be_unmanaged),
		("managed record output cannot be unmanaged", test_managed_record_join_parameter_cannot_be_unmanaged),
		("owning union output cannot be unmanaged", test_owning_union_join_parameter_cannot_be_unmanaged),
		("primitive output cannot be managed", test_primitive_join_parameter_cannot_be_managed),
		("join result cannot repeat a prefix value", test_join_result_cannot_repeat_a_prefix_value_identity),
		("join result cannot repeat a prefix owner", test_join_result_cannot_repeat_a_prefix_owner_identity),
		("join parameter owner must be next", test_join_parameter_owner_must_be_the_next_ordinal),
		("join arm cannot read a new output", test_join_arm_cannot_read_a_new_output),
		("join result value must be next", test_join_result_value_must_be_the_next_ordinal),
		("raw join carried outputs require fresh values", test_raw_join_carried_outputs_require_fresh_value_identities),
		("raw join carried transfers require parameter arity", test_raw_join_carried_transfers_require_the_parameter_arity),
		("yield of a prefix owner without acquisition is rejected", test_yield_of_a_prefix_owner_without_acquisition_is_rejected),
		("managed yield without an owner is rejected", test_managed_yield_without_an_owner_is_rejected),
		("arm owner leaked across a yield is rejected", test_arm_owner_leaked_across_a_yield_is_rejected),
		("prefix owner dropped in one arm is rejected", test_prefix_owner_dropped_in_one_arm_is_rejected),
		("undischarged join value is rejected", test_undischarged_join_value_is_rejected),
		("payload storing a prefix owner in a join arm is rejected", test_payload_storing_a_prefix_owner_in_a_join_arm_is_rejected),
		("join scrutinee of another type is rejected", test_join_scrutinee_of_another_type_is_rejected),
		("yield of another type is rejected", test_yield_of_another_type_is_rejected),
		("unmanaged yield moving an owner is rejected", test_unmanaged_yield_moving_an_owner_is_rejected),
		("yield moving another value's owner is rejected", test_yield_moving_another_values_owner_is_rejected),
		("yield of a dropped owner is rejected", test_yield_of_a_dropped_owner_is_rejected),
	]
}
