-- Direct raw-IR constructors shared by independent verifier tests. These
-- create decision graphs only; no insertion, parsing or expected result oracle.
import:
	../../../src/check/model as Model
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete


pure func direct(scrutinee: Own.OwnedArgument) -> Own.OwnedSelection:
	{ scrutinee = scrutinee, nodes = [Own.EnterArm({ arm = Model.match_arm_id(0), operations = [], transfers = [] })], entry = Model.decision_node_id(0) }


pure func branches(scrutinee: Own.OwnedArgument, variant: Concrete.VariantInstanceId) -> Own.OwnedSelection:
	{ scrutinee = scrutinee, nodes = [
		Own.EnterArm({ arm = Model.match_arm_id(0), operations = [], transfers = [] }),
		Own.EnterArm({ arm = Model.match_arm_id(1), operations = [], transfers = [] }),
		Own.TestVariant({ value_type = Concrete.UnionType(Concrete.variant_owner(variant)), route = Concrete.MatchRoot }, variant, Model.decision_node_id(0), Model.decision_node_id(1)),
	], entry = Model.decision_node_id(2) }


pure func lowered_direct(scrutinee: Lower.ValueId) -> Lower.LoweredSelection:
	{ scrutinee = scrutinee, nodes = [Lower.EnterArm({ arm = Model.match_arm_id(0), definitions = [], arguments = [] })], entry = Model.decision_node_id(0) }


pure func lowered_branches(scrutinee: Lower.ValueId, variant: Concrete.VariantInstanceId) -> Lower.LoweredSelection:
	{ scrutinee = scrutinee, nodes = [
		Lower.EnterArm({ arm = Model.match_arm_id(0), definitions = [], arguments = [] }),
		Lower.EnterArm({ arm = Model.match_arm_id(1), definitions = [], arguments = [] }),
		Lower.TestVariant({ value_type = Concrete.UnionType(Concrete.variant_owner(variant)), route = Concrete.MatchRoot }, variant, Model.decision_node_id(0), Model.decision_node_id(1)),
	], entry = Model.decision_node_id(2) }


-- Copy only structural identity/tests from a Lower seed. Tested operations and
-- input signatures remain authored by the caller, independently of insertion.
pure func empty_from_lower(selection: Lower.LoweredSelection, scrutinee: Own.OwnedArgument) -> Own.OwnedSelection:
	nodes = selection.nodes.map(pure func(node):
		match node:
			Lower.TestVariant(place, variant, yes, no): Own.TestVariant(place, variant, yes, no)
			Lower.TestListLength(place, test, yes, no): Own.TestListLength(place, test, yes, no)
			Lower.TestStringBytes(place, bytes, yes, no): Own.TestStringBytes(place, bytes, yes, no)
			Lower.EnterArm(edge): Own.EnterArm({ arm = edge.arm, operations = [], transfers = [] })
	)
	{ scrutinee = scrutinee, entry = selection.entry, nodes = nodes }
