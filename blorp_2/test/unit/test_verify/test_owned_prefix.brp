import:
	../ownership_inputs: borrowed_rows
	../../../src/check/model as Model
	./selection_inputs as Selection
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/utils/source: compiler_source
	../../../src/utils/syntax: Diagnostic, Span
	../../../src/verify/verify: verify
	../managed_union_inputs: lowered, lowered_tail_join
	../ownership_inputs: InputIds, input_ids
	test: TestSuite


private SOURCE: String =
	|union Choice:
	|	Yes
	|	No
	|record Holder { text: String }
	|pure func make() -> Holder:
	|	{ text = "42" }
	|pure func inspect(choice: Choice) -> String:
	|	owned = make()
	|	match choice:
	|		Yes: owned.text
	|		No: owned.text
	|func main() -> Int:
	|	unused = inspect(Yes)
	|	0
	|


private union RawCase:
	Valid
	MissingFirstDrop
	MissingSecondDrop
	DoubleFirstDrop
	DirectPrefixTransfer
	EarlyParentDrop
	SiblingOwner
	UndefinedOwner
	BorrowedEscape


private pure func span(at: Int) -> Span:
	{
		source = compiler_source(),
		start = at,
		end = at + 1
	}


private pure func seed_error() -> Diagnostic:
	{
		span = {
			source = compiler_source(),
			start = 0,
			end = 1
		},
		note = None,
		message = "invalid owned-prefix identity seed",
		help = "fix test setup"
	}


private pure func raw_arm(
	arm: Lower.JoinArm,
	identity: Lower.ValueId,
	parent: Lower.ValueId,
	ordinal: Int,
	case: RawCase,
) -> Result[Own.OwnedLoopArm, Diagnostic]:
	at = if ordinal == 1:
		span(20)
	else:
		span(30)

	match arm.steps:
		[Lower.Define(child)]:
			match child.operation:
				Lower.ReadRecordFieldValue(field, _):
					root = Own.owner_id(1)
					acquired = Own.owner_id(ordinal + 1)
					var operations: List[Own.OwnershipOperation] = []

					match case:
						EarlyParentDrop:
							if ordinal == 1:
								operations = operations.append(Own.DropOwner(root, at))
						_:
							void

					operations = operations.append(Own.DefineValue({
						id = identity,
						value_type = child.value_type,
						operation = Own.ReadRecordFieldDefinition(
							field,
							Own.BorrowedArgument({
								value = parent,
								source = Own.OwnerBorrow(root),
							}),
						),
						result = Own.BorrowedResult(Own.PayloadBorrow(parent)),
						span = at,
					}))

					escaping_borrow = match case:
						BorrowedEscape:
							ordinal == 1
						_:
							False

					if not escaping_borrow:
						operations = operations.append(
							Own.AcquireOwner(
								acquired,
								{
									value = identity,
									source = Own.PayloadBorrow(parent)
								},
								at,
							),
						)

					missing = match case:
						MissingFirstDrop | DirectPrefixTransfer:
							ordinal == 1
						MissingSecondDrop:
							ordinal == 2
						_:
							False

					if not missing:
						operations = operations.append(Own.DropOwner(root, at))

					match case:
						DoubleFirstDrop:
							if ordinal == 1:
								operations = operations.append(Own.DropOwner(root, at))
						SiblingOwner:
							if ordinal == 2:
								operations = operations.append(Own.DropOwner(Own.owner_id(2), at))
						UndefinedOwner:
							if ordinal == 1:
								operations = operations.append(Own.DropOwner(Own.owner_id(99), at))
						_:
							void

					returned = match case:
						DirectPrefixTransfer:
							if ordinal == 1:
								root
							else:
								acquired
						_:
							acquired

					transfer = if escaping_borrow:
						Own.UnmanagedReturn(identity)
					else:
						Own.OwnedReturn(identity, returned)

					Ok({ id = arm.id, inputs = [], body = { operations = operations, tail = Own.ExitLoop(Own.Break({ value = transfer, carried = [], span = at })) } })
				_:
					Err(seed_error())
		_:
			Err(seed_error())


private pure func raw_function(
	function: Lower.LoweredFunction,
	seed: Lower.LoweredFunctions,
	values: InputIds,
	case: RawCase,
) -> Result[Own.OwnedFunction, Diagnostic]:
	match lowered_tail_join(function):
		None:
			Own.insert_function(function, seed.unions, seed.records)
		Some(matched):
			match (function.steps, matched.arms):
				([Lower.Define(parameter), Lower.Define(parent), Lower.Join(_)], [first, second]):
					match parent.operation:
						Lower.CallValue(call, []):
							left ?= raw_arm(first, values.fourth, values.third, 1, case)
							right ?= raw_arm(second, values.fifth, values.third, 2, case)
							Ok({
								parameters = borrowed_rows(function.signature.parameters, seed.unions, seed.records), return_type = function.signature.return_type,
								operations = [Own.DefineValue({
										id = values.first,
										value_type = parameter.value_type,
										operation = Own.ParameterDefinition(0),
										result = Own.UnmanagedResult,
										span = parameter.span,
									}), Own.ExecuteLoop({
										entry_acquisitions = [],
										headers = [],
										result = Own.ManagedJoinParameter({ id = values.second, value_type = function.signature.return_type, span = span(40) }, Own.owner_id(0)),
										carried = [],
										body = {
											operations = [Own.DefineValue({
												id = values.third,
												value_type = parent.value_type,
												operation = Own.CallDefinition(call, []),
												result = Own.OwnedResult(Own.owner_id(1)),
												span = parent.span,
											})],
											tail = Own.MatchLoop({
												selection = Selection.empty_from_lower(matched.selection, Own.UnmanagedArgument(values.first)),
												arms = [left, right],
											}),
										},
									})],
								result = Own.OwnedReturn(values.second, Own.owner_id(0)),
							})
						_:
							Err(seed_error())
				_:
					Err(seed_error())


-- Lowering supplies sealed identities and nominal types only. The target match's
-- prefix, acquisitions, drops and returns are authored independently here.
private pure func raw_program(case: RawCase) -> Result[Own.OwnershipProgram, Diagnostic]:
	ids ?= input_ids()
	lowered ?= lowered(SOURCE)
	seed = Lower.lowered_functions(lowered)
	var functions: List[Own.OwnedFunction] = []
	var invalid: Option[Diagnostic] = None

	for function in seed.functions:
		built = raw_function(function, seed, ids, case)

		match built:
			Ok(function):
				functions = functions.append(function)
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok({
				records = seed.records,
				unions = seed.unions,
				functions = functions,
				entrypoint = seed.entrypoint,
			})


private pure func rejects(case: RawCase, message: String, at: Int) -> Bool:
	match raw_program(case):
		Err(_):
			False
		Ok(program):
			match verify(program):
				Ok(_):
					False
				Err(error):
					(
						error.message == "ownership verification failed: " + message
						and error.help == "report this compiler error with the input program"
						and error.span.start == at
						and error.span.end == at + 1
					)


pure func test_independent_arm_prefix_discharge_is_valid() -> Bool:
	raw_program(Valid)
		.and_then(pure func(program): verify(program))
		.is_ok()


pure func test_first_arm_must_discharge_prefix() -> Bool:
	rejects(MissingFirstDrop, "loop-local owner remains live at an edge", 20)


pure func test_second_arm_must_discharge_prefix() -> Bool:
	rejects(MissingSecondDrop, "loop-local owner remains live at an edge", 30)


pure func test_prefix_cannot_be_dropped_twice() -> Bool:
	rejects(DoubleFirstDrop, "owner 1 has already been discharged", 20)


pure func test_loop_output_requires_a_fresh_acquisition() -> Bool:
	rejects(DirectPrefixTransfer, "loop transfer must use a fresh acquisition", 20)


pure func test_parent_must_be_live_at_projection() -> Bool:
	rejects(EarlyParentDrop, "borrow refers to discharged owner 1", 20)


pure func test_sibling_owner_gap_is_unavailable() -> Bool:
	rejects(SiblingOwner, "owner 2 is not available in this match arm", 30)


pure func test_unintroduced_owner_is_rejected() -> Bool:
	rejects(UndefinedOwner, "owner 99 is not defined", 20)


pure func test_borrowed_child_cannot_escape_without_owner() -> Bool:
	rejects(BorrowedEscape, "managed yield requires an owner transfer", 20)


private STORED_PREFIX_SOURCE: String =
	|union Choice:
	|	Yes
	|	No
	|record Pair { first: String, second: String }
	|pure func inspect(choice: Choice) -> Pair:
	|	text = "42"
	|	match choice:
	|		Yes: { first = text, second = text }
	|		No: { first = text, second = text }
	|func main() -> Int:
	|	unused = inspect(Yes)
	|	0
	|


private union PrefixSlots:
	DistinctSlots
	DuplicateSlot


private pure func raw_stored_prefix_arm(
	arm: Lower.JoinArm,
	identity: Lower.ValueId,
	text: Lower.ValueId,
	second: Own.OwnerId,
	introduced: Own.OwnerId,
	outgoing: Own.OwnerId,
	at: Int,
) -> Result[Own.OwnedLoopArm, Diagnostic]:
	match arm.steps:
		[Lower.Define(constructed)]:
			match constructed.operation:
				Lower.ConstructRecordValue(owner, [left, right]):
					Ok({ id = arm.id, inputs = [], body = { operations = [Own.DefineValue({
							id = identity,
							value_type = constructed.value_type,
							operation = Own.ConstructRecordDefinition(owner, [
								{
									field = left.field,
									value = Own.OwnedPayload(text, Own.owner_id(1)),
								},
								{
									field = right.field,
									value = Own.OwnedPayload(text, second),
								},
							]),
							result = Own.OwnedResult(introduced),
							span = span(at),
						}), Own.AcquireOwner(outgoing, { value = identity, source = Own.OwnerBorrow(introduced) }, span(at)), Own.DropOwner(introduced, span(at))], tail = Own.ExitLoop(Own.Break({ value = Own.OwnedReturn(identity, outgoing), carried = [], span = span(at) })) } })
				_:
					Err(seed_error())
		_:
			Err(seed_error())


private pure func raw_stored_prefix_function(
	function: Lower.LoweredFunction,
	seed: Lower.LoweredFunctions,
	values: InputIds,
	slots: PrefixSlots,
) -> Result[Own.OwnedFunction, Diagnostic]:
	match lowered_tail_join(function):
		None:
			Own.insert_function(function, seed.unions, seed.records)
		Some(matched):
			match (function.steps, matched.arms):
				([Lower.Define(parameter), Lower.Define(text), Lower.Join(_)], [first, second]):
					match text.operation:
						Lower.StringValue(contents):
							var operations = [Own.DefineValue({
									id = values.third,
									value_type = text.value_type,
									operation = Own.StringDefinition(contents),
									result = Own.OwnedResult(Own.owner_id(1)),
									span = span(11),
								})]

							second_slot = match slots:
								DistinctSlots:
									operations = operations.append(Own.AcquireOwner(
										Own.owner_id(2),
										{
											value = values.third,
											source = Own.OwnerBorrow(Own.owner_id(1)),
										},
										span(12),
									))
									2
								DuplicateSlot:
									1

							left ?= raw_stored_prefix_arm(
								first,
								values.fourth,
								values.third,
								Own.owner_id(second_slot),
								Own.owner_id(second_slot + 1),
								Own.owner_id(second_slot + 2),
								20,
							)
							right ?= raw_stored_prefix_arm(
								second,
								values.fifth,
								values.third,
								Own.owner_id(second_slot),
								Own.owner_id(second_slot + 3),
								Own.owner_id(second_slot + 4),
								30,
							)
							Ok({
								parameters = borrowed_rows(function.signature.parameters, seed.unions, seed.records), return_type = function.signature.return_type,
								operations = [Own.DefineValue({
										id = values.first,
										value_type = parameter.value_type,
										operation = Own.ParameterDefinition(0),
										result = Own.UnmanagedResult,
										span = span(10),
									}), Own.ExecuteLoop({
										entry_acquisitions = [],
										headers = [],
										result = Own.ManagedJoinParameter({ id = values.second, value_type = function.signature.return_type, span = span(40) }, Own.owner_id(0)),
										carried = [],
										body = {
											operations = operations,
											tail = Own.MatchLoop({
												selection = Selection.empty_from_lower(matched.selection, Own.UnmanagedArgument(values.first)),
												arms = [left, right],
											}),
										},
									})],
								result = Own.OwnedReturn(values.second, Own.owner_id(0)),
							})
						_:
							Err(seed_error())
				_:
					Err(seed_error())


-- Only sealed identities, field positions and nominal types come from lowering.
-- Target prefix owners, stored transfers, arm roots and returns are authored here.
private pure func raw_stored_prefix_program(
	slots: PrefixSlots,
) -> Result[Own.OwnershipProgram, Diagnostic]:
	ids ?= input_ids()
	lowered ?= lowered(STORED_PREFIX_SOURCE)
	seed = Lower.lowered_functions(lowered)
	var functions: List[Own.OwnedFunction] = []
	var invalid: Option[Diagnostic] = None

	for function in seed.functions:
		match raw_stored_prefix_function(function, seed, ids, slots):
			Ok(owned):
				functions = functions.append(owned)
			Err(error):
				invalid = Some(error)
				break

	match invalid:
		Some(error):
			Err(error)
		None:
			Ok({
				records = seed.records,
				unions = seed.unions,
				functions = functions,
				entrypoint = seed.entrypoint,
			})


pure func test_record_slots_consume_distinct_prefix_owners() -> Bool:
	raw_stored_prefix_program(DistinctSlots)
		.and_then(pure func(program): verify(program))
		.is_ok()


pure func test_record_slots_cannot_transfer_a_prefix_owner_twice() -> Bool:
	match raw_stored_prefix_program(DuplicateSlot):
		Err(_):
			False
		Ok(program):
			match verify(program):
				Ok(_):
					False
				Err(error):
					(
						error.message == "ownership verification failed: payload owner has already been discharged"
						and error.help == "report this compiler error with the input program"
						and error.span.start == 20
						and error.span.end == 21
						and error.span.source == compiler_source()
					)


tests: TestSuite = {
	description = "owned match prefix verification",
	tests = [
		("record slots consume distinct prefix owners", test_record_slots_consume_distinct_prefix_owners),
		("record slots cannot transfer a prefix owner twice", test_record_slots_cannot_transfer_a_prefix_owner_twice),
		("borrowed child escape needs owner", test_borrowed_child_cannot_escape_without_owner),
		("independent arm prefix discharge", test_independent_arm_prefix_discharge_is_valid),
		("first arm prefix leak", test_first_arm_must_discharge_prefix),
		("second arm prefix leak", test_second_arm_must_discharge_prefix),
		("prefix double drop", test_prefix_cannot_be_dropped_twice),
		("loop output requires a fresh acquisition", test_loop_output_requires_a_fresh_acquisition),
		("projection after prefix parent drop", test_parent_must_be_live_at_projection),
		("sibling owner gap", test_sibling_owner_gap_is_unavailable),
		("unintroduced owner", test_unintroduced_owner_is_rejected),
	]
}
