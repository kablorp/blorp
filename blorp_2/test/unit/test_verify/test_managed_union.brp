pure func test_inline_owning_signature_is_rejected_in_a_self_tail_loop() -> Bool:
	run(pure func(ids, layout):
		input = variant_program(
			ids,
			layout,
			None,
			Owned.OwnedResult(Owned.owner_id(0)),
		)

		match input.functions:
			[main, helper]:
				rejects(
					{ input | functions = [
							main,
							{ helper |
								execution = SelfTailLoop(span(90)),
								tail = Owned.ReturnTail(Owned.RecurArguments([], span(80)))
							},
						] },
					"managed signature in a self-tail loop",
					span(90),
				)
			_:
				False
	)


pure func test_inline_owning_intermediate_is_rejected_even_after_drop() -> Bool:
	run(pure func(ids, layout):
		input = variant_program(
			ids,
			layout,
			None,
			Owned.OwnedResult(Owned.owner_id(0)),
		)

		match input.functions:
			[main, helper]:
				rejects(
					{ input | functions = [
							main,
							{ helper |
								execution = SelfTailLoop(span(90)),
								signature = { helper.signature | return_type = Concrete.IntType },
								operations = helper.operations.append(
									Owned.DropOwner(
										Owned.owner_id(0),
										span(40),
									),
								),
								tail = Owned.ReturnTail(Owned.RecurArguments([], span(80)))
							},
						] },
					"managed value appears in a self-tail loop",
					span(20),
				)
			_:
				False
	)


-- Supplementary integration/lifetime probe; it supplies no expected raw facts.
-- Reading the actual fixture prevents CTFE from erasing the stage lifetimes.
func test_dynamic_fixture_reaches_verified_ownership() -> Bool:
	match read_file("blorp_2/test/e2e/fixtures/generic/managed/basic.brp"):
		Err(error):
			print_error(error)
			False
		Ok(source):
			match (
				lowered_modules([
					{
						source = source,
						targets = [1, 2]
					},
					{
						source = INTEGER_OPERATIONS,
						targets = []
					},
					{
						source = STRING_OPERATIONS,
						targets = []
					},
				])
					.and_then(pure func(program): Owned.own(program))
					.and_then(verify)
			):
				Err(error):
					print_error(error.message)
					False
				Ok(_):
					True


tests: TestSuite = {
	description = "Independent managed union ownership verification",
	tests = [
		(
			"inline owning self-tail signature rejected",
			test_inline_owning_signature_is_rejected_in_a_self_tail_loop,
		),
		(
			"dropped inline owning self-tail intermediate rejected",
			test_inline_owning_intermediate_is_rejected_even_after_drop,
		),
		(
			"dynamic fixture stage lifetime integration",
			test_dynamic_fixture_reaches_verified_ownership,
		),
		(
			"constructor consumes exact child owner",
			test_constructor_consumes_child_and_returns_aggregate,
		),
		("constructor requires child transfer", test_constructor_requires_child_transfer),
		(
			"constructor rejects another value owner",
			test_constructor_rejects_owner_of_another_value,
		),
		("constructor rejects discharged child", test_constructor_rejects_discharged_child),
		(
			"constructor rejects repeated child transfer",
			test_constructor_rejects_repeated_child_transfer,
		),
		("constructor requires aggregate owner", test_constructor_requires_aggregate_owner),
		(
			"constructor rejects equal shaped nominal child",
			test_constructor_rejects_equal_shaped_nominal_child,
		),
		(
			"independent aggregate owner survives original drop",
			test_independent_aggregate_owner_survives_original_drop,
		),
		(
			"extra acquisition cannot reactivate original owner",
			test_extra_acquisition_does_not_reactivate_original_owner,
		),
		("nullary variant has aggregate owner", test_nullary_variant_has_aggregate_owner),
		("nullary variant requires aggregate owner", test_nullary_variant_requires_aggregate_owner),
		("Int variant has aggregate owner", test_unmanaged_active_variant_has_aggregate_owner),
		(
			"Int variant requires aggregate owner",
			test_unmanaged_active_variant_requires_aggregate_owner,
		),
		("Int payload cannot transfer owner", test_unmanaged_payload_cannot_transfer_owner),
		(
			"selected payload returns independent owner",
			test_selected_payload_returns_independent_owner,
		),
		(
			"selected nested aggregate returns independent owner",
			test_selected_nested_aggregate_returns_independent_owner,
		),
		(
			"projection rejects wrong immediate parent",
			test_projection_rejects_wrong_immediate_parent,
		),
		(
			"projection rejects sibling variant",
			test_projection_rejects_sibling_variant_with_same_payload,
		),
		(
			"projection rejects other nominal union",
			test_projection_rejects_equal_shaped_other_union,
		),
		(
			"projection rejects other same typed scrutinee",
			test_projection_rejects_another_same_typed_scrutinee,
		),
		("projection rejects forward source", test_projection_rejects_forward_source),
		("projection rejects self parent edge", test_projection_rejects_self_parent_edge),
		("projection requires parent borrow kind", test_projection_requires_parent_borrow_kind),
		(
			"acquisition rejects wrong payload ancestry",
			test_acquisition_rejects_wrong_payload_ancestry,
		),
		("acquisition rejects inactive owner", test_acquisition_rejects_inactive_owner),
		(
			"acquisition rejects active parent owner",
			test_acquisition_rejects_active_owner_of_parent,
		),
		("returned payload requires acquisition", test_returned_payload_requires_acquisition),
		(
			"returned payload cannot name unacquired owner",
			test_returned_payload_cannot_name_unacquired_owner,
		),
		("payload owner leak rejected", test_payload_owner_leak_is_rejected),
		("payload owner double drop rejected", test_payload_owner_double_drop_is_rejected),
		("live prefix acquisition requires cleanup", test_live_prefix_acquisition_must_be_discharged),
		(
			"dropped prefix acquisition allows match",
			test_discharged_prefix_acquisition_allows_match,
		),
		(
			"dropped owned scrutinee rejects tag read",
			test_discharged_scrutinee_rejects_tag_read,
		),
		("unused nested owning layout accepted", test_unused_nested_owning_layout_is_accepted),
		("unused String layout cannot be unmanaged", test_unused_string_layout_cannot_be_unmanaged),
		("unused Int layout cannot own", test_unused_unmanaged_layout_cannot_claim_ownership),
		("unused parent cannot hide owning child", test_unused_parent_cannot_hide_owning_child),
		("unused self layout rejected", test_unused_self_layout_reference_is_rejected),
		(
			"unused existing forward layout rejected",
			test_unused_existing_forward_layout_reference_is_rejected,
		),
		("unused unknown layout rejected", test_unused_unknown_layout_reference_is_rejected),
		("unused empty layout rejected", test_unused_empty_layout_is_rejected),
	]
}
