						span(22),
					), Owned.DropOwner(
						Owned.owner_id(0),
						span(23),
					)],
				Owned.OwnedReturn(
					ids.third,
					Owned.owner_id(0),
				),
				[],
			),
			"owner 0 has already been discharged",
			span(23),
		)
	)


private pure func prefix_projection_program(
	ids: InputIds,
	layout: LayoutIds,
	discharged: Bool,
) -> Owned.OwnershipProgram:
	prefix = [acquire(
			0,
			ids.first,
			Owned.ParameterBorrow(ids.first),
			12,
		)]

	operations = if discharged:
		prefix + [Owned.DropOwner(
				Owned.owner_id(0),
				span(13),
			)]
	else:
		prefix

	input = projection_program(
		ids,
		layout,
		[projected(
				ids.third,
				layout.left_field,
				ids.first,
				Owned.PayloadBorrow(ids.first),
				20,
			), acquire(
				1,
				ids.third,
				Owned.PayloadBorrow(ids.first),
				21,
			)],
		Owned.OwnedReturn(
			ids.third,
			Owned.owner_id(1),
		),
		operations,
	)

	match input.functions:
		[main, helper]:
			match helper.tail:
				Owned.MatchTail(matched):
					match matched.arms:
						[first, second]:
							match second.operations:
								[child, Owned.AcquireOwner(_, borrow, at)]:
									{ input | functions = [
											main,
											{ helper | tail = Owned.MatchTail(
													{ matched | arms = [
															first,
															{ second |
																operations = [
																	child,
																	Owned.AcquireOwner(
																		Owned.owner_id(2),
																		borrow,
																		at,
																	),
																],
																exit = Owned.ReturnResult(
																	Owned.OwnedReturn(
																		ids.fourth,
																		Owned.owner_id(2),
																	),
																)
															},
														] },
												) },
										] }
								_:
									input
						_:
							input
				_:
					input
		_:
			input


pure func test_live_prefix_acquisition_must_be_discharged() -> Bool:
	run(pure func(ids, layout): rejects(
			prefix_projection_program(ids, layout, False),
			"owner 0 remains live at return",
			span(20),
		))


pure func test_discharged_prefix_acquisition_allows_match() -> Bool:
	run(pure func(ids, layout): verify(prefix_projection_program(ids, layout, True)).is_ok())


pure func test_discharged_scrutinee_rejects_tag_read() -> Bool:
	run(pure func(ids, layout):
		input = variant_program(
			ids,
			layout,
			None,
			Owned.OwnedResult(Owned.owner_id(0)),
		)

		match input.functions:
			[main, helper]:
				bad = { helper |
					signature = {
						parameters = [],
						return_type = Concrete.IntType
					},
					operations = helper.operations.append(
						Owned.DropOwner(
							Owned.owner_id(0),
							span(21),
						),
					),
					tail = Owned.MatchTail({
						scrutinee = Owned.BorrowedArgument({
							value = ids.second,
							source = Owned.OwnerBorrow(Owned.owner_id(0)),
						}),
						owner = layout.choice,
						arms = [
							{
								label = Lower.DefaultLabel,
								operations = [],
								exit = Owned.ReturnResult(Owned.UnmanagedReturn(ids.first))
							},
						],
					})
				}
				rejects(
					{ input | functions = [main, bad] },
					"borrow refers to discharged owner 0",
					span(20),
				)
			_:
				False
	)


private pure func unused_layout_program(
	ids: InputIds,
	layout: LayoutIds,
	unions: List[Concrete.ConcreteUnion],
) -> Owned.OwnershipProgram:
	{
		records = [],
		unions = unions,
		functions = [main_function(ids)],
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus)
	}


private pure func layout_span() -> Span:
	{
		source = COMPILER_SOURCE,
		start = 0,
		end = 0
	}


pure func test_unused_nested_owning_layout_is_accepted() -> Bool:
	run(pure func(ids, layout):
		verify(unused_layout_program(ids, layout, layouts(layout))).is_ok()
	)


pure func test_unused_string_layout_cannot_be_unmanaged() -> Bool:
	run(pure func(ids, layout):
		rejects(
			unused_layout_program(
				ids,
				layout,
				[
					{
						variants = [[], [Concrete.StringType]],
						representation = Concrete.InlineUnmanaged
					},
				],
			),
			"union ownership summary does not match its payloads",
			layout_span(),
		)
	)


