import:
	../../../src/lex/lex: lex
	../../../src/lower/lower as Lower
	../../../src/own/own as Owned
	../../../src/utils/source: COMPILER_SOURCE, module_source, root_module_id
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax:
		Diagnostic,
		Entrypoint(NoArguments), EntryResult(IntegerExitStatus),
		FunctionExecution(OrdinaryCalls, SelfTailLoop),
		Span,
		entry_function,
	../../../src/utils/text: concat
	../../../src/verify/verify: verify
	../input: check, parse, setup_diagnostic
	int as IntOps
	../managed_union_inputs: lowered, lowered_modules
	../module_input: INTEGER_OPERATIONS, STRING_OPERATIONS
	../ownership_inputs: InputIds, input_ids, span
	system: read_file
	test: TestSuite


private fixed record LayoutIds {
	box: Concrete.UnionInstanceId,
	boxed: Concrete.VariantInstanceId,
	boxed_field: Concrete.VariantFieldInstanceId,
	choice: Concrete.UnionInstanceId,
	left: Concrete.VariantInstanceId,
	left_field: Concrete.VariantFieldInstanceId,
	right: Concrete.VariantInstanceId,
	right_field: Concrete.VariantFieldInstanceId,
	other: Concrete.UnionInstanceId,
	othered: Concrete.VariantInstanceId,
	othered_field: Concrete.VariantFieldInstanceId,
	outer: Concrete.UnionInstanceId,
	wrapped: Concrete.VariantInstanceId,
	wrapped_field: Concrete.VariantFieldInstanceId
}


private pure func seed_error() -> Diagnostic:
	{
		span = span(0),
		note = None,
		message = "missing managed union verifier identity seed",
		help = "fix the verifier test seed"
	}


private pure func seed_variant(
	arm: Lower.LoweredArm,
) -> Result[Concrete.VariantInstanceId, Diagnostic]:
	match arm.label:
		Lower.VariantLabel(id):
			Ok(id)
		_:
			Err(seed_error())


-- Lowering supplies opaque identities only. These tests independently declare
-- every layout, operation, ownership obligation and borrow edge they verify.
private pure func layout_ids() -> Result[LayoutIds, Diagnostic]:
	source: String =
		|fixed union Box[T]:
		|    Box(T)
		|fixed union Choice[T]:
		|    Left(T)
		|    Right(T)
		|fixed union Other[T]:
		|    Other(T)
		|fixed union Outer[T]:
		|    Outer(T)
		|pure func box(value: Box[Int]) -> Int:
		|    match value:
		|        Box(item): item
		|pure func choice(value: Choice[Int]) -> Int:
		|    match value:
		|        Left(item): item
		|        Right(item): item
		|pure func other(value: Other[Int]) -> Int:
		|    match value:
		|        Other(item): item
		|pure func outer(value: Outer[Box[Int]]) -> Box[Int]:
		|    match value:
		|        Outer(item): item
		|func main() -> Int:
		|    first = box(Box(0))
		|    second = choice(Left(0))
		|    third = other(Other(0))
		|    fourth = outer(Outer(Box(0)))
		|    0
		|
	tokens ?= lex(module_source(root_module_id()), source)
	parsed ?= parse(tokens)
	checked ?= check(parsed).map_err(setup_diagnostic)
	concrete ?= Concrete.specialize(checked)
	lowered ?= Lower.lower(concrete)
	program = Lower.lowered_functions(lowered)

	match program.functions:
		[_, box, choice, other, outer]:
			match (box.tail, choice.tail, other.tail, outer.tail):
				(Lower.MatchValue(box), Lower.MatchValue(choice), Lower.MatchValue(other), Lower.MatchValue(outer)):
					match (box.arms, choice.arms, other.arms, outer.arms):
						([boxed], [left, right], [othered], [wrapped]):
							boxed ?= seed_variant(boxed)
							boxed_field ?= Concrete.variant_field(boxed, 0, program.unions, span(0))
							left ?= seed_variant(left)
							left_field ?= Concrete.variant_field(left, 0, program.unions, span(0))
							right ?= seed_variant(right)
							right_field ?= Concrete.variant_field(right, 0, program.unions, span(0))
							othered ?= seed_variant(othered)
							othered_field ?= Concrete.variant_field(othered, 0, program.unions, span(0))
							wrapped ?= seed_variant(wrapped)
							wrapped_field ?= Concrete.variant_field(wrapped, 0, program.unions, span(0))

							-- Raw catalog rows below use this explicit producer-issued order.
							if (
								IntOps.equals(
									Concrete.union_number(box.owner),
									0,
								)
								and IntOps.equals(
									Concrete.union_number(choice.owner),
									1,
								)
								and IntOps.equals(
									Concrete.union_number(other.owner),
									2,
								)
								and IntOps.equals(
									Concrete.union_number(outer.owner),
									3,
								)
								and IntOps.equals(
									Concrete.variant_number(boxed),
									0,
								)
								and IntOps.equals(
									Concrete.variant_number(left),
									0,
								)
								and IntOps.equals(
									Concrete.variant_number(right),
									1,
								)
								and IntOps.equals(
									Concrete.variant_number(othered),
									0,
								)
								and IntOps.equals(
									Concrete.variant_number(wrapped),
									0,
								)
							):
								Ok({
									box = box.owner,
									boxed = boxed,
									boxed_field = boxed_field,
									choice = choice.owner,
									left = left,
									left_field = left_field,
									right = right,
									right_field = right_field,
									other = other.owner,
									othered = othered,
									othered_field = othered_field,
									outer = outer.owner,
									wrapped = wrapped,
									wrapped_field = wrapped_field,
								})
							else:
								Err(seed_error())
						_:
							Err(seed_error())
				_:
					Err(seed_error())
		_:
			Err(seed_error())


private pure func run(test: pure (InputIds, LayoutIds) -> Bool) -> Bool:
	match (input_ids(), layout_ids()):
		(Ok(ids), Ok(layout)):
			IntOps.equals(
				Lower.value_number(ids.first),
				0,
			) and IntOps.equals(
				Lower.value_number(ids.second),
				1,
			) and IntOps.equals(
				Lower.value_number(ids.third),
				2,
			) and IntOps.equals(
				Lower.value_number(ids.fourth),
				3,
			) and IntOps.equals(
				Lower.value_number(ids.fifth),
				4,
			) and IntOps.equals(
				Concrete.function_number(ids.entrypoint),
				0,
			) and test(ids, layout)
		_:
			False


private pure func layouts(layout: LayoutIds) -> List[Concrete.ConcreteUnion]:
	[
		{
			variants = [[Concrete.StringType]],
			representation = Concrete.InlineOwningPayload
		},
		{
			variants = [[Concrete.StringType], [Concrete.StringType]],
			representation = Concrete.InlineOwningPayload
		},
		{
			variants = [[Concrete.StringType]],
			representation = Concrete.InlineOwningPayload
		},
		{
			variants = [[Concrete.UnionType(layout.box)]],
			representation = Concrete.InlineOwningPayload
		},
	]


private pure func parameter(
	id: Lower.ValueId,
	position: Int,
	value_type: Concrete.TypeRef,
	at: Int,
) -> Owned.OwnershipOperation:
	Owned.DefineValue({
		id = id,
		value_type = value_type,
		operation = Owned.ParameterDefinition(position),
		result = Owned.BorrowedResult(Owned.ParameterBorrow(id)),
		span = span(at),
	})


private pure func acquire(
	owner: Int,
	value: Lower.ValueId,
	source: Owned.BorrowSource,
	at: Int,
) -> Owned.OwnershipOperation:
	Owned.AcquireOwner(
		Owned.owner_id(owner),
		{
			value = value,
			source = source
		},
		span(at),
	)


private pure func constructed(
	id: Lower.ValueId,
	variant: Concrete.VariantInstanceId,
	payload: Owned.StoredPayload,
	result: Owned.ResultOwnership,
	at: Int,
) -> Owned.OwnershipOperation:
	Owned.DefineValue({
		id = id,
		value_type = Concrete.UnionType(Concrete.variant_owner(variant)),
		operation = Owned.ConstructDefinition(variant, [payload]),
		result = result,
		span = span(at),
	})


private pure func integer(id: Lower.ValueId, at: Int) -> Owned.OwnershipOperation:
	Owned.DefineValue({
		id = id,
		value_type = Concrete.IntType,
		operation = Owned.IntegerDefinition(7),
		result = Owned.UnmanagedResult,
		span = span(at),
	})


private pure func function(
	parameters: List[Concrete.TypeRef],
	return_type: Concrete.TypeRef,
	operations: List[Owned.OwnershipOperation],
	returned: Owned.ReturnTransfer,
) -> Owned.OwnedFunction:
	{
		execution = OrdinaryCalls,
		signature = {
			parameters = parameters,
			return_type = return_type
		},
		operations = operations,
		tail = Owned.ReturnTail(Owned.ReturnResult(returned))
	}


private pure func main_function(ids: InputIds) -> Owned.OwnedFunction:
	function(
		[],
		Concrete.IntType,
		[integer(ids.first, 0)],
		Owned.UnmanagedReturn(ids.first),
	)


private pure func program(
	ids: InputIds,
	layout: LayoutIds,
	helper: Owned.OwnedFunction,
) -> Owned.OwnershipProgram:
	{
		records = [],
		unions = layouts(layout),
		functions = [main_function(ids), helper],
		entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus)
	}


private pure func rejects(input: Owned.OwnershipProgram, message: String, expected: Span) -> Bool:
	match verify(input):
		Err(error):
			(
				error.message == "ownership verification failed: ".concat(message)
				and error.help == "report this compiler error with the input program"
				and error.span.start == expected.start
				and error.span.end == expected.end
				and error.note.is_none()
			)
		Ok(_):
			False


private pure func constructor_program(
	ids: InputIds,
	layout: LayoutIds,
	payload: Owned.StoredPayload,
	result: Owned.ResultOwnership,
	before: List[Owned.OwnershipOperation],
	after: List[Owned.OwnershipOperation],
) -> Owned.OwnershipProgram:
	program(
		ids,
		layout,
		function(
			[Concrete.StringType, Concrete.StringType],
			Concrete.UnionType(layout.box),
			[
				parameter(ids.first, 0, Concrete.StringType, 10),
				parameter(ids.second, 1, Concrete.StringType, 11),
			]
				.concat(before)
				.append(constructed(ids.third, layout.boxed, payload, result, 20))
				.concat(after),
			Owned.OwnedReturn(
				ids.third,
				Owned.owner_id(1),
			),
		),
	)


private pure func child_acquisition(ids: InputIds) -> Owned.OwnershipOperation:
	acquire(
		0,
		ids.first,
		Owned.ParameterBorrow(ids.first),
		12,
	)


pure func test_constructor_consumes_child_and_returns_aggregate() -> Bool:
	run(pure func(ids, layout):
		verify(
			constructor_program(
				ids,
				layout,
				Owned.OwnedPayload(
					ids.first,
					Owned.owner_id(0),
				),
				Owned.OwnedResult(Owned.owner_id(1)),
				[child_acquisition(ids)],
				[],
			),
		).is_ok()
	)


pure func test_constructor_requires_child_transfer() -> Bool:
	run(pure func(ids, layout):
		rejects(
			constructor_program(
				ids,
				layout,
				Owned.UnmanagedPayload(ids.first),
				Owned.OwnedResult(Owned.owner_id(1)),
				[child_acquisition(ids)],
				[],
			),
			"managed payload requires an owner transfer",
			span(20),
		)
	)


pure func test_constructor_rejects_owner_of_another_value() -> Bool:
	run(pure func(ids, layout):
		rejects(
			constructor_program(
				ids,
				layout,
				Owned.OwnedPayload(
					ids.first,
					Owned.owner_id(1),
				),
				Owned.OwnedResult(Owned.owner_id(2)),
				[child_acquisition(ids), acquire(
						1,
						ids.second,
						Owned.ParameterBorrow(ids.second),
						13,
					)],
				[],
			),
			"payload owner does not own the stored value",
			span(20),
		)
	)


pure func test_constructor_rejects_discharged_child() -> Bool:
	run(pure func(ids, layout):
		rejects(
			constructor_program(
				ids,
				layout,
				Owned.OwnedPayload(
					ids.first,
					Owned.owner_id(0),
				),
				Owned.OwnedResult(Owned.owner_id(1)),
				[child_acquisition(ids), Owned.DropOwner(
						Owned.owner_id(0),
						span(13),
					)],
				[],
			),
			"payload owner has already been discharged",
			span(20),
		)
	)


pure func test_constructor_rejects_repeated_child_transfer() -> Bool:
	run(pure func(ids, layout):
		rejects(
			constructor_program(
				ids,
				layout,
				Owned.OwnedPayload(
					ids.first,
					Owned.owner_id(0),
				),
				Owned.OwnedResult(Owned.owner_id(1)),
				[child_acquisition(ids)],
				[constructed(
						ids.fourth,
						layout.boxed,
						Owned.OwnedPayload(
							ids.first,
							Owned.owner_id(0),
						),
						Owned.OwnedResult(Owned.owner_id(2)),
						21,
					)],
			),
			"payload owner has already been discharged",
			span(21),
		)
	)


pure func test_constructor_requires_aggregate_owner() -> Bool:
	run(pure func(ids, layout):
		rejects(
			constructor_program(
				ids,
				layout,
				Owned.OwnedPayload(
					ids.first,
					Owned.owner_id(0),
				),
				Owned.UnmanagedResult,
				[child_acquisition(ids)],
				[],
			),
			"managed result requires an owner",
			span(20),
		)
	)


pure func test_constructor_rejects_equal_shaped_nominal_child() -> Bool:
	run(pure func(ids, layout):
		rejects(
			program(
				ids,
				layout,
				function(
					[Concrete.UnionType(layout.other)],
					Concrete.UnionType(layout.outer),
					[parameter(
							ids.first,
							0,
							Concrete.UnionType(layout.other),
							10,
						), acquire(
							0,
							ids.first,
							Owned.ParameterBorrow(ids.first),
							11,
						), constructed(
							ids.second,
							layout.wrapped,
							Owned.OwnedPayload(
								ids.first,
								Owned.owner_id(0),
							),
							Owned.OwnedResult(Owned.owner_id(1)),
							20,
						)],
					Owned.OwnedReturn(
						ids.second,
						Owned.owner_id(1),
					),
				),
			),
			"variant payload does not match its operation",
			span(20),
		)
	)


private pure func aliased_aggregate(
	ids: InputIds,
	layout: LayoutIds,
	after: List[Owned.OwnershipOperation],
) -> Owned.OwnershipProgram:
	program(
		ids,
		layout,
		function(
			[Concrete.StringType],
			Concrete.UnionType(layout.box),
			[parameter(ids.first, 0, Concrete.StringType, 10), child_acquisition(ids), constructed(
					ids.second,
					layout.boxed,
					Owned.OwnedPayload(
						ids.first,
						Owned.owner_id(0),
					),
					Owned.OwnedResult(Owned.owner_id(1)),
					20,
				), acquire(
					2,
					ids.second,
					Owned.OwnerBorrow(Owned.owner_id(1)),
					21,
				)].concat(after),
			Owned.OwnedReturn(
				ids.second,
				Owned.owner_id(2),
			),
		),
	)


pure func test_independent_aggregate_owner_survives_original_drop() -> Bool:
	run(pure func(ids, layout):
		verify(aliased_aggregate(ids, layout, [Owned.DropOwner(
						Owned.owner_id(1),
						span(22),
					)])).is_ok()
	)


pure func test_extra_acquisition_does_not_reactivate_original_owner() -> Bool:
	run(pure func(ids, layout):
		rejects(
			aliased_aggregate(
				ids,
				layout,
				[Owned.DropOwner(
						Owned.owner_id(1),
						span(22),
					), acquire(
						3,
						ids.second,
						Owned.OwnerBorrow(Owned.owner_id(1)),
						23,
					)],
			),
			"borrow refers to discharged owner 1",
			span(23),
		)
	)


private pure func variant_program(
	ids: InputIds,
	layout: LayoutIds,
	payload: Option[Concrete.TypeRef],
	result: Owned.ResultOwnership,
) -> Owned.OwnershipProgram:
	operation = match payload:
		None:
			Owned.DefineValue({
				id = ids.second,
				value_type = Concrete.UnionType(layout.choice),
				operation = Owned.ConstructDefinition(layout.left, []),
				result = result,
				span = span(20),
			})
		Some(_):
			constructed(
				ids.second,
				layout.left,
				Owned.UnmanagedPayload(ids.first),
				result,
				20,
			)

	input = program(
		ids,
		layout,
		function(
			[],
			Concrete.UnionType(layout.choice),
			[integer(ids.first, 10), operation],
			Owned.OwnedReturn(
				ids.second,
				Owned.owner_id(0),
			),
		),
	)
	fields: List[Concrete.TypeRef] = match payload:
		None: []
		Some(value_type): [value_type]

	{ input | unions = layouts(layout).set(
			1,
			{
				variants = [fields, [Concrete.StringType]],
				representation = Concrete.InlineOwningPayload
			},
		) }


pure func test_nullary_variant_has_aggregate_owner() -> Bool:
	run(pure func(ids, layout):
		verify(variant_program(ids, layout, None, Owned.OwnedResult(Owned.owner_id(0)))).is_ok()
	)


pure func test_nullary_variant_requires_aggregate_owner() -> Bool:
	run(pure func(ids, layout):
		rejects(
			variant_program(ids, layout, None, Owned.UnmanagedResult),
			"managed result requires an owner",
			span(20),
		)
	)


pure func test_unmanaged_active_variant_has_aggregate_owner() -> Bool:
	run(pure func(ids, layout):
		verify(
			variant_program(
				ids,
				layout,
				Some(Concrete.IntType),
				Owned.OwnedResult(Owned.owner_id(0)),
			),
		).is_ok()
	)


pure func test_unmanaged_active_variant_requires_aggregate_owner() -> Bool:
	run(pure func(ids, layout):
		rejects(
			variant_program(ids, layout, Some(Concrete.IntType), Owned.UnmanagedResult),
			"managed result requires an owner",
			span(20),
		)
	)


pure func test_unmanaged_payload_cannot_transfer_owner() -> Bool:
	run(pure func(ids, layout):
		input = variant_program(
			ids,
			layout,
			Some(Concrete.IntType),
			Owned.OwnedResult(Owned.owner_id(0)),
		)
		bad = function(
			[],
			Concrete.UnionType(layout.choice),
			[integer(ids.first, 10), constructed(
					ids.second,
					layout.left,
					Owned.OwnedPayload(
						ids.first,
						Owned.owner_id(0),
					),
					Owned.OwnedResult(Owned.owner_id(1)),
					20,
				)],
			Owned.OwnedReturn(
				ids.second,
				Owned.owner_id(1),
			),
		)
		rejects(
			{ input | functions = [main_function(ids), bad] },
			"unmanaged payload cannot transfer an owner",
			span(20),
		)
	)


private pure func projected(
	id: Lower.ValueId,
	field: Concrete.VariantFieldInstanceId,
	parent: Lower.ValueId,
	source: Owned.BorrowSource,
	at: Int,
) -> Owned.OwnershipOperation:
	Owned.DefineValue({
		id = id,
		value_type = Concrete.StringType,
		operation = Owned.PayloadDefinition(field, parent),
		result = Owned.BorrowedResult(source),
		span = span(at),
	})


private pure func projection_program(
	ids: InputIds,
	layout: LayoutIds,
	first_operations: List[Owned.OwnershipOperation],
	returned: Owned.ReturnTransfer,
	prefix: List[Owned.OwnershipOperation],
) -> Owned.OwnershipProgram:
	program(
		ids,
		layout,
		{
			execution = OrdinaryCalls,
			signature = {
				parameters = [Concrete.UnionType(layout.choice), Concrete.UnionType(layout.choice)],
				return_type = Concrete.StringType
			},
			operations = [parameter(
					ids.first,
					0,
					Concrete.UnionType(layout.choice),
					10,
				), parameter(
					ids.second,
					1,
					Concrete.UnionType(layout.choice),
					11,
				)].concat(prefix),
			tail = Owned.MatchTail({
				scrutinee = Owned.BorrowedArgument({ value = ids.first, source = Owned.ParameterBorrow(ids.first) }),
				owner = layout.choice,
				arms = [
					{
						label = Lower.VariantLabel(layout.left),
						operations = first_operations,
						exit = Owned.ReturnResult(returned)
					},
					{
						label = Lower.VariantLabel(layout.right),
						operations = [projected(
								ids.fourth,
								layout.right_field,
								ids.first,
								Owned.PayloadBorrow(ids.first),
								30,
							), acquire(
								1,
								ids.fourth,
								Owned.PayloadBorrow(ids.first),
								31,
							)],
						exit = Owned.ReturnResult(Owned.OwnedReturn(ids.fourth, Owned.owner_id(1)))
					},
				],
			})
		},
	)


private pure func projection(
	ids: InputIds,
	layout: LayoutIds,
	field: Concrete.VariantFieldInstanceId,
	parent: Lower.ValueId,
	source: Owned.BorrowSource,
) -> Owned.OwnershipProgram:
	projection_program(
		ids,
		layout,
		[projected(ids.third, field, parent, source, 20), acquire(
				0,
				ids.third,
				Owned.PayloadBorrow(ids.first),
				21,
			)],
		Owned.OwnedReturn(
			ids.third,
			Owned.owner_id(0),
		),
		[],
	)


pure func test_selected_payload_returns_independent_owner() -> Bool:
	run(pure func(ids, layout):
		verify(
			projection(
				ids,
				layout,
				layout.left_field,
				ids.first,
				Owned.PayloadBorrow(ids.first),
			),
		).is_ok()
	)


pure func test_selected_nested_aggregate_returns_independent_owner() -> Bool:
	run(pure func(ids, layout):
		verify(
			program(
				ids,
				layout,
				{
					execution = OrdinaryCalls,
					signature = {
						parameters = [Concrete.UnionType(layout.outer)],
						return_type = Concrete.UnionType(layout.box)
					},
					operations = [parameter(
							ids.first,
							0,
							Concrete.UnionType(layout.outer),
							10,
						)],
					tail = Owned.MatchTail({
						scrutinee = Owned.BorrowedArgument({ value = ids.first, source = Owned.ParameterBorrow(ids.first) }),
						owner = layout.outer,
						arms = [
							{
								label = Lower.VariantLabel(layout.wrapped),
								operations = [Owned.DefineValue({
										id = ids.second,
										value_type = Concrete.UnionType(layout.box),
										operation = Owned.PayloadDefinition(
											layout.wrapped_field,
											ids.first,
										),
										result = Owned.BorrowedResult(
											Owned.PayloadBorrow(ids.first),
										),
										span = span(20),
									}), acquire(
										0,
										ids.second,
										Owned.PayloadBorrow(ids.first),
										21,
									)],
								exit = Owned.ReturnResult(
									Owned.OwnedReturn(
										ids.second,
										Owned.owner_id(0),
									),
								)
							},
						],
					})
				},
			),
		).is_ok()
	)


