import:
	../../../src/own/own as Own
	../../../src/verify/verify: verify
	../../../src/utils/source: module_source, root_module_id, same_source
	../constant_inputs: TWICE, owned
	test: TestSuite


pure func test_independent_string_obligations_verify() -> Bool:
	owned(TWICE).and_then(pure func(program): verify(program)).is_ok()


pure func test_missing_second_materialized_string_drop_is_rejected() -> Bool:
	match owned(TWICE):
		Err(_): False
		Ok(program):
			keep_operation = pure func(operation: Own.OwnershipOperation) -> Bool:
				match operation:
					Own.DropOwner(owner, _): Own.owner_number(owner) != 1
					_: True
			functions = program.functions.map(pure func(function):
				{ function | operations = function.operations.filter(keep_operation) }
			)
			broken = { program | functions = functions }
			match verify(broken):
				Ok(_): False
				Err(error):
					start = TWICE.length() - "0\n".length()
					(error.message == "ownership verification failed: owner 1 remains live at return"
						and error.help == "report this compiler error with the input program" and error.note.is_none()
						and same_source(error.span.source, module_source(root_module_id()))
						and error.span.start == start and error.span.end == start + 1)


tests: TestSuite = {
	description = "Independent constant use ownership verification",
	tests = [
		("separate String materializations verify", test_independent_string_obligations_verify),
		("missing second String drop fails independently", test_missing_second_materialized_string_drop_is_rejected),
	]
}
