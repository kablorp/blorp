import:
	../../../src/own/own as Own
	../../../src/verify/verify: verify
	../../../src/utils/source: module_source, root_module_id, same_source
	../constant_inputs: TWICE, AGGREGATE_TWICE, owned
	test: TestSuite


pure func test_independent_string_obligations_verify() -> Bool:
	owned(TWICE).and_then(pure func(program): verify(program)).is_ok()


pure func test_missing_second_materialized_string_drop_is_rejected() -> Bool:
	match owned(TWICE):
		Err(_): False
		Ok(program):
			keep_operation = pure func(operation: Own.OwnershipOperation) -> Bool:
				match operation:
					Own.DropOwner(owner, _): Own.owner_number(owner) != 1
					_: True
			functions = program.functions.map(pure func(function):
				{ function | operations = function.operations.filter(keep_operation) }
			)
			broken = { program | functions = functions }
			match verify(broken):
				Ok(_): False
				Err(error):
					start = TWICE.length() - "0\n".length()
					(error.message == "ownership verification failed: owner 1 remains live at return"
						and error.help == "report this compiler error with the input program" and error.note.is_none()
						and same_source(error.span.source, module_source(root_module_id()))
						and error.span.start == start and error.span.end == start + 1)


pure func test_independent_aggregate_obligations_verify() -> Bool:
	owned(AGGREGATE_TWICE).and_then(pure func(program): verify(program)).is_ok()


pure func test_missing_aggregate_root_drop_is_rejected() -> Bool:
	match owned(AGGREGATE_TWICE):
		Err(_): False
		Ok(program):
			var selected: Option[Own.OwnerId] = None
			for function in program.functions:
				for operation in function.operations:
					match operation:
						Own.DefineValue(definition):
							match (definition.operation, definition.result):
								(Own.ConstructRecordDefinition(_, _), Own.OwnedResult(owner)): selected = Some(owner)
								_: void
						_: void
			match selected:
				None: False
				Some(target):
					keep = pure func(operation: Own.OwnershipOperation) -> Bool:
						match operation:
							Own.DropOwner(owner, _): Own.owner_number(owner) != Own.owner_number(target)
							_: True
					broken = { program | functions = program.functions.map(pure func(function): { function | operations = function.operations.filter(keep) }) }
					match verify(broken):
						Ok(_): False
						Err(error):
							start = AGGREGATE_TWICE.length() - "0\n".length()
							(error.message == "ownership verification failed: owner " + Own.owner_number(target).to_string() + " remains live at return"
								and error.help == "report this compiler error with the input program" and error.note.is_none()
								and same_source(error.span.source, module_source(root_module_id())) and error.span.start == start and error.span.end == start + 1)


tests: TestSuite = {
	description = "Independent constant use ownership verification",
	tests = [
		("separate String materializations verify", test_independent_string_obligations_verify),
		("missing second String drop fails independently", test_missing_second_materialized_string_drop_is_rejected),
		("separate aggregate materializations verify", test_independent_aggregate_obligations_verify),
		("missing aggregate root drop fails independently", test_missing_aggregate_root_drop_is_rejected),
	]
}
