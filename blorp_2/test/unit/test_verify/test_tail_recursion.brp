	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects(
				ids,
				{ original |
					signature = { original.signature | parameters = [StringType, IntType] }
				},
				90,
				"managed signature in a self-tail loop",
			)


pure func test_managed_return_signature() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects(
				ids,
				{ original | signature = { original.signature | return_type = StringType } },
				90,
				"managed signature in a self-tail loop",
			)


pure func test_managed_intermediate_even_after_drop() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			managed: OwnedDefinition = {
				id = ids.third,
				value_type = StringType,
				operation = CallDefinition(
					RuntimeFunction(Builtins.IntToString),
					[UnmanagedArgument(ids.first)],
				),
				result = OwnedResult(owner_id(0)),
				span = span(30)
			}
			rejects(
				ids,
				{ original | operations = original.operations
						.append(DefineValue(managed))
						.append(DropOwner(owner_id(0), span(40))) },
				30,
				"managed value appears in a self-tail loop",
			)


