							changed = { runtime_loop | headers = [{ header | initial = UnmanagedReturn(ids.third) }, other] }
							rejects(ids, { original | operations = [first, second, ExecuteLoop(changed)] }, 10, "value 2 is not defined before use")
						_: False
				_: False


