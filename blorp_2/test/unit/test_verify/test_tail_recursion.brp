import:
	../../../src/lower/lower: MatchLabel(DefaultLabel, VariantLabel)
	../../../src/own/own:
		BorrowSource(ParameterBorrow, OwnerBorrow),
		OwnedArgument(UnmanagedArgument),
		OwnedDefinition,
		OwnedExit(ReturnResult, RecurArguments),
		OwnedFunction,
		OwnedJoinParameter(UnmanagedJoinParameter, ManagedJoinParameter),
		OwnedTail(ReturnTail, MatchTail),
		OwnedValueOperation(
			ParameterDefinition, IntegerDefinition, CallDefinition,
			ConstructDefinition, StringDefinition, VoidDefinition,
		),
		OwnershipOperation(DefineValue, ExecuteJoin, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		StoredPayload(UnmanagedPayload),
		owner_id,
	../../../src/namespace/builtins as Builtins: RuntimeOperation(IntToString)
	../../../src/specialize/specialize:
		CallTarget(UserFunction, RuntimeFunction),
		TypeRef(IntType, StringType, UnionType, VoidType),
	../../../src/utils/syntax: FunctionExecution(OrdinaryCalls, SelfTailLoop), same_span, Entrypoint(NoArguments), EntryResult(IntegerExitStatus), entry_function
	../../../src/verify/verify: verify
	../ownership_inputs: InputIds, input_ids, span
	test: TestSuite


-- The seed issues opaque identities only. Every verifier input is built here,
-- independently of ownership insertion and its execution/admission decisions.
private pure func loop(ids: InputIds) -> OwnedFunction:
	{
		execution = SelfTailLoop(span(90)),
		signature = {
			parameters = [IntType, IntType],
			return_type = IntType
		},
		operations = [DefineValue({
				id = ids.first,
				value_type = IntType,
				operation = ParameterDefinition(0),
				result = UnmanagedResult,
				span = span(10),
			}), DefineValue({
				id = ids.second,
				value_type = IntType,
				operation = ParameterDefinition(1),
				result = UnmanagedResult,
				span = span(20),
			})],
		tail = ReturnTail(
			RecurArguments(
				[ids.second, ids.first],
				span(80),
			),
		)
	}


private pure func program(ids: InputIds, function: OwnedFunction) -> OwnershipProgram:
	{
		records = [],
		unions = ids.unions,
		functions = [
			function,
			{
				execution = OrdinaryCalls,
				signature = {
					parameters = [],
					return_type = IntType
				},
				operations = [DefineValue({
						id = ids.first,
						value_type = IntType,
						operation = IntegerDefinition(7),
						result = UnmanagedResult,
						span = span(1),
					})],
				tail = ReturnTail(ReturnResult(UnmanagedReturn(ids.first)))
			},
		],
		entrypoint = NoArguments(ids.second_function, IntegerExitStatus)
	}


private pure func rejects(
	ids: InputIds,
	function: OwnedFunction,
	at: Int,
	message: String,
) -> Bool:
	match verify(program(ids, function)):
		Ok(_):
			False
		Err(error):
			(
				same_span(error.span, span(at))
				and error.message == "ownership verification failed: " + message
				and error.help == "report this compiler error with the input program"
				and error.note.is_none()
			)


pure func test_valid_permutation() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match verify(program(ids, loop(ids))):
				Ok(_):
					True
				Err(_):
					False


pure func test_valid_duplicate() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)

			match (
				verify(
					program(
						ids,
						{ original | tail = ReturnTail(
								RecurArguments(
									[ids.first, ids.first],
									span(80),
								),
							) },
					),
				)
			):
				Ok(_):
					True
				Err(_):
					False


pure func test_zero_argument_entry_loop() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			raw = program(ids, loop(ids))
			function: OwnedFunction = {
				execution = SelfTailLoop(span(90)),
				signature = {
					parameters = [],
					return_type = IntType
				},
				operations = [],
				tail = ReturnTail(RecurArguments([], span(80)))
			}

			match verify({ raw |
					functions = [function],
					entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus)
				}):
				Ok(_):
					True
				Err(_):
					False


pure func test_backedge_outside_loop() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects(
				ids,
				{ original | execution = OrdinaryCalls },
				80,
				"recursive backedge outside a self-tail loop",
			)


pure func test_wrong_arity() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects(
				ids,
				{ original | tail = ReturnTail(RecurArguments([ids.first], span(80))) },
				80,
				"recursive backedge arity does not match its function",
			)


pure func test_wrong_nominal_type() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			variant: OwnedDefinition = {
				id = ids.third,
				value_type = UnionType(ids.union_id),
				operation = ConstructDefinition(ids.second_variant, []),
				result = UnmanagedResult,
				span = span(30)
			}
			rejects(
				ids,
				{ original |
					operations = original.operations.append(DefineValue(variant)),
					tail = ReturnTail(
						RecurArguments(
							[ids.third, ids.first],
							span(80),
						),
					)
				},
				80,
				"recursive backedge type does not match its parameter",
			)


pure func test_undefined_terminal_operand() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects(
				ids,
				{ original | tail = ReturnTail(
						RecurArguments(
							[ids.third, ids.first],
							span(80),
						),
					) },
				80,
				"value 2 is not defined before use",
			)


pure func test_forward_operand_in_definition() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			forward: OwnedDefinition = {
				id = ids.third,
				value_type = UnionType(ids.union_id),
				operation = ConstructDefinition(ids.second_variant, [UnmanagedPayload(ids.fourth)]),
				result = UnmanagedResult,
				span = span(30)
			}
			later: OwnedDefinition = {
				id = ids.fourth,
				value_type = IntType,
				operation = IntegerDefinition(7),
				result = UnmanagedResult,
				span = span(40)
			}
			rejects(
				ids,
				{ original | operations = original.operations
						.append(DefineValue(forward))
						.append(DefineValue(later)) },
				30,
				"value 3 is not defined before use",
			)


pure func test_ordinary_self_call_in_prefix() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			call: OwnedDefinition = {
				id = ids.third,
				value_type = IntType,
				operation = CallDefinition(
					UserFunction(ids.entrypoint),
					[UnmanagedArgument(ids.first), UnmanagedArgument(ids.second)],
				),
				result = UnmanagedResult,
				span = span(30)
			}
			rejects(
				ids,
				{ original | operations = original.operations.append(DefineValue(call)) },
				30,
				"ordinary self call remains in a self-tail loop",
			)


pure func test_loop_without_backedge() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects(
				ids,
				{ original | tail = ReturnTail(ReturnResult(UnmanagedReturn(ids.first))) },
				90,
				"self-tail loop has no recursive backedge",
			)


