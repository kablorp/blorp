private pure func aliased_loop(ids: InputIds) -> OwnedLoop:
	{
		entry_acquisitions = [],
		headers = [],
		result = ManagedJoinParameter(
			{ id = ids.first, value_type = StringType, span = span(10) },
			owner_id(0),
		),
		carried = [ManagedJoinParameter(
			{ id = ids.second, value_type = StringType, span = span(20) },
			owner_id(1),
		)],
		body = {
			operations = [
				DefineValue({
					id = ids.third,
					value_type = StringType,
					operation = StringDefinition("local"),
					result = OwnedResult(owner_id(2)),
					span = span(30)
				}),
				AcquireOwner(owner_id(3), { value = ids.third, source = OwnerBorrow(owner_id(2)) }, span(40)),
				AcquireOwner(owner_id(4), { value = ids.third, source = OwnerBorrow(owner_id(2)) }, span(50)),
				DropOwner(owner_id(2), span(60)),
			],
			tail = ExitLoop(Break({
				value = OwnedReturn(ids.third, owner_id(3)),
				carried = [OwnedReturn(ids.third, owner_id(4))],
				span = span(90)
			}))
		}
	}


pure func test_raw_loop_alias_outputs_use_distinct_obligations() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			verify(program(ids, {
				signature = { parameters = [], return_type = StringType },
				operations = [ExecuteLoop(aliased_loop(ids)), DropOwner(owner_id(1), span(100))],
				result = OwnedReturn(ids.first, owner_id(0))
			})).is_ok()


pure func test_raw_loop_alias_outputs_reject_reused_obligation() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = aliased_loop(ids)
			bad = { original | body = { original.body | tail = ExitLoop(Break({
				value = OwnedReturn(ids.third, owner_id(3)),
				carried = [OwnedReturn(ids.third, owner_id(3))],
				span = span(90)
			})) } }
			rejects(ids, {
				signature = { parameters = [], return_type = StringType },
				operations = [ExecuteLoop(bad), DropOwner(owner_id(1), span(100))],
				result = OwnedReturn(ids.first, owner_id(0))
			}, 90, "loop transfer refers to a discharged owner")


pure func test_raw_loop_alias_outputs_require_each_obligation() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = aliased_loop(ids)
			bad = { original | body = { original.body | tail = ExitLoop(Break({
				value = OwnedReturn(ids.third, owner_id(3)),
				carried = [UnmanagedReturn(ids.third)],
				span = span(90)
			})) } }
			rejects(ids, {
				signature = { parameters = [], return_type = StringType },
				operations = [ExecuteLoop(bad), DropOwner(owner_id(1), span(100))],
				result = OwnedReturn(ids.first, owner_id(0))
			}, 90, "managed yield requires an owner transfer")


pure func test_raw_loop_alias_outputs_reject_direct_local_move() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = aliased_loop(ids)
			match original.body.operations:
				[local, acquire, _, _]:
					direct = { original | body = {
						operations = [local, acquire],
						tail = ExitLoop(Break({
							value = OwnedReturn(ids.third, owner_id(2)),
							carried = [OwnedReturn(ids.third, owner_id(3))],
							span = span(90)
						}))
					} }
					rejects(ids, {
						signature = { parameters = [], return_type = StringType },
						operations = [ExecuteLoop(direct), DropOwner(owner_id(1), span(100))],
						result = OwnedReturn(ids.first, owner_id(0))
					}, 90, "loop transfer must use a fresh acquisition")
				_: False


pure func test_raw_loop_alias_outputs_accept_acquire_before_local_drop() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = aliased_loop(ids)
			match original.body.operations:
				[local, first, second, dropped]:
					acquired = { original | body = {
						operations = [local, first, second, dropped],
						tail = ExitLoop(Break({
							value = OwnedReturn(ids.third, owner_id(3)),
							carried = [OwnedReturn(ids.third, owner_id(4))],
							span = span(90)
						}))
					} }
					verify(program(ids, {
						signature = { parameters = [], return_type = StringType },
						operations = [ExecuteLoop(acquired), DropOwner(owner_id(1), span(100))],
						result = OwnedReturn(ids.first, owner_id(0))
					})).is_ok()
				_: False


private pure func pre_loop(ids: InputIds) -> Own.OwnedFunction:
	{
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = [
			Own.DefineValue({
				id = ids.first,
				value_type = Concrete.StringType,
				operation = Own.StringDefinition("PRE"),
				result = Own.OwnedResult(Own.owner_id(0)),
				span = span(10)
			}),
			Own.DefineValue({
				id = ids.second,
				value_type = Concrete.IntType,
				operation = Own.IntegerDefinition(7),
				result = Own.UnmanagedResult,
				span = span(20)
			}),
			Own.ExecuteLoop({
				entry_acquisitions = [],
				headers = [{
					parameter = Own.UnmanagedJoinParameter({
						id = ids.fifth,
						value_type = Concrete.IntType,
						span = span(50)
					}),
					initial = Own.UnmanagedReturn(ids.second)
				}],
				result = Own.UnmanagedJoinParameter({
					id = ids.third,
					value_type = Concrete.IntType,
					span = span(30)
				}),
				carried = [],
				body = {
					operations = [
						Own.DefineValue({
							id = ids.sixth,
							value_type = Concrete.StringType,
							operation = Own.StringDefinition("local"),
							result = Own.OwnedResult(Own.owner_id(1)),
							span = span(60)
						}),
						Own.DefineValue({
							id = ids.seventh,
							value_type = Concrete.UnionType(ids.union_id),
							operation = Own.ConstructDefinition(ids.second_variant, []),
							result = Own.UnmanagedResult,
							span = span(70)
						}),
					],
					tail = Own.MatchLoop({
						selection = Selection.direct(Own.UnmanagedArgument(ids.seventh)),
						arms = [{ id = Model.match_arm_id(0), inputs = [], body = { operations = [Own.DropOwner(Own.owner_id(1), span(80))], tail = Own.ExitLoop(Own.Break({
								value = Own.UnmanagedReturn(ids.fifth),
								carried = [],
								span = span(90)
							})) } }],
					})
				}
			}),
			Own.DefineValue({
				id = ids.fourth,
				value_type = Concrete.IntType,
				operation = Own.CallDefinition(
					Concrete.RuntimeFunction(Builtins.StringLength),
					[Own.BorrowedArgument({
						value = ids.first,
						source = Own.OwnerBorrow(Own.owner_id(0))
					})],
				),
				result = Own.UnmanagedResult,
				span = span(100)
			}),
			Own.DropOwner(Own.owner_id(0), span(110)),
		],
		result = Own.UnmanagedReturn(ids.fourth)
	}


pure func test_raw_loop_keeps_pre_owner_for_continuation() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids): verify(program(ids, pre_loop(ids))).is_ok()


pure func test_raw_loop_break_arm_cannot_discharge_pre_owner() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = pre_loop(ids)
			match original.operations:
				[pre, seed, ExecuteLoop(runtime_loop), read, drop]:
					match runtime_loop.body.tail:
						MatchLoop(matched):
							match matched.arms:
								[arm]:
									changed = { arm | body = { arm.body | operations = [DropOwner(owner_id(1), span(80)), DropOwner(owner_id(0), span(81))] } }
									changed_loop = { runtime_loop | body = { runtime_loop.body |
										tail = MatchLoop({ matched | arms = [changed] })
									} }
									rejects(ids, { original | operations = [pre, seed, ExecuteLoop(changed_loop), read, drop] }, 90, "loop edge discharges a captured owner")
								_: False
						_: False
				_: False


pure func test_raw_loop_recur_arm_cannot_discharge_pre_owner() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = pre_loop(ids)
			match original.operations:
				[pre, seed, ExecuteLoop(runtime_loop), read, drop]:
					match runtime_loop.body.tail:
						MatchLoop(matched):
							match matched.arms:
								[arm]:
									changed = { arm | body = { arm.body | operations = [DropOwner(owner_id(1), span(80)), DropOwner(owner_id(0), span(81))], tail = Own.ExitLoop(Recur([UnmanagedReturn(ids.fifth)], span(90))) } }
									changed_loop = { runtime_loop | body = { runtime_loop.body |
										tail = MatchLoop({ matched | arms = [changed] })
									} }
									rejects(ids, { original | operations = [pre, seed, ExecuteLoop(changed_loop), read, drop] }, 90, "loop edge discharges a captured owner")
								_: False
						_: False
				_: False


pure func test_raw_loop_arm_must_retire_old_body_local() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = pre_loop(ids)
			match original.operations:
				[pre, seed, ExecuteLoop(runtime_loop), read, drop]:
					match runtime_loop.body.tail:
						MatchLoop(matched):
							match matched.arms:
								[arm]:
									changed = { arm | body = { arm.body | operations = [] } }
									changed_loop = { runtime_loop | body = { runtime_loop.body |
										tail = MatchLoop({ matched | arms = [changed] })
									} }
									rejects(ids, { original | operations = [pre, seed, ExecuteLoop(changed_loop), read, drop] }, 90, "loop-local owner remains live at an edge")
								_: False
						_: False
				_: False


pure func test_raw_loop_arm_cannot_reacquire_discharged_body_local() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = pre_loop(ids)
			match original.operations:
				[pre, seed, ExecuteLoop(runtime_loop), read, drop]:
					match runtime_loop.body.tail:
						MatchLoop(matched):
							match matched.arms:
								[arm]:
									changed = { arm | body = { arm.body | operations = [
										DropOwner(owner_id(1), span(80)),
										AcquireOwner(owner_id(2), { value = ids.sixth, source = OwnerBorrow(owner_id(1)) }, span(82)),
									] } }
									changed_loop = { runtime_loop | body = { runtime_loop.body |
										tail = MatchLoop({ matched | arms = [changed] })
									} }
									rejects(ids, { original | operations = [pre, seed, ExecuteLoop(changed_loop), read, drop] }, 82, "borrow refers to discharged owner 1")
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Independent common runtime Loop verification",
	tests = [
		("raw loop arm cannot reacquire discharged body local", test_raw_loop_arm_cannot_reacquire_discharged_body_local),
		("raw loop arm must retire old body local", test_raw_loop_arm_must_retire_old_body_local),
		("raw loop recur arm cannot discharge pre owner", test_raw_loop_recur_arm_cannot_discharge_pre_owner),
		("raw loop break arm cannot discharge pre owner", test_raw_loop_break_arm_cannot_discharge_pre_owner),
		("raw loop keeps pre owner for continuation", test_raw_loop_keeps_pre_owner_for_continuation),
		("raw loop alias outputs reject direct local move", test_raw_loop_alias_outputs_reject_direct_local_move),
		("raw loop alias outputs accept acquire before local drop", test_raw_loop_alias_outputs_accept_acquire_before_local_drop),
		("raw loop alias outputs require each obligation", test_raw_loop_alias_outputs_require_each_obligation),
		("raw loop alias outputs reject reused obligation", test_raw_loop_alias_outputs_reject_reused_obligation),
		("raw loop alias outputs use distinct obligations", test_raw_loop_alias_outputs_use_distinct_obligations),
		("valid permutation", test_valid_permutation),
		("valid duplicate", test_valid_duplicate),
		("zero argument entry loop", test_zero_argument_entry_loop),
		("backedge outside loop", test_backedge_outside_loop),
		("wrong arity", test_wrong_arity),
		("wrong nominal type", test_wrong_nominal_type),
		("undefined terminal operand", test_undefined_terminal_operand),
		("forward operand in definition", test_forward_operand_in_definition),
		("owner operation on backedge", test_owner_operation_on_backedge),
		("falsified unmanaged operation type", test_falsified_unmanaged_operation_type),
		("sibling terminal operand", test_sibling_terminal_operand),
		("raw loop initial cannot read parent output", test_raw_loop_initial_cannot_read_parent_output),
		("raw loop initial cannot read header", test_raw_loop_initial_cannot_read_header),
		("raw loop initial requires header nominal type", test_raw_loop_initial_requires_header_nominal_type),
		("raw loop header identity cannot overlap parent", test_raw_loop_header_identity_cannot_overlap_parent),
		("raw loop break requires output arity", test_raw_loop_break_requires_output_arity),
		("raw loop break requires output nominal type", test_raw_loop_break_requires_output_nominal_type),
		("raw loop accepts break without recur", test_raw_loop_accepts_break_without_recur),
	]
}
