pure func test_sibling_terminal_operand() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = loop(ids)
			match original.operations:
				[first, second, ExecuteLoop(runtime_loop)]:
					changed = { runtime_loop | body = {
						operations = [DefineValue({
							id = ids.sixth,
							value_type = UnionType(ids.union_id),
							operation = ConstructDefinition(ids.second_variant, []),
							result = UnmanagedResult,
							span = span(20)
						})],
						tail = MatchLoop({
							selection = Selection.branches(UnmanagedArgument(ids.sixth), ids.second_variant),
							arms = [
								{ id = Model.match_arm_id(0), inputs = [], body = { operations = [DefineValue({
									id = ids.seventh,
									value_type = IntType,
									operation = IntegerDefinition(7),
									result = UnmanagedResult,
									span = span(30)
								})], tail = Own.ExitLoop(Break({ value = UnmanagedReturn(ids.fourth), carried = [], span = span(70) })) } },
								{ id = Model.match_arm_id(1), inputs = [], body = { operations = [], tail = Own.ExitLoop(Recur([UnmanagedReturn(ids.seventh), UnmanagedReturn(ids.fifth)], span(80))) } },
							],
						})
					} }
					rejects(ids, { original | operations = [first, second, ExecuteLoop(changed)] }, 80, "value 6 is not defined before use")
				_: False


