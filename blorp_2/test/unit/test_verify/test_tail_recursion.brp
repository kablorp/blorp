			)


pure func test_owner_operation_on_backedge() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			rejects(
				ids,
				{ original | operations = original.operations.append(
						AcquireOwner(
							owner_id(0),
							{
								value = ids.first,
								source = ParameterBorrow(ids.first)
							},
							span(40),
						),
					) },
				40,
				"owner operation appears in a self-tail loop",
			)


pure func test_falsified_unmanaged_operation_type() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			managed: OwnedDefinition = {
				id = ids.third,
				value_type = IntType,
				operation = CallDefinition(
					RuntimeFunction(Builtins.IntToString),
					[UnmanagedArgument(ids.first)],
				),
				result = UnmanagedResult,
				span = span(30)
			}
			rejects(
				ids,
				{ original | operations = original.operations.append(DefineValue(managed)) },
				30,
				"call result type does not match its contract",
			)


pure func test_sibling_terminal_operand() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			function: OwnedFunction = { original |
				signature = { original.signature | parameters = [IntType] },
				operations = [DefineValue({
						id = ids.first,
						value_type = IntType,
						operation = ParameterDefinition(0),
						result = UnmanagedResult,
						span = span(10),
					}), DefineValue({
						id = ids.second,
						value_type = UnionType(ids.union_id),
						operation = ConstructDefinition(ids.second_variant, []),
						result = UnmanagedResult,
						span = span(20),
					})],
				tail = MatchTail({
					scrutinee = UnmanagedArgument(ids.second),
					owner = ids.union_id,
					arms = [
						{
							label = VariantLabel(ids.second_variant),
							operations = [DefineValue({
									id = ids.third,
									value_type = IntType,
									operation = IntegerDefinition(7),
									result = UnmanagedResult,
									span = span(30),
								})],
							exit = ReturnResult(UnmanagedReturn(ids.first))
						},
						{
							label = DefaultLabel,
							operations = [],
							exit = RecurArguments([ids.third], span(80))
						},
					],
				})
			}
			rejects(ids, function, 80, "value 2 is not defined before use")


pure func test_ordinary_self_call_in_arm() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			function: OwnedFunction = { original |
				signature = { original.signature | parameters = [IntType] },
				operations = [DefineValue({
						id = ids.first,
						value_type = IntType,
						operation = ParameterDefinition(0),
						result = UnmanagedResult,
						span = span(10),
					}), DefineValue({
						id = ids.second,
						value_type = UnionType(ids.union_id),
						operation = ConstructDefinition(ids.second_variant, []),
						result = UnmanagedResult,
						span = span(20),
					})],
				tail = MatchTail({
					scrutinee = UnmanagedArgument(ids.second),
					owner = ids.union_id,
					arms = [
						{
							label = VariantLabel(ids.second_variant),
							operations = [
								DefineValue({
									id = ids.third,
									value_type = IntType,
									operation = CallDefinition(
										UserFunction(ids.entrypoint),
										[UnmanagedArgument(ids.first)],
									),
									result = UnmanagedResult,
									span = span(30),
								}),
							],
							exit = ReturnResult(UnmanagedReturn(ids.third))
						},
						{
							label = DefaultLabel,
							operations = [],
							exit = RecurArguments([ids.first], span(80))
						},
					],
				})
			}
			rejects(ids, function, 30, "ordinary self call remains in a self-tail loop")


pure func test_managed_arm_value_already_dropped() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = loop(ids)
			function: OwnedFunction = { original |
				signature = { original.signature | parameters = [IntType] },
				operations = [DefineValue({
						id = ids.first,
						value_type = IntType,
						operation = ParameterDefinition(0),
						result = UnmanagedResult,
						span = span(10),
					}), DefineValue({
						id = ids.second,
						value_type = UnionType(ids.union_id),
						operation = ConstructDefinition(ids.second_variant, []),
						result = UnmanagedResult,
						span = span(20),
					})],
				tail = MatchTail({
					scrutinee = UnmanagedArgument(ids.second),
					owner = ids.union_id,
					arms = [
						{
							label = VariantLabel(ids.second_variant),
							operations = [
								DefineValue({
									id = ids.third,
									value_type = StringType,
									operation = CallDefinition(
										RuntimeFunction(Builtins.IntToString),
										[UnmanagedArgument(ids.first)],
									),
									result = OwnedResult(owner_id(0)),
									span = span(30),
								}),
								DropOwner(owner_id(0), span(40)),
							],
							exit = ReturnResult(UnmanagedReturn(ids.first))
						},
						{
							label = DefaultLabel,
							operations = [],
							exit = RecurArguments([ids.first], span(80))
						},
					],
				})
			}
			rejects(ids, function, 30, "managed value appears in a self-tail loop")


pure func test_raw_managed_join_carrier_rejects_before_its_arm_operations() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = loop(ids)
			function = { original |
				signature = { original.signature | parameters = [UnionType(ids.union_id), IntType] },
				operations = [
					DefineValue({ id = ids.first, value_type = UnionType(ids.union_id), operation = ParameterDefinition(0), result = UnmanagedResult, span = span(10) }),
					DefineValue({ id = ids.second, value_type = IntType, operation = ParameterDefinition(1), result = UnmanagedResult, span = span(20) }),
					ExecuteJoin({
						result = UnmanagedJoinParameter({ id = ids.third, value_type = VoidType, span = span(30) }),
						carried = [ManagedJoinParameter({ id = ids.fourth, value_type = StringType, span = span(31) }, owner_id(0))],
						scrutinee = UnmanagedArgument(ids.first),
						owner = ids.union_id,
						arms = [{
							label = DefaultLabel,
							operations = [
								DefineValue({ id = ids.fifth, value_type = StringType, operation = StringDefinition("arm"), result = OwnedResult(owner_id(1)), span = span(40) }),
								DefineValue({ id = ids.sixth, value_type = VoidType, operation = VoidDefinition, result = UnmanagedResult, span = span(41) }),
								AcquireOwner(owner_id(2), { value = ids.fifth, source = OwnerBorrow(owner_id(1)) }, span(42)),
								DropOwner(owner_id(1), span(43)),
							],
							transfer = UnmanagedReturn(ids.sixth),
							carried = [OwnedReturn(ids.fifth, owner_id(2))],
						}],
					}),
					DropOwner(owner_id(0), span(50)),
				],
				tail = ReturnTail(RecurArguments([ids.first, ids.second], span(80))),
			}
			rejects(ids, function, 31, "managed value appears in a self-tail loop")


tests: TestSuite = {
	description = "Independent recursive backedge verification",
	tests = [
		("managed raw carrier rejects before its arm", test_raw_managed_join_carrier_rejects_before_its_arm_operations),
		("valid permutation", test_valid_permutation),
		("valid duplicate", test_valid_duplicate),
		("zero argument entry loop", test_zero_argument_entry_loop),
		("backedge outside loop", test_backedge_outside_loop),
		("wrong arity", test_wrong_arity),
		("wrong nominal type", test_wrong_nominal_type),
		("undefined terminal operand", test_undefined_terminal_operand),
		("forward operand in definition", test_forward_operand_in_definition),
		("ordinary self call in prefix", test_ordinary_self_call_in_prefix),
		("loop without backedge", test_loop_without_backedge),
		("managed parameter signature", test_managed_parameter_signature),
		("managed return signature", test_managed_return_signature),
		("managed intermediate even after drop", test_managed_intermediate_even_after_drop),
		("managed terminal operand", test_managed_terminal_operand),
		("owner operation on backedge", test_owner_operation_on_backedge),
		("falsified unmanaged operation type", test_falsified_unmanaged_operation_type),
		("sibling terminal operand", test_sibling_terminal_operand),
		("ordinary self call in arm", test_ordinary_self_call_in_arm),
		("managed arm value already dropped", test_managed_arm_value_already_dropped),
	]
}
