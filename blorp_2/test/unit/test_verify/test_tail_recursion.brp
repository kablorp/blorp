import:
	../../../src/check/model as Model
	./selection_inputs as Selection
	../../../src/lower/lower as Lower
	../../../src/own/own as Own:
		BorrowSource(ParameterBorrow, OwnerBorrow),
		OwnedArgument(UnmanagedArgument, BorrowedArgument),
		OwnedDefinition, OwnedFunction, OwnedLoop,
		OwnedJoinParameter(UnmanagedJoinParameter, ManagedJoinParameter),
		OwnedLoopTail(ExitLoop, MatchLoop),
		OwnedLoopExit(Break, Recur),
		OwnedValueOperation(ParameterDefinition, IntegerDefinition, CallDefinition, ConstructDefinition, StringDefinition),
		OwnershipOperation(DefineValue, ExecuteLoop, AcquireOwner, DropOwner),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn, OwnedReturn),
		StoredPayload(UnmanagedPayload), owner_id,
	../../../src/namespace/builtins as Builtins: RuntimeOperation(IntToString, IntAdd)
	../../../src/specialize/specialize as Concrete:
		CallTarget(RuntimeFunction),
		TypeRef(IntType, StringType, UnionType),
	../../../src/utils/syntax: same_span, Entrypoint(NoArguments), EntryResult(IntegerExitStatus)
	../../../src/verify/verify: verify
	../ownership_inputs: InputIds, input_ids, span
	test: TestSuite


-- Identities come from their authority; raw loops and every expected fact below
-- are constructed independently of Own and source-annotation admission.
private pure func loop(ids: InputIds) -> OwnedFunction:
	{
		signature = {
			parameters = [IntType, IntType],
			return_type = IntType
		},
		operations = [DefineValue({
				id = ids.first,
				value_type = IntType,
				operation = ParameterDefinition(0),
				result = UnmanagedResult,
				span = span(10),
			}), DefineValue({
				id = ids.second,
				value_type = IntType,
				operation = ParameterDefinition(1),
				result = UnmanagedResult,
				span = span(20),
			})].append(ExecuteLoop({
			entry_acquisitions = [],
			headers = [
				{ parameter = Own.UnmanagedJoinParameter({ id = ids.fourth, value_type = IntType, span = span(10) }), initial = Own.UnmanagedReturn(ids.first) },
				{ parameter = Own.UnmanagedJoinParameter({ id = ids.fifth, value_type = IntType, span = span(20) }), initial = Own.UnmanagedReturn(ids.second) },
			],
			result = UnmanagedJoinParameter({ id = ids.third, value_type = IntType, span = span(90) }),
			carried = [],
			body = { operations = [], tail = ExitLoop(Recur([UnmanagedReturn(ids.fifth), UnmanagedReturn(ids.fourth)], span(80))) }
		})),
		result = UnmanagedReturn(ids.third)
	}


private pure func program(ids: InputIds, function: OwnedFunction) -> OwnershipProgram:
	{
		records = [],
		unions = ids.unions,
		functions = [
			function,
			{
				signature = {
					parameters = [],
					return_type = IntType
				},
				operations = [DefineValue({
						id = ids.first,
						value_type = IntType,
						operation = IntegerDefinition(7),
						result = UnmanagedResult,
						span = span(1),
					})],
				result = UnmanagedReturn(ids.first)
			},
		],
		entrypoint = NoArguments(ids.second_function, IntegerExitStatus)
	}

private pure func rejects(
	ids: InputIds,
	function: OwnedFunction,
	at: Int,
	message: String,
) -> Bool:
	match verify(program(ids, function)):
		Ok(_):
			False
		Err(error):
			(
				same_span(error.span, span(at))
				and error.message == "ownership verification failed: " + message
				and error.help == "report this compiler error with the input program"
				and error.note.is_none()
			)


pure func test_valid_permutation() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match verify(program(ids, loop(ids))):
				Ok(_):
					True
				Err(_):
					False


pure func test_valid_duplicate() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = loop(ids)
			match original.operations:
				[first, second, ExecuteLoop(runtime_loop)]:
					changed = { runtime_loop | body = { runtime_loop.body | tail = ExitLoop(Recur([UnmanagedReturn(ids.fourth), UnmanagedReturn(ids.fourth)], span(80))) } }
					verify(program(ids, { original | operations = [first, second, ExecuteLoop(changed)] })).is_ok()
				_: False


pure func test_zero_argument_entry_loop() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			raw = program(ids, loop(ids))
			function: OwnedFunction = {
				signature = { parameters = [], return_type = IntType },
				operations = [ExecuteLoop({
					entry_acquisitions = [],
					headers = [],
					result = UnmanagedJoinParameter({ id = ids.first, value_type = IntType, span = span(90) }),
					carried = [],
					body = { operations = [], tail = ExitLoop(Recur([], span(80))) }
				})],
				result = UnmanagedReturn(ids.first)
			}
			verify({ raw | functions = [function], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }).is_ok()



pure func test_backedge_outside_loop() -> Bool:
	match input_ids():
		Err(_): False
		Ok(ids):
			original = loop(ids)
			match original.operations:
				[first, second, ExecuteLoop(runtime_loop)]:
					changed = { runtime_loop | body = { runtime_loop.body | operations = [DefineValue({
						id = ids.sixth,
						value_type = IntType,
						operation = CallDefinition(RuntimeFunction(Builtins.IntAdd), [UnmanagedArgument(ids.third), UnmanagedArgument(ids.fourth)]),
						result = UnmanagedResult, span = span(30)
					})] } }
					rejects(ids, { original | operations = [first, second, ExecuteLoop(changed)] }, 30, "value 2 is not defined before use")
				_: False


