import:
	../../../src/check/model as Model
	../../../src/check/check: CheckedProgram, check, check_errors, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/render: render_failure
	../../../src/utils/ids as Declaration
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/namespace/builtins as Builtins
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax:
		Diagnostic,
		FunctionExecution(OrdinaryCalls),
		Entrypoint(NoArguments),
		EntryResult(IntegerExitStatus),
	../../../src/verify/verify: verify
	../input: setup_diagnostic
	list: set_index
	../module_input: parse_modules
	../ownership_inputs: InputIds, input_ids, span
	test: TestSuite


private HEADER: String = "pure func compare(left: String, right: String) -> Bool:"
private LABEL: String = "\"string.equals\""
private BODY: String = "\n    builtin(\"string.equals\")\n"
private MAIN: String =
	|func main() -> Int:
	|    0
	|
private COMPARISON_MAIN: String =
	|func main() -> Int:
	|    compared = compare("left", "right")
	|    0
	|


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules([{ source = source, targets = [] }])
	check(parsed).map_err(setup_diagnostic)


-- The test foundation declares True before False.
pure func test_checked_comparison_returns_the_designated_bool() -> Bool:
	match checked(HEADER + BODY + COMPARISON_MAIN):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match (function.signature.return_type.value_type, function.body):
						(Model.UnionType(owner), Model.CheckedValueBody(Model.ReturnExpression(value))):
							match value.form:
								Model.InvokeFunction(call, [left, right]):
									match call.target:
										Model.RuntimeFunction(Builtins.StringEquals(boolean)):
											Declaration.union_number(Declaration.variant_owner(boolean.true_variant)) == Declaration.union_number(owner) and Declaration.union_number(Declaration.variant_owner(boolean.false_variant)) == Declaration.union_number(owner) and Declaration.variant_number(boolean.true_variant) == 0 and Declaration.variant_number(boolean.false_variant) == 1 and Model.same_type(left.value_type, Model.StringType) and Model.same_type(right.value_type, Model.StringType)
										_: False
								_: False
						_: False
				_: False


pure func test_specialized_comparison_has_two_empty_unmanaged_constructors() -> Bool:
	match checked(HEADER + BODY + COMPARISON_MAIN).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			contents = Concrete.specialized_contents(program)
			match contents.functions:
				[_, function]:
					match (function.signature.return_type, function.body):
						(Concrete.UnionType(owner), Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
							match (value.form, contents.unions.get(Concrete.union_number(owner))):
								(Concrete.InvokeFunction(call, [_, _]), Some(layout)):
									match (call.target, layout.variants, layout.representation):
										(Concrete.RuntimeFunction(Builtins.StringEquals(boolean)), [[], []], Concrete.InlineUnmanaged):
											Concrete.union_number(Concrete.variant_owner(boolean.true_variant)) == Concrete.union_number(owner) and Concrete.union_number(Concrete.variant_owner(boolean.false_variant)) == Concrete.union_number(owner) and Concrete.variant_number(boolean.true_variant) == 0 and Concrete.variant_number(boolean.false_variant) == 1
										_: False
								_: False
						_: False
				_: False


pure func test_comparison_borrows_both_inputs_without_acquisition() -> Bool:
	match checked(HEADER + BODY + COMPARISON_MAIN).and_then(pure func(program): Concrete.specialize(program)).and_then(pure func(program): Lower.lower(program)):
		Err(_): False
		Ok(program):
			contents = Lower.lowered_functions(program)
			match contents.functions:
				[_, function]:
					match Own.insert_function(function, contents.unions, []):
						Err(_): False
						Ok(function):
							match (function.operations, function.tail):
								([Own.DefineValue(left), Own.DefineValue(right), Own.DefineValue(result)], Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(returned)))):
									match (left.result, right.result, result.operation, result.result):
										(Own.BorrowedResult(Own.ParameterBorrow(left_source)), Own.BorrowedResult(Own.ParameterBorrow(right_source)), Own.CallDefinition(_, [Own.BorrowedArgument(left_argument), Own.BorrowedArgument(right_argument)]), Own.UnmanagedResult):
											match (left_argument.source, right_argument.source):
												(Own.ParameterBorrow(left_borrow), Own.ParameterBorrow(right_borrow)):
													Lower.value_number(left_source) == 0 and Lower.value_number(right_source) == 1 and Lower.value_number(left_borrow) == 0 and Lower.value_number(right_borrow) == 1 and Lower.value_number(left_argument.value) == 0 and Lower.value_number(right_argument.value) == 1 and Lower.value_number(returned) == 2
												_: False
										_: False
								_: False
				_: False


-- A comparison into any union other than the designated Bool is a contract
-- mismatch, however closely that union resembles Bool.
pure func test_checker_rejects_comparison_into_an_ordinary_union() -> Bool:
	declaration: String =
		|fixed union Answer:
		|    Identical
		|    Different
		|pure func compare(left: String, right: String) -> Answer:
		|    builtin("string.equals")
		|
	start = declaration.length() - "\"string.equals\")\n".length()
	match parse_modules([{ source = declaration + MAIN, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					kind_matches = match check_errors(failure).first.kind:
						Errors.BuiltinRejection(Errors.BuiltinContractMismatch(_)): True
						_: False
					rendered = render_failure(failure)
					kind_matches and check_errors(failure).remaining.is_empty() and rendered.remaining.is_empty() and same_source(rendered.first.span.source, module_source(root_module_id())) and rendered.first.span.start == start and rendered.first.span.end == start + LABEL.length() and rendered.first.message == "builtin declaration does not match its runtime contract" and rendered.first.help == "declare a pure nongeneric function with two String parameters returning Bool" and rendered.first.note.is_none()


private fixed record Seed {
	ids: InputIds,
	boolean: Builtins.DesignatedBoolean[Concrete.VariantInstanceId],
	other: Concrete.VariantInstanceId,
	unions: List[Concrete.ConcreteUnion]
}


private pure func seed_error() -> Diagnostic:
	{ span = span(0), note = None, message = "invalid comparison identity seed", help = "fix the comparison test seed" }


private pure func comparison_constructors(function: Lower.LoweredFunction) -> Result[Builtins.DesignatedBoolean[Concrete.VariantInstanceId], Diagnostic]:
	match function.definitions:
		[_, _, result]:
			match result.operation:
				Lower.CallValue(call, [_, _]):
					match call.target:
						Concrete.RuntimeFunction(Builtins.StringEquals(boolean)): Ok(boolean)
						_: Err(seed_error())
				_: Err(seed_error())
		_: Err(seed_error())


-- Identity minting stops at Lower IR; raw verification below never consumes
-- an ownership inserter's result or repair. `other` is an empty constructor of
-- an ordinary union, so it shares no owner with Bool.
private pure func seed() -> Result[Seed, Diagnostic]:
	other: String =
		|fixed union Other:
		|    No
		|    Yes
		|pure func pick() -> Other:
		|    No
		|
	ids ?= input_ids()
	main: String =
		|func main() -> Int:
		|    first = compare("left", "right")
		|    second = pick()
		|    0
		|
	checked ?= checked(HEADER + BODY + other + main)
	concrete ?= Concrete.specialize(checked)
	lowered ?= Lower.lower(concrete)
	contents = Lower.lowered_functions(lowered)
	match contents.functions:
		[_, comparison, picked]:
			boolean ?= comparison_constructors(comparison)
			match picked.definitions:
				[constructed]:
					match constructed.operation:
						Lower.ConstructValue(variant, []): Ok({ ids = ids, boolean = boolean, other = variant, unions = contents.unions })
						_: Err(seed_error())
				_: Err(seed_error())
		_: Err(seed_error())


private pure func definition(id: Lower.ValueId, value_type: Concrete.TypeRef, operation: Own.OwnedValueOperation, result: Own.ResultOwnership, at: Int) -> Own.OwnershipOperation:
	Own.DefineValue({ id = id, value_type = value_type, operation = operation, result = result, span = span(at) })


private pure func raw(seed: Seed, boolean: Builtins.DesignatedBoolean[Concrete.VariantInstanceId]) -> Own.OwnershipProgram:
	ids = seed.ids
	entry: Own.OwnedFunction = {
		execution = OrdinaryCalls,
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = [definition(ids.first, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 1)],
		tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.first)))
	}
	call: Concrete.ConcreteCall = { target = Concrete.RuntimeFunction(Builtins.StringEquals(boolean)), span = span(30) }
	comparison: Own.OwnedFunction = {
		execution = OrdinaryCalls,
		signature = { parameters = [Concrete.StringType, Concrete.StringType], return_type = Concrete.IntType },
		operations = [
			definition(ids.first, Concrete.StringType, Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(ids.first)), 10),
			definition(ids.second, Concrete.StringType, Own.ParameterDefinition(1), Own.BorrowedResult(Own.ParameterBorrow(ids.second)), 20),
			definition(ids.third, Concrete.UnionType(Concrete.variant_owner(boolean.true_variant)), Own.CallDefinition(call, [Own.BorrowedArgument({ value = ids.first, source = Own.ParameterBorrow(ids.first) }), Own.BorrowedArgument({ value = ids.second, source = Own.ParameterBorrow(ids.second) })]), Own.UnmanagedResult, 30),
			definition(ids.fourth, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 50),
		],
		tail = Own.ReturnTail(Own.ReturnResult(Own.UnmanagedReturn(ids.fourth)))
	}
	{ records = [], unions = seed.unions, functions = [entry, comparison], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }


private pure func rejects(program: Own.OwnershipProgram, message: String) -> Bool:
	match verify(program):
		Err(error): error.message == "ownership verification failed: " + message and error.help == "report this compiler error with the input program" and same_source(error.span.source, module_source(root_module_id())) and error.span.start == 30 and error.span.end == 31 and error.note.is_none()
		Ok(_): False


pure func test_raw_comparison_with_two_borrowed_inputs_is_valid() -> Bool:
	match seed():
		Ok(seed): verify(raw(seed, seed.boolean)).is_ok()
		Err(_): False


pure func test_verifier_rejects_comparison_constructor_from_other_owner() -> Bool:
	match seed():
		Ok(seed): rejects(raw(seed, { true_variant = seed.boolean.true_variant, false_variant = seed.other }), "runtime Bool constructors do not cover one result union")
		Err(_): False


private pure func rejects_layout(seed: Seed, variants: List[List[Concrete.TypeRef]], message: String) -> Bool:
	program = raw(seed, seed.boolean)
	owner = Concrete.union_number(Concrete.variant_owner(seed.boolean.true_variant))
	match seed.unions.set_index(owner, { variants = variants, representation = Concrete.InlineUnmanaged }):
		Some(unions): rejects({ program | unions = unions }, message)
		None: False


pure func test_verifier_rejects_unknown_comparison_ordinal() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[]], "unknown variant identity")
		Err(_): False


pure func test_verifier_rejects_comparison_payload() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[], [Concrete.IntType]], "variant field count does not match its operation")
		Err(_): False


pure func test_verifier_rejects_extra_comparison_variant() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[], [], []], "runtime Bool constructors do not cover one result union")
		Err(_): False


pure func test_verifier_rejects_duplicate_comparison_constructor() -> Bool:
	match seed():
		Ok(seed): rejects(raw(seed, { true_variant = seed.boolean.true_variant, false_variant = seed.boolean.true_variant }), "runtime Bool constructors do not cover one result union")
		Err(_): False


tests: TestSuite = {
	description = "Independent designated Bool comparison contracts",
	tests = [
		("checked comparison returns the designated Bool", test_checked_comparison_returns_the_designated_bool),
		("specialized comparison has empty unmanaged constructors", test_specialized_comparison_has_two_empty_unmanaged_constructors),
		("comparison borrows both inputs without acquisition", test_comparison_borrows_both_inputs_without_acquisition),
		("checker rejects comparison into an ordinary union", test_checker_rejects_comparison_into_an_ordinary_union),
		("raw comparison with borrowed inputs valid", test_raw_comparison_with_two_borrowed_inputs_is_valid),
		("verifier rejects wrong comparison owner", test_verifier_rejects_comparison_constructor_from_other_owner),
		("verifier rejects unknown comparison ordinal", test_verifier_rejects_unknown_comparison_ordinal),
		("verifier rejects comparison payload", test_verifier_rejects_comparison_payload),
		("verifier rejects extra comparison variant", test_verifier_rejects_extra_comparison_variant),
		("verifier rejects duplicate comparison constructor", test_verifier_rejects_duplicate_comparison_constructor),
	]
}
