import:
	../../../src/check/model as Model
	../../../src/check/check: CheckedProgram, check, check_errors, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/render: render_failure
	../../../src/utils/ids as Declaration
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/namespace/builtins as Builtins
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax:
		Diagnostic,
		FunctionExecution(OrdinaryCalls),
		Entrypoint(NoArguments),
		EntryResult(IntegerExitStatus),
	../../../src/verify/verify: verify
	../input: setup_diagnostic
	list: set_index
	../module_input: FOUNDATION_TYPES, test_base, parse_modules, parse_modules_with_base
	../ownership_inputs: InputIds, input_ids, span
	test: TestSuite


private HEADER: String = "pure func compare(left: String, right: String) -> Bool:"
private LABEL: String = "\"string.equals\""
private BODY: String = "\n    builtin(\"string.equals\")\n"
private MAIN: String =
	|func main() -> Int:
	|    0
	|
private COMPARISON_MAIN: String =
	|func main() -> Int:
	|    compared = compare("left", "right")
	|    0
	|


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules([{ source = source, targets = [] }])
	check(parsed).map_err(setup_diagnostic)


-- The test foundation declares True before False.
pure func test_checked_comparison_returns_the_designated_bool() -> Bool:
	match checked(HEADER + BODY + COMPARISON_MAIN):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match (function.signature.return_type.value_type, function.body):
						(Model.UnionType(owner), Model.CheckedValueBody(Model.ReturnExpression(value))):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(left), Model.ValueOperand(right)]:
											match call.target:
												Model.RuntimeFunction(Builtins.StringEquals(boolean)):
													Declaration.union_number(Declaration.variant_owner(boolean.true_variant)) == Declaration.union_number(owner) and Declaration.union_number(Declaration.variant_owner(boolean.false_variant)) == Declaration.union_number(owner) and Declaration.variant_number(boolean.true_variant) == 0 and Declaration.variant_number(boolean.false_variant) == 1 and Model.same_type(left.value_type, Model.StringType) and Model.same_type(right.value_type, Model.StringType)
												_: False
										_: False
								_: False
						_: False
				_: False


pure func test_specialized_comparison_has_two_empty_unmanaged_constructors() -> Bool:
	match checked(HEADER + BODY + COMPARISON_MAIN).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			contents = Concrete.specialized_contents(program)
			match contents.functions:
				[_, function]:
					match (function.signature.return_type, function.body):
						(Concrete.UnionType(owner), Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
							match (value.form, contents.unions.get(Concrete.union_number(owner))):
								(Concrete.InvokeFunction(call, [_, _]), Some(layout)):
									match (call.target, layout.variants, layout.representation):
										(Concrete.RuntimeFunction(Builtins.StringEquals(boolean)), [[], []], Concrete.InlineUnmanaged):
											Concrete.union_number(Concrete.variant_owner(boolean.true_variant)) == Concrete.union_number(owner) and Concrete.union_number(Concrete.variant_owner(boolean.false_variant)) == Concrete.union_number(owner) and Concrete.variant_number(boolean.true_variant) == 0 and Concrete.variant_number(boolean.false_variant) == 1
										_: False
								_: False
						_: False
				_: False


pure func test_comparison_borrows_both_inputs_without_acquisition() -> Bool:
	match checked(HEADER + BODY + COMPARISON_MAIN).and_then(pure func(program): Concrete.specialize(program)).and_then(pure func(program): Lower.lower(program)):
		Err(_): False
		Ok(program):
			contents = Lower.lowered_functions(program)
			match contents.functions:
				[_, function]:
					match Own.insert_function(function, contents.unions, []):
						Err(_): False
						Ok(function):
							match (function.operations, function.result):
								([Own.DefineValue(left), Own.DefineValue(right), Own.DefineValue(result)], Own.UnmanagedReturn(returned)):
									match (left.result, right.result, result.operation, result.result):
										(Own.BorrowedResult(Own.ParameterBorrow(left_source)), Own.BorrowedResult(Own.ParameterBorrow(right_source)), Own.CallDefinition(_, [Own.BorrowedArgument(left_argument), Own.BorrowedArgument(right_argument)]), Own.UnmanagedResult):
											match (left_argument.source, right_argument.source):
												(Own.ParameterBorrow(left_borrow), Own.ParameterBorrow(right_borrow)):
													Lower.value_number(left_source) == 0 and Lower.value_number(right_source) == 1 and Lower.value_number(left_borrow) == 0 and Lower.value_number(right_borrow) == 1 and Lower.value_number(left_argument.value) == 0 and Lower.value_number(right_argument.value) == 1 and Lower.value_number(returned) == 2
												_: False
										_: False
								_: False
				_: False


-- A comparison into any union other than the designated Bool is a contract
-- mismatch, however closely that union resembles Bool.
pure func test_checker_rejects_comparison_into_an_ordinary_union() -> Bool:
	declaration: String =
		|fixed union Answer:
		|    Identical
		|    Different
		|pure func compare(left: String, right: String) -> Answer:
		|    builtin("string.equals")
		|
	start = declaration.length() - "\"string.equals\")\n".length()
	match parse_modules([{ source = declaration + MAIN, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					kind_matches = match check_errors(failure).first.kind:
						Errors.BuiltinRejection(Errors.BuiltinContractMismatch(_)): True
						_: False
					rendered = render_failure(failure)
					kind_matches and check_errors(failure).remaining.is_empty() and rendered.remaining.is_empty() and same_source(rendered.first.span.source, module_source(root_module_id())) and rendered.first.span.start == start and rendered.first.span.end == start + LABEL.length() and rendered.first.message == "builtin declaration does not match its runtime contract" and rendered.first.help == "declare a pure nongeneric function with two String parameters returning Bool" and rendered.first.note.is_none()


private fixed record Seed {
	ids: InputIds,
	boolean: Builtins.DesignatedBoolean[Concrete.VariantInstanceId],
	other: Concrete.VariantInstanceId,
	other_second: Concrete.VariantInstanceId,
	unions: List[Concrete.ConcreteUnion]
}


private pure func seed_error() -> Diagnostic:
	{ span = span(0), note = None, message = "invalid comparison identity seed", help = "fix the comparison test seed" }


private pure func comparison_constructors(function: Lower.LoweredFunction) -> Result[Builtins.DesignatedBoolean[Concrete.VariantInstanceId], Diagnostic]:
	match function.steps:
		[Lower.Define(_), Lower.Define(_), Lower.Define(result)]:
			match result.operation:
				Lower.CallValue(call, [_, _]):
					match call:
						Concrete.RuntimeFunction(Builtins.StringEquals(boolean)): Ok(boolean)
						_: Err(seed_error())
				_: Err(seed_error())
		_: Err(seed_error())


-- Identity minting stops at Lower IR; raw verification below never consumes
-- an ownership inserter's result or repair. `other` is an empty constructor of
-- an ordinary union, so it shares no owner with Bool.
private pure func seed() -> Result[Seed, Diagnostic]:
	other: String =
		|fixed union Other:
		|    No
		|    Yes
		|pure func pick() -> Other:
		|    No
		|pure func pick_second() -> Other:
		|    Yes
		|
	ids ?= input_ids()
	main: String =
		|func main() -> Int:
		|    first = compare("left", "right")
		|    second = pick()
		|    third = pick_second()
		|    0
		|
	checked ?= checked(HEADER + BODY + other + main)
	concrete ?= Concrete.specialize(checked)
	lowered ?= Lower.lower(concrete)
	contents = Lower.lowered_functions(lowered)
	match contents.functions:
		[_, comparison, picked, picked_second]:
			boolean ?= comparison_constructors(comparison)
			match (picked.steps, picked_second.steps):
				([Lower.Define(constructed)], [Lower.Define(constructed_second)]):
					match (constructed.operation, constructed_second.operation):
						(Lower.ConstructValue(variant, []), Lower.ConstructValue(second_variant, [])): Ok({ ids = ids, boolean = boolean, other = variant, other_second = second_variant, unions = contents.unions })
						_: Err(seed_error())
				_: Err(seed_error())
		_: Err(seed_error())


private pure func definition(id: Lower.ValueId, value_type: Concrete.TypeRef, operation: Own.OwnedValueOperation, result: Own.ResultOwnership, at: Int) -> Own.OwnershipOperation:
	Own.DefineValue({ id = id, value_type = value_type, operation = operation, result = result, span = span(at) })


private pure func raw(seed: Seed, boolean: Builtins.DesignatedBoolean[Concrete.VariantInstanceId]) -> Own.OwnershipProgram:
	ids = seed.ids
	entry: Own.OwnedFunction = {
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = [definition(ids.first, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 1)],
		result = Own.UnmanagedReturn(ids.first)
	}
	call: Concrete.CallTarget = Concrete.RuntimeFunction(Builtins.StringEquals(boolean))
	comparison: Own.OwnedFunction = {
		signature = { parameters = [Concrete.StringType, Concrete.StringType], return_type = Concrete.IntType },
		operations = [
			definition(ids.first, Concrete.StringType, Own.ParameterDefinition(0), Own.BorrowedResult(Own.ParameterBorrow(ids.first)), 10),
			definition(ids.second, Concrete.StringType, Own.ParameterDefinition(1), Own.BorrowedResult(Own.ParameterBorrow(ids.second)), 20),
			definition(ids.third, Concrete.UnionType(Concrete.variant_owner(boolean.true_variant)), Own.CallDefinition(call, [Own.BorrowedArgument({ value = ids.first, source = Own.ParameterBorrow(ids.first) }), Own.BorrowedArgument({ value = ids.second, source = Own.ParameterBorrow(ids.second) })]), Own.UnmanagedResult, 30),
			definition(ids.fourth, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 50),
		],
		result = Own.UnmanagedReturn(ids.fourth)
	}
	{ records = [], unions = seed.unions, functions = [entry, comparison], entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus) }


private pure func rejects(program: Own.OwnershipProgram, message: String) -> Bool:
	match verify(program):
		Err(error): error.message == "ownership verification failed: " + message and error.help == "report this compiler error with the input program" and same_source(error.span.source, module_source(root_module_id())) and error.span.start == 30 and error.span.end == 31 and error.note.is_none()
		Ok(_): False


pure func test_raw_comparison_with_two_borrowed_inputs_is_valid() -> Bool:
	match seed():
		Ok(seed): verify(raw(seed, seed.boolean)).is_ok()
		Err(_): False


pure func test_verifier_rejects_comparison_constructor_from_other_owner() -> Bool:
	match seed():
		Ok(seed): rejects(raw(seed, { true_variant = seed.boolean.true_variant, false_variant = seed.other }), "runtime Bool constructors do not cover one result union")
		Err(_): False


-- Another union's second constructor has a different ordinal from True and
-- Bool's layout is untouched, so only the type clause can refuse it.
pure func test_verifier_rejects_comparison_constructor_of_another_union_with_a_distinct_ordinal() -> Bool:
	match seed():
		Ok(seed): rejects(raw(seed, { true_variant = seed.boolean.true_variant, false_variant = seed.other_second }), "runtime Bool constructors do not cover one result union")
		Err(_): False


-- The owner lookup fails in the variant's own check, before the layout is read.
pure func test_verifier_rejects_unknown_comparison_owner() -> Bool:
	match seed():
		Ok(seed): rejects({ raw(seed, seed.boolean) | unions = [] }, "unknown variant owner")
		Err(_): False


private pure func rejects_layout(seed: Seed, variants: List[List[Concrete.TypeRef]], message: String) -> Bool:
	program = raw(seed, seed.boolean)
	owner = Concrete.union_number(Concrete.variant_owner(seed.boolean.true_variant))
	match seed.unions.set_index(owner, { variants = variants, representation = Concrete.InlineUnmanaged }):
		Some(unions): rejects({ program | unions = unions }, message)
		None: False


pure func test_verifier_rejects_unknown_comparison_ordinal() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[]], "unknown variant identity")
		Err(_): False


pure func test_verifier_rejects_comparison_payload() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[], [Concrete.IntType]], "variant field count does not match its operation")
		Err(_): False


pure func test_verifier_rejects_extra_comparison_variant() -> Bool:
	match seed():
		Ok(seed): rejects_layout(seed, [[], [], []], "runtime Bool constructors do not cover one result union")
		Err(_): False


pure func test_verifier_rejects_duplicate_comparison_constructor() -> Bool:
	match seed():
		Ok(seed): rejects(raw(seed, { true_variant = seed.boolean.true_variant, false_variant = seed.boolean.true_variant }), "runtime Bool constructors do not cover one result union")
		Err(_): False


-- Ordinary constructor expressions provide independent issued identities;
-- neither observer assumes the foundation's variant order.
private FLOAT_PREDICATES: String =
	|pure func equal(first: Float, second: Float) -> Bool:
	|    builtin("float.equals")
	|pure func less(first: Float, second: Float) -> Bool:
	|    builtin("float.less_than")
	|pure func nan(value: Float) -> Bool:
	|    builtin("float.is_nan")
	|pure func finite(value: Float) -> Bool:
	|    builtin("float.is_finite")
	|pure func truth() -> Bool:
	|    True
	|pure func falsehood() -> Bool:
	|    False
	|func main() -> Int:
	|    equal_result = equal(1.0, 2.0)
	|    less_result = less(1.0, 2.0)
	|    nan_result = nan(1.0)
	|    finite_result = finite(1.0)
	|    true_result = truth()
	|    false_result = falsehood()
	|    0
	|


private pure func checked_float_predicates(types: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules_with_base([{ source = FLOAT_PREDICATES, targets = [] }], { test_base() | types = types })
	check(parsed).map_err(setup_diagnostic)


private pure func checked_float_identity(function: Model.CheckedFunction, truth: Model.CheckedExpr, falsehood: Model.CheckedExpr, arity: Int) -> Bool:
	match (truth.form, falsehood.form, function.body):
		(Model.ConstructVariant(true_id, []), Model.ConstructVariant(false_id, []), Model.CheckedValueBody(Model.ReturnExpression(value))):
			match value.form:
				Model.InvokeFunction(call):
					match call.target:
						Model.RuntimeFunction(operation):
							match Builtins.runtime_contract(operation).return_type:
								Builtins.BooleanResult(boolean):
									(
										Model.same_variant(boolean.true_variant, true_id)
										and Model.same_variant(boolean.false_variant, false_id)
										and Model.same_type(function.signature.return_type.value_type, truth.value_type)
										and Model.same_type(value.value_type, truth.value_type)
										and call.operands.length() == arity
										and call.operands.all(pure func(operand):
											match operand:
												Model.ValueOperand(argument): Model.same_type(argument.value_type, Model.FloatType)
												Model.CallableOperand(_, _, _): False
										)
									)
								_: False
						_: False
				_: False
		_: False


private pure func checked_float_identities(types: String) -> Bool:
	match checked_float_predicates(types):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[equal, less, nan, finite, truth, falsehood, _]:
					match (truth.body, falsehood.body):
						(Model.CheckedValueBody(Model.ReturnExpression(true_value)), Model.CheckedValueBody(Model.ReturnExpression(false_value))):
							(
								checked_float_identity(equal, true_value, false_value, 2)
								and checked_float_identity(less, true_value, false_value, 2)
								and checked_float_identity(nan, true_value, false_value, 1)
								and checked_float_identity(finite, true_value, false_value, 1)
							)
						_: False
				_: False


private pure func same_concrete_variant(first: Concrete.VariantInstanceId, second: Concrete.VariantInstanceId) -> Bool:
	(
		Concrete.union_number(Concrete.variant_owner(first)) == Concrete.union_number(Concrete.variant_owner(second))
		and Concrete.variant_number(first) == Concrete.variant_number(second)
	)


private pure func specialized_float_identity(function: Concrete.ConcreteFunction, truth: Concrete.ConcreteExpr, falsehood: Concrete.ConcreteExpr, arity: Int) -> Bool:
	match (truth.form, falsehood.form, function.body):
		(Concrete.ConstructVariant(true_id, []), Concrete.ConstructVariant(false_id, []), Concrete.ConcreteValueBody(Concrete.ReturnExpression(value))):
			match value.form:
				Concrete.InvokeFunction(call, arguments):
					match call.target:
						Concrete.RuntimeFunction(operation):
							match Builtins.runtime_contract(operation).return_type:
								Builtins.BooleanResult(boolean):
									(
										same_concrete_variant(boolean.true_variant, true_id)
										and same_concrete_variant(boolean.false_variant, false_id)
										and Concrete.same_type(function.signature.return_type, truth.value_type)
										and Concrete.same_type(value.value_type, truth.value_type)
										and arguments.length() == arity
										and arguments.all(pure func(argument): Concrete.same_type(argument.value_type, Concrete.FloatType))
									)
								_: False
						_: False
				_: False
		_: False


private pure func specialized_float_identities(types: String) -> Bool:
	match checked_float_predicates(types).and_then(pure func(program): Concrete.specialize(program)):
		Err(_): False
		Ok(program):
			contents = Concrete.specialized_contents(program)
			match (contents.functions, contents.unions):
				([_, equal, less, nan, finite, truth, falsehood], [layout]):
					match (truth.body, falsehood.body, layout.variants, layout.representation):
						(Concrete.ConcreteValueBody(Concrete.ReturnExpression(true_value)), Concrete.ConcreteValueBody(Concrete.ReturnExpression(false_value)), [[], []], Concrete.InlineUnmanaged):
							(
								specialized_float_identity(equal, true_value, false_value, 2)
								and specialized_float_identity(less, true_value, false_value, 2)
								and specialized_float_identity(nan, true_value, false_value, 1)
								and specialized_float_identity(finite, true_value, false_value, 1)
							)
						_: False
				_: False


pure func test_checked_float_predicates_preserve_constructor_identities() -> Bool:
	checked_float_identities(FOUNDATION_TYPES)


pure func test_checked_float_predicates_preserve_reversed_constructor_identities() -> Bool:
	checked_float_identities(FOUNDATION_TYPES.replace("    True\n    False", "    False\n    True"))


pure func test_specialized_float_predicates_preserve_constructor_identities() -> Bool:
	specialized_float_identities(FOUNDATION_TYPES)


pure func test_specialized_float_predicates_preserve_reversed_constructor_identities() -> Bool:
	specialized_float_identities(FOUNDATION_TYPES.replace("    True\n    False", "    False\n    True"))


pure func test_checker_rejects_float_predicate_into_an_ordinary_union() -> Bool:
	declaration: String =
		|fixed union Answer:
		|    Identical
		|    Different
		|pure func compare(left: Float, right: Float) -> Answer:
		|    builtin("float.equals")
		|
	start = declaration.length() - "\"float.equals\")\n".length()
	match parse_modules([{ source = declaration + MAIN, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					kind_matches = match check_errors(failure).first.kind:
						Errors.BuiltinRejection(Errors.BuiltinContractMismatch(_)): True
						_: False
					rendered = render_failure(failure)
					kind_matches and check_errors(failure).remaining.is_empty() and rendered.remaining.is_empty() and same_source(rendered.first.span.source, module_source(root_module_id())) and rendered.first.span.start == start and rendered.first.span.end == start + "\"float.equals\"".length() and rendered.first.message == "builtin declaration does not match its runtime contract" and rendered.first.help == "declare a pure nongeneric function with two Float parameters returning Bool" and rendered.first.note.is_none()


-- This raw product borrows only issued IDs and union layouts from the existing
-- seed. No Own insertion or repair supplies the verification oracle.
private pure func raw_float(
	seed: Seed,
	operation: Builtins.RuntimeOperation[Concrete.VariantInstanceId, Concrete.TypeRef],
	arguments: List[Own.OwnedArgument],
	result_type: Concrete.TypeRef,
) -> Own.OwnershipProgram:
	program = raw(seed, seed.boolean)
	ids = seed.ids
	function: Own.OwnedFunction = {
		signature = { parameters = [], return_type = Concrete.IntType },
		operations = [
			definition(ids.first, Concrete.FloatType, Own.FloatDefinition(1.0), Own.UnmanagedResult, 10),
			definition(ids.second, Concrete.FloatType, Own.FloatDefinition(2.0), Own.UnmanagedResult, 20),
			definition(ids.third, Concrete.IntType, Own.IntegerDefinition(0), Own.UnmanagedResult, 25),
			definition(ids.fourth, result_type, Own.CallDefinition(Concrete.RuntimeFunction(operation), arguments), Own.UnmanagedResult, 30),
		],
		result = Own.UnmanagedReturn(ids.third)
	}
	{ program | functions = [function] }


pure func test_raw_float_binary_predicate_is_valid() -> Bool:
	match seed():
		Ok(seed):
			program = raw_float(
				seed,
				Builtins.FloatLessThan(seed.boolean),
				[Own.UnmanagedArgument(seed.ids.first), Own.UnmanagedArgument(seed.ids.second)],
				Concrete.UnionType(Concrete.variant_owner(seed.boolean.true_variant)),
			)
			verify(program).is_ok()
		Err(_): False


pure func test_raw_float_unary_classifier_is_valid() -> Bool:
	match seed():
		Ok(seed):
			program = raw_float(
				seed,
				Builtins.FloatIsFinite(seed.boolean),
				[Own.UnmanagedArgument(seed.ids.first)],
				Concrete.UnionType(Concrete.variant_owner(seed.boolean.true_variant)),
			)
			verify(program).is_ok()
		Err(_): False


pure func test_verifier_rejects_float_binary_missing_argument() -> Bool:
	match seed():
		Ok(seed):
			program = raw_float(
				seed,
				Builtins.FloatEquals(seed.boolean),
				[Own.UnmanagedArgument(seed.ids.first)],
				Concrete.UnionType(Concrete.variant_owner(seed.boolean.true_variant)),
			)
			rejects(program, "call is missing its argument")
		Err(_): False


pure func test_verifier_rejects_float_classifier_extra_argument() -> Bool:
	match seed():
		Ok(seed):
			program = raw_float(
				seed,
				Builtins.FloatIsFinite(seed.boolean),
				[Own.UnmanagedArgument(seed.ids.first), Own.UnmanagedArgument(seed.ids.second)],
				Concrete.UnionType(Concrete.variant_owner(seed.boolean.true_variant)),
			)
			rejects(program, "call has an unexpected argument")
		Err(_): False


pure func test_verifier_rejects_float_predicate_int_argument() -> Bool:
	match seed():
		Ok(seed):
			program = raw_float(
				seed,
				Builtins.FloatEquals(seed.boolean),
				[Own.UnmanagedArgument(seed.ids.first), Own.UnmanagedArgument(seed.ids.third)],
				Concrete.UnionType(Concrete.variant_owner(seed.boolean.true_variant)),
			)
			rejects(program, "call argument type does not match its contract")
		Err(_): False


pure func test_verifier_rejects_float_classifier_int_result() -> Bool:
	match seed():
		Ok(seed):
			program = raw_float(
				seed,
				Builtins.FloatIsNaN(seed.boolean),
				[Own.UnmanagedArgument(seed.ids.first)],
				Concrete.IntType,
			)
			rejects(program, "call result type does not match its contract")
		Err(_): False


pure func test_verifier_rejects_float_classifier_mixed_union_constructors() -> Bool:
	match seed():
		Ok(seed):
			program = raw_float(
				seed,
				Builtins.FloatIsFinite({ true_variant = seed.boolean.true_variant, false_variant = seed.other }),
				[Own.UnmanagedArgument(seed.ids.first)],
				Concrete.UnionType(Concrete.variant_owner(seed.boolean.true_variant)),
			)
			rejects(program, "runtime Bool constructors do not cover one result union")
		Err(_): False


tests: TestSuite = {
	description = "Independent designated Bool comparison contracts",
	tests = [
		("checker rejects Float predicate into an ordinary union", test_checker_rejects_float_predicate_into_an_ordinary_union),
		("checked Float predicates preserve constructor identities", test_checked_float_predicates_preserve_constructor_identities),
