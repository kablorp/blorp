			_: False
	)


pure func test_variant_failure_is_owned_by_one_union() -> Bool:
	source: String =
		|fixed union Choice:
		|    Item
		|    Item
		|func main() -> Int:
		|    0
		|
	namespace_rejects([{ source = source, targets = [] }], pure func(program, failure):
		match failure.first:
			DuplicateVariantName(name, previous):
				failure.remaining.is_empty() and names_in(program, name.id, "Item") and same_span(name.span, root_span(33, 37)) and same_span(previous, root_span(24, 28))
			_: False
	)


pure func test_variant_function_failure_preserves_later_primary_site() -> Bool:
	source: String =
		|fixed union Choice:
		|    Item
		|pure func Item() -> Int:
		|    1
		|func main() -> Int:
		|    0
		|
	namespace_rejects([{ source = source, targets = [] }], pure func(program, failure):
		match failure.first:
			VariantFunctionNameConflict(name, variant, function):
				error = namespace_error(failure.first)
				failure.remaining.is_empty() and names_in(program, name, "Item") and same_span(variant, root_span(24, 28)) and same_span(function, root_span(39, 43)) and same_span(error.span, function)
			_: False
	)


pure func test_distinct_constructor_owners_and_function_type_names_stay_valid() -> Bool:
	source: String =
		|fixed union Left:
		|    Item
		|fixed union Right:
		|    Item
		|fixed record Shared { value: Int }
		|pure func Shared() -> Int:
		|    1
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program):
			match (build_namespace(program), find_name(parsed_contents(program).names, "Shared"), find_name(parsed_contents(program).names, "Item")):
				(Ok(namespace), Some(shared), Some(item)):
					match (function_candidate(namespace, root_module_id(), shared), type_candidate(namespace, root_module_id(), shared), variant_candidates(namespace, root_module_id(), item)):
						(Some(_), Some(RecordCandidate(_)), [left, right]): union_number(variant_owner(left)) != union_number(variant_owner(right)) and check(program).is_ok()
						_: False
				_: False


pure func test_unique_lookups_retain_definition_scope_and_absence() -> Bool:
	root: String =
		|func main() -> Int:
		|    0
		|
	owner: String =
		|fixed record Hidden { value: Int }
		|pure func hidden() -> Int:
		|    1
		|
	match parse_modules([{ source = root, targets = [] }, { source = owner, targets = [] }]):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			match (build_namespace(program), module_id(1), find_name(parsed.names, "Hidden"), find_name(parsed.names, "hidden")):
				(Ok(namespace), Some(module), Some(type_name), Some(function_name)):
					match (
						inventory_records(parsed.declarations), inventory_functions(parsed.declarations).get(1),
						type_candidate(namespace, module, type_name), function_candidate(namespace, module, function_name),
					):
						([type_row], Some(function), Some(RecordCandidate(type_id)), Some(candidate)):
							(
								record_number(type_id) == record_number(type_row.id)
								and function_number(candidate.function) == function_number(function.id)
								and type_candidate(namespace, root_module_id(), type_name).is_none()
								and function_candidate(namespace, root_module_id(), function_name).is_none()
							)
						_: False
				_: False


private pure func original_variant_note(program: ParsedProgram, problem: NamespaceProblem, expected: Span, exposure: Span) -> Bool:
	match problem:
		ImportedVariantNameConflict(name, previous):
			error = namespace_error(problem)
			diagnostic = render_check_error(program, error)
			typed = match error.kind:
				Errors.ImportRejection(Errors.ImportedVariantConflict(id, site)): same_name(id, name.id) and same_span(site, expected)
				_: False
			match diagnostic.note:
				Some(PreviousDeclaration(note)):
					typed and same_span(previous, expected) and same_span(note, expected) and same_span(name.span, exposure) and same_span(error.span, exposure) and diagnostic.message == "imported function conflicts with a local variant" and diagnostic.help == "give the imported function and local variant distinct names"
				_: False
		_: False


pure func test_forwarded_constructor_keeps_original_declaration_span() -> Bool:
	root: String =
		|import:
		|    ./facade: Choice(Item)
		|    ./functions: Item
		|func main() -> Int:
		|    0
		|
	facade: String =
		|import:
		|    ./owner: Choice
		|
	owner: String =
		|fixed union Choice:
		|    Item
		|
	functions: String =
		|pure func Item() -> Int:
		|    1
		|
	namespace_rejects([
		{ source = root, targets = [1, 2] }, { source = facade, targets = [3] },
		{ source = functions, targets = [] }, { source = owner, targets = [] },
	], pure func(program, failure):
		match (failure.first, failure.remaining, module_id(3)):
			(ImportedConstructorNameConflict(constructor, function), [variant], Some(owner_id)):
				original: Span = { source = module_source(owner_id), start = 24, end = 28 }
				same_span(constructor.span, root_span(29, 33)) and same_span(function, root_span(52, 56)) and original_variant_note(program, variant, original, root_span(52, 56))
			_: False
	)


pure func test_prelude_constructor_keeps_original_declaration_span() -> Bool:
	root: String =
		|import:
		|    ./functions: Item
		|func main() -> Int:
		|    0
		|
	functions: String =
		|pure func Item() -> Int:
		|    1
		|
	extra: String =
		|fixed union Choice:
		|    Item
		|
	foundation: TestFoundation = { types = TEST_BASE.types.concat(extra), prelude_selections = TEST_BASE.prelude_selections.concat(", Choice(Item)") }
	match parse_modules_with_base([{ source = root, targets = [1] }, { source = functions, targets = [] }], foundation):
		Err(_): False
		Ok(program):
			match (build_namespace(program), module_id(2), module_id(3)):
				(Err(failure), Some(base), Some(prelude)):
					match (failure.first, failure.remaining):
						(ImportedConstructorNameConflict(constructor, function), [ImportedConstructorNameConflict(_, _), variant]):
							original: Span = { source = module_source(base), start = TEST_BASE.types.length() + 24, end = TEST_BASE.types.length() + 28 }
							(
								same_source(constructor.span.source, module_source(prelude)) and not same_source(constructor.span.source, original.source)
								and same_span(function, root_span(25, 29)) and original_variant_note(program, variant, original, root_span(25, 29))
							)
						_: False
				_: False


-- Loading rejects these self edges. Direct assembly isolates receiver-origin
-- promotion without claiming that a cyclic input is an accepted program.
private pure func receiver_origin(source: String, expected: FunctionOrigin) -> Bool:
	match parse_modules([{ source = source, targets = [0] }]):
		Err(_): False
		Ok(program):
			parsed = parsed_contents(program)
			match build_namespace(program):
				Err(_): False
				Ok(namespace):
					match validate_declarations(parsed, namespace):
						Err(_): False
						Ok(declarations):
							match validate_finite_declarations(declarations):
								Err(_): False
								Ok(_):
									match (validate_signatures(parsed, namespace, declarations.unions), inventory_functions(parsed.declarations).get(0)):
										(Ok(signatures), Some(issued)):
											bindings = build_callables(namespace, signatures.functions).filter(pure func(binding): same_module(binding.module, root_module_id()) and function_number(binding.function) == function_number(issued.id))
											match bindings:
												[binding]:
													match (binding.origin, expected):
														(LocalFunction, LocalFunction): True
														(ImportedFunction(actual), ImportedFunction(site)): same_span(actual, site)
														_: False
												_: False
										_: False


pure func test_named_exposure_promotes_same_identity_before_method_selection() -> Bool:
	source: String =
		|import:
		|    ./self: R methods_only, pick
		|fixed record R { value: Int }
		|pure func pick(value: R) -> Int:
		|    value.value
		|func main() -> Int:
		|    0
		|
	receiver_origin(source, ImportedFunction(root_span(36, 40)))


pure func test_method_only_exposure_does_not_replace_local_origin() -> Bool:
	source: String =
		|import:
		|    ./self: R methods_only
		|fixed record R { value: Int }
		|pure func pick(value: R) -> Int:
		|    value.value
		|func main() -> Int:
		|    0
		|
	receiver_origin(source, LocalFunction)


pure func test_import_group_precedes_nominal_and_function_faults() -> Bool:
	source: String =
		|import:
		|    ./empty: absent
		|fixed union Choice:
		|    Item
		|    Item
		|pure func duplicate(value: Missing) -> Int:
		|    1
		|pure func duplicate() -> Int:
		|    2
		|func main() -> Int:
		|    0
		|
	namespace_rejects([{ source = source, targets = [1] }, { source = "", targets = [] }], pure func(program, failure):
		match (failure.first, failure.remaining):
			(ImportSelectionFailure(MissingImportedFunction(_, absent)), [DuplicateVariantName(item, previous), DuplicateFunctionName(function, first)]):
				same_span(absent.span, root_span(21, 27)) and same_span(item.span, root_span(61, 65)) and same_span(previous, root_span(52, 56)) and same_span(function.span, root_span(126, 135)) and same_span(first, root_span(76, 85))
			_: False
	)


tests: TestSuite = {
	description = "namespace publication priority",
	tests = [
		("duplicate function precedes earlier invalid annotation", test_duplicate_function_precedes_earlier_invalid_annotation),
		("duplicate union precedes earlier invalid payload annotation", test_duplicate_union_precedes_earlier_invalid_payload_annotation),
		("duplicate record precedes earlier invalid field annotation", test_duplicate_record_precedes_earlier_invalid_field_annotation),
		("function failure retains identity and both sites", test_function_failure_retains_declaration_identity_and_both_sites),
		("union failure retains identity and both sites", test_union_failure_retains_declaration_identity_and_both_sites),
		("record failure retains identity and both sites", test_record_failure_retains_declaration_identity_and_both_sites),
		("variant failure is owned by one union", test_variant_failure_is_owned_by_one_union),
		("variant function failure keeps later primary site", test_variant_function_failure_preserves_later_primary_site),
		("distinct constructor owners and function type names stay valid", test_distinct_constructor_owners_and_function_type_names_stay_valid),
		("unique lookups retain definition scope and absence", test_unique_lookups_retain_definition_scope_and_absence),
		("forwarded constructor keeps original declaration span", test_forwarded_constructor_keeps_original_declaration_span),
		("prelude constructor keeps original declaration span", test_prelude_constructor_keeps_original_declaration_span),
		("named exposure promotes identity before method selection", test_named_exposure_promotes_same_identity_before_method_selection),
		("method only exposure keeps local origin", test_method_only_exposure_does_not_replace_local_origin),
		("import group precedes nominal and function faults", test_import_group_precedes_nominal_and_function_faults),
	]
}
