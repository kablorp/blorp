				failure.remaining.is_empty() and names_in(program, name.id, "Choice") and same_span(name.span, root_span(49, 55)) and same_span(previous, root_span(12, 18))
			_: False
	)


pure func test_record_failure_retains_declaration_identity_and_both_sites() -> Bool:
	source: String =
		|fixed record Box { value: Missing }
		|fixed record Box { value: Int }
		|func main() -> Int:
