import:
	../../src/assemble: ParsedProgram, parsed_contents
	../../src/check: CheckFailure, check, check_errors, failure_program
	../../src/check_errors as Errors
	../../src/check_render: render_failure, render_check_error
	../../src/check_imports: namespace_error
	../../src/check_methods: build_callables
	../../src/check_signatures: validate_signatures
	../../src/check_types: validate_declarations, validate_finite_declarations
	../../src/declarations: function_number, inventory_functions, inventory_records, record_number, variant_owner, union_number
	../../src/names: NameId, find_name, same_name
	../../src/namespace:
		FunctionOrigin(LocalFunction, ImportedFunction), NamespaceFailure,
		NamespaceProblem(
			ImportSelectionFailure, DuplicateFunctionName, DuplicateUnionName, DuplicateTypeName,
			DuplicateVariantName, VariantFunctionNameConflict, ImportedConstructorNameConflict,
			ImportedVariantNameConflict,
		),
		ImportProblem(MissingImportedFunction),
		TypeCandidate(RecordCandidate), build_namespace, function_candidate, type_candidate, variant_candidates,
	../../src/source: module_id, module_source, root_module_id, same_module, same_source
	../../src/syntax: DiagnosticNote(TypeDeclaration, PreviousDeclaration), Span, same_span
	../../src/text: concat
	module_input: ModuleInput, TestFoundation, TEST_BASE, parse_modules, parse_modules_with_base
	test: TestSuite


private pure func root_span(start: Int, end: Int) -> Span:
	{ source = module_source(root_module_id()), start = start, end = end }


private pure func names_declaration(failure: CheckFailure, name: NameId, spelling: String) -> Bool:
	match find_name(parsed_contents(failure_program(failure)).names, spelling):
		Some(expected): same_name(name, expected)
		None: False


private pure func rendered_as(
	failure: CheckFailure,
	start: Int,
	end: Int,
	message: String,
	help: String,
	previous_type: Option[Span],
) -> Bool:
	errors = check_errors(failure)
	diagnostics = render_failure(failure)
	note_matches = match previous_type:
		None:
			diagnostics.first.note.is_none()
		Some(expected):
			match diagnostics.first.note:
				Some(TypeDeclaration(actual)): same_span(actual, expected)
				_: False
	(
		errors.remaining.is_empty() and diagnostics.remaining.is_empty()
		and same_span(errors.first.span, root_span(start, end))
		and same_span(diagnostics.first.span, errors.first.span)
		and diagnostics.first.message == message and diagnostics.first.help == help
		and note_matches
	)


pure func test_duplicate_function_precedes_earlier_invalid_annotation() -> Bool:
	source: String =
		|pure func answer(value: Missing) -> Int:
		|    1
		|pure func answer() -> Int:
		|    2
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					match check_errors(failure).first.kind:
						Errors.SignatureRejection(Errors.DuplicateFunction(name, previous)):
							(
								names_declaration(failure, name, "answer")
								and same_span(previous, root_span(10, 16))
								and rendered_as(failure, 57, 63, "duplicate function name", "give every function a distinct name", None)
							)
						_: False


pure func test_duplicate_union_precedes_earlier_invalid_payload_annotation() -> Bool:
	source: String =
		|fixed union Choice:
		|    One(Missing)
		|fixed union Choice:
		|    Two
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					match check_errors(failure).first.kind:
						Errors.TypeDeclarationRejection(Errors.DuplicateUnion(name, Errors.SourceTypeDeclaration(previous))):
							(
								names_declaration(failure, name, "Choice")
								and same_span(previous, root_span(12, 18))
								and rendered_as(
									failure, 49, 55,
									"duplicate union type name",
									"give union types distinct names; foundational types are declared by the base module",
									None,
								)
							)
						_: False


pure func test_duplicate_record_precedes_earlier_invalid_field_annotation() -> Bool:
	source: String =
		|fixed record Box { value: Missing }
		|fixed record Box { value: Int }
		|func main() -> Int:
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					match check_errors(failure).first.kind:
						Errors.TypeDeclarationRejection(Errors.DuplicateRecordType(name, Errors.SourceTypeDeclaration(previous))):
							(
								names_declaration(failure, name, "Box")
								and same_span(previous, root_span(13, 16))
								and rendered_as(
									failure, 49, 52,
									"duplicate type name", "give record and union types distinct names",
									Some(root_span(13, 16)),
								)
							)
						_: False


private pure func namespace_rejects(inputs: List[ModuleInput], expected: pure (ParsedProgram, NamespaceFailure) -> Bool) -> Bool:
	match parse_modules(inputs):
		Err(_): False
		Ok(program):
			match build_namespace(program):
				Ok(_): False
				Err(failure): expected(program, failure)


private pure func names_in(program: ParsedProgram, name: NameId, spelling: String) -> Bool:
	match find_name(parsed_contents(program).names, spelling):
		Some(expected): same_name(name, expected)
		None: False


pure func test_function_failure_retains_declaration_identity_and_both_sites() -> Bool:
	source: String =
		|pure func answer(value: Missing) -> Int:
		|    1
		|pure func answer() -> Int:
		|    2
		|func main() -> Int:
		|    0
		|
	namespace_rejects([{ source = source, targets = [] }], pure func(program, failure):
		match failure.first:
			DuplicateFunctionName(name, previous):
				failure.remaining.is_empty() and names_in(program, name.id, "answer") and same_span(name.span, root_span(57, 63)) and same_span(previous, root_span(10, 16))
			_: False
	)


pure func test_union_failure_retains_declaration_identity_and_both_sites() -> Bool:
	source: String =
		|fixed union Choice:
		|    One(Missing)
		|fixed union Choice:
