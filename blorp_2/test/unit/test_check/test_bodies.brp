import:
	../input: checked_source
	test: TestSuite


pure func test_payload_match_example_is_accepted() -> Bool:
	source: String =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Empty: 0
		|		Number(number): number
		|func main() -> Int:
		|	unwrap(Number(42))
		|

	match checked_source(source):
		Ok(_):
			True
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp 2 function bodies",
	tests = [
		("payload match example is accepted", test_payload_match_example_is_accepted),
	]
}
