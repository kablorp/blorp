import:
    ../../../src/load/load: load_test_program
    ../../../src/check/check: check
    ../../../src/check/render: render_failure
    ../../../src/utils/source: module_source, root_module_id, same_source
    fs: IOError, temporary_directory, resource_path
    option: is_none
    path as Path
    system: getcwd, temp_dir, write_file
    test: TestSuite


private func inspect_result(source: String, expected: Option[(String, String)]) -> Result[Bool, IOError]:
    with directory ?= temporary_directory(temp_dir(), "blorp-2-test-entry "):
        root = Path.join(directory.resource_path(), "main.brp")
        helper = Path.join(directory.resource_path(), "helper.brp")
        Ok(match write_file(helper, "import:\n    test: TestSuite\ntests: TestSuite = { description = \"entry\", tests = [] }\n"):
            Err(_): False
            Ok(_):
                match write_file(root, source):
                    Err(_): False
                    Ok(_):
                        match load_test_program(root, Path.join(getcwd(), "blorp_2/standard_library")):
                            Err(_): False
                            Ok(loaded):
                                match check(loaded.program):
                                    Ok(_): expected.is_none()
                                    Err(failure):
                                        errors = render_failure(failure)
                                        actual = errors.first
                                        match (expected, errors.remaining):
                                            (Some((message, help)), []):
                                                (
                                                    actual.message == message and actual.help == help
                                                    and same_source(actual.span.source, module_source(root_module_id()))
                                                    and actual.span.start == source.length() and actual.span.end == source.length()
                                                    and actual.note.is_none()
                                                )
                                            _: False
        )


private func inspect(source: String, expected: Option[(String, String)]) -> Bool:
    match inspect_result(source, expected):
        Ok(result): result
        Err(_): False


func test_local_constant() -> Bool:
    inspect("import:\n    test: TestSuite\ntests: TestSuite = { description = \"entry\", tests = [] }\n", None)


func test_missing_suite() -> Bool:
    inspect("func main() -> Int:\n    0\n", Some(("unknown value", "use this function's parameter name, a declared variant, or a call")))


func test_scalar_suite() -> Bool:
    inspect("tests: Int = 1\n", Some(("argument type does not match the parameter type", "use an expression of type TestSuite here")))


func test_old_impure_factory() -> Bool:
    inspect("import:\n    test: TestSuite\nfunc tests() -> TestSuite:\n    { description = \"entry\", tests = [] }\n", Some(("argument type does not match the parameter type", "use an expression of type TestSuite here")))


func test_old_parameter_factory() -> Bool:
    inspect("import:\n    test: TestSuite\npure func tests(value: Int) -> TestSuite:\n    { description = \"entry\", tests = [] }\n", Some(("argument type does not match the parameter type", "use an expression of type TestSuite here")))


func test_unresolved_generic() -> Bool:
    inspect("import:\n    test: TestSuite\npure func tests[T]() -> TestSuite:\n    { description = \"entry\", tests = [] }\n", Some(("cannot infer the type parameter from the argument", "pass a value whose type determines the declared type parameter; use a concrete helper when no argument can determine it")))


func test_wrong_nominal() -> Bool:
    inspect("import:\n    test as T\nfixed record OtherSuite { description: String, tests: List[(String, () -> Bool)] }\ntests: OtherSuite = { description = \"entry\", tests = [] }\n", Some(("argument type does not match the parameter type", "use an expression of type TestSuite here")))


func test_imported_visible_constant() -> Bool:
    inspect("import:\n    ./helper: tests\n", None)


tests: TestSuite = {
    description = "Blorp 2 actual target test entry contract",
    tests = [
        ("local constant", test_local_constant),
        ("missing suite", test_missing_suite),
        ("scalar suite", test_scalar_suite),
        ("old impure factory", test_old_impure_factory),
        ("old parameter factory", test_old_parameter_factory),
        ("unresolved generic", test_unresolved_generic),
        ("wrong nominal", test_wrong_nominal),
        ("imported visible constant", test_imported_visible_constant),
    ]
}
