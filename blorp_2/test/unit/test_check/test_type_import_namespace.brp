pure func test_forwarded_constructor_uses_original_union_owner() -> Bool:
	root: String =
		|import:
		|    ./facade: Choice(One)
		|func main() -> Int:
		|    0
		|
	facade: String =
		|import:
		|    ./owner: Choice()
		|
	owner: String =
		|fixed union Choice:
		|    One(Int)
		|    Two
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = facade,
				targets = [2]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match (
				candidate(input, 0, "Choice"),
				find_name(parsed_contents(input.program).names, "One"),
				module_id(1),
			):
				(Some(UnionCandidate(owner_id)), Some(name), Some(forwarder)):
					match scope_variants(input, root_module_id(), name):
						[variant]:
							(
								union_number(variant_owner(variant)) == union_number(owner_id)
								and variant_number(variant) == 0
								and scope_variants(input, forwarder, name).is_empty()
								and input.namespace.is_ok()
							)
						_:
							False
				_:
					False


pure func test_constructor_overlap_is_idempotent() -> Bool:
