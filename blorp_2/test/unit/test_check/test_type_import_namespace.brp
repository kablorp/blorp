		|    One
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1, 2]
			},
			{
				source = forward,
				targets = [3]
			},
			{
				source = forward,
				targets = [3]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match find_name(parsed_contents(input.program).names, "One"):
				Some(name):
					(
						scope_variants(input, root_module_id(), name).length() == 1
						and input.namespace.is_ok()
					)
				None:
					False


