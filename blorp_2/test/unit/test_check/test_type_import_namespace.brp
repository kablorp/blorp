		Ok(input):
			match scope_problems(input):
				[ImportSelectionFailure(MissingImportedFunction(_, _))]:
					candidate(input, 0, "Foo").is_none()
				_:
					False


pure func test_base_type_conflicts_with_distinct_local_declaration() -> Bool:
	root: String =
		|fixed record Int { value: String }
		|func main() -> Int:
		|    0
		|

	match (
		namespace_input(
			[
				{
					source = root,
					targets = []
				},
			],
		)
	):
		Err(_):
			False
		Ok(input):
			match scope_problems(input):
				[ImportSelectionFailure(ImportedTypeConflict(written, previous))]:
					parsed = parsed_contents(input.program)
					match inventory_records(parsed.declarations):
						[row]:
							(
								input.namespace.is_err() and record_number(row.id) == 0
								and same_module(row.declaration.module, root_module_id())
								and same_name(row.declaration.type_name.id, written.id)
								and same_source(written.span.source, module_source(root_module_id()))
								and written.span.start == 13 and written.span.end == 16
								and same_source(previous.source, module_source(parsed.foundation.prelude))
								and previous.start == 19 and previous.end == 22
							)
						_: False
				_:
					False


pure func test_prelude_selected_scope_obeys_explicit_module_roles() -> Bool:
	root: String =
		|func main() -> Int:
		|    0
		|
	operations: String =
		|import:
		|    _base: Int
		|fixed union Choice:
		|    One(Int)
		|pure func number(value: Choice) -> Int:
		|    42
		|pure func answer() -> Int:
		|    42
		|
	prelude: String =
		|import:
		|    _base: Int
		|    ./operations: Choice(One), answer
		|
	match role_namespace([
		{ source = root, targets = [], role = UserModule },
		{ source = "", targets = [], role = UserModule },
		{ source = "", targets = [], role = LibraryModule },
		{ source = operations, targets = [4], role = LibraryModule },
		{ source = TEST_BASE.types, targets = [], role = FoundationTypesModule },
		{ source = prelude, targets = [4, 3], role = FoundationPreludeModule },
	]):
		Err(_): False
		Ok(input):
			match (
				find_name(parsed_contents(input.program).names, "One"),
				find_name(parsed_contents(input.program).names, "answer"),
				module_id(1), module_id(2),
			):
				(Some(one), Some(answer), Some(helper), Some(library)):
					(
						same_visible_type(input, 0, 3, "Choice")
						and same_visible_type(input, 1, 3, "Choice")
						and candidate(input, 2, "Choice").is_none()
						and candidate(input, 4, "Choice").is_none()
						and candidate(input, 1, "Int").is_some()
						and candidate(input, 2, "Int").is_none()
						and candidate(input, 3, "Int").is_some()
						and scope_variants(input, root_module_id(), one).length() == 1
						and scope_variants(input, helper, one).length() == 1
						and scope_variants(input, library, one).is_empty()
						and scope_function(input, root_module_id(), answer).is_some()
						and scope_function(input, helper, answer).is_some()
						and scope_function(input, library, answer).is_none()
						and operation_requests(input).length() == 3
						and input.namespace.is_ok()
					)
				_: False


pure func test_local_prelude_declarations_do_not_supply_implicit_scope() -> Bool:
	root: String =
		|func main() -> Int:
		|    0
		|
	prelude: String =
		|fixed record Local { value: Int }
		|pure func hidden() -> Int:
		|    42
		|
	match role_namespace([
		{ source = root, targets = [], role = UserModule },
		{ source = TEST_BASE.types, targets = [], role = FoundationTypesModule },
		{ source = prelude, targets = [], role = FoundationPreludeModule },
	]):
		Err(_): False
		Ok(input):
			match find_name(parsed_contents(input.program).names, "hidden"):
				Some(hidden):
					(
						candidate(input, 0, "Local").is_none()
						and candidate(input, 2, "Local").is_some()
						and scope_function(input, root_module_id(), hidden).is_none()
						and namespace_methods(input).is_empty()
						and input.namespace.is_ok()
					)
				None: False


pure func test_explicit_and_prelude_function_overlap_is_idempotent() -> Bool:
	root: String =
		|import:
		|    ./operations: answer
		|func main() -> Int:
		|    answer()
		|
	operations: String =
		|pure func answer() -> Int:
		|    42
		|
	prelude: String =
		|import:
		|    ./operations: answer
		|
	match role_namespace([
		{ source = root, targets = [1], role = UserModule },
		{ source = operations, targets = [], role = LibraryModule },
		{ source = TEST_BASE.types, targets = [], role = FoundationTypesModule },
		{ source = prelude, targets = [1], role = FoundationPreludeModule },
	]):
		Err(_): False
		Ok(input):
			match find_name(parsed_contents(input.program).names, "answer"):
				Some(answer): scope_function(input, root_module_id(), answer).is_some() and input.namespace.is_ok()
				None: False


pure func test_methods_only_adds_no_constructor_bindings() -> Bool:
	root: String =
		|import:
		|    ./owner: Choice()
		|    ./operations: Choice methods_only
		|func main() -> Int:
		|    0
		|
	operations: String =
		|import:
		|    ./owner: Choice(One)
		|
	owner: String =
		|fixed union Choice:
		|    One
		|
	match namespace_input([
		{ source = root, targets = [2, 1] },
		{ source = operations, targets = [2] },
		{ source = owner, targets = [] },
	]):
		Err(_): False
		Ok(input):
			match (find_name(parsed_contents(input.program).names, "One"), module_id(1)):
				(Some(one), Some(operations_module)):
					(
						scope_variants(input, root_module_id(), one).is_empty()
						and scope_variants(input, operations_module, one).length() == 1
						and same_visible_type(input, 0, 2, "Choice")
						and input.namespace.is_ok()
					)
				_: False


pure func test_ambiguous_forwarded_type_keeps_both_identities_and_rejects_selection() -> Bool:
	root: String =
		|import:
		|    ./facade: Foo
		|func main() -> Int:
		|    0
		|
	facade: String =
		|import:
		|    ./left: Foo
		|    ./right: Foo
		|
	owner: String =
		|fixed record Foo { value: Int }
		|
	match namespace_input([
		{ source = root, targets = [1] },
		{ source = facade, targets = [2, 3] },
		{ source = owner, targets = [] },
		{ source = owner, targets = [] },
	]):
		Err(_): False
		Ok(input):
			match scope_problems(input):
				[ImportSelectionFailure(AmbiguousImportedType(target, requested)), ImportSelectionFailure(ImportedTypeConflict(written, previous))]:
					match module_id(1):
						Some(facade_id):
							(
								input.namespace.is_err() and distinct_record_owners(input, 2, 3, "Foo")
								and same_module(target, facade_id)
								and same_source(requested.span.source, module_source(root_module_id()))
								and requested.span.start == 22 and requested.span.end == 25
								and same_source(written.span.source, module_source(facade_id))
								and same_source(previous.source, module_source(facade_id))
								and written.span.start == 37 and written.span.end == 40
								and previous.start == 20 and previous.end == 23
							)
						None: False
				_: False


-- Base declarations reach a library module only through its own imports, and a
-- user module only through the prelude's selections.
pure func test_base_scope_comes_only_from_imports() -> Bool:
	root: String =
		|func main() -> Int:
		|    0
		|
	importing: String =
		|import:
		|    _base: Int, Option(Some, None)
		|
	prelude: String =
		|import:
		|    _base: Int
		|
	match role_namespace([
		{ source = root, targets = [], role = UserModule },
		{ source = "", targets = [], role = LibraryModule },
		{ source = importing, targets = [3], role = LibraryModule },
		{ source = TEST_BASE.types, targets = [], role = FoundationTypesModule },
		{ source = prelude, targets = [3], role = FoundationPreludeModule },
	]):
		Err(_): False
		Ok(input):
			match (find_name(parsed_contents(input.program).names, "Some"), module_id(1), module_id(2), module_id(4)):
				(Some(some), Some(silent), Some(importing_module), Some(prelude_module)):
					(
						candidate(input, 1, "Int").is_none() and candidate(input, 1, "Option").is_none()
						and scope_variants(input, silent, some).is_empty()
						and same_visible_type(input, 2, 3, "Int") and same_visible_type(input, 2, 3, "Option")
						and scope_variants(input, importing_module, some).length() == 1
						and same_visible_type(input, 0, 3, "Int") and same_visible_type(input, 4, 3, "Int")
						and candidate(input, 0, "Option").is_none() and candidate(input, 4, "Option").is_none()
						and scope_variants(input, root_module_id(), some).is_empty()
						and scope_variants(input, prelude_module, some).is_empty()
						and input.namespace.is_ok()
					)
				_: False


-- The prelude's shape: types come from base, and an operation module adds only
-- its receiver methods. User modules receive both; library modules neither.
pure func test_prelude_methods_only_selection_reaches_user_modules() -> Bool:
	root: String =
		|func main() -> Int:
		|    0
		|
	operations: String =
		|import:
		|    _base: Int
		|pure func doubled(value: Int) -> Int:
		|    value
		|
	prelude: String =
		|import:
		|    _base: Int
		|    ./operations: Int methods_only
		|
	match role_namespace([
		{ source = root, targets = [], role = UserModule },
		{ source = operations, targets = [2], role = LibraryModule },
		{ source = TEST_BASE.types, targets = [], role = FoundationTypesModule },
		{ source = prelude, targets = [2, 1], role = FoundationPreludeModule },
	]):
		Err(_): False
		Ok(input):
			match (operation_requests(input), module_id(1)):
				([from_prelude, for_root], Some(operations_module)):
					(
						same_module(from_prelude.module, module_id(3).get_or(root_module_id()))
						and same_module(for_root.module, root_module_id())
						and same_module(for_root.target, operations_module)
						and same_type_candidate(for_root.receiver, PrimitiveCandidate(BuiltinInt))
						and same_visible_type(input, 0, 2, "Int")
						and input.namespace.is_ok()
					)
				_: False


pure func test_library_module_without_base_import_cannot_name_int() -> Bool:
	root: String =
		|import:
		|    ops: answer
		|func main() -> Int:
		|    answer()
		|
	operations: String =
		|pure func answer() -> Int:
		|    42
		|
	prelude: String =
		|import:
		|    _base: Int
		|
	match role_namespace([
		{ source = root, targets = [1], role = UserModule },
		{ source = operations, targets = [], role = LibraryModule },
		{ source = TEST_BASE.types, targets = [], role = FoundationTypesModule },
		{ source = prelude, targets = [2], role = FoundationPreludeModule },
	]):
		Err(_): False
		Ok(input):
			match check(input.program):
				Ok(_): False
				Err(failure):
					diagnostic = render_failure(failure).first
					(
						same_source(diagnostic.span.source, module_source(module_id(1).get_or(root_module_id())))
						and diagnostic.span.start == 22 and diagnostic.span.end == 25
						and diagnostic.message == "unknown type"
						and diagnostic.help == "declare or import this type; builtin types and declared type parameters are also available"
					)


tests: TestSuite = {
	description = "Blorp 2 type import identities and complete visibility closure",
	tests = [
		("prelude selected scope obeys explicit module roles", test_prelude_selected_scope_obeys_explicit_module_roles),
		("base scope comes only from imports", test_base_scope_comes_only_from_imports),
		("library module without base import cannot name Int", test_library_module_without_base_import_cannot_name_int),
		("prelude methods only selection reaches user modules", test_prelude_methods_only_selection_reaches_user_modules),
		("local prelude declarations do not supply implicit scope", test_local_prelude_declarations_do_not_supply_implicit_scope),
		("explicit and prelude function overlap is idempotent", test_explicit_and_prelude_function_overlap_is_idempotent),
		("methods only adds no constructor bindings", test_methods_only_adds_no_constructor_bindings),
		("ambiguous forwarded type keeps identities and rejects selection", test_ambiguous_forwarded_type_keeps_both_identities_and_rejects_selection),
		(
			"bare record import retains owner and publishes method request",
			test_bare_record_import_retains_owner_and_publishes_method_request,
		),
		(
			"bare union import adds type without constructors",
			test_bare_union_import_adds_type_without_constructors,
		),
		(
			"builtin types forward through empty operation modules",
			test_builtin_types_forward_through_empty_operation_modules,
		),
		("forwarded record keeps original identity", test_forwarded_record_keeps_original_identity),
		("diamond forwarding is idempotent", test_diamond_forwarding_is_idempotent),
		("seeded forwarding cycle converges", test_seeded_forwarding_cycle_converges),
		(
			"unseeded forwarding cycle reports missing origin",
			test_unseeded_forwarding_cycle_reports_missing_origin,
		),
		("same spelled distinct types conflict", test_same_spelled_distinct_types_conflict),
		(
			"bare type and local function selector is ambiguous",
			test_bare_type_and_local_function_selector_is_ambiguous,
		),
		(
			"methods only requires independent caller type",
			test_methods_only_requires_independent_caller_type,
		),
		(
			"methods only rejects unrelated same named caller type",
			test_methods_only_rejects_unrelated_same_named_caller_type,
		),
		(
			"methods only accepts caller local declaration",
			test_methods_only_accepts_caller_local_declaration,
		),
		(
			"methods only is independent of import row order",
			test_methods_only_is_independent_of_import_row_order,
		),
		(
			"methods only unknown target type is typed",
			test_methods_only_unknown_target_type_is_typed,
		),
		(
			"forwarded constructor uses original union owner",
			test_forwarded_constructor_uses_original_union_owner,
		),
		("constructor overlap is idempotent", test_constructor_overlap_is_idempotent),
		(
			"repeated explicit constructor selection still rejects",
			test_repeated_explicit_constructor_selection_still_rejects,
		),
		(
			"function import does not forward types or dependency functions",
			test_function_import_does_not_forward_types_or_dependency_functions,
		),
		(
			"base type conflicts with distinct local declaration",
			test_base_type_conflicts_with_distinct_local_declaration,
		),
	]
}
