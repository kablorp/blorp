private pure func reordered_methods_valid(root: String, targets: List[Int]) -> Bool:
	operations: String =
		|import:
		|    ./owner: Foo
		|
	owner: String =
		|fixed record Foo { value: Int }
		|

	match (
		namespace_input([
			{
				source = root,
				targets = targets
			},
			{
				source = operations,
				targets = [2]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			(
				same_visible_type(input, 0, 2, "Foo")
				and operation_requests(input).length() == 3
				and input.namespace.is_ok()
			)


pure func test_methods_only_is_independent_of_import_row_order() -> Bool:
	first: String =
		|import:
		|    ./operations: Foo methods_only
		|    ./owner: Foo
		|func main() -> Int:
		|    0
		|
	last: String =
		|import:
		|    ./owner: Foo
		|    ./operations: Foo methods_only
		|func main() -> Int:
		|    0
		|
	reordered_methods_valid(
		first,
		[1, 2],
	) and reordered_methods_valid(
		last,
		[2, 1],
	)


