import:
	../../../src/utils/ids: VariantId, inventory_records, record_number, union_number, variant_number, variant_owner
	../../../src/utils/names: NameId, find_name, same_name
	../../../src/namespace/namespace:
		ImportProblem(
			AmbiguousImportSelection, AmbiguousImportedType, MissingImportedType, MethodTypeNotVisible,
			MissingImportedFunction, ImportedTypeConflict, RepeatedImportedVariant,
		),
		MethodSelectionRequest,
		Namespace, NamespaceFailure, NamespaceProblem(ImportSelectionFailure), FunctionCandidate,
		TypeCandidate(PrimitiveCandidate, ListCandidate, UnionCandidate, RecordCandidate),
		build_namespace,
		function_candidate,
		method_selection_requests,
		same_type_candidate,
		type_candidate,
		variant_candidates,
	../../../src/check/check: check
	../../../src/check/render: render_failure
	../../../src/lex/lex: lex
	../../../src/parse/assemble:
		ParsedAssembly,
		ParsedProgram,
		append_module,
		assembly_names,
		begin_program,
		parsed_contents,
		seal_program,
	../../../src/parse/parse: parse_module
	../../../src/namespace/builtins: PrimitiveType(BuiltinInt)
	../../../src/utils/source:
		COMPILER_SOURCE, ModuleId, ModuleKind(FoundationTypesModule, FoundationPreludeModule, LibraryModule, UserModule),
		module_id, module_source, root_module_id, same_module, same_source,
	../../../src/utils/syntax: Diagnostic
	../module_input: ModuleInput, TEST_BASE, parse_modules
	int as IntOps
	option: to_result
	result: and_then, map
	test: TestSuite


private fixed record NamespaceInput {
	program: ParsedProgram,
	namespace: Result[Namespace, NamespaceFailure]
}


private fixed record RoleModuleInput {
	source: String,
	targets: List[Int],
	role: ModuleKind
}


private INVENTORY_ERROR: Diagnostic = {
	span = { source = COMPILER_SOURCE, start = 0, end = 0 },
	note = None,
	message = "invalid namespace test inventory",
	help = "supply nonnegative module ordinals and one target for each written import"
}


private pure func append_role_module(
	assembly: ParsedAssembly,
	input: RoleModuleInput,
	position: Int,
) -> Result[ParsedAssembly, Diagnostic]:
	module ?= module_id(position).to_result(INVENTORY_ERROR)
	tokens ?= lex(module_source(module), input.source)
	parsed ?= parse_module(tokens, module, assembly_names(assembly))
	var resolved: Result[List[ModuleId], Diagnostic] = Ok([])
	for ordinal in input.targets:
		resolved = resolved.and_then(pure func(targets): module_id(ordinal).to_result(INVENTORY_ERROR).map(pure func(target): targets.append(target)))
	targets ?= resolved
	append_module(assembly, parsed, targets, input.role)


private pure func role_namespace(inputs: List[RoleModuleInput]) -> Result[NamespaceInput, Diagnostic]:
	var assembly: Result[ParsedAssembly, Diagnostic] = Ok(begin_program())
	var position: Int = 0
	for input in inputs:
		ordinal = position
		assembly = assembly.and_then(pure func(builder): append_role_module(builder, input, ordinal))
		position = IntOps.add(position, 1)
	complete ?= assembly
	program ?= seal_program(complete)
	Ok({ program = program, namespace = build_namespace(program) })


private pure func namespace_input(inputs: List[ModuleInput]) -> Result[NamespaceInput, Diagnostic]:
	program ?= parse_modules(inputs)
	Ok({
		program = program,
		namespace = build_namespace(program),
	})


-- A failed publication has no scope to query. Negative cases inspect all typed
-- namespace problems; positive cases require the successful Result explicitly.
private pure func scope_problems(input: NamespaceInput) -> List[NamespaceProblem]:
	match input.namespace:
		Ok(_): []
		Err(failure): [failure.first].concat(failure.remaining)


private pure func candidate(input: NamespaceInput, ordinal: Int, spelling: String) -> Option[TypeCandidate]:
	match input.namespace:
		Err(_): None
		Ok(namespace):
			match (module_id(ordinal), find_name(parsed_contents(input.program).names, spelling)):
				(Some(module), Some(name)): type_candidate(namespace, module, name)
				_: None


private pure func scope_function(input: NamespaceInput, module: ModuleId, name: NameId) -> Option[FunctionCandidate]:
	match input.namespace:
		Ok(namespace): function_candidate(namespace, module, name)
		Err(_): None


private pure func scope_variants(input: NamespaceInput, module: ModuleId, name: NameId) -> List[VariantId]:
	match input.namespace:
		Ok(namespace): variant_candidates(namespace, module, name)
		Err(_): []


private pure func namespace_methods(input: NamespaceInput) -> List[MethodSelectionRequest]:
	match input.namespace:
		Ok(namespace): method_selection_requests(namespace)
		Err(_): []


private pure func same_visible_type(
	input: NamespaceInput,
	left: Int,
	right: Int,
	spelling: String,
) -> Bool:
	match (candidate(input, left, spelling), candidate(input, right, spelling)):
		(Some(first), Some(second)):
			same_type_candidate(first, second)
		_:
			False


-- Even a failed publication retains the parsed producer's issued identities.
-- Inspect those declarations rather than querying an invalid Namespace.
private pure func distinct_record_owners(input: NamespaceInput, left: Int, right: Int, spelling: String) -> Bool:
	parsed = parsed_contents(input.program)
	match (module_id(left), module_id(right), find_name(parsed.names, spelling)):
		(Some(left_module), Some(right_module), Some(name)):
			rows = inventory_records(parsed.declarations)
			left_rows = rows.filter(pure func(row): same_module(row.declaration.module, left_module) and same_name(row.declaration.type_name.id, name))
			right_rows = rows.filter(pure func(row): same_module(row.declaration.module, right_module) and same_name(row.declaration.type_name.id, name))
			match (left_rows, right_rows):
				([first], [second]): record_number(first.id) != record_number(second.id)
				_: False
		_: False


-- Method requests that select from operation modules. Every user module also
-- receives the test prelude's selections from the base, whose method set is empty.
private pure func operation_requests(input: NamespaceInput) -> List[MethodSelectionRequest]:
	base = parsed_contents(input.program).foundation.types
	namespace_methods(input).filter(pure func(request): not same_module(request.target, base))


pure func test_bare_record_import_retains_owner_and_publishes_method_request() -> Bool:
	root: String =
		|import:
		|    ./foo: Foo
		|func main() -> Int:
		|    0
		|
	owner: String =
		|fixed record Foo { value: Int }
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match (
				candidate(input, 0, "Foo"),
				operation_requests(input),
				module_id(1),
			):
				(Some(RecordCandidate(receiver)), [request], Some(target)):
					(
						record_number(receiver) == 0
						and same_visible_type(input, 0, 1, "Foo")
						and same_module(request.module, root_module_id())
						and same_module(request.target, target)
						and same_type_candidate(request.receiver, RecordCandidate(receiver))
						and request.name.span.start == 19
						and request.name.span.end == 22
						and input.namespace.is_ok()
					)
				_:
					False


pure func test_bare_union_import_adds_type_without_constructors() -> Bool:
	root: String =
		|import:
		|    ./choice: Choice
		|func main() -> Int:
		|    0
		|
	owner: String =
		|fixed union Choice:
		|    One
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match find_name(parsed_contents(input.program).names, "One"):
				Some(name):
					(
						same_visible_type(input, 0, 1, "Choice")
						and scope_variants(input, root_module_id(), name).is_empty()
					)
				None:
					False


pure func test_builtin_types_forward_through_empty_operation_modules() -> Bool:
	root: String =
		|import:
		|    ./operations: Int, List
		|func main() -> Int:
		|    0
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = "",
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match (candidate(input, 0, "Int"), candidate(input, 0, "List")):
				(Some(PrimitiveCandidate(BuiltinInt)), Some(ListCandidate)):
					(
						same_visible_type(input, 0, 1, "Int")
						and operation_requests(input).length() == 2
						and input.namespace.is_ok()
					)
				_:
					False


pure func test_forwarded_record_keeps_original_identity() -> Bool:
	root: String =
		|import:
		|    ./facade: Foo
		|func main() -> Int:
		|    0
		|
	facade: String =
		|import:
		|    ./owner: Foo
		|
	owner: String =
		|fixed record Foo { value: Int }
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = facade,
				targets = [2]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			(
				same_visible_type(input, 0, 2, "Foo")
				and same_visible_type(input, 1, 2, "Foo")
				and input.namespace.is_ok()
			)


pure func test_diamond_forwarding_is_idempotent() -> Bool:
	root: String =
		|import:
		|    ./left: Foo
		|    ./right: Foo
		|func main() -> Int:
		|    0
		|
	forward: String =
		|import:
		|    ./owner: Foo
		|
	owner: String =
		|fixed record Foo { value: Int }
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1, 2]
			},
			{
				source = forward,
				targets = [3]
			},
			{
				source = forward,
				targets = [3]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			same_visible_type(input, 0, 3, "Foo") and input.namespace.is_ok()


pure func test_seeded_forwarding_cycle_converges() -> Bool:
	root: String =
		|import:
		|    ./left: Foo
		|func main() -> Int:
		|    0
		|
	left: String =
		|import:
		|    ./right: Foo
		|
	right: String =
		|import:
		|    ./left: Foo
		|fixed record Foo { value: Int }
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = left,
				targets = [2]
			},
			{
				source = right,
				targets = [1]
			},
		])
	):
		Err(_):
			False
		Ok(input):
			same_visible_type(input, 0, 2, "Foo") and input.namespace.is_ok()


pure func test_unseeded_forwarding_cycle_reports_missing_origin() -> Bool:
	root: String =
		|import:
		|    ./left: Foo
		|func main() -> Int:
		|    0
		|
	forward: String =
		|import:
		|    ./next: Foo
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = forward,
				targets = [2]
			},
			{
				source = forward,
				targets = [1]
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match scope_problems(input):
				[ImportSelectionFailure(MissingImportedFunction(_, _)), ImportSelectionFailure(MissingImportedFunction(_, _)), ImportSelectionFailure(MissingImportedFunction(_, _))]:
					candidate(input, 0, "Foo").is_none()
				_:
					False


pure func test_same_spelled_distinct_types_conflict() -> Bool:
	root: String =
		|import:
		|    ./left: Foo
		|    ./right: Foo
		|func main() -> Int:
		|    0
		|
	owner: String =
		|fixed record Foo { value: Int }
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1, 2]
			},
			{
				source = owner,
				targets = []
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match scope_problems(input):
				[ImportSelectionFailure(ImportedTypeConflict(written, previous))]:
					(
						input.namespace.is_err()
						and distinct_record_owners(input, 1, 2, "Foo")
						and same_source(written.span.source, module_source(root_module_id()))
						and same_source(previous.source, module_source(root_module_id()))
						and written.span.start == 37 and written.span.end == 40
						and previous.start == 20 and previous.end == 23
					)
				_:
					False


pure func test_bare_type_and_local_function_selector_is_ambiguous() -> Bool:
	root: String =
		|import:
		|    ./owner: Foo
		|func main() -> Int:
		|    0
		|
	owner: String =
		|fixed record Foo { value: Int }
		|pure func Foo() -> Int:
		|    1
		|

	match (
		namespace_input([
			{
				source = root,
				targets = [1]
			},
			{
				source = owner,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(input):
			match (
				scope_problems(input),
				find_name(parsed_contents(input.program).names, "Foo"),
			):
				([ImportSelectionFailure(AmbiguousImportSelection(_, written))], Some(name)):
					(
						written.span.start == 21
						and candidate(input, 0, "Foo").is_none()
						and scope_function(input, root_module_id(), name).is_none()
					)
				_:
					False


