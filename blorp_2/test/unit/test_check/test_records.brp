import:
	../../../src/utils/names: program_names
	../../../src/check/errors as Errors
	../../../src/check/check as API
	../../../src/check/model as Model
	../../../src/check/render: render_failure
	../../../src/utils/ids as Declaration
	../../../src/lex/lex: lex
	../../../src/namespace/namespace: ImportProblem(ImportedTypeConflict)
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax:
		Diagnostic,
		DiagnosticNote(PreviousField, RecordFieldDeclaration, TypeDeclaration),
	../input: check, check_failure, check_modules_failure, parse, setup_diagnostic
	../module_input:
		INTEGER_OPERATIONS,
		ModuleInput,
		PRIMITIVE_BASE,
		STRING_OPERATIONS,
		parse_modules_with_base,
	test: TestSuite


private INT_IMPORT: String = "import:\n\tint: to_string\n"

private PAIR: String =
	|fixed record Pair { first: Int, second: Int }
	|

private MAKE: String =
	|pure func make_pair() -> Pair:
	|	{ second = 9, first = 7 }
	|

private READ: String =
	|pure func read_first(value: Pair) -> Int:
	|	value.first
	|

private MAIN: String =
	|func main() -> Int:
	|	0
	|

private BAD_PREFIX: String =
	|pure func bad() -> Pair:
	|


private pure func checked(source: String) -> Result[API.CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	check(parsed).map_err(setup_diagnostic)


private pure func accepts(source: String) -> Bool:
	match checked(source):
		Ok(_):
			True
		_:
			False


private pure func rejects(
	prefix: String,
	marked: String,
	suffix: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(prefix + marked + suffix):
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)
		_:
			False


private pure func rejects_modules(
	inputs: List[ModuleInput],
	prefix: String,
	marked: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_modules_failure(inputs, PRIMITIVE_BASE):
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)
		_:
			False


pure func test_checked_fields_keep_nominal_owner_and_written_order() -> Bool:
	match checked(PAIR + MAKE + READ + MAIN):
		Ok(program):
			contents = API.checked_functions(program)

			match contents.records:
				[declaration]:
					match contents.functions:
						[make, read, _]:
							match make.body:
								Model.CheckedValueBody(Model.ReturnExpression(value)):
									match value.form:
										Model.ConstructRecord(owner, [second, first]):
											match read.body:
												Model.CheckedValueBody(Model.ReturnExpression(projected)):
													match projected.form:
														Model.ReadRecordField(_, field):
															(
																declaration.fields.length() == 2
																and Declaration.record_number(
																	owner,
																) == 0
																and Declaration.record_number(
																	Model.field_owner(
																		second.field,
																	),
																) == 0
																and Model.field_number(
																	second.field,
																) == 1
																and Model.field_number(
																	first.field,
																) == 0
																and Model.field_number(
																	field,
																) == 0
																and Model.same_type(
																	projected.value_type,
																	Model.IntType,
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_late_declaration_and_existing_generic_identity() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|	value
		|func main() -> Int:
		|	identity(make_pair()).first
		|
	accepts(source + MAKE + PAIR)


pure func test_recursive_call_through_literal_field_is_checked() -> Bool:
	read_prefix: String =
		|pure func read() -> Int:
		|
	make: String =
		|pure func make_pair() -> Pair:
		|	{ first = read(), second = 9 }
		|
	accepts(PAIR + read_prefix + "\tmake_pair().first\n" + make + MAIN)


pure func test_immediate_concrete_ufcs_supplies_literal_context() -> Bool:
	source: String =
		|func main() -> Int:
		|	{ first = 7, second = 9 }.read_first()
		|
	accepts(PAIR + READ + source)


pure func test_field_postfix_never_infers_literal_shape() -> Bool:
	main_prefix: String =
		|func main() -> Int:
		|
	prefix = PAIR + main_prefix + "\t"
	rejects(prefix, "{ first = 7, second = 9 }", ".first\n", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordNeedsExpectedType):
				True
			_:
				False
	)


pure func test_unique_generic_ufcs_supplies_concrete_literal_context() -> Bool:
	generic: String =
		|pure func read[T](value: Pair, other: T) -> Int:
		|	value.first
		|
	main_prefix: String =
		|func main() -> Int:
		|
	accepts(PAIR + generic + main_prefix + "\t{ first = 7, second = 9 }.read(1)\n")


pure func test_earlier_generic_argument_does_not_contextualize_later_literal() -> Bool:
	generic: String =
		|pure func pick[T](left: T, right: T) -> T:
		|	left
		|
	main_prefix: String =
		|func main() -> Int:
		|
	rejects(PAIR + MAKE + generic + main_prefix + "\tpick(make_pair(), ", "{ first = 7, second = 9 }", ").first\n", pure func(
		kind,
	):
		match kind:
			Errors.RecordRejection(Errors.RecordNeedsExpectedType):
				True
			_:
				False
	)


pure func test_record_copies_and_whole_value_reassignment() -> Bool:
	source: String =
		|func main() -> Int:
		|	var current = make_pair()
		|	original = current
		|	current = { second = 42, first = 1 }
		|	original.first
		|
	accepts(PAIR + MAKE + source)


pure func test_identical_layouts_are_nominally_distinct() -> Bool:
	other: String =
		|fixed record Other { first: Int, second: Int }
		|pure func wrong() -> Other:
		|
	rejects(PAIR + MAKE + other + "\t", "make_pair()", "\n" + MAIN, pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
				match mismatch.actual.value_type:
					Model.RecordType(actual):
						match mismatch.expected:
							Model.RecordType(expected):
								Declaration.record_number(
									actual,
								) != Declaration.record_number(expected)
							_:
								False
					_:
						False
			_:
				False
	)


pure func test_structural_errors_precede_children() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects(PAIR + helper_prefix + "\t{ ", "third", " = missing, first = 7 }\n" + MAIN, pure func(
		kind,
	):
		match kind:
			Errors.RecordRejection(Errors.UnknownRecordField(_, _)):
				True
			_:
				False
	)


pure func test_missing_fields_precede_children() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects(PAIR + helper_prefix + "\t", "{ first = missing }", "\n" + MAIN, pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.MissingRecordField(field, _)):
				Model.field_number(field) == 1
			_:
				False
	)


pure func test_empty_literal_reports_first_missing_field() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects(PAIR + helper_prefix + "\t", "{}", "\n" + MAIN, pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.MissingRecordField(field, _)):
				Model.field_number(field) == 0
			_:
				False
	)


pure func test_duplicate_literal_highlights_second_name() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects(PAIR + helper_prefix + "\t{ first = 7, ", "first", " = missing }\n" + MAIN, pure func(
		kind,
	):
		match kind:
			Errors.RecordRejection(Errors.DuplicateLiteralField(_, _)):
				True
			_:
				False
	)


pure func test_child_errors_precede_sibling_type_mismatch() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects_modules([
		{
			source = INT_IMPORT + PAIR + helper_prefix + "\t{ first = 1.to_string(), second = " + "missing" + (" }\n" + MAIN),
			targets = [1]
		},
		{
			source = INTEGER_OPERATIONS,
			targets = []
		},
	], INT_IMPORT + PAIR + helper_prefix + "\t{ first = 1.to_string(), second = ", "missing", pure func(
		kind,
	):
		match kind:
			Errors.ValueRejection(Errors.UnknownValue(_)):
				True
			_:
				False
	)


pure func test_field_type_error_covers_complete_child_and_annotation() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects_modules([
		{
			source = INT_IMPORT + PAIR + helper_prefix + "\t{ first = " + "1.to_string()" + (", second = 9 }\n" + MAIN),
			targets = [1]
		},
		{
			source = INTEGER_OPERATIONS,
			targets = []
		},
	], INT_IMPORT + PAIR + helper_prefix + "\t{ first = ", "1.to_string()", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordFieldTypeMismatch(field, actual, annotation)):
				(
					Model.field_number(field) == 0
					and annotation.span.start == INT_IMPORT.length() + 27
					and annotation.span.end == INT_IMPORT.length() + 30
					and Model.same_type(actual.value_type, Model.StringType)
				)
			_:
				False
	)


pure func test_unknown_projection_covers_field_name() -> Bool:
	rejects(PAIR + MAKE + "func main() -> Int:\n\tmake_pair().", "third", "\n", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.UnknownRecordField(_, _)):
				True
			_:
				False
	)


pure func test_nonrecord_projection_requires_parentheses_for_calls() -> Bool:
	rejects("func main() -> Int:\n\t7.", "length", "\n", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.FieldRequiresRecord(actual)):
				Model.same_type(actual, Model.IntType)
			_:
				False
	)


pure func test_mixed_fields_publish_exact_types() -> Bool:
	source: String =
		|fixed record Entry { count: Int, ratio: Float, text: String, empty: Void }
		|pure func make() -> Entry:
		|	{ count = 7, ratio = 2.5, text = "42", empty = void }
		|pure func escaped(value: Entry) -> String:
		|	value.text
		|func main() -> Int:
		|	unused = escaped(make())
		|	0
		|

	match checked(source):
		Ok(program):
			contents = API.checked_functions(program)

			match contents.records:
				[entry]:
					match entry.fields:
						[count, ratio, text, empty]:
							(
								Model.same_type(count.value_type.value_type, Model.IntType)
								and Model.same_type(ratio.value_type.value_type, Model.FloatType)
								and Model.same_type(text.value_type.value_type, Model.StringType)
								and Model.same_type(empty.value_type.value_type, Model.VoidType)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_unknown_field_annotation_remains_unknown_type() -> Bool:
	rejects("fixed record Bad { value: ", "Unknown", " }\n" + MAIN, pure func(kind):
		match kind:
			Errors.TypeTermRejection(Errors.UnknownType(_)):
				True
			_:
				False
	)


pure func test_record_union_conflict_highlights_later_name() -> Bool:
	rejects(PAIR + "fixed union ", "Pair", ":\n\tOnly\n" + MAIN, pure func(kind):
		match kind:
			Errors.TypeDeclarationRejection(Errors.DuplicateRecordType(_, Errors.SourceTypeDeclaration(previous))):
				previous.start == 13 and previous.end == 17
			_:
				False
	)


pure func test_union_record_conflict_highlights_later_name() -> Bool:
	rejects("fixed union Pair:\n\tOnly\nfixed record ", "Pair", " { first: Int }\n" + MAIN, pure func(
		kind,
	):
		match kind:
			Errors.TypeDeclarationRejection(Errors.DuplicateRecordType(_, Errors.SourceTypeDeclaration(previous))):
				previous.start == 12 and previous.end == 16
			_:
				False
	)


pure func test_type_parameter_conflicts_with_record() -> Bool:
	rejects(PAIR + "pure func identity[", "Pair", "](value: Pair) -> Pair:\n\tvalue\n" + MAIN, pure func(
		kind,
	):
		match kind:
			Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)):
				True
			_:
				False
	)


pure func test_record_literal_diagnostic_has_help_and_field_note() -> Bool:
	helper: String =
		|pure func bad() -> Pair:
		|	{}
		|
	source = PAIR + helper + MAIN

	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			match check(parsed):
				Err(failure):
					diagnostic = render_failure(failure).first

					match diagnostic.note:
						Some(RecordFieldDeclaration(declaration)):
							(
								diagnostic.message == "missing field in record literal"
								and diagnostic.help == "provide every declared record field exactly once"
								and declaration.start == 20
								and declaration.end == 25
							)
						_:
							False
				_:
					False
		_:
			False


private pure func diagnostic(source: String) -> Option[Diagnostic]:
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			match check(parsed):
				Err(failure):
					Some(render_failure(failure).first)
				Ok(_):
					None
		Err(_):
			None


private pure func diagnostic_modules(inputs: List[ModuleInput]) -> Option[Diagnostic]:
	match parse_modules_with_base(inputs, PRIMITIVE_BASE):
		Ok(parsed):
			match check(parsed):
				Err(failure):
					Some(render_failure(failure).first)
				Ok(_):
					None
		Err(_):
			None


private pure func rendered_as(source: String, message: String, help: String) -> Bool:
	match diagnostic(source):
		Some(error):
			error.message == message and error.help == help
		None:
			False


pure func test_duplicate_declaration_field_reports_previous_name() -> Bool:
	prefix = "fixed record Pair { first: Int, "
	rejects(prefix, "first", ": Int }\n" + MAIN, pure func(kind):
		match kind:
			Errors.TypeDeclarationRejection(Errors.DuplicateRecordField(_, previous)):
				previous.start == 20 and previous.end == 25
			_:
				False
	) and rendered_as(
		prefix + "first: Int }\n" + MAIN,
		"duplicate record field name",
		"give each field in a record a distinct name",
	)


pure func test_record_name_conflicts_with_base() -> Bool:
	rejects("fixed record ", "Int", " { first: Int }\n" + MAIN, pure func(kind):
		match kind:
			Errors.ImportRejection(Errors.ImportRejected(ImportedTypeConflict(_, _))):
				True
			_:
				False
	) and rendered_as(
		"fixed record Int { first: Int }\n" + MAIN,
		"imported type conflicts with another type",
		"give the types distinct names or remove the duplicate import",
	)


pure func test_unknown_field_render_names_nominal_owner() -> Bool:
	rendered_as(
		PAIR + BAD_PREFIX + "\t{ third = 7, second = 9 }\n" + MAIN,
		"unknown field 'third' in Pair",
		"use a field declared by the receiving record",
	)


pure func test_literal_without_context_teaches_concrete_helper() -> Bool:
	source: String =
		|func main() -> Int:
		|	unused = { first = 7, second = 9 }
		|	0
		|
	rendered_as(
		PAIR + source,
		"record literal needs an expected record type",
		(
			"pass the literal to a concrete record parameter or return it from a helper "
			+ "declaring that record"
		),
	)


pure func test_duplicate_literal_render_notes_first_written_name() -> Bool:
	prefix = PAIR + BAD_PREFIX + "\t{ "

	match diagnostic(prefix + "first = 7, first = 9 }\n" + MAIN):
		Some(error):
			match error.note:
				Some(PreviousField(previous)):
					(
						error.message == "duplicate field in record literal"
						and error.help == "write each record field exactly once"
						and previous.start == prefix.length()
						and previous.end == prefix.length() + 5
					)
				_:
					False
		_:
			False


pure func test_field_mismatch_render_notes_annotation() -> Bool:
	match (
		diagnostic_modules([
			{
				source = INT_IMPORT + PAIR + BAD_PREFIX + "\t{ first = 1.to_string(), second = 9 }\n" + MAIN,
				targets = [1]
			},
			{
				source = INTEGER_OPERATIONS,
				targets = []
			},
		])
	):
		Some(error):
			match error.note:
				Some(RecordFieldDeclaration(annotation)):
					(
						error.message == "record field requires Int"
						and error.help == "use an expression of type Int here"
						and annotation.start == INT_IMPORT.length() + 27
						and annotation.end == INT_IMPORT.length() + 30
					)
				_:
					False
		_:
			False


pure func test_nonrecord_field_render_teaches_call_parentheses() -> Bool:
	source: String =
		|func main() -> Int:
		|	7.length
		|
	rendered_as(
		source,
		"field access requires a record value",
		"read a declared record field, or use parentheses for a UFCS function call",
	)


pure func test_recursive_field_render_teaches_finite_scope() -> Bool:
	rendered_as(
		"fixed record Bad { field: Bad }\n" + MAIN,
		"recursive aggregate types are not supported yet",
		"use finite record and union fields; a non-generic union may refer to itself only as one direct variant payload, such as Next(Node)",
	)


pure func test_unused_self_recursive_record_rejects_typed_annotation() -> Bool:
	rejects("fixed record Node { next: ", "Node", " }\n" + MAIN, pure func(kind):
		match kind:
			Errors.TypeDeclarationRejection(Errors.RecursiveAggregateType(Model.RecordType(_))):
				True
			_:
				False
	)


pure func test_mutual_records_reject_closing_annotation() -> Bool:
	prefix: String = "fixed record First { next: Second }\nfixed record Second { next: "
	rejects(prefix, "First", " }\n" + MAIN, pure func(kind):
		match kind:
			Errors.TypeDeclarationRejection(Errors.RecursiveAggregateType(Model.RecordType(_))):
				True
			_:
				False
	)


pure func test_record_union_cycle_rejects_complete_application_annotation() -> Bool:
	prefix: String = "fixed union Box[T]:\n\tFull(T)\nfixed record Node { next: "
	rejects(prefix, "Box[Node]", " }\n" + MAIN, pure func(kind):
		match kind:
			Errors.TypeDeclarationRejection(Errors.RecursiveAggregateType(Model.RecordType(_))):
				True
			_:
				False
	)


pure func test_mixed_field_mismatch_retains_expected_and_actual_types() -> Bool:
	prefix: String = "fixed record Entry { ratio: Float }\npure func make() -> Entry:\n\t{ ratio = "
	rejects(prefix, "7", " }\n" + MAIN, pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordFieldTypeMismatch(_, actual, expected)):
				(
					Model.same_type(actual.value_type, Model.IntType)
					and Model.same_type(expected.value_type, Model.FloatType)
				)
			_:
				False
	)


tests: TestSuite = {
	description = "Checked fixed records",
	tests = [
		(
			"unused self recursive record typed rejection",
			test_unused_self_recursive_record_rejects_typed_annotation,
		),
		("mutual records close at exact annotation", test_mutual_records_reject_closing_annotation),
		(
			"record union recursion covers complete annotation",
			test_record_union_cycle_rejects_complete_application_annotation,
		),
		(
			"mixed field mismatch preserves expected and actual types",
			test_mixed_field_mismatch_retains_expected_and_actual_types,
		),
		(
			"literal child recursive call is checked",
			test_recursive_call_through_literal_field_is_checked,
		),
		(
			"duplicate declaration field and previous name",
			test_duplicate_declaration_field_reports_previous_name,
		),
		("record base type conflict", test_record_name_conflicts_with_base),
		("unknown field renders nominal owner", test_unknown_field_render_names_nominal_owner),
		("literal context help", test_literal_without_context_teaches_concrete_helper),
		(
			"duplicate literal previous field note",
			test_duplicate_literal_render_notes_first_written_name,
		),
		("field mismatch annotation note", test_field_mismatch_render_notes_annotation),
		(
			"nonrecord field call parentheses help",
			test_nonrecord_field_render_teaches_call_parentheses,
		),
		("recursive field finite-data help", test_recursive_field_render_teaches_finite_scope),
		(
			"checked fields retain nominal owner and written order",
			test_checked_fields_keep_nominal_owner_and_written_order,
		),
		(
			"late declaration and generic identity",
			test_late_declaration_and_existing_generic_identity,
		),
		(
			"concrete UFCS supplies immediate context",
			test_immediate_concrete_ufcs_supplies_literal_context,
		),
		("field postfix never infers literal shape", test_field_postfix_never_infers_literal_shape),
		("unique generic UFCS supplies concrete literal context", test_unique_generic_ufcs_supplies_concrete_literal_context),
		(
			"earlier generic argument does not contextualize later literal",
			test_earlier_generic_argument_does_not_contextualize_later_literal,
		),
		("copies and whole-value reassignment", test_record_copies_and_whole_value_reassignment),
		("identical layouts are nominally distinct", test_identical_layouts_are_nominally_distinct),
		("structural errors precede children", test_structural_errors_precede_children),
		("missing fields precede children", test_missing_fields_precede_children),
		(
			"empty literal reports first missing field",
			test_empty_literal_reports_first_missing_field,
		),
		("duplicate literal highlights second name", test_duplicate_literal_highlights_second_name),
		("child errors precede sibling mismatch", test_child_errors_precede_sibling_type_mismatch),
		(
			"field type error covers complete child and annotation",
			test_field_type_error_covers_complete_child_and_annotation,
		),
		("unknown projection covers name", test_unknown_projection_covers_field_name),
		(
			"nonrecord projection requires call parentheses",
			test_nonrecord_projection_requires_parentheses_for_calls,
		),
		("mixed fields publish exact types", test_mixed_fields_publish_exact_types),
		(
			"unknown field annotation remains UnknownType",
			test_unknown_field_annotation_remains_unknown_type,
		),
		(
			"record then union conflict highlights later declaration",
			test_record_union_conflict_highlights_later_name,
		),
		(
			"union then record conflict highlights later declaration",
			test_union_record_conflict_highlights_later_name,
		),
		("type parameter conflicts with record", test_type_parameter_conflicts_with_record),
		(
			"missing-field diagnostic has help and declaration note",
			test_record_literal_diagnostic_has_help_and_field_note,
		),
	]
}
