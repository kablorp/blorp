import:
	../../../src/utils/names: program_names
	../../../src/check/errors as Errors
	../../../src/check/check as API
	../../../src/check/model as Model
	../../../src/check/render: render_failure
	../../../src/utils/ids as Declaration
	../../../src/lex/lex: lex
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax:
		Diagnostic,
		DiagnosticNote(PreviousField, RecordFieldDeclaration),
	../input: check, check_failure, check_modules_failure, parse, setup_diagnostic
	../module_input:
		INTEGER_OPERATIONS,
		ModuleInput,
		primitive_base,
		STRING_OPERATIONS,
		parse_modules_with_base,
	test: TestSuite


private INT_IMPORT: String = "import:\n\tint: to_string\n"

private PAIR: String =
	|fixed record Pair { first: Int, second: Int }
	|

private MAKE: String =
	|pure func make_pair() -> Pair:
	|	{ second = 9, first = 7 }
	|

private READ: String =
	|pure func read_first(value: Pair) -> Int:
	|	value.first
	|

private MAIN: String =
	|func main() -> Int:
	|	0
	|

private BAD_PREFIX: String =
	|pure func bad() -> Pair:
	|


private pure func checked(source: String) -> Result[API.CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	check(parsed).map_err(setup_diagnostic)


private pure func accepts(source: String) -> Bool:
	match checked(source):
		Ok(_):
			True
		_:
			False


private pure func rejects(
	prefix: String,
	marked: String,
	suffix: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(prefix + marked + suffix):
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)
		_:
			False


private pure func rejects_modules(
	inputs: List[ModuleInput],
	prefix: String,
	marked: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_modules_failure(inputs, primitive_base()):
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)
		_:
			False


pure func test_checked_fields_keep_nominal_owner_and_written_order() -> Bool:
	match checked(PAIR + MAKE + READ + MAIN):
		Ok(program):
			contents = API.checked_functions(program)

			match contents.records:
				[declaration]:
					match contents.functions:
						[make, read, _]:
							match make.body:
								Model.CheckedValueBody(Model.ReturnExpression(value)):
									match value.form:
										Model.ConstructRecord(owner, [second, first]):
											match read.body:
												Model.CheckedValueBody(Model.ReturnExpression(projected)):
													match projected.form:
														Model.ReadRecordField(_, field):
															(
																declaration.fields.length() == 2
																and Declaration.record_number(
																	owner,
																) == 0
																and Declaration.record_number(
																	Model.field_owner(
																		second.field,
																	),
																) == 0
																and Model.field_number(
																	second.field,
																) == 1
																and Model.field_number(
																	first.field,
																) == 0
																and Model.field_number(
																	field,
																) == 0
																and Model.same_type(
																	projected.value_type,
																	Model.IntType,
																)
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_late_declaration_and_existing_generic_identity() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|	value
		|func main() -> Int:
		|	identity(make_pair()).first
		|
	accepts(source + MAKE + PAIR)


pure func test_recursive_call_through_literal_field_is_checked() -> Bool:
	read_prefix: String =
		|pure func read() -> Int:
		|
	make: String =
		|pure func make_pair() -> Pair:
		|	{ first = read(), second = 9 }
		|
	accepts(PAIR + read_prefix + "\tmake_pair().first\n" + make + MAIN)


pure func test_immediate_concrete_ufcs_supplies_literal_context() -> Bool:
	source: String =
		|func main() -> Int:
		|	{ first = 7, second = 9 }.read_first()
		|
	accepts(PAIR + READ + source)


pure func test_field_postfix_never_infers_literal_shape() -> Bool:
	main_prefix: String =
		|func main() -> Int:
		|
	prefix = PAIR + main_prefix + "\t"
	rejects(prefix, "{ first = 7, second = 9 }", ".first\n", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordNeedsExpectedType):
				True
			_:
				False
	)


pure func test_unique_generic_ufcs_supplies_concrete_literal_context() -> Bool:
	generic: String =
		|pure func read[T](value: Pair, other: T) -> Int:
		|	value.first
		|
	main_prefix: String =
		|func main() -> Int:
		|
	accepts(PAIR + generic + main_prefix + "\t{ first = 7, second = 9 }.read(1)\n")


private pure func pair_literal(value: Model.CheckedExpr, owner: Declaration.RecordId) -> Bool:
	match value.form:
		Model.ConstructRecord(actual_owner, [first, second]):
			match (first.value.form, second.value.form):
				(Model.LiteralInteger(7), Model.LiteralInteger(9)):
					(
						Model.same_type(value.value_type, Model.NominalType(Model.RecordAggregate(owner), []))
						and Model.same_type(Model.NominalType(Model.RecordAggregate(actual_owner), []), Model.NominalType(Model.RecordAggregate(owner), []))
						and Model.field_number(first.field) == 0 and Model.field_number(second.field) == 1
						and Model.same_type(first.value.value_type, Model.IntType)
						and Model.same_type(second.value.value_type, Model.IntType)
					)
				_: False
		_: False


private pure func sibling_literal_has_pair_type(arguments: String, literal_first: Bool) -> Bool:
	generic: String =
		|pure func pick[T](left: T, right: T) -> T:
		|	left
		|
	main_prefix: String =
		|func main() -> Int:
		|
	match checked(PAIR + MAKE + generic + main_prefix + "\tpick(" + arguments + ").first\n"):
		Ok(program):
			contents = API.checked_functions(program)
			match (contents.records, contents.functions):
				([declaration], [make, pick, main]):
					match main.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.ReadRecordField(receiver, field):
									match receiver.form:
										Model.InvokeFunction(call):
											match (call.target, call.operands):
												(Model.UserFunction(callee, [substitution]), [Model.ValueOperand(left), Model.ValueOperand(right)]):
													literal = if literal_first:
														left
													else:
														right
													sibling = if literal_first:
														right
													else:
														left
													match sibling.form:
														Model.InvokeFunction(sibling_call):
															match sibling_call.target:
																Model.UserFunction(sibling_id, []):
																	(
																		Declaration.function_number(callee) == Declaration.function_number(pick.id)
																		and Declaration.function_number(sibling_id) == Declaration.function_number(make.id)
																		and Model.same_type(substitution, Model.NominalType(Model.RecordAggregate(declaration.id), []))
																		and Model.same_type(value.value_type, Model.IntType)
																		and Model.field_number(field) == 0
																		and pair_literal(literal, declaration.id)
																	)
																_: False
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False
		Err(_): False


pure func test_earlier_generic_argument_contextualizes_later_literal() -> Bool:
	sibling_literal_has_pair_type("make_pair(), { first = 7, second = 9 }", False)


pure func test_later_generic_argument_contextualizes_earlier_literal() -> Bool:
	sibling_literal_has_pair_type("{ first = 7, second = 9 }, make_pair()", True)


private PICK: String =
	|pure func pick[T](left: T, right: T) -> T:
	|    left
	|pure func pick3[T](left: T, middle: T, right: T) -> T:
	|    left
	|


private pure func deferred_unknown(before: String, after: String) -> Bool:
	prefix = PAIR + MAKE + PICK + "func main() -> Int:\n    " + before
	structured = rejects(prefix, "missing", after + "\n", pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.UnknownValue(_)): True
			_: False
	)
	match diagnostic(prefix + "missing" + after + "\n"):
		Some(error):
			(
				structured and error.message == "unknown value"
				and error.help == "use this function's parameter name, a declared variant, or a call"
				and error.note.is_none()
				and error.span.start == prefix.length() and error.span.end == prefix.length() + "missing".length()
			)
		None: False


pure func test_deferred_record_child_errors_follow_sibling_inference() -> Bool:
	(
		deferred_unknown("pick(make_pair(), { first = ", ", second = 9 }).first")
		and deferred_unknown("pick({ first = ", ", second = 9 }, make_pair()).first")
	)


pure func test_later_ordinary_child_precedes_deferred_record_child() -> Bool:
	(
		deferred_unknown("pick3({ first = unknown, second = 9 }, make_pair(), ", ").first")
		and deferred_unknown("pick3(make_pair(), { first = unknown, second = 9 }, ", ").first")
	)


pure func test_sibling_context_reaches_literal_in_nested_generic_call() -> Bool:
	generic: String =
		|pure func identity[T](value: T) -> T:
		|    value
		|func main() -> Int:
		|    selected = pick(identity({ first = 7, second = 9 }), make_pair())
		|    selected.first
		|
	match checked(PAIR + MAKE + PICK + generic):
		Ok(program):
			contents = API.checked_functions(program)
			match (contents.records, contents.functions.get(4)):
				([declaration], Some(main)):
					match main.statements:
						[Model.InitializeBinding(_, value)]:
							match value.form:
								Model.InvokeFunction(outer):
									match outer.operands:
										[Model.ValueOperand(inner), Model.ValueOperand(_)]:
											match inner.form:
												Model.InvokeFunction(call):
													match (call.target, call.operands):
														(Model.UserFunction(_, [substitution]), [Model.ValueOperand(literal)]):
															Model.same_type(substitution, Model.NominalType(Model.RecordAggregate(declaration.id), [])) and pair_literal(literal, declaration.id)
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False
		Err(_): False


pure func test_deferred_record_still_validates_duplicate_and_missing_fields() -> Bool:
	prefix = PAIR + MAKE + PICK + "func main() -> Int:\n    pick("
	(
		rejects(prefix + "{ first = 7, ", "first", " = 9 }, make_pair()).first\n", pure func(kind):
			match kind:
				Errors.RecordRejection(Errors.DuplicateLiteralField(_, _)): True
				_: False
		)
		and rejects(prefix, "{ first = missing }", ", make_pair()).first\n", pure func(kind):
			match kind:
				Errors.RecordRejection(Errors.MissingRecordField(field, _)): Model.field_number(field) == 1
				_: False
		)
	)


pure func test_unresolved_sibling_literals_do_not_guess_same_shaped_records() -> Bool:
	other = "fixed record Other { first: Int, second: Int }\n"
	prefix = PAIR + other + PICK + "func main() -> Int:\n    unused = pick("
	literal = "{ first = 7, second = 9 }"
	suffix = ", " + literal + ")\n    0\n"
	rejects(prefix, literal, suffix, pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordNeedsExpectedType): True
			_: False
	) and rendered_as(prefix + literal + suffix,
		"record literal needs an expected record type",
		"pass the literal to a concrete record parameter or return it from a helper declaring that record")


pure func test_authoritative_nominal_conflict_precedes_deferred_literal() -> Bool:
	other: String =
		|fixed record Other { first: Int, second: Int }
		|pure func make_other() -> Other:
		|    { first = 1, second = 2 }
		|
	call_prefix = PAIR + MAKE + other + PICK + "func main() -> Int:\n    pick3("
	prefix = call_prefix + "make_pair(), "
	rejects(prefix, "make_other()", ", { first = 7, second = 9 }).first\n", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
				match (conflict.previous.value_type, conflict.current.value_type):
					(Model.NominalType(Model.RecordAggregate(previous), []), Model.NominalType(Model.RecordAggregate(current), [])):
						(
							Declaration.record_number(previous) == 0 and Declaration.record_number(current) == 1
							and conflict.previous.span.start == call_prefix.length()
							and conflict.previous.span.end == call_prefix.length() + "make_pair()".length()
							and conflict.current.span.start == prefix.length()
							and conflict.current.span.end == prefix.length() + "make_other()".length()
							and Model.same_type(conflict.mismatch.expected, conflict.previous.value_type)
							and conflict.mismatch.argument_position == 1
							and Model.parameter_position(conflict.parameter) == 0
						)
					_: False
			_: False
	)


pure func test_lambda_result_supplies_sibling_literal_context_in_both_orders() -> Bool:
	functions: String =
		|pure func choose[T](make: pure () -> T, value: T) -> T:
		|    make()
		|pure func reverse[T](value: T, make: pure () -> T) -> T:
		|    make()
		|func main() -> Int:
		|    first = choose(pure func(): make_pair(), { first = 7, second = 9 })
		|    second = reverse({ first = 7, second = 9 }, pure func(): make_pair())
		|    second.first
		|
	match checked(PAIR + MAKE + functions):
		Ok(program):
			match API.checked_functions(program).functions:
				[make, _, _, main]:
					match main.statements:
						[Model.InitializeBinding(_, first), Model.InitializeBinding(_, second)]:
							(
								Model.same_type(first.value_type, make.signature.return_type.value_type)
								and Model.same_type(second.value_type, make.signature.return_type.value_type)
							)
						_: False
				_: False
		Err(_): False


pure func test_sibling_list_context_reaches_deferred_record_element() -> Bool:
	functions: String =
		|pure func choose[T](left: List[T], right: List[T]) -> List[T]:
		|    left
		|func main() -> Int:
		|    values = choose([{ first = 7, second = 9 }], [make_pair()])
		|    0
		|
	match checked(PAIR + MAKE + functions):
		Ok(program):
			match API.checked_functions(program).functions:
				[make, _, main]:
					match main.statements:
						[Model.InitializeBinding(_, value)]:
							Model.same_type(value.value_type, Model.ListType(make.signature.return_type.value_type))
						_: False
				_: False
		Err(_): False


pure func test_resumed_field_lambda_retains_scope_and_distinct_admission_identity() -> Bool:
	source: String =
		|fixed record Holder { run: pure () -> Int }
		|pure func make() -> Holder:
		|    { run = pure func() -> Int: 7 }
		|pure func choose[T](left: T, ordinary: pure () -> Int, right: T) -> T:
		|    left
		|func main() -> Int:
		|    seed = 7
		|    selected = choose({ run = pure func() -> Int: seed }, pure func() -> Int: seed, make())
		|    callback: pure () -> Int = selected.run
		|    callback()
		|
	match checked(source):
		Ok(program):
			contents = API.checked_functions(program)
			match (contents.functions, contents.lambdas):
				([_, _, main], [_, ordinary, deferred]):
					identities = match main.statements:
						[Model.InitializeBinding(_, _), Model.InitializeBinding(_, selected), Model.InitializeBinding(_, _)]:
							match selected.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(literal), Model.CallableOperand(_, Model.LambdaCallable(ordinary_id, _), _), Model.ValueOperand(_)]:
											match literal.form:
												Model.ConstructRecord(_, [field]):
													match field.value.form:
														Model.MakeCallable(Model.LambdaCallable(field_id, _)):
															Model.lambda_number(ordinary_id) == 1 and Model.lambda_number(field_id) == 2
														_: False
												_: False
										_: False
								_: False
						_: False
					match (ordinary.captures, deferred.captures):
						([ordinary_capture], [field_capture]):
							(
								identities
								and Model.same_body(ordinary_capture.binding.owner, Model.DeclaredBody(main.id))
								and Model.same_body(field_capture.binding.owner, Model.DeclaredBody(main.id))
								and Model.binding_number(ordinary_capture.binding.binding) == 0
								and Model.binding_number(field_capture.binding.binding) == 0
								and Model.same_type(field_capture.value_type.value_type, Model.IntType)
							)
						_: False
				_: False
		Err(_): False


pure func test_joint_context_and_lambda_stall_reports_first_written_construct() -> Bool:
	functions: String =
		|pure func choose[T,A,B](value: T, callback: pure (A) -> B) -> Int:
		|    0
		|pure func reverse[A,B,T](callback: pure (A) -> B, value: T) -> Int:
		|    0
		|func main() -> Int:
		|
	prefix = PAIR + functions + "    "
	(
		rejects(prefix + "choose(", "{ first = 7, second = 9 }", ", pure func(value): value)\n", pure func(kind):
			match kind:
				Errors.RecordRejection(Errors.RecordNeedsExpectedType): True
				_: False
		)
		and rejects(prefix + "reverse(", "pure func(value): value", ", { first = 7, second = 9 })\n", pure func(kind):
			match kind:
				Errors.CallRejection(Errors.LambdaInputNeedsType): True
				_: False
		)
		and rendered_as(prefix + "reverse(pure func(value): value, { first = 7, second = 9 })\n",
			"cannot infer this lambda's input types", "annotate its parameters or supply a typed ordinary argument")
	)


pure func test_unknown_call_projection_does_not_guess_a_record_owner() -> Bool:
	prefix = PAIR + PICK + "func main() -> Int:\n    pick({ first = 7, second = 9 }, { first = 7, second = 9 })."
	rejects(prefix, "first", "\n", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.FieldRequiresRecord(_)): True
			_: False
	)


pure func test_rigid_parameter_never_supplies_a_nominal_record_head() -> Bool:
	prefix = PAIR + PICK + "pure func keep[A](value: A) -> A:\n    pick(value, "
	rejects(prefix, "{ first = 7, second = 9 }", ")\n" + MAIN, pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordNeedsExpectedType): True
			_: False
	)


pure func test_linked_placeholder_does_not_own_the_authoritative_conflict_note() -> Bool:
	declarations: String =
		|fixed record Other { first: Int, second: Int }
		|pure func make_other() -> Other:
		|    { first = 1, second = 2 }
		|pure func identity[T](value: T) -> T:
		|    value
		|
	call_prefix = PAIR + MAKE + declarations + PICK + "func main() -> Int:\n    pick3(identity({ first = 7, second = 9 }), "
	prefix = call_prefix + "make_pair(), "
	rejects(prefix, "make_other()", ").first\n", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
				(
					conflict.previous.span.start == call_prefix.length()
					and conflict.previous.span.end == call_prefix.length() + "make_pair()".length()
					and conflict.current.span.start == prefix.length()
					and conflict.current.span.end == prefix.length() + "make_other()".length()
				)
			_: False
	)


pure func test_bound_placeholder_preserves_the_later_authoritative_conflict_note() -> Bool:
	declarations: String =
		|fixed record Other { first: Int, second: Int }
		|pure func make_other() -> Other:
		|    { first = 1, second = 2 }
		|pure func choose4[T](value: T, callback: pure () -> T, witness: T, other: T) -> T:
		|    value
		|func main() -> Int:
		|
	witness_prefix = PAIR + MAKE + declarations + "    choose4({ first = 7, second = 9 }, pure func() -> Pair: make_pair(), "
	prefix = witness_prefix + "make_pair(), "
	rejects(prefix, "make_other()", ").first\n", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
				(
					conflict.previous.span.start == witness_prefix.length()
					and conflict.previous.span.end == witness_prefix.length() + "make_pair()".length()
					and conflict.current.span.start == prefix.length()
					and conflict.current.span.end == prefix.length() + "make_other()".length()
				)
			_: False
	)


pure func test_resumed_lambda_context_uses_written_order_for_stalled_diagnostic() -> Bool:
	declarations: String =
		|pure func identity[T](value: T) -> T:
		|    value
		|pure func choose[A,B](callback: pure () -> A, value: B) -> Int:
		|    0
		|func main() -> Int:
		|
	prefix = PAIR + declarations + "    choose(pure func(): identity("
	rejects(prefix, "{ first = 7, second = 9 }", "), { first = 7, second = 9 })\n", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordNeedsExpectedType): True
			_: False
	)


private pure func deferred_field_mismatch(before: String, after: String) -> Bool:
	prefix = PAIR + MAKE + PICK + "func main() -> Int:\n    " + before
	source = prefix + "\"bad\"" + after + "\n"
	structured = rejects(prefix, "\"bad\"", after + "\n", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordFieldTypeMismatch(field, actual, annotation)):
				(
					Model.field_number(field) == 0
					and Model.same_type(actual.value_type, Model.StringType)
					and Model.same_type(annotation.value_type, Model.IntType)
					and annotation.span.start == 27 and annotation.span.end == 30
				)
			_: False
	)
	match diagnostic(source):
		Some(error):
			match error.note:
				Some(RecordFieldDeclaration(annotation)):
					(
						structured and error.message == "record field requires Int"
						and error.help == "use an expression of type Int here"
						and annotation.start == 27 and annotation.end == 30
					)
				_: False
		None: False


pure func test_deferred_record_field_mismatch_retains_annotation_and_span() -> Bool:
	(
		deferred_field_mismatch("pick(make_pair(), { first = ", ", second = 9 }).first")
		and deferred_field_mismatch("pick({ first = ", ", second = 9 }, make_pair()).first")
	)


pure func test_record_copies_and_whole_value_reassignment() -> Bool:
	source: String =
		|func main() -> Int:
		|	var current = make_pair()
		|	original = current
		|	current = { second = 42, first = 1 }
		|	original.first
		|
	accepts(PAIR + MAKE + source)


pure func test_identical_layouts_are_nominally_distinct() -> Bool:
	other: String =
		|fixed record Other { first: Int, second: Int }
		|pure func wrong() -> Other:
		|
	rejects(PAIR + MAKE + other + "\t", "make_pair()", "\n" + MAIN, pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
				match mismatch.actual.value_type:
					Model.NominalType(Model.RecordAggregate(actual), []):
						match mismatch.expected:
							Model.NominalType(Model.RecordAggregate(expected), []):
								Declaration.record_number(
									actual,
								) != Declaration.record_number(expected)
							_:
								False
					_:
						False
			_:
				False
	)


pure func test_structural_errors_precede_children() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects(PAIR + helper_prefix + "\t{ ", "third", " = missing, first = 7 }\n" + MAIN, pure func(
		kind,
	):
		match kind:
			Errors.RecordRejection(Errors.UnknownRecordField(_, _)):
				True
			_:
				False
	)


pure func test_missing_fields_precede_children() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects(PAIR + helper_prefix + "\t", "{ first = missing }", "\n" + MAIN, pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.MissingRecordField(field, _)):
				Model.field_number(field) == 1
			_:
				False
	)


pure func test_empty_literal_reports_first_missing_field() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects(PAIR + helper_prefix + "\t", "{}", "\n" + MAIN, pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.MissingRecordField(field, _)):
				Model.field_number(field) == 0
			_:
				False
	)


pure func test_duplicate_literal_highlights_second_name() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects(PAIR + helper_prefix + "\t{ first = 7, ", "first", " = missing }\n" + MAIN, pure func(
		kind,
	):
		match kind:
			Errors.RecordRejection(Errors.DuplicateLiteralField(_, _)):
				True
			_:
				False
	)


pure func test_child_errors_precede_sibling_type_mismatch() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects_modules([
		{
			source = INT_IMPORT + PAIR + helper_prefix + "\t{ first = 1.to_string(), second = " + "missing" + (" }\n" + MAIN),
			targets = [1]
		},
		{
			source = INTEGER_OPERATIONS,
			targets = []
		},
	], INT_IMPORT + PAIR + helper_prefix + "\t{ first = 1.to_string(), second = ", "missing", pure func(
		kind,
	):
		match kind:
			Errors.ValueRejection(Errors.UnknownValue(_)):
				True
			_:
				False
	)


pure func test_field_type_error_covers_complete_child_and_annotation() -> Bool:
	helper_prefix: String =
		|pure func bad() -> Pair:
		|
	rejects_modules([
		{
			source = INT_IMPORT + PAIR + helper_prefix + "\t{ first = " + "1.to_string()" + (", second = 9 }\n" + MAIN),
			targets = [1]
		},
		{
			source = INTEGER_OPERATIONS,
			targets = []
		},
	], INT_IMPORT + PAIR + helper_prefix + "\t{ first = ", "1.to_string()", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordFieldTypeMismatch(field, actual, annotation)):
				(
					Model.field_number(field) == 0
					and annotation.span.start == INT_IMPORT.length() + 27
					and annotation.span.end == INT_IMPORT.length() + 30
					and Model.same_type(actual.value_type, Model.StringType)
				)
			_:
				False
	)


pure func test_unknown_projection_covers_field_name() -> Bool:
	rejects(PAIR + MAKE + "func main() -> Int:\n\tmake_pair().", "third", "\n", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.UnknownRecordField(_, _)):
				True
			_:
				False
	)


pure func test_nonrecord_projection_requires_parentheses_for_calls() -> Bool:
	rejects("func main() -> Int:\n\t7.", "length", "\n", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.FieldRequiresRecord(actual)):
				Model.same_type(actual, Model.IntType)
			_:
				False
	)


pure func test_mixed_fields_publish_exact_types() -> Bool:
	source: String =
		|fixed record Entry { count: Int, ratio: Float, text: String, empty: Void }
		|pure func make() -> Entry:
		|	{ count = 7, ratio = 2.5, text = "42", empty = void }
		|pure func escaped(value: Entry) -> String:
		|	value.text
		|func main() -> Int:
		|	unused = escaped(make())
		|	0
		|

	match checked(source):
		Ok(program):
			contents = API.checked_functions(program)

			match contents.records:
				[entry]:
					match entry.fields:
						[count, ratio, text, empty]:
							(
								Model.same_type(count.value_type.value_type, Model.IntType)
								and Model.same_type(ratio.value_type.value_type, Model.FloatType)
								and Model.same_type(text.value_type.value_type, Model.StringType)
								and Model.same_type(empty.value_type.value_type, Model.VoidType)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_unknown_field_annotation_remains_unknown_type() -> Bool:
	rejects("fixed record Bad { value: ", "Unknown", " }\n" + MAIN, pure func(kind):
		match kind:
			Errors.TypeTermRejection(Errors.UnknownType(_)):
				True
			_:
				False
	)


pure func test_type_parameter_conflicts_with_record() -> Bool:
	rejects(PAIR + "pure func identity[", "Pair", "](value: Pair) -> Pair:\n\tvalue\n" + MAIN, pure func(
		kind,
	):
		match kind:
			Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)):
				True
			_:
				False
	)


pure func test_record_literal_diagnostic_has_help_and_field_note() -> Bool:
	helper: String =
		|pure func bad() -> Pair:
		|	{}
		|
	source = PAIR + helper + MAIN

	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			match check(parsed):
				Err(failure):
					diagnostic = render_failure(failure).first

					match diagnostic.note:
						Some(RecordFieldDeclaration(declaration)):
							(
								diagnostic.message == "missing field in record literal"
								and diagnostic.help == "provide every declared record field exactly once"
								and declaration.start == 20
								and declaration.end == 25
							)
						_:
							False
				_:
					False
		_:
			False


private pure func diagnostic(source: String) -> Option[Diagnostic]:
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			match check(parsed):
				Err(failure):
					Some(render_failure(failure).first)
				Ok(_):
					None
		Err(_):
			None


private pure func diagnostic_modules(inputs: List[ModuleInput]) -> Option[Diagnostic]:
	match parse_modules_with_base(inputs, primitive_base()):
		Ok(parsed):
			match check(parsed):
				Err(failure):
					Some(render_failure(failure).first)
				Ok(_):
					None
		Err(_):
			None


private pure func rendered_as(source: String, message: String, help: String) -> Bool:
	match diagnostic(source):
		Some(error):
			error.message == message and error.help == help
		None:
			False


pure func test_duplicate_declaration_field_reports_previous_name() -> Bool:
	prefix = "fixed record Pair { first: Int, "
	rejects(prefix, "first", ": Int }\n" + MAIN, pure func(kind):
		match kind:
			Errors.TypeDeclarationRejection(Errors.DuplicateRecordField(_, previous)):
				previous.start == 20 and previous.end == 25
			_:
				False
	) and rendered_as(
		prefix + "first: Int }\n" + MAIN,
		"duplicate record field name",
		"give each field in a record a distinct name",
	)


pure func test_unknown_field_render_names_nominal_owner() -> Bool:
	rendered_as(
		PAIR + BAD_PREFIX + "\t{ third = 7, second = 9 }\n" + MAIN,
		"unknown field 'third' in Pair",
		"use a field declared by the receiving record",
	)


pure func test_literal_without_context_teaches_concrete_helper() -> Bool:
	source: String =
		|func main() -> Int:
		|	unused = { first = 7, second = 9 }
		|	0
		|
	rendered_as(
		PAIR + source,
		"record literal needs an expected record type",
		(
			"pass the literal to a concrete record parameter or return it from a helper "
			+ "declaring that record"
		),
	)


pure func test_duplicate_literal_render_notes_first_written_name() -> Bool:
	prefix = PAIR + BAD_PREFIX + "\t{ "

	match diagnostic(prefix + "first = 7, first = 9 }\n" + MAIN):
		Some(error):
			match error.note:
				Some(PreviousField(previous)):
					(
						error.message == "duplicate field in record literal"
						and error.help == "write each record field exactly once"
						and previous.start == prefix.length()
						and previous.end == prefix.length() + 5
					)
				_:
					False
		_:
			False


pure func test_field_mismatch_render_notes_annotation() -> Bool:
	match (
		diagnostic_modules([
			{
				source = INT_IMPORT + PAIR + BAD_PREFIX + "\t{ first = 1.to_string(), second = 9 }\n" + MAIN,
				targets = [1]
			},
			{
				source = INTEGER_OPERATIONS,
				targets = []
			},
		])
	):
		Some(error):
			match error.note:
				Some(RecordFieldDeclaration(annotation)):
					(
						error.message == "record field requires Int"
						and error.help == "use an expression of type Int here"
						and annotation.start == INT_IMPORT.length() + 27
						and annotation.end == INT_IMPORT.length() + 30
					)
				_:
					False
		_:
			False


pure func test_nonrecord_field_render_teaches_call_parentheses() -> Bool:
	source: String =
		|func main() -> Int:
		|	7.length
		|
	rendered_as(
		source,
		"field access requires a record value",
		"read a declared record field, or use parentheses for a UFCS function call",
	)


-- A record field is a pointer edge: a record may recurse through itself,
-- another record, or a generic union applied to itself.
pure func test_self_recursive_record_is_admitted() -> Bool:
	accepts("fixed record Bad { field: Bad }\n" + MAIN)


pure func test_unused_self_recursive_record_is_admitted() -> Bool:
	accepts("fixed record Node { next: Node }\n" + MAIN)


pure func test_mutual_records_are_admitted() -> Bool:
	accepts("fixed record First { next: Second }\nfixed record Second { next: First }\n" + MAIN)


pure func test_record_through_applied_union_is_admitted() -> Bool:
	source: String =
		|fixed union Box[T]:
		|	Full(T)
		|fixed record Node { next: Box[Node] }
		|

	accepts(source + MAIN)


pure func test_mixed_field_mismatch_retains_expected_and_actual_types() -> Bool:
	prefix: String = "fixed record Entry { ratio: Float }\npure func make() -> Entry:\n\t{ ratio = "
	rejects(prefix, "7", " }\n" + MAIN, pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.RecordFieldTypeMismatch(_, actual, expected)):
				(
					Model.same_type(actual.value_type, Model.IntType)
					and Model.same_type(expected.value_type, Model.FloatType)
				)
			_:
				False
	)


tests: TestSuite = {
	description = "Checked fixed records",
	tests = [
		(
			"unused self-recursive record admitted",
			test_unused_self_recursive_record_is_admitted,
		),
		("mutual records admitted", test_mutual_records_are_admitted),
		(
			"record through applied union admitted",
			test_record_through_applied_union_is_admitted,
		),
		(
			"mixed field mismatch preserves expected and actual types",
			test_mixed_field_mismatch_retains_expected_and_actual_types,
		),
		(
			"literal child recursive call is checked",
			test_recursive_call_through_literal_field_is_checked,
		),
		(
			"duplicate declaration field and previous name",
			test_duplicate_declaration_field_reports_previous_name,
		),
		("unknown field renders nominal owner", test_unknown_field_render_names_nominal_owner),
		("literal context help", test_literal_without_context_teaches_concrete_helper),
		(
			"duplicate literal previous field note",
			test_duplicate_literal_render_notes_first_written_name,
		),
		("field mismatch annotation note", test_field_mismatch_render_notes_annotation),
		(
			"nonrecord field call parentheses help",
			test_nonrecord_field_render_teaches_call_parentheses,
		),
		("self-recursive record admitted", test_self_recursive_record_is_admitted),
		(
			"checked fields retain nominal owner and written order",
			test_checked_fields_keep_nominal_owner_and_written_order,
		),
		(
			"late declaration and generic identity",
			test_late_declaration_and_existing_generic_identity,
		),
		(
			"concrete UFCS supplies immediate context",
			test_immediate_concrete_ufcs_supplies_literal_context,
		),
		("field postfix never infers literal shape", test_field_postfix_never_infers_literal_shape),
		("unique generic UFCS supplies concrete literal context", test_unique_generic_ufcs_supplies_concrete_literal_context),
		(
			"earlier generic argument contextualizes later literal",
			test_earlier_generic_argument_contextualizes_later_literal,
		),
		(
			"later generic argument contextualizes earlier literal",
			test_later_generic_argument_contextualizes_earlier_literal,
		),
		("linked placeholder does not own authoritative conflict note", test_linked_placeholder_does_not_own_the_authoritative_conflict_note),
		("bound placeholder preserves later authoritative conflict note", test_bound_placeholder_preserves_the_later_authoritative_conflict_note),
		("resumed lambda context preserves written stalled diagnostic order", test_resumed_lambda_context_uses_written_order_for_stalled_diagnostic),
		("joint context and lambda stall reports first written construct", test_joint_context_and_lambda_stall_reports_first_written_construct),
		("unknown call projection never guesses a record owner", test_unknown_call_projection_does_not_guess_a_record_owner),
		("rigid parameter never supplies nominal record head", test_rigid_parameter_never_supplies_a_nominal_record_head),
		("lambda results contextualize sibling literals in both orders", test_lambda_result_supplies_sibling_literal_context_in_both_orders),
		("sibling List context reaches a deferred record element", test_sibling_list_context_reaches_deferred_record_element),
		("resumed field lambda retains scope and distinct identity", test_resumed_field_lambda_retains_scope_and_distinct_admission_identity),
		("unresolved sibling literals never guess same-shaped record heads", test_unresolved_sibling_literals_do_not_guess_same_shaped_records),
		("authoritative nominal conflict precedes deferred literal", test_authoritative_nominal_conflict_precedes_deferred_literal),
		("nested generic call receives sibling literal context", test_sibling_context_reaches_literal_in_nested_generic_call),
		("deferred record validates duplicate and missing fields", test_deferred_record_still_validates_duplicate_and_missing_fields),
		("deferred record child errors follow sibling inference", test_deferred_record_child_errors_follow_sibling_inference),
		("ordinary later child precedes deferred record child", test_later_ordinary_child_precedes_deferred_record_child),
		("deferred field mismatch retains annotation and span", test_deferred_record_field_mismatch_retains_annotation_and_span),
		("copies and whole-value reassignment", test_record_copies_and_whole_value_reassignment),
		("identical layouts are nominally distinct", test_identical_layouts_are_nominally_distinct),
		("structural errors precede children", test_structural_errors_precede_children),
		("missing fields precede children", test_missing_fields_precede_children),
		(
			"empty literal reports first missing field",
			test_empty_literal_reports_first_missing_field,
		),
		("duplicate literal highlights second name", test_duplicate_literal_highlights_second_name),
		("child errors precede sibling mismatch", test_child_errors_precede_sibling_type_mismatch),
		(
			"field type error covers complete child and annotation",
			test_field_type_error_covers_complete_child_and_annotation,
		),
		("unknown projection covers name", test_unknown_projection_covers_field_name),
		(
			"nonrecord projection requires call parentheses",
			test_nonrecord_projection_requires_parentheses_for_calls,
		),
