import:
	../selection_inputs: checked_arm_variant, concrete_arm_variant
	../../../src/utils/names: program_names
	../../../src/check/model as Model
	../../../src/utils/ids as Declaration
	../../../src/check/check: check, check_errors, checked_functions
	../../../src/check/errors as Errors
	../../../src/lex/lex: lex
	../../../src/namespace/namespace: NamespaceProblem(NameConflict)
	../../../src/parse/assemble: ParsedAssembly, ParsedProgram, append_module, assembly_names, begin_program
	../../../src/parse/parse: parse_module
	../../../src/utils/source: ModuleId, ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule), module_id, module_source, root_module_id, same_source
	../../../src/utils/syntax: Diagnostic
	option: to_result
	../module_input: ModuleInput, test_base, parse_modules, sealed
	../input: setup_diagnostic, checked_tail_join
	test: TestSuite


private pure func accepts(inputs: List[ModuleInput]) -> Bool:
	match parse_modules(inputs):
		Err(_):
			False
		Ok(parsed):
			check(parsed)
				.is_ok()


private pure func rejects(
	inputs: List[ModuleInput],
	expected: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match parse_modules(inputs):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					expected(check_errors(failure).first.kind)


private OPS: String =
	|pure func number(value: Int) -> Int:
	|    value
	|


pure func test_method_import_does_not_enable_direct_call() -> Bool:
	root: String =
		|import:
		|    ./ops: Int methods
		|func main() -> Int:
		|    number(42)
		|
	rejects([
		{
			source = root,
			targets = [1]
		},
		{
			source = OPS,
			targets = []
		},
	], pure func(kind):
		match kind:
			Errors.CallRejection(Errors.UnknownFunction(_)):
				True
			_:
				False
	)


pure func test_method_only_selection_enables_receiver_call() -> Bool:
	root: String =
		|import:
		|    ./ops: Int methods
		|func main() -> Int:
		|    42.number()
		|
	accepts([
		{
			source = root,
			targets = [1]
		},
		{
			source = OPS,
			targets = []
		},
	])


pure func test_method_and_named_selection_merge_one_function() -> Bool:
	root: String =
		|import:
		|    ./ops: Int methods, number
		|func main() -> Int:
		|    value = number(42)
		|    value.number()
		|
	accepts([
		{
			source = root,
			targets = [1]
		},
		{
			source = OPS,
			targets = []
		},
	])


