private pure func append_role(
	assembly: ParsedAssembly,
	source: String,
	ordinal: Int,
	targets: List[ModuleId],
	role: ModuleKind,
) -> Result[ParsedAssembly, Diagnostic]:
	id ?= module_id(ordinal).to_result({
		span = {source = module_source(root_module_id()), start = 0, end = 0},
		note = None,
		message = "invalid test module ordinal",
		help = "use nonnegative ordinals",
	})
	tokens ?= lex(module_source(id), source, assembly_names(assembly))
	parsed ?= parse_module(tokens, id)
	append_module(assembly, parsed, targets, role)


private pure func equal_offset_conflict_program() -> Result[ParsedProgram, Diagnostic]:
	left = module_id(1).get_or(root_module_id())
	right = module_id(2).get_or(root_module_id())
	root_source: String =
		|import:
		|    ./right: pick
		|func main() -> Int:
		|    pick(42)
		|
	base_id = module_id(3).get_or(root_module_id())
	-- The base row follows the selection, so both imports of pick start at the same offset.
	prelude_source: String =
		|import:
		|    ./lefts: pick
		|    _base: Int
		|
	operation: String =
		|import:
		|    _base: Int
		|pure func pick(value: Int) -> Int:
		|    value
		|
	root ?= append_role(begin_program(), root_source, 0, [right], UserModule)
	first ?= append_role(root, operation, 1, [base_id], LibraryModule)
	second ?= append_role(first, operation, 2, [base_id], LibraryModule)
	base ?= append_role(second, test_base().types, 3, [], FoundationTypesModule)
	prelude ?= append_role(base, prelude_source, 4, [left, base_id], FoundationPreludeModule)
	sealed(prelude)


pure func test_equal_offsets_in_different_sources_retain_direct_function_conflict() -> Bool:
	match equal_offset_conflict_program():
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					error = check_errors(failure).first
					match error.kind:
						Errors.NamespaceRejection(NameConflict(conflict)):
							previous = conflict.previous.name.span
							(
								error.span.start == previous.start
								and error.span.end == previous.end
								and not same_source(error.span.source, previous.source)
							)
						_: False


private GENERIC_LIBRARY_PREFIX: String =
	|import:
	|    _base: String
	|fixed record Box[T] { value: T, label: String }
	|fixed union Pair[A, B]:
	|    Pair(A,${" "}


private pure func generic_library_program() -> Result[ParsedProgram, Diagnostic]:
	library = module_id(1).get_or(root_module_id())
	foundation = module_id(2).get_or(root_module_id())
	root_source: String =
		|import:
		|    ./library: Box, Pair(Pair)
		|pure func make(value: String) -> Pair[Box[String], String]:
		|    Pair({ value = value, label = value }, value)
		|pure func escape(value: Pair[Box[String], String]) -> String:
		|    match value:
		|        Pair(_, second): second
		|func main() -> Int:
		|    unused = escape(make("42"))
		|    0
		|
	prelude_source: String =
		|import:
		|    _base: Int, String
		|
	root ?= append_role(begin_program(), root_source, 0, [library], UserModule)
	declarations ?= append_role(root, GENERIC_LIBRARY_PREFIX + "B)\n", 1, [foundation], LibraryModule)
	base ?= append_role(declarations, test_base().types, 2, [], FoundationTypesModule)
	prelude ?= append_role(base, prelude_source, 3, [foundation], FoundationPreludeModule)
	sealed(prelude)


private pure func projects_second_field(selection: Model.CheckedSelection) -> Bool:
	match selection.nodes:
		[Model.EnterArm(_, [Model.BorrowPlace(place)])]:
			match place.route:
				Model.UnionField(_, _, ordinal): ordinal == 1
				_: False
		_: False


private pure func second_field_escapes(
	function: Model.CheckedFunction,
	variant: Declaration.VariantId,
	expected_parameter: Model.TypeRef,
) -> Bool:
	match (function.signature.parameters.get(0), checked_tail_join(function.body)):
		(Some(parameter), Some(body)):
			match body.arms:
				[arm]:
					match (checked_arm_variant(body.selection, arm.id), arm.inputs, arm.value):
						(Some(selected), captures, result):
							-- The selector records the field ordinal; body inputs contain only bindings.
							match (captures, result.form):
								([captured], Model.ReadBinding(returned)):
									(
										Model.same_variant(selected, variant)
										and captures.length() == 1 and projects_second_field(body.selection)
										and Model.binding_number(captured) == 1
										and Model.binding_number(returned) == Model.binding_number(captured)
										and Model.same_type(result.value_type, Model.StringType)
										and Model.same_type(parameter.value_type, expected_parameter)
									)
								_: False
						_: False
				_: False
		_: False


private pure func library_aggregate_facts(
	box: Model.CheckedRecord,
	pair: Model.CheckedUnion,
	escape: Model.CheckedFunction,
	library: ModuleId,
) -> Bool:
	match (box.type_parameters, pair.type_parameters, pair.variants, box.fields.get(0)):
		([record_parameter], [first_parameter, second_parameter], [variant], Some(field)):
			match (Model.parameter_owner(record_parameter), Model.parameter_owner(second_parameter), variant.fields):
				(Model.RecordDeclaration(record_owner), Model.UnionDeclaration(union_owner), [first, second]):
					expected = Model.NominalType(Model.UnionAggregate(union_owner), [Model.NominalType(Model.RecordAggregate(record_owner), [Model.StringType]), Model.StringType])
					(
						Declaration.record_number(record_owner) == 0
						and Declaration.union_number(union_owner) == 0
						and Model.parameter_position(record_parameter) == 0
						and Model.parameter_position(first_parameter) == 0
						and Model.parameter_position(second_parameter) == 1
						and Model.same_owner(Model.parameter_owner(first_parameter), Model.UnionDeclaration(union_owner))
						and Model.field_number(field.id) == 0
						and Declaration.record_number(Model.field_owner(field.id)) == 0
						and same_source(field.name.span.source, module_source(library))
						and Model.same_type(field.value_type.value_type, Model.ParameterType(record_parameter))
						and Model.same_type(first.value_type, Model.ParameterType(first_parameter))
						and Model.same_type(second.value_type, Model.ParameterType(second_parameter))
						and not Model.same_type(second.value_type, Model.ParameterType(record_parameter))
						and same_source(second.span.source, module_source(library))
						and second.span.start == GENERIC_LIBRARY_PREFIX.length()
						and second.span.end == GENERIC_LIBRARY_PREFIX.length() + 1
						and same_source(variant.name.span.source, module_source(library))
						and Declaration.union_number(Declaration.variant_owner(variant.id)) == 0
						and Declaration.variant_number(variant.id) == 0
						and second_field_escapes(escape, variant.id, expected)
					)
				_: False
		_: False


pure func test_imported_aggregate_fields_keep_owners_and_library_annotations() -> Bool:
	match generic_library_program().and_then(pure func(parsed): check(parsed).map_err(setup_diagnostic)):
		Err(_): False
		Ok(program):
			facts = checked_functions(program)
			match (facts.records, facts.unions.get(0), facts.functions.get(1), module_id(1)):
				([box], Some(pair), Some(escape), Some(library)):
					library_aggregate_facts(box, pair, escape, library)
				_: False


tests: TestSuite = {
	description = "method visibility",
	tests = [
		("imported aggregate owners and library annotation spans", test_imported_aggregate_fields_keep_owners_and_library_annotations),
		("equal offsets across sources retain function conflict", test_equal_offsets_in_different_sources_retain_direct_function_conflict),
		(
			"union named exposure merges method identity",
			test_union_method_and_named_selection_merge_identity,
		),
		(
			"union methods only reject direct calls",
			test_method_only_does_not_enable_direct_union_call,
		),
		("a method import rejects direct calls", test_method_import_does_not_enable_direct_call),
		(
			"method only selection enables receiver call",
			test_method_only_selection_enables_receiver_call,
		),
		(
			"named exposure merges with method exposure",
			test_method_and_named_selection_merge_one_function,
		),
		(
			"zero parameter functions excluded",
			test_method_import_excludes_zero_parameter_functions,
		),
		("bare generic receiver excluded", test_method_import_excludes_bare_generic_receiver),
		("named generic receiver accepted", test_named_import_enables_bare_generic_receiver),
		("visibility belongs to caller scope", test_method_visibility_is_owned_by_importing_scope),
	]
}
