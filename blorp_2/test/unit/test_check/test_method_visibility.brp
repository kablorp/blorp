pure func test_method_visibility_is_owned_by_importing_scope() -> Bool:
	root: String =
		|import:
		|    ./ops: Int methods
		|    ./helper: answer
		|func main() -> Int:
		|    answer().number()
		|
	helper: String =
		|import:
		|    ./ops: number
		|pure func answer() -> Int:
		|    number(42)
		|
	accepts([
		{
			source = root,
			targets = [1, 2]
		},
		{
			source = OPS,
			targets = []
		},
		{
			source = helper,
			targets = [1]
		},
	])


pure func test_union_method_and_named_selection_merge_identity() -> Bool:
	root: String =
		|import:
		|    ./ops: Option methods, number
		|pure func make() -> Option[Int]:
		|    Some(42)
		|func main() -> Int:
		|    first = number(make())
		|    make().number()
		|
	ops: String =
		|pure func number(value: Option[Int]) -> Int:
		|    42
		|
	accepts([
		{
			source = root,
			targets = [1]
		},
		{
			source = ops,
			targets = []
		},
	])


