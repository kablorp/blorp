import:
	../../../src/check/check: check, check_errors, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/model as Model
	../../../src/check/render: render_failure
	../../../src/namespace/builtins: check_builtin_types
	../../../src/utils/ids: function_number
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: DiagnosticNote(PreviousDeclaration), Span, entry_function, same_span
	../module_input: TEST_BASE, parse_modules_with_base
	../source_while_inputs as Input
	test: TestSuite


LIST_SUM: String =
	|pure func add(left: Int, right: Int) -> Int:
	|    builtin("int.add")
	|func main() -> Int:
	|    var total: Int = 0
	|    var last: Int = 0
	|    for item in [1, 2, 3]:
	|        local = item
	|        last = local
	|        total = add(total, item)
	|    total
	|


RANGE_SUM: String =
	|func main() -> Int:
	|    var total: Int = 0
	|    for item in 1..4:
	|        total = item
	|    total
	|


private pure func source_for(function: Model.CheckedFunction) -> Option[Model.CheckedFor]:
	var found: Option[Model.CheckedFor] = None
	for statement in function.statements:
		match statement:
			Model.RunFor(loop): found = Some(loop)
			_: void
	found


private pure func list_facts() -> Option[Bool]:
	parsed ?= parse_modules_with_base([{ source = LIST_SUM, targets = [] }], TEST_BASE).to_option()
	foundation ?= check_builtin_types(parsed).to_option()
	accepted ?= check(parsed).to_option()
	contents = checked_functions(accepted)
	function ?= contents.functions.get(function_number(entry_function(contents.entrypoint)))
	loop ?= source_for(function)
	item ?= loop.item
	definition ?= function.bindings.get(Model.binding_number(item))
	first ?= loop.carried.get(0)
	second ?= loop.carried.get(1)
	local ?= loop.body.get(0)
	immutable = match definition.mutability:
		Model.Immutable: True
		_: False
	local_read = match local:
		Model.InitializeBinding(id, value):
			match value.form:
				Model.ReadBinding(read): Model.binding_number(id) == 3 and Model.binding_number(read) == Model.binding_number(item)
				_: False
		_: False
	match loop.iteration:
		Model.ListIteration(iterable, element, option):
			Some(Model.same_type(element, Model.IntType)
				and Model.same_type(iterable.value_type, Model.ListType(Model.IntType))
				and Model.same_type(definition.value_type, element) and immutable and local_read
				and Model.same_variant(option.some, foundation.designated.option.some)
				and Model.same_variant(option.none, foundation.designated.option.none)
				and Model.binding_number(item) == 2 and function.bindings.length() == 4
				and Model.binding_number(first) == 0 and Model.binding_number(second) == 1
				and loop.carried.length() == 2 and loop.body.length() == 3)
		_: None


pure func test_list_retains_element_designation_item_and_ordered_carriers() -> Bool:
	list_facts().get_or(False)


private pure func range_facts() -> Option[Bool]:
	parsed ?= parse_modules_with_base([{ source = RANGE_SUM, targets = [] }], TEST_BASE).to_option()
	foundation ?= check_builtin_types(parsed).to_option()
	accepted ?= check(parsed).to_option()
	contents = checked_functions(accepted)
	function ?= contents.functions.get(function_number(entry_function(contents.entrypoint)))
	loop ?= source_for(function)
	item ?= loop.item
	definition ?= function.bindings.get(Model.binding_number(item))
	carried ?= loop.carried.get(0)
	match loop.iteration:
		Model.AscendingIntRange(start, end, boolean):
			bounds = match (start.form, end.form):
				(Model.LiteralInteger(1), Model.LiteralInteger(4)): True
				_: False
			Some(bounds and Model.same_type(start.value_type, Model.IntType)
				and Model.same_type(end.value_type, Model.IntType)
				and Model.same_type(definition.value_type, Model.IntType)
				and Model.same_variant(boolean.true_variant, foundation.designated.boolean.true_variant)
				and Model.same_variant(boolean.false_variant, foundation.designated.boolean.false_variant)
				and Model.binding_number(item) == 1 and Model.binding_number(carried) == 0
				and loop.carried.length() == 1 and function.bindings.length() == 2)
		_: None


pure func test_range_retains_ordered_int_bounds_and_designated_boolean() -> Bool:
	range_facts().get_or(False)


private pure func discard_facts() -> Option[Bool]:
	source: String =
		|func main() -> Int:
		|    var total: Int = 0
		|    for _ in [1, 2]:
		|        total = 7
		|    total
		|
	accepted ?= Input.checked(source).to_option()
	contents = checked_functions(accepted)
	function ?= contents.functions.get(function_number(entry_function(contents.entrypoint)))
	loop ?= source_for(function)
	Some(loop.item.is_none() and function.bindings.length() == 1 and loop.carried.length() == 1)


pure func test_discard_iteration_issues_no_item_binding() -> Bool:
	discard_facts().get_or(False)


private pure func rejects(
	source: String,
	start: Int,
	marked: String,
	message: String,
	help: String,
	previous: Option[Span],
	expected: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match parse_modules_with_base([{ source = source, targets = [] }], TEST_BASE):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					errors = check_errors(failure)
					diagnostics = render_failure(failure)
					error = diagnostics.first
					note = match (error.note, previous):
						(None, None): True
						(Some(PreviousDeclaration(actual)), Some(written)): same_span(actual, written)
						_: False
					(errors.remaining.is_empty() and diagnostics.remaining.is_empty()
						and expected(errors.first.kind) and note
						and same_span(errors.first.span, { source = module_source(root_module_id()), start = start, end = start + marked.length() })
						and same_span(error.span, errors.first.span)
						and error.message == message and error.help == help)


pure func test_noniterable_rejects_at_iterable_expression() -> Bool:
	prefix = "func main() -> Int:\n    for item in "
	rejects(prefix + "7:\n        unused = item\n    0\n", prefix.length(), "7",
		"for iterable must be a List or an Int range", "iterate a List value, or write start..end with Int bounds",
		None, pure func(kind):
			match kind:
				Errors.StatementRejection(Errors.NonIterableFor(actual)): Model.same_type(actual, Model.IntType)
				_: False
	)


private pure func bad_bound(prefix: String, suffix: String) -> Bool:
	rejects(prefix + "\"bad\"" + suffix, prefix.length(), "\"bad\"",
		"range bound must have type Int", "use an Int expression for each bound in start..end",
		None, pure func(kind):
			match kind:
				Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
					site = match mismatch.expected_site:
						Errors.ForRangeBound: True
						_: False
					site and Model.same_type(mismatch.expected, Model.IntType) and Model.same_type(mismatch.actual.value_type, Model.StringType)
				_: False
	)


pure func test_first_range_bound_has_exact_int_diagnostic() -> Bool:
	bad_bound("func main() -> Int:\n    for item in ", "..4:\n        unused = item\n    0\n")


pure func test_last_range_bound_has_exact_int_diagnostic() -> Bool:
	bad_bound("func main() -> Int:\n    for item in 1..", ":\n        unused = item\n    0\n")


pure func test_item_is_not_in_scope_after_loop() -> Bool:
	prefix = "func main() -> Int:\n    for item in [1]:\n        local = item\n    "
	rejects(prefix + "item\n", prefix.length(), "item", "unknown value",
		"use this function's parameter name, a declared variant, or a call",
		None, pure func(kind):
			match kind:
				Errors.ValueRejection(Errors.UnknownValue(_)): True
				_: False
	)


pure func test_item_cannot_shadow_enclosing_binding() -> Bool:
	header = "func main() -> Int:\n    "
	prefix = header + "item = 0\n    for "
	previous: Span = { source = module_source(root_module_id()), start = header.length(), end = header.length() + "item".length() }
	rejects(prefix + "item in [1]:\n        local = item\n    item\n", prefix.length(), "item",
		"`item` is already a local in this function", "choose a different name for this binding",
		Some(previous), pure func(kind):
			match kind:
				Errors.BindingRejection(Errors.LocalBindingConflict(site, Model.BodyLocal)): same_span(site.span, previous)
				_: False
	)


private pure func nearest_controls_facts() -> Option[Bool]:
	source: String =
		|func main() -> Int:
		|    for outer in [1, 2]:
		|        while True:
		|            if True:
		|                continue
		|            break
		|        continue
		|    0
		|
	accepted ?= Input.checked(source).to_option()
	contents = checked_functions(accepted)
	function ?= contents.functions.get(function_number(entry_function(contents.entrypoint)))
	outer ?= source_for(function)
	inner_statement ?= outer.body.get(0)
	outer_control ?= outer.body.get(1)
	match (inner_statement, outer_control):
		(Model.RunWhile(inner), Model.ContinueSourceLoop(_)):
			branch ?= inner.body.get(0)
			inner_control ?= inner.body.get(1)
			match (branch, inner_control):
				(Model.DiscardExpression(value), Model.BreakSourceLoop(_)):
					match value.form:
						Model.Match(join):
							arm ?= join.arms.get(0)
							control ?= arm.statements.get(0)
							match control:
								Model.ContinueSourceLoop(_): Some(outer.body.length() == 2 and inner.body.length() == 2)
								_: None
						_: None
				_: None
		_: None


pure func test_nested_controls_remain_in_nearest_lexical_body() -> Bool:
	nearest_controls_facts().get_or(False)


-- Pending full-control ownership: managed carried state requires the shared
-- exit/ownership port; no managed-H acceptance is claimed here.
tests: TestSuite = {
	description = "Blorp 2 source for checking",
	tests = [
		("List iteration retains typed facts and ordered carriers", test_list_retains_element_designation_item_and_ordered_carriers),
		("range retains ordered Int bounds and Bool identities", test_range_retains_ordered_int_bounds_and_designated_boolean),
		("discard iteration issues no item binding", test_discard_iteration_issues_no_item_binding),
		("noniterable exact diagnostic", test_noniterable_rejects_at_iterable_expression),
		("first range bound exact diagnostic", test_first_range_bound_has_exact_int_diagnostic),
		("last range bound exact diagnostic", test_last_range_bound_has_exact_int_diagnostic),
		("item scope ends at loop exit", test_item_is_not_in_scope_after_loop),
		("item cannot shadow enclosing binding", test_item_cannot_shadow_enclosing_binding),
		("nested controls retain nearest lexical bodies", test_nested_controls_remain_in_nearest_lexical_body),
	]
}
