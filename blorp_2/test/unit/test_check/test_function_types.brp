import:
	../../../src/check/check: check_errors
	../../../src/check/errors as Errors
	../../../src/check/render: render_check_error
	../../../src/utils/source: module_source, root_module_id, same_source
	../input: check, singleton_check_error
	../module_input: parse_modules
	test: TestSuite


private pure func rejects_callback(prefix: String, callback: String, suffix: String) -> Bool:
	match parse_modules([{ source = prefix + callback + suffix, targets = [] }]):
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					match singleton_check_error(check_errors(failure)):
						Some(error):
							match error.kind:
								Errors.UnsupportedSyntax(Errors.FunctionType):
									diagnostic = render_check_error(program, error)
									(
										same_source(error.span.source, module_source(root_module_id()))
										and error.span.start == prefix.length() and error.span.end == prefix.length() + callback.length()
										and same_source(diagnostic.span.source, error.span.source)
										and diagnostic.span.start == error.span.start and diagnostic.span.end == error.span.end
										and diagnostic.message == "callable types are only supported as function parameters"
										and diagnostic.help == "write pure function types only on function parameters; use ordinary data types inside them"
										and diagnostic.note.is_none()
									)
								_: False
						None: False


pure func test_callback_return_rejects_before_resolving_unknown_children() -> Bool:
	rejects_callback("func make() -> ", "pure (MissingInput) -> pure () -> MissingOutput", ":\n\t0\n")


pure func test_named_generic_callback() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|	value
		|
		|pure func apply[T, U](value: T, f: pure (T) -> U) -> U:
		|	f(value)
		|
		|func main() -> Int:
		|	apply(17, identity)
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program): check(program).is_ok()


pure func test_named_callback_cannot_bind_a_data_parameter_to_a_callable() -> Bool:
	declarations: String =
		|pure func higher(g: pure (Int) -> Int) -> Int:
		|	g(1)
		|pure func ignore[T](f: pure (T) -> Int) -> Int:
		|	0
		|func main() -> Int:
		|
	prefix = declarations + "\tignore("
	match parse_modules([{ source = prefix + "higher)\n", targets = [] }]):
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					match singleton_check_error(check_errors(failure)):
						None: False
						Some(error):
							match error.kind:
								Errors.CallRejection(Errors.CallableCandidateHasCallableParameters(_)):
									diagnostic = render_check_error(program, error)
									(
										error.span.start == prefix.length() and error.span.end == prefix.length() + 6
										and same_source(error.span.source, module_source(root_module_id()))
										and diagnostic.message == "callback signature must contain only data types"
										and diagnostic.help == "pass a named function whose parameters and result are ordinary data types"
										and diagnostic.note.is_none()
									)
								_: False


tests: TestSuite = {
	description = "Named callable parameters and unsupported callable storage",
	tests = [
		("named callback cannot turn an ordinary type parameter into a callable", test_named_callback_cannot_bind_a_data_parameter_to_a_callable),
		("named generic callback", test_named_generic_callback),
		("callback return rejects before resolving unknown children", test_callback_return_rejects_before_resolving_unknown_children),
	]
}
