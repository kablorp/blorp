import:
	../../../src/check/check: check_errors
	../../../src/check/errors as Errors
	../../../src/check/render: render_check_error
	../../../src/utils/source: module_source, root_module_id, same_source
	../input: check, singleton_check_error
	../module_input: parse_modules
	test: TestSuite


private pure func rejects_callback(prefix: String, callback: String, suffix: String) -> Bool:
	match parse_modules([{ source = prefix + callback + suffix, targets = [] }]):
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					match singleton_check_error(check_errors(failure)):
						Some(error):
							match error.kind:
								Errors.UnsupportedSyntax(Errors.FunctionType):
									diagnostic = render_check_error(program, error)
									(
										same_source(error.span.source, module_source(root_module_id()))
										and error.span.start == prefix.length() and error.span.end == prefix.length() + callback.length()
										and same_source(diagnostic.span.source, error.span.source)
										and diagnostic.span.start == error.span.start and diagnostic.span.end == error.span.end
										and diagnostic.message == "function types are not supported yet"
										and diagnostic.help == "declare a named function and call it directly; callback parameters are not available yet"
										and diagnostic.note.is_none()
									)
								_: False
						None: False


pure func test_callback_parameter_rejects_the_whole_written_type() -> Bool:
	rejects_callback("func use(callback: ", "pure (Int, String) -> Int", ") -> Int:\n\t0\n")


pure func test_callback_return_rejects_before_resolving_unknown_children() -> Bool:
	rejects_callback("func make() -> ", "pure (MissingInput) -> pure () -> MissingOutput", ":\n\t0\n")


tests: TestSuite = {
	description = "Function type syntax remains unsupported by checking",
	tests = [
		("callback parameter rejects the whole written type", test_callback_parameter_rejects_the_whole_written_type),
		("callback return rejects before resolving unknown children", test_callback_return_rejects_before_resolving_unknown_children),
	]
}
