import:
	../../../src/check/check: check
	../../../src/check/render: render_failure
	../../../src/utils/source: same_source, module_source, root_module_id
	../module_input: parse_modules
	string: String methods_only
	int: Int methods_only
	list: List methods_only
	bool: Bool methods_only
	option: Option methods_only
	test: TestSuite


private HEADER: String = "func run(program: String, args: List[String], out: String, err: String, timeout: Int) -> Result[Int, String]:"
private BODY: String = "\n    builtin(\"process.run_to_files\")\nfunc main() -> Int:\n    0\n"
private HELP: String = "declare an impure nongeneric function with String, List[String], String, String, Int parameters returning Result[Int, String]"


pure func test_exact_contract_is_accepted() -> Bool:
	match parse_modules([{ source = "${HEADER}${BODY}", targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): True
				Err(_): False


private pure func header_rejects(header: String) -> Bool:
	match parse_modules([{ source = "${header}${BODY}", targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					errors = render_failure(failure)
					actual = errors.first
					start = header.length().add("\n    builtin(".length())
					actual.message.equals("builtin declaration does not match its runtime contract")
						.and(actual.help.equals(HELP))
						.and(actual.span.start.equals(start))
						.and(actual.span.end.equals(start.add("\"process.run_to_files\"".length())))
						.and(same_source(actual.span.source, module_source(root_module_id())))
						.and(errors.remaining.is_empty())
						.and(actual.note.is_none())


pure func test_arity_and_string_list_are_closed() -> Bool:
	[
		"func run() -> Result[Int, String]:",
		"func run(program: String, args: List[Int], out: String, err: String, timeout: Int) -> Result[Int, String]:",
		"func run(program: String, args: String, out: String, err: String, timeout: Int) -> Result[Int, String]:",
		"func run(program: String, args: List[String], out: String, err: String, timeout: String) -> Result[Int, String]:",
	].all(header_rejects)


pure func test_result_and_purity_are_closed() -> Bool:
	[
		"pure ${HEADER}",
		"func run[Element](program: String, args: List[String], out: String, err: String, timeout: Int) -> Result[Int, String]:",
		"func run(program: String, args: List[String], out: String, err: String, timeout: Int) -> Result[String, String]:",
		"func run(program: String, args: List[String], out: String, err: String, timeout: Int) -> Result[Int, Int]:",
	].all(header_rejects)


tests: TestSuite = {
	description = "Process builtin contract",
	tests = [
		("exact impure five-parameter contract", test_exact_contract_is_accepted),
		("arity and String list reject unsupported declarations", test_arity_and_string_list_are_closed),
		("purity generics and Result payloads reject", test_result_and_purity_are_closed),
	]
}
