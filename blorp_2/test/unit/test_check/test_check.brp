import:
	../../../src/utils/names: program_names
	../../../src/utils/ids: function_number
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/check/check: checked_functions
	../../../src/check/model:
		CallTarget(UserFunction, RuntimeFunction, CallableParameter),
		CallableChoice(LambdaCallable),
		lambda_number,
		CheckedBody(CheckedValueBody),
		CheckedExit(ReturnExpression),
		CheckedForm(InvokeFunction, LiteralInteger, ReadBinding),
		CheckedFunction,
	../../../src/lex/lex: lex
	../../../src/utils/syntax: Purity(Impure), entry_function
	../input: check, checked_source, parse
	test: TestSuite


private pure func user_function_number(target: CallTarget) -> Option[Int]:
	match target:
		UserFunction(id, _, []):
			Some(function_number(id))
		UserFunction(_, _, _) | RuntimeFunction(_) | CallableParameter(_):
			None


private pure func form_of(function: CheckedFunction) -> Option[CheckedForm]:
	match function.body:
		CheckedValueBody(ReturnExpression(value)):
			Some(value.form)
		_:
			None


pure func test_resolved_forward_call_and_entrypoint() -> Bool:
	source: String =
		|func main() -> Int:
		|	one()
		|func one() -> Int:
		|	1
		|

	match lex(module_source(root_module_id()), source, program_names().names):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					match check(parsed):
						Err(_):
							False
						Ok(program):
							checked = checked_functions(program)

							match checked.functions:
								[first, second]:
									second_is_one: Bool = match form_of(second):
										Some(LiteralInteger(1)):
											True
										_:
											False

									match form_of(first):
										Some(InvokeFunction(call, [])):
											(
												user_function_number(call.target) == Some(1)
												and second_is_one
												and first.signature.purity == Impure
												and second.signature.purity == Impure
												and function_number(entry_function(checked.entrypoint)) == 0
											)
										_:
											False
								_:
									False


pure func test_self_recursion_is_checked() -> Bool:
	source: String =
		|func main() -> Int:
		|	main()
		|
	checked_source(source).is_ok()


pure func test_mutual_recursion_is_checked() -> Bool:
	source: String =
		|func main() -> Int:
		|	one()
		|func one() -> Int:
		|	main()
		|
	checked_source(source).is_ok()


pure func test_unused_recursive_helper_is_checked() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|func one() -> Int:
		|	one()
		|
	checked_source(source).is_ok()


pure func test_recursion_in_argument_is_checked() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|func loop() -> Int:
		|	identity(loop())
		|func main() -> Int:
		|	loop()
		|
	checked_source(source).is_ok()


pure func test_unary_recursion_is_checked() -> Bool:
	source: String =
		|func loop(value: Int) -> Int:
		|	loop(value)
		|func main() -> Int:
		|	loop(1)
		|
	checked_source(source).is_ok()


pure func test_recursion_after_inner_wrapper_is_checked() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|func loop(value: Int) -> Int:
		|	loop(identity(value))
		|func main() -> Int:
		|	loop(1)
		|
	checked_source(source).is_ok()


pure func test_special_spellings_resolve_by_role_and_declaration_order() -> Bool:
	source: String =
		|pure func Int(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	Int(1)
		|

	match checked_source(source):
		Err(_):
			False
		Ok(program):
			checked = checked_functions(program)

			match checked.functions:
				[helper, entrypoint]:
					match form_of(helper):
						Some(ReadBinding(_)):
							match form_of(entrypoint):
								Some(InvokeFunction(call, [_])):
									(
										function_number(entry_function(checked.entrypoint)) == 1
										and user_function_number(call.target) == Some(0)
									)
								_:
									False
						_:
							False
				_:
					False


private pure func returned_lambda_number(function: CheckedFunction) -> Option[Int]:
	match form_of(function):
		Some(InvokeFunction(call, _)):
			match call.target:
				UserFunction(_, _, [choice]):
					match choice.choice:
						LambdaCallable(id, []): Some(lambda_number(id))
						_: None
				_: None
		_: None


pure func test_successive_function_bodies_publish_distinct_lambda_rows() -> Bool:
	source: String =
		|pure func apply[T](callback: pure (T) -> T, value: T) -> T:
		|    callback(value)
		|pure func first(value: Int) -> Int:
		|    apply(pure func(item: Int): item, value)
		|pure func second(value: Int) -> Int:
		|    apply(pure func(item: Int): item, value)
		|func main() -> Int:
		|    0
		|
	match checked_source(source):
		Err(_): False
		Ok(program):
			checked = checked_functions(program)
			match (checked.functions, checked.lambdas):
				([dispatcher, first, second, main], [first_lambda, second_lambda]):
					(
						function_number(dispatcher.id) == 0 and function_number(first.id) == 1
							and function_number(second.id) == 2 and function_number(main.id) == 3
							and returned_lambda_number(first) == Some(0)
							and returned_lambda_number(second) == Some(1)
							and function_number(first_lambda.root) == function_number(first.id)
							and function_number(second_lambda.root) == function_number(second.id)
							and first_lambda.captures.is_empty() and second_lambda.captures.is_empty()
							and first_lambda.parameters.length() == 1 and second_lambda.parameters.length() == 1
					)
				_: False


pure func test_first_body_error_precedes_a_later_erroneous_declaration() -> Bool:
	prefix = "func first() -> Int:\n    "
	marked = "missing_first"
	suffix: String =
		|
		|func second() -> Int:
		|    missing_second
		|func main() -> Int:
		|    0
		|
	match checked_source(prefix + marked + suffix):
		Ok(_): False
		Err(error):
			(
				error.message == "unknown value"
					and error.help == "use this function's parameter name, a declared variant, or a call"
					and same_source(error.span.source, module_source(root_module_id()))
					and error.span.start == prefix.length() and error.span.end == prefix.length() + marked.length()
					and error.note.is_none()
			)


tests: TestSuite = {
	description = "Blorp 2 semantic checking",
	tests = [
		("successive function bodies publish distinct lambda rows", test_successive_function_bodies_publish_distinct_lambda_rows),
		("first body error precedes a later erroneous declaration", test_first_body_error_precedes_a_later_erroneous_declaration),
		(
			"special spellings resolve by role and declaration order",
			test_special_spellings_resolve_by_role_and_declaration_order,
		),
		(
			"recursion after a checked inner wrapper is accepted",
			test_recursion_after_inner_wrapper_is_checked,
		),
		("unary recursion is checked", test_unary_recursion_is_checked),
		("recursion inside a call argument is accepted", test_recursion_in_argument_is_checked),
		("resolved forward call and entrypoint", test_resolved_forward_call_and_entrypoint),
		("unused recursive helper is checked", test_unused_recursive_helper_is_checked),
		("self recursion is checked", test_self_recursion_is_checked),
		("mutual recursion is checked", test_mutual_recursion_is_checked),
	]
}
