import:
    ../../../src/check/check: check, checked_functions
    ../../../src/check/render: render_failure
    ../../../src/utils/source: module_source, root_module_id
    string: String methods
    ../../../src/check/model as Model
    ../module_input: parse_modules
    bool: and
    int: Int methods
    result: Result methods
    option: Option methods
    test: TestSuite


private SOURCE: String =
    |pure func produce(value: String) -> Result[String, String]:
    |    Ok(value)
    |pure func advance(value: String) -> Result[Int, String]:
    |    _ ?= produce(value)
    |    Ok(7)
    |func main() -> Int:
    |    0
    |


pure func test_discard_preserves_typed_match_capture() -> Bool:
    match parse_modules([{ source = SOURCE, targets = [] }]):
        Err(_): False
        Ok(parsed):
            match check(parsed):
                Err(_): False
                Ok(accepted):
                    match checked_functions(accepted).functions.get(1):
                        None: False
                        Some(function):
                            match function.body:
                                Model.CheckedValueBody(Model.ReturnExpression(value)):
                                    match value.form:
                                        Model.Match(join):
                                            match join.arms.get(0):
                                                None: False
                                                Some(arm):
                                                    match arm.inputs:
                                                        [capture]:
                                                            match function.bindings.get(Model.binding_number(capture)):
                                                                None: False
                                                                Some(definition):
                                                                    match definition.origin:
                                                                        Model.MatchCapture:
                                                                            (definition.value_type == Model.StringType)
                                                                                .and(arm.statements.is_empty())
                                                                                .and(join.arms.length().equals(2))
                                                                        _: False
                                                        _: False
                                        _: False
                                _: False


pure func test_named_void_payload_infers_without_annotation() -> Bool:
    source: String =
        |pure func complete() -> Result[Void, String]:
        |    Ok(void)
        |pure func advance() -> Result[Int, String]:
        |    quiet ?= complete()
        |    Ok(7)
        |func main() -> Int:
        |    0
        |
    match parse_modules([{ source = source, targets = [] }]):
        Err(_): False
        Ok(parsed): check(parsed).is_ok()


private DECLARATIONS: String =
    |pure func produce() -> Result[String, String]:
    |    Ok("value")
    |pure func complete() -> Result[Void, String]:
    |    Ok(void)
    |pure func optional() -> Option[String]:
    |    Some("value")
    |


private pure func rejects(header: String, before: String, marked: String, tail: String, message: String, help: String) -> Bool:
    prefix = "${DECLARATIONS}func advance() -> ${header}:\n    ${before}"
    source = "${prefix}${marked}\n    ${tail}\nfunc main() -> Int:\n    0\n"
    match parse_modules([{ source = source, targets = [] }]):
        Err(_): False
        Ok(parsed):
            match check(parsed):
                Ok(_): False
                Err(failure):
                    errors = render_failure(failure)
                    error = errors.first
                    error.message.equals(message).and(error.help.equals(help))
                        .and(error.span.source == module_source(root_module_id()))
                        .and(error.span.start.equals(prefix.length()))
                        .and(error.span.end.equals(prefix.length().add(marked.length())))
                        .and(errors.remaining.is_empty()).and(error.note.is_none())


pure func test_result_only_rules_still_apply() -> Bool:
    rejects("Int", "", "_ ?= complete()", "0", "`?=` requires a Result-returning function",
        "return Result[Value, Error] from this function, or match on the value explicitly")
        .and(rejects("Result[Int, String]", "_ ?= ", "optional()", "Ok(7)", "`?=` requires a Result value",
            "use a Result value here, or match on the value explicitly"))


pure func test_success_annotation_and_error_types_still_apply() -> Bool:
    rejects("Result[Int, String]", "_: Int ?= ", "produce()", "Ok(7)", "expression does not match the expected type",
        "use an expression of type Result[Int, String] here")
        .and(rejects("Result[Int, Int]", "_ ?= ", "produce()", "Ok(7)", "expression does not match the expected type",
            "use an expression of type Result[String, Int] here"))


tests: TestSuite = {
    description = "Discard Result propagation checking",
    tests = [
        ("managed success keeps the existing typed match capture", test_discard_preserves_typed_match_capture),
        ("named Void success needs no annotation", test_named_void_payload_infers_without_annotation),
        ("Result-return and Result-source requirements remain", test_result_only_rules_still_apply),
        ("annotations and error types remain checked", test_success_annotation_and_error_types_still_apply),
    ]
}
