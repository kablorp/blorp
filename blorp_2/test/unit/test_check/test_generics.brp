private pure func callback_contract(
	function: Model.CheckedFunction,
	input: Model.TypeRef,
	argument: Model.TypeRef,
	result: Model.TypeRef,
	returned: Model.TypeRef,
	selected: VariantId,
	bypassed: VariantId,
) -> Bool:
	signature = match function.signature.parameters:
		[value, callback]:
			(
				Model.same_type(value.value_type, input)
				and Model.same_type(callback.value_type, Model.CallableType(Pure, [argument], result))
				and Model.same_type(function.signature.return_type.value_type, returned)
			)
		_: False
	rigid = function.signature.type_parameters.all(pure func(parameter):
		match Model.parameter_owner(parameter):
			Model.FunctionDeclaration(owner): function_number(owner) == function_number(function.id)
			_: False
	)
	match checked_tail_join(function.body):
		Some(matched):
			var selected_count = 0
			var bypass_count = 0
			var passed = signature and rigid and function.statements.is_empty()
			for arm in matched.arms:
				calls = Model.function_calls({ function | statements = arm.statements, body = Model.CheckedValueBody(Model.ReturnExpression(arm.value)) })
				match checked_arm_variant(matched.selection, arm.id):
					Some(variant):
						if Model.same_variant(variant, selected):
							selected_count = selected_count + 1
							valid_call = match calls:
								[call]:
									match call.target:
										Model.CallableParameter(parameter): Model.same_callable_parameter(parameter, Model.callable_parameter(function.id, 1))
										_: False
								_: False
							passed = passed and valid_call
						else:
							bypass_count = bypass_count + 1
							passed = passed and Model.same_variant(variant, bypassed) and calls.is_empty()
					None:
						-- A final nullary alternative is selected by excluding the tested tag.
						match (matched.selection.nodes.get(Model.decision_node_number(matched.selection.entry)), arm.value.form):
							(Some(Model.TestVariant(place, tested, _, when_false)), Model.ConstructVariant(returned_variant, [])):
								match (place.route, matched.selection.nodes.get(Model.decision_node_number(when_false))):
									(Model.MatchRoot, Some(Model.EnterArm(target, []))):
										bypass_count = bypass_count + 1
										passed = (
											passed and Model.same_variant(tested, selected) and Model.same_variant(returned_variant, bypassed)
											and Model.same_type(place.value_type, input) and Model.match_arm_number(target) == Model.match_arm_number(arm.id)
											and arm.inputs.is_empty() and calls.is_empty()
										)
									_: passed = False
							_: passed = False
			passed and selected_count == 1 and bypass_count == 1 and Model.function_calls(function).length() == 1
		_: False


private pure func callback_helpers(
	optional: Model.CheckedFunction,
	mapped: Model.CheckedFunction,
	errors: Model.CheckedFunction,
	chained: Model.CheckedFunction,
	option_owner: Model.CheckedUnion,
	result_owner: Model.CheckedUnion,
) -> Bool:
	match (
		(optional.signature.type_parameters, mapped.signature.type_parameters, errors.signature.type_parameters),
		(chained.signature.type_parameters, option_owner.variants, result_owner.variants)
	):
		(([a, b], [c, d, e], [f, g, h]), ([i, j, k], [some, none], [ok, error])):
			(
				not Model.same_parameter(a, b) and not Model.same_parameter(c, d) and not Model.same_parameter(d, e) and not Model.same_parameter(c, e)
				and not Model.same_parameter(f, g) and not Model.same_parameter(g, h) and not Model.same_parameter(f, h)
				and not Model.same_parameter(i, j) and not Model.same_parameter(j, k) and not Model.same_parameter(i, k)
				and callback_contract(optional,
					Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(option_owner.id)), [Model.ParameterType(a)]), Model.ParameterType(a), Model.ParameterType(b),
					Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(option_owner.id)), [Model.ParameterType(b)]), some.id, none.id,
				)
				and callback_contract(mapped,
					Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(result_owner.id)), [Model.ParameterType(c), Model.ParameterType(e)]), Model.ParameterType(c), Model.ParameterType(d),
					Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(result_owner.id)), [Model.ParameterType(d), Model.ParameterType(e)]), ok.id, error.id,
				)
				and callback_contract(errors,
					Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(result_owner.id)), [Model.ParameterType(f), Model.ParameterType(g)]), Model.ParameterType(g), Model.ParameterType(h),
					Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(result_owner.id)), [Model.ParameterType(f), Model.ParameterType(h)]), error.id, ok.id,
				)
				and callback_contract(chained,
					Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(result_owner.id)), [Model.ParameterType(i), Model.ParameterType(k)]), Model.ParameterType(i),
					Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(result_owner.id)), [Model.ParameterType(j), Model.ParameterType(k)]),
					Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(result_owner.id)), [Model.ParameterType(j), Model.ParameterType(k)]), ok.id, error.id,
				)
			)
		_: False


func test_library_helpers_preserve_foundation_owners_and_function_rigidity() -> Bool:
	match load_program("blorp_2/test/e2e/fixtures/generic/managed/option_result_helpers.brp", "blorp_2/standard_library"):
		Err(_): False
		Ok(loaded):
			parsed = parsed_contents(loaded.program)
			match (parsed.modules.get(0), check(loaded.program)):
				(Some(root), Ok(checked)):
					match (root.imports, checked_functions(checked).unions):
						([_, _, optional, result], [boolean, option_owner, result_owner]):
							ids = inventory_functions(parsed.declarations).filter(pure func(row):
								same_module(row.declaration.module, optional.target) or same_module(row.declaration.module, result.target)
							)
							functions = checked_functions(checked).functions
							match ids.map(pure func(row): functions.get(function_number(row.id))):
								[Some(some), Some(none), Some(unwrap), Some(convert), Some(optional_map), Some(ok), Some(result_map), Some(error_map), Some(chained)]:
									match (unwrap.signature.type_parameters, convert.signature.type_parameters, unwrap.signature.parameters, convert.signature.parameters):
										([t], [value, error], [optional_value, default], [converted_value, failure]):
											match (Model.parameter_owner(t), Model.parameter_owner(value), Model.parameter_owner(error)):
												(Model.FunctionDeclaration(a), Model.FunctionDeclaration(b), Model.FunctionDeclaration(c)):
													(
														function_number(a) == function_number(unwrap.id)
														and function_number(b) == function_number(convert.id) and function_number(c) == function_number(convert.id)
														and not Model.same_parameter(value, error)
														and Model.same_type(optional_value.value_type, Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(option_owner.id)), [Model.ParameterType(t)]))
														and Model.same_type(default.value_type, Model.ParameterType(t))
														and Model.same_type(unwrap.signature.return_type.value_type, Model.ParameterType(t))
														and Model.same_type(converted_value.value_type, Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(option_owner.id)), [Model.ParameterType(value)]))
														and Model.same_type(failure.value_type, Model.ParameterType(error))
														and Model.same_type(convert.signature.return_type.value_type, Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(result_owner.id)), [Model.ParameterType(value), Model.ParameterType(error)]))
														and [some, none, ok].all(pure func(f): Model.same_type(f.signature.return_type.value_type, Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(boolean.id)), [])))
														and [some, none, unwrap, convert, optional_map, ok, result_map, error_map, chained].all(pure func(f): same_purity(f.signature.purity, Pure))
														and callback_helpers(optional_map, result_map, error_map, chained, option_owner, result_owner)
														and functions.get(function_number(entry_function(checked_functions(checked).entrypoint))).map(pure func(main):
															[unwrap, ok].all(pure func(target):
																expected = if function_number(target.id) == function_number(unwrap.id):
																	5
																else:
																	2
																Model.function_calls(main).filter(pure func(call):
																	ordinary = call.operands.all(pure func(operand):
																		match operand:
																			Model.ValueOperand(_): True
																			Model.CallableOperand(_, _, _): False
																	)
																	match (call.target, ordinary):
																		(Model.UserFunction(id, _), True): function_number(id) == function_number(target.id)
																		_: False
																).length() == expected
															)
														).get_or(False)
													)
												_: False
										_: False
								_: False
						_: False
				_: False


private CALLBACK_ERRORS: String =
	|import:
	|    option: map
	|    result as Results
	|pure func wrong_input(value: String) -> Int:
	|    0
	|pure func wrong_error(value: Int) -> Result[Int, Int]:
	|    Err(0)
	|func impure(value: Int) -> Int:
	|    value
	|pure func identity(value: Int) -> Int:
	|    value
	|union Foreign:
	|    ForeignSome(Int)
	|    ForeignNone
	|func main() -> Int:
	|    optional: Option[Int] = Some(7)
	|    result: Result[Int, String] = Ok(7)
	|    unrelated: Foreign = ForeignSome(7)
	|    unused =


private func rejects_library_callback(before: String, marked: String, after: String, message_text: String, help: String, accepts: pure (Errors.CheckErrorKind) -> Bool) -> Result[Bool, String]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-callback-diagnostic-") on error => message(error):
		prefix = CALLBACK_ERRORS + " " + before
		path = directory.resource_path() + "/main.brp"
		written ?= write_file(path, prefix + marked + after + "\n    0\n")
		loaded ?= load_program(path, "blorp_2/standard_library").map_err(func(failure): failure.diagnostic.message)
		match check(loaded.program):
			Ok(_): Ok(False)
			Err(failure):
				match singleton_check_error(check_errors(failure)):
					None: Ok(False)
					Some(error):
						diagnostic = render_check_error(loaded.program, error)
						Ok(
							accepts(error.kind) and same_source(error.span.source, module_source(root_module_id()))
							and error.span.start == prefix.length() and error.span.end == prefix.length() + marked.length()
							and same_span(diagnostic.span, error.span) and diagnostic.note.is_none()
							and diagnostic.message == message_text and diagnostic.help == help
						)


func test_library_callback_rejects_impurity() -> Bool:
	rejects_library_callback("map(optional, ", "impure", ")", "pure callback requires a pure function", "pass a pure named function; impure functions cannot satisfy a pure callable parameter", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.ImpureCallback(_)): True
			_: False
	).get_or(False)


func test_library_callback_rejects_wrong_input() -> Bool:
	rejects_library_callback("map(optional, ", "wrong_input", ")", "argument type does not match the parameter type", "use an expression of type pure (Int) -> U here", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
				match (conflict.mismatch.expected, conflict.mismatch.actual.value_type):
					(Model.CallableType(Pure, [Model.IntType], Model.ParameterType(_)), Model.CallableType(Pure, [Model.StringType], Model.IntType)): True
					_: False
			_: False
	).get_or(False)


func test_library_chain_rejects_wrong_result_error() -> Bool:
	rejects_library_callback("Results.and_then(result, ", "wrong_error", ")", "argument type does not match the parameter type", "use an expression of type pure (Int) -> Result[Int, String] here", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
				match (conflict.mismatch.expected, conflict.mismatch.actual.value_type):
					(Model.CallableType(Pure, [Model.IntType], Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(owner)), [Model.IntType, Model.StringType])), Model.CallableType(Pure, [Model.IntType], Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(other)), [Model.IntType, Model.IntType]))):
						Model.same_type(Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(owner)), []), Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(other)), []))
					_: False
			_: False
	).get_or(False)


func test_library_map_rejects_a_same_shaped_foreign_union() -> Bool:
	rejects_library_callback("map(", "unrelated", ", identity)", "argument type does not match the parameter type", "use an expression of type Option[Int] here", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
				match (mismatch.expected, mismatch.actual.value_type):
					(Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(_)), [Model.IntType]), Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(_)), [])): not Model.same_type(mismatch.expected, mismatch.actual.value_type)
					_: False
			_: False
	).get_or(False)


private IDENTITY: String =
	|pure func identity[T](value: T) -> T:
	|	value
	|

private MAIN: String =
	|func main() -> Int:
	|	0
	|

private INFERENCE_HELP: String = (
	"pass a value whose type determines the declared type parameter; use a concrete "
	+ "helper when no argument can determine it"
)

private CONSTRUCTOR_HELP: String = "pass an already-typed union value or call a concrete helper returning the union"

private COLLISION_HELP: String = "choose a distinct type parameter name, such as T"


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	check(parsed)
		.map_err(setup_diagnostic)


private pure func rejects(
	prefix: String,
	marked: String,
	suffix: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(prefix + marked + suffix):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)


private pure func rejects_modules(
	inputs: List[ModuleInput],
	prefix: String,
	marked: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_modules_failure(inputs, primitive_base()):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)


pure func test_one_declaration_accepts_int_and_string() -> Bool:
	source: String =
		|import:
		|    int: Int methods
		|    string: String methods
		|pure func identity[T](value: T) -> T:
		|	value
		|func main() -> Int:
		|	integer = identity(7)
		|	text = integer.to_string().identity()
		|	identity(text).length()
		|
	compile_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	], primitive_base()).is_ok()


pure func test_generic_forwarding_preserves_the_caller_parameter() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|	value
		|pure func forward[Element](value: Element) -> Element:
		|	identity(value)
		|func main() -> Int:
		|	forward(42)
		|
	compile(source).is_ok()


pure func test_unused_invalid_rigid_body_rejects() -> Bool:
	rejects("pure func bad[T](value: T) -> T:\n\t", "42", "\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_int_only_use_does_not_recheck_invalid_body_as_int() -> Bool:
	source: String =
		|
		|func main() -> Int:
		|	bad(7)
		|
	rejects("pure func bad[T](value: T) -> T:\n\t", "42", source, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_arbitrary_parameter_cannot_call_string_runtime() -> Bool:
	bad_source: String =
		|import:
		|    string: length
		|pure func bad[T](value: T) -> Int:
		|	value.
	rejects_modules([
		{ source = (bad_source) + "length" + ("()\n" + MAIN), targets = [1] },
		{ source = STRING_OPERATIONS, targets = [] },
	], bad_source, "length", pure func(kind: Errors.CheckErrorKind) -> Bool:
		match kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_arbitrary_parameter_cannot_call_integer_runtime() -> Bool:
	rejects_modules([
		{ source = ("import:\n    int: to_string\npure func bad[T](value: T) -> String:\n\t") + "to_string" + ("(value)\n" + MAIN), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], "import:\n    int: to_string\npure func bad[T](value: T) -> String:\n\t", "to_string", pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_generic_main_rejects_at_parameter_declaration() -> Bool:
	rejects("func main[", "T", "]() -> Int:\n\t0\n", pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.SignatureRejection(Errors.GenericMain(_)):
				True
			_:
				False
	)


pure func test_builtin_type_parameter_collision_rejects() -> Bool:
	integer_suffix: String =
		|](value: Int) -> Int:
		|	value
		|
	string_suffix: String =
		|](value: String) -> String:
		|	value
		|
	(
		rejects("pure func identity[", "Int", integer_suffix + MAIN, pure func(
			kind: Errors.CheckErrorKind,
		) -> Bool:
			match kind:
				Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)):
					True
				_:
					False
		)
		and rejects("pure func identity[", "String", string_suffix + MAIN, pure func(
			kind: Errors.CheckErrorKind,
		) -> Bool:
			match kind:
				Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)):
					True
				_:
					False
		)
	)


