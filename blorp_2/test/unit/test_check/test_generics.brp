pure func test_concrete_parameter_still_contextualizes_constructor() -> Bool:
	take_source: String =
		|pure func take(value: Choice) -> Choice:
		|	value
		|pure func use() -> Choice:
		|	identity(take(Number(7)))
		|
	checked(CHOICE + IDENTITY + take_source + MAIN).is_ok()


private pure func symbolic_argument(
	function: Model.CheckedFunction,
) -> Option[Model.TypeParameterId]:
	match function.body:
		Model.CheckedValueBody(Model.ReturnExpression(value)):
			match value.form:
				Model.InvokeFunction(call):
					match (call.target, call.operands):
						(Model.UserFunction(_, [Model.ParameterType(argument)]), [Model.ValueOperand(_)]):
							Some(argument)
						_:
							None
				_:
					None
		_:
			None


pure func test_forwarding_publishes_caller_owned_symbolic_substitution() -> Bool:
	forward_source: String =
		|pure func forward[T](value: T) -> T:
		|	identity(value)
		|

	match checked(IDENTITY + forward_source + MAIN):
		Ok(program):
			match checked_functions(program).functions:
				[identity, forward, _, ..._]:
					match identity.signature.type_parameters:
						[callee_parameter]:
							match forward.signature.type_parameters:
								[caller_parameter]:
									match symbolic_argument(forward):
										Some(argument):
											(
												not Model.same_parameter(
													callee_parameter,
													caller_parameter,
												)
												and Model.same_parameter(
													argument,
													caller_parameter,
												)
											)
										None:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_generic_runtime_module_rejects() -> Bool:
	prefix: String =
		|pure func convert[T](value: Int) -> String:
		|    builtin(
	source = prefix + "\"int.to_string\")\nfunc main() -> Int:\n    0\n"
	match checked(source):
		Err(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + 15
				and error.message == "builtin declaration does not match its runtime contract"
				and error.help == "declare a pure function with one Int parameter returning String"
			)
		Ok(_): False


func test_contains_library_preserves_its_rigid_parameter_and_designated_bool() -> Bool:
	match load_program("blorp_2/test/e2e/fixtures/list/contains_int.brp", "blorp_2/standard_library"):
		Err(_): False
		Ok(loaded):
			parsed = parsed_contents(loaded.program)
			match (parsed.modules.get(0), check(loaded.program)):
				(Some(root), Ok(checked)):
					match (root.imports, checked_functions(checked).unions):
						([list_import, ..._], [boolean, ..._]):
							-- Select the two public API declarations in the actual imported module.
							rows = inventory_functions(parsed.declarations).filter(pure func(row):
								name = name_spelling(parsed.names, row.declaration.function_name.id)
								(
									same_module(row.declaration.module, list_import.target)
										and (name == Some("any") or name == Some("contains"))
								)
							)
							functions = checked_functions(checked).functions
							match rows.map(pure func(row): functions.get(function_number(row.id))):
								-- Inventory order is source order: contains precedes any in list.brp.
								[Some(membership), Some(predicate_api)]:
									match (predicate_api.signature.type_parameters, predicate_api.signature.parameters, membership.signature.type_parameters, membership.signature.parameters):
										([parameter], [values, predicate], [element], [items, wanted]):
											match (membership.signature.requirements, checked_functions(checked).traits.canonical.equality, Model.function_calls(membership)):
												([requirement], Some(canonical), [call]):
													match (Model.parameter_owner(parameter), Model.parameter_owner(element), call.target, call.operands):
														(
															Model.FunctionDeclaration(owner), Model.FunctionDeclaration(member_owner),
															Model.TraitMethod(method),
															[Model.ValueOperand(_), Model.ValueOperand(_)],
														):
															bool_type = Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(boolean.id)), [])
															(
																function_number(owner) == function_number(predicate_api.id)
																and function_number(member_owner) == function_number(membership.id)
																and same_purity(predicate_api.signature.purity, Pure)
																and same_purity(membership.signature.purity, Pure)
																and predicate_api.signature.requirements.is_empty()
																and Model.same_type(values.value_type, Model.ListType(Model.ParameterType(parameter)))
																and Model.same_type(predicate.value_type, Model.CallableType(Pure, [Model.ParameterType(parameter)], bool_type))
																and Model.same_type(predicate_api.signature.return_type.value_type, bool_type)
																and Model.same_type(membership.signature.return_type.value_type, bool_type)
																and Model.same_type(items.value_type, Model.ListType(Model.ParameterType(element)))
																and Model.same_type(wanted.value_type, Model.ParameterType(element))
																and Model.same_parameter(requirement.parameter, element)
																and requirement.required_trait == Model.canonical_owner(canonical)
																-- The == in contains is one call on the canonical equals of its element type.
																and Model.method_identity(method) == Model.canonical_equals(canonical)
																and Model.same_type(Model.method_receiver(method), Model.ParameterType(element))
															)
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False


func test_contains_requires_a_declared_bound_even_without_callers() -> Bool:
	before_call: String =
		|import:
		|    list as Lists
		|
		|pure func unbounded[Element](values: List[Element], needle: Element) -> Bool:
		|
	prefix = before_call + "    Lists."
	source = prefix + "contains(values, needle)\n\nfunc main() -> Int:\n    0\n"
	with_directory(func(directory: String):
		path = directory + "/main.brp"
		written ?= write_file(path, source)
		loaded ?= load_program(path, "blorp_2/standard_library").map_err(pure func(failure): failure.diagnostic.message)
		parsed = parsed_contents(loaded.program)
		root_functions = inventory_functions(parsed.declarations)
			.filter(pure func(row): same_module(row.declaration.module, root_module_id()))
		valid = match (build_namespace(loaded.program), check(loaded.program), root_functions):
			(Ok(namespace), Err(failure), [unbounded, _]):
				match (designated_trait(parsed, namespace, foundation_words(parsed.names).equatable_word), singleton_check_error(check_errors(failure)), failure_functions(failure).get(function_number(unbounded.id))):
					(Some(canonical), Some(error), Some(accepted)):
						match (inventory_traits(parsed.declarations).get(trait_number(canonical)), accepted.signature.type_parameters, error.kind):
							(Some(owner), [parameter], Errors.TraitRejection(Errors.MissingTraitBound(required, Model.ParameterType(actual)))):
								match Model.parameter_owner(parameter):
									Model.FunctionDeclaration(function):
										diagnostic = render_check_error(loaded.program, error)
										(
											required == owner.id
											and owner.id == canonical
											and function_number(function) == function_number(unbounded.id)
											and Model.parameter_position(parameter) == 0
											and Model.same_parameter(parameter, actual)
											and accepted.signature.requirements.is_empty()
											and same_source(error.span.source, module_source(root_module_id()))
											and error.span.start == prefix.length() and error.span.end == prefix.length() + 8
											and same_span(error.span, diagnostic.span)
											and diagnostic.note.is_none()
											and diagnostic.message == "type does not satisfy the required trait bound"
											and diagnostic.help == "add the required trait to this function's type parameter bounds, or provide an implementation for the concrete receiver"
										)
									_: False
							_: False
					_: False
			_: False
		if valid:
			Ok(void)
		else:
			Err("uncalled membership must reject its actual unbounded parameter at the callee")
	)


func test_any_keeps_named_and_forwarded_callback_identities() -> Bool:
	source: String =
		|import:
		|    list: any
		|    string as StringOps
		|pure func is_kept(value: String) -> Bool:
		|    StringOps.equals(value, "kept")
		|pure func forward[A](values: List[A], predicate: pure (A) -> Bool) -> Bool:
		|    any(values, predicate)
		|func main() -> Int:
		|    found = forward(["kept"], is_kept)
		|    0
		|
	with_directory(func(directory: String):
		path = directory + "/main.brp"
		written ?= write_file(path, source)
		loaded ?= load_program(path, "blorp_2/standard_library").map_err(pure func(failure): failure.diagnostic.message)
		checked ?= check(loaded.program).map_err(pure func(_): "valid forwarded membership was rejected")
		parsed = parsed_contents(loaded.program)
		functions = checked_functions(checked).functions
		root_functions = inventory_functions(parsed.declarations)
			.filter(pure func(row): same_module(row.declaration.module, root_module_id()))
		valid = match root_functions.map(pure func(row): functions.get(function_number(row.id))):
			[Some(is_kept), Some(forward), Some(main)]:
				match (forward.signature.type_parameters, Model.function_calls(forward), Model.function_calls(main)):
					([parameter], [forwarded], [named]):
						match (forwarded.target, named.target, forwarded.operands, named.operands):
							(
								Model.UserFunction(target, [Model.ParameterType(argument)]),
								Model.UserFunction(called_forward, [Model.StringType]),
								[Model.ValueOperand(_), Model.CallableOperand(forwarded_parameter, forwarded_choice, _)],
								[Model.ValueOperand(_), Model.CallableOperand(named_parameter, named_choice, _)],
							):
								match (forwarded_choice, named_choice):
									(Model.ForwardedCallable(original), Model.NamedCallable(chosen, [])):
										(
											Model.same_parameter(parameter, argument)
											and function_number(called_forward) == function_number(forward.id)
											and function_number(chosen) == function_number(is_kept.id)
											and Model.same_callable_parameter(original, Model.callable_parameter(forward.id, 1))
											and Model.same_callable_parameter(forwarded_parameter, Model.callable_parameter(target, 1))
											and Model.same_callable_parameter(named_parameter, Model.callable_parameter(forward.id, 1))
										)
									_: False
							_: False
					_: False
			_: False
		if valid:
			Ok(void)
		else:
			Err("callback API did not preserve the actual named/forwarded choices")
	)


private CONTAINS_CALL_SCOPE: String =
	|import:
	|    list: any, contains
	|pure func same(left: Int, right: Int) -> Bool:
	|    True
	|pure func wrong_input(value: String) -> Bool:
	|    True
	|pure func wrong_result(value: Int) -> String:
	|    "wrong"
	|func side_effect(value: Int) -> Bool:
	|    True
	|func main() -> Int:
	|


private func rejects_contains_call(
	before: String,
	marked: String,
	after: String,
	message: String,
	help: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	prefix = CONTAINS_CALL_SCOPE + "    " + before
	source = prefix + marked + after + "\n    0\n"
	with_directory(func(directory: String):
		path = directory + "/main.brp"
		match write_file(path, source):
			Err(error): Err(error)
			Ok(_):
				match load_program(path, "blorp_2/standard_library"):
					Err(failure): Err(failure.diagnostic.message)
					Ok(loaded):
						match check(loaded.program):
							Ok(_): Err("invalid membership call was accepted")
							Err(failure):
								match singleton_check_error(check_errors(failure)):
									None: Err("membership call did not have one diagnostic")
									Some(error):
										diagnostic = render_check_error(loaded.program, error)
										if (
										matches(error.kind)
										and same_source(error.span.source, module_source(root_module_id()))
										and error.span.start == prefix.length() and error.span.end == prefix.length() + marked.length()
										and same_source(diagnostic.span.source, error.span.source)
										and diagnostic.span.start == error.span.start and diagnostic.span.end == error.span.end
											and diagnostic.message == message and diagnostic.help == help
											and diagnostic.note.is_none()
										):
											Ok(void)
										else:
											Err("membership diagnostic mismatch: " + diagnostic.message + " / " + diagnostic.help)
	)


func test_int_membership_rejects_a_string_needle() -> Bool:
	rejects_contains_call("contains([1], ", "\"wrong\"", ")",
		"argument type does not match the parameter type", "use an expression of type Int here",
		pure func(kind):
			match kind:
				Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
					match Model.parameter_owner(conflict.parameter):
						Model.FunctionDeclaration(_):
							(
								Model.parameter_position(conflict.parameter) == 0
								and Model.same_type(conflict.previous.value_type, Model.IntType)
								and Model.same_type(conflict.current.value_type, Model.StringType)
								and conflict.mismatch.argument_position == 1
								and Model.same_type(conflict.mismatch.expected, Model.IntType)
								and Model.same_type(conflict.mismatch.actual.value_type, Model.StringType)
							)
						_: False
				_: False
	)


func test_any_requires_two_arguments() -> Bool:
	rejects_contains_call("", "any", "([1])",
		"argument count does not match the function parameters",
		"pass one expression for each declared parameter; UFCS supplies the receiver first",
		pure func(kind):
			match kind:
				Errors.CallRejection(Errors.ArgumentCountMismatch(arity)): arity.expected == 2 and arity.actual == 1
				_: False
	)


func test_any_rejects_a_predicate_for_another_element_type() -> Bool:
	rejects_contains_call("any([1], ", "wrong_input", ")",
		"argument type does not match the parameter type", "use an expression of type pure (Int) -> Bool here",
		pure func(kind):
			match kind:
				Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
					match (
						Model.parameter_owner(conflict.parameter),
						conflict.mismatch.expected,
						conflict.mismatch.actual.value_type,
					):
						(
							Model.FunctionDeclaration(_),
							Model.CallableType(Pure, [Model.IntType], Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(expected_bool)), [])),
							Model.CallableType(Pure, [Model.StringType], Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(actual_bool)), [])),
						):
							(
								Model.parameter_position(conflict.parameter) == 0
								and Model.same_type(conflict.previous.value_type, Model.IntType)
								and Model.same_type(conflict.current.value_type, Model.StringType)
								and conflict.mismatch.argument_position == 1
								and Model.same_type(Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(expected_bool)), []), Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(actual_bool)), []))
							)
						_: False
				_: False
	)


func test_any_requires_a_boolean_predicate_result() -> Bool:
	rejects_contains_call("any([1], ", "wrong_result", ")",
		"argument type does not match the parameter type", "use an expression of type pure (Int) -> Bool here",
		pure func(kind):
			match kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					match (mismatch.expected, mismatch.actual.value_type):
						(
							Model.CallableType(Pure, [Model.IntType], Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(_)), [])),
							Model.CallableType(Pure, [Model.IntType], Model.StringType),
						): mismatch.argument_position == 1
						_: False
				_: False
	)


func test_any_rejects_an_impure_predicate() -> Bool:
	rejects_contains_call("any([1], ", "side_effect", ")",
		"pure callback requires a pure function",
		"pass a pure named function; impure functions cannot satisfy a pure callable parameter",
		pure func(kind):
			match kind:
				Errors.CallRejection(Errors.ImpureCallback(_)): True
				_: False
	)


tests: TestSuite = {
	description = "Blorp 2 generic functions",
	tests = [
		("actual membership APIs retain their own rigid and designated Bool", test_contains_library_preserves_its_rigid_parameter_and_designated_bool),
		("uncalled membership requires its actual declared bound", test_contains_requires_a_declared_bound_even_without_callers),
		("actual callback API preserves named and forwarded callback identities", test_any_keeps_named_and_forwarded_callback_identities),
		("Int membership rejects a String needle", test_int_membership_rejects_a_string_needle),
		("predicate callback has the written two-argument contract", test_any_requires_two_arguments),
		("predicate input matches the actual element", test_any_rejects_a_predicate_for_another_element_type),
		("predicate returns Bool", test_any_requires_a_boolean_predicate_result),
		("predicate must be pure", test_any_rejects_an_impure_predicate),
		("library callback rejects impurity with exact diagnostic", test_library_callback_rejects_impurity),
		("library callback rejects wrong input with exact diagnostic", test_library_callback_rejects_wrong_input),
		("library chain rejects wrong Result error with exact diagnostic", test_library_chain_rejects_wrong_result_error),
		("library map rejects same shaped foreign union", test_library_map_rejects_a_same_shaped_foreign_union),
		("library helpers preserve foundation owners and function rigidity", test_library_helpers_preserve_foundation_owners_and_function_rigidity),
		("ufcs payload constructor without context still rejects", test_ufcs_payload_constructor_without_context_still_rejects),
		("direct payload constructor without context still rejects", test_direct_payload_constructor_without_context_still_rejects),
		("ufcs nullary constructor without context still rejects", test_ufcs_nullary_constructor_without_context_still_rejects),
		("direct nullary constructor without context still rejects", test_direct_nullary_constructor_without_context_still_rejects),
		("one declaration accepts Int and String", test_one_declaration_accepts_int_and_string),
		(
			"generic forwarding preserves caller parameter",
			test_generic_forwarding_preserves_the_caller_parameter,
		),
		("unused rigid invalid body rejects", test_unused_invalid_rigid_body_rejects),
		(
			"Int only use does not recheck rigid invalid body",
			test_int_only_use_does_not_recheck_invalid_body_as_int,
		),
		(
			"arbitrary parameter cannot call String runtime",
			test_arbitrary_parameter_cannot_call_string_runtime,
		),
		(
			"arbitrary parameter cannot call Int runtime",
			test_arbitrary_parameter_cannot_call_integer_runtime,
		),
		(
			"generic main rejects at parameter declaration",
			test_generic_main_rejects_at_parameter_declaration,
		),
		("builtin type parameter collision rejects", test_builtin_type_parameter_collision_rejects),
		(
			"forward declared union parameter collision rejects",
			test_forward_declared_union_type_parameter_collision_rejects,
		),
		("phantom parameter call has no default", test_phantom_parameter_call_has_no_default),
		(
			"zero argument generic call has no default",
			test_zero_argument_generic_call_has_no_default,
		),
		("generic unary call requires argument", test_generic_unary_call_still_requires_argument),
		("generic call preserves purity", test_generic_call_preserves_purity),
		("unused generic recursion is checked", test_generic_recursion_is_checked_even_when_unused),
		("undeclared parameter name rejects", test_undeclared_parameter_name_rejects),
		(
			"generic parameter value is not callable",
			test_generic_parameter_value_is_not_callable,
		),
		(
			"generic parameter receiver selects UFCS function",
			test_generic_parameter_receiver_selects_the_ufcs_function,
		),
		(
			"direct nullary constructor uses return context",
			test_direct_nullary_constructor_uses_return_context,
		),
		(
			"UFCS nullary constructor uses return context",
			test_ufcs_nullary_constructor_uses_return_context,
		),
		(
			"direct payload constructor uses return context",
			test_direct_payload_constructor_uses_return_context,
		),
		(
			"UFCS payload constructor uses return context",
			test_ufcs_payload_constructor_uses_return_context,
		),
		(
			"concrete parameter contextualizes constructor",
			test_concrete_parameter_still_contextualizes_constructor,
		),
		(
			"forwarding publishes caller owned symbolic substitution",
			test_forwarding_publishes_caller_owned_symbolic_substitution,
		),
		("generic runtime module rejects", test_generic_runtime_module_rejects),
	]
}
