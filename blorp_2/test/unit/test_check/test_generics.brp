import:
	../../../src/check/check_model as Model
	../../../src/utils/source: module_source, root_module_id
	../../../src/check/check: CheckedProgram, check, checked_functions
	../../../src/check/check_errors as Errors
	../../../src/lex/lex: lex
	../../../src/utils/syntax: Diagnostic
	../compilation: compile, compile_modules
	../input: check_failure, parse, setup_diagnostic, check_modules_failure
	../module_input: PRIMITIVE_BASE, INTEGER_OPERATIONS, STRING_OPERATIONS, ModuleInput
	test: TestSuite


private IDENTITY: String =
	|pure func identity[T](value: T) -> T:
	|	value
	|

private MAIN: String =
	|func main() -> Int:
	|	0
	|

private INFERENCE_HELP: String = (
	"pass a value whose type determines the declared type parameter; use a concrete "
	+ "helper when no argument can determine it"
)

private CONSTRUCTOR_HELP: String = "pass an already-typed union value or call a concrete helper returning the union"

private COLLISION_HELP: String = "choose a distinct type parameter name, such as T"


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source)
	parsed ?= parse(tokens)
	check(parsed)
		.map_err(setup_diagnostic)


private pure func rejects(
	prefix: String,
	marked: String,
	suffix: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(prefix + marked + suffix):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)


private pure func rejects_modules(
	inputs: List[ModuleInput],
	prefix: String,
	marked: String,
	matches: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match check_modules_failure(inputs, PRIMITIVE_BASE):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)


pure func test_one_declaration_accepts_int_and_string() -> Bool:
	source: String =
		|import:
		|    int: Int
		|    string: String
		|pure func identity[T](value: T) -> T:
		|	value
		|func main() -> Int:
		|	integer = identity(7)
		|	text = integer.to_string().identity()
		|	identity(text).length()
		|
	compile_modules([
		{ source = source, targets = [1, 2] },
		{ source = INTEGER_OPERATIONS, targets = [] },
		{ source = STRING_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE).is_ok()


pure func test_generic_forwarding_preserves_the_caller_parameter() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|	value
		|pure func forward[Element](value: Element) -> Element:
		|	identity(value)
		|func main() -> Int:
		|	forward(42)
		|
	compile(source).is_ok()


pure func test_unused_invalid_rigid_body_rejects() -> Bool:
	rejects("pure func bad[T](value: T) -> T:\n\t", "42", "\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_int_only_use_does_not_recheck_invalid_body_as_int() -> Bool:
	source: String =
		|
		|func main() -> Int:
		|	bad(7)
		|
	rejects("pure func bad[T](value: T) -> T:\n\t", "42", source, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_arbitrary_parameter_cannot_call_string_runtime() -> Bool:
	bad_source: String =
		|import:
		|    string: length
		|pure func bad[T](value: T) -> Int:
		|	value.
	rejects_modules([
		{ source = (bad_source) + "length" + ("()\n" + MAIN), targets = [1] },
		{ source = STRING_OPERATIONS, targets = [] },
	], bad_source, "length", pure func(kind: Errors.CheckErrorKind) -> Bool:
		match kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_arbitrary_parameter_cannot_call_integer_runtime() -> Bool:
	rejects_modules([
		{ source = ("import:\n    int: to_string\npure func bad[T](value: T) -> String:\n\t") + "to_string" + ("(value)\n" + MAIN), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], "import:\n    int: to_string\npure func bad[T](value: T) -> String:\n\t", "to_string", pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(_)):
				True
			_:
				False
	)


pure func test_generic_main_rejects_at_parameter_declaration() -> Bool:
	rejects("func main[", "T", "]() -> Int:\n\t0\n", pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.SignatureRejection(Errors.GenericMain(_)):
				True
			_:
				False
	)


pure func test_builtin_type_parameter_collision_rejects() -> Bool:
	integer_suffix: String =
		|](value: Int) -> Int:
		|	value
		|
	string_suffix: String =
		|](value: String) -> String:
		|	value
		|
	(
		rejects("pure func identity[", "Int", integer_suffix + MAIN, pure func(
			kind: Errors.CheckErrorKind,
		) -> Bool:
			match kind:
				Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)):
					True
				_:
					False
		)
		and rejects("pure func identity[", "String", string_suffix + MAIN, pure func(
			kind: Errors.CheckErrorKind,
		) -> Bool:
			match kind:
				Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)):
					True
				_:
					False
		)
	)


pure func test_forward_declared_union_type_parameter_collision_rejects() -> Bool:
	choice_source: String =
		|](value: Choice) -> Choice:
		|	value
		|fixed union Choice:
		|	First
		|
	rejects("pure func identity[", "Choice", choice_source + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)):
				True
			_:
				False
	)


pure func test_phantom_parameter_call_has_no_default() -> Bool:
	source: String =
		|pure func phantom[T](value: Int) -> Int:
		|	value
		|func main() -> Int:
	rejects(source + "\n\t", "phantom", "(7)\n", pure func(kind: Errors.CheckErrorKind) -> Bool:
		match kind:
			Errors.CallRejection(Errors.UninferableTypeParameter(_)):
				True
			_:
				False
	)


pure func test_zero_argument_generic_call_has_no_default() -> Bool:
	source: String =
		|pure func phantom[T]() -> Int:
		|	7
		|func main() -> Int:
	rejects(source + "\n\t", "phantom", "()\n", pure func(kind: Errors.CheckErrorKind) -> Bool:
		match kind:
			Errors.CallRejection(Errors.UninferableTypeParameter(_)):
				True
			_:
				False
	)


pure func test_generic_unary_call_still_requires_argument() -> Bool:
	rejects(IDENTITY + "func main() -> Int:\n\t", "identity", "()\n", pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.CallRejection(Errors.ArgumentCountMismatch(_)):
				True
			_:
				False
	)


pure func test_generic_call_preserves_purity() -> Bool:
	identity_source: String =
		|func identity[T](value: T) -> T:
		|	value
		|pure func use() -> Int:
	rejects(identity_source + "\n\t", "identity", "(7)\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.CallRejection(Errors.ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_generic_recursion_is_checked_even_when_unused() -> Bool:
	source: String =
		|pure func recurse[T](value: T) -> T:
		|	recurse(value)
		|
	checked(source + MAIN).is_ok()


pure func test_undeclared_parameter_name_rejects() -> Bool:
	rejects("pure func identity(value: ", "T", ") -> Int:\n\t7\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.TypeTermRejection(Errors.UnknownType(_)):
				True
			_:
				False
	)


pure func test_local_parameter_shadows_direct_generic_call() -> Bool:
	rejects(IDENTITY + "pure func use[T](identity: T) -> T:\n\t", "identity", "(identity)\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.CallRejection(Errors.UncallableBinding(_, Model.ParameterBinding(_), _)):
				True
			_:
				False
	)


pure func test_local_parameter_does_not_shadow_generic_ufcs() -> Bool:
	source: String =
		|pure func use[T](identity: T) -> T:
		|	identity.identity()
		|func main() -> Int:
		|	use(7)
		|
	checked(IDENTITY + source).is_ok()


private CHOICE: String =
	|fixed union Choice:
	|	First
	|	Number(Int)
	|


private pure func expected_identity_has_complete_substitution(expression: String) -> Bool:
	source = CHOICE + IDENTITY + "pure func use() -> Choice:\n    " + expression + "\n" + MAIN

	match checked(source):
		Ok(program):
			match checked_functions(program).functions.get(1):
				Some(function):
					match function.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.InvokeFunction(call, [_]): identity_target_matches(call, function.signature.return_type.value_type)
								_: False
						_: False
				None: False
		Err(_): False


private pure func identity_target_matches(call: Model.CheckedCall, expected: Model.TypeRef) -> Bool:
	match call.target:
		Model.UserFunction(_, [argument]): Model.same_type(argument, expected)
		_: False


pure func test_direct_nullary_constructor_uses_return_context() -> Bool:
	expected_identity_has_complete_substitution("identity(First)")


pure func test_direct_nullary_constructor_without_context_still_rejects() -> Bool:
	use_source: String =
		|pure func use() -> Int:
		|	value = identity(
	rejects(CHOICE + IDENTITY + use_source, "First", ")\n\t0\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ConstructorRejection(Errors.ConstructorNeedsExpectedType(_)):
				True
			_:
				False
	)


pure func test_ufcs_nullary_constructor_uses_return_context() -> Bool:
	expected_identity_has_complete_substitution("First.identity()")


pure func test_ufcs_nullary_constructor_without_context_still_rejects() -> Bool:
	rejects(CHOICE + IDENTITY + "pure func use() -> Int:\n\tvalue = ", "First", ".identity()\n\t0\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ConstructorRejection(Errors.ConstructorNeedsExpectedType(_)):
				True
			_:
				False
	)


pure func test_direct_payload_constructor_uses_return_context() -> Bool:
	expected_identity_has_complete_substitution("identity(Number(7))")


pure func test_direct_payload_constructor_without_context_still_rejects() -> Bool:
	use_source: String =
		|pure func use() -> Int:
		|	value = identity(
	rejects(CHOICE + IDENTITY + use_source, "Number", "(7))\n\t0\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ConstructorRejection(Errors.ConstructorNeedsExpectedType(_)):
				True
			_:
				False
	)


pure func test_ufcs_payload_constructor_uses_return_context() -> Bool:
	expected_identity_has_complete_substitution("Number(7).identity()")


pure func test_ufcs_payload_constructor_without_context_still_rejects() -> Bool:
	rejects(CHOICE + IDENTITY + "pure func use() -> Int:\n\tvalue = ", "Number", "(7).identity()\n\t0\n" + MAIN, pure func(
		kind: Errors.CheckErrorKind,
	) -> Bool:
		match kind:
			Errors.ConstructorRejection(Errors.ConstructorNeedsExpectedType(_)):
				True
			_:
				False
	)




pure func test_concrete_parameter_still_contextualizes_constructor() -> Bool:
	take_source: String =
		|pure func take(value: Choice) -> Choice:
		|	value
		|pure func use() -> Choice:
		|	identity(take(Number(7)))
		|
	checked(CHOICE + IDENTITY + take_source + MAIN).is_ok()


private pure func symbolic_argument(
	function: Model.CheckedFunction,
) -> Option[Model.TypeParameterId]:
	match function.body:
		Model.CheckedValueBody(Model.ReturnExpression(value)):
			match value.form:
				Model.InvokeFunction(call, [_]):
					match call.target:
						Model.UserFunction(_, [Model.ParameterType(argument)]):
							Some(argument)
						_:
							None
				_:
					None
		_:
			None


pure func test_forwarding_publishes_caller_owned_symbolic_substitution() -> Bool:
	forward_source: String =
		|pure func forward[T](value: T) -> T:
		|	identity(value)
		|

	match checked(IDENTITY + forward_source + MAIN):
		Ok(program):
			match checked_functions(program).functions:
				[identity, forward, _, ..._]:
					match identity.signature.type_parameters:
						[callee_parameter]:
							match forward.signature.type_parameters:
								[caller_parameter]:
									match symbolic_argument(forward):
										Some(argument):
											(
												not Model.same_parameter(
													callee_parameter,
													caller_parameter,
												)
												and Model.same_parameter(
													argument,
													caller_parameter,
												)
											)
										None:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_generic_runtime_module_rejects() -> Bool:
	prefix: String =
		|pure func convert[T](value: Int) -> String:
		|    builtin(
	source = prefix + "\"int.to_string\")\nfunc main() -> Int:\n    0\n"
	match checked(source):
		Err(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + 15
				and error.message == "builtin declaration does not match its runtime contract"
				and error.help == "declare a pure function with one Int parameter returning String"
			)
		Ok(_): False


tests: TestSuite = {
	description = "Blorp 2 generic functions",
	tests = [
		("ufcs payload constructor without context still rejects", test_ufcs_payload_constructor_without_context_still_rejects),
		("direct payload constructor without context still rejects", test_direct_payload_constructor_without_context_still_rejects),
		("ufcs nullary constructor without context still rejects", test_ufcs_nullary_constructor_without_context_still_rejects),
		("direct nullary constructor without context still rejects", test_direct_nullary_constructor_without_context_still_rejects),
		("one declaration accepts Int and String", test_one_declaration_accepts_int_and_string),
		(
			"generic forwarding preserves caller parameter",
			test_generic_forwarding_preserves_the_caller_parameter,
		),
		("unused rigid invalid body rejects", test_unused_invalid_rigid_body_rejects),
		(
			"Int only use does not recheck rigid invalid body",
			test_int_only_use_does_not_recheck_invalid_body_as_int,
		),
		(
			"arbitrary parameter cannot call String runtime",
			test_arbitrary_parameter_cannot_call_string_runtime,
		),
		(
			"arbitrary parameter cannot call Int runtime",
			test_arbitrary_parameter_cannot_call_integer_runtime,
		),
		(
			"generic main rejects at parameter declaration",
			test_generic_main_rejects_at_parameter_declaration,
		),
		("builtin type parameter collision rejects", test_builtin_type_parameter_collision_rejects),
		(
			"forward declared union parameter collision rejects",
			test_forward_declared_union_type_parameter_collision_rejects,
		),
		("phantom parameter call has no default", test_phantom_parameter_call_has_no_default),
		(
			"zero argument generic call has no default",
			test_zero_argument_generic_call_has_no_default,
		),
		("generic unary call requires argument", test_generic_unary_call_still_requires_argument),
		("generic call preserves purity", test_generic_call_preserves_purity),
		("unused generic recursion is checked", test_generic_recursion_is_checked_even_when_unused),
		("undeclared parameter name rejects", test_undeclared_parameter_name_rejects),
		(
			"local parameter shadows direct generic call",
			test_local_parameter_shadows_direct_generic_call,
		),
		(
			"local parameter does not shadow generic UFCS",
			test_local_parameter_does_not_shadow_generic_ufcs,
		),
		(
			"direct nullary constructor uses return context",
			test_direct_nullary_constructor_uses_return_context,
		),
		(
			"UFCS nullary constructor uses return context",
			test_ufcs_nullary_constructor_uses_return_context,
		),
		(
			"direct payload constructor uses return context",
			test_direct_payload_constructor_uses_return_context,
		),
		(
			"UFCS payload constructor uses return context",
			test_ufcs_payload_constructor_uses_return_context,
		),
		(
			"concrete parameter contextualizes constructor",
			test_concrete_parameter_still_contextualizes_constructor,
		),
		(
			"forwarding publishes caller owned symbolic substitution",
			test_forwarding_publishes_caller_owned_symbolic_substitution,
		),
		("generic runtime module rejects", test_generic_runtime_module_rejects),
	]
}
