pure func test_generic_parameter_receiver_selects_the_ufcs_function() -> Bool:
	source: String =
		|pure func use[T](argument: T) -> T:
		|	argument.identity()
		|func main() -> Int:
		|	use(7)
		|
	checked(IDENTITY + source).is_ok()


private CHOICE: String =
	|union Choice:
	|	First
	|	Number(Int)
	|


private pure func expected_identity_has_complete_substitution(expression: String) -> Bool:
	source = CHOICE + IDENTITY + "pure func use() -> Choice:\n    " + expression + "\n" + MAIN

	match checked(source):
		Ok(program):
			match checked_functions(program).functions.get(1):
				Some(function):
					match function.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(_)]: identity_target_matches(call, function.signature.return_type.value_type)
										_: False
								_: False
						_: False
				None: False
		Err(_): False


private pure func identity_target_matches(call: Model.CheckedCall, expected: Model.TypeRef) -> Bool:
	ordinary = call.operands.all(pure func(operand):
		match operand:
			Model.ValueOperand(_): True
			Model.CallableOperand(_, _, _): False
	)
	match (call.target, ordinary):
		(Model.UserFunction(_, [argument]), True): Model.same_type(argument, expected)
		_: False


pure func test_direct_nullary_constructor_uses_return_context() -> Bool:
