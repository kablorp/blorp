import:
	../../../src/check/model as Model
	../../../src/utils/declarations as Declaration
	../../../src/utils/source: module_source, root_module_id
	../../../src/check/check: CheckedProgram, check, checked_functions
	../../../src/check/errors as Errors
	../../../src/lex/lex: lex
	../../../src/utils/syntax: Diagnostic
	../../../src/utils/text: concat
	../input: check_failure, parse, setup_diagnostic, check_modules_failure
	int as IntOps
	../module_input: ModuleInput, PRIMITIVE_BASE, INTEGER_OPERATIONS
	test: TestSuite


private INT_IMPORT: String = "import:\n\tint: to_string\n"


private CHOICE: String =
	|fixed union Choice:
	|	Empty
	|	Number(Int)
	|

private MAIN: String =
	|func main() -> Int:
	|	0
	|


private pure func checked_source(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source)
	program ?= parse(tokens)
	check(program)
		.map_err(setup_diagnostic)


private pure func rejects_at(
	prefix: String,
	marked: String,
	suffix: String,
	expected: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match (
		check_failure(
			prefix
				.concat(marked)
				.concat(suffix),
		)
	):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == IntOps.add(prefix.length(), marked.length())
				and expected(error.kind)
			)


private pure func rejects_at_modules(
	inputs: List[ModuleInput],
	prefix: String,
	marked: String,
	expected: pure (Errors.CheckErrorKind) -> Bool,
) -> Bool:
	match (
		check_modules_failure(inputs, PRIMITIVE_BASE)
	):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == IntOps.add(prefix.length(), marked.length())
				and expected(error.kind)
			)


pure func test_binding_and_scrutinee_synthesize_the_same_nominal_type() -> Bool:
	source: String =
		|fixed union Choice:
		|	Empty
		|	Number(Int)
		|pure func choose() -> Choice:
		|	Number(7)
		|pure func inspect() -> Int:
		|	value = choose()
		|	match value:
		|		Empty: 0
		|		Number(item): item
		|func main() -> Int:
		|	inspect()

	match checked_source(source.concat("\n")):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[choose, inspect, _]:
					match inspect.bindings:
						[local, _]:
							match inspect.body:
								Model.CheckedMatchBody(body):
									match body.scrutinee.form:
										Model.ReadBinding(binding):
											(
												Model.binding_number(binding) == 0
												and Model.same_type(
													local.value_type,
													choose.signature.return_type.value_type,
												)
												and Model.same_type(
													body.union_type,
													local.value_type,
												)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_checked_return_provides_constructor_type() -> Bool:
	choose_source: String =
		|pure func choose() -> Choice:
		|	Number(7)
		|
	checked_source(
		CHOICE
			.concat(choose_source)
			.concat(MAIN),
	).is_ok()


pure func test_checked_arm_provides_constructor_type() -> Bool:
	choose_source: String =
		|pure func choose(value: Choice) -> Choice:
		|	match value:
		|		Empty: Number(7)
		|		Number(item): Empty
		|
	checked_source(
		CHOICE
			.concat(choose_source)
			.concat(MAIN),
	).is_ok()


pure func test_concrete_direct_argument_provides_constructor_type() -> Bool:
	keep_source: String =
		|pure func keep(value: Choice) -> Choice:
		|	value
		|pure func choose() -> Choice:
		|	keep(Number(7))
		|
	checked_source(
		CHOICE
			.concat(keep_source)
			.concat(MAIN),
	).is_ok()


pure func test_concrete_receiver_provides_constructor_type() -> Bool:
	keep_source: String =
		|pure func keep(value: Choice) -> Choice:
		|	value
		|pure func choose() -> Choice:
		|	Number(7).keep()
		|
	checked_source(
		CHOICE
			.concat(keep_source)
			.concat(MAIN),
	).is_ok()


pure func test_generic_return_context_keeps_rigid_payload_identity() -> Bool:
	source: String =
		|fixed union Box[T]:
		|    Box(T)
		|pure func box[T](value: T) -> Box[T]:
		|    Box(value)
		|func main() -> Int:
		|    0
		|
	match checked_source(source):
		Ok(program):
			match checked_functions(program).functions:
				[box, _]:
					match (box.body, box.signature.type_parameters):
						(Model.CheckedValueBody(Model.ReturnExpression(value)), [parameter]):
							match value.form:
								Model.ConstructVariant(variant, [payload]):
									match payload.value_type:
										Model.ParameterType(payload_parameter):
											(
												Model.same_parameter(parameter, payload_parameter)
												and Declaration.union_number(Declaration.variant_owner(variant)) == 0
												and Model.same_type(value.value_type, box.signature.return_type.value_type)
											)
										_: False
								_: False
						_: False
				_: False
		Err(_): False

pure func test_synthesized_binding_does_not_inherit_return_context() -> Bool:
	choose_source: String =
		|pure func choose() -> Choice:
		|	value =
	rejects_at(CHOICE.concat(
		choose_source + " ",
	), "Number", "(7)\n\tvalue\n".concat(MAIN), pure func(kind):
		match kind:
			Errors.ConstructorRejection(Errors.ConstructorNeedsExpectedType(_)):
				True
			_:
				False
	)


pure func test_synthesized_scrutinee_does_not_inherit_return_context() -> Bool:
	main_source: String =
		|func main() -> Int:
		|	match
	match_suffix: String =
		|(7):
		|		Empty: 0
		|		Number(item): item
		|
	rejects_at(CHOICE.concat(main_source + " "), "Number", match_suffix, pure func(kind):
		match kind:
			Errors.ConstructorRejection(Errors.ConstructorNeedsExpectedType(_)):
				True
			_:
				False
	)


pure func test_unique_generic_receiver_receives_return_context() -> Bool:
	keep_source: String =
		|pure func keep[T](value: T) -> T:
		|    value
		|pure func choose() -> Choice:
		|    Number(7).keep()
		|
	checked_source(CHOICE + keep_source + MAIN).is_ok()


pure func test_unused_generic_return_is_checked_rigidly() -> Bool:
	prefix = "pure func wrong[T](value: T) -> T:\n\t"
	rejects_at(prefix, "7", "\n".concat(MAIN), pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
				match mismatch.expected:
					Model.ParameterType(parameter):
						match Model.parameter_owner(parameter):
							Model.FunctionDeclaration(owner):
								match mismatch.expected_site:
									Errors.SourceAnnotation(annotation):
										(
											Declaration.function_number(owner) == 0
											and annotation.start == 32
											and annotation.end == 33
											and Model.same_type(
												mismatch.actual.value_type,
												Model.IntType,
											)
											and mismatch.actual.span.start == prefix.length()
										)
									_:
										False
							_:
								False
					_:
						False
			_:
				False
	)


pure func test_later_direct_child_error_precedes_earlier_type_mismatch() -> Bool:
	source: String =
		|pure func first(left: Int, right: Int) -> Int:
		|	left
		|func main() -> Int:
		|	first(7.to_string(),
	rejects_at_modules([
		{ source = (INT_IMPORT + source + " ") + "missing" + (")\n"), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], INT_IMPORT + source + " ", "missing", pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.UnknownValue(_)):
				True
			_:
				False
	)


pure func test_later_ufcs_child_error_precedes_receiver_type_mismatch() -> Bool:
	source: String =
		|pure func first(left: Int, right: Int) -> Int:
		|	left
		|func main() -> Int:
		|	7.to_string().first(
	rejects_at_modules([
		{ source = (INT_IMPORT + source) + "missing" + (")\n"), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], INT_IMPORT + source, "missing", pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.UnknownValue(_)):
				True
			_:
				False
	)


pure func test_postfix_contract_error_precedes_base_error() -> Bool:
	main_source: String =
		|func main() -> Int:
		|	missing.
	rejects_at(main_source, "absent", "()\n", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.UnknownFunction(_)):
				True
			_:
				False
	)


pure func test_later_child_error_precedes_generic_conflict() -> Bool:
	source: String =
		|pure func first[T](left: T, right: T, last: Int) -> T:
		|	left
		|func main() -> Int:
		|	first(7, 8.to_string(),
	rejects_at_modules([
		{ source = (INT_IMPORT + source + " ") + "missing" + (")\n"), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], INT_IMPORT + source + " ", "missing", pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.UnknownValue(_)):
				True
			_:
				False
	)


pure func test_checked_arm_mismatch_keeps_expression_and_annotation_spans() -> Bool:
	inspect_source: String =
		|pure func inspect(value: Choice) -> Int:
		|	match value:
		|		Empty:
	prefix = INT_IMPORT + CHOICE.concat(inspect_source + " ")
	body = "8.to_string()"
	rejects_at_modules([
		{ source = (prefix) + body + ("\n\t\tNumber(item): item\n".concat(MAIN)), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], prefix, body, pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
				match mismatch.expected_site:
					Errors.SourceAnnotation(annotation):
						(
							Model.same_type(mismatch.expected, Model.IntType)
							and Model.same_type(mismatch.actual.value_type, Model.StringType)
							and mismatch.actual.span.start == prefix.length()
							and mismatch.actual.span.end == IntOps.add(
								prefix.length(),
								body.length(),
							)
							and annotation.start == INT_IMPORT.length() + 76
							and annotation.end == INT_IMPORT.length() + 79
						)
					_:
						False
			_:
				False
	)


pure func test_checked_reassignment_keeps_binding_owner_and_occurrences() -> Bool:
	prefix_source: String =
		|pure func spare() -> Int:
		|	0
		|func main() -> Int:
		|	var current = 7
		|	current =
	prefix = INT_IMPORT + prefix_source + " "
	body = "8.to_string()"
	rejects_at_modules([
		{ source = (prefix) + body + ("\n\t0\n"), targets = [1] },
		{ source = INTEGER_OPERATIONS, targets = [] },
	], prefix, body, pure func(kind):
		match kind:
			Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
				match mismatch.expected_site:
					Errors.InferredBindingDeclaration(binding):
						(
							Model.same_type(mismatch.expected, Model.IntType)
							and Model.same_type(mismatch.actual.value_type, Model.StringType)
							and mismatch.actual.span.start == prefix.length()
							and mismatch.actual.span.end == IntOps.add(
								prefix.length(),
								body.length(),
							)
							and Declaration.function_number(binding.function) == 1
							and Model.binding_number(binding.binding) == 0
							and binding.span.start == INT_IMPORT.length() + 54
							and binding.span.end == INT_IMPORT.length() + 61
						)
					_:
						False
			_:
				False
	)


tests: TestSuite = {
	description = "Blorp 2 synthesis and checking contracts",
	tests = [
		(
			"later child error precedes generic conflict",
			test_later_child_error_precedes_generic_conflict,
		),
		(
			"checked arm mismatch preserves provenance",
			test_checked_arm_mismatch_keeps_expression_and_annotation_spans,
		),
		(
			"checked reassignment preserves binding identity",
			test_checked_reassignment_keeps_binding_owner_and_occurrences,
		),
		(
			"binding and scrutinee synthesize nominal type",
			test_binding_and_scrutinee_synthesize_the_same_nominal_type,
		),
		("checked return directs constructor", test_checked_return_provides_constructor_type),
		("checked arm directs constructor", test_checked_arm_provides_constructor_type),
		(
			"concrete direct argument directs constructor",
			test_concrete_direct_argument_provides_constructor_type,
		),
		("concrete receiver directs constructor", test_concrete_receiver_provides_constructor_type),
		(
			"generic return keeps rigid payload identity",
			test_generic_return_context_keeps_rigid_payload_identity,
		),
		(
			"binding synthesis has no return context",
			test_synthesized_binding_does_not_inherit_return_context,
		),
		(
			"scrutinee synthesis has no return context",
			test_synthesized_scrutinee_does_not_inherit_return_context,
		),
		(
			"unique generic receiver receives return context",
			test_unique_generic_receiver_receives_return_context,
		),
		("unused generic return remains rigid", test_unused_generic_return_is_checked_rigidly),
		(
			"later direct child error has precedence",
			test_later_direct_child_error_precedes_earlier_type_mismatch,
		),
		(
			"later UFCS child error has precedence",
			test_later_ufcs_child_error_precedes_receiver_type_mismatch,
		),
		("postfix contract error has precedence", test_postfix_contract_error_precedes_base_error),
	]
}
