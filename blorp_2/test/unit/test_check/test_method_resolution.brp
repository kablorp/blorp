pure func test_generic_and_concrete_receiver_declarations_overlap() -> Bool:
	root: String =
		|import:
		|    ./left: Option methods_only
		|    ./right: Option methods_only
		|pure func make() -> Option[Int]:
		|    Some(42)
		|func main() -> Int:
		|    make().measure()
		|
	left: String =
		|pure func measure[T](value: Option[T]) -> Int:
		|    42
		|
	right: String =
		|pure func measure(value: Option[Int]) -> Int:
		|    1
		|
	match parse_modules([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}]):
		Err(_): False
		Ok(parsed):
			-- Root make/main precede the two provider declarations in the inventory.
			match (check(parsed), inventory_functions(parsed_contents(parsed).declarations)):
				(Err(failure), [_, _, generic, concrete]):
					match check_errors(failure).first.kind:
						Errors.MethodRejection(Errors.OverlappingReceivers(_, overlap)):
							match (overlap.introduced_receiver, overlap.other_receiver):
								(Model.AppliedUnionType(concrete_owner, [Model.IntType]), Model.AppliedUnionType(generic_owner, [Model.ParameterType(parameter)])):
									match Model.parameter_owner(parameter):
										Model.FunctionDeclaration(owner):
											(function_number(overlap.introduced.function) == function_number(concrete.id)
												and function_number(overlap.other.function) == function_number(generic.id)
												and union_number(concrete_owner) == union_number(generic_owner)
												and function_number(owner) == function_number(generic.id) and Model.parameter_position(parameter) == 0)
										_: False
								_: False
						_: False
				_: False


