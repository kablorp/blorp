		|    ./ops: Int methods_only
		|pure func main() -> Int:
		|    42.measure()
		|
	ops: String =
		|func measure(value: Int) -> Int:
		|    value
		|
	rejects([{source = root, targets = [1]}, {source = ops, targets = []}], pure func(error):
		match error.kind:
			Errors.CallRejection(Errors.ImpureCall(_, _)): True
			_: False
	)


private FOO: String =
	|fixed record Foo { value: Int }
	|


pure func test_record_methods_compose_across_modules_and_chain() -> Bool:
	root: String =
		|import:
		|    ./foo: Foo
		|    ./left: Foo methods_only
		|    ./right: Foo methods_only
		|pure func make() -> Foo:
		|    { value = 42 }
		|func main() -> Int:
		|    make().identity().number()
		|
	left: String =
		|import:
		|    ./foo: Foo
		|pure func identity(value: Foo) -> Foo:
		|    value
		|
	right: String =
		|import:
		|    ./foo: Foo
		|pure func number(value: Foo) -> Int:
		|    value.value
		|
	accepts([{source = root, targets = [1, 2, 3]}, {source = FOO, targets = []}, {source = left, targets = [1]}, {source = right, targets = [1]}])


