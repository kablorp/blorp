pure func test_overlapping_constructor_receivers_reject_before_body_context() -> Bool:
	root: String =
		|import:
		|    ./left: Option methods_only
		|    ./right: Option methods_only
		|func main() -> Int:
		|    Some(42).measure(1)
		|
