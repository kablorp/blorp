pure func test_rigid_actual_parameter_keeps_no_applicable_method() -> Bool:
	prefix: String =
		|import:
		|    ./left: Int methods_only
		|    ./right: Float methods_only
		|pure func use[T](receiver: T) -> Int:
		|    receiver.
	source = prefix + "measure()\nfunc main() -> Int:\n    0\n"
	match parse_modules([{ source = source, targets = [1, 2] }, { source = INT_METHOD, targets = [] }, { source = FLOAT_METHOD, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match (check(parsed), inventory_functions(parsed_contents(parsed).declarations).get(0)):
				(Err(failure), Some(declaration)):
					error = check_errors(failure).first
					diagnostic = render_failure(failure).first
					match (error.kind, diagnostic.note):
						(Errors.MethodRejection(Errors.NoApplicableMethod(_, Model.ParameterType(parameter), [left, right])), Some(CompetingDeclarations([_, _, _, _]))):
							match Model.parameter_owner(parameter):
								Model.FunctionDeclaration(owner):
									(function_number(owner) == function_number(declaration.id) and Model.parameter_position(parameter) == 0
										and function_number(left.function) == 2 and function_number(right.function) == 3
										and same_span(error.span, root_span(prefix, "measure")) and same_span(diagnostic.span, error.span)
										and diagnostic.message == "no method accepts this receiver type"
										and diagnostic.help == "use a value of a declared receiver type, or import a function accepting this type")
								_: False
						_: False
				_: False


pure func test_function_and_type_import_routes_keep_one_candidate_identity() -> Bool:
	root: String =
		|import:
		|    ./ops: describe, Foo
		|    ./other as OtherProvider
		|func main() -> Int:
		|    { value = 23 }.describe()
		|
	ops: String =
		|fixed record Foo { value: Int }
		|pure func describe(value: Foo) -> Int:
		|    value.value
		|
	unrelated: String =
		|fixed record Other { value: Int }
		|pure func describe(value: Other) -> Int:
		|    value.value
		|
	match parse_modules([{ source = root, targets = [1, 2] }, { source = ops, targets = [] }, { source = unrelated, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match (check(parsed), inventory_functions(parsed_contents(parsed).declarations).get(1)):
				(Ok(program), Some(declaration)):
					match checked_functions(program).functions.get(0):
						None: False
						Some(main):
							match main.body:
								Model.CheckedValueBody(Model.ReturnExpression(result)):
									match result.form:
										Model.InvokeFunction(call, [receiver]):
											match (call.target, receiver.value_type):
												(Model.UserFunction(target, []), Model.RecordType(_)):
													function_number(target) == function_number(declaration.id)
												_: False
										_: False
								_: False
				_: False


