import:
	../../../src/check/check_model as Model
	../../../src/check/check: check, check_errors
	../../../src/check/check_errors as Errors
	../../../src/check/check_render: render_failure
	../../../src/utils/source: module_id, module_source, root_module_id, same_source
	../../../src/utils/syntax: DiagnosticNote(CompetingDeclarations), same_span
	../module_input: ModuleInput, parse_modules
	test: TestSuite
	../../../src/utils/text: concat


private pure func accepts(inputs: List[ModuleInput]) -> Bool:
	match parse_modules(inputs):
		Err(_): False
		Ok(parsed): check(parsed).is_ok()


private pure func rejects(inputs: List[ModuleInput], expected: pure (Errors.CheckError) -> Bool) -> Bool:
	match parse_modules(inputs):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure): expected(check_errors(failure).first)


private pure func method_diagnostic_is(
	inputs: List[ModuleInput],
	message: String,
	help: String,
	start: Int,
	end: Int,
) -> Bool:
	match parse_modules(inputs):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					diagnostic = render_failure(failure).first
					match diagnostic.note:
						Some(CompetingDeclarations([_, _, _, _])):
							(
								diagnostic.message == message
								and diagnostic.help == help
								and same_span(diagnostic.span, {source = module_source(root_module_id()), start = start, end = end})
							)
						_: False


private pure func two_methods(body: String, left: String, right: String) -> List[ModuleInput]:
	root = "import:\n    ./left: Int, Float, String\n    ./right: Int, Float, String\nfunc main() -> Int:\n    ".concat(body).concat("\n")
	[{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}]


private INT_METHOD: String =
	|pure func measure(value: Int) -> Int:
	|    value
	|


private FLOAT_METHOD: String =
	|pure func measure(value: Float) -> Int:
	|    42
	|


pure func test_receiver_type_selects_same_named_methods() -> Bool:
	(
		accepts(two_methods("42.measure()", INT_METHOD, FLOAT_METHOD))
		and accepts(two_methods("1.0.measure()", INT_METHOD, FLOAT_METHOD))
	)


pure func test_receiver_selection_ignores_import_order() -> Bool:
	accepts(two_methods("42.measure()", FLOAT_METHOD, INT_METHOD))


pure func test_same_receiver_and_arity_is_ambiguous() -> Bool:
	rejects(two_methods("42.measure()", INT_METHOD, INT_METHOD), pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.AmbiguousMethod(_, Model.IntType, [left, right])):
				(
					not same_source(left.declaration.source, right.declaration.source)
					and left.import_site.is_some() and right.import_site.is_some()
				)
			_: False
	)


pure func test_local_and_type_import_method_ambiguity_keeps_both_origins() -> Bool:
	root: String =
		|import:
		|    ./ops: Int
		|pure func measure(value: Int) -> Int:
		|    value
		|func main() -> Int:
		|    42.measure()
		|
	match parse_modules([{source = root, targets = [1]}, {source = INT_METHOD, targets = []}]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					error = check_errors(failure).first
					match error.kind:
						Errors.MethodRejection(Errors.AmbiguousMethod(_, Model.IntType, [local, imported])):
							match (local.import_site, imported.import_site, render_failure(failure).first.note):
								(None, Some(import_site), Some(CompetingDeclarations([first, second, selection]))):
									(
										same_span(first, local.declaration)
										and same_span(second, imported.declaration)
										and same_span(selection, import_site)
										and same_source(first.source, module_source(root_module_id()))
										and not same_source(first.source, second.source)
									)
								_: False
						_: False


pure func test_ambiguity_renders_primary_and_all_candidate_sites() -> Bool:
	match parse_modules(two_methods("42.measure()", INT_METHOD, INT_METHOD)):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					diagnostic = render_failure(failure).first
					match diagnostic.note:
						Some(CompetingDeclarations([left, left_import, right, right_import])):
							(
								diagnostic.message == "ambiguous method call"
								and diagnostic.help == "rename one method or call a uniquely imported function directly; receiver type and argument count must identify one function"
								and same_span(diagnostic.span, {source = module_source(root_module_id()), start = 98, end = 105})
								and same_span(left, {source = module_source(module_id(1).get_or(root_module_id())), start = 10, end = 17})
								and same_span(right, {source = module_source(module_id(2).get_or(root_module_id())), start = 10, end = 17})
								and same_span(left_import, {source = module_source(root_module_id()), start = 20, end = 23})
								and same_span(right_import, {source = module_source(root_module_id()), start = 52, end = 55})
							)
						_: False


pure func test_multiple_incompatible_receivers_have_typed_error() -> Bool:
	rejects(two_methods("\"text\".measure()", INT_METHOD, FLOAT_METHOD), pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.NoApplicableMethod(_, Model.StringType, [_, _])): True
			_: False
	)


pure func test_unique_incompatible_receiver_preserves_argument_error() -> Bool:
	root: String =
		|import:
		|    ./ops: Int
		|func main() -> Int:
		|    "text".measure()
		|
	rejects([{source = root, targets = [1]}, {source = INT_METHOD, targets = []}], pure func(error):
		match error.kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
				(
					Model.same_type(mismatch.expected, Model.IntType)
					and Model.same_type(mismatch.actual.value_type, Model.StringType)
				)
			_: False
	)


pure func test_unique_receiver_preserves_wrong_arity_beside_other_type() -> Bool:
	left: String =
		|pure func measure(value: Int, other: Int) -> Int:
		|    value
		|
	rejects(two_methods("42.measure()", left, FLOAT_METHOD), pure func(error):
		match error.kind:
			Errors.CallRejection(Errors.ArgumentCountMismatch(mismatch)): mismatch.expected == 2 and mismatch.actual == 1
			_: False
	)


pure func test_arity_selects_among_receiver_matches() -> Bool:
	right: String =
		|pure func measure(value: Int, other: Int) -> Int:
		|    value
		|
	accepts(two_methods("42.measure(1)", INT_METHOD, right))


pure func test_multiple_receiver_matches_report_available_arities() -> Bool:
	left: String =
		|pure func measure(value: Int, other: Int) -> Int:
		|    value
		|
	right: String =
		|pure func measure(value: Int, other: Int, third: Int) -> Int:
		|    value
		|
	rejects(two_methods("42.measure()", left, right), pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.MethodArgumentCounts(_, 1, [2, 3], [_, _])): True
			_: False
	)


pure func test_later_arguments_do_not_rank_candidates() -> Bool:
	left: String =
		|pure func measure(value: Int, other: Int) -> Int:
		|    value
		|
	right: String =
		|pure func measure(value: Int, other: String) -> Int:
		|    value
		|
	rejects(two_methods("42.measure(1)", left, right), pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.AmbiguousMethod(_, _, [_, _])): True
			_: False
	)


pure func test_purity_does_not_rank_candidates() -> Bool:
	root: String =
		|import:
		|    ./left: Int
		|    ./right: Int
		|pure func main() -> Int:
		|    42.measure()
		|
	impure: String =
		|func measure(value: Int) -> Int:
		|    value
		|
	rejects([{source = root, targets = [1, 2]}, {source = INT_METHOD, targets = []}, {source = impure, targets = []}], pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.AmbiguousMethod(_, _, [_, _])): True
			_: False
	)


pure func test_expected_return_type_does_not_rank_candidates() -> Bool:
	right: String =
		|pure func measure(value: Int) -> Float:
		|    1.0
		|
	rejects(two_methods("42.measure()", INT_METHOD, right), pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.AmbiguousMethod(_, Model.IntType, [_, _])): True
			_: False
	)


pure func test_unique_selected_impure_method_rejects_pure_caller() -> Bool:
	root: String =
		|import:
		|    ./ops: Int
		|pure func main() -> Int:
		|    42.measure()
		|
	ops: String =
		|func measure(value: Int) -> Int:
		|    value
		|
	rejects([{source = root, targets = [1]}, {source = ops, targets = []}], pure func(error):
		match error.kind:
			Errors.CallRejection(Errors.ImpureCall(_, _)): True
			_: False
	)


private FOO: String =
	|fixed record Foo { value: Int }
	|


pure func test_record_methods_compose_across_modules_and_chain() -> Bool:
	root: String =
		|import:
		|    ./foo: Foo
		|    ./left: Foo methods_only
		|    ./right: Foo methods_only
		|pure func make() -> Foo:
		|    { value = 42 }
		|func main() -> Int:
		|    make().identity().number()
		|
	left: String =
		|import:
		|    ./foo: Foo
		|pure func identity(value: Foo) -> Foo:
		|    value
		|
	right: String =
		|import:
		|    ./foo: Foo
		|pure func number(value: Foo) -> Int:
		|    value.value
		|
	accepts([{source = root, targets = [1, 2, 3]}, {source = FOO, targets = []}, {source = left, targets = [1]}, {source = right, targets = [1]}])


pure func test_field_access_then_method_uses_field_type() -> Bool:
	root: String =
		|import:
		|    ./left: Int
		|    ./right: Float
		|fixed record Foo { value: Int }
		|pure func make() -> Foo:
		|    { value = 42 }
		|func main() -> Int:
		|    make().value.measure()
		|
	accepts([{source = root, targets = [1, 2]}, {source = INT_METHOD, targets = []}, {source = FLOAT_METHOD, targets = []}])


pure func test_unique_constructor_receiver_context_is_preserved() -> Bool:
	root: String =
		|fixed union Choice:
		|    Chosen(Int)
		|pure func measure(value: Choice) -> Int:
		|    match value:
		|        Chosen(number): number
		|func main() -> Int:
		|    Chosen(42).measure()
		|
	accepts([{source = root, targets = []}])


pure func test_competing_constructor_receiver_context_teaches_annotation() -> Bool:
	root: String =
		|import:
		|    ./left: Choice(Chosen)
		|    ./right: Other
		|func main() -> Int:
		|    Chosen(42).measure()
		|
	left: String =
		|fixed union Choice:
		|    Chosen(Int)
		|pure func measure(value: Choice) -> Int:
		|    42
		|
	right: String =
		|fixed union Other:
		|    Empty
		|pure func measure(value: Other) -> Int:
		|    42
		|
	rejects([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}], pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.MethodReceiverNeedsType(_, [_, _])): True
			_: False
	)


pure func test_applied_generic_receiver_matches_full_arguments() -> Bool:
	root: String =
		|import:
		|    ./left: Option
		|    ./right: Option
		|pure func make() -> Option[Int]:
		|    Some(42)
		|func main() -> Int:
		|    make().measure()
		|
	left: String =
		|pure func measure(value: Option[Int]) -> Int:
		|    42
		|
	right: String =
		|pure func measure(value: Option[String]) -> Int:
		|    1
		|
	accepts([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}])


pure func test_generic_receiver_is_not_less_specific() -> Bool:
	root: String =
		|import:
		|    ./left: Option
		|    ./right: Option
		|pure func make() -> Option[Int]:
		|    Some(42)
		|func main() -> Int:
		|    make().measure()
		|
	left: String =
		|pure func measure[T](value: Option[T]) -> Int:
		|    42
		|
	right: String =
		|pure func measure(value: Option[Int]) -> Int:
		|    1
		|
	rejects([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}], pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.AmbiguousMethod(_, _, [_, _])): True
			_: False
	)


pure func test_unique_generic_callee_provides_concrete_constructor_context() -> Bool:
	root: String =
		|import:
		|    ./ops: Option
		|func main() -> Int:
		|    Some(42).measure(1)
		|
	ops: String =
		|pure func measure[T](value: Option[Int], other: T) -> Int:
		|    42
		|
	accepts([{source = root, targets = [1]}, {source = ops, targets = []}])


pure func test_concrete_list_receiver_selects_list_method() -> Bool:
	root: String =
		|import:
		|    ./left: List
		|    ./right: String
		|func main(arguments: List[String]) -> Int:
		|    arguments.measure()
		|
	left: String =
		|pure func measure(value: List[String]) -> Int:
		|    42
		|
	right: String =
		|pure func measure(value: String) -> Int:
		|    1
		|
	accepts([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}])


pure func test_common_constructor_context_preserves_arity_selection() -> Bool:
	root: String =
		|import:
		|    ./left: Option
		|    ./right: Option
		|func main() -> Int:
		|    Some(42).measure(1)
		|
	left: String =
		|pure func measure(value: Option[Int]) -> Int:
		|    1
		|
	right: String =
		|pure func measure(value: Option[Int], other: Int) -> Int:
		|    42
		|
	accepts([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}])


pure func test_unique_generic_union_receiver_instantiates_from_receiver() -> Bool:
	root: String =
		|import:
		|    ./ops: Option
		|pure func make() -> Option[String]:
		|    None
		|func main() -> Int:
		|    make().measure()
		|
	ops: String =
		|pure func measure[T](value: Option[T]) -> Int:
		|    42
		|
	accepts([{source = root, targets = [1]}, {source = ops, targets = []}])


pure func test_repeated_generic_receiver_arguments_must_unify() -> Bool:
	root: String =
		|import:
		|    ./left: Result
		|    ./right: Result
		|pure func make() -> Result[Int, String]:
		|    Ok(42)
		|func main() -> Int:
		|    make().measure()
		|
	left: String =
		|pure func measure[T](value: Result[T, T]) -> Int:
		|    1
		|
	right: String =
		|pure func measure(value: Result[Int, String]) -> Int:
		|    42
		|
	accepts([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}])


pure func test_inapplicable_method_diagnostic_has_exact_help_and_call_span() -> Bool:
	method_diagnostic_is(
		two_methods("\"text\".measure()", INT_METHOD, FLOAT_METHOD),
		"no method accepts this receiver type",
		"use a value of a declared receiver type, or import a function accepting this type",
		102,
		109,
	)


pure func test_method_arity_diagnostic_has_exact_counts_and_call_span() -> Bool:
	left: String =
		|pure func measure(value: Int, other: Int) -> Int:
		|    value
		|
	right: String =
		|pure func measure(value: Int, other: Int, third: Int) -> Int:
		|    value
		|
	method_diagnostic_is(
		two_methods("42.measure()", left, right),
		"method argument count does not match any receiver-compatible function",
		"pass one of these total argument counts, including the receiver: 2, 3",
		98,
		105,
	)


pure func test_constructor_context_diagnostic_has_exact_help_and_call_span() -> Bool:
	root: String =
		|import:
		|    ./left: Choice(Chosen)
		|    ./right: Other
		|func main() -> Int:
		|    Chosen(42).measure()
		|
	left: String =
		|fixed union Choice:
		|    Chosen(Int)
		|pure func measure(value: Choice) -> Int:
		|    42
		|
	right: String =
		|fixed union Other:
		|    Empty
		|pure func measure(value: Other) -> Int:
		|    42
		|
	method_diagnostic_is(
		[{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}],
		"method receiver needs an explicit type",
		"bind the receiver through a typed helper, or call a uniquely imported function directly",
		89,
		96,
	)


pure func test_competing_outer_methods_preserve_nested_constructor_error() -> Bool:
	root: String =
		|import:
		|    ./left: Int
		|    ./right: Float
		|pure func identity[T](value: T) -> T:
		|    value
		|func main() -> Int:
		|    identity(None).measure()
		|
	rejects([{source = root, targets = [1, 2]}, {source = INT_METHOD, targets = []}, {source = FLOAT_METHOD, targets = []}], pure func(error):
		match error.kind:
			Errors.ConstructorRejection(Errors.ConstructorNeedsExpectedType(_)): True
			_: False
	)


pure func test_bare_constructor_with_competing_contexts_teaches_annotation() -> Bool:
	root: String =
		|import:
		|    ./left: Option
		|    ./right: Option
		|func main() -> Int:
		|    None.measure()
		|
	left: String =
		|pure func measure(value: Option[Int]) -> Int:
		|    1
		|
	right: String =
		|pure func measure(value: Option[String]) -> Int:
		|    42
		|
	rejects([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}], pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.MethodReceiverNeedsType(_, [_, _])): True
			_: False
	)


pure func test_record_with_competing_contexts_teaches_annotation() -> Bool:
	root: String =
		|import:
		|    ./left: Foo
		|    ./right: Other
		|func main() -> Int:
		|    { value = 42 }.measure()
		|
	left: String =
		|fixed record Foo { value: Int }
		|pure func measure(value: Foo) -> Int:
		|    1
		|
	right: String =
		|fixed record Other { value: Int }
		|pure func measure(value: Other) -> Int:
		|    42
		|
	rejects([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}], pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.MethodReceiverNeedsType(_, [_, _])): True
			_: False
	)


tests: TestSuite = {
	description = "method resolution",
	tests = [
		("expected return type does not rank candidates", test_expected_return_type_does_not_rank_candidates),
		("local and imported method ambiguity retains both origins", test_local_and_type_import_method_ambiguity_keeps_both_origins),
		("bare constructor competing contexts teach annotation", test_bare_constructor_with_competing_contexts_teaches_annotation),
		("record competing contexts teach annotation", test_record_with_competing_contexts_teaches_annotation),
		("competing methods preserve nested constructor error", test_competing_outer_methods_preserve_nested_constructor_error),
		("inapplicable diagnostic exact help and span", test_inapplicable_method_diagnostic_has_exact_help_and_call_span),
		("arity diagnostic exact counts and span", test_method_arity_diagnostic_has_exact_counts_and_call_span),
		("constructor context diagnostic exact help and span", test_constructor_context_diagnostic_has_exact_help_and_call_span),
		("unique generic receiver instantiates from receiver", test_unique_generic_union_receiver_instantiates_from_receiver),
		("repeated generic receiver arguments must unify", test_repeated_generic_receiver_arguments_must_unify),
		("concrete List receiver selects List method", test_concrete_list_receiver_selects_list_method),
		("common constructor context retains arity selection", test_common_constructor_context_preserves_arity_selection),
		("receiver type selects same named methods", test_receiver_type_selects_same_named_methods),
		("receiver selection ignores import order", test_receiver_selection_ignores_import_order),
		("same receiver and arity are ambiguous", test_same_receiver_and_arity_is_ambiguous),
		("ambiguity renders every candidate site", test_ambiguity_renders_primary_and_all_candidate_sites),
		("multiple incompatible receivers have typed error", test_multiple_incompatible_receivers_have_typed_error),
		("unique incompatible receiver preserves argument error", test_unique_incompatible_receiver_preserves_argument_error),
		("wrong arity survives different receiver matching arity", test_unique_receiver_preserves_wrong_arity_beside_other_type),
		("arity selects among receiver matches", test_arity_selects_among_receiver_matches),
		("multiple receiver matches report available arities", test_multiple_receiver_matches_report_available_arities),
		("later arguments do not rank candidates", test_later_arguments_do_not_rank_candidates),
		("purity does not rank candidates", test_purity_does_not_rank_candidates),
		("unique impure method rejects pure caller", test_unique_selected_impure_method_rejects_pure_caller),
		("record methods compose across modules and chain", test_record_methods_compose_across_modules_and_chain),
		("field then method uses field type", test_field_access_then_method_uses_field_type),
		("unique constructor receiver context is preserved", test_unique_constructor_receiver_context_is_preserved),
		("competing constructor context teaches annotation", test_competing_constructor_receiver_context_teaches_annotation),
		("applied receiver matches full arguments", test_applied_generic_receiver_matches_full_arguments),
		("generic receiver does not lose specificity ranking", test_generic_receiver_is_not_less_specific),
		("unique generic callee provides constructor context", test_unique_generic_callee_provides_concrete_constructor_context),
	]
}
