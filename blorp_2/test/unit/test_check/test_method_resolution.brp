pure func test_inapplicable_method_diagnostic_has_exact_help_and_call_span() -> Bool:
	method_diagnostic_is(
		two_methods("\"text\".measure()", INT_METHOD, FLOAT_METHOD),
		"no method accepts this receiver type",
		"use a value of a declared receiver type, or import a function accepting this type",
		180,
		187,
	)


pure func test_unique_method_arity_diagnostic_has_exact_help_and_call_span() -> Bool:
	left: String =
		|pure func measure(value: Int, other: Int) -> Int:
		|    value
		|
	match parse_modules(two_methods("42.measure()", left, FLOAT_METHOD)):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					error = check_errors(failure).first
					diagnostic = render_failure(failure).first
					prefix = "import:\n    ./left: Int methods_only, Float methods_only, String methods_only\n    ./right: Int methods_only, Float methods_only, String methods_only\nfunc main() -> Int:\n    42."
					match error.kind:
						Errors.CallRejection(Errors.ArgumentCountMismatch(mismatch)):
							(mismatch.expected == 2 and mismatch.actual == 1
								and same_span(error.span, root_span(prefix, "measure")) and same_span(error.span, diagnostic.span)
								and diagnostic.note.is_none()
								and diagnostic.message == "argument count does not match the function parameters"
								and diagnostic.help == "pass one expression for each declared parameter; UFCS supplies the receiver first")
						_: False


pure func test_constructor_context_diagnostic_has_exact_help_and_call_span() -> Bool:
	root: String =
		|import:
		|    ./left: Choice(Chosen)
		|    ./right: Other
		|func main() -> Int:
		|    Chosen(42).measure()
		|
	left: String =
		|fixed union Choice:
		|    Chosen(Int)
		|pure func measure(value: Choice) -> Int:
		|    42
		|
	right: String =
		|fixed union Other:
		|    Empty
		|pure func measure(value: Other) -> Int:
		|    42
		|
	method_diagnostic_is(
		[{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}],
		"method receiver needs an explicit type",
		"bind the receiver through a typed helper, or call a uniquely imported function directly",
		89,
		96,
	)


