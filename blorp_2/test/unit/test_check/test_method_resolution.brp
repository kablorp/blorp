import:
	../../../src/check/model as Model
	../../../src/check/check: check, check_errors, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/render: render_failure
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: function_number, inventory_functions, union_number
	../../../src/utils/source: module_id, module_source, root_module_id, same_source
	../../../src/utils/syntax: DiagnosticNote(CompetingDeclarations, NoteLines), Span, same_span
	../module_input: ModuleInput, parse_modules
	test: TestSuite
	../../../src/utils/text: concat


private pure func accepts(inputs: List[ModuleInput]) -> Bool:
	match parse_modules(inputs):
		Err(_): False
		Ok(parsed): check(parsed).is_ok()


private pure func rejects(inputs: List[ModuleInput], expected: pure (Errors.CheckError) -> Bool) -> Bool:
	match parse_modules(inputs):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure): expected(check_errors(failure).first)


private pure func method_diagnostic_is(
	inputs: List[ModuleInput],
	message: String,
	help: String,
	start: Int,
	end: Int,
) -> Bool:
	match parse_modules(inputs):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					diagnostic = render_failure(failure).first
					match diagnostic.note:
						Some(CompetingDeclarations([_, _, _, _])):
							(
								diagnostic.message == message
								and diagnostic.help == help
								and same_span(diagnostic.span, {source = module_source(root_module_id()), start = start, end = end})
							)
						_: False


private pure func two_methods(body: String, left: String, right: String) -> List[ModuleInput]:
	root = "import:\n    ./left: Int methods_only, Float methods_only, String methods_only\n    ./right: Int methods_only, Float methods_only, String methods_only\nfunc main() -> Int:\n    ".concat(body).concat("\n")
	[{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}]


private pure func root_span(prefix: String, name: String) -> Span:
	{ source = module_source(root_module_id()), start = prefix.length(), end = prefix.length() + name.length() }


-- These controlled three-module inputs declare main, left measure, right measure.
private pure func overlapping_int_receivers(error: Errors.CheckError) -> Bool:
	match error.kind:
		Errors.MethodRejection(Errors.OverlappingReceivers(_, overlap)):
			(function_number(overlap.introduced.function) == 2 and function_number(overlap.other.function) == 1
				and Model.same_type(overlap.introduced_receiver, Model.IntType)
				and Model.same_type(overlap.other_receiver, Model.IntType))
		_: False


private INT_METHOD: String =
	|pure func measure(value: Int) -> Int:
	|    value
	|


private FLOAT_METHOD: String =
	|pure func measure(value: Float) -> Int:
	|    42
	|


pure func test_receiver_type_selects_same_named_methods() -> Bool:
	(
		accepts(two_methods("42.measure()", INT_METHOD, FLOAT_METHOD))
		and accepts(two_methods("1.0.measure()", INT_METHOD, FLOAT_METHOD))
	)


pure func test_receiver_selection_ignores_import_order() -> Bool:
	accepts(two_methods("42.measure()", FLOAT_METHOD, INT_METHOD))


pure func test_same_receiver_declarations_overlap() -> Bool:
	rejects(two_methods("42.measure()", INT_METHOD, INT_METHOD), overlapping_int_receivers)


pure func test_local_and_imported_receiver_clash_keeps_both_origins() -> Bool:
	root: String =
		|import:
		|    ./ops: Int methods_only
		|pure func measure(value: Int) -> Int:
		|    value
		|func main() -> Int:
		|    42.measure()
		|
	match parse_modules([{source = root, targets = [1]}, {source = INT_METHOD, targets = []}]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					error = check_errors(failure).first
					diagnostic = render_failure(failure).first
					match error.kind:
						Errors.MethodRejection(Errors.OverlappingReceivers(_, overlap)):
							match (overlap.other.import_site, overlap.introduced.import_site, diagnostic.note):
								(None, Some(import_site), Some(NoteLines([imported, local]))):
									primary = root_span("import:\n    ./ops: ", "Int")
									(function_number(overlap.introduced.function) == 2 and function_number(overlap.other.function) == 0
										and Model.same_type(overlap.introduced_receiver, Model.IntType)
										and Model.same_type(overlap.other_receiver, Model.IntType)
										and same_span(imported.span, overlap.introduced.declaration)
										and same_span(local.span, overlap.other.declaration)
										and imported.text == "receiver Int is declared here" and local.text == imported.text
										and same_source(local.span.source, module_source(root_module_id()))
										and same_source(imported.span.source, module_source(module_id(1).get_or(root_module_id())))
										and same_span(import_site, primary) and same_span(error.span, primary) and same_span(diagnostic.span, primary)
										and diagnostic.message == "two functions named measure can accept the same receiver"
										and diagnostic.help == "rename one of them, or change a first parameter so that no value fits both receivers, Int and Int")
								_: False
						_: False


pure func test_receiver_clash_renders_primary_and_all_other_sites() -> Bool:
	match parse_modules(two_methods("42.measure()", INT_METHOD, INT_METHOD)):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					error = check_errors(failure).first
					diagnostic = render_failure(failure).first
					match diagnostic.note:
						Some(NoteLines([right, left, left_import])):
							primary_prefix = "import:\n    ./left: Int methods_only, Float methods_only, String methods_only\n    ./right: "
							primary = root_span(primary_prefix, "Int")
							declaration = "pure func ".length()
							(
								overlapping_int_receivers(error) and same_span(error.span, primary) and same_span(diagnostic.span, primary)
								and diagnostic.message == "two functions named measure can accept the same receiver"
								and diagnostic.help == "rename one of them, or change a first parameter so that no value fits both receivers, Int and Int"
								and same_span(left.span, { source = module_source(module_id(1).get_or(root_module_id())), start = declaration, end = declaration + "measure".length() })
								and same_span(right.span, { source = module_source(module_id(2).get_or(root_module_id())), start = declaration, end = declaration + "measure".length() })
								and same_span(left_import.span, root_span("import:\n    ./left: ", "Int"))
								and left.text == "receiver Int is declared here" and right.text == left.text
								and left_import.text == "receiver Int is imported here"
							)
						_: False


pure func test_multiple_incompatible_receivers_have_typed_error() -> Bool:
	rejects(two_methods("\"text\".measure()", INT_METHOD, FLOAT_METHOD), pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.NoApplicableMethod(_, Model.StringType, [_, _])): True
			_: False
	)


pure func test_unique_incompatible_receiver_preserves_argument_error() -> Bool:
	root: String =
		|import:
		|    ./ops: Int methods_only
		|func main() -> Int:
		|    "text".measure()
		|
	rejects([{source = root, targets = [1]}, {source = INT_METHOD, targets = []}], pure func(error):
		match error.kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
				(
					Model.same_type(mismatch.expected, Model.IntType)
					and Model.same_type(mismatch.actual.value_type, Model.StringType)
				)
			_: False
	)


pure func test_unique_receiver_preserves_wrong_arity_beside_other_type() -> Bool:
	left: String =
		|pure func measure(value: Int, other: Int) -> Int:
		|    value
		|
	rejects(two_methods("42.measure()", left, FLOAT_METHOD), pure func(error):
		match error.kind:
			Errors.CallRejection(Errors.ArgumentCountMismatch(mismatch)): mismatch.expected == 2 and mismatch.actual == 1
			_: False
	)


pure func test_different_arities_do_not_separate_receivers() -> Bool:
	right: String =
		|pure func measure(value: Int, other: Int) -> Int:
		|    value
		|
	rejects(two_methods("42.measure(1)", INT_METHOD, right), overlapping_int_receivers)


