		("record methods compose across modules and chain", test_record_methods_compose_across_modules_and_chain),
		("field then method uses field type", test_field_access_then_method_uses_field_type),
		("unique constructor receiver context is preserved", test_unique_constructor_receiver_context_is_preserved),
		("competing constructor context teaches annotation", test_competing_constructor_receiver_context_teaches_annotation),
		("applied receiver matches full arguments", test_applied_generic_receiver_matches_full_arguments),
		("generic and concrete receiver declarations overlap", test_generic_and_concrete_receiver_declarations_overlap),
		("unique generic callee provides constructor context", test_unique_generic_callee_provides_concrete_constructor_context),
		("rigid caller parameter keeps no applicable method", test_rigid_actual_parameter_keeps_no_applicable_method),
		("function and type import routes keep one candidate identity", test_function_and_type_import_routes_keep_one_candidate_identity),
	]
