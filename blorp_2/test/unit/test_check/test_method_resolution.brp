		|pure func measure(value: Option[Int]) -> Int:
		|    1
		|
	right: String =
		|pure func measure(value: Option[Int], other: Int) -> Int:
		|    42
		|
	rejects([{source = root, targets = [1, 2]}, {source = left, targets = []}, {source = right, targets = []}], pure func(error):
		match error.kind:
			Errors.MethodRejection(Errors.OverlappingReceivers(_, overlap)):
				match overlap.introduced_receiver:
					Model.AppliedUnionType(_, [Model.IntType]):
						(function_number(overlap.introduced.function) == 2 and function_number(overlap.other.function) == 1
							and Model.same_type(overlap.introduced_receiver, overlap.other_receiver))
					_: False
			_: False
	)


