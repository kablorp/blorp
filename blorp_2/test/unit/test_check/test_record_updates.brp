	prefix = PAIR.concat(
		|pure func change(value: Pair) -> Pair:
		|    { value | first = 2.5,
	).concat(" ")
	suffix: String =
		|missing = 1 }
		|func main() -> Int:
		|    0
		|
	rejects(prefix.concat(suffix), prefix.length(), IntOps.add(prefix.length(), "missing".length()), "unknown field 'missing' in Pair", "use a field declared by the receiving record", pure func(kind):
		match kind:
			Errors.RecordRejection(Errors.UnknownRecordField(_, _)): True
			_: False
	)


pure func test_later_duplicate_precedes_earlier_unknown_rhs_value() -> Bool:
	prefix = PAIR.concat(
		|pure func change(value: Pair) -> Pair:
		|    { value |
	).concat(" ")
	first = "first"
	middle = " = missing, "
	suffix: String =
		|first = 1 }
		|func main() -> Int:
		|    0
		|
	source = prefix.concat(first).concat(middle).concat(suffix)
	rejects_duplicate(source, prefix.length(), IntOps.add(IntOps.add(prefix.length(), first.length()), middle.length()), first.length())


pure func test_growing_generic_recursion_is_found_in_a_replacement() -> Bool:
	prefix: String =
		|fixed record Box[T] { value: T, count: Int }
		|pure func make[T](value: T) -> Box[T]:
		|    { value = value, count = 0 }
		|pure func growing[T](value: T) -> Int:
		|    unused = { make(value) | count =
	before = prefix.concat(" ")
	call = "growing(make(value))"
	suffix: String =
		| }
		|    0
		|func main() -> Int:
		|    0
		|
	rejects(before.concat(call).concat(suffix), before.length(), IntOps.add(before.length(), "growing".length()), "recursive calls grow type arguments without bound", "pass recursive type arguments unchanged, permute them, or reset them to concrete types", pure func(kind):
		match kind:
			Errors.RecursionRejection(Errors.GrowingRecursiveInstantiation): True
			_: False
	)


tests: TestSuite = {
	description = "Fresh record updates",
	tests = [
		("update fields partition the record", test_update_fields_partition_the_record),
		("fresh update accepts an existing alias", test_fresh_update_accepts_an_existing_alias),
		("replacement infers unsettled base arguments", test_replacement_infers_unsettled_base_arguments),
		("unknown replacement precedes base freeze", test_unknown_replacement_precedes_unsettled_base_freeze),
		("nonrecord postfix base has its complete span", test_nonrecord_postfix_base_reports_its_complete_span),
		("duplicate replacement notes the first name", test_duplicate_replacement_retains_first_written_span),
		("replacement mismatch retains value and annotation", test_replacement_mismatch_retains_complete_value_and_annotation),
		("literal base uses the ordinary result context", test_literal_base_uses_the_ordinary_result_context),
		("outer postfix preserves the update record head", test_outer_postfix_preserves_the_record_update_head),
		("generic update preserves rigid parameter identity", test_generic_update_keeps_the_declaration_owned_parameter),
		("impure replacement has the ordinary call error", test_impure_replacement_keeps_the_ordinary_call_error),
		("tail recursion validation visits the update base", test_tail_recursion_validation_visits_the_update_base),
		("tail recursion validation visits replacement children", test_tail_recursion_validation_visits_replacement_children),
		("growing recursion is found in an update base", test_growing_generic_recursion_is_found_in_an_update_base),
		("same layout preserves nominal update owner", test_same_layout_cannot_change_the_nominal_update_owner),
		("later unknown field precedes earlier wrong RHS", test_unknown_later_field_precedes_earlier_wrong_rhs_type),
		("later duplicate precedes earlier unknown RHS", test_later_duplicate_precedes_earlier_unknown_rhs_value),
		("growing recursion is found in a replacement", test_growing_generic_recursion_is_found_in_a_replacement),
	]
}
