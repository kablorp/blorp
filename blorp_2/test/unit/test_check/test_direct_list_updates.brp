import:
	../../../src/check/check: check, checked_functions
	../../../src/check/model as Checked
	../../../src/check/render: render_failure
	../../../src/namespace/builtins as Builtins
	../../../src/utils/ids: function_number
	../../../src/utils/source: module_source, root_module_id, same_source
	../module_input: parse_modules
	bool: Bool methods
	int: Int methods
	list: List methods
	option: Option methods
	result: Result methods
	string: String methods
	test: TestSuite


private APPEND: String =
	|pure func append[Element](values: List[Element], value: Element) -> List[Element]:
	|    builtin("list.append")
	|

private MAIN: String = "func main() -> Int:\n    0\n"


private pure func checked_function(source: String, position: Int) -> Option[Checked.CheckedFunction]:
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): None
		Ok(parsed):
			match check(parsed):
				Err(_): None
				Ok(program): checked_functions(program).functions.get(position)


private pure func returned_call(function: Checked.CheckedFunction) -> Option[Checked.CheckedCall]:
	match function.body:
		Checked.CheckedValueBody(Checked.ReturnExpression(value)):
			match value.form:
				Checked.InvokeFunction(call): Some(call)
				_: None
		_: None


private pure func append_operands(function: Checked.CheckedFunction, expected: Checked.TypeRef, left_position: Int, right_position: Int) -> Bool:
	match returned_call(function):
		Some(call):
			match (call.target, call.operands):
				(Checked.RuntimeFunction(Builtins.ListAppend(element)), [Checked.ValueOperand(left), Checked.ValueOperand(right)]):
					match (left.form, right.form):
						(Checked.ReadBinding(left_id), Checked.ReadBinding(right_id)):
							Checked.same_type(element, expected)
								.and(Checked.same_type(left.value_type, Checked.ListType(expected)))
								.and(Checked.same_type(right.value_type, expected))
								.and(Checked.binding_number(left_id).equals(left_position))
								.and(Checked.binding_number(right_id).equals(right_position))
						_: False
				_: False
		None: False


private pure func concrete_call(element_name: String, element: Checked.TypeRef, expression: String) -> Bool:
	source = "${APPEND}pure func caller(values: List[${element_name}], value: ${element_name}) -> List[${element_name}]:\n    ${expression}\n${MAIN}"
	match checked_function(source, 1):
		Some(function): append_operands(function, element, 0, 1)
		None: False


pure func test_direct_concrete_append() -> Bool:
	concrete_call("Int", Checked.IntType, "append(values, value)")


pure func test_receiver_concrete_append() -> Bool:
	concrete_call("String", Checked.StringType, "values.append(value)")


pure func test_nested_element_substitution() -> Bool:
	concrete_call("List[String]", Checked.ListType(Checked.StringType), "append(values, value)")


private pure func generic_call(expression: String) -> Bool:
	-- The caller element is its second parameter, owned by another declaration.
	-- Callee parameter position zero must never leak into the checked operation.
	source = "${APPEND}pure func caller[Ignored, Payload](ignored: Ignored, values: List[Payload], value: Payload) -> List[Payload]:\n    ${expression}\n${MAIN}"
	match checked_function(source, 1):
		Some(function):
			match function.signature.type_parameters:
				[_, element]: append_operands(function, Checked.ParameterType(element), 1, 2)
				_: False
		None: False


pure func test_direct_generic_append() -> Bool:
	generic_call("append(values, value)")


pure func test_receiver_generic_append() -> Bool:
	generic_call("values.append(value)")


pure func test_expected_list_type_reaches_the_runtime_operation() -> Bool:
	source: String =
		|pure func caller() -> List[Option[String]]:
		|    append([], None)
		|
	match checked_function("${APPEND}${source}${MAIN}", 1):
		Some(function):
			match returned_call(function):
				Some(call):
					match (call.target, call.operands):
						(Checked.RuntimeFunction(Builtins.ListAppend(element)), [Checked.ValueOperand(values), Checked.ValueOperand(value)]):
							match function.signature.return_type.value_type:
								Checked.ListType(expected):
									Checked.same_type(element, expected)
										.and(Checked.same_type(values.value_type, Checked.ListType(expected)))
										.and(Checked.same_type(value.value_type, expected))
								_: False
						_: False
				None: False
		None: False


pure func test_user_wrapper_retains_its_declared_target() -> Bool:
	source: String =
		|pure func wrapper(values: List[Int], value: Int) -> List[Int]:
		|    append(values, value)
		|pure func caller(values: List[Int], value: Int) -> List[Int]:
		|    wrapper(values, value)
		|
	match checked_function("${APPEND}${source}${MAIN}", 2):
		Some(function):
			match returned_call(function):
				Some(call):
					match call.target:
						Checked.UserFunction(id, []): function_number(id).equals(1)
						_: False
				None: False
		None: False


pure func test_named_append_callable_retains_its_declared_wrapper() -> Bool:
	source: String =
		|pure func apply(callback: pure (List[Int], Int) -> List[Int], values: List[Int], value: Int) -> List[Int]:
		|    callback(values, value)
		|pure func caller(values: List[Int], value: Int) -> List[Int]:
		|    apply(append, values, value)
		|
	match checked_function("${APPEND}${source}${MAIN}", 2):
		Some(function):
			match returned_call(function):
				Some(call):
					match (call.target, call.operands):
						(Checked.UserFunction(apply_id, []), [Checked.CallableOperand(_, Checked.NamedCallable(append_id, [element]), _), Checked.ValueOperand(_), Checked.ValueOperand(_)]):
							function_number(apply_id).equals(1).and(function_number(append_id).equals(0))
								.and(Checked.same_type(element, Checked.IntType))
						_: False
				None: False
		None: False


pure func test_stored_append_callable_retains_its_declared_wrapper() -> Bool:
	source: String =
		|pure func stored() -> pure (List[String], String) -> List[String]:
		|    append
		|
	match checked_function("${APPEND}${source}${MAIN}", 1):
		Some(function):
			match function.body:
				Checked.CheckedValueBody(Checked.ReturnExpression(value)):
					match value.form:
						Checked.MakeCallable(Checked.NamedCallable(id, [element])):
							function_number(id).equals(0).and(Checked.same_type(element, Checked.StringType))
						_: False
				_: False
		None: False


private pure func rejects(prefix: String, marked: String, suffix: String, message: String, help: String) -> Bool:
	source = "${prefix}${marked}${suffix}${MAIN}"
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					diagnostics = render_failure(failure)
					error = diagnostics.first
					error.message.equals(message).and(error.help.equals(help))
						.and(same_source(error.span.source, module_source(root_module_id())))
						.and(error.span.start.equals(prefix.length()))
						.and(error.span.end.equals(prefix.length().add(marked.length())))
						.and(error.note.is_none()).and(diagnostics.remaining.is_empty())


pure func test_argument_type_mismatch_still_rejects() -> Bool:
	prefix = "${APPEND}pure func caller(values: List[Int]) -> List[Int]:\n    append(values, "
	rejects(prefix, "\"wrong\"", ")\n", "argument type does not match the parameter type", "use an expression of type Int here")


pure func test_direct_arity_still_rejects_at_the_function_name() -> Bool:
	prefix = "${APPEND}pure func caller(values: List[Int]) -> List[Int]:\n    "
	rejects(prefix, "append", "(values)\n", "argument count does not match the function parameters", "pass one expression for each declared parameter; UFCS supplies the receiver first")


pure func test_receiver_arity_still_rejects_at_the_function_name() -> Bool:
	prefix = "${APPEND}pure func caller(values: List[Int]) -> List[Int]:\n    values."
	rejects(prefix, "append", "()\n", "argument count does not match the function parameters", "pass one expression for each declared parameter; UFCS supplies the receiver first")


private BOUNDED_APPEND: String =
	|trait Allowed:
	|    pure func permit(value: Self) -> Int
	|pure func append[Element: Allowed](values: List[Element], value: Element) -> List[Element]:
	|    builtin("list.append")
	|

private BOUND_MESSAGE: String = "type does not satisfy the required trait bound"
private BOUND_HELP: String = "add the required trait to this function's type parameter bounds, or provide an implementation for the concrete receiver"


pure func test_runtime_call_proves_concrete_signature_bounds() -> Bool:
	prefix = "${BOUNDED_APPEND}pure func caller(values: List[Int], value: Int) -> List[Int]:\n    "
	rejects(prefix, "append", "(values, value)\n", BOUND_MESSAGE, BOUND_HELP)


pure func test_runtime_call_proves_generic_signature_bounds() -> Bool:
	prefix = "${BOUNDED_APPEND}pure func caller[Payload](values: List[Payload], value: Payload) -> List[Payload]:\n    values."
	rejects(prefix, "append", "(value)\n", BOUND_MESSAGE, BOUND_HELP)


pure func test_runtime_call_accepts_proved_generic_signature_bounds() -> Bool:
	source: String =
		|pure func caller[Payload: Allowed](values: List[Payload], value: Payload) -> List[Payload]:
		|    append(values, value)
		|
	match checked_function("${BOUNDED_APPEND}${source}${MAIN}", 1):
		Some(function):
			match function.signature.type_parameters:
				[element]: append_operands(function, Checked.ParameterType(element), 0, 1)
				_: False
		None: False


private pure func update_declaration(is_set: Bool, bounded: Bool) -> String:
	parameter = if bounded:
		"Element: Allowed"
	else:
		"Element"
	if is_set:
		"pure func set[${parameter}](values: List[Element], index: Int, value: Element) -> List[Element]:\n    builtin(\"list.set\")\n"
	else:
		"pure func concat[${parameter}](left: List[Element], right: List[Element]) -> List[Element]:\n    builtin(\"list.concat\")\n"


private pure func binding_at(value: Checked.CheckedExpr, position: Int) -> Bool:
	match value.form:
		Checked.ReadBinding(id): Checked.binding_number(id).equals(position)
		_: False


private pure func update_operands(function: Checked.CheckedFunction, expected: Checked.TypeRef, is_set: Bool, left_position: Int) -> Bool:
	match returned_call(function):
		None: False
		Some(call):
			match (call.target, call.operands):
				(Checked.RuntimeFunction(Builtins.ListSet(element)), [Checked.ValueOperand(left), Checked.ValueOperand(index), Checked.ValueOperand(right)]):
					is_set.and(Checked.same_type(element, expected))
						.and(Checked.same_type(left.value_type, Checked.ListType(expected)))
						.and(Checked.same_type(index.value_type, Checked.IntType)).and(Checked.same_type(right.value_type, expected))
						.and(binding_at(left, left_position)).and(binding_at(index, left_position.add(1))).and(binding_at(right, left_position.add(2)))
				(Checked.RuntimeFunction(Builtins.ListConcat(element)), [Checked.ValueOperand(left), Checked.ValueOperand(right)]):
					is_set.not().and(Checked.same_type(element, expected))
						.and(Checked.same_type(left.value_type, Checked.ListType(expected))).and(Checked.same_type(right.value_type, Checked.ListType(expected)))
						.and(binding_at(left, left_position)).and(binding_at(right, left_position.add(1)))
				_: False


private pure func checked_update(is_set: Bool, generic: Bool, receiver: Bool) -> Bool:
	parameters = if is_set:
		"values: List[Payload], index: Int, value: Payload"
	else:
		"values: List[Payload], right: List[Payload]"
	expression = if is_set:
		if receiver:
			"values.set(index, value)"
		else:
			"set(values, index, value)"
	else:
		if receiver:
			"values.concat(right)"
		else:
			"concat(values, right)"
	caller = if generic:
		"pure func caller[Ignored, Payload](ignored: Ignored, ${parameters}) -> List[Payload]:\n    ${expression}\n"
	else:
		if is_set:
			"pure func caller(values: List[String], index: Int, value: String) -> List[String]:\n    ${expression}\n"
		else:
			"pure func caller(values: List[String], right: List[String]) -> List[String]:\n    ${expression}\n"
	match checked_function("${update_declaration(is_set, False)}${caller}${MAIN}", 1):
		None: False
		Some(function):
			if generic:
				match function.signature.type_parameters:
					[_, element]: update_operands(function, Checked.ParameterType(element), is_set, 1)
					_: False
			else:
				update_operands(function, Checked.StringType, is_set, 0)


pure func test_set_direct_concrete() -> Bool:
	checked_update(True, False, False)


pure func test_set_receiver_concrete() -> Bool:
	checked_update(True, False, True)


pure func test_set_direct_generic() -> Bool:
	checked_update(True, True, False)


pure func test_set_receiver_generic() -> Bool:
	checked_update(True, True, True)


pure func test_concat_direct_concrete() -> Bool:
	checked_update(False, False, False)


pure func test_concat_receiver_concrete() -> Bool:
	checked_update(False, False, True)


pure func test_concat_direct_generic() -> Bool:
	checked_update(False, True, False)


pure func test_concat_receiver_generic() -> Bool:
	checked_update(False, True, True)


private pure func update_stored_wrapper(is_set: Bool) -> Bool:
	body = if is_set:
		"pure func stored() -> pure (List[String], Int, String) -> List[String]:\n    set\n"
	else:
		"pure func stored() -> pure (List[String], List[String]) -> List[String]:\n    concat\n"
	match checked_function("${update_declaration(is_set, False)}${body}${MAIN}", 1):
		None: False
		Some(function):
			match function.body:
				Checked.CheckedValueBody(Checked.ReturnExpression(value)):
					match value.form:
						Checked.MakeCallable(Checked.NamedCallable(id, [element])): function_number(id).equals(0).and(Checked.same_type(element, Checked.StringType))
						_: False
				_: False


pure func test_set_stored_wrapper() -> Bool:
	update_stored_wrapper(True)


pure func test_concat_stored_wrapper() -> Bool:
	update_stored_wrapper(False)


private pure func update_named_wrapper(is_set: Bool) -> Bool:
	body = if is_set:
		"pure func apply(callback: pure (List[Int], Int, Int) -> List[Int], values: List[Int], index: Int, value: Int) -> List[Int]:\n    callback(values, index, value)\npure func caller(values: List[Int], index: Int, value: Int) -> List[Int]:\n    apply(set, values, index, value)\n"
	else:
		"pure func apply(callback: pure (List[Int], List[Int]) -> List[Int], values: List[Int], right: List[Int]) -> List[Int]:\n    callback(values, right)\npure func caller(values: List[Int], right: List[Int]) -> List[Int]:\n    apply(concat, values, right)\n"
	match checked_function("${update_declaration(is_set, False)}${body}${MAIN}", 2):
		None: False
		Some(function):
			match returned_call(function):
				Some(call):
					match call.operands.get(0):
						Some(Checked.CallableOperand(_, Checked.NamedCallable(id, [element]), _)): function_number(id).equals(0).and(Checked.same_type(element, Checked.IntType))
						_: False
				None: False


pure func test_set_named_wrapper() -> Bool:
	update_named_wrapper(True)


pure func test_concat_named_wrapper() -> Bool:
	update_named_wrapper(False)


private ALLOWED_TRAIT: String = "trait Allowed:\n    pure func permit(value: Self) -> Int\n"


private pure func update_bound_rejects(is_set: Bool, generic: Bool) -> Bool:
	header = if generic:
		"pure func caller[Ignored, Payload](ignored: Ignored, values: List[Payload], value: Payload, right: List[Payload]) -> List[Payload]:\n    "
	else:
		"pure func caller(values: List[Int], value: Int, right: List[Int]) -> List[Int]:\n    "
	name = if is_set:
		"set"
	else:
		"concat"
	arguments = if is_set:
		"(values, 0, value)\n"
	else:
		"(values, right)\n"
	rejects("${ALLOWED_TRAIT}${update_declaration(is_set, True)}${header}", name, arguments, BOUND_MESSAGE, BOUND_HELP)


pure func test_set_concrete_bound_rejects() -> Bool:
	update_bound_rejects(True, False)


pure func test_set_generic_bound_rejects() -> Bool:
	update_bound_rejects(True, True)


pure func test_concat_concrete_bound_rejects() -> Bool:
	update_bound_rejects(False, False)


pure func test_concat_generic_bound_rejects() -> Bool:
	update_bound_rejects(False, True)


private pure func update_bound_accepts(is_set: Bool) -> Bool:
	body = if is_set:
		"pure func caller[Ignored, Payload: Allowed](ignored: Ignored, values: List[Payload], index: Int, value: Payload) -> List[Payload]:\n    set(values, index, value)\n"
	else:
		"pure func caller[Ignored, Payload: Allowed](ignored: Ignored, values: List[Payload], right: List[Payload]) -> List[Payload]:\n    concat(values, right)\n"
	match checked_function("${ALLOWED_TRAIT}${update_declaration(is_set, True)}${body}${MAIN}", 1):
		None: False
		Some(function):
			match function.signature.type_parameters:
				[_, element]: update_operands(function, Checked.ParameterType(element), is_set, 1)
				_: False


pure func test_set_bound_accepts() -> Bool:
	update_bound_accepts(True)


pure func test_concat_bound_accepts() -> Bool:
	update_bound_accepts(False)


tests: TestSuite = {
	description = "Direct List update checking and generic publication",
	tests = [
		("set concrete direct publishes typed runtime", test_set_direct_concrete),
		("set concrete UFCS publishes typed runtime", test_set_receiver_concrete),
		("set generic direct substitutes second caller parameter", test_set_direct_generic),
		("set generic UFCS substitutes second caller parameter", test_set_receiver_generic),
		("concat concrete direct publishes typed runtime", test_concat_direct_concrete),
		("concat concrete UFCS publishes typed runtime", test_concat_receiver_concrete),
		("concat generic direct substitutes second caller parameter", test_concat_direct_generic),
		("concat generic UFCS substitutes second caller parameter", test_concat_receiver_generic),
		("set stored callable retains wrapper", test_set_stored_wrapper),
		("concat stored callable retains wrapper", test_concat_stored_wrapper),
		("set named callable retains wrapper", test_set_named_wrapper),
		("concat named callable retains wrapper", test_concat_named_wrapper),
		("set concrete trait bound rejects exactly", test_set_concrete_bound_rejects),
		("set generic trait bound rejects exactly", test_set_generic_bound_rejects),
		("concat concrete trait bound rejects exactly", test_concat_concrete_bound_rejects),
		("concat generic trait bound rejects exactly", test_concat_generic_bound_rejects),
		("set accepts proved caller trait bound", test_set_bound_accepts),
		("concat accepts proved caller trait bound", test_concat_bound_accepts),
		("direct concrete call selects runtime append", test_direct_concrete_append),
		("UFCS concrete call selects runtime append", test_receiver_concrete_append),
		("nested List element substitutes without callee parameters", test_nested_element_substitution),
		("direct generic call publishes caller-owned element", test_direct_generic_append),
		("UFCS generic call publishes caller-owned element", test_receiver_generic_append),
		("expected List type reaches runtime operation and operands", test_expected_list_type_reaches_the_runtime_operation),
		("ordinary wrapper call stays declared", test_user_wrapper_retains_its_declared_target),
		("named callable retains borrowed wrapper", test_named_append_callable_retains_its_declared_wrapper),
		("stored callable retains borrowed wrapper", test_stored_append_callable_retains_its_declared_wrapper),
		("mismatched element rejects with exact diagnostic", test_argument_type_mismatch_still_rejects),
		("direct arity rejects with exact diagnostic", test_direct_arity_still_rejects_at_the_function_name),
		("UFCS arity rejects with exact diagnostic", test_receiver_arity_still_rejects_at_the_function_name),
		("runtime target proves concrete signature bounds", test_runtime_call_proves_concrete_signature_bounds),
		("runtime target proves generic signature bounds", test_runtime_call_proves_generic_signature_bounds),
		("runtime target accepts caller's proved bounds", test_runtime_call_accepts_proved_generic_signature_bounds),
	]
}
