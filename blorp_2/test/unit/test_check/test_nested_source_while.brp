import:
	../../../src/check/check: checked_functions
	../../../src/check/model as Checked
	../../../src/utils/ids: function_number
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: entry_function, same_span
	../source_while_inputs as Input
	../nested_while_inputs as Nested
	test: TestSuite


private pure func first_loop(statements: List[Checked.CheckedStatement]) -> Option[Checked.CheckedWhile]:
	var found: Option[Checked.CheckedWhile] = None
	for statement in statements:
		match statement:
			Checked.RunWhile(loop):
				found = Some(loop)
				break
			_: void
	found


private pure func nested_carried_bindings() -> Option[Bool]:
	accepted ?= Input.checked(Nested.MANY_ITERATIONS).to_option()
	contents = checked_functions(accepted)
	function ?= contents.functions.get(function_number(entry_function(contents.entrypoint)))
	outer ?= first_loop(function.statements)
	inner ?= first_loop(outer.body)
	outer_cursor ?= outer.carried.get(0)
	outer_total ?= outer.carried.get(1)
	inner_total ?= inner.carried.get(0)
	inner_cursor ?= inner.carried.get(1)
	Some(outer.carried.length() == 2 and inner.carried.length() == 2
		and Checked.binding_number(outer_cursor) == 0
		and Checked.binding_number(outer_total) == 1
		and Checked.binding_number(inner_total) == 1
		and Checked.binding_number(inner_cursor) == 2)


pure func test_inner_writes_reach_outer_scope_without_carrying_inner_local() -> Bool:
	nested_carried_bindings().get_or(False)


pure func test_nested_final_false_condition_write_is_checked() -> Bool:
	Input.checked(Nested.FINAL_FALSE_WRITES).is_ok()


private pure func nested_span(source: String, following: String) -> Option[Bool]:
	indent ?= source.index_of("        while ")
	end ?= source.index_of(following)
	accepted ?= Input.checked(source).to_option()
	contents = checked_functions(accepted)
	function ?= contents.functions.get(function_number(entry_function(contents.entrypoint)))
	outer ?= first_loop(function.statements)
	inner ?= first_loop(outer.body)
	Some(same_span(inner.span, { source = module_source(root_module_id()), start = indent + 8, end = end }))


pure func test_nested_many_retains_complete_inner_statement_span() -> Bool:
	nested_span(Nested.MANY_ITERATIONS, "\n        outer =").get_or(False)


pure func test_nested_condition_retains_complete_inner_statement_span() -> Bool:
	nested_span(Nested.FINAL_FALSE_WRITES, "\n        outer =").get_or(False)


tests: TestSuite = {
	description = "Blorp 2 nested scalar while checking",
	tests = [
		("inner writes reach outer scope without inner local carrier", test_inner_writes_reach_outer_scope_without_carrying_inner_local),
		("nested final False condition write is checked", test_nested_final_false_condition_write_is_checked),
		("nested many retains complete inner statement span", test_nested_many_retains_complete_inner_statement_span),
		("nested condition retains complete inner statement span", test_nested_condition_retains_complete_inner_statement_span),
	]
}
