pure func test_ufcs_tail_call_preserves_a_local_receiver_identity() -> Bool:
	source: String =
		|@tail_recursive func loop(value: Int) -> Int:
		|	receiver = value
		|	receiver.loop()
		|
	match checked(source + MAIN):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match (function.execution, function.statements, function.body):
						(SelfTailLoop(_), [Check.InitializeBinding(local, initializer)], Check.CheckedValueBody(Check.RecurWith([receiver], _))):
							match (initializer.form, receiver.form):
								(Check.ReadBinding(parameter), Check.ReadBinding(argument)):
									Check.binding_number(parameter) == 0 and Check.binding_number(local) == 1 and Check.binding_number(argument) == Check.binding_number(local)
								_: False
						_: False
				_: False


pure func test_unannotated_recursion_stays_ordinary() -> Bool:
	source: String =
		|func main() -> Int:
		|	main()
		|

	match checked(source):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[function]:
					match function.execution:
						OrdinaryCalls:
							match function.body:
								Check.CheckedValueBody(Check.ReturnExpression(value)):
									match value.form:
										Check.InvokeFunction(operand_call_1):
											match operand_call_1.operands:
												[]:
													True
												_: False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


