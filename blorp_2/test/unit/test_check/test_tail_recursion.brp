		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					match check_errors(failure).first.kind:
						Errors.CallRejection(Errors.ArgumentTypeMismatch(_)):
							True
						_:
							False


