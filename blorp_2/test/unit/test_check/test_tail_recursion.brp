import:
	../../../src/utils/names: program_names, same_name
	../../../src/utils/ids as Declaration
	../../../src/utils/source: module_source, root_module_id
	../../../src/check/check: CheckedProgram, check_errors, checked_functions
	../../../src/check/errors as Errors
	../../../src/check/model as Check
	../../../src/check/render: render_failure
	../../../src/namespace/namespace: ValueBinding(FunctionName)
	../../../src/parse/assemble: parsed_contents
	../../../src/lex/lex: lex
	../../../src/utils/syntax: Diagnostic, DiagnosticNote(PreviousDeclaration), FunctionExecution(SelfTailLoop, OrdinaryCalls), same_span
	../input: check, parse, setup_diagnostic, existing_name
	../module_input: primitive_base, INTEGER_OPERATIONS, parse_modules_with_base
	test: TestSuite


private STEP: String =
	|union Step:
	|	Stop
	|	Once
	|

private MAIN: String =
	|func main() -> Int:
	|	0
	|


private pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	check(parsed).map_err(setup_diagnostic)


private pure func accepts(source: String) -> Bool:
	match checked(source):
		Ok(_):
			True
		Err(_):
			False


private pure func rejects_non_tail(source: String, start: Int, end: Int) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					error = check_errors(failure).first
					diagnostic = render_failure(failure).first

					match error.kind:
						Errors.RecursionRejection(Errors.NonTailSelfCall(id)):
							(
								Declaration.function_number(id) == 0
								and error.span.start == start
								and error.span.end == end
								and same_span(diagnostic.span, error.span)
								and diagnostic.message == "recursive call is not in tail position"
								and diagnostic.help == "return this call directly, or remove @tail_recursive"
								and diagnostic.note.is_none()
							)
						_:
							False


private pure func rejects_annotation(source: String, generic: Bool) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					error = check_errors(failure).first
					diagnostic = render_failure(failure).first

					kind_valid = match error.kind:
						Errors.RecursionRejection(Errors.GenericTailRecursionUnsupported):
							(
								generic
								and diagnostic.message == "generic @tail_recursive functions are not supported yet"
								and diagnostic.help == "use a nongeneric helper, or remove @tail_recursive"
							)
						Errors.RecursionRejection(Errors.NoSelfRecursion):
							(
								not generic
								and diagnostic.message == "@tail_recursive function has no direct self call"
								and diagnostic.help == "remove @tail_recursive; mutual recursion is not covered by this annotation"
							)
						_:
							False

					(
						kind_valid
						and error.span.start == 0
						and error.span.end == 15
						and same_span(diagnostic.span, error.span)
						and diagnostic.note.is_none()
					)


pure func test_direct_terminal_is_explicit() -> Bool:
	source: String =
		|@tail_recursive pure func loop(value: Int) -> Int:
		|	loop(value)
		|func main() -> Int:
		|	0
		|

	match checked(source):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match function.execution:
						SelfTailLoop(annotation):
							match function.body:
								Check.CheckedValueBody(Check.RecurWith([argument], span)):
									match argument.form:
										Check.ReadBinding(id):
											(
												annotation.start == 0
												and annotation.end == 15
												and Check.binding_number(id) == 0
												and span.start == 52
												and span.end == 63
												and Check
													.function_calls(function)
													.length() == 0
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_ufcs_terminal_preserves_receiver() -> Bool:
	source: String =
		|@tail_recursive pure func loop(value: Int) -> Int:
		|	value.loop()
		|func main() -> Int:
		|	0
		|

	match checked(source):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[function, _]:
					match function.body:
						Check.CheckedValueBody(Check.RecurWith([receiver], span)):
							match receiver.form:
								Check.ReadBinding(id):
									(
										Check.binding_number(id) == 0
										and span.start == 52
										and span.end == 64
									)
								_:
									False
						_:
							False
				_:
					False


