pure func test_ordinary_arity_error_precedes_annotation() -> Bool:
	source: String =
		|@tail_recursive pure func loop(value: Int) -> Int:
		|	loop()
		|func main() -> Int:
		|	0
		|

	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					match check_errors(failure).first.kind:
						Errors.CallRejection(Errors.ArgumentCountMismatch(_)):
							True
						_:
							False


