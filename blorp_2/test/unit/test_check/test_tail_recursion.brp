-- Several non-tail self calls in one value are reported in evaluation order: a
-- call's arguments, receiver first, before the call. A direct call therefore
-- reports its nested argument call, and a receiver chain its base call.
pure func test_nested_direct_self_call_in_initializer_reports_the_inner_call() -> Bool:
	source: String =
		|@tail_recursive pure func loop(value: Int) -> Int:
		|	unused = loop(loop(value))
		|	loop(value)
		|func main() -> Int:
		|	0
		|
	rejects_non_tail(source, 66, 77)


pure func test_self_call_in_a_ufcs_argument_reports_the_argument_call() -> Bool:
	source: String =
		|@tail_recursive pure func loop(left: Int, right: Int) -> Int:
		|	unused = left.loop(loop(left, right))
		|	loop(left, right)
		|func main() -> Int:
		|	0
		|
	rejects_non_tail(source, 82, 99)


