import:
	../../../src/check/errors: CheckErrorKind(TypeTermRejection), TypeTermError(UnknownType)
	../input: rejects_at
	test: TestSuite


pure func test_wrong_return_type_diagnostic() -> Bool:
	source: String =
		|func main() -> Foo:
		|	0
		|
	rejects_at(source, 15, 18, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			TypeTermRejection(UnknownType(_)):
				True
			_:
				False
	)


pure func test_unknown_helper_return_type_diagnostic() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|func one() -> Nope:
		|	1
		|
	rejects_at(source, 37, 41, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			TypeTermRejection(UnknownType(_)):
				True
			_:
				False
	)


pure func test_unknown_parameter_type_diagnostic() -> Bool:
	source: String =
		|func identity(value: Nope) -> Int:
		|	value
		|func main() -> Int:
		|	identity(1)
		|
	rejects_at(source, 21, 25, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			TypeTermRejection(UnknownType(_)):
				True
			_:
				False
	)


tests: TestSuite = {
	description = "Blorp 2 written type resolution",
	tests = [
		("unknown parameter type diagnostic", test_unknown_parameter_type_diagnostic),
		("unknown helper return type diagnostic", test_unknown_helper_return_type_diagnostic),
		("wrong return type diagnostic", test_wrong_return_type_diagnostic),
	]
}
