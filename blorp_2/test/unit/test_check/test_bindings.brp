private pure func arm_definitions_result() -> Result[Bool, Diagnostic]:
	first_prefix = ARM_PREFIX + "\t\tEmpty:\n\t\t\tvar "
	second_prefix = first_prefix + "local = 0\n\t\t\tlocal\n\t\tNumber(payload):\n\t\t\tvar "
	lexed ?= lex(
		module_source(root_module_id()),
		second_prefix + "local = payload\n\t\t\tlocal = 42\n\t\t\tlocal\nfunc main() -> Int:\n\tinspect(Number(7))\n",
		program_names().names,
	)
	parsed ?= parse(lexed)
	program ?= check(parsed).map_err(setup_diagnostic)
	Ok(
		match checked_functions(program).functions:
			[inspect, _]:
				match inspect.bindings:
					[parameter, first, capture, second]:
						match checked_tail_join(inspect.body):
							Some(matched):
								match matched.arms:
									[first_arm, second_arm]:
										match first_arm.statements:
											[InitializeBinding(first_id, _)]:
												match second_arm.statements:
													[InitializeBinding(second_id, initializer), ReassignBinding(reassigned, _)]:
														match initializer.form:
															ReadBinding(captured):
																(
																	same_origin(
																		parameter.origin,
																		ParameterBinding(0),
																	)
																	and same_origin(
																		first.origin,
																		BodyLocal,
																	)
																	and same_origin(
																		second.origin,
																		BodyLocal,
																	)
																	and first.mutable == True
																	and second.mutable == True
																	and same_origin(
																		capture.origin,
																		MatchCapture,
																	)
																	and capture.mutable == False
																	and same_type(
																		capture.value_type,
																		IntType,
																	)
																	and binding_number(
																		first_id,
																	) == 1
																	and binding_number(
																		captured,
																	) == 2
																	and binding_number(
																		second_id,
																	) == 3
																	and binding_number(
																		reassigned,
																	) == 3
																	and first.span.start == first_prefix.length()
																	and first.span.end == first_prefix.length() + 5
																	and second.span.start == second_prefix.length()
																	and second.span.end == second_prefix.length() + 5
																)
															_:
																False
													_:
														False
											_:
												False
									_:
										False
							_:
								False
					_:
						False
			_:
				False
	)


pure func test_arm_definitions_have_function_owned_ids_and_exact_facts() -> Bool:
	arm_definitions_result().get_or(False)


tests: TestSuite = {
	description = "Blorp 2 scalar binding checks",
	tests = [
		(
			"arm definitions have function ids and exact facts",
			test_arm_definitions_have_function_owned_ids_and_exact_facts,
		),
		(
			"arm final value matches function return type",
			test_arm_final_value_must_match_the_function_return_type,
		),
		("arm local mutation is pure", test_arm_local_mutation_is_pure),
		(
			"arm var initializer reads the capture",
			test_arm_var_initializer_reads_the_capture,
		),
		("arm var initializer reads enclosing body local", test_arm_var_initializer_reads_an_enclosing_body_local),
		(
			"sibling arms may declare same local name",
			test_sibling_arms_can_declare_the_same_local_name,
		),
		("arm local cannot escape to sibling", test_arm_local_does_not_escape_to_a_sibling),
		("arm capture assignment rejected", test_arm_capture_assignment_is_rejected),
		(
			"arm immutable local assignment rejected",
			test_arm_immutable_local_assignment_is_rejected,
		),
		(
			"arm duplicate mutable declaration rejected",
			test_arm_duplicate_mutable_declaration_is_rejected,
		),
		("arm self initializer is not visible", test_arm_self_initializer_is_not_visible),
		(
			"arm reassignment keeps established type",
			test_arm_reassignment_keeps_its_established_type,
		),
		(
			"unused unselected arm impure initializer rejected",
			test_unused_unselected_arm_impure_initializer_is_rejected,
		),
		(
			"unused unselected arm recursive initializer checked",
			test_unused_unselected_arm_recursive_initializer_is_checked,
		),
		("body local integer cannot be called with an argument", test_body_local_integer_cannot_be_called_with_an_argument),
		(
			"body local integer cannot be called without arguments",
			test_body_local_integer_cannot_be_called_without_arguments,
		),
		("body local receiver selects UFCS function", test_body_local_receiver_selects_the_ufcs_function),
		(
			"binding definitions own facts and stable ids",
			test_binding_definitions_own_origin_mutability_type_and_span,
		),
		(
			"union locals and reassignment keep established type",
			test_union_local_and_reassignment_use_the_established_type,
		),
		("reassignment rejects different type", test_reassignment_rejects_a_different_type),
		("new union local requires receiving type", test_new_union_local_requires_a_receiving_type),
		("immutable and mutable bindings", test_immutable_and_mutable_bindings),
		(
			"initializer reads previous parameter scope",
			test_initializer_reads_previous_parameter_scope,
		),
		("immutable assignment is rejected", test_immutable_assignment_is_rejected),
		(
			"duplicate mutable declaration is rejected",
			test_duplicate_mutable_declaration_is_rejected,
		),
		("unknown self initializer is rejected", test_unknown_self_initializer_is_rejected),
		("unused impure initializer is rejected", test_unused_impure_initializer_is_rejected),
		("unused recursive initializer is checked", test_unused_recursive_initializer_is_checked),
	]
}


private pure func same_origin(actual: BindingOrigin, expected: BindingOrigin) -> Bool:
	match actual:
		ParameterBinding(index):
			match expected:
				ParameterBinding(other):
					index == other
				_:
					False
		CallableParameterBinding(parameter):
			match expected:
				CallableParameterBinding(other):
					same_callable_parameter(parameter, other)
				_:
					False
		BodyLocal:
			match expected:
				BodyLocal:
					True
				_:
					False
		MatchCapture:
			match expected:
				MatchCapture:
					True
				_:
					False
