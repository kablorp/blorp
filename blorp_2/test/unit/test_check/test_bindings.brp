import:
	../../../src/utils/names: program_names
	../../../src/check/check: check_errors, checked_functions
	../../../src/check/errors:
		CheckErrorKind(CallRejection, ConstructorRejection, StatementRejection, ValueRejection, BindingRejection),
		ConstructorError(ConstructorNeedsExpectedType),
		BindingError(LocalBindingConflict),
		StatementError(ImmutableAssignment),
		ValueError(ExpressionTypeMismatch, UnknownValue),
		CallError(ImpureCall, UncallableBinding),
	../../../src/check/model:
		BindingOrigin(ParameterBinding, CallableParameterBinding, BodyLocal, MatchCapture),
		CheckedForm(ReadBinding),
		CheckedStatement(InitializeBinding, ReassignBinding),
		TypeRef(IntType),
		binding_number,
		same_type,
		same_callable_parameter,
	../../../src/lex/lex: lex
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: Diagnostic
	../input: check, check_failure, parse, setup_diagnostic, singleton_check_error, checked_tail_join
	result: get_or
	test: TestSuite


private pure func accepts(source: String) -> Bool:
	match checked(source):
		Ok(_):
			True
		Err(_):
			False


private pure func checked(source: String) -> Result[Void, Diagnostic]:
	lexed ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(lexed)
	accepted ?= check(parsed).map_err(setup_diagnostic)
	Ok(void)


private pure func rejects(
	body: String,
	start: Int,
	end: Int,
	matches: pure (CheckErrorKind) -> Bool,
) -> Bool:
	prefix = "func main() -> Int:\n\t"

	match check_failure(prefix + body):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length() + start
				and error.span.end == prefix.length() + end
				and matches(error.kind)
			)


pure func test_immutable_and_mutable_bindings() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func preserve() -> Int:
		|	original = 1
		|	var current = original
		|	current = identity(42)
		|	original
		|func main() -> Int:
		|	preserve()
		|
	accepts(source)


pure func test_initializer_reads_previous_parameter_scope() -> Bool:
	source: String =
		|pure func preserve(input: Int) -> Int:
		|	var value = input
		|	value = value
		|	value
		|func main() -> Int:
		|	preserve(42)
		|
	accepts(source)


pure func test_immutable_assignment_is_rejected() -> Bool:
	body: String =
		|value = 1
		|	value = 2
		|	value
		|
	rejects(body, 11, 16, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			StatementRejection(ImmutableAssignment(_)):
				True
			_:
				False
	)


pure func test_duplicate_mutable_declaration_is_rejected() -> Bool:
	body: String =
		|var value = 1
		|	var value = 2
		|	value
		|
	rejects(body, 19, 24, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			BindingRejection(LocalBindingConflict(_, _)):
				True
			_:
				False
	)


pure func test_unknown_self_initializer_is_rejected() -> Bool:
	body: String =
		|value = value
		|	value
		|
	rejects(body, 8, 13, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ValueRejection(UnknownValue(_)):
				True
			_:
				False
	)


pure func test_unused_impure_initializer_is_rejected() -> Bool:
	source: String =
		|func effect() -> Int:
		|	1
		|pure func main() -> Int:
		|	unused = effect()
		|	0
		|

	match check_failure(source):
		None:
			False
		Some(error):
			(
				match error.kind:
					CallRejection(ImpureCall(_, _)):
						True
					_:
						False
				and error.span.start == 60
				and error.span.end == 66
			)


pure func test_unused_recursive_initializer_is_checked() -> Bool:
	source: String =
		|func main() -> Int:
		|	unused = main()
		|	0
		|
	accepts(source)


private pure func test_binding_definitions_own_origin_mutability_type_and_span_result(

) -> Result[Bool, Diagnostic]:
	source: String =
		|pure func copy(input: Int) -> Int:
		|	var value = input
		|	old = value
		|	value = 42
		|	old
		|func main() -> Int:
		|	copy(1)
		|
	lexed ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(lexed)
	program ?= check(parsed).map_err(setup_diagnostic)
	Ok(
		match checked_functions(program).functions:
			[copy, _]:
				match copy.bindings:
					[parameter, mutable, old]:
						match copy.statements:
							[InitializeBinding(current_id, current), InitializeBinding(old_id, previous_value), ReassignBinding(reassigned, _)]:
								match current.form:
									ReadBinding(parameter_id):
										match previous_value.form:
											ReadBinding(alias_id):
												(
													same_origin(
														parameter.origin,
														ParameterBinding(0),
													)
													and parameter.mutable == False
													and parameter.span.start == 15
													and parameter.span.end == 20
													and same_origin(mutable.origin, BodyLocal)
													and mutable.mutable == True
													and mutable.span.start == 40
													and mutable.span.end == 45
													and same_origin(old.origin, BodyLocal)
													and old.mutable == False
													and same_type(old.value_type, IntType)
													and binding_number(parameter_id) == 0
													and binding_number(current_id) == 1
													and binding_number(old_id) == 2
													and binding_number(alias_id) == 1
													and binding_number(reassigned) == 1
													and same_type(current.value_type, IntType)
												)
											_:
												False
									_:
										False
							_:
								False
					_:
						False
			_:
				False
	)


pure func test_union_local_and_reassignment_use_the_established_type() -> Bool:
	source: String =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|pure func number() -> Value:
		|	Number(1)
		|pure func copy(value: Value) -> Value:
		|	var current = value
		|	old = current
		|	current = Number(42)
		|	old
		|func main() -> Int:
		|	0
		|
	accepts(source)


private pure func test_reassignment_rejects_a_different_type_result() -> Result[Bool, Diagnostic]:
	prefix =
		|fixed union Value:
		|	Empty
		|pure func value() -> Value:
		|	Empty
		|func main() -> Int:
		|	var current = value()
		|	current = 1
		|	0
		|
	lexed ?= lex(module_source(root_module_id()), prefix, program_names().names)
	parsed ?= parse(lexed)
	Ok(
		match check(parsed):
			Ok(_):
				False
			Err(failure):
				match singleton_check_error(check_errors(failure)):
					None:
						False
					Some(error):
						(
							match error.kind:
								ValueRejection(ExpressionTypeMismatch(_)):
									True
								_:
									False
							and error.span.start == 115
							and error.span.end == 116
						)
	)


private pure func test_new_union_local_requires_a_receiving_type_result(

) -> Result[Bool, Diagnostic]:
	source: String =
		|fixed union Value:
		|	Empty
		|func main() -> Int:
		|	value = Empty
		|	0
		|
	lexed ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(lexed)
	Ok(
		match check(parsed):
			Ok(_):
				False
			Err(failure):
				match singleton_check_error(check_errors(failure)):
					None:
						False
					Some(error):
						(
							match error.kind:
								ConstructorRejection(ConstructorNeedsExpectedType(_)):
									True
								_:
									False
							and error.span.start == 55
							and error.span.end == 60
						)
	)


pure func test_binding_definitions_own_origin_mutability_type_and_span() -> Bool:
	test_binding_definitions_own_origin_mutability_type_and_span_result().get_or(False)


pure func test_reassignment_rejects_a_different_type() -> Bool:
	test_reassignment_rejects_a_different_type_result().get_or(False)


pure func test_new_union_local_requires_a_receiving_type() -> Bool:
	test_new_union_local_requires_a_receiving_type_result().get_or(False)


