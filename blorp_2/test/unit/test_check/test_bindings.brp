private ARM_PREFIX: String =
	|fixed union Value:
	|	Empty
	|	Number(Int)
	|pure func inspect(value: Value) -> Int:
	|	match value:
	|


private pure func rejects_arm(
	before: String,
	spelling: String,
	after: String,
	matches: pure (CheckErrorKind) -> Bool,
) -> Bool:
	main_source: String =
		|func main() -> Int:
		|	inspect(Number(7))
		|

	match check_failure(ARM_PREFIX + before + spelling + after + main_source):
		None:
			False
		Some(error):
			(
				error.span.start == ARM_PREFIX.length() + before.length()
				and error.span.end == ARM_PREFIX.length() + before.length() + spelling.length()
				and matches(error.kind)
			)


pure func test_arm_local_mutation_is_pure() -> Bool:
	arms: String =
		|		Empty: 0
		|		Number(payload):
		|			var current = payload
		|			original = current
		|			current = 42
		|			original
		|func main() -> Int:
		|	inspect(Number(7))
		|
	accepts(ARM_PREFIX + arms)


