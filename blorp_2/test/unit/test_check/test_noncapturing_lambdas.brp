pure func test_outer_callable_use_preserves_the_issued_capture() -> Bool:
	declarations: String =
		|pure func route(callback: pure (Int) -> Int, value: Int) -> Int:
		|
	source = APPLY + declarations + "    apply(pure func(item: Int) -> Int: callback(item), value)\nfunc main() -> Int:\n    0\n"
	match parse_modules([{ source = source, targets = [1] }, { source = INTEGER_OPERATIONS, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Err(_): False
				Ok(program):
					match checked_functions(program).lambdas:
						[row]:
							match (row.captures, row.body):
								([capture], Checked.CheckedValueBody(Checked.ReturnExpression(value))):
									match value.form:
										Checked.InvokeFunction(call):
											match (call.target, call.operands, capture.value_type.value_type):
												(Checked.ValueCall(callee), [Checked.ValueOperand(argument)], Checked.CallableType(Pure, [Checked.IntType], Checked.IntType)):
													match (callee.form, argument.form):
														(Checked.ReadCapture(id), Checked.ReadBinding(input)):
															(Checked.capture_number(id) == 0 and Checked.lambda_number(Checked.capture_owner(id)) == 0
																and Checked.binding_number(input) == 0 and Checked.binding_number(capture.binding.binding) == 0
																and Checked.same_body(capture.binding.owner, Checked.DeclaredBody(row.root))
																and Checked.same_type(callee.value_type, capture.value_type.value_type))
														_: False
												_: False
										_: False
								_: False
						_: False


pure func test_deferred_nested_and_sibling_sites_keep_reserved_ids() -> Bool:
	source: String =
		|pure func both[A, B](left: pure (A) -> B, right: pure (Int) -> Int, value: A) -> B:
		|    left(value)
		|func main() -> Int:
		|    saved = both(pure func(first): apply(pure func(inner: Int): inner, first), pure func(sibling: Int): sibling, 7)
		|    0
		|
	match parse_modules([{ source = APPLY + source, targets = [1] }, { source = INTEGER_OPERATIONS, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Err(_): False
				Ok(program):
					checked = checked_functions(program)
					match (checked.functions.get(Declaration.function_number(entry_function(checked.entrypoint))), checked.lambdas):
						(Some(main), [outer, sibling, inner]):
							match (main.statements, outer.body, sibling.body, inner.body):
								([Checked.InitializeBinding(_, call)], Checked.CheckedValueBody(Checked.ReturnExpression(nested)), Checked.CheckedValueBody(Checked.ReturnExpression(sibling_value)), Checked.CheckedValueBody(Checked.ReturnExpression(inner_value))):
									match (call.form, nested.form, sibling_value.form, inner_value.form):
										(Checked.InvokeFunction(main_call), Checked.InvokeFunction(outer_call), Checked.ReadBinding(sibling_local), Checked.ReadBinding(inner_local)):
											match (main_call.operands, outer_call.operands):
												([Checked.CallableOperand(_, first, _), Checked.CallableOperand(_, second, _), Checked.ValueOperand(_)], [Checked.CallableOperand(_, third, _), Checked.ValueOperand(argument)]):
													match (main_call.target, outer_call.target, argument.form):
														(Checked.UserFunction(_, _), Checked.UserFunction(_, _), Checked.ReadBinding(outer_local)):
															match (first, second, third):
																(Checked.LambdaCallable(first_id, []), Checked.LambdaCallable(second_id, []), Checked.LambdaCallable(third_id, [])):
																	(
																		Checked.lambda_number(first_id) == 0 and Checked.lambda_number(second_id) == 1
																		and Checked.lambda_number(third_id) == 2
																		and Checked.binding_number(outer_local) == 0 and Checked.binding_number(sibling_local) == 0
																		and Checked.binding_number(inner_local) == 0
																		and [outer, sibling, inner].all(pure func(lambda):
																			(
																				Declaration.function_number(lambda.root) == Declaration.function_number(main.id)
																				and lambda.bindings.length() == 1 and lambda.parameters.length() == 1
																				and lambda.parameters.all(pure func(parameter): Checked.same_type(parameter.value_type, Checked.IntType))
																				and Checked.same_type(lambda.return_type.value_type, Checked.IntType)
																			)
																		)
																	)
																_: False
														_: False
												_: False
										_: False
								_: False
						_: False


