import:
	../../../src/check/check: check_errors, checked_functions
	../../../src/check/model as Checked
	../../../src/utils/ids as Declaration
	../../../src/check/render: render_check_error, render_failure
	../../../src/utils/source: module_source, root_module_id, same_source, source_module, module_number
	../../../src/utils/syntax: Diagnostic, entry_function, same_span, Purity(Pure)
	../input: check, singleton_check_error
	../module_input: parse_modules, INTEGER_OPERATIONS
	test: TestSuite


private APPLY: String =
	|import:
	|    int as IntOps
	|pure func apply[T, U](f: pure (T) -> U, value: T) -> U:
	|    f(value)
	|


private BLOCK_MAIN: String =
	|func main() -> Int:
	|    apply(pure func(number: Int) -> Int:
	|        incremented = IntOps.add(number, 1)
	|        IntOps.add(incremented, 1)
	|    , 7)
	|


private pure func accepts(source: String) -> Bool:
	match parse_modules([{ source = source, targets = [1] }, { source = INTEGER_OPERATIONS, targets = [] }]):
		Err(_): False
		Ok(program): check(program).is_ok()


private pure func rejects(prefix: String, marked: String, suffix: String, message: String, help: String) -> Bool:
	match parse_modules([{ source = prefix + marked + suffix, targets = [1] }, { source = INTEGER_OPERATIONS, targets = [] }]):
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					match singleton_check_error(check_errors(failure)):
						None: False
						Some(error):
							diagnostic = render_check_error(program, error)
							(
								same_source(error.span.source, module_source(root_module_id()))
								and error.span.start == prefix.length() and error.span.end == prefix.length() + marked.length()
								and same_source(diagnostic.span.source, error.span.source)
								and diagnostic.span.start == error.span.start and diagnostic.span.end == error.span.end
								and diagnostic.message == message and diagnostic.help == help and diagnostic.note.is_none()
							)


pure func test_inline_input_is_solved_by_later_data_argument() -> Bool:
	body: String =
		|func main() -> Int:
		|    apply(pure func(number): IntOps.add(number, 1), 7)
		|
	accepts(APPLY + body)


pure func test_result_context_solves_the_only_lambda_input() -> Bool:
	source: String =
		|import:
		|    int as IntOps
		|pure func use[T](callback: pure (T) -> T) -> List[T]:
		|    []
		|func main() -> Int:
		|    items: List[Int] = use(pure func(value): value)
		|    0
		|
	accepts(source)



pure func test_nested_unresolved_input_precedes_a_later_written_sibling() -> Bool:
	declarations: String =
		|import:
		|    int as IntOps
		|pure func ignore[U](f: pure (U) -> Int) -> Int:
		|    0
		|pure func both[T](first: pure (Int) -> Int, second: pure (T) -> Int) -> Int:
		|    0
		|func main() -> Int:
		|
	rejects(
		declarations + "    both(pure func(_: Int): ignore(", "pure func(inner): 0", "), pure func(later): 0)\n",
		"cannot infer this lambda's input types", "annotate its parameters or supply a typed ordinary argument",
	)


pure func test_typed_inline_callback_changes_the_result_type() -> Bool:
	body: String =
		|pure func describe() -> String:
		|    apply(pure func(number: Int) -> String: IntOps.to_string(number), 7)
		|func main() -> Int:
		|    description = describe()
		|    0
		|
	accepts(APPLY + body)


pure func test_annotated_block_callback_checks_local_statements() -> Bool:
