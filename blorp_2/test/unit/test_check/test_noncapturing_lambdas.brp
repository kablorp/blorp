pure func test_block_without_final_result_rejects() -> Bool:
	rejects(
		APPLY + "func main() -> Int:\n    apply(pure func(item: Int) -> Int:\n        ",
		"unused = item", "\n    , 7)\n",
		"expression does not match the expected type", "use an expression of type Int here",
	)


-- These sites cross every source-loop expression boundary. The third lambda
-- owns a loop even while its enclosing declaration is checking a loop body.
private LOOP_SITES: String =
	|func main() -> Int:
	|    flag: Bool = True
	|    while match flag:
	|        True: apply(pure func(item: Int) -> Bool: False, 1)
	|        False: False
	|    :
	|        if apply(pure func(item: Int) -> Bool: True, 2):
	|            chosen = apply(pure func(item: Int) -> Int:
	|                var again: Bool = True
	|                var cursor = item
	|                while again:
	|                    cursor = IntOps.add(cursor, 1)
	|                    again = False
	|                cursor
	|            , 7)
	|


private pure func lambda_choice(value: Checked.CheckedExpr) -> Option[Int]:
	match value.form:
		Checked.InvokeFunction(call):
			match (call.target, call.operands):
				(Checked.UserFunction(_, _), [Checked.CallableOperand(_, argument, _), Checked.ValueOperand(_)]):
					match argument:
						Checked.LambdaCallable(id, []): Some(Checked.lambda_number(id))
						_: None
				_: None
		_: None


private pure func loop_sites_facts() -> Option[Bool]:
	parsed ?= parse_modules([{ source = APPLY + LOOP_SITES + "    0\n", targets = [1] }, { source = INTEGER_OPERATIONS, targets = [] }]).to_option()
	accepted ?= check(parsed).to_option()
	contents = checked_functions(accepted)
	main ?= contents.functions.get(Declaration.function_number(entry_function(contents.entrypoint)))
	match (main.statements, contents.lambdas):
		([Checked.InitializeBinding(_, _), Checked.RunWhile(loop)], [condition, branch, child]):
			match (loop.condition.form, loop.body, child.statements):
				(Checked.Match(matched), [Checked.DiscardExpression(selected)], [Checked.InitializeBinding(_, _), Checked.InitializeBinding(_, _), Checked.RunWhile(inner)]):
					match selected.form:
						Checked.Match(join):
							match (matched.arms.get(0), join.arms.get(0)):
								(Some(condition_arm), Some(then_arm)):
									match then_arm.statements:
										[Checked.InitializeBinding(_, call)]:
											Some(lambda_choice(condition_arm.value) == Some(0)
												and lambda_choice(join.scrutinee) == Some(1) and lambda_choice(call) == Some(2)
												and inner.carried.map(Checked.binding_number) == [1, 2]
												and child.bindings.length() == 3 and child.parameters.length() == 1
												and [condition, branch, child].all(pure func(row):
													Declaration.function_number(row.root) == Declaration.function_number(main.id)
												))
										_: None
								_: None
						_: None
				_: None
		_: None


pure func test_loop_boundaries_preserve_lambda_rows_and_local_loop_scope() -> Bool:
	loop_sites_facts().get_or(False)


private pure func parent_loop_after_lambda() -> Option[Bool]:
	prefix = APPLY + LOOP_SITES + "        "
	nested = "while False:\n            unused = 0"
	control_prefix = prefix + nested + "\n        "
	source = control_prefix + "continue\n    0\n"
	parsed ?= parse_modules([{ source = source, targets = [1] }, { source = INTEGER_OPERATIONS, targets = [] }]).to_option()
	accepted ?= check(parsed).to_option()
	contents = checked_functions(accepted)
	main ?= contents.functions.get(Declaration.function_number(entry_function(contents.entrypoint)))
	outer_start ?= source.index_of("while match flag:")
	match (main.statements, contents.lambdas):
		([Checked.InitializeBinding(_, _), Checked.RunWhile(outer)], [condition, branch, child]):
			match outer.body:
				[Checked.DiscardExpression(selected), Checked.RunWhile(inner), Checked.ContinueSourceLoop(span)]:
					condition_id ?= match outer.condition.form:
						Checked.Match(join): join.arms.get(0).and_then(pure func(arm): lambda_choice(arm.value))
						_: None
					branch_id ?= match selected.form:
						Checked.Match(join): lambda_choice(join.scrutinee)
						_: None
					child_id ?= match selected.form:
						Checked.Match(join):
							match join.arms.get(0).map(pure func(arm): arm.statements):
								Some([Checked.InitializeBinding(_, call)]): lambda_choice(call)
								_: None
						_: None
					child_loop ?= match child.statements:
						[Checked.InitializeBinding(_, _), Checked.InitializeBinding(_, _), Checked.RunWhile(loop)]: Some(loop)
						_: None
					Some(condition_id == 0 and branch_id == 1 and child_id == 2
						and child.bindings.length() == 3 and child.parameters.length() == 1
						and child_loop.carried.map(Checked.binding_number) == [1, 2]
						and outer.carried.is_empty() and inner.carried.is_empty()
						and inner.body.length() == 1
						and same_span(inner.span, { source = module_source(root_module_id()), start = prefix.length(), end = prefix.length() + nested.length() })
						and same_span(span, { source = module_source(root_module_id()), start = control_prefix.length(), end = control_prefix.length() + "continue".length() })
						and same_span(outer.span, { source = module_source(root_module_id()), start = outer_start, end = span.end })
						and [condition, branch, child].all(pure func(row):
							Declaration.function_number(row.root) == Declaration.function_number(main.id)
						))
				_: None
		_: None


pure func test_lambda_completion_restores_the_parent_loop_scope() -> Bool:
	parent_loop_after_lambda().get_or(False)


pure func test_result_rhs_and_suffix_keep_distinct_root_owned_lambda_rows() -> Bool:
	source: String =
		|pure func wrap[T](value: T) -> Result[T, String]:
		|    Ok(value)
		|pure func route[T](value: T) -> Result[T, String]:
		|    item ?= wrap(apply(pure func(first: T) -> T: first, value))
		|    Ok(apply(pure func(second: T) -> T: second, item))
		|func main() -> Int:
		|    saved = route(7)
		|    0
		|
	match parse_modules([{ source = APPLY + source, targets = [1] }, { source = INTEGER_OPERATIONS, targets = [] }]).map(check):
		Ok(Ok(program)):
			contents = checked_functions(program)
			match contents.lambdas:
				[first, second]:
					calls = contents.functions.get(Declaration.function_number(first.root)).map(Checked.function_calls).get_or([])
					choices = calls.map(pure func(call):
						match (call.target, call.operands):
							(Checked.UserFunction(_, _), [Checked.CallableOperand(_, argument, _), Checked.ValueOperand(_)]):
								match argument:
									Checked.LambdaCallable(id, []): Some(Checked.lambda_number(id))
									_: None
							_: None
					)
					(
						choices == [Some(0), None, Some(1)]
							and Declaration.function_number(first.root) == Declaration.function_number(second.root)
							and [first, second].all(pure func(row):
								match row.parameters:
									[parameter]:
										match parameter.value_type:
											Checked.ParameterType(id):
												match Checked.parameter_owner(id):
													Checked.FunctionDeclaration(owner): Declaration.function_number(owner) == Declaration.function_number(row.root)
													_: False
											_: False
									_: False
							)
					)
				_: False
		_: False


tests: TestSuite = {
	description = "Lambda scopes, callable captures and generic calls",
	tests = [
		("loop boundaries retain lambda IDs and lambda-local scope", test_loop_boundaries_preserve_lambda_rows_and_local_loop_scope),
		("lambda completion restores the enclosing loop scope", test_lambda_completion_restores_the_parent_loop_scope),
		("Result RHS and suffix retain root-owned lambda rows", test_result_rhs_and_suffix_keep_distinct_root_owned_lambda_rows),
		("annotated block cannot return only a statement", test_block_without_final_result_rejects),
		("written Result lambda annotation completes partial context", test_written_result_lambda_annotation_supplies_complete_context),
		("written Bool lambda result admits a mutable local block", test_written_bool_lambda_annotation_admits_block),
		("caller Bool annotation solves generic block result", test_complete_caller_bool_context_admits_block),
		("complete callable Bool result admits a block", test_complete_callback_bool_context_admits_block),
		("nested completion preserves reserved sibling lambda IDs", test_deferred_nested_and_sibling_sites_keep_reserved_ids),
		("lambda captures an enclosing callable parameter by issued ID", test_outer_callable_use_preserves_the_issued_capture),
		("lambda rejects a mutable outer read", test_mutable_outer_read_is_rejected),
		("immutable outer read is captured by value", test_immutable_outer_read_is_accepted),
		("block lambda rejects partial Result context", test_block_lambda_needs_complete_result_result),
		("block lambda rejects partial Option result context", test_block_lambda_needs_complete_option_result),
		("block lambda cannot infer an unknown result from its body", test_block_lambda_needs_unknown_result),
		("lambda arity rejects an extra parameter", test_lambda_rejects_extra_parameter),
		("lambda arity rejects a missing parameter", test_lambda_rejects_missing_parameter),
		("inline input is solved by later data argument", test_inline_input_is_solved_by_later_data_argument),
		("result context solves the only lambda input", test_result_context_solves_the_only_lambda_input),
		("nested unresolved input precedes a later written sibling", test_nested_unresolved_input_precedes_a_later_written_sibling),
		("typed inline callback changes the result type", test_typed_inline_callback_changes_the_result_type),
		("annotated block callback checks local statements", test_annotated_block_callback_checks_local_statements),
		("block callback before data has accepted layout", test_block_callback_before_data_has_accepted_layout),
		("inline callback after data uses the same generic contract", test_inline_callback_after_data_uses_the_same_generic_contract),
		("pure lambda in impure root rejects an impure call", test_pure_lambda_in_impure_root_rejects_an_impure_call),
		("outer mutable assignment is a capture before its RHS", test_outer_mutable_assignment_is_a_capture_before_its_rhs),
		("impure named callback still rejects", test_impure_named_callback_still_rejects),
		("callable return resolves unknown child before body", test_callable_return_resolves_unknown_child_before_body),
		("explicit nominal lambda result supplies record context", test_explicit_nominal_lambda_result_supplies_record_context),
	]
