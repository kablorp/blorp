pure func test_pure_lambda_in_impure_root_rejects_an_impure_call() -> Bool:
	declarations: String =
		|func effect() -> Int:
		|    1
		|func main() -> Int:
		|
	rejects(
		APPLY + declarations + "    apply(pure func(_: Int) -> Int: ", "effect", "(), 7)\n",
		"pure functions cannot call impure functions",
		"mark the callee pure or remove pure from the caller",
	)


pure func test_outer_mutable_assignment_is_a_capture_before_its_rhs() -> Bool:
	declarations: String =
		|func main() -> Int:
		|    var counter = 0
		|
	rejects(
		APPLY + declarations + "    apply(pure func(_: Int) -> Int:\n        ", "counter", " = missing\n        1\n    , 7)\n",
		"lambda cannot assign to an outer binding", "mutate a lambda-local variable or return the updated value explicitly",
	)



pure func test_impure_named_callback_still_rejects() -> Bool:
	declarations: String =
		|func effect(number: Int) -> Int:
		|    number
		|func main() -> Int:
		|
	rejects(
		APPLY + declarations + "    apply(", "effect", ", 7)\n",
		"pure callback requires a pure function",
		"pass a pure named function; impure functions cannot satisfy a pure callable parameter",
	)


pure func test_callable_return_resolves_unknown_child_before_body() -> Bool:
	rejects(
		APPLY + "func make() -> pure (", "Missing", ") -> Absent:\n    0\nfunc main() -> Int:\n    0\n",
		"unknown type",
		"declare or import this type; builtin types and declared type parameters are also available",
	)


private pure func nominal_lambda_facts(checked: Checked.CheckedFunctions) -> Bool:
	match (checked.records, checked.functions, checked.lambdas):
		([declaration], [_, main], [lambda]):
			match (lambda.parameters, lambda.return_type.value_type, lambda.body):
				([input], Checked.RecordType(result), Checked.CheckedValueBody(Checked.ReturnExpression(value))):
					match (value.value_type, value.form):
						(Checked.RecordType(expression), Checked.ConstructRecord(owner, [field])):
							match field.value.form:
								Checked.ReadBinding(local):
									(
										Declaration.function_number(lambda.root) == Declaration.function_number(main.id)
										and Checked.same_type(input.value_type, Checked.IntType)
										and Declaration.record_number(result) == Declaration.record_number(declaration.id)
										and Declaration.record_number(expression) == Declaration.record_number(declaration.id)
										and Declaration.record_number(owner) == Declaration.record_number(declaration.id)
										and Declaration.record_number(Checked.field_owner(field.field)) == Declaration.record_number(declaration.id)
										and Checked.field_number(field.field) == 0 and Checked.binding_number(local) == 0
										and Checked.same_type(field.value.value_type, Checked.IntType)
										and lambda.bindings.length() == 1
									)
								_: False
						_: False
				_: False
		_: False


private func report_nominal_diagnostic(diagnostic: Diagnostic) -> Void:
	source_label = match source_module(diagnostic.span.source):
		Some(module): "module ".append_int(module_number(module))
		None: "compiler"
	print("  message: " + diagnostic.message)
	print("  help: " + diagnostic.help)
	print(("  span: " + source_label + " [").append_int(diagnostic.span.start)
		+ ", ".append_int(diagnostic.span.end) + ")")


func test_explicit_nominal_lambda_result_supplies_record_context() -> Bool:
	source: String =
		|fixed record Token { value: Int }
		|pure func apply[T, U](callback: pure (T) -> U, value: T) -> U:
		|    callback(value)
		|func main() -> Int:
		|    token = apply(pure func(item: Int) -> Token: { value = item }, 7)
		|    0
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(diagnostic):
			report_nominal_diagnostic(diagnostic)
			False
		Ok(parsed):
			match check(parsed):
				Err(failure):
					rendered = render_failure(failure)
					report_nominal_diagnostic(rendered.first)
					for diagnostic in rendered.remaining:
						report_nominal_diagnostic(diagnostic)
					False
				Ok(program): nominal_lambda_facts(checked_functions(program))


