import:
	../../../src/check/check: check, checked_functions, check_errors
	../../../src/check/model as Model
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_records, inventory_traits, TraitMethodId
	../../../src/namespace/namespace: TypeHead(RecordHead, ListHead), same_head
	../../../src/check/errors as Errors
	../../../src/check/render: render_failure
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: same_span
	../module_input: parse_modules_with_base, test_base
	test: TestSuite


private VISIT: String =
	|trait Visit:
	|    pure func visit(value: Self) -> Int
	|implements Visit for Int:
	|    pure func visit(value: Self) -> Int:
	|        0
	|

private MAIN: String =
	|func main() -> Int:
	|    0
	|


private pure func accepts(source: String) -> Bool:
	match parse_modules_with_base([{ source = source, targets = [] }], test_base()):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Err(_): False
				Ok(_): True


-- Every rejection pins the actual source call selected by the sufficient proof,
-- independently of the exact type/namespace identities issued for this fixture.
private pure func rejects_unproven(prefix: String, call: String, suffix: String) -> Bool:
	match parse_modules_with_base([{ source = prefix + call + suffix, targets = [] }], test_base()):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					errors = check_errors(failure)
					diagnostics = render_failure(failure)
					error = errors.first
					diagnostic = diagnostics.first
					match error.kind:
						Errors.RecursionRejection(Errors.UnprovenTraitInstantiation):
							(
								errors.remaining.is_empty()
								and diagnostics.remaining.is_empty()
								and error.span.source == module_source(root_module_id())
								and error.span.start == prefix.length()
								and error.span.end == prefix.length() + call.length()
								and same_span(error.span, diagnostic.span)
								and diagnostic.message == "cannot prove finite generic trait instantiation"
								and diagnostic.help == "avoid recursively wrapping generic receivers through trait dispatch; this increment uses a conservative constructor-path proof"
								and diagnostic.note.is_none()
							)
						_: False


pure func test_list_relay_preserves_a_finite_semantic_key_cycle() -> Bool:
	source: String =
		|implements Visit for List[Element: Visit]:
		|    pure func visit(value: Self) -> Int:
		|        relay(value)
		|pure func relay[Value: Visit](value: Value) -> Int:
		|    visit(value)
		|
	accepts(VISIT + source + MAIN)


pure func test_list_relay_wrapping_the_whole_receiver_cannot_prove_finite() -> Bool:
	family: String =
		|implements Visit for List[Element: Visit]:
		|    pure func visit(value: Self) -> Int:
		|        relay([value])
		|pure func relay[Value: Visit](value: Value) -> Int:
		|
	prefix = VISIT + family + "    "
	rejects_unproven(prefix, "visit", "(value)\n" + MAIN)


pure func test_tree_and_list_dispatch_have_a_finite_generic_family() -> Bool:
	source: String =
		|union Tree:
		|    Leaf(Int)
		|    Branch(List[Tree])
		|implements Visit for List[Element: Visit]:
		|    pure func visit(value: Self) -> Int:
		|        match value:
		|            []: 0
		|            [head, ..._]: visit(head)
		|implements Visit for Tree:
		|    pure func visit(value: Self) -> Int:
		|        match value:
		|            Leaf(item): visit(item)
		|            Branch(children): visit(children)
		|
	accepts(VISIT + source + MAIN)


pure func test_mutual_aggregates_through_lists_have_finite_dispatch() -> Bool:
	source: String =
		|record Left { children: List[Right] }
		|union Right:
		|    Empty
		|    Back(List[Left])
		|implements Visit for List[Element: Visit]:
		|    pure func visit(value: Self) -> Int:
		|        match value:
		|            []: 0
		|            [head, ..._]: visit(head)
		|implements Visit for Left:
		|    pure func visit(value: Self) -> Int:
		|        visit(value.children)
		|implements Visit for Right:
		|    pure func visit(value: Self) -> Int:
		|        match value:
		|            Empty: 0
		|            Back(children): visit(children)
		|
	accepts(VISIT + source + MAIN)


-- Read the real accepted family mapping independently of function order or IDs.
private pure func selects_authored_family(
	checked: Model.CheckedFunctions, method: TraitMethodId,
	receiver: Model.TypeRef, head: TypeHead, arguments: List[Model.TypeRef],
) -> Bool:
	var found = False
	for family in Model.implementation_rows(checked.traits.implementations):
		if same_head(family.receiver_head, head):
			for member in family.methods:
				if member.method == method:
					match (member.body, Model.method_body(checked.traits, Model.accepted_method(method, receiver))):
						(Model.AuthoredMethod(function), Some(selected)):
							found = selected.body == Model.DeclaredBody(function) and selected.arguments == arguments
						_: void
	found


-- Matching constructor paths distinguish the actual Wrap receiver from Box.
pure func test_finite_box_to_wrap_selects_the_actual_authored_family() -> Bool:
	family: String =
		|record Box[Element] { value: Element }
		|record Wrap[Element] { value: Element }
		|implements Visit for Wrap[Element]:
		|    pure func visit(value: Self) -> Int:
		|        0
		|implements Visit for Box[Element: Visit]:
		|    pure func visit(value: Self) -> Int:
		|        relay(wrap(value))
		|pure func wrap[Element](value: Element) -> Wrap[Element]:
		|    {value = value}
		|pure func relay[Value: Visit](value: Value) -> Int:
		|
	prefix = VISIT + family + "    "
	match parse_modules_with_base([{ source = prefix + "visit(value)\n" + MAIN, targets = [] }], test_base()):
		Err(_): False
		Ok(parsed):
			match (inventory_records(parsed_contents(parsed).declarations), inventory_traits(parsed_contents(parsed).declarations), check(parsed)):
				([box, wrap], [visit], Ok(program)):
					checked = checked_functions(program)
					var found = False
					match visit.methods:
						[method]:
							for function in checked.functions:
								for call in Model.function_calls(function):
									match call.target:
										Model.UserFunction(_, [Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(actual_wrap)), [Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(actual_box)), [Model.ParameterType(parameter)])])]):
											receiver = Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(actual_wrap)), [Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(actual_box)), [Model.ParameterType(parameter)])])
											match (function.signature.type_parameters, function.signature.parameters):
												([owned], [value]):
													found = (
														receiver == Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(wrap.id)), [Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(box.id)), [Model.ParameterType(parameter)])])
														and owned == parameter
														and value.value_type == Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(box.id)), [Model.ParameterType(parameter)])
														and selects_authored_family(checked, method.id, receiver, RecordHead(wrap.id), [Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(box.id)), [Model.ParameterType(parameter)])])
													)
												_: void
										_: void
						_: void
					found
				_: False


-- Each selected List family consumes exactly one actual constructor layer.
pure func test_three_nested_lists_in_a_generic_field_have_finite_dispatch() -> Bool:
	family: String =
		|record Box[Element] { values: List[List[List[Element]]] }
		|implements Visit for List[Element: Visit]:
		|    pure func visit(value: Self) -> Int:
		|        match value:
		|            []: 0
		|            [head, ..._]: visit(head)
		|implements Visit for Box[Element: Visit]:
		|    pure func visit(value: Self) -> Int:
		|
	prefix = VISIT + family + "        "
	match parse_modules_with_base([{ source = prefix + "visit(value.values)\n" + MAIN, targets = [] }], test_base()):
		Err(_): False
		Ok(parsed):
			match (inventory_records(parsed_contents(parsed).declarations), check(parsed)):
				([box], Ok(program)):
					checked = checked_functions(program)
					var found = False
					for function in checked.functions:
						for call in Model.function_calls(function):
							match call.target:
								Model.TraitMethod(method):
									receiver = Model.method_receiver(method)
									match receiver:
										Model.ListType(Model.ListType(Model.ListType(Model.ParameterType(parameter)))):
											match (function.signature.type_parameters, function.signature.parameters):
												([owned], [value]):
													found = (
														owned == parameter
														and value.value_type == Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(box.id)), [Model.ParameterType(parameter)])
														and selects_authored_family(checked, Model.method_identity(method), receiver, ListHead, [Model.ListType(Model.ListType(Model.ParameterType(parameter)))])
													)
												_: void
										_: void
								_: void
					found
				_: False


pure func test_creating_a_more_wrapped_method_value_cannot_prove_finite() -> Bool:
	family: String =
		|implements Visit for List[Element: Visit]:
		|    pure func visit(value: Self) -> Int:
		|
	prefix = VISIT + family + "        callback: pure (List[List[Element]]) -> Int = "
	rejects_unproven(prefix, "visit", "\n        0\n" + MAIN)


pure func test_creating_an_unchanged_method_value_preserves_a_finite_key() -> Bool:
	family: String =
		|implements Visit for List[Element: Visit]:
		|    pure func visit(value: Self) -> Int:
		|        callback: pure (List[Element]) -> Int = visit
		|        0
		|
	accepts(VISIT + family + MAIN)


tests: TestSuite = {
	description = "Blorp 2 sufficient proof of finite trait instantiation",
	tests = [
		("List relay preserves a finite semantic key cycle", test_list_relay_preserves_a_finite_semantic_key_cycle),
		("wrapping a List receiver cannot prove finite", test_list_relay_wrapping_the_whole_receiver_cannot_prove_finite),
		("Tree and List have finite dispatch", test_tree_and_list_dispatch_have_a_finite_generic_family),
		("mutual aggregates through Lists have finite dispatch", test_mutual_aggregates_through_lists_have_finite_dispatch),
		("finite Box to Wrap selects the actual family", test_finite_box_to_wrap_selects_the_actual_authored_family),
		("three nested Lists have finite dispatch", test_three_nested_lists_in_a_generic_field_have_finite_dispatch),
		("creating a wrapped method value cannot prove finite", test_creating_a_more_wrapped_method_value_cannot_prove_finite),
		("creating an unchanged method value preserves finite keys", test_creating_an_unchanged_method_value_preserves_a_finite_key),
	]
}
