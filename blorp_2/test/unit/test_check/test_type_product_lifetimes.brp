import:
	../../../src/check/model as Model: TypeRef(IntType, StringType, ListType), same_type
	../../../src/check/check: checked_functions, record_declaration_id, union_declaration_id
	../../../src/utils/ids as Declaration
	../../../src/utils/syntax: Purity(Pure)
	../input: checked_source
	../product_lifetime_inputs: call_source, applied_type_source
	test: TestSuite


private pure func nested_type(depth: Int, leaf: TypeRef) -> TypeRef:
	var value = leaf
	for _ in 0..depth:
		value = ListType(value)
	value


private pure func type_depth(value: TypeRef) -> Option[Int]:
	var current = value
	var depth = 0
	var result: Option[Int] = None
	while True:
		match current:
			ListType(child):
				current = child
				depth = depth + 1
			StringType:
				result = Some(depth)
				break
			_:
				break
	result


private pure func retained_child(depth: Int) -> Option[TypeRef]:
	parent = nested_type(depth + 1, StringType)
	match parent:
		ListType(child): Some(child)
		_: None


private pure func nested_product_survives(depth: Int) -> Bool:
	match retained_child(depth):
		Some(child):
			type_depth(child) == Some(depth) and same_type(child, nested_type(depth, StringType))
		None: False


-- Distinct nesting depths identify every stored type's position. The saved
-- element remains usable after the broad parent List and other slots retire.
private pure func broad_child(width: Int) -> Option[TypeRef]:
	var values: List[TypeRef] = []
	for index in 0..width:
		leaf = if index % 2 == 0:
			StringType
		else:
			IntType
		values = values.append(nested_type(index + 1, leaf))
	values.get(width - 2)


private pure func broad_product_survives(width: Int) -> Bool:
	match broad_child(width):
		Some(child): type_depth(child) == Some(width - 1)
		None: False


private record RetainedCalls {
	expression: Model.CheckedExpr,
	target: Declaration.FunctionId,
	signature: Model.FunctionSignature
}


private record RetainedApplication {
	value_type: TypeRef,
	record_id: Declaration.RecordId,
	union_id: Declaration.UnionId
}


-- The fixture declares keep then main. Only the projection and issued ID escape.
private pure func retained_calls(depth: Int) -> Option[RetainedCalls]:
	match checked_source(call_source(depth)):
		Err(_): None
		Ok(parent):
			match checked_functions(parent).functions:
				[keep, main]:
					match main.body:
						Model.CheckedValueBody(Model.ReturnExpression(expression)):
							Some({
								expression = expression,
								target = keep.id,
								signature = keep.signature
							})
						_: None
				_: None


-- Zero is a declaration position passed to its issuer, not a fabricated ID.
private pure func retained_application(depth: Int) -> Option[RetainedApplication]:
	match checked_source(applied_type_source(depth)):
		Err(_): None
		Ok(parent):
			match (record_declaration_id(parent, 0), union_declaration_id(parent, 0), checked_functions(parent).functions):
				(Some(record_id), Some(union_id), [consume, _]):
					match consume.signature.parameters:
						[parameter]:
							Some({
								value_type = parameter.value_type,
								record_id = record_id,
								union_id = union_id
							})
						_: None
				_: None


private pure func checked_calls_survive(depth: Int) -> Bool:
	match retained_calls(depth):
		None: False
		Some(product):
			match product.signature.parameters:
				[parameter]:
					var current = product.expression
					var found: Option[Int] = None
					var calls = 0
					while True:
						if not same_type(current.value_type, IntType):
							break
						match current.form:
							Model.InvokeFunction(call):
								match call.operands:
									[Model.ValueOperand(child)]:
										match call.target:
											Model.UserFunction(target, []):
												if Declaration.function_number(target) != Declaration.function_number(product.target):
													break
												current = child
												calls = calls + 1
											_: break
									_: break
							Model.LiteralInteger(7):
								found = Some(calls)
								break
							_: break
					(
						found == Some(depth) and product.signature.type_parameters.is_empty() and product.signature.purity == Pure
						and same_type(parameter.value_type, IntType) and same_type(product.signature.return_type.value_type, IntType)
					)
				_: False


private pure func checked_applications_survive(depth: Int) -> Bool:
	match retained_application(depth):
		None: False
		Some(product):
			var current = product.value_type
			var valid = True
			for _ in 0..depth:
				match current:
					Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(record_id)), [Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(union_id)), [child])]):
						valid = (
							valid and Declaration.record_number(record_id) == Declaration.record_number(product.record_id)
							and Declaration.union_number(union_id) == Declaration.union_number(product.union_id)
						)
						current = child
					_: valid = False
			valid and same_type(current, IntType)


tests: TestSuite = {
	description = "Retained checked type products",
	tests = [
		("16 checked calls survive their program", pure func(): checked_calls_survive(16)),
		("32 checked calls survive their program", pure func(): checked_calls_survive(32)),
		("64 checked calls survive their program", pure func(): checked_calls_survive(64)),
		("128 checked calls survive their program", pure func(): checked_calls_survive(128)),
		("16 mixed applications survive their checked program", pure func(): checked_applications_survive(16)),
		("32 mixed applications survive their checked program", pure func(): checked_applications_survive(32)),
		("64 mixed applications survive their checked program", pure func(): checked_applications_survive(64)),
		("128 mixed applications survive their checked program", pure func(): checked_applications_survive(128)),
		("16 List types survive their parent", pure func(): nested_product_survives(16)),
		("32 List types survive their parent", pure func(): nested_product_survives(32)),
		("64 List types survive their parent", pure func(): nested_product_survives(64)),
		("128 List types survive their parent", pure func(): nested_product_survives(128)),
		("a child survives 16 ordered type slots", pure func(): broad_product_survives(16)),
		("a child survives 32 ordered type slots", pure func(): broad_product_survives(32)),
		("a child survives 64 ordered type slots", pure func(): broad_product_survives(64)),
		("a child survives 128 ordered type slots", pure func(): broad_product_survives(128)),
	]
}
