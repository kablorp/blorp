-- A record meets each arithmetic trait with exactly the declared member shape,
-- and bounds reach those members.
fixed record Meters { value: Int }

implements Addable for Meters:
    pure func add(left: Self, right: Self) -> Self:
        { value = left.value.add(right.value) }

implements Subtractable for Meters:
    pure func subtract(left: Self, right: Self) -> Self:
        { value = left.value.subtract(right.value) }

implements Multipliable for Meters:
    pure func multiply(left: Self, right: Self) -> Self:
        { value = left.value.multiply(right.value) }

implements Divisible for Meters:
    pure func divide(left: Self, right: Self) -> Self:
        { value = left.value.divide(right.value) }

implements Modulable for Meters:
    pure func remainder(left: Self, right: Self) -> Self:
        { value = left.value.remainder(right.value) }

implements Negatable for Meters:
    pure func negate(value: Self) -> Self:
        { value = value.value.negate() }

pure func combine[Value: Addable + Subtractable + Multipliable + Divisible + Modulable + Negatable](left: Value, right: Value) -> Value:
    left.add(right).subtract(right).multiply(right).divide(right).remainder(right).negate()

func main() -> Int:
    meters: Meters = combine({ value = 7 }, { value = 2 })
    combine(meters.value, combine(7, 2))
