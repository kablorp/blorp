import:
	../../../src/check/check: check, checked_functions
	../../../src/check/model as Model
	../../../src/namespace/builtins as Builtins
	../../../src/utils/ids: union_number, variant_number, variant_owner
	../../../src/utils/text: concat
	../input: setup_diagnostic
	../module_input: parse_modules
	int as IntOps
	test: TestSuite


func test_byte_at_checks_as_an_optional_integer() -> Bool:
	source: String =
		|pure func read_byte(value: String, index: Int) -> Option[Int]:
		|    builtin("string.byte_at")
		|func main() -> Int:
		|    0
		|

	match (
		parse_modules([{ source = source, targets = [] }])
			.and_then(pure func(parsed): check(parsed).map_err(setup_diagnostic))
	):
		Err(error):
			print_error(error.message)
			print_error(error.help)
			print_error(IntOps.to_string(error.span.start).concat("..").concat(IntOps.to_string(error.span.end)))
			False
		Ok(program):
			match checked_functions(program).functions.get(0):
				Some(function):
					match (function.signature.return_type.value_type, function.body):
						(Model.AppliedUnionType(owner, [Model.IntType]), Model.CheckedValueBody(Model.ReturnExpression(value))):
							match value.form:
								Model.InvokeFunction(call, [text, index]):
									match call.target:
										Model.RuntimeFunction(Builtins.StringByteAt(option)):
											(
												Model.same_type(text.value_type, Model.StringType) and Model.same_type(index.value_type, Model.IntType)
												and IntOps.equals(union_number(variant_owner(option.some)), union_number(owner))
												and IntOps.equals(union_number(variant_owner(option.none)), union_number(owner))
												and IntOps.equals(variant_number(option.some), 0) and IntOps.equals(variant_number(option.none), 1)
											)
										_:
											False
								_:
									False
						_:
							False
				None:
					False


tests: TestSuite = {
	description = "Blorp 2 String byte access contract",
	tests = [
		("byte_at checks as Option[Int]", test_byte_at_checks_as_an_optional_integer),
	]
}
