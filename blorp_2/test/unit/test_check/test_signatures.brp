import:
	../../../src/utils/names: program_names
	../../../src/check/check: checked_functions, CheckedProgram, check_errors
	../../../src/check/errors as Errors:
		CheckErrorKind(SignatureRejection),
		SignatureError(DuplicateFunction, MainParameterType, MissingMain)
	../../../src/check/render: render_failure
	../../../src/lex/lex: lex
	../../../src/namespace/builtins as Builtins: RuntimeOperation(IntAdd)
	../../../src/utils/source: module_source, root_module_id, module_id, same_source
	../../../src/utils/syntax: Purity(Pure, Impure), Diagnostic, ParsedRuntimeOperation(IntegerAddBuiltin)
	../input: check, checked_source, parse, rejects_at, setup_diagnostic
	../module_input: parse_modules
	../ownership_inputs: span
	test: TestSuite


pure func test_duplicate_function_diagnostic() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|func main() -> Int:
		|	1
		|
	rejects_at(source, 28, 32, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			SignatureRejection(DuplicateFunction(_, _)):
				True
			_:
				False
	)


pure func test_missing_main_diagnostic() -> Bool:
	source: String =
		|func nope() -> Int:
		|	0
		|
	rejects_at(source, 23, 23, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			SignatureRejection(MissingMain):
				True
			_:
				False
	)


pure func test_duplicate_helper_diagnostic() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|func one() -> Int:
		|	1
		|func one() -> Int:
		|	0
		|
	rejects_at(source, 50, 53, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			SignatureRejection(DuplicateFunction(_, _)):
				True
			_:
				False
	)


pure func test_checked_functions_keep_declared_purity() -> Bool:
	source: String =
		|pure func one() -> Int:
		|	1
		|pure func answer() -> Int:
		|	one()
		|func main() -> Int:
		|	answer()
		|

	match lex(module_source(root_module_id()), source, program_names().names):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					match check(parsed):
						Err(_):
							False
						Ok(program):
							match checked_functions(program).functions:
								[one, answer, main]:
									(
										one.signature.purity == Pure
										and answer.signature.purity == Pure
										and main.signature.purity == Impure
									)
								_:
									False


pure func test_wrong_main_parameter_type_is_rejected() -> Bool:
	source: String =
		|func main(value: Int) -> Int:
		|	value
		|
	rejects_at(source, 17, 20, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			SignatureRejection(MainParameterType):
				True
			_:
				False
	)


pure func test_main_rejects_two_parameters_with_teaching_diagnostic() -> Bool:
	prefix = "func main(arguments: List[String], "
	match checked_source(prefix + "extra: Int) -> Int:\n    0\n"):
		Err(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + "extra".length()
				and error.message == "main accepts at most one parameter"
				and error.help == "declare main() -> Int: or main(arguments: List[String]) -> Int:"
				and error.note.is_none()
			)
		Ok(_): False


private ROOT: String =
	|import:
	|    ./int: add
	|func main() -> Int:
	|    add(20, 22)
	|


private ADD: String =
	|pure func add(first: Int, second: Int) -> Int:
	|    builtin("int.add")
	|


private pure func checked_add(helper: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules([
		{
			source = ROOT,
			targets = [1]
		},
		{
			source = helper,
			targets = []
		},
	])
	check(parsed)
		.map_err(setup_diagnostic)


private pure func rejects_header(header: String) -> Bool:
	helper = header + "\n    builtin(\"int.add\")\n"
	label = header.length() + "\n    builtin(".length()

	match (
		parse_modules([
			{
				source = ROOT,
				targets = [1]
			},
			{
				source = helper,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(parsed):
			match (check(parsed), module_id(1)):
				(Err(failure), Some(helper_module)):
					diagnostics = render_failure(failure)
					error = diagnostics.first
					(
						diagnostics.remaining.is_empty()
						and same_source(error.span.source, module_source(helper_module))
						and error.span.start == label
						and error.span.end == label + "\"int.add\"".length()
						and error.note.is_none()
						and error.message == "builtin declaration does not match its runtime contract"
						and error.help == "declare a pure function with two Int parameters returning Int"
					)
				_:
					False


pure func test_builtin_rejects_impurity() -> Bool:
	rejects_header("func add(first: Int, second: Int) -> Int:")


pure func test_builtin_rejects_zero_parameters() -> Bool:
	rejects_header("pure func add() -> Int:")


pure func test_builtin_rejects_one_parameter() -> Bool:
	rejects_header("pure func add(first: Int) -> Int:")


pure func test_builtin_rejects_extra_parameter() -> Bool:
	rejects_header("pure func add(first: Int, second: Int, third: Int) -> Int:")


pure func test_builtin_rejects_wrong_first_type() -> Bool:
	rejects_header("pure func add(first: String, second: Int) -> Int:")


pure func test_builtin_rejects_wrong_second_type() -> Bool:
	rejects_header("pure func add(first: Int, second: String) -> Int:")


pure func test_builtin_rejects_wrong_result_type() -> Bool:
	rejects_header("pure func add(first: Int, second: Int) -> String:")


pure func test_builtin_rejects_generic_header() -> Bool:
	rejects_header("pure func add[T](first: Int, second: Int) -> Int:")


pure func test_builtin_rejects_tail_annotation() -> Bool:
	match checked_add("@tail_recursive\n" + ADD):
		Ok(_):
			False
		Err(error):
			(
				error.span.start == 0
				and error.span.end == "@tail_recursive".length()
				and error.message == "builtin bodies cannot have a tail-recursion annotation"
				and error.help == "remove @tail_recursive from the builtin declaration"
			)


pure func test_builtin_signature_error_precedes_unrelated_caller_body() -> Bool:
	root: String =
		|import:
		|    ./int: add
		|func main() -> Int:
		|    missing()
		|
	helper: String =
		|pure func add(first: Int, second: String) -> Int:
		|    builtin("int.add")
		|

	match (
		parse_modules([
			{
				source = root,
				targets = [1]
			},
			{
				source = helper,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					match check_errors(failure).first.kind:
						Errors.BuiltinRejection(Errors.BuiltinContractMismatch(IntegerAddBuiltin)):
							True
						_:
							False


-- The root sees Answer without its constructors; its own Same and Other share
-- Answer's variant positions. A builtin role must name a variant of the
-- annotated result union itself.
pure func test_builtin_role_of_another_union_is_not_in_the_result() -> Bool:
	answer: String =
		|fixed union Answer:
		|    Same
		|    Other
		|
	prefix = "import:\n    ./answer: Answer()\nfixed union Mine:\n    Same\n    Other\npure func compare(left: Int, right: Int) -> Answer:\n    builtin(\"int.equals\", "
	root = prefix + "Same, Other)\nfunc main() -> Int:\n    0\n"

	match parse_modules([{ source = root, targets = [1] }, { source = answer, targets = [] }]):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					error = check_errors(failure).first
					rendered = render_failure(failure).first

					match error.kind:
						Errors.BuiltinRejection(Errors.BuiltinRoleNotInResult(_, _)):
							(
								error.span.start == prefix.length()
								and error.span.end == prefix.length() + "Same".length()
								and rendered.message == "builtin constructor does not belong to its result type"
								and rendered.help == "import or declare this constructor in the annotated result union"
							)
						_:
							False


tests: TestSuite = {
	description = "Blorp 2 function signatures, entrypoint and builtin body contracts",
	tests = [
		("wrong main parameter type is rejected", test_wrong_main_parameter_type_is_rejected),
		("main rejects two parameters with teaching diagnostic", test_main_rejects_two_parameters_with_teaching_diagnostic),
		("checked functions keep declared purity", test_checked_functions_keep_declared_purity),
		("duplicate helper diagnostic", test_duplicate_helper_diagnostic),
		("duplicate function diagnostic", test_duplicate_function_diagnostic),
		("missing main diagnostic", test_missing_main_diagnostic),
		("builtin role of another union is not in the result", test_builtin_role_of_another_union_is_not_in_the_result),
		("builtin rejects impurity", test_builtin_rejects_impurity),
		("builtin rejects zero parameters", test_builtin_rejects_zero_parameters),
		("builtin rejects one parameter", test_builtin_rejects_one_parameter),
		("builtin rejects extra parameter", test_builtin_rejects_extra_parameter),
		("builtin rejects wrong first type", test_builtin_rejects_wrong_first_type),
		("builtin rejects wrong second type", test_builtin_rejects_wrong_second_type),
		("builtin rejects wrong result type", test_builtin_rejects_wrong_result_type),
		("builtin rejects generic header", test_builtin_rejects_generic_header),
		("builtin rejects tail annotation", test_builtin_rejects_tail_annotation),
		(
			"builtin signature error precedes caller body",
			test_builtin_signature_error_precedes_unrelated_caller_body,
		),
	]
}
