private pure func exact_failure(source: String, start: Int, end: Int, message: String, help: String, matches: pure (Errors.CheckErrorKind) -> Bool) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names).and_then(parse):
		Err(_): False
		Ok(parsed):
			match API.check(parsed):
				Ok(_): False
				Err(failure):
					errors = API.check_errors(failure)
					diagnostics = render_failure(failure)
					(
						matches(errors.first.kind) and errors.remaining.is_empty() and diagnostics.remaining.is_empty()
						and same_source(errors.first.span.source, module_source(root_module_id()))
						and errors.first.span.start == start and errors.first.span.end == end
						and same_source(diagnostics.first.span.source, errors.first.span.source)
						and diagnostics.first.span.start == start and diagnostics.first.span.end == end
						and diagnostics.first.message == message and diagnostics.first.help == help
						and diagnostics.first.note.is_none()
					)


pure func test_substituted_list_parameter_reports_an_ordinary_mismatch() -> Bool:
	prefix = "pure func choose[T](witness:T, values: "
	suffix: String =
		|List[T])->Int:
		|    0
		|func main()->Int:
		|    choose(1, "bad")
		|
	exact_failure(prefix + suffix, 92, 97,
		"argument type does not match the parameter type", "use an expression of type List[Int] here",
		pure func(kind):
			match kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					(
						Model.same_type(mismatch.expected, Model.ListType(Model.IntType))
						and Model.same_type(mismatch.actual.value_type, Model.StringType)
						and mismatch.argument_position == 1
						and mismatch.actual.span.start == 92 and mismatch.actual.span.end == 97
						and same_source(mismatch.actual.span.source, module_source(root_module_id()))
					)
				_: False
	)


pure func test_pure_void_result_reports_the_ordinary_list_argument_mismatch() -> Bool:
	prefix = "pure func choose[T](witness:T, values: "
	suffix: String =
		|List[T])->T:
		|    witness
		|func main()->Int:
		|    choose(void, "bad")
		|
	exact_failure(prefix + suffix, 99, 104,
		"argument type does not match the parameter type", "use an expression of type List[Void] here",
		pure func(kind):
			match kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					(
						Model.same_type(mismatch.expected, Model.ListType(Model.VoidType))
						and Model.same_type(mismatch.actual.value_type, Model.StringType)
						and mismatch.argument_position == 1
						and mismatch.actual.span.start == 99 and mismatch.actual.span.end == 104
						and same_source(mismatch.actual.span.source, module_source(root_module_id()))
					)
				_: False
	)

private NAMED_FORWARDING: String =
	|pure func first[T](value: T) -> T:
	|    value
	|pure func second(value: Int) -> Int:
	|    2
	|pure func compose[T](value: T, f: pure (T) -> T, g: pure (T) -> T) -> T:
	|    f(g(value))
	|pure func forward[T](f: pure (T) -> T, value: T, g: pure (T) -> T) -> T:
	|    compose(value, f, g)
	|func main() -> Int:
	|    same_choices = forward(first, 17, first)
	|    changed_second = forward(first, 17, second)
	|    swapped_choices = forward(second, 17, first)
	|    forward(first, 17, second)
	|


pure func test_callable_formals_retain_canonical_checked_bindings() -> Bool:
	match checked(NAMED_FORWARDING):
		Err(_): False
		Ok(program):
			match API.checked_functions(program).functions:
				[_, _, _, forward, _]:
					-- Checked slots retain every written formal; Specialize owns runtime erasure.
					match (forward.signature.type_parameters, forward.bindings):
						([parameter], [first, value, last]):
							match (first.origin, value.origin, last.origin):
								(Model.CallableParameterBinding(left), Model.ParameterBinding(1), Model.CallableParameterBinding(right)):
									callable = Model.CallableType(Pure, [Model.ParameterType(parameter)], Model.ParameterType(parameter))
									(Model.same_callable_parameter(left, Model.callable_parameter(forward.id, 0))
										and Model.same_callable_parameter(right, Model.callable_parameter(forward.id, 2))
										and Model.same_type(first.value_type, callable) and Model.same_type(last.value_type, callable)
										and Model.same_type(value.value_type, Model.ParameterType(parameter)))
								_: False
						_: False
				_: False


pure func test_forwarded_choices_keep_written_positions_and_rigid_owner() -> Bool:
	match checked(NAMED_FORWARDING):
		Err(_): False
		Ok(program):
			match API.checked_functions(program).functions:
				[_, _, compose, forward, _]:
					match (forward.signature.type_parameters, body_value(forward)):
						([parameter], Some(value)):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(argument), Model.CallableOperand(left_parameter, left_choice, _), Model.CallableOperand(right_parameter, right_choice, _)]:
											match (call.target, argument.form):
												(Model.UserFunction(owner, [Model.ParameterType(actual)]), Model.ReadBinding(binding)):
													match (left_choice, right_choice):
														(Model.ForwardedCallable(first), Model.ForwardedCallable(second)):
															parameter_read = match forward.bindings.get(Model.binding_number(binding)):
																Some(definition):
																	match definition.origin:
																		Model.ParameterBinding(1): Model.same_type(definition.value_type, Model.ParameterType(parameter))
																		_: False
																None: False
															(
																Declaration.function_number(owner) == Declaration.function_number(compose.id)
																and Model.same_parameter(actual, parameter) and Model.binding_number(binding) == 1 and parameter_read
																and Model.same_callable_parameter(left_parameter, Model.callable_parameter(compose.id, 1))
																and Model.same_callable_parameter(right_parameter, Model.callable_parameter(compose.id, 2))
																and Model.same_callable_parameter(first, Model.callable_parameter(forward.id, 0))
																and Model.same_callable_parameter(second, Model.callable_parameter(forward.id, 2))
															)
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False


private CROSS_TYPES: String =
	|pure func convert(value: Int) -> String:
	|    "é\0"
	|pure func apply[T, U](f: pure (T) -> U, value: T, g: pure (T) -> U, fallback: U) -> U:
	|    saved = f(value)
	|    saved
	|pure func forward[T, U](f: pure (T) -> U, value: T, g: pure (T) -> U, fallback: U) -> U:
	|    apply(f, value, g, fallback)
	|func main() -> Int:
	|    saved = forward(convert, 17, convert, "fallback")
	|    0
	|


pure func test_interleaved_data_and_locals_keep_dense_ids() -> Bool:
	match checked(CROSS_TYPES):
		Err(_): False
		Ok(program):
			match API.checked_functions(program).functions:
				[_, apply, _, _]:
					match (apply.signature.type_parameters, apply.bindings, apply.statements):
						([input, output], [callback, first, other_callback, second, local], [Model.InitializeBinding(saved, value)]):
							match ((callback.origin, first.origin, other_callback.origin), (second.origin, local.origin, value.form)):
								((Model.CallableParameterBinding(first_callback), Model.ParameterBinding(1), Model.CallableParameterBinding(second_callback)), (Model.ParameterBinding(3), Model.BodyLocal, Model.InvokeFunction(call))):
									match call.operands:
										[Model.ValueOperand(argument)]:
											match (call.target, argument.form):
												(Model.CallableParameter(parameter), Model.ReadBinding(actual)):
													(
														Model.binding_number(saved) == 4 and Model.binding_number(actual) == 1
														and Model.same_callable_parameter(first_callback, Model.callable_parameter(apply.id, 0))
														and Model.same_callable_parameter(second_callback, Model.callable_parameter(apply.id, 2))
														and Model.same_type(callback.value_type, Model.CallableType(Pure, [Model.ParameterType(input)], Model.ParameterType(output)))
														and Model.same_type(other_callback.value_type, callback.value_type)
														and Model.same_type(first.value_type, Model.ParameterType(input))
														and Model.same_type(second.value_type, Model.ParameterType(output))
														and Model.same_type(local.value_type, Model.ParameterType(output))
														and Model.same_callable_parameter(parameter, Model.callable_parameter(apply.id, 0))
													)
												_: False
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Contextual generic-call inference",
	tests = [
		("interleaved data bindings and first local remain dense", test_interleaved_data_and_locals_keep_dense_ids),
		("callable formals retain canonical checked bindings", test_callable_formals_retain_canonical_checked_bindings),
		("forwarded choices retain written positions and rigid owner", test_forwarded_choices_keep_written_positions_and_rigid_owner),
		("substituted List parameter reports ordinary mismatch", test_substituted_list_parameter_reports_an_ordinary_mismatch),
		("pure Void result reports ordinary List mismatch", test_pure_void_result_reports_the_ordinary_list_argument_mismatch),
		("deferred List result permits later unknown", test_deferred_list_result_allows_a_later_unknown_child),
		("known List context opens mixed structural terms", test_known_list_context_opens_only_the_mixed_inference_shape),
		("closed nested calls retain complete nominal ancestry", test_closed_nested_results_publish_complete_nominal_ancestry),
		("direct hint rebuilds substituted accepted compound", test_direct_result_hint_rebuilds_the_substituted_compound),
		("UFCS hint rebuilds substituted accepted receiver", test_ufcs_result_hint_rebuilds_the_substituted_receiver_compound),
		("repeated result retains common partial nominal head", test_repeated_result_projection_keeps_a_common_partial_nominal_head),
		("repeated result prefers concrete descendant guidance", test_repeated_projection_prefers_known_descendants_over_fresh_variables),
		("repeated projection origin is source-first", test_repeated_projection_preserves_the_source_first_parameter_origin),
		("merged hint retains exact authoritative sibling conflict", test_merged_hint_does_not_mask_a_later_authoritative_sibling_conflict),
		("repeated result never guesses incompatible nominal heads", test_repeated_projection_never_guesses_between_different_nominal_heads),
		("deferred merged payload permits later unknown", test_deferred_merged_hint_payload_allows_later_unknown_child),
		("merged hint normalizes bound descendant before checking payload", test_merged_hint_normalizes_a_bound_descendant_before_payload_checking),
		("repeated projection preserves caller rigid atoms", test_repeated_projection_keeps_caller_rigid_atoms_exact),

		("unique UFCS partial nominal head solves payload", test_unique_ufcs_partial_nominal_receiver_solves_payload),
		("unique UFCS partial nullary receiver retains ambiguity", test_unique_ufcs_partial_nullary_receiver_retains_ambiguity),
		("independent nested calls use distinct fresh variables", test_two_independent_pending_calls_keep_distinct_fresh_variables),
		("nested repeated create produces finite occurs diagnostic", test_repeated_nested_create_reports_a_finite_occurs_diagnostic),
		("occurs origin remains stable after rank-changing merges", test_occurs_origin_is_independent_of_a_different_calls_rank_root),
		("partial nominal head solves constructor payload", test_partial_nominal_argument_hint_solves_constructor_payload),
		("partial nullary constructor rejects only remaining ambiguity", test_partial_nullary_constructor_resolves_owner_before_ambiguity),
		("partial constructor payload accepts pending nested call", test_partial_constructor_payload_accepts_a_pending_nested_call),
		("no nominal hint never guesses constructor owner", test_no_nominal_hint_never_guesses_a_constructor_owner),
		("known constructor payload mismatch precedes later unknown", test_known_constructor_payload_mismatch_precedes_later_unknown),
		("closed nested mismatch precedes later unknown", test_closed_nested_mismatch_precedes_a_later_unknown_child),
		("deferred nested call permits later unknown", test_deferred_nested_mismatch_allows_a_later_unknown_child),
		("descendant ambiguity precedes all outer ordinary mismatches", test_deferred_child_ambiguity_precedes_every_outer_ordinary_mismatch),
		("discard reports nested empty parameter", test_discarded_nested_result_reports_the_child_parameter),
		("merged ambiguity preserves queried child origin", test_merged_variable_ambiguity_preserves_the_queried_child_origin),
		("true phantom precedes later unknown", test_true_nested_phantom_precedes_a_later_unknown_child),
		("phantom ambiguity precedes result mismatch", test_phantom_ambiguity_precedes_an_expected_result_mismatch),
		("discarded Void tail supplies no result constraint", test_discarded_void_tail_supplies_no_result_constraint),
		("annotated result completes zero-argument substitution", test_annotated_result_publishes_complete_zero_argument_substitution),
		("result context flows through nested generic calls", test_result_context_flows_through_a_nested_generic_call),
		("concrete argument solves nested empty call", test_concrete_argument_context_solves_a_nested_empty_call),
		("later sibling solves earlier nested call", test_later_sibling_evidence_solves_an_earlier_nested_call),
		("generic result preserves caller rigid parameter", test_generic_result_context_preserves_the_caller_rigid_parameter),
		("direct constructor receives nominal result context", test_result_context_provides_a_nominal_head_to_a_direct_constructor),
		("unique UFCS receiver receives nominal result context", test_result_context_provides_a_nominal_head_to_a_unique_ufcs_receiver),
		("binding does not inherit function result context", test_uncontextualized_binding_does_not_inherit_function_result),
		("phantom parameter remains uninferred", test_phantom_parameter_stays_uninferred_despite_result_context),
		("later child name error retains precedence", test_later_child_name_error_precedes_argument_and_result_conflicts),
	]
}
