pure func test_uncontextualized_binding_does_not_inherit_function_result() -> Bool:
	prefix = CHOICE + "func main() -> Int:\n    value = "
	match check_failure(prefix + "empty()\n    0\n"):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.UninferableTypeParameter(parameter)):
					match Model.parameter_owner(parameter):
						Model.FunctionDeclaration(owner):
							(
								Declaration.function_number(owner) == 0
								and Model.parameter_position(parameter) == 0
								and error.span.start == prefix.length()
								and error.span.end == prefix.length() + 5
							)
						_:
							False
				_:
					False
		None:
			False


