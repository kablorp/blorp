private pure func occurs_at(source: String, owner: Int, call_start: Int, actual_start: Int, actual_end: Int, annotation_start: Int) -> Bool:
	match check_failure(source):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.InfiniteTypeArgument(infinite)):
					parameter_matches = match Model.parameter_owner(infinite.parameter):
						Model.FunctionDeclaration(declaration): Declaration.function_number(declaration) == owner and Model.parameter_position(infinite.parameter) == 0
						_: False
					snapshot_matches = match infinite.recursive_type:
						Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(box)), [Model.ParameterType(parameter)]): Declaration.union_number(box) == 0 and Model.same_parameter(parameter, infinite.parameter)
						_: False
					site_matches = match infinite.expected_site:
						Errors.SourceAnnotation(span): span.start == annotation_start and span.end == annotation_start + 9
						_: False
					parameter_matches and snapshot_matches and site_matches and infinite.call_span.start == call_start and infinite.call_span.end == call_start + 8 and error.span.start == actual_start and error.span.end == actual_end
				_: False
		None: False


private OCCURS_TYPES: String =
	|union Box[T]:
	|    Boxed
	|union Pair[A,B]:
	|    Paired
	|


pure func test_repeated_nested_create_reports_a_finite_occurs_diagnostic() -> Bool:
	create: String =
		|pure func create[T]() -> Pair[T,Box[T]]:
		|    Paired
		|pure func repeated[T](value:
	annotation_prefix = OCCURS_TYPES + create + " "
	declarations = annotation_prefix + "Pair[T,T])->Int:\n    7\nfunc main()->Int:\n    "
	source = declarations + "repeated(create())\n"
	facts = occurs_at(source, 1, declarations.length(), declarations.length() + 9, declarations.length() + 17, annotation_prefix.length())
	rendered = match checked(source):
		Err(diagnostic): diagnostic.message == "inferred type would contain itself" and diagnostic.help == "pass a value with a finite type, or use a concrete helper"
		Ok(_): False
	facts and rendered


pure func test_occurs_origin_is_independent_of_a_different_calls_rank_root() -> Bool:
	create: String =
		|pure func seed[T]() -> T:
		|    seed()
		|pure func identity[T](value: T) -> T:
		|    value
		|pure func pair_from[T](value: T) -> Pair[T,Box[T]]:
		|    Paired
		|pure func repeated[T](value:
	annotation_prefix = OCCURS_TYPES + create + " "
	declarations = annotation_prefix + "Pair[T,T])->Int:\n    7\nfunc main()->Int:\n    "
	actual = "pair_from(identity(seed()))"
	occurs_at(declarations + "repeated(" + actual + ")\n", 3, declarations.length(), declarations.length() + 9, declarations.length() + 9 + actual.length(), annotation_prefix.length())


