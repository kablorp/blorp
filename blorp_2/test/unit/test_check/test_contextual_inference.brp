			match API.checked_functions(program).functions.get(3).and_then(body_value):
				Some(value):
					match value.form:
						Model.InvokeFunction(call):
							match call.operands:
								[Model.ValueOperand(_)]: one_type_argument(call, Model.IntType)
								_: False
						_: False
				None: False
		Err(_): False


