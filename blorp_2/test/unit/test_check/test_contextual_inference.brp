																Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(owner)), [child]): Declaration.union_number(owner) == 0 and Model.same_type(child, inner.value_type) and one_type_argument(outer, inner.value_type) and one_type_argument(call, Model.IntType)
																_: False
														_: False
