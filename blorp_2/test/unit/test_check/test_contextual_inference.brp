private pure func ambiguity_at(source: String, owner: Int, start: Int, end: Int) -> Bool:
	match check_failure(source):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.UninferableTypeParameter(parameter)):
					match Model.parameter_owner(parameter):
						Model.FunctionDeclaration(declaration):
							Declaration.function_number(declaration) == owner and Model.parameter_position(parameter) == 0 and error.span.start == start and error.span.end == end
						_: False
				_: False
		None: False


pure func test_closed_nested_mismatch_precedes_a_later_unknown_child() -> Bool:
	declarations: String =
		|pure func take_int(value: Int) -> Int:
		|    value
		|pure func outer(left: Int, right: Int) -> Int:
		|    left
		|func main() -> Int:
	prefix = declarations + "\n    outer("
	match check_failure(prefix + "take_int(\"bad\"), missing)\n"):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					error.span.start == prefix.length() and error.span.end == prefix.length() + 8 and Model.same_type(mismatch.expected, Model.IntType) and Model.same_type(mismatch.actual.value_type, Model.StringType)
				_: False
		None: False


