				None: False
		Err(_): False


private pure func choice_argument_is_int(value: Model.CheckedExpr) -> Bool:
	match value.value_type:
		Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(owner)), [argument]): Declaration.union_number(owner) == 0 and Model.same_type(argument, Model.IntType)
		_: False


