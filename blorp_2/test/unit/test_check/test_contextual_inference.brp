		|    Nothing
		|pure func take_int(value: Int) -> Int:
		|    value
		|pure func outer(left: Int, right: Int) -> Int:
		|    left
		|func main() -> Int:
	prefix = declarations + "\n    outer(take_int(create()), "
	match check_failure(prefix + "missing)\n"):
		Some(error):
			match error.kind:
				Errors.ValueRejection(Errors.UnknownValue(_)): error.span.start == prefix.length() and error.span.end == prefix.length() + 7
				_: False
		None: False


