pure func test_two_independent_pending_calls_keep_distinct_fresh_variables() -> Bool:
	declarations: String =
		|pure func inspect[T](value: Choice[T], evidence: T) -> Int:
		|    7
		|pure func outer(left: Int, right: Int) -> Int:
		|    left
		|func main() -> Int:
		|    outer(inspect(empty(), 1), inspect(empty(), "text"))
		|
	match checked(CHOICE + declarations):
		Ok(program):
			match API.checked_functions(program).functions.get(4).and_then(body_value):
				Some(value):
					match value.form:
						Model.InvokeFunction(operand_call_2):
							match operand_call_2.operands:
								[Model.ValueOperand(left), Model.ValueOperand(right)]: independent_inspection(left, Model.IntType) and independent_inspection(right, Model.StringType)
								_: False
						_: False
				None: False
		Err(_): False


private pure func independent_inspection(value: Model.CheckedExpr, expected: Model.TypeRef) -> Bool:
	match value.form:
		Model.InvokeFunction(call):
			match call.operands:
				[Model.ValueOperand(inner), Model.ValueOperand(_)]:
					match inner.form:
						Model.InvokeFunction(nested):
							match nested.operands:
								[]: one_type_argument(call, expected) and one_type_argument(nested, expected)
								_: False
						_: False
				_: False
		_: False


private REPEATED: String =
	|union Pair[A,B]:
	|    Paired
	|pure func repeat[T](value: T) -> Pair[T,T]:
	|    Paired
	|


pure func test_repeated_result_projection_keeps_a_common_partial_nominal_head() -> Bool:
	source: String =
		|pure func take[A,B](value: Pair[Choice[A],Choice[B]], a:A, b:B) -> Int:
		|    7
		|func main() -> Int:
		|    take(repeat(Value(1)), 1, 1)
		|
	match checked(CHOICE + REPEATED + source):
		Ok(program): API.checked_functions(program).functions.get(4).and_then(body_value).map(repeated_result_substitutions).get_or(False)
		Err(_): False


private pure func repeated_result_substitutions(value: Model.CheckedExpr) -> Bool:
	match value.form:
		Model.InvokeFunction(call):
			match call.operands:
				[Model.ValueOperand(repeated), Model.ValueOperand(_), Model.ValueOperand(_)]:
					outer = match call.target:
						Model.UserFunction(owner, [Model.IntType, Model.IntType]): Declaration.function_number(owner) == 3
						_: False
					outer and repeated_argument_substitution(repeated)
				_: False
		_: False


private pure func repeated_argument_substitution(value: Model.CheckedExpr) -> Bool:
	match value.form:
		Model.InvokeFunction(call):
			match call.operands:
				[Model.ValueOperand(payload)]:
					match (call.target, payload.form, value.value_type):
						(Model.UserFunction(owner, [argument]), Model.ConstructVariant(variant, [child]), Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(pair)), [first, second])):
							match payload.value_type:
								Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(choice)), [Model.IntType]):
									(
										Declaration.function_number(owner) == 2
										and Declaration.union_number(pair) == 1
										and Declaration.union_number(choice) == 0
										and Declaration.union_number(Declaration.variant_owner(variant)) == 0
										and Declaration.variant_number(variant) == 1
										and Model.same_type(child.value_type, Model.IntType)
										and Model.same_type(argument, payload.value_type)
										and Model.same_type(first, argument)
										and Model.same_type(second, argument)
									)
								_: False
						_: False
				_: False
		_: False

pure func test_repeated_projection_prefers_known_descendants_over_fresh_variables() -> Bool:
	source: String =
		|pure func take[A](value: Pair[Choice[A],Choice[Int]], a:A) -> Int:
		|    7
		|func main() -> Int:
		|    take(repeat(Value(1)), 1)
		|
	checked(CHOICE + REPEATED + source).is_ok()


pure func test_repeated_projection_preserves_the_source_first_parameter_origin() -> Bool:
	declarations: String =
		|pure func take[A,B](value: Pair[Choice[A],Choice[B]]) -> Int:
		|    7
		|func main() -> Int:
	prefix = CHOICE + REPEATED + declarations + "\n    "
	ambiguity_at(prefix + "take(repeat(Empty))\n", 3, prefix.length(), prefix.length() + 4)


pure func test_merged_hint_does_not_mask_a_later_authoritative_sibling_conflict() -> Bool:
	take_source: String =
		|pure func take[A,B](value: Pair[Choice[A],Choice[B]], a:A, b:
	annotation_prefix = CHOICE + REPEATED + take_source + " "
	declarations = annotation_prefix + "B) -> Int:\n    7\nfunc main() -> Int:\n    take("
	first = "repeat(Value(1))"
	prefix = declarations + first + ", 1, "
	match check_failure(prefix + "\"bad\")\n"):
		Some(error):
			match error.kind:
				Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
					owner_matches = match Model.parameter_owner(conflict.parameter):
						Model.FunctionDeclaration(owner): Declaration.function_number(owner) == 3 and Model.parameter_position(conflict.parameter) == 1
						_: False
					site_matches = match conflict.mismatch.expected_site:
						Errors.SourceAnnotation(span): span.start == annotation_prefix.length() and span.end == annotation_prefix.length() + 1
						_: False
					owner_matches and site_matches and error.span.start == prefix.length() and error.span.end == prefix.length() + 5 and conflict.previous.span.start == declarations.length() and conflict.previous.span.end == declarations.length() + first.length() and conflict.current.span.start == prefix.length() and conflict.current.span.end == prefix.length() + 5 and Model.same_type(conflict.previous.value_type, Model.IntType) and Model.same_type(conflict.current.value_type, Model.StringType) and Model.same_type(conflict.mismatch.expected, Model.IntType) and conflict.mismatch.argument_position == 2
				_: False
		None: False


pure func test_repeated_projection_never_guesses_between_different_nominal_heads() -> Bool:
	declarations: String =
		|union Other[T]:
		|    OtherValue(T)
		|pure func take[A,B](value: Pair[Choice[A],Other[B]], a:A, b:B) -> Int:
		|    7
		|func main() -> Int:
	prefix = CHOICE + REPEATED + declarations + "\n    take("
	marked = "repeat(Value(1))"
	exact_failure(prefix + marked + ", 1, 1)\n", prefix.length(), prefix.length() + marked.length(),
		"argument type does not match the parameter type",
		"use an expression of type Pair[Choice[Int], Other[Int]] here",
		pure func(kind):
			match kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					match (mismatch.expected, mismatch.actual.value_type):
						(Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(expected_owner)), [first, second]), Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(actual_owner)), [actual_first, actual_second])):
							(
								Declaration.union_number(expected_owner) == Declaration.union_number(actual_owner)
								and not Model.same_type(first, second)
								and Model.same_type(first, actual_first) and Model.same_type(first, actual_second)
								and mismatch.argument_position == 0
							)
						_: False
				_: False
	)


