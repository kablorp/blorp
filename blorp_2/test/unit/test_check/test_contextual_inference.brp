import:
	../../../src/utils/names: program_names
	../../../src/check/errors as Errors
	../../../src/check/model as Model
	../../../src/check/check as API
	../../../src/check/render: render_failure
	../../../src/utils/ids as Declaration
	../../../src/lex/lex: lex
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: Diagnostic, Purity(Pure)
	../input: check_failure, parse, setup_diagnostic
	test: TestSuite


private CHOICE: String =
	|union Choice[T]:
	|    Empty
	|    Value(T)
	|pure func empty[T]() -> Choice[T]:
	|    Empty
	|pure func identity[T](value: T) -> T:
	|    value
	|

private MAIN: String =
	|func main() -> Int:
	|    0
	|


private pure func checked(source: String) -> Result[API.CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	API.check(parsed).map_err(setup_diagnostic)


private pure func body_value(function: Model.CheckedFunction) -> Option[Model.CheckedExpr]:
	match function.body:
		Model.CheckedValueBody(Model.ReturnExpression(value)):
			Some(value)
		_:
			None


private pure func one_type_argument(call: Model.CheckedCall, expected: Model.TypeRef) -> Bool:
	ordinary = call.operands.all(pure func(operand):
		match operand:
			Model.ValueOperand(_): True
			Model.CallableOperand(_, _, _): False
	)
	match (call.target, ordinary):
		(Model.UserFunction(_, [actual]), True):
			Model.same_type(actual, expected)
		_:
			False


pure func test_annotated_result_publishes_complete_zero_argument_substitution() -> Bool:
	source: String =
		|pure func choose() -> Choice[Int]:
		|    empty()
		|
	match checked(CHOICE + source + MAIN):
		Ok(program):
			match API.checked_functions(program).functions.get(2).and_then(body_value):
				Some(value):
					match value.form:
						Model.InvokeFunction(call):
							match call.operands:
								[]:
									one_type_argument(call, Model.IntType)
								_: False
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_result_context_flows_through_a_nested_generic_call() -> Bool:
	source: String =
		|pure func choose() -> Choice[Int]:
		|    identity(empty())
		|
	match checked(CHOICE + source + MAIN):
		Ok(program):
			match API.checked_functions(program).functions.get(2):
				Some(function):
					match body_value(function):
						Some(value):
							match value.form:
								Model.InvokeFunction(outer):
									match outer.operands:
										[Model.ValueOperand(inner)]:
											match inner.form:
												Model.InvokeFunction(call):
													match call.operands:
														[]:
															(
																one_type_argument(outer, function.signature.return_type.value_type)
																and one_type_argument(call, Model.IntType)
															)
														_: False
												_:
													False
										_: False
								_:
									False
						None:
							False
				None:
					False
		Err(_):
			False


pure func test_concrete_argument_context_solves_a_nested_empty_call() -> Bool:
	source: String =
		|pure func inspect(value: Choice[Int]) -> Int:
		|    7
		|func main() -> Int:
		|    inspect(empty())
		|
	match checked(CHOICE + source):
		Ok(program):
			match API.checked_functions(program).functions.get(3).and_then(body_value):
				Some(value):
					match value.form:
						Model.InvokeFunction(operand_call_1):
							match operand_call_1.operands:
								[Model.ValueOperand(inner)]:
									match inner.form:
										Model.InvokeFunction(call):
											match call.operands:
												[]:
													one_type_argument(call, Model.IntType)
												_: False
										_:
											False
								_: False
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_later_sibling_evidence_solves_an_earlier_nested_call() -> Bool:
	source: String =
		|pure func integer() -> Choice[Int]:
		|    Value(7)
		|pure func first[T](left: T, right: T) -> T:
		|    left
		|func main() -> Int:
		|    selected = first(empty(), integer())
		|    0
		|
	match checked(CHOICE + source):
		Ok(program):
			match API.checked_functions(program).functions.get(4):
				Some(function):
					match function.statements:
						[Model.InitializeBinding(_, value)]:
							match value.form:
								Model.InvokeFunction(outer):
									match outer.operands:
										[Model.ValueOperand(inner), Model.ValueOperand(_)]:
											match inner.form:
												Model.InvokeFunction(call):
													match call.operands:
														[]:
															(
																one_type_argument(call, Model.IntType)
																and one_type_argument(outer, value.value_type)
															)
														_: False
												_:
													False
										_: False
								_:
									False
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_generic_result_context_preserves_the_caller_rigid_parameter() -> Bool:
	source: String =
		|pure func forward[Element]() -> Choice[Element]:
		|    empty()
		|
	match checked(CHOICE + source + MAIN):
		Ok(program):
			match API.checked_functions(program).functions.get(2):
				Some(function):
					match (function.signature.type_parameters, body_value(function)):
						([parameter], Some(value)):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[]:
											one_type_argument(call, Model.ParameterType(parameter))
										_: False
								_:
									False
						_:
							False
				None:
					False
		Err(_):
			False


