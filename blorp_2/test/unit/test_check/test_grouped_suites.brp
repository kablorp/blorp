import:
    ../../../src/check/check: check
    ../../../src/check/render: render_failure
    ../../../src/load/load: load_test_program
    ../../../src/utils/source: SourceId, module_id, module_source, root_module_id
    bool: and
    int: Int methods
    list: List methods
    option: Option methods
    result: Result methods
    string: String methods
    system: read_file
    test: TestSuite


private LIBRARY_ROOT: String = "blorp_2/standard_library"
private FIXTURES: String = "blorp_2/test/e2e/fixtures/test_entry/"
-- Later roots follow the first root, the base and the prelude.
private FIRST_LATER_ROOT_ORDINAL: Int = 3


private pure func fixture(name: String) -> String:
    "${FIXTURES}${name}.brp"


private pure func later_root_source() -> SourceId:
    module_source(module_id(FIRST_LATER_ROOT_ORDINAL).get_or(root_module_id()))


-- Checking rejects with exactly this diagnostic, at the end of `located`,
-- the input whose source is `origin`.
private func rejected_at_end(root: String, grouped: List[String], located: String, origin: SourceId, message: String, help: String) -> Bool:
    match (load_test_program(root, grouped, LIBRARY_ROOT), read_file(located)):
        (Ok(loaded), Ok(contents)):
            match check(loaded.program):
                Ok(_): False
                Err(failure):
                    errors = render_failure(failure)
                    error = errors.first
                    and(
                        and(errors.remaining.is_empty(), and(error.message == message, error.help == help)),
                        and(error.span.source == origin, and(error.span.start == contents.length(), error.span.end == contents.length())),
                    )
        _: False


func test_grouped_constant_suites_check() -> Bool:
    match load_test_program(fixture("passing"), [fixture("failing"), fixture("empty")], LIBRARY_ROOT):
        Err(_): False
        Ok(loaded): check(loaded.program).is_ok()


-- The suite is still an argument of a TestSuite parameter, so the checker's
-- message is unchanged.
func test_a_root_suite_of_the_wrong_type_keeps_the_argument_message() -> Bool:
    rejected_at_end(
        fixture("scalar"), [], fixture("scalar"), module_source(root_module_id()),
        "argument type does not match the parameter type", "use an expression of type TestSuite here",
    )


func test_a_later_suite_of_the_wrong_type_is_reported_at_its_own_end() -> Bool:
    rejected_at_end(
        fixture("passing"), [fixture("scalar")], fixture("scalar"), later_root_source(),
        "argument type does not match the parameter type", "use an expression of type TestSuite here",
    )


-- Known limit: the entry reads a later root's suite through an import, so a
-- private constant there is rejected as private to its unwritable alias.
func test_a_private_later_suite_is_rejected_as_private() -> Bool:
    rejected_at_end(
        fixture("passing"), [fixture("private")], fixture("private"), later_root_source(),
        "tests is private to <suite 1>", "remove private or qualify a public declaration",
    )


tests: TestSuite = {
    description = "Blorp 2 grouped test entry checking",
    tests = [
        ("grouped constant suites check", test_grouped_constant_suites_check),
        ("a root suite of the wrong type keeps the argument message", test_a_root_suite_of_the_wrong_type_keeps_the_argument_message),
        ("a later suite of the wrong type is reported at its own end", test_a_later_suite_of_the_wrong_type_is_reported_at_its_own_end),
        ("a private later suite is rejected as private", test_a_private_later_suite_is_rejected_as_private),
    ]
}
