import:
	../../../src/check/model:
		TypeParameterOwner(FunctionDeclaration, UnionDeclaration, RecordDeclaration),
		TypeRef(
			VoidType, IntType, FloatType, StringType, ListType, RecordType, UnionType,
			AppliedUnionType, AppliedRecordType, ParameterType,
		),
		binding_id,
		binding_number,
		field_id,
		field_number,
		field_owner,
		parameter_position,
		same_parameter,
		same_type,
		same_types,
		type_parameter_id,
	../../../src/utils/ids: FunctionId, RecordId, UnionId, inventory_functions, inventory_records, inventory_unions, record_number
	../declaration_inputs: sample_inventory
	test: TestSuite


private fixed record ModelIds {
	function0: FunctionId,
	function1: FunctionId,
	record0: RecordId,
	record1: RecordId,
	record2: RecordId,
	record3: RecordId,
	union0: UnionId,
	union1: UnionId,
	union2: UnionId,
	union3: UnionId,
	union4: UnionId
}


private pure func model_ids() -> Option[ModelIds]:
	inventory = sample_inventory()
	match (inventory_functions(inventory), inventory_records(inventory), inventory_unions(inventory)):
		([first, second, _, _], [record0, record1, record2, record3], [union0, union1, union2, union3, union4]):
			Some({
				function0 = first.id,
				function1 = second.id,
				record0 = record0.id,
				record1 = record1.id,
				record2 = record2.id,
				record3 = record3.id,
				union0 = union0.id,
				union1 = union1.id,
				union2 = union2.id,
				union3 = union3.id,
				union4 = union4.id,
			})
		_: None


private pure func function_parameter(function: FunctionId, position: Int) -> TypeRef:
	ParameterType(type_parameter_id(FunctionDeclaration(function), position))


-- One representative of every TypeRef form; equal positions denote equal types.
private pure func representatives(ids: ModelIds) -> List[TypeRef]:
	[
		VoidType,
		IntType,
		FloatType,
		StringType,
		ListType(StringType),
		ListType(function_parameter(ids.function0, 0)),
		RecordType(ids.record0),
		RecordType(ids.record1),
		UnionType(ids.union0),
		UnionType(ids.union1),
		AppliedUnionType(ids.union2, [IntType]),
		AppliedUnionType(ids.union2, [StringType]),
		AppliedUnionType(ids.union2, [IntType, IntType]),
		AppliedUnionType(ids.union3, [IntType]),
		AppliedRecordType(ids.record2, [IntType]),
		AppliedRecordType(ids.record2, [StringType]),
		AppliedRecordType(ids.record2, [IntType, StringType]),
		AppliedRecordType(ids.record2, [StringType, IntType]),
		AppliedRecordType(ids.record3, [IntType]),
		function_parameter(ids.function0, 0),
		function_parameter(ids.function0, 1),
		function_parameter(ids.function1, 0),
		ParameterType(type_parameter_id(UnionDeclaration(ids.union0), 0)),
		ParameterType(type_parameter_id(RecordDeclaration(ids.record0), 0)),
	]


pure func test_type_equality_is_structural_and_distinguishes_every_form() -> Bool:
	match model_ids():
		None: False
		Some(ids):
			left_types = representatives(ids)
			right_types = representatives(ids)
			var correct = True
			var left_position = 0

			for left in left_types:
				var right_position = 0

				for right in right_types:
					correct = correct and same_type(left, right) == (left_position == right_position)
					right_position = right_position + 1

				left_position = left_position + 1

			correct


pure func test_parameter_identity_compares_owner_kind_owner_and_position() -> Bool:
	match model_ids():
		None: False
		Some(ids):
			function_first = type_parameter_id(FunctionDeclaration(ids.function0), 0)
			union_first = type_parameter_id(UnionDeclaration(ids.union0), 0)
			(
				same_parameter(function_first, type_parameter_id(FunctionDeclaration(ids.function0), 0))
				and not same_parameter(function_first, union_first)
				and not same_parameter(function_first, type_parameter_id(FunctionDeclaration(ids.function0), 1))
				and parameter_position(type_parameter_id(UnionDeclaration(ids.union4), 2)) == 2
			)


pure func test_checked_identities_retain_their_components() -> Bool:
	match model_ids():
		None: False
		Some(ids):
			field = field_id(ids.record3, 1)
			(
				record_number(field_owner(field)) == 3
				and field_number(field) == 1
				and binding_number(binding_id(5)) == 5
			)


pure func test_type_vectors_preserve_empty_length_and_order() -> Bool:
	(
		same_types([], [])
		and not same_types([], [IntType])
		and not same_types([IntType], [])
		and not same_types([IntType], [IntType, StringType])
		and not same_types([IntType, StringType], [IntType])
		and same_types([IntType, StringType], [IntType, StringType])
		and not same_types([IntType, StringType], [StringType, IntType])
	)


pure func test_type_vectors_compare_nested_nominal_owners() -> Bool:
	match model_ids():
		None: False
		Some(ids):
			first = AppliedRecordType(ids.record0, [
				AppliedUnionType(ids.union0, [ListType(function_parameter(ids.function0, 0))]),
				StringType,
			])
			equal = AppliedRecordType(ids.record0, [
				AppliedUnionType(ids.union0, [ListType(function_parameter(ids.function0, 0))]),
				StringType,
			])
			other_union = AppliedRecordType(ids.record0, [
				AppliedUnionType(ids.union1, [ListType(function_parameter(ids.function0, 0))]),
				StringType,
			])
			other_parameter = AppliedRecordType(ids.record0, [
				AppliedUnionType(ids.union0, [ListType(function_parameter(ids.function1, 0))]),
				StringType,
			])
			other_record = AppliedRecordType(ids.record1, [
				AppliedUnionType(ids.union0, [ListType(function_parameter(ids.function0, 0))]),
				StringType,
			])
			(
				same_types([first, VoidType], [equal, VoidType])
				and not same_types([first, VoidType], [other_union, VoidType])
				and not same_types([first, VoidType], [other_parameter, VoidType])
				and not same_types([first, VoidType], [other_record, VoidType])
				and not same_types([first, VoidType], [equal, StringType])
			)


tests: TestSuite = {
	description = "Blorp 2 checked program model",
	tests = [
		("type vectors preserve empty length and order", test_type_vectors_preserve_empty_length_and_order),
		("type vectors compare nested nominal owners", test_type_vectors_compare_nested_nominal_owners),
		(
			"type equality is structural and distinguishes every form",
			test_type_equality_is_structural_and_distinguishes_every_form,
		),
		(
			"parameter identity compares owner kind, owner and position",
			test_parameter_identity_compares_owner_kind_owner_and_position,
		),
		("checked identities retain their components", test_checked_identities_retain_their_components),
	]
}
