import:
	../../../src/check/model:
		TypeParameterOwner(FunctionDeclaration, UnionDeclaration, RecordDeclaration),
		TypeRef(
			VoidType, IntType, FloatType, StringType, ListType, NominalType, ParameterType, CallableType,
		),
		AggregateId(RecordAggregate, UnionAggregate),
		NominalId(AggregateNominal, OpaqueNominal),
		binding_id,
		binding_number,
		callable_parameter, callable_owner, callable_position,
		field_id,
		field_number,
		field_owner,
		parameter_position,
		type_parameter_id,
	../../../src/utils/ids:
		FunctionId, OpaqueId, RecordId, UnionId, inventory_functions, inventory_opaques, inventory_records, inventory_unions,
		issue_inventory, record_number, function_number
	../../../src/utils/syntax: TypeSyntax(AtomicType), Purity(Pure)
	../declaration_inputs: sample_inventory
	test: TestSuite


private record ModelIds {
	function0: FunctionId,
	function1: FunctionId,
	record0: RecordId,
	record1: RecordId,
	record2: RecordId,
	record3: RecordId,
	union0: UnionId,
	union1: UnionId,
	union2: UnionId,
	union3: UnionId,
	union4: UnionId,
	opaque0: OpaqueId,
	opaque1: OpaqueId
}


private pure func model_ids() -> Option[ModelIds]:
	inventory = sample_inventory()
	match (inventory_functions(inventory), inventory_records(inventory), inventory_unions(inventory)):
		([first, second, _, _], [record0, record1, record2, record3], [union0, union1, union2, union3, union4]):
			-- Issue both nominal leaves together; shared no-opaque fixtures stay unchanged.
			opaque_inventory = issue_inventory([], [], [], [
				{
					module = first.declaration.module,
					visibility = first.declaration.visibility,
					type_name = record0.declaration.type_name,
					type_parameters = [],
					underlying = AtomicType(record0.declaration.type_name),
				},
				{
					module = second.declaration.module,
					visibility = second.declaration.visibility,
					type_name = record1.declaration.type_name,
					type_parameters = [],
					underlying = AtomicType(record0.declaration.type_name),
				},
			], [], [])
			match inventory_opaques(opaque_inventory):
				[opaque0, opaque1]:
					Some({
						function0 = first.id,
						function1 = second.id,

						record0 = record0.id,
						record1 = record1.id,
						record2 = record2.id,
						record3 = record3.id,
						union0 = union0.id,
						union1 = union1.id,
						union2 = union2.id,
						union3 = union3.id,
						union4 = union4.id,
						opaque0 = opaque0.id,
						opaque1 = opaque1.id,
					})
				_: None
		_: None


private pure func function_parameter(function: FunctionId, position: Int) -> TypeRef:
	ParameterType(type_parameter_id(FunctionDeclaration(function), position))


-- One representative of every TypeRef form; equal positions denote equal types.
private pure func representatives(ids: ModelIds) -> List[TypeRef]:
	[
		VoidType,
		IntType,
		FloatType,
		StringType,
		ListType(StringType),
		ListType(function_parameter(ids.function0, 0)),
		NominalType(AggregateNominal(RecordAggregate(ids.record0)), []),
		NominalType(AggregateNominal(RecordAggregate(ids.record1)), []),
		NominalType(AggregateNominal(UnionAggregate(ids.union0)), []),
		NominalType(AggregateNominal(UnionAggregate(ids.union1)), []),
		NominalType(OpaqueNominal(ids.opaque0), []),
		NominalType(OpaqueNominal(ids.opaque1), []),
		ListType(NominalType(OpaqueNominal(ids.opaque0), [])),
		ListType(NominalType(OpaqueNominal(ids.opaque1), [])),
		NominalType(AggregateNominal(RecordAggregate(ids.record2)), [NominalType(OpaqueNominal(ids.opaque0), [])]),
		NominalType(AggregateNominal(RecordAggregate(ids.record2)), [NominalType(OpaqueNominal(ids.opaque1), [])]),
		NominalType(AggregateNominal(UnionAggregate(ids.union2)), [IntType]),
		NominalType(AggregateNominal(UnionAggregate(ids.union2)), [StringType]),
		NominalType(AggregateNominal(UnionAggregate(ids.union2)), [IntType, IntType]),
		NominalType(AggregateNominal(UnionAggregate(ids.union3)), [IntType]),
		NominalType(AggregateNominal(RecordAggregate(ids.record2)), [IntType]),
		NominalType(AggregateNominal(RecordAggregate(ids.record2)), [StringType]),
		NominalType(AggregateNominal(RecordAggregate(ids.record2)), [IntType, StringType]),
		NominalType(AggregateNominal(RecordAggregate(ids.record2)), [StringType, IntType]),
		NominalType(AggregateNominal(RecordAggregate(ids.record3)), [IntType]),
		function_parameter(ids.function0, 0),
		function_parameter(ids.function0, 1),
		function_parameter(ids.function1, 0),
		ParameterType(type_parameter_id(UnionDeclaration(ids.union0), 0)),
		ParameterType(type_parameter_id(UnionDeclaration(ids.union1), 0)),
		ParameterType(type_parameter_id(RecordDeclaration(ids.record0), 0)),
		ParameterType(type_parameter_id(RecordDeclaration(ids.record1), 0)),
		CallableType(Pure, [], VoidType),
		CallableType(Pure, [], IntType),
		CallableType(Pure, [IntType], IntType),
		CallableType(Pure, [StringType], IntType),
		CallableType(Pure, [IntType], StringType),
		CallableType(Pure, [IntType, StringType], IntType),
		CallableType(Pure, [StringType, IntType], IntType),
		CallableType(Pure, [ListType(function_parameter(ids.function0, 0))], IntType),
		CallableType(Pure, [ListType(function_parameter(ids.function1, 0))], IntType),
		CallableType(Pure, [IntType], function_parameter(ids.function0, 0)),
		CallableType(Pure, [IntType], function_parameter(ids.function1, 0)),
	]


pure func test_type_equality_is_structural_and_distinguishes_every_form() -> Bool:
	match model_ids():
		None: False
		Some(ids):
			left_types = representatives(ids)
			right_types = representatives(ids)
			var correct = True
			var left_position = 0

			for left in left_types:
				var right_position = 0

				for right in right_types:
					correct = correct and left == right == (left_position == right_position)
					right_position = right_position + 1

				left_position = left_position + 1

			correct


pure func test_parameter_identity_compares_owner_kind_owner_and_position() -> Bool:
	match model_ids():
		None: False
		Some(ids):
			function_first = type_parameter_id(FunctionDeclaration(ids.function0), 0)
			union_first = type_parameter_id(UnionDeclaration(ids.union0), 0)
			(
				function_first == type_parameter_id(FunctionDeclaration(ids.function0), 0)
				and not (function_first == union_first)
				and not (function_first == type_parameter_id(FunctionDeclaration(ids.function0), 1))
				and parameter_position(type_parameter_id(UnionDeclaration(ids.union4), 2)) == 2
			)


pure func test_callable_parameter_identity_compares_owner_and_written_position() -> Bool:
	match model_ids():
		None: False
		Some(ids):
			first = callable_parameter(ids.function0, 1)
			(
				first == callable_parameter(ids.function0, 1)
				and not (first == callable_parameter(ids.function1, 1))
				and not (first == callable_parameter(ids.function0, 2))
				and function_number(callable_owner(first)) == function_number(ids.function0)
				and callable_position(first) == 1
			)


pure func test_checked_identities_retain_their_components() -> Bool:
	match model_ids():
		None: False
		Some(ids):
			field = field_id(ids.record3, 1)
			(
				record_number(field_owner(field)) == 3
				and field_number(field) == 1
				and binding_number(binding_id(5)) == 5
			)


pure func test_type_vectors_preserve_empty_length_and_order() -> Bool:
	(
		[] == []
		and not ([] == [IntType])
		and not ([IntType] == [])
		and not ([IntType] == [IntType, StringType])
		and not ([IntType, StringType] == [IntType])
		and [IntType, StringType] == [IntType, StringType]
		and not ([IntType, StringType] == [StringType, IntType])
	)


pure func test_type_vectors_compare_nested_nominal_owners() -> Bool:
	match model_ids():
		None: False
		Some(ids):
			first = NominalType(AggregateNominal(RecordAggregate(ids.record0)), [
				NominalType(AggregateNominal(UnionAggregate(ids.union0)), [ListType(function_parameter(ids.function0, 0))]),
				StringType,
			])
			equal = NominalType(AggregateNominal(RecordAggregate(ids.record0)), [
				NominalType(AggregateNominal(UnionAggregate(ids.union0)), [ListType(function_parameter(ids.function0, 0))]),
				StringType,
			])
			other_union = NominalType(AggregateNominal(RecordAggregate(ids.record0)), [
				NominalType(AggregateNominal(UnionAggregate(ids.union1)), [ListType(function_parameter(ids.function0, 0))]),
				StringType,
			])
			other_parameter = NominalType(AggregateNominal(RecordAggregate(ids.record0)), [
				NominalType(AggregateNominal(UnionAggregate(ids.union0)), [ListType(function_parameter(ids.function1, 0))]),
				StringType,
			])
			other_record = NominalType(AggregateNominal(RecordAggregate(ids.record1)), [
				NominalType(AggregateNominal(UnionAggregate(ids.union0)), [ListType(function_parameter(ids.function0, 0))]),
				StringType,
			])
			(
				[first, VoidType] == [equal, VoidType]
				and not ([first, VoidType] == [other_union, VoidType])
				and not ([first, VoidType] == [other_parameter, VoidType])
				and not ([first, VoidType] == [other_record, VoidType])
				and not ([first, VoidType] == [equal, StringType])
			)


tests: TestSuite = {
	description = "Blorp 2 checked program model",
	tests = [
		(
			"callable parameter identity compares owner and written position",
			test_callable_parameter_identity_compares_owner_and_written_position,
		),
		("type vectors preserve empty length and order", test_type_vectors_preserve_empty_length_and_order),
		("type vectors compare nested nominal owners", test_type_vectors_compare_nested_nominal_owners),
		(
			"type equality is structural and distinguishes every form",
			test_type_equality_is_structural_and_distinguishes_every_form,
		),
		(
			"parameter identity compares owner kind, owner and position",
			test_parameter_identity_compares_owner_kind_owner_and_position,
		),
		("checked identities retain their components", test_checked_identities_retain_their_components),
	]
}
