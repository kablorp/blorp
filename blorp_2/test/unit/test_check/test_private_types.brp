import:
	../../../src/check/check: check, check_errors
	../../../src/check/errors as Errors: CheckErrorKind
	../../../src/check/render: render_failure
	../../../src/namespace/namespace: Unoffered(PrivateName)
	../../../src/parse/assemble: ParsedProgram, parsed_contents
	../../../src/utils/names: same_name
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: Diagnostic
	../module_input: ModuleInput, parse_modules
	../input: existing_name
	test: TestSuite


private SECRET: String = "private fixed record Secret { value: Int }\n"
private MAIN: String = "func main() -> Int:\n    0\n"


private pure func single(source: String) -> Result[ParsedProgram, Diagnostic]:
	parse_modules([{ source = source, targets = [] }])


-- The prefix ends at the offending written name, so every test pins that
-- occurrence independently of the declaration that gave Secret its identity.
private pure func rejects_private(parsed: Result[ParsedProgram, Diagnostic], prefix: String, owner: String) -> Bool:
	match parsed:
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					errors = check_errors(failure)
					names = parsed_contents(program).names
					typed = match errors.first.kind:
						Errors.TypeTermRejection(Errors.PrivateTypeInPublicDeclaration(private_type, declaration)):
							match (existing_name(names, "Secret"), existing_name(names, owner)):
								(Some(expected_private), Some(expected_public)):
									same_name(private_type, expected_private) and same_name(declaration, expected_public)
								_: False
						_: False
					diagnostics = render_failure(failure)
					error = diagnostics.first
					(
						typed
						and errors.first.span.start == prefix.length()
						and errors.first.span.end == prefix.length() + "Secret".length()
						and diagnostics.remaining.is_empty()
						and check_errors(failure).remaining.is_empty()
						and same_source(error.span.source, module_source(root_module_id()))
						and error.span.start == prefix.length()
						and error.span.end == prefix.length() + "Secret".length()
						and error.message == "Secret is private but appears in public declaration " + owner
						and error.help == "make Secret public, or make " + owner + " private"
						and error.note.is_none()
					)


private pure func exposure(prefix: String, suffix: String, owner: String) -> Bool:
	rejects_private(single(prefix + "Secret" + suffix + MAIN), prefix, owner)


pure func test_public_parameter_rejects_private_type() -> Bool:
	exposure(SECRET + "pure func reveal(value: ", ") -> Int:\n    0\n", "reveal")


pure func test_public_return_rejects_private_type() -> Bool:
	exposure(SECRET + "pure func reveal() -> ", ":\n    { value = 6 }\n", "reveal")


pure func test_public_record_field_rejects_private_type() -> Bool:
	exposure(SECRET + "fixed record Envelope { value: ", " }\n", "Envelope")


pure func test_public_union_payload_rejects_private_type() -> Bool:
	exposure(SECRET + "fixed union Envelope:\n    Wrapped(", ")\n", "Envelope")


pure func test_public_list_argument_rejects_private_type() -> Bool:
	exposure(SECRET + "pure func reveal(value: List[", "]) -> Int:\n    0\n", "reveal")


pure func test_public_nested_option_list_rejects_private_type() -> Bool:
	exposure(SECRET + "pure func reveal(value: Option[List[", "]]) -> Int:\n    0\n", "reveal")


pure func test_public_generic_record_argument_rejects_private_type() -> Bool:
	box = "fixed record Box[T] { value: T }\n"
	exposure(SECRET + box + "pure func reveal(value: Box[", "]) -> Int:\n    0\n", "reveal")


pure func test_public_generic_union_argument_rejects_private_type() -> Bool:
	box = "fixed union Box[T]:\n    Wrapped(T)\n"
	exposure(SECRET + box + "pure func reveal(value: Box[", "]) -> Int:\n    0\n", "reveal")


pure func test_private_head_rejection_precedes_invalid_arity() -> Bool:
	exposure(SECRET + "pure func reveal(value: ", "[Int]) -> Int:\n    0\n", "reveal")


pure func test_qualified_public_wrapper_keeps_argument_access() -> Bool:
	prefix = "import:\n    ./boxes as B\n" + SECRET + "pure func reveal(value: B.Box["
	rejects_private(
		parse_modules([
			{ source = prefix + "Secret]) -> Int:\n    0\n" + MAIN, targets = [1] },
			{ source = "fixed record Box[T] { value: T }\n", targets = [] },
		]),
		prefix,
		"reveal",
	)


private pure func preserves_error(
	parsed: Result[ParsedProgram, Diagnostic],
	prefix: String,
	length: Int,
	matches: pure (CheckErrorKind) -> Bool,
	message: String,
	help: String,
) -> Bool:
	match parsed:
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					errors = check_errors(failure)
					diagnostics = render_failure(failure)
					error = diagnostics.first
					(
						errors.remaining.is_empty() and matches(errors.first.kind)
						and diagnostics.remaining.is_empty()
						and same_source(error.span.source, module_source(root_module_id()))
						and error.span.start == prefix.length() and error.span.end == prefix.length() + length
						and error.message == message and error.help == help and error.note.is_none()
					)


pure func test_qualified_private_head_keeps_existing_rejection() -> Bool:
	prefix = "import:\n    ./boxes as B\npure func reveal(value: B."
	payload = "Secret) -> Int:\n    0\n"
	preserves_error(
		parse_modules([
			{ source = prefix + payload + MAIN, targets = [1] },
			{ source = SECRET, targets = [] },
		]),
		prefix, "Secret".length(),
		(pure func(kind: CheckErrorKind) -> Bool:
			match kind:
				Errors.QualifiedRejection(Errors.QualifiedNotOffered(_, _, _, PrivateName)): True
				_: False
		),
		"Secret is private to ./boxes",
		"remove private or qualify a public declaration",
	)


pure func test_unknown_atomic_type_keeps_existing_rejection() -> Bool:
	prefix = "pure func reveal(value: "
	preserves_error(single(prefix + "Missing) -> Int:\n    0\n" + MAIN), prefix, 7,
		(pure func(kind: CheckErrorKind) -> Bool:
			match kind:
				Errors.TypeTermRejection(Errors.UnknownType(_)): True
				_: False
		),
		"unknown type", "declare or import this type; builtin types and declared type parameters are also available",
	)


pure func test_unknown_applied_type_keeps_existing_rejection() -> Bool:
	prefix = SECRET + "pure func reveal(value: "
	preserves_error(single(prefix + "Missing[Secret]) -> Int:\n    0\n" + MAIN), prefix, 7,
		(pure func(kind: CheckErrorKind) -> Bool:
			match kind:
				Errors.TypeTermRejection(Errors.NonApplicableType(_)): True
				_: False
		),
		"type does not accept a type argument", "apply a declared generic union or record, such as Box[Int]",
	)


pure func test_public_head_applicability_precedes_private_argument() -> Bool:
	prefix = SECRET + "fixed record Box { value: Int }\npure func reveal(value: "
	preserves_error(single(prefix + "Box[Secret]) -> Int:\n    0\n" + MAIN), prefix, "Box[Secret]".length(),
		(pure func(kind: CheckErrorKind) -> Bool:
			match kind:
				Errors.TypeTermRejection(Errors.OrdinaryRecordApplied(_)): True
				_: False
		),
		"ordinary record does not accept a type argument", "remove the type argument from this record type",
	)


pure func test_public_head_arity_precedes_private_argument() -> Bool:
	prefix = SECRET + "fixed record Box[T] { value: T }\npure func reveal(value: "
	preserves_error(single(prefix + "Box[Secret, Int]) -> Int:\n    0\n" + MAIN), prefix, "Box[Secret, Int]".length(),
		(pure func(kind: CheckErrorKind) -> Bool:
			match kind:
				Errors.TypeTermRejection(Errors.RecordTypeArgumentCountMismatch(_, 1, 2)): True
				_: False
		),
		"record type argument count does not match its declaration", "expected 1 type arguments, got 2; supply types in declaration order",
	)


pure func test_type_parameter_conflict_precedes_private_use() -> Bool:
	prefix = SECRET + "pure func reveal["
	preserves_error(single(prefix + "Secret](value: Secret) -> Secret:\n    value\n" + MAIN), prefix, 6,
		(pure func(kind: CheckErrorKind) -> Bool:
			match kind:
				Errors.TypeDeclarationRejection(Errors.TypeParameterTypeNameConflict(_)): True
				_: False
		),
		"type parameter conflicts with a type name", "choose a distinct type parameter name, such as T",
	)


private pure func accepted(source: String) -> Bool:
	match single(source + MAIN):
		Err(_): False
		Ok(program): check(program).is_ok()


pure func test_private_declaration_positions_accept_private_types() -> Bool:
	source: String =
		|private fixed record Secret { value: Int }
		|private fixed record Envelope { value: Option[List[Secret]] }
		|private fixed union Hidden:
		|    Wrapped(Secret)
		|private pure func reveal(value: Secret) -> Secret:
		|    value
		|
	accepted(source)


pure func test_public_generic_parameters_and_concrete_types_remain_valid() -> Bool:
	source: String =
		|fixed record Box[T] { value: T }
		|fixed union Envelope[T]:
		|    Wrapped(Box[T])
		|pure func reveal[T](value: T) -> T:
		|    value
		|pure func concrete(value: Box[Int]) -> Box[Int]:
		|    value
		|
	accepted(source)


pure func test_body_only_private_type_remains_valid() -> Bool:
	source: String =
		|private fixed record Secret { value: Int }
		|private pure func secret() -> Secret:
		|    { value = 6 }
		|pure func reveal() -> Int:
		|    secret().value
		|
	accepted(source)


pure func test_imported_public_types_remain_valid() -> Bool:
	source: String =
		|import:
		|    ./boxes as B: Box
		|pure func reveal(value: Box[Int]) -> B.Box[Int]:
		|    value
		|
	match parse_modules([
		{ source = source + MAIN, targets = [1] },
		{ source = "fixed record Box[T] { value: T }\n", targets = [] },
	]):
		Err(_): False
		Ok(program): check(program).is_ok()


tests: TestSuite = {
	description = "Private types in public annotations",
	tests = [
		("public parameter rejects private type", test_public_parameter_rejects_private_type),
		("public return rejects private type", test_public_return_rejects_private_type),
		("public record field rejects private type", test_public_record_field_rejects_private_type),
		("public union payload rejects private type", test_public_union_payload_rejects_private_type),
		("public List argument rejects private type", test_public_list_argument_rejects_private_type),
		("nested Option and List reject private type", test_public_nested_option_list_rejects_private_type),
		("generic record argument rejects private type", test_public_generic_record_argument_rejects_private_type),
		("generic union argument rejects private type", test_public_generic_union_argument_rejects_private_type),
		("private head rejection precedes invalid arity", test_private_head_rejection_precedes_invalid_arity),
		("qualified public wrapper keeps argument access", test_qualified_public_wrapper_keeps_argument_access),
		("qualified private head keeps existing rejection", test_qualified_private_head_keeps_existing_rejection),
		("unknown atomic type keeps existing rejection", test_unknown_atomic_type_keeps_existing_rejection),
		("unknown applied type keeps existing rejection", test_unknown_applied_type_keeps_existing_rejection),
		("public head applicability precedes private argument", test_public_head_applicability_precedes_private_argument),
		("public head arity precedes private argument", test_public_head_arity_precedes_private_argument),
		("type parameter conflict precedes private use", test_type_parameter_conflict_precedes_private_use),
		("private declaration positions accept private types", test_private_declaration_positions_accept_private_types),
		("public generics and concrete types remain valid", test_public_generic_parameters_and_concrete_types_remain_valid),
		("body-only private type remains valid", test_body_only_private_type_remains_valid),
		("imported public types remain valid", test_imported_public_types_remain_valid),
	]
}
