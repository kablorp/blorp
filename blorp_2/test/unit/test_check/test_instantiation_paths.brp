import:
	../../../src/check/instantiation_paths: InstantiationPath, PathOperation(KeepPath, PushPath, PopPath), PathBoundedness(BoundedPaths, UnboundedPaths), bound_instantiation_paths
	bool: and
	int as IntOps
	option: is_none
	test: TestSuite


-- These are analysis-local controls/symbols, not fabricated semantic IDs.
private pure func bounded(count: Int, paths: List[InstantiationPath]) -> Bool:
	match bound_instantiation_paths(count, paths):
		Some(BoundedPaths): True
		Some(UnboundedPaths(_)):
			False
		None: False


private pure func marks_all(count: Int, paths: List[InstantiationPath]) -> Bool:
	match bound_instantiation_paths(count, paths):
		Some(BoundedPaths): False
		Some(UnboundedPaths(marked)):
			var complete: Bool = IntOps.equals(marked.length(), paths.length())
			for position in 0..paths.length():
				complete = and(complete, marked.any(pure func(found): IntOps.equals(found, position)))
			complete
		None: False


pure func test_empty_and_epsilon_paths_are_bounded() -> Bool:
	and(bounded(0, []), bounded(2, [
		{ source = 0, target = 1, operation = KeepPath },
		{ source = 1, target = 0, operation = KeepPath }
	]))


pure func test_an_unmatched_push_cycle_is_unbounded() -> Bool:
	marks_all(1, [{ source = 0, target = 0, operation = PushPath(0) }])


pure func test_a_pop_cycle_only_consumes_finite_input() -> Bool:
	bounded(1, [{ source = 0, target = 0, operation = PopPath(0) }])


pure func test_matching_push_pop_cycle_is_bounded() -> Bool:
	bounded(2, [
		{ source = 0, target = 1, operation = PushPath(0) },
		{ source = 1, target = 0, operation = PopPath(0) }
	])


pure func test_a_default_peek_is_not_unconditional_epsilon() -> Bool:
	bounded(2, [
		{ source = 0, target = 1, operation = PopPath(0) },
		{ source = 1, target = 0, operation = PushPath(0) }
	])


pure func test_different_constructor_slots_cannot_cancel() -> Bool:
	bounded(3, [
		{ source = 0, target = 1, operation = PushPath(0) },
		{ source = 1, target = 2, operation = PopPath(1) },
		{ source = 2, target = 0, operation = PushPath(2) }
	])


pure func test_guarded_wrapping_retains_the_unmatched_push() -> Bool:
	marks_all(3, [
		{ source = 0, target = 1, operation = PopPath(1) },
		{ source = 1, target = 2, operation = PushPath(0) },
		{ source = 2, target = 0, operation = PushPath(1) }
	])


pure func test_three_list_field_dispatch_does_not_select_box_head() -> Bool:
	bounded(3, [
		{ source = 0, target = 1, operation = PushPath(0) },
		{ source = 1, target = 2, operation = PushPath(0) },
		{ source = 2, target = 0, operation = PopPath(1) },
		{ source = 2, target = 2, operation = PopPath(0) }
	])


pure func test_phantom_default_and_list_dispatch_have_finite_paths() -> Bool:
	bounded(5, [
		{ source = 0, target = 1, operation = KeepPath },
		{ source = 1, target = 2, operation = KeepPath },
		{ source = 2, target = 3, operation = PushPath(0) },
		{ source = 3, target = 2, operation = PopPath(0) },
		{ source = 3, target = 4, operation = PopPath(1) },
		{ source = 4, target = 0, operation = PushPath(1) }
	])


pure func test_all_overlapping_pumps_are_marked_in_both_orders() -> Bool:
	forward: List[InstantiationPath] = [
		{ source = 0, target = 1, operation = PushPath(0) },
		{ source = 1, target = 0, operation = KeepPath },
		{ source = 1, target = 2, operation = PushPath(0) },
		{ source = 2, target = 1, operation = KeepPath }
	]
	var reverse: List[InstantiationPath] = []
	for path in forward:
		reverse = [path].concat(reverse)
	and(marks_all(3, forward), marks_all(3, reverse))


pure func test_every_alternative_balanced_derivation_is_marked() -> Bool:
	paths: List[InstantiationPath] = [
		{ source = 0, target = 1, operation = PushPath(0) },
		{ source = 1, target = 0, operation = KeepPath },
		{ source = 1, target = 3, operation = PushPath(1) },
		{ source = 3, target = 4, operation = KeepPath },
		{ source = 4, target = 0, operation = PopPath(1) }
	]
	var reverse: List[InstantiationPath] = []
	for path in paths:
		reverse = [path].concat(reverse)
	and(marks_all(5, paths), marks_all(5, reverse))


pure func test_compact_composition_has_no_expanded_numeric_weights() -> Bool:
	var paths: List[InstantiationPath] = []
	for level in 1..66:
		paths = paths.append({ source = level, target = IntOps.subtract(level, 1), operation = PushPath(IntOps.subtract(level, 1)) })
	for head in 0..66:
		paths = paths.append({ source = 0, target = head, operation = PopPath(head) })
	bounded(66, paths)


pure func test_unrelated_nonpump_transitions_are_not_marked() -> Bool:
	paths: List[InstantiationPath] = [
		{ source = 0, target = 0, operation = PushPath(0) },
		{ source = 1, target = 2, operation = KeepPath }
	]
	match bound_instantiation_paths(3, paths):
		Some(UnboundedPaths([position])): IntOps.equals(position, 0)
		_: False


pure func test_matching_cancellation_exposes_a_growing_cycle() -> Bool:
	marks_all(3, [
		{ source = 0, target = 1, operation = PushPath(0) },
		{ source = 1, target = 2, operation = PopPath(0) },
		{ source = 2, target = 0, operation = PushPath(2) }
	])


pure func test_malformed_local_domains_do_not_produce_a_bound() -> Bool:
	validations: List[Bool] = [
		bound_instantiation_paths(-1, []).is_none(),
		bound_instantiation_paths(IntOps.INT_MAX, []).is_none(),
		bound_instantiation_paths(1, [{ source = 1, target = 0, operation = KeepPath }]).is_none(),
		bound_instantiation_paths(1, [{ source = 0, target = -1, operation = KeepPath }]).is_none(),
		bound_instantiation_paths(1, [{ source = 0, target = 0, operation = PushPath(-1) }]).is_none()
	]
	validations.all(pure func(valid): valid)


tests: TestSuite = {
	description = "Constructor-path instantiation boundedness",
	tests = [
		("empty and epsilon paths are bounded", test_empty_and_epsilon_paths_are_bounded),
		("an unmatched push cycle grows", test_an_unmatched_push_cycle_is_unbounded),
		("a pop cycle consumes finite input", test_a_pop_cycle_only_consumes_finite_input),
		("matching push and pop stay bounded", test_matching_push_pop_cycle_is_bounded),
		("a default peek retains its guard", test_a_default_peek_is_not_unconditional_epsilon),
		("distinct constructor slots cannot cancel", test_different_constructor_slots_cannot_cancel),
		("matching cancellation exposes a growing cycle", test_matching_cancellation_exposes_a_growing_cycle),
		("malformed local domains are rejected", test_malformed_local_domains_do_not_produce_a_bound),
		("guarded wrapping still grows", test_guarded_wrapping_retains_the_unmatched_push),
		("a three-List field cannot select Box prematurely", test_three_list_field_dispatch_does_not_select_box_head),
		("Phantom default dispatch has finite paths", test_phantom_default_and_list_dispatch_have_finite_paths),
		("all overlapping pumps are order independent", test_all_overlapping_pumps_are_marked_in_both_orders),
		("all balanced derivations contribute provenance", test_every_alternative_balanced_derivation_is_marked),
		("compact 65-level composition remains bounded", test_compact_composition_has_no_expanded_numeric_weights),
		("unrelated transitions are not marked", test_unrelated_nonpump_transitions_are_not_marked)
	]
}
