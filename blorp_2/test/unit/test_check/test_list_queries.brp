import:
	../../../src/load/load: load_program
	../../../src/parse/assemble: parsed_contents
	../../../src/check/check: check, checked_functions, check_errors
	../../../src/check/model as Model
	../../../src/check/errors as Errors
	../../../src/utils/ids: inventory_functions, inventory_unions, function_number, union_number
	../../../src/utils/names: name_spelling, foundation_words
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: Purity(Pure), same_purity
	../input: setup_diagnostic, singleton_check_error
	fs: temporary_directory, resource_path, message
	system: temp_dir, write_file
	test: TestSuite


private QUERY_MAIN: String =
	|import:
	|    list: get_or
	|func main() -> Int:
	|


func test_query_signatures_keep_their_own_rigids_and_foundation_types() -> Bool:
	match load_program("blorp_2/test/e2e/fixtures/generic/managed/list_queries.brp", "blorp_2/standard_library"):
		Err(_): False
		Ok(loaded):
			parsed = parsed_contents(loaded.program)
			match (parsed.modules.filter(pure func(row): row.module == root_module_id()), check(loaded.program)):
				([root], Ok(program)):
					rows = checked_functions(program)
					list_imports = root.imports.filter(pure func(request): request.path.parts.map(pure func(part): name_spelling(parsed.names, part)) == [Some("list")])
					booleans = inventory_unions(parsed.declarations).filter(pure func(row): row.module == parsed.foundation.types and row.type_name.id == foundation_words(parsed.names).bool_word)
					optionals = inventory_unions(parsed.declarations).filter(pure func(row): row.module == parsed.foundation.types and row.type_name.id == foundation_words(parsed.names).option_word)
					match (list_imports, booleans, optionals):
						([list_import], [boolean_row], [optional_row]):
							boolean = rows.unions.get(union_number(boolean_row.id))
							optional = rows.unions.get(union_number(optional_row.id))
							match (boolean, optional):
								(Some(boolean), Some(optional)):
									functions = inventory_functions(parsed.declarations).filter(pure func(row): row.declaration.module == list_import.target)
									fallback_functions = functions.filter(pure func(row): name_spelling(parsed.names, row.declaration.function_name.id) == Some("get_or"))
									empty_functions = functions.filter(pure func(row): name_spelling(parsed.names, row.declaration.function_name.id) == Some("is_empty"))
									final_functions = functions.filter(pure func(row): name_spelling(parsed.names, row.declaration.function_name.id) == Some("last"))
									match (fallback_functions, empty_functions, final_functions):
										([fallback_row], [empty_row], [final_row]):
											match (rows.functions.get(function_number(fallback_row.id)), rows.functions.get(function_number(empty_row.id)), rows.functions.get(function_number(final_row.id))):
												(Some(fallback), Some(empty), Some(final)):
													match (fallback.signature.type_parameters, empty.signature.type_parameters, final.signature.type_parameters):
														([t], [u], [v]):
															owned = [fallback, empty, final].all(pure func(function):
																match function.signature.type_parameters:
																	[parameter]:
																		match Model.parameter_owner(parameter):
																			Model.FunctionDeclaration(owner): function_number(owner) == function_number(function.id) and same_purity(function.signature.purity, Pure)
																			_: False
																	_: False
															)
															match (fallback.signature.parameters, empty.signature.parameters, final.signature.parameters):
																([values, index, default], [queried], [ended]):
																	(
																		owned and not Model.same_parameter(t, u) and not Model.same_parameter(t, v) and not Model.same_parameter(u, v)
																		and Model.same_type(values.value_type, Model.ListType(Model.ParameterType(t)))
																		and Model.same_type(index.value_type, Model.IntType) and Model.same_type(default.value_type, Model.ParameterType(t))
																		and Model.same_type(fallback.signature.return_type.value_type, Model.ParameterType(t))
																		and Model.same_type(queried.value_type, Model.ListType(Model.ParameterType(u)))
																		and Model.same_type(empty.signature.return_type.value_type, Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(boolean.id)), []))
																		and Model.same_type(ended.value_type, Model.ListType(Model.ParameterType(v)))
																		and Model.same_type(final.signature.return_type.value_type, Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(optional.id)), [Model.ParameterType(v)]))
																	)
																_: False
														_: False
												_: False
										_: False
								_: False
						_: False
				_: False


private func rejects_bad_argument(prefix: String, suffix: String, position: Int) -> Result[Bool, String]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-list-query-negative-") on error => message(error):
		path = directory.resource_path() + "/main.brp"
		marked = "\"bad\""
		written ?= write_file(path, prefix + marked + suffix)
		loaded ?= load_program(path, "blorp_2/standard_library").map_err(func(failure): failure.diagnostic.message)
		match check(loaded.program):
			Ok(_): Ok(False)
			Err(failure):
				diagnostic = setup_diagnostic(failure)
				match singleton_check_error(check_errors(failure)):
					Some(error):
						mismatch = match error.kind:
							Errors.CallRejection(Errors.ArgumentTypeMismatch(actual)):
								if position == 1:
									Some(actual)
								else:
									None
							Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
								if position == 2 and Model.same_type(conflict.previous.value_type, Model.IntType) and Model.same_type(conflict.current.value_type, Model.StringType):
									Some(conflict.mismatch)
								else:
									None
							_: None
						Ok(mismatch.map(pure func(actual):
							(
								actual.argument_position == position and Model.same_type(actual.expected, Model.IntType)
								and Model.same_type(actual.actual.value_type, Model.StringType)
								and actual.actual.span.source == module_source(root_module_id())
								and actual.actual.span.start == prefix.length() and actual.actual.span.end == prefix.length() + marked.length()
								and error.span.source == actual.actual.span.source and error.span.start == actual.actual.span.start and error.span.end == actual.actual.span.end
								and diagnostic.message == "argument type does not match the parameter type"
								and diagnostic.help == "use an expression of type Int here" and diagnostic.note.is_none()
							)
						).get_or(False))
					None: Ok(False)


func test_bad_index_is_a_typed_argument_mismatch() -> Bool:
	rejects_bad_argument(QUERY_MAIN + "    get_or([1], ", ", 0)\n", 1).get_or(False)


func test_bad_default_conflicts_with_the_list_element_rigid() -> Bool:
	rejects_bad_argument(QUERY_MAIN + "    get_or([1], 0, ", ")\n", 2).get_or(False)


tests: TestSuite = {
	description = "Blorp 2 target List query checking",
	tests = [
		("List queries keep function-owned rigids and foundation results", test_query_signatures_keep_their_own_rigids_and_foundation_types),
		("List get_or rejects a String index at the actual argument", test_bad_index_is_a_typed_argument_mismatch),
		("List get_or rejects a mismatched eager default at the actual argument", test_bad_default_conflicts_with_the_list_element_rigid),
	]
}
