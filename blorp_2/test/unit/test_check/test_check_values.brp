import:
	../../../src/check/check_render: render_failure
	../../../src/utils/declarations: function_number
	../../../src/check/check: checked_functions, check_errors
	../../../src/check/check_errors:
		CheckErrorKind(CallRejection, ValueRejection, ConstructorRejection),
		CallError(UncallableBinding, UnknownFunction),
		ValueError(UnknownValue),
		ConstructorError(VariantNotInExpectedType),
	../../../src/check/check_model:
		BindingOrigin(ParameterBinding),
		CallTarget(UserFunction, RuntimeFunction),
		CheckedBody(CheckedValueBody),
		CheckedExit(ReturnExpression),
		CheckedExpr,
		CheckedForm(ConstructVariant, InvokeFunction, LiteralInteger, ReadBinding),
		CheckedFunction,
		CheckedStatement(InitializeBinding),
		TypeRef(IntType),
		TypeUse,
		same_type,
	../../../src/utils/syntax: Purity(Pure), entry_function
	../input: check, checked_source, rejects_at
	../module_input: parse_modules
	test: TestSuite


private pure func user_function_number(target: CallTarget) -> Option[Int]:
	match target:
		UserFunction(id, _):
			Some(function_number(id))
		RuntimeFunction(_):
			None


private pure func returned(function: CheckedFunction) -> Option[CheckedExpr]:
	match function.body:
		CheckedValueBody(ReturnExpression(value)):
			Some(value)
		_:
			None


private pure func returned_form(function: CheckedFunction) -> Option[CheckedForm]:
	match returned(function):
		Some(value):
			Some(value.form)
		None:
			None


private pure func integer_parameter(shape: List[TypeUse]) -> Bool:
	match shape:
		[type_ref]:
			same_type(type_ref.value_type, IntType)
		_:
			False


private pure func no_parameter(shape: List[TypeUse]) -> Bool:
	match shape:
		[]:
			True
		_:
			False


pure func test_unknown_callee_diagnostic() -> Bool:
	source: String =
		|func main() -> Int:
		|	missing()
		|
	rejects_at(source, 21, 28, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(UnknownFunction(_)):
				True
			_:
				False
	)


pure func test_unreachable_unknown_callee_diagnostic() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|func one() -> Int:
		|	missing()
		|
	rejects_at(source, 43, 50, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(UnknownFunction(_)):
				True
			_:
				False
	)


pure func test_unknown_bare_value_is_rejected() -> Bool:
	source: String =
		|func main() -> Int:
		|	value
		|
	rejects_at(source, 21, 26, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ValueRejection(UnknownValue(_)):
				True
			_:
				False
	)


pure func test_parameter_cannot_be_called_as_global_function() -> Bool:
	source: String =
		|func one() -> Int:
		|	1
		|func use(one: Int) -> Int:
		|	one()
		|func main() -> Int:
		|	use(1)
		|
	rejects_at(source, 50, 53, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(UncallableBinding(_, ParameterBinding(_), IntType)):
				True
			_:
				False
	)


pure func test_parameter_does_not_leak_to_other_function() -> Bool:
	source: String =
		|func helper(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	value
		|
	rejects_at(source, 60, 65, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ValueRejection(UnknownValue(_)):
				True
			_:
				False
	)


pure func test_argument_does_not_use_callee_parameter_scope() -> Bool:
	source: String =
		|func identity(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	identity(value)
		|
	rejects_at(source, 71, 76, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ValueRejection(UnknownValue(_)):
				True
			_:
				False
	)


pure func test_parameter_slot_and_repeated_wrappers() -> Bool:
	source: String =
		|pure func one() -> Int:
		|	1
		|pure func identity(one: Int) -> Int:
		|	one
		|func main() -> Int:
		|	identity(identity(1))
		|

	match checked_source(source):
		Err(_):
			False
		Ok(program):
			checked = checked_functions(program)

			match checked.functions:
				[first, identity, main]:
					parameter_is_value: Bool = match returned_form(identity):
						Some(ReadBinding(_)):
							True
						_:
							False

					match returned_form(main):
						Some(InvokeFunction(outer, [nested])):
							match nested.form:
								InvokeFunction(inner, [literal]):
									match literal.form:
										LiteralInteger(1):
											(
												parameter_is_value
												and integer_parameter(identity.signature.parameters)
												and identity.signature.purity == Pure
												and no_parameter(first.signature.parameters)
												and no_parameter(main.signature.parameters)
												and user_function_number(inner.target) == Some(1)
												and user_function_number(outer.target) == Some(1)
												and inner.span.start == 99
												and inner.span.end == 107
												and outer.span.start == 90
												and outer.span.end == 98
												and function_number(entry_function(checked.entrypoint)) == 2
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_parameter_still_shadows_direct_unary_target() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func use(identity: Int) -> Int:
		|	identity(identity)
		|func main() -> Int:
		|	use(1)
		|
	rejects_at(source, 84, 92, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(UncallableBinding(_, ParameterBinding(_), IntType)):
				True
			_:
				False
	)


pure func test_case_distinct_interned_name_is_not_a_declaration() -> Bool:
	source: String =
		|pure func One() -> Int:
		|	1
		|func main() -> Int:
		|	one()
		|
	rejects_at(source, 48, 51, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(UnknownFunction(_)):
				True
			_:
				False
	)


pure func test_signed_integer_value_survives_checking() -> Bool:
	source: String =
		|func main() -> Int:
		|	-42
		|

	match checked_source(source):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[function]:
					match returned_form(function):
						Some(LiteralInteger(value)):
							value == -42
						_:
							False
				_:
					False


-- The root sees TestOption without its constructors, and its own TestNone
-- shares the position of TestOption's. Only the expected union's own variant
-- may construct it.
pure func test_constructor_of_another_union_is_not_a_variant_of_the_expected_union() -> Bool:
	option: String =
		|fixed union TestOption[T]:
		|    TestSome(T)
		|    TestNone
		|
	prefix = "import:\n    ./option: TestOption()\nfixed union Mine:\n    Zero\n    TestNone\npure func empty() -> TestOption[Int]:\n    "
	root = prefix + "TestNone\nfunc main() -> Int:\n    0\n"

	match parse_modules([{ source = root, targets = [1] }, { source = option, targets = [] }]):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					error = check_errors(failure).first
					rendered = render_failure(failure).first

					match error.kind:
						ConstructorRejection(VariantNotInExpectedType(_, _)):
							(
								error.span.start == prefix.length()
								and error.span.end == prefix.length() + "TestNone".length()
								and rendered.message == "variant does not belong to the expected type"
								and rendered.help == "use an expression of type TestOption[Int] here"
							)
						_:
							False


private pure func spans_at(expr: CheckedExpr, start: Int, end: Int) -> Bool:
	expr.span.start == start and expr.span.end == end


-- A receiver chain folds into nested calls, each receiver the first argument.
-- A node's span is its occurrence, from the written receiver to its own postfix;
-- the callee anchor stays on the call.
pure func test_ufcs_chain_nests_each_receiver_as_first_argument() -> Bool:
	source: String =
		|pure func one(value: Int) -> Int:
		|	1
		|pure func zero(value: Int) -> Int:
		|	0
		|func main() -> Int:
		|	7.one().zero()
		|

	match checked_source(source):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[_, _, main]:
					match returned(main):
						Some(outer):
							match outer.form:
								InvokeFunction(zero, [inner]):
									match inner.form:
										InvokeFunction(one, [seven]):
											match seven.form:
												LiteralInteger(7):
													(
														user_function_number(zero.target) == Some(1)
														and user_function_number(one.target) == Some(0)
														and spans_at(outer, 96, 110)
														and spans_at(inner, 96, 103)
														and spans_at(seven, 96, 97)
														and zero.span.start == 104
														and zero.span.end == 108
														and one.span.start == 98
														and one.span.end == 101
														and same_type(outer.value_type, IntType)
													)
												_:
													False
										_:
											False
								_:
									False
						None:
							False
				_:
					False


private pure func argument_integers(expr: CheckedExpr) -> List[Int]:
	match expr.form:
		InvokeFunction(_, arguments):
			var integers: List[Int] = []

			for argument in arguments:
				match argument.form:
					LiteralInteger(integer):
						integers = integers.append(integer)
					_:
						void

			integers
		_:
			[]


pure func test_direct_and_ufcs_calls_share_one_argument_order() -> Bool:
	source: String =
		|pure func pair(left: Int, right: Int) -> Int:
		|	left
		|func main() -> Int:
		|	ufcs = 7.pair(9)
		|	pair(7, 9)
		|

	match checked_source(source):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[_, main]:
					match main.statements:
						[InitializeBinding(_, ufcs)]:
							match returned(main):
								Some(direct):
									match argument_integers(ufcs):
										[7, 9]:
											match argument_integers(direct):
												[7, 9]:
													True
												_:
													False
										_:
											False
								None:
									False
						_:
							False
				_:
					False


pure func test_payload_free_variant_is_a_construct_with_no_arguments() -> Bool:
	source: String =
		|fixed union Step:
		|	Stop
		|	Once
		|pure func pick(step: Step) -> Int:
		|	match step:
		|		Stop: 0
		|		Once: 1
		|func main() -> Int:
		|	pick(Stop)
		|

	match checked_source(source):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[_, main]:
					match returned_form(main):
						Some(InvokeFunction(_, [stop])):
							match stop.form:
								ConstructVariant(_, []):
									True
								_:
									False
						_:
							False
				_:
					False


tests: TestSuite = {
	description = "Blorp 2 value synthesis",
	tests = [
		(
			"UFCS chain nests each receiver as the first argument",
			test_ufcs_chain_nests_each_receiver_as_first_argument,
		),
		(
			"direct and UFCS calls share one argument order",
			test_direct_and_ufcs_calls_share_one_argument_order,
		),
		(
			"payload-free variant is a construct with no arguments",
			test_payload_free_variant_is_a_construct_with_no_arguments,
		),
		(
			"constructor of another union is not a variant of the expected union",
			test_constructor_of_another_union_is_not_a_variant_of_the_expected_union,
		),
		("signed integer value survives checking", test_signed_integer_value_survives_checking),
		(
			"case-distinct interned name is not a declaration",
			test_case_distinct_interned_name_is_not_a_declaration,
		),
		(
			"parameter still shadows direct unary target",
			test_parameter_still_shadows_direct_unary_target,
		),
		("parameter slot and repeated wrappers", test_parameter_slot_and_repeated_wrappers),
		("unknown bare value is rejected", test_unknown_bare_value_is_rejected),
		(
			"parameter call cannot fall through to a global",
			test_parameter_cannot_be_called_as_global_function,
		),
		(
			"parameter does not leak to other functions",
			test_parameter_does_not_leak_to_other_function,
		),
		(
			"argument does not use callee parameter scope",
			test_argument_does_not_use_callee_parameter_scope,
		),
		("unknown callee diagnostic", test_unknown_callee_diagnostic),
		("unreachable unknown callee diagnostic", test_unreachable_unknown_callee_diagnostic),
	]
}
