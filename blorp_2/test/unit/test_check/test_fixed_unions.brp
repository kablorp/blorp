---
A `fixed union` promises inline storage with no counted child: every payload
is a number, Void, another fixed union, a record of numbers or an opaque type
over one of those, and no fixed union contains itself. Type parameters are
rejected by the parser.
---
import:
	../../../src/check/check: check, checked_functions
	../../../src/check/render: render_failure
	../../../src/utils/source: module_source, root_module_id, same_source
	../module_input: TestFoundation, parse_modules, parse_modules_with_base, test_base
	bool: and
	int: Int methods
	option: Option methods
	string: String methods
	test: TestSuite


private ENTRY: String = "func main() -> Int:\n    0\n"
private INLINE_PAYLOAD: String = "a fixed union payload must be stored inline"
private INLINE_PAYLOAD_HELP: String = "use Int, Float, a fixed union or a record of numbers, or remove fixed"
private CONTAINS_ITSELF: String = "a fixed union cannot contain itself"
private CONTAINS_ITSELF_HELP: String = "remove fixed so the union can be stored on the heap"


-- The target foundation declares Bool fixed, and designation accepts it.
private FIXED_BOOL_TYPES: String =
	|type Int = builtin
	|type Float = builtin
	|type String = builtin
	|type Void = builtin
	|type List[T] = builtin
	|fixed union Bool:
	|    True
	|    False
	|union Option[A]:
	|    Some(A)
	|    None
	|union Result[Value, Error]:
	|    Ok(Value)
	|    Err(Error)
	|


private pure func fixed_bool_base() -> TestFoundation:
	{ test_base() | types = FIXED_BOOL_TYPES }


-- How many checked unions were written `fixed`, when the program is accepted.
private pure func accepted_fixed_unions(declarations: String) -> Option[Int]:
	accepted_with_base(declarations, test_base())


private pure func accepted_with_base(declarations: String, foundation: TestFoundation) -> Option[Int]:
	match parse_modules_with_base([{ source = declarations.add(ENTRY), targets = [] }], foundation):
		Err(_): None
		Ok(parsed):
			match check(parsed):
				Err(_): None
				Ok(accepted):
					var count = 0
					for declaration in checked_functions(accepted).unions:
						if declaration.fixed:
							count = count.add(1)
					Some(count)


private pure func rejects(declarations: String, start: Int, end: Int, message: String, help: String) -> Bool:
	match parse_modules([{ source = declarations.add(ENTRY), targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					rendered = render_failure(failure).first
					same_source(rendered.span.source, module_source(root_module_id()))
						.and(rendered.span.start == start).and(rendered.span.end == end)
						.and(rendered.message == message).and(rendered.help == help).and(rendered.note.is_none())


pure func test_payload_free_fixed_union_is_accepted() -> Bool:
	accepted_fixed_unions("union Plain:\n    Only\nfixed union Light:\n    Red\n    Green\n") == Some(1)


pure func test_number_and_void_payloads_are_accepted() -> Bool:
	accepted_fixed_unions("fixed union Reading:\n    Level(Int)\n    Ratio(Float, Int)\n    Unit(Void)\n") == Some(1)


pure func test_fixed_union_payload_is_accepted() -> Bool:
	accepted_fixed_unions("fixed union Signal:\n    Off\n    Level(Int)\nfixed union Event:\n    Quiet\n    Pulse(Signal)\n") == Some(2)


-- `Cell[Int]` is inline because its field, at the argument Int, is a number;
-- a record of records of numbers is inline too.
private RECORDS_OF_NUMBERS: String =
	|fixed record Point { x: Int, y: Float }
	|fixed record Line { start: Point, end: Point }
	|fixed record Cell[T] { value: T, count: Int }
	|fixed union Shape:
	|    At(Point)
	|    Segment(Line)
	|    Counted(Cell[Int])
	|    Nested(Cell[Cell[Float]])
	|


pure func test_record_of_numbers_payloads_are_accepted() -> Bool:
	accepted_fixed_unions(RECORDS_OF_NUMBERS) == Some(1)


-- An opaque type is stored as its underlying type.
private OPAQUE_PAYLOADS: String =
	|fixed record Point { x: Int, y: Int }
	|opaque type Code = Int
	|opaque type Spot = Point
	|fixed union Signal:
	|    Off
	|    Level(Int)
	|opaque type Mode = Signal
	|fixed union Event:
	|    Coded(Code)
	|    Placed(Spot)
	|    Switched(Mode)
	|


pure func test_opaque_payloads_over_fixed_storage_are_accepted() -> Bool:
	accepted_fixed_unions(OPAQUE_PAYLOADS) == Some(2)


pure func test_string_payload_is_rejected() -> Bool:
	rejects("fixed union Named:\n    Label(String)\n", 29, 35, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


pure func test_list_payload_is_rejected() -> Bool:
	rejects("fixed union Batch:\n    Items(List[Int])\n", 29, 38, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


-- The foundation's fixed Bool is one of its two fixed unions.
pure func test_fixed_bool_payload_is_accepted() -> Bool:
	accepted_with_base("fixed union Switch:\n    Flag(Bool)\n", fixed_bool_base()) == Some(2)


-- The default test foundation declares Bool as a plain union.
pure func test_plain_bool_payload_is_rejected() -> Bool:
	rejects("fixed union Switch:\n    Flag(Bool)\n", 29, 33, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


-- Toggle is stored inline today, but it does not promise to stay that way.
pure func test_ordinary_union_payload_is_rejected() -> Bool:
	rejects("union Toggle:\n    On\n    Off\nfixed union Switch:\n    Flag(Toggle)\n", 58, 64, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


pure func test_managed_record_payload_is_rejected() -> Bool:
	rejects("fixed record Person { name: String }\nfixed union Holder:\n    Held(Person)\n", 66, 72, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


-- The record's field is checked at the payload's argument: String is managed.
pure func test_generic_record_at_a_managed_argument_is_rejected() -> Bool:
	rejects(
		"fixed record Cell[T] { value: T }\nfixed union Holder:\n    Count(Cell[Int])\n    Text(Cell[String])\n",
		84, 96, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP,
	)


pure func test_opaque_over_managed_type_is_rejected() -> Bool:
	rejects("opaque type Name = String\nfixed union Holder:\n    Named(Name)\n", 56, 60, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


-- A single self payload is admitted for an ordinary union, which is boxed.
pure func test_direct_self_payload_is_rejected() -> Bool:
	rejects("fixed union Tree:\n    Leaf\n    Node(Tree)\n", 36, 40, CONTAINS_ITSELF, CONTAINS_ITSELF_HELP)


pure func test_repeated_self_payload_reports_the_first() -> Bool:
	rejects("fixed union Tree:\n    Leaf\n    Node(Tree, Tree)\n", 36, 40, CONTAINS_ITSELF, CONTAINS_ITSELF_HELP)


-- The walk starts at First, so Second's payload closes the cycle.
pure func test_mutual_recursion_reports_the_closing_payload() -> Bool:
	rejects(
		"fixed union First:\n    Wrap(Second)\nfixed union Second:\n    Back(First)\n    Stop\n",
		65, 70, CONTAINS_ITSELF, CONTAINS_ITSELF_HELP,
	)


-- A is walked first; C's payload meets D already finished through B.
private DIAMOND: String =
	|fixed union A:
	|    Left(B)
	|    Right(C)
	|fixed union B:
	|    HoldsD(D)
	|fixed union C:
	|    AlsoD(D)
	|fixed union D:
	|    Leaf(Int)
	|


pure func test_diamond_of_fixed_unions_is_accepted() -> Bool:
	accepted_fixed_unions(DIAMOND) == Some(4)


-- A only reaches the cycle between B and C; C's payload closes it.
pure func test_cycle_reached_from_another_union_is_rejected() -> Bool:
	rejects(
		"fixed union A:\n    ToB(B)\nfixed union B:\n    ToC(C)\nfixed union C:\n    Back(B)\n    Stop\n",
		76, 77, CONTAINS_ITSELF, CONTAINS_ITSELF_HELP,
	)


-- A cycle through an opaque type never reaches the fixed union walk:
-- validate_opaque_representations rejects it first, at the payload.
pure func test_cycle_through_an_opaque_type_is_a_recursive_opaque() -> Bool:
	rejects(
		"opaque type Wrapped = Loop\nfixed union Loop:\n    Again(Wrapped)\n    Done\n",
		55, 62,
		"recursive opaque representations are not supported yet",
		"wrap an independently recursive aggregate instead of referring back to the opaque type",
	)


-- The payload rule follows today's record layout: a record with any field
-- other than a number or such a record is managed.
pure func test_record_with_void_field_is_rejected() -> Bool:
	rejects("fixed record Marked { value: Int, unit: Void }\nfixed union Holder:\n    Held(Marked)\n", 76, 82, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


pure func test_record_with_bool_field_is_rejected() -> Bool:
	rejects("fixed record Flagged { set: Bool }\nfixed union Holder:\n    Held(Flagged)\n", 64, 71, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


pure func test_record_with_fixed_union_field_is_rejected() -> Bool:
	rejects(
		"fixed union Signal:\n    Off\nfixed record Signalled { signal: Signal }\nfixed union Holder:\n    Held(Signalled)\n",
		99, 108, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP,
	)


pure func test_tuple_payload_is_rejected() -> Bool:
	rejects("fixed union Holder:\n    Pair((Int, Int))\n", 29, 39, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


pure func test_callable_payload_is_rejected() -> Bool:
	rejects("fixed union Holder:\n    Call(pure (Int) -> Int)\n", 29, 46, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


-- A record containing itself is a layout in progress, which is managed.
pure func test_self_containing_record_is_rejected() -> Bool:
	rejects("fixed record Chain { value: Int, next: Chain }\nfixed union Holder:\n    Held(Chain)\n", 76, 81, INLINE_PAYLOAD, INLINE_PAYLOAD_HELP)


tests: TestSuite = {
	description = "Fixed union declarations",
	tests = [
		("a payload-free fixed union is accepted", test_payload_free_fixed_union_is_accepted),
		("Int, Float and Void payloads are accepted", test_number_and_void_payloads_are_accepted),
		("a fixed union payload is accepted", test_fixed_union_payload_is_accepted),
		("records of numbers, including Cell[Int], are accepted", test_record_of_numbers_payloads_are_accepted),
		("opaque types over fixed storage are accepted", test_opaque_payloads_over_fixed_storage_are_accepted),
		("a String payload is rejected", test_string_payload_is_rejected),
		("a List payload is rejected", test_list_payload_is_rejected),
		("a fixed Bool payload is accepted", test_fixed_bool_payload_is_accepted),
		("a plain Bool payload is rejected", test_plain_bool_payload_is_rejected),
		("an ordinary payload-free union payload is rejected", test_ordinary_union_payload_is_rejected),
		("a record with a String field is rejected", test_managed_record_payload_is_rejected),
		("a generic record at a managed argument is rejected", test_generic_record_at_a_managed_argument_is_rejected),
		("an opaque type over String is rejected", test_opaque_over_managed_type_is_rejected),
		("a direct self payload is rejected", test_direct_self_payload_is_rejected),
		("a repeated self payload reports the first", test_repeated_self_payload_reports_the_first),
		("mutual recursion reports the payload that closes the cycle", test_mutual_recursion_reports_the_closing_payload),
		("a diamond of fixed unions is accepted", test_diamond_of_fixed_unions_is_accepted),
		("a cycle reached from another union is rejected", test_cycle_reached_from_another_union_is_rejected),
		("a cycle through an opaque type is a recursive opaque", test_cycle_through_an_opaque_type_is_a_recursive_opaque),
		("a record with a Void field is rejected", test_record_with_void_field_is_rejected),
		("a record with a Bool field is rejected", test_record_with_bool_field_is_rejected),
		("a record with a fixed union field is rejected", test_record_with_fixed_union_field_is_rejected),
		("a tuple payload is rejected", test_tuple_payload_is_rejected),
		("a callable payload is rejected", test_callable_payload_is_rejected),
		("a record containing itself is rejected", test_self_containing_record_is_rejected),
	],
}
