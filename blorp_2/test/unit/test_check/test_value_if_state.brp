import:
	../../../src/check/check: check, checked_functions
	../../../src/check/model as Model
	../module_input: test_base, INTEGER_OPERATIONS, parse_modules_with_base
	test: TestSuite


private SOURCE: String =
	|func main() -> Int:
	|    var total = 0
	|    var from_condition = 0
	|    flag: Bool = True
	|    selected: Int = if match flag:
	|        True:
	|            total = 1
	|            from_condition = 7
	|            True
	|        False: False
	|    :
	|        if flag:
	|            local = 2
	|            total = local
	|            total
	|        else:
	|            total = 3
	|            total
	|    else:
	|        total
	|    add(selected, from_condition)
	|


private pure func carried_facts() -> Option[Bool]:
	parsed ?= parse_modules_with_base([{ source = SOURCE + INTEGER_OPERATIONS, targets = [] }], test_base()).to_option()
	accepted ?= check(parsed).to_option()
	function ?= checked_functions(accepted).functions.get(0)
	match function.statements:
		[Model.InitializeBinding(total, _), Model.InitializeBinding(from_condition, _), Model.InitializeBinding(_, _), Model.InitializeBinding(selected, value)]:
			match value.form:
				Model.Match(join):
					match join.scrutinee.form:
						Model.Match(condition):
							match join.arms:
								[first, _]:
									match first.value.form:
										Model.Match(inner):
											Some(join.carried.map(Model.binding_number) == [Model.binding_number(total), Model.binding_number(from_condition)]
												and condition.carried.map(Model.binding_number) == [Model.binding_number(total), Model.binding_number(from_condition)]
												and inner.carried.map(Model.binding_number) == [Model.binding_number(total)]
												and Model.binding_number(selected) == 4 and function.bindings.length() == 5
												and Model.same_type(value.value_type, Model.IntType))
										_: None
								_: None
						_: None
				_: None
		_: None


pure func test_condition_and_final_nested_join_preserve_outer_writes_and_local_ids() -> Bool:
	carried_facts().get_or(False)


tests: TestSuite = {
	description = "Blorp 2 value if state threading",
	tests = [("condition and final nested join preserve state", test_condition_and_final_nested_join_preserve_outer_writes_and_local_ids)]
}
