import:
	../../../src/check/check: checked_functions
	../../../src/check/model:
		CheckedBody(CheckedValueBody), CheckedExit(ReturnExpression), CheckedExpr,
		CheckedForm(ReadConstant), ClosedConstant(IntegerConstant, FloatConstant, StringConstant),
		TypeRef(IntType, FloatType, StringType),
	../../../src/utils/ids: ConstantId, constant_number
	../input: checked_source
	test: TestSuite


private INTEGER: String =
	|ANSWER: Int = 23
	|
	|func main() -> Int:
	|    ANSWER
	|


private FLOAT: String =
	|ANSWER: Float = 1.25
	|
	|pure func answer() -> Float:
	|    ANSWER
	|
	|func main() -> Int:
	|    0
	|


private STRING: String =
	|MESSAGE: String = "hello λ"
	|
	|pure func message() -> String:
	|    MESSAGE
	|
	|func main() -> Int:
	|    0
	|


private pure func reads(value: CheckedExpr, id: ConstantId) -> Bool:
	match value.form:
		ReadConstant(actual): constant_number(actual) == constant_number(id)
		_: False


pure func test_integer_constant_read_has_its_annotated_type() -> Bool:
	match checked_source(INTEGER):
		Err(_): False
		Ok(program):
			facts = checked_functions(program)
			match (facts.functions, facts.constants):
				([main], [constant]):
					match main.body:
						CheckedValueBody(ReturnExpression(value)):
							match (value.value_type, constant.value):
								(IntType, IntegerConstant(23)): reads(value, constant.id)
								_: False
						_: False
				_: False


pure func test_float_constant_read_has_its_annotated_type() -> Bool:
	match checked_source(FLOAT):
		Err(_): False
		Ok(program):
			facts = checked_functions(program)
			match (facts.functions, facts.constants):
				([answer, _], [constant]):
					match answer.body:
						CheckedValueBody(ReturnExpression(value)):
							match (value.value_type, constant.value):
								(FloatType, FloatConstant(number)): number == 1.25 and reads(value, constant.id)
								_: False
						_: False
				_: False


pure func test_string_constant_read_has_its_annotated_type() -> Bool:
	match checked_source(STRING):
		Err(_): False
		Ok(program):
			facts = checked_functions(program)
			match (facts.functions, facts.constants):
				([message, _], [constant]):
					match message.body:
						CheckedValueBody(ReturnExpression(value)):
							match (value.value_type, constant.value):
								(StringType, StringConstant(text)): text == "hello λ" and reads(value, constant.id)
								_: False
						_: False
				_: False


pure func test_raw_string_constant_preserves_c_fragment_bytes() -> Bool:
	source: String =
		raw
			|RUNTIME: String =
			|    raw
			|        |const char *message="a\nb";
			|
			|pure func fragment() -> String:
			|    RUNTIME
			|func main() -> Int:
			|    0
			|

	match checked_source(source):
		Err(_): False
		Ok(program):
			facts = checked_functions(program)
			match (facts.functions, facts.constants):
				([fragment, _], [constant]):
					match fragment.body:
						CheckedValueBody(ReturnExpression(value)):
							match (value.value_type, constant.value):
								(StringType, StringConstant(text)):
									-- Quoted expected bytes distinguish literal backslash-n from an LF.
									text == "const char *message=\"a\\nb\";" and reads(value, constant.id)
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 scalar constant checking",
	tests = [
		("Int constant read keeps annotated type", test_integer_constant_read_has_its_annotated_type),
		("Float constant read keeps annotated type", test_float_constant_read_has_its_annotated_type),
		("String constant read keeps annotated type", test_string_constant_read_has_its_annotated_type),
		("raw String constant preserves C fragment bytes", test_raw_string_constant_preserves_c_fragment_bytes),
	]
}
