import:
	../../../src/check/check: check_errors, checked_functions
	../../../src/check/model as Checked
	../../../src/utils/ids as Declaration
	../../../src/check/render: render_check_error
	../input: check, singleton_check_error, checked_tail_join
	../module_input: parse_modules, INTEGER_OPERATIONS
	test: TestSuite


private APPLY: String =
	|import:
	|    int as IntOps
	|pure func apply[T, U](callback: pure (T) -> U, value: T) -> U:
	|    callback(value)
	|


private func accepts(source: String) -> Bool:
	match parse_modules([{ source = source, targets = [1] }, { source = INTEGER_OPERATIONS, targets = [] }]):
		Err(error):
			print(error.message)
			False
		Ok(program):
			match check(program):
				Ok(_): True
				Err(failure):
					match singleton_check_error(check_errors(failure)):
						Some(error):
							diagnostic = render_check_error(program, error)
							print(diagnostic.message)
							print(diagnostic.help)
							print("capture span ".append_int(error.span.start) + "..".append_int(error.span.end))
						None: print("expected one capture rejection")
					False


func test_scalar_capture_reads_the_enclosing_immutable_parameter() -> Bool:
	body: String =
		|pure func offset(value: Int, amount: Int) -> Int:
		|    apply(pure func(item: Int) -> Int: IntOps.add(item, amount), value)
		|func main() -> Int:
		|    offset(40, 2)
		|
	accepts(APPLY + body)


func test_managed_capture_keeps_two_alias_bindings_distinct() -> Bool:
	body: String =
		|pure func choose(prefix: String) -> String:
		|    saved_alias = prefix
		|    apply(pure func(_: Int) -> String:
		|        saved = prefix
		|        saved_alias
		|    , 0)
		|func main() -> Int:
		|    selected = choose("saved")
		|    0
		|
	accepts(APPLY + body)


private pure func captured_source(body: String) -> Option[Checked.CheckedFunctions]:
	match parse_modules([{ source = APPLY + body, targets = [1] }, { source = INTEGER_OPERATIONS, targets = [] }]):
		Err(_): None
		Ok(program):
			match check(program):
				Err(_): None
				Ok(checked): Some(checked_functions(checked))


private pure func returned_choice(function: Checked.CheckedFunction) -> Option[Checked.CallableChoice]:
	match function.body:
		Checked.CheckedValueBody(Checked.ReturnExpression(value)):
			match value.form:
				Checked.InvokeFunction(call):
					match (call.target, call.operands):
						(Checked.UserFunction(_, _), [Checked.CallableOperand(_, argument, _), Checked.ValueOperand(_)]): Some(argument)
						_: None
				_: None
		_: None


private pure func reads_capture(value: Checked.CheckedExpr, owner: Checked.LambdaId, position: Int) -> Bool:
	match value.form:
		Checked.ReadCapture(id):
			Checked.lambda_number(Checked.capture_owner(id)) == Checked.lambda_number(owner) and Checked.capture_number(id) == position
		_: False


private pure func captures_binding(capture: Checked.CheckedCapture, owner: Checked.BodyOwner, position: Int, value_type: Checked.TypeRef) -> Bool:
	(
		Checked.same_body(capture.binding.owner, owner) and Checked.binding_number(capture.binding.binding) == position
			and Checked.same_type(capture.value_type.value_type, value_type)
	)


private pure func scalar_capture_facts() -> Option[Bool]:
	body: String =
		|pure func offset(value: Int, amount: Int) -> Int:
		|    apply(pure func(item: Int) -> Int: IntOps.add(item, amount), value)
		|func main() -> Int:
		|    offset(40, 2)
		|
	contents ?= captured_source(body)
	lambda = match contents.lambdas:
		[row]: Some(row)
		_: None
	row ?= lambda
	root ?= contents.functions.get(Declaration.function_number(row.root))
	choice ?= returned_choice(root)
	match (row.captures, row.body, choice):
		([capture], Checked.CheckedValueBody(Checked.ReturnExpression(value)), Checked.LambdaCallable(id, [operand])):
			match (value.form, operand.form):
				(Checked.InvokeFunction(operand_call_1), Checked.ReadBinding(binding)):
					match operand_call_1.operands:
						[Checked.ValueOperand(item), Checked.ValueOperand(outer)]:
							match item.form:
								Checked.ReadBinding(local): Some(
									captures_binding(capture, Checked.DeclaredBody(root.id), 1, Checked.IntType)
										and reads_capture(outer, id, 0) and Checked.binding_number(local) == 0
										and Checked.binding_number(binding) == 1 and Checked.same_type(operand.value_type, Checked.IntType)
								)
								_: None
						_: None
				_: None
		_: None


pure func test_capture_row_owns_the_typed_read_and_creation_operand() -> Bool:
	scalar_capture_facts().get_or(False)

pure func test_repeated_reads_deduplicate_the_resolved_scoped_identity() -> Bool:
	body: String =
		|pure func twice(amount: Int) -> Int:
		|    apply(pure func(_: Int) -> Int: IntOps.add(amount, amount), 0)
		|func main() -> Int:
		|    twice(21)
		|
	match captured_source(body):
		Some(contents):
			match contents.lambdas:
				[row]:
					match (row.captures, row.body, contents.functions.get(Declaration.function_number(row.root)).and_then(returned_choice)):
						([capture], Checked.CheckedValueBody(Checked.ReturnExpression(value)), Some(choice)):
							match (value.form, choice):
								(Checked.InvokeFunction(operand_call_2), Checked.LambdaCallable(id, [operand])):
									match operand_call_2.operands:
										[Checked.ValueOperand(left), Checked.ValueOperand(right)]:
											(
											captures_binding(capture, Checked.DeclaredBody(row.root), 0, Checked.IntType)
													and reads_capture(left, id, 0) and reads_capture(right, id, 0)
													and Checked.same_type(operand.value_type, Checked.IntType)
											)
										_: False
								_: False
						_: False
				_: False
		None: False


pure func test_managed_aliases_are_distinct_source_bindings_and_capture_slots() -> Bool:
	body: String =
		|pure func choose(prefix: String) -> String:
		|    saved_alias = prefix
		|    apply(pure func(_: Int) -> String:
		|        saved = prefix
		|        saved_alias
		|    , 0)
		|func main() -> Int:
		|    selected = choose("saved")
		|    0
		|
	match captured_source(body):
		Some(contents):
			match contents.lambdas:
				[row]:
					match (row.captures, row.statements, row.body, contents.functions.get(Declaration.function_number(row.root)).and_then(returned_choice)):
						([first, second], [Checked.InitializeBinding(_, saved)], Checked.CheckedValueBody(Checked.ReturnExpression(returned)), Some(choice)):
							match choice:
								Checked.LambdaCallable(id, [left, right]):
									match (left.form, right.form):
										(Checked.ReadBinding(original), Checked.ReadBinding(copy)):
											(
												captures_binding(first, Checked.DeclaredBody(row.root), 0, Checked.StringType)
													and captures_binding(second, Checked.DeclaredBody(row.root), 1, Checked.StringType)
													and reads_capture(saved, id, 0) and reads_capture(returned, id, 1)
													and Checked.binding_number(original) == 0 and Checked.binding_number(copy) == 1
												)
										_: False
								_: False
						_: False
				_: False
		None: False


pure func test_nested_child_creation_forwards_the_only_grandparent_use() -> Bool:
	body: String =
		|pure func keep(value: String) -> String:
		|    apply(pure func(parent_item: Int) -> String: apply(pure func(child_item: Int) -> String: value, parent_item), 0)
		|func main() -> Int:
		|    kept = keep("saved")
		|    0
		|
	match captured_source(body):
		Some(contents):
			match contents.lambdas:
				[parent, child]:
					match (parent.captures, child.captures, parent.body, child.body):
						([outer_capture], [inner_capture], Checked.CheckedValueBody(Checked.ReturnExpression(creation)), Checked.CheckedValueBody(Checked.ReturnExpression(read))):
							match creation.form:
								Checked.InvokeFunction(call):
									match (call.target, call.operands):
										(Checked.UserFunction(_, _), [Checked.CallableOperand(_, choice, _), Checked.ValueOperand(_)]):
											match choice:
												Checked.LambdaCallable(child_id, [operand]):
													(
														captures_binding(outer_capture, Checked.DeclaredBody(parent.root), 0, Checked.StringType)
															and Checked.same_scoped_binding(outer_capture.binding, inner_capture.binding)
															and Declaration.function_number(parent.root) == Declaration.function_number(child.root)
															and reads_capture(operand, Checked.lambda_id(0), 0) and reads_capture(read, child_id, 0)
													)
												_: False
										_: False
								_: False
						_: False
				_: False
		None: False


pure func test_equal_local_ordinals_in_parent_and_root_keep_distinct_capture_identity() -> Bool:
	body: String =
		|pure func keep(original: String) -> String:
		|    apply(pure func(local: String) -> String:
		|        apply(pure func(_: Int) -> String:
		|            saved = original
		|            local
		|        , 0)
		|    , original)
		|func main() -> Int:
		|    kept = keep("saved")
		|    0
		|
	match captured_source(body):
		None: False
		Some(contents):
			match contents.lambdas:
				[parent, child]:
					match (parent.captures, child.captures, contents.functions.get(Declaration.function_number(parent.root)).and_then(returned_choice)):
						([outer], [grandparent, local], Some(choice)):
							match choice:
								Checked.LambdaCallable(parent_id, [_]):
									(
										captures_binding(outer, Checked.DeclaredBody(parent.root), 0, Checked.StringType)
											and Checked.same_scoped_binding(outer.binding, grandparent.binding)
											and captures_binding(local, Checked.LambdaBody(parent_id), 0, Checked.StringType)
											and Checked.same_scoped_binding(grandparent.binding, local.binding) == False
									)
								_: False
						_: False
				_: False


pure func test_deferred_sibling_and_nested_capture_rows_survive_parent_restoration() -> Bool:
	body: String =
		|pure func both(first: pure (Int) -> String, last: pure (Int) -> String) -> String:
		|    first(0)
		|pure func keep(prefix: String, suffix: String) -> String:
		|    both(pure func(item: Int) -> String: apply(pure func(_: Int) -> String: prefix, item), pure func(_: Int) -> String: suffix)
		|func main() -> Int:
		|    kept = keep("first", "second")
		|    0
		|
	match captured_source(body):
		None: False
		Some(contents):
			match contents.lambdas:
				[parent, sibling, child]:
					match (parent.captures, sibling.captures, child.captures):
						([first], [last], [nested]):
							(
								captures_binding(first, Checked.DeclaredBody(parent.root), 0, Checked.StringType)
									and captures_binding(last, Checked.DeclaredBody(parent.root), 1, Checked.StringType)
									and Checked.same_scoped_binding(first.binding, nested.binding)
									and Declaration.function_number(parent.root) == Declaration.function_number(sibling.root)
									and Declaration.function_number(parent.root) == Declaration.function_number(child.root)
							)
						_: False
				_: False


private pure func invocation_choice(value: Checked.CheckedExpr) -> Option[Checked.CallableChoice]:
	match value.form:
		Checked.InvokeFunction(call):
			match (call.target, call.operands):
				(Checked.UserFunction(_, _), [Checked.CallableOperand(_, argument, _), Checked.ValueOperand(_)]): Some(argument)
				_: None
		_: None


private pure func alternative_capture_facts() -> Option[Bool]:
	body: String =
		|fixed union Side:
		|    Left(String, String)
		|    Right(String, String)
		|pure func choose(value: Side) -> String:
		|    match value:
		|        Left(item, _) | Right(_, item):
		|            apply(pure func(_: Int) -> String: item, 0)
		|func main() -> Int:
		|    0
		|
	contents ?= captured_source(body)
	row ?= match contents.lambdas:
		[one]: Some(one)
		_: None
	root ?= contents.functions.get(Declaration.function_number(row.root))
	join ?= checked_tail_join(root.body)
	arm ?= match join.arms:
		[one]: Some(one)
		_: None
	choice ?= invocation_choice(arm.value)
	match (arm.inputs, row.captures, row.body, choice):
		([input], [capture], Checked.CheckedValueBody(Checked.ReturnExpression(read)), Checked.LambdaCallable(id, [operand])):
			match (join.selection.nodes, operand.form):
				([Checked.EnterArm(right, [_]), Checked.EnterArm(left, [_]), Checked.TestVariant(_, _, _, _)], Checked.ReadBinding(binding)):
					Some(
						Checked.match_arm_number(right) == Checked.match_arm_number(arm.id)
							and Checked.match_arm_number(left) == Checked.match_arm_number(arm.id)
							and captures_binding(capture, Checked.DeclaredBody(root.id), Checked.binding_number(input), Checked.StringType)
							and Checked.binding_number(binding) == Checked.binding_number(input)
							and Checked.lambda_number(id) == 0 and reads_capture(read, id, 0)
					)
				_: None
		_: None


pure func test_alternative_arm_checks_one_body_and_one_capture_site() -> Bool:
	alternative_capture_facts().get_or(False)


private pure func conditional_capture_facts() -> Option[Bool]:
	body: String =
		|pure func keep(original: String) -> String:
		|    if apply(pure func(_: Int) -> Bool:
		|        observed = apply(pure func(_: Int) -> String: original, 0)
		|        True
		|    , 0):
		|        apply(pure func(_: Int) -> String: original, 0)
		|    else:
		|        apply(pure func(_: Int) -> String: original, 0)
		|func main() -> Int:
		|    0
		|
	contents ?= captured_source(body)
	condition ?= contents.lambdas.get(0)
	child ?= contents.lambdas.get(1)
	root ?= contents.functions.get(Declaration.function_number(condition.root))
	join ?= checked_tail_join(root.body)
	first ?= join.arms.get(0)
	second ?= join.arms.get(1)
	condition_choice ?= invocation_choice(join.scrutinee)
	first_choice ?= invocation_choice(first.value)
	second_choice ?= invocation_choice(second.value)
	creation ?= match condition.statements:
		[Checked.InitializeBinding(_, value)]: Some(value)
		_: None
	child_choice ?= invocation_choice(creation)
	match (condition_choice, child_choice, first_choice, second_choice):
		(Checked.LambdaCallable(condition_id, [_]), Checked.LambdaCallable(child_id, [operand]), Checked.LambdaCallable(first_id, [_]), Checked.LambdaCallable(second_id, [_])):
			match child.body:
				Checked.CheckedValueBody(Checked.ReturnExpression(read)):
					Some(
						contents.lambdas.length() == 4 and join.arms.length() == 2
							and Checked.lambda_number(condition_id) == 0 and Checked.lambda_number(child_id) == 1
							and Checked.lambda_number(first_id) == 2 and Checked.lambda_number(second_id) == 3
							and reads_capture(operand, condition_id, 0) and reads_capture(read, child_id, 0)
							and contents.lambdas.all(pure func(row):
								match row.captures:
									[capture]:
										(
											Declaration.function_number(row.root) == Declaration.function_number(root.id)
												and captures_binding(capture, Checked.DeclaredBody(root.id), 0, Checked.StringType)
										)
									_: False
							)
					)
				_: None
		_: None


pure func test_nested_condition_and_both_branches_keep_latest_capture_rows() -> Bool:
	conditional_capture_facts().get_or(False)


private pure func structural_capture_facts() -> Option[Bool]:
	body: String =
		|func main() -> Int:
		|    values: List[String] = ["saved"]
		|    selected: String = match values:
		|        [item, ..._]:
		|            apply(pure func(_: Int) -> String:
		|                if True:
		|                    item
		|                else:
		|                    item
		|            , 0)
		|        []: "empty"
		|    0
		|
	contents ?= captured_source(body)
	row ?= match contents.lambdas:
		[one]: Some(one)
		_: None
	root ?= contents.functions.get(Declaration.function_number(row.root))
	selected ?= match root.statements:
		[Checked.InitializeBinding(_, _), Checked.InitializeBinding(_, value)]: Some(value)
		_: None
	join ?= match selected.form:
		Checked.Match(value): Some(value)
		_: None
	arm ?= join.arms.get(0)
	input ?= match arm.inputs:
		[one]: Some(one)
		_: None
	choice ?= invocation_choice(arm.value)
	branches ?= checked_tail_join(row.body)
	match (row.captures, choice, branches.arms):
		([capture], Checked.LambdaCallable(id, [operand]), [first, second]):
			match operand.form:
				Checked.ReadBinding(binding):
					Some(
						captures_binding(capture, Checked.DeclaredBody(root.id), Checked.binding_number(input), Checked.StringType)
							and Checked.binding_number(binding) == Checked.binding_number(input)
							and reads_capture(first.value, id, 0) and reads_capture(second.value, id, 0)
							and join.arms.length() == 2 and first.statements.is_empty() and second.statements.is_empty()
							and join.selection.nodes.any(pure func(node):
								match node:
									Checked.EnterArm(target, [Checked.BorrowPlace(place)]):
										match place.route:
											Checked.ListElement(parent, 0):
												(
													Checked.match_arm_number(target) == Checked.match_arm_number(arm.id)
														and Checked.same_type(place.value_type, Checked.StringType)
														and Checked.same_type(parent.value_type, join.scrutinee.value_type)
												)
											_: False
									_: False
							)
					)
				_: None
		_: None


pure func test_list_pattern_capture_keeps_scope_through_both_value_if_arms() -> Bool:
	structural_capture_facts().get_or(False)


tests: TestSuite = {
	description = "Pure callbacks capture immutable values by scoped identity",
	tests = [
		("List pattern capture keeps scope through both value-if arms", test_list_pattern_capture_keeps_scope_through_both_value_if_arms),
		("alternative arm checks one body and capture site", test_alternative_arm_checks_one_body_and_one_capture_site),
		("nested condition and branches keep latest capture rows", test_nested_condition_and_both_branches_keep_latest_capture_rows),
		("scalar capture reads the enclosing immutable parameter", test_scalar_capture_reads_the_enclosing_immutable_parameter),
		("managed capture keeps two alias bindings distinct", test_managed_capture_keeps_two_alias_bindings_distinct),
		("capture row owns typed read and creation operand", test_capture_row_owns_the_typed_read_and_creation_operand),
		("repeated reads deduplicate resolved scoped identity", test_repeated_reads_deduplicate_the_resolved_scoped_identity),
		("managed aliases retain source identity and capture slots", test_managed_aliases_are_distinct_source_bindings_and_capture_slots),
		("nested child forwards the only grandparent use", test_nested_child_creation_forwards_the_only_grandparent_use),
		("equal local ordinals in different owners stay distinct", test_equal_local_ordinals_in_parent_and_root_keep_distinct_capture_identity),
		("deferred sibling and nested rows survive restoration", test_deferred_sibling_and_nested_capture_rows_survive_parent_restoration),
	]
}
