---
When several parts of one construct fail, the checker reports the first failure
in source order, as every sibling loop does.
---
import:
	../../../src/check/check: check, check_errors
	../../../src/check/errors as Errors
	../../../src/check/model as Model
	../../../src/check/render: render_failure
	../../../src/utils/source: module_source, root_module_id
	../module_input: parse_modules
	bool: and
	int: Int methods
	option: Option methods
	string: String methods
	test: TestSuite


-- Both type parameters are unreachable from the arguments, so referencing the
-- function as a value leaves `First` and `Second` uninferred.
private SOURCE: String =
	|pure func ignore[First, Second](value: Int) -> Int:
	|    value
	|func main() -> Int:
	|
private AFTER: String = "ignore\n    0\n"


-- The rendered diagnostic is the same for either parameter, so the rejection
-- kind names which parameter was reported.
pure func test_callable_reference_reports_the_first_unsolved_parameter() -> Bool:
	prefix = SOURCE.add("    callback = ")
	match parse_modules([{ source = prefix.add(AFTER), targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					errors = check_errors(failure)
					rendered = render_failure(failure).first
					first_parameter = match errors.first.kind:
						Errors.CallRejection(Errors.UninferableTypeParameter(parameter)): Model.parameter_position(parameter) == 0
						_: False
					first_parameter.and(errors.remaining.is_empty())
						.and(rendered.message == "cannot infer the type parameter from the argument")
						.and(rendered.help == "pass a value whose type determines the declared type parameter; use a concrete helper when no argument can determine it")
						.and(rendered.span.source == module_source(root_module_id()))
						.and(rendered.span.start == prefix.length()).and(rendered.span.end == prefix.length().add(6))


tests: TestSuite = {
	description = "first rejection wins",
	tests = [
		("a callable reference reports its first unsolved type parameter", test_callable_reference_reports_the_first_unsolved_parameter),
	],
}
