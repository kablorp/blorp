pure func test_equal_underlying_types_remain_nominal_in_the_defining_module() -> Bool:
	declarations: String =
		|opaque type First = Int
		|opaque type Second = Int
		|pure func accept(value: First) -> Int:
		|    from_opaque First(value)
		|
	body: String =
		|func main() -> Int:
		|
	call_prefix = declarations + body + "    "
	prefix = call_prefix + "accept("
	operand = "into_opaque Second(7)"
	annotation: String =
		|opaque type First = Int
		|opaque type Second = Int
		|pure func accept(value:
	annotation_prefix = annotation + " "
	match parse_modules_with_base([{ source = prefix + operand + ")\n", targets = [] }], primitive_base()):
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					errors = check_errors(failure)
					diagnostics = render_failure(failure)
					match errors.first.kind:
						Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
							nominal_types = match (inventory_opaques(parsed_contents(program).declarations), mismatch.expected, mismatch.actual.value_type):
								([first, second], Model.OpaqueType(expected), Model.OpaqueType(actual)):
									opaque_number(expected) == opaque_number(first.id) and opaque_number(actual) == opaque_number(second.id)
								_: False
							match mismatch.expected_site:
								Errors.SourceAnnotation(annotation):
									(
										errors.remaining.is_empty() and diagnostics.remaining.is_empty()
										and nominal_types
										and mismatch.argument_position == 0
										and not Model.same_type(mismatch.expected, mismatch.actual.value_type)
										and same_source(errors.first.span.source, module_source(root_module_id()))
										and errors.first.span.start == call_prefix.length()
										and errors.first.span.end == call_prefix.length() + "accept".length()
										and same_source(mismatch.actual.span.source, errors.first.span.source)
										and mismatch.actual.span.start == prefix.length()
										and mismatch.actual.span.end == prefix.length() + operand.length()
										and same_source(annotation.source, errors.first.span.source)
										and annotation.start == annotation_prefix.length()
										and annotation.end == annotation.start + "First".length()
										and same_source(diagnostics.first.span.source, errors.first.span.source)
										and diagnostics.first.span.start == errors.first.span.start
										and diagnostics.first.span.end == errors.first.span.end
										and diagnostics.first.message == "argument type does not match the parameter type"
										and diagnostics.first.help == "use an expression of type First here"
										and diagnostics.first.note.is_none()
									)
								_: False
						_: False


pure func test_generic_growth_inside_construction_is_observed() -> Bool:
	header: String =
		|pure func grow[T](value: T) -> Id:
		|
	prefix = ID_MODULE + header + "    into_opaque Id(number("
	match rejection([{ source = prefix + "grow([value])))\n" + MAIN, targets = [] }], prefix, "grow".length(),
		"recursive calls grow type arguments without bound", "pass recursive type arguments unchanged, permute them, or reset them to concrete types"):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.RecursionRejection(Errors.GrowingRecursiveInstantiation): True
				_: False
		None: False


pure func test_generic_growth_inside_projection_is_observed() -> Bool:
	header: String =
		|pure func grow[T](value: T) -> Int:
		|
	prefix = ID_MODULE + header + "    from_opaque Id(make("
	match rejection([{ source = prefix + "grow([value])))\n" + MAIN, targets = [] }], prefix, "grow".length(),
		"recursive calls grow type arguments without bound", "pass recursive type arguments unchanged, permute them, or reset them to concrete types"):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.RecursionRejection(Errors.GrowingRecursiveInstantiation): True
				_: False
		None: False


pure func test_construction_around_self_call_is_not_tail_recursion() -> Bool:
	header: String =
		|@tail_recursive pure func grow(value: Int) -> Id:
		|
	prefix = ID_MODULE + header + "    into_opaque Id(number("
	match rejection([{ source = prefix + "grow(value)))\n" + MAIN, targets = [] }], prefix, "grow(value)".length(),
		"recursive call is not in tail position", "return this call directly, or remove @tail_recursive"):
		Some(failure):
			match (check_errors(failure).first.kind, inventory_functions(parsed_contents(failure_program(failure)).declarations)):
				(Errors.RecursionRejection(Errors.NonTailSelfCall(id)), [_, _, grow, _]): function_number(id) == function_number(grow.id)
				_: False
		None: False


pure func test_projection_around_self_call_is_not_tail_recursion() -> Bool:
	header: String =
		|@tail_recursive pure func grow(value: Int) -> Int:
		|
	prefix = ID_MODULE + header + "    from_opaque Id(make("
	match rejection([{ source = prefix + "grow(value)))\n" + MAIN, targets = [] }], prefix, "grow(value)".length(),
		"recursive call is not in tail position", "return this call directly, or remove @tail_recursive"):
		Some(failure):
			match (check_errors(failure).first.kind, inventory_functions(parsed_contents(failure_program(failure)).declarations)):
				(Errors.RecursionRejection(Errors.NonTailSelfCall(id)), [_, _, grow, _]): function_number(id) == function_number(grow.id)
				_: False
		None: False


pure func test_private_opaque_cannot_appear_in_public_signature() -> Bool:
	prefix_body: String =
		|private opaque type Secret = Int
		|pure func reveal(value:
	prefix = prefix_body + " "
	suffix: String =
		|Secret) -> Int:
		|    0
		|
	match rejection(
		[{ source = prefix + suffix + MAIN, targets = [] }], prefix, 6,
		"Secret is private but appears in public declaration reveal",
		"make Secret public, or make reveal private",
	):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.TypeTermRejection(Errors.PrivateTypeInPublicDeclaration(secret, declaration)):
					names = parsed_contents(failure_program(failure)).names
					(
						name_spelling(names, secret) == Some("Secret")
						and name_spelling(names, declaration) == Some("reveal")
					)
				_: False
		None: False


pure func test_opaque_type_cannot_be_applied() -> Bool:
	header: String =
		|pure func accept(value:
	prefix = ID_MODULE + header + " "
	suffix: String =
		|Id[Int]) -> Int:
		|    0
		|
	match rejection(
		[{ source = prefix + suffix + MAIN, targets = [] }], prefix, 2,
		"type does not accept a type argument",
		"apply a declared generic union or record, such as Box[Int]",
	):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.TypeTermRejection(Errors.NonApplicableType(name)):
					name_spelling(parsed_contents(failure_program(failure)).names, name) == Some("Id")
				_: False
		None: False


pure func test_opaque_receiver_does_not_inherit_int_method() -> Bool:
	body: String =
		|pure func increment(value: Int) -> Int:
		|    value
		|func main() -> Int:
		|    make(7).
	prefix = ID_MODULE + body
	suffix: String =
		|increment()
		|
	match rejection(
		[{ source = prefix + suffix, targets = [] }], prefix, 9,
		"argument type does not match the parameter type", "use an expression of type Int here",
	):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					match mismatch.actual.value_type:
						Model.OpaqueType(id):
							(
								names_issued_opaque(failure, id)
								and Model.same_type(mismatch.expected, Model.IntType)
								and mismatch.argument_position == 0
								and same_span(mismatch.actual.span, check_errors(failure).first.span)
							)
						_: False
				_: False
		None: False


pure func test_opaque_receiver_does_not_expose_underlying_field() -> Bool:
	prefix: String =
		|fixed record Representation { value: Int }
		|opaque type Box = Representation
		|pure func read(value: Box) -> Int:
		|    value.
	suffix: String =
		|value
		|
	match rejection(
		[{ source = prefix + suffix + MAIN, targets = [] }], prefix, 5,
		"field access requires a record value",
		"read a declared record field, or use parentheses for a UFCS function call",
	):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.RecordRejection(Errors.FieldRequiresRecord(Model.OpaqueType(id))):
					names_issued_opaque(failure, id)
				_: False
		None: False


private AGGREGATE_ARGUMENTS: String =
	|opaque type A = Int
	|opaque type B = Int
	|fixed record Box[T] { value: T }
	|pure func list_b() -> List[B]:
	|    [into_opaque B(7)]
	|pure func box_b() -> Box[B]:
	|    { value = into_opaque B(7) }
	|pure func take_list(value: List[A]) -> Int:
	|    0
	|pure func take_box(value: Box[A]) -> Int:
	|    0
	|func main() -> Int:
	|


private pure func rejects_nominal_aggregate(callee: String, argument: String, expected: String) -> Bool:
	prefix = AGGREGATE_ARGUMENTS + "    "
	argument_start = prefix.length() + callee.length() + 1
	source = prefix + callee + "(" + argument + ")\n"
	match rejection(
		[{ source = source, targets = [] }], prefix, callee.length(),
		"argument type does not match the parameter type", "use an expression of type " + expected + " here",
	):
		None: False
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
					inventory = parsed_contents(failure_program(failure)).declarations
					nominal_types = match (inventory_opaques(inventory), inventory_records(inventory)):
						([first, second], [box]):
							match (mismatch.expected, mismatch.actual.value_type):
								(Model.ListType(Model.OpaqueType(expected)), Model.ListType(Model.OpaqueType(actual))):
									opaque_number(expected) == opaque_number(first.id) and opaque_number(actual) == opaque_number(second.id)
								(Model.NominalType(Model.RecordAggregate(expected_box), [Model.OpaqueType(expected)]), Model.NominalType(Model.RecordAggregate(actual_box), [Model.OpaqueType(actual)])):
									(
										record_number(expected_box) == record_number(box.id)
										and record_number(actual_box) == record_number(box.id)
										and opaque_number(expected) == opaque_number(first.id)
										and opaque_number(actual) == opaque_number(second.id)
									)
								_: False
						_: False
					(
						nominal_types
						and mismatch.actual.span.start == argument_start
						and mismatch.actual.span.end == argument_start + argument.length()
						and same_source(mismatch.actual.span.source, module_source(root_module_id()))
					)
				_: False


pure func test_list_elements_keep_opaque_identity() -> Bool:
	rejects_nominal_aggregate("take_list", "list_b()", "List[A]")


pure func test_box_arguments_keep_opaque_identity() -> Bool:
	rejects_nominal_aggregate("take_box", "box_b()", "Box[A]")


pure func test_opaque_only_root_reports_missing_main_at_eof() -> Bool:
	source: String =
		|opaque type Name = Int
		|
	match rejection(
		[{ source = source, targets = [] }], source, 0,
		"expected a main function", "declare func main() -> Int: as the entrypoint",
	):
		None: False
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.SignatureRejection(Errors.MissingMain): True
				_: False


tests: TestSuite = {
	description = "Blorp 2 ordinary opaque access and conversions",
	tests = [
		("opaque-only root reports MissingMain at exact EOF", test_opaque_only_root_reports_missing_main_at_eof),
		("List elements keep checked opaque identity", test_list_elements_keep_opaque_identity),
		("Box arguments keep checked opaque identity", test_box_arguments_keep_opaque_identity),
		("private opaque cannot appear in public signature", test_private_opaque_cannot_appear_in_public_signature),
		("opaque type cannot be applied", test_opaque_type_cannot_be_applied),
		("opaque receiver does not inherit Int method", test_opaque_receiver_does_not_inherit_int_method),
		("opaque receiver does not expose underlying field", test_opaque_receiver_does_not_expose_underlying_field),
		("generic growth inside construction is observed", test_generic_growth_inside_construction_is_observed),
		("generic growth inside projection is observed", test_generic_growth_inside_projection_is_observed),
		("construction around self call is not tail recursion", test_construction_around_self_call_is_not_tail_recursion),
		("projection around self call is not tail recursion", test_projection_around_self_call_is_not_tail_recursion),
		("nested generic calls in explicit conversions", test_explicit_conversions_accept_nested_generic_calls),
		("public opaque references cross modules", test_public_opaque_reference_crosses_module_boundary),
		("conversion expectation closes zero-argument generic result", test_conversion_expectation_closes_zero_argument_generic_result),
		("unused underlying rows preserve IDs and full annotations", test_unused_underlying_rows_keep_nominal_ids_and_annotations),
		("later generic child error precedes earlier conversion mismatch", test_later_generic_child_error_precedes_earlier_conversion_mismatch),
		("operand mismatch keeps later generic constraint independent", test_operand_mismatch_keeps_later_generic_constraint_independent),
		("foreign construction precedes invalid operand", test_foreign_construction_rejects_before_invalid_operand),
		("foreign projection precedes invalid operand", test_foreign_projection_rejects_before_invalid_operand),
		("unknown opaque conversion type", test_missing_conversion_type_has_exact_diagnostic),
		("nonopaque conversion head", test_nonopaque_conversion_head_has_exact_diagnostic),
		("construction mismatch operand span", test_construction_mismatch_uses_complete_operand_span),
		("projection mismatch operand span", test_projection_mismatch_uses_complete_operand_span),
		("invalid construction operand precedes outer argument mismatch", test_invalid_construction_operand_precedes_outer_argument_mismatch),
		("invalid projection operand precedes outer argument mismatch", test_invalid_projection_operand_precedes_outer_argument_mismatch),
		("equal underlying types stay nominal in defining module", test_equal_underlying_types_remain_nominal_in_the_defining_module),
	]
}
