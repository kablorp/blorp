pure func test_construction_mismatch_uses_complete_operand_span() -> Bool:
	body: String =
		|func main() -> Int:
		|    unused = into_opaque Id(
	prefix = ID_MODULE + body
	match rejection(
		[{ source = prefix + "\"bad\")\n    0\n", targets = [] }], prefix, 5,
		"opaque construction value has the wrong type", "pass the declared underlying type to into_opaque",
	):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
					match mismatch.expected_site:
						Errors.OpaqueConstruction(id):
							(
								names_issued_opaque(failure, id)
								and Model.same_type(mismatch.expected, Model.IntType)
								and Model.same_type(mismatch.actual.value_type, Model.StringType)
								and same_span(mismatch.actual.span, check_errors(failure).first.span)
							)
						_: False
				_: False
		None: False


pure func test_projection_mismatch_uses_complete_operand_span() -> Bool:
	body: String =
		|func main() -> Int:
		|    from_opaque Id(
	prefix = ID_MODULE + body
	match rejection(
		[{ source = prefix + "7)\n", targets = [] }], prefix, 1,
		"opaque projection value has the wrong type", "pass a value of the named opaque type to from_opaque",
	):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.ValueRejection(Errors.ExpressionTypeMismatch(mismatch)):
					match mismatch.expected_site:
						Errors.OpaqueProjection(id):
							(
								names_issued_opaque(failure, id)
								and Model.same_type(mismatch.expected, Model.OpaqueType(id))
								and Model.same_type(mismatch.actual.value_type, Model.IntType)
								and same_span(mismatch.actual.span, check_errors(failure).first.span)
							)
						_: False
				_: False
		None: False


