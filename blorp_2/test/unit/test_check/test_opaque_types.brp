-- Source cases assert the published checked IDs, error kinds and diagnostics.
import:
	../../../src/check/check: CheckFailure, check, check_errors, checked_functions, failure_program
	../../../src/check/errors as Errors
	../../../src/check/inference as Inference
	../../../src/check/model as Model
	../../../src/check/render: render_failure
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: FunctionId, OpaqueId, function_number, inventory_functions, inventory_opaques, inventory_records, opaque_number, record_number
	../../../src/utils/names: name_spelling
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: ExpressionBase(DirectApplication, OpaqueWrap, OpaqueUnwrap), ParsedBody(ParsedValueBody), ValueExpression, same_span, type_span
	../module_input: ModuleInput, primitive_base, parse_modules_with_base
	test: TestSuite


private ID_MODULE: String =
	|opaque type Id = Int
	|pure func make(value: Int) -> Id:
	|    into_opaque Id(value)
	|pure func number(value: Id) -> Int:
	|    from_opaque Id(value)
	|


private MAIN: String =
	|func main() -> Int:
	|    0
	|


private pure func accepts(inputs: List[ModuleInput]) -> Bool:
	match parse_modules_with_base(inputs, primitive_base()):
		Ok(program): check(program).is_ok()
		Err(_): False


private pure func rejection(
	inputs: List[ModuleInput],
	prefix: String,
	length: Int,
	message: String,
	help: String,
) -> Option[CheckFailure]:
	match parse_modules_with_base(inputs, primitive_base()):
		Err(_): None
		Ok(program):
			match check(program):
				Ok(_): None
				Err(failure):
					typed = check_errors(failure)
					rendered = render_failure(failure)
					if (
						typed.remaining.is_empty() and rendered.remaining.is_empty()
						and same_source(typed.first.span.source, module_source(root_module_id()))
						and typed.first.span.start == prefix.length()
						and typed.first.span.end == prefix.length() + length
						and same_source(rendered.first.span.source, typed.first.span.source)
						and rendered.first.span.start == typed.first.span.start
						and rendered.first.span.end == typed.first.span.end
						and rendered.first.message == message and rendered.first.help == help
						and rendered.first.note.is_none()
					):
						Some(failure)
					else:
						None


private pure func names_issued_opaque(failure: CheckFailure, id: OpaqueId) -> Bool:
	match inventory_opaques(parsed_contents(failure_program(failure)).declarations):
		[row]: opaque_number(id) == opaque_number(row.id)
		_: False


private pure func nested_identity_calls(function: Model.CheckedFunction, target: FunctionId, value_type: Model.TypeRef, written: ValueExpression) -> Bool:
	match (written.base, Model.function_calls(function)):
		(DirectApplication(outer_name, [inner_input]), [first, second]):
			match ((inner_input.base, first.target, second.target), (first.operands, second.operands)):
				((DirectApplication(inner_name, [_]), Model.UserFunction(first_id, [first_type]), Model.UserFunction(second_id, [second_type])), ([Model.ValueOperand(_)], [Model.ValueOperand(_)])):
					(
						function_number(first_id) == function_number(target)
						and function_number(second_id) == function_number(target)
						and Model.same_type(first_type, value_type) and Model.same_type(second_type, value_type)
						and same_span(first.span, inner_name.span) and same_span(second.span, outer_name.span)
					)
				_: False
		_: False


pure func test_explicit_conversions_accept_nested_generic_calls() -> Bool:
	source: String =
		|opaque type Id = Int
		|pure func identity[T](value: T) -> T:
		|    value
		|pure func make(value: Int) -> Id:
		|    into_opaque Id(identity(identity(value)))
		|pure func number(value: Id) -> Int:
		|    from_opaque Id(identity(identity(value)))
		|func main() -> Int:
		|    number(make(7))
		|
	match parse_modules_with_base([{ source = source, targets = [] }], primitive_base()):
		Err(_): False
		Ok(program):
			match check(program):
				Err(_): False
				Ok(checked):
					inventory = parsed_contents(program).declarations
					match (inventory_opaques(inventory), inventory_functions(inventory), checked_functions(checked).functions):
						([declaration], [identity_source, make_source, number_source, _], [_, make, number, _]):
							match (make_source.declaration.body, number_source.declaration.body, make.body, number.body):
								(ParsedValueBody(written_make), ParsedValueBody(written_number), Model.CheckedValueBody(Model.ReturnExpression(made)), Model.CheckedValueBody(Model.ReturnExpression(projected))):
									match (written_make.base, written_number.base, made.form, projected.form):
										(OpaqueWrap(_, wrap_input), OpaqueUnwrap(_, unwrap_input), Model.ConstructOpaque(make_id, wrapped), Model.ProjectOpaque(number_id, unwrapped)):
											(
												opaque_number(make_id) == opaque_number(declaration.id)
												and opaque_number(number_id) == opaque_number(declaration.id)
												and Model.same_type(made.value_type, Model.OpaqueType(declaration.id))
												and Model.same_type(wrapped.value_type, Model.IntType)
												and Model.same_type(projected.value_type, Model.IntType)
												and Model.same_type(unwrapped.value_type, Model.OpaqueType(declaration.id))
												and same_span(made.span, written_make.base_span)
												and same_span(projected.span, written_number.base_span)
												and same_span(wrapped.span, wrap_input.span)
												and same_span(unwrapped.span, unwrap_input.span)
												and nested_identity_calls(make, identity_source.id, Model.IntType, wrap_input)
												and nested_identity_calls(number, identity_source.id, Model.OpaqueType(declaration.id), unwrap_input)
											)
										_: False
								_: False
						_: False


pure func test_public_opaque_reference_crosses_module_boundary() -> Bool:
	main: String =
		|import:
		|    ./id: Id, make, number
		|pure func read(value: Id) -> Int:
		|    number(value)
		|func main() -> Int:
		|    read(make(7))
		|
	accepts([{ source = main, targets = [1] }, { source = ID_MODULE, targets = [] }])


pure func test_conversion_expectation_closes_zero_argument_generic_result() -> Bool:
	source: String =
		|opaque type Rows = List[Int]
		|pure func empty[T]() -> List[T]:
		|    []
		|pure func make() -> Rows:
		|    into_opaque Rows(empty())
		|func main() -> Int:
		|    0
		|
	match parse_modules_with_base([{ source = source, targets = [] }], primitive_base()):
		Err(_): False
		Ok(program):
			match check(program):
				Err(_): False
				Ok(checked):
					match (inventory_opaques(parsed_contents(program).declarations), checked_functions(checked).functions):
						([declaration], [empty, make, _]):
							match make.body:
								Model.CheckedValueBody(Model.ReturnExpression(value)):
									match value.form:
										Model.ConstructOpaque(id, operand):
											match operand.form:
												Model.InvokeFunction(call):
													match call.operands:
														[]:
															match call.target:
																Model.UserFunction(target, [argument]):
																	(
																		opaque_number(id) == opaque_number(declaration.id)
																		and function_number(target) == function_number(empty.id)
																		and Model.same_type(argument, Model.IntType)
																		and Model.same_type(operand.value_type, Model.ListType(Model.IntType))
																	)
																_: False
														_: False
												_: False
										_: False
								_: False
						_: False


pure func test_unused_underlying_rows_keep_nominal_ids_and_annotations() -> Bool:
	source: String =
		|private fixed record Representation { value: Int }
		|opaque type Id = Representation
		|opaque type Alias = Id
		|func main() -> Int:
		|    0
		|
	match parse_modules_with_base([{ source = source, targets = [] }], primitive_base()):
		Err(_): False
		Ok(program):
			match check(program):
				Err(_): False
				Ok(checked):
					contents = checked_functions(checked)
					match (inventory_opaques(parsed_contents(program).declarations), contents.opaques, contents.records):
						([first, second], [checked_first, checked_second], [representation]):
							(
								opaque_number(checked_first.id) == opaque_number(first.id)
								and opaque_number(checked_second.id) == opaque_number(second.id)
								and Model.same_type(checked_first.underlying_type.value_type, Model.NominalType(Model.RecordAggregate(representation.id), []))
								and Model.same_type(checked_second.underlying_type.value_type, Model.OpaqueType(first.id))
								and same_span(checked_first.underlying_type.span, type_span(first.declaration.underlying))
								and same_span(checked_second.underlying_type.span, type_span(second.declaration.underlying))
							)
						_: False


-- The source case pins diagnostic priority. The direct solver case below
-- checks constraint independence; a first error can mask later binding facts.
pure func test_later_generic_child_error_precedes_earlier_conversion_mismatch() -> Bool:
	source: String =
		|opaque type Id = Int
		|opaque type Rows = List[Int]
		|pure func empty[T]() -> List[T]:
		|    []
		|pure func text(value: List[Int]) -> String:
		|    "bad"
		|pure func identity[T](value: T) -> T:
		|    value
		|pure func consume(first: Id, second: Rows) -> Int:
		|    0
		|func main() -> Int:
		|    consume(into_opaque Id(text(empty())), into_opaque Rows(identity(
	match rejection(
		[{ source = source + "unknown)))\n", targets = [] }], source, 7,
		"unknown value", "use this function's parameter name, a declared variant, or a call",
	):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.ValueRejection(Errors.UnknownValue(name)):
					name_spelling(parsed_contents(failure_program(failure)).names, name) == Some("unknown")
				_: False
		None: False


pure func test_operand_mismatch_keeps_later_generic_constraint_independent() -> Bool:
	source: String =
		|opaque type Id = Int
		|pure func identity[T](value: T) -> T:
		|    value
		|func main() -> Int:
		|    0
		|
	match parse_modules_with_base([{ source = source, targets = [] }], primitive_base()):
		Err(_): False
		Ok(program):
			match (inventory_opaques(parsed_contents(program).declarations), inventory_functions(parsed_contents(program).declarations)):
				([opaque_row], [function, _]):
					match function.declaration.type_parameters:
						[written]:
							parameter = Model.type_parameter_id(Model.FunctionDeclaration(function.id), 0)
							slots: List[Inference.InferenceSlot] = [{ parameter = parameter, call_span = written.name.span, first_argument = None, state = Inference.UnboundVariable(0) }]
							expected: Inference.ExpectedValue = { value_type = Model.IntType, site = Errors.OpaqueConstruction(opaque_row.id) }
							origin = Inference.OpaqueOperandConstraint(expected, opaque_row.declaration.type_name.span)
							mismatch: Inference.InferenceEquality = { expected = Inference.AcceptedType(Model.StringType), actual = Inference.AcceptedType(Model.IntType), origin = origin, relation = Inference.RequireEquality, parameter = None }
							match Inference.inspect_inference_equality(mismatch, slots):
								Ok(Inference.CompleteEquality):
									variable = Inference.inference_type(Model.ParameterType(parameter), [parameter], 0)
									later = { mismatch | expected = variable }
									match Inference.inspect_inference_equality(later, slots):
										Ok(Inference.UpdateInferenceSlots([update])):
											match update.slot.state:
												Inference.BoundVariable(Inference.AcceptedType(actual)):
													update.position == 0 and Model.same_parameter(update.slot.parameter, parameter) and Model.same_type(actual, Model.IntType)
												_: False
										_: False
								_: False
						_: False
				_: False


pure func test_foreign_construction_rejects_before_invalid_operand() -> Bool:
	conversion: String =
		|import:
		|    ./id: Id
		|func main() -> Int:
		|    into_opaque
	prefix = conversion + " "
	match rejection(
		[{ source = prefix + "Id(unknown)\n", targets = [1] }, { source = ID_MODULE, targets = [] }],
		prefix, 2,
		"opaque values can be constructed only in their declaring module",
		"call a public constructor from the declaring module",
	):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.ValueRejection(Errors.ForeignOpaqueConstruction(id)): names_issued_opaque(failure, id)
				_: False
		None: False


pure func test_foreign_projection_rejects_before_invalid_operand() -> Bool:
	conversion: String =
		|import:
		|    ./id: Id
		|func main() -> Int:
		|    from_opaque
	prefix = conversion + " "
	match rejection(
		[{ source = prefix + "Id(unknown)\n", targets = [1] }, { source = ID_MODULE, targets = [] }],
		prefix, 2,
		"opaque values can be projected only in their declaring module",
		"call a public accessor from the declaring module",
	):
		Some(failure):
			match check_errors(failure).first.kind:
				Errors.ValueRejection(Errors.ForeignOpaqueProjection(id)): names_issued_opaque(failure, id)
				_: False
		None: False


