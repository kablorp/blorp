import:
	../../../src/check/check: check_errors
	../../../src/check/errors: CheckErrorKind(ConstructorRejection), ConstructorError(VariantNotInExpectedType)
	../../../src/check/render: render_failure
	../input: check
	../module_input: parse_modules
	test: TestSuite


-- The root sees TestOption without its constructors, and its own TestNone
-- shares the position of TestOption's. Only the expected union's own variant
-- may construct it.
pure func test_constructor_of_another_union_is_not_a_variant_of_the_expected_union() -> Bool:
	option: String =
		|fixed union TestOption[T]:
		|    TestSome(T)
		|    TestNone
		|
	prefix = "import:\n    ./option: TestOption()\nfixed union Mine:\n    Zero\n    TestNone\npure func empty() -> TestOption[Int]:\n    "
	root = prefix + "TestNone\nfunc main() -> Int:\n    0\n"

	match parse_modules([{ source = root, targets = [1] }, { source = option, targets = [] }]):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					error = check_errors(failure).first
					rendered = render_failure(failure).first

					match error.kind:
						ConstructorRejection(VariantNotInExpectedType(_, _)):
							(
								error.span.start == prefix.length()
								and error.span.end == prefix.length() + "TestNone".length()
								and rendered.message == "variant does not belong to the expected type"
								and rendered.help == "use an expression of type TestOption[Int] here"
							)
						_:
							False


tests: TestSuite = {
	description = "Blorp 2 constructor planning",
	tests = [
		(
			"constructor of another union is not a variant of the expected union",
			test_constructor_of_another_union_is_not_a_variant_of_the_expected_union,
		),
	]
}
