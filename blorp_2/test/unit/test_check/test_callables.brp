import:
	../../../src/check/check: checked_functions, check_errors
	../../../src/check/render: render_failure
	../../../src/utils/source: module_source, root_module_id, same_source
	../../../src/utils/syntax: CallNotation(ReceiverCall), same_span
	../../../src/check/errors:
		CallError(ArgumentCountMismatch, ArgumentTypeMismatch, ImpureCall),
		CheckErrorKind(CallRejection, ValueRejection),
		ValueError(UnknownValue),
		ExpectedTypeSite(SourceAnnotation)
	../../../src/check/model:
		CheckedCallOperand(ValueOperand, CallableOperand),
		CallIdentity(DeclaredTarget),
		CallTarget(UserFunction, RuntimeFunction, CallableParameter),
		CheckedBody(CheckedValueBody),
		CheckedExit(ReturnExpression),
		CheckedForm(InvokeFunction, ReadBinding),
		CheckedFunction, CheckedCall,
		TypeRef(IntType, StringType),
		same_type
	../../../src/utils/ids: function_number
	../../../src/utils/text: concat
	../input: checked_source, rejects_at, check, singleton_check_error
	../module_input: PRIMITIVE_BASE, INTEGER_OPERATIONS, parse_modules, parse_modules_with_base
	test: TestSuite


pure func test_pure_caller_rejects_default_impure_callee() -> Bool:
	source: String =
		|pure func main() -> Int:
		|	one()
		|func one() -> Int:
		|	1
		|
	rejects_at(source, 26, 29, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_transitive_pure_chain_rejects_its_impure_edge() -> Bool:
	source: String =
		|pure func main() -> Int:
		|	answer()
		|pure func answer() -> Int:
		|	one()
		|func one() -> Int:
		|	1
		|
	rejects_at(source, 63, 66, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_unreachable_pure_caller_rejects_impure_callee() -> Bool:
	source: String =
		|func main() -> Int:
		|	0
		|pure func helper() -> Int:
		|	one()
		|func one() -> Int:
		|	1
		|
	rejects_at(source, 51, 54, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_call_requires_its_parameter_argument() -> Bool:
