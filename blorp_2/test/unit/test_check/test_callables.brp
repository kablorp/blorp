pure func test_outer_wrapper_arity_is_checked_after_valid_inner() -> Bool:
	source: String =
		|func one() -> Int:
		|	1
		|pure func identity(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	one(identity(1))
		|
	rejects_at(source, 89, 92, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ArgumentCountMismatch(_)):
