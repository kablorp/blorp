		|func identity(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	identity()
		|
	rejects_at(source, 62, 70, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ArgumentCountMismatch(_)):
				True
			_:
				False
	)


