pure func test_typed_second_argument_mismatch() -> Bool:
	prefix = "import:\n\tint: to_string\npure func first(left: Int, right: Int) -> Int:\n\tleft\nfunc main() -> Int:\n\tfirst(7, "
	argument = "8.to_string()"

	match (
		parse_modules_with_base([
			{ source = prefix
				.concat(argument)
				.concat(")\n"), targets = [1] },
			{ source = INTEGER_OPERATIONS, targets = [] },
		], PRIMITIVE_BASE)
	):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					match singleton_check_error(check_errors(failure)):
						None:
							False
						Some(error):
							match error.kind:
								CallRejection(ArgumentTypeMismatch(mismatch)):
									match mismatch.expected_site:
										SourceAnnotation(annotation):
											(
												same_type(mismatch.expected, IntType)
												and same_type(
													mismatch.actual.value_type,
													StringType,
												)
												and error.span.start == prefix.length()
												and error.span.end == prefix.length() + argument.length()
												and mismatch.argument_position == 1
												and mismatch.actual.span.start == prefix.length()
												and mismatch.actual.span.end == prefix.length() + argument.length()
												and annotation.start == "import:\n\tint: to_string\npure func first(left: Int, right: ".length()
												and annotation.end == annotation.start + 3
											)
										_:
											False
								_:
									False


private pure func user_function_number(call: CheckedCall) -> Option[Int]:
	ordinary = call.operands.all(pure func(operand):
		match operand:
			ValueOperand(_): True
			CallableOperand(_, _, _): False
	)
	match (call.target, ordinary):
		(UserFunction(id, _), True):
			Some(function_number(id))
		_:
			None


private pure func form_of(function: CheckedFunction) -> Option[CheckedForm]:
	match function.body:
		CheckedValueBody(ReturnExpression(value)):
			Some(value.form)
		_:
			None


pure func test_parameter_receiver_selects_the_ufcs_target() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func use(argument: Int) -> Int:
		|	argument.identity()
		|func main() -> Int:
		|	use(1)
		|

	match checked_source(source):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[_, use, _]:
					match form_of(use):
						Some(InvokeFunction(call)):
							match call.operands:
								[ValueOperand(receiver)]:
									match receiver.form:
										ReadBinding(_):
											user_function_number(call) == Some(0)
										_:
											False
								_: False
						_:
							False
				_:
					False


pure func test_ufcs_zero_parameter_target_teaches_direct_call() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|func zero() -> Int:
		|	0
		|pure func main() -> Int:
		|	1.identity().zero()
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					error = check_errors(failure).first
					diagnostic = render_failure(failure).first
					match error.kind:
						CallRejection(ArgumentCountMismatch(arity)):
							match arity.target:
								DeclaredTarget(target):
									(arity.expected == 0 and arity.actual == 1 and arity.notation == ReceiverCall and function_number(target) == 1
										and error.span.start == 108 and error.span.end == 112
										and same_source(error.span.source, module_source(root_module_id())) and same_span(error.span, diagnostic.span)
										and diagnostic.message == "function takes no arguments"
										and diagnostic.help == "call zero() directly, or choose a function with one parameter" and diagnostic.note.is_none())
								_: False
						_: False


pure func test_ufcs_uses_containing_purity() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|func impure(value: Int) -> Int:
		|	value
		|pure func main() -> Int:
		|	1.identity().impure()
		|
	rejects_at(source, 124, 130, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			CallRejection(ImpureCall(_, _)):
				True
			_:
				False
	)


pure func test_ufcs_recursion_is_checked() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|pure func loop(value: Int) -> Int:
		|	value.identity().loop()
		|func main() -> Int:
		|	1.loop()
		|
	checked_source(source).is_ok()


pure func test_ufcs_receiver_uses_caller_parameter_scope() -> Bool:
	source: String =
		|pure func identity(value: Int) -> Int:
		|	value
		|func main() -> Int:
		|	value.identity()
		|
	rejects_at(source, 67, 72, pure func(kind: CheckErrorKind) -> Bool:
		match kind:
			ValueRejection(UnknownValue(_)):
				True
			_:
				False
	)


tests: TestSuite = {
	description = "Blorp 2 call contracts and receiver method selection",
	tests = [
		("typed second argument mismatch", test_typed_second_argument_mismatch),
		(
			"outer wrapper arity is checked after valid inner",
			test_outer_wrapper_arity_is_checked_after_valid_inner,
		),
		(
			"pure caller checks the outer wrapper after pure inner",
			test_pure_caller_checks_outer_wrapper_after_pure_inner,
		),
		(
			"impure caller may pass impure call to pure function",
			test_impure_caller_can_pass_impure_call_to_pure_function,
		),
		("pure caller rejects impure unary wrapper", test_pure_caller_rejects_impure_unary_wrapper),
		("one-parameter call requires an argument", test_call_requires_its_parameter_argument),
		("zero-parameter call rejects an argument", test_zero_parameter_call_rejects_argument),
		(
			"argument purity uses the containing function",
			test_pure_argument_call_uses_containing_function,
		),
		(
			"pure caller rejects default impure callee",
			test_pure_caller_rejects_default_impure_callee,
		),
		(
			"transitive pure chain rejects its impure edge",
			test_transitive_pure_chain_rejects_its_impure_edge,
		),
		(
			"unreachable pure caller rejects impure callee",
			test_unreachable_pure_caller_rejects_impure_callee,
		),
		("parameter receiver selects UFCS target", test_parameter_receiver_selects_the_ufcs_target),
		(
			"UFCS zero-parameter target teaches direct call",
			test_ufcs_zero_parameter_target_teaches_direct_call,
		),
		("UFCS uses containing purity", test_ufcs_uses_containing_purity),
		("UFCS recursion is checked", test_ufcs_recursion_is_checked),
		(
			"UFCS receiver uses caller parameter scope",
			test_ufcs_receiver_uses_caller_parameter_scope,
		),
	]
}
