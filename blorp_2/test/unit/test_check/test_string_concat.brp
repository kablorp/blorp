import:
	../../../src/check/check: check, checked_functions
	../../../src/check/model as Model
	../../../src/check/render: render_failure
	../../../src/namespace/builtins as Builtins
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: Purity(Pure)
	../input: setup_diagnostic
	../module_input: parse_modules
	../string_concat_inputs: CONCAT_SOURCE
	test: TestSuite


pure func test_concat_checks_as_pure_strings_to_string() -> Bool:
	match parse_modules([{ source = CONCAT_SOURCE, targets = [] }]).and_then(pure func(parsed): check(parsed).map_err(setup_diagnostic)):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions.get(0):
				Some(function):
					match (function.signature.purity, function.signature.parameters, function.body):
						(Pure, [left, right], Model.CheckedValueBody(Model.ReturnExpression(value))):
							match value.form:
								Model.InvokeFunction(call):
									match call.operands:
										[Model.ValueOperand(left_value), Model.ValueOperand(right_value)]:
											match call.target:
												Model.RuntimeFunction(Builtins.StringConcat):
													(
														Model.same_type(left.value_type, Model.StringType)
														and Model.same_type(right.value_type, Model.StringType)
														and Model.same_type(left_value.value_type, Model.StringType)
														and Model.same_type(right_value.value_type, Model.StringType)
														and Model.same_type(value.value_type, Model.StringType)
														and Model.same_type(function.signature.return_type.value_type, Model.StringType)
													)
												_: False
										_: False
								_: False
						_: False
				None: False


private BODY: String =
	|    builtin("string.add")
	|func main() -> Int:
	|    0
	|


private pure func header_rejected(header: String) -> Bool:
	start = header.length() + "\n    builtin(".length()
	match parse_modules([{ source = header + "\n" + BODY, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Ok(_): False
				Err(failure):
					diagnostics = render_failure(failure)
					error = diagnostics.first
					(
						diagnostics.remaining.is_empty() and error.note.is_none()
						and error.message == "builtin declaration does not match its runtime contract"
						and error.help == "declare a pure nongeneric function with two String parameters returning String"
						and error.span.source == module_source(root_module_id())
						and error.span.start == start and error.span.end == start + "\"string.add\"".length()
					)


tests: TestSuite = {
	description = "Blorp 2 String concat checked contract",
	tests = [
		("pure String operands and result publish typed operation", test_concat_checks_as_pure_strings_to_string),
		("impure declaration rejects", pure func(): header_rejected("func concatenate(left: String, right: String) -> String:")),
		("generic declaration rejects", pure func(): header_rejected("pure func concatenate[T](left: String, right: String) -> String:")),
		("missing operand rejects", pure func(): header_rejected("pure func concatenate(left: String) -> String:")),
		("extra operand rejects", pure func(): header_rejected("pure func concatenate(left: String, right: String, extra: String) -> String:")),
		("wrong left type rejects", pure func(): header_rejected("pure func concatenate(left: Int, right: String) -> String:")),
		("wrong right type rejects", pure func(): header_rejected("pure func concatenate(left: String, right: Int) -> String:")),
		("wrong return type rejects", pure func(): header_rejected("pure func concatenate(left: String, right: String) -> Int:")),
	]
}
