	)


pure func test_unreachable_cyclic_helper_diagnostic() -> Bool:
	diagnostic(
		"func main() -> Int:\n\t0\nfunc one() -> Int:\n\tone()\n",
		43,
		46,
		"call chain contains recursion",
		"use an acyclic call chain; recursion is not supported in this increment",
	)


pure func test_unreachable_unknown_callee_diagnostic() -> Bool:
	diagnostic(
		"func main() -> Int:\n\t0\nfunc one() -> Int:\n\tmissing()\n",
		43,
		50,
		"unknown function",
		"declare the called function in this file",
	)


pure func test_pure_caller_rejects_default_impure_callee() -> Bool:
	diagnostic(
		"pure func main() -> Int:\n\tone()\nfunc one() -> Int:\n\t1\n",
		26,
		29,
		"pure functions cannot call impure functions",
		"mark the callee pure or remove pure from the caller",
	)


pure func test_transitive_pure_chain_rejects_its_impure_edge() -> Bool:
	diagnostic(
		"pure func main() -> Int:\n\tanswer()\npure func answer() -> Int:\n\tone()\nfunc one() -> Int:\n\t1\n",
		63,
		66,
		"pure functions cannot call impure functions",
		"mark the callee pure or remove pure from the caller",
	)


pure func test_unreachable_pure_caller_rejects_impure_callee() -> Bool:
	diagnostic(
		"func main() -> Int:\n\t0\npure func helper() -> Int:\n\tone()\nfunc one() -> Int:\n\t1\n",
		51,
		54,
		"pure functions cannot call impure functions",
		"mark the callee pure or remove pure from the caller",
	)


pure func test_checked_functions_keep_declared_purity() -> Bool:
	match lex(
		"pure func one() -> Int:\n\t1\npure func answer() -> Int:\n\tone()\nfunc main() -> Int:\n\tanswer()\n",
	):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					match check(parsed):
						Err(_):
							False
						Ok(program):
							checked_functions(
								program,
							).functions.map(
								pure func(
									function: CheckedFunction,
								) -> Purity: function.purity,
							) == [Pure, Pure, Impure]


pure func test_parameter_type_is_explicit_int() -> Bool:
	diagnostic(
		"func identity(value: Bool) -> Int:\n\tvalue\nfunc main() -> Int:\n\tidentity(1)\n",
		21,
		25,
		"expected Int as the parameter type",
		"declare the parameter as name: Int",
	)


pure func test_main_has_no_parameter() -> Bool:
	diagnostic(
		"func main(value: Int) -> Int:\n\tvalue\n",
		10,
		15,
		"main cannot have a parameter",
		"declare main() -> Int: with no parameters",
	)


pure func test_unknown_bare_value_is_rejected() -> Bool:
	diagnostic(
		"func main() -> Int:\n\tvalue\n",
		21,
		26,
		"unknown value",
		"use this function's parameter name or a call such as one()",
	)


pure func test_parameter_cannot_be_called_as_global_function() -> Bool:
	diagnostic(
		"func one() -> Int:\n\t1\nfunc use(one: Int) -> Int:\n\tone()\nfunc main() -> Int:\n\tuse(1)\n",
		50,
		53,
		"Int parameters cannot be called",
		"use the parameter as a value, or rename it to call the function",
	)


pure func test_call_requires_its_parameter_argument() -> Bool:
	diagnostic(
		"func identity(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tidentity()\n",
		62,
		70,
		"function requires one argument",
		"pass one Int expression, such as identity(1)",
	)


pure func test_zero_parameter_call_rejects_argument() -> Bool:
	diagnostic(
		"func one() -> Int:\n\t1\nfunc main() -> Int:\n\tone(1)\n",
		43,
		46,
		"function takes no arguments",
		"remove the argument and call the function with ()",
	)


pure func test_pure_argument_call_uses_containing_function() -> Bool:
	diagnostic(
		"func one() -> Int:\n\t1\npure func identity(value: Int) -> Int:\n\tvalue\npure func main() -> Int:\n\tidentity(one())\n",
		103,
		106,
		"pure functions cannot call impure functions",
		"mark the callee pure or remove pure from the caller",
	)


pure func test_argument_cycle_is_rejected() -> Bool:
	diagnostic(
		"pure func identity(value: Int) -> Int:\n\tvalue\nfunc loop() -> Int:\n\tidentity(loop())\nfunc main() -> Int:\n\tloop()\n",
		76,
		80,
		"call chain contains recursion",
		"use an acyclic call chain; recursion is not supported in this increment",
	)


pure func test_parameter_does_not_leak_to_other_function() -> Bool:
	diagnostic(
		"func helper(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tvalue\n",
		60,
		65,
		"unknown value",
		"use this function's parameter name or a call such as one()",
	)


pure func test_argument_does_not_use_callee_parameter_scope() -> Bool:
	diagnostic(
		"func identity(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tidentity(value)\n",
		71,
		76,
		"unknown value",
		"use this function's parameter name or a call such as one()",
	)


pure func test_parameter_slot_and_repeated_wrappers() -> Bool:
	match checked_source(
		"pure func one() -> Int:\n\t1\npure func identity(one: Int) -> Int:\n\tone\nfunc main() -> Int:\n\tidentity(identity(1))\n",
	):
		Err(_):
			False
		Ok(program):
			checked = checked_functions(program)

			match checked.functions:
				[first, identity, main]:
					parameter_is_value: Bool = match identity.body.base:
						ReturnParameter:
							identity.body.unary_calls.length() == 0
						_:
							False

					match main.body.base:
						ReturnInteger(One):
							match main.body.unary_calls:
								[inner, outer]:
									(
										parameter_is_value
										and identity.parameters == IntParameter
										and identity.purity == Pure
										and first.parameters == NoParameter
										and main.parameters == NoParameter
										and function_number(inner.target) == 1
										and function_number(outer.target) == 1
										and inner.span.start == 99
										and inner.span.end == 107
										and outer.span.start == 90
										and outer.span.end == 98
										and function_number(checked.entrypoint) == 2
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_impure_caller_can_pass_impure_call_to_pure_function() -> Bool:
	match checked_source(
		"func one() -> Int:\n\t1\npure func identity(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tidentity(one())\n",
	):
		Ok(_):
			True
		Err(_):
			False


