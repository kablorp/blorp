pure func test_checked_functions_keep_declared_purity() -> Bool:
	source: String =
		|pure func one() -> Int:
		|	1
		|pure func answer() -> Int:
		|	one()
		|func main() -> Int:
		|	answer()
		|

	match lex(source):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					match check(parsed):
						Err(_):
							False
						Ok(program):
							checked_functions(
								program,
							).functions.map(
								pure func(
									function: CheckedFunction,
								) -> Purity: function.signature.purity,
							) == [Pure, Pure, Impure]


