pure func test_checked_functions_keep_declared_purity() -> Bool:
	match lex(
		"pure func one() -> Int:\n\t1\npure func answer() -> Int:\n\tone()\nfunc main() -> Int:\n\tanswer()\n",
	):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					match check(parsed):
						Err(_):
							False
						Ok(program):
							checked_functions(
								program,
							).functions.map(
								pure func(
									function: CheckedFunction,
								) -> Purity: function.signature.purity,
							) == [Pure, Pure, Impure]


