import:
	../../src/check:
		BindingOrigin(ParameterBinding),
		CallTarget(UserFunction, RuntimeFunction),
		CheckErrorKind(
			UnknownFunction, UnknownValue, ImpureCall, ArgumentCountMismatch, UncallableBinding,
			MainHasParameters, UnknownType, DuplicateFunction, MissingMain,
		),
		CheckedBase(ReturnInteger, ReturnBinding, ReturnCall),
		CheckedBody(CheckedValueBody),
		CheckedExit(ReturnExpression),
		CheckedFunction,
		CheckedOperation(InvokeFunction),
		CheckedProgram,
		ExpectedTypeSite(SourceAnnotation),
		TypeRef(IntType, StringType),
		TypeUse,
		check_errors,
		checked_functions,
		function_number,
		same_type,
	../../src/lex: lex
	../../src/syntax: Diagnostic, Purity(Pure, Impure)
	../../src/text: concat
	input: check, check_failure, parse, setup_diagnostic, singleton_check_error
	test: TestSuite


private pure func user_function_number(target: CallTarget) -> Option[Int]:
	match target:
		UserFunction(id, _):
			Some(function_number(id))
		RuntimeFunction(_):
			None


private pure func base_of(function: CheckedFunction) -> Option[CheckedBase]:
	match function.body:
		CheckedValueBody(ReturnExpression(value)):
			Some(value.base)
		_:
			None


private pure func operations_of(function: CheckedFunction) -> Option[List[CheckedOperation]]:
	match function.body:
		CheckedValueBody(ReturnExpression(value)):
			Some(value.operations.map(
				pure func(step): step.operation,
			))
		_:
			None


private pure func integer_parameter(shape: List[TypeUse]) -> Bool:
	match shape:
		[type_ref]:
			same_type(type_ref.value_type, IntType)
		_:
			False


private pure func no_parameter(shape: List[TypeUse]) -> Bool:
	match shape:
		[]:
			True
		_:
			False


private pure func checked_source(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(source)
	parsed ?= parse(tokens)
	check(parsed).map_err(setup_diagnostic)


private pure func diagnostic(
	source: String,
	start: Int,
	end: Int,
	matches: pure (CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(source):
		None:
			False
		Some(error):
			error.span.start == start and error.span.end == end and matches(error.kind)


pure func test_resolved_forward_call_and_entrypoint() -> Bool:
	source: String =
		|func main() -> Int:
		|	one()
		|func one() -> Int:
		|	1
		|

	match lex(source):
		Err(_):
			False
		Ok(tokens):
			match parse(tokens):
				Err(_):
					False
				Ok(parsed):
					match check(parsed):
						Err(_):
							False
						Ok(program):
							checked = checked_functions(program)

							match checked.functions:
								[first, second]:
									second_is_one: Bool = match base_of(second):
										Some(ReturnInteger(1)):
											True
										_:
											False

									match base_of(first):
										Some(ReturnCall(call, [])):
											(
												user_function_number(call.target) == Some(1)
												and operations_of(
													first,
												).map(
													pure func(values): values.length(),
												) == Some(0)
												and operations_of(
													second,
												).map(
													pure func(values): values.length(),
												) == Some(0)
												and second_is_one
												and first.signature.purity == Impure
												and second.signature.purity == Impure
												and function_number(checked.entrypoint) == 0
											)
										_:
											False
								_:
									False


