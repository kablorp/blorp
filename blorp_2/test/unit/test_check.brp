pure func test_parameter_does_not_shadow_ufcs_target() -> Bool:
	match checked_source(
		"pure func identity(value: Int) -> Int:\n\tvalue\npure func use(identity: Int) -> Int:\n\tidentity.identity()\nfunc main() -> Int:\n\tuse(1)\n",
	):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[_, use, _]:
					match base_of(use):
						Some(ReturnBinding(_)):
							match operations_of(use):
								Some([InvokeFunction(call, [])]):
									user_function_number(call.target) == Some(0)
								_:
									False
						_:
							False
				_:
					False


