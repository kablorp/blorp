import:
	../../src/check: CheckedProgram, CheckedReturn(ReturnZero), check, checked_return
	../../src/syntax: Diagnostic, ParsedProgram, ReturnExpression(ZeroExpression)
	test: TestSuite


private pure func parsed_program(function_name: String, return_type: String) -> ParsedProgram:
	{
		function_name = {
			spelling = function_name,
			span = {
				start = 5,
				end = 9
			}
		},
		return_type = {
			spelling = return_type,
			span = {
				start = 15,
				end = 18
			}
		},
		body = ZeroExpression
	}


private pure func rejects(
	result: Result[CheckedProgram, Diagnostic],
	start: Int,
	end: Int,
	message: String,
	help: String,
) -> Bool:
	match result:
		Err(diagnostic):
			(
				diagnostic.span.start == start
				and diagnostic.span.end == end
				and diagnostic.message == message
				and diagnostic.help == help
			)
		Ok(_):
			False


pure func test_valid_entrypoint_produces_checked_zero() -> Bool:
	match check(parsed_program("main", "Int")):
		Err(_):
			False
		Ok(program):
			match program.checked_return():
				ReturnZero:
					True


pure func test_wrong_entrypoint_diagnostic() -> Bool:
	rejects(
		check(parsed_program("nope", "Int")),
		5,
		9,
		"expected exactly one main function",
		"name the entrypoint main",
	)


pure func test_wrong_return_type_diagnostic() -> Bool:
	rejects(
		check(parsed_program("main", "Foo")),
		15,
		18,
		"expected Int as the main return type",
		"declare func main() -> Int:",
	)


tests: TestSuite = {
	description = "Blorp 2 semantic checking",
	tests = [
		("valid entrypoint produces checked zero", test_valid_entrypoint_produces_checked_zero),
		("wrong entrypoint diagnostic", test_wrong_entrypoint_diagnostic),
		("wrong return type diagnostic", test_wrong_return_type_diagnostic),
	]
}
