		"pure func identity(value: Int) -> Int:\n\tvalue\nfunc impure(value: Int) -> Int:\n\tvalue\npure func main() -> Int:\n\timpure(identity(1))\n",
		111,
		117,
		"pure functions cannot call impure functions",
		"mark the callee pure or remove pure from the caller",
	)


pure func test_outer_wrapper_arity_is_checked_after_valid_inner() -> Bool:
	diagnostic(
		"func one() -> Int:\n\t1\npure func identity(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tone(identity(1))\n",
		89,
		92,
		"function takes no arguments",
		"remove the argument and call the function with ()",
	)


pure func test_parameter_does_not_shadow_ufcs_target() -> Bool:
	match checked_source(
		"pure func identity(value: Int) -> Int:\n\tvalue\npure func use(identity: Int) -> Int:\n\tidentity.identity()\nfunc main() -> Int:\n\tuse(1)\n",
	):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[_, use, _]:
					match use.body.base:
						ReturnParameter:
							match use.body.unary_calls:
								[call]:
									function_number(call.target) == 0
								_:
									False
						_:
							False
				_:
					False


pure func test_parameter_still_shadows_direct_unary_target() -> Bool:
	diagnostic(
		"pure func identity(value: Int) -> Int:\n\tvalue\npure func use(identity: Int) -> Int:\n\tidentity(identity)\nfunc main() -> Int:\n\tuse(1)\n",
		84,
		92,
		"Int parameters cannot be called",
		"use the parameter as a value, or rename it to call the function",
	)


pure func test_ufcs_zero_parameter_target_teaches_direct_call() -> Bool:
	diagnostic(
		"pure func identity(value: Int) -> Int:\n\tvalue\nfunc zero() -> Int:\n\t0\nfunc main() -> Int:\n\t1.identity().zero()\n",
		103,
		107,
		"function takes no arguments",
		"call zero() directly, or choose a function with one Int parameter",
	)


pure func test_ufcs_uses_containing_purity() -> Bool:
	diagnostic(
		"pure func identity(value: Int) -> Int:\n\tvalue\nfunc impure(value: Int) -> Int:\n\tvalue\npure func main() -> Int:\n\t1.identity().impure()\n",
		124,
		130,
		"pure functions cannot call impure functions",
		"mark the callee pure or remove pure from the caller",
	)


pure func test_ufcs_cycle_is_rejected() -> Bool:
	diagnostic(
		"pure func identity(value: Int) -> Int:\n\tvalue\npure func loop(value: Int) -> Int:\n\tvalue.identity().loop()\nfunc main() -> Int:\n\t1.loop()\n",
		99,
		103,
		"call chain contains recursion",
		"use an acyclic call chain; recursion is not supported in this increment",
	)


pure func test_ufcs_receiver_uses_caller_parameter_scope() -> Bool:
	diagnostic(
		"pure func identity(value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\tvalue.identity()\n",
		67,
		72,
		"unknown value",
		"use this function's parameter name or a call such as one()",
	)


pure func test_special_spellings_resolve_by_role_and_declaration_order() -> Bool:
	match checked_source(
		"pure func Int(main: Int) -> Int:\n\tmain\nfunc main() -> Int:\n\tInt(1)\n",
	):
		Err(_):
			False
		Ok(program):
			checked = checked_functions(program)

			match checked.functions:
				[helper, entrypoint]:
					match helper.body.base:
						ReturnParameter:
							match entrypoint.body.unary_calls:
								[call]:
									(
										function_number(checked.entrypoint) == 1
										and function_number(call.target) == 0
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_case_distinct_interned_name_is_not_a_declaration() -> Bool:
	diagnostic(
		"pure func One() -> Int:\n\t1\nfunc main() -> Int:\n\tone()\n",
		48,
		51,
		"unknown function",
		"declare the called function in this file",
	)


tests: TestSuite = {
	description = "Blorp 2 semantic checking",
	tests = [
		(
			"special spellings resolve by role and declaration order",
			test_special_spellings_resolve_by_role_and_declaration_order,
		),
		(
			"case-distinct interned name is not a declaration",
			test_case_distinct_interned_name_is_not_a_declaration,
		),
		("parameter does not shadow UFCS target", test_parameter_does_not_shadow_ufcs_target),
		(
			"parameter still shadows direct unary target",
			test_parameter_still_shadows_direct_unary_target,
		),
		(
			"UFCS zero-parameter target teaches direct call",
			test_ufcs_zero_parameter_target_teaches_direct_call,
		),
		("UFCS uses containing purity", test_ufcs_uses_containing_purity),
		("UFCS cycle is rejected", test_ufcs_cycle_is_rejected),
		(
			"UFCS receiver uses caller parameter scope",
			test_ufcs_receiver_uses_caller_parameter_scope,
		),
		(
			"outer wrapper arity is checked after valid inner",
			test_outer_wrapper_arity_is_checked_after_valid_inner,
		),
		(
			"cycle after a settled inner wrapper is rejected",
			test_cycle_after_settled_inner_wrapper_is_rejected,
		),
		(
			"pure caller checks the outer wrapper after pure inner",
			test_pure_caller_checks_outer_wrapper_after_pure_inner,
		),
		("parameter slot and repeated wrappers", test_parameter_slot_and_repeated_wrappers),
		(
			"impure caller may pass impure call to pure function",
			test_impure_caller_can_pass_impure_call_to_pure_function,
		),
		("cycle in unary wrapper is rejected", test_cycle_in_unary_wrapper_is_rejected),
		("pure caller rejects impure unary wrapper", test_pure_caller_rejects_impure_unary_wrapper),
		("parameter type is explicit Int", test_parameter_type_is_explicit_int),
		("main has no parameter", test_main_has_no_parameter),
		("unknown bare value is rejected", test_unknown_bare_value_is_rejected),
		(
			"parameter call cannot fall through to a global",
			test_parameter_cannot_be_called_as_global_function,
		),
		("one-parameter call requires an argument", test_call_requires_its_parameter_argument),
		("zero-parameter call rejects an argument", test_zero_parameter_call_rejects_argument),
		(
			"argument purity uses the containing function",
			test_pure_argument_call_uses_containing_function,
		),
		("cycle inside a call argument is rejected", test_argument_cycle_is_rejected),
		(
			"parameter does not leak to other functions",
			test_parameter_does_not_leak_to_other_function,
		),
		(
			"argument does not use callee parameter scope",
			test_argument_does_not_use_callee_parameter_scope,
		),
		("resolved forward call and entrypoint", test_resolved_forward_call_and_entrypoint),
		("checked functions keep declared purity", test_checked_functions_keep_declared_purity),
		("unknown callee diagnostic", test_unknown_callee_diagnostic),
		(
			"pure caller rejects default impure callee",
			test_pure_caller_rejects_default_impure_callee,
		),
		(
			"transitive pure chain rejects its impure edge",
			test_transitive_pure_chain_rejects_its_impure_edge,
		),
		(
			"unreachable pure caller rejects impure callee",
			test_unreachable_pure_caller_rejects_impure_callee,
		),
		("duplicate helper diagnostic", test_duplicate_helper_diagnostic),
		("non-integer helper diagnostic", test_non_integer_helper_diagnostic),
		("unreachable cyclic helper diagnostic", test_unreachable_cyclic_helper_diagnostic),
		("unreachable unknown callee diagnostic", test_unreachable_unknown_callee_diagnostic),
		("duplicate function diagnostic", test_duplicate_function_diagnostic),
		("missing main diagnostic", test_missing_main_diagnostic),
		("wrong return type diagnostic", test_wrong_return_type_diagnostic),
		("self recursion diagnostic", test_self_recursion_diagnostic),
		("mutual recursion diagnostic", test_mutual_recursion_diagnostic),
	]
}
