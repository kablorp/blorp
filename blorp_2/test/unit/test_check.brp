pure func test_signed_integer_value_survives_checking() -> Bool:
	source: String =
		|func main() -> Int:
		|	-42
		|

	match checked_source(source):
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[function]:
					match base_of(function):
						Some(ReturnInteger(value)):
							value == -42
						_:
							False
				_:
					False


pure func test_payload_match_example_is_accepted() -> Bool:
	source: String =
		|fixed union Value:
		|	Empty
		|	Number(Int)
		|pure func unwrap(value: Value) -> Int:
		|	match value:
		|		Empty: 0
		|		Number(number): number
		|func main() -> Int:
		|	unwrap(Number(42))
		|

	match checked_source(source):
		Ok(_):
			True
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp 2 semantic checking",
	tests = [
		("typed second argument mismatch", test_typed_second_argument_mismatch),
		("payload match example is accepted", test_payload_match_example_is_accepted),
		("signed integer value survives checking", test_signed_integer_value_survives_checking),
		(
			"special spellings resolve by role and declaration order",
			test_special_spellings_resolve_by_role_and_declaration_order,
		),
		(
			"case-distinct interned name is not a declaration",
			test_case_distinct_interned_name_is_not_a_declaration,
		),
		("parameter does not shadow UFCS target", test_parameter_does_not_shadow_ufcs_target),
		(
			"parameter still shadows direct unary target",
			test_parameter_still_shadows_direct_unary_target,
		),
		(
			"UFCS zero-parameter target teaches direct call",
			test_ufcs_zero_parameter_target_teaches_direct_call,
		),
		("UFCS uses containing purity", test_ufcs_uses_containing_purity),
		("UFCS recursion is checked", test_ufcs_recursion_is_checked),
		(
			"UFCS receiver uses caller parameter scope",
			test_ufcs_receiver_uses_caller_parameter_scope,
		),
		(
			"outer wrapper arity is checked after valid inner",
			test_outer_wrapper_arity_is_checked_after_valid_inner,
		),
		(
			"recursion after a checked inner wrapper is accepted",
			test_recursion_after_inner_wrapper_is_checked,
		),
		(
			"pure caller checks the outer wrapper after pure inner",
			test_pure_caller_checks_outer_wrapper_after_pure_inner,
		),
		("parameter slot and repeated wrappers", test_parameter_slot_and_repeated_wrappers),
		(
			"impure caller may pass impure call to pure function",
			test_impure_caller_can_pass_impure_call_to_pure_function,
		),
		("unary recursion is checked", test_unary_recursion_is_checked),
		("pure caller rejects impure unary wrapper", test_pure_caller_rejects_impure_unary_wrapper),
		("parameter type is explicit Int", test_parameter_type_is_explicit_int),
		("main has no parameter", test_main_has_no_parameter),
		("unknown bare value is rejected", test_unknown_bare_value_is_rejected),
		(
			"parameter call cannot fall through to a global",
			test_parameter_cannot_be_called_as_global_function,
		),
		("one-parameter call requires an argument", test_call_requires_its_parameter_argument),
		("zero-parameter call rejects an argument", test_zero_parameter_call_rejects_argument),
		(
			"argument purity uses the containing function",
			test_pure_argument_call_uses_containing_function,
		),
		("recursion inside a call argument is accepted", test_recursion_in_argument_is_checked),
		(
			"parameter does not leak to other functions",
			test_parameter_does_not_leak_to_other_function,
		),
		(
			"argument does not use callee parameter scope",
			test_argument_does_not_use_callee_parameter_scope,
		),
		("resolved forward call and entrypoint", test_resolved_forward_call_and_entrypoint),
		("checked functions keep declared purity", test_checked_functions_keep_declared_purity),
		("unknown callee diagnostic", test_unknown_callee_diagnostic),
		(
			"pure caller rejects default impure callee",
			test_pure_caller_rejects_default_impure_callee,
		),
		(
			"transitive pure chain rejects its impure edge",
			test_transitive_pure_chain_rejects_its_impure_edge,
		),
		(
			"unreachable pure caller rejects impure callee",
			test_unreachable_pure_caller_rejects_impure_callee,
		),
		("duplicate helper diagnostic", test_duplicate_helper_diagnostic),
		("non-integer helper diagnostic", test_non_integer_helper_diagnostic),
		("unused recursive helper is checked", test_unused_recursive_helper_is_checked),
		("unreachable unknown callee diagnostic", test_unreachable_unknown_callee_diagnostic),
		("duplicate function diagnostic", test_duplicate_function_diagnostic),
		("missing main diagnostic", test_missing_main_diagnostic),
		("wrong return type diagnostic", test_wrong_return_type_diagnostic),
		("self recursion is checked", test_self_recursion_is_checked),
		("mutual recursion is checked", test_mutual_recursion_is_checked),
	]
}


pure func test_typed_second_argument_mismatch() -> Bool:
	prefix = "pure func first(left: Int, right: Int) -> Int:\n\tleft\nfunc main() -> Int:\n\tfirst(7, "
	argument = "8.to_string()"

	match (
		lex(
			prefix
				.concat(argument)
				.concat(")\n"),
		).and_then(pure func(tokens): parse(tokens))
	):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					match singleton_check_error(check_errors(failure)):
						None:
							False
						Some(error):
							match error.kind:
								ArgumentTypeMismatch(mismatch):
									match mismatch.expected_site:
										SourceAnnotation(annotation):
											(
												same_type(mismatch.expected, IntType)
												and same_type(
													mismatch.actual.value_type,
													StringType,
												)
												and error.span.start == prefix.length()
												and error.span.end == prefix.length() + argument.length()
												and mismatch.argument_position == 1
												and mismatch.actual.span.start == prefix.length()
												and mismatch.actual.span.end == prefix.length() + argument.length()
												and annotation.start == "pure func first(left: Int, right: ".length()
												and annotation.end == annotation.start + 3
											)
										_:
											False
								_:
									False
