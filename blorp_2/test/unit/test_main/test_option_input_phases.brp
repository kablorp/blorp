import:
	../../../src/check/check: CheckedProgram, checked_functions
	../../../src/check/model as Checked
	../../../src/utils/ids as Declaration
	../../../src/lower/lower as Lower
	../../../src/main: compile as compile_program
	../../../src/own/own as Own
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic, Diagnostics
	../compilation: compile_modules
	../input: check, setup_diagnostic
	../module_input: TEST_BASE, TestFoundation, parse_modules, parse_modules_with_base
	test: TestSuite


-- The designation finds Some and None by name, so a foundation that declares
-- None first keeps that layout: None is tag 0 and Some is tag 1.
private REVERSED_OPTION_TYPES: String =
	|type Int = builtin
	|type Float = builtin
	|type String = builtin
	|type Void = builtin
	|type List[T] = builtin
	|fixed union Bool:
	|    True
	|    False
	|fixed union Option[A]:
	|    None
	|    Some(A)
	|fixed union Result[Value, Error]:
	|    Ok(Value)
	|    Err(Error)
	|


private REVERSED_OPTION_BASE: TestFoundation = { types = REVERSED_OPTION_TYPES, prelude_selections = TEST_BASE.prelude_selections }


private SOURCE: String =
	|pure func parse_number(text: String) -> Option[Int]:
	|    builtin("string.parse_int")
	|pure func unwrap(text: String) -> Int:
	|    match parse_number(text):
	|        Some(value): value
	|        None: 0
	|func main() -> Int:
	|    unwrap("42")
	|


private pure func compile(source: String) -> Result[String, Diagnostics]:
	compile_modules([{ source = source, targets = [] }], REVERSED_OPTION_BASE)


pure func test_designated_option_accepts_reversed_declaration_order() -> Bool:
	match compile(SOURCE):
		Ok(_):
			True
		Err(_):
			False


pure func test_selected_union_import_preserves_original_declaration() -> Bool:
	-- A typed helper provides the constructor's expected union type.
	typed: String =
		|import:
		|    ./option: Maybe(Some, None)
		|pure func unwrap(value: Maybe[Int]) -> Int:
		|    match value:
		|        Some(number): number
		|        None: 0
		|func main() -> Int:
		|    unwrap(Some(42))
		|
	option: String =
		|fixed union Maybe[T]:
		|    Some(T)
		|    None
		|

	match (
		parse_modules([
			{
				source = typed,
				targets = [1]
			},
			{
				source = option,
				targets = []
			},
		])
	):
		Err(_):
			False
		Ok(parsed):
			match compile_program(parsed):
				Ok(_):
					True
				Err(_):
					False


pure func test_counted_parse_runtime_is_emitted() -> Bool:
	match compile(SOURCE):
		Ok(output):
			output.contains("blorp_string_parse_int")
		Err(_):
			False


private pure func checked_source() -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules_with_base([{ source = SOURCE, targets = [] }], REVERSED_OPTION_BASE)
	check(parsed).map_err(setup_diagnostic)


private pure func concrete_source() -> Result[Concrete.SpecializedProgram, Diagnostic]:
	checked_source().and_then(pure func(program): Concrete.specialize(program))


private pure func lowered_source() -> Result[Lower.LoweredProgram, Diagnostic]:
	concrete_source().and_then(pure func(program): Lower.lower(program))


pure func test_checked_option_constructors_are_reversed_declaration_ids() -> Bool:
	match checked_source():
		Err(_):
			False
		Ok(program):
			match checked_functions(program).functions:
				[parser, _, _]:
					match parser.body:
						Checked.CheckedValueBody(Checked.ReturnExpression(value)):
							match (value.form, value.value_type):
								(Checked.InvokeFunction(call, [_]), Checked.AppliedUnionType(owner, [Checked.IntType])):
									match call.target:
										Checked.RuntimeFunction(Builtins.StringParseInt(option)):
											(
												Declaration.variant_number(option.some) == 1
												and Declaration.variant_number(option.none) == 0
												and Declaration.union_number(
													Declaration.variant_owner(
														option.some,
													),
												) == Declaration.union_number(owner)
												and Declaration.union_number(
													Declaration.variant_owner(
														option.none,
													),
												) == Declaration.union_number(owner)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_concrete_option_constructors_are_translated_to_the_result_instance() -> Bool:
	match concrete_source():
		Err(_):
			False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, _, parser]:
					match parser.body:
						Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
							match (value.form, value.value_type):
								(Concrete.InvokeFunction(call, [_]), Concrete.UnionType(owner)):
									match call.target:
										Concrete.RuntimeFunction(Builtins.StringParseInt(option)):
											(
												Concrete.variant_number(option.some) == 1
												and Concrete.variant_number(option.none) == 0
												and Concrete.union_number(
													Concrete.variant_owner(
														option.some,
													),
												) == Concrete.union_number(owner)
												and Concrete.union_number(
													Concrete.variant_owner(
														option.none,
													),
												) == Concrete.union_number(owner)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_lowering_preserves_option_constructors_and_borrowed_parameter_argument() -> Bool:
	match lowered_source():
		Err(_):
			False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, _, parser]:
					match parser.definitions:
						[parameter, result]:
							match (parameter.operation, result.operation):
								(Lower.ParameterValue(0), Lower.CallValue(call, [argument])):
									match call.target:
										Concrete.RuntimeFunction(Builtins.StringParseInt(option)):
											(
												Lower.value_number(
													parameter.id,
												) == Lower.value_number(argument)
												and Lower.value_number(result.id) == 1
												and Concrete.variant_number(option.some) == 1
												and Concrete.variant_number(option.none) == 0
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_emission_projects_explicit_tags_with_flat_scratch_values() -> Bool:
	match compile(SOURCE):
		Err(_):
			False
		Ok(output):
			(
				output.contains("int64_t blorp_runtime_1=0;const uint8_t blorp_runtime_1_some=")
				and output.contains(".tag=blorp_v_0_1,.payload.blorp_up_1.blorp_uf_0=blorp_runtime_1")
				and output.contains(".tag=blorp_v_0_0}")
				and not output.contains("blorp_string_print")
			)


tests: TestSuite = {
	description = "Blorp 2 accepted library result contracts",
	tests = [
		("designated Option in reversed order", test_designated_option_accepts_reversed_declaration_order),
		("selected union identity", test_selected_union_import_preserves_original_declaration),
		("counted parser emission", test_counted_parse_runtime_is_emitted),
		("checked Option declaration identities", test_checked_option_constructors_are_reversed_declaration_ids),
		(
			"concrete Option instance identities",
			test_concrete_option_constructors_are_translated_to_the_result_instance,
		),
		(
			"lowered Option and argument identities",
			test_lowering_preserves_option_constructors_and_borrowed_parameter_argument,
		),
		(
			"flat explicit tag projection",
			test_emission_projects_explicit_tags_with_flat_scratch_values,
		),
	]
}
