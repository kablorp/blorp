import:
	../compilation: compile_modules
	../module_input: TEST_BASE
	test: TestSuite


pure func test_list_get_returns_owned_designated_optional_string() -> Bool:
	source: String =
		|pure func read(values: List[String], index: Int) -> Option[String]:
		|    builtin("list.get")
		|func main(values: List[String]) -> Int:
		|    line = read(values, 0)
		|    0
		|

	match compile_modules([{ source = source, targets = [] }], TEST_BASE):
		Ok(output):
			output.contains("blorp_list_get_0_s")
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp 2 designated Option input results",
	tests = [
		("owned optional String input", test_list_get_returns_owned_designated_optional_string),
	]
}
