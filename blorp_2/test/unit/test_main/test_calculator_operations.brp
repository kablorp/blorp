import:
	../compilation: compile, compile_modules
	../module_input: PRIMITIVE_BASE, STRING_OPERATIONS, TEST_BASE
	test: TestSuite


pure func test_string_equality_returns_the_designated_bool() -> Bool:
	source: String =
		|pure func equal(left: String, right: String) -> Bool:
		|    builtin("string.equals")
		|pure func choose(left: String, right: String) -> Int:
		|    match equal(left, right):
		|        True: 42
		|        False: 0
		|func main() -> Int:
		|    choose("add", "add")
		|

	match compile_modules([{ source = source, targets = [] }], TEST_BASE):
		Ok(output):
			output.contains("blorp_string_equals")
		Err(_):
			False


pure func test_integer_arithmetic_operations_have_closed_contracts() -> Bool:
	source: String =
		|pure func subtract(left: Int, right: Int) -> Int:
		|    builtin("int.subtract")
		|pure func multiply(left: Int, right: Int) -> Int:
		|    builtin("int.multiply")
		|pure func divide(left: Int, right: Int) -> Int:
		|    builtin("int.divide")
		|pure func remainder(left: Int, right: Int) -> Int:
		|    builtin("int.remainder")
		|func main() -> Int:
		|    subtract(multiply(divide(84, 2), 2), remainder(84, 43))
		|

	match compile(source):
		Ok(output):
			(
				output.contains("blorp_int_subtract")
				and output.contains("blorp_int_multiply")
				and output.contains("blorp_int_divide")
				and output.contains("blorp_int_remainder")
			)
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp 2 calculator operation contracts",
	tests = [
		("designated Bool string equality", test_string_equality_returns_the_designated_bool),
		("closed integer arithmetic", test_integer_arithmetic_operations_have_closed_contracts),
		("local function uses its declared signature", test_local_function_resolves_by_its_declared_signature),
	]
}


pure func test_local_function_resolves_by_its_declared_signature() -> Bool:
	source: String =
		|import:
		|    string: length
		|pure func to_string(text: String) -> String:
		|    text
		|func main() -> Int:
		|    length(to_string("kept"))
		|

	match compile_modules([
		{ source = source, targets = [1] },
		{ source = STRING_OPERATIONS, targets = [] },
	], PRIMITIVE_BASE):
		Ok(_):
			True
		Err(_):
			False
