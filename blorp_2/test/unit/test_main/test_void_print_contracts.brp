import:
	../compilation: compile
	test: TestSuite


func test_void_is_a_first_class_value() -> Bool:
	source: String =
		|func identity[T](value: T) -> T:
		|    value
		|func unit(value: Void) -> Void:
		|    saved = identity(value)
		|    saved
		|func main() -> Int:
		|    unit(void)
		|    0
		|

	match compile(source):
		Ok(_):
			True
		Err(errors):
			print_error(errors.first.message)
			False


func test_print_can_interleave_with_mutation() -> Bool:
	source: String =
		|func print(value: String) -> Void:
		|    builtin("string.print")
		|func main() -> Int:
		|    var text = "first"
		|    print(text)
		|    text = "second"
		|    print(text)
		|    0
		|

	match compile(source):
		Ok(_):
			True
		Err(errors):
			print_error(errors.first.message)
			False


pure func test_non_void_discard_teaches_binding_or_return() -> Bool:
	match compile("func main() -> Int:\n    7\n    0\n"):
		Err(errors):
			(
				errors.remaining.is_empty()
				and errors.first.message == "expression statement must return Void"
				and errors.first.help == "bind this value with name = expression, or make it the final expression"
				and errors.first.span.start == 24
				and errors.first.span.end == 25
			)
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 Void and print public contracts",
	tests = [
		("Void is a first-class value", test_void_is_a_first_class_value),
		("print interleaves with mutation", test_print_can_interleave_with_mutation),
		(
			"non-Void discard teaches binding or return",
			test_non_void_discard_teaches_binding_or_return,
		),
	]
}
