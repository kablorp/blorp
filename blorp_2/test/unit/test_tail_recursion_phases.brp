import:
	../../src/source: module_source, root_module_id
	../../src/lex: lex
	../../src/lower as Lower
	../../src/own as Own
	../../src/specialize as Concrete
	../../src/syntax: Diagnostic, FunctionExecution(SelfTailLoop)
	compilation: compile
	input: check, parse, setup_diagnostic
	test: TestSuite


private STEP: String =
	|fixed union Step:
	|	Stop
	|	Once
	|

private PREFIX: String =
	|@tail_recursive
	|pure func walk(step: Step, left: Int, right: Int) -> Int:
	|	prefix = identity(left)
	|	var current = right
	|	current = prefix
	|	match step:
	|		Stop: current
	|		Once:
	|			saved = left
	|

private SUFFIX: String =
	|pure func identity(value: Int) -> Int:
	|	value
	|func main() -> Int:
	|	walk(Once, 7, 9)
	|


private pure func concrete(source: String) -> Result[Concrete.SpecializedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source)
	parsed ?= parse(tokens)
	checked ?= check(parsed).map_err(setup_diagnostic)
	Concrete.specialize(checked)


private pure func source(terminal: String) -> String:
	STEP + PREFIX + "\t\t\t" + terminal + "\n" + SUFFIX


pure func test_specialization_preserves_backedge_and_arguments() -> Bool:
	match concrete(source("walk(Stop, identity(current), identity(saved))")):
		Err(_):
			False
		Ok(program):
			match Concrete.specialized_contents(program).functions:
				[_, function, _]:
					match function.execution:
						SelfTailLoop(annotation):
							match function.body:
								Concrete.ConcreteMatchBody(matched):
									match matched.arms:
										[base, recur]:
											match recur.body:
												Concrete.RecurWith([step, left, right], occurrence):
													match (step.base, left.base, right.base):
														(Concrete.ReturnVariant(_), Concrete.ReturnCall(first, [_]), Concrete.ReturnCall(second, [_])):
															match (
																first.target,
																second.target,
																base.body,
															):
																(Concrete.UserFunction(first_id), Concrete.UserFunction(second_id), Concrete.ReturnExpression(_)):
																	(
																		Concrete.function_number(
																			first_id,
																		) == 2
																		and Concrete.function_number(
																			second_id,
																		) == 2
																		and annotation.start == STEP.length()
																		and occurrence.end > occurrence.start
																	)
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


private pure func ordered_values(terminal: String) -> Bool:
	match concrete(source(terminal)).and_then(pure func(program): Lower.lower(program)):
		Err(_):
			False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, function, _]:
					match function.definitions:
						[step, left, right, prefix]:
							match (
								step.operation,
								left.operation,
								right.operation,
								(prefix.operation, function.tail),
							):
								(Lower.ParameterValue(0), Lower.ParameterValue(1), Lower.ParameterValue(2), (Lower.CallValue(_, [original]), Lower.MatchValue(matched))):
									match matched.arms:
										[base, recur]:
											match (
												base.body.exit,
												recur.body.exit,
												recur.body.definitions,
											):
												(Lower.ReturnValue(returned), Lower.RecurValues([next_step, next_left, next_right], _), [variant, first, second]):
													match (
														variant.operation,
														first.operation,
														second.operation,
													):
														(Lower.VariantValue(_), Lower.CallValue(_, [current]), Lower.CallValue(_, [saved])):
															(
																Lower.value_number(original) == 1
																and Lower.value_number(
																	returned,
																) == 3
																and base.body.definitions.length() == 0
																and Lower.value_number(current) == 3
																and Lower.value_number(saved) == 1
																and Lower.value_number(
																	next_step,
																) == 4
																and Lower.value_number(
																	next_left,
																) == 5
																and Lower.value_number(
																	next_right,
																) == 6
																and Lower.value_number(
																	second.id,
																) == 6
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_direct_arguments_lower_once_in_order() -> Bool:
	ordered_values("walk(Stop, identity(current), identity(saved))")


pure func test_ufcs_arguments_lower_once_in_order() -> Bool:
	ordered_values("Stop.walk(identity(current), identity(saved))")


pure func test_ufcs_receiver_chain_lowers_before_explicit_arguments() -> Bool:
	helper: String =
		|pure func step_identity(step: Step) -> Step:
		|	step
		|
	terminal: String =
		|			Stop.step_identity().walk(identity(current), identity(saved))
		|
	program_source = STEP + PREFIX + terminal + helper + SUFFIX

	match concrete(program_source).and_then(pure func(program): Lower.lower(program)):
		Err(_):
			False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, function, _, _]:
					match function.tail:
						Lower.MatchValue(matched):
							match matched.arms:
								[_, recur]:
									match (recur.body.definitions, recur.body.exit):
										([variant, receiver, left, right], Lower.RecurValues([next_step, next_left, next_right], _)):
											match (
												variant.operation,
												receiver.operation,
												left.operation,
												right.operation,
											):
												(Lower.VariantValue(_), Lower.CallValue(step_call, [receiver_argument]), Lower.CallValue(left_call, [left_argument]), Lower.CallValue(right_call, [right_argument])):
													match (
														step_call.target,
														left_call.target,
														right_call.target,
													):
														(Concrete.UserFunction(step_id), Concrete.UserFunction(left_id), Concrete.UserFunction(right_id)):
															(
																Concrete.function_number(
																	step_id,
																) == 3
																and Concrete.function_number(
																	left_id,
																) == 2
																and Concrete.function_number(
																	right_id,
																) == 2
																and Lower.value_number(
																	receiver_argument,
																) == 4
																and Lower.value_number(
																	left_argument,
																) == 3
																and Lower.value_number(
																	right_argument,
																) == 1
																and Lower.value_number(
																	next_step,
																) == 5
																and Lower.value_number(
																	next_left,
																) == 6
																and Lower.value_number(
																	next_right,
																) == 7
															)
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_prefix_and_snapshots_are_inside_loop() -> Bool:
	match compile(source("walk(Stop, identity(current), identity(saved))")):
		Err(_):
			False
		Ok(output):
			(
				output.contains("{while (1){const enum blorp_u_0 blorp_vl_0=blorp_p_0;")
				and output.contains("const int64_t blorp_vl_3=blorp_f_2(blorp_vl_1);")
				and output.contains(
					"blorp_p_0=blorp_vl_4;blorp_p_1=blorp_vl_5;blorp_p_2=blorp_vl_6;continue;",
				)
				and not output.contains("=blorp_f_1(blorp_vl_4")
			)


pure func test_zero_argument_main_emits_valid_loop() -> Bool:
	source: String =
		|@tail_recursive func main() -> Int:
		|	main()
		|

	match compile(source):
		Err(_):
			False
		Ok(output):
			(
				output.contains("int64_t blorp_f_0(void){while (1){continue;}}")
				and output.contains("int main(void){return (int)blorp_f_0();}")
			)


private pure func compiles_loop(source: String) -> Bool:
	match compile(source):
		Err(_):
			False
		Ok(output):
			output.contains("while (1)") and output.contains("continue;")


pure func test_phantom_string_argument_is_unmanaged() -> Bool:
	source: String =
		|fixed union Marker[T]:
		|	Only
		|fixed union Step:
		|	Stop
		|	Once
		|@tail_recursive pure func loop(step: Step, marker: Marker[String]) -> Int:
		|	match step:
		|		Stop: 7
		|		Once: loop(Stop, marker)
		|func main() -> Int:
		|	loop(Once, Only)
		|

	match (
		concrete(source)
			.and_then(pure func(program): Lower.lower(program))
			.and_then(pure func(program): Own.own(program))
	):
		Err(_):
			False
		Ok(program):
			match program.functions:
				[_, function]:
					match function.execution:
						SelfTailLoop(_):
							function.operations.length() == 2 and compiles_loop(source)
						_:
							False
				_:
					False


tests: TestSuite = {
	description = "Self-tail phase contracts and C projection",
	tests = [
		(
			"UFCS receiver helper precedes explicit arguments exactly once",
			test_ufcs_receiver_chain_lowers_before_explicit_arguments,
		),
		(
			"specialization preserves explicit branch backedge",
			test_specialization_preserves_backedge_and_arguments,
		),
		(
			"direct next arguments lower once in source order",
			test_direct_arguments_lower_once_in_order,
		),
		("UFCS next arguments lower once in source order", test_ufcs_arguments_lower_once_in_order),
		(
			"parameter snapshots and prefix work occur inside loop",
			test_prefix_and_snapshots_are_inside_loop,
		),
		("zero-argument main loop keeps entry ABI", test_zero_argument_main_emits_valid_loop),
		(
			"phantom String type argument has no managed payload",
			test_phantom_string_argument_is_unmanaged,
		),
	]
}
