import:
    ../../../src/utils/ids: inventory_functions
    ../../../src/load/load: LoadFailure, SourceFile, import_path, library_layout, load_program, module_role
    ../../../src/utils/names: NameId, intern_names, program_names
    ../../../src/parse/assemble: ParsedModuleRow, parsed_contents
    ../../../src/parse/parse: ImportOrigin(RelativeImport, LibraryImport)
    ../../../src/utils/source:
        COMPILER_SOURCE, ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule),
        SourceId, foundation_types_module_id, module_id, module_number, source_module, module_source, root_module_id, same_module, same_source
    ../../../src/utils/syntax: Diagnostic
    fs: IOError, message, resource_path, temporary_directory
    option: is_none, is_some
    ../../../src/utils/text: concat
    string: starts_with
    path as Path
    system: mkdir, read_file, temp_dir, write_file
    test: TestSuite


private TYPES: String =
    |type Int = builtin
    |type Float = builtin
    |type String = builtin
    |type Void = builtin
    |type List[T] = builtin
    |


private pure func exact_error(error: Diagnostic, origin: SourceId, start: Int, end: Int, message: String, help: String) -> Bool:
    (
        same_source(error.span.source, origin) and error.span.start == start and error.span.end == end
        and error.message == message and error.help == help and error.note.is_none()
    )


private pure func projects_to(importer: String, parents: Int, parts: List[String], expected: String) -> Bool:
    interned = intern_names(program_names().names, parts)
    names = interned.names
    request = {
        path = { origin = RelativeImport(parents), parts = interned.ids }, symbols = [],
        span = { source = COMPILER_SOURCE, start = 0, end = 0 }
    }
    match import_path(importer, request, names, library_layout("/target/library")):
        Err(_): False
        Ok(actual): actual == expected


pure func test_import_paths_preserve_relative_identity() -> Bool:
    (
        projects_to("/project/features/main.brp", 0, ["math", "helpers"], "/project/features/math/helpers.brp")
        and projects_to("/project/src/check/check.brp", 1, ["utils", "syntax"], "/project/src/utils/syntax.brp")
        and projects_to("/project/src/main.brp", 0, ["check", "check"], "/project/src/check/check.brp")
        and projects_to("/project/features/ui/main.brp", 2, ["shared", "helper"], "/project/shared/helper.brp")
    )


pure func test_import_path_rejects_invalid_spelling_identity() -> Bool:
    initial = program_names()
    part = intern_names(initial.names, ["helper"])
    request = { path = { origin = RelativeImport(0), parts = part.ids }, symbols = [], span = { source = COMPILER_SOURCE, start = 0, end = 0 } }
    match import_path("/project/main.brp", request, initial.names, library_layout("/target/library")):
        Ok(_): False
        Err(error): exact_error(error, COMPILER_SOURCE, 0, 0, "import path references an invalid spelling identity", "report this compiler error with the input files")


pure func test_library_path_uses_explicit_root() -> Bool:
    part = intern_names(program_names().names, ["int"])
    request = { path = { origin = LibraryImport, parts = part.ids }, symbols = [], span = { source = COMPILER_SOURCE, start = 0, end = 0 } }
    match import_path("/project/main.brp", request, part.names, library_layout("/target/library")):
        Ok(actual): actual == "/target/library/int.brp"
        Err(_): False


pure func test_roles_follow_the_configured_library() -> Bool:
    layout = library_layout("/target/library")
    (
        module_role(layout, "/target/library/_base.brp") == FoundationTypesModule
        and module_role(layout, "/target/library/prelude.brp") == FoundationPreludeModule
        and module_role(layout, "/target/library/int.brp") == LibraryModule
        and module_role(layout, "/target/library/nested/prelude.brp") == LibraryModule
        and module_role(layout, "/target/library/nested/ops.brp") == LibraryModule
        and module_role(layout, "/target/helper.brp") == UserModule
    )


pure func test_roles_preserve_directory_boundaries() -> Bool:
    layout = library_layout("/target/library")
    (
        module_role(layout, "/target/library_copy/int.brp") == UserModule
        and module_role(layout, "/target/library_copy/_base.brp") == UserModule
        and module_role(layout, "/target/other/library/prelude.brp") == UserModule
    )


pure func test_layout_normalizes_its_root() -> Bool:
    layout = library_layout("/target/./other/../library/")
    (
        module_role(layout, "/target/library/int.brp") == LibraryModule
        and module_role(layout, "/target/library/_base.brp") == FoundationTypesModule
    )


pure func test_filesystem_root_is_a_library_directory() -> Bool:
    layout = library_layout("/")
    (
        module_role(layout, "/int.brp") == LibraryModule
        and module_role(layout, "/nested/ops.brp") == LibraryModule
        and module_role(layout, "/_base.brp") == FoundationTypesModule
    )


private func write_module(directory: String, name: String, contents: String) -> Result[String, String]:
    path = Path.join(directory, name)
    written ?= write_file(path, contents)
    Ok(path)


private func library(directory: String, prelude: String) -> Result[String, String]:
    library = Path.join(directory, "library")
    created ?= if mkdir(library):
        Ok(void)
    else:
        Err("could not create test library")
    types ?= write_module(library, "_base.brp", TYPES)
    prelude ?= write_module(library, "prelude.brp", prelude)
    Ok(library)


private pure func matching_rows(rows: List[SourceFile], path: String) -> Int:
    var count = 0
    for row in rows:
        if row.path == path:
            count = count + 1
    count


private func diamond(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root: String =
        |import:
        |    ./left: left
        |    ./right: right
        |func main() -> Int:
        |    0
        |
    left = "import:\n    ./leaf: answer\npure func left() -> Int:\n    answer()\n"
    right = "import:\n    ./leaf: answer\npure func right() -> Int:\n    answer()\n"
    leaf = "pure func answer() -> Int:\n    42\n"
    root_path ?= write_module(directory, "main.brp", root)
    left_path ?= write_module(directory, "left.brp", left)
    right_path ?= write_module(directory, "right.brp", right)
    leaf_path ?= write_module(directory, "leaf.brp", leaf)
    Ok(match load_program(root_path, lib):
        Err(_): False
        Ok(loaded):
            program = parsed_contents(loaded.program)
            match program.modules:
                [root_row, base, prelude, left_row, right_row, leaf_row]:
                    match (root_row.imports, left_row.imports, right_row.imports):
                        ([root_left, root_right], [left_leaf], [right_leaf]):
                            (
                                loaded.sources.modules.length() == 6 and inventory_functions(program.declarations).length() == 4
                                and same_module(root_row.module, root_module_id())
                                and base.role == FoundationTypesModule and prelude.role == FoundationPreludeModule
                                and root_row.role == UserModule and left_row.role == UserModule and right_row.role == UserModule
                                and same_module(root_left.target, left_row.module) and same_module(root_right.target, right_row.module)
                                and same_module(left_leaf.target, leaf_row.module) and same_module(right_leaf.target, leaf_row.module)
                                and matching_rows(loaded.sources.modules, leaf_path) == 1
                                and matching_rows(loaded.sources.modules, Path.join(lib, "_base.brp")) == 1
                                and matching_rows(loaded.sources.modules, Path.join(lib, "prelude.brp")) == 1
                            )
                        _: False
                _: False
    )


private pure func cycle_rejected(failure: LoadFailure, closing: Int, start: Int, end: Int, cycle: List[String]) -> Bool:
    match module_id(closing):
        None: False
        Some(importer):
            exact_error(
                failure.diagnostic, module_source(importer), start, end,
                "import cycle: ".concat(cycle.join(" -> ")),
                "move the declarations both modules need into a third module that both import",
            )


-- The closing import is the one in the module that leads back onto the path.
private func two_module_cycle(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ./helper: answer\nfunc main() -> Int:\n    0\n")
    helper_path ?= write_module(directory, "helper.brp", "import:\n    ./main: main\npure func answer() -> Int:\n    42\n")
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure): cycle_rejected(failure, 3, 12, 24, [root_path, Path.normalize(helper_path), root_path])
    )


private func aggregate_lex_error_precedes_cycle(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ./helper: answer\nfunc main() -> Int:\n    0\n")
    beginning: String =
        |import:
        |    ./main: main
        |fixed union Pair:
        |    Pair(Int,
    prefix = beginning + " "
    source = prefix + "$)"
    helper_path ?= write_module(directory, "helper.brp", source)
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure):
            match module_id(3):
                None: False
                Some(helper):
                    (
                        exact_error(
                            failure.diagnostic, module_source(helper), prefix.length(), prefix.length() + 1,
                            "unsupported character",
                            "use ASCII function declarations and numeric literals, parameter names, or calls; keep -> adjacent",
                        )
                        and failure.sources.modules.get(3) == Some({ path = helper_path, contents = source })
                    )
    )


private func aggregate_parse_error_precedes_cycle(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ./helper: answer\nfunc main() -> Int:\n    0\n")
    beginning: String =
        |import:
        |    ./main: main
        |fixed union Pair:
        |    Pair(Int,
    -- A trailing comma is legal; a second comma is the parse error.
    prefix = beginning
    source = prefix + ",)"
    helper_path ?= write_module(directory, "helper.brp", source)
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure):
            match module_id(3):
                None: False
                Some(helper):
                    (
                        exact_error(
                            failure.diagnostic, module_source(helper), prefix.length(), prefix.length() + 1,
                            "expected a payload type",
                            "use an ASCII identifier starting with a letter or underscore; 'func', 'pure', 'match', 'var', and lone '_' are reserved",
                        )
                        and failure.sources.modules.get(3) == Some({ path = helper_path, contents = source })
                    )
    )


private func cycle_precedes_aggregate_semantics(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ./helper: answer\nfunc main() -> Int:\n    0\n")
    source: String =
        |import:
        |    ./main: main
        |fixed record Box[T] { value: T }
        |fixed union Pair[A, B]:
        |    Pair(Box[A], Missing)
        |pure func answer() -> Int:
        |    42
        |
    helper_path ?= write_module(directory, "helper.brp", source)
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure): cycle_rejected(failure, 3, 12, 24, [root_path, Path.normalize(helper_path), root_path])
    )


private func self_import(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ./main: main\nfunc main() -> Int:\n    0\n")
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure): cycle_rejected(failure, 0, 12, 24, [root_path, root_path])
    )


-- The cycle need not pass through the root: only its own modules are named.
private func three_module_cycle(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ./first: first\nfunc main() -> Int:\n    0\n")
    first_path ?= write_module(directory, "first.brp", "import:\n    ./second: second\npure func first() -> Int:\n    1\n")
    second_path ?= write_module(directory, "second.brp", "import:\n    ./third: third\npure func second() -> Int:\n    2\n")
    third_path ?= write_module(directory, "third.brp", "import:\n    ./first: first\npure func third() -> Int:\n    3\n")
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure):
            first = Path.normalize(first_path)
            cycle_rejected(failure, 5, 12, 26, [first, Path.normalize(second_path), Path.normalize(third_path), first])
    )


-- The walk starts from modules in load order and follows imports in written
-- order. Late's self-import closes in module 4, which loads before early_loop
-- (module 5), yet the walk reaches early's cycle first and reports that one.
private func first_cycle_in_load_order(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ./early: early\n    ./late: late\nfunc main() -> Int:\n    0\n")
    early_path ?= write_module(directory, "early.brp", "import:\n    ./early_loop: loop\npure func early() -> Int:\n    1\n")
    late_path ?= write_module(directory, "late.brp", "import:\n    ./late: late\npure func late() -> Int:\n    2\n")
    early_loop ?= write_module(directory, "early_loop.brp", "import:\n    ./early: early\npure func loop() -> Int:\n    3\n")
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure):
            early = Path.normalize(early_path)
            cycle_rejected(failure, 5, 12, 26, [early, Path.normalize(early_loop), early])
    )


private pure func user_import_rejected(failure: LoadFailure, importer: Int, start: Int, end: Int) -> Bool:
    match module_id(importer):
        None: False
        Some(module):
            exact_error(
                failure.diagnostic, module_source(module), start, end,
                "a library module cannot import a user module",
                "library modules may import only other library modules and _base",
            )


-- A user module receives the prelude, which imports library modules, so a
-- library module importing a user module would close a cycle through the prelude.
private func library_imports_user(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    created ?= if mkdir(Path.join(directory, "user")):
        Ok(void)
    else:
        Err("could not create user directory")
    root_path ?= write_module(directory, "main.brp", "import:\n    int: answer\nfunc main() -> Int:\n    answer()\n")
    int_path ?= write_module(lib, "int.brp", "import:\n    ../user/u: helper\npure func answer() -> Int:\n    helper()\n")
    user_path ?= write_module(Path.join(directory, "user"), "u.brp", "pure func helper() -> Int:\n    42\n")
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure): user_import_rejected(failure, 3, 12, 29)
    )


private func prelude_imports_user(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "import:\n    ../helper: helper\n")
    root_path ?= write_module(directory, "main.brp", "func main() -> Int:\n    0\n")
    helper_path ?= write_module(directory, "helper.brp", "pure func helper() -> Int:\n    42\n")
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure): user_import_rejected(failure, 2, 12, 29)
    )


-- The application root is a user module even when it lives under the library root.
private func library_imports_root(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(lib, "app.brp", "import:\n    ops: answer\nfunc main() -> Int:\n    answer()\n")
    ops_path ?= write_module(lib, "ops.brp", "import:\n    ./app: main\npure func answer() -> Int:\n    42\n")
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure): user_import_rejected(failure, 3, 12, 23)
    )


private func reserved(directory: String, path: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ".concat(path).concat(": Int\nfunc main() -> Int:\n    0\n"))
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure):
            (
                failure.diagnostic.message == "the prelude cannot be imported explicitly"
                and failure.diagnostic.help == "remove this import; user modules receive the prelude automatically"
                and same_source(failure.diagnostic.span.source, module_source(root_module_id()))
                and failure.diagnostic.span.start == 12
            )
    )


-- The base is an ordinary import target: it keeps its designated identity and
-- is read once however it is reached.
private func explicit_base(directory: String, path: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ".concat(path).concat(": Int\nfunc main() -> Int:\n    0\n"))
    Ok(match load_program(root_path, lib):
        Err(_): False
        Ok(loaded):
            match parsed_contents(loaded.program).modules:
                [root, base, _]:
                    match root.imports:
                        [request]:
                            (
                                same_module(request.target, base.module) and same_module(base.module, foundation_types_module_id())
                                and matching_rows(loaded.sources.modules, Path.join(lib, "_base.brp")) == 1
                            )
                        _: False
                _: False
    )


private func foundation_root(directory: String, file: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path = Path.join(lib, file)
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure):
            (
                failure.diagnostic.message == "foundation modules cannot be application roots"
                and failure.sources.modules == [{ path = root_path, contents = "" }]
            )
    )


private func roles(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "import:\n    _base: Int\n    ops: Int methods_only\n")
    root_path ?= write_module(directory, "main.brp", "import:\n    ops: answer\n    ./helper: helper\n    ./library/shared: shared\nfunc main() -> Int:\n    0\n")
    ops_path ?= write_module(lib, "ops.brp", "import:\n    ./shared: shared\npure func answer() -> Int:\n    42\n")
    shared_path ?= write_module(lib, "shared.brp", "pure func shared() -> Int:\n    0\n")
    helper_path ?= write_module(directory, "helper.brp", "pure func helper() -> Int:\n    0\n")
    Ok(match load_program(root_path, lib):
        Err(_): False
        Ok(loaded):
            match parsed_contents(loaded.program).modules:
                [root, base, prelude, ops, helper, shared]:
                    (
                        root.role == UserModule and helper.role == UserModule and ops.role == LibraryModule and shared.role == LibraryModule
                        and base.role == FoundationTypesModule and prelude.role == FoundationPreludeModule
                        and matching_rows(loaded.sources.modules, ops_path) == 1 and matching_rows(loaded.sources.modules, shared_path) == 1
                    )
                _: False
    )


private func missing_foundation(directory: String, missing: String) -> Result[Bool, String]:
    lib = Path.join(directory, "library")
    created ?= if mkdir(lib):
        Ok(void)
    else:
        Err("could not create test library")
    root_path ?= write_module(directory, "main.brp", "func main() -> Int:\n    0\n")
    present ?= if missing == "_base.brp":
        write_module(lib, "prelude.brp", "")
    else:
        write_module(lib, "_base.brp", TYPES)
    missing_path = Path.join(lib, missing)
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure):
            known_origin = match source_module(failure.diagnostic.span.source):
                Some(id): failure.sources.modules.get(module_number(id)).is_some()
                None: False
            failure.diagnostic.message.starts_with("could not read module ".concat(missing_path)) and known_origin
    )


private func imported_parse_error(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    ./helper: answer\nfunc main() -> Int:\n    0\n")
    helper_path ?= write_module(directory, "helper.brp", "import:\n    ./helper.brp: answer\n")
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure):
            (
                failure.sources.modules.length() == 4 and failure.sources.modules.get(3) == Some({ path = helper_path, contents = "import:\n    ./helper.brp: answer\n" })
                and failure.diagnostic.message == "import paths omit file extensions"
                and failure.diagnostic.span.start == 20 and failure.diagnostic.span.end == 21
            )
    )


private func no_fallback(directory: String) -> Result[Bool, String]:
    lib ?= library(directory, "")
    root_path ?= write_module(directory, "main.brp", "import:\n    absent: answer\nfunc main() -> Int:\n    0\n")
    decoy ?= write_module(directory, "absent.brp", "pure func answer() -> Int:\n    42\n")
    Ok(match load_program(root_path, lib):
        Ok(_): False
        Err(failure):
            (
                failure.diagnostic.message.starts_with("could not read module ".concat(Path.join(lib, "absent.brp")))
                and same_source(failure.diagnostic.span.source, module_source(root_module_id()))
            )
    )


private func in_directory(check: (String) -> Result[Bool, String]) -> Bool:
    match scoped_directory(check):
        Ok(passed): passed
        Err(error):
            print_error(message(error))
            False


private func scoped_directory(check: (String) -> Result[Bool, String]) -> Result[Bool, IOError]:
    with directory ?= temporary_directory(temp_dir(), "blorp-2-load "):
        match check(directory.resource_path()):
            Ok(passed): Ok(passed)
            Err(error):
                print_error(error)
                Ok(False)


tests: TestSuite = {
    description = "Blorp 2 configured source inventory",
    tests = [
        ("relative path projection", test_import_paths_preserve_relative_identity),
        ("invalid spelling rejected", test_import_path_rejects_invalid_spelling_identity),
        ("explicit library path", test_library_path_uses_explicit_root),
        ("roles follow the configured library", test_roles_follow_the_configured_library),
        ("roles preserve directory boundaries", test_roles_preserve_directory_boundaries),
        ("layout normalizes its root", test_layout_normalizes_its_root),
        ("filesystem root is a library directory", test_filesystem_root_is_a_library_directory),
        ("diamond loaded and parsed once", func(): in_directory(diamond)),
        ("two-module import cycle rejected at its closing import", func(): in_directory(two_module_cycle)),
        ("aggregate lexical error precedes cycle analysis", func(): in_directory(aggregate_lex_error_precedes_cycle)),
        ("aggregate parse error precedes cycle analysis", func(): in_directory(aggregate_parse_error_precedes_cycle)),
        ("cycle precedes aggregate semantic rejection", func(): in_directory(cycle_precedes_aggregate_semantics)),
        ("self-import is a cycle", func(): in_directory(self_import)),
        ("three-module cycle names only its modules", func(): in_directory(three_module_cycle)),
        ("first cycle in load order is reported", func(): in_directory(first_cycle_in_load_order)),
        ("library module cannot import a user module", func(): in_directory(library_imports_user)),
        ("prelude cannot import a user module", func(): in_directory(prelude_imports_user)),
        ("library module cannot import a root under the library", func(): in_directory(library_imports_root)),
        ("bare base import is the designated base", func(): in_directory(func(dir): explicit_base(dir, "_base"))),
        ("relative base import is the designated base", func(): in_directory(func(dir): explicit_base(dir, "./library/_base"))),
        ("bare prelude import reserved", func(): in_directory(func(dir): reserved(dir, "prelude"))),
        ("relative prelude import reserved", func(): in_directory(func(dir): reserved(dir, "./library/prelude"))),
        ("base cannot be the application root", func(): in_directory(func(dir): foundation_root(dir, "_base.brp"))),
        ("prelude cannot be the application root", func(): in_directory(func(dir): foundation_root(dir, "prelude.brp"))),
        ("roles use configured root across relative paths", func(): in_directory(roles)),
        ("missing base has source path", func(): in_directory(func(dir): missing_foundation(dir, "_base.brp"))),
        ("missing prelude has source path", func(): in_directory(func(dir): missing_foundation(dir, "prelude.brp"))),
        ("imported parse error retains bytes", func(): in_directory(imported_parse_error)),
        ("missing library module does not fall back", func(): in_directory(no_fallback)),
    ]
}
