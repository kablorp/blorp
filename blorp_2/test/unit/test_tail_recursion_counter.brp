import:
	../e2e/fixtures/tail_recursion/countdown:
		Carry(Decrement, Keep),
		Digit(D0, D1, D2, D3, D4, D5, D6, D7, D8, D9, D10, D11, D12, D13, D14, D15),
		adjust,
		borrow,
		either,
		nonzero,
		predecessor,
	test: TestSuite


-- These direct host calls verify the workload's helper tables. The e2e suite
-- compiles the unchanged countdown source with the pilot and runs its own main.
private pure func number(digit: Digit) -> Int:
	match digit:
		D0:
			0
		D1:
			1
		D2:
			2
		D3:
			3
		D4:
			4
		D5:
			5
		D6:
			6
		D7:
			7
		D8:
			8
		D9:
			9
		D10:
			10
		D11:
			11
		D12:
			12
		D13:
			13
		D14:
			14
		D15:
			15


private pure func digits() -> List[Digit]:
	[D0, D1, D2, D3, D4, D5, D6, D7, D8, D9, D10, D11, D12, D13, D14, D15]


private pure func keeps(incoming: Carry) -> Bool:
	match incoming:
		Keep:
			True
		Decrement:
			False


pure func test_borrow_without_incoming_decrement() -> Bool:
	var passed = True

	for digit in digits():
		passed = passed and keeps(borrow(digit, Keep))

	passed


pure func test_borrow_stops_at_every_nonzero_digit() -> Bool:
	var passed = True

	for digit in [D1, D2, D3, D4, D5, D6, D7, D8, D9, D10, D11, D12, D13, D14, D15]:
		passed = passed and keeps(borrow(digit, Decrement))

	passed


pure func test_adjust_without_incoming_decrement() -> Bool:
	var passed = True

	for digit in digits():
		passed = passed and number(adjust(digit, Keep)) == number(digit)

	passed


pure func test_nonzero_detects_every_nonzero_digit() -> Bool:
	var passed = True

	for digit in [D1, D2, D3, D4, D5, D6, D7, D8, D9, D10, D11, D12, D13, D14, D15]:
		passed = passed and not keeps(nonzero(digit))

	passed


tests: TestSuite = {
	description = "Tail-recursion countdown helper truth tables",
	tests = [
		("predecessor D0", pure func(): number(predecessor(D0)) == 15),
		("predecessor D1", pure func(): number(predecessor(D1)) == 0),
		("predecessor D2", pure func(): number(predecessor(D2)) == 1),
		("predecessor D3", pure func(): number(predecessor(D3)) == 2),
		("predecessor D4", pure func(): number(predecessor(D4)) == 3),
		("predecessor D5", pure func(): number(predecessor(D5)) == 4),
		("predecessor D6", pure func(): number(predecessor(D6)) == 5),
		("predecessor D7", pure func(): number(predecessor(D7)) == 6),
		("predecessor D8", pure func(): number(predecessor(D8)) == 7),
		("predecessor D9", pure func(): number(predecessor(D9)) == 8),
		("predecessor D10", pure func(): number(predecessor(D10)) == 9),
		("predecessor D11", pure func(): number(predecessor(D11)) == 10),
		("predecessor D12", pure func(): number(predecessor(D12)) == 11),
		("predecessor D13", pure func(): number(predecessor(D13)) == 12),
		("predecessor D14", pure func(): number(predecessor(D14)) == 13),
		("predecessor D15", pure func(): number(predecessor(D15)) == 14),
		("adjust with decrement D0", pure func(): number(adjust(D0, Decrement)) == 15),
		("adjust with decrement D1", pure func(): number(adjust(D1, Decrement)) == 0),
		("adjust with decrement D2", pure func(): number(adjust(D2, Decrement)) == 1),
		("adjust with decrement D3", pure func(): number(adjust(D3, Decrement)) == 2),
		("adjust with decrement D4", pure func(): number(adjust(D4, Decrement)) == 3),
		("adjust with decrement D5", pure func(): number(adjust(D5, Decrement)) == 4),
		("adjust with decrement D6", pure func(): number(adjust(D6, Decrement)) == 5),
		("adjust with decrement D7", pure func(): number(adjust(D7, Decrement)) == 6),
		("adjust with decrement D8", pure func(): number(adjust(D8, Decrement)) == 7),
		("adjust with decrement D9", pure func(): number(adjust(D9, Decrement)) == 8),
		("adjust with decrement D10", pure func(): number(adjust(D10, Decrement)) == 9),
		("adjust with decrement D11", pure func(): number(adjust(D11, Decrement)) == 10),
		("adjust with decrement D12", pure func(): number(adjust(D12, Decrement)) == 11),
		("adjust with decrement D13", pure func(): number(adjust(D13, Decrement)) == 12),
		("adjust with decrement D14", pure func(): number(adjust(D14, Decrement)) == 13),
		("adjust with decrement D15", pure func(): number(adjust(D15, Decrement)) == 14),
		("borrow without decrement at every digit", test_borrow_without_incoming_decrement),
		("borrow propagates at zero", pure func(): not keeps(borrow(D0, Decrement))),
		("borrow stops at every nonzero digit", test_borrow_stops_at_every_nonzero_digit),
		("adjust without decrement preserves every digit", test_adjust_without_incoming_decrement),
		("zero is inactive", pure func(): keeps(nonzero(D0))),
		("every nonzero digit is active", test_nonzero_detects_every_nonzero_digit),
		("either keep keep", pure func(): keeps(either(Keep, Keep))),
		("either keep decrement", pure func(): not keeps(either(Keep, Decrement))),
		("either decrement keep", pure func(): not keeps(either(Decrement, Keep))),
		("either decrement decrement", pure func(): not keeps(either(Decrement, Decrement))),
	]
}
