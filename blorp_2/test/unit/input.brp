import:
	../../src/utils/source: module_source, root_module_id
	../../src/check/check as Check: CheckFailure, CheckedProgram, check_errors
	../../src/check/model as Checked
	../../src/check/errors: BuiltinError(BuiltinTypesRejected), CheckError, CheckErrorKind, CheckErrors, builtin_error
	../../src/check/traits: designated_trait, accept_trait_contracts, validate_implementations
	../../src/check/signatures: CheckedSignatures, validate_signatures
	../../src/namespace/namespace: Namespace
	../../src/check/render: render_failure
	../../src/lex/lex: lex
	../../src/utils/names: InitialNames, NameId, NameTable, intern_names, program_names, same_name_table
	../../src/parse/assemble: ParsedProgram, parsed_contents
	../../src/namespace/builtins: CheckedFoundation, check_builtin_types, render_builtin_type_error
	../../src/utils/syntax: Diagnostic, LexedProgram
	../../src/utils/ids: TraitId
	./module_input: ModuleInput, TestFoundation, parse_modules_with_base, parse_root
	result: and_then, map_err
	int as IntOps


-- The ID `names` already gives `spelling`, or None when interning it would
-- extend the table. Tests ask which ID a published table gave a spelling.
pure func existing_name(names: NameTable, spelling: String) -> Option[NameId]:
	interned = intern_names(names, [spelling])

	match interned.ids:
		[id]:
			if same_name_table(interned.names, names):
				Some(id)
			else:
				None
		_:
			None


pure func initial_names() -> Result[InitialNames, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), "func main() -> Int:\n    0\n", program_names().names)
	program ?= parse_root(tokens)
	foundation ?= check_builtin_types(program).map_err(render_builtin_type_error)
	Ok(foundation.initial)


-- Test setup borrows one accepted contract list across the signatures and
-- implementation boundaries, while signature-only observers stop before the latter.
fixed record PreparedSignatures {
	signatures: CheckedSignatures,
	contracts: List[Checked.AcceptedTrait],
	canonical: Option[TraitId]
}


pure func prepare_signatures(program: ParsedProgram, namespace: Namespace) -> Result[PreparedSignatures, CheckError]:
	foundation: CheckedFoundation ?= match check_builtin_types(program):
		Ok(accepted): Ok(accepted)
		Err(error): Err(builtin_error(error.span, BuiltinTypesRejected(error)))
	parsed = parsed_contents(program)
	canonical = designated_trait(parsed, namespace)
	contracts ?= accept_trait_contracts(parsed, namespace, foundation.designated.boolean, canonical)
	signatures ?= validate_signatures(parsed, namespace, foundation.designated, contracts)
	Ok({ signatures = signatures, contracts = contracts, canonical = canonical })


pure func accepted_signatures(program: ParsedProgram, namespace: Namespace) -> Result[CheckedSignatures, CheckError]:
	prepared ?= prepare_signatures(program, namespace)
	Ok(prepared.signatures)


pure func accepted_traits(
	program: ParsedProgram,
	namespace: Namespace,
	prepared: PreparedSignatures,
) -> Result[Checked.AcceptedTraits, CheckError]:
	validate_implementations(
		parsed_contents(program), namespace, prepared.signatures.implementation_headers,
		prepared.signatures.functions, prepared.contracts, prepared.canonical,
	)


pure func parse(input: LexedProgram) -> Result[ParsedProgram, Diagnostic]:
	parse_root(input)


pure func check(program: ParsedProgram) -> Result[CheckedProgram, CheckFailure]:
	Check.check(program)


-- Ordinary tail observers require the value-join product, never a legacy tail.
pure func checked_tail_join(body: Checked.CheckedBody) -> Option[Checked.CheckedJoin]:
	match body:
		Checked.CheckedValueBody(Checked.ReturnExpression(value)):
			match value.form:
				Checked.Match(join): Some(join)
				_: None
		_: None


-- Parsing failures and accepted programs cannot satisfy a semantic rejection test.
pure func check_failure(source: String) -> Option[CheckError]:
	parsed_check_failure(lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)))


pure func check_modules_failure(inputs: List[ModuleInput], foundation: TestFoundation) -> Option[CheckError]:
	parsed_check_failure(parse_modules_with_base(inputs, foundation))


private pure func parsed_check_failure(program: Result[ParsedProgram, Diagnostic]) -> Option[CheckError]:
	match program:
		Err(_):
			None
		Ok(parsed):
			match check(parsed):
				Ok(_):
					None
				Err(failure):
					singleton_check_error(check_errors(failure))


pure func singleton_check_error(errors: CheckErrors) -> Option[CheckError]:
	match errors.remaining:
		[]:
			Some(errors.first)
		_:
			None


-- Used only to compose success-path setup with unchanged later phases.
-- A future multiple-error checker must not silently collapse this adapter.
pure func setup_diagnostic(failure: CheckFailure) -> Diagnostic:
	errors = render_failure(failure)

	match errors.remaining:
		[]:
			errors.first
		_:
			{
				span = errors.first.span,
				note = None,
				message = "test setup received multiple checker errors",
				help = "handle the complete checker error collection"
			}


pure func checked_source(source: String) -> Result[CheckedProgram, Diagnostic]:
	tokens ?= lex(module_source(root_module_id()), source, program_names().names)
	parsed ?= parse(tokens)
	check(parsed).map_err(setup_diagnostic)


-- Whether checking rejects the source with an error at exactly this span.
pure func rejects_at(
	source: String,
	start: Int,
	end: Int,
	matches: pure (CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(source):
		None:
			False
		Some(error):
			if IntOps.equals(error.span.start, start):
				if IntOps.equals(error.span.end, end):
					matches(error.kind)
				else:
					False
			else:
				False
