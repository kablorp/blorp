import:
	../../src/lower: RecordFieldValue, ValueId
	../../src/own:
		OwnedArgument(UnmanagedArgument),
		OwnedDefinition,
		OwnedExit(ReturnResult),
		OwnedFunction,
		OwnedTail(ReturnTail),
		OwnedValueOperation(
			IntegerDefinition, ConstructRecordDefinition, ReadRecordFieldDefinition,
			ParameterDefinition, CallDefinition,
		),
		OwnershipOperation(DefineValue),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult, OwnedResult),
		ReturnTransfer(UnmanagedReturn),
		ValueOwnership(NoOwnership),
		owner_id,
		value_ownership,
	../../src/prelude: RuntimeOperation(IntToString)
	../../src/specialize:
		CallTarget(UserFunction, RuntimeFunction),
		FieldInstanceId,
		TypeRef(IntType, StringType, RecordType),
	../../src/syntax: FunctionExecution(OrdinaryCalls)
	../../src/verify: verify
	ownership_inputs: RecordIds, record_ids, span
	test: TestSuite


private pure func integer(id: ValueId, number: Int) -> OwnershipOperation:
	DefineValue({
		id = id,
		value_type = IntType,
		operation = IntegerDefinition(number),
		result = UnmanagedResult,
		span = span(10),
	})


private pure func constructed(ids: RecordIds, fields: List[RecordFieldValue]) -> OwnedDefinition:
	{
		id = ids.third,
		value_type = RecordType(ids.record_id),
		operation = ConstructRecordDefinition(ids.record_id, fields),
		result = UnmanagedResult,
		span = span(30)
	}


private pure func fields(ids: RecordIds) -> List[RecordFieldValue]:
	[
		{
			field = ids.second_field,
			value = ids.second
		},
		{
			field = ids.first_field,
			value = ids.first
		},
	]


private pure func projection(
	ids: RecordIds,
	field: FieldInstanceId,
	source: ValueId,
) -> OwnedDefinition:
	{
		id = ids.fourth,
		value_type = IntType,
		operation = ReadRecordFieldDefinition(field, source),
		result = UnmanagedResult,
		span = span(40)
	}


private pure func program(
	ids: RecordIds,
	construction: OwnedDefinition,
	projected: OwnedDefinition,
) -> OwnershipProgram:
	{
		records = ids.records,
		unions = [],
		entrypoint = ids.entrypoint,
		functions = [
			{
				execution = OrdinaryCalls,
				signature = {
					parameters = [],
					return_type = IntType
				},
				operations = [
					integer(ids.first, 7),
					integer(ids.second, 9),
					DefineValue(construction),
					DefineValue(projected),
				],
				tail = ReturnTail(ReturnResult(UnmanagedReturn(ids.fourth)))
			},
		]
	}


private pure func rejects(
	input: OwnershipProgram,
	message: String,
	at: Int,
	end: Int,
) -> Bool:
	match verify(input):
		Err(error):
			(
				error.message == "ownership verification failed: " + message
				and error.help == "report this compiler error with the input program"
				and error.span.start == at
				and error.span.end == end
			)
		Ok(_):
			False


private pure func rejects_fields(
	ids: RecordIds,
	supplied: List[RecordFieldValue],
	message: String,
) -> Bool:
	rejects(
		program(
			ids,
			constructed(ids, supplied),
			projection(ids, ids.first_field, ids.third),
		),
		message,
		30,
		31,
	)


pure func test_accepts_reordered_complete_fields_and_projection() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			match verify(
				program(
					ids,
					constructed(ids, fields(ids)),
					projection(ids, ids.first_field, ids.third),
				),
			):
				Ok(_):
					True
				Err(_):
					False


pure func test_rejects_another_record_field_owner() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			rejects_fields(
				ids,
				[
					{
						field = ids.other_field,
						value = ids.first
					},
					{
						field = ids.second_field,
						value = ids.second
					},
				],
				"field belongs to a different record layout",
			)


pure func test_rejects_duplicate_construction_fields() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			rejects_fields(
				ids,
				[
					{
						field = ids.first_field,
						value = ids.first
					},
					{
						field = ids.first_field,
						value = ids.second
					},
				],
				"record construction repeats a field",
			)


pure func test_rejects_missing_construction_fields() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			rejects_fields(
				ids,
				[
					{
						field = ids.first_field,
						value = ids.first
					},
				],
				"record construction must provide every field exactly once",
			)


pure func test_rejects_unavailable_field_operands() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			rejects_fields(
				ids,
				[
					{
						field = ids.first_field,
						value = ids.fourth
					},
					{
						field = ids.second_field,
						value = ids.second
					},
				],
				"value 3 is not defined before use",
			)


pure func test_rejects_a_string_field_operand() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			original = program(
				ids,
				constructed(ids, fields(ids)),
				projection(ids, ids.first_field, ids.third),
			)
			text = DefineValue({
				id = ids.second,
				value_type = StringType,
				operation = CallDefinition(
					{
						target = RuntimeFunction(IntToString),
						span = span(20)
					},
					[UnmanagedArgument(ids.first)],
				),
				result = OwnedResult(owner_id(0)),
				span = span(20),
			})
			rejects(
				{ original | functions = [
						{
							execution = OrdinaryCalls,
							signature = {
								parameters = [],
								return_type = IntType
							},
							operations = [
								integer(ids.first, 7),
								text,
								DefineValue(constructed(ids, fields(ids))),
							],
							tail = ReturnTail(ReturnResult(UnmanagedReturn(ids.first)))
						},
					] },
				"record field value type does not match its layout",
				30,
				31,
			)


pure func test_rejects_construction_reporting_another_record_type() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			original = constructed(ids, fields(ids))
			rejects(
				program(
					ids,
					{ original | value_type = RecordType(ids.other_record) },
					projection(ids, ids.first_field, ids.third),
				),
				"definition type does not match its operation",
				30,
				31,
			)


pure func test_rejects_record_ownership_obligations() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			original = constructed(ids, fields(ids))
			rejects(
				program(
					ids,
					{ original | result = OwnedResult(owner_id(0)) },
					projection(ids, ids.first_field, ids.third),
				),
				"unmanaged value carries an ownership obligation",
				30,
				31,
			)


pure func test_rejects_projection_from_an_integer() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			rejects(
				program(
					ids,
					constructed(ids, fields(ids)),
					projection(ids, ids.first_field, ids.first),
				),
				"field projection requires a record value",
				40,
				41,
			)


pure func test_rejects_projection_from_another_record_owner() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			rejects(
				program(
					ids,
					constructed(ids, fields(ids)),
					projection(ids, ids.other_field, ids.third),
				),
				"field belongs to a different record layout",
				40,
				41,
			)


pure func test_rejects_unavailable_projection_source() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			rejects(
				program(
					ids,
					constructed(ids, fields(ids)),
					projection(ids, ids.first_field, ids.fifth),
				),
				"value 4 is not defined before use",
				40,
				41,
			)


pure func test_rejects_wrong_projection_result_type() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			original = projection(ids, ids.first_field, ids.third)
			rejects(
				program(
					ids,
					constructed(ids, fields(ids)),
					{ original | value_type = StringType },
				),
				"definition type does not match its operation",
				40,
				41,
			)


pure func test_rejects_a_removed_public_record_layout() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			original = program(
				ids,
				constructed(ids, fields(ids)),
				projection(ids, ids.first_field, ids.third),
			)
			rejects({ original | records = [] }, "unknown record layout", 30, 31)


pure func test_rejects_a_field_removed_from_its_public_layout() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			original = program(
				ids,
				constructed(ids, fields(ids)),
				projection(ids, ids.first_field, ids.third),
			)
			one_field = { original | records = [{fields = [IntType]}] }
			single = constructed(
				ids,
				[
					{
						field = ids.second_field,
						value = ids.first
					},
				],
			)
			malformed = program(
				ids,
				single,
				projection(ids, ids.first_field, ids.third),
			)
			rejects({ malformed | records = one_field.records }, "unknown record field", 30, 31)


pure func test_rejects_an_unused_empty_record_layout() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			original = program(
				ids,
				constructed(ids, fields(ids)),
				projection(ids, ids.first_field, ids.third),
			)
			rejects(
				{ original | records = ids.records.append({fields = []}) },
				"record layout must contain one or more Int fields",
				0,
				0,
			)


pure func test_rejects_an_unused_non_int_record_layout() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			original = program(
				ids,
				constructed(ids, fields(ids)),
				projection(ids, ids.first_field, ids.third),
			)
			rejects(
				{ original | records = ids.records.append({fields = [StringType]}) },
				"record layout must contain one or more Int fields",
				0,
				0,
			)


pure func test_rejects_unknown_record_parameters_without_projection() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			original = program(
				ids,
				constructed(ids, fields(ids)),
				projection(ids, ids.first_field, ids.third),
			)
			parameter: OwnedDefinition = {
				id = ids.first,
				value_type = RecordType(ids.record_id),
				operation = ParameterDefinition(0),
				result = UnmanagedResult,
				span = span(10)
			}
			helper: OwnedFunction = {
				execution = OrdinaryCalls,
				signature = {
					parameters = [RecordType(ids.record_id)],
					return_type = RecordType(ids.record_id)
				},
				operations = [DefineValue(parameter)],
				tail = ReturnTail(ReturnResult(UnmanagedReturn(ids.first)))
			}
			main_function: OwnedFunction = {
				execution = OrdinaryCalls,
				signature = {
					parameters = [],
					return_type = IntType
				},
				operations = [integer(ids.first, 7)],
				tail = ReturnTail(ReturnResult(UnmanagedReturn(ids.first)))
			}
			rejects(
				{ original |
					records = [],
					functions = [main_function, helper]
				},
				"unknown record layout",
				10,
				11,
			)


pure func test_record_classification_requires_a_valid_layout() -> Bool:
	match record_ids():
		Err(_):
			False
		Ok(ids):
			match value_ownership(RecordType(ids.record_id), [], ids.records):
				Ok(NoOwnership):
					match value_ownership(RecordType(ids.record_id), [], []):
						Err(error):
							error.message == "internal compiler error: invalid record identity in ownership representation"
						Ok(_):
							False
				_:
					False


tests: TestSuite = {
	description = "Independent fixed record verification",
	tests = [
		(
			"reordered complete construction and projection",
			test_accepts_reordered_complete_fields_and_projection,
		),
		("construction field owner", test_rejects_another_record_field_owner),
		("construction duplicate", test_rejects_duplicate_construction_fields),
		("construction missing field", test_rejects_missing_construction_fields),
		("construction operand availability", test_rejects_unavailable_field_operands),
		("construction field value type", test_rejects_a_string_field_operand),
		("construction reported type", test_rejects_construction_reporting_another_record_type),
		("record carries no ownership obligation", test_rejects_record_ownership_obligations),
		("projection requires record", test_rejects_projection_from_an_integer),
		("projection field owner", test_rejects_projection_from_another_record_owner),
		("projection operand availability", test_rejects_unavailable_projection_source),
		("projection reported type", test_rejects_wrong_projection_result_type),
		("removed public layout", test_rejects_a_removed_public_record_layout),
		("removed public field", test_rejects_a_field_removed_from_its_public_layout),
		("unused empty layout", test_rejects_an_unused_empty_record_layout),
		("unused non Int layout", test_rejects_an_unused_non_int_record_layout),
		(
			"unknown pass through parameter layout",
			test_rejects_unknown_record_parameters_without_projection,
		),
		("classification validates layout", test_record_classification_requires_a_valid_layout),
	]
}
