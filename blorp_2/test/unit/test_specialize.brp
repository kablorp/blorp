import:
	../../src/check: check, checked_functions
	../../src/declarations as Declaration
	../../src/lex: lex
	../../src/source: COMPILER_SOURCE, module_source, root_module_id, same_source
	../../src/specialize:
		CallTarget(UserFunction, RuntimeFunction),
		ConcreteBase(ReturnCall),
		ConcreteBody(ConcreteValueBody, ConcreteMatchBody),
		ConcreteExit(ReturnExpression),
		ConcreteFunction,
		ConcreteOperation(InvokeFunction),
		ConcreteStatement(InitializeBinding, ReassignBinding),
		ConcreteValue,
		RecordRepresentation(InlineRecord, ManagedRecord),
		SpecializedContents,
		TypeRef(VoidType, IntType, FloatType, StringType, ListType, RecordType, UnionType),
		UnionRepresentation(InlineUnmanaged, InlineOwningPayload),
		ValueOwnership(
			NoOwnership, ManagedStringLeaf, ManagedListRoot, ManagedRecordRoot,
			InlineOwnedFields,
		),
		function_number,
		record_number,
		same_type,
		specialize,
		specialized_contents,
		union_number,
		value_ownership,
	../../src/syntax: Diagnostic, Entrypoint(NoArguments), entry_function
	input: parse, setup_diagnostic
	test: TestSuite


private IDENTITY: String =
	|pure func identity[T](value: T) -> T:
	|	value
	|


private pure func program(source: String) -> Result[SpecializedContents, Diagnostic]:
	lexed ?= lex(module_source(root_module_id()), source)
	parsed ?= parse(lexed)
	checked ?= check(parsed)
		.map_err(setup_diagnostic)
	concrete ?= specialize(checked)
	Ok(specialized_contents(concrete))


private pure func fixture(source: String) -> Result[List[ConcreteFunction], Diagnostic]:
	program(source).map(pure func(contents): contents.functions)


private pure func target(value: ConcreteValue) -> Option[Int]:
	call = match value.operations:
		[step]:
			match step.operation:
				InvokeFunction(call, _):
					Some(call)
				_:
					None
		[]:
			match value.base:
				ReturnCall(call, _):
					Some(call)
				_:
					None
		_:
			None

	match call:
		Some(call):
			match call.target:
				UserFunction(id):
					Some(function_number(id))
				RuntimeFunction(_):
					None
		None:
			None


private pure func body_target(function: ConcreteFunction) -> Option[Int]:
	match function.body:
		ConcreteValueBody(ReturnExpression(value)):
			target(value)
		_:
			None


private pure func repeated_target(value: ConcreteValue, expected: Int) -> Bool:
	match value.operations:
		[first, second]:
			(
				target({ value | operations = [first] }) == Some(expected)
				and target({ value | operations = [second] }) == Some(expected)
			)
		_:
			False


private pure func returns_type(exit: ConcreteExit, expected: TypeRef) -> Bool:
	match exit:
		ReturnExpression(value):
			same_type(value.base_type, expected)
		_:
			False


private pure func returns_repeated_target(exit: ConcreteExit, expected: Int) -> Bool:
	match exit:
		ReturnExpression(value):
			repeated_target(value, expected)
		_:
			False


pure func test_direct_and_ufcs_reuse_one_instance() -> Bool:
	main_source: String =
		|func main() -> Int:
		|	first = identity(7)
		|	second = 8.identity()
		|	identity(9)
		|

	match fixture(IDENTITY + main_source):
		Ok([main, identity]):
			match main.statements:
				[InitializeBinding(_, first), InitializeBinding(_, second)]:
					(
						target(first) == Some(1)
						and target(second) == Some(1)
						and body_target(main) == Some(1)
						and same_type(identity.signature.return_type, IntType)
					)
				_:
					False
		_:
			False


pure func test_argument_types_create_distinct_complete_instances() -> Bool:
	main_source: String =
		|func main() -> Int:
		|	integer = identity(7)
		|	text = "7".identity()
		|	ignored = identity(text)
		|	0
		|

	match fixture(IDENTITY + main_source):
		Ok([_, integer, text]):
			match integer.signature.parameters:
				[integer_type]:
					match text.signature.parameters:
						[text_type]:
							(
								same_type(integer_type, IntType)
								and same_type(integer.signature.return_type, IntType)
								and same_type(text_type, StringType)
								and same_type(text.signature.return_type, StringType)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_forwarded_symbolic_call_is_remapped_to_concrete_callee() -> Bool:
	source: String =
		|pure func forward[Element](value: Element) -> Element:
		|	identity(value)
		|func main() -> Int:
		|	forward(42)
		|

	match fixture(IDENTITY + source):
		Ok([main, forward, identity]):
			(
				body_target(main) == Some(1)
				and body_target(forward) == Some(2)
				and same_type(forward.signature.return_type, IntType)
				and same_type(identity.signature.return_type, IntType)
			)
		_:
			False


pure func test_declarations_with_same_parameter_spelling_stay_distinct() -> Bool:
	source: String =
		|pure func other[T](value: T) -> T:
		|	value
		|func main() -> Int:
		|	first = identity(7)
		|	other(9)
		|

	match fixture(IDENTITY + source):
		Ok([main, _, _]):
			match main.statements:
				[InitializeBinding(_, first)]:
					target(first) == Some(1) and body_target(main) == Some(2)
				_:
					False
		_:
			False


private pure func binding_types(function: ConcreteFunction, expected: TypeRef) -> Bool:
	var valid = function.bindings.length() == 3

	for binding in function.bindings:
		valid = valid and same_type(binding.value_type, expected)

	match function.statements:
		[InitializeBinding(_, first), InitializeBinding(_, second), ReassignBinding(_, replacement)]:
			(
				valid
				and same_type(first.base_type, expected)
				and same_type(second.base_type, expected)
				and same_type(replacement.base_type, expected)
			)
		_:
			False


pure func test_bindings_and_reassignments_are_substituted_per_instance() -> Bool:
	source: String =
		|pure func preserve[T](value: T) -> T:
		|	var current = value
		|	original = current
		|	current = value
		|	original
		|func main() -> Int:
		|	integer = preserve(7)
		|	text = preserve("7")
		|	0
		|

	match fixture(source):
		Ok([_, integer, text]):
			binding_types(integer, IntType) and binding_types(text, StringType)
		_:
			False


pure func test_nominal_union_arguments_do_not_merge() -> Bool:
	first_source: String =
		|fixed union First:
		|	Only
		|fixed union Second:
		|	Only
		|pure func first() -> First:
		|	Only
		|pure func second() -> Second:
		|	Only
		|
	main_source: String =
		|func main() -> Int:
		|	a = identity(first())
		|	b = identity(second())
		|	0
		|

	match fixture(first_source + IDENTITY + main_source):
		Ok([_, _, first, _, second]):
			match first.signature.return_type:
				UnionType(_):
					match second.signature.return_type:
						UnionType(_):
							not same_type(first.signature.return_type, second.signature.return_type)
						_:
							False
				_:
					False
		_:
			False


pure func test_unused_functions_create_no_concrete_instance() -> Bool:
	source: String =
		|pure func unused() -> String:
		|    "unused"
		|func main() -> Int:
		|    0
		|
	match fixture(IDENTITY + source):
		Ok([main]):
			same_type(main.signature.return_type, IntType)
		_:
			False


pure func test_entrypoint_translates_original_declaration_to_first_instance() -> Bool:
	source: String =
		|pure func unused() -> Int:
		|    7
		|func main() -> Int:
		|    0
		|
	match lex(module_source(root_module_id()), IDENTITY + source).and_then(parse):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Err(_): False
				Ok(checked):
					match specialize(checked):
						Err(_): False
						Ok(concrete):
							(
								Declaration.function_number(entry_function(checked_functions(checked).entrypoint)) == 2
								and function_number(entry_function(specialized_contents(concrete).entrypoint)) == 0
								and specialized_contents(concrete).functions.length() == 1
							)


pure func test_rigid_return_types_translate_in_every_match_arm() -> Bool:
	source: String =
		|fixed union Flag:
		|	Off
		|	On
		|pure func flag() -> Flag:
		|	On
		|pure func choose[T](value: T) -> T:
		|	match flag():
		|		Off: value
		|		On: value
		|func main() -> Int:
		|	choose(7)
		|

	match fixture(source):
		Ok([_, choose, _]):
			match choose.body:
				ConcreteMatchBody(matched):
					match matched.arms:
						[first, second]:
							(
								returns_type(first.body, IntType)
								and returns_type(second.body, IntType)
								and same_type(choose.signature.return_type, IntType)
							)
						_:
							False
				_:
					False
		_:
			False


pure func test_match_scrutinee_assignments_and_results_discover_generic_instances() -> Bool:
	flag_source: String =
		|fixed union Flag:
		|	Off
		|	On
		|pure func flag() -> Flag:
		|	On
		|
	source: String =
		|pure func save[T](value: T) -> T:
		|	value
		|pure func choose[T](value: T) -> T:
		|	match identity(flag()):
		|		Off:
		|			saved = save(value)
		|			saved
		|		On: value.identity().identity()
		|func main() -> Int:
		|	choose(7)
		|

	match fixture(flag_source + IDENTITY + source):
		Ok([main, choose, flag, flag_identity, save, int_identity]):
			match choose.body:
				ConcreteMatchBody(matched):
					match matched.arms:
						[first, second]:
							match first.statements:
								[InitializeBinding(_, saved)]:
									match choose.bindings:
										[parameter, saved_binding]:
											(
												body_target(main) == Some(1)
												and target(matched.scrutinee) == Some(3)
												and target(saved) == Some(4)
												and returns_repeated_target(second.body, 5)
												and same_type(
													flag_identity.signature.return_type,
													flag.signature.return_type,
												)
												and same_type(
													matched.scrutinee.base_type,
													flag.signature.return_type,
												)
												and same_type(
													int_identity.signature.return_type,
													IntType,
												)
												and same_type(parameter.value_type, IntType)
												and same_type(save.signature.return_type, IntType)
												and same_type(saved_binding.value_type, IntType)
												and same_type(saved.base_type, IntType)
												and returns_type(first.body, IntType)
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func ownership_rejection(
	result: Result[ValueOwnership, Diagnostic],
	message: String,
) -> Bool:
	match result:
		Err(error):
			(
				error.message == "internal compiler error: " + message
				and error.help == "report this compiler error with the input program"
				and same_source(error.span.source, COMPILER_SOURCE)
				and error.span.start == 0
				and error.span.end == 0
				and error.note.is_none()
			)
		Ok(_):
			False


pure func test_numeric_and_void_types_have_no_ownership() -> Bool:
	var valid = True

	for value_type in [IntType, FloatType, VoidType]:
		match value_ownership(value_type, [], []):
			Ok(NoOwnership):
				void
			_:
				valid = False

	valid


pure func test_string_ownership_is_a_managed_leaf() -> Bool:
	match value_ownership(StringType, [], []):
		Ok(ManagedStringLeaf):
			True
		_:
			False


pure func test_string_list_ownership_is_a_managed_root() -> Bool:
	match value_ownership(ListType(StringType), [], []):
		Ok(ManagedListRoot):
			True
		_:
			False


pure func test_all_supported_list_elements_have_one_managed_root() -> Bool:
	values = [IntType, FloatType, VoidType, StringType, ListType(StringType)]
	values.all(pure func(element):
		match value_ownership(ListType(element), [], []):
			Ok(ManagedListRoot): True
			_: False
	)


private pure func return_plan(contents: SpecializedContents) -> Result[ValueOwnership, Diagnostic]:
	match contents.functions:
		[_, helper]:
			value_ownership(helper.signature.return_type, contents.unions, contents.records)
		_:
			Err({
				span = {
					source = COMPILER_SOURCE,
					start = 0,
					end = 0
				},
				note = None,
				message = "invalid ownership producer test",
				help = "fix the two-function producer input",
			})


pure func test_nested_numeric_records_remain_inline() -> Bool:
	source: String =
		|fixed record Inner { number: Int }
		|fixed record Outer { child: Inner, fraction: Float }
		|pure func make() -> Outer:
		|    { child = { number = 7 }, fraction = 1.5 }
		|func main() -> Int:
		|    unused = make()
		|    0
		|

	match program(source):
		Ok(contents):
			match contents.records:
				[inner, outer]:
					inline_child = match inner.representation:
						InlineRecord:
							True
						ManagedRecord:
							False
					inline_parent = match outer.representation:
						InlineRecord:
							True
						ManagedRecord:
							False
					child_fields = match inner.fields:
						[IntType]:
							True
						_:
							False
					parent_fields = match outer.fields:
						[RecordType(child), FloatType]:
							record_number(child) == 0
						_:
							False
					unmanaged_parent = match return_plan(contents):
						Ok(NoOwnership):
							True
						_:
							False
					inline_child and inline_parent and child_fields and parent_fields and unmanaged_parent
				_:
					False
		Err(_):
			False

pure func test_string_record_has_one_root_and_complete_repeated_fields() -> Bool:
	source: String =
		|fixed record Pair { left: String, count: Int, right: String }
		|pure func make() -> Pair:
		|    { left = "same", count = 7, right = "same" }
		|func main() -> Int:
		|    unused = make()
		|    0
		|

	match program(source):
		Ok(contents):
			match contents.records:
				[layout]:
					complete_fields = match layout.fields:
						[StringType, IntType, StringType]:
							True
						_:
							False
					managed_root = match return_plan(contents):
						Ok(ManagedRecordRoot(id)):
							record_number(id) == 0
						_:
							False
					complete_fields and managed_root
				_:
					False
		Err(_):
			False

pure func test_void_record_has_a_root_without_owned_children() -> Bool:
	source: String =
		|fixed record Unit { empty: Void }
		|pure func make() -> Unit:
		|    { empty = void }
		|func main() -> Int:
		|    unused = make()
		|    0
		|

	match program(source):
		Ok(contents):
			match return_plan(contents):
				Ok(ManagedRecordRoot(id)):
					record_number(id) == 0
				_:
					False
		Err(_):
			False


pure func test_unmanaged_union_field_still_requires_a_record_root() -> Bool:
	source: String =
		|fixed union Maybe[T]:
		|    Missing
		|    Present(T)
		|fixed record Wrapped { value: Maybe[Int] }
		|pure func make() -> Wrapped:
		|    { value = Present(7) }
		|func main() -> Int:
		|    unused = make()
		|    0
		|

	match program(source):
		Ok(contents):
			match contents.records:
				[layout]:
					unmanaged_child = match layout.fields:
						[UnionType(child)]:
							match value_ownership(UnionType(child), contents.unions, contents.records):
								Ok(NoOwnership):
									True
								_:
									False
						_:
							False
					managed_parent = match return_plan(contents):
						Ok(ManagedRecordRoot(id)):
							record_number(id) == 0
						_:
							False
					unmanaged_child and managed_parent
				_:
					False
		Err(_):
			False

pure func test_phantom_string_argument_creates_no_child_obligation() -> Bool:
	source: String =
		|fixed record Phantom[T] { number: Int }
		|pure func make() -> Phantom[String]:
		|    { number = 7 }
		|func main() -> Int:
		|    unused = make()
		|    0
		|

	match program(source):
		Ok(contents):
			match return_plan(contents):
				Ok(NoOwnership):
					True
				_:
					False
		Err(_):
			False


pure func test_inline_union_keeps_each_repeated_owned_field() -> Bool:
	source: String =
		|fixed union Payload:
		|    Empty
		|    Pair(String, Int, String)
		|pure func make() -> Payload:
		|    Pair("same", 7, "same")
		|func main() -> Int:
		|    unused = make()
		|    0
		|

	match program(source):
		Ok(contents):
			match contents.unions:
				[layout]:
					complete_fields = match layout.variants:
						[[], [StringType, IntType, StringType]]:
							True
						_:
							False
					owning_representation = match layout.representation:
						InlineOwningPayload:
							True
						InlineUnmanaged:
							False
					owning_fields = match return_plan(contents):
						Ok(InlineOwnedFields(id)):
							union_number(id) == 0
						_:
							False
					complete_fields and owning_representation and owning_fields
				_:
					False
		Err(_):
			False

pure func test_record_ownership_query_rejects_missing_layout() -> Bool:
	source: String =
		|fixed record Number { number: Int }
		|pure func make() -> Number:
		|    { number = 7 }
		|func main() -> Int:
		|    unused = make()
		|    0
		|

	match fixture(source):
		Ok([_, helper]):
			ownership_rejection(
				value_ownership(helper.signature.return_type, [], []),
				"invalid record identity in ownership representation",
			)
		_:
			False


pure func test_union_ownership_query_rejects_missing_layout() -> Bool:
	source: String =
		|fixed union Flag:
		|    Off
		|    On
		|pure func make() -> Flag:
		|    Off
		|func main() -> Int:
		|    unused = make()
		|    0
		|

	match fixture(source):
		Ok([_, helper]):
			ownership_rejection(
				value_ownership(helper.signature.return_type, [], []),
				"invalid union identity in ownership representation",
			)
		_:
			False


tests: TestSuite = {
	description = "Blorp 2 specialization",
	tests = [
		("numeric and Void ownership", test_numeric_and_void_types_have_no_ownership),
		("String ownership authority", test_string_ownership_is_a_managed_leaf),
		("String List ownership authority", test_string_list_ownership_is_a_managed_root),
		(
			"supported List elements share one root obligation",
			test_all_supported_list_elements_have_one_managed_root,
		),
		("nested numeric records stay inline", test_nested_numeric_records_remain_inline),
		(
			"record root retains complete repeated fields",
			test_string_record_has_one_root_and_complete_repeated_fields,
		),
		(
			"Void record root without owned children",
			test_void_record_has_a_root_without_owned_children,
		),
		(
			"unmanaged union field needs record root",
			test_unmanaged_union_field_still_requires_a_record_root,
		),
		(
			"phantom String argument owns no child",
			test_phantom_string_argument_creates_no_child_obligation,
		),
		(
			"inline union keeps repeated owned fields",
			test_inline_union_keeps_each_repeated_owned_field,
		),
		(
			"record ownership rejects missing layout",
			test_record_ownership_query_rejects_missing_layout,
		),
		(
			"union ownership rejects missing layout",
			test_union_ownership_query_rejects_missing_layout,
		),
		("direct and UFCS reuse one instance", test_direct_and_ufcs_reuse_one_instance),
		(
			"argument types create complete distinct instances",
			test_argument_types_create_distinct_complete_instances,
		),
		(
			"forwarded symbolic call maps to concrete callee",
			test_forwarded_symbolic_call_is_remapped_to_concrete_callee,
		),
		(
			"declarations with same parameter spelling stay distinct",
			test_declarations_with_same_parameter_spelling_stay_distinct,
		),
		(
			"binding and reassignment types substitute per instance",
			test_bindings_and_reassignments_are_substituted_per_instance,
		),
		("nominal union arguments do not merge", test_nominal_union_arguments_do_not_merge),
		(
			"unused functions create no concrete instance",
			test_unused_functions_create_no_concrete_instance,
		),
		(
			"entrypoint translates original declaration to first instance",
			test_entrypoint_translates_original_declaration_to_first_instance,
		),
		(
			"rigid return types translate in every match arm",
			test_rigid_return_types_translate_in_every_match_arm,
		),
		(
			"match scrutinee, statements and results discover generic instances",
			test_match_scrutinee_assignments_and_results_discover_generic_instances,
		),
	]
}
