import:
	../../src/check/check: check, check_errors
	../../src/check/check_errors as Errors
	../../src/check/check_render: render_failure
	../../src/utils/source: module_source, root_module_id, same_source
	../../src/utils/syntax: Diagnostic, DiagnosticNote(PreviousDeclaration), Span, same_span
	module_input: ModuleInput, parse_modules
	test: TestSuite


private pure func rejects(
	sources: List[ModuleInput],
	expected: pure (Errors.CheckError) -> Bool,
) -> Bool:
	match parse_modules(sources):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					errors = check_errors(failure)
					errors.remaining.is_empty() and expected(errors.first)


private pure func root_span(start: Int, end: Int) -> Span:
	{source = module_source(root_module_id()), start = start, end = end}


private pure func rejects_diagnostic(
	sources: List[ModuleInput],
	expected: pure (Diagnostic) -> Bool,
) -> Bool:
	match parse_modules(sources):
		Err(_):
			False
		Ok(parsed):
			match check(parsed):
				Ok(_):
					False
				Err(failure):
					diagnostics = render_failure(failure)
					diagnostics.remaining.is_empty() and expected(diagnostics.first)


private pure func function_conflict(diagnostic: Diagnostic, occurrence: Span, previous: Span) -> Bool:
	match diagnostic.note:
		Some(PreviousDeclaration(note)):
			(
				same_span(diagnostic.span, occurrence)
				and same_span(note, previous)
				and diagnostic.message == "imported function conflicts with another function"
				and diagnostic.help == "give the functions distinct names or remove the duplicate import"
			)
		_:
			False


pure func test_imported_function_cannot_collide_with_a_local_function() -> Bool:
	root: String =
		|import:
		|    ./helper: answer
		|pure func answer() -> Int:
		|    7
		|func main() -> Int:
		|    answer()
		|
	helper: String =
		|pure func answer() -> Int:
		|    42
		|
	selector = "import:\n    ./helper: ".length()
	declaration = "import:\n    ./helper: answer\npure func ".length()
	rejects_diagnostic([{source = root, targets = [1]}, {source = helper, targets = []}], pure func(diagnostic):
		function_conflict(diagnostic, root_span(selector, selector + 6), root_span(declaration, declaration + 6))
	)


pure func test_imported_function_cannot_collide_with_a_local_variant() -> Bool:
	root: String =
		|import:
		|    ./helper: Ready
		|fixed union Choice:
		|    Ready
		|func main() -> Int:
		|    Ready()
		|
	helper: String =
		|pure func Ready() -> Int:
		|    42
		|
	rejects([{source = root, targets = [1]}, {source = helper, targets = []}], pure func(error):
		match error.kind:
			Errors.ImportRejection(Errors.ImportedVariantConflict(_, previous)):
				same_source(error.span.source, previous.source) and error.span.start < previous.start
			_:
				False
	)


pure func test_ambiguous_imports_reject_the_second_selector() -> Bool:
	root: String =
		|import:
		|    ./left: answer
		|    ./right: answer
		|func main() -> Int:
		|    answer()
		|
	helper: String =
		|pure func answer() -> Int:
		|    42
		|
	first = "import:\n    ./left: ".length()
	second = "import:\n    ./left: answer\n    ./right: ".length()
	rejects_diagnostic([
		{source = root, targets = [1, 2]},
		{source = helper, targets = []},
		{source = helper, targets = []},
	], pure func(diagnostic):
		function_conflict(diagnostic, root_span(second, second + 6), root_span(first, first + 6))
	)


pure func test_duplicate_selector_rejects_its_second_occurrence() -> Bool:
	root: String =
		|import:
		|    ./helper: answer, answer
		|func main() -> Int:
		|    answer()
		|
	helper: String =
		|pure func answer() -> Int:
		|    42
		|
	first = "import:\n    ./helper: ".length()
	second = "import:\n    ./helper: answer, ".length()
	rejects_diagnostic([{source = root, targets = [1]}, {source = helper, targets = []}], pure func(diagnostic):
		match diagnostic.note:
			Some(PreviousDeclaration(previous)):
				(
					same_span(diagnostic.span, root_span(second, second + 6))
					and same_span(previous, root_span(first, first + 6))
					and diagnostic.message == "function selected more than once"
					and diagnostic.help == "list each selected function once"
				)
			_:
				False
	)


pure func test_repeated_module_import_retains_both_occurrences() -> Bool:
	root: String =
		|import:
		|    ./helper: answer
		|    ./again: hidden
		|func main() -> Int:
		|    answer()
		|
	helper: String =
		|pure func answer() -> Int:
		|    42
		|pure func hidden() -> Int:
		|    7
		|
	first = root_span("import:\n    ".length(), "import:\n    ./helper: answer".length())
	second = root_span("import:\n    ./helper: answer\n    ".length(), "import:\n    ./helper: answer\n    ./again: hidden".length())
	rejects_diagnostic([{source = root, targets = [1, 1]}, {source = helper, targets = []}], pure func(diagnostic):
		match diagnostic.note:
			Some(PreviousDeclaration(previous)):
				(
					same_span(diagnostic.span, second)
					and same_span(previous, first)
					and diagnostic.message == "module imported more than once"
					and diagnostic.help == "combine the selected function names into one import"
				)
			_:
				False
	)


tests: TestSuite = {
	description = "Blorp 2 import validation",
	tests = [
		("imported functions cannot collide with local functions", test_imported_function_cannot_collide_with_a_local_function),
		("imported functions cannot collide with local variants", test_imported_function_cannot_collide_with_a_local_variant),
		("ambiguous imports reject the second selector", test_ambiguous_imports_reject_the_second_selector),
		("duplicate selectors reject the second occurrence", test_duplicate_selector_rejects_its_second_occurrence),
		("repeated module import retains both occurrences", test_repeated_module_import_retains_both_occurrences),
	]
}
