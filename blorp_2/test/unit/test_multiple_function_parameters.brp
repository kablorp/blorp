			"two parameters accept independent int and string arguments",
			test_two_parameters_accept_independent_int_and_string_arguments,
		),
		(
			"generic explicit concrete annotation supplies constructor hint",
			test_generic_explicit_concrete_annotation_supplies_constructor_hint,
		),
		(
			"generic concrete receiver still has no constructor hint",
			test_generic_concrete_receiver_still_has_no_constructor_hint,
		),
		(
			"three parameters reach concrete signatures and bindings",
			test_three_parameters_reach_concrete_signatures_and_bindings,
		),
		(
			"unused body keeps distinct rigid parameter positions",
			test_unused_body_keeps_distinct_rigid_parameter_positions,
		),
		(
			"duplicate parameters are owned semantic errors",
			test_duplicate_parameters_are_owned_semantic_errors,
		),
		(
			"first missing parameter precedes an ordinary mismatch",
			test_first_missing_parameter_precedes_an_ordinary_mismatch,
		),
		(
			"expected result does not infer missing parameters",
			test_expected_result_does_not_infer_missing_parameters,
		),
		(
			"runtime order selects conflict across parameters",
			test_runtime_order_selects_conflict_across_parameters,
		),
		(
			"generic conflict precedes earlier ordinary mismatch",
			test_generic_conflict_precedes_earlier_ordinary_mismatch,
		),
		(
			"unknown later child precedes generic conflict",
			test_unknown_later_child_precedes_generic_conflict,
		),
		(
			"structural conflict keeps first candidate and annotation origin",
			test_structural_conflict_keeps_first_candidate_and_annotation_origin,
		),
		(
			"forwarding substitution is permuted and caller owned",
			test_forwarding_substitution_is_permuted_and_caller_owned,
		),
		(
			"unused later parameter still distinguishes instance keys",
			test_unused_later_parameter_still_distinguishes_instance_keys,
		),
		(
			"malformed parameter lists have exact parser diagnostics",
			test_malformed_parameter_lists_have_exact_parser_diagnostics,
		),
		(
			"union parameter headers accept multiple names",
			test_union_parameter_headers_accept_multiple_names,
		),
		(
			"ordered calls and instances preserve int string permutation",
			test_ordered_calls_and_instances_preserve_int_string_permutation,
		),
		(
			"duplicate renderer uses typed error without rechecking",
			test_duplicate_renderer_uses_typed_error_without_rechecking,
		),
	]
}
