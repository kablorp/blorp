pure func test_distinct_owners_drop_at_their_separate_final_uses() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match (
				insert_function(
					function(
						[
							parameter(ids.first, IntType),
							runtime(ids.second, IntToString, [ids.first], StringType, 20),
							runtime(ids.third, IntToString, [ids.first], StringType, 30),
							runtime(ids.fourth, StringLength, [ids.second], IntType, 40),
							runtime(ids.fifth, StringLength, [ids.third], IntType, 50),
						],
						ids.fifth,
						[IntType],
						IntType,
					),
					[],
				)
			):
				Ok(output):
					match output.operations:
						[DefineValue(_), DefineValue(first), DefineValue(second), DefineValue(first_length), DropOwner(first_drop, first_at), DefineValue(second_length), DropOwner(second_drop, second_at)]:
							match output.tail:
								ReturnTail(UnmanagedReturn(result)):
									(
										owns_result(first.result, 0)
										and owns_result(second.result, 1)
										and borrows_owner(first_length.operation, 1, 0)
										and borrows_owner(second_length.operation, 2, 1)
										and owner_number(first_drop) == 0
										and first_at == span(40)
										and owner_number(second_drop) == 1
										and second_at == span(50)
										and value_number(result) == 4
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_owned_return_drops_a_different_unused_owner() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match (
				insert_function(
					function(
						[
							integer(ids.first, 7, 10),
							runtime(ids.second, IntToString, [ids.first], StringType, 20),
							runtime(ids.third, IntToString, [ids.first], StringType, 30),
						],
						ids.third,
						[],
						StringType,
					),
					[],
				)
			):
				Ok(output):
					match output.operations:
						[DefineValue(_), DefineValue(unused), DropOwner(dropped, at), DefineValue(returned)]:
							match output.tail:
								ReturnTail(OwnedReturn(value, transferred)):
									(
										owns_result(unused.result, 0)
										and owner_number(dropped) == 0
										and at == span(20)
										and owns_result(returned.result, 1)
										and value_number(value) == 2
										and owner_number(transferred) == 1
									)
								_:
									False
						_:
							False
				_:
					False


