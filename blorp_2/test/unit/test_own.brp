pure func test_replacement_result_precedes_old_owner_drop() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			replacement = {
				id = ids.third,
				value_type = StringType,
				operation = CallValue(
					{
						target = UserFunction(ids.entrypoint),
						span = span(30)
					},
					[ids.second],
				),
				span = span(30)
			}

			match (
				insert_function(
					function(
						[
							integer(ids.first, 7, 10),
							runtime(ids.second, IntToString, [ids.first], StringType, 20),
							replacement,
							runtime(ids.fourth, StringLength, [ids.third], IntType, 40),
						],
						ids.fourth,
						[],
						IntType,
					),
					[],
				)
			):
				Ok(output):
					match output.operations:
						[DefineValue(_), DefineValue(_), DefineValue(result), DropOwner(old, _), DefineValue(_), DropOwner(current, _)]:
							match result.result:
								OwnedResult(acquired):
									(
										owner_number(old) == 0
										and owner_number(acquired) == 1
										and owner_number(current) == 1
									)
								_:
									False
						_:
							False
				_:
					False


pure func test_managed_match_prefix_is_explicitly_rejected() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			input = function(
				[
					ids.union_value,
					integer(ids.second, 7, 10),
					runtime(ids.third, IntToString, [ids.second], StringType, 20),
				],
				ids.second,
				[],
				IntType,
			)

			match (
				insert_function(
					{ input | tail = MatchValue({
							scrutinee = ids.first,
							owner = ids.union_id,
							arms = [
								{
									label = DefaultLabel,
									body = {
										definitions = [],
										result = ids.second
									}
								},
							],
						}) },
					ids.unions,
				)
			):
				Err(error):
					(
						error.message == "managed values before a tail match are not supported yet"
						and error.help == (
							"create Strings inside the selected match arm or a separate straight-line "
							+ "function"
						)
						and error.span.start == 20
					)
				_:
					False


pure func test_unused_managed_match_arm_value_is_dropped() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			input = function(
				[ids.union_value, integer(ids.second, 7, 10)],
				ids.second,
				[],
				IntType,
			)

			match (
				insert_function(
					{ input | tail = MatchValue({
							scrutinee = ids.first,
							owner = ids.union_id,
							arms = [
								{
									label = DefaultLabel,
									body = {
										definitions = [
											runtime(
												ids.third,
												IntToString,
												[ids.second],
												StringType,
												30,
											),
											integer(ids.fourth, 0, 40),
										],
										result = ids.fourth
									}
								},
							],
						}) },
					ids.unions,
				)
			):
				Ok(output):
					match output.tail:
						MatchTail(matched):
							match matched.arms:
								[arm]:
									match arm.operations:
										[DefineValue(_), DropOwner(owner, at), DefineValue(_)]:
											owner_number(owner) == 0 and at == span(30)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


