												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


pure func test_returning_a_borrowed_parameter_acquires_an_owner() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match insert_function(
				function([parameter(ids.first, StringType)], ids.first, [StringType], StringType),
				[],
			):
				Ok(output):
					match output.operations:
						[DefineValue(_), AcquireOwner(owner, borrow, _)]:
							match output.tail:
								ReturnTail(OwnedReturn(value, returned)):
									match borrow.source:
										ParameterBorrow(_):
											(
												owner_number(owner) == 0
												and owner_number(returned) == 0
												and value_number(value) == 0
												and value_number(borrow.value) == 0
											)
										_:
											False
								_:
									False
						_:
							False
				_:
					False


