pure func test_last_use_does_not_invent_a_zero_argument_operand() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			call = {
				id = ids.second,
				value_type = IntType,
				operation = CallValue(
					{
						target = UserFunction(ids.second_function),
						span = span(20)
					},
					[],
				),
				span = span(20)
			}

			match (
				last_uses(
					[integer(ids.first, 7, 10), call],
					ids.second,
				)
			):
				Ok(uses):
					uses == [None, Some(2)]
				_:
					False


pure func test_last_use_rejects_nonconsecutive_definition_ids() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match (
				last_uses(
					[integer(ids.first, 7, 10), integer(ids.third, 0, 20)],
					ids.first,
				)
			):
				Err(error):
					(
						error.message == "internal compiler error: nonconsecutive value identity in ownership use analysis"
						and error.help == "report this compiler error with the input program"
						and error.span == span(20)
					)
				_:
					False


