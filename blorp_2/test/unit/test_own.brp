						and error.help == "report this compiler error with the input program"
						and error.span == span(40)
					)
				_:
					False


pure func test_match_arms_drop_unused_owners_and_transfer_distinct_owners() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			input = function(
				[ids.union_value, integer(ids.second, 7, 20)],
				ids.second,
				[],
				StringType,
			)

			match (
				insert_function(
					{ input | tail = MatchValue({
							scrutinee = ids.first,
							owner = ids.union_id,
							arms = [
								{
									label = VariantLabel(ids.second_variant),
									body = {
										definitions = [
											runtime(
												ids.third,
												IntToString,
												[ids.second],
												StringType,
												30,
											),
											runtime(
												ids.fourth,
												IntToString,
												[ids.second],
												StringType,
												40,
											),
										],
										result = ids.fourth
									}
								},
								{
									label = DefaultLabel,
									body = {
										definitions = [
											runtime(
												ids.fifth,
												IntToString,
												[ids.second],
												StringType,
												50,
											),
										],
										result = ids.fifth
									}
								},
							],
						}) },
					ids.unions,
				)
			):
				Ok(output):
					match output.tail:
						MatchTail(matched):
							match matched.arms:
								[first, second]:
									match first.operations:
										[DefineValue(unused), DropOwner(dropped, at), DefineValue(returned)]:
											match second.operations:
												[DefineValue(other)]:
													match first.result:
														OwnedReturn(value, owner):
															match second.result:
																OwnedReturn(other_value, other_owner):
																	(
																		owns_result(
																			unused.result,
																			0,
																		)
																		and owner_number(
																			dropped,
																		) == 0
																		and at == span(30)
																		and owns_result(
																			returned.result,
																			1,
																		)
																		and value_number(value) == 3
																		and owner_number(owner) == 1
																		and owns_result(
																			other.result,
																			2,
																		)
																		and value_number(
																			other_value,
																		) == 4
																		and owner_number(
																			other_owner,
																		) == 2
																	)
																_:
																	False
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False


tests: TestSuite = {
	description = "Blorp 2 ownership insertion",
	tests = [
		(
			"arm uses retain offsets and unmanaged prefix",
			test_arm_last_use_handles_offset_and_unmanaged_prefix,
		),
		(
			"arm may return an unmanaged prefix value",
			test_arm_last_use_accepts_returning_an_unmanaged_prefix_value,
		),
		(
			"arm use analysis rejects sibling values",
			test_arm_last_use_rejects_sibling_value_identity,
		),
		(
			"arm ownership drops unused and transfers distinct owners",
			test_match_arms_drop_unused_owners_and_transfer_distinct_owners,
		),
		(
			"last use leaves unused value unmarked",
			test_last_use_leaves_an_unused_definition_unmarked,
		),
		(
			"last use extends String through return",
			test_last_use_marks_a_returned_string_at_the_tail,
		),
		(
			"last use skips absent call operand",
			test_last_use_does_not_invent_a_zero_argument_operand,
		),
		(
