import:
	compilation: compile
	test: TestSuite


pure func test_mortal_string_reaches_c_emission() -> Bool:
	match compile("func main() -> Int:\n\tvalue = 7.to_string()\n\tvalue.length()\n"):
		Ok(_):
			True
		Err(_):
			False


tests: TestSuite = {
	description = "Blorp 2 first managed value",
	tests = [("mortal String reaches C emission", test_mortal_string_reaches_c_emission)]
}
