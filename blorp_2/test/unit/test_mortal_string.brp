import:
	compilation: compile
	test: TestSuite


pure func test_mortal_string_reaches_c_emission() -> Bool:
	source: String =
		|func main() -> Int:
		|	value = 7.to_string()
		|	value.length()
		|

	match compile(source):
		Ok(_):
			True
		Err(_):
			False


pure func test_tail_match_returns_a_fresh_string() -> Bool:
	source: String =
		|fixed union Choice:
		|	First
		|	Second
		|pure func choose(choice: Choice) -> String:
		|	match choice:
		|		First: 7.to_string()
		|		Second: 42.to_string()
		|func main() -> Int:
		|	choose(Second).length()
		|

	match compile(source):
		Ok(_):
			True
		Err(_):
			False


pure func test_tail_match_rejects_managed_prefix() -> Bool:
	source: String =
		|fixed union Choice:
		|	First
		|	Second
		|pure func choose(choice: Choice) -> Int:
		|	unused = 7.to_string()
		|	match choice:
		|		First: 0
		|		Second: 0
		|func main() -> Int:
		|	choose(First)
		|

	match compile(source):
		Err(errors):
			match errors.remaining:
				[]:
					error = errors.first
					(
						error.message == "managed values before a tail match are not supported yet"
						and error.help == (
							"create Strings inside the selected match arm or a separate straight-line "
							+ "function"
						)
						and error.span == {
							start = 88,
							end = 97
						}
					)
				_:
					False
		Ok(_):
			False


pure func test_tail_match_rejects_borrowed_parameter() -> Bool:
	source: String =
		|fixed union Choice:
		|	First
		|	Second
		|pure func flag() -> Choice:
		|	First
		|pure func choose(value: String) -> String:
		|	match flag():
		|		First: value
		|		Second: value
		|func main() -> Int:
		|	0
		|

	match compile(source):
		Err(errors):
			match errors.remaining:
				[]:
					error = errors.first
					(
						error.message == "managed values before a tail match are not supported yet"
						and error.help == (
							"create Strings inside the selected match arm or a separate straight-line "
							+ "function"
						)
						and error.span == {
							start = 87,
							end = 92
						}
					)
				_:
					False
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 first managed value",
	tests = [
		("tail match rejects managed_prefix", test_tail_match_rejects_managed_prefix),
		("tail match rejects borrowed_parameter", test_tail_match_rejects_borrowed_parameter),
		("mortal String reaches C emission", test_mortal_string_reaches_c_emission),
		("tail match returns fresh String", test_tail_match_returns_a_fresh_string),
	]
}
