import:
	../../src/syntax: same_span
	../../src/source: module_source, root_module_id
	../../src/text: concat
	compilation: compile
	test: TestSuite


pure func test_mortal_string_reaches_c_emission() -> Bool:
	source: String =
		|func main() -> Int:
		|	value = 7.to_string()
		|	value.length()
		|

	match compile(source):
		Ok(_):
			True
		Err(_):
			False


pure func test_tail_match_returns_a_fresh_string() -> Bool:
	source: String =
		|fixed union Choice:
		|	First
		|	Second
		|pure func choose(choice: Choice) -> String:
		|	match choice:
		|		First: 7.to_string()
		|		Second: 42.to_string()
		|func main() -> Int:
		|	choose(Second).length()
		|

	match compile(source):
		Ok(_):
			True
		Err(_):
			False


pure func test_tail_match_rejects_managed_prefix() -> Bool:
	source: String =
		|fixed union Choice:
		|	First
		|	Second
		|pure func choose(choice: Choice) -> Int:
		|	unused = 7.to_string()
		|	match choice:
		|		First: 0
		|		Second: 0
		|func main() -> Int:
		|	choose(First)
		|

	match compile(source):
		Err(errors):
			match errors.remaining:
				[]:
					error = errors.first
					(
						error.message == "owned managed values before a tail match are not supported yet"
						and error.help == (
							"create managed values inside the selected match arm or a separate straight-line "
							+ "function"
						)
						and same_span(error.span, {
							source = module_source(root_module_id()),
							start = 88,
							end = 97
						})
					)
				_:
					False
		Ok(_):
			False


pure func test_tail_match_accepts_borrowed_parameter_with_mortal_string() -> Bool:
	source: String =
		|fixed union Choice:
		|	First
		|	Second
		|pure func flag() -> Choice:
		|	First
		|pure func choose(value: String) -> String:
		|	match flag():
		|		First: value
		|		Second: value
		|func main() -> Int:
		|	choose(7.to_string()).length()
		|

	match compile(source):
		Ok(_):
			True
		Err(_):
			False


func test_tail_match_rejects_owned_union_prefix_with_borrowed_string_parameter() -> Bool:
	before_call: String =
		|fixed union Choice:
		|	First
		|	Second
		|fixed union Box[T]:
		|	Box(T)
		|pure func box[T](value: T) -> Box[T]:
		|	Box(value)
		|pure func flag() -> Choice:
		|	First
		|pure func choose(value: String) -> Int:
		|	unused =
	prefix = before_call.concat(" ")
	suffix: String =
		|box(value)
		|	match flag():
		|		First: 0
		|		Second: 0
		|func main() -> Int:
		|	choose(42.to_string())
		|

	match compile(prefix.concat(suffix)):
		Ok(_):
			False
		Err(errors):
			match errors.remaining:
				[]:
					error = errors.first
					matches = (
						error.message == "owned managed values before a tail match are not supported yet"
						and error.help == "create managed values inside the selected match arm or a separate straight-line ".concat(
							"function",
						)
						and same_span(error.span, {
							source = module_source(root_module_id()),
							start = prefix.length(),
							end = prefix.length() + "box".length()
						})
						and error.note.is_none()
					)

					if matches:
						True
					else:
						print_error(error.message)
						print_error(error.help)
						print_error(
							"span="
								.append_int(error.span.start)
								.concat("..")
								.append_int(error.span.end),
						)
						False
				_:
					False


tests: TestSuite = {
	description = "Blorp 2 first managed value",
	tests = [
		("tail match rejects managed_prefix", test_tail_match_rejects_managed_prefix),
		(
			"tail match accepts borrowed parameter with mortal String",
			test_tail_match_accepts_borrowed_parameter_with_mortal_string,
		),
		(
			"tail match rejects owned union prefix with borrowed String parameter",
			test_tail_match_rejects_owned_union_prefix_with_borrowed_string_parameter,
		),
		("mortal String reaches C emission", test_mortal_string_reaches_c_emission),
		("tail match returns fresh String", test_tail_match_returns_a_fresh_string),
	]
}
