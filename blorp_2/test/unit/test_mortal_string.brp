import:
	compilation: compile
	test: TestSuite


pure func test_mortal_string_reaches_c_emission() -> Bool:
	match compile("func main() -> Int:\n\tvalue = 7.to_string()\n\tvalue.length()\n"):
		Ok(_):
			True
		Err(_):
			False


pure func test_tail_match_returns_a_fresh_string() -> Bool:
	match compile(
		"fixed union Choice:\n\tFirst\n\tSecond\npure func choose(choice: Choice) -> String:\n\tmatch choice:\n\t\tFirst: 7.to_string()\n\t\tSecond: 42.to_string()\nfunc main() -> Int:\n\tchoose(Second).length()\n",
	):
		Ok(_):
			True
		Err(_):
			False


pure func test_tail_match_rejects_managed_prefix() -> Bool:
	match compile(
		"fixed union Choice:\n\tFirst\n\tSecond\npure func choose(choice: Choice) -> Int:\n\tunused = 7.to_string()\n\tmatch choice:\n\t\tFirst: 0\n\t\tSecond: 0\nfunc main() -> Int:\n\tchoose(First)\n",
	):
		Err(error):
			(
				error.message == "managed values before a tail match are not supported yet"
				and error.help == (
					"create Strings inside the selected match arm or a separate straight-line "
					+ "function"
				)
				and error.span == {
					start = 88,
					end = 97
				}
			)
		Ok(_):
			False


pure func test_tail_match_rejects_borrowed_parameter() -> Bool:
	match compile(
		"fixed union Choice:\n\tFirst\n\tSecond\npure func flag() -> Choice:\n\tFirst\npure func choose(value: String) -> String:\n\tmatch flag():\n\t\tFirst: value\n\t\tSecond: value\nfunc main() -> Int:\n\t0\n",
	):
		Err(error):
			(
				error.message == "managed values before a tail match are not supported yet"
				and error.help == (
					"create Strings inside the selected match arm or a separate straight-line "
					+ "function"
				)
				and error.span == {
					start = 87,
					end = 92
				}
			)
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 first managed value",
	tests = [
		("tail match rejects managed_prefix", test_tail_match_rejects_managed_prefix),
		("tail match rejects borrowed_parameter", test_tail_match_rejects_borrowed_parameter),
		("mortal String reaches C emission", test_mortal_string_reaches_c_emission),
		("tail match returns fresh String", test_tail_match_returns_a_fresh_string),
	]
}
