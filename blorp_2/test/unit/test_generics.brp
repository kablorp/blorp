import:
	../../src/check as Checked
	../../src/lex: lex
	../../src/parse: parse_prelude
	../../src/prelude: check_prelude
	../../src/syntax: Diagnostic
	compilation: compile
	input: check_failure, parse, setup_diagnostic
	test: TestSuite


private IDENTITY: String = "pure func identity[T](value: T) -> T:\n\tvalue\n"

private MAIN: String = "func main() -> Int:\n\t0\n"

private INFERENCE_HELP: String = (
	"pass a value whose type determines the declared type parameter; use a concrete "
	+ "helper when no argument can determine it"
)

private CONSTRUCTOR_HELP: String = "pass an already-typed union value or call a concrete helper returning the union"

private COLLISION_HELP: String = "choose a distinct type parameter name, such as T"


private pure func checked(source: String) -> Result[Checked.CheckedProgram, Diagnostic]:
	tokens ?= lex(source)
	parsed ?= parse(tokens)
	Checked
		.check(parsed)
		.map_err(setup_diagnostic)


private pure func rejects(
	prefix: String,
	marked: String,
	suffix: String,
	matches: pure (Checked.CheckErrorKind) -> Bool,
) -> Bool:
	match check_failure(prefix + marked + suffix):
		None:
			False
		Some(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + marked.length()
				and matches(error.kind)
			)


pure func test_one_declaration_accepts_int_and_string() -> Bool:
	compile(
		"pure func identity[T](value: T) -> T:\n\tvalue\nfunc main() -> Int:\n\tinteger = identity(7)\n\ttext = integer.to_string().identity()\n\tidentity(text).length()\n",
	).is_ok()


pure func test_generic_forwarding_preserves_the_caller_parameter() -> Bool:
	compile(
		"pure func identity[T](value: T) -> T:\n\tvalue\npure func forward[Element](value: Element) -> Element:\n\tidentity(value)\nfunc main() -> Int:\n\tforward(42)\n",
	).is_ok()


pure func test_unused_invalid_rigid_body_rejects() -> Bool:
	rejects("pure func bad[T](value: T) -> T:\n\t", "42", "\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ExpressionTypeMismatch(_):
				True
			_:
				False
	)


pure func test_int_only_use_does_not_recheck_invalid_body_as_int() -> Bool:
	rejects("pure func bad[T](value: T) -> T:\n\t", "42", "\nfunc main() -> Int:\n\tbad(7)\n", pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ExpressionTypeMismatch(_):
				True
			_:
				False
	)


pure func test_arbitrary_parameter_cannot_call_string_runtime() -> Bool:
	rejects("pure func bad[T](value: T) -> Int:\n\tvalue.", "length", "()\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ArgumentTypeMismatch(_):
				True
			_:
				False
	)


pure func test_arbitrary_parameter_cannot_call_integer_runtime() -> Bool:
	rejects("pure func bad[T](value: T) -> String:\n\t", "to_string", "(value)\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ArgumentTypeMismatch(_):
				True
			_:
				False
	)


pure func test_generic_main_rejects_at_parameter_declaration() -> Bool:
	rejects("func main[", "T", "]() -> Int:\n\t0\n", pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.GenericMain(_):
				True
			_:
				False
	)


pure func test_builtin_type_parameter_collision_rejects() -> Bool:
	(
		rejects("pure func identity[", "Int", "](value: Int) -> Int:\n\tvalue\n" + MAIN, pure func(
			kind: Checked.CheckErrorKind,
		) -> Bool:
			match kind:
				Checked.TypeParameterTypeNameConflict(_):
					True
				_:
					False
		)
		and rejects("pure func identity[", "String", "](value: String) -> String:\n\tvalue\n" + MAIN, pure func(
			kind: Checked.CheckErrorKind,
		) -> Bool:
			match kind:
				Checked.TypeParameterTypeNameConflict(_):
					True
				_:
					False
		)
	)


pure func test_forward_declared_union_type_parameter_collision_rejects() -> Bool:
	rejects("pure func identity[", "Choice", "](value: Choice) -> Choice:\n\tvalue\nfixed union Choice:\n\tFirst\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.TypeParameterTypeNameConflict(_):
				True
			_:
				False
	)


pure func test_phantom_parameter_call_has_no_default() -> Bool:
	rejects("pure func phantom[T](value: Int) -> Int:\n\tvalue\nfunc main() -> Int:\n\t", "phantom", "(7)\n", pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.UninferableTypeParameter(_):
				True
			_:
				False
	)


pure func test_zero_argument_generic_call_has_no_default() -> Bool:
	rejects("pure func phantom[T]() -> Int:\n\t7\nfunc main() -> Int:\n\t", "phantom", "()\n", pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.UninferableTypeParameter(_):
				True
			_:
				False
	)


pure func test_generic_unary_call_still_requires_argument() -> Bool:
	rejects(IDENTITY + "func main() -> Int:\n\t", "identity", "()\n", pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ArgumentCountMismatch(_):
				True
			_:
				False
	)


pure func test_generic_call_preserves_purity() -> Bool:
	rejects("func identity[T](value: T) -> T:\n\tvalue\npure func use() -> Int:\n\t", "identity", "(7)\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ImpureCall(_, _):
				True
			_:
				False
	)


pure func test_generic_recursion_rejects_even_when_unused() -> Bool:
	rejects("pure func recurse[T](value: T) -> T:\n\t", "recurse", "(value)\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.RecursiveCallChain:
				True
			_:
				False
	)


pure func test_undeclared_parameter_name_rejects() -> Bool:
	rejects("pure func identity(value: ", "T", ") -> Int:\n\t7\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.UnknownType(_):
				True
			_:
				False
	)


pure func test_local_parameter_shadows_direct_generic_call() -> Bool:
	rejects(IDENTITY + "pure func use[T](identity: T) -> T:\n\t", "identity", "(identity)\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.UncallableBinding(_, Checked.ParameterBinding(_), _):
				True
			_:
				False
	)


pure func test_local_parameter_does_not_shadow_generic_ufcs() -> Bool:
	checked(
		IDENTITY + "pure func use[T](identity: T) -> T:\n\tidentity.identity()\nfunc main() -> Int:\n\tuse(7)\n",
	).is_ok()


private CHOICE: String = "fixed union Choice:\n\tFirst\n\tNumber(Int)\n"


pure func test_direct_nullary_constructor_cannot_infer_from_return_context() -> Bool:
	rejects(CHOICE + IDENTITY + "pure func use() -> Choice:\n\tidentity(", "First", ")\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ConstructorNeedsExpectedType(_):
				True
			_:
				False
	)


pure func test_ufcs_nullary_constructor_cannot_infer_from_return_context() -> Bool:
	rejects(CHOICE + IDENTITY + "pure func use() -> Choice:\n\t", "First", ".identity()\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ConstructorNeedsExpectedType(_):
				True
			_:
				False
	)


pure func test_direct_payload_constructor_cannot_infer_from_return_context() -> Bool:
	rejects(CHOICE + IDENTITY + "pure func use() -> Choice:\n\tidentity(", "Number", "(7))\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ConstructorNeedsExpectedType(_):
				True
			_:
				False
	)


pure func test_ufcs_payload_constructor_cannot_infer_from_return_context() -> Bool:
	rejects(CHOICE + IDENTITY + "pure func use() -> Choice:\n\t", "Number", "(7).identity()\n" + MAIN, pure func(
		kind: Checked.CheckErrorKind,
	) -> Bool:
		match kind:
			Checked.ConstructorNeedsExpectedType(_):
				True
			_:
				False
	)


pure func test_concrete_parameter_still_contextualizes_constructor() -> Bool:
	checked(
		CHOICE + IDENTITY + "pure func take(value: Choice) -> Choice:\n\tvalue\npure func use() -> Choice:\n\tidentity(take(Number(7)))\n" + MAIN,
	).is_ok()


private pure func symbolic_argument(
	function: Checked.CheckedFunction,
) -> Option[Checked.TypeParameterId]:
	match function.body:
		Checked.CheckedValueBody(value):
			match value.base:
				Checked.ReturnCall(call, [_]):
					match call.target:
						Checked.UserFunction(_, [Checked.ParameterType(argument)]):
							Some(argument)
						_:
							None
				_:
					None
		_:
			None


pure func test_forwarding_publishes_caller_owned_symbolic_substitution() -> Bool:
	match checked(IDENTITY + "pure func forward[T](value: T) -> T:\n\tidentity(value)\n" + MAIN):
		Ok(program):
			match Checked.checked_functions(program).functions:
				[identity, forward, _]:
					match identity.signature.type_parameters:
						[callee_parameter]:
							match forward.signature.type_parameters:
								[caller_parameter]:
									match symbolic_argument(forward):
										Some(argument):
											(
												not Checked.same_parameter(
													callee_parameter,
													caller_parameter,
												)
												and Checked.same_parameter(
													argument,
													caller_parameter,
												)
											)
										None:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


private pure func accepted_prelude(source: String) -> Result[Void, Diagnostic]:
	tokens ?= lex(source)
	parsed ?= parse_prelude(tokens)
	accepted ?= check_prelude(parsed)
	Ok(void)


pure func test_generic_runtime_prelude_rejects() -> Bool:
	prefix = "type Int = builtin\ntype String = builtin\npure func convert["

	match accepted_prelude(prefix + "T](value: Int) -> String:\n\tbuiltin(\"int.to_string\")\n"):
		Err(error):
			(
				error.span.start == prefix.length()
				and error.span.end == prefix.length() + 1
				and error.message == "prelude builtin functions cannot be generic"
				and error.help == "remove the type parameter and use the runtime operation's concrete signature"
			)
		Ok(_):
			False


tests: TestSuite = {
	description = "Blorp 2 generic functions",
	tests = [
		("one declaration accepts Int and String", test_one_declaration_accepts_int_and_string),
		(
			"generic forwarding preserves caller parameter",
			test_generic_forwarding_preserves_the_caller_parameter,
		),
		("unused rigid invalid body rejects", test_unused_invalid_rigid_body_rejects),
		(
			"Int only use does not recheck rigid invalid body",
			test_int_only_use_does_not_recheck_invalid_body_as_int,
		),
		(
			"arbitrary parameter cannot call String runtime",
			test_arbitrary_parameter_cannot_call_string_runtime,
		),
		(
			"arbitrary parameter cannot call Int runtime",
			test_arbitrary_parameter_cannot_call_integer_runtime,
		),
		(
			"generic main rejects at parameter declaration",
			test_generic_main_rejects_at_parameter_declaration,
		),
		("builtin type parameter collision rejects", test_builtin_type_parameter_collision_rejects),
		(
			"forward declared union parameter collision rejects",
			test_forward_declared_union_type_parameter_collision_rejects,
		),
		("phantom parameter call has no default", test_phantom_parameter_call_has_no_default),
		(
			"zero argument generic call has no default",
			test_zero_argument_generic_call_has_no_default,
		),
		("generic unary call requires argument", test_generic_unary_call_still_requires_argument),
		("generic call preserves purity", test_generic_call_preserves_purity),
		("unused generic recursion rejects", test_generic_recursion_rejects_even_when_unused),
		("undeclared parameter name rejects", test_undeclared_parameter_name_rejects),
		(
			"local parameter shadows direct generic call",
			test_local_parameter_shadows_direct_generic_call,
		),
		(
			"local parameter does not shadow generic UFCS",
			test_local_parameter_does_not_shadow_generic_ufcs,
		),
		(
			"direct nullary constructor cannot infer from return context",
			test_direct_nullary_constructor_cannot_infer_from_return_context,
		),
		(
			"UFCS nullary constructor cannot infer from return context",
			test_ufcs_nullary_constructor_cannot_infer_from_return_context,
		),
		(
			"direct payload constructor cannot infer from return context",
			test_direct_payload_constructor_cannot_infer_from_return_context,
		),
		(
			"UFCS payload constructor cannot infer from return context",
			test_ufcs_payload_constructor_cannot_infer_from_return_context,
		),
		(
			"concrete parameter contextualizes constructor",
			test_concrete_parameter_still_contextualizes_constructor,
		),
		(
			"forwarding publishes caller owned symbolic substitution",
			test_forwarding_publishes_caller_owned_symbolic_substitution,
		),
		("generic runtime prelude rejects", test_generic_runtime_prelude_rejects),
	]
}
