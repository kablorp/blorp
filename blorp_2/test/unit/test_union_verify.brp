import:
	../../src/own:
		OwnedExit(ReturnResult),
		OwnedTail(ReturnTail),
		OwnedValueOperation(IntegerDefinition),
		OwnershipOperation(DefineValue),
		OwnershipProgram,
		ResultOwnership(UnmanagedResult),
		ReturnTransfer(UnmanagedReturn),
	../../src/specialize: ConcreteUnion, PayloadShape(NoPayload, IntPayload), TypeRef(IntType)
	../../src/syntax: FunctionExecution(OrdinaryCalls), Purity(Pure)
	../../src/verify: verify
	ownership_inputs: InputIds, input_ids, span
	test: TestSuite


-- Only identities come from the seed; these raw layouts and operations are
-- constructed independently of ownership insertion.
private pure func program(ids: InputIds, unions: List[ConcreteUnion]) -> OwnershipProgram:
	{
		records = [],
		unions = unions,
		entrypoint = ids.entrypoint,
		functions = [
			{
				execution = OrdinaryCalls,
				signature = {
					purity = Pure,
					parameters = [],
					return_type = IntType
				},
				operations = [DefineValue({
						id = ids.first,
						value_type = IntType,
						operation = IntegerDefinition(0),
						result = UnmanagedResult,
						span = span(10),
					})],
				tail = ReturnTail(ReturnResult(UnmanagedReturn(ids.first)))
			},
		]
	}


private pure func rejects(input: OwnershipProgram, message: String) -> Bool:
	match verify(input):
		Err(error):
			(
				error.message == "ownership verification failed: " + message
				and error.help == "report this compiler error with the input program"
				and error.span.start == 0
				and error.span.end == 0
			)
		Ok(_):
			False


private pure func accepts(unions: List[ConcreteUnion]) -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			match verify(program(ids, unions)):
				Ok(_):
					True
				Err(_):
					False


private pure func rejects_empty(unions: List[ConcreteUnion]) -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			rejects(
				program(ids, unions),
				"union layout must contain one or more variants",
			)


pure func test_rejects_an_unused_empty_union() -> Bool:
	rejects_empty([{variants = []}])


pure func test_rejects_an_empty_union_before_a_valid_unused_union() -> Bool:
	rejects_empty([
		{variants = []},
		{variants = [NoPayload]},
	])


pure func test_rejects_an_empty_union_after_a_valid_unused_union() -> Bool:
	rejects_empty([
		{variants = [NoPayload, IntPayload]},
		{variants = []},
	])


pure func test_accepts_an_unused_payload_free_union() -> Bool:
	accepts([{variants = [NoPayload]}])


pure func test_accepts_an_unused_int_payload_union() -> Bool:
	accepts([{variants = [IntPayload]}])


pure func test_accepts_multiple_unused_nonempty_unions() -> Bool:
	accepts([
		{variants = [NoPayload]},
		{variants = [IntPayload, NoPayload]},
	])


pure func test_record_layout_error_precedes_union_layout_error() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = program(ids, [{variants = []}])
			rejects(
				{ original | records = [{fields = []}] },
				"record layout must contain one or more Int fields",
			)


pure func test_union_layout_error_precedes_function_error() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = program(ids, [{variants = []}])

			match original.functions:
				[function]:
					rejects(
						{ original | functions = [{ function | operations = [] }] },
						"union layout must contain one or more variants",
					)
				_:
					False


pure func test_missing_entrypoint_precedes_union_layout_error() -> Bool:
	match input_ids():
		Err(_):
			False
		Ok(ids):
			original = program(ids, [{variants = []}])
			rejects({ original | functions = [] }, "entrypoint function is not defined")


tests: TestSuite = {
	description = "Independent union layout publication verification",
	tests = [
		("unused empty union", test_rejects_an_unused_empty_union),
		("empty union before valid row", test_rejects_an_empty_union_before_a_valid_unused_union),
		("empty union after valid row", test_rejects_an_empty_union_after_a_valid_unused_union),
		("unused payload free union", test_accepts_an_unused_payload_free_union),
		("unused Int payload union", test_accepts_an_unused_int_payload_union),
		("multiple unused valid unions", test_accepts_multiple_unused_nonempty_unions),
		("record error precedence", test_record_layout_error_precedes_union_layout_error),
		("union error before function", test_union_layout_error_precedes_function_error),
		("missing entrypoint precedence", test_missing_entrypoint_precedes_union_layout_error),
	]
}
