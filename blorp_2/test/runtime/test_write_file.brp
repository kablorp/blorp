import:
	../../src/emit/emit: aggregate_runtime
	../../src/own/own: own
	../../src/runtime/string: string_runtime
	../../src/runtime/system: SYSTEM_WRITE_FILE_RUNTIME
	../../src/verify/verify: verify
	../unit/module_input: TEST_BASE
	../unit/void_string_result_inputs: lowered_result
	fs: IOError, resource_path, temporary_directory
	process: run
	system: getenv, read_file, temp_dir, write_file
	test: TestSuite, run_suite_result


private func native_case(executable: String, name: String) -> Bool:
	match run(executable, [name]):
		Err(_): False
		Ok(output):
			if output.exit_code() == 0 and output.stdout() == "" and output.stderr() == "":
				True
			else:
				print_error(output.stderr())
				False


private func native_checks(directory: String) -> Result[Bool, String]:
	lowered ?= lowered_result(TEST_BASE).map_err(pure func(error): error.message)
	owned ?= own(lowered).map_err(pure func(error): error.message)
	verified ?= verify(owned).map_err(pure func(error): error.message)
	aggregates ?= aggregate_runtime(verified).map_err(pure func(error): error.message)
	strings_written ?= write_file(directory + "/string_runtime.c", string_runtime())
	written ?= write_file(directory + "/write_file_runtime.c", SYSTEM_WRITE_FILE_RUNTIME + aggregates + "\n")
	fixture ?= read_file("blorp_2/test/runtime/fixtures/write_file_test.c")
	test_written ?= write_file(directory + "/write_file_test.c", fixture)
	executable = directory + "/write_file_test"
	compiled ?= run(getenv("BLORP_CC").get_or("clang"), ["-std=c11", "-O0", "-Wall", "-Wextra", "-Werror", "-pedantic", "-fsanitize=address,undefined", "-fno-sanitize-recover=all", directory + "/write_file_test.c", "-lm", "-o", executable])
	if compiled.exit_code() != 0 or compiled.stdout() != "" or compiled.stderr() != "":
		Err("write-file native build failed: " + compiled.stderr())
	else:
		cases = [
			("empty creates and truncates without fwrite", "empty"),
			("wb truncates and writes counted Unicode", "utf8"),
			("contents retain NUL and following bytes", "nul"),
			("contents retain CRLF and BOM", "crlf_bom"),
			("NUL path rejects before path allocation or open", "nul_path"),
			("missing parent returns the saved native error", "missing_parent"),
			("open EACCES survives path free", "open_eacces"),
			("short EIO survives free and close", "short_eio"),
			("short EINTR makes one write attempt", "short_eintr"),
			("short transfer retains zero errno", "short_zero"),
			("close ENOSPC rejects completed write", "close_enospc"),
			("close EINTR makes one close attempt", "close_eintr"),
			("short write error beats close failure", "write_close"),
			("simultaneous errors own distinct fresh roots", "fresh"),
			("same String supplies two unchanged live borrows", "same_input"),
			("active Ok drops no String child", "ok_drop"),
			("active Err drops exactly one String child", "err_drop"),
		]
		suite: TestSuite = {
			description = "Target write-file native ownership",
			tests = cases.map(func(item): (item[0], func(): native_case(executable, item[1])))
		}
		result = run_suite_result(suite)
		Ok(result[1] == 0)


private func scoped_native_checks() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp2_write_file_"):
		match native_checks(directory.resource_path()):
			Ok(passed): Ok(passed)
			Err(error):
				print_error(error)
				Ok(False)


func test_write_file_native_contract() -> Bool:
	match scoped_native_checks():
		Ok(passed): passed
		Err(error):
			print_error(error.to_string())
			False


tests: TestSuite = {
	description = "Blorp 2 write-file native runtime",
	tests = [("native status and ordinary Void/String Result destruction", test_write_file_native_contract)]
}
