import:
	../../src/runtime/string:
		string_equals_runtime,
		string_parse_int_runtime,
		string_print_runtime,
		string_runtime,
	fs: IOError, resource_path, temporary_directory
	process: ProcessOutput, run
	system: getenv, read_file, temp_dir, write_file
	test: TestSuite, run_suite_result


private func run_isolated(
	program: String,
	arguments: List[String],
) -> Result[ProcessOutput, String]:
	run(
		"/usr/bin/env",
		["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", program].concat(arguments),
	)


private func build_runtime_tests(directory: String) -> Result[String, String]:
	runtime_written ?= write_file(
		directory + "/string_runtime.c",
		string_runtime() + string_print_runtime() + string_parse_int_runtime() + string_equals_runtime(),
	)
	test_source ?= read_file("blorp_2/test/runtime/fixtures/string_test.c")
	test_written ?= write_file(directory + "/string_runtime_test.c", test_source)
	executable = directory + "/string_runtime_test"
	compiled ?= run_isolated(
		getenv("BLORP_CC").get_or("clang"),
		[
			"-std=c11",
			"-O0",
			"-Wall",
			"-Wextra",
			"-Werror",
			"-pedantic",
			"-fsanitize=address,undefined",
			"-fno-sanitize-recover=all",
			directory + "/string_runtime_test.c",
			"-o",
			executable,
		],
	)

	if (
		compiled.exit_code() == 0
		and compiled.stdout() == ""
		and compiled.stderr() == ""
	):
		Ok(executable)
	else:
		Err("String runtime C unit build failed: " + compiled.stderr())


private func run_runtime_case(executable: String, name: String) -> Bool:
	run_runtime_output(executable, name, "")


private func run_runtime_output(executable: String, name: String, expected: String) -> Bool:
	match run_isolated(executable, [name]):
		Err(error):
			print_error(error)
			False
		Ok(result):
			if (
				result.exit_code() == 0
				and result.stdout() == expected
				and result.stderr() == ""
			):
				True
			else:
				print_error("String runtime case " + name + " exited " + result
						.exit_code()
						.to_string() + "; stdout=" + result.stdout() + "; stderr=" + result.stderr())
				False


private pure func runtime_suite(executable: String) -> TestSuite:
	{
		description = "Blorp 2 String runtime C unit invariants",
		tests = [
			("duplicate edge outputs retain independent lifetimes", func(): run_runtime_case(executable, "edge_duplicate_outputs")),
			("swap outputs survive both old-owner retirements", func(): run_runtime_case(executable, "edge_swap_outputs")),
			("old alias and new edge output die independently", func(): run_runtime_case(executable, "edge_old_alias")),
			("byte_at rejects full-width bounds without allocating", func(): run_runtime_case(executable, "byte_at_bounds")),
			("byte_at borrows unsigned UTF-8 and NUL bytes", func(): run_runtime_case(executable, "byte_at_values")),
			("from_codepoint encodes exact scalar boundaries with one owner", func(): run_runtime_case(executable, "from_codepoint_boundaries")),
			("from_codepoint rejects invalid Int64 scalars without allocating", func(): run_runtime_case(executable, "from_codepoint_invalid")),
			(
				"empty equality borrows both inputs",
				func(): run_runtime_case(executable, "equals_empty"),
			),
			("equal bytes borrow both inputs", func(): run_runtime_case(executable, "equals_same")),
			(
				"same prefix and unequal lengths differ",
				func(): run_runtime_case(executable, "equals_lengths"),
			),
			(
				"equality observes NUL and following digits",
				func(): run_runtime_case(executable, "equals_nul"),
			),
			(
				"equality preserves distinct valid UTF-8 bytes",
				func(): run_runtime_case(executable, "equals_bytes"),
			),
			("strict parse Int64 bounds", func(): run_runtime_case(executable, "parse_bounds")),
			("strict parse Int64 overflow", func(): run_runtime_case(executable, "parse_overflow")),
			("strict parse signs and zero", func(): run_runtime_case(executable, "parse_signs")),
			(
				"strict parse counted bytes",
				func(): run_runtime_case(executable, "parse_counted_bytes"),
			),
			("strict parse whitespace", func(): run_runtime_case(executable, "parse_whitespace")),
			(
				"print borrows and returns canonical unit",
				func(): run_runtime_output(executable, "print_borrow", "kept\nkept\n"),
			),
			("empty print writes LF", func(): run_runtime_output(executable, "print_empty", "\n")),
			(
				"print writes counted UTF-8 NUL and digits",
				func(): run_runtime_output(executable, "print_bytes", "é😀\0123\n"),
			),
			(
				"zero has exact decimal bytes and length",
				func(): run_runtime_case(executable, "zero"),
			),
			(
				"negative has exact decimal bytes and length",
				func(): run_runtime_case(executable, "negative"),
			),
			(
				"Int64 minimum has exact decimal bytes and length",
				func(): run_runtime_case(executable, "minimum"),
			),
			(
				"Int64 maximum has exact decimal bytes and length",
				func(): run_runtime_case(executable, "maximum"),
			),
			(
				"new String owns one reference",
				func(): run_runtime_case(executable, "initial_reference"),
			),
			(
				"retain increments only the reference count",
				func(): run_runtime_case(executable, "retain"),
			),
			(
				"nonfinal release preserves usable bytes",
				func(): run_runtime_case(executable, "nonfinal_release"),
			),
			(
				"final release frees exactly one root",
				func(): run_runtime_case(executable, "final_release"),
			),
			(
				"String objects have independent lifetimes",
				func(): run_runtime_case(executable, "independent_objects"),
			),
			(
				"empty bytes create a terminated String",
				func(): run_runtime_case(executable, "bytes_empty"),
			),
			(
				"ASCII bytes use their exact explicit length",
				func(): run_runtime_case(executable, "bytes_ascii"),
			),
			(
				"embedded NUL preserves the following digit",
				func(): run_runtime_case(executable, "bytes_embedded_nul"),
			),
			(
				"escape bytes quotes backslashes and question marks are exact",
				func(): run_runtime_case(executable, "bytes_escapes"),
			),
			(
				"two-byte accented scalar retains its UTF-8 byte length",
				func(): run_runtime_case(executable, "bytes_utf8_accent"),
			),
			(
				"four-byte emoji retains its UTF-8 byte length",
				func(): run_runtime_case(executable, "bytes_utf8_emoji"),
			),
			(
				"mixed UTF-8 and embedded NUL retain all bytes",
				func(): run_runtime_case(executable, "bytes_utf8_mixed_nul"),
			),
			(
				"equal byte contents allocate independent roots",
				func(): run_runtime_case(executable, "bytes_independent_roots"),
			),
			(
				"byte construction copies mutable input storage",
				func(): run_runtime_case(executable, "bytes_copy_input"),
			),
			(
				"byte construction starts with one reference",
				func(): run_runtime_case(executable, "bytes_initial_reference"),
			),
			(
				"nonfinal byte release preserves usable contents",
				func(): run_runtime_case(executable, "bytes_nonfinal_release"),
			),
			(
				"final byte release frees exactly one root",
				func(): run_runtime_case(executable, "bytes_final_release"),
			),
			(
				"byte root allocations and final frees balance",
				func(): run_runtime_case(executable, "bytes_balanced_lifetimes"),
			),
		]
	}


private func check_runtime() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-runtime-"):
		match build_runtime_tests(directory.resource_path()):
			Err(error):
				print_error(error)
				Ok(False)
			Ok(executable):
				result = run_suite_result(runtime_suite(executable))
				Ok(result[1] == 0)


func test_runtime() -> Bool:
	match check_runtime():
		Ok(passed):
			passed
		Err(error):
			print_error(error.to_string())
			False


tests: TestSuite = {
	description = "Blorp 2 String runtime",
	tests = [("compile runtime once and run C unit cases", test_runtime)]
}
