import:
	../../src/emit/emit: aggregate_runtime
	../../src/own/own: own
	../../src/runtime/string: string_runtime
	../../src/runtime/system: SYSTEM_READ_FILE_RUNTIME
	../../src/verify/verify: verify
	../unit/file_read_inputs: file_read_seed
	../unit/module_input: TEST_BASE
	fs: IOError, resource_path, temporary_directory
	process: run
	system: getenv, read_file, temp_dir, write_file
	test: TestSuite, run_suite_result


private func native_case(executable: String, name: String) -> Bool:
	match run(executable, [name]):
		Err(_): False
		Ok(output):
			if output.exit_code() == 0 and output.stdout() == "" and output.stderr() == "":
				True
			else:
				print_error(output.stderr())
				False


private func native_checks(directory: String) -> Result[Bool, String]:
	seed ?= file_read_seed(TEST_BASE).map_err(pure func(error): error.message)
	owned ?= own(seed.lowered).map_err(pure func(error): error.message)
	verified ?= verify(owned).map_err(pure func(error): error.message)
	aggregates ?= aggregate_runtime(verified).map_err(pure func(error): error.message)
	written ?= write_file(directory + "/file_read_runtime.c", string_runtime() + SYSTEM_READ_FILE_RUNTIME + aggregates)
	fixture ?= read_file("blorp_2/test/runtime/fixtures/file_read_test.c")
	test_written ?= write_file(directory + "/file_read_test.c", fixture)
	executable = directory + "/file_read_test"
	compiled ?= run(getenv("BLORP_CC").get_or("clang"), ["-std=c11", "-O0", "-Wall", "-Wextra", "-Werror", "-pedantic", "-fsanitize=address,undefined", "-fno-sanitize-recover=all", directory + "/file_read_test.c", "-lm", "-o", executable])
	if compiled.exit_code() != 0 or compiled.stdout() != "" or compiled.stderr() != "":
		Err("file-read native build failed: " + compiled.stderr())
	else:
		cases = [
			("empty fresh success", "empty"),
			("counted multibyte success", "utf8"),
			("bytes after NUL remain exact", "nul"),
			("CRLF and BOM remain exact", "crlf_bom"),
			("malformed UTF-8 rejects before publication", "malformed"),
			("NUL path performs no open", "nul_path"),
			("two live calls own distinct roots", "fresh"),
			("open error survives path free", "open"),
			("seek-end error survives close", "seek_end"),
			("tell error survives close", "tell"),
			("tell EOVERFLOW is reachable OS error", "tell_overflow"),
			("seek-start error survives close", "seek_start"),
			("read EIO survives ferror and cleanup", "read_eio"),
			("read EINTR makes one attempt", "read_eintr"),
			("EOF ignores stale errno", "short"),
			("close ENOSPC rejects", "close"),
			("close EINTR makes one attempt", "close_eintr"),
			("primary read error beats close", "read_close"),
			("close error beats encoding", "invalid_close"),
		]
		suite: TestSuite = {
			description = "Target file-read native ownership",
			tests = cases.map(func(item): (item[0], func(): native_case(executable, item[1])))
		}
		result = run_suite_result(suite)
		Ok(result[1] == 0)


private func scoped_native_checks() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp2_file_read_"):
		match native_checks(directory.resource_path()):
			Ok(passed): Ok(passed)
			Err(error):
				print_error(error)
				Ok(False)


func test_file_read_native_contract() -> Bool:
	match scoped_native_checks():
		Ok(passed): passed
		Err(error):
			print_error(error.to_string())
			False


tests: TestSuite = {
	description = "Blorp 2 file-read native runtime",
	tests = [("native admission and both Result payloads", test_file_read_native_contract)]
}
