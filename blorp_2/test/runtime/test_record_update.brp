import:
	../../src/specialize/specialize as Concrete
	../../src/verify/verify: VerifiedProgram, verified_contents
	int as IntOps
	test: TestSuite
	./test_record: RuntimeCase, runtime_passes


-- Current literal/projection syntax supplies the complete runtime catalogue.
-- These metadata functions are never called by the native helper fixture.
private SOURCE: String =
	|fixed record Entry { number: Int, text: String }
	|fixed record Pair { left: String, right: String }
	|fixed record Unit { value: Void }
	|fixed record NumberBox { choice: Option[Int] }
	|fixed record Box { number: Int, entry: Entry, values: List[Entry], choice: Option[String] }
	|fixed record Point { left: Int, right: Int }
	|pure func repeat[T](element: T, count: Int) -> List[T]:
	|    builtin("list.repeat")
	|pure func make_entry() -> Entry:
	|    { number = 42, text = "42" }
	|pure func make_pair() -> Pair:
	|    { left = "left", right = "right" }
	|pure func make_unit() -> Unit:
	|    { value = void }
	|pure func make_number() -> NumberBox:
	|    { choice = None }
	|pure func make_box() -> Box:
	|    { number = 42, entry = make_entry(), values = repeat(make_entry(), 2), choice = Some("42") }
	|pure func make_point() -> Point:
	|    { left = 1, right = 2 }
	|func main() -> Int:
	|    entry = make_entry()
	|    pair = make_pair()
	|    unit = make_unit()
	|    number = make_number()
	|    boxed = make_box()
	|    point = make_point()
	|    0
	|


private pure func managed(layout: Concrete.ConcreteRecord) -> Bool:
	match layout:
		Concrete.CountedFields(_): True
		Concrete.InlineFields(_): False


private pure func record_type(value_type: Concrete.TypeRef, ordinal: Int) -> Bool:
	match value_type:
		Concrete.RecordType(id): IntOps.equals(Concrete.record_number(id), ordinal)
		_: False


private pure func union_type(value_type: Concrete.TypeRef, ordinal: Int) -> Bool:
	match value_type:
		Concrete.UnionType(id): IntOps.equals(Concrete.union_number(id), ordinal)
		_: False


-- C symbol ordinals are safe only after checking all producer-issued rows,
-- complete fields and representations that the native cases consume.
private pure func complete_catalogue(program: VerifiedProgram) -> Bool:
	facts = verified_contents(program)
	match facts.records:
		[entry, pair, unit, number, boxed, point]:
			entry_fields = match Concrete.record_fields(entry):
				[Concrete.IntType, Concrete.StringType]: True
				_: False
			pair_fields = match Concrete.record_fields(pair):
				[Concrete.StringType, Concrete.StringType]: True
				_: False
			unit_fields = match Concrete.record_fields(unit):
				[Concrete.VoidType]: True
				_: False
			number_fields = match Concrete.record_fields(number):
				[choice]: union_type(choice, 0)
				_: False
			box_fields = match Concrete.record_fields(boxed):
				[Concrete.IntType, child, Concrete.ListType(element), choice]:
					record_type(child, 0) and record_type(element, 0) and union_type(choice, 1)
				_: False
			point_fields = match Concrete.record_fields(point):
				[Concrete.IntType, Concrete.IntType]: True
				_: False
			point_inline = match point:
				Concrete.InlineFields(_): True
				Concrete.CountedFields(_): False
			unions = match facts.unions:
				[numeric, text]:
					numeric_fields = match Concrete.union_variants(numeric):
						[[Concrete.IntType], []]: True
						_: False
					text_fields = match Concrete.union_variants(text):
						[[Concrete.StringType], []]: True
						_: False
					numeric_unmanaged = match numeric:
						Concrete.PlainCases(_): True
						Concrete.OwningCases(_) | Concrete.BoxedCases(_): False
					text_owned = match text:
						Concrete.OwningCases(_): True
						Concrete.PlainCases(_) | Concrete.BoxedCases(_): False
					numeric_fields and text_fields and numeric_unmanaged and text_owned
				_: False
			(entry_fields and pair_fields and unit_fields and number_fields and box_fields and point_fields and unions
			and managed(entry) and managed(pair) and managed(unit) and managed(number) and managed(boxed) and point_inline)
		_: False


private CASES: List[RuntimeCase] = [
	{ description = "fresh copy preserves old live root and independently owns retained text", name = "fresh" },
	{ description = "equal replacements still allocate a fresh root", name = "equal" },
	{ description = "old record alias survives nonfinal drop without acquiring children", name = "old_alias" },
	{ description = "omitted child escapes after both record parents retire", name = "escape" },
	{ description = "RHS and inherited slot independently own the same child", name = "repeated" },
	{ description = "Void-only managed records allocate fresh zero-child roots", name = "void_root" },
	{ description = "unmanaged union fields still require managed record roots", name = "union_root" },
	{ description = "mixed record List and active union children survive base retirement", name = "mixed" },
	{ description = "old List alias survives retiring both enclosing records", name = "list_alias" },
	{ description = "inactive union storage is neither acquired nor destroyed", name = "inactive" },
	{ description = "inline numeric copy allocates no runtime root", name = "inline" },
	{ description = "all-replaced base retirement permits allocator address reuse", name = "all_replaced" },
]


func test_runtime_ownership_protocol() -> Bool:
	runtime_passes(SOURCE, complete_catalogue, "blorp_2/test/runtime/fixtures/record_update_test.c", CASES)


tests: TestSuite = {
	description = "Fresh record update runtime ownership",
	tests = [("actual allocation occurrences and exhaustive child destruction", test_runtime_ownership_protocol)]
}
