import:
	../../src/runtime/memory: MEMORY_RUNTIME
	../../src/runtime/string: string_runtime
	../../src/runtime/string_concat: STRING_CONCAT_RUNTIME, STRING_APPEND_INT_RUNTIME
	fs: IOError, resource_path, temporary_directory
	process: run
	system: getenv, read_file, temp_dir, write_file
	test: TestSuite, run_suite_result


private func native_case(executable: String, name: String, diagnostics: Bool) -> Bool:
	arguments = if diagnostics:
		["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict", executable, name]
	else:
		["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", executable, name]
	match run("/usr/bin/env", arguments):
		Err(error):
			print_error(error)
			False
		Ok(output):
			stderr_valid = if diagnostics:
				output.stderr().starts_with("blorp: leak check: ") and output.stderr().ends_with("0 leaked, 0 bytes\n")
			else:
				output.stderr() == ""
			if output.exit_code() == 0 and output.stdout() == "" and stderr_valid:
				True
			else:
				print_error(name + ": " + output.stderr())
				False


private func native_checks(directory: String) -> Result[Bool, String]:
	written ?= write_file(directory + "/string_concat_runtime.c", MEMORY_RUNTIME + string_runtime() + STRING_CONCAT_RUNTIME + STRING_APPEND_INT_RUNTIME)
	fixture ?= read_file("blorp_2/test/runtime/fixtures/string_concat_test.c")
	test_written ?= write_file(directory + "/string_concat_test.c", fixture)
	executable = directory + "/string_concat_test"
	compiled ?= run(getenv("BLORP_CC").get_or("clang"), ["-std=c11", "-O0", "-Wall", "-Wextra", "-Werror", "-pedantic", "-fsanitize=address,undefined", "-fno-sanitize-recover=all", directory + "/string_concat_test.c", "-o", executable])
	diagnostic_executable = executable + "_diagnostics"
	diagnostic_compiled ?= run(getenv("BLORP_CC").get_or("clang"), ["-std=c11", "-O0", "-Wall", "-Wextra", "-Werror", "-pedantic", "-fsanitize=address,undefined", "-fno-sanitize-recover=all", "-DBLORP_MEMORY_DIAGNOSTICS=1", directory + "/string_concat_test.c", "-o", diagnostic_executable])
	if compiled.exit_code() != 0 or compiled.stdout() != "" or compiled.stderr() != "" or diagnostic_compiled.exit_code() != 0 or diagnostic_compiled.stdout() != "" or diagnostic_compiled.stderr() != "":
		Err("String concat native build failed: " + compiled.stderr() + diagnostic_compiled.stderr())
	else:
		cases = [
			("empty operands create one fresh owner", "concat_empty"),
			("empty left preserves exact right", "concat_left_empty"),
			("empty right preserves exact left", "concat_right_empty"),
			("ASCII concatenation survives input destruction", "concat_ascii"),
			("concatenation preserves multilingual bytes", "concat_utf8"),
			("concatenation preserves embedded NUL and following bytes", "concat_nul"),
			("concatenation preserves distinct normalization forms", "concat_normalization"),
			("aliasing operands borrow one source obligation", "concat_alias"),
			("consuming empty operands keeps exact bytes", "take_empty"),
			("consuming empty prefix grows through relocation", "take_left_empty"),
			("consuming empty suffix needs no allocation", "take_right_empty"),
			("consuming concat preserves UTF-8 and embedded NUL", "take_utf8_nul"),
			("unique spare capacity needs zero allocation or resize", "take_spare_capacity"),
			("shared prefix is preserved and one reference discharged", "take_shared"),
			("distinct counted owners may alias the same root", "take_shared_alias"),
			("geometric growth relocates with bounded total copying", "take_geometric_growth"),
			("unrepresentable lengths abort before accessing bytes", "overflow"),
			("borrowed integer append preserves source and allocates only its result", "append_int_borrowed"),
			("integer append formats zero and both Int64 limits", "append_int_limits"),
			("integer append preserves UTF-8 and embedded NUL prefix", "append_int_utf8_nul"),
			("shared integer append copies and discharges one reference", "append_int_shared"),
			("unique integer append reuses spare capacity without a decimal allocation", "append_int_spare"),
			("integer append growth relocates with bounded total copying", "append_int_growth"),
			("integer append rejects length overflow before reading bytes", "append_int_overflow"),
		]
		suite: TestSuite = {
			description = "Counted String concat lifetimes and bytes",
			tests = cases.map(func(item): (item[0], func(): native_case(executable, item[1], False)))
				.concat(cases.map(func(item): (item[0] + " with strict leak checks", func(): native_case(diagnostic_executable, item[1], True))))
		}
		result = run_suite_result(suite)
		Ok(result[1] == 0)


private func scoped_native_checks() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp2_string_concat_"):
		match native_checks(directory.resource_path()):
			Ok(passed): Ok(passed)
			Err(error):
				print_error(error)
				Ok(False)


func test_string_concat_native_contract() -> Bool:
	match scoped_native_checks():
		Ok(passed): passed
		Err(error):
			print_error(error.to_string())
			False


tests: TestSuite = {
	description = "Blorp 2 counted String concat native runtime",
	tests = [("native concat contracts", test_string_concat_native_contract)]
}
