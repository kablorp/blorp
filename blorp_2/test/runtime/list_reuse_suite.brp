import:
    ../../src/emit/emit: aggregate_runtime
    ../../src/own/own: own
    ../../src/verify/verify: verify, verified_contents, VerifiedProgram
    ../../src/specialize/specialize as Concrete
    ../../src/runtime/memory: MEMORY_RUNTIME
    ../../src/runtime/string: string_runtime
    ../unit/list_update_inputs: lowered
    ../e2e/self_hosted_reports: verify_accounting
    process: run_to_files
    system: read_file, write_file
    io: print_error
    test: TestSuite
    string: String methods
    int: Int methods
    bool: and
    result: Result methods


-- Shared with the native probe's EXPECTED_CAPACITY_ABORT status.
private EXPECTED_CAPACITY_ABORT: Int = 73
-- The memory runtime's BLORP_STRICT_LEAK_EXIT_STATUS.
private STRICT_LEAK_EXIT_STATUS: Int = 99
private UNBALANCED_EMPTY_PREFIX: String = "blorp: leak check: unbalanced empty list owners: "


-- Only the public phases establish the concrete aggregate helpers. The C probe
-- includes their runtime fragment and never a generated language function.
private SOURCE: String =
    |fixed record Entry { text: String }
    |fixed record Point { number: Int }
    |fixed union Choice:
    |    Text(String)
    |    Empty
    |pure func repeat[T](element: T, count: Int) -> List[T]:
    |    builtin("list.repeat")
    |pure func append[T](values: List[T], element: T) -> List[T]:
    |    builtin("list.append")
    |pure func set[T](values: List[T], index: Int, element: T) -> List[T]:
    |    builtin("list.set")
    |pure func concat[T](left: List[T], right: List[T]) -> List[T]:
    |    builtin("list.concat")
    |pure func rest[T](values: List[T]) -> List[T]:
    |    match values:
    |        []: []
    |        [_, ...remaining]: remaining
    |pure func identity() -> Int:
    |    0
    |func main(args: List[String]) -> Int:
    |    entry: Entry = { text = "text" }
    |    point: Point = { number = 1 }
    |    entries = append(repeat(entry, 0), entry)
    |    points = append(repeat(point, 0), point)
    |    choices: List[Choice] = append(repeat(Text("text"), 0), Text("other"))
    |    ints = append(repeat(0, 0), 1)
    |    replaced = set(ints, 0, 2)
    |    joined = concat(ints, ints)
    |    texts = append(repeat("text", 0), "other")
    |    nested = append(repeat(texts, 0), texts)
    |    units = append(repeat(void, 0), void)
    |    callbacks = append(repeat(identity, 0), identity)
    |    updated_texts = set(texts, 0, "replacement")
    |    joined_texts = concat(texts, texts)
    |    updated_nested = set(nested, 0, texts)
    |    joined_nested = concat(nested, nested)
    |    updated_entries = set(entries, 0, entry)
    |    joined_entries = concat(entries, entries)
    |    updated_points = set(points, 0, point)
    |    joined_points = concat(points, points)
    |    updated_choices = set(choices, 0, Empty)
    |    joined_choices = concat(choices, choices)
    |    updated_units = set(units, 0, void)
    |    joined_units = concat(units, units)
    |    updated_callbacks = set(callbacks, 0, identity)
    |    joined_callbacks = concat(callbacks, callbacks)
    |    tail = rest(texts)
    |    0
    |


-- The probe's concrete C names are admitted only after this typed catalogue.
private pure func catalogue(program: VerifiedProgram) -> Bool:
    contents = verified_contents(program)
    match (contents.records, contents.unions):
        ([entry, point], [choice]):
            match ((entry, Concrete.record_fields(entry)), (point, Concrete.record_fields(point)), (choice, Concrete.union_variants(choice))):
                ((Concrete.CountedFields(_), [Concrete.StringType]), (Concrete.InlineFields(_), [Concrete.IntType]), (Concrete.OwningCases(_), [[Concrete.StringType], []])): True
                _: False
        _: False


private func ready(c_compiler: String, directory: String) -> Result[String, String]:
    program ?= lowered(SOURCE).and_then(own).and_then(verify).map_err(pure func(error): error.message.add("; ").add(error.help))
    _: Void ?= if catalogue(program):
        Ok(void)
    else:
        Err("list runtime concrete catalogue differs")
    aggregates ?= aggregate_runtime(program).map_err(pure func(error): error.message.add("; ").add(error.help))
    _ ?= write_file(directory.add("/list_memory.c"), MEMORY_RUNTIME)
    _ ?= write_file(directory.add("/list_values.c"), string_runtime().add(aggregates).add("\n"))
    executable = directory.add("/list_reuse_probe")
    prefix = directory.add("/list-reuse-build")
    status ?= run_to_files(c_compiler, ["-std=c11", "-O0", "-Wall", "-Wextra", "-Werror", "-pedantic", "-fsanitize=address,undefined", "-fno-sanitize-recover=all", "-DBLORP_MEMORY_DIAGNOSTICS=1", "-I", directory, "blorp_2/test/runtime/fixtures/list_reuse_test.c", "-o", executable], prefix.add(".out"), prefix.add(".err"), 600000)
    out ?= read_file(prefix.add(".out"))
    err ?= read_file(prefix.add(".err"))
    if and(status.equals(0), and(out.equals(""), err.equals(""))):
        Ok(executable)
    else:
        Err("list reuse native build: ".add(err))


private func probe(executable: String, directory: String, name: String) -> Bool:
    prefix = directory.add("/list-reuse-").add(name)
    result: Result[Void, String] = match run_to_files("/usr/bin/env", ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict", executable, name], prefix.add(".out"), prefix.add(".err"), 10000):
        Err(error): Err(error)
        Ok(status):
            match read_file(prefix.add(".out")):
                Err(error): Err(error)
                Ok(out):
                    match read_file(prefix.add(".err")):
                        Err(error): Err(error)
                        Ok(err):
                            if and(status.equals(0), out.equals("")):
                                verify_accounting(err, False)
                            else:
                                Err("list reuse ".add(name).add(": ").add(err))
    match result:
        Ok(_): True
        Err(error):
            print_error(error)
            False


-- A strict run whose `[]` owners end at `owners` instead of 0 must report that
-- balance before an otherwise balanced allocation report and fail.
private func unbalanced_empty(executable: String, directory: String, name: String, owners: String) -> Bool:
    prefix = directory.add("/list-reuse-").add(name)
    line = UNBALANCED_EMPTY_PREFIX.add(owners).add("\n")
    result: Result[Void, String] = match run_to_files("/usr/bin/env", ["-u", "BLORP_MEMORY_STATS", "BLORP_LEAK_CHECK=strict", executable, name], prefix.add(".out"), prefix.add(".err"), 10000):
        Err(error): Err(error)
        Ok(status):
            match (read_file(prefix.add(".out")), read_file(prefix.add(".err"))):
                (Ok(out), Ok(err)):
                    if and(status.equals(STRICT_LEAK_EXIT_STATUS), and(out.equals(""), err.starts_with(line))):
                        match err.slice(line.length(), err.length()):
                            Some(accounting): verify_accounting(accounting, False)
                            None: Err("list reuse ".add(name).add(": truncated report"))
                    else:
                        Err("list reuse ".add(name).add(": exit ").add(status.to_string()).add(": ").add(err))
                (Err(error), _): Err(error)
                (_, Err(error)): Err(error)
    match result:
        Ok(_): True
        Err(error):
            print_error(error)
            False


-- The C probe maps SIGABRT to this fixed status before invoking only the
-- checked helper. A normal return and any other signal fail this oracle.
private func rejected_capacity(executable: String, directory: String, mode: String) -> Bool:
    prefix = directory.add("/list-reuse-").add(mode)
    match run_to_files(executable, [mode], prefix.add(".out"), prefix.add(".err"), 10000):
        Err(error):
            print_error(error)
            False
        Ok(status):
            match (read_file(prefix.add(".out")), read_file(prefix.add(".err"))):
                (Ok(out), Ok(err)): and(status.equals(EXPECTED_CAPACITY_ABORT), and(out.equals(""), err.equals("")))
                _: False


func suite(c_compiler: String, directory: String) -> TestSuite:
    match ready(c_compiler, directory):
        Err(error):
            print_error(error)
            { description = "List reuse setup", tests = [("native runtime probe builds", func(): False)] }
        Ok(executable):
            {
                description = "List consumed update runtime",
                tests = [
                    ("capacity boundaries 0 1 3 4 5 8 9", func(): probe(executable, directory, "boundaries")),
                    ("unique relocation preserves child obligations", func(): probe(executable, directory, "strings")),
                    ("shared roots preserve aliases and acquire once", func(): probe(executable, directory, "shared")),
                    ("nested root occurrence remains independently owned", func(): probe(executable, directory, "nested")),
                    ("inline record slots move by value", func(): probe(executable, directory, "inline")),
                    ("managed records and owning unions retain exact children", func(): probe(executable, directory, "managed")),
                    ("callable environments and Void slots", func(): probe(executable, directory, "callable")),
                    ("unique set has constant slot work and invalid indices have no hooks", func(): probe(executable, directory, "set-work")),
                    ("same child replacement acquires before its last release", func(): probe(executable, directory, "set-equal")),
                    ("set and concat preserve every aggregate element family", func(): probe(executable, directory, "update-families")),
                    ("unique concat acquires only right slots with at most one relocation", func(): probe(executable, directory, "concat-work")),
                    ("shared set and concat preserve counted aliases", func(): probe(executable, directory, "updates-shared")),
                    ("empty update operands preserve roots and obligations", func(): probe(executable, directory, "updates-empty")),
                    ("the immortal empty root is never written, freed or resized", func(): probe(executable, directory, "static-empty")),
                    ("an extra drop of an empty literal fails the strict check", func(): unbalanced_empty(executable, directory, "static-empty-extra-drop", "-1")),
                    ("a missing drop of an empty literal fails the strict check", func(): unbalanced_empty(executable, directory, "static-empty-missing-drop", "1")),
                    ("concat Int64 bound aborts before storage access", func(): rejected_capacity(executable, directory, "concat-length-overflow")),
                    ("concat byte bound aborts before storage access", func(): rejected_capacity(executable, directory, "concat-byte-overflow")),
                    ("capacity clamps to byte and Int64 bounds", func(): probe(executable, directory, "bounds")),
                    ("required capacity beyond byte limit aborts", func(): rejected_capacity(executable, directory, "required-overflow")),
                    ("invalid current capacity aborts before growth", func(): rejected_capacity(executable, directory, "current-overflow")),
                ]
            }
