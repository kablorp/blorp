import:
	../../src/runtime/memory: MEMORY_RUNTIME
	../../src/emit/emit: aggregate_runtime
	../../src/lower/lower: lower
	../../src/own/own: own
	../../src/specialize/specialize as Concrete
	../../src/runtime/string: string_runtime
	../../src/utils/syntax: Diagnostic
	../../src/verify/verify: VerifiedProgram, verified_contents, verify
	../unit/input: check, setup_diagnostic
	../unit/module_input: TEST_BASE, parse_modules_with_base
	fs: IOError, resource_path, temporary_directory
	process: ProcessOutput, run
	system: getenv, read_file, temp_dir, write_file
	test: TestSuite, run_suite_result


fixed record RuntimeCase {
	description: String,
	name: String
}


-- Reachable constructor calls establish the exact concrete layout authority;
-- unused declarations alone would not populate the specialization catalog.
private RUNTIME_SOURCE: String =
	|fixed record Holder { text: String }
	|fixed record Pair { first: String, second: String }
	|fixed record Nested { child: Holder }
	|fixed record StringChoice { value: Option[String] }
	|fixed record StringValues { values: List[String] }
	|fixed record UnitHolder { value: Void }
	|fixed record NumberChoice { value: Option[Int] }
	|fixed record RecordChoice { value: Option[Holder] }
	|fixed record Scalars { count: Int, ratio: Float, text: String }
	|pure func text(value: Int) -> String:
	|    builtin("int.to_string")
	|pure func make_holder() -> Holder:
	|    { text = text(42) }
	|pure func make_pair() -> Pair:
	|    { first = text(7), second = text(42) }
	|pure func make_nested() -> Nested:
	|    { child = make_holder() }
	|pure func make_choice(value: Option[String]) -> StringChoice:
	|    { value = value }
	|pure func make_values(value: List[String]) -> StringValues:
	|    { values = value }
	|pure func make_unit() -> UnitHolder:
	|    { value = void }
	|pure func make_number(value: Option[Int]) -> NumberChoice:
	|    { value = value }
	|pure func make_record(value: Option[Holder]) -> RecordChoice:
	|    { value = value }
	|pure func make_scalars() -> Scalars:
	|    { count = 7, ratio = 2.5, text = text(42) }
	|func main(arguments: List[String]) -> Int:
	|    first = make_holder()
	|    second = make_pair()
	|    third = make_nested()
	|    fourth = make_choice(Some(text(42)))
	|    fifth = make_values(arguments)
	|    sixth = make_unit()
	|    seventh = make_number(Some(42))
	|    eighth = make_record(Some(make_holder()))
	|    ninth = make_scalars()
	|    0
	|

-- Distinct concrete keys of Holder and Choice must produce the same complete
-- physical catalog as the nongeneric source before the shared C cases run.
private GENERIC_RUNTIME_SOURCE: String =
	|fixed record Holder[T] { text: T }
	|fixed record Pair[T] { first: T, second: T }
	|fixed record Nested[T] { child: Holder[T] }
	|fixed record Choice[T] { value: Option[T] }
	|fixed record Values[T] { values: List[T] }
	|fixed record Scalars[T] { count: Int, ratio: Float, text: T }
	|pure func text(value: Int) -> String:
	|    builtin("int.to_string")
	|pure func make_holder() -> Holder[String]:
	|    { text = text(42) }
	|pure func make_pair() -> Pair[String]:
	|    { first = text(7), second = text(42) }
	|pure func make_nested() -> Nested[String]:
	|    { child = make_holder() }
	|pure func make_choice(value: Option[String]) -> Choice[String]:
	|    { value = value }
	|pure func make_values(value: List[String]) -> Values[String]:
	|    { values = value }
	|pure func make_unit() -> Holder[Void]:
	|    { text = void }
	|pure func make_number(value: Option[Int]) -> Choice[Int]:
	|    { value = value }
	|pure func make_record(value: Option[Holder[String]]) -> Choice[Holder[String]]:
	|    { value = value }
	|pure func make_scalars() -> Scalars[String]:
	|    { count = 7, ratio = 2.5, text = text(42) }
	|func main(arguments: List[String]) -> Int:
	|    first = make_holder()
	|    second = make_pair()
	|    third = make_nested()
	|    fourth = make_choice(Some(text(42)))
	|    fifth = make_values(arguments)
	|    sixth = make_unit()
	|    seventh = make_number(Some(42))
	|    eighth = make_record(Some(make_holder()))
	|    ninth = make_scalars()
	|    0
	|

-- Direct annotations converge on the same complete concrete catalog and runtime
-- fragments; constructor names stay distinct from the base Option declaration.
private DIRECT_RUNTIME_SOURCE: String =
	|fixed union TextChoice:
	|    TextValue(String)
	|    NoText
	|fixed union NumberChoiceValue:
	|    NumberValue(Int)
	|    NoNumber
	|fixed union HolderChoice:
	|    HolderValue(Holder)
	|    NoHolder
	|fixed record Holder { text: String }
	|fixed record Pair { first: String, second: String }
	|fixed record Nested { child: Holder }
	|fixed record StringChoice { value: TextChoice }
	|fixed record StringValues { values: List[String] }
	|fixed record UnitHolder { value: Void }
	|fixed record NumberChoice { value: NumberChoiceValue }
	|fixed record RecordChoice { value: HolderChoice }
	|fixed record Scalars { count: Int, ratio: Float, text: String }
	|pure func text(value: Int) -> String:
	|    builtin("int.to_string")
	|pure func make_holder() -> Holder:
	|    { text = text(42) }
	|pure func make_pair() -> Pair:
	|    { first = text(7), second = text(42) }
	|pure func make_nested() -> Nested:
	|    { child = make_holder() }
	|pure func make_choice(value: TextChoice) -> StringChoice:
	|    { value = value }
	|pure func make_values(value: List[String]) -> StringValues:
	|    { values = value }
	|pure func make_unit() -> UnitHolder:
	|    { value = void }
	|pure func make_number(value: NumberChoiceValue) -> NumberChoice:
	|    { value = value }
	|pure func make_record(value: HolderChoice) -> RecordChoice:
	|    { value = value }
	|pure func make_scalars() -> Scalars:
	|    { count = 7, ratio = 2.5, text = text(42) }
	|func main(arguments: List[String]) -> Int:
	|    first = make_holder()
	|    second = make_pair()
	|    third = make_nested()
	|    fourth = make_choice(TextValue(text(42)))
	|    fifth = make_values(arguments)
	|    sixth = make_unit()
	|    seventh = make_number(NumberValue(42))
	|    eighth = make_record(HolderValue(make_holder()))
	|    ninth = make_scalars()
	|    0
	|


private pure func runtime_program(source: String) -> Result[VerifiedProgram, Diagnostic]:
	parsed ?= parse_modules_with_base(
		[
			{
				source = source,
				targets = []
			},
		],
		TEST_BASE,
	)
	checked ?= check(parsed).map_err(setup_diagnostic)
	specialized ?= Concrete.specialize(checked)
	lowered ?= lower(specialized)
	owned ?= own(lowered)
	verify(owned)


private pure func is_managed(layout: Concrete.ConcreteRecord) -> Bool:
	match layout.representation:
		Concrete.ManagedRecord:
			True
		Concrete.InlineRecord:
			False


private pure func same_fields(
	layout: Concrete.ConcreteRecord,
	expected: List[Concrete.TypeRef],
) -> Bool:
	(
		layout.fields.length() == expected.length()
		and layout.fields
			.zip(expected)
			.all(pure func(pair): Concrete.same_type(pair[0], pair[1]))
	)


private pure func has_record_field(layout: Concrete.ConcreteRecord, expected: Int) -> Bool:
	match layout.fields:
		[Concrete.RecordType(owner)]:
			Concrete.record_number(owner) == expected
		_:
			False


private pure func has_union_field(layout: Concrete.ConcreteRecord, expected: Int) -> Bool:
	match layout.fields:
		[Concrete.UnionType(owner)]:
			Concrete.union_number(owner) == expected
		_:
			False


private pure func is_string_option(layout: Concrete.ConcreteUnion) -> Bool:
	match (layout.representation, layout.variants):
		(Concrete.InlineOwningPayload, [[Concrete.StringType], []]):
			True
		_:
			False


private pure func is_number_option(layout: Concrete.ConcreteUnion) -> Bool:
	match (layout.representation, layout.variants):
		(Concrete.InlineUnmanaged, [[Concrete.IntType], []]):
			True
		_:
			False


private pure func is_record_option(layout: Concrete.ConcreteUnion) -> Bool:
	match (layout.representation, layout.variants):
		(Concrete.InlineOwningPayload, [[Concrete.RecordType(owner)], []]):
			Concrete.record_number(owner) == 0
		_:
			False


private pure func complete_runtime_catalog(program: VerifiedProgram) -> Bool:
	contents = verified_contents(program)

	match (contents.records, contents.unions):
		([holder, pair, nested, choice, values, unit_holder, number, record_choice, scalars], [string_option, number_option, record_option]):
			(
				contents.records.all(is_managed)
				and same_fields(holder, [Concrete.StringType])
				and same_fields(
					pair,
					[Concrete.StringType, Concrete.StringType],
				)
				and has_record_field(nested, 0)
				and has_union_field(choice, 0)
				and same_fields(values, [Concrete.ListType(Concrete.StringType)])
				and same_fields(unit_holder, [Concrete.VoidType])
				and has_union_field(number, 1)
				and has_union_field(record_choice, 2)
				and same_fields(
					scalars,
					[Concrete.IntType, Concrete.FloatType, Concrete.StringType],
				)
				and is_string_option(string_option)
				and is_number_option(number_option)
				and is_record_option(record_option)
			)
		_:
			False


private func run_isolated(
	program: String,
	arguments: List[String],
) -> Result[ProcessOutput, String]:
	run(
		"/usr/bin/env",
		["-u", "BLORP_LEAK_CHECK", "-u", "BLORP_MEMORY_STATS", program].concat(arguments),
	)


private func build_runtime_tests(
	directory: String,
	source: String,
	catalog: pure (VerifiedProgram) -> Bool,
	fixture: String,
) -> Result[String, String]:
	program ?= runtime_program(
		source,
	).map_err(
		pure func(error): error.message + "; help: " + error.help,
	)

	catalog ?= if catalog(program):
		Ok(void)
	else:
		Err("aggregate runtime test requires its complete concrete catalog")

	aggregates ?= aggregate_runtime(
		program,
	).map_err(
		pure func(error): error.message + "; help: " + error.help,
	)
	strings_written ?= write_file(directory + "/string_runtime.c", MEMORY_RUNTIME + string_runtime())
	-- Emitted helpers are a fragment; a C source file needs a terminating newline.
	aggregates_written ?= write_file(directory + "/record_runtime.c", aggregates + "\n")
	aggregate_source ?= read_file(directory + "/record_runtime.c")
	terminated ?= if aggregate_source.ends_with("\n"):
		Ok(void)
	else:
		Err("aggregate runtime C source must end with a newline")
	executable = directory + "/aggregate_runtime_test"
	compiled ?= run_isolated(
		getenv("BLORP_CC").get_or("clang"),
		[
			"-std=c11",
			"-O0",
			"-Wall",
			"-Wextra",
			"-Werror",
			"-pedantic",
			"-fsanitize=address,undefined",
			"-fno-sanitize-recover=all",
			"-I",
			directory,
			fixture,
			"-o",
			executable,
		],
	)

	if (
		compiled.exit_code() == 0
		and compiled.stdout() == ""
		and compiled.stderr() == ""
	):
		Ok(executable)
	else:
		Err("aggregate runtime C unit build failed: " + compiled.stderr())


private func run_runtime_case(executable: String, name: String) -> Bool:
	match run_isolated(executable, [name]):
		Err(error):
			print_error(error)
			False
		Ok(result):
			if (
				result.exit_code() == 0
				and result.stdout() == ""
				and result.stderr() == ""
			):
				True
			else:
				print_error("record runtime case " + name + " exited " + result
						.exit_code()
						.to_string() + "; stdout=" + result.stdout() + "; stderr=" + result.stderr())
				False


private RECORD_CASES: List[RuntimeCase] = [
	{
		description = "fresh slot ownership transfers without child retain",
		name = "fresh_transfer"
	},
	{
		description = "record retain changes only the root count",
		name = "root_retain"
	},
	{
		description = "nonfinal release preserves root and child",
		name = "nonfinal_release"
	},
	{
		description = "final release frees both distinct children and root once",
		name = "final_release"
	},
	{
		description = "acquired String survives its record root",
		name = "independent_child"
	},
	{
		description = "repeated child pointers discharge both stored occurrences",
		name = "repeated_pointer"
	},
	{
		description = "nested acquired root survives final parent release",
		name = "nested_lifetime"
	},
	{
		description = "active owning union cleans only at final record release",
		name = "union_active"
	},
	{
		description = "inactive String union storage owns no child",
		name = "union_inactive"
	},
	{
		description = "acquired owning union survives its record root",
		name = "union_escape"
	},
	{
		description = "List field transfers root and destroys both children",
		name = "list_transfer"
	},
	{
		description = "record retain and nonfinal release preserve List children",
		name = "list_retain"
	},
	{
		description = "acquired List and owned lookup survive both parent roots",
		name = "list_escape"
	},
	{
		description = "empty List field destroys only its two roots",
		name = "list_empty"
	},
	{
		description = "Void field record frees its child-free root",
		name = "void_root"
	},
	{
		description = "Some Int field record frees its child-free root",
		name = "number_present"
	},
	{
		description = "None Int field record frees its child-free root",
		name = "number_absent"
	},
	{
		description = "union owning record payload preserves independent root",
		name = "record_union_escape"
	},
	{
		description = "inactive record union storage owns no record root",
		name = "record_union_inactive"
	},
	{
		description = "mixed numeric and String fields preserve values and cleanup",
		name = "mixed_scalars"
	},
]

private pure func runtime_suite(executable: String, cases: List[RuntimeCase]) -> TestSuite:
	callbacks = cases.map(pure func(expected: RuntimeCase):
		(
			expected.description,
			func(): run_runtime_case(executable, expected.name),
		)
	)
	{
		description = "Blorp 2 concrete aggregate runtime C unit invariants",
		tests = callbacks
	}


private func check_runtime(
	source: String,
	catalog: pure (VerifiedProgram) -> Bool,
	fixture: String,
	cases: List[RuntimeCase],
) -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-record-runtime-"):
		match build_runtime_tests(directory.resource_path(), source, catalog, fixture):
			Err(error):
				print_error(error)
				Ok(False)
			Ok(executable):
				result = run_suite_result(runtime_suite(executable, cases))
				Ok(result[1] == 0)


func runtime_passes(
	source: String,
	catalog: pure (VerifiedProgram) -> Bool,
	fixture: String,
	cases: List[RuntimeCase],
) -> Bool:
	match check_runtime(source, catalog, fixture, cases):
		Ok(passed):
			passed
		Err(error):
			print_error(error.to_string())
			False


func test_runtime() -> Bool:
	runtime_passes(
		RUNTIME_SOURCE, complete_runtime_catalog,
		"blorp_2/test/runtime/fixtures/record_test.c", RECORD_CASES,
	)


func test_generic_runtime() -> Bool:
	runtime_passes(
		GENERIC_RUNTIME_SOURCE, complete_runtime_catalog,
		"blorp_2/test/runtime/fixtures/record_test.c", RECORD_CASES,
	)


func test_direct_runtime() -> Bool:
	runtime_passes(
		DIRECT_RUNTIME_SOURCE, complete_runtime_catalog,
		"blorp_2/test/runtime/fixtures/record_test.c", RECORD_CASES,
	)


tests: TestSuite = {
	description = "Blorp 2 concrete record runtime",
	tests = [
		("nongeneric catalog and concrete runtime helpers", test_runtime),
		("generic catalog and concrete runtime helpers", test_generic_runtime),
		("direct payload catalog and concrete runtime helpers", test_direct_runtime),
	]
}
