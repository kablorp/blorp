import:
	../../src/utils/syntax: Entrypoint(WithArguments), EntryResult(IntegerExitStatus)
	../../src/verify/verify: VerifiedProgram, verified_contents
	./test_record: RuntimeCase, runtime_passes
	test: TestSuite


-- The argument entrypoint selects the production String List and argv helpers.
private RUNTIME_SOURCE: String =
	|func main(arguments: List[String]) -> Int:
	|    0
	|


private pure func argv_catalog(program: VerifiedProgram) -> Bool:
	contents = verified_contents(program)
	match contents.entrypoint:
		WithArguments(_, IntegerExitStatus):
			contents.records.length() == 0 and contents.unions.length() == 0
		_:
			False


private CASES: List[RuntimeCase] = [
	{ description = "valid argv preserves order, empty bytes and owned roots", name = "valid" },
	{ description = "empty native argv owns only its list root", name = "empty_argv" },
	{ description = "acquired noncharacter argument survives its list", name = "argv_escape" },
	{ description = "invalid executable bytes reject and destroy the list root", name = "invalid_first" },
	{ description = "invalid middle argument destroys its initialized prefix", name = "invalid_middle" },
	{ description = "invalid last argument destroys every acquired root", name = "invalid_last" },
	{ description = "argv rejects isolated continuations before publication", name = "argv_continuation" },
	{ description = "argv rejects truncated scalars before publication", name = "argv_truncated" },
	{ description = "argv rejects overlong scalars before publication", name = "argv_overlong" },
	{ description = "argv rejects surrogate scalars before publication", name = "argv_surrogate" },
	{ description = "argv rejects scalars above Unicode maximum", name = "argv_above_max" },
	{ description = "argv rejects a malformed suffix after valid UTF-8", name = "argv_bad_suffix" },
	{ description = "empty UTF-8 validates without allocation", name = "utf8_empty" },
	{ description = "all ASCII bytes including NUL validate unchanged", name = "utf8_ascii" },
	{ description = "multilingual UTF-8 validates unchanged", name = "utf8_multilingual" },
	{ description = "decomposed UTF-8 is valid without normalization", name = "utf8_decomposed" },
	{ description = "scalar encoding boundaries validate unchanged", name = "utf8_boundaries" },
	{ description = "Unicode noncharacters remain valid scalars", name = "utf8_noncharacters" },
	{ description = "unassigned Unicode scalar remains valid", name = "utf8_unassigned" },
	{ description = "counted NUL preserves validation of following bytes", name = "utf8_nul" },
	{ description = "malformed bytes after counted NUL are rejected", name = "utf8_after_nul" },
	{ description = "isolated continuation endpoints are rejected", name = "utf8_isolated" },
	{ description = "F5 through FF leads and former equality inputs reject", name = "utf8_forbidden_leads" },
	{ description = "C0 and C1 two-byte overlongs are rejected", name = "utf8_overlong_two" },
	{ description = "three-byte overlong encodings are rejected", name = "utf8_overlong_three" },
	{ description = "four-byte overlong encodings are rejected", name = "utf8_overlong_four" },
	{ description = "surrogate range endpoints are rejected", name = "utf8_surrogates" },
	{ description = "four-byte scalars above Unicode maximum reject", name = "utf8_above_max" },
	{ description = "two-byte truncation cannot read beyond input", name = "utf8_truncated_two" },
	{ description = "three-byte truncations cannot read beyond input", name = "utf8_truncated_three" },
	{ description = "four-byte truncations cannot read beyond input", name = "utf8_truncated_four" },
	{ description = "bad continuation bytes at every position reject", name = "utf8_continuations" },
	{ description = "valid scalar prefix does not hide a bad suffix", name = "utf8_bad_suffix" },
]


private func test_argv_runtime() -> Bool:
	runtime_passes(
		RUNTIME_SOURCE, argv_catalog,
		"blorp_2/test/runtime/fixtures/argv_test.c", CASES,
	)


tests: TestSuite = {
	description = "Blorp 2 native argv admission",
	tests = [("production argv helper validates before String publication", test_argv_runtime)]
}
