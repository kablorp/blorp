import:
	../../src/specialize/specialize as Concrete
	../../src/verify/verify: VerifiedProgram, verified_contents
	./test_record: RuntimeCase, runtime_passes
	test: TestSuite


-- Reachable constructors establish both boxed layout authorities: Nat is
-- union 0 and Trail, with a String beside its self child, is union 1.
private RUNTIME_SOURCE: String =
	|fixed union Nat:
	|    Zero
	|    Succ(Nat)
	|fixed union Trail:
	|    End
	|    Step(String, Trail)
	|pure func make() -> Nat:
	|    Succ(Zero)
	|pure func text(value: Int) -> String:
	|    builtin("int.to_string")
	|pure func trail() -> Trail:
	|    Step(text(7), End)
	|func main() -> Int:
	|    unused = make()
	|    other = trail()
	|    0
	|


private pure func boxed_catalog(program: VerifiedProgram) -> Bool:
	contents = verified_contents(program)
	match (contents.records, contents.unions):
		([], [nat, trail]):
			match (nat, Concrete.union_variants(nat), trail, Concrete.union_variants(trail)):
				(Concrete.BoxedCases(_), [[], [Concrete.UnionType(self)]], Concrete.BoxedCases(_), [[], [Concrete.StringType, Concrete.UnionType(other)]]):
					Concrete.union_number(self) == 0 and Concrete.union_number(other) == 1
				_: False
		_: False


private CASES: List[RuntimeCase] = [
	{
		description = "a leaf is one counted node freed by its final release",
		name = "leaf_release"
	},
	{
		description = "final release of a root frees every node of its chain once",
		name = "chain_release"
	},
	{
		description = "nonfinal release keeps the chain and retains no child again",
		name = "nonfinal_release"
	},
	{
		description = "a retained middle node stops the walk and releases its tail later",
		name = "shared_tail"
	},
	{
		description = "two roots over one tail free the tail with the last root",
		name = "two_roots_one_tail"
	},
	{
		description = "a 100,000-deep chain releases on a 512 KiB stack",
		name = "deep_release"
	},
	{
		description = "a String beside the self child is released with its node",
		name = "sibling_release"
	},
	{
		description = "a retained node keeps its String and its tail until its own release",
		name = "sibling_shared_tail"
	},
]


func test_runtime() -> Bool:
	runtime_passes(
		RUNTIME_SOURCE, boxed_catalog,
		"blorp_2/test/runtime/fixtures/recursive_union_test.c", CASES,
	)


tests: TestSuite = {
	description = "Blorp 2 boxed recursive union runtime",
	tests = [("boxed Nat and Trail catalog and bounded-stack release helpers", test_runtime)]
}
