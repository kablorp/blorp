#!/bin/bash
# Measure where Blorp 2's self-compile spends reference counts, copies and allocations.
#
# Usage: blorp_2/scripts/attribution/run [--output DIRECTORY] [--stage STAGE]... [--top N]
#
# DIRECTORY defaults to build/blorp_2_attribution in the repository, which git ignores:
# the raw samples are kept only there, are not committed, and are regenerated by this
# command. A rerun of a stage replaces that stage's files.
#
# Bash, not compare-compilers' zsh: nothing here needs zsh, and macOS's stock bash 3.2
# runs it.
#
# The input is this checkout's blorp_2/src. B is `make -C blorp_2 compiler`; "self C" is
# the C that B writes for blorp_2/src, and every measured program is built from it.
# Stages, in order (default: all; each later stage needs the files of `build`):
#   build        B, its self C, provenance
#   markers      a marker compiler (scratch patch of emit) and the proof that its output,
#                with markers stripped, is byte-identical to B's
#   copies       List and String update copies by Blorp function and C statement
#   rc           atomic reference-count operations by kind and by source
#   allocations  allocations by data kind and site (BLORP_ALLOCATION_SITES)
#   profile      a -O2 -g self-compile under `sample`
#   timing       best-of-5 cycles, atomic against plain reference counts
#   report       markdown tables for every stage that ran, in OUTPUT/tables/
# Everything runs serially. The one concurrent process is `sample` watching the single
# profiled self-compile in `profile`. macOS and Apple clang only. The scratch patches
# apply to copies under OUTPUT; nothing in blorp_2/src or the repository changes.
# Expect 6 to 9 minutes on an Apple M4, depending on the machine's load, which is recorded.
set -euo pipefail
export LC_ALL=C

HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/../../.." && pwd)
LIBRARY=$ROOT/blorp_2/standard_library
SOURCE=$ROOT/blorp_2/src
B=$ROOT/blorp_2/build/compiler
OUT=$ROOT/build/blorp_2_attribution
TOP=20
STAGES=()
ALL_STAGES=(build markers copies rc allocations profile timing report)
TIMING_SAMPLES=5

die() { echo "error: attribution: $*" >&2; exit 2; }

while [ $# -gt 0 ]; do
    case $1 in
        --output) [ $# -ge 2 ] || die "missing value for --output"; OUT=$2; shift 2 ;;
        --stage) [ $# -ge 2 ] || die "missing value for --stage"; STAGES+=("$2"); shift 2 ;;
        --top) [ $# -ge 2 ] || die "missing value for --top"; TOP=$2; shift 2 ;;
        --help|-h) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done
[ "$(uname -s)" = Darwin ] || die "this script needs macOS (atos, sample, /usr/bin/time -l)"
[ ${#STAGES[@]} -gt 0 ] || STAGES=("${ALL_STAGES[@]}")
for stage in "${STAGES[@]}"; do
    case " ${ALL_STAGES[*]} " in *" $stage "*) ;; *) die "unknown stage: $stage" ;; esac
done
mkdir -p "$OUT"
OUT=$(cd "$OUT" && pwd)

# Stage timing: begin NAME ... finish NAME; seconds go to OUTPUT/stage_seconds.txt.
begin() { echo "== $1"; STAGE_START=$SECONDS; }
finish() {
    { grep -v "^$1 " "$OUT/stage_seconds.txt" 2> /dev/null || true; echo "$1 $((SECONDS - STAGE_START))"; } > "$OUT/stage_seconds.new"
    mv "$OUT/stage_seconds.new" "$OUT/stage_seconds.txt"
}
wants() { case " ${STAGES[*]} " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
sha() { shasum -a 256 "$1" | cut -d' ' -f1; }
load() { sysctl -n vm.loadavg | tr -d '{}' | awk '{print $1","$2","$3}'; }
need() { [ -e "$1" ] || die "missing $1; run the earlier stage first"; }
# clang with the flags every program built from the self C shares (the generated C is not
# warning-clean, so warnings are off).
build_c() { clang -w "$@" -lm -lpthread; }
# Run a compiler under test on blorp_2/src; callers compare its output with B's self C.
compile_self() {
    local program=$1 output=$2
    "$program" --library-root "$LIBRARY" "$SOURCE/main.brp" "$output"
}

if wants build; then
    begin build
    make -C "$ROOT/blorp_2" compiler
    "$B" --library-root "$LIBRARY" "$SOURCE/main.brp" "$OUT/self.c"
    {
        echo "commit        $(git -C "$ROOT" rev-parse HEAD)"
        echo "src status    $(git -C "$ROOT" status --porcelain -- blorp_2/src | wc -l | tr -d ' ') changed files"
        echo "B             $(sha "$B")"
        echo "B C           $(sha "$ROOT/blorp_2/build/compiler.c")"
        echo "self C        $(sha "$OUT/self.c")"
        echo "clang         $(clang --version | head -1)"
        echo "machine       $(sysctl -n machdep.cpu.brand_string), $(sw_vers -productName) $(sw_vers -productVersion)"
        echo "load average  $(load)"
    } | tee "$OUT/provenance.txt"
    finish build
fi

if wants markers; then
    begin markers
    need "$OUT/self.c"
    rm -rf "$OUT/markers" && mkdir -p "$OUT/markers"
    cp -R "$SOURCE" "$OUT/markers/src"
    python3 -I "$HERE/patch_emit_markers.py" "$OUT/markers/src"
    "$B" --library-root "$LIBRARY" "$OUT/markers/src/main.brp" "$OUT/markers/compiler.c"
    build_c -O2 "$OUT/markers/compiler.c" -o "$OUT/markers/compiler"
    compile_self "$OUT/markers/compiler" "$OUT/markers/marked.c"
    sed 's#/\*RC:[^*]*\*/##g' "$OUT/markers/marked.c" > "$OUT/markers/stripped.c"
    {
        echo "normal self C    $(sha "$OUT/self.c")"
        echo "marked self C    $(sha "$OUT/markers/marked.c")"
        echo "marked, stripped $(sha "$OUT/markers/stripped.c")"
    } | tee "$OUT/markers/identity.txt"
    cmp "$OUT/self.c" "$OUT/markers/stripped.c" || die "stripped marker output differs from B's self C"
    echo "marker output, stripped, is byte-identical to B's"
    finish markers
fi

if wants copies; then
    begin copies
    need "$OUT/self.c"
    rm -rf "$OUT/copies" && mkdir -p "$OUT/copies"
    python3 -I "$HERE/instrument_copies.py" "$OUT/self.c" "$OUT/copies/statements.c"
    # No inlining and no tail calls: a helper's return address is then the statement
    # that called it, not a caller's caller.
    clang -c -O2 -g -fno-inline -fno-optimize-sibling-calls -fno-omit-frame-pointer \
        -DBLORP_MEMORY_DIAGNOSTICS=1 -w "$OUT/copies/statements.c" -o "$OUT/copies/binary.o"
    clang "$OUT/copies/binary.o" -o "$OUT/copies/binary" -lm -lpthread
    dsymutil "$OUT/copies/binary"
    BLORP_LEAK_CHECK=strict BLORP_PROF_OUT="$OUT/copies/prof.tsv" \
        compile_self "$OUT/copies/binary" "$OUT/copies/output.c"
    cmp "$OUT/self.c" "$OUT/copies/output.c" || die "copy-instrumented compiler wrote different C"
    finish copies
fi

if wants rc; then
    begin rc
    need "$OUT/self.c"; need "$OUT/markers/marked.c"
    rm -rf "$OUT/rc" && mkdir -p "$OUT/rc"
    python3 -I "$HERE/instrument_rc.py" --kinds "$OUT/self.c" "$OUT/rc/kinds.c"
    python3 -I "$HERE/instrument_rc.py" --tagged "$OUT/markers/marked.c" "$OUT/rc/tagged.c" "$OUT/rc/categories.tsv"
    build_c -O2 "$OUT/rc/kinds.c" -o "$OUT/rc/kinds"
    build_c -O2 "$OUT/rc/tagged.c" -o "$OUT/rc/tagged"
    BLORP_RC_OUT="$OUT/rc/kinds.tsv" compile_self "$OUT/rc/kinds" "$OUT/rc/kinds_output.c"
    cmp "$OUT/self.c" "$OUT/rc/kinds_output.c" || die "kind-counting compiler wrote different C"
    BLORP_RC_OUT="$OUT/rc/tagged.tsv" compile_self "$OUT/rc/tagged" "$OUT/rc/tagged_output.c"
    cmp "$OUT/self.c" "$OUT/rc/tagged_output.c" || die "tag-counting compiler wrote different C"
    finish rc
fi

if wants allocations; then
    begin allocations
    need "$OUT/self.c"
    rm -rf "$OUT/allocations" && mkdir -p "$OUT/allocations"
    clang -O0 -g -fno-omit-frame-pointer -DBLORP_MEMORY_DIAGNOSTICS=1 -w "$OUT/self.c" \
        -o "$OUT/allocations/binary" -lm -lpthread
    BLORP_ALLOCATION_SITES="$OUT/allocations/report.txt" BLORP_LEAK_CHECK=strict \
        compile_self "$OUT/allocations/binary" "$OUT/allocations/output.c" 2>&1 | tee "$OUT/allocations/leak_check.txt"
    cmp "$OUT/self.c" "$OUT/allocations/output.c" || die "diagnostic compiler wrote different C"
    "$ROOT/blorp_2/scripts/allocation-sites" "$OUT/allocations/report.txt" "$OUT/allocations/binary" \
        "$OUT/self.c" --top 1000000 > "$OUT/allocations/sites.txt"
    finish allocations
fi

if wants profile; then
    begin profile
    need "$OUT/self.c"
    rm -rf "$OUT/profile" && mkdir -p "$OUT/profile"
    clang -O2 -g -fno-omit-frame-pointer -w "$OUT/self.c" -o "$OUT/profile/binary" -lm -lpthread
    /usr/bin/time -l "$OUT/profile/binary" --library-root "$LIBRARY" "$SOURCE/main.brp" "$OUT/profile/timed.c" \
        2> "$OUT/profile/time.txt"
    cmp "$OUT/self.c" "$OUT/profile/timed.c" || die "profiled compiler wrote different C"
    # sample needs the process id of a running program: this is the only concurrency.
    "$OUT/profile/binary" --library-root "$LIBRARY" "$SOURCE/main.brp" "$OUT/profile/sampled.c" &
    sampled=$!
    sample "$sampled" 600 1 -mayDie -file "$OUT/profile/sample.txt" > /dev/null 2>&1 || true
    wait "$sampled"
    [ -s "$OUT/profile/sample.txt" ] || die "sample wrote no profile"
    cmp "$OUT/self.c" "$OUT/profile/sampled.c" || die "sampled compiler wrote different C"
    finish profile
fi

if wants timing; then
    begin timing
    need "$OUT/self.c"
    rm -rf "$OUT/timing" && mkdir -p "$OUT/timing"
    # Plain counts: every atomic read-modify-write on a reference count becomes a relaxed
    # load and store (what a single-threaded runtime would do). Orders are dropped with it.
    {
        echo '#include <stdatomic.h>'
        echo '#define blorp_plain_fetch_add_explicit(p,v,order) ({ __typeof__(__c11_atomic_load((p),__ATOMIC_RELAXED)) blorp_old=__c11_atomic_load((p),__ATOMIC_RELAXED); __c11_atomic_store((p),blorp_old+(v),__ATOMIC_RELAXED); blorp_old; })'
        echo '#define blorp_plain_fetch_sub_explicit(p,v,order) ({ __typeof__(__c11_atomic_load((p),__ATOMIC_RELAXED)) blorp_old=__c11_atomic_load((p),__ATOMIC_RELAXED); __c11_atomic_store((p),blorp_old-(v),__ATOMIC_RELAXED); blorp_old; })'
        sed -e 's/atomic_fetch_add_explicit(/blorp_plain_fetch_add_explicit(/g' \
            -e 's/atomic_fetch_sub_explicit(/blorp_plain_fetch_sub_explicit(/g' "$OUT/self.c"
    } > "$OUT/timing/plain.c"
    build_c -O2 "$OUT/self.c" -o "$OUT/timing/atomic"
    build_c -O2 "$OUT/timing/plain.c" -o "$OUT/timing/plain"
    # The atomic build must contain arm64 atomic read-modify-write instructions and the plain
    # build none; otherwise the comparison measures nothing.
    for build in atomic plain; do
        count=$(objdump -d --no-show-raw-insn "$OUT/timing/$build" \
            | grep -c -E '[[:space:]](ldadd|ldaddal|ldadda|ldaddl|swp|swpal|cas|casal)[[:space:]]' || true)
        echo "$build read-modify-write instructions: $count" | tee -a "$OUT/timing/instructions.txt"
        if [ "$build" = atomic ] && [ "$count" -eq 0 ]; then die "the atomic build has no atomic instructions (no LSE?)"; fi
        if [ "$build" = plain ] && [ "$count" -ne 0 ]; then die "the plain build still has $count atomic instructions"; fi
    done
    : > "$OUT/timing/runs.tsv"
    for sample_number in $(seq 1 $TIMING_SAMPLES); do
        # Alternate the order so drift in the machine's load does not favour one build.
        if [ $((sample_number % 2)) -eq 1 ]; then order="atomic plain"; else order="plain atomic"; fi
        for build in $order; do
            before=$(load)
            /usr/bin/time -l "$OUT/timing/$build" --library-root "$LIBRARY" "$SOURCE/main.brp" "$OUT/timing/$build.out.c" \
                2> "$OUT/timing/time_$build.txt"
            cmp "$OUT/self.c" "$OUT/timing/$build.out.c" || die "$build compiler wrote different C"
            awk -v build="$build" -v n="$sample_number" -v load="$before" '
                / real / { for (i = 1; i <= NF; i++) { if ($i == "user") u = $(i-1); if ($i == "sys") s = $(i-1) } }
                /instructions retired/ { instructions = $1 }
                /cycles elapsed/ { cycles = $1 }
                END { printf "%s\t%d\t%s\t%.3f\t%d\t%d\n", build, n, load, u + s, cycles, instructions }' \
                "$OUT/timing/time_$build.txt" >> "$OUT/timing/runs.tsv"
        done
    done
    finish timing
fi

if wants report; then
    begin report
    mkdir -p "$OUT/tables"
    for stage in copies rc allocations profile timing; do
        if [ -e "$OUT/$stage" ]; then
            top=$TOP
            [ "$stage" != profile ] || top=15
            python3 -I "$HERE/report.py" "$stage" "$OUT" --top "$top" > "$OUT/tables/$stage.md"
            echo "wrote $OUT/tables/$stage.md"
        fi
    done
    finish report
fi
echo "done: $OUT"
