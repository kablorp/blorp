-- Pure logical paths; only ASCII '/' is a separator.
import:
    _base: Int, String, Bool(True, False), Option(Some, None)
    int as IntOps
    string as TextOps

private PATH_SEPARATOR_BYTE: Int = 47

private pure func is_separator(path: String, position: Int) -> Bool:
    match TextOps.byte_at(path, position):
        Some(byte): IntOps.equals(byte, PATH_SEPARATOR_BYTE)
        None: False

-- Empty children add or preserve the separator used by library-prefix checks.
-- Components and separator runs are preserved without normalization.
pure func join(base: String, child: String) -> String:
    match is_separator(child, 0):
        True:
            child
        False:
            base_length = TextOps.length(base)
            match IntOps.equals(base_length, 0):
                True:
                    child
                False:
                    match is_separator(base, IntOps.subtract(base_length, 1)):
                        True:
                            TextOps.add(base, child)
                        False:
                            TextOps.add(TextOps.add(base, "/"), child)
