-- Temporary target adaptation of standard_library/src/float.brp.
-- Upstream revision: 2f5795cc750200a97115dfe5a637f5c4e6e47ddb
-- Upstream SHA256: 234b1d2ee47b741c4cb78199c72cf0620ce482f6ece06e6c53557124f2875506
-- Upstream reference: ../reference/standard_library/float.brp
-- Float is owned by _base.brp. Only concrete arithmetic and formatting are active.
-- Zero divisors return positive zero under the pilot's parent arithmetic principle;
-- this deliberately differs from the referenced upstream IEEE behavior.
import:
    _base: Float, String

pure func add(first: Float, second: Float) -> Float:
    builtin("float.add")

pure func subtract(first: Float, second: Float) -> Float:
    builtin("float.subtract")

pure func multiply(first: Float, second: Float) -> Float:
    builtin("float.multiply")

pure func divide(first: Float, second: Float) -> Float:
    builtin("float.divide")

pure func remainder(first: Float, second: Float) -> Float:
    builtin("float.remainder")

pure func to_string(value: Float) -> String:
    builtin("float.to_string")
