-- The configured foundation owns primitive identities and ordinary base unions.
type Int = builtin
type Float = builtin
type String = builtin
type Void = builtin
type List[T] = builtin

fixed union Bool:
    True
    False

fixed union Option[A]:
    Some(A)
    None

fixed union Result[Value, Error]:
    Ok(Value)
    Err(Error)

-- Set, Dict, and other foundational declarations remain deferred.
