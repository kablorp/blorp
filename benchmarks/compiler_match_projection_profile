#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation="${1:-plain}"

case "$instrumentation" in
	plain|profile)
		shift || true
		;;
	*)
		echo "usage: benchmarks/compiler_match_projection_profile plain|profile [iterations] [declarations] [matches] [variants_per_union] [accessor_depth] [generic_arguments] [target_union_index] [target_variant_index]" >&2
		exit 2
		;;
esac

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-match-projection-profile \
	blorp/benchmark/compiler/compiler_match_projection_profile.brp \
	"$instrumentation" \
	"$@"
