#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation=plain

if [ "${BLORP_ENV_SYMBOLS_NAMED_PROFILE_FUNCTIONS:-0}" = "1" ]; then
	instrumentation=profile
fi

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-env-symbols-named-profile \
	blorp/benchmark/compiler/compiler_env_symbols_named_profile.brp \
	"$instrumentation" \
	"$@"
