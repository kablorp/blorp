#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation=plain

if [ "${BLORP_IMPORT_GRAPH_PROFILE_FUNCTIONS:-0}" = "1" ]; then
	instrumentation=profile
fi

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-import-graph-profile \
	compiler/benchmarks/compiler_import_graph_profile.brp \
	"$instrumentation" \
	"$@"
