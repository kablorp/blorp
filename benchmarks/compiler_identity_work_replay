#!/usr/bin/env python3
"""Build a disposable exact-profile compiler worker using the shared helper."""

from pathlib import Path
import sys

from compiler_benchmark_worker import prepare_benchmark_worker


ROOT = Path(__file__).resolve().parent.parent
INCLUDE_DIRS = (
    Path("blorp/src/compiler/stage_04_modules"),
    Path("blorp/src/compiler/stage_06_typecheck/graph"),
    Path("blorp/src/compiler/stage_06_typecheck/type_system"),
    Path("blorp/src/lib"),
    Path("blorp/src/lsp/server"),
    Path("blorp/src/test"),
)
PROFILE_FUNCTIONS = tuple(
    "blorp/src/compiler/identity_work_counters::" + name
    for name in (
        "identity_work_core_var_equal",
        "identity_work_local_scope_lookup",
        "identity_work_observed_core_var_constructor_helper_calls",
        "identity_work_observed_display_lookup",
        "register_identity_work_counters",
    )
)


def main() -> int:
    if len(sys.argv) != 2:
        raise ValueError("usage: compiler_identity_work_replay OUTPUT_DIR")
    worker = prepare_benchmark_worker(
        ROOT,
        Path(sys.argv[1]).resolve(),
        None,
        env_name="BLORP_IDENTITY_WORK_REPLAY_WORKER",
        source_path=Path("blorp/benchmark/compiler/compiler_identity_work_replay.brp"),
        worker_name="compiler_identity_work_replay",
        main_symbol="__blorp_identity_work_replay_main",
        include_dirs=INCLUDE_DIRS,
        # Importing CLI main pulls in LSP native hooks; only this replay needs
        # their C implementation at link time.
        link_sources=(Path("blorp/src/lsp/server/native_runtime.c"),),
        debug_profile=True,
        profile_functions=PROFILE_FUNCTIONS,
        profile_mode="calls",
    )
    print(worker)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
