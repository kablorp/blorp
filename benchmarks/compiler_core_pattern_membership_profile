#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation="${1:-plain}"

case "$instrumentation" in
	plain|profile)
		shift || true
		;;
	*)
		echo "usage: benchmarks/compiler_core_pattern_membership_profile plain|profile match|closure early|late|miss [iterations] [width] [cases]" >&2
		exit 2
		;;
esac

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-core-pattern-membership-profile \
	blorp/benchmark/compiler/compiler_core_pattern_membership_profile.brp \
	"$instrumentation" \
	"$@"
