-- One shape per process. Run with --memory-stats, and inspect emitted C.
import:
	authority:
		control_consumer_run, control_run, nested_control_run, nested_receipt_run, owner_checksum,
		program_run, receipt_run, shared_control_run, shared_receipt_run,
		raw_run, raw_nested_run, raw_shared_run,
	memory: MemoryCounter(ManagedAllocations, ManagedReleases, MemoryStatsActive), read_memory_counter

pure func workload(shape: String, count: Int) -> Int:
	match shape:
		"raw": raw_run(count)
		"raw-nested": raw_nested_run(count)
		"raw-shared": raw_shared_run(count)
		"control": owner_checksum(control_run(count))
		"control-consumer": owner_checksum(control_consumer_run(count))
		"receipt": owner_checksum(receipt_run(count))
		"program": owner_checksum(program_run(count))
		"nested-control": owner_checksum(nested_control_run(count))
		"nested-receipt": owner_checksum(nested_receipt_run(count))
		"shared-control": shared_control_run(count)
		"shared-receipt": shared_receipt_run(count)
		_: -1

func main(args: List[String]) -> Int:
	shape = args.get(1).get_or("")
	count = args.get(2).get_or("0").parse_int().get_or(0)
	active = read_memory_counter(MemoryStatsActive)
	allocations_before = read_memory_counter(ManagedAllocations)
	releases_before = read_memory_counter(ManagedReleases)
	checksum = workload(shape, count)
	allocations_after = read_memory_counter(ManagedAllocations)
	releases_after = read_memory_counter(ManagedReleases)
	print("${shape} count=${count} checksum=${checksum} active=${active} allocations=${allocations_after - allocations_before} releases=${releases_after - releases_before}")
	if active == 1 and checksum != -1:
		0
	else:
		2
