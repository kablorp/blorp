#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation=plain

if [ "${BLORP_MODULE_BINDING_PROFILE_FUNCTIONS:-0}" = "1" ]; then
	instrumentation=profile
fi

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-module-binding-profile \
	compiler/blorp/benchmarks/compiler_module_binding_profile.brp \
	"$instrumentation" \
	"$@"
