#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

: "${BLORP_COMPILER_BENCHMARK_SKIP_BUILD:=1}"
export BLORP_COMPILER_BENCHMARK_SKIP_BUILD

if [ -z "${BLORP_COMPILER_BENCHMARK_COMPILER:-}" ]; then
	BLORP_COMPILER_BENCHMARK_COMPILER=$("$repo_root/scripts/blorp-compiler-bootstrap" --print-path)
	export BLORP_COMPILER_BENCHMARK_COMPILER
fi

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-mono-data-alias-profile \
	"$repo_root/blorp/benchmark/compiler/compiler_mono_data_alias_profile.brp" \
	plain \
	"$@"
