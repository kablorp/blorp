import:
	io: print


-- Compiler-shaped AST pass benchmark.
-- Models repeated recursive IR rewrites over immutable tree nodes.
-- A record carries each node because direct recursive unions allow one child.
record Expr { form: Form }


union Form:
	ELit(Int)
	EVar(Int)
	EAdd(Expr, Expr)
	EMul(Expr, Expr)
	ELet(Int, Expr, Expr)
	EIf(Expr, Expr, Expr)


pure func build_expr(depth: Int, seed: Int) -> Expr:
	if depth.less_than_or_equal(0):
		if seed.remainder(3).equals(0):
			{ form = EVar(seed.remainder(4096)) }
		else:
			{ form = ELit(seed.multiply(17).add(11).remainder(100000)) }
	else:
		next: Int = seed.multiply(3).add(depth)
		kind: Int = depth.remainder(5)

		if kind.equals(0):
			{ form = EAdd(
				build_expr(depth.subtract(1), next),
				build_expr(depth.subtract(1), next.add(1)),
			) }
		else if kind.equals(1):
			{ form = EMul(
				build_expr(depth.subtract(1), next),
				build_expr(depth.subtract(1), next.add(3)),
			) }
		else if kind.equals(2):
			{ form = ELet(
				seed.remainder(8192),
				build_expr(depth.subtract(1), next),
				build_expr(depth.subtract(1), next.add(5)),
			) }
		else if kind.equals(3):
			{ form = EIf(
				build_expr(depth.subtract(1), next),
				build_expr(depth.subtract(2), next.add(7)),
				build_expr(depth.subtract(2), next.add(11)),
			) }
		else:
			{ form = EAdd(
				build_expr(depth.subtract(1), next.add(13)),
				build_expr(depth.subtract(1), next.add(17)),
			) }


pure func rewrite_expr(expr: Expr, pass: Int) -> Expr:
	match expr.form:
		ELit(value):
			{ form = ELit(value.add(pass.multiply(13)).add(7).remainder(1000003)) }
		EVar(id):
			{ form = EVar(id.multiply(33).add(pass).add(19).remainder(16384)) }
		EAdd(left, right):
			if pass.remainder(7).equals(0):
				{ form = EAdd(
					rewrite_expr(right, pass),
					rewrite_expr(left, pass),
				) }
			else:
				{ form = EAdd(
					rewrite_expr(left, pass),
					rewrite_expr(right, pass),
				) }
		EMul(left, right):
			{ form = EMul(
				rewrite_expr(left, pass),
				rewrite_expr(right, pass),
			) }
		ELet(name, value, body):
			{ form = ELet(
				name.add(pass).remainder(16384),
				rewrite_expr(value, pass),
				rewrite_expr(body, pass.add(1)),
			) }
		EIf(cond, then_expr, else_expr):
			{ form = EIf(
				rewrite_expr(cond, pass),
				rewrite_expr(then_expr, pass.add(2)),
				rewrite_expr(else_expr, pass.add(3)),
			) }


pure func checksum_expr(expr: Expr) -> Int:
	match expr.form:
		ELit(value):
			value.add(3)
		EVar(id):
			id.multiply(5).add(7)
		EAdd(left, right):
			11.add(checksum_expr(left).multiply(3)).add(checksum_expr(right))
		EMul(left, right):
			17.add(checksum_expr(left)).add(checksum_expr(right).multiply(3))
		ELet(name, value, body):
			23.add(name).add(checksum_expr(value)).add(checksum_expr(body).multiply(5))
		EIf(cond, then_expr, else_expr):
			31.add(checksum_expr(cond)).add(checksum_expr(then_expr).multiply(7))
				.add(checksum_expr(else_expr))


func run_pipeline(depth: Int, passes: Int) -> Int:
	var expr: Expr = build_expr(depth, 19)
	var checksum: Int = 0

	for pass in 0..passes:
		expr = rewrite_expr(expr, pass)

		if pass.remainder(8).equals(0):
			checksum = checksum.add(checksum_expr(expr))

	checksum.add(checksum_expr(expr))


func main(args: List[String]) -> Int:
	checksum: Int = run_pipeline(11, 80)
	print("compiler_ast checksum: ".add(checksum.to_string()))
	0
