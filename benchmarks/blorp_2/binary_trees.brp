import:
	int: max
	io: print
	option: get_or
	string: parse_int


-- Binary Trees benchmark from the Computer Language Benchmarks Game.
-- Builds and checks complete trees to stress allocation and deallocation.
-- A record carries each node because direct recursive unions allow one child.
fixed record Tree { form: TreeForm }


union TreeForm:
	Leaf(Int)
	Node(Tree, Tree)


func make_with_value(depth: Int, value: Int) -> Tree:
	if depth.equals(0):
		{ form = Leaf(value) }
	else:
		next: Int = value.multiply(2)
		{ form = Node(
			make_with_value(depth.subtract(1), next),
			make_with_value(depth.subtract(1), next.add(1)),
		) }


func make(depth: Int) -> Tree:
	make_with_value(depth, 1)


-- Check tree contents: Leaf = payload, Node = 1 + left + right.
pure func check(tree: Tree) -> Int:
	match tree.form:
		Leaf(value):
			value
		Node(left, right):
			1.add(check(left)).add(check(right))


pure func power_of_two(n: Int) -> Int:
	var result: Int = 1
	var i: Int = 0

	while i.less_than(n):
		result = result.multiply(2)
		i = i.add(1)

	result


func parse_n(args: List[String]) -> Option[Int]:
	match args.get(1):
		None:
			None
		Some(value):
			parse_int(value)


func main(args: List[String]) -> Int:
	-- N defaults to 10; min_depth stays 4 as in the canonical benchmark.
	min_depth: Int = 4
	parsed_n: Option[Int] = parse_n(args)
	n: Int = parsed_n.get_or(10)
	max_depth: Int = max(n, min_depth.add(2))
	stretch_depth: Int = max_depth.add(1)

	stretch_tree: Tree = make(stretch_depth)
	print(
		"stretch tree of depth ".add(stretch_depth.to_string())
			.add(" check: ").add(check(stretch_tree).to_string()),
	)

	long_lived_tree: Tree = make(max_depth)
	var d: Int = min_depth

	while d.less_than_or_equal(max_depth):
		iterations: Int = power_of_two(max_depth.subtract(d).add(min_depth))
		var total_check: Int = 0

		for i in 0..iterations:
			tree: Tree = make(d)
			total_check = total_check.add(check(tree))

		print(
			iterations.to_string().add(" trees of depth ").add(d.to_string())
				.add(" check: ").add(total_check.to_string()),
		)
		d = d.add(2)

	print(
		"long lived tree of depth ".add(max_depth.to_string())
			.add(" check: ").add(check(long_lived_tree).to_string()),
	)
	0
