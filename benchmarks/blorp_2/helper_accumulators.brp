import:
	io: print
	list: repeat
	string: parse_int


-- Accumulators threaded through helper functions. Each mode performs `count`
-- updates through a helper that receives the accumulator as a parameter; a
-- borrowed parameter copies the whole accumulator on every call, making the
-- work quadratic in `count`, while an owned one keeps it linear. `none` is the
-- process-startup control. Usage: helper_accumulators <mode> <count>.
pure func push(values: List[Int], value: Int) -> List[Int]:
	values.append(value)


pure func list_helper(count: Int) -> Int:
	var values: List[Int] = []
	for index in 0..count:
		values = push(values, index)
	values.length()


pure func emit_digit(output: String, value: Int) -> String:
	output.append_int(value.remainder(10))


pure func string_helper(count: Int) -> Int:
	var output = ""
	for index in 0..count:
		output = emit_digit(output, index)
	output.length()


-- `set` through a helper on a fixed-size table, as `with_bucket_entry` does.
pure func bump(table: List[Int], index: Int) -> List[Int]:
	match table.get(index):
		Some(value): table.set(index, value.add(1))
		None: table


pure func set_helper(count: Int) -> Int:
	var table: List[Int] = repeat(0, count)
	for index in 0..count:
		table = bump(table, index)
	table.length()


pure func run(mode: String, count: Int) -> Option[Int]:
	match mode:
		"list_helper": Some(list_helper(count))
		"string_helper": Some(string_helper(count))
		"set_helper": Some(set_helper(count))
		"none": Some(0)
		_: None


func main(args: List[String]) -> Int:
	mode = args.get_or(1, "")
	selected = match parse_int(args.get_or(2, "")):
		Some(count): run(mode, count)
		None: None
	match selected:
		Some(length):
			print(length.to_string())
			0
		None:
			print("usage: helper_accumulators list_helper|string_helper|set_helper|none <count>")
			2
