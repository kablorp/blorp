import:
	io: print


-- Same inputs and work counts as benchmarks/blorp/list_ops.brp.
func make_shuffled(n: Int) -> List[Int]:
	var values: List[Int] = []

	for i in 0..n:
		value = i.multiply(1103515245).add(12345).remainder(n)
		values = values.append(value)

	values


func bench_append(n: Int, iters: Int) -> Int:
	var checksum = 0

	for _ in 0..iters:
		var values: List[Int] = []

		for i in 0..n:
			values = values.append(i)

		checksum = checksum.add(values.length())

	checksum


func bench_sort(shuffled: List[Int], iters: Int) -> Int:
	var checksum = 0

	for _ in 0..iters:
		-- The target library offers stable sort_by with Int keys, not sort.
		sorted = shuffled.sort_by(pure func(value: Int) -> Int: value)
		first = sorted.get_or(0, 0)
		middle = sorted.get_or(sorted.length().divide(2), 0)
		last = sorted.get_or(sorted.length().subtract(1), 0)
		checksum = checksum.add(sorted.length().add(first).add(middle).add(last))

	checksum


func bench_filter(values: List[Int], iters: Int) -> Int:
	var checksum = 0

	for _ in 0..iters:
		evens = values.filter(pure func(value: Int) -> Bool: value.remainder(2).equals(0))
		checksum = checksum.add(evens.length())

	checksum


func bench_fold(values: List[Int], iters: Int) -> Int:
	var checksum = 0

	for _ in 0..iters:
		-- No target fold_left: preserve the same left-to-right summation.
		var total = 0
		for value in values:
			total = total.add(value)
		checksum = checksum.add(total)

	checksum


func bench_reverse(values: List[Int], iters: Int) -> Int:
	var checksum = 0

	for _ in 0..iters:
		reversed = values.reverse()
		checksum = checksum.add(reversed.length())

	checksum


func bench_concat(left: List[Int], right: List[Int], iters: Int) -> Int:
	var checksum = 0

	for _ in 0..iters:
		combined = left.concat(right)
		checksum = checksum.add(combined.length())

	checksum


func main(args: List[String]) -> Int:
	n = 10000
	append_check = bench_append(n, 500)
	print("append checksum: ".add(append_check.to_string()))
	shuffled = make_shuffled(n)

	sort_check = bench_sort(shuffled, 200)
	print("sort checksum: ".add(sort_check.to_string()))

	-- Build a sequential list for filter/fold/reverse.
	var sequential: List[Int] = []
	for i in 0..n:
		sequential = sequential.append(i)

	filter_check = bench_filter(sequential, 500)
	print("filter checksum: ".add(filter_check.to_string()))
	fold_check = bench_fold(sequential, 2000)
	print("fold checksum: ".add(fold_check.to_string()))
	reverse_check = bench_reverse(sequential, 1000)
	print("reverse checksum: ".add(reverse_check.to_string()))

	-- Split for concat benchmark.
	var left: List[Int] = []
	var right: List[Int] = []
	half = n.divide(2)
	for i in 0..half:
		left = left.append(i)
	for i in half..n:
		right = right.append(i)

	concat_check = bench_concat(left, right, 1000)
	print("concat checksum: ".add(concat_check.to_string()))
	0
