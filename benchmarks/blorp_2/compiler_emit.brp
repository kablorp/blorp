-- Same generated bytes and append chunks as benchmarks/blorp/compiler_emit.brp.
-- Provisional library difference: the target String API cannot reserve capacity.
import:
	io: print


pure func emit_program(functions: Int, blocks: Int, statements: Int) -> String:
	var out = ""
	out = out.add("/* generated benchmark program */\n")

	for function_id in 0..functions:
		out = out.add("static long f")
		out = out.append_int(function_id)
		out = out.add("(long seed) {\n")
		out = out.add("  long acc = seed;\n")

		for i in 0..24:
			out = out.add("  long v")
			out = out.append_int(i)
			out = out.add(" = seed + ")
			out = out.append_int(function_id.add(i))
			out = out.add(";\n")

		for block_id in 0..blocks:
			out = out.add("block_")
			out = out.append_int(block_id)
			out = out.add(":\n")

			for statement_id in 0..statements:
				target = statement_id.add(function_id).add(block_id).remainder(17)
				left = statement_id.multiply(3).add(function_id).remainder(23)
				right = block_id.multiply(5).add(statement_id).remainder(29)
				out = out.add("  v")
				out = out.append_int(target)
				out = out.add(" = v")
				out = out.append_int(left)
				out = out.add(" + ")
				out = out.append_int(right)
				out = out.add(";\n")

			if block_id.remainder(3).equals(0):
				out = out.add("  goto block_")
				out = out.append_int(block_id.add(1))
				out = out.add(";\n")
			else:
				out = out.add("  acc += v")
				out = out.append_int(block_id.remainder(17))
				out = out.add(";\n")

		out = out.add("  return acc;\n}\n")

	out


pure func checksum_text(text: String) -> Int:
	var checksum = 0

	for i in 0..text.length():
		-- Every emitted character is ASCII, so byte_at matches Char.to_int.
		match text.byte_at(i):
			Some(byte):
				checksum = checksum.multiply(33).add(byte)
			None:
				void

	checksum


func main(args: List[String]) -> Int:
	text = emit_program(120, 10, 8)
	print("compiler_emit checksum: ".add(checksum_text(text).to_string()))
	print("compiler_emit bytes: ".add(text.length().to_string()))
	0
