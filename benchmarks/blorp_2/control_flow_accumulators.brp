import:
	io: print
	string: parse_int


-- Accumulators updated inside control flow. Each mode appends `count` values;
-- a List that is copied on every inner-loop entry or join arm makes the work
-- quadratic in `count`, while in-place reuse keeps it linear. `none` is the
-- process-startup control. Usage: control_flow_accumulators <mode> <count>.
pure func in_arms(count: Int) -> List[Int]:
	var values: List[Int] = []
	for index in 0..count:
		match index.remainder(2).equals(0):
			True:
				values = values.append(index)
			False:
				values = values.append(index.add(1))
	values


-- Rows of sixteen appends: the accumulator enters the inner loop once per row.
pure func nested(count: Int) -> List[Int]:
	var values: List[Int] = []
	for row in 0..count.divide(16):
		for column in 0..16:
			values = values.append(column)
	values


pure func flat(count: Int) -> List[Int]:
	var values: List[Int] = []
	for index in 0..count:
		values = values.append(index)
	values


pure func accumulate(mode: String, count: Int) -> Option[List[Int]]:
	match mode:
		"in_arms": Some(in_arms(count))
		"nested": Some(nested(count))
		"flat": Some(flat(count))
		"none": Some([])
		_: None


func main(args: List[String]) -> Int:
	mode = args.get_or(1, "")
	selected = match parse_int(args.get_or(2, "")):
		Some(count): accumulate(mode, count)
		None: None
	match selected:
		Some(values):
			print(values.length().to_string())
			0
		None:
			print("usage: control_flow_accumulators in_arms|nested|flat|none <count>")
			2
