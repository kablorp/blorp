import:
	io: print


-- Pure numeric loop benchmark: raw loop and arithmetic performance.
func collatz_steps(start: Int) -> Int:
	var n: Int = start
	var steps: Int = 0

	while n.not_equals(1):
		if n.remainder(2).equals(0):
			n = n.divide(2)
		else:
			n = n.multiply(3).add(1)

		steps = steps.add(1)

	steps


func main(args: List[String]) -> Int:
	var total_steps: Int = 0

	for i in 1..1000000:
		total_steps = total_steps.add(collatz_steps(i))

	print("Total Collatz steps: ".add(total_steps.to_string()))
	0
