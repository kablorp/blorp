    if as_json:
        print(json.dumps(metrics, sort_keys=True))
        return

    ordered_names = (
        "fixture_version",
        "modules",
        "type_depth",
        "probes_per_module",
        "primitive_probes_per_module",
        "primitive_storage_probes_per_module",
        "resource_scan_depth",
        "resource_scan_probes_per_module",
        "self_resolution_depth",
        "self_resolution_probes_per_module",
        "runs",
        "warmup_runs",
        "platform",
        "source_declarations",
        "artifacts",
        "request_bytes",
        "response_bytes",
        "response_sha256",
        "bridge_sha256",
        "baseline_bridge_sha256",
        "request_sha256",
        "elapsed_min_seconds",
        "elapsed_seconds",
        "elapsed_max_seconds",
        "baseline_elapsed_min_seconds",
        "baseline_elapsed_seconds",
        "baseline_elapsed_max_seconds",
        "elapsed_paired_change_percent",
        "peak_rss_median_bytes",
        "peak_rss_bytes",
        "baseline_peak_rss_median_bytes",
        "baseline_peak_rss_bytes",
        "peak_rss_paired_change_percent",
        "physical_footprint_bytes",
        "baseline_physical_footprint_bytes",
        "malloc_small_bytes",
        "baseline_malloc_small_bytes",
        "allocation_count",
        "baseline_allocation_count",
        "comparison_order",
        "verified",
    )
    fields = [f"{name}={metrics[name]}" for name in ordered_names if name in metrics]
    print("TYPECHECK_MEMORY_BENCH " + " ".join(fields))


def run_measurement(
    root: Path,
    temp_dir: Path,
    label: str,
    bridge: Path,
    request_path: Path,
    expected_modules: list[str],
    bridge_sha256: str,
    request_sha256: str,
    sample_vmmap: bool,
) -> tuple[JsonObject, int, int, str]:
    response_path = temp_dir / f"{label}.response.jsonl"
    stderr_path = temp_dir / f"{label}.bridge.stderr"
    metrics_path = temp_dir / f"{label}.metrics.json"
    worker_command = [
        sys.executable,
        str(Path(__file__).resolve()),
        WORKER_FLAG,
        str(bridge),
        str(request_path),
        str(response_path),
        str(stderr_path),
        str(metrics_path),
        "1" if sample_vmmap else "0",
    ]
    worker = subprocess.run(worker_command, cwd=root, check=False)
    if worker.returncode != 0 or not metrics_path.is_file():
        raise RuntimeError(f"benchmark measurement worker failed during {label}")
    if sha256_file(bridge) != bridge_sha256:
        raise RuntimeError("typecheck bridge changed during measurement")
    if sha256_file(request_path) != request_sha256:
        raise RuntimeError("typecheck request changed during measurement")

    metrics = json.loads(metrics_path.read_text(encoding="utf-8"))
    if metrics["exit_code"] != 0:
        stderr = stderr_path.read_text(
            encoding="utf-8",
            errors="replace",
        ).strip()
        raise RuntimeError(
            f"typecheck bridge exited with {metrics['exit_code']} during {label}: {stderr}"
        )

    artifact_count = validate_response(response_path, expected_modules)
    del metrics["exit_code"]
    return (
        metrics,
        artifact_count,
        response_path.stat().st_size,
        sha256_file(response_path),
    )


def summarize_measurements(measured: list[JsonObject]) -> JsonObject:
    elapsed_values = [float(run["elapsed_seconds"]) for run in measured]
    peak_rss_values = [int(run["peak_rss_bytes"]) for run in measured]
    summary: JsonObject = {
        "elapsed_min_seconds": min(elapsed_values),
        "elapsed_seconds": statistics.median(elapsed_values),
        "elapsed_max_seconds": max(elapsed_values),
        "peak_rss_median_bytes": int(statistics.median(peak_rss_values)),
        "peak_rss_bytes": max(peak_rss_values),
    }
    for metric_name in (
        "physical_footprint_bytes",
        "malloc_small_bytes",
        "allocation_count",
    ):
        values = [
            int(run[metric_name])
            for run in measured
            if metric_name in run
        ]
        if values:
            summary[metric_name] = max(values)
    return summary


def paired_change_percent(
    candidate: list[JsonObject],
    baseline: list[JsonObject],
    metric_name: str,
) -> float:
    changes = []
    for candidate_run, baseline_run in zip(candidate, baseline, strict=True):
        baseline_value = float(baseline_run[metric_name])
        candidate_value = float(candidate_run[metric_name])
        changes.append(((candidate_value - baseline_value) / baseline_value) * 100.0)
    return statistics.median(changes)


def run_benchmark(args: argparse.Namespace) -> int:
    baseline_requested = bool(getattr(args, "baseline_bridge", None))
    if baseline_requested and args.runs % 2 != 0:
        raise RuntimeError("bridge comparison requires an even number of measured runs")
    if baseline_requested and args.warmup_runs % 2 != 0:
        raise RuntimeError("bridge comparison requires an even number of warmup runs")

    root = project_root()
    with tempfile.TemporaryDirectory(prefix="blorp-typecheck-memory-") as temp_name:
        temp_dir = Path(temp_name)
        bridge_dir = temp_dir / "bridge"
        bridge_dir.mkdir()
        bridge = prepared_typecheck_bridge(root, bridge_dir, args.bridge)
        baseline_bridge = None
        if getattr(args, "baseline_bridge", None):
            baseline_bridge_dir = temp_dir / "baseline-bridge"
            baseline_bridge_dir.mkdir()
            baseline_bridge = prepared_typecheck_bridge(
                root,
                baseline_bridge_dir,
                args.baseline_bridge,
            )

        request, fixture = fixture_request(
            args.modules,
            args.type_depth,
            args.probes_per_module,
            args.primitive_probes_per_module,
            args.primitive_storage_probes_per_module,
            args.resource_scan_depth,
            args.resource_scan_probes_per_module,
            args.self_resolution_depth,
            args.self_resolution_probes_per_module,
        )
        request_path = temp_dir / "request.json"
        request_path.write_text(
            json.dumps(request, separators=(",", ":")),
            encoding="utf-8",
        )
        bridge_sha256 = sha256_file(bridge)
        baseline_bridge_sha256 = (
            sha256_file(baseline_bridge)
            if baseline_bridge is not None
            else None
        )
        request_sha256 = sha256_file(request_path)

        bridges = [("candidate", bridge, bridge_sha256)]
        if baseline_bridge is not None and baseline_bridge_sha256 is not None:
            bridges.append(("baseline", baseline_bridge, baseline_bridge_sha256))

        for index in range(args.warmup_runs):
            ordered_bridges = bridges if index % 2 == 0 else list(reversed(bridges))
            for role, selected_bridge, selected_hash in ordered_bridges:
                run_measurement(
                    root,
                    temp_dir,
                    f"warmup-{index}-{role}",
                    selected_bridge,
                    request_path,
                    fixture["artifact_order"],
                    selected_hash,
                    request_sha256,
                    args.vmmap,
                )

        measured: dict[str, list[JsonObject]] = {
            role: [] for role, _, _ in bridges
        }
        artifact_counts: dict[str, list[int]] = {
            role: [] for role, _, _ in bridges
        }
        response_sizes: dict[str, list[int]] = {
            role: [] for role, _, _ in bridges
        }
        response_hashes: dict[str, list[str]] = {
            role: [] for role, _, _ in bridges
        }
        sample_execution_order: list[str] = []
        for index in range(args.runs):
            ordered_bridges = bridges if index % 2 == 0 else list(reversed(bridges))
            sample_execution_order.append(
                ",".join(role for role, _, _ in ordered_bridges)
            )
            for role, selected_bridge, selected_hash in ordered_bridges:
                (
                    run_metrics,
                    artifact_count,
                    response_size,
                    response_hash,
                ) = run_measurement(
                    root,
                    temp_dir,
                    f"run-{index}-{role}",
                    selected_bridge,
                    request_path,
                    fixture["artifact_order"],
                    selected_hash,
                    request_sha256,
                    args.vmmap,
                )
                measured[role].append(run_metrics)
                artifact_counts[role].append(artifact_count)
                response_sizes[role].append(response_size)
                response_hashes[role].append(response_hash)

        all_artifact_counts = [
            count for role_counts in artifact_counts.values() for count in role_counts
        ]
        all_response_sizes = [
            size for role_sizes in response_sizes.values() for size in role_sizes
        ]
        all_response_hashes = [
            digest for role_hashes in response_hashes.values() for digest in role_hashes
        ]
        if len(set(all_artifact_counts)) != 1:
            raise RuntimeError("typecheck bridge artifact count varied between runs")
        if len(set(all_response_sizes)) != 1:
            raise RuntimeError("typecheck bridge response size varied between runs")
        if len(set(all_response_hashes)) != 1:
            raise RuntimeError("typecheck bridge response content varied between runs")

        metrics = summarize_measurements(measured["candidate"])
        metrics["elapsed_samples_seconds"] = [
            float(run["elapsed_seconds"]) for run in measured["candidate"]
        ]
        metrics["peak_rss_samples_bytes"] = [
            int(run["peak_rss_bytes"]) for run in measured["candidate"]
        ]
        if baseline_bridge_sha256 is not None:
            baseline_summary = summarize_measurements(measured["baseline"])
            metrics.update({
                f"baseline_{name}": value
                for name, value in baseline_summary.items()
            })
            metrics["baseline_bridge_sha256"] = baseline_bridge_sha256
            metrics["baseline_elapsed_samples_seconds"] = [
                float(run["elapsed_seconds"]) for run in measured["baseline"]
            ]
            metrics["baseline_peak_rss_samples_bytes"] = [
                int(run["peak_rss_bytes"]) for run in measured["baseline"]
            ]
            metrics["sample_execution_order"] = sample_execution_order
            metrics["elapsed_paired_change_percent"] = paired_change_percent(
                measured["candidate"],
                measured["baseline"],
                "elapsed_seconds",
            )
            metrics["peak_rss_paired_change_percent"] = paired_change_percent(
                measured["candidate"],
                measured["baseline"],
                "peak_rss_bytes",
            )
            metrics["comparison_order"] = "alternating"

        metrics.update(
            {
                "fixture_version": FIXTURE_VERSION,
                "modules": args.modules,
                "type_depth": args.type_depth,
                "probes_per_module": args.probes_per_module,
                "primitive_probes_per_module": args.primitive_probes_per_module,
                "primitive_storage_probes_per_module": (
                    args.primitive_storage_probes_per_module
                ),
                "resource_scan_depth": args.resource_scan_depth,
                "resource_scan_probes_per_module": (
                    args.resource_scan_probes_per_module
                ),
                "self_resolution_depth": args.self_resolution_depth,
                "self_resolution_probes_per_module": (
                    args.self_resolution_probes_per_module
                ),
                "runs": args.runs,
                "warmup_runs": args.warmup_runs,
                "platform": platform.platform(),
                "source_declarations": fixture["source_declarations"],
                "artifacts": all_artifact_counts[0],
                "request_bytes": request_path.stat().st_size,
                "response_bytes": all_response_sizes[0],
                "response_sha256": all_response_hashes[0],
                "bridge_sha256": bridge_sha256,
                "request_sha256": request_sha256,
                "verified": True,
            }
        )
        print_metrics(metrics, args.json)
    return 0


def main(argv: list[str]) -> int:
    if argv and argv[0] == WORKER_FLAG:
        return measurement_worker(argv[1:])

    parser = argparse.ArgumentParser(
        description=(
            "Measure the production typecheck_graph path with nested named types "
            "and explicitly typed local bindings."
        )
    )
    parser.add_argument("--modules", type=positive_int, default=DEFAULT_MODULES)
    parser.add_argument("--type-depth", type=positive_int, default=DEFAULT_TYPE_DEPTH)
    parser.add_argument(
        "--probes-per-module",
        type=positive_int,
        default=DEFAULT_PROBES_PER_MODULE,
    )
    parser.add_argument(
        "--primitive-probes-per-module",
        type=nonnegative_int,
        default=DEFAULT_PRIMITIVE_PROBES_PER_MODULE,
    )
    parser.add_argument(
        "--primitive-storage-probes-per-module",
        type=nonnegative_int,
        default=DEFAULT_PRIMITIVE_STORAGE_PROBES_PER_MODULE,
    )
    parser.add_argument(
        "--resource-scan-depth",
        type=nonnegative_int,
        default=DEFAULT_RESOURCE_SCAN_DEPTH,
    )
    parser.add_argument(
        "--resource-scan-probes-per-module",
        type=nonnegative_int,
        default=DEFAULT_RESOURCE_SCAN_PROBES_PER_MODULE,
    )
    parser.add_argument(
        "--self-resolution-depth",
        type=nonnegative_int,
        default=DEFAULT_SELF_RESOLUTION_DEPTH,
    )
    parser.add_argument(
        "--self-resolution-probes-per-module",
        type=nonnegative_int,
        default=DEFAULT_SELF_RESOLUTION_PROBES_PER_MODULE,
    )
    parser.add_argument(
        "--runs",
        type=positive_int,
        default=DEFAULT_RUNS,
        help="measured runs using one prepared bridge and one immutable request",
    )
    parser.add_argument(
        "--warmup-runs",
        type=nonnegative_int,
        default=DEFAULT_WARMUP_RUNS,
        help="validated unmeasured runs before measurement",
    )
    parser.add_argument(
        "--bridge",
        help=f"prepared typecheck bridge; defaults to ${TYPECHECK_BRIDGE_ENV} or prepares one",
    )
    parser.add_argument(
        "--baseline-bridge",
        help="prepared baseline bridge compared with alternating execution order",
    )
    parser.add_argument(
        "--vmmap",
        action="store_true",
        help="sample macOS vmmap allocator and physical-footprint metrics",
    )
    parser.add_argument("--json", action="store_true", help="print metrics as JSON")
    args = parser.parse_args(argv)

    if args.vmmap and (platform.system() != "Darwin" or shutil.which("vmmap") is None):
        parser.error("--vmmap requires macOS vmmap")

    try:
        return run_benchmark(args)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
