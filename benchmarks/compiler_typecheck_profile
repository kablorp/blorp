#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
source_file="$repo_root/compiler/blorp/benchmarks/compiler_typecheck_profile.brp"
runner_file="$script_dir/compiler_typecheck_profile"
cc_path=$(command -v cc)
compiler="${BLORP_TYPECHECK_PROFILE_COMPILER:-$repo_root/compiler/_build/blorp-cli/blorp}"

if command -v shasum >/dev/null 2>&1; then
	hash_command=(shasum -a 256)
elif command -v sha256sum >/dev/null 2>&1; then
	hash_command=(sha256sum)
else
	echo "compiler_typecheck_profile requires shasum or sha256sum." >&2
	exit 1
fi

if [ "${BLORP_TYPECHECK_PROFILE_SKIP_BUILD:-0}" != "1" ]; then
	make -C "$repo_root" all >/dev/null
fi
if [[ "$compiler" != /* ]]; then
	compiler="$PWD/$compiler"
fi
if [ ! -x "$compiler" ]; then
	echo "compiler_typecheck_profile requires an executable compiler." >&2
	exit 1
fi

semantic_worker="${BLORP_OCAML_MIDDLE_BIN:-$repo_root/compiler/_build/default/bin/blorp_ocaml_middle.exe}"
if [[ "$semantic_worker" != /* ]]; then
	semantic_worker="$PWD/$semantic_worker"
fi
if [ ! -x "$semantic_worker" ]; then
	echo "compiler_typecheck_profile requires an executable semantic worker." >&2
	exit 1
fi

bridge_compiler="${BLORP_COMPILER_BRIDGE_BIN:-}"
if [ -z "$bridge_compiler" ]; then
	bridge_compiler=$("$repo_root/scripts/blorp-compiler-bootstrap" --print-path)
fi
if [[ "$bridge_compiler" != /* ]]; then
	bridge_compiler="$PWD/$bridge_compiler"
fi

export BLORP_COMPILER_BRIDGE_BIN="$bridge_compiler"
export BLORP_OCAML_MIDDLE_BIN="$semantic_worker"
unset \
	BLORP_COMPILER_BRIDGE_RENDERER_SOURCE \
	BLORP_COMPILER_RENDERER_HELPER \
	BLORP_FRONTEND_PARSER \
	BLORP_STD

prepared_bridge_files=()
if [ "${BLORP_BENCHMARK_USE_PREPARED_BRIDGES:-0}" = "1" ]; then
	for bridge_variable in \
		BLORP_COMPILER_PARSER_BRIDGE_BIN \
		BLORP_COMPILER_RENDERER_BRIDGE_BIN \
		BLORP_COMPILER_TYPECHECK_BRIDGE_BIN
	do
		prepared_bridge="${!bridge_variable:-}"
		if [ -n "$prepared_bridge" ] && [[ "$prepared_bridge" != /* ]]; then
			prepared_bridge="$PWD/$prepared_bridge"
		fi
		if [ -z "$prepared_bridge" ] || [ ! -x "$prepared_bridge" ]; then
			echo "prepared bridge mode requires executable parser, renderer, and typecheck bridge paths." >&2
			exit 1
		fi
		printf -v "$bridge_variable" '%s' "$prepared_bridge"
		export "$bridge_variable"
		prepared_bridge_files+=("$prepared_bridge")
	done
	export BLORP_COMPILER_REQUIRE_PREPARED_BRIDGE=1
else
	unset \
		BLORP_COMPILER_PARSER_BRIDGE_BIN \
		BLORP_COMPILER_RENDERER_BRIDGE_BIN \
		BLORP_COMPILER_REQUIRE_PREPARED_BRIDGE \
		BLORP_COMPILER_TYPECHECK_BRIDGE_BIN
fi
cd "$repo_root"

cache_input_files=(
	"$runner_file"
	"$compiler"
	"$semantic_worker"
	"$bridge_compiler"
	"$cc_path"
	"$repo_root/blorp.toml"
)
if [ "${BLORP_BENCHMARK_USE_PREPARED_BRIDGES:-0}" = "1" ]; then
	cache_input_files+=("${prepared_bridge_files[@]}")
fi
cache_root="${BLORP_BENCHMARK_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/blorp/benchmarks}"
input_hash=$(
	{
		find \
			"$repo_root/compiler/blorp/src" \
			"$repo_root/compiler/blorp/benchmarks" \
			"$repo_root/std" \
			-type f -name '*.brp' \
			-exec "${hash_command[@]}" {} +
		"${hash_command[@]}" "${cache_input_files[@]}"
		printf 'platform=%s\n' "$(uname -srm)"
		"$cc_path" --version
	} |
		LC_ALL=C sort |
		"${hash_command[@]}" |
		awk '{print $1}'
)
artifact_dir="$cache_root/compiler-typecheck-profile/$input_hash"
binary="$artifact_dir/compiler_typecheck_profile"

if [ ! -x "$binary" ]; then
	stage_dir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-typecheck-profile.XXXXXX")
	trap 'rm -rf "$stage_dir"' EXIT

	"$compiler" compile --profile --no-format \
		-o "$stage_dir/compiler_typecheck_profile.c" \
		"$source_file" >/dev/null
	"$cc_path" -O0 -fwrapv -pipe -w \
		"$stage_dir/compiler_typecheck_profile.c" \
		-lm -lpthread \
		-o "$stage_dir/compiler_typecheck_profile"

	mkdir -p "$artifact_dir"
	mv "$stage_dir/compiler_typecheck_profile" "$binary"
	trap - EXIT
	rm -rf "$stage_dir"
fi

if [ "${1:-}" = "--" ]; then
	shift
fi

exec "$binary" "$@"
