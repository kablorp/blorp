#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-typecheck-profile \
	"$repo_root/compiler/blorp/benchmarks/compiler_typecheck_profile.brp" \
	profile \
	"$@"
