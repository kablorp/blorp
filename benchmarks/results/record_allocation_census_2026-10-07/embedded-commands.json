[
  {
    "label": "generate-embedded",
    "argv": [
      "bin/blorp",
      "compile",
      "--no-format",
      "--check-invariants",
      "--dump-core-after=final",
      "--dump-core-file=$ORACLE/oracle.final.core",
      "-o",
      "$ORACLE/oracle.normal.c",
      "benchmarks/results/record_allocation_census_2026-10-04/oracle.brp"
    ],
    "exit": 0
  },
  {
    "label": "compile-normal",
    "argv": [
      "clang",
      "-O2",
      "-DBLORP_MEMORY_DIAGNOSTICS=1",
      "$ORACLE/oracle.normal.c",
      "-lm",
      "-pthread",
      "-o",
      "$ORACLE/oracle.normal"
    ],
    "exit": 0
  },
  {
    "label": "oracle.normal.n4",
    "argv": [
      "$ORACLE/oracle.normal"
    ],
    "environment_set": {
      "BLORP_MEMORY_STATS": "1"
    },
    "exit": 0
  },
  {
    "label": "oracle.normal.n5",
    "argv": [
      "$ORACLE/oracle.normal",
      "extra"
    ],
    "environment_set": {
      "BLORP_MEMORY_STATS": "1"
    },
    "exit": 0
  },
  {
    "label": "compile-instrumented",
    "argv": [
      "clang",
      "-O2",
      "-DBLORP_MEMORY_DIAGNOSTICS=1",
      "$ORACLE/oracle.instrumented.c",
      "-lm",
      "-pthread",
      "-o",
      "$ORACLE/oracle.instrumented"
    ],
    "exit": 0
  },
  {
    "label": "oracle.instrumented.n4",
    "argv": [
      "$ORACLE/oracle.instrumented"
    ],
    "environment_set": {
      "BLORP_MEMORY_STATS": "1"
    },
    "exit": 0
  },
  {
    "label": "oracle.instrumented.n5",
    "argv": [
      "$ORACLE/oracle.instrumented",
      "extra"
    ],
    "environment_set": {
      "BLORP_MEMORY_STATS": "1"
    },
    "exit": 0
  }
]
