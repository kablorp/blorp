record FreshScalar {value: Int}
record UniqueScalar {value: Int, other: Int}
record SharedScalar {value: Int, other: Int}
record FreshManaged {text: String, value: Int}
record UniqueManaged {text: String, value: Int}
record SharedManaged {text: String, value: Int}

func fresh(iterations: Int) -> Int:
	var total: Int = 0
	for index in 0..iterations:
		scalar: FreshScalar = {value = index}
		managed: FreshManaged = {text = "managed", value = index}
		total += scalar.value + managed.value + managed.text.length()
	total

func unique(seed: Int) -> Int:
	var scalar: UniqueScalar = {value = seed, other = 2}
	var managed: UniqueManaged = {text = "unique", value = seed}
	scalar = {scalar | value = scalar.value + 1}
	managed = {managed | value = managed.value + 1}
	scalar.value + scalar.other + managed.value + managed.text.length()

func shared(seed: Int) -> Int:
	base_scalar: SharedScalar = {value = seed, other = 2}
	var changed_scalar: SharedScalar = base_scalar
	base_managed: SharedManaged = {text = "shared", value = seed}
	var changed_managed: SharedManaged = base_managed
	changed_scalar = {changed_scalar | value = changed_scalar.value + 1}
	changed_managed = {changed_managed | value = changed_managed.value + 1}
	base_scalar.value + changed_scalar.value + base_managed.value + changed_managed.value

func main(args: List[String]) -> Int:
	iterations: Int = 3 + args.length()
	print(fresh(iterations))
	print(unique(iterations))
	print(shared(iterations))
	0
