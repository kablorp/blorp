-- Manual known-failure reproduction, intentionally outside the runtime gate.
-- Both expectations remain True. See README.md for the unclosed boundary.
import:
	test: TestSuite
	traits: Equatable


record DefaultChoice {
	value: Int
}


implements Equatable for DefaultChoice:
	pure func equals(left: DefaultChoice, right: DefaultChoice) -> Bool:
		False


DEFAULT_LEFT: DefaultChoice = {value = 1}

FOLDED_DEFAULT_NOT_EQUAL: Bool = DEFAULT_LEFT != DEFAULT_LEFT


func test_folded_not_equals_preserves_default_method() -> Bool:
	FOLDED_DEFAULT_NOT_EQUAL


func test_runtime_not_equals_preserves_default_method() -> Bool:
	left: DefaultChoice = {value = 1}
	left != left


tests: TestSuite = {
	description = "Known default inequality CTFE identity gap",
	tests = [
		(
			"folded not_equals preserves default method",
			test_folded_not_equals_preserves_default_method,
		),
		(
			"runtime not_equals preserves default method",
			test_runtime_not_equals_preserves_default_method,
		),
	]
}
