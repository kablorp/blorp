import:
	selector as choices: Selector, pick_marker

record AliasBox {
	value: Int
}

implements Selector for AliasBox:
	pure func pick_marker(value: AliasBox) -> Int:
		17

pure func alias_selected() -> Int:
	box: AliasBox = {value = 1}
	box.pick_marker()

func main(args: List[String]) -> Int:
	print(alias_selected().to_string())
	0
