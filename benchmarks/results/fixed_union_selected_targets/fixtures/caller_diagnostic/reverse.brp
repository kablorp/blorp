import:
	forward: forwarded
	provider: Choice(First, Second), provider_direct, provider_same

func main(args: List[String]) -> Int:
	print("importer_forwarded=" + forwarded(First, Second).to_string())
	print("importer_direct=" + (First == Second).to_string())
	print("provider_forwarded=" + provider_same().to_string())
	print("provider_direct=" + provider_direct().to_string())
	0
