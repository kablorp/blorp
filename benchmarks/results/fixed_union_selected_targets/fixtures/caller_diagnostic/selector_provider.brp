import:
	selector: Selector, pick_marker
	selector_forward: forwarded_select

record Box {
	value: Int
}

private implements Selector for Box:
	pure func pick_marker(value: Box) -> Int:
		11

pure func provider_selected() -> Int:
	box: Box = {value = 1}
	forwarded_select(box)

pure func provider_direct_selected() -> Int:
	box: Box = {value = 1}
	box.pick_marker()
