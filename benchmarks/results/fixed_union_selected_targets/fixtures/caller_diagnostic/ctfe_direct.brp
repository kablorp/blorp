import:
	provider: Choice(First, Second), provider_direct

FOLDED_IMPORTER: Bool = First == Second
FOLDED_PROVIDER: Bool = provider_direct()

func main(args: List[String]) -> Int:
	print("folded_importer=" + FOLDED_IMPORTER.to_string())
	print("folded_provider=" + FOLDED_PROVIDER.to_string())
	print("runtime_importer=" + (First == Second).to_string())
	print("runtime_provider=" + provider_direct().to_string())
	0
