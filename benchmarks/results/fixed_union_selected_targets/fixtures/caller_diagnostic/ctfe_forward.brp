import:
	forward: forwarded
	provider: Choice(First, Second), provider_same

FOLDED_IMPORTER: Bool = forwarded(First, Second)
FOLDED_PROVIDER: Bool = provider_same()

func main(args: List[String]) -> Int:
	print("folded_importer=" + FOLDED_IMPORTER.to_string())
	print("folded_provider=" + FOLDED_PROVIDER.to_string())
	print("runtime_importer=" + forwarded(First, Second).to_string())
	print("runtime_provider=" + provider_same().to_string())
	0
