-- Diagnostic follow-on: this compound pattern must reject Number.
union Inner:
	Text(String)
	Number(Int)


union Outer:
	Wrapped(Inner)
	Other


pure func compound_match(state: Result[Int, String], value: Outer) -> Bool:
	match (state, value):
		(Ok(_), Wrapped(Text(text))):
			text.length() > 0
		_:
			False


func main(args: List[String]) -> Int:
	print("positive=" + compound_match(Ok(0), Wrapped(Text("yes"))).to_string())
	print("negative=" + compound_match(Ok(0), Wrapped(Number(30))).to_string())
	0
