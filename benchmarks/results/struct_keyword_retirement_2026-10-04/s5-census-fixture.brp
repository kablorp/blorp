record ScalarPair {
	left: Int,
	right: Int
}


record ManagedBox {
	value: String
}


pure func scalar_projection(left: Int, right: Int) -> Int:
	pair: ScalarPair = { left = left, right = right }
	pair.left + pair.right


pure func observe_pair(pair: ScalarPair) -> Int:
	pair.left


pure func whole_call(value: Int) -> Int:
	pair: ScalarPair = { left = value, right = value + 1 }
	observe_pair(pair)


func captured_pair(value: Int) -> Int:
	pair: ScalarPair = { left = value, right = value + 1 }
	getter = func() -> Int:
		pair.left
	getter()


pure func managed_projection(text: String) -> Int:
	box: ManagedBox = { value = text }
	box.value.length()


func main(args: List[String]) -> Int:
	scalar_projection(1, 2) + whole_call(3) + captured_pair(4) + managed_projection("five")
