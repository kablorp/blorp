-- Publication-only probe: no nested trait call or synthesized automatic trait.
import:
	test: TestSuite


trait Marker:
	pure func anchor(value: Self) -> Int
	pure func marker(value: Self) -> Int:
		37


record Token {
	value: Int
}


implements Marker for Token:
	pure func anchor(value: Token) -> Int:
		value.value


TOKEN: Token = {value = 5}

FOLDED_MARKER: Int = marker(TOKEN)


pure func runtime_marker(value: Token) -> Int:
	marker(value)


func test_literal_default_global() -> Bool:
	FOLDED_MARKER == 37


func test_literal_default_runtime() -> Bool:
	runtime_marker({value = 9}) == 37


tests: TestSuite = {
	description = "Literal default callable publication probe",
	tests = [
		("literal default global", test_literal_default_global),
		("literal default runtime", test_literal_default_runtime),
	]
}
