+pure func ranked_standalone_c_source(program: CoreProgram) -> String:
+	match try_emit_source_spelled_prepared_c_artifact(prepared_core_program(program), FunctionProfileOff):
+		Ok(artifact): artifact.c_code
+		Err(error): "/* " + core_emit_error_message(error) + " */"
+
+
+pure func ranked_getter_inline_record_decl() -> CoreInlineRecordDecl:
+	{
+		name = "RankedPoint",
+		fields = [{ name = "value", ref = core_field_ref(0), typ = int_type() }],
+		loc = synthetic_core_source_loc()
+	}
+
