+record RankedGetterCase {
+	name: String,
+	dims: List[CoreTensorDim],
+	arguments: List[Int],
+	element_type: CoreType,
+	result_type: CoreType,
+	value_declaration: String,
+	read_expression: String
+}
+
+
+pure func ranked_getter_case(
+	name: String,
+	rank: Int,
+	shaped: Bool,
+	element_type: CoreType,
+	result_type: CoreType,
+	value_declaration: String,
+	read_expression: String,
+) -> RankedGetterCase:
+	dimensions: List[Int] = [2, 3, 4, 5, 6].take(rank)
+	indices: List[Int] = [-1, 1, 0, 1, 0].take(rank)
+	arguments: List[Int] = if shaped:
+		dimensions.concat(indices)
+	else:
+		indices
+	{
+		name = name,
+		dims = dimensions.map(pure func(dimension): TensorStaticDim(dimension)),
+		arguments = arguments,
+		element_type = element_type,
+		result_type = result_type,
+		value_declaration = value_declaration,
+		read_expression = read_expression
+	}
+
