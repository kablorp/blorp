-- Scratch production-pipeline oracle; retained before and after the local ABI refactor.
-- Exit 0 proves ranked reads preserve scalar widths, erased values and inline records.
import:
	float: to_float16, to_float32
	tensor as T


fixed record RankedPoint {
	value: Int
}


func reads_rank3() -> Bool:
	floats: Float[#2, #2, #2] = T.tensor3(1.5, 2, 2, 2)
	floats32: Float32[#2, #2, #2] = T.tensor3(to_float32(2.5), 2, 2, 2)
	floats16: Float16[#2, #2, #2] = T.tensor3(to_float16(3.5), 2, 2, 2)
	ints: Int[#2, #2, #2] = T.tensor3(7, 2, 2, 2)
	strings: String[#2, #2, #2] = T.tensor3("ranked", 2, 2, 2)
	points: RankedPoint[#2, #2, #2] = T.tensor3({ value = 11 }, 2, 2, 2)
	point: RankedPoint = T.tensor3_checked_get(points, -1, -1, -1)
	(
		T.tensor3_checked_get(floats, -1, -1, -1) == 1.5
		and T.tensor3_checked_get(floats32, -1, -1, -1) == to_float32(2.5)
		and T.tensor3_checked_get(floats16, -1, -1, -1) == to_float16(3.5)
		and T.tensor3_checked_get(ints, -1, -1, -1) == 7
		and T.tensor3_checked_get(strings, -1, -1, -1) == "ranked"
		and point.value == 11
		and T.tensor3_checked_get(floats, 2, 0, 0) == 0.0
		and T.tensor3_checked_get(floats32, 2, 0, 0) == to_float32(0.0)
		and T.tensor3_checked_get(floats16, 2, 0, 0) == to_float16(0.0)
		and T.tensor3_checked_get(ints, 2, 0, 0) == 0
	)


func reads_rank4() -> Bool:
	floats: Float[#2, #2, #2, #2] = T.tensor4(1.5, 2, 2, 2, 2)
	floats32: Float32[#2, #2, #2, #2] = T.tensor4(to_float32(2.5), 2, 2, 2, 2)
	floats16: Float16[#2, #2, #2, #2] = T.tensor4(to_float16(3.5), 2, 2, 2, 2)
	ints: Int[#2, #2, #2, #2] = T.tensor4(7, 2, 2, 2, 2)
	strings: String[#2, #2, #2, #2] = T.tensor4("ranked", 2, 2, 2, 2)
	points: RankedPoint[#2, #2, #2, #2] = T.tensor4({ value = 11 }, 2, 2, 2, 2)
	point: RankedPoint = T.tensor4_checked_get(points, -1, -1, -1, -1)
	(
		T.tensor4_checked_get(floats, -1, -1, -1, -1) == 1.5
		and T.tensor4_checked_get(floats32, -1, -1, -1, -1) == to_float32(2.5)
		and T.tensor4_checked_get(floats16, -1, -1, -1, -1) == to_float16(3.5)
		and T.tensor4_checked_get(ints, -1, -1, -1, -1) == 7
		and T.tensor4_checked_get(strings, -1, -1, -1, -1) == "ranked"
		and point.value == 11
		and T.tensor4_checked_get(floats, 2, 0, 0, 0) == 0.0
		and T.tensor4_checked_get(floats32, 2, 0, 0, 0) == to_float32(0.0)
		and T.tensor4_checked_get(floats16, 2, 0, 0, 0) == to_float16(0.0)
		and T.tensor4_checked_get(ints, 2, 0, 0, 0) == 0
	)


func reads_rank5() -> Bool:
	floats: Float[#2, #2, #2, #2, #2] = T.tensor5(1.5, 2, 2, 2, 2, 2)
	floats32: Float32[#2, #2, #2, #2, #2] = T.tensor5(to_float32(2.5), 2, 2, 2, 2, 2)
	floats16: Float16[#2, #2, #2, #2, #2] = T.tensor5(to_float16(3.5), 2, 2, 2, 2, 2)
	ints: Int[#2, #2, #2, #2, #2] = T.tensor5(7, 2, 2, 2, 2, 2)
	strings: String[#2, #2, #2, #2, #2] = T.tensor5("ranked", 2, 2, 2, 2, 2)
	points: RankedPoint[#2, #2, #2, #2, #2] = T.tensor5({ value = 11 }, 2, 2, 2, 2, 2)
	point: RankedPoint = T.tensor5_checked_get(points, -1, -1, -1, -1, -1)
	(
		T.tensor5_checked_get(floats, -1, -1, -1, -1, -1) == 1.5
		and T.tensor5_checked_get(floats32, -1, -1, -1, -1, -1) == to_float32(2.5)
		and T.tensor5_checked_get(floats16, -1, -1, -1, -1, -1) == to_float16(3.5)
		and T.tensor5_checked_get(ints, -1, -1, -1, -1, -1) == 7
		and T.tensor5_checked_get(strings, -1, -1, -1, -1, -1) == "ranked"
		and point.value == 11
		and T.tensor5_checked_get(floats, 2, 0, 0, 0, 0) == 0.0
		and T.tensor5_checked_get(floats32, 2, 0, 0, 0, 0) == to_float32(0.0)
		and T.tensor5_checked_get(floats16, 2, 0, 0, 0, 0) == to_float16(0.0)
		and T.tensor5_checked_get(ints, 2, 0, 0, 0, 0) == 0
	)


func main(args: List[String]) -> Int:
	if reads_rank3() and reads_rank4() and reads_rank5():
		0
	else:
		1
