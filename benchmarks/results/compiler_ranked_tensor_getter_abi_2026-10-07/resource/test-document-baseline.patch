+pure func test_dict_get_repeated_specialization_keeps_one_key_box() -> Bool:
+	var unchanged: Bool = True
+
+	for (name, payload) in [("blorp_dict_get_int", named_type("Int")), ("blorp_dict_get_nullable", named_type("String"))]:
+		once: CoreExpr = specialized(int_key_dict_get(name, payload))
+		twice: CoreExpr = specialized(once)
+		unchanged = (
+			unchanged and dict_get_has_one_int_key_box(twice) and same_core_expr(twice, once)
+		)
+
+	unchanged
