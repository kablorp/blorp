+def pin_candidate_construction(setup_text):
+    global CONSTRUCTION_PINS, CONSTRUCTION_MANIFEST_SHA
+    if CONSTRUCTION_PINS:
+        raise SystemExit('Candidate construction must not be recaptured.')
+    log = OUT / 'candidate-stage2-setup.log'
+    raw = log.read_bytes()
+    if raw.decode() != setup_text:
+        raise SystemExit('Setup log changed before construction validation.')
+
+    def value(label):
+        matches = re.findall('^' + re.escape(label) + r'\s*:\s*(.+)$', setup_text, re.MULTILINE)
+        if len(matches) != 1:
+            raise SystemExit('Setup log lacks one exact artifact field: ' + label)
+        return matches[0].strip()
+
+    pins = {'setup_log': {'path': str(log.resolve()), 'sha256': hashlib.sha256(raw).hexdigest()}}
+    artifacts = [
+        ('generated_c', OUT / 'candidate-main.c', 'stage2 generated C sha256', 'stage2 generated C'),
+        ('body_object', OUT / 'candidate-main.o', 'stage2 body sha256', None),
+        ('normal_binary', OUT / 'blorp-stage2', 'stage2 binary sha256', 'stage2 binary'),
+        ('diagnostic_binary', OUT / 'blorp-stage2-diagnostic', 'stage2 diagnostic sha256', 'stage2 diagnostic binary'),
+    ]
+    for mode in ['0', '1']:
+        artifacts.append(('runtime_object_' + mode, Path(value('stage2 runtime object diagnostics=' + mode)),
+                          'stage2 runtime sha256 diagnostics=' + mode, None))
+    for name, path, hash_label, path_label in artifacts:
+        expected = value(hash_label)
+        if not re.fullmatch(r'[0-9a-f]{64}', expected):
+            raise SystemExit('Setup log artifact hash is invalid: ' + hash_label)
+        if path_label and Path(value(path_label)).resolve() != path.resolve():
+            raise SystemExit('Setup log artifact path differs from expected output: ' + name)
+        if sha(path) != expected:
+            raise SystemExit('Produced artifact differs from setup-log authority: ' + name)
+        pins[name] = {'path': str(path.resolve()), 'sha256': expected}
+    # Protect the validation-to-pin interval for every artifact, including the log.
+    for item in pins.values():
+        if sha(item['path']) != item['sha256']:
+            raise SystemExit('Construction artifact changed before immediate pinning.')
+    CONSTRUCTION_PINS = pins
+    write_json(OUT / 'construction-pins.json', pins)
+    CONSTRUCTION_MANIFEST_SHA = sha(OUT / 'construction-pins.json')
+
+
+def verify_construction_pins():
+    if not CONSTRUCTION_PINS:
+        return
+    if sha(OUT / 'construction-pins.json') != CONSTRUCTION_MANIFEST_SHA:
+        raise SystemExit('Candidate construction pin manifest changed.')
+    for name, item in CONSTRUCTION_PINS.items():
+        if sha(item['path']) != item['sha256']:
+            raise SystemExit('Candidate construction artifact changed: ' + name)
 
 
