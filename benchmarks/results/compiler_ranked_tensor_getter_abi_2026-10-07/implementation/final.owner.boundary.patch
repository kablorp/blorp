+pure func ranked_getter_program(case: RankedGetterCase, statement_receiver: Bool) -> CoreProgram:
+	tensor_type: CoreType = TensorType({ element_type = case.element_type, dims = case.dims })
+	tensor: CoreExpr = VarExpr(named_var("tensor"), tensor_type, synthetic_core_source_loc())
+	receiver: CoreExpr = if statement_receiver:
+		SeqExpr(CooperativeCheckpointExpr(VoidType, synthetic_core_source_loc()), tensor)
+	else:
+		tensor
+	read: CoreExpr = CallExpr(
+		BuiltinCall(case.name),
+		VoidExpr(VoidType, synthetic_core_source_loc()),
+		[receiver].concat(case.arguments.map(pure func(value): int_expr(value))),
+		case.result_type,
+		synthetic_core_source_loc(),
+	)
+	function: CoreFunction = {
+		ranked_tensor_checked_get_function() |
+		name = "ranked_getter_control",
+		params = [{ name = named_var("tensor"), typ = tensor_type, loc = synthetic_core_source_loc() }],
+		return_type = case.result_type,
+		body = Some(read),
+		is_pure = not statement_receiver,
+	}
+	{ decls = [FunctionDecl(function)], foreign_includes = [], source_files = [] }
+
