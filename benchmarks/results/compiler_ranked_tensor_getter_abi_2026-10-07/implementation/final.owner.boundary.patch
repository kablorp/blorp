+	float32_value: String = "float __tgnd_value_tensor_ranked_checked_get = 0.0f;"
+	float32_read: String = "blorp_vector_read_f32(__tgnd_vec_tensor_ranked_checked_get, __tgnd_flat_tensor_ranked_checked_get)"
+	[
+		ranked_getter_case("blorp_tensor3_checked_get", 3, False, float_type(), raw_pointer_type(), erased_value, erased_read),
+		ranked_getter_case("blorp_tensor3_checked_get_shape", 3, True, float_type(), raw_pointer_type(), erased_value, erased_read),
