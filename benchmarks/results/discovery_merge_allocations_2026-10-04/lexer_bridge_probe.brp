-- Exact per-family pins guard builder threading with managed discovery rows.
-- The fixed tolerance remains far below one extra copy per 2,000 repeats;
-- larger admitted row costs do not increase tolerated table-copy traffic.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexed_module: LexedModule
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/declaration_parser:
		parse_module_declarations,
	../../../../src/compiler_new/stage_01_discovery/parse/lexed_bridge: bridge_lexed_module
	test: TestSuite
	../../../../src/compiler_new/stage_01_discovery/pipeline: load_module
	../../../../src/compiler_new/stage_01_discovery/sources/source_admission:
		admit_source_with_line_starts,
	../../../../src/compiler_new/stage_01_discovery/sources/source_provider:
		ModulePlacement(InUserCode),
	../../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		ModuleOpening,
		close_module,
		empty_discovery_builder,
		next_module_id,
		open_module,
		opened_module,
	../../../../src/compiler_new/stage_01_discovery/tables/ids:
		module_id_at_row,
		name_id_at_row,
		source_id_at_row,
	../../../../src/compiler_new/stage_01_discovery/tables/node_builder: append_plain_leaf_node
	../../../../src/compiler_new/stage_01_discovery/tables/node_kind_classes:
		PlainLeafKind(BreakLeaf),
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		DefinitionKind(FunctionDefinition),
		ModuleOriginKind(UserModule),
		ModuleReach(RootModule),
		Visibility(PublicVisibility),
	../../../../src/compiler_new/stage_01_discovery/tables/span: pack_span
	../../support/raw_rows: append_definition
	memory:
		MemoryCounter(ManagedAllocations, MemoryStatsActive, OracleStatsActive),
		read_memory_counter,
		reset_mem_stats,


---
Statements or rows per measured run.
---
REPEATS: Int = 2000


---
A module that is `prefix` followed by `item` repeated `REPEATS` times; the
names and literals it uses are interned by its first copy.
---
pure func repeated_text(prefix: String, item: String, repeats: Int) -> String:
	var text: String = prefix
	var index: Int = 0

	while index < repeats:
		text += item
		index += 1

	text


---
The allocations parsing `text` as a module made, or `None` when the parse
rejected it or lost its repeated items: either would pass a budget vacuously.
Lexing and bridging the module happen before the counters reset: the budget
guards the parser's builder threading, and the lexer is a pure function whose
own allocations `test_lexer_allocations` pins.
---
func parse_allocations(text: String) -> Option[Int]:
	empty: DiscoveryBuilder = empty_discovery_builder()
	lexed: LexedModule = lex_module(empty.next_module_id(), text)
	admitted: DiscoveryBuilder = empty.admit_source_with_line_starts(
		"budget.brp",
		text,
		lexed.line_starts,
	)
	opening: ModuleOpening = admitted.open_module(UserModule, RootModule)
	prepared: DiscoveryBuilder = admitted.bridge_lexed_module(lexed)
	reset_mem_stats()
	active_before = (
		read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
	)
	builder: DiscoveryBuilder = prepared
		.parse_module_declarations(opening.opened_module())
		.close_module(opening)
	allocations = read_memory_counter(ManagedAllocations)

	if (
		active_before
		and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
		and builder.diagnostics.length() == 0
		and builder.tokens.length() > 0
	):
		Some(allocations)
	else:
		None


func bridge_allocations(text: String) -> Option[Int]:
	empty: DiscoveryBuilder = empty_discovery_builder()
	lexed: LexedModule = lex_module(empty.next_module_id(), text)
	admitted: DiscoveryBuilder = empty.admit_source_with_line_starts(
		"budget.brp",
		text,
		lexed.line_starts,
	)
	reset_mem_stats()
	active_before = (
		read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
	)
	bridged: DiscoveryBuilder = admitted.bridge_lexed_module(lexed)
	allocations = read_memory_counter(ManagedAllocations)

	if (
		active_before
		and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
		and allocations > 0
		and bridged.tokens.length() > 0
	):
		Some(allocations)
	else:
		None


func load_allocations(text: String) -> Option[Int]:
	reset_mem_stats()
	active_before = read_memory_counter(MemoryStatsActive)
	oracle_before = read_memory_counter(OracleStatsActive)
	builder: DiscoveryBuilder = load_module(
		empty_discovery_builder(),
		{
			path = "budget.brp",
			trusted_directory = ".",
			placement = InUserCode
		},
		RootModule,
		text,
	)

	if (
		builder.diagnostics.length() == 0
		and builder.tokens.length() > 0
		and active_before == 1
		and oracle_before == 1
		and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
	):
		Some(read_memory_counter(ManagedAllocations))
	else:
		None


func lexer_allocations(text: String) -> Option[Int]:
	reset_mem_stats()
	active_before = (
		read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
	)
	lexed = lex_module(module_id_at_row(0), text)
	allocations = read_memory_counter(ManagedAllocations)

	if (
		active_before
		and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
		and lexed.tokens.length() > 0
	):
		Some(allocations)
	else:
		None


func sample(label: String, prefix: String, item: String):
	for repeats in [0, 1, 2, 10, 2000, 4000]:
		text = repeated_text(prefix, item, repeats)
		lexer = lexer_allocations(text)
		bridge = bridge_allocations(text)
		parser = parse_allocations(text)
		load = load_allocations(text)
		print(label + " " + repeats.to_string() + " lexer=" + count_text(lexer) + " bridge=" + count_text(bridge) + " parser=" + count_text(parser) + " load=" + count_text(load))


pure func count_text(value: Option[Int]) -> String:
	match value:
		Some(count): count.to_string()
		None: "invalid"

func measure_all() -> Bool:
	sample("symbols", "", "( ) [ ] + -\n")
	sample("names", "", "foo bar baz\n")
	sample("keywords", "", "if match func\n")
	sample("layout", "", "if a:\n\tb\n")
	sample("comments", "", "-- note\n\nx\n")
	sample("dimensions", "", "#N #M\n")
	sample("integers", "", "1 22 333\n")
	sample("floats", "", "1.5 2.25\n")
	sample("strings", "", "\"ab\" \"cd\"\n")
	sample("rawstrings", "", "raw\"a\" raw\"b\"\n")
	sample("characters", "", "'a' 'b'\n")
	sample("interpolations", "", "\"a $" + "{b} c\"\n")
	sample("bridge_names", "", "alpha beta alpha #Rows beta\n")
	sample("bridge_literals", "", "x = 1 + 2.5 + 1 + \"text\" + \"text\"\n")
	sample("bridge_rejected_int", "", "x = 170141183460469231731687303715884105728\n")
	sample("bridge_rejected_float", "", "x = 1" + "0".repeat(400) + ".5\n")
	sample("bridge_interpolation", "", "y = \"a $" + "{a} b $" + "{b + c}\"\n")
	for repeats in [0, 1, 2, 10, 2000, 4000]:
		var text: String = ""
		for index in 0..repeats:
			text += "word" + index.to_string() + "\n"
		allocations = lexer_allocations(text)
		print("newspellings " + repeats.to_string() + " lexer=" + count_text(allocations))
	True

tests: TestSuite = { description = "Allocation merge measurements", tests = [("small and large samples", measure_all)] }
