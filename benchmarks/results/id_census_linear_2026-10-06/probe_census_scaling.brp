import:
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: GlobalForm(ConstantGlobal)
	../../../../src/compiler_new/stage_01_discovery/syntax/expressions:
		BinaryOperator(Add),
		Expression,
		Statement,
		StatementKind(ExpressionStatement),
		ExpressionKind(Binary, DebugBlock, IntegerLiteral, ListLiteral),
	../../../../src/compiler_new/stage_01_discovery/syntax/id_census: id_census
	../../../../src/compiler_new/stage_01_discovery/syntax/ids: minted_global
	../../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: ModuleItem(GlobalItem), ModuleSyntax
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds: Visibility(PublicVisibility)
	../../support/syntax_samples: SampleBuild, block, expression, module_syntax, statement, next_span, sample_build, sample_module, written
	memory:
		MemoryCounter(BackingMallocEvents, ManagedAllocations, MemoryStatsActive, OracleStatsActive),
		read_memory_counter,
		reset_mem_stats
	time: now
	test: TestSuite

pure func one_global(build: SampleBuild) -> (SampleBuild, ModuleItem):
	(b0, left) = build.expression(IntegerLiteral(to_int128(1)))
	(b1, right) = b0.expression(IntegerLiteral(to_int128(1)))
	(b2, value) = b1.expression(Binary(Add, left, right))
	(b3, name) = b2.written("value")
	(b4, span) = b3.next_span()
	(m1, global) = b4.mint.minted_global(PublicVisibility, None, ConstantGlobal, name, None, value, span)
	({ b4 | mint = m1 }, GlobalItem(global))

pure func many_globals(count: Int) -> ModuleSyntax:
	var build: SampleBuild = sample_build()
	var items: List[ModuleItem] = []
	var made: Int = 0
	while made < count:
		(next, item) = build.one_global()
		build = next
		items = items.append(item)
		made += 1
	build.module_syntax(items, None)

pure func big_list(count: Int) -> ModuleSyntax:
	var build: SampleBuild = sample_build()
	var elements: List[Expression] = []
	var made: Int = 0
	while made < count:
		(next, element) = build.expression(IntegerLiteral(to_int128(1)))
		build = next
		elements = elements.append(element)
		made += 1
	(b1, value) = build.expression(ListLiteral(elements))
	(b2, name) = b1.written("value")
	(b3, span) = b2.next_span()
	(m1, global) = b3.mint.minted_global(PublicVisibility, None, ConstantGlobal, name, None, value, span)
	{ b3 | mint = m1 }.module_syntax([GlobalItem(global)], None)

pure func big_block(count: Int) -> ModuleSyntax:
	var build: SampleBuild = sample_build()
	var statements: List[Statement] = []
	var made: Int = 0
	while made <= count:
		(b0, element) = build.expression(IntegerLiteral(to_int128(1)))
		(next, line) = b0.statement(ExpressionStatement(element))
		build = next
		statements = statements.append(line)
		made += 1
	(b0, final) = build.expression(IntegerLiteral(to_int128(1)))
	(b1, last) = b0.statement(ExpressionStatement(final))
	(b2, body) = b1.block(statements, last)
	(b3, value) = b2.expression(DebugBlock(body))
	(b4, name) = b3.written("value")
	(b5, span) = b4.next_span()
	(m1, global) = b5.mint.minted_global(PublicVisibility, None, ConstantGlobal, name, None, value, span)
	{ b5 | mint = m1 }.module_syntax([GlobalItem(global)], None)

func measure(label: String, syntax: ModuleSyntax):
	reset_mem_stats()
	start = now()
	problems = id_census(sample_module(), syntax).length()
	stop = now()
	allocs = read_memory_counter(ManagedAllocations)
	raw = read_memory_counter(BackingMallocEvents)
	print("${label} problems=${problems} managed_allocs=${allocs} libc_malloc=${raw} us=${stop - start}")

func test_probe() -> Bool:
	for count in [250, 500, 1000, 2000, 4000]:
		measure("globals ${count}", many_globals(count))
	for count in [250, 500, 1000, 2000, 4000]:
		measure("block ${count}", big_block(count))
	for count in [250, 500, 1000, 2000, 4000]:
		measure("list ${count}", big_list(count))
	True

tests: TestSuite = {
	description = "probe",
	tests = [("probe", test_probe)]
}
