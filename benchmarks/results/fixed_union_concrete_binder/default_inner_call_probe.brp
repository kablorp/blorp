-- Retained same-path CTFE/runtime probe. Passing values alone do not prove folding.
-- Inspect the generated Core/C global and the selected outer/inner callable IDs.
import:
	test: TestSuite
	traits: Equatable


record Choice {
	value: Int
}


implements Equatable for Choice:
	pure func equals(left: Choice, right: Choice) -> Bool:
		False


CHOICE: Choice = {value = 1}

FOLDED_DEFAULT_NOT_EQUAL: Bool = CHOICE != CHOICE


pure func runtime_default_not_equal(left: Choice, right: Choice) -> Bool:
	left != right


func test_default_global_matches_custom_equals() -> Bool:
	FOLDED_DEFAULT_NOT_EQUAL


func test_default_runtime_matches_custom_equals() -> Bool:
	runtime_default_not_equal({value = 1}, {value = 1})


tests: TestSuite = {
	description = "Concrete accepted default inner call CTFE/runtime probe",
	tests = [
		("default global matches custom equals", test_default_global_matches_custom_equals),
		("default runtime matches custom equals", test_default_runtime_matches_custom_equals),
	]
}
