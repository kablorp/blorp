import:
	test: TestSuite
	traits: Equatable


record IndependentChoice {
	value: Int
}


implements Equatable for IndependentChoice:
	pure func equals(left: IndependentChoice, right: IndependentChoice) -> Bool:
		False

	pure func not_equals(left: IndependentChoice, right: IndependentChoice) -> Bool:
		False


INDEPENDENT_CHOICE: IndependentChoice = {value = 1}

FOLDED_INDEPENDENT_NOT_EQUAL: Bool = INDEPENDENT_CHOICE != INDEPENDENT_CHOICE


pure func runtime_independent_not_equal(left: IndependentChoice, right: IndependentChoice) -> Bool:
	left != right


func test_independent_not_equals_global() -> Bool:
	not FOLDED_INDEPENDENT_NOT_EQUAL


func test_independent_not_equals_runtime() -> Bool:
	not runtime_independent_not_equal({value = 1}, {value = 1})


tests: TestSuite = {
	description = "Explicit not_equals remains independent of equals",
	tests = [
		("independent not equals global", test_independent_not_equals_global),
		("independent not equals runtime", test_independent_not_equals_runtime),
	]
}
