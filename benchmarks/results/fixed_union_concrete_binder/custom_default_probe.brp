import:
	helpers/custom_equality: CustomEquality, disagrees
	test: TestSuite


record Choice {
	value: Int
}


implements CustomEquality for Choice:
	pure func agrees(left: Choice, right: Choice) -> Bool:
		False


CHOICE: Choice = {value = 1}

FOLDED_DISAGREES: Bool = CHOICE.disagrees(CHOICE)


pure func runtime_disagrees(left: Choice, right: Choice) -> Bool:
	left.disagrees(right)


func test_custom_default_global() -> Bool:
	FOLDED_DISAGREES


func test_custom_default_runtime() -> Bool:
	runtime_disagrees({value = 1}, {value = 1})


tests: TestSuite = {
	description = "Custom accepted default inner call CTFE/runtime probe",
	tests = [
		("custom default global", test_custom_default_global),
		("custom default runtime", test_custom_default_runtime),
	]
}
