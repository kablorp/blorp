import:
	helpers/action: Action, not_equals
	test: TestSuite


record Token {
	value: Int
}


implements Action for Token:
	pure func equals(left: Token, right: Token) -> Bool:
		False


func test_pure_implementation_of_impure_slot_remains_valid() -> Bool:
	value: Token = {value = 1}
	value.not_equals(value)


tests: TestSuite = {
	description = "Pure implementation of impure trait slot preservation",
	tests = [
		(
			"pure implementation of impure slot remains valid",
			test_pure_implementation_of_impure_slot_remains_valid,
		),
	]
}
