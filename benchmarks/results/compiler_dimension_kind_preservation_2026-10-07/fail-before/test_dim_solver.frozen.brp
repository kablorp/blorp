import:
	../../../../src/compiler/stage_06_typecheck/type_system/context: Context, meta_solver_session
	../../../../src/compiler/stage_06_typecheck/type_system/dim_solver:
		DimSolveResult(DimBindMeta, DimBindVar, DimContradiction, DimSolved, DimStuck),
		dim_solve,
	../../../../src/compiler/stage_06_typecheck/type_system/semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply),
		SemanticType(
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticTypeVar,
		),
		SemanticTypeVarKind(SemanticDimensionParameter, SemanticTypeParameter),
		type_to_string,
		types_equal,
	test: TestSuite
	meta_support: test_meta, test_meta_context


pure func dim_add(left: SemanticType, right: SemanticType) -> SemanticType:
	SemanticDimOpType(SemanticDimAdd, left, right)


pure func dim_mul(left: SemanticType, right: SemanticType) -> SemanticType:
	SemanticDimOpType(SemanticDimMultiply, left, right)


pure func dim_div(left: SemanticType, right: SemanticType) -> SemanticType:
	SemanticDimOpType(SemanticDimDivide, left, right)


pure func dim_var(name: String) -> SemanticType:
	SemanticTypeVar(name, SemanticDimensionParameter)


pure func dim_const(value: Int) -> SemanticType:
	SemanticConstIntType(value)


pure func test_dim_solve(
	context: Context,
	bindings: List[Option[SemanticType]],
	left: SemanticType,
	right: SemanticType,
) -> DimSolveResult:
	dim_solve(meta_solver_session(context), bindings, left, right)


func test_equivalent_sum_products_solve() -> Bool:
	context = test_meta_context()
	left: SemanticType = dim_mul(
		dim_const(2),
		dim_add(dim_var("#N"), dim_const(3)),
	)
	right: SemanticType = dim_add(
		dim_mul(dim_var("#N"), dim_const(2)),
		dim_const(6),
	)

	match test_dim_solve(context, [], left, right):
		DimSolved:
			True
		_:
			False


func test_exact_constant_division_solves() -> Bool:
	context = test_meta_context()
	left: SemanticType = dim_div(
		dim_mul(dim_const(8), dim_var("#N")),
		dim_const(4),
	)
	right: SemanticType = dim_mul(dim_const(2), dim_var("#N"))

	match test_dim_solve(context, [], left, right):
		DimSolved:
			True
		_:
			False


func test_single_dim_variable_binding() -> Bool:
	context = test_meta_context()

	match test_dim_solve(
		context,
		[],
		dim_add(dim_var("#N"), dim_const(1)),
		dim_const(5),
	):
		DimBindVar(name, value):
			name == "#N" and types_equal(value, dim_const(4))
		_:
			False


func test_single_meta_binding() -> Bool:
	context = test_meta_context()

	match test_dim_solve(
		context,
		[],
		dim_add(
			test_meta(context, 0),
			dim_const(2),
		),
		dim_const(5),
	):
		DimBindMeta(_, meta_id, value):
			meta_id == 0 and types_equal(value, dim_const(3))
		_:
			False


func test_uses_meta_bindings() -> Bool:
	context = test_meta_context()

	match test_dim_solve(
		context,
		[Some(dim_const(3))],
		dim_add(
			test_meta(context, 0),
			dim_const(2),
		),
		dim_const(5),
	):
		DimSolved:
			True
		_:
			False


func test_foreign_session_meta_does_not_read_same_slot_binding() -> Bool:
	context = test_meta_context()
	foreign_context = test_meta_context()
	foreign_meta = test_meta(foreign_context, 0)
	expression = dim_add(foreign_meta, dim_const(2))

	match test_dim_solve(context, [Some(dim_const(3))], expression, dim_const(5)):
		DimStuck:
			True
		_:
			False


func test_contradiction_and_stuck_are_distinct() -> Bool:
	context = test_meta_context()

	contradiction_ok: Bool = match test_dim_solve(context, [], dim_const(3), dim_const(5)):
		DimContradiction:
			True
		_:
			False

	stuck_ok: Bool = match test_dim_solve(
		context,
		[],
		dim_mul(dim_var("#N"), dim_var("#M")),
		dim_const(5),
	):
		DimStuck:
			True
		_:
			False

	contradiction_ok and stuck_ok


func test_linear_binding_can_keep_symbolic_remainder() -> Bool:
	context = test_meta_context()

	match test_dim_solve(
		context,
		[],
		dim_add(
			test_meta(context, 4),
			dim_const(1),
		),
		dim_add(dim_var("#N"), dim_const(2)),
	):
		DimBindMeta(_, meta_id, value):
			meta_id == 4 and type_to_string(value) == "#1 + #N"
		_:
			False


func test_opaque_division_distinguishes_meta_from_type_var_spelling() -> Bool:
	context = test_meta_context()
	left = dim_add(
		dim_const(1),
		dim_div(
			test_meta(context, 1),
			dim_const(3),
		),
	)
	right = dim_add(
		dim_const(1),
		dim_div(dim_var("?m1"), dim_const(3)),
	)

	match test_dim_solve(context, [], left, right):
		DimStuck:
			True
		_:
			False


func test_special_factor_permutation_and_multiplicity() -> Bool:
	context = test_meta_context()
	left = dim_mul(
		dim_mul(
			test_meta(context, 1),
			dim_var("#N"),
		),
		test_meta(context, 2),
	)
	right = dim_mul(
		test_meta(context, 2),
		dim_mul(
			dim_var("#N"),
			test_meta(context, 1),
		),
	)
	unequal = dim_mul(
		test_meta(context, 1),
		test_meta(context, 1),
	)
	other = dim_mul(
		test_meta(context, 1),
		test_meta(context, 2),
	)

	permutation_ok: Bool = match test_dim_solve(context, [], left, right):
		DimSolved:
			True
		_:
			False

	multiplicity_ok: Bool = match test_dim_solve(context, [], unequal, other):
		DimStuck:
			True
		_:
			False

	permutation_ok and multiplicity_ok


func test_opaque_division_equivalent_after_operand_normalization() -> Bool:
	context = test_meta_context()
	left = dim_add(
		dim_const(1),
		dim_div(
			dim_add(dim_var("#N"), dim_const(2)),
			dim_const(3),
		),
	)
	right = dim_add(
		dim_const(1),
		dim_div(
			dim_add(dim_const(2), dim_var("#N")),
			dim_const(3),
		),
	)

	match test_dim_solve(context, [], left, right):
		DimSolved:
			True
		_:
			False


func test_opaque_type_distinguishes_type_var_display_spelling() -> Bool:
	context = test_meta_context()
	-- Squared factors make this an equality check: neither side is isolatable.
	-- A single dimension factor can legitimately bind to the opaque type.
	opaque_type = SemanticNamedType("Foo", [])
	dimension = dim_var("Foo")
	left = dim_add(dim_const(1), dim_mul(opaque_type, opaque_type))
	right = dim_add(dim_const(1), dim_mul(dimension, dimension))

	match test_dim_solve(context, [], left, right):
		DimStuck:
			True
		_:
			False


func test_symbolic_meta_binding_reconstructs_opaque_division() -> Bool:
	context = test_meta_context()
	division = dim_div(dim_var("#N"), dim_const(3))

	match test_dim_solve(
		context,
		[],
		dim_add(
			test_meta(context, 2),
			division,
		),
		dim_const(5),
	):
		DimBindMeta(_, meta_id, value):
			if meta_id != 2:
				False
			else:
				match test_dim_solve(
					context,
					[],
					dim_add(value, division),
					dim_const(5),
				):
					DimSolved:
						True
					_:
						False
		_:
			False


func test_special_terms_commute_and_distribute() -> Bool:
	context = test_meta_context()
	first = dim_div(dim_var("#N"), dim_const(3))
	second = dim_div(dim_var("#M"), dim_const(3))

	commuted: Bool = match test_dim_solve(
		context,
		[],
		dim_add(first, second),
		dim_add(second, first),
	):
		DimSolved:
			True
		_:
			False

	left = dim_mul(
		test_meta(context, 1),
		dim_add(
			test_meta(context, 2),
			test_meta(context, 3),
		),
	)
	right = dim_add(
		dim_mul(
			test_meta(context, 1),
			test_meta(context, 2),
		),
		dim_mul(
			test_meta(context, 1),
			test_meta(context, 3),
		),
	)

	distributed: Bool = match test_dim_solve(context, [], left, right):
		DimSolved:
			True
		_:
			False

	commuted and distributed


func test_meta_binding_choice_is_independent_of_sum_order() -> Bool:
	context = test_meta_context()
	forward = dim_add(
		test_meta(context, 1),
		test_meta(context, 2),
	)
	reversed = dim_add(
		test_meta(context, 2),
		test_meta(context, 1),
	)

	forward_choice: Bool = match test_dim_solve(context, [], forward, dim_const(5)):
		DimBindMeta(_, meta_id, _):
			meta_id == 1
		_:
			False

	reverse_choice: Bool = match test_dim_solve(context, [], reversed, dim_const(5)):
		DimBindMeta(_, meta_id, _):
			meta_id == 1
		_:
			False

	forward_choice and reverse_choice


func test_nested_opaque_division_preserves_meta_identity() -> Bool:
	context = test_meta_context()
	left = dim_add(
		dim_const(1),
		dim_div(
			dim_add(
				dim_const(1),
				dim_div(
					test_meta(context, 1),
					dim_const(3),
				),
			),
			dim_const(5),
		),
	)
	right = dim_add(
		dim_const(1),
		dim_div(
			dim_add(
				dim_const(1),
				dim_div(dim_var("?m1"), dim_const(3)),
			),
			dim_const(5),
		),
	)

	match test_dim_solve(context, [], left, right):
		DimStuck:
			True
		_:
			False


func test_symbolic_binding_values_are_equivalent_across_opaque_term_order() -> Bool:
	context = test_meta_context()
	first = dim_div(dim_var("#N"), dim_const(3))
	second = dim_div(dim_var("#M"), dim_const(5))
	forward = dim_add(
		test_meta(context, 1),
		dim_add(first, second),
	)
	reversed = dim_add(
		test_meta(context, 1),
		dim_add(second, first),
	)

	match (
		test_dim_solve(context, [], forward, dim_const(7)),
		test_dim_solve(context, [], reversed, dim_const(7)),
	):
		(DimBindMeta(_, first_id, first_value), DimBindMeta(_, second_id, second_value)):
			if first_id != 1 or second_id != 1:
				False
			else:
				match test_dim_solve(context, [], first_value, second_value):
					DimSolved:
						True
					_:
						False
		_:
			False


func test_named_binding_choice_is_independent_of_opaque_term_order() -> Bool:
	context = test_meta_context()
	opaque_term = dim_div(dim_var("#Q"), dim_const(3))
	forward = dim_add(
		dim_add(dim_var("#N"), opaque_term),
		dim_var("#M"),
	)
	reversed = dim_add(
		dim_add(dim_var("#M"), opaque_term),
		dim_var("#N"),
	)

	forward_choice: Bool = match test_dim_solve(context, [], forward, dim_const(7)):
		DimBindVar(name, _):
			name == "#M"
		_:
			False

	reverse_choice: Bool = match test_dim_solve(context, [], reversed, dim_const(7)):
		DimBindVar(name, _):
			name == "#M"
		_:
			False

	forward_choice and reverse_choice


func test_dimension_kind_solves_without_sigil() -> Bool:
	context = test_meta_context()

	match test_dim_solve(context, [], dim_add(dim_var("Rows"), dim_const(1)), dim_const(5)):
		DimBindVar(name, value):
			name == "Rows" and types_equal(value, dim_const(4))
		_:
			False


func test_ordinary_kind_does_not_solve_from_sigil() -> Bool:
	context = test_meta_context()
	ordinary = SemanticTypeVar("#Rows", SemanticTypeParameter)

	match test_dim_solve(context, [], dim_add(ordinary, dim_const(1)), dim_const(5)):
		DimStuck:
			True
		_:
			False


func test_same_spelling_kinds_bind_without_cancelling() -> Bool:
	context = test_meta_context()
	var preserved = True

	for name in ["Parameter", "#Parameter"]:
		ordinary = SemanticTypeVar(name, SemanticTypeParameter)
		bound: Bool = match test_dim_solve(
			context,
			[],
			dim_add(dim_var(name), dim_const(1)),
			dim_add(ordinary, dim_const(1)),
		):
			DimBindVar(bound_name, value):
				bound_name == name and types_equal(value, ordinary)
			_:
				False
		preserved = preserved and bound

	preserved


func test_meta_binding_preserves_no_sigil_dimension_kind() -> Bool:
	context = test_meta_context()
	dimension = dim_var("Rows")
	expected = dim_add(dim_const(5), dim_mul(dim_const(-1), dimension))

	match test_dim_solve(
		context,
		[],
		dim_add(test_meta(context, 1), dimension),
		dim_const(5),
	):
		DimBindMeta(_, meta_id, value):
			meta_id == 1 and types_equal(value, expected)
		_:
			False


func test_meta_binding_preserves_sigil_looking_ordinary_kind() -> Bool:
	context = test_meta_context()
	ordinary = SemanticTypeVar("#Element", SemanticTypeParameter)
	expected = dim_add(dim_const(5), dim_mul(dim_const(-1), ordinary))

	match test_dim_solve(
		context,
		[],
		dim_add(test_meta(context, 1), ordinary),
		dim_const(5),
	):
		DimBindMeta(_, meta_id, value):
			meta_id == 1 and types_equal(value, expected)
		_:
			False


func test_named_isolation_keeps_ordinary_remainder() -> Bool:
	context = test_meta_context()
	ordinary = SemanticTypeVar("#Element", SemanticTypeParameter)
	expected = dim_add(dim_const(7), dim_mul(dim_const(-1), ordinary))

	match test_dim_solve(
		context,
		[],
		dim_add(dim_var("Rows"), ordinary),
		dim_const(7),
	):
		DimBindVar(name, value):
			name == "Rows" and types_equal(value, expected)
		_:
			False


func test_mixed_candidates_prefer_meta_and_preserve_kinds() -> Bool:
	context = test_meta_context()
	dimension = dim_var("Rows")
	ordinary = SemanticTypeVar("#Element", SemanticTypeParameter)
	expected = dim_add(
		dim_add(dim_const(7), dim_mul(dim_const(-1), dimension)),
		dim_mul(dim_const(-1), ordinary),
	)

	match test_dim_solve(
		context,
		[],
		dim_add(test_meta(context, 2), dim_add(dimension, ordinary)),
		dim_const(7),
	):
		DimBindMeta(_, meta_id, value):
			meta_id == 2 and types_equal(value, expected)
		_:
			False


func test_opaque_ordinary_factors_commute_and_keep_multiplicity() -> Bool:
	context = test_meta_context()
	first = SemanticTypeVar("#Element", SemanticTypeParameter)
	second = SemanticTypeVar("Item", SemanticTypeParameter)

	commuted: Bool = match test_dim_solve(
		context,
		[],
		dim_mul(first, second),
		dim_mul(second, first),
	):
		DimSolved:
			True
		_:
			False

	multiplicity: Bool = match test_dim_solve(
		context,
		[],
		dim_mul(first, first),
		dim_mul(first, second),
	):
		DimStuck:
			True
		_:
			False

	commuted and multiplicity


tests: TestSuite = {
	description = "Compiler dimension solver",
	tests = [
		("equivalent sum products solve", test_equivalent_sum_products_solve),
		("exact constant division solves", test_exact_constant_division_solves),
		("single dim variable binding", test_single_dim_variable_binding),
		("single meta binding", test_single_meta_binding),
		("uses meta bindings", test_uses_meta_bindings),
		(
			"foreign-session meta does not read same-slot binding",
			test_foreign_session_meta_does_not_read_same_slot_binding,
		),
		("contradiction and stuck are distinct", test_contradiction_and_stuck_are_distinct),
		(
			"linear binding can keep symbolic remainder",
			test_linear_binding_can_keep_symbolic_remainder,
		),
		(
			"opaque division distinguishes meta from type variable spelling",
			test_opaque_division_distinguishes_meta_from_type_var_spelling,
		),
		(
			"special factor permutation and multiplicity",
			test_special_factor_permutation_and_multiplicity,
		),
		(
			"opaque division equivalent after operand normalization",
			test_opaque_division_equivalent_after_operand_normalization,
		),
		(
			"opaque type distinguishes type variable display spelling",
			test_opaque_type_distinguishes_type_var_display_spelling,
		),
		(
			"symbolic meta binding reconstructs opaque division",
			test_symbolic_meta_binding_reconstructs_opaque_division,
		),
		("special terms commute and distribute", test_special_terms_commute_and_distribute),
		(
			"meta binding choice is independent of sum order",
			test_meta_binding_choice_is_independent_of_sum_order,
		),
		(
			"nested opaque division preserves meta identity",
			test_nested_opaque_division_preserves_meta_identity,
		),
		(
			"symbolic binding values are equivalent across opaque term order",
			test_symbolic_binding_values_are_equivalent_across_opaque_term_order,
		),
		(
			"named binding choice is independent of opaque term order",
			test_named_binding_choice_is_independent_of_opaque_term_order,
		),
		("dimension kind solves without sigil", test_dimension_kind_solves_without_sigil),
		("ordinary kind does not solve from sigil", test_ordinary_kind_does_not_solve_from_sigil),
		(
			"same spelling kinds bind without cancelling",
			test_same_spelling_kinds_bind_without_cancelling,
		),
		(
			"meta binding preserves no-sigil dimension kind",
			test_meta_binding_preserves_no_sigil_dimension_kind,
		),
		(
			"meta binding preserves sigil-looking ordinary kind",
			test_meta_binding_preserves_sigil_looking_ordinary_kind,
		),
		("named isolation keeps ordinary remainder", test_named_isolation_keeps_ordinary_remainder),
		(
			"mixed candidates prefer meta and preserve kinds",
			test_mixed_candidates_prefer_meta_and_preserve_kinds,
		),
		(
			"opaque ordinary factors commute and keep multiplicity",
			test_opaque_ordinary_factors_commute_and_keep_multiplicity,
		),
	]
}
