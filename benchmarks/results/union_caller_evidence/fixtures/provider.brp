import:
	forward: forwarded, forwarded_render, forwarded_select
	option: Option(Some)
	selector: Selector


fixed union Choice:
	First
	Second


private implements Equatable for Choice:
	pure func equals(left: Choice, right: Choice) -> Bool:
		True

	pure func not_equals(left: Choice, right: Choice) -> Bool:
		False


record Box {
	value: Int
}


private implements Selector for Box:
	pure func marker(value: Box) -> Int:
		11


private implements Stringable for Box:
	pure func to_string(value: Box) -> String:
		"selected-private-box"


pure func provider_forwarded() -> Bool:
	forwarded(First, Second)


pure func provider_list() -> Bool:
	forwarded([First], [Second])


pure func provider_option() -> Bool:
	forwarded(Some(First), Some(Second))


pure func provider_selector() -> Int:
	box: Box = {value = 1}
	forwarded_select(box)


pure func provider_stringable() -> String:
	box: Box = {value = 1}
	forwarded_render(box)
