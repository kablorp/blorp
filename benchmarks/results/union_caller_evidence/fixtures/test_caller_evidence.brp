-- Retained pending runtime witness: current-base source legality was checked;
-- exact execution produced 5 PASS/5 FAIL, not caller-evidence acceptance.
import:
	forward: forwarded
	option: Option(Some)
	provider:
		Choice(First, Second), provider_forwarded, provider_list, provider_option,
		provider_selector, provider_stringable
	test: TestSuite


FOLDED_PROVIDER: Bool = provider_forwarded()

FOLDED_IMPORTER: Bool = forwarded(First, Second)


func test_provider_keeps_private_evidence() -> Bool:
	provider_forwarded()


func test_importer_keeps_compiler_evidence() -> Bool:
	not forwarded(First, Second)


func test_provider_list_keeps_element_evidence() -> Bool:
	provider_list()


func test_importer_list_keeps_element_evidence() -> Bool:
	not forwarded([First], [Second])


func test_provider_option_keeps_payload_evidence() -> Bool:
	provider_option()


func test_importer_option_keeps_payload_evidence() -> Bool:
	not forwarded(Some(First), Some(Second))


func test_provider_ctfe_agrees() -> Bool:
	FOLDED_PROVIDER and provider_forwarded()


func test_importer_ctfe_agrees() -> Bool:
	not FOLDED_IMPORTER and not forwarded(First, Second)


func test_user_trait_keeps_exact_member() -> Bool:
	provider_selector() == 11


func test_stringable_keeps_exact_member() -> Bool:
	provider_stringable() == "selected-private-box"


tests: TestSuite = {
	description = "Caller-selected trait evidence",
	tests = [
		("provider keeps private evidence", test_provider_keeps_private_evidence),
		("importer keeps compiler evidence", test_importer_keeps_compiler_evidence),
		("provider List keeps element evidence", test_provider_list_keeps_element_evidence),
		("importer List keeps element evidence", test_importer_list_keeps_element_evidence),
		("provider Option keeps payload evidence", test_provider_option_keeps_payload_evidence),
		("importer Option keeps payload evidence", test_importer_option_keeps_payload_evidence),
		("provider CTFE agrees", test_provider_ctfe_agrees),
		("importer CTFE agrees", test_importer_ctfe_agrees),
		("user trait keeps exact member", test_user_trait_keeps_exact_member),
		("Stringable keeps exact member", test_stringable_keeps_exact_member),
	]
}
