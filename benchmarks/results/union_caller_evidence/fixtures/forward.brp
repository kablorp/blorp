import:
	same: same
	selector: Selector, marker


pure func forwarded[T: Equatable](left: T, right: T) -> Bool:
	same(left, right)


pure func rendered[T: Stringable](value: T) -> String:
	value.to_string()


pure func forwarded_render[T: Stringable](value: T) -> String:
	rendered(value)


pure func selected[T: Selector](value: T) -> Int:
	value.marker()


pure func forwarded_select[T: Selector](value: T) -> Int:
	selected(value)
