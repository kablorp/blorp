import:
	../../../../blorp/src/compiler/stage_06_typecheck/type_system/builtins:
		BUILTIN_TRAIT_NAMES, builtin_trait_member_declaration, env_with_builtins
	../../../../blorp/src/compiler/stage_06_typecheck/type_system/env: ENV_EMPTY, env_get_trait_by_id
	../../../../blorp/src/compiler/stage_06_typecheck/type_system/trait_identity:
		builtin_trait_id_at_registry_index, trait_ids_equal
	io: print


private FIRST_DEFINITION: Int = 100


func main(args: List[String]) -> Int:
	env = env_with_builtins(ENV_EMPTY)
	result = BUILTIN_TRAIT_NAMES.enumerate().all(func(indexed):
		id = builtin_trait_id_at_registry_index(indexed[0])
		env_get_trait_by_id(env, id).map(func(declaration):
			(
				declaration.def_id == FIRST_DEFINITION + indexed[0]
				and declaration.name == indexed[1]
				and declaration.methods.enumerate().all(func(method):
					builtin_trait_member_declaration(id, method[1].name)
						.map(func(found): trait_ids_equal(found[0], id) and found[1] == method[0])
						.get_or(False)
				)
			)
		).get_or(False)
	)
	print(result)
	0
