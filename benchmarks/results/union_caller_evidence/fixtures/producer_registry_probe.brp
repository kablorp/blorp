import:
	../../../../blorp/src/compiler/stage_06_typecheck/type_system/builtins:
		builtin_trait_evidence_members,
		builtin_trait_evidence_registry,
	../../../../blorp/src/compiler/stage_06_typecheck/type_system/trait_identity: TRAIT_ID_ORDERABLE


func main(args: List[String]):
	match builtin_trait_evidence_registry():
		Ok(registry):
			match builtin_trait_evidence_members(registry, TRAIT_ID_ORDERABLE):
				Ok(members):
					print(members.length() + args.length())
				Err(message):
					print(message)
		Err(message):
			print(message)
