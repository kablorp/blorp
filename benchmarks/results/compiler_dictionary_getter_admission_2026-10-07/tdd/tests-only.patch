+								(CallExpr(BuiltinCall("blorp_dict_get_nullable"), _, [VarExpr(map_ref, _, _), VarExpr(key_ref, _, _)], _, _), SeqExpr(CallExpr(IntrinsicCall("release_hash_key_box"), _, [VarExpr(released_key, _, _)], _, _), VarExpr(found_ref, _, _))):
+									(
+										same_core_expr(map_value, make_dict)
+										and box.kind == Int128Box
+										and box.source_type == wide_type
+										and same_core_expr(box.value, key)
+										and map_binding.name == map_ref.name
+										and key_binding.name == key_ref.name
+										and key_binding.name == released_key.name
+										and found_binding.name == found_ref.name
+									)
+								_:
+									False
+						_:
+							False
+				_:
+					False
+		_:
+			False
