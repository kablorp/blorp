+	match result:
+		LetExpr(map_binding, False, _, map_value, boxed_lookup):
+			match boxed_lookup:
+				LetExpr(key_binding, False, _, BoxExpr(box, _, _), bound_found):
+					match bound_found:
+						LetExpr(found_binding, False, _, lookup, release_then_found):
