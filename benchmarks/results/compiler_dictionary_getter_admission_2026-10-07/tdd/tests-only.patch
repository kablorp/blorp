+pure func test_generic_dict_get_evaluates_map_before_fresh_key_box() -> Bool:
+	wide_type: CoreType = named_type("Int128")
+	dict_type: CoreType = NamedType("Dict", [wide_type, named_type("String")])
+	make_dict: CoreExpr = call("make_dict", [], dict_type)
+	key: CoreExpr = variable("key", wide_type)
+	result: CoreExpr = specialized(call(
+			"blorp_dict_get", [make_dict, key], option_type(named_type("String")),
+		))
