import:
	../../../src/compiler/stage_09_core/ir:
		CoreBoxKind(FloatBox, PointerBox, PrimBox, StructBox),
		CoreCallKind(BuiltinCall, IntrinsicCall),
		CoreDecl(EnumDecl, HeapRecordDecl, TypeAliasDecl),
		CoreExpr(
			BoxExpr,
			CallExpr,
			CastExpr,
			ConstructorMatchExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			LiteralExpr,
			SeqExpr,
			UnboxExpr,
			VarExpr,
			VoidExpr,
		),
		CoreListStorageLayout(InlineListStorage),
		CoreLiteral(IntLiteral),
		CoreRecordForm(OrdinaryRecordForm),
		CoreProgram,
		CoreSourceLoc,
		synthetic_core_source_loc,
		CoreTensorDim(TensorStaticDim),
		CoreType(
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			StackResultType,
			TensorType,
			TupleType,
			VoidType,
		),
		CoreUnboxKind(PointerUnbox, StructUnbox),
		CoreBinderOrigin(AuthoredBinder),
		CoreVar,
		core_expr_to_json,
	../../../src/compiler/stage_09_core/specialize_collection: specialize_collection_expr
	../../../src/compiler/stage_09_core/specialize_layout:
		CoreSpecializeLayout,
		build_specialize_layout,
	../../../src/compiler/stage_09_core/traverse: immediate_core_expr_children
	test: TestSuite


private pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


private pure func core_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None,
		origin = AuthoredBinder
	}


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, synthetic_core_source_loc())


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), named_type("Int"), synthetic_core_source_loc())


private pure func call(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, synthetic_core_source_loc()),
		args,
		typ,
		synthetic_core_source_loc(),
	)


private pure func intrinsic(name: String, args: List[CoreExpr], typ: CoreType) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, synthetic_core_source_loc()),
		args,
		typ,
		synthetic_core_source_loc(),
	)


private pure func function_type(params: List[CoreType], result: CoreType) -> CoreType:
	FunctionType(True, params, result)


private pure func list_type(element: CoreType) -> CoreType:
	NamedType("List", [element])


private pure func stream_type(element: CoreType) -> CoreType:
	NamedType("Stream", [element])


private pure func option_type(payload: CoreType) -> CoreType:
	NamedType("Option", [payload])


private pure func tensor_type(element: CoreType, dims: List[Int]) -> CoreType:
	TensorType({
		element_type = element,
		dims = dims.map(func(dim): TensorStaticDim(dim)),
	})


private pure func collection_program() -> CoreProgram:
	{
		decls = [
			TypeAliasDecl({
				abi_type = None,
				name = "Name",
				type_params = [],
				target = named_type("String"),
				is_opaque = False,
				loc = synthetic_core_source_loc(),
			}),
			TypeAliasDecl({
				abi_type = None,
				name = "Number",
				type_params = [],
				target = named_type("Int"),
				is_opaque = False,
				loc = synthetic_core_source_loc(),
			}),
			TypeAliasDecl({
				abi_type = None,
				name = "MaybeName",
				type_params = [],
				target = option_type(named_type("Name")),
				is_opaque = False,
				loc = synthetic_core_source_loc(),
			}),
			TypeAliasDecl({
				abi_type = None,
				name = "Shade",
				type_params = [],
				target = named_type("Color"),
				is_opaque = False,
				loc = synthetic_core_source_loc(),
			}),
			EnumDecl({
				abi_type = None,
				name = "Color",
				type_params = [],
				variants = [
					{
						name = "Red",
						tag = 0,
						def_id = None
					},
					{
						name = "Blue",
						tag = 1,
						def_id = None
					},
				],
				loc = synthetic_core_source_loc(),
			}),
			HeapRecordDecl({
				abi_type = None,
				form = OrdinaryRecordForm,
				name = "Pair",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			}),
			HeapRecordDecl({
				abi_type = None,
				form = OrdinaryRecordForm,
				name = "Widget",
				type_params = [],
				fields = [],
				loc = synthetic_core_source_loc(),
			}),
		],
		foreign_includes = [],
		source_files = []
	}


private pure func collection_layout() -> CoreSpecializeLayout:
	build_specialize_layout(collection_program())


private pure func specialized(expr: CoreExpr) -> CoreExpr:
	specialize_collection_expr(collection_layout(), expr)


private pure func is_int_literal(expr: CoreExpr, expected: Int) -> Bool:
	match expr:
		LiteralExpr(IntLiteral(value), _, _):
			value == expected
		_:
			False


private pure func call_name(expr: CoreExpr) -> Option[String]:
	match expr:
		CallExpr(BuiltinCall(name), _, _, _, _):
			Some(name)
		CallExpr(IntrinsicCall(name), _, _, _, _):
			Some(name)
		_:
			None


private pure func call_last_int_is(expr: CoreExpr, expected: Int) -> Bool:
	match expr:
		CallExpr(BuiltinCall(_), _, args, _, _):
			match args.last():
				Some(last):
					is_int_literal(last, expected)
				None:
					False
		_:
			False


private pure func contains_call(expr: CoreExpr, expected: String) -> Bool:
	if call_name(expr) == Some(expected):
		True
	else:
		var found: Bool = False

		for child in immediate_core_expr_children(expr):
			if contains_call(child, expected):
				found = True
				break

		found


private pure func contains_constructor_match(expr: CoreExpr) -> Bool:
	match expr:
		ConstructorMatchExpr(_, _, _, _, _, _):
			True
		_:
			var found: Bool = False

			for child in immediate_core_expr_children(expr):
				if contains_constructor_match(child):
					found = True
					break

			found


private pure func both_pointer_boxes(left: CoreExpr, right: CoreExpr) -> Bool:
	match (left, right):
		(BoxExpr(_, NamedType("Ptr", []), _), BoxExpr(_, NamedType("Ptr", []), _)):
			True
		_:
			False


private pure func dict_get_boxes_key(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(_, _, [_, BoxExpr(_, NamedType("Ptr", []), _)], _, _):
			True
		_:
			False


private pure func same_core_expr(left: CoreExpr, right: CoreExpr) -> Bool:
	core_expr_to_json(left).to_string() == core_expr_to_json(right).to_string()


private pure func int_key_dict_get(name: String, payload: CoreType) -> CoreExpr:
	call(
		name,
		[variable("dict", NamedType("Dict", [named_type("Int"), payload])), int_literal(1)],
		option_type(payload),
	)


private pure func dict_get_has_one_int_key_box(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(_, _, [VarExpr(_, _, _), BoxExpr(box, NamedType("Ptr", []), _)], _, _):
			(
				box.kind == PrimBox
				and box.source_type == named_type("Int")
				and is_int_literal(box.value, 1)
			)
		_:
			False


private pure func unfold_has_layouts(expr: CoreExpr, element: Int, state: Int) -> Bool:
	match expr:
		CallExpr(BuiltinCall("blorp_stream_unfold"), _, [BoxExpr(_, NamedType("Ptr", []), _), _, element_layout, state_layout], _, _):
			is_int_literal(element_layout, element) and is_int_literal(state_layout, state)
		_:
			False


private pure func stream_repeat_boxes_immediate(expr: CoreExpr) -> Bool:
	serialized: String = core_expr_to_json(expr).to_string()

	(
		serialized.contains("\"name\":\"blorp_stream_repeat\"")
		and serialized.contains("\"kind\":\"box\"")
		and serialized.contains("\"kind\":{\"kind\":\"prim\"}")
	)


private pure func unfold_has_trailing_layouts(expr: CoreExpr, element: Int, state: Int) -> Bool:
	match expr:
		CallExpr(BuiltinCall("blorp_stream_unfold"), _, [_, _, element_layout, state_layout], _, _):
			is_int_literal(element_layout, element) and is_int_literal(state_layout, state)
		_:
			False


private pure func fold_has_pointer_and_release(expr: CoreExpr) -> Bool:
	match expr:
		CastExpr(CallExpr(BuiltinCall("blorp_fold_parallel_with"), _, args, NamedType("Ptr", []), _), HeapRecordType("Pair"), _):
			match args:
				[_, VarExpr(_, HeapRecordType("Pair"), _), _, _, release_flag]:
					is_int_literal(release_flag, 1)
				_:
					False
		_:
			False


private pure func no_boxed_fold_initial_value(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(_, _, [_, LiteralExpr(_, _, _), _], _, _):
			True
		_:
			False


private pure func no_boxed_set_contains_value(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(_, _, [_, LiteralExpr(_, _, _)], _, _):
			True
		_:
			False


private pure func set_add_boxes_element(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(BuiltinCall("blorp_set_add"), _, [VarExpr(_, _, _), BoxExpr(_, NamedType("Ptr", []), _)], _, _):
			True
		_:
			False


private pure func set_add_refines_empty_constructor(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(_, _, args, _, _):
			match args.get(0):
				Some(CallExpr(kind, _, constructor_args, _, _)):
					match kind:
						BuiltinCall(name):
							name == "blorp_set_new" and constructor_args.is_empty()
						_:
							False
				_:
					False
		_:
			False


private pure func immediate_dict_insert_is_refined(expr: CoreExpr) -> Bool:
	match expr:
		CallExpr(BuiltinCall("blorp_dict_insert"), _, [CallExpr(BuiltinCall("blorp_dict_new"), _, [], NamedType("Dict", [NamedType("Shade", []), NamedType("Int", [])]), _), key, value], _, _):
			both_pointer_boxes(key, value)
		_:
			False


private pure func parallel_filter_map_fallback_shape(expr: CoreExpr) -> Bool:
	var found: Bool = False

	if contains_call(expr, "list_alloc"):
		found = (
			contains_call(expr, "list_set_owned")
			and contains_call(expr, "list_set_len")
			and contains_constructor_match(expr)
		)

	found


pure func test_list_alloc_uses_concrete_layout() -> Bool:
	result: CoreExpr = specialized(
		intrinsic(
			"list_alloc",
			[int_literal(4)],
			list_type(named_type("Int")),
		),
	)

	match result:
		ListAllocExpr(alloc, NamedType("List", [NamedType("Int", [])]), _):
			match alloc.layout:
				InlineListStorage(8):
					not alloc.elem_needs_release
				_:
					False
		_:
			False


pure func test_stale_pointer_cast_of_float_is_reboxed() -> Bool:
	float_type: CoreType = named_type("Float")

	match specialized(
		CastExpr(
			variable("value", float_type),
			named_type("Ptr"),
			synthetic_core_source_loc(),
		),
	):
		BoxExpr(box, NamedType("Ptr", []), _):
			box.kind == FloatBox and box.source_type == float_type
		_:
			False


pure func test_list_alloc_alias_enum_uses_registry_layout() -> Bool:
	result: CoreExpr = specialized(
		call(
			"blorp_list_new",
			[int_literal(4)],
			list_type(named_type("Shade")),
		),
	)

	match result:
		ListAllocExpr(alloc, NamedType("List", [NamedType("Shade", [])]), _):
			match alloc.layout:
				InlineListStorage(1):
					not alloc.elem_needs_release
				_:
					False
		_:
			False


pure func test_erased_stack_result_metadata_is_canonicalized() -> Bool:
	result_type: CoreType = StackResultType(named_type("Int"), named_type("String"))
	list_result_type: CoreType = list_type(result_type)
	stale: CoreExpr = ListConstructExpr(
		{
			layout = InlineListStorage(8),
			elements = [
				{
					kind = PointerBox,
					value = variable("result", result_type),
					needs_release = False,
					transfers_ownership = False
				},
			],
			elem_needs_release = False
		},
		list_result_type,
		synthetic_core_source_loc(),
	)

	match specialized(stale):
		ListConstructExpr(construct, _, _):
			match construct.elements:
				[boxed]:
					match boxed.kind:
						StructBox("blorp_StackResult"):
							boxed.needs_release
						_:
							False
				_:
					False
		_:
			False


pure func test_box_and_unbox_metadata_is_canonicalized() -> Bool:
	pair_type: CoreType = HeapRecordType("Pair")
	value: CoreExpr = variable("pair", pair_type)
	stale_box: CoreExpr = BoxExpr(
		{
			kind = PointerBox,
			value = value,
			source_type = pair_type
		},
		named_type("Ptr"),
		synthetic_core_source_loc(),
	)
	stale_unbox: CoreExpr = UnboxExpr(
		PointerUnbox,
		variable("raw", named_type("Ptr")),
		pair_type,
		synthetic_core_source_loc(),
	)

	match (specialized(stale_box), specialized(stale_unbox)):
		(CastExpr(VarExpr(_, HeapRecordType("Pair"), _), NamedType("Ptr", []), _), UnboxExpr(PointerUnbox, _, HeapRecordType("Pair"), _)):
			True
		_:
			False


pure func test_managed_void_slot_box_becomes_borrowed_cast() -> Bool:
	boxed: CoreExpr = BoxExpr(
		{
			kind = PointerBox,
			value = variable("text", named_type("String")),
			source_type = named_type("String")
		},
		named_type("Ptr"),
		synthetic_core_source_loc(),
	)

	match specialized(boxed):
		CastExpr(VarExpr(variable, NamedType("String", []), _), NamedType("Ptr", []), _):
			variable.name == "text"
		_:
			False


pure func test_hash_container_constructor_dispatch() -> Bool:
	string_set: CoreExpr = call(
		"blorp_set_new",
		[],
		NamedType("Set", [named_type("String")]),
	)
	float_dict: CoreExpr = call(
		"blorp_dict_new",
		[],
		NamedType(
			"Dict",
			[named_type("Float"), named_type("Int")],
		),
	)
	alias_capacity: CoreExpr = call(
		"blorp_dict_with_capacity",
		[int_literal(8)],
		NamedType(
			"Dict",
			[named_type("Name"), named_type("Int")],
		),
	)
	record_dict: CoreExpr = call(
		"blorp_dict_new",
		[],
		NamedType(
			"Dict",
			[HeapRecordType("Widget"), named_type("Int")],
		),
	)

	(
		call_name(specialized(string_set)) == Some("blorp_set_new_string")
		and call_name(specialized(float_dict)) == Some("blorp_dict_new_float")
		and call_name(specialized(alias_capacity)) == Some("blorp_dict_with_capacity_string")
		and call_name(specialized(record_dict)) == Some("blorp_dict_new_custom")
	)


pure func test_int128_hash_container_constructor_dispatch() -> Bool:
	int128_dict: CoreExpr = call(
		"blorp_dict_new",
		[],
		NamedType(
			"Dict",
			[named_type("Int128"), named_type("String")],
		),
	)
	uint128_set: CoreExpr = call(
		"blorp_set_new",
		[],
		NamedType("Set", [named_type("UInt128")]),
	)
	uint128_capacity: CoreExpr = call(
		"blorp_dict_with_capacity",
		[int_literal(8)],
		NamedType(
			"Dict",
			[named_type("UInt128"), named_type("Int")],
		),
	)

	(
		call_name(specialized(int128_dict)) == Some("blorp_dict_new_int128")
		and call_name(specialized(uint128_set)) == Some("blorp_set_new_int128")
		and call_name(specialized(uint128_capacity)) == Some("blorp_dict_with_capacity_int128")
	)


pure func test_immediate_dict_constructor_refinement_and_boxing() -> Bool:
	dict_type: CoreType = NamedType(
		"Dict",
		[named_type("Shade"), named_type("Int")],
	)
	dict_new: CoreExpr = call("blorp_dict_new", [], dict_type)
	result: CoreExpr = specialized(
		call(
			"blorp_dict_insert",
			[dict_new, variable("key", named_type("Shade")), int_literal(1)],
			dict_type,
		),
	)

	immediate_dict_insert_is_refined(result)


private pure func is_intrinsic_named(expr: CoreExpr, expected: String) -> Bool:
	match expr:
		CallExpr(IntrinsicCall(name), _, _, _, _):
			name == expected
		_:
			False


private pure func is_void(expr: CoreExpr) -> Bool:
	match expr:
		VoidExpr(_, _):
			True
		_:
			False


private pure func erased_key_marker(source: CoreExpr) -> CoreExpr:
	intrinsic(
		"release_erased_key_temp",
		[variable("__key_temp", named_type("Ptr")), source],
		VoidType,
	)


pure func test_erased_key_marker_does_not_release_managed_record() -> Bool:
	is_void(specialized(erased_key_marker(variable("key", HeapRecordType("Pair")))))


pure func test_erased_key_marker_releases_stack_option_box() -> Bool:
	is_intrinsic_named(
		specialized(erased_key_marker(variable("key", option_type(named_type("Int"))))),
		"release_hash_key_box",
	)


pure func test_erased_key_marker_releases_int128_box() -> Bool:
	is_intrinsic_named(
		specialized(erased_key_marker(variable("key", named_type("Int128")))),
		"release_hash_key_box",
	)


pure func test_erased_key_marker_is_void_for_pointer_and_word_keys() -> Bool:
	(
		is_void(specialized(erased_key_marker(variable("key", named_type("String")))))
		and is_void(specialized(erased_key_marker(variable("key", named_type("Int")))))
	)


pure func test_set_add_boxes_only_the_element() -> Bool:
	set_type: CoreType = NamedType("Set", [named_type("Int")])

	set_add_boxes_element(
		specialized(
			call(
				"blorp_set_add",
				[variable("set", set_type), int_literal(1)],
				set_type,
			),
		),
	)


pure func test_set_add_refines_empty_constructor() -> Bool:
	set_type: CoreType = NamedType("Set", [named_type("Int")])

	set_add_refines_empty_constructor(
		specialized(
			call(
				"blorp_set_add",
				[call("blorp_set_new", [], set_type), int_literal(1)],
				set_type,
			),
		),
	)


pure func test_non_void_slot_collection_calls_remain_unboxed() -> Bool:
	set_type: CoreType = NamedType("Set", [named_type("Int")])
	list_int: CoreType = list_type(named_type("Int"))
	contains: CoreExpr = specialized(
		call(
			"blorp_set_contains",
			[variable("set", set_type), int_literal(1)],
			named_type("Bool"),
		),
	)
	fold: CoreExpr = specialized(
		call(
			"blorp_list_fold_left",
			[
				variable("items", list_int),
				int_literal(0),
				variable(
					"fold",
					function_type(
						[named_type("Int"), named_type("Int")],
						named_type("Int"),
					),
				),
			],
			named_type("Int"),
		),
	)

	no_boxed_set_contains_value(contains) and no_boxed_fold_initial_value(fold)


pure func test_dict_get_and_channel_receive_option_dispatch() -> Bool:
	dict_type: CoreType = NamedType(
		"Dict",
		[named_type("Int"), named_type("String")],
	)
	dict_get: CoreExpr = specialized(
		call(
			"blorp_dict_get",
			[variable("dict", dict_type), int_literal(1)],
			option_type(named_type("String")),
		),
	)
	channel_recv: CoreExpr = specialized(call("blorp_channel_recv", [variable(
					"channel",
					NamedType("Channel", [named_type("Int")]),
				)], option_type(named_type("Int"))))
	channel_timeout: CoreExpr = specialized(
		call(
			"blorp_channel_recv_timeout",
			[variable(
					"channel",
					NamedType("Channel", [named_type("String")]),
				), int_literal(5)],
			option_type(named_type("String")),
		),
	)

	(
		call_name(dict_get) == Some("blorp_dict_get_nullable")
		and call_name(channel_recv) == Some("blorp_channel_recv_int")
		and call_name(channel_timeout) == Some("blorp_channel_recv_timeout_nullable")
		and dict_get_boxes_key(dict_get)
	)


pure func test_already_specialized_dict_get_boxes_primitive_key() -> Bool:
	dict_type: CoreType = NamedType(
		"Dict",
		[named_type("Int"), named_type("String")],
	)
	dict_get: CoreExpr = specialized(
		call(
			"blorp_dict_get_nullable",
			[variable("dict", dict_type), int_literal(1)],
			option_type(named_type("String")),
		),
	)

	call_name(dict_get) == Some("blorp_dict_get_nullable") and dict_get_boxes_key(dict_get)


pure func test_unknown_dict_get_suffix_stays_unboxed() -> Bool:
	var unchanged: Bool = True

	for name in ["blorp_dict_get_future", "blorp_dict_get_int_extra", "blorp_dict_getter"]:
		original: CoreExpr = int_key_dict_get(name, named_type("Int"))
		unchanged = unchanged and same_core_expr(specialized(original), original)

	unchanged


pure func test_dict_get_suffix_requires_matching_option_payload() -> Bool:
	primitive: CoreExpr = int_key_dict_get("blorp_dict_get_int", named_type("String"))
	nullable: CoreExpr = int_key_dict_get("blorp_dict_get_nullable", named_type("Int"))
	not_option: CoreExpr = call(
		"blorp_dict_get_int",
		[variable("dict", NamedType("Dict", [named_type("Int"), named_type("Int")])), int_literal(1)],
		named_type("Int"),
	)

	(
		same_core_expr(specialized(primitive), primitive)
		and same_core_expr(specialized(nullable), nullable)
		and same_core_expr(specialized(not_option), not_option)
	)


pure func test_typed_dict_get_wrong_arity_stays_unboxed() -> Bool:
	dict_value: CoreExpr = variable(
		"dict", NamedType("Dict", [named_type("Int"), named_type("String")]),
	)
	one_argument: CoreExpr = call(
		"blorp_dict_get_nullable", [dict_value], option_type(named_type("String")),
	)
	three_arguments: CoreExpr = call(
		"blorp_dict_get_nullable", [dict_value, int_literal(1), int_literal(2)],
		option_type(named_type("String")),
	)

	(
		same_core_expr(specialized(one_argument), one_argument)
		and same_core_expr(specialized(three_arguments), three_arguments)
	)


pure func test_intrinsic_dict_get_name_stays_unboxed() -> Bool:
	original: CoreExpr = intrinsic(
		"blorp_dict_get_nullable",
		[variable("dict", NamedType("Dict", [named_type("Int"), named_type("String")])), int_literal(1)],
		option_type(named_type("String")),
	)

	same_core_expr(specialized(original), original)


pure func test_dict_get_primitive_widths_share_key_boxing() -> Bool:
	-- This table is the native getter ABI, not another production selector.
	cases: List[(String, String)] = [
		("Int", "int"), ("Int8", "int8"), ("Int16", "int16"), ("Int32", "int32"),
		("Int64", "int64"), ("UInt8", "uint8"), ("UInt16", "uint16"),
		("UInt32", "uint32"), ("UInt64", "uint64"), ("Float", "float"),
		("Float32", "f32"), ("Float16", "f16"), ("Bool", "bool"), ("Char", "char")
	]
	var boxed: Bool = True

	for (payload_name, suffix) in cases:
		payload: CoreType = named_type(payload_name)
		runtime_name: String = "blorp_dict_get_" + suffix
		generic: CoreExpr = specialized(int_key_dict_get("blorp_dict_get", payload))
		typed: CoreExpr = specialized(int_key_dict_get(runtime_name, payload))
		boxed = (
			boxed
			and call_name(generic) == Some(runtime_name)
			and call_name(typed) == Some(runtime_name)
			and dict_get_has_one_int_key_box(generic)
			and dict_get_has_one_int_key_box(typed)
		)

	boxed


pure func test_dict_get_payload_and_option_aliases_keep_key_boxing() -> Bool:
	primitive: CoreExpr = specialized(int_key_dict_get("blorp_dict_get_int", named_type("Number")))
	managed: CoreExpr = specialized(int_key_dict_get("blorp_dict_get_nullable", named_type("Name")))
	option_alias: CoreExpr = specialized(call(
			"blorp_dict_get_nullable",
			[variable("dict", NamedType("Dict", [named_type("Int"), named_type("Name")])), int_literal(1)],
			named_type("MaybeName"),
		))

	(
		call_name(primitive) == Some("blorp_dict_get_int")
		and call_name(managed) == Some("blorp_dict_get_nullable")
		and call_name(option_alias) == Some("blorp_dict_get_nullable")
		and dict_get_has_one_int_key_box(primitive)
		and dict_get_has_one_int_key_box(managed)
		and dict_get_has_one_int_key_box(option_alias)
	)


pure func test_generic_dict_get_preserves_boxed_and_unspecialized_payloads() -> Bool:
	var preserved: Bool = True

	for payload in [option_type(named_type("Int")), named_type("Ptr")]:
		result: CoreExpr = specialized(int_key_dict_get("blorp_dict_get", payload))
		preserved = (
			preserved
			and call_name(result) == Some("blorp_dict_get")
			and dict_get_has_one_int_key_box(result)
		)

	for payload in [named_type("Color"), RangeType, named_type("Int128"), named_type("UInt128")]:
		original: CoreExpr = int_key_dict_get("blorp_dict_get", payload)
		preserved = preserved and same_core_expr(specialized(original), original)

	preserved


pure func test_dict_get_repeated_specialization_keeps_one_key_box() -> Bool:
	var unchanged: Bool = True

	for (name, payload) in [("blorp_dict_get_int", named_type("Int")), ("blorp_dict_get_nullable", named_type("String"))]:
		once: CoreExpr = specialized(int_key_dict_get(name, payload))
		twice: CoreExpr = specialized(once)
		unchanged = (
			unchanged and dict_get_has_one_int_key_box(twice) and same_core_expr(twice, once)
		)

	unchanged


pure func test_dict_get_managed_key_remains_borrowed() -> Bool:
	original: CoreExpr = call(
		"blorp_dict_get_int",
		[variable("dict", NamedType("Dict", [named_type("String"), named_type("Int")])), variable("key", named_type("String"))],
		option_type(named_type("Int")),
	)

	same_core_expr(specialized(original), original)


pure func test_generic_dict_get_evaluates_map_before_fresh_key_box() -> Bool:
	float_type: CoreType = named_type("Float")
	dict_type: CoreType = NamedType("Dict", [float_type, named_type("String")])
	make_dict: CoreExpr = call("make_dict", [], dict_type)
	key: CoreExpr = variable("key", float_type)
	result: CoreExpr = specialized(call(
			"blorp_dict_get", [make_dict, key], option_type(named_type("String")),
		))

	match result:
		LetExpr(map_binding, False, _, map_value, boxed_lookup):
			match boxed_lookup:
				LetExpr(key_binding, False, _, BoxExpr(box, _, _), bound_found):
					match bound_found:
						LetExpr(found_binding, False, _, lookup, release_then_found):
							match (lookup, release_then_found):
								(CallExpr(BuiltinCall("blorp_dict_get_nullable"), _, [VarExpr(map_ref, _, _), VarExpr(key_ref, _, _)], _, _), SeqExpr(CallExpr(IntrinsicCall("release_hash_key_box"), _, [VarExpr(released_key, _, _)], _, _), VarExpr(found_ref, _, _))):
									(
										same_core_expr(map_value, make_dict)
										and box.kind == FloatBox
										and box.source_type == float_type
										and same_core_expr(box.value, key)
										and map_binding.name == map_ref.name
										and key_binding.name == key_ref.name
										and key_binding.name == released_key.name
										and found_binding.name == found_ref.name
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_nullable_managed_option_runtime_renames() -> Bool:
	getenv: CoreExpr = specialized(
		call(
			"blorp_getenv",
			[variable("name", named_type("String"))],
			option_type(named_type("String")),
		),
	)
	decode: CoreExpr = specialized(
		call(
			"blorp_decode_utf8",
			[variable("bytes", named_type("Bytes"))],
			option_type(list_type(named_type("Char"))),
		),
	)
	base64: CoreExpr = specialized(
		call(
			"blorp_base64_decode",
			[variable("text", named_type("String"))],
			option_type(named_type("String")),
		),
	)
	from_hex: CoreExpr = specialized(
		call(
			"blorp_bytes_from_hex",
			[variable("text", named_type("String"))],
			option_type(named_type("Bytes")),
		),
	)

	(
		call_name(getenv) == Some("blorp_getenv_nullable")
		and call_name(decode) == Some("blorp_decode_utf8_nullable")
		and call_name(base64) == Some("blorp_base64_decode_nullable")
		and call_name(from_hex) == Some("blorp_bytes_from_hex_nullable")
	)


pure func test_stream_repeat_map_and_unfold_layouts() -> Bool:
	repeat: CoreExpr = specialized(
		call(
			"blorp_stream_repeat",
			[variable("text", named_type("String"))],
			stream_type(named_type("String")),
		),
	)
	map: CoreExpr = specialized(
		call(
			"blorp_stream_map",
			[variable("stream", stream_type(named_type("Int"))), variable(
					"map",
					function_type([named_type("Int")], named_type("String")),
				)],
			stream_type(named_type("String")),
		),
	)
	unfold: CoreExpr = specialized(
		call(
			"blorp_stream_unfold",
			[int_literal(0), variable(
					"next",
					function_type(
						[named_type("Int")],
						option_type(TupleType([named_type("String"), named_type("Int")])),
					),
				)],
			stream_type(named_type("String")),
		),
	)

	call_last_int_is(repeat, 1) and call_last_int_is(map, 2) and unfold_has_layouts(unfold, 2, 0)


pure func test_stream_option_dispatch() -> Bool:
	filter_map: CoreExpr = specialized(
		call(
			"blorp_stream_filter_map",
			[variable("stream", stream_type(named_type("Int"))), variable(
					"filter_map",
					function_type([named_type("Int")], option_type(named_type("String"))),
				)],
			stream_type(named_type("String")),
		),
	)
	find: CoreExpr = specialized(
		call(
			"blorp_stream_find",
			[variable("stream", stream_type(named_type("Int"))), variable(
					"predicate",
					function_type([named_type("Int")], named_type("Bool")),
				)],
			option_type(named_type("Int")),
		),
	)
	fallible_find: CoreExpr = specialized(
		call(
			"blorp_fallible_stream_find_raw",
			[
				variable(
					"stream",
					NamedType(
						"FallibleStream",
						[named_type("String"), named_type("String")],
					),
				),
				variable(
					"predicate",
					function_type([named_type("String")], named_type("Bool")),
				),
			],
			StackResultType(
				option_type(named_type("String")),
				named_type("String"),
			),
		),
	)

	(
		call_name(filter_map) == Some("blorp_stream_filter_map_nullable")
		and call_name(find) == Some("blorp_stream_find_int")
		and call_name(fallible_find) == Some("blorp_fallible_stream_find_raw_nullable")
	)


pure func test_stream_scalar_and_managed_state_layouts() -> Bool:
	repeat: CoreExpr = specialized(
		call(
			"blorp_stream_repeat",
			[int_literal(7)],
			stream_type(named_type("Int")),
		),
	)
	map: CoreExpr = specialized(
		call(
			"blorp_stream_map",
			[variable("stream", stream_type(named_type("String"))), variable(
					"map",
					function_type([named_type("String")], named_type("Int")),
				)],
			stream_type(named_type("Int")),
		),
	)
	unfold: CoreExpr = specialized(
		call(
			"blorp_stream_unfold",
			[variable("state", named_type("String")), variable(
					"next",
					function_type(
						[named_type("String")],
						option_type(TupleType([named_type("String"), named_type("String")])),
					),
				)],
			stream_type(named_type("String")),
		),
	)

	(
		stream_repeat_boxes_immediate(repeat)
		and call_last_int_is(repeat, 0)
		and call_last_int_is(map, 0)
		and unfold_has_trailing_layouts(unfold, 2, 2)
	)


pure func test_parallel_filter_map_dispatch_and_fallback() -> Bool:
	list_int: CoreType = list_type(named_type("Int"))
	direct: CoreExpr = specialized(
		call(
			"blorp_filter_map_parallel",
			[variable("items", list_int), variable(
					"map",
					function_type([named_type("Int")], option_type(named_type("String"))),
				)],
			list_type(named_type("String")),
		),
	)
	boxed_nested_option: CoreExpr = specialized(
		call(
			"blorp_filter_map_parallel",
			[variable("items", list_int), variable(
					"map",
					function_type([named_type("Int")], option_type(option_type(named_type("Int")))),
				)],
			list_type(option_type(named_type("Int"))),
		),
	)
	fallback: CoreExpr = specialized(
		call(
			"blorp_filter_map_parallel",
			[variable("items", list_int), variable(
					"map",
					function_type([named_type("Int")], option_type(RangeType)),
				)],
			list_type(RangeType),
		),
	)
	boxed_shape: Bool = match boxed_nested_option:
		CallExpr(BuiltinCall("blorp_filter_map_parallel"), _, [VarExpr(_, NamedType("List", [NamedType("Int", [])]), _), VarExpr(_, FunctionType(True, [NamedType("Int", [])], NamedType("Option", [NamedType("Option", [NamedType("Int", [])])])), _), LiteralExpr(IntLiteral(1), NamedType("Int", []), _)], NamedType("List", [NamedType("Option", [NamedType("Int", [])])]), _):
			True
		_:
			False

	(
		call_name(direct) == Some("blorp_filter_map_parallel_nullable")
		and call_last_int_is(direct, 1)
		and boxed_shape
		and parallel_filter_map_fallback_shape(fallback)
	)


pure func test_collection_map_release_metadata() -> Bool:
	pair: CoreType = HeapRecordType("Pair")
	list_map: CoreExpr = specialized(
		call(
			"blorp_map_parallel",
			[variable("items", list_type(named_type("Int"))), variable(
					"map",
					function_type([named_type("Int")], pair),
				)],
			list_type(pair),
		),
	)
	vector_map: CoreExpr = specialized(
		call(
			"blorp_vector_map",
			[variable(
					"items",
					tensor_type(named_type("Int"), [4]),
				), variable(
					"map",
					function_type([named_type("Int")], pair),
				)],
			tensor_type(
				pair,
				[4],
			),
		),
	)
	matrix_zip: CoreExpr = specialized(
		call(
			"blorp_matrix_zip_map",
			[
				variable(
					"left",
					tensor_type(
						named_type("Float"),
						[2, 3],
					),
				),
				variable(
					"right",
					tensor_type(
						named_type("Float"),
						[2, 3],
					),
				),
				variable(
					"zip",
					function_type(
						[named_type("Float"), named_type("Float")],
						named_type("Float"),
					),
				),
			],
			tensor_type(
				named_type("Float"),
				[2, 3],
			),
		),
	)

	(
		call_last_int_is(list_map, 1)
		and call_last_int_is(vector_map, 1)
		and call_last_int_is(matrix_zip, 0)
	)


pure func test_fold_release_metadata_and_raw_result() -> Bool:
	fold: CoreExpr = specialized(
		call(
			"blorp_fold_parallel_with",
			[
				variable("items", list_type(named_type("Int"))),
				variable("init", HeapRecordType("Pair")),
				variable(
					"fold",
					function_type(
						[HeapRecordType("Pair"), named_type("Int")],
						HeapRecordType("Pair"),
					),
				),
				int_literal(2),
			],
			HeapRecordType("Pair"),
		),
	)
	fallible: CoreExpr = specialized(
		call(
			"blorp_fallible_stream_fold_raw",
			[
				variable(
					"stream",
					NamedType(
						"FallibleStream",
						[named_type("Int"), named_type("String")],
					),
				),
				int_literal(0),
				variable(
					"fold",
					function_type(
						[named_type("Int"), named_type("Int")],
						StackResultType(
							named_type("Int"),
							named_type("String"),
						),
					),
				),
			],
			StackResultType(
				named_type("Int"),
				named_type("String"),
			),
		),
	)

	fold_has_pointer_and_release(fold) and call_last_int_is(fallible, 0)


tests: TestSuite = {
	description = "Blorp compiler collection and stream specialization",
	tests = [
		("list allocation uses concrete layout", test_list_alloc_uses_concrete_layout),
		(
			"erased key marker preserves managed record ownership",
			test_erased_key_marker_does_not_release_managed_record,
		),
		(
			"erased key marker releases stack option box",
			test_erased_key_marker_releases_stack_option_box,
		),
		("erased key marker releases Int128 box", test_erased_key_marker_releases_int128_box),
		(
			"erased key marker is void for pointer and word keys",
			test_erased_key_marker_is_void_for_pointer_and_word_keys,
		),
		("stale pointer cast of Float is reboxed", test_stale_pointer_cast_of_float_is_reboxed),
		(
			"list allocation alias enum uses registry layout",
			test_list_alloc_alias_enum_uses_registry_layout,
		),
		(
			"erased stack Result metadata is canonicalized",
			test_erased_stack_result_metadata_is_canonicalized,
		),
		("box and unbox metadata is canonicalized", test_box_and_unbox_metadata_is_canonicalized),
		(
			"managed void-slot box becomes a borrowed cast",
			test_managed_void_slot_box_becomes_borrowed_cast,
		),
		("hash container constructor dispatch", test_hash_container_constructor_dispatch),
		("int128 hash container constructor dispatch", test_int128_hash_container_constructor_dispatch),
		(
			"immediate dict constructor refinement and boxing",
			test_immediate_dict_constructor_refinement_and_boxing,
		),
		("set add boxes only the element", test_set_add_boxes_only_the_element),
		("set add refines empty constructor", test_set_add_refines_empty_constructor),
		(
			"non-void-slot collection calls remain unboxed",
			test_non_void_slot_collection_calls_remain_unboxed,
		),
		(
			"dict get and Channel receive Option dispatch",
			test_dict_get_and_channel_receive_option_dispatch,
		),
		(
			"already-specialized dict get boxes primitive key",
			test_already_specialized_dict_get_boxes_primitive_key,
		),
		("unknown dict get suffix stays unboxed", test_unknown_dict_get_suffix_stays_unboxed),
		(
			"dict get suffix requires matching Option payload",
			test_dict_get_suffix_requires_matching_option_payload,
		),
		("typed dict get wrong arity stays unboxed", test_typed_dict_get_wrong_arity_stays_unboxed),
		("intrinsic dict get name stays unboxed", test_intrinsic_dict_get_name_stays_unboxed),
		("dict get primitive widths share key boxing", test_dict_get_primitive_widths_share_key_boxing),
		(
			"dict get payload and Option aliases keep key boxing",
			test_dict_get_payload_and_option_aliases_keep_key_boxing,
		),
		(
			"generic dict get preserves boxed and unspecialized payloads",
			test_generic_dict_get_preserves_boxed_and_unspecialized_payloads,
		),
		(
			"dict get repeated specialization keeps one key box",
			test_dict_get_repeated_specialization_keeps_one_key_box,
		),
		("dict get managed key remains borrowed", test_dict_get_managed_key_remains_borrowed),
		(
			"generic dict get evaluates map before fresh key box",
			test_generic_dict_get_evaluates_map_before_fresh_key_box,
		),
		("nullable managed Option runtime renames", test_nullable_managed_option_runtime_renames),
		("stream repeat, map, and unfold layouts", test_stream_repeat_map_and_unfold_layouts),
		("stream scalar and managed-state layouts", test_stream_scalar_and_managed_state_layouts),
		("stream Option dispatch", test_stream_option_dispatch),
		(
			"parallel filter-map dispatch and fallback",
			test_parallel_filter_map_dispatch_and_fallback,
		),
		("collection map release metadata", test_collection_map_release_metadata),
		("fold release metadata and raw result", test_fold_release_metadata_and_raw_result),
	]
}
