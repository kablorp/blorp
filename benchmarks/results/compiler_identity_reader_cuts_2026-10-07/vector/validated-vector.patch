+private pure func get_or_body_is_preserved(get_kind: CoreCallKind, payload: CoreType) -> Bool:
+	body: CoreExpr = tensor_get_or_match_for_getter(
+		get_kind,
+		NamedType("Option", [payload]),
+		payload,
+		variable("default", payload),
+	)
+
+	match specialized_body(body):
+		Some(actual):
+			core_expr_to_json(actual).to_string() == core_expr_to_json(body).to_string()
+		None:
+			False
+
+
+pure func test_tensor_get_or_preserves_unsupported_getter_suffixes() -> Bool:
+	(
+		get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int_extra"), named_type("Int"))
+		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_unknown"), named_type("Int"))
+	)
+
+
+pure func test_tensor_get_or_preserves_incompatible_getter_payloads() -> Bool:
+	(
+		get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_f32"), named_type("Int"))
+		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int"), named_type("Float32"))
+		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int"), RangeType)
+		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int"), EnumType("Color"))
+	)
+
+
+pure func test_tensor_get_or_preserves_nullable_and_nonbuiltin_calls() -> Bool:
+	(
+		get_or_body_is_preserved(BuiltinCall("blorp_vector_get_nullable"), HeapRecordType("Point"))
+		and get_or_body_is_preserved(BuiltinCall("blorp_vector_get_opt_int"), HeapRecordType("Point"))
+		and get_or_body_is_preserved(UserCall("blorp_vector_get_opt_int", Some(42), []), named_type("Int"))
+	)
+
+
+pure func test_tensor_get_or_rewrites_supported_scalar_getters() -> Bool:
+	var rewrites: Bool = True
+
+	for (getter, payload, read_name) in [
+		("blorp_vector_get_opt_int", named_type("Int"), "tensor_get_i64"),
+		("blorp_vector_get_opt_int8", named_type("Int8"), "tensor_get_i64"),
+		("blorp_vector_get_opt_int16", named_type("Int16"), "tensor_get_i64"),
+		("blorp_vector_get_opt_int32", named_type("Int32"), "tensor_get_i64"),
+		("blorp_vector_get_opt_int64", named_type("Int64"), "tensor_get_i64"),
+		("blorp_vector_get_opt_uint8", named_type("UInt8"), "tensor_get_i64"),
+		("blorp_vector_get_opt_uint16", named_type("UInt16"), "tensor_get_i64"),
+		("blorp_vector_get_opt_uint32", named_type("UInt32"), "tensor_get_i64"),
+		("blorp_vector_get_opt_uint64", named_type("UInt64"), "tensor_get_i64"),
+		("blorp_vector_get_opt_float", named_type("Float"), "tensor_get_f64"),
+		("blorp_vector_get_opt_f32", named_type("Float32"), "tensor_get_f32"),
+		("blorp_vector_get_opt_f16", named_type("Float16"), "tensor_get_f16"),
+		("blorp_vector_get_opt_bool", named_type("Bool"), "tensor_get_i64"),
+		("blorp_vector_get_opt_char", named_type("Char"), "tensor_get_i64"),
+	]:
+		body: CoreExpr = tensor_get_or_match_for_getter(
+			BuiltinCall(getter), NamedType("Option", [payload]), payload, variable("default", payload),
