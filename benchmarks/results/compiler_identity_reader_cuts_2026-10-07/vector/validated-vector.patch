+
+		match specialized_body(body):
+			Some(IfExpr(LogicalExpr(AndOp, _, _, _, _), CallExpr(IntrinsicCall(actual), _, _, _, _), _, _, _)):
+				rewrites = rewrites and actual == read_name
+			_:
+				rewrites = False
