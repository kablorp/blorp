import:
	./repo/blorp/src/lib/source:
		source_file,
		source_cursor_at,
		unindexed_source_table_for_file,
		singleton_source_file_id,
		source_location_from_offsets,
		source_location_line_column_span
	test: TestSuite

pure func dynamic_source_text(seed: Int) -> String:
	seed.to_string() + "\t\nbc\t"

func temporary_source_cursor() -> Bool:
	cursor = source_cursor_at(source_file("temporary", "temporary", dynamic_source_text(1)), 6)
	cursor.offset == 6 and cursor.line == 2 and cursor.column == 5

func temporary_unindexed_span() -> Bool:
	span = source_location_line_column_span(
		unindexed_source_table_for_file(source_file("temporary", "temporary", dynamic_source_text(1))),
		source_location_from_offsets(singleton_source_file_id(), 1, 6),
	)
	span.start_line == 1 and span.start_column == 2 and span.end_line == 2 and span.end_column == 5

tests: TestSuite = {
	description = "Temporary source parent lifetimes",
	tests = [
		("temporary source cursor", temporary_source_cursor),
		("temporary unindexed span", temporary_unindexed_span),
	]
}
