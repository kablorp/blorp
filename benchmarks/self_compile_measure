#!/usr/bin/env python3
"""Standard self-compile measurement for compiler performance work.

Measures one compiler executable compiling a frozen input snapshot to C and
reports, per compiler phase, allocation counts (deterministic) and, per run,
retired instructions, wall time, and peak RSS. Every worker and every
baseline/candidate comparison uses this script so numbers are comparable.

Subcommands:

  measure   Run the measurement (default when no subcommand is given).
  freeze    Create the frozen input snapshot for a revision and print its path.
  lock      Run an arbitrary command under the global measurement lock.

The global lock serializes measurements and multi-process gates across
worktrees so they do not perturb each other or overwhelm macOS syspolicyd.

Toolchain fingerprint: every measurement records `cc_version` (first line of
`cc --version`), the full `<compiler> --version` output, and the
`compiled_by` / `optimization` / `commit` fields parsed out of it (each
"unknown" when the binary's --version output does not carry that key --
older binaries print only "commit: unknown" / "target: unknown"; a warning
is printed in that case, not a failure). `compare()` treats a difference in
`cc_version`, `compiled_by`, or `optimization` as a hard mismatch (exit
nonzero unless --allow-toolchain-mismatch); a `commit` difference is
expected (that is what is usually being measured) and is informational
only. `compiled_by` has one more exception: a stage-2 compiler's
`compiled_by` is `self-<its own commit>`, so a stage-2 baseline compared
against a stage-2 candidate always differs there by construction -- that
comparison is informational too (labelled "expected for stage-2"). A
`dev-<sha>` (bootstrap-built) baseline differing from another `dev-<sha>`
candidate (the bootstrap pin changed) or from a `self-<sha>` candidate
(bootstrap-built vs. stage-2) is still a hard mismatch. A baseline recorded
before this change has no "toolchain" key at all; that compares with a
warning, never a hard refusal, since there is nothing to validate against.

Wall time (`wall_seconds`, `phases_ms`) is host-clock noise, not acceptance
evidence. It is still recorded in every JSON but only printed in the
comparison table with --show-wall.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import fcntl
import hashlib
import json
import os
import platform
import re
import shutil
import statistics
import subprocess
import sys
import tempfile
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
TMP_BASE = Path(os.environ.get("TMPDIR", "/tmp"))
LOCK_PATH = TMP_BASE / "blorp-perf-measure.lock"
INPUT_BASE = TMP_BASE / "blorp-perf-input"
CHECKPOINT_RE = re.compile(r"^BLORP_COMPILER_MEMORY_CHECKPOINT\s+(.*)$")
PHASE_ROW_RE = re.compile(r"^([a-z_]+)\t([0-9.]+) ms$")
INSTRUCTIONS_RE = re.compile(r"^\s*(\d+)\s+instructions retired")
RSS_RE = re.compile(r"^\s*(\d+)\s+maximum resident set size")
REAL_RE = re.compile(r"^\s*([0-9.]+)\s+real\s+([0-9.]+)\s+user\s+([0-9.]+)\s+sys")
SMALL_PROGRAM = SCRIPT_DIR / "self_compile" / "small.brp"
STAGE2_BUILD_SCRIPT = SCRIPT_DIR / "build_stage2_compiler"
STAGE2_DEFAULT_BIN = REPO_ROOT / "bin" / "blorp-stage2"
SCHEMA_VERSION = 1


class MeasureError(Exception):
    pass


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def git(args: list[str], cwd: Path) -> str:
    return subprocess.run(
        ["git", *args], cwd=cwd, check=True, capture_output=True, text=True
    ).stdout.strip()


def cc_version_line() -> str:
    """First line of `cc --version`, or "unknown" if it cannot be run."""
    try:
        result = subprocess.run(["cc", "--version"], capture_output=True, text=True)
    except OSError:
        return "unknown"
    lines = result.stdout.splitlines()
    return lines[0].strip() if lines else "unknown"


def parse_compiler_version(compiler: Path) -> dict:
    """Run `<compiler> --version` and parse the fingerprint lines out of it.

    The target format (a parallel change is adding these lines to --version)
    is:

        blorp 0.0.1
        commit: <12-hex sha>[-dirty]
        target: aarch64-apple-darwin
        compiled_by: dev-<sha>        (bootstrap-built)  or  self-<sha>  (stage-2)
        optimization: cli=-O2 runtime=-O2
        split: 8

    Parsing is lenient: any missing key becomes "unknown" so this never
    fails on an older binary that only prints "commit: unknown" /
    "target: unknown".
    """
    try:
        result = subprocess.run(
            [str(compiler), "--version"], capture_output=True, text=True
        )
        lines = result.stdout.splitlines()
    except OSError:
        lines = []
    fields = {"commit": "unknown", "compiled_by": "unknown", "optimization": "unknown"}
    for line in lines:
        for key in fields:
            prefix = f"{key}: "
            if line.startswith(prefix):
                fields[key] = line[len(prefix):].strip()
    complete = all(value != "unknown" for value in fields.values())
    return {"lines": lines, "fields": fields, "complete": complete}


def toolchain_fingerprint(compiler: Path) -> dict:
    cc_version = cc_version_line()
    parsed = parse_compiler_version(compiler)
    fingerprint = {
        "cc_version": cc_version,
        "compiler_version": parsed["lines"],
        "compiled_by": parsed["fields"]["compiled_by"],
        "optimization": parsed["fields"]["optimization"],
        "commit": parsed["fields"]["commit"],
    }
    if cc_version == "unknown" or not parsed["complete"]:
        print(
            "self_compile_measure: warning: toolchain fingerprint is incomplete "
            "(binary predates full --version fields, or `cc --version` failed); "
            "comparisons against this measurement cannot fully validate the toolchain",
            file=sys.stderr,
        )
    return fingerprint


STAGE2_SENSITIVE_PREFIXES = (
    "blorp/src/compiler/stage_10_backend/",
    "blorp/src/lib/runtime/native/",
)


def warn_if_stage2_needed(root: Path | None, fingerprint: dict) -> None:
    """If measuring a bootstrap-built binary while this worktree changes the
    backend or native runtime, warn loudly: bin/blorp's C was generated by
    the pinned bootstrap compiler, so such changes are invisible to it."""
    if root is None or not fingerprint.get("compiled_by", "unknown").startswith("dev-"):
        return
    changed: set[str] = set()
    for diff_args in (
        ["diff", "--name-only", "origin/main...HEAD"],
        ["diff", "--name-only", "HEAD"],
    ):
        try:
            changed.update(line for line in git(diff_args, root).splitlines() if line)
        except subprocess.CalledProcessError:
            continue
    touched = sorted(p for p in changed if p.startswith(STAGE2_SENSITIVE_PREFIXES))
    if not touched:
        return
    print("=" * 72, file=sys.stderr)
    print(
        "self_compile_measure: WARNING - this measurement uses a bootstrap-built "
        "compiler (compiled_by starts with 'dev-'), but the worktree changes:",
        file=sys.stderr,
    )
    for path in touched[:10]:
        print(f"    {path}", file=sys.stderr)
    print(
        "  bin/blorp's generated C came from the pinned bootstrap compiler, so "
        "backend/runtime changes here are invisible to this measurement.",
        file=sys.stderr,
    )
    print(
        "  Build and measure a stage-2 compiler instead: "
        "benchmarks/build_stage2_compiler (or `self_compile_measure --stage2`).",
        file=sys.stderr,
    )
    print("=" * 72, file=sys.stderr)


def freeze_input(rev: str) -> Path:
    """Materialize blorp/ and standard_library/ from `rev` into a shared dir."""
    full = git(["rev-parse", "--verify", f"{rev}^{{commit}}"], REPO_ROOT)
    target = INPUT_BASE / full
    marker = target / ".complete"
    embedded_std = target / "blorp" / "src" / "compiler" / "stage_01_generated_inputs" / "embedded_std.brp"
    if marker.exists() and embedded_std.exists():
        return target
    generator = REPO_ROOT / "blorp" / "build" / "_build" / "build-tools" / "generate-build-sources"
    if not generator.exists():
        raise MeasureError(f"build source generator missing at {generator}; run make first")
    if target.exists():
        shutil.rmtree(target)
    target.mkdir(parents=True)
    archive = subprocess.run(
        ["git", "archive", full, "blorp", "standard_library"],
        cwd=REPO_ROOT,
        check=True,
        capture_output=True,
    ).stdout
    subprocess.run(["tar", "-x", "-C", str(target)], input=archive, check=True)
    # embedded_std.brp is a gitignored build product; regenerate it from the
    # frozen standard library so the input is complete and self-consistent.
    embedded_std.parent.mkdir(parents=True, exist_ok=True)
    with embedded_std.open("wb") as handle:
        subprocess.run(
            [str(generator), "embedded-std", str(target / "standard_library" / "src")],
            check=True,
            stdout=handle,
        )
    marker.write_text(full + "\n")
    return target


class GlobalLock:
    """Multi-process gates run through `lock --` take this exclusive lock so
    they never overlap each other. Measurements do not take it."""

    def __init__(self, exclusive: bool = False) -> None:
        LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
        self.handle = LOCK_PATH.open("a+")
        self.mode = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH

    def __enter__(self) -> "GlobalLock":
        fcntl.flock(self.handle.fileno(), self.mode)
        return self

    def __exit__(self, *_exc) -> None:
        fcntl.flock(self.handle.fileno(), fcntl.LOCK_UN)
        self.handle.close()


def compiler_repo_root(compiler: Path) -> Path | None:
    candidate = compiler.resolve().parent.parent
    if (candidate / "scripts" / "compiler-build-status").exists():
        return candidate
    return None


def check_build_fresh(compiler: Path) -> str:
    root = compiler_repo_root(compiler)
    if root is None:
        return "unknown (compiler not inside a repo checkout)"
    result = subprocess.run(
        [str(root / "scripts" / "compiler-build-status"), "--quiet"],
        cwd=root,
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        return "FRESH"
    if result.returncode == 1:
        raise MeasureError(
            f"bin/blorp in {root} is STALE relative to its sources; run make first"
        )
    return "UNKNOWN"


def run_compile(
    compiler: Path,
    input_dir: Path,
    program: Path,
    output_c: Path,
    env_extra: dict[str, str],
    with_time: bool,
) -> tuple[str, dict]:
    args = [
        str(compiler),
        "compile",
        "--no-format",
        "--no-embed-runtime",
        "--time-phases",
        "--std-dir",
        str(input_dir / "standard_library" / "src"),
        "-o",
        str(output_c),
        str(program),
    ]
    if with_time:
        args = ["/usr/bin/time", "-l", *args]
    env = dict(os.environ)
    env.pop("BLORP_COMPILER_MEMORY_PROFILE", None)
    env.pop("BLORP_ALLOCATOR_STATS", None)
    env.update(env_extra)
    result = subprocess.run(args, capture_output=True, text=True, env=env)
    if result.returncode != 0:
        raise MeasureError(
            f"compile failed (exit {result.returncode}):\n{result.stderr[-4000:]}"
        )
    stderr = result.stderr
    parsed: dict = {"phases_ms": {}, "checkpoints": []}
    for line in stderr.splitlines():
        row = PHASE_ROW_RE.match(line)
        if row:
            parsed["phases_ms"][row.group(1)] = float(row.group(2))
            continue
        checkpoint = CHECKPOINT_RE.match(line)
        if checkpoint:
            fields = dict(
                item.split("=", 1) for item in checkpoint.group(1).split() if "=" in item
            )
            parsed["checkpoints"].append(fields)
            continue
        instructions = INSTRUCTIONS_RE.match(line)
        if instructions:
            parsed["instructions_retired"] = int(instructions.group(1))
            continue
        rss = RSS_RE.match(line)
        if rss:
            parsed["peak_rss_bytes"] = int(rss.group(1))
            continue
        real = REAL_RE.match(line)
        if real:
            parsed["wall_seconds"] = float(real.group(1))
            parsed["user_seconds"] = float(real.group(2))
    return sha256_file(output_c), parsed


def checkpoint_deltas(checkpoints: list[dict]) -> list[dict]:
    rows = []
    previous_total = 0
    previous_bytes = 0
    for fields in checkpoints:
        name = fields.get("phase", "?")
        total = int(fields.get("total_allocations", 0))
        allocator_bytes = int(fields.get("allocator_bytes", 0))
        rows.append(
            {
                "name": name,
                "total_allocations": total,
                "delta_allocations": total - previous_total,
                "current_objects": int(fields.get("current_objects", 0)),
                "allocator_bytes": allocator_bytes,
                "delta_allocator_bytes": allocator_bytes - previous_bytes,
                "rss_bytes": int(fields.get("rss_bytes", 0)),
            }
        )
        previous_total = total
        previous_bytes = allocator_bytes
    return rows


def build_stage2_compiler() -> tuple[Path, str]:
    """Build bin/blorp-stage2 via benchmarks/build_stage2_compiler and return
    its path along with the sha256 of the bin/blorp that built it (the
    stage-2 rule: bin/blorp-stage2 is blorp/src/main.brp compiled by
    bin/blorp, not by the pinned bootstrap that built bin/blorp itself)."""
    stage1 = (REPO_ROOT / "bin" / "blorp")
    if not stage1.is_file():
        raise MeasureError("bin/blorp is missing; run `make` first (needed to build the stage-2 compiler)")
    stage1_sha256 = sha256_file(stage1)
    result = subprocess.run(
        [str(STAGE2_BUILD_SCRIPT), str(STAGE2_DEFAULT_BIN)],
        cwd=REPO_ROOT, capture_output=True, text=True,
    )
    if result.returncode != 0:
        raise MeasureError(
            f"benchmarks/build_stage2_compiler failed:\n{result.stdout}{result.stderr}"
        )
    return STAGE2_DEFAULT_BIN, stage1_sha256


def measure(args: argparse.Namespace) -> dict:
    stage2_built_by_sha256 = None
    if args.stage2:
        stage2_bin, stage2_built_by_sha256 = build_stage2_compiler()
        args.compiler = str(stage2_bin)
        args.skip_build_check = True
    compiler = Path(args.compiler).resolve()
    if not compiler.exists():
        raise MeasureError(f"compiler not found: {compiler}")
    freshness = "skipped" if args.skip_build_check else check_build_fresh(compiler)
    if args.input_dir:
        input_dir = Path(args.input_dir).resolve()
        input_rev = (input_dir / ".complete").read_text().strip() if (input_dir / ".complete").exists() else "unknown"
    else:
        input_rev = git(["rev-parse", "--verify", f"{args.input_rev}^{{commit}}"], REPO_ROOT)
        input_dir = freeze_input(input_rev)
    if args.program == "self":
        program = input_dir / "blorp" / "src" / "main.brp"
    else:
        program = SMALL_PROGRAM.resolve()
    if not program.exists():
        raise MeasureError(f"program not found: {program}")

    root = compiler_repo_root(compiler)
    compiler_rev = git(["rev-parse", "HEAD"], root) if root else "unknown"
    compiler_dirty = bool(git(["status", "--porcelain", "--untracked-files=no"], root)) if root else None
    toolchain = toolchain_fingerprint(compiler)
    warn_if_stage2_needed(root, toolchain)

    record: dict = {
        "schema": SCHEMA_VERSION,
        "label": args.label,
        "timestamp": _dt.datetime.now(_dt.timezone.utc).isoformat(timespec="seconds"),
        "host": platform.node(),
        "machine": platform.machine(),
        "compiler_path": str(compiler),
        "compiler_sha256": sha256_file(compiler),
        "compiler_rev": compiler_rev,
        "compiler_dirty": compiler_dirty,
        "compiler_build_status": freshness,
        "toolchain": toolchain,
        "compiler_stage": 2 if args.stage2 else 1,
        "stage2_built_by_bin_blorp_sha256": stage2_built_by_sha256,
        "c_optimization": os.environ.get("BLORP_CLI_C_OPTIMIZATION", "-O0 (default)"),
        "input_rev": input_rev,
        "input_dir": str(input_dir),
        "program": args.program,
        "samples": args.samples,
    }

    # Measurements take no lock: they are single-process and their primary
    # metrics tolerate concurrency. Only `lock --` gates serialize, so a queued
    # gate is never starved behind a stream of shared measurements.
    with tempfile.TemporaryDirectory(prefix="blorp-measure.") as tmp:
        tmp_dir = Path(tmp)
        alloc_c = tmp_dir / "alloc.c"
        output_sha, alloc_run = run_compile(
            compiler, input_dir, program, alloc_c,
            {"BLORP_COMPILER_MEMORY_PROFILE": "1"}, with_time=False,
        )
        record["output_sha256"] = output_sha
        record["output_bytes"] = alloc_c.stat().st_size
        record["checkpoints"] = checkpoint_deltas(alloc_run["checkpoints"])
        record["total_allocations"] = (
            record["checkpoints"][-1]["total_allocations"] if record["checkpoints"] else None
        )
        if args.keep_output:
            shutil.copyfile(alloc_c, Path(args.keep_output))

        instructions: list[int] = []
        walls: list[float] = []
        rss: list[int] = []
        phase_samples: dict[str, list[float]] = {}
        for index in range(args.samples):
            sample_c = tmp_dir / f"sample{index}.c"
            sample_sha, run = run_compile(
                compiler, input_dir, program, sample_c, {}, with_time=True
            )
            if sample_sha != output_sha:
                raise MeasureError("generated C differed between runs of the same compiler")
            sample_c.unlink()
            instructions.append(run.get("instructions_retired", 0))
            walls.append(run.get("wall_seconds", 0.0))
            rss.append(run.get("peak_rss_bytes", 0))
            for name, ms in run["phases_ms"].items():
                phase_samples.setdefault(name, []).append(ms)

    record["instructions_retired"] = {
        "min": min(instructions) if instructions else None,
        "median": statistics.median(instructions) if instructions else None,
        "samples": instructions,
    }
    record["wall_seconds"] = {
        "min": min(walls) if walls else None,
        "median": statistics.median(walls) if walls else None,
        "samples": walls,
    }
    record["peak_rss_bytes"] = max(rss) if rss else None
    record["phases_ms"] = {
        name: statistics.median(values) for name, values in phase_samples.items()
    }
    return record


def pct(baseline: float | None, candidate: float | None) -> str:
    if not baseline or candidate is None:
        return "n/a"
    return f"{100.0 * (candidate - baseline) / baseline:+.2f}%"


def fmt(value) -> str:
    if value is None:
        return "-"
    if isinstance(value, float):
        return f"{value:,.1f}"
    return f"{value:,}"


def compare_toolchain(baseline: dict, candidate: dict) -> tuple[list[str], list[str]]:
    """Return (lines to print, fields that are a hard mismatch)."""
    base_tc = baseline.get("toolchain")
    cand_tc = candidate.get("toolchain")
    if base_tc is None:
        return (
            ["toolchain mismatch: baseline predates fingerprint recording; "
             "comparing without toolchain validation"],
            [],
        )
    lines: list[str] = []
    hard: list[str] = []
    base_commit = base_tc.get("commit", "unknown")
    cand_commit = cand_tc.get("commit", "unknown")
    if base_commit != cand_commit:
        lines.append(f"toolchain commit differs (expected): {base_commit} -> {cand_commit}")
    for field in ("cc_version", "compiled_by", "optimization"):
        base_val = base_tc.get(field, "unknown")
        cand_val = cand_tc.get(field, "unknown")
        if base_val == cand_val:
            continue
        if base_val == "unknown" or cand_val == "unknown":
            lines.append(
                f"toolchain {field} incomplete on one side "
                f"(baseline={base_val!r} candidate={cand_val!r}); not a hard mismatch"
            )
            continue
        if field == "compiled_by" and base_val.startswith("self-") and cand_val.startswith("self-"):
            # A stage-2 compiler's compiled_by embeds its own commit, so a
            # stage-2 baseline vs. a stage-2 candidate always differs here --
            # that is exactly the comparison the stage-2 rule exists for.
            lines.append(
                f"toolchain compiled_by differs (expected for stage-2): "
                f"{base_val} -> {cand_val}"
            )
            continue
        lines.append(
            f"toolchain mismatch: {field} differs (baseline={base_val!r} candidate={cand_val!r})"
        )
        hard.append(field)
    return lines, hard


def compare(baseline: dict, candidate: dict, show_wall: bool = False) -> dict:
    identical = baseline.get("output_sha256") == candidate.get("output_sha256")
    toolchain_lines, hard_mismatch_fields = compare_toolchain(baseline, candidate)
    print()
    print(f"baseline : {baseline.get('label')} @ {baseline.get('compiler_rev', '?')[:12]}")
    print(f"candidate: {candidate.get('label')} @ {candidate.get('compiler_rev', '?')[:12]}")
    print(f"input    : {candidate.get('input_rev', '?')[:12]}  program={candidate.get('program')}")
    print(f"output C : {'IDENTICAL' if identical else 'DIFFERENT'} "
          f"({baseline.get('output_bytes')} vs {candidate.get('output_bytes')} bytes)")
    for line in toolchain_lines:
        print(line)
    print()
    header = f"{'metric':<44} {'baseline':>16} {'candidate':>16} {'delta':>9}"
    print(header)
    print("-" * len(header))
    base_cp = {row["name"]: row for row in baseline.get("checkpoints", [])}
    cand_cp = {row["name"]: row for row in candidate.get("checkpoints", [])}
    for name in list(base_cp) + [n for n in cand_cp if n not in base_cp]:
        b = base_cp.get(name, {}).get("delta_allocations")
        c = cand_cp.get(name, {}).get("delta_allocations")
        print(f"{'allocs ' + name:<44} {fmt(b):>16} {fmt(c):>16} {pct(b, c):>9}")
    b = baseline.get("total_allocations"); c = candidate.get("total_allocations")
    print(f"{'allocs TOTAL':<44} {fmt(b):>16} {fmt(c):>16} {pct(b, c):>9}")
    b = baseline.get("instructions_retired", {}).get("min")
    c = candidate.get("instructions_retired", {}).get("min")
    print(f"{'instructions retired (min)':<44} {fmt(b):>16} {fmt(c):>16} {pct(b, c):>9}")
    b = baseline.get("output_bytes"); c = candidate.get("output_bytes")
    print(f"{'output bytes':<44} {fmt(b):>16} {fmt(c):>16} {pct(b, c):>9}")
    b = baseline.get("peak_rss_bytes"); c = candidate.get("peak_rss_bytes")
    print(f"{'peak RSS bytes':<44} {fmt(b):>16} {fmt(c):>16} {pct(b, c):>9}")
    if show_wall:
        print()
        print("-- wall-clock (host noise; not acceptance evidence) --")
        for name in list(baseline.get("phases_ms", {})) + [
            n for n in candidate.get("phases_ms", {}) if n not in baseline.get("phases_ms", {})
        ]:
            b = baseline.get("phases_ms", {}).get(name)
            c = candidate.get("phases_ms", {}).get(name)
            print(f"{'ms ' + name + ' (median)':<44} {fmt(b):>16} {fmt(c):>16} {pct(b, c):>9}")
        b = baseline.get("wall_seconds", {}).get("min"); c = candidate.get("wall_seconds", {}).get("min")
        print(f"{'wall seconds (min)':<44} {fmt(b):>16} {fmt(c):>16} {pct(b, c):>9}")
    print()
    return {"identical": identical, "hard_mismatch_fields": hard_mismatch_fields}


def cmd_measure(args: argparse.Namespace) -> int:
    record = measure(args)
    if args.output:
        Path(args.output).write_text(json.dumps(record, indent=2) + "\n")
        print(f"wrote {args.output}")
    if args.baseline:
        baseline = json.loads(Path(args.baseline).read_text())
        result = compare(baseline, record, show_wall=args.show_wall)
        if args.require_identical and not result["identical"]:
            print("generated C differs from baseline", file=sys.stderr)
            return 3
        if result["hard_mismatch_fields"] and not args.allow_toolchain_mismatch:
            print(
                "self_compile_measure: toolchain mismatch in "
                f"{', '.join(result['hard_mismatch_fields'])}; this baseline/candidate pair "
                "is not comparable. Pass --allow-toolchain-mismatch to proceed anyway.",
                file=sys.stderr,
            )
            return 4
    else:
        print(json.dumps({k: v for k, v in record.items() if k != "checkpoints"}, indent=2))
        for row in record["checkpoints"]:
            print(f"  {row['name']:<36} allocs +{row['delta_allocations']:>12,}")
    return 0


def cmd_freeze(args: argparse.Namespace) -> int:
    print(freeze_input(args.rev))
    return 0


def cmd_lock(args: argparse.Namespace) -> int:
    if not args.command:
        raise MeasureError("lock requires a command after --")
    with GlobalLock(exclusive=True):
        return subprocess.call(args.command)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command_name")

    measure_parser = sub.add_parser("measure", help="measure a compiler (default)")
    for p in (parser, measure_parser):
        p.add_argument("--compiler", default=str(REPO_ROOT / "bin" / "blorp"))
        p.add_argument("--input-rev", default="HEAD", help="revision to freeze as the input snapshot")
        p.add_argument("--input-dir", help="use an existing frozen input directory")
        p.add_argument("--program", choices=["self", "small"], default="self")
        p.add_argument("--label", default="unlabeled")
        p.add_argument("--samples", type=int, default=2, help="uninstrumented timing samples")
        p.add_argument("--baseline", help="baseline JSON to compare against")
        p.add_argument("--output", help="write the measurement JSON here")
        p.add_argument("--keep-output", help="copy the generated C here")
        p.add_argument("--require-identical", action="store_true", help="exit 3 if generated C differs from baseline")
        p.add_argument("--skip-build-check", action="store_true")
        p.add_argument(
            "--allow-toolchain-mismatch", action="store_true",
            help="proceed (exit 0) even if cc_version, compiled_by, or optimization "
                 "differ between baseline and candidate; a commit difference alone "
                 "never blocks",
        )
        p.add_argument(
            "--show-wall", action="store_true",
            help="include wall-clock rows (phase ms, wall seconds) in the comparison "
                 "table; they are host noise and not acceptance evidence, so they are "
                 "omitted by default (still recorded in the JSON either way)",
        )
        p.add_argument(
            "--stage2", action="store_true",
            help="build bin/blorp-stage2 via benchmarks/build_stage2_compiler and measure it "
                 "(equivalent to --compiler bin/blorp-stage2 --skip-build-check); "
                 "overrides --compiler and --skip-build-check",
        )

    freeze_parser = sub.add_parser("freeze", help="materialize the frozen input for a revision")
    freeze_parser.add_argument("--rev", default="HEAD")

    lock_parser = sub.add_parser("lock", help="run a command under the global measurement lock")
    lock_parser.add_argument("command", nargs=argparse.REMAINDER)

    args = parser.parse_args(argv)
    try:
        if args.command_name == "freeze":
            return cmd_freeze(args)
        if args.command_name == "lock":
            command = list(args.command)
            if command and command[0] == "--":
                command = command[1:]
            args.command = command
            return cmd_lock(args)
        return cmd_measure(args)
    except MeasureError as error:
        print(f"self_compile_measure: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
