#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation="${1:-plain}"
usage="usage: benchmarks/compiler_prepared_reuse_decl_profile plain|profile [iterations] [declarations] [union_count] [variants_per_union] [prepared_match_count]"

case "$instrumentation" in
	plain|profile)
		shift || true
		;;
	*)
		echo "$usage" >&2
		exit 2
		;;
esac

case "${1:-}" in
	parent-linear|indexed)
		echo "lookup algorithm is compiled into blorp/benchmark/compiler/compiler_prepared_reuse_decl_profile.brp; do not pass it on the command line" >&2
		echo "$usage" >&2
		exit 2
		;;
esac

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-prepared-reuse-decl-profile \
	blorp/benchmark/compiler/compiler_prepared_reuse_decl_profile.brp \
	"$instrumentation" \
	"$@"
