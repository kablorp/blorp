import:
	string: parse_int


func count_flips(perm1: List[Int]) -> Int:
	var p: List[Int] = perm1
	var flips: Int = 0
	var k: Int = p.get_or(0, 0)
	while k != 0:
		k2: Int = (k + 1) / 2
		var j: Int = 0
		while j < k2:
			kj: Int = k - j
			a: Int = p.get_or(j, 0)
			b: Int = p.get_or(kj, 0)
			p = p.set(j, b)
			p = p.set(kj, a)
			j += 1
		flips += 1
		k = p.get_or(0, 0)
	flips


func parse_n(args: List[String]) -> Option[Int]:
	s ?= args.get(1)
	v ?= parse_int(s)
	Some(v)


func main(args: List[String]):
	parsed_n: Option[Int] = parse_n(args)
	n: Int = parsed_n.get_or(7)
	var perm1: List[Int] = []
	for i in 0..n:
		perm1 = perm1.append(i)
	var count: List[Int] = []
	for i in 0..n:
		count = count.append(0)
	var max_flips: Int = 0
	var checksum: Int = 0
	var perm_count: Int = 0
	var r: Int = n
	var done: Bool = False
	while not done:
		while r > 1:
			count = count.set(r - 1, r)
			r -= 1
		flips: Int = count_flips(perm1)
		if flips > max_flips:
			max_flips = flips
		if perm_count % 2 == 0:
			checksum += flips
		else:
			checksum -= flips
		perm_count += 1
		var advanced: Bool = False
		while not advanced:
			if r == n:
				done = True
				advanced = True
			else:
				p0: Int = perm1.get_or(0, 0)
				var j: Int = 0
				while j < r:
					val: Int = perm1.get_or(j + 1, 0)
					perm1 = perm1.set(j, val)
					j += 1
				perm1 = perm1.set(r, p0)
				count_r: Int = count.get_or(r, 0)
				cr: Int = count_r - 1
				count = count.set(r, cr)
				if cr > 0:
					advanced = True
				if not advanced:
					r += 1
	print(to_string(checksum))
	print("Pfannkuchen(${to_string(n)}) = ${to_string(max_flips)}")
