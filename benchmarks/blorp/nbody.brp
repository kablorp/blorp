import:
	float: format, pi, sqrt
	list: get
	string: parse_int


-- N-body simulation benchmark (struct-of-arrays layout, vector storage)
solar_mass: Float = 4.0 * pi() * pi()

days_per_year: Float = 365.24

dt: Float = 0.01


func main(args: List[String]):
	parsed_n: Option[Int] = try:
		s ?= get(args, 1)
		v ?= parse_int(s)
		v
	n: Int = parsed_n.get_or(1000)
	-- Struct-of-arrays: 5 bodies stored as parallel vectors
	var bx = vector(0.0, 5)
	var by = vector(0.0, 5)
	var bz = vector(0.0, 5)
	var bvx = vector(0.0, 5)
	var bvy = vector(0.0, 5)
	var bvz = vector(0.0, 5)
	var bmass = vector(0.0, 5)
	-- Sun
	bmass[0] = solar_mass
	-- Jupiter
	bx[1] = 4.841431442464721
	by[1] = -1.1603200440274284
	bz[1] = -0.10362204447112311
	bvx[1] = 0.001660076642744037 * days_per_year
	bvy[1] = 0.007699011184197404 * days_per_year
	bvz[1] = -0.0000690460016972063 * days_per_year
	bmass[1] = 0.0009547919384243266 * solar_mass
	-- Saturn
	bx[2] = 8.34336671824458
	by[2] = 4.124798564124305
	bz[2] = -0.4035234171143214
	bvx[2] = -0.002767425107268624 * days_per_year
	bvy[2] = 0.004998528012349172 * days_per_year
	bvz[2] = 0.00002304172975737639 * days_per_year
	bmass[2] = 0.0002858859806661308 * solar_mass
	-- Uranus
	bx[3] = 12.894369562139131
	by[3] = -15.111151401698631
	bz[3] = -0.22330757889265573
	bvx[3] = 0.002964601375647616 * days_per_year
	bvy[3] = 0.0023784717395948095 * days_per_year
	bvz[3] = -0.00002965895685402376 * days_per_year
	bmass[3] = 0.00004366244043351563 * solar_mass
	-- Neptune
	bx[4] = 15.379697114850917
	by[4] = -25.919314609987964
	bz[4] = 0.17925877295037118
	bvx[4] = 0.0026806777249038932 * days_per_year
	bvy[4] = 0.001628241700382423 * days_per_year
	bvz[4] = -0.00009515922545197159 * days_per_year
	bmass[4] = 0.00005151389020466115 * solar_mass
	-- Offset momentum
	var px: Float = 0.0
	var py: Float = 0.0
	var pz: Float = 0.0
	for i in 0..length(bx):
		px += bvx[i] * bmass[i]
		py += bvy[i] * bmass[i]
		pz += bvz[i] * bmass[i]
	bvx[0] = -px / solar_mass
	bvy[0] = -py / solar_mass
	bvz[0] = -pz / solar_mass
	-- Initial energy
	var e: Float = 0.0
	for i in 0..length(bx):
		e += 0.5 * bmass[i] * (bvx[i] * bvx[i] + bvy[i] * bvy[i] + bvz[i] * bvz[i])
		for j in i + 1..length(bx):
			edx: Float = bx[i] - bx[j]
			edy: Float = by[i] - by[j]
			edz: Float = bz[i] - bz[j]
			edist: Float = sqrt(edx * edx + edy * edy + edz * edz)
			e -= bmass[i] * bmass[j] / edist
	print(format(e, 9))
	-- Simulation loop
	for step in 0..n:
		for i in 0..length(bx):
			for j in i + 1..length(bx):
				dx: Float = bx[i] - bx[j]
				dy: Float = by[i] - by[j]
				dz: Float = bz[i] - bz[j]
				dist_sq: Float = dx * dx + dy * dy + dz * dz
				dist: Float = sqrt(dist_sq)
				mag: Float = dt / (dist_sq * dist)
				bvx[i] = bvx[i] - dx * bmass[j] * mag
				bvy[i] = bvy[i] - dy * bmass[j] * mag
				bvz[i] = bvz[i] - dz * bmass[j] * mag
				bvx[j] = bvx[j] + dx * bmass[i] * mag
				bvy[j] = bvy[j] + dy * bmass[i] * mag
				bvz[j] = bvz[j] + dz * bmass[i] * mag
		for i in 0..length(bx):
			bx[i] = bx[i] + dt * bvx[i]
			by[i] = by[i] + dt * bvy[i]
			bz[i] = bz[i] + dt * bvz[i]
	-- Final energy
	var e2: Float = 0.0
	for i in 0..length(bx):
		e2 += 0.5 * bmass[i] * (bvx[i] * bvx[i] + bvy[i] * bvy[i] + bvz[i] * bvz[i])
		for j in i + 1..length(bx):
			edx: Float = bx[i] - bx[j]
			edy: Float = by[i] - by[j]
			edz: Float = bz[i] - bz[j]
			edist: Float = sqrt(edx * edx + edy * edy + edz * edz)
			e2 -= bmass[i] * bmass[j] / edist
	print(format(e2, 9))
