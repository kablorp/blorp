-- Repeated value-struct closure captures for S3 allocation measurement.
--
-- Each iteration builds a distinct pair, captures it in a returned closure,
-- calls through the function value, and drops the closure before continuing.
-- The varying fields and indirect invocation keep creation observable and
-- prevent hoisting one invariant closure out of the loop.
import:
	memory: get_mem_stats, reset_mem_stats


closure_capture_batch_size: Int = 1024


struct ClosureCapturePair {
	left: Int,
	right: Int
}


func make_closure_capture_reader(pair: ClosureCapturePair) -> pure () -> Int:
	func(): pair.left + pair.right


func invoke_closure_capture_reader(reader: pure () -> Int) -> Int:
	reader()


func create_call_and_drop_closure_capture(pair: ClosureCapturePair) -> Int:
	reader: pure () -> Int = make_closure_capture_reader(pair)
	invoke_closure_capture_reader(reader)


func warm_up_closure_capture() -> Int:
	pair: ClosureCapturePair = {
		left = 1,
		right = 2
	}
	create_call_and_drop_closure_capture(pair)


func run_closure_capture_batch() -> Int:
	var checksum: Int = 0
	var iteration: Int = 0

	while iteration < closure_capture_batch_size:
		pair: ClosureCapturePair = {
			left = iteration,
			right = iteration + 5
		}
		checksum += create_call_and_drop_closure_capture(pair)
		iteration += 1

	checksum


func main(args: List[String]) -> Int:
	warm_up_checksum: Int = warm_up_closure_capture()
	reset_mem_stats()
	checksum: Int = run_closure_capture_batch()
	stats = get_mem_stats()

	print("closure capture allocations: " + stats.total_allocations.to_string())
	print("closure capture live objects: " + stats.current_objects.to_string())
	print("closure capture checksum: " + checksum.to_string())

	expected_checksum: Int = closure_capture_batch_size * (closure_capture_batch_size + 4)

	if (
		warm_up_checksum == 3
		and checksum == expected_checksum
		and stats.current_objects == 0
	):
		0
	else:
		1
