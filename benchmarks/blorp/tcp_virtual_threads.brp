import:
	./support/benchmark: format_duration
	instrumentation: SchedulerStats, black_box_int, get_scheduler_stats, reset_scheduler_stats
	list: range
	net/tcp as Tcp
	system: now_microseconds


private func consume_results(results: List[Result[Int, ConcurrencyError]]) -> Int:
	var checksum: Int = 0
	for result in results:
		match result:
			Ok(value): checksum += value
			Err(_): checksum -= 1000000
	black_box_int(checksum)


private func format_sched(stats: SchedulerStats) -> String:
	" parks=" + stats.fiber_parks.to_string() + " resumes=" + stats.fiber_resumes.to_string() + " enqueues=" + stats.runnable_enqueues.to_string() + " steals=" + stats.work_steals.to_string() + " reactor_ctrl=" + stats.reactor_control_wakes.to_string() + " reactor_polls=" + stats.reactor_poll_wakes.to_string() + " reactor_ready=" + stats.reactor_ready_events.to_string() + " reactor_waiters=" + stats.reactor_waiter_wakes.to_string()


private func accept_and_close_n(listener: TcpListener, count: Int) -> Int:
	var accepted: Int = 0
	var ok: Bool = True
	while accepted < count and ok:
		match Tcp.accept(listener):
			Ok(peer):
				Tcp.close(peer)
				accepted += 1
			Err(_):
				ok = False
	if ok:
		accepted
	else:
		-accepted


private func connect_and_close_n(port: Int, count: Int) -> Int:
	var connected: Int = 0
	var ok: Bool = True
	for i in 0..count:
		match Tcp.connect("127.0.0.1", port):
			Ok(stream):
				Tcp.close(stream)
				connected += 1
			Err(_):
				ok = False
	if ok:
		connected
	else:
		-connected


private func connect_and_close_one(port: Int) -> Int:
	match Tcp.connect("127.0.0.1", port):
		Ok(stream):
			Tcp.close(stream)
			1
		Err(_): -1


private func connect_storm_clients(port: Int, count: Int) -> Int:
	results: List[Result[Int, ConcurrencyError]] = range(0, count).concurrent(
		count,
		func(i: Int): connect_and_close_one(port),
	)
	consume_results(results)


private func run_accept_connect_case(count: Int) -> Int:
	match Tcp.listen("127.0.0.1", 0, count):
		Ok(listener):
			match Tcp.local_port(listener):
				Ok(port):
					reset_scheduler_stats()
					start: Int = now_microseconds()
					concurrent(max_threads: 1, timeout: 5000):
						accepted = accept_and_close_n(listener, count)
						connected = connect_and_close_n(port, count)
					elapsed: Int = now_microseconds() - start
					stats: SchedulerStats = get_scheduler_stats()
					var checksum: Int = 0
					match accepted:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					match connected:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					Tcp.close(listener)
					print(
						"  accept/connect " + count.to_string() + " loopback connections: " + format_duration(
							elapsed,
						) + format_sched(stats),
					)
					black_box_int(checksum)
				Err(_):
					Tcp.close(listener)
					-1
		Err(_): -1


private func run_connect_storm_case(count: Int) -> Int:
	match Tcp.listen("127.0.0.1", 0, count):
		Ok(listener):
			match Tcp.local_port(listener):
				Ok(port):
					reset_scheduler_stats()
					start: Int = now_microseconds()
					concurrent(max_threads: 4, timeout: 5000):
						server = accept_and_close_n(listener, count)
						clients = connect_storm_clients(port, count)
					elapsed: Int = now_microseconds() - start
					stats: SchedulerStats = get_scheduler_stats()
					var checksum: Int = 0
					match server:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					match clients:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					Tcp.close(listener)
					print(
						"  connect storm " + count.to_string() + " loopback clients: " + format_duration(
							elapsed,
						) + format_sched(stats),
					)
					black_box_int(checksum)
				Err(_):
					Tcp.close(listener)
					-1
		Err(_): -1


private func accept_hold_close_n(listener: TcpListener, count: Int, hold_ms: Int) -> Int:
	var peers: List[TcpStream] = []
	var accepted: Int = 0
	var ok: Bool = True
	while accepted < count and ok:
		match Tcp.accept(listener):
			Ok(peer):
				peers = peers.append(peer)
				accepted += 1
			Err(_):
				ok = False
	sleep(hold_ms)
	for peer in peers:
		Tcp.close(peer)
	if ok:
		accepted
	else:
		-accepted


private func connect_hold_close_one(port: Int, hold_ms: Int) -> Int:
	match Tcp.connect("127.0.0.1", port):
		Ok(stream):
			sleep(hold_ms)
			Tcp.close(stream)
			1
		Err(_): -1


private func connect_hold_close_many(port: Int, count: Int, hold_ms: Int) -> Int:
	results: List[Result[Int, ConcurrencyError]] = range(0, count).concurrent(
		count,
		func(i: Int): connect_hold_close_one(port, hold_ms),
	)
	consume_results(results)


private func run_idle_connection_case(count: Int, hold_ms: Int) -> Int:
	match Tcp.listen("127.0.0.1", 0, count):
		Ok(listener):
			match Tcp.local_port(listener):
				Ok(port):
					reset_scheduler_stats()
					start: Int = now_microseconds()
					concurrent(max_threads: 4, timeout: 5000):
						server = accept_hold_close_n(listener, count, hold_ms)
						clients = connect_hold_close_many(port, count, hold_ms)
					elapsed: Int = now_microseconds() - start
					stats: SchedulerStats = get_scheduler_stats()
					var checksum: Int = 0
					match server:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					match clients:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					Tcp.close(listener)
					print(
						"  " + count.to_string() + " idle loopback connections held for " + hold_ms.to_string() + "ms: " + format_duration(
							elapsed,
						) + format_sched(stats),
					)
					black_box_int(checksum)
				Err(_):
					Tcp.close(listener)
					-1
		Err(_): -1


private func client_read_one(port: Int) -> Int:
	match Tcp.connect("127.0.0.1", port):
		Ok(stream):
			match Tcp.read(stream, 1):
				Ok(data):
					n: Int = data.length()
					Tcp.close(stream)
					n
				Err(_):
					Tcp.close(stream)
					-1
		Err(_): -1


private func run_client_readers(port: Int, count: Int) -> Int:
	results: List[Result[Int, ConcurrencyError]] = range(0, count).concurrent(
		count,
		func(i: Int): client_read_one(port),
	)
	consume_results(results)


private func serve_delayed_writes(listener: TcpListener, count: Int, delay_ms: Int) -> Int:
	var peers: List[TcpStream] = []
	var accepted: Int = 0
	var ok: Bool = True
	while accepted < count and ok:
		match Tcp.accept(listener):
			Ok(peer):
				peers = peers.append(peer)
				accepted += 1
			Err(_):
				ok = False
	sleep(delay_ms)
	payload: Bytes = "x".to_bytes()
	var written: Int = 0
	for peer in peers:
		match Tcp.write(peer, payload):
			Ok(n): written += n
			Err(_): written -= 1000000
		Tcp.close(peer)
	if ok:
		accepted + written
	else:
		-(accepted + written)


private func client_read_chunks(port: Int, chunks: Int) -> Int:
	match Tcp.connect("127.0.0.1", port):
		Ok(stream):
			var total: Int = 0
			var ok: Bool = True
			for i in 0..chunks:
				if ok:
					match Tcp.read(stream, 1):
						Ok(data): total += data.length()
						Err(_):
							ok = False
							total -= 1000000
			Tcp.close(stream)
			total
		Err(_): -1


private func run_chunked_readers(port: Int, count: Int, chunks: Int) -> Int:
	results: List[Result[Int, ConcurrencyError]] = range(0, count).concurrent(
		count,
		func(i: Int): client_read_chunks(port, chunks),
	)
	consume_results(results)


private func serve_drip_writes(
	listener: TcpListener,
	count: Int,
	chunks: Int,
	delay_ms: Int,
) -> Int:
	var peers: List[TcpStream] = []
	var accepted: Int = 0
	var ok: Bool = True
	while accepted < count and ok:
		match Tcp.accept(listener):
			Ok(peer):
				peers = peers.append(peer)
				accepted += 1
			Err(_):
				ok = False
	payload: Bytes = "x".to_bytes()
	var written: Int = 0
	for i in 0..chunks:
		sleep(delay_ms)
		for peer in peers:
			match Tcp.write(peer, payload):
				Ok(n): written += n
				Err(_): written -= 1000000
	for peer in peers:
		Tcp.close(peer)
	if ok:
		accepted + written
	else:
		-(accepted + written)


private func run_slow_writer_case(count: Int, chunks: Int, delay_ms: Int) -> Int:
	match Tcp.listen("127.0.0.1", 0, count):
		Ok(listener):
			match Tcp.local_port(listener):
				Ok(port):
					reset_scheduler_stats()
					start: Int = now_microseconds()
					concurrent(max_threads: 4, timeout: 10000):
						server = serve_drip_writes(
							listener,
							count,
							chunks,
							delay_ms,
						)
						clients = run_chunked_readers(port, count, chunks)
					elapsed: Int = now_microseconds() - start
					stats: SchedulerStats = get_scheduler_stats()
					var checksum: Int = 0
					match server:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					match clients:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					Tcp.close(listener)
					print(
						"  " + count.to_string() + " slow TCP readers, " + chunks.to_string() + " chunks every " + delay_ms.to_string() + "ms: " + format_duration(
							elapsed,
						) + format_sched(stats),
					)
					black_box_int(checksum)
				Err(_):
					Tcp.close(listener)
					-1
		Err(_): -1


private func run_parked_read_fanout_case(count: Int, delay_ms: Int) -> Int:
	match Tcp.listen("127.0.0.1", 0, count):
		Ok(listener):
			match Tcp.local_port(listener):
				Ok(port):
					reset_scheduler_stats()
					start: Int = now_microseconds()
					concurrent(max_threads: 4, timeout: 5000):
						server = serve_delayed_writes(listener, count, delay_ms)
						clients = run_client_readers(port, count)
					elapsed: Int = now_microseconds() - start
					stats: SchedulerStats = get_scheduler_stats()
					var checksum: Int = 0
					match server:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					match clients:
						Ok(value): checksum += value
						Err(_): checksum -= 1000000
					Tcp.close(listener)
					print(
						"  " + count.to_string() + " parked TCP readers with " + delay_ms.to_string() + "ms delayed writes: " + format_duration(
							elapsed,
						) + format_sched(stats),
					)
					black_box_int(checksum)
				Err(_):
					Tcp.close(listener)
					-1
		Err(_): -1


func main(args: List[String]) -> Int:
	print("")
	print("=== TCP Virtual Thread Benchmarks ===")
	print("")
	var checksum: Int = 0
	checksum += run_accept_connect_case(64)
	checksum += run_accept_connect_case(256)
	checksum += run_connect_storm_case(128)
	checksum += run_idle_connection_case(128, 10)
	checksum += run_parked_read_fanout_case(32, 10)
	checksum += run_parked_read_fanout_case(128, 10)
	checksum += run_slow_writer_case(32, 4, 2)
	print("")
	print("checksum: " + black_box_int(checksum).to_string())
	0
