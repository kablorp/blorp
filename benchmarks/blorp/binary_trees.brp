import:
	int: max
	string: parse_int


-- Binary Trees benchmark
-- From the Computer Language Benchmarks Game
-- Stress tests memory allocation/deallocation with binary tree construction and traversal
union Tree:
	Leaf(Int)
	Node(Tree, Tree)


-- Build a complete binary tree of given depth
func make_with_value(depth: Int, value: Int) -> Tree:
	if depth == 0:
		Leaf(value)
	else:
		next: Int = value * 2
		Node(make_with_value(depth - 1, next), make_with_value(depth - 1, next + 1))


func make(depth: Int) -> Tree:
	make_with_value(depth, 1)


-- Check tree contents: Leaf = payload, Node = 1 + left + right
pure func check(tree: Tree) -> Int:
	match tree:
		Leaf(value): value
		Node(left, right): 1 + check(left) + check(right)


-- Compute 2^n using repeated multiplication
pure func power_of_two(n: Int) -> Int:
	var result: Int = 1
	var i: Int = 0
	while i < n:
		result *= 2
		i += 1
	result


func parse_n(args: List[String]) -> Option[Int]:
	s ?= args.get(1)
	v ?= parse_int(s)
	Some(v)


-- Return the larger of two integers
func main(args: List[String]):
	-- Parse N from command line, default 10
	-- N sets max_depth; min_depth is always 4 (per canonical benchmark)
	min_depth: Int = 4
	parsed_n: Option[Int] = parse_n(args)
	n: Int = parsed_n.get_or(10)
	max_depth: Int = max(n, min_depth + 2)
	stretch_depth: Int = max_depth + 1
	-- Step 1: Create and check stretch tree
	stretch_tree: Tree = make(stretch_depth)
	print(
		"stretch tree of depth " + to_string(
			stretch_depth,
		) + " check: " + to_string(check(stretch_tree)),
	)
	-- Step 2: Create long-lived tree
	long_lived_tree: Tree = make(max_depth)
	-- Step 3: For each depth, create many trees and sum checks
	var d: Int = min_depth
	while d <= max_depth:
		iterations: Int = power_of_two(max_depth - d + min_depth)
		var total_check: Int = 0
		for i in 0..iterations:
			tree: Tree = make(d)
			total_check += check(tree)
		print(
			to_string(
				iterations,
			) + " trees of depth " + to_string(d) + " check: " + to_string(total_check),
		)
		d += 2
	-- Step 4: Print long-lived tree check
	print(
		"long lived tree of depth " + to_string(
			max_depth,
		) + " check: " + to_string(check(long_lived_tree)),
	)
