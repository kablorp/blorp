import:
	int: max
	io: print
	option: get_or
	string: parse_int


-- Binary Trees benchmark from the Computer Language Benchmarks Game.
-- Builds and checks complete trees to stress allocation and deallocation.
-- A record carries each node because direct recursive unions allow one child.
record Tree { form: TreeForm }


union TreeForm:
	Leaf(Int)
	Node(Tree, Tree)


func make_with_value(depth: Int, value: Int) -> Tree:
	if depth.equals(0):
		{ form = Leaf(value) }
	else:
		next: Int = value * 2
		{ form = Node(
			make_with_value(depth - 1, next),
			make_with_value(depth - 1, next + 1),
		) }


func make(depth: Int) -> Tree:
	make_with_value(depth, 1)


-- Check tree contents: Leaf = payload, Node = 1 + left + right.
pure func check(tree: Tree) -> Int:
	match tree.form:
		Leaf(value):
			value
		Node(left, right):
			(1 + check(left)) + check(right)


pure func power_of_two(n: Int) -> Int:
	var result: Int = 1
	var i: Int = 0

	while i < n:
		result = result * 2
		i = i + 1

	result


func parse_n(args: List[String]) -> Option[Int]:
	match args.get(1):
		None:
			None
		Some(value):
			parse_int(value)


func main(args: List[String]) -> Int:
	-- N defaults to 10; min_depth stays 4 as in the canonical benchmark.
	min_depth: Int = 4
	parsed_n: Option[Int] = parse_n(args)
	n: Int = parsed_n.get_or(10)
	max_depth: Int = max(n, min_depth + 2)
	stretch_depth: Int = max_depth + 1

	stretch_tree: Tree = make(stretch_depth)
	print(
		("stretch tree of depth " + stretch_depth.to_string() + " check: ") + check(stretch_tree).to_string(),
	)

	long_lived_tree: Tree = make(max_depth)
	var d: Int = min_depth

	while d <= max_depth:
		iterations: Int = power_of_two((max_depth - d) + min_depth)
		var total_check: Int = 0

		for i in 0..iterations:
			tree: Tree = make(d)
			total_check = total_check + check(tree)

		print(
			iterations.to_string() + " trees of depth " + d.to_string() + " check: " + total_check.to_string(),
		)
		d = d + 2

	print(
		("long lived tree of depth " + max_depth.to_string() + " check: ") + check(long_lived_tree).to_string(),
	)
	0
