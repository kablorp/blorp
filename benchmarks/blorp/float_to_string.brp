import:
	float: to_string as float_string


-- Float to_string on values whose short `%g` form does not round-trip.
-- Standalone microbenchmark (not in bench.sh's cross-language list): the
-- runtime searches for the fewest significant digits that round-trip, and
-- most computed doubles such as a / b need 15 to 17 of them. Compare base
-- and candidate runtimes on retired instructions (`/usr/bin/time -l`). The
-- generated C embeds the compiler's runtime, so emit it with each compiler:
--
--   bin/blorp compile --no-format benchmarks/blorp/float_to_string.brp \
--     -o /tmp/float_to_string.c
--   clang -fwrapv -O2 -pthread -I blorp/src/lib/runtime/native \
--     -DBLORP_MEMORY_DIAGNOSTICS=0 /tmp/float_to_string.c -o /tmp/float_to_string -lm
--   /usr/bin/time -l /tmp/float_to_string
--
-- The printed checksum must match between runs.
ITERS: Int = 400000

-- Denominators cycle through 1..DENOMINATOR_COUNT so the quotients mix
-- short exact values (a / 1, a / 2) with 7- to 17-digit ones.
DENOMINATOR_COUNT: Int = 97


-- Keeps the order-sensitive length checksum within Int.
CHECKSUM_MODULUS: Int = 1000000007


func bench_float_text(iters: Int) -> Int:
	var checksum: Int = 0

	for i in 0..iters:
		numerator: Float = to_float(i + 1)
		denominator: Float = to_float(i % DENOMINATOR_COUNT + 1)
		text: String = float_string(numerator / denominator)
		checksum = (checksum * 31 + text.length()) % CHECKSUM_MODULUS

	checksum


func main(args: List[String]) -> Int:
	print("checksum: " + bench_float_text(ITERS).to_string())
	print("sample: " + float_string(to_float(ITERS) / to_float(DENOMINATOR_COUNT)))
	0
