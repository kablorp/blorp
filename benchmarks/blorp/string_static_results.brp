import:
	memory: MemStats, get_mem_stats
	string: from_char, string


-- Runtime string results that are fixed or already exist.
-- Standalone microbenchmark (not in bench.sh's cross-language list): Bool and
-- ASCII Char conversions, empty results, and joins with an empty operand.
-- Compare base and candidate runtimes on managed allocation counts
-- (printed below) and retired instructions (`/usr/bin/time -l`). The
-- generated C embeds the compiler's runtime, so emit it with each compiler:
--
--   bin/blorp compile --no-format benchmarks/blorp/string_static_results.brp \
--     -o /tmp/static_results.c
--   clang -fwrapv -O2 -pthread -I blorp/src/lib/runtime/native \
--     -DBLORP_MEMORY_DIAGNOSTICS=0 /tmp/static_results.c -o /tmp/static_results -lm
--   /usr/bin/time -l /tmp/static_results
--
-- For the allocation count build with -DBLORP_MEMORY_DIAGNOSTICS=1 and run
-- with BLORP_TRACK_STATS=1. The printed checksum must match between runs.
ITERS: Int = 2000000

-- Characters cycled through by the conversion loop: the 26 upper-case ASCII
-- letters starting at 'A', plus one two-byte character that still allocates.
LETTER_BASE: Int = 65

LETTER_COUNT: Int = 26

NON_ASCII_CODEPOINT: Int = 233


-- Impure so the conversions below cannot be folded at compile time.
func runtime_empty(seed: Int) -> String:
	if seed < 0:
		"never"
	else:
		string(0)


-- Every 64th character is non-ASCII; the rest cycle through the letters.
pure func conversion_codepoint(i: Int) -> Int:
	if i % 64 == 0:
		NON_ASCII_CODEPOINT
	else:
		LETTER_BASE + i % LETTER_COUNT


func bench_conversions(iters: Int) -> Int:
	var checksum: Int = 0

	for i in 0..iters:
		flag_text: String = (i % 3 == 0).to_string()
		char_text: String = from_char(conversion_codepoint(i).to_char())
		checksum += flag_text.length() * 7 + char_text.length()

	checksum


func bench_empty_joins(iters: Int) -> Int:
	empty: String = runtime_empty(iters)
	var checksum: Int = 0

	for i in 0..iters:
		char_text: String = from_char((LETTER_BASE + i % LETTER_COUNT).to_char())
		joined: String = "${empty}${char_text}"
		wrapped: String = "${empty}${joined}${empty}"
		checksum += wrapped.length() + (empty + joined).length()

	checksum


func main(args: List[String]) -> Int:
	conversions: Int = bench_conversions(ITERS)
	joins: Int = bench_empty_joins(ITERS)
	stats: MemStats = get_mem_stats()
	print("checksum: " + (conversions + joins).to_string())
	print("managed allocations: " + stats.total_allocations.to_string())
	0
