import:
	./support/benchmark: format_microseconds
	instrumentation: black_box_int
	list: range
	system: now_microseconds


private func noop_task(i: Int) -> Int:
	i


private func sleep_task(ms: Int, i: Int) -> Int:
	sleep(ms)
	i


private func consume_results(results: List[Result[Int, ConcurrencyError]]) -> Int:
	var checksum: Int = 0
	for result in results:
		match result:
			Ok(value): checksum += value
			Err(_): checksum -= 1
	black_box_int(checksum)


private func run_noop_case(count: Int) -> Int:
	start: Int = now_microseconds()
	results: List[Result[Int, ConcurrencyError]] = range(0, count).concurrent(
		count,
		func(i: Int): noop_task(i),
	)
	checksum: Int = consume_results(results)
	elapsed: Int = now_microseconds() - start
	print("  " + count.to_string() + " noop fibers: " + format_microseconds(elapsed))
	checksum


private func run_sleep_case(count: Int, ms: Int) -> Int:
	start: Int = now_microseconds()
	results: List[Result[Int, ConcurrencyError]] = range(0, count).concurrent(
		count,
		func(i: Int): sleep_task(ms, i),
	)
	checksum: Int = consume_results(results)
	elapsed: Int = now_microseconds() - start
	print(
		"  " + count.to_string() + " fibers sleeping " + ms.to_string() + "ms: " + format_microseconds(
			elapsed,
		),
	)
	checksum


private func warm_thread_pool() -> Int:
	concurrent:
		warm = noop_task(1)
	match warm:
		Ok(value): value
		Err(_): 0


func main(args: List[String]) -> Int:
	print("")
	print("=== Virtual Thread Benchmarks ===")
	print("")
	var checksum: Int = warm_thread_pool()
	checksum += run_noop_case(1000)
	checksum += run_noop_case(5000)
	checksum += run_noop_case(10000)
	checksum += run_sleep_case(50, 50)
	checksum += run_sleep_case(500, 10)
	checksum += run_sleep_case(5000, 10)
	print("")
	print("checksum: " + black_box_int(checksum).to_string())
	0
