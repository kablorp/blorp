import:
	dict: Dict, dict, get, remove, set


-- Dict Operations Benchmark
-- Tests: Build, Lookup Hit, Lookup Miss, Remove, Iterate
func bench_build(n: Int, iters: Int) -> Dict[Int, Int]:
	var d: Dict[Int, Int] = dict()

	for iter in 0..iters:
		d = dict()

		for i in 0..n:
			d = set(d, i, i * 7)

	d


func bench_lookup_hit(d: Dict[Int, Int], n: Int, iters: Int) -> Int:
	var checksum: Int = 0

	for iter in 0..iters:
		for i in 0..n:
			match get(d, i):
				Some(v): checksum += v
				None: checksum = checksum

	checksum


func bench_lookup_miss(d: Dict[Int, Int], n: Int, iters: Int) -> Int:
	var misses: Int = 0

	for iter in 0..iters:
		for i in n..n + n:
			match get(d, i):
				Some(_): misses = misses
				None: misses += 1

	misses


func bench_remove(n: Int, iters: Int) -> Int:
	var removed: Int = 0

	for iter in 0..iters:
		var d: Dict[Int, Int] = dict()

		for i in 0..n:
			d = set(d, i, i * 7)

		for i in 0..n:
			d = remove(d, i)
			removed += 1

	removed


func bench_iterate(d: Dict[Int, Int], iters: Int) -> Int:
	var total: Int = 0

	for iter in 0..iters:
		for (k, v) in d:
			total += v

	total


func main(args: List[String]):
	N: Int = 10000
	d: Dict[Int, Int] = bench_build(N, 100)
	print("build: done")
	hit_sum: Int = bench_lookup_hit(d, N, 100)
	print("lookup_hit checksum: " + to_string(hit_sum))
	miss_count: Int = bench_lookup_miss(d, N, 100)
	print("lookup_miss count: " + to_string(miss_count))
	rem_count: Int = bench_remove(N, 100)
	print("remove count: " + to_string(rem_count))
	iter_sum: Int = bench_iterate(d, 1000)
	print("iterate sum: " + to_string(iter_sum))
