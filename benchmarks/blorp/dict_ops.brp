import:
	dict as D
	io: print


-- Same inputs and work counts as benchmarks/legacy/dict_ops.brp: build, lookup
-- hit, lookup miss, remove and iterate over Int keys. Iterating walks D.values,
-- since a Dict has no for loop; the legacy loop sums only the values as well.
func bench_build(n: Int, iters: Int) -> D.Dict[Int, Int]:
	var d: D.Dict[Int, Int] = D.empty()

	for _ in 0..iters:
		d = D.empty()

		for i in 0..n:
			d = D.set(d, i, i * 7)

	d


func bench_lookup_hit(d: D.Dict[Int, Int], n: Int, iters: Int) -> Int:
	var checksum = 0

	for _ in 0..iters:
		for i in 0..n:
			match D.get(d, i):
				Some(v):
					checksum = checksum + v
				None:
					void

	checksum


func bench_lookup_miss(d: D.Dict[Int, Int], n: Int, iters: Int) -> Int:
	var misses = 0

	for _ in 0..iters:
		for i in n..n + n:
			match D.get(d, i):
				Some(_):
					void
				None:
					misses = misses + 1

	misses


func bench_remove(n: Int, iters: Int) -> Int:
	var removed = 0

	for _ in 0..iters:
		var d: D.Dict[Int, Int] = D.empty()

		for i in 0..n:
			d = D.set(d, i, i * 7)

		for i in 0..n:
			d = D.remove(d, i)
			removed = removed + 1

	removed


func bench_iterate(d: D.Dict[Int, Int], iters: Int) -> Int:
	var total = 0

	for _ in 0..iters:
		for v in D.values(d):
			total = total + v

	total


func main(args: List[String]) -> Int:
	n = 10000
	d = bench_build(n, 100)
	print("build: done")
	hit_sum = bench_lookup_hit(d, n, 100)
	print("lookup_hit checksum: " + hit_sum.to_string())
	miss_count = bench_lookup_miss(d, n, 100)
	print("lookup_miss count: " + miss_count.to_string())
	rem_count = bench_remove(n, 100)
	print("remove count: " + rem_count.to_string())
	iter_sum = bench_iterate(d, 1000)
	print("iterate sum: " + iter_sum.to_string())
	0
