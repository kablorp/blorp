import:
	dict as D: Dict
	list: get, length, sort_by
	string: length as str_length, parse_int, repeat, substring


-- K-nucleotide benchmark
-- Simplified implementation from the Computer Language Benchmarks Game
-- Counts occurrences of nucleotide subsequences in a DNA string
-- Hardcoded test DNA sequence (a fragment representative of FASTA input)
pure func sample_dna() -> String:
	(
		"GGTATTTTAATTTATAGTGGTATTTTAATTTATAGTACGTACGTACGTACGTGGTATTTTAATTTATAGTAACGTGGTAT"
		+ "TTTAATTTATAGTTGCAGGTATTTTAATTTATAGTACGGTATTACGTGGTATTTTAATTTATAGTGGTATTTTAATTTAT"
		+ "AGTTCGATCGATCGATCGATGGTAACGTACGTGGTATTTTAATTTATAGTTTTAACGGTATTTTAATTTATAGTAGCTAG"
		+ "CTAGCTAGCTAGACGTACGTGGTATTTTAATTTATAGTTGCATGCATG"
	)


-- Build a deterministic sequence of exactly N characters by repeating the
-- shared sample. Keep this in sync with the Go/Python benchmark variants.
func build_sequence(n: Int) -> String:
	base: String = sample_dna()
	if n <= 0:
		""
	else:
		base_len: Int = str_length(base)
		copies: Int = n / base_len + 1
		substring(repeat(base, copies), 0, n)


-- Count all subsequences of length k in the sequence
func count_kmers(seq: String, k: Int) -> Dict[String, Int]:
	var counts: Dict[String, Int] = D.dict()
	seq_len: Int = str_length(seq)
	var i: Int = 0
	while i <= seq_len - k:
		kmer: String = substring(seq, i, k)
		match D.get(counts, kmer):
			Some(c): counts = D.set(counts, kmer, c + 1)
			None: counts = D.set(counts, kmer, 1)
		i += 1
	counts


-- Format a float as a frequency with 3 decimal places (approximate)
pure func format_freq(f: Float) -> String:
	-- Multiply by 1000, round, then format
	scaled: Int = to_int(f * 1000.0 + 0.5)
	whole: Int = scaled / 1000
	frac: Int = scaled % 1000
	var frac_str: String = to_string(frac)

	-- Pad fraction to 3 digits
	while str_length(frac_str) < 3:
		frac_str = "0" + frac_str
	to_string(whole) + "." + frac_str


-- Print frequency table for k-mers sorted by frequency (descending)
func print_frequencies(seq: String, k: Int) -> Void:
	counts: Dict[String, Int] = count_kmers(seq, k)
	seq_len: Int = str_length(seq)
	total: Float = to_float(seq_len - k + 1)

	-- Get entries as list of tuples and sort by count descending
	entries: List[(String, Int)] = D.entries(counts)
	sorted_entries: List[(String, Int)] = sort_by(entries, func(e: (String, Int)): 0 - e.1)

	-- Print each k-mer and its frequency percentage
	for i in 0..length(sorted_entries):
		match get(sorted_entries, i):
			Some(entry):
				kmer: String = entry.0
				count: Int = entry.1
				freq: Float = to_float(count) * 100.0 / total
				print(kmer + " " + format_freq(freq))
			None: void
	print("")


-- Count occurrences of a specific sequence
func count_specific(seq: String, pattern: String) -> Int:
	k: Int = str_length(pattern)
	counts: Dict[String, Int] = count_kmers(seq, k)
	match D.get(counts, pattern):
		Some(c): c
		None: 0


func parse_n(args: List[String]) -> Option[Int]:
	s ?= get(args, 1)
	v ?= parse_int(s)
	Some(v)


func main(args: List[String]):
	-- Parse N from command line (target sequence length), default 100
	parsed_n: Option[Int] = parse_n(args)
	n: Int = parsed_n.get_or(100)
	seq: String = build_sequence(n)
	print_frequencies(seq, 1)
	print_frequencies(seq, 2)
	patterns: List[String] = ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"]
	for i in 0..length(patterns):
		match get(patterns, i):
			Some(pattern):
				c: Int = count_specific(seq, pattern)
				print(to_string(c) + "\t" + pattern)
			None: void
