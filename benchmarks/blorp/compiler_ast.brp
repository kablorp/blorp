-- Compiler-shaped AST pass benchmark.
-- Models repeated recursive IR rewrites over immutable tree nodes.
union Expr:
	ELit(Int)
	EVar(Int)
	EAdd(Expr, Expr)
	EMul(Expr, Expr)
	ELet(Int, Expr, Expr)
	EIf(Expr, Expr, Expr)


pure func build_expr(depth: Int, seed: Int) -> Expr:
	if depth <= 0:
		if seed % 3 == 0:
			EVar(seed % 4096)
		else:
			ELit((seed * 17 + 11) % 100000)
	else:
		next: Int = seed * 3 + depth

		match depth % 5:
			0:
				EAdd(build_expr(depth - 1, next), build_expr(depth - 1, next + 1))
			1:
				EMul(build_expr(depth - 1, next), build_expr(depth - 1, next + 3))
			2:
				ELet(seed % 8192, build_expr(depth - 1, next), build_expr(depth - 1, next + 5))
			3:
				EIf(
					build_expr(
						depth - 1,
						next,
					),
					build_expr(
						depth - 2,
						next + 7,
					),
					build_expr(
						depth - 2,
						next + 11,
					),
				)
			_:
				EAdd(build_expr(depth - 1, next + 13), build_expr(depth - 1, next + 17))


pure func rewrite_expr(expr: Expr, pass: Int) -> Expr:
	match expr:
		ELit(value):
			ELit((value + pass * 13 + 7) % 1000003)
		EVar(id):
			EVar((id * 33 + pass + 19) % 16384)
		EAdd(left, right):
			if pass % 7 == 0:
				EAdd(rewrite_expr(right, pass), rewrite_expr(left, pass))
			else:
				EAdd(rewrite_expr(left, pass), rewrite_expr(right, pass))
		EMul(left, right):
			EMul(rewrite_expr(left, pass), rewrite_expr(right, pass))
		ELet(name, value, body):
			ELet((name + pass) % 16384, rewrite_expr(value, pass), rewrite_expr(body, pass + 1))
		EIf(cond, then_expr, else_expr):
			EIf(
				rewrite_expr(
					cond,
					pass,
				),
				rewrite_expr(
					then_expr,
					pass + 2,
				),
				rewrite_expr(
					else_expr,
					pass + 3,
				),
			)


pure func checksum_expr(expr: Expr) -> Int:
	match expr:
		ELit(value): value + 3
		EVar(id): id * 5 + 7
		EAdd(left, right): 11 + checksum_expr(left) * 3 + checksum_expr(right)
		EMul(left, right): 17 + checksum_expr(left) + checksum_expr(right) * 3
		ELet(name, value, body): 23 + name + checksum_expr(value) + checksum_expr(body) * 5
		EIf(cond, then_expr, else_expr):
			31 + checksum_expr(cond) + checksum_expr(then_expr) * 7 + checksum_expr(else_expr)


func run_pipeline(depth: Int, passes: Int) -> Int:
	var expr: Expr = build_expr(depth, 19)
	var checksum: Int = 0

	for pass in 0..passes:
		expr = rewrite_expr(expr, pass)

		if pass % 8 == 0:
			checksum += checksum_expr(expr)

	checksum + checksum_expr(expr)


func main(args: List[String]):
	checksum: Int = run_pipeline(11, 80)
	print("compiler_ast checksum: " + checksum.to_string())
