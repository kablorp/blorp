-- Same generated bytes and append chunks as benchmarks/go/compiler_emit.go.
-- Provisional library difference: the target String API cannot reserve capacity.
import:
    io/console: print


pure func emit_program(functions: Int, blocks: Int, statements: Int) -> String:
    var out = ""
    out = out + "/* generated benchmark program */\n"

    for function_id in 0..functions:
        out = out + "static long f"
        out = out.append_int(function_id)
        out = out + "(long seed) {\n"
        out = out + "  long acc = seed;\n"

        for i in 0..24:
            out = out + "  long v"
            out = out.append_int(i)
            out = out + " = seed + "
            out = out.append_int(function_id + i)
            out = out + ";\n"

        for block_id in 0..blocks:
            out = out + "block_"
            out = out.append_int(block_id)
            out = out + ":\n"

            for statement_id in 0..statements:
                target = ((statement_id + function_id) + block_id) % 17
                left = ((statement_id * 3) + function_id) % 23
                right = ((block_id * 5) + statement_id) % 29
                out = out + "  v"
                out = out.append_int(target)
                out = out + " = v"
                out = out.append_int(left)
                out = out + " + "
                out = out.append_int(right)
                out = out + ";\n"

            if (block_id % 3).equals(0):
                out = out + "  goto block_"
                out = out.append_int(block_id + 1)
                out = out + ";\n"
            else:
                out = out + "  acc += v"
                out = out.append_int(block_id % 17)
                out = out + ";\n"

        out = out + "  return acc;\n}\n"

    out


pure func checksum_text(text: String) -> Int:
    var checksum = 0

    for i in 0..text.length():
        -- Every emitted character is ASCII, so byte_at matches Char.to_int.
        match text.byte_at(i):
            Some(byte): checksum = (checksum * 33) + byte.to_int()
            None: void

    checksum


func main(args: List[String]) -> Int:
    text = emit_program(120, 10, 8)
    print("compiler_emit checksum: " + checksum_text(text).to_string())
    print(
        (
            "compiler_emit bytes: "
            + text
                .length()
                .to_string()
        ),
    )
    0
