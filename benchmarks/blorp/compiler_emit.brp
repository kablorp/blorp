-- Compiler-shaped code emission benchmark.
-- Models generated C emission from a simple IR. This intentionally stresses
-- repeated string construction because that is a self-hosting risk area.
pure func emit_statement(function_id: Int, block_id: Int, statement_id: Int) -> String:
	target: Int = (statement_id + function_id + block_id) % 17
	left: Int = (statement_id * 3 + function_id) % 23
	right: Int = (block_id * 5 + statement_id) % 29
	"  v" + target.to_string() + " = v" + left.to_string() + " + " + right.to_string() + ";\n"


pure func emit_block(function_id: Int, block_id: Int, statements: Int) -> String:
	var out: String = "block_" + block_id.to_string() + ":\n"
	for statement_id in 0..statements:
		out += emit_statement(function_id, block_id, statement_id)
	if block_id % 3 == 0:
		out + "  goto block_" + (block_id + 1).to_string() + ";\n"
	else:
		out + "  acc += v" + (block_id % 17).to_string() + ";\n"


pure func emit_function(function_id: Int, blocks: Int, statements: Int) -> String:
	var out: String = "static long f" + function_id.to_string() + "(long seed) {\n"
	out += "  long acc = seed;\n"
	for i in 0..24:
		out = out + "  long v" + i.to_string() + " = seed + " + (function_id + i).to_string() + ";\n"
	for block_id in 0..blocks:
		out += emit_block(function_id, block_id, statements)
	out + "  return acc;\n}\n"


pure func emit_program(functions: Int, blocks: Int, statements: Int) -> String:
	var out: String = "/* generated benchmark program */\n"
	for function_id in 0..functions:
		out += emit_function(function_id, blocks, statements)
	out


pure func checksum_text(text: String) -> Int:
	var checksum: Int = 0
	for i in 0..text.length():
		match text.get(i):
			Some(ch):
				checksum = checksum * 33 + ch.to_int()
			None:
				void
	checksum


func main(args: List[String]):
	text: String = emit_program(120, 10, 8)
	print("compiler_emit checksum: " + checksum_text(text).to_string())
	print("compiler_emit bytes: " + text
			.length()
			.to_string())
