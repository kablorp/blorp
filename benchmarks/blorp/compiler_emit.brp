-- Compiler-shaped code emission benchmark.
-- Models generated C emission from a simple IR. This intentionally stresses
-- repeated output construction because that is a self-hosting risk area.
import:
	string: string


pure func estimated_program_capacity(functions: Int, blocks: Int, statements: Int) -> Int:
	functions * (blocks * (statements * 32 + 48) + 768) + 64


pure func emit_program(functions: Int, blocks: Int, statements: Int) -> String:
	var out: String = string(estimated_program_capacity(functions, blocks, statements))
	out = out.append_str("/* generated benchmark program */\n")
	for function_id in 0..functions:
		out = out.append_str("static long f")
		out = out.append_str(function_id.to_string())
		out = out.append_str("(long seed) {\n")
		out = out.append_str("  long acc = seed;\n")
		for i in 0..24:
			out = out.append_str("  long v")
			out = out.append_str(i.to_string())
			out = out.append_str(" = seed + ")
			out = out.append_str((function_id + i).to_string())
			out = out.append_str(";\n")
		for block_id in 0..blocks:
			out = out.append_str("block_")
			out = out.append_str(block_id.to_string())
			out = out.append_str(":\n")
			for statement_id in 0..statements:
				target: Int = (statement_id + function_id + block_id) % 17
				left: Int = (statement_id * 3 + function_id) % 23
				right: Int = (block_id * 5 + statement_id) % 29
				out = out.append_str("  v")
				out = out.append_str(target.to_string())
				out = out.append_str(" = v")
				out = out.append_str(left.to_string())
				out = out.append_str(" + ")
				out = out.append_str(right.to_string())
				out = out.append_str(";\n")
			if block_id % 3 == 0:
				out = out.append_str("  goto block_")
				out = out.append_str((block_id + 1).to_string())
				out = out.append_str(";\n")
			else:
				out = out.append_str("  acc += v")
				out = out.append_str((block_id % 17).to_string())
				out = out.append_str(";\n")
		out = out.append_str("  return acc;\n}\n")
	out


pure func checksum_text(text: String) -> Int:
	var checksum: Int = 0
	for i in 0..text.length():
		match text.get(i):
			Some(ch):
				checksum = checksum * 33 + ch.to_int()
			None:
				void
	checksum


func main(args: List[String]):
	text: String = emit_program(120, 10, 8)
	print("compiler_emit checksum: " + checksum_text(text).to_string())
	print("compiler_emit bytes: " + text
			.length()
			.to_string())
