import:
	list: append, get, length
	string as Str: chars, from_chars, parse_int, reverse, split, starts_with, substring, trim, upper


pure func complement(c: Char) -> Char:
	match c:
		'A': 'T'
		'T': 'A'
		'C': 'G'
		'G': 'C'
		'M': 'K'
		'K': 'M'
		'R': 'Y'
		'Y': 'R'
		'W': 'W'
		'S': 'S'
		'V': 'B'
		'B': 'V'
		'H': 'D'
		'D': 'H'
		'N': 'N'
		'a': 't'
		't': 'a'
		'c': 'g'
		'g': 'c'
		'm': 'k'
		'k': 'm'
		'r': 'y'
		'y': 'r'
		'w': 'w'
		's': 's'
		'v': 'b'
		'b': 'v'
		'h': 'd'
		'd': 'h'
		'n': 'n'
		_: c


pure func complement_string(s: String) -> String:
	cs: List[Char] = chars(s)
	var result: List[Char] = []
	for i in 0..length(cs):
		match get(cs, i):
			Some(c): result = append(result, complement(c))
			None: void
	from_chars(result)


pure func reverse_complement(seq: String) -> String:
	reversed: String = reverse(seq)
	complement_string(reversed)


func print_wrapped(seq: String, line_width: Int) -> Void:
	n: Int = Str.length(seq)
	var pos: Int = 0
	while pos < n:
		remaining: Int = n - pos
		chunk_len: Int = if remaining < line_width:
			remaining
		else:
			line_width
		print(substring(seq, pos, chunk_len))
		pos += chunk_len


pure func parse_fasta(input: String) -> List[(String, String)]:
	lines: List[String] = split(input, "\n")
	var sequences: List[(String, String)] = []
	var current_header: String = ""
	var current_seq: String = ""
	var in_sequence: Bool = False
	for i in 0..length(lines):
		match get(lines, i):
			Some(line):
				trimmed: String = trim(line)
				if Str.length(trimmed) > 0:
					if starts_with(trimmed, ">"):
						if in_sequence:
							sequences = append(sequences, (current_header, current_seq))
						current_header = trimmed
						current_seq = ""
						in_sequence = True
					else:
						current_seq += upper(trimmed)
			None: void
	if in_sequence:
		sequences = append(sequences, (current_header, current_seq))
	sequences


pure func repeat_string(s: String, n: Int) -> String:
	var result: String = ""
	var i: Int = 0
	while i < n:
		result += s
		i += 1
	result


func test_fasta_data() -> String:
	seq_one: String = "CTTGGCACCCGAGCAGCTCAAGGAGATGGCCACCACGCTGCCTGCCGCTGACCTCCTGGCGAAGCTGACCTCCTGGCGAAGATGCCACCACGCTGCCTGCC"
	seq_two: String = "ATGGCCAATGCCACTGCCGTCGTTTTACACAACGTTTGCCACCACGCTGCCTGCCGCTGACCTCCTGGCGAAGCTGAAGATGCCACCACGCTGCCTGCCGCTGA"
	seq_three: String = "GCCACTGCCACCGGCAATCGCAAATGTGCCACTGCATCGTTTTACACNNNNNGTTTGCCACCACGCTGCCTGCCGCTGACCTCCTGGCGAAGCTGACCTCCTGGCGAAGCTGAAGATGCCACCACGCTGCCTGCCGCTGAMRWSYKVHDBN"
	">ONE Homo sapiens alu\n" + seq_one + "\n>TWO IUB ambiguity codes\n" + seq_two + "\n>THREE Homo sapiens frequency\n" + seq_three


func main(args: List[String]):
	parsed_n: Option[Int] = try:
		s ?= get(args, 1)
		v ?= parse_int(s)
		v
	n: Int = parsed_n.get_or(1)
	base_fasta: String = test_fasta_data()
	base_sequences: List[(String, String)] = parse_fasta(base_fasta)
	var total_nucleotides: Int = 0
	for i in 0..length(base_sequences):
		match get(base_sequences, i):
			Some(pair):
				header: String = pair.0
				seq: String = pair.1
				full_seq: String = repeat_string(seq, n)
				rc: String = reverse_complement(full_seq)
				total_nucleotides += Str.length(rc)
				print(header)
				print_wrapped(rc, 60)
			None: void
	print("Total nucleotides: ${to_string(total_nucleotides)}")
