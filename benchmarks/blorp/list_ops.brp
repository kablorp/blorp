import:
	list: List, append, concat, filter, fold_left, get, length, reverse, sort


-- List Operations Benchmark
-- Tests: Append, Sort, Filter, Fold, Reverse, Concat
func make_shuffled(n: Int) -> List[Int]:
	var list: List[Int] = []
	for i in 0..n:
		val: Int = (i * 1103515245 + 12345) % n
		list = append(list, val)
	list


func bench_append(n: Int, iters: Int) -> Int:
	var checksum: Int = 0
	for iter in 0..iters:
		var list: List[Int] = []
		for i in 0..n:
			list = append(list, i)
		checksum += length(list)
	checksum


func bench_sort(shuffled: List[Int], iters: Int) -> Int:
	var checksum: Int = 0
	for iter in 0..iters:
		sorted: List[Int] = sort(shuffled)
		first: Int = match get(sorted, 0):
			Some(v): v
			None: 0
		middle: Int = match get(sorted, length(sorted) / 2):
			Some(v): v
			None: 0
		last: Int = match get(sorted, length(sorted) - 1):
			Some(v): v
			None: 0
		checksum += length(sorted) + first + middle + last
	checksum


func bench_filter(list: List[Int], iters: Int) -> Int:
	var checksum: Int = 0
	for iter in 0..iters:
		evens: List[Int] = filter(list, func(x: Int): x % 2 == 0)
		checksum += length(evens)
	checksum


func bench_fold(list: List[Int], iters: Int) -> Int:
	var checksum: Int = 0
	for iter in 0..iters:
		total: Int = fold_left(list, 0, func(acc: Int, x: Int): acc + x)
		checksum += total
	checksum


func bench_reverse(list: List[Int], iters: Int) -> Int:
	var checksum: Int = 0
	for iter in 0..iters:
		rev: List[Int] = reverse(list)
		checksum += length(rev)
	checksum


func bench_concat(a: List[Int], b: List[Int], iters: Int) -> Int:
	var checksum: Int = 0
	for iter in 0..iters:
		combined: List[Int] = concat(a, b)
		checksum += length(combined)
	checksum


func main(args: List[String]):
	N: Int = 10000
	append_check: Int = bench_append(N, 500)
	print("append checksum: " + to_string(append_check))
	shuffled: List[Int] = make_shuffled(N)
	sort_check: Int = bench_sort(shuffled, 200)
	print("sort checksum: " + to_string(sort_check))

	-- Build a sequential list for filter/fold/reverse
	var seq: List[Int] = []
	for i in 0..N:
		seq = append(seq, i)
	filter_check: Int = bench_filter(seq, 500)
	print("filter checksum: " + to_string(filter_check))
	fold_check: Int = bench_fold(seq, 2000)
	print("fold checksum: " + to_string(fold_check))
	reverse_check: Int = bench_reverse(seq, 1000)
	print("reverse checksum: " + to_string(reverse_check))

	-- Split for concat benchmark
	var a: List[Int] = []
	var b: List[Int] = []
	half: Int = N / 2
	for i in 0..half:
		a = append(a, i)
	for i in half..N:
		b = append(b, i)
	concat_check: Int = bench_concat(a, b, 1000)
	print("concat checksum: " + to_string(concat_check))
