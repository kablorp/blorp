import:
	float: format, sqrt
	list as L: append, get
	string: parse_int


-- Spectral norm benchmark
-- From the Computer Language Benchmarks Game
-- Compute the spectral norm of an infinite matrix A
-- where A[i][j] = 1 / ((i+j)(i+j+1)/2 + i + 1)
-- Matrix element: A[i][j] = 1 / ((i+j)(i+j+1)/2 + i + 1)
pure func a_element(i: Int, j: Int) -> Float:
	1.0 / to_float((i + j) * (i + j + 1) / 2 + i + 1)


-- Safe list access that returns 0.0 for out-of-bounds
pure func list_get_f(lst: List[Float], idx: Int) -> Float:
	L
		.get(lst, idx)
		.get_or(0.0)


-- Multiply vector by matrix A: result[i] = sum_j(A[i][j] * v[j])
func multiply_av(v: List[Float], n: Int) -> List[Float]:
	var result: List[Float] = []
	for i in 0..n:
		var sum: Float = 0.0
		for j in 0..n:
			sum += a_element(i, j) * list_get_f(v, j)
		result = append(result, sum)
	result


-- Multiply vector by A^T: result[i] = sum_j(A[j][i] * v[j])
func multiply_atv(v: List[Float], n: Int) -> List[Float]:
	var result: List[Float] = []
	for i in 0..n:
		var sum: Float = 0.0
		for j in 0..n:
			sum += a_element(j, i) * list_get_f(v, j)
		result = append(result, sum)
	result


-- Multiply by A^T * A (one step of the power method)
func multiply_atav(v: List[Float], n: Int) -> List[Float]:
	temp: List[Float] = multiply_av(v, n)
	multiply_atv(temp, n)


func parse_n(args: List[String]) -> Option[Int]:
	s ?= get(args, 1)
	v ?= parse_int(s)
	Some(v)


func main(args: List[String]):
	-- Parse N from command line, default 500
	parsed_n: Option[Int] = parse_n(args)
	n: Int = parsed_n.get_or(500)

	-- Initialize u to all 1.0s
	var u: List[Float] = []
	for i in 0..n:
		u = append(u, 1.0)

	-- Initialize v to all 0.0s
	var v: List[Float] = []
	for i in 0..n:
		v = append(v, 0.0)

	-- 10 iterations of the power method
	for i in 0..10:
		v = multiply_atav(u, n)
		u = multiply_atav(v, n)

	-- Compute vBv = dot(u, v) and vv = dot(v, v)
	var vbv: Float = 0.0
	var vv: Float = 0.0
	for i in 0..n:
		ui: Float = list_get_f(u, i)
		vi: Float = list_get_f(v, i)
		vbv += ui * vi
		vv += vi * vi

	-- Result: sqrt(vBv / vv)
	result: Float = sqrt(vbv / vv)
	print(format(result, 9))
