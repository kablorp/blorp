import:
	instrumentation: black_box_int
	list: range
	string: parse_int
	system: getenv


func env_int(name: String, default: Int) -> Int:
	match getenv(name):
		Some(raw):
			match parse_int(raw):
				Some(value):
					if value > 0:
						value
					else:
						default
				None: default
		None: default


func sleep_task(ms: Int, i: Int) -> Int:
	sleep(ms)
	i


func consume_results(results: List[Result[Int, ConcurrencyError]]) -> Int:
	var checksum: Int = 0

	for result in results:
		match result:
			Ok(value): checksum += value
			Err(_): checksum -= 1

	black_box_int(checksum)


func main(args: List[String]) -> Int:
	tasks: Int = env_int("BENCH_SLEEP_TASKS", 512)
	ms: Int = env_int("BENCH_SLEEP_MS", 5)
	results: List[Result[Int, ConcurrencyError]] = range(0, tasks).concurrent(
		tasks,
		func(i: Int): sleep_task(ms, i),
	)
	checksum: Int = consume_results(results)
	print("checksum: " + checksum.to_string())
	0
