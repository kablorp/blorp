import:
	./support/particle_gravity_kernel: build_particle_tree, run_particle_gravity_kernel
	instrumentation: black_box_float
	list: get
	string: parse_int


-- Particle-sim-derived gravity benchmark.
--
-- This is intentionally portable: it keeps the compiler/runtime hot shapes from
-- scratch/particle_sim without depending on SDL or local native headers.
func parse_frames(args: List[String]) -> Option[Int]:
	s ?= get(args, 1)
	v ?= parse_int(s)
	Some(v)


func main(args: List[String]) -> Int:
	parsed_frames: Option[Int] = parse_frames(args)
	frames: Int = parsed_frames.get_or(30)
	tree_result = build_particle_tree(17)
	tree = tree_result.0
	alive: Float[#1024] = vector(1.0, 1024)
	checksum: Float = black_box_float(run_particle_gravity_kernel(frames, 1024, tree, alive))
	print("particle_gravity checksum=${to_string(to_int(checksum * 1000000.0))}")
	0
