import:
	dict: Dict, contains, dict, entries, get, keys, remove, set
	option: Option(Some, None)
	time: now


-- Dict profiling — isolate each operation to find the bottleneck
func bench(label: String, start: Int, end: Int) -> Void:
	ms: Int = (end - start) / 1000
	print("  " + label + ": " + to_string(ms) + "ms")


func main(args: List[String]):
	N: Int = 10000
	ITERS: Int = 100

	-- 1. Build (insert N keys, ITERS times)
	t0: Int = now()
	var d: Dict[Int, Int] = dict()

	for iter in 0..ITERS:
		d = dict()

		for i in 0..N:
			d = set(d, i, i * 7)

	t1: Int = now()
	bench("build (" + to_string(N) + " x " + to_string(ITERS) + ")", t0, t1)

	-- 2. Lookup hit
	t2: Int = now()
	var checksum: Int = 0

	for iter in 0..ITERS:
		for i in 0..N:
			match get(d, i):
				Some(v): checksum += v
				None: void

	t3: Int = now()
	bench("lookup_hit (" + to_string(N) + " x " + to_string(ITERS) + ")", t2, t3)

	-- 3. Lookup miss
	t4: Int = now()
	var misses: Int = 0

	for iter in 0..ITERS:
		for i in N..N + N:
			match get(d, i):
				Some(_): void
				None: misses += 1

	t5: Int = now()
	bench("lookup_miss (" + to_string(N) + " x " + to_string(ITERS) + ")", t4, t5)

	-- 4. Contains (no Option allocation, just bool)
	t6: Int = now()
	var hits: Int = 0

	for iter in 0..ITERS:
		for i in 0..N:
			if contains(d, i):
				hits += 1

	t7: Int = now()
	bench("contains (" + to_string(N) + " x " + to_string(ITERS) + ")", t6, t7)

	-- 5. Remove
	t8: Int = now()

	for iter in 0..ITERS:
		var d2: Dict[Int, Int] = dict()

		for i in 0..N:
			d2 = set(d2, i, i)

		for i in 0..N:
			d2 = remove(d2, i)

	t9: Int = now()
	bench("remove (build+remove " + to_string(N) + " x " + to_string(ITERS) + ")", t8, t9)

	-- 6. Iterate via entries()
	t10: Int = now()
	var total: Int = 0

	for iter in 0..100:
		es: List[(Int, Int)] = entries(d)

		for (k, v) in es:
			total += v

	t11: Int = now()
	bench("iterate entries (10k x 100)", t10, t11)

	-- 7. Iterate via keys()
	t12: Int = now()
	var ksum: Int = 0

	for iter in 0..100:
		ks: List[Int] = keys(d)

		for k in ks:
			ksum += k

	t13: Int = now()
	bench("iterate keys (10k x 100)", t12, t13)

	-- 8. Overwrite (set existing keys)
	t14: Int = now()
	var d3: Dict[Int, Int] = d

	for iter in 0..ITERS:
		for i in 0..N:
			d3 = set(d3, i, i * 3)

	t15: Int = now()
	bench("overwrite (" + to_string(N) + " x " + to_string(ITERS) + ")", t14, t15)
	print("")
	print(
		"checksum=" + to_string(
			checksum,
		) + " misses=" + to_string(misses) + " hits=" + to_string(hits),
	)
