import:
	../../../blorp/src/compiler/stage_09_core/ir:
		CoreCallKind(UserCall),
		CoreDecl(FunctionDecl),
		CoreExpr(CallExpr, LiteralExpr, VarExpr, VoidExpr),
		CoreFunction,
		CoreFunctionKind(UserFunction),
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreProgram,
		CoreType(NamedType, VoidType),
		CoreVar,
		synthetic_core_source_loc,
	../../../blorp/src/compiler/stage_09_core/pipeline: run_pre_dce_tail
	../../../blorp/src/compiler/stage_10_backend/emit:
		try_emit_prepared_core_program_c_artifact_with_profile,
	../../../blorp/src/lib/function_profile: FunctionProfileConfiguration(FunctionProfileOff)
	memory: get_mem_stats, reset_mem_stats


private FIXTURE_FUNCTION_COUNT: Int = 64

private COMBINE_MIXED_DEF_ID: Int = 19001

private EFFECTFUL_MIXED_ARG_DEF_ID: Int = 19002


private pure func int_type() -> CoreType:
	NamedType("Int", [])


private pure func closure_type() -> CoreType:
	NamedType("Closure", [])


private pure func named_var(name: String) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = None
	}


private pure func fixture_param(name: String, id: Int, typ: CoreType) -> CoreParam:
	{
		name = {
			name = name,
			id = id,
			def_id = None
		},
		typ = typ,
		loc = synthetic_core_source_loc()
	}


private pure func fixture_target_function(
	name: String,
	def_id: Int,
	params: List[CoreParam],
) -> CoreFunction:
	{
		name = name,
		source_module = None,
		type_params = [],
		params = params,
		return_type = int_type(),
		body = Some(LiteralExpr(IntLiteral(0), int_type(), synthetic_core_source_loc())),
		is_pure = True,
		function_kind = UserFunction,
		def_id = def_id,
		loc = synthetic_core_source_loc()
	}


private pure func emitted_call(name: String, def_id: Int) -> CoreExpr:
	CallExpr(
		UserCall(name, Some(def_id), []),
		VarExpr(named_var(name), closure_type(), synthetic_core_source_loc()),
		[],
		int_type(),
		synthetic_core_source_loc(),
	)


private pure func fixture_function(index: Int) -> CoreFunction:
	source: CoreVar = named_var("source")
	param: CoreParam = {
		name = source,
		typ = int_type(),
		loc = synthetic_core_source_loc()
	}
	{
		name = "mixed_call_" + index.to_string(),
		source_module = None,
		type_params = [],
		params = [param],
		return_type = int_type(),
		body = Some(
			CallExpr(
				UserCall(
					"combine_mixed",
					Some(COMBINE_MIXED_DEF_ID),
					[],
				),
				VarExpr(
					named_var("combine_mixed"),
					closure_type(),
					synthetic_core_source_loc(),
				),
				[
					LiteralExpr(IntLiteral(11), int_type(), synthetic_core_source_loc()),
					VarExpr(source, int_type(), synthetic_core_source_loc()),
					VoidExpr(VoidType, synthetic_core_source_loc()),
					emitted_call("effectful_mixed_arg", EFFECTFUL_MIXED_ARG_DEF_ID),
					LiteralExpr(IntLiteral(7), int_type(), synthetic_core_source_loc()),
				],
				int_type(),
				synthetic_core_source_loc(),
			),
		),
		is_pure = True,
		function_kind = UserFunction,
		def_id = 20000 + index,
		loc = synthetic_core_source_loc()
	}


private pure func fixture_program() -> CoreProgram:
	-- The production emitter projects only declared callable identities.
	var decls: List[CoreDecl] = [
		FunctionDecl(
			fixture_target_function(
				"combine_mixed",
				COMBINE_MIXED_DEF_ID,
				[
					fixture_param("first", 1, int_type()),
					fixture_param("second", 2, int_type()),
					fixture_param("unused", 3, VoidType),
					fixture_param("nested", 4, int_type()),
					fixture_param("last", 5, int_type()),
				],
			),
		),
		FunctionDecl(
			fixture_target_function(
				"effectful_mixed_arg",
				EFFECTFUL_MIXED_ARG_DEF_ID,
				[],
			),
		),
	]

	for index in 0..FIXTURE_FUNCTION_COUNT:
		decls = decls.append(FunctionDecl(fixture_function(index)))

	{
		decls = decls,
		foreign_includes = [],
		source_files = []
	}


func main(args: List[String]) -> Int:
	-- Prepare outside the measured interval. Keep the artifact alive until
	-- after the memory snapshot so release work is outside it too.
	prepared = run_pre_dce_tail(fixture_program())
	reset_mem_stats()
	emitted = try_emit_prepared_core_program_c_artifact_with_profile(prepared, FunctionProfileOff)
	stats = get_mem_stats()

	match emitted:
		Ok(artifact):
			print("allocations=" + stats.total_allocations.to_string())
			print("bytes=" + artifact.c_code
					.length()
					.to_string())
			print(artifact.c_code)
			0
		Err(_):
			print("emission failed")
			1
