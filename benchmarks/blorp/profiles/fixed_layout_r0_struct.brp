import:
	memory: MemStats, get_mem_stats, reset_mem_stats


fixed record Point {
	x: Int,
	y: Int
}


func main(args: List[String]) -> Int:
	reset_mem_stats()
	var sum: Int = 0
	for index in 0..10000:
		point: Point = {x = index, y = index + 1}
		sum = sum + point.x + point.y
	stats: MemStats = get_mem_stats()
	print(sum)
	print(stats.total_allocations)
	print(stats.total_releases)
	0
