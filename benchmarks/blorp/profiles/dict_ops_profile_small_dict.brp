import:
	dict: Dict, contains as dict_contains, dict as dict_new, get as dict_get, set as dict_set
	list: append, get as list_get, length as list_length
	option: Option(Some, None)
	tensor: get, length, set_index, vector
	time: now


-- Compare Dict vs flat vectors for small key-value stores.
-- "Flat" = two vectors (keys + values) with linear scan.
-- ============================================================================
-- Flat key-value store (two vectors, linear scan)
-- ============================================================================
pure func flat_contains(ks: Tensor[Int, #Ds...], size: Int, key: Int) -> Bool:
	var found: Bool = False
	var i: Int = 0
	while i < size and not found:
		match get(ks, i):
			Some(k):
				if k == key:
					found = True
			None: void
		i += 1
	found


-- ============================================================================
-- Benchmarks
-- ============================================================================
func bench_dict(n: Int, lookups: Int) -> Void:
	-- Build
	t0: Int = now()
	var total_build: Int = 0
	iters: Int = 1000000 / n
	for iter in 0..iters:
		var d: Dict[Int, Int] = dict_new()
		for i in 0..n:
			d = dict_set(d, i, i * 7)
		total_build += 1
	t1: Int = now()

	-- Lookup hit
	var d: Dict[Int, Int] = dict_new()
	for i in 0..n:
		d = dict_set(d, i, i * 7)
	t2: Int = now()
	var hits: Int = 0
	for iter in 0..lookups:
		for i in 0..n:
			if dict_contains(d, i):
				hits += 1
	t3: Int = now()

	-- Lookup miss
	t4: Int = now()
	var misses: Int = 0
	for iter in 0..lookups:
		for i in n..n + n:
			if dict_contains(d, i):
				misses += 1
	t5: Int = now()
	build_ns: Int = (t1 - t0) * 1000 / (iters * n)
	hit_ns: Int = (t3 - t2) * 1000 / (lookups * n)
	miss_ns: Int = (t5 - t4) * 1000 / (lookups * n)
	label: String = if n < 10:
		" " + to_string(n)
	else:
		to_string(n)
	print(
		"  dict  n=" + label + "  build: " + to_string(
			build_ns,
		) + "ns  hit: " + to_string(hit_ns) + "ns  miss: " + to_string(miss_ns) + "ns",
	)


func bench_flat(n: Int, lookups: Int) -> Void:
	-- Build
	t0: Int = now()
	var total_build: Int = 0
	iters: Int = 1000000 / n
	for iter in 0..iters:
		var ks = vector(0, n)
		var vs = vector(0, n)
		for i in 0..length(ks):
			ks[i] = i
			vs[i] = i * 7
		total_build += 1
	t1: Int = now()

	-- Lookup hit
	var ks = vector(0, n)
	var vs = vector(0, n)
	for i in 0..length(ks):
		ks[i] = i
		vs[i] = i * 7
	t2: Int = now()
	var hits: Int = 0
	for iter in 0..lookups:
		for i in 0..n:
			if flat_contains(ks, n, i):
				hits += 1
	t3: Int = now()

	-- Lookup miss
	t4: Int = now()
	var misses: Int = 0
	for iter in 0..lookups:
		for i in n..n + n:
			if flat_contains(ks, n, i):
				misses += 1
	t5: Int = now()
	build_ns: Int = (t1 - t0) * 1000 / (iters * n)
	hit_ns: Int = (t3 - t2) * 1000 / (lookups * n)
	miss_ns: Int = (t5 - t4) * 1000 / (lookups * n)
	label: String = if n < 10:
		" " + to_string(n)
	else:
		to_string(n)
	print(
		"  flat  n=" + label + "  build: " + to_string(
			build_ns,
		) + "ns  hit: " + to_string(hit_ns) + "ns  miss: " + to_string(miss_ns) + "ns",
	)


func bench_size(n: Int, lookups: Int) -> Void:
	bench_dict(n, lookups)
	bench_flat(n, lookups)
	print("")


func main(args: List[String]):
	print("Dict vs Flat Vector (int keys, ns/op)")
	print("======================================")
	print("")
	bench_size(1, 1000000)
	bench_size(2, 500000)
	bench_size(4, 250000)
	bench_size(6, 200000)
	bench_size(8, 150000)
	bench_size(10, 100000)
	bench_size(12, 100000)
	bench_size(16, 80000)
	bench_size(24, 50000)
	bench_size(32, 40000)
	bench_size(48, 25000)
	bench_size(64, 20000)
