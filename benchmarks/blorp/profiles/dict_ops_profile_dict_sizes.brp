import:
	dict: Dict, contains, dict, set
	time: now


-- Measure per-lookup cost at various dict sizes to find where
-- hashing overhead dominates vs where linear scan would win.
func bench_lookup_at_size(n: Int, iters: Int) -> Void:
	-- Build dict of size n
	var d: Dict[Int, Int] = dict()
	for i in 0..n:
		d = set(d, i, i * 7)

	-- Measure lookup hit (all keys exist)
	t0: Int = now()
	var checksum: Int = 0
	for iter in 0..iters:
		for i in 0..n:
			if contains(d, i):
				checksum += 1
	t1: Int = now()

	-- Measure lookup miss (no keys exist)
	t2: Int = now()
	var misses: Int = 0
	for iter in 0..iters:
		for i in n..n + n:
			if contains(d, i):
				misses += 1
	t3: Int = now()
	total_hit: Int = n * iters
	total_miss: Int = n * iters
	us_hit: Int = t1 - t0
	us_miss: Int = t3 - t2

	-- ns per lookup = (microseconds * 1000) / total_ops
	ns_hit: Int = us_hit * 1000 / total_hit
	ns_miss: Int = us_miss * 1000 / total_miss
	label: String = if n < 10:
		"  " + to_string(n)
	else if n < 100:
		" " + to_string(n)
	else:
		to_string(n)
	print(
		"  n=" + label + "  hit: " + to_string(
			ns_hit,
		) + "ns  miss: " + to_string(ns_miss) + "ns  (" + to_string(total_hit) + " ops)",
	)


func bench_insert_at_size(n: Int, iters: Int) -> Void:
	t0: Int = now()
	for iter in 0..iters:
		var d: Dict[Int, Int] = dict()
		for i in 0..n:
			d = set(d, i, i)
	t1: Int = now()
	total: Int = n * iters
	us: Int = t1 - t0
	ns: Int = us * 1000 / total
	label: String = if n < 10:
		"  " + to_string(n)
	else if n < 100:
		" " + to_string(n)
	else:
		to_string(n)
	print("  n=" + label + "  insert: " + to_string(ns) + "ns/op  (" + to_string(total) + " ops)")


func main(args: List[String]):
	print("Dict lookup cost by size (ns/op)")
	print("================================")
	bench_lookup_at_size(1, 1000000)
	bench_lookup_at_size(2, 500000)
	bench_lookup_at_size(3, 300000)
	bench_lookup_at_size(4, 250000)
	bench_lookup_at_size(6, 200000)
	bench_lookup_at_size(8, 150000)
	bench_lookup_at_size(10, 100000)
	bench_lookup_at_size(12, 100000)
	bench_lookup_at_size(16, 80000)
	bench_lookup_at_size(24, 50000)
	bench_lookup_at_size(32, 40000)
	bench_lookup_at_size(64, 20000)
	bench_lookup_at_size(128, 10000)
	bench_lookup_at_size(256, 5000)
	print("")
	print("Dict insert cost by size (ns/op)")
	print("================================")
	bench_insert_at_size(1, 1000000)
	bench_insert_at_size(2, 500000)
	bench_insert_at_size(4, 250000)
	bench_insert_at_size(8, 150000)
	bench_insert_at_size(12, 100000)
	bench_insert_at_size(16, 80000)
	bench_insert_at_size(32, 40000)
	bench_insert_at_size(64, 20000)
	bench_insert_at_size(128, 10000)
