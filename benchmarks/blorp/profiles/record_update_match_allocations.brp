import:
	memory: MemStats, get_mem_stats, reset_mem_stats


record RecordUpdateMatchAllocationProbe {
	width: Int,
	height: Int,
	depth: Int,
	scale: Float
}


func update_record(iterations: Int) -> RecordUpdateMatchAllocationProbe:
	var current: RecordUpdateMatchAllocationProbe = {
		width = 100,
		height = 200,
		depth = 50,
		scale = 1.0
	}

	for index in 0..iterations:
		current = match index % 2 == 0:
			True:
				{ current | width = current.width + 1 }
			False:
				{ current | height = current.height + 1 }

	current


func main(args: List[String]) -> Int:
	reset_mem_stats()
	result: RecordUpdateMatchAllocationProbe = update_record(100000)
	stats: MemStats = get_mem_stats()
	print(result.width + result.height)
	print(stats.total_allocations)
	print(stats.total_releases)
	print(stats.current_objects)
	print(stats.bytes_allocated)
	0
