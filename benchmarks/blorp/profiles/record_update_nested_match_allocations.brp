import:
	memory: MemStats, get_mem_stats, reset_mem_stats


record RecordUpdateNestedMatchAllocationProbe {
	width: Int,
	height: Int,
	depth: Int,
	scale: Float,
	label: String,
	alternate: String
}


func update_record(
	iterations: Int,
	even_selector: Option[Bool],
	odd_selector: Option[Bool],
) -> RecordUpdateNestedMatchAllocationProbe:
	var current: RecordUpdateNestedMatchAllocationProbe = {
		width = 100,
		height = 200,
		depth = 50,
		scale = 1.0,
		label = "left",
		alternate = "right"
	}

	for index in 0..iterations:
		selector: Option[Bool] = match index % 3:
			0:
				even_selector
			1:
				odd_selector
			_:
				None

		current = match selector:
			Some(True):
				{ current |
					width = current.width + 1,
					label = current.alternate
				}
			Some(False):
				{ current |
					height = current.height + 1,
					alternate = current.label
				}
			None:
				{ current | depth = current.depth + 1 }

	current


func main(args: List[String]) -> Int:
	even_selector: Option[Bool] = Some(True)
	odd_selector: Option[Bool] = Some(False)
	reset_mem_stats()
	result: RecordUpdateNestedMatchAllocationProbe = update_record(
		100000,
		even_selector,
		odd_selector,
	)
	stats: MemStats = get_mem_stats()

	result_value: Int = if result.label == "right" and result.alternate == "right":
		result.width + result.height
	else:
		0

	print(result_value)
	print(stats.total_allocations)
	print(stats.total_releases)
	print(stats.current_objects)
	print(stats.bytes_allocated)
	0
