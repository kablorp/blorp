import:
	memory: MemStats, get_mem_stats, reset_mem_stats,
	../../../blorp/src/compiler/stage_09_core/dce: CoreValueReferences, value_references,
	../../../blorp/src/compiler/stage_09_core/ir:
		CoreExpr(DropExpr, SeqExpr, VarExpr, VoidExpr),
		CoreReleasePolicy(ArcReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
		CoreVar,


DCE_FACT_REFERENCE_COUNT: Int = 512


pure func int_type() -> CoreType:
	NamedType("Int", [])


pure func reference_variable(index: Int) -> CoreVar:
	{
		name = "dce_fact_${index}",
		uniq = index,
		def_id = Some(index),
	}


pure func variable_expr(variable: CoreVar) -> CoreExpr:
	VarExpr(variable, int_type(), SyntheticSourceLoc)


pure func reference_segment(index: Int) -> CoreExpr:
	variable = reference_variable(index)
	SeqExpr(
		variable_expr(variable),
		SeqExpr(
			variable_expr(variable),
			SeqExpr(
				DropExpr(
					variable,
					int_type(),
					ArcReleasePolicy,
					VoidExpr(VoidType, SyntheticSourceLoc),
					VoidType,
					SyntheticSourceLoc,
				),
				DropExpr(
					variable,
					int_type(),
					ArcReleasePolicy,
					VoidExpr(VoidType, SyntheticSourceLoc),
					VoidType,
					SyntheticSourceLoc,
				),
			),
		),
	)


pure func reference_chain() -> CoreExpr:
	var result: CoreExpr = reference_segment(0)

	for index in 1..DCE_FACT_REFERENCE_COUNT:
		result = SeqExpr(
			result,
			reference_segment(index),
		)

	result


func main(args: List[String]) -> Int:
	expr: CoreExpr = reference_chain()
	reset_mem_stats()
	references: CoreValueReferences = value_references(expr)
	stats: MemStats = get_mem_stats()

	missing_variable: CoreVar = { name = "missing", uniq = -1, def_id = None }
	var exact_order: Bool = True
	for index in 0..DCE_FACT_REFERENCE_COUNT:
		expected_variable = reference_variable(index)
		expected_name = expected_variable.name
		occurrence_index = index * 4
		exact_order = (
			exact_order
			and references.names.get(index).get_or("") == expected_name
			and references.resolved_reads.get(index).get_or(missing_variable) == expected_variable
			and references.resolved_invalidations.get(index).get_or(missing_variable)
				== expected_variable
			and references.resolved_occurrences.get(occurrence_index).get_or(missing_variable)
				== expected_variable
			and references.resolved_occurrences.get(occurrence_index + 1).get_or(missing_variable)
				== expected_variable
			and references.resolved_occurrences.get(occurrence_index + 2).get_or(missing_variable)
				== expected_variable
			and references.resolved_occurrences.get(occurrence_index + 3).get_or(missing_variable)
				== expected_variable
		)

	exact_order_value: Int = if exact_order:
		1
	else:
		0

	print(references.names.length())
	print(references.resolved_reads.length())
	print(references.resolved_invalidations.length())
	print(references.resolved_occurrences.length())
	print(exact_order_value)
	print(stats.total_allocations)
	print(stats.total_releases)
	print(stats.current_objects)
	print(stats.bytes_allocated)
	0
