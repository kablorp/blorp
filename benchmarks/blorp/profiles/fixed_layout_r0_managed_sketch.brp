-- R0 expected-fail design sketch: neither fixed syntax nor field-wise
-- ownership has landed. R2 must make copy, update, and drop own `name`.
fixed record Header {name: String, code: Int}


func main(args: List[String]) -> Int:
	first: Header = {name = "alpha", code = 1}
	second: Header = first
	third: Header = {first | code = 2}
	print(second.name)
	print(third.name)
	0
