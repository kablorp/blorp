import:
	memory: MemStats, get_mem_stats, reset_mem_stats


record Child {
	value: Int
}


record Parent {
	child: Child,
	stamp: Int
}


func fresh(iterations: Int) -> Int:
	var total: Int = 0
	for index in 0..iterations:
		parent: Parent = {child = {value = index}, stamp = 1}
		total = total + parent.child.value + parent.stamp
	total


func escaping(iterations: Int) -> Int:
	var total: Int = 0
	for index in 0..iterations:
		child: Child = {value = index}
		parent: Parent = {child = child, stamp = 1}
		total = total + parent.child.value + child.value
	total


func main(args: List[String]) -> Int:
	reset_mem_stats()
	fresh_result: Int = fresh(10000)
	fresh_stats: MemStats = get_mem_stats()
	reset_mem_stats()
	escaping_result: Int = escaping(10000)
	escaping_stats: MemStats = get_mem_stats()
	print(fresh_result)
	print(fresh_stats.total_allocations)
	print(fresh_stats.total_releases)
	print(escaping_result)
	print(escaping_stats.total_allocations)
	print(escaping_stats.total_releases)
	0
