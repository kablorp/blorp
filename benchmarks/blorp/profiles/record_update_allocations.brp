import:
	memory: MemStats, get_mem_stats, reset_mem_stats


record RecordUpdateAllocationProbe {
	width: Int,
	height: Int,
	depth: Int,
	scale: Float
}


func update_record(iterations: Int) -> RecordUpdateAllocationProbe:
	var current: RecordUpdateAllocationProbe = {
		width = 100,
		height = 200,
		depth = 50,
		scale = 1.0
	}

	for _ in 0..iterations:
		current = { current | width = current.width + 1 }

	current


func main(args: List[String]) -> Int:
	reset_mem_stats()
	result: RecordUpdateAllocationProbe = update_record(100000)
	stats: MemStats = get_mem_stats()
	print(result.width)
	print(stats.total_allocations)
	print(stats.total_releases)
	print(stats.current_objects)
	print(stats.bytes_allocated)
	0
