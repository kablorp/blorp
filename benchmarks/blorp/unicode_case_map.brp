import:
	string: lower, upper


-- upper and lower on text that is not pure ASCII.
-- Standalone microbenchmark (not in bench.sh's cross-language list): ASCII
-- text takes a byte-mapping fast path, so every sample below mixes in
-- non-ASCII letters, a final sigma, and expanding mappings such as sharp s.
-- Compare base and candidate runtimes on retired instructions
-- (`/usr/bin/time -l`). The generated C embeds the compiler's runtime, so
-- emit it with each compiler:
--
--   bin/blorp compile --no-format benchmarks/blorp/unicode_case_map.brp \
--     -o /tmp/unicode_case_map.c
--   clang -fwrapv -O2 -pthread -I blorp/src/lib/runtime/native \
--     -DBLORP_MEMORY_DIAGNOSTICS=0 /tmp/unicode_case_map.c -o /tmp/unicode_case_map -lm
--   /usr/bin/time -l /tmp/unicode_case_map
--
-- The printed checksum must match between runs.
ITERS: Int = 200000

-- Keeps the order-sensitive length checksum within Int.
CHECKSUM_MODULUS: Int = 1000000007


-- Impure so the samples are built at run time and cannot be folded.
func samples() -> List[String]:
	[
		"Straße und Größe",
		"ΟΔΥΣΣΕΥΣ ΚΑΙ ΣΟΦΙΑ",
		"Ελληνικά γράμματα",
		"Café déjà vu, naïve façade",
		"Пример русского текста",
		"ﬁne ﬂour ŉ ǰ",
		"İstanbul ve Iğdır",
		"Mixed ASCII prefix then é at the end of a longer sentence é",
	]


func main(args: List[String]) -> Int:
	texts: List[String] = samples()
	count: Int = texts.length()
	var checksum: Int = 0

	for i in 0..ITERS:
		text: String = texts.get_or(i % count, "")
		upper_text: String = upper(text)
		lower_text: String = lower(text)
		checksum = (checksum * 31 + upper_text.length() * 3 + lower_text.length()) % CHECKSUM_MODULUS

	print("checksum: " + checksum.to_string())
	print("upper: " + upper(texts.get_or(0, "")))
	print("lower: " + lower(texts.get_or(1, "")))
	0
