import:
	instrumentation: black_box_int
	list: range
	string: parse_int
	system: getenv


func env_int(name: String, default: Int) -> Int:
	match getenv(name):
		Some(raw):
			match parse_int(raw):
				Some(value):
					if value > 0:
						value
					else:
						default
				None: default
		None: default


pure func heavy_work(seed: Int, rounds: Int) -> Int:
	var acc: Int = seed + 1
	var i: Int = 0
	while i < rounds:
		acc = (acc * 1103515245 + 12345 + i + seed) % 2147483647
		i += 1
	acc % 1000003


pure func worker_sum(
	worker_id: Int,
	workers: Int,
	items: Int,
	rounds: Int,
) -> Int:
	var checksum: Int = 0
	var i: Int = worker_id
	while i < items:
		checksum += heavy_work(i, rounds)
		i += workers
	checksum


func consume_results(results: List[Result[Int, ConcurrencyError]]) -> Int:
	var checksum: Int = 0
	for result in results:
		match result:
			Ok(value): checksum += value
			Err(_): checksum -= 1
	black_box_int(checksum)


func main(args: List[String]) -> Int:
	workers: Int = env_int("BENCH_THREADS", 4)
	items: Int = env_int("BENCH_ITEMS", 10000)
	rounds: Int = env_int("BENCH_ROUNDS", 1000)
	results: List[Result[Int, ConcurrencyError]] = range(0, workers).concurrent(
		workers,
		func(worker_id: Int): worker_sum(
			worker_id,
			workers,
			items,
			rounds,
		),
	)
	checksum: Int = consume_results(results)
	print("checksum: " + checksum.to_string())
	0
