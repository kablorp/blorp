import:
	channel: wait_send
	instrumentation: black_box_int
	string: parse_int
	system: getenv


func env_int(name: String, default: Int) -> Int:
	match getenv(name):
		Some(raw):
			match parse_int(raw):
				Some(value):
					if value > 0:
						value
					else:
						default
				None: default
		None: default


pure func heavy_work(seed: Int, rounds: Int) -> Int:
	var acc: Int = seed + 1
	var i: Int = 0
	while i < rounds:
		acc = (acc * 1103515245 + 12345 + i + seed) % 2147483647
		i += 1
	acc % 1000003


func producer(items: Int, out: Channel[Int]):
	var i: Int = 0
	while i < items:
		_ = wait_send(out, i)
		i += 1
	seal(out)


func pipeline_worker(
	input: Channel[Int],
	output: Channel[Int],
	rounds: Int,
	done: Channel[Int],
):
	var processed: Int = 0
	for item in input:
		_ = wait_send(output, heavy_work(item, rounds))
		processed += 1
	_ = send(done, processed)


func receive_outputs(output: Channel[Int], items: Int) -> Int:
	var checksum: Int = 0
	var received: Int = 0
	while received < items:
		match recv(output):
			Some(value):
				checksum += value
				received += 1
			None: void
	black_box_int(checksum)


func receive_done(done: Channel[Int], workers: Int) -> Int:
	var processed: Int = 0
	var finished: Int = 0
	while finished < workers:
		match recv(done):
			Some(count):
				processed += count
				finished += 1
			None: void
	black_box_int(processed)


func main(args: List[String]) -> Int:
	workers: Int = env_int("BENCH_THREADS", 4)
	items: Int = env_int("BENCH_ITEMS", 20000)
	rounds: Int = env_int("BENCH_ROUNDS", 64)
	capacity: Int = workers * 4
	input_ch: Channel[Int] = channel(capacity)
	output: Channel[Int] = channel(capacity)
	done: Channel[Int] = channel(workers)

	detach producer(items, input_ch)
	var worker_id: Int = 0
	while worker_id < workers:
		detach pipeline_worker(input_ch, output, rounds, done)
		worker_id += 1

	checksum: Int = receive_outputs(output, items)
	processed: Int = receive_done(done, workers)
	seal(output)
	print("checksum: " + checksum.to_string())
	print("processed: " + processed.to_string())
	0
