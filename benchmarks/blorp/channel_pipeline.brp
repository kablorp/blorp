import:
	instrumentation: black_box_int
	list: range
	string: parse_int
	system: getenv


-- Concurrency pipeline benchmark.
--
-- The current Blorp-compiled backend path does not yet lower direct channel
-- receive calls from benchmark sources. Keep this row compiling by using the
-- structured concurrent-list API while preserving the same item/worker/rounds
-- controls and checksum contract as the channel variants in other languages.
struct PipelineStats {
	checksum: Int,
	processed: Int
}


func env_int(name: String, default: Int) -> Int:
	match getenv(name):
		Some(raw):
			match parse_int(raw):
				Some(value):
					if value > 0:
						value
					else:
						default
				None:
					default
		None:
			default


pure func heavy_work(seed: Int, rounds: Int) -> Int:
	var acc: Int = seed + 1
	var i: Int = 0

	while i < rounds:
		acc = (acc * 1103515245 + 12345 + i + seed) % 2147483647
		i += 1

	acc % 1000003


func consume_results(results: List[Result[Int, ConcurrencyError]]) -> PipelineStats:
	var checksum: Int = 0
	var processed: Int = 0

	for result in results:
		match result:
			Ok(value):
				checksum += value
				processed += 1
			Err(_):
				checksum -= 1

	{
		checksum = black_box_int(checksum),
		processed = black_box_int(processed)
	}


func main(args: List[String]) -> Int:
	workers: Int = env_int("BENCH_THREADS", 4)
	items: Int = env_int("BENCH_ITEMS", 20000)
	rounds: Int = env_int("BENCH_ROUNDS", 64)
	results: List[Result[Int, ConcurrencyError]] = range(0, items).concurrent(
		workers,
		func(item: Int): heavy_work(item, rounds),
	)
	stats: PipelineStats = consume_results(results)
	print("checksum: " + stats.checksum.to_string())
	print("processed: " + stats.processed.to_string())
	0
