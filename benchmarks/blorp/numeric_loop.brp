-- Pure numeric loop benchmark
-- Tests raw loop + arithmetic performance with no allocations
func collatz_steps(start: Int) -> Int:
	var n: Int = start
	var steps: Int = 0
	while n != 1:
		if n % 2 == 0:
			n /= 2
		else:
			n = n * 3 + 1
		steps += 1
	steps


func main(args: List[String]):
	var total_steps: Int = 0
	for i in 1..1000000:
		total_steps += collatz_steps(i)
	print("Total Collatz steps: " + to_string(total_steps))
