import:
	string: contains, count, length, lower, replace, reverse, split, substring, trim, upper


-- String Processing Benchmark
-- Runs the same operations and reports checksums. The harness owns timing.
ITERS: Int = 100000

test_string: String = (
	"The quick brown fox jumps over the lazy dog. This is a test string for "
	+ "benchmarking purposes."
)

chain_string: String = (
	"   The quick brown fox jumps over the lazy dog. This is a test string for "
	+ "benchmarking purposes.   "
)


func bench_count(s: String, needle: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		total += count(s, needle)

	total


func bench_contains(s: String, needle: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		if contains(s, needle):
			total += 1

	total


func bench_replace(s: String, old: String, new: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		result: String = replace(s, old, new)
		total += length(result)

	total


func bench_substring(s: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		start: Int = i % 16
		result: String = substring(s, start, 24)
		total += length(result)

	total


func bench_split(s: String, delim: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		parts: List[String] = split(s, delim)
		total += parts.length()

	total


func bench_upper(s: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		result: String = upper(s)
		total += length(result)

	total


func bench_lower(s: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		result: String = lower(s)
		total += length(result)

	total


func bench_reverse(s: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		rev: String = reverse(s)
		total += length(rev)

	total


func bench_trim(iters: Int) -> Int:
	padded: String = "   hello world   "
	var total: Int = 0

	for i in 0..iters:
		trimmed: String = trim(padded)
		total += length(trimmed)

	total


func bench_chain_window_replace(s: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		start: Int = i % 16
		total += s
			.trim()
			.substring(start, 40)
			.replace(" ", "_")
			.length()

	total


func bench_chain_case_replace(s: String, iters: Int) -> Int:
	var total: Int = 0

	for i in 0..iters:
		total += s
			.lower()
			.replace("the", "a")
			.upper()
			.length()

	total


func bench_chain_trim_reverse(iters: Int) -> Int:
	padded: String = "   hello world   "
	var total: Int = 0

	for i in 0..iters:
		total += padded
			.trim()
			.reverse()
			.replace("l", "L")
			.length()

	total


func main(args: List[String]):
	print("count checksum: " + to_string(bench_count(test_string, "e", ITERS)))
	print("contains checksum: " + to_string(bench_contains(test_string, "fox", ITERS)))
	print("replace_same checksum: " + to_string(bench_replace(test_string, "the", "THE", ITERS)))
	print(
		"replace_grow checksum: " + to_string(
			bench_replace(
				test_string,
				"dog",
				"catapult",
				ITERS,
			),
		),
	)
	print(
		"replace_shrink checksum: " + to_string(
			bench_replace(
				test_string,
				"benchmarking",
				"bench",
				ITERS,
			),
		),
	)
	print("substring checksum: " + to_string(bench_substring(test_string, ITERS)))
	print("split checksum: " + to_string(bench_split(test_string, " ", ITERS)))
	print("upper checksum: " + to_string(bench_upper(test_string, ITERS)))
	print("lower checksum: " + to_string(bench_lower(test_string, ITERS)))
	print("reverse checksum: " + to_string(bench_reverse(test_string, ITERS)))
	print("trim checksum: " + to_string(bench_trim(ITERS)))
	print(
		"chain_window_replace checksum: " + to_string(
			bench_chain_window_replace(
				chain_string,
				ITERS,
			),
		),
	)
	print("chain_case_replace checksum: " + to_string(bench_chain_case_replace(test_string, ITERS)))
	print("chain_trim_reverse checksum: " + to_string(bench_chain_trim_reverse(ITERS)))
