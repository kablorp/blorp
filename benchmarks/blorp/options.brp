import:
	./support/benchmark:
		BenchmarkFloatResult,
		BenchmarkResult,
		bench_float,
		bench_int,
		run_benchmarks,


private pure func maybe_int(i: Int) -> Option[Int]:
	if i % 4 == 0:
		None
	else:
		Some(i + 1)


private func consume_option_int(i: Int) -> Int:
	maybe_int(i).get_or(0)


private pure func maybe_float(i: Int) -> Option[Float]:
	if i % 4 == 0:
		None
	else:
		Some(to_float(i) * 0.5)


private func consume_option_float(i: Int) -> Float:
	match maybe_float(i):
		Some(v): v + 1.0
		None: 0.0


private pure func maybe_string(i: Int) -> Option[String]:
	if i % 4 == 0:
		None
	else if i % 2 == 0:
		Some("alpha")
	else:
		Some("beta")


private func consume_option_string(i: Int) -> Int:
	match maybe_string(i):
		Some(s): s.length()
		None: 0


private func make_option_int_list(count: Int, salt: Int) -> List[Option[Int]]:
	var result: List[Option[Int]] = []
	for i in 0..count:
		if (i + salt) % 4 == 0:
			result = result.append(None)
		else:
			result = result.append(Some(i + salt))
	result


private func sum_option_int_list(values: List[Option[Int]]) -> Int:
	var total: Int = 0
	for value in values:
		match value:
			Some(v): total += v
			None: total += 0
	total


private func consume_list_option_int(i: Int) -> Int:
	values: List[Option[Int]] = make_option_int_list(64, i)
	sum_option_int_list(values)


private func bench_option_int() -> Int:
	result: BenchmarkResult = bench_int(1000000, consume_option_int)
	result.elapsed_us


private func bench_option_float() -> Int:
	result: BenchmarkFloatResult = bench_float(1000000, consume_option_float)
	result.elapsed_us


private func bench_option_string() -> Int:
	result: BenchmarkResult = bench_int(500000, consume_option_string)
	result.elapsed_us


private func bench_list_option_int() -> Int:
	result: BenchmarkResult = bench_int(20000, consume_list_option_int)
	result.elapsed_us


func main(args: List[String]) -> Int:
	benchmarks: List[(String, () -> Int)] = [
		("Option[Int] match", func(): bench_option_int()),
		("Option[Float] match", func(): bench_option_float()),
		("Option[String] nullable match", func(): bench_option_string()),
		("List[Option[Int]] build+sum", func(): bench_list_option_int()),
	]
	run_benchmarks("Option Representation Benchmarks", benchmarks)
	0
