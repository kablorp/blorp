-- Runtime reads of inline (unboxed) list elements.
-- Standalone microbenchmark (not in bench.sh's cross-language list): list
-- equality on Int, Int32 and Bool lists reads every element through the
-- runtime's generic element accessor, which copies elem_size bytes. Compare
-- base and candidate runtimes on retired instructions (`/usr/bin/time -l`).
-- The generated C embeds the compiler's runtime, so emit it with each
-- compiler:
--
--   bin/blorp compile --no-format benchmarks/blorp/inline_list_access.brp \
--     -o /tmp/inline_list_access.c
--   clang -fwrapv -O2 -pthread -I blorp/src/lib/runtime/native \
--     -DBLORP_MEMORY_DIAGNOSTICS=0 /tmp/inline_list_access.c -o /tmp/inline_list_access -lm
--   /usr/bin/time -l /tmp/inline_list_access
--
-- The printed checksum must match between runs.
ROUNDS: Int = 20000

LIST_LENGTH: Int = 1000

-- Bools alternate with this period so the lists are not constant.
BOOL_PERIOD: Int = 3


-- Impure so the lists are built at run time and cannot be folded.
func build_ints(length: Int) -> List[Int]:
	var values: List[Int] = []

	for i in 0..length:
		values = values.append(i * 7)

	values


func build_int32s(length: Int) -> List[Int32]:
	var values: List[Int32] = []

	for i in 0..length:
		values = values.append(to_int32(i))

	values


func build_bools(length: Int) -> List[Bool]:
	var values: List[Bool] = []

	for i in 0..length:
		values = values.append(i % BOOL_PERIOD == 0)

	values


func main(args: List[String]) -> Int:
	ints_a: List[Int] = build_ints(LIST_LENGTH)
	ints_b: List[Int] = build_ints(LIST_LENGTH)
	int32s_a: List[Int32] = build_int32s(LIST_LENGTH)
	int32s_b: List[Int32] = build_int32s(LIST_LENGTH)
	bools_a: List[Bool] = build_bools(LIST_LENGTH)
	bools_b: List[Bool] = build_bools(LIST_LENGTH)
	var checksum: Int = 0

	for round in 0..ROUNDS:
		if ints_a == ints_b:
			checksum += 1

		if int32s_a == int32s_b:
			checksum += 2

		if bools_a == bools_b:
			checksum += 4

	print("checksum: " + checksum.to_string())
	0
