import:
	instrumentation: black_box_float, black_box_int, elapsed_duration
	system: now_microseconds
	units:
		Duration,
		format_duration as format_units_duration,
		microseconds as make_duration_microseconds


-- Benchmarking helpers for benchmark sources.
--
-- This module intentionally lives under benchmarks/blorp instead of std.
-- It is not part of the shipped standard library surface.
struct BenchmarkResult {
	elapsed: Duration,
	checksum: Int
}


struct BenchmarkFloatResult {
	elapsed: Duration,
	checksum: Float
}


---
Run a benchmark N times and return total elapsed time.
Not pure because the benchmarked function may have side effects.
---
func bench(
	iterations: Int,
	bench_func: () -> Void,
) -> Duration:
	start: Int = now_microseconds()
	for i in 0..iterations:
		bench_func()
	elapsed_duration(start, now_microseconds())


---
Run an Int-returning benchmark N times and return elapsed time plus a checksum.
The checksum forces optimized builds to keep pure numeric work in the benchmark body.
---
func bench_int(
	iterations: Int,
	bench_func: (Int) -> Int,
) -> BenchmarkResult:
	start: Int = now_microseconds()
	var checksum: Int = 0
	for i in 0..iterations:
		checksum += black_box_int(bench_func(i))
	elapsed: Duration = elapsed_duration(start, now_microseconds())
	{
		elapsed = elapsed,
		checksum = black_box_int(checksum)
	}


---
Run a Float-returning benchmark N times and return elapsed time plus a checksum.
The checksum forces optimized builds to keep pure numeric work in the benchmark body.
---
func bench_float(
	iterations: Int,
	bench_func: (Int) -> Float,
) -> BenchmarkFloatResult:
	start: Int = now_microseconds()
	var checksum: Float = 0.0
	for i in 0..iterations:
		checksum += black_box_float(bench_func(i))
	elapsed: Duration = elapsed_duration(start, now_microseconds())
	{
		elapsed = elapsed,
		checksum = black_box_float(checksum)
	}


---
Format a duration value with standard units formatting.
---
pure func format_duration(duration: Duration) -> String:
	format_units_duration(duration)


---
Format a raw microsecond count at benchmark text-protocol boundaries.
---
pure func format_microseconds(microseconds: Int) -> String:
	format_duration(make_duration_microseconds(microseconds))


---
Run a list of benchmarks and print results.
Each benchmark is a (name, function) pair where the function returns total time.
---
func run_benchmarks(
	description: String,
	benchmarks: List[(String, () -> Duration)],
) -> Void:
	print("")
	print("=== " + description + " ===")
	print("")
	for i in 0..benchmarks.length():
		match benchmarks.get(i):
			Some(item):
				name: String = item[0]
				bench_func: () -> Duration = item[1]
				elapsed: Duration = bench_func()
				print("  " + name + ": " + format_duration(elapsed))
			None: void
	print("")
	print("=== Benchmarks Complete ===")
