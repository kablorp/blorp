import:
	instrumentation: black_box_float, black_box_int, elapsed_us
	system: now_microseconds


-- Benchmarking helpers for benchmark sources.
--
-- This module intentionally lives under benchmarks/blorp instead of std.
-- It is not part of the shipped standard library surface.
record BenchmarkResult {
	elapsed_us: Int,
	checksum: Int
}


record BenchmarkFloatResult {
	elapsed_us: Int,
	checksum: Float
}


---
Run a benchmark N times and return total time in microseconds.
Not pure because the benchmarked function may have side effects.
---
func bench(
	iterations: Int,
	bench_func: () -> Void,
) -> Int:
	start: Int = now_microseconds()
	for i in 0..iterations:
		bench_func()
	elapsed_us(start, now_microseconds())


---
Run an Int-returning benchmark N times and return elapsed time plus a checksum.
The checksum forces optimized builds to keep pure numeric work in the benchmark body.
---
func bench_int(
	iterations: Int,
	bench_func: (Int) -> Int,
) -> BenchmarkResult:
	start: Int = now_microseconds()
	var checksum: Int = 0
	for i in 0..iterations:
		checksum += black_box_int(bench_func(i))
	elapsed: Int = elapsed_us(start, now_microseconds())
	{
		elapsed_us = elapsed,
		checksum = black_box_int(checksum)
	}


---
Run a Float-returning benchmark N times and return elapsed time plus a checksum.
The checksum forces optimized builds to keep pure numeric work in the benchmark body.
---
func bench_float(
	iterations: Int,
	bench_func: (Int) -> Float,
) -> BenchmarkFloatResult:
	start: Int = now_microseconds()
	var checksum: Float = 0.0
	for i in 0..iterations:
		checksum += black_box_float(bench_func(i))
	elapsed: Int = elapsed_us(start, now_microseconds())
	{
		elapsed_us = elapsed,
		checksum = black_box_float(checksum)
	}


---
Format a duration value with appropriate units.
Automatically selects microseconds, milliseconds, or seconds.
---
pure func format_duration(us: Int) -> String:
	us_f: Float = to_float(us)
	match us < 1000:
		True: us.to_string() + " us"
		False:
			ms: Float = us_f / 1000.0
			match ms < 1000.0:
				True: (round(ms * 10.0) / 10.0).to_string() + " ms"
				False:
					sec: Float = ms / 1000.0
					(round(sec * 100.0) / 100.0).to_string() + " s"


---
Run a list of benchmarks and print results.
Each benchmark is a (name, function) pair where the function returns total time.
---
func run_benchmarks(
	description: String,
	benchmarks: List[(String, () -> Int)],
) -> Void:
	print("")
	print("=== " + description + " ===")
	print("")
	for i in 0..benchmarks.length():
		match benchmarks.get(i):
			Some(item):
				name: String = item[0]
				bench_func: () -> Int = item[1]
				total_us: Int = bench_func()
				print("  " + name + ": " + format_duration(total_us))
			None: void
	print("")
	print("=== Benchmarks Complete ===")
