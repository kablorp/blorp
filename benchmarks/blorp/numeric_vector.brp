import:
	./support/benchmark: bench, format_duration
	float: cos, exp, fma, log, log2, pow, round, sin, sqrt, tan
	matrix: transpose
	vector: argmax, argmin, cross, cumsum, dot, map, norm, product, sum


-- Comprehensive Numeric & Tensor Benchmark
--
-- Covers: scalar arithmetic, math functions, 1D tensor reductions,
-- 1D/2D element-wise ops, scalar broadcast, multi-index access,
-- row slicing, transpose, type comparisons, HOFs.
-- ============================================================================
-- Helpers
-- ============================================================================
func report(name: String, iters: Int, us: Int) -> Void:
	ns_per_op: Float = to_float(us) * 1000.0 / to_float(iters)
	print(
		"  " + name + ": " + format_duration(
			us,
		) + " total, " + to_string(round(ns_per_op * 10.0) / 10.0) + " ns/op",
	)


-- ============================================================================
-- 1. Scalar Arithmetic
-- ============================================================================
func bench_int_arith() -> Void:
	iters: Int = 10000000
	us: Int = bench(
		iters,
		func():
			var x: Int = 17
			x = x * 31 + 7
			x /= 3
			x = x % 97
			_ = x
	)
	report("int arith (mul+add+div+mod)", iters, us)


func bench_float_arith() -> Void:
	iters: Int = 10000000
	us: Int = bench(
		iters,
		func():
			var x: Float = 17.5
			x = x * 3.14 + 2.71
			x /= 1.41
			_ = x
	)
	report("float arith (mul+add+div)", iters, us)


func bench_safe_div_zero() -> Void:
	iters: Int = 10000000
	us: Int = bench(
		iters,
		func():
			_ = 42 / 0
			_ = 42 % 0
	)
	report("safe div-by-zero (Int)", iters, us)


func bench_checked_div() -> Void:
	iters: Int = 10000000
	us: Int = bench(
		iters,
		func():
			_ = checked_div(42, 7)
			_ = checked_mod(42, 7)
	)
	report("checked_div + checked_mod", iters, us)


-- ============================================================================
-- 2. Math Functions (Float)
-- ============================================================================
func bench_sqrt() -> Void:
	iters: Int = 5000000
	us: Int = bench(
		iters,
		func():
			_ = sqrt(2.0)
			_ = sqrt(144.0)
			_ = sqrt(999999.0)
	)
	report("sqrt (3 calls)", iters, us)


func bench_trig() -> Void:
	iters: Int = 2000000
	us: Int = bench(
		iters,
		func():
			_ = sin(1.0)
			_ = cos(1.0)
			_ = tan(1.0)
	)
	report("sin+cos+tan", iters, us)


func bench_exp_log() -> Void:
	iters: Int = 2000000
	us: Int = bench(
		iters,
		func():
			_ = exp(2.0)
			_ = log(100.0)
			_ = log2(1024.0)
	)
	report("exp+log+log2", iters, us)


func bench_pow() -> Void:
	iters: Int = 2000000
	us: Int = bench(
		iters,
		func():
			_ = pow(2.0, 10.0)
			_ = pow(3.14, 2.5)
	)
	report("pow (2 calls)", iters, us)


func bench_fma() -> Void:
	iters: Int = 5000000
	us: Int = bench(
		iters,
		func():
			_ = fma(3.0, 4.0, 5.0)
	)
	report("fma", iters, us)


