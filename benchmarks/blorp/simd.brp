import:
	float: to_float32
	vector: dot, sum


-- SIMD Tensor Benchmarks
--
-- Compares vector operations across numeric bit-widths and vector sizes.
-- Float and Float32 element-wise vector operations use SIMD where the target
-- supports it. Integer vector operations currently use the generic scalar path.
-- Sized integer tensors are intentionally excluded until they have an unboxed
-- numeric-tensor path; otherwise they dominate this benchmark for non-SIMD
-- reasons.
-- Benchmarked work is reduced to a checksum so optimized C builds cannot erase
-- discarded vector stores.
add_iters: Int = 200000

reduce_iters: Int = 500000

mul_iters: Int = 200000


private pure func make_f64[#N](size: #N, offset: Float) -> Float[#N]:
	var result: Float[#N] = vector(0.0, size)

	for i in 0..result.length():
		result[i] = to_float(i % 17) + offset

	result


private pure func make_f32[#N](size: #N, offset: Float) -> Float32[#N]:
	var result: Float32[#N] = vector(to_float32(0.0), size)

	for i in 0..result.length():
		result[i] = to_float32(to_float(i % 17) + offset)

	result


private pure func make_int[#N](size: #N, offset: Int) -> Int[#N]:
	var result: Int[#N] = vector(0, size)

	for i in 0..result.length():
		result[i] = i % 17 + offset

	result


-- ============================================================================
-- Bit-Width Comparison: Element-wise Add (64 elements)
-- ============================================================================
func bench_add_float64() -> Int:
	a: Float[#64] = make_f64(64, 1.0)
	b: Float[#64] = make_f64(64, 2.0)
	var checksum: Int = 0

	for i in 0..add_iters:
		checksum += sum(a + b).to_int()

	checksum


func bench_add_float32() -> Int:
	a: Float32[#64] = make_f32(64, 1.0)
	b: Float32[#64] = make_f32(64, 2.0)
	var checksum: Int = 0

	for i in 0..add_iters:
		checksum += sum(a + b).to_int()

	checksum


func bench_add_int64() -> Int:
	a: Int[#64] = make_int(64, 1)
	b: Int[#64] = make_int(64, 2)
	var checksum: Int = 0

	for i in 0..add_iters:
		checksum += sum(a + b)

	checksum


-- ============================================================================
-- Size Scaling: Float64 Add across SIMD tiers
-- ============================================================================
func bench_add_f64_size_4() -> Int:
	a: Float[#4] = make_f64(4, 1.0)
	b: Float[#4] = make_f64(4, 2.0)
	var checksum: Int = 0

	for i in 0..add_iters:
		checksum += sum(a + b).to_int()

	checksum


func bench_add_f64_size_16() -> Int:
	a: Float[#16] = make_f64(16, 1.0)
	b: Float[#16] = make_f64(16, 2.0)
	var checksum: Int = 0

	for i in 0..add_iters:
		checksum += sum(a + b).to_int()

	checksum


func bench_add_f64_size_64() -> Int:
	a: Float[#64] = make_f64(64, 1.0)
	b: Float[#64] = make_f64(64, 2.0)
	var checksum: Int = 0

	for i in 0..add_iters:
		checksum += sum(a + b).to_int()

	checksum


func bench_add_f64_size_256() -> Int:
	a: Float[#256] = make_f64(256, 1.0)
	b: Float[#256] = make_f64(256, 2.0)
	var checksum: Int = 0

	for i in 0..add_iters:
		checksum += sum(a + b).to_int()

	checksum


-- ============================================================================
-- Reductions: sum and dot (64 elements)
-- ============================================================================
func bench_sum_float64() -> Int:
	a: Float[#64] = make_f64(64, 1.0)
	var checksum: Int = 0

	for i in 0..reduce_iters:
		checksum += sum(a).to_int()

	checksum


func bench_sum_int64() -> Int:
	a: Int[#64] = make_int(64, 1)
	var checksum: Int = 0

	for i in 0..reduce_iters:
		checksum += sum(a)

	checksum


func bench_dot_float64() -> Int:
	a: Float[#64] = make_f64(64, 1.0)
	b: Float[#64] = make_f64(64, 2.0)
	var checksum: Int = 0

	for i in 0..reduce_iters:
		checksum += dot(a, b).to_int()

	checksum


func bench_dot_int64() -> Int:
	a: Int[#64] = make_int(64, 1)
	b: Int[#64] = make_int(64, 2)
	var checksum: Int = 0

	for i in 0..reduce_iters:
		checksum += dot(a, b)

	checksum


-- ============================================================================
-- Element-wise Mul: Float64 vs Float32 (64 elements)
-- ============================================================================
func bench_mul_float64() -> Int:
	a: Float[#64] = make_f64(64, 1.0)
	b: Float[#64] = make_f64(64, 2.0)
	var checksum: Int = 0

	for i in 0..mul_iters:
		checksum += sum(a * b).to_int()

	checksum


func bench_mul_float32() -> Int:
	a: Float32[#64] = make_f32(64, 1.0)
	b: Float32[#64] = make_f32(64, 2.0)
	var checksum: Int = 0

	for i in 0..mul_iters:
		checksum += sum(a * b).to_int()

	checksum


-- ============================================================================
-- Main
-- ============================================================================
func main(args: List[String]):
	print("add_f64: " + to_string(bench_add_float64()))
	print("add_f32: " + to_string(bench_add_float32()))
	print("add_i64: " + to_string(bench_add_int64()))
	print("add_f64_4: " + to_string(bench_add_f64_size_4()))
	print("add_f64_16: " + to_string(bench_add_f64_size_16()))
	print("add_f64_64: " + to_string(bench_add_f64_size_64()))
	print("add_f64_256: " + to_string(bench_add_f64_size_256()))
	print("sum_f64: " + to_string(bench_sum_float64()))
	print("sum_i64: " + to_string(bench_sum_int64()))
	print("dot_f64: " + to_string(bench_dot_float64()))
	print("dot_i64: " + to_string(bench_dot_int64()))
	print("mul_f64: " + to_string(bench_mul_float64()))
	print("mul_f32: " + to_string(bench_mul_float32()))
