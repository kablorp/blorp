-- Set Operations Benchmark
-- Tests: Build, Contains Hit, Contains Miss, Union, Intersection, Difference
import:
	set: Set, add, combine, contains, difference, intersect, set


func bench_build(n: Int, iters: Int) -> Set[Int]:
	var s: Set[Int] = set()
	for iter in 0..iters:
		s = set()
		for i in 0..n:
			s = add(s, i)
	s


func bench_contains_hit(s: Set[Int], n: Int, iters: Int) -> Int:
	var hits: Int = 0
	for iter in 0..iters:
		for i in 0..n:
			if contains(s, i):
				hits += 1
			else:
				hits = hits
	hits


func bench_contains_miss(s: Set[Int], n: Int, iters: Int) -> Int:
	var misses: Int = 0
	for iter in 0..iters:
		for i in n..n + n:
			if contains(s, i):
				misses = misses
			else:
				misses += 1
	misses


func bench_union(a: Set[Int], b: Set[Int], iters: Int) -> Int:
	var checksum: Int = 0
	for iter in 0..iters:
		result: Set[Int] = combine(a, b)
		checksum += result.length()
	checksum


func bench_intersect(a: Set[Int], b: Set[Int], iters: Int) -> Int:
	var checksum: Int = 0
	for iter in 0..iters:
		result: Set[Int] = intersect(a, b)
		checksum += result.length()
	checksum


func bench_difference(a: Set[Int], b: Set[Int], iters: Int) -> Int:
	var checksum: Int = 0
	for iter in 0..iters:
		result: Set[Int] = difference(a, b)
		checksum += result.length()
	checksum


func main(args: List[String]):
	N: Int = 10000
	s: Set[Int] = bench_build(N, 200)
	print("build: done")
	hits: Int = bench_contains_hit(s, N, 200)
	print("contains_hit: " + to_string(hits))
	misses: Int = bench_contains_miss(s, N, 200)
	print("contains_miss: " + to_string(misses))
	-- Build two 5k-element sets for union
	var a: Set[Int] = set()
	var b: Set[Int] = set()
	for i in 0..5000:
		a = add(a, i)
	for i in 5000..10000:
		b = add(b, i)
	union_count: Int = bench_union(a, b, 500)
	print("union: " + to_string(union_count))
	-- Build two overlapping 10k-element sets for intersect/difference
	var c: Set[Int] = set()
	var d: Set[Int] = set()
	for i in 0..N:
		c = add(c, i)
	half: Int = N / 2
	for i in half..half + N:
		d = add(d, i)
	intersect_count: Int = bench_intersect(c, d, 500)
	print("intersect: " + to_string(intersect_count))
	diff_count: Int = bench_difference(c, d, 500)
	print("difference: " + to_string(diff_count))
