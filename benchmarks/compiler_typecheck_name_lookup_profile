#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
instrumentation=plain

# The benchmark imports the edited typecheck source into its own executable, so
# rebuilding the compiler first only adds unrelated bootstrap latency.
: "${BLORP_COMPILER_BENCHMARK_SKIP_BUILD:=1}"
export BLORP_COMPILER_BENCHMARK_SKIP_BUILD

if [ "${BLORP_NAME_LOOKUP_PROFILE_FUNCTIONS:-0}" = "1" ]; then
	instrumentation=profile
fi

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-typecheck-name-lookup-profile \
	"$repo_root/compiler/blorp/benchmarks/compiler_typecheck_name_lookup_profile.brp" \
	"$instrumentation" \
	"$@"
