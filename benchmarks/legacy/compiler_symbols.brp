import:
	dict as D


-- Compiler-shaped symbol lookup benchmark.
-- Models immutable nested scopes, shadowing, and repeated failed/successful
-- walks through parent links.
record Scope {
	parent: Int,
	symbols: Dict[String, Int]
}


pure func symbol_name(scope_id: Int, slot: Int) -> String:
	"s" + scope_id.to_string() + "_" + slot.to_string()


pure func make_scope(scope_id: Int, parent: Int, names_per_scope: Int) -> Scope:
	var symbols: Dict[String, Int] = D.dict()

	for slot in 0..names_per_scope:
		symbols = symbols.set(
			symbol_name(scope_id, slot),
			scope_id * 1009 + slot,
		)

	{
		parent = parent,
		symbols = symbols
	}


pure func build_scopes(count: Int, names_per_scope: Int) -> List[Scope]:
	var scopes: List[Scope] = []

	for scope_id in 0..count:
		parent: Int = scope_id - 1
		scopes = scopes.append(make_scope(scope_id, parent, names_per_scope))

	scopes


pure func lookup_symbol(scopes: List[Scope], start_scope: Int, name: String) -> Int:
	var scope_id: Int = start_scope
	var found: Int = -1
	var done: Bool = False

	while not done and scope_id >= 0:
		match scopes.get(scope_id):
			Some(scope):
				match scope.symbols.get(name):
					Some(value):
						found = value
						done = True
					None:
						scope_id = scope.parent
			None:
				done = True

	found


func run_symbol_pass(
	scopes: List[Scope],
	scope_count: Int,
	names_per_scope: Int,
	rounds: Int,
) -> Int:
	var checksum: Int = 0

	for round in 0..rounds:
		for start_scope in 0..scope_count:
			local_slot: Int = (start_scope + round) % names_per_scope

			parent_scope: Int = if start_scope > 12:
				start_scope - 12
			else:
				0

			parent_slot: Int = (round * 7 + start_scope) % names_per_scope
			missing_slot: Int = names_per_scope + (round + start_scope) % names_per_scope
			local_name: String = symbol_name(start_scope, local_slot)
			parent_name: String = symbol_name(parent_scope, parent_slot)
			missing_name: String = symbol_name(start_scope + scope_count + 1, missing_slot)
			checksum += lookup_symbol(scopes, start_scope, local_name)
			checksum += lookup_symbol(scopes, start_scope, parent_name)
			checksum += lookup_symbol(scopes, start_scope, missing_name)

	checksum


func main(args: List[String]):
	scope_count: Int = 220
	names_per_scope: Int = 36
	scopes: List[Scope] = build_scopes(scope_count, names_per_scope)
	checksum: Int = run_symbol_pass(scopes, scope_count, names_per_scope, 12)
	print("compiler_symbols checksum: " + checksum.to_string())
