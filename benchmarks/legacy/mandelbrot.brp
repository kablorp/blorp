import:
	string: string


-- Mandelbrot set benchmark
-- Modeled after the Computer Language Benchmarks Game
-- Outputs ASCII representation: '#' for points in the set, '.' for escaped points
-- Check if point (cr, ci) is in the Mandelbrot set
-- Returns True if inside (does not escape after max_iter iterations)
pure func in_mandelbrot(cr: Float, ci: Float, max_iter: Int) -> Bool:
	var zr: Float = 0.0
	var zi: Float = 0.0
	var i: Int = 0
	var escaped: Bool = False

	while i < max_iter:
		if zr * zr + zi * zi > 4.0:
			escaped = True
			break
		else:
			tr: Float = zr * zr - zi * zi + cr
			zi = 2.0 * zr * zi + ci
			zr = tr
			i += 1

	escaped.negate()


func parse_n(args: List[String]) -> Option[Int]:
	s ?= args.get(1)
	v ?= s.parse_int()
	Some(v)


func main(args: List[String]):
	parsed_n: Option[Int] = parse_n(args)
	n: Int = parsed_n.get_or(16)
	max_iter: Int = 50
	inv_n: Float = 2.0 / to_float(n)

	for y in 0..n:
		ci: Float = to_float(y) * inv_n - 1.0
		var row: String = string(n)

		for x in 0..n:
			cr: Float = to_float(x) * inv_n - 1.5

			if in_mandelbrot(cr, ci, max_iter):
				row = row.append_char('#')
			else:
				row = row.append_char('.')

		print(row)
