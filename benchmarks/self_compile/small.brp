-- Small-program guard for `benchmarks/self_compile_measure --program small`.
-- A compiler change that helps the self-compile must not regress a small
-- program materially. Keep this file stable; it is part of the measurement
-- contract shared by every performance worker.
import:
	list: range

record Point {
	x: Int,
	y: Int
}


union Shape:
	Circle(Point, Int)
	Rect(Point, Point)
	Empty


pure func area(shape: Shape) -> Int:
	match shape:
		Circle(_, r):
			3 * r * r
		Rect(a, b):
			(b.x - a.x) * (b.y - a.y)
		Empty:
			0


pure func describe(shape: Shape) -> String:
	match shape:
		Circle(center, r):
			"circle at ${center.x},${center.y} r=${r}"
		Rect(a, b):
			"rect ${a.x},${a.y}-${b.x},${b.y}"
		Empty:
			"empty"


pure func make_shape(i: Int) -> Shape:
	center: Point = { x = i, y = i + 1 }
	origin: Point = { x = 0, y = 0 }
	corner: Point = { x = i, y = i * 2 }

	if i % 3 == 0:
		Circle(center, i + 2)
	else if i % 3 == 1:
		Rect(origin, corner)
	else:
		Empty


pure func add(acc: Int, value: Int) -> Int:
	acc + value


pure func tally(acc: Dict[String, Int], name: String) -> Dict[String, Int]:
	acc.set(name, acc.get_or(name, 0) + 1)


func main(args: List[String]) -> Int:
	all_shapes: List[Shape] = range(0, 30).map(make_shape)
	total: Int = all_shapes.map(area).fold_left(0, add)
	names: List[String] = all_shapes.map(describe)
	no_counts: Dict[String, Int] = {}
	counts: Dict[String, Int] = names.fold_left(no_counts, tally)
	print("total area: " + total.to_string())
	print("empty shapes: " + counts.get_or("empty", 0).to_string())
	0
