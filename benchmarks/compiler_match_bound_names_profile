#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation="${1:-plain}"

case "$instrumentation" in
	plain|profile)
		shift || true
		;;
	*)
		echo "usage: benchmarks/compiler_match_bound_names_profile plain|profile [iterations] [incoming_bound_width] [cases] [pattern_binders]" >&2
		exit 2
		;;
esac

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-match-bound-names-profile \
	blorp/benchmark/compiler/compiler_match_bound_names_profile.brp \
	"$instrumentation" \
	"$@"
