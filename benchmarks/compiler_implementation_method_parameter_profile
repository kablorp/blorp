#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
	echo "usage: compiler_implementation_method_parameter_profile plain|profile [iterations] [parameters] [occurrences-per-type] [return-occurrences] [constraints] [duplicate-percent]" >&2
	exit 2
fi

instrumentation=$1
shift
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-implementation-method-parameter-profile \
	blorp/benchmark/compiler/compiler_implementation_method_parameter_profile.brp \
	"$instrumentation" \
	"$@"
