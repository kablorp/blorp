#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export BLORP_COMPILER_BENCHMARK_DEBUG="${BLORP_COMPILER_BENCHMARK_DEBUG:-1}"
exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-identity-work-profile \
	blorp/benchmark/compiler/compiler_identity_work_profile.brp \
	"${BLORP_COMPILER_BENCHMARK_INSTRUMENTATION:-profile}" \
	"$@"
