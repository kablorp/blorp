import:
	./arithmetic: projection_fixture_arithmetic_checksum_with_deliberately_long_name
	./callbacks: projection_fixture_callback_checksum_with_deliberately_long_name


private EXPECTED_CHECKSUM: Int = 243


func main(args: List[String]) -> Int:
	seed: Int = 5
	var checksum: Int = projection_fixture_arithmetic_checksum_with_deliberately_long_name(seed)
	checksum += projection_fixture_callback_checksum_with_deliberately_long_name(seed)
	print("C_SYMBOL_HASH_CHECKSUM=${checksum}")

	if checksum == EXPECTED_CHECKSUM:
		0
	else:
		1
