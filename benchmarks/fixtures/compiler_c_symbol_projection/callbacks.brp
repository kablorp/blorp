pure func projection_fixture_invoke_callback_with_deliberately_long_name(
	value: Int,
	callback: pure (Int) -> Int,
) -> Int:
	callback(value)


pure func projection_fixture_named_callback_with_deliberately_long_name(value: Int) -> Int:
	value * 3


pure func projection_fixture_callback_checksum_with_deliberately_long_name(seed: Int) -> Int:
	offset: Int = 7
	named: Int = projection_fixture_invoke_callback_with_deliberately_long_name(
		seed,
		projection_fixture_named_callback_with_deliberately_long_name,
	)
	captured: Int = projection_fixture_invoke_callback_with_deliberately_long_name(
		seed,
		func(value: Int): value + offset,
	)
	named + captured
