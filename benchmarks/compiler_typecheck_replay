METRIC_VERSION = 3
DEFAULT_TIMEOUT_SECONDS = 120.0
MAX_UNCONFIRMED_REQUEST_BYTES = 16 * 1024 * 1024
TRACE_ENV = "BLORP_COMPILER_TYPECHECK_TRACE"
MEMSTATS_ENV = "BLORP_COMPILER_TYPECHECK_MEMSTATS"
ALLOCATOR_STATS_ENV = "BLORP_ALLOCATOR_STATS"
INVENTORY_ENV = "BLORP_COMPILER_TYPECHECK_INVENTORY"
WORKER_FLAG = "--measurement-worker"
POLL_SECONDS = 0.02
TERMINATE_GRACE_SECONDS = 1.0
ERROR_EXCERPT_BYTES = 4096
PHASE_PREFIX = "[typecheck-phase] "
INVENTORY_PREFIX = "[typecheck-inventory] "
MEMSTAT_FIELDS = (
    "total_allocations",
