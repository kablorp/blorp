#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
compiler="${BLORP_CORE_LOWERING_ATTRIBUTION_COMPILER:-$repo_root/bin/blorp}"
source_file="$repo_root/benchmarks/blorp/profiles/core_lowering_allocation_attribution.brp"

if [ "${BLORP_CORE_LOWERING_ATTRIBUTION_SKIP_BUILD:-0}" != "1" ]; then
	BLORP_CLI_C_OPTIMIZATION=-O2 make -C "$repo_root" all >/dev/null
fi

if [ ! -x "$compiler" ]; then
	echo "compiler_core_lowering_allocation_attribution: compiler is not executable: $compiler" >&2
	exit 1
fi

cd "$repo_root"
BLORP_TRACK_STATS=1 "$compiler" run --no-format "$source_file"
