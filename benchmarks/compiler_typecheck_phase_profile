#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation="${BLORP_COMPILER_BENCHMARK_INSTRUMENTATION:-profile}"

if [ "${1:-}" = "source-names" ]; then
	export BLORP_COMPILER_BENCHMARK_DEBUG="${BLORP_COMPILER_BENCHMARK_DEBUG:-1}"
fi

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-typecheck-phase-profile \
	blorp/benchmark/compiler/compiler_typecheck_phase_profile.brp \
	"$instrumentation" \
	"$@"
