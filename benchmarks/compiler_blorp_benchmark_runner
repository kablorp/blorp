#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 3 ]; then
	echo "usage: compiler_blorp_benchmark_runner NAME SOURCE profile|plain [ARGS...]" >&2
	exit 2
fi

benchmark_name=$1
source_file=$2
instrumentation=$3
shift 3

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
cc_path=$(command -v cc)
workspace_root="${BLORP_COMPILER_BENCHMARK_WORKSPACE_ROOT:-$repo_root}"
if [[ "$workspace_root" != /* ]]; then
	workspace_root="$PWD/$workspace_root"
fi
compiler="${BLORP_COMPILER_BENCHMARK_COMPILER:-${BLORP_TYPECHECK_PROFILE_COMPILER:-$workspace_root/compiler/_build/blorp-cli/blorp}}"

case "$instrumentation" in
	plain|profile)
		;;
	*)
		echo "instrumentation must be 'plain' or 'profile'" >&2
		exit 2
		;;
esac

if command -v shasum >/dev/null 2>&1; then
	hash_command=(shasum -a 256)
elif command -v sha256sum >/dev/null 2>&1; then
	hash_command=(sha256sum)
else
	echo "compiler benchmark runner requires shasum or sha256sum" >&2
	exit 1
fi

skip_build="${BLORP_COMPILER_BENCHMARK_SKIP_BUILD:-${BLORP_TYPECHECK_PROFILE_SKIP_BUILD:-0}}"
if [ "$skip_build" != "1" ]; then
	make -C "$workspace_root" all >/dev/null
fi
if [[ "$compiler" != /* ]]; then
	compiler="$PWD/$compiler"
fi
if [ ! -x "$compiler" ]; then
	echo "compiler benchmark runner requires an executable compiler: $compiler" >&2
	exit 1
fi
if [[ "$source_file" != /* ]]; then
	source_file="$workspace_root/$source_file"
fi
if [ ! -f "$source_file" ]; then
	echo "compiler benchmark source does not exist: $source_file" >&2
	exit 1
fi

bridge_compiler="${BLORP_COMPILER_BRIDGE_BIN:-}"
if [ -z "$bridge_compiler" ]; then
	bridge_compiler=$("$workspace_root/scripts/blorp-compiler-bootstrap" --print-path)
fi
if [[ "$bridge_compiler" != /* ]]; then
	bridge_compiler="$PWD/$bridge_compiler"
fi

export BLORP_COMPILER_BRIDGE_BIN="$bridge_compiler"
unset \
	BLORP_FRONTEND_PARSER \
	BLORP_STD

prepared_bridge_files=()
if [ "${BLORP_BENCHMARK_USE_PREPARED_BRIDGES:-0}" = "1" ]; then
	prepared_bridge="${BLORP_COMPILER_PARSER_BRIDGE_BIN:-}"
	if [ -n "$prepared_bridge" ] && [[ "$prepared_bridge" != /* ]]; then
		prepared_bridge="$PWD/$prepared_bridge"
	fi
	if [ -z "$prepared_bridge" ] || [ ! -x "$prepared_bridge" ]; then
		echo "prepared bridge mode requires an executable parser bridge" >&2
		exit 1
	fi
	export BLORP_COMPILER_PARSER_BRIDGE_BIN="$prepared_bridge"
	prepared_bridge_files+=("$prepared_bridge")
	export BLORP_COMPILER_REQUIRE_PREPARED_BRIDGE=1
else
	unset \
		BLORP_COMPILER_PARSER_BRIDGE_BIN \
		BLORP_COMPILER_REQUIRE_PREPARED_BRIDGE
fi
cd "$workspace_root"

cache_input_files=(
	"$script_dir/compiler_blorp_benchmark_runner"
	"$source_file"
	"$compiler"
	"$bridge_compiler"
	"$cc_path"
	"$workspace_root/blorp.toml"
)
if [ "${BLORP_BENCHMARK_USE_PREPARED_BRIDGES:-0}" = "1" ]; then
	cache_input_files+=("${prepared_bridge_files[@]}")
fi
cache_root="${BLORP_BENCHMARK_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/blorp/benchmarks}"
input_hash=$(
	{
		find \
			"$workspace_root/compiler/blorp/src" \
			"$workspace_root/compiler/blorp/benchmarks" \
			"$workspace_root/std" \
			-type f \( -name '*.brp' -o -name '*.h' \) \
			-exec "${hash_command[@]}" {} +
		"${hash_command[@]}" "${cache_input_files[@]}"
		printf 'benchmark=%s\ninstrumentation=%s\nplatform=%s\n' \
			"$benchmark_name" "$instrumentation" "$(uname -srm)"
		"$cc_path" --version
	} |
		LC_ALL=C sort |
		"${hash_command[@]}" |
		awk '{print $1}'
)
artifact_dir="$cache_root/$benchmark_name/$input_hash"
binary="$artifact_dir/$benchmark_name"

if [ ! -x "$binary" ]; then
	stage_dir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-compiler-benchmark.XXXXXX")
	trap 'rm -rf "$stage_dir"' EXIT

	compile_args=(compile --no-format)
	cc_optimization=-O2
	if [ "$instrumentation" = "profile" ]; then
		compile_args+=(--profile)
		cc_optimization=-O0
	fi
	"$compiler" "${compile_args[@]}" -o "$stage_dir/$benchmark_name.c" "$source_file" >/dev/null
	"$cc_path" "$cc_optimization" -fwrapv -pipe -w \
		-I"$workspace_root/compiler/blorp/src/stage_06_typecheck/graph" \
		"$stage_dir/$benchmark_name.c" -lm -lpthread -o "$stage_dir/$benchmark_name"

	mkdir -p "$artifact_dir"
	mv "$stage_dir/$benchmark_name" "$binary"
	trap - EXIT
	rm -rf "$stage_dir"
fi

if [ "${1:-}" = "--" ]; then
	shift
fi

exec "$binary" "$@"
