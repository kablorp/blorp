#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

: "${BLORP_COMPILER_BENCHMARK_SKIP_BUILD:=1}"
export BLORP_COMPILER_BENCHMARK_SKIP_BUILD

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-known-type-index-profile \
	"$repo_root/blorp/benchmark/compiler/compiler_known_type_index_profile.brp" \
	plain \
	"$@"
