#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

exec "$script_dir/compiler_typecheck_memory" \
	--type-depth 1 \
	--probes-per-module 1 \
	--resource-scan-depth 64 \
	--resource-scan-probes-per-module 64 \
	--self-resolution-depth 64 \
	--self-resolution-probes-per-module 64 \
	--warmup-runs 2 \
	--runs 6 \
	"$@"
