        baseline_counters = [point.get("baseline_work_counters") for point in points]
        if not all(isinstance(value, dict) for value in baseline_counters):
            raise RuntimeError("lambda-owner matrix requires baseline work counters")

        candidate_visits = visits[-1]
        baseline_visits = int(
            baseline_counters[-1]["lambda_borrowed_normalization_visits"]
        )
        if candidate_visits * 4 > baseline_visits:
            raise RuntimeError(
                "lambda-owner matrix must reduce 32-owner reconstruction visits "
                f"by at least 75%: baseline {baseline_visits}, candidate {candidate_visits}"
            )

        high_owner = points[-1]
        speed_ratio = high_owner.get(
            "paired_window_elapsed_microseconds_ratio_median"
        )
        allocation_ratio = high_owner.get(
            "paired_window_allocations_ratio_median"
        )
        if not isinstance(speed_ratio, (int, float)):
            raise RuntimeError("lambda-owner matrix is missing paired direct timing")
        if float(speed_ratio) > 0.85:
            raise RuntimeError(
                "lambda-owner matrix must make the 32-owner direct window at least "
                f"15% faster: ratio {speed_ratio}"
            )
        if not isinstance(allocation_ratio, (int, float)):
            raise RuntimeError("lambda-owner matrix is missing paired allocation data")
        if float(allocation_ratio) > 0.80:
            raise RuntimeError(
                "lambda-owner matrix must reduce 32-owner direct-window allocations "
                f"by at least 20%: ratio {allocation_ratio}"
            )

        one_owner = points[0]
        one_owner_speed_ratio = one_owner.get(
            "paired_window_elapsed_microseconds_ratio_median"
        )
        if not isinstance(one_owner_speed_ratio, (int, float)):
            raise RuntimeError("lambda-owner matrix is missing one-owner paired timing")
        if float(one_owner_speed_ratio) > 1.05:
            raise RuntimeError(
                "lambda-owner matrix one-owner direct timing regressed by more "
                f"than 5%: ratio {one_owner_speed_ratio}"
            )
        for metric_name in ("window_allocations", "window_releases"):
            ratio = one_owner.get(f"paired_{metric_name}_ratio_median")
            if not isinstance(ratio, (int, float)):
                raise RuntimeError(
                    f"lambda-owner matrix is missing one-owner paired {metric_name}"
                )
            if float(ratio) > 1.02:
                raise RuntimeError(
                    "lambda-owner matrix one-owner "
                    f"{metric_name} regressed by more than 2%: ratio {ratio}"
                )


