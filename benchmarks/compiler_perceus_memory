def referenced_global_result_tree(referenced_globals: int) -> JsonObject:
    results = [
        global_ref_expr(
            (
                REFERENCED_GLOBAL_CALL_SITES_PER_FUNCTION
                + REFERENCED_GLOBAL_AGGREGATE_SITES_PER_FUNCTION
                + terminal_index
            )
            % referenced_globals
        )
        for terminal_index in range(REFERENCED_GLOBAL_RESULT_SITES_PER_FUNCTION)
    ]
    while len(results) > 1:
        if len(results) % 2 != 0:
            raise RuntimeError("referenced-global result count must form a balanced tree")
        results = [
            {
                "kind": "if",
                "cond": literal_expr("bool", True, "Bool"),
                "then": results[index],
                "else": results[index + 1],
                "type": named_type(MANAGED_PARAMETER_TYPE),
                "loc": synthetic_loc(),
            }
            for index in range(0, len(results), 2)
        ]
    return results[0]


def referenced_global_boundary_body(
    function_index: int,
    referenced_globals: int,
    body_nodes: int,
) -> JsonObject:
    if referenced_globals < 1 or referenced_globals > REFERENCED_GLOBAL_SITES_PER_FUNCTION:
        raise ValueError("referenced-global boundary requires between 1 and 32 globals")

    work: list[JsonObject] = []
    for site_index in range(REFERENCED_GLOBAL_CALL_SITES_PER_FUNCTION):
        work.append(referenced_global_call_expr(site_index % referenced_globals))
    for site_index in range(REFERENCED_GLOBAL_AGGREGATE_SITES_PER_FUNCTION):
        global_site = REFERENCED_GLOBAL_CALL_SITES_PER_FUNCTION + site_index
        work.append(referenced_global_aggregate_expr(global_site % referenced_globals))

    result = referenced_global_result_tree(referenced_globals)
    body_tail = padded_result_sequence_with_work(result=result, work=work, target_nodes=body_nodes - 2)
    return {
        "kind": "let",
        "name": core_var(f"BENCH_MANAGED_LOCAL_{function_index:04d}", None),
        "mutable": False,
        "type": named_type(MANAGED_PARAMETER_TYPE),
        "rhs": literal_expr("string", "managed-global-boundary", MANAGED_PARAMETER_TYPE),
        "body": body_tail,
    }


def referenced_global_boundary_census(value: Any) -> JsonObject:
    consuming_calls = 0
    aggregate_transfers = 0
    reference_sites = 0
    global_indices: set[int] = set()

    def visit(current: Any) -> None:
        nonlocal consuming_calls, aggregate_transfers, reference_sites
        if isinstance(current, dict):
            kind = current.get("kind")
            if kind == "call":
                call_kind = current.get("call_kind")
                if (
                    isinstance(call_kind, dict)
                    and call_kind.get("kind") == "builtin"
                    and call_kind.get("name") == "blorp_string_concat_consume"
                ):
                    consuming_calls += 1
            elif (
                kind == "record_construct"
                and current.get("type_name") == BORROWED_OWNER_TYPE_NAME
            ):
                aggregate_transfers += 1
            elif kind == "var":
                variable = current.get("var")
                if isinstance(variable, dict):
                    name = variable.get("name")
                    def_id = variable.get("def_id")
                    if (
                        isinstance(name, str)
                        and name.startswith("BENCH_UNUSED_GLOBAL_")
                        and isinstance(def_id, int)
                    ):
                        reference_sites += 1
                        global_indices.add(def_id - 1)
            for child in current.values():
                visit(child)
        elif isinstance(current, list):
            for child in current:
                visit(child)

    visit(value)
    return {
        "consuming_calls": consuming_calls,
        "aggregate_transfers": aggregate_transfers,
        "result_terminals": reference_sites - consuming_calls - aggregate_transfers,
        "reference_sites": reference_sites,
        "distinct_global_indices": len(global_indices),
    }


