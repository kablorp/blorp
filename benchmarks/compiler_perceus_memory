def parse_perceus_work_counters(stderr: str) -> dict[str, int]:
    counters: dict[str, int] = {}
    for line in stderr.splitlines():
        for name in PERCEUS_WORK_COUNTER_NAMES:
            if f"perceus_work_{name}" not in line:
                continue
            match = re.search(r"\s([0-9]+)\s+[0-9.]+\s*$", line)
            if match is not None:
                registered_count = int(match.group(1))
                if registered_count < 1:
                    raise RuntimeError(f"invalid Perceus work counter: {name}")
                counters[name] = registered_count - 1
    missing = [name for name in PERCEUS_WORK_COUNTER_NAMES if name not in counters]
    if missing:
        raise RuntimeError("missing Perceus work counters: " + ", ".join(missing))
    return counters


def core_ownership_census(core_program: JsonObject) -> JsonObject:
    dup_by_policy: dict[str, int] = {}
    drop_by_policy: dict[str, int] = {}
    expression_nodes = 0

    def visit(value: Any) -> None:
        nonlocal expression_nodes
        if isinstance(value, dict):
            kind = value.get("kind")
            if kind in CORE_EXPR_KINDS:
                expression_nodes += 1
            if kind == "dup":
                policy = str(value.get("retain_policy", "unknown"))
                dup_by_policy[policy] = dup_by_policy.get(policy, 0) + 1
            elif kind == "drop":
                policy = str(value.get("release_policy", "unknown"))
                drop_by_policy[policy] = drop_by_policy.get(policy, 0) + 1
            for child in value.values():
                visit(child)
        elif isinstance(value, list):
            for child in value:
                visit(child)

    visit(core_program)
    return {
        "expression_nodes": expression_nodes,
        "dup_by_policy": dict(sorted(dup_by_policy.items())),
        "drop_by_policy": dict(sorted(drop_by_policy.items())),
    }


def c_without_literals_and_comments(c_code: str) -> str:
    """Blank C literals/comments while preserving token and line boundaries."""
    output: list[str] = []
    index = 0
    state = "code"
    while index < len(c_code):
        current = c_code[index]
        following = c_code[index + 1] if index + 1 < len(c_code) else ""
        if state == "code":
            if current == '"':
                state = "string"
                output.append(" ")
            elif current == "'":
                state = "char"
                output.append(" ")
            elif current == "/" and following == "/":
                state = "line_comment"
                output.extend((" ", " "))
                index += 1
            elif current == "/" and following == "*":
                state = "block_comment"
                output.extend((" ", " "))
                index += 1
            else:
                output.append(current)
        elif state in ("string", "char"):
            if current == "\\":
                output.append(" ")
                if following:
                    output.append("\n" if following == "\n" else " ")
                    index += 1
            elif (state == "string" and current == '"') or (
                state == "char" and current == "'"
            ):
                state = "code"
                output.append(" ")
            else:
                output.append("\n" if current == "\n" else " ")
        elif state == "line_comment":
            output.append("\n" if current == "\n" else " ")
            if current == "\n":
                state = "code"
        else:
            output.append("\n" if current == "\n" else " ")
            if current == "*" and following == "/":
                output.append(" ")
                index += 1
                state = "code"
        index += 1
    return "".join(output)


def generated_c_ownership_census(c_code: str) -> JsonObject:
    """Count emitted ownership statements, excluding C literals and comments."""
    emitted_code = c_without_literals_and_comments(c_code)
    return {
        "retain_calls": len(re.findall(r"\bblorp_retain\s*\(", emitted_code)),
        "release_calls": len(re.findall(r"\bblorp_release\s*\(", emitted_code)),
        "release_arc_only_calls": len(
            re.findall(r"\bblorp_release_arc_only\s*\(", emitted_code)
        ),
        "cleanup_push_calls": len(
            re.findall(r"\bblorp_task_cleanup_push\s*\(", emitted_code)
        ),
        "cleanup_pop_calls": len(
            re.findall(r"\bblorp_task_cleanup_pop_slot\s*\(", emitted_code)
