def synthetic_loc() -> JsonObject:
    return {"kind": "synthetic"}


def named_type(name: str) -> JsonObject:
    return {"kind": "named", "name": name, "args": []}


def heap_record_type(name: str) -> JsonObject:
    return {"kind": "heap_record", "name": name}


def core_var(name: str, def_id: int | None) -> JsonObject:
    return {"name": name, "uniq": 0, "def_id": def_id}


def literal_expr(kind: str, value: Any, type_name: str) -> JsonObject:
    return {
        "kind": "literal",
        "literal": {"kind": kind, "value": value},
        "type": named_type(type_name),
        "loc": synthetic_loc(),
    }


def seq_expr(expressions: list[JsonObject]) -> JsonObject:
    if not expressions:
        raise ValueError("a sequence requires at least one expression")

    result = expressions[-1]
    for expression in reversed(expressions[:-1]):
        result = {"kind": "seq", "first": expression, "second": result}
    return result


def balanced_seq_expr(expressions: list[JsonObject]) -> JsonObject:
    """Preserve sequence order without making fixture depth proportional to size."""
    if not expressions:
        raise ValueError("a sequence requires at least one expression")

    level = list(expressions)
    while len(level) > 1:
        next_level: list[JsonObject] = []
        index = 0
        while index + 1 < len(level):
            next_level.append({
                "kind": "seq",
                "first": level[index],
                "second": level[index + 1],
            })
            index += 2
        if index < len(level):
            next_level.append(level[index])
        level = next_level
    return level[0]


def expression_node_count(value: Any) -> int:
    node_count = 0
    pending = [value]
    while pending:
        current = pending.pop()
        if isinstance(current, dict):
            kind = current.get("kind")
            node_count += int(isinstance(kind, str) and kind in CORE_EXPR_KINDS)
            pending.extend(current.values())
        elif isinstance(current, list):
            pending.extend(current)
    return node_count


def padded_sequence(expressions: list[JsonObject], target_nodes: int) -> JsonObject:
    if not expressions:
        expressions = [literal_expr("int", 0, "Int")]
    result = seq_expr(expressions)
    current_nodes = expression_node_count(result)
    if current_nodes > target_nodes:
        raise ValueError(
            f"body workload needs {current_nodes} nodes but target is {target_nodes}"
        )
    while current_nodes + 2 <= target_nodes:
        expressions.append(literal_expr("int", current_nodes, "Int"))
        current_nodes += 2
    result = seq_expr(expressions)
    if current_nodes < target_nodes:
        result = {
            "kind": "cast",
            "expr": result,
            "type": named_type("Int"),
            "loc": synthetic_loc(),
        }
    if expression_node_count(result) != target_nodes:
        raise RuntimeError("failed to construct exact Perceus body node target")
    return result


def balanced_padded_sequence(
    expressions: list[JsonObject],
    target_nodes: int,
) -> JsonObject:
    if not expressions:
        expressions = [literal_expr("int", 0, "Int")]
    current_nodes = expression_node_count(balanced_seq_expr(expressions))
    if current_nodes > target_nodes:
        raise ValueError(
            f"body workload needs {current_nodes} nodes but target is {target_nodes}"
        )
    while current_nodes + 2 <= target_nodes:
        expressions.append(literal_expr("int", current_nodes, "Int"))
        current_nodes += 2
    result = balanced_seq_expr(expressions)
    if current_nodes < target_nodes:
        result = {
            "kind": "cast",
            "expr": result,
            "type": named_type("Int"),
            "loc": synthetic_loc(),
        }
    if expression_node_count(result) != target_nodes:
        raise RuntimeError("failed to construct exact Perceus body node target")
    return result


def balanced_padded_sequence_without_wrapper(
    expressions: list[JsonObject],
    target_nodes: int,
) -> JsonObject:
    """Reach an exact size without an outer child-domain-changing wrapper."""
    if not expressions:
        expressions = [literal_expr("int", 0, "Int")]
    current_nodes = expression_node_count(balanced_seq_expr(expressions))
    if current_nodes > target_nodes:
        raise ValueError(
            f"body workload needs {current_nodes} nodes but target is {target_nodes}"
        )
    remaining_nodes = target_nodes - current_nodes
    if remaining_nodes % 2 == 1:
        if remaining_nodes < 5:
            raise ValueError("exact traversable padding needs at least five odd nodes")
        expressions.append({
            "kind": "if",
            "cond": literal_expr("bool", True, "Bool"),
            "then": literal_expr("int", 0, "Int"),
            "else": literal_expr("int", 0, "Int"),
            "type": named_type("Int"),
            "loc": synthetic_loc(),
        })
        current_nodes += 5
    while current_nodes + 2 <= target_nodes:
        expressions.append(literal_expr("int", current_nodes, "Int"))
        current_nodes += 2
    result = balanced_seq_expr(expressions)
    if expression_node_count(result) != target_nodes:
        raise RuntimeError("failed to construct exact traversable body node target")
    return result


def padded_result_sequence(result: JsonObject, target_nodes: int) -> JsonObject:
    """Add traversable non-result work while preserving the result expression."""
    result_nodes = expression_node_count(result)
    padding_nodes = target_nodes - result_nodes - 1
    if padding_nodes < 1:
        raise ValueError(
            "borrowed-result workload is larger than the requested node count"
        )
    padding = padded_sequence(
        [literal_expr("int", 0, "Int")],
        padding_nodes,
    )
    combined = {"kind": "seq", "first": padding, "second": result}
    if expression_node_count(combined) != target_nodes:
        raise RuntimeError("failed to construct exact borrowed-result node target")
    return combined


def padded_result_sequence_with_work(
    work: list[JsonObject],
    result: JsonObject,
    target_nodes: int,
    *,
    balance_padding: bool = False,
) -> JsonObject:
    """Pad non-result work without moving it into the function result path."""
    result_nodes = expression_node_count(result)
    work_target_nodes = target_nodes - result_nodes - 1
    if work_target_nodes < 1:
        raise ValueError(
            "referenced-global workload is larger than the requested node count"
        )
    padded_work = list(work)
    work_nodes = expression_node_count(seq_expr(padded_work))
    remaining_nodes = work_target_nodes - work_nodes
    if remaining_nodes % 2 == 1:
        if remaining_nodes < 3:
            raise ValueError(
                "non-result workload needs a dedicated three-node odd padding value"
            )
        padded_work.append({
            "kind": "cast",
            "expr": literal_expr("int", 0, "Int"),
            "type": named_type("Int"),
            "loc": synthetic_loc(),
        })
    if balance_padding:
        padding = balanced_padded_sequence(padded_work, work_target_nodes)
    else:
        padding = padded_sequence(padded_work, work_target_nodes)
    combined = {"kind": "seq", "first": padding, "second": result}
    if expression_node_count(combined) != target_nodes:
        raise RuntimeError("failed to construct exact referenced-global node target")
    return combined


