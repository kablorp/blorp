def borrowed_boundary_fusion_result_tree(
    function_index: int,
    active_density: int,
) -> JsonObject:
    results = [
        (
            borrowed_boundary_fusion_owner_ref(function_index, site_index)
            if site_index < active_density
            else literal_expr(
                "string",
                f"FUSION_INACTIVE_RESULT_{site_index:04d}",
                MANAGED_PARAMETER_TYPE,
            )
        )
        for site_index in range(BORROWED_BOUNDARY_FUSION_SLOTS_PER_FAMILY)
    ]
    while len(results) > 1:
        next_level: list[JsonObject] = []
        index = 0
        while index + 1 < len(results):
            next_level.append({
                "kind": "if",
                "cond": literal_expr("bool", True, "Bool"),
                "then": results[index],
                "else": results[index + 1],
                "type": named_type(MANAGED_PARAMETER_TYPE),
                "loc": synthetic_loc(),
            })
            index += 2
        if index < len(results):
            next_level.append(results[index])
        results = next_level
    return results[0]


def borrowed_boundary_fusion_body(
    function_index: int,
    active_density: int,
    body_nodes: int,
) -> JsonObject:
    if active_density not in BORROWED_BOUNDARY_FUSION_DENSITIES:
        raise ValueError("borrowed-boundary density must be 8, 32, or 96")

    work = [
        borrowed_boundary_fusion_call_slot(
            function_index,
            site_index,
            active_density,
        )
        for site_index in range(BORROWED_BOUNDARY_FUSION_SLOTS_PER_FAMILY)
    ]
    work.extend(
        borrowed_boundary_fusion_storage_slot(
            function_index,
            site_index,
            active_density,
        )
        for site_index in range(BORROWED_BOUNDARY_FUSION_SLOTS_PER_FAMILY)
    )

    result = borrowed_boundary_fusion_result_tree(function_index, active_density)
    placeholder = literal_expr("int", 0, "Int")

    def assemble(case_body: JsonObject) -> JsonObject:
        managed_local_rhs = {
            "kind": "call",
            "call_kind": {"kind": "builtin", "name": "blorp_string_concat"},
            "callee": {
                "kind": "var",
                "var": core_var("blorp_string_concat", None),
                "type": named_type("Function"),
                "loc": synthetic_loc(),
            },
            "args": [
                literal_expr("string", "managed-fusion-", MANAGED_PARAMETER_TYPE),
                literal_expr(
                    "string",
                    f"{function_index:04d}",
                    MANAGED_PARAMETER_TYPE,
                ),
            ],
            "type": named_type(MANAGED_PARAMETER_TYPE),
            "loc": synthetic_loc(),
        }
        match_work = {
            "kind": "literal_match",
            "scrutinee": literal_expr("int", 0, "Int"),
            "cases": [{
                "literal": {"kind": "int", "value": 0},
                "bindings": [],
                "body": case_body,
            }],
            "fallback": {"kind": "fail"},
            "type": named_type("Int"),
            "loc": synthetic_loc(),
        }
        return {
            "kind": "let",
            "name": core_var(f"BENCH_MANAGED_LOCAL_{function_index:04d}", None),
            "mutable": False,
            "type": named_type(MANAGED_PARAMETER_TYPE),
            "rhs": managed_local_rhs,
            "body": {
                "kind": "resource_scope",
                "scope": {
                    "var": core_var(f"BENCH_FUSION_RESOURCE_{function_index:04d}", None),
                    "type": named_type(MANAGED_PARAMETER_TYPE),
                    "acquire": literal_expr(
                        "string",
                        f"resource-fusion-{function_index:04d}",
                        MANAGED_PARAMETER_TYPE,
                    ),
                    "body": {"kind": "seq", "first": match_work, "second": result},
                    "cleanup": literal_expr("int", 0, "Int"),
                },
                "type": named_type(MANAGED_PARAMETER_TYPE),
                "loc": synthetic_loc(),
            },
        }

    fixed_nodes = expression_node_count(assemble(placeholder)) - 1
    work_body = balanced_padded_sequence_without_wrapper(
        work,
        body_nodes - fixed_nodes,
    )
    body = assemble(work_body)
    if expression_node_count(body) != body_nodes:
        raise RuntimeError("borrowed-boundary fusion body node count changed")
    return body


def borrowed_boundary_fusion_census(value: Any) -> JsonObject:
    call_slots = 0
    active_calls = 0
    storage_slots = 0
    active_storage = 0
    nested_lambdas = 0
    literal_matches = 0
    resource_scopes = 0
    globals_seen: set[int] = set()
    opaque_padding_nodes = 0

    pending = [value]
    while pending:
        current = pending.pop()
        if isinstance(current, dict):
            kind = current.get("kind")
            if kind == "call":
                call_kind = current.get("call_kind")
                args = current.get("args")
                first_arg = args[0] if isinstance(args, list) and args else None
                if (
                    isinstance(call_kind, dict)
                    and isinstance(first_arg, dict)
                    and first_arg.get("kind") in ("var", "field")
                ):
                    name = call_kind.get("name")
                    if name in (
                        "blorp_string_concat",
                        "blorp_string_concat_consume",
                    ):
                        call_slots += 1
                        active_calls += int(name == "blorp_string_concat_consume")
            elif kind == "tensor_boxed_literal":
                storage_slots += 1
                literal = current.get("literal")
                if isinstance(literal, dict):
                    active_storage += int(bool(literal.get("elem_needs_release")))
            elif kind == "lambda":
                nested_lambdas += 1
                continue
            elif kind == "literal_match":
                literal_matches += 1
            elif kind == "resource_scope":
                resource_scopes += 1
            elif kind == "cast":
                opaque_padding_nodes += 1
            elif kind == "var":
                variable = current.get("var")
                if isinstance(variable, dict):
                    name = variable.get("name")
                    def_id = variable.get("def_id")
                    if (
                        isinstance(name, str)
                        and name.startswith("BENCH_UNUSED_GLOBAL_")
                        and isinstance(def_id, int)
                    ):
                        globals_seen.add(def_id - 1)
            pending.extend(current.values())
        elif isinstance(current, list):
            pending.extend(current)

    result_tree = value["body"]["scope"]["body"]["second"]
    result_slots = 0
    active_results = 0
    pending_results = [result_tree]
    while pending_results:
        current = pending_results.pop()
        if current.get("kind") == "if":
            pending_results.extend((current["then"], current["else"]))
        else:
            result_slots += 1
            literal = current.get("literal")
            inactive = (
                isinstance(literal, dict)
                and isinstance(literal.get("value"), str)
                and literal["value"].startswith("FUSION_INACTIVE_RESULT_")
            )
            active_results += int(not inactive)

    return {
        "call_slots": call_slots,
        "active_calls": active_calls,
        "storage_slots": storage_slots,
        "active_storage": active_storage,
        "result_slots": result_slots,
        "active_results": active_results,
        "distinct_globals": len(globals_seen),
        "nested_lambdas": nested_lambdas,
        "literal_matches": literal_matches,
        "resource_scopes": resource_scopes,
        "opaque_padding_nodes": opaque_padding_nodes,
    }


def lambda_owner_name(function_index: int, owner_index: int) -> str:
    return f"BENCH_LAMBDA_OWNER_{function_index:04d}_{owner_index:04d}"


def lambda_owner_ref_expr(function_index: int, owner_index: int) -> JsonObject:
    return {
        "kind": "var",
        "var": core_var(lambda_owner_name(function_index, owner_index), None),
        "type": named_type(MANAGED_PARAMETER_TYPE),
        "loc": synthetic_loc(),
    }


def lambda_expr(
    params: list[JsonObject],
    return_type: JsonObject,
    body: JsonObject,
) -> JsonObject:
    return {
        "kind": "lambda",
        "params": params,
        "return_type": return_type,
        "body": body,
        "pure": True,
        "type": named_type("Function"),
        "loc": synthetic_loc(),
    }


def lambda_boundary_result_tree(
    function_index: int,
    owner_count: int,
) -> JsonObject:
    results = [
        lambda_owner_ref_expr(
            function_index,
            (LAMBDA_CALL_SITES_PER_FUNCTION + LAMBDA_AGGREGATE_SITES_PER_FUNCTION + site)
            % owner_count,
        )
        for site in range(LAMBDA_RESULT_SITES_PER_FUNCTION)
    ]
    while len(results) > 1:
        next_level: list[JsonObject] = []
        index = 0
        while index + 1 < len(results):
            next_level.append({
                "kind": "if",
                "cond": literal_expr("bool", True, "Bool"),
                "then": results[index],
                "else": results[index + 1],
                "type": named_type(MANAGED_PARAMETER_TYPE),
                "loc": synthetic_loc(),
            })
            index += 2
        if index < len(results):
            next_level.append(results[index])
        results = next_level
    return results[0]


def lambda_borrowed_boundary_expr(
    function_index: int,
    owner_count: int,
    body_nodes: int,
) -> JsonObject:
    if owner_count < 1 or owner_count > 32:
        raise ValueError("lambda borrowed boundary requires between 1 and 32 owners")

    work: list[JsonObject] = []
    for site in range(LAMBDA_CALL_SITES_PER_FUNCTION):
        work.append({
            "kind": "call",
            "call_kind": {"kind": "builtin", "name": "blorp_string_concat_consume"},
            "callee": {
                "kind": "var",
                "var": core_var("blorp_string_concat_consume", None),
                "type": named_type("Function"),
                "loc": synthetic_loc(),
            },
            "args": [
                lambda_owner_ref_expr(function_index, site % owner_count),
                literal_expr("string", "", MANAGED_PARAMETER_TYPE),
            ],
            "type": named_type(MANAGED_PARAMETER_TYPE),
            "loc": synthetic_loc(),
        })
    for site in range(LAMBDA_AGGREGATE_SITES_PER_FUNCTION):
        owner_index = (LAMBDA_CALL_SITES_PER_FUNCTION + site) % owner_count
        work.append({
            "kind": "record_construct",
            "type_name": BORROWED_OWNER_TYPE_NAME,
            "fields": [{
                "name": "BENCH_PAYLOAD",
                "value": lambda_owner_ref_expr(function_index, owner_index),
            }],
            "type": heap_record_type(BORROWED_OWNER_TYPE_NAME),
            "loc": synthetic_loc(),
        })

    nested_name = f"BENCH_NESTED_LAMBDA_OWNER_{function_index:04d}"
    work.append(lambda_expr(
        [core_param(nested_name, MANAGED_PARAMETER_TYPE)],
        named_type(MANAGED_PARAMETER_TYPE),
        {
            "kind": "var",
            "var": core_var(nested_name, None),
            "type": named_type(MANAGED_PARAMETER_TYPE),
            "loc": synthetic_loc(),
        },
    ))

    body = padded_result_sequence_with_work(
        work=work,
        result=lambda_boundary_result_tree(function_index, owner_count),
        target_nodes=body_nodes,
    )
    params = [
        core_param(lambda_owner_name(function_index, owner_index), MANAGED_PARAMETER_TYPE)
        for owner_index in range(owner_count)
    ]
    return lambda_expr(params, named_type(MANAGED_PARAMETER_TYPE), body)


def lambda_boundary_census(value: Any) -> JsonObject:
    consuming_calls = 0
    aggregate_transfers = 0
    owner_reads = 0
    owner_names: set[str] = set()
    nested_lambdas = 0

    def visit(current: Any) -> None:
        nonlocal consuming_calls, aggregate_transfers, owner_reads, nested_lambdas
        if isinstance(current, dict):
            kind = current.get("kind")
            if kind == "lambda":
                nested_lambdas += 1
                return
            if kind == "call":
                call_kind = current.get("call_kind")
                if (
                    isinstance(call_kind, dict)
                    and call_kind.get("kind") == "builtin"
                    and call_kind.get("name") == "blorp_string_concat_consume"
                ):
                    consuming_calls += 1
            elif (
                kind == "record_construct"
                and current.get("type_name") == BORROWED_OWNER_TYPE_NAME
            ):
                aggregate_transfers += 1
            elif kind == "var":
                variable = current.get("var")
                if isinstance(variable, dict):
                    name = variable.get("name")
                    if isinstance(name, str) and name.startswith("BENCH_LAMBDA_OWNER_"):
                        owner_reads += 1
                        owner_names.add(name)
            for child in current.values():
                visit(child)
        elif isinstance(current, list):
            for child in current:
                visit(child)

    visit(value)
    return {
        "consuming_calls": consuming_calls,
        "aggregate_transfers": aggregate_transfers,
        "result_terminals": owner_reads - consuming_calls - aggregate_transfers,
        "owner_reads": owner_reads,
        "distinct_owners": len(owner_names),
        "nested_lambdas": nested_lambdas,
    }


