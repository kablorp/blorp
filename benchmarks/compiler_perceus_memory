    if as_json:
        print(json.dumps(metrics, sort_keys=True))
        return

    ordered_names = (
        "fixture_version",
        "action",
        "globals",
        "functions",
        "body_leaves",
        "global_reads_per_function",
        "params_per_function",
        "parameter_type",
        "baseline_parameter_type",
        "comparison_kind",
        "invoke_workers",
        "declarations",
        "input_expression_nodes",
        "request_bytes",
        "response_bytes",
        "artifact_bytes",
        "artifact_sha256",
        "samples",
        "warmup",
        "timeout_seconds",
        "baseline_elapsed_seconds",
        "candidate_elapsed_seconds",
        "candidate_baseline_ratio",
        "paired_ratio_median",
        "paired_ratio_mad",
        "generated_c_bytes",
        "generated_c_sha256",
        "elapsed_seconds",
        "elapsed_mad_seconds",
        "peak_rss_bytes",
        "physical_footprint_bytes",
        "malloc_small_bytes",
        "allocation_count",
        "verified",
    )
    fields = [f"{name}={metrics[name]}" for name in ordered_names if name in metrics]
    print("PERCEUS_MEMORY_BENCH " + " ".join(fields))


def run_measurement(
    root: Path,
    bridge: Path,
    request_path: Path,
    temp_dir: Path,
    sample_index: str | int,
    sample_vmmap: bool,
    timeout_seconds: float,
) -> tuple[JsonObject, Path]:
    response_path = temp_dir / f"response-{sample_index}.json"
    stderr_path = temp_dir / f"bridge-{sample_index}.stderr"
    metrics_path = temp_dir / f"metrics-{sample_index}.json"
    worker_command = [
        sys.executable,
        str(Path(__file__).resolve()),
        WORKER_FLAG,
        str(bridge),
        str(request_path),
        str(response_path),
        str(stderr_path),
        str(metrics_path),
        str(timeout_seconds),
        "1" if sample_vmmap else "0",
    ]
    worker = subprocess.Popen(worker_command, cwd=root)
    try:
        worker_return_code = worker.wait(
            timeout=timeout_seconds + SUPERVISOR_GRACE_SECONDS,
        )
    except subprocess.TimeoutExpired as error:
        worker.terminate()
        try:
            worker.wait(timeout=SUPERVISOR_GRACE_SECONDS)
        except subprocess.TimeoutExpired:
            worker.kill()
            worker.wait()
        raise RuntimeError("benchmark measurement supervisor timed out") from error
    if worker_return_code != 0 or not metrics_path.is_file():
        raise RuntimeError("benchmark measurement worker failed")

    metrics = json.loads(metrics_path.read_text(encoding="utf-8"))
    if metrics.get("timed_out") is True:
        raise RuntimeError(
            f"backend benchmark worker exceeded {timeout_seconds:g} seconds"
        )
    if metrics["exit_code"] != 0:
        stderr = stderr_path.read_text(encoding="utf-8", errors="replace").strip()
        raise RuntimeError(
            f"backend benchmark worker exited with {metrics['exit_code']}: {stderr}"
        )
    del metrics["exit_code"]
    del metrics["timed_out"]
    return metrics, response_path


def paired_sample_order(sample_index: int) -> tuple[str, str]:
    if sample_index % 2 == 0:
        return "baseline", "candidate"
    return "candidate", "baseline"


def median_and_mad(samples: list[float]) -> tuple[float, float]:
    median = statistics.median(samples)
    return median, statistics.median(abs(value - median) for value in samples)


def summarize_paired_elapsed(
    baseline_samples: list[float],
    candidate_samples: list[float],
) -> JsonObject:
    baseline_median, baseline_mad = median_and_mad(baseline_samples)
    candidate_median, candidate_mad = median_and_mad(candidate_samples)
    ratios = [
        candidate / baseline
        for baseline, candidate in zip(baseline_samples, candidate_samples, strict=True)
    ]
    ratio_median, ratio_mad = median_and_mad(ratios)
    return {
        "baseline_elapsed_seconds": baseline_median,
        "baseline_elapsed_mad_seconds": baseline_mad,
        "baseline_elapsed_samples_seconds": baseline_samples,
        "candidate_elapsed_seconds": candidate_median,
        "candidate_elapsed_mad_seconds": candidate_mad,
        "candidate_elapsed_samples_seconds": candidate_samples,
        "candidate_baseline_ratio": candidate_median / baseline_median,
        "paired_ratio_median": ratio_median,
        "paired_ratio_mad": ratio_mad,
        "paired_ratios": ratios,
    }


def run_benchmark(args: argparse.Namespace) -> int:
    root = project_root()
    with tempfile.TemporaryDirectory(prefix="blorp-perceus-memory-") as temp_name:
        temp_dir = Path(temp_name)
        bridge_dir = temp_dir / "bridge"
        bridge_dir.mkdir()
        bridge = prepare_backend_worker(root, bridge_dir, args.bridge)
        candidate_worker_sha256 = file_sha256(bridge)
        control_parameter_type = getattr(args, "control_parameter_type", None)
        baseline_bridge: Path | None = None
        baseline_worker_sha256: str | None = None
        if control_parameter_type is not None:
            baseline_bridge = bridge
            baseline_worker_sha256 = candidate_worker_sha256
        elif args.baseline_bridge is not None:
            baseline_dir = temp_dir / "baseline-bridge"
            baseline_dir.mkdir()
            baseline_bridge = prepare_backend_worker(
                root,
                baseline_dir,
                args.baseline_bridge,
            )
            baseline_worker_sha256 = file_sha256(baseline_bridge)

        action = END_TO_END_ACTION if args.end_to_end else PERCEUS_ACTION
        request, core_program = fixture_request(
            args.globals,
            args.functions,
            args.body_leaves,
            args.global_reads_per_function,
            action,
            args.params_per_function,
            args.parameter_type,
            args.invoke_workers,
        )
        request_path = temp_dir / "request.json"
        request_path.write_text(
            json.dumps(request, separators=(",", ":")),
            encoding="utf-8",
        )
        baseline_request_path = request_path
        baseline_parameter_type = args.parameter_type
        artifacts_must_match = True
        if control_parameter_type is not None:
            control_request, _ = fixture_request(
                args.globals,
                args.functions,
                args.body_leaves,
                args.global_reads_per_function,
                action,
                args.params_per_function,
                control_parameter_type,
                args.invoke_workers,
            )
            baseline_request_path = temp_dir / "control-request.json"
            baseline_request_path.write_text(
                json.dumps(control_request, separators=(",", ":")),
                encoding="utf-8",
            )
            baseline_parameter_type = control_parameter_type
            artifacts_must_match = False

        if args.warmup:
            _, warmup_response = run_measurement(
                root, bridge, request_path, temp_dir, "candidate-warmup", False, args.timeout
            )
            validate_response(
                warmup_response,
                args.globals,
                args.functions,
                action,
                args.params_per_function,
                args.parameter_type,
            )
            if baseline_bridge is not None:
                _, baseline_warmup_response = run_measurement(
                    root,
                    baseline_bridge,
                    baseline_request_path,
                    temp_dir,
                    "baseline-warmup",
                    False,
                    args.timeout,
                )
                validate_response(
                    baseline_warmup_response,
                    args.globals,
                    args.functions,
                    action,
                    args.params_per_function,
                    baseline_parameter_type,
                )

        samples_by_worker: dict[str, list[JsonObject]] = {
            "candidate": [],
            "baseline": [],
        }
        artifact_bytes = 0
        artifact_sha256 = ""
        response_bytes = 0
        artifact_by_worker: dict[str, tuple[int, str]] = {}
        for sample_index in range(args.samples):
            workers: dict[str, tuple[Path, Path, str]] = {
                "candidate": (bridge, request_path, args.parameter_type)
            }
            order = ("candidate",)
            if baseline_bridge is not None:
                workers["baseline"] = (
                    baseline_bridge,
                    baseline_request_path,
                    baseline_parameter_type,
                )
                order = paired_sample_order(sample_index)
            for worker_name in order:
                worker_bridge, worker_request, worker_parameter_type = workers[worker_name]
                sample, response_path = run_measurement(
                    root,
                    worker_bridge,
                    worker_request,
                    temp_dir,
                    f"{sample_index}-{worker_name}",
                    args.vmmap,
                    args.timeout,
                )
                current_bytes, current_sha256 = validate_response(
                    response_path,
                    args.globals,
                    args.functions,
                    action,
                    args.params_per_function,
                    worker_parameter_type,
                )
                previous_artifact = artifact_by_worker.get(worker_name)
                if previous_artifact is not None and current_sha256 != previous_artifact[1]:
                    raise RuntimeError(
                        "Perceus benchmark output differs between samples"
                    )
                artifact_by_worker[worker_name] = (current_bytes, current_sha256)
                if (
                    artifacts_must_match
                    and len(artifact_by_worker) == 2
                    and artifact_by_worker["candidate"][1] != artifact_by_worker["baseline"][1]
                ):
                    raise RuntimeError("Perceus benchmark output differs between workers")
                if worker_name == "candidate":
                    artifact_bytes = current_bytes
                    artifact_sha256 = current_sha256
                    response_bytes = response_path.stat().st_size
                samples_by_worker[worker_name].append(sample)

        candidate_samples = samples_by_worker["candidate"]
        elapsed_samples = [
            float(sample["elapsed_seconds"]) for sample in candidate_samples
        ]
        median_elapsed, elapsed_mad = median_and_mad(elapsed_samples)
        metrics: JsonObject = {
            "elapsed_seconds": median_elapsed,
            "elapsed_mad_seconds": elapsed_mad,
            "elapsed_samples_seconds": elapsed_samples,
            "peak_rss_bytes": max(
                int(sample["peak_rss_bytes"])
                for sample in candidate_samples
                if "peak_rss_bytes" in sample
            ) if any("peak_rss_bytes" in sample for sample in candidate_samples) else 0,
            "samples": args.samples,
            "warmup": args.warmup,
        }
        for metric_name in (
            "physical_footprint_bytes",
            "malloc_small_bytes",
            "allocation_count",
        ):
            values = [
                int(sample[metric_name])
                for sample in candidate_samples
                if metric_name in sample
            ]
            if values:
                metrics[metric_name] = max(values)
                metrics[f"{metric_name}_samples"] = values
        if baseline_bridge is not None:
            metrics.update(
                summarize_paired_elapsed(
                    [
                        float(sample["elapsed_seconds"])
                        for sample in samples_by_worker["baseline"]
                    ],
                    elapsed_samples,
                )
            )
            baseline_samples = samples_by_worker["baseline"]
            for metric_name in (
                "peak_rss_bytes",
                "physical_footprint_bytes",
                "malloc_small_bytes",
                "allocation_count",
            ):
                values = [
                    int(sample[metric_name])
                    for sample in baseline_samples
                    if metric_name in sample
                ]
                if values:
                    metrics[f"baseline_{metric_name}"] = max(values)
                    metrics[f"baseline_{metric_name}_samples"] = values
                    candidate_value = metrics.get(metric_name)
                    if isinstance(candidate_value, int) and max(values) > 0:
                        metrics[f"candidate_baseline_{metric_name}_ratio"] = (
                            candidate_value / max(values)
                        )
            metrics["baseline_worker_sha256"] = baseline_worker_sha256
            baseline_artifact = artifact_by_worker["baseline"]
            metrics["baseline_artifact_bytes"] = baseline_artifact[0]
            metrics["baseline_artifact_sha256"] = baseline_artifact[1]
            metrics["baseline_parameter_type"] = baseline_parameter_type
            metrics["baseline_request_bytes"] = baseline_request_path.stat().st_size
            metrics["baseline_request_sha256"] = file_sha256(baseline_request_path)
            metrics["comparison_kind"] = (
                "parameter-control"
                if control_parameter_type is not None
                else "compiler-worker"
            )
            metrics["execution_order"] = [
                list(paired_sample_order(index)) for index in range(args.samples)
            ]
        metrics.update(
            {
                "fixture_version": FIXTURE_VERSION,
                "action": action,
                "globals": args.globals,
                "functions": args.functions,
                "body_leaves": args.body_leaves,
                "global_reads_per_function": args.global_reads_per_function,
                "params_per_function": args.params_per_function,
                "parameter_type": args.parameter_type,
                "invoke_workers": args.invoke_workers,
                "declarations": len(core_program["decls"]),
                "input_expression_nodes": input_expression_count(
                    args.globals,
                    args.functions,
                    args.body_leaves,
                    args.params_per_function,
                    args.invoke_workers,
                ),
                "request_bytes": request_path.stat().st_size,
                "request_sha256": file_sha256(request_path),
                "worker_sha256": candidate_worker_sha256,
                "timeout_seconds": args.timeout,
                "memory_limit_bytes": None,
                "response_bytes": response_bytes,
                "artifact_bytes": artifact_bytes,
                "artifact_sha256": artifact_sha256,
                "platform": platform.platform(),
                "compiler_revision": git_output(root, "rev-parse", "HEAD"),
                "working_tree_dirty": bool(git_output(root, "status", "--porcelain")),
                "harness_sha256": file_sha256(Path(__file__).resolve()),
                "build_mode": args.build_mode,
                "c_compiler": os.environ.get("CC", "cc"),
                "verified": True,
            }
        )
        if file_sha256(bridge) != candidate_worker_sha256:
            raise RuntimeError("candidate benchmark worker changed during measurement")
        if baseline_bridge is not None and file_sha256(baseline_bridge) != baseline_worker_sha256:
            raise RuntimeError("baseline benchmark worker changed during measurement")
        if action == END_TO_END_ACTION:
            metrics["generated_c_bytes"] = artifact_bytes
            metrics["generated_c_sha256"] = artifact_sha256
        print_metrics(metrics, args.json)
    return 0


def run_global_matrix(args: argparse.Namespace) -> int:
    root = project_root()
    with tempfile.TemporaryDirectory(prefix="blorp-perceus-matrix-worker-") as temp_name:
        worker_dir = Path(temp_name)
        bridge = prepare_backend_worker(root, worker_dir, args.bridge)

        for global_count, global_reads in ((32, 0), (32, 32), (384, 0), (384, 32)):
            point = argparse.Namespace(**vars(args))
            point.bridge = str(bridge)
            point.globals = global_count
            point.global_reads_per_function = global_reads
            point.params_per_function = 0
            point.parameter_type = MANAGED_PARAMETER_TYPE
            point.invoke_workers = True
            point.global_matrix = False
            point.parameter_matrix = False
            run_benchmark(point)

    return 0


def run_parameter_matrix(args: argparse.Namespace) -> int:
    root = project_root()
    with tempfile.TemporaryDirectory(prefix="blorp-perceus-param-matrix-worker-") as temp_name:
        worker_dir = Path(temp_name)
        bridge = prepare_backend_worker(root, worker_dir, args.bridge)

        for param_count in (1, 8, 32):
            point = argparse.Namespace(**vars(args))
            point.bridge = str(bridge)
            point.globals = 1
            point.functions = PARAMETER_MATRIX_FUNCTIONS
            point.body_leaves = PARAMETER_MATRIX_BODY_LEAVES
            point.global_reads_per_function = 0
            point.params_per_function = param_count
            point.parameter_type = MANAGED_PARAMETER_TYPE
            point.control_parameter_type = (
                None
                if args.baseline_bridge is not None
                else PRIMITIVE_PARAMETER_TYPE
            )
            point.invoke_workers = False
            point.global_matrix = False
            point.parameter_matrix = False
            run_benchmark(point)

    return 0


def main(argv: list[str]) -> int:
    if argv and argv[0] == WORKER_FLAG:
        return measurement_worker(argv[1:])

    parser = argparse.ArgumentParser(
        description=(
            "Measure the isolated production Perceus stage with many managed globals "
            "and moderately sized function bodies containing resolved global reads."
        )
    )
    parser.add_argument("--globals", type=positive_int, default=DEFAULT_GLOBALS)
    parser.add_argument("--functions", type=positive_int, default=DEFAULT_FUNCTIONS)
    parser.add_argument("--body-leaves", type=positive_int, default=DEFAULT_BODY_LEAVES)
    parser.add_argument(
        "--global-reads-per-function",
        type=nonnegative_int,
        default=DEFAULT_GLOBAL_READS_PER_FUNCTION,
    )
    parser.add_argument(
        "--params-per-function",
        type=nonnegative_int,
        default=DEFAULT_PARAMS_PER_FUNCTION,
    )
    parser.add_argument(
        "--parameter-type",
        choices=(PRIMITIVE_PARAMETER_TYPE, MANAGED_PARAMETER_TYPE),
        default=MANAGED_PARAMETER_TYPE,
        help="parameter type for a single fixture; the parameter matrix runs both",
    )
    parser.add_argument(
        "--bridge",
        help=f"backend benchmark worker; defaults to ${BACKEND_WORKER_ENV} or builds one",
    )
    parser.add_argument(
        "--baseline-bridge",
        help="explicit baseline worker for paired, alternating comparison",
    )
    parser.add_argument(
        "--end-to-end",
        action="store_true",
        help="continue through C emission instead of stopping after Perceus",
    )
    parser.add_argument(
        "--samples",
        type=positive_int,
        default=1,
        help="number of measured worker processes to run",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT_SECONDS,
        help="maximum seconds for each worker process",
    )
    parser.add_argument(
        "--global-matrix",
        action="store_true",
        help="run the 32/384 globals by 0/32 reads matrix with one worker build",
    )
    parser.add_argument(
        "--parameter-matrix",
        action="store_true",
        help=(
            "run primitive and managed 1/8/32 parameter controls with a fixed "
            "two-function, 128-leaf fixture"
        ),
    )
    parser.add_argument(
        "--no-warmup",
        action="store_false",
        dest="warmup",
        help="skip the unmeasured warmup process",
    )
    parser.set_defaults(warmup=True)
    parser.set_defaults(invoke_workers=True)
    parser.add_argument(
        "--vmmap",
        action="store_true",
        help="sample macOS vmmap allocator and physical-footprint metrics",
    )
    parser.add_argument("--json", action="store_true", help="print metrics as JSON")
    args = parser.parse_args(argv)
    args.build_mode = (
        "explicit-worker"
        if args.bridge is not None or os.environ.get(BACKEND_WORKER_ENV)
        else "benchmark-worker-O0"
    )

    if args.global_matrix:
        if 32 >= args.body_leaves:
            parser.error("--global-matrix requires --body-leaves greater than 32")
    elif not args.parameter_matrix:
        if args.global_reads_per_function >= args.body_leaves:
            parser.error("--global-reads-per-function must be less than --body-leaves")
        if args.global_reads_per_function + args.params_per_function >= args.body_leaves:
            parser.error(
                "global reads plus parameters must be less than --body-leaves"
            )
        if args.global_reads_per_function > args.globals:
            parser.error("--global-reads-per-function cannot exceed --globals")
    if args.timeout <= 0:
        parser.error("--timeout must be greater than zero")
    if args.baseline_bridge is not None and args.samples < 7:
        parser.error("paired comparison requires at least 7 samples")
    if args.global_matrix and args.parameter_matrix:
        parser.error("--global-matrix and --parameter-matrix are mutually exclusive")
    if args.parameter_matrix and args.end_to_end:
        parser.error("--parameter-matrix cannot be combined with --end-to-end")

    if args.vmmap and (platform.system() != "Darwin" or shutil.which("vmmap") is None):
        parser.error("--vmmap requires macOS vmmap")

    try:
        if args.global_matrix:
            return run_global_matrix(args)
        if args.parameter_matrix:
            return run_parameter_matrix(args)
        return run_benchmark(args)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
