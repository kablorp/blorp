def worker_decl(
    index: int,
    def_id: int,
    body_leaves: int,
    global_reads_per_function: int,
    params_per_function: int,
    parameter_type: str,
    body_shape: str,
    function_count: int,
    first_function_id: int,
    user_call_edges: int,
    branch_arms: int,
) -> JsonObject:
    if body_shape == "borrowed_boundary_fusion":
        return user_function(
            f"bench_worker_{index:04d}",
            def_id,
            borrowed_boundary_fusion_body(index, branch_arms, body_leaves),
            [
                core_param_with_type(
                    borrowed_param_name(index, param_index),
                    heap_record_type(BORROWED_OWNER_TYPE_NAME),
                )
                for param_index in range(params_per_function)
            ],
            MANAGED_PARAMETER_TYPE,
        )

    if body_shape == "mixed_function_owner_catalog":
        return user_function(
            f"bench_worker_{index:04d}",
            def_id,
            mixed_function_owner_catalog_body(
                index,
                params_per_function,
                global_reads_per_function,
                body_leaves,
            ),
            [
                core_param_with_type(
                    borrowed_param_name(index, param_index),
                    heap_record_type(BORROWED_OWNER_TYPE_NAME),
                )
                for param_index in range(params_per_function)
            ],
            MANAGED_PARAMETER_TYPE,
        )

    if body_shape == "referenced_global_boundary":
        return user_function(
            f"bench_worker_{index:04d}",
            def_id,
            referenced_global_boundary_body(index, global_reads_per_function, body_leaves),
            [],
            MANAGED_PARAMETER_TYPE,
        )

    if body_shape == "lambda_borrowed_boundary":
        managed_local_name = f"BENCH_MANAGED_LOCAL_{index:04d}"
        body = {
            "kind": "let",
            "name": core_var(managed_local_name, None),
            "mutable": False,
            "type": named_type(MANAGED_PARAMETER_TYPE),
            "rhs": literal_expr(
                "string",
                f"managed-lambda-{index:04d}",
                MANAGED_PARAMETER_TYPE,
            ),
            "body": lambda_borrowed_boundary_expr(
                index,
                params_per_function,
                body_leaves,
            ),
        }
        return user_function(
            f"bench_worker_{index:04d}",
            def_id,
            body,
            [],
            "Function",
        )

    if body_shape == "borrowed_return":
        if params_per_function == 0:
            raise ValueError("borrowed return requires parameters")
        body_tail = padded_result_sequence(
            borrowed_result_tree(index),
            body_leaves - CONTRACT_FIXTURE_LET_NODES,
        )
        managed_local_name = f"BENCH_MANAGED_LOCAL_{index:04d}"
        body = {
            "kind": "let",
            "name": core_var(managed_local_name, None),
            "mutable": False,
            "type": named_type("String"),
            "rhs": literal_expr("string", f"managed-{index:04d}", "String"),
            "body": body_tail,
        }
        params = [
            core_param(
                borrowed_param_name(index, param_index),
                MANAGED_PARAMETER_TYPE,
            )
            for param_index in range(params_per_function)
        ]
        return user_function(
            f"bench_worker_{index:04d}",
            def_id,
            body,
            params,
            MANAGED_PARAMETER_TYPE,
        )

    direct_parameter_reads = (
        body_shape == "linear"
        or (body_shape == "nested_user_call" and index == function_count - 1)
        or (body_shape == "mutually_recursive_calls" and index == 0)
    )
    expressions = [
        global_ref_expr(global_index)
        for global_index in range(global_reads_per_function)
    ]
    if direct_parameter_reads:
        expressions.extend(
            (
                borrowed_param_ref_expr(index, param_index, parameter_type)
                if body_shape == "linear"
                else consuming_parameter_expr(index, param_index, parameter_type)
            )
            for param_index in range(params_per_function)
        )
    if body_shape == "borrowed_call_protection":
        if params_per_function == 0:
            raise ValueError("borrowed-call protection requires parameters")
        expressions.append(consuming_borrowed_projection_expr(index, parameter_type))
    elif body_shape == "aggregate_escape":
        if params_per_function == 0:
            raise ValueError("aggregate escape requires parameters")
        expressions.extend(
            borrowed_aggregate_escape_expr(index)
            for _ in range(AGGREGATE_ESCAPE_SITES_PER_FUNCTION)
        )
        # The fixed 128-node workload has even cardinality. Include one fully
        # traversable even-sized expression so padded_sequence does not need
        # to wrap the whole body in an opaque CastExpr merely to fix parity.
        expressions.append({
            "kind": "if",
            "cond": literal_expr("bool", True, "Bool"),
            "then": literal_expr("int", 0, "Int"),
            "else": literal_expr("int", 0, "Int"),
            "type": named_type("Int"),
            "loc": synthetic_loc(),
        })
    if body_shape == "nested_user_call":
        if index < function_count - 1:
            calls = [
                call_worker_with_borrowed_params_expr(
                    index,
                    target_index,
                    first_function_id + target_index,
                    params_per_function,
                    parameter_type,
                )
                for target_index in range(
                    index + 1,
                    min(function_count, index + 1 + user_call_edges),
                )
            ]
            expressions = [*calls, *expressions]
    elif body_shape == "mutually_recursive_calls" and function_count > 1:
        calls = []
        for edge_index in range(user_call_edges):
            target_index = (index + edge_index + 1) % function_count
            calls.append(
                call_worker_with_borrowed_params_expr(
                    index,
                    target_index,
                    first_function_id + target_index,
                    params_per_function,
                    parameter_type,
                )
            )
        expressions = [*calls, *expressions]
    elif body_shape not in ("linear", "borrowed_call_protection", "aggregate_escape"):
        raise ValueError(f"unsupported Perceus body shape: {body_shape}")
    if body_shape == "linear":
        literal_count = body_leaves - global_reads_per_function - params_per_function
        expressions.extend(
            literal_expr("int", leaf, "Int") for leaf in range(literal_count)
        )
        body_tail = seq_expr(expressions)
    else:
        expressions.append(literal_expr("int", 0, "Int"))
        body_tail = padded_sequence(
            expressions,
            body_leaves - CONTRACT_FIXTURE_LET_NODES,
        )
    managed_local_name = f"BENCH_MANAGED_LOCAL_{index:04d}"
    body = {
        "kind": "let",
        "name": core_var(managed_local_name, None),
        "mutable": False,
        "type": named_type("String"),
        "rhs": literal_expr("string", f"managed-{index:04d}", "String"),
        "body": body_tail,
    }
    params = [
        (
            core_param_with_type(
                borrowed_param_name(index, param_index),
                heap_record_type(BORROWED_OWNER_TYPE_NAME),
            )
            if body_shape in ("borrowed_call_protection", "aggregate_escape")
            else core_param(borrowed_param_name(index, param_index), parameter_type)
        )
        for param_index in range(params_per_function)
    ]
    return user_function(f"bench_worker_{index:04d}", def_id, body, params)


def call_worker_expr(
    index: int,
    def_id: int,
    params_per_function: int,
    parameter_type: str,
    body_shape: str = "linear",
) -> JsonObject:
    name = f"bench_worker_{index:04d}"
    function_type = named_type("Function")
    return {
        "kind": "call",
        "call_kind": {"kind": "selected_direct", "def_id": def_id},
        "callee": {
            "kind": "var",
            "var": core_var(name, def_id),
            "type": function_type,
            "loc": synthetic_loc(),
        },
        "args": [] if body_shape == "lambda_borrowed_boundary" else [
            (
                borrowed_owner_argument_expr(param_index)
                if body_shape in ("borrowed_call_protection", "aggregate_escape")
                else parameter_argument_expr(param_index, parameter_type)
            )
            for param_index in range(params_per_function)
        ],
        "type": named_type(
            "Function"
            if body_shape == "lambda_borrowed_boundary"
            else (
                MANAGED_PARAMETER_TYPE
                if body_shape in ("borrowed_return", "referenced_global_boundary")
                else "Int"
            )
        ),
        "loc": synthetic_loc(),
    }


def call_worker_with_borrowed_params_expr(
    caller_index: int,
    target_index: int,
    target_def_id: int,
    params_per_function: int,
    parameter_type: str,
) -> JsonObject:
    call = call_worker_expr(
        target_index,
        target_def_id,
        params_per_function,
        parameter_type,
    )
    call["call_kind"] = {
        "kind": "user",
        "name": f"bench_worker_{target_index:04d}",
        "def_id": target_def_id,
        "consumed_args": [],
    }
    call["args"] = [
        borrowed_param_ref_expr(caller_index, param_index, parameter_type)
        for param_index in range(params_per_function)
    ]
    return call


def fixture_request(
    global_count: int,
    function_count: int,
    body_leaves: int,
    global_reads_per_function: int,
    action: str = PERCEUS_ACTION,
    params_per_function: int = DEFAULT_PARAMS_PER_FUNCTION,
    parameter_type: str = MANAGED_PARAMETER_TYPE,
    invoke_workers: bool = True,
    body_shape: str = "linear",
    branch_arms: int = 2,
    user_call_edges: int = 1,
) -> tuple[JsonObject, JsonObject]:
    if body_shape not in BODY_SHAPES:
        raise ValueError(f"unsupported Perceus body shape: {body_shape}")
    globals_json = [global_decl(index) for index in range(global_count)]
    type_decls = (
        [borrowed_owner_decl()]
        if body_shape in (
            "borrowed_call_protection",
            "aggregate_escape",
            "referenced_global_boundary",
            "mixed_function_owner_catalog",
            "borrowed_boundary_fusion",
            "lambda_borrowed_boundary",
        )
        else []
    )
    first_function_id = global_count + 1
    functions_json = [
        worker_decl(
            index,
            first_function_id + index,
            body_leaves,
            global_reads_per_function,
            params_per_function,
            parameter_type,
            body_shape,
            function_count,
            first_function_id,
            user_call_edges,
            branch_arms,
        )
        for index in range(function_count)
    ]
    if body_shape == "borrowed_boundary_fusion":
        expected_census = {
            "call_slots": BORROWED_BOUNDARY_FUSION_SLOTS_PER_FAMILY,
            "active_calls": branch_arms,
            "storage_slots": BORROWED_BOUNDARY_FUSION_SLOTS_PER_FAMILY,
            "active_storage": branch_arms,
            "result_slots": BORROWED_BOUNDARY_FUSION_SLOTS_PER_FAMILY,
            "active_results": branch_arms,
            "distinct_globals": BORROWED_BOUNDARY_FUSION_GLOBALS,
            "nested_lambdas": 0,
            "literal_matches": 1,
            "resource_scopes": 1,
            "opaque_padding_nodes": 0,
        }
        for function in functions_json:
            body = function.get("body")
            if expression_node_count(body) != body_leaves:
                raise RuntimeError("borrowed-boundary fusion body node count changed")
            if borrowed_boundary_fusion_census(body) != expected_census:
                raise RuntimeError("borrowed-boundary fusion census changed")
    elif body_shape == "mixed_function_owner_catalog":
        for function in functions_json:
            body = function.get("body")
            if expression_node_count(body) != body_leaves:
                raise RuntimeError("mixed function owner body node count changed")
            parameter_sites_per_family = (
                MIXED_FUNCTION_OWNER_BOUNDARY_SITES_PER_FAMILY
                - global_reads_per_function
            )
            expected_census = {
                "consuming_calls": MIXED_FUNCTION_OWNER_BOUNDARY_SITES_PER_FAMILY,
                "aggregate_transfers": MIXED_FUNCTION_OWNER_BOUNDARY_SITES_PER_FAMILY,
                "result_terminals": MIXED_FUNCTION_OWNER_BOUNDARY_SITES_PER_FAMILY,
                "parameter_reference_sites": 3 * parameter_sites_per_family,
                "global_reference_sites": 3 * global_reads_per_function,
                "distinct_parameters": min(params_per_function, parameter_sites_per_family),
                "distinct_globals": global_reads_per_function,
                "nested_lambdas": 0,
            }
            if mixed_function_owner_census(body) != expected_census:
                raise RuntimeError("mixed function owner boundary census changed")
    elif body_shape == "referenced_global_boundary":
        for function in functions_json:
            body = function.get("body")
            if expression_node_count(body) != body_leaves:
                raise RuntimeError("referenced-global worker body node count changed")
            expected_census = {
                "consuming_calls": REFERENCED_GLOBAL_CALL_SITES_PER_FUNCTION,
                "aggregate_transfers": REFERENCED_GLOBAL_AGGREGATE_SITES_PER_FUNCTION,
                "result_terminals": REFERENCED_GLOBAL_RESULT_SITES_PER_FUNCTION,
                "reference_sites": REFERENCED_GLOBAL_SITES_PER_FUNCTION,
                "distinct_global_indices": global_reads_per_function,
            }
            if referenced_global_boundary_census(body) != expected_census:
                raise RuntimeError("referenced-global boundary site census changed")
    elif body_shape == "lambda_borrowed_boundary":
        for function in functions_json:
            outer = function.get("body", {}).get("body")
            if not isinstance(outer, dict) or outer.get("kind") != "lambda":
                raise RuntimeError("lambda-boundary worker is missing its outer lambda")
            lambda_body = outer.get("body")
            if expression_node_count(lambda_body) != body_leaves:
                raise RuntimeError("lambda-boundary body node count changed")
            expected_census = {
                "consuming_calls": LAMBDA_CALL_SITES_PER_FUNCTION,
                "aggregate_transfers": LAMBDA_AGGREGATE_SITES_PER_FUNCTION,
                "result_terminals": LAMBDA_RESULT_SITES_PER_FUNCTION,
                "owner_reads": (
                    LAMBDA_CALL_SITES_PER_FUNCTION
                    + LAMBDA_AGGREGATE_SITES_PER_FUNCTION
                    + LAMBDA_RESULT_SITES_PER_FUNCTION
                ),
                "distinct_owners": params_per_function,
                "nested_lambdas": 1,
            }
            if lambda_boundary_census(lambda_body) != expected_census:
                raise RuntimeError("lambda borrowed-boundary site census changed")
    main_expressions = []
    if invoke_workers:
        main_expressions = [
            call_worker_expr(
                index,
                first_function_id + index,
                params_per_function,
                parameter_type,
                body_shape,
            )
            for index in range(function_count)
        ]
    main_expressions.append(literal_expr("int", 0, "Int"))
    main_json = user_function(
        "main",
        first_function_id + function_count,
        seq_expr(main_expressions),
    )
    core_program = {
        "kind": "program",
        "decls": [*globals_json, *type_decls, *functions_json, main_json],
        "foreign_includes": [],
    }
    request = {
        "schema": 1,
        "domain": "compiler",
        "action": action,
        "payload": {"core": core_program, "profile": False},
    }
    return request, core_program


def input_expression_count(
    global_count: int,
    function_count: int,
    body_leaves: int,
    params_per_function: int = DEFAULT_PARAMS_PER_FUNCTION,
    invoke_workers: bool = True,
) -> int:
    worker_nodes = function_count * ((2 * body_leaves) + 1)
    main_nodes = 1
    if invoke_workers:
        call_nodes = 3 + params_per_function
        main_nodes += function_count * call_nodes
    return global_count + worker_nodes + main_nodes


def parse_memory_bytes(value: str) -> int:
    match = re.fullmatch(r"([0-9]+(?:[.][0-9]+)?)([KMGTP]?)", value.strip())
    if match is None:
        raise ValueError(f"invalid memory value: {value}")
    number = float(match.group(1))
    suffix = match.group(2)
    multiplier = {
        "": 1,
        "K": 1024,
        "M": 1024**2,
        "G": 1024**3,
        "T": 1024**4,
        "P": 1024**5,
    }[suffix]
    return int(number * multiplier)


def vmmap_metrics(pid: int, timeout_seconds: float) -> JsonObject:
    try:
        result = subprocess.run(
            ["vmmap", "-summary", str(pid)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired:
        return {}
    if result.returncode != 0:
        return {}

    metrics: JsonObject = {}
    physical = re.search(r"^Physical footprint:\s+([0-9.]+[KMGTP]?)", result.stdout, re.M)
    if physical is not None:
        metrics["physical_footprint_bytes"] = parse_memory_bytes(physical.group(1))

    malloc_small = re.search(
        r"^\s*MALLOC_SMALL\b[^\n]*?([0-9.]+[KMGTP])\b",
        result.stdout,
        re.M,
    )
    if malloc_small is not None:
        metrics["malloc_small_bytes"] = parse_memory_bytes(malloc_small.group(1))

    allocation_counts = re.findall(r"([0-9][0-9,]*) allocations", result.stdout)
    zone_rows = re.findall(
        r"^DefaultMallocZone_\S+\s+\S+\s+\S+\s+\S+\s+\S+\s+([0-9,]+)\s+",
        result.stdout,
        re.M,
    )
    allocation_counts.extend(zone_rows)
    if allocation_counts:
        metrics["allocation_count"] = max(
            int(value.replace(",", "")) for value in allocation_counts
        )
    return metrics


def merge_max_metrics(current: JsonObject, sample: JsonObject) -> JsonObject:
    result = dict(current)
    for name, value in sample.items():
        result[name] = max(int(result.get(name, 0)), int(value))
    return result


def normalized_max_rss_bytes() -> int:
    max_rss = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
    if platform.system() == "Darwin":
        return int(max_rss)
    return int(max_rss) * 1024


def process_group_exists(process_group_id: int) -> bool:
    try:
        os.killpg(process_group_id, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    process_group_id = process.pid
    try:
        os.killpg(process_group_id, signal.SIGTERM)
    except ProcessLookupError:
        process.wait()
        return

    deadline = time.perf_counter() + TERMINATE_GRACE_SECONDS
    while time.perf_counter() < deadline:
        process.poll()
        if not process_group_exists(process_group_id):
            break
        time.sleep(0.01)

    if process_group_exists(process_group_id):
        try:
            os.killpg(process_group_id, signal.SIGKILL)
        except (PermissionError, ProcessLookupError):
            pass
    process.wait()


def execute_measurement_worker(args: argparse.Namespace) -> int:
    vmmap_enabled = args.sample_vmmap == "1"
    vmmap_result: JsonObject = {}
    timed_out = False
    started = time.perf_counter()
    deadline = started + args.timeout_seconds
    with open(args.response, "wb") as stdout_file, open(args.stderr, "wb") as stderr_file:
        process = subprocess.Popen(
            [args.bridge, args.request],
            stdout=stdout_file,
            stderr=stderr_file,
            start_new_session=True,
        )
        try:
            while process.poll() is None:
                now = time.perf_counter()
                if now >= deadline:
                    timed_out = True
                    terminate_process_group(process)
                    break
                if vmmap_enabled:
                    vmmap_result = merge_max_metrics(
                        vmmap_result,
                        vmmap_metrics(
                            process.pid,
                            min(VMMAP_COMMAND_TIMEOUT_SECONDS, deadline - now),
                        ),
                    )
                now = time.perf_counter()
                if now < deadline:
                    time.sleep(min(VMAP_SAMPLE_SECONDS, deadline - now))
        finally:
            process.poll()
            if process_group_exists(process.pid):
                terminate_process_group(process)
        return_code = process.wait()

    metrics = {
        "elapsed_seconds": time.perf_counter() - started,
        "exit_code": return_code,
        "timed_out": timed_out,
        **vmmap_result,
    }
    if not vmmap_enabled:
        metrics["peak_rss_bytes"] = normalized_max_rss_bytes()
    Path(args.metrics).write_text(json.dumps(metrics), encoding="utf-8")
    return 0


def measurement_worker(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("bridge")
    parser.add_argument("request")
    parser.add_argument("response")
    parser.add_argument("stderr")
    parser.add_argument("metrics")
    parser.add_argument("timeout_seconds", type=float)
    parser.add_argument("sample_vmmap", choices=("0", "1"))
    args = parser.parse_args(argv)

    previous_sigint_handler = signal.getsignal(signal.SIGINT)
    previous_sigterm_handler = signal.getsignal(signal.SIGTERM)

    def interrupt_worker(_signum: int, _frame: Any) -> None:
        raise InterruptedError("Perceus measurement worker terminated")

    signal.signal(signal.SIGINT, interrupt_worker)
    signal.signal(signal.SIGTERM, interrupt_worker)
    try:
        return execute_measurement_worker(args)
    finally:
        signal.signal(signal.SIGINT, previous_sigint_handler)
        signal.signal(signal.SIGTERM, previous_sigterm_handler)


def positive_int(value: str) -> int:
    result = int(value)
    if result <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return result


def nonnegative_int(value: str) -> int:
    result = int(value)
    if result < 0:
        raise argparse.ArgumentTypeError("must be zero or greater")
    return result


