def borrowed_result_tree(function_index: int) -> JsonObject:
    results = [
        borrowed_param_ref_expr(function_index, 0, MANAGED_PARAMETER_TYPE)
        for _ in range(RESULT_ALIAS_TERMINALS_PER_FUNCTION)
    ]
    while len(results) > 1:
        if len(results) % 2 != 0:
            raise RuntimeError("borrowed-result terminal count must form a balanced tree")
        results = [
            {
                "kind": "if",
                "cond": literal_expr("bool", True, "Bool"),
                "then": results[index],
                "else": results[index + 1],
                "type": named_type(MANAGED_PARAMETER_TYPE),
                "loc": synthetic_loc(),
            }
            for index in range(0, len(results), 2)
        ]
    return results[0]


