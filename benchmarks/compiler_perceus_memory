    "literal", "var", "void", "debug_block", "cooperative_checkpoint",
    "call", "seq", "if", "binary", "unary", "logical", "assign", "cast",
    "box", "unbox", "field", "tuple_field", "tuple", "tuple_construct",
    "vector", "lambda", "closure_create", "list_construct", "list_alloc",
    "list_get", "list_handoff", "list_handoff_set_owned",
    "list_handoff_set_source_slot", "string_byte_read", "string_byte_write",
    "string_byte_copy", "string_set_len", "tensor_raw_read",
    "tensor_raw_write", "tensor_raw_view_let", "dict", "borrow_let",
    "tensor_literal", "tensor_boxed_literal", "tensor_packed_literal",
    "tensor_raw_fill", "dict_construct", "set_alloc", "list_retain",
    "list_set", "list_swap", "record", "record_update", "record_reuse",
    "record_cow_update", "record_construct", "union_construct",
    "union_reuse_construct", "detach", "drop", "dup", "let", "while",
    "break", "continue", "resource_scope", "resource_cleanup_exit",
