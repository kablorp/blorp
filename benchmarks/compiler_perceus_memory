def mixed_function_owner_census(value: Any) -> JsonObject:
    consuming_calls = 0
    aggregate_transfers = 0
    parameter_reference_sites = 0
    global_reference_sites = 0
    parameter_names: set[str] = set()
    global_indices: set[int] = set()
    nested_lambdas = 0

    pending = [value]
    while pending:
        current = pending.pop()
        if isinstance(current, dict):
            kind = current.get("kind")
            if kind == "lambda":
                nested_lambdas += 1
                continue
            if kind == "call":
                call_kind = current.get("call_kind")
                if (
                    isinstance(call_kind, dict)
                    and call_kind.get("kind") == "builtin"
                    and call_kind.get("name") == "blorp_string_concat_consume"
                ):
                    consuming_calls += 1
            elif (
                kind == "record_construct"
                and current.get("type_name") == BORROWED_OWNER_TYPE_NAME
            ):
                aggregate_transfers += 1
            elif kind == "var":
                variable = current.get("var")
                if isinstance(variable, dict):
                    name = variable.get("name")
                    def_id = variable.get("def_id")
                    if isinstance(name, str) and name.startswith("BENCH_BORROWED_PARAM_"):
                        parameter_reference_sites += 1
                        parameter_names.add(name)
                    elif (
                        isinstance(name, str)
                        and name.startswith("BENCH_UNUSED_GLOBAL_")
                        and isinstance(def_id, int)
                    ):
                        global_reference_sites += 1
                        global_indices.add(def_id - 1)
            pending.extend(current.values())
        elif isinstance(current, list):
            pending.extend(current)
    return {
        "consuming_calls": consuming_calls,
        "aggregate_transfers": aggregate_transfers,
        "result_terminals": (
            parameter_reference_sites
            + global_reference_sites
            - consuming_calls
            - aggregate_transfers
        ),
        "parameter_reference_sites": parameter_reference_sites,
        "global_reference_sites": global_reference_sites,
        "distinct_parameters": len(parameter_names),
        "distinct_globals": len(global_indices),
        "nested_lambdas": nested_lambdas,
    }


