    }


def synthetic_loc() -> JsonObject:
    return {"kind": "synthetic"}


def named_type(name: str) -> JsonObject:
    return {"kind": "named", "name": name, "args": []}


def core_var(name: str, def_id: int | None) -> JsonObject:
    return {"name": name, "uniq": 0, "def_id": def_id}


def literal_expr(kind: str, value: Any, type_name: str) -> JsonObject:
    return {
        "kind": "literal",
        "literal": {"kind": kind, "value": value},
        "type": named_type(type_name),
        "loc": synthetic_loc(),
    }


def seq_expr(expressions: list[JsonObject]) -> JsonObject:
    if not expressions:
        raise ValueError("a sequence requires at least one expression")

    result = expressions[-1]
    for expression in reversed(expressions[:-1]):
        result = {"kind": "seq", "first": expression, "second": result}
    return result


def expression_node_count(value: Any) -> int:
    if isinstance(value, dict):
        own = int(value.get("kind") in CORE_EXPR_KINDS)
        return own + sum(expression_node_count(child) for child in value.values())
    if isinstance(value, list):
        return sum(expression_node_count(child) for child in value)
    return 0


def padded_sequence(expressions: list[JsonObject], target_nodes: int) -> JsonObject:
    if not expressions:
        expressions = [literal_expr("int", 0, "Int")]
    result = seq_expr(expressions)
    current_nodes = expression_node_count(result)
    if current_nodes > target_nodes:
        raise ValueError(
            f"body workload needs {current_nodes} nodes but target is {target_nodes}"
        )
    while current_nodes + 2 <= target_nodes:
        expressions.append(literal_expr("int", current_nodes, "Int"))
        current_nodes += 2
    result = seq_expr(expressions)
    if current_nodes < target_nodes:
        result = {
            "kind": "cast",
            "expr": result,
            "type": named_type("Int"),
            "loc": synthetic_loc(),
        }
    if expression_node_count(result) != target_nodes:
        raise RuntimeError("failed to construct exact Perceus body node target")
    return result


def global_decl(index: int) -> JsonObject:
    def_id = index + 1
    name = f"BENCH_UNUSED_GLOBAL_{index:04d}"
    return {
        "kind": "global",
        "name": core_var(name, def_id),
        "source_module": None,
        "type": named_type("String"),
        "init": literal_expr("string", f"global-{index:04d}", "String"),
        "mutable": False,
        "const": True,
        "private": False,
        "def_id": def_id,
        "loc": synthetic_loc(),
    }


def core_param(name: str, type_name: str) -> JsonObject:
    return {
        "name": core_var(name, None),
        "type": named_type(type_name),
        "loc": synthetic_loc(),
    }


def user_function(
    name: str,
    def_id: int,
    body: JsonObject,
    params: list[JsonObject] | None = None,
) -> JsonObject:
    return {
        "kind": "function",
        "name": name,
        "module": None,
        "type_params": [],
        "params": params if params is not None else [],
        "return_type": named_type("Int"),
        "body": body,
        "pure": True,
        "function_kind": {"kind": "user"},
        "def_id": def_id,
        "loc": synthetic_loc(),
    }


def global_ref_expr(index: int) -> JsonObject:
    return {
        "kind": "var",
        "var": core_var(f"BENCH_UNUSED_GLOBAL_{index:04d}", index + 1),
        "type": named_type("String"),
        "loc": synthetic_loc(),
    }


def borrowed_param_name(function_index: int, param_index: int) -> str:
    return f"BENCH_BORROWED_PARAM_{function_index:04d}_{param_index:04d}"


def borrowed_param_ref_expr(
    function_index: int,
    param_index: int,
    type_name: str,
) -> JsonObject:
    return {
        "kind": "var",
        "var": core_var(borrowed_param_name(function_index, param_index), None),
        "type": named_type(type_name),
        "loc": synthetic_loc(),
    }


def parameter_argument_expr(param_index: int, parameter_type: str) -> JsonObject:
    if parameter_type == MANAGED_PARAMETER_TYPE:
        return literal_expr(
            "string",
            f"argument-{param_index:04d}",
            parameter_type,
        )
    return literal_expr("int", param_index, parameter_type)


def consuming_parameter_expr(
    function_index: int,
    param_index: int,
    parameter_type: str,
) -> JsonObject:
    if parameter_type != MANAGED_PARAMETER_TYPE:
        return borrowed_param_ref_expr(function_index, param_index, parameter_type)
    return {
        "kind": "call",
        "call_kind": {"kind": "builtin", "name": "blorp_string_concat_consume"},
        "callee": {
            "kind": "var",
            "var": core_var("blorp_string_concat_consume", None),
            "type": named_type("Function"),
            "loc": synthetic_loc(),
        },
        "args": [
            borrowed_param_ref_expr(function_index, param_index, parameter_type),
            literal_expr("string", "", MANAGED_PARAMETER_TYPE),
        ],
        "type": named_type(MANAGED_PARAMETER_TYPE),
        "loc": synthetic_loc(),
    }


def worker_decl(
    index: int,
    def_id: int,
    body_leaves: int,
    global_reads_per_function: int,
    params_per_function: int,
    parameter_type: str,
    body_shape: str,
    function_count: int,
    first_function_id: int,
    user_call_edges: int,
) -> JsonObject:
    direct_parameter_reads = (
        body_shape == "linear"
        or (body_shape == "nested_user_call" and index == function_count - 1)
        or (body_shape == "mutually_recursive_calls" and index == 0)
    )
    expressions = [
        global_ref_expr(global_index)
        for global_index in range(global_reads_per_function)
    ]
    if direct_parameter_reads:
        expressions.extend(
            (
                borrowed_param_ref_expr(index, param_index, parameter_type)
                if body_shape == "linear"
                else consuming_parameter_expr(index, param_index, parameter_type)
            )
            for param_index in range(params_per_function)
        )
    if body_shape == "nested_user_call":
        if index < function_count - 1:
            calls = [
                call_worker_with_borrowed_params_expr(
                    index,
                    target_index,
                    first_function_id + target_index,
                    params_per_function,
                    parameter_type,
                )
                for target_index in range(
                    index + 1,
                    min(function_count, index + 1 + user_call_edges),
                )
            ]
            expressions = [*calls, *expressions]
    elif body_shape == "mutually_recursive_calls" and function_count > 1:
        calls = []
        for edge_index in range(user_call_edges):
            target_index = (index + edge_index + 1) % function_count
            calls.append(
                call_worker_with_borrowed_params_expr(
                    index,
                    target_index,
                    first_function_id + target_index,
                    params_per_function,
                    parameter_type,
                )
            )
        expressions = [*calls, *expressions]
    elif body_shape != "linear":
        raise ValueError(f"unsupported Perceus body shape: {body_shape}")
    if body_shape == "linear":
        literal_count = body_leaves - global_reads_per_function - params_per_function
        expressions.extend(
            literal_expr("int", leaf, "Int") for leaf in range(literal_count)
        )
        body_tail = seq_expr(expressions)
    else:
        expressions.append(literal_expr("int", 0, "Int"))
        body_tail = padded_sequence(
            expressions,
            body_leaves - CONTRACT_FIXTURE_LET_NODES,
        )
    managed_local_name = f"BENCH_MANAGED_LOCAL_{index:04d}"
    body = {
        "kind": "let",
        "name": core_var(managed_local_name, None),
        "mutable": False,
        "type": named_type("String"),
        "rhs": literal_expr("string", f"managed-{index:04d}", "String"),
        "body": body_tail,
    }
    params = [
        core_param(borrowed_param_name(index, param_index), parameter_type)
        for param_index in range(params_per_function)
    ]
    return user_function(f"bench_worker_{index:04d}", def_id, body, params)


def call_worker_expr(
    index: int,
    def_id: int,
    params_per_function: int,
    parameter_type: str,
) -> JsonObject:
    name = f"bench_worker_{index:04d}"
    function_type = named_type("Function")
    return {
        "kind": "call",
        "call_kind": {"kind": "selected_direct", "def_id": def_id},
        "callee": {
            "kind": "var",
            "var": core_var(name, def_id),
            "type": function_type,
            "loc": synthetic_loc(),
        },
        "args": [
            parameter_argument_expr(param_index, parameter_type)
            for param_index in range(params_per_function)
        ],
        "type": named_type("Int"),
        "loc": synthetic_loc(),
    }


def call_worker_with_borrowed_params_expr(
    caller_index: int,
    target_index: int,
    target_def_id: int,
    params_per_function: int,
    parameter_type: str,
) -> JsonObject:
    call = call_worker_expr(
        target_index,
        target_def_id,
        params_per_function,
        parameter_type,
    )
    call["call_kind"] = {
        "kind": "user",
        "name": f"bench_worker_{target_index:04d}",
        "def_id": target_def_id,
        "consumed_args": [],
    }
    call["args"] = [
        borrowed_param_ref_expr(caller_index, param_index, parameter_type)
        for param_index in range(params_per_function)
    ]
    return call


def fixture_request(
    global_count: int,
    function_count: int,
    body_leaves: int,
    global_reads_per_function: int,
    action: str = PERCEUS_ACTION,
    params_per_function: int = DEFAULT_PARAMS_PER_FUNCTION,
    parameter_type: str = MANAGED_PARAMETER_TYPE,
    invoke_workers: bool = True,
    body_shape: str = "linear",
    branch_arms: int = 2,
    user_call_edges: int = 1,
) -> tuple[JsonObject, JsonObject]:
    del branch_arms
    if body_shape not in BODY_SHAPES:
        raise ValueError(f"unsupported Perceus body shape: {body_shape}")
    globals_json = [global_decl(index) for index in range(global_count)]
    first_function_id = global_count + 1
    functions_json = [
        worker_decl(
            index,
            first_function_id + index,
            body_leaves,
            global_reads_per_function,
            params_per_function,
            parameter_type,
            body_shape,
            function_count,
            first_function_id,
            user_call_edges,
        )
        for index in range(function_count)
    ]
    main_expressions = []
    if invoke_workers:
        main_expressions = [
            call_worker_expr(
                index,
                first_function_id + index,
                params_per_function,
                parameter_type,
            )
            for index in range(function_count)
        ]
    main_expressions.append(literal_expr("int", 0, "Int"))
    main_json = user_function(
        "main",
        first_function_id + function_count,
        seq_expr(main_expressions),
    )
    core_program = {
        "kind": "program",
        "decls": [*globals_json, *functions_json, main_json],
        "foreign_includes": [],
    }
    request = {
        "schema": 1,
        "domain": "compiler",
        "action": action,
        "payload": {"core": core_program, "profile": False},
    }
    return request, core_program


def input_expression_count(
    global_count: int,
    function_count: int,
    body_leaves: int,
    params_per_function: int = DEFAULT_PARAMS_PER_FUNCTION,
    invoke_workers: bool = True,
) -> int:
    worker_nodes = function_count * ((2 * body_leaves) + 1)
    main_nodes = 1
    if invoke_workers:
        call_nodes = 3 + params_per_function
        main_nodes += function_count * call_nodes
    return global_count + worker_nodes + main_nodes


def parse_memory_bytes(value: str) -> int:
    match = re.fullmatch(r"([0-9]+(?:[.][0-9]+)?)([KMGTP]?)", value.strip())
    if match is None:
        raise ValueError(f"invalid memory value: {value}")
    number = float(match.group(1))
    suffix = match.group(2)
    multiplier = {
        "": 1,
        "K": 1024,
        "M": 1024**2,
        "G": 1024**3,
        "T": 1024**4,
        "P": 1024**5,
    }[suffix]
    return int(number * multiplier)


def vmmap_metrics(pid: int, timeout_seconds: float) -> JsonObject:
    try:
        result = subprocess.run(
            ["vmmap", "-summary", str(pid)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired:
        return {}
    if result.returncode != 0:
        return {}

    metrics: JsonObject = {}
    physical = re.search(r"^Physical footprint:\s+([0-9.]+[KMGTP]?)", result.stdout, re.M)
    if physical is not None:
        metrics["physical_footprint_bytes"] = parse_memory_bytes(physical.group(1))

    malloc_small = re.search(
        r"^\s*MALLOC_SMALL\b[^\n]*?([0-9.]+[KMGTP])\b",
        result.stdout,
        re.M,
    )
    if malloc_small is not None:
        metrics["malloc_small_bytes"] = parse_memory_bytes(malloc_small.group(1))

    allocation_counts = re.findall(r"([0-9][0-9,]*) allocations", result.stdout)
    zone_rows = re.findall(
        r"^DefaultMallocZone_\S+\s+\S+\s+\S+\s+\S+\s+\S+\s+([0-9,]+)\s+",
        result.stdout,
        re.M,
    )
    allocation_counts.extend(zone_rows)
    if allocation_counts:
        metrics["allocation_count"] = max(
            int(value.replace(",", "")) for value in allocation_counts
        )
    return metrics


def merge_max_metrics(current: JsonObject, sample: JsonObject) -> JsonObject:
    result = dict(current)
    for name, value in sample.items():
        result[name] = max(int(result.get(name, 0)), int(value))
    return result


def normalized_max_rss_bytes() -> int:
    max_rss = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
    if platform.system() == "Darwin":
        return int(max_rss)
    return int(max_rss) * 1024


def process_group_exists(process_group_id: int) -> bool:
    try:
        os.killpg(process_group_id, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    process_group_id = process.pid
    try:
        os.killpg(process_group_id, signal.SIGTERM)
    except ProcessLookupError:
        process.wait()
        return

    deadline = time.perf_counter() + TERMINATE_GRACE_SECONDS
    while time.perf_counter() < deadline:
        process.poll()
        if not process_group_exists(process_group_id):
            break
        time.sleep(0.01)

    if process_group_exists(process_group_id):
        try:
            os.killpg(process_group_id, signal.SIGKILL)
        except (PermissionError, ProcessLookupError):
            pass
    process.wait()


def execute_measurement_worker(args: argparse.Namespace) -> int:
    vmmap_enabled = args.sample_vmmap == "1"
    vmmap_result: JsonObject = {}
    timed_out = False
    started = time.perf_counter()
    deadline = started + args.timeout_seconds
    with open(args.response, "wb") as stdout_file, open(args.stderr, "wb") as stderr_file:
        process = subprocess.Popen(
            [args.bridge, args.request],
            stdout=stdout_file,
            stderr=stderr_file,
            start_new_session=True,
        )
        try:
            while process.poll() is None:
                now = time.perf_counter()
                if now >= deadline:
                    timed_out = True
                    terminate_process_group(process)
                    break
                if vmmap_enabled:
                    vmmap_result = merge_max_metrics(
                        vmmap_result,
                        vmmap_metrics(
                            process.pid,
                            min(VMMAP_COMMAND_TIMEOUT_SECONDS, deadline - now),
                        ),
                    )
                now = time.perf_counter()
                if now < deadline:
                    time.sleep(min(VMAP_SAMPLE_SECONDS, deadline - now))
        finally:
            process.poll()
            if process_group_exists(process.pid):
                terminate_process_group(process)
        return_code = process.wait()

    metrics = {
        "elapsed_seconds": time.perf_counter() - started,
        "exit_code": return_code,
        "timed_out": timed_out,
        **vmmap_result,
    }
    if not vmmap_enabled:
        metrics["peak_rss_bytes"] = normalized_max_rss_bytes()
    Path(args.metrics).write_text(json.dumps(metrics), encoding="utf-8")
    return 0


def measurement_worker(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("bridge")
    parser.add_argument("request")
    parser.add_argument("response")
    parser.add_argument("stderr")
    parser.add_argument("metrics")
    parser.add_argument("timeout_seconds", type=float)
    parser.add_argument("sample_vmmap", choices=("0", "1"))
    args = parser.parse_args(argv)

    previous_sigint_handler = signal.getsignal(signal.SIGINT)
    previous_sigterm_handler = signal.getsignal(signal.SIGTERM)

    def interrupt_worker(_signum: int, _frame: Any) -> None:
        raise InterruptedError("Perceus measurement worker terminated")

    signal.signal(signal.SIGINT, interrupt_worker)
    signal.signal(signal.SIGTERM, interrupt_worker)
    try:
        return execute_measurement_worker(args)
    finally:
        signal.signal(signal.SIGINT, previous_sigint_handler)
        signal.signal(signal.SIGTERM, previous_sigterm_handler)


def positive_int(value: str) -> int:
    result = int(value)
    if result <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return result


def nonnegative_int(value: str) -> int:
    result = int(value)
    if result < 0:
        raise argparse.ArgumentTypeError("must be zero or greater")
    return result


def project_root() -> Path:
    return Path(__file__).resolve().parent.parent


def has_expected_managed_local_drop(value: Any) -> bool:
    if isinstance(value, dict):
        variable = value.get("var")
        value_type = value.get("value_type")
        if (
            value.get("kind") == "drop"
            and isinstance(variable, dict)
            and variable.get("name") == "BENCH_MANAGED_LOCAL_0000"
            and isinstance(value_type, dict)
            and value_type.get("kind") == "named"
            and value_type.get("name") == "String"
            and value.get("release_policy") == "arc"
        ):
            return True
        return any(has_expected_managed_local_drop(child) for child in value.values())
    if isinstance(value, list):
        return any(has_expected_managed_local_drop(child) for child in value)
    return False


def validate_perceus_parameter_shape(
    core_program: JsonObject,
    function_count: int,
    params_per_function: int,
    parameter_type: str,
    body_shape: str = "linear",
    user_call_edges: int = 1,
) -> None:
    declarations = core_program.get("decls")
    if not isinstance(declarations, list):
        raise RuntimeError("Perceus Core parameter shape is missing declarations")

    functions_by_name = {
        declaration.get("name"): declaration
        for declaration in declarations
        if isinstance(declaration, dict) and declaration.get("kind") == "function"
    }
    for function_index in range(function_count):
        function_name = f"bench_worker_{function_index:04d}"
        function = functions_by_name.get(function_name)
        if not isinstance(function, dict):
            raise RuntimeError(f"Perceus Core parameter shape is missing {function_name}")
        params = function.get("params")
        if not isinstance(params, list) or len(params) != params_per_function:
            raise RuntimeError(f"Perceus Core parameter shape changed for {function_name}")
        for param_index, param in enumerate(params):
            expected_name = borrowed_param_name(function_index, param_index)
            if not isinstance(param, dict):
                raise RuntimeError(f"Perceus Core parameter shape changed for {function_name}")
            variable = param.get("name")
            value_type = param.get("type")
            if (
                not isinstance(variable, dict)
                or variable.get("name") != expected_name
                or not isinstance(value_type, dict)
                or value_type.get("kind") != "named"
                or value_type.get("name") != parameter_type
            ):
                raise RuntimeError(f"Perceus Core parameter shape changed for {function_name}")
            expected_reads = 1
            if body_shape == "nested_user_call":
                expected_reads = (
                    1
                    if function_index == function_count - 1
                    else min(user_call_edges, function_count - function_index - 1)
                )
            elif body_shape == "mutually_recursive_calls":
                expected_reads = user_call_edges + (1 if function_index == 0 else 0)
            if count_parameter_reads(function.get("body"), expected_name) != expected_reads:
                raise RuntimeError(f"Perceus Core parameter reads changed for {function_name}")


def count_parameter_reads(value: Any, expected_name: str) -> int:
    if isinstance(value, dict):
        own_read = 0
        variable = value.get("var")
        if (
            value.get("kind") == "var"
            and isinstance(variable, dict)
            and variable.get("name") == expected_name
            and variable.get("def_id") is None
        ):
            own_read = 1
        return own_read + sum(
            count_parameter_reads(child, expected_name) for child in value.values()
        )
    if isinstance(value, list):
        return sum(count_parameter_reads(child, expected_name) for child in value)
    return 0


def validate_response(
    response_path: Path,
    global_count: int,
    function_count: int,
    action: str,
    params_per_function: int,
    parameter_type: str,
    body_shape: str = "linear",
    user_call_edges: int = 1,
) -> tuple[int, str]:
    try:
        response = json.loads(response_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as error:
        raise RuntimeError(f"backend benchmark worker returned invalid JSON: {error}") from error

    if response.get("ok") is not True:
        raise RuntimeError(f"backend benchmark worker failed: {response.get('error', response)}")
    artifact = response.get("artifact")
    if not isinstance(artifact, dict):
        raise RuntimeError("backend benchmark worker response is missing an artifact")
    if action == END_TO_END_ACTION:
        output = artifact.get("c_code")
        if not isinstance(output, str) or not output:
            raise RuntimeError("backend benchmark worker artifact is missing generated C")
        encoded_output = output.encode("utf-8")
    else:
        output = artifact.get("core")
        if not isinstance(output, dict):
            raise RuntimeError("backend benchmark worker artifact is missing Perceus Core")
        validate_perceus_parameter_shape(
            output,
            function_count,
            params_per_function,
            parameter_type,
            body_shape,
            user_call_edges,
        )
        encoded_output = json.dumps(output, separators=(",", ":")).encode("utf-8")

    if action != END_TO_END_ACTION:
        expected_names = ["BENCH_UNUSED_GLOBAL_0000", "bench_worker_0000", "main"]
        if global_count > 1:
            expected_names.append(f"BENCH_UNUSED_GLOBAL_{global_count - 1:04d}")
        if function_count > 1:
            expected_names.append(f"bench_worker_{function_count - 1:04d}")
        rendered_output = encoded_output.decode("utf-8")
        missing_names = [name for name in expected_names if name not in rendered_output]
        if missing_names:
            raise RuntimeError(
                "benchmark artifact is missing fixture declarations: "
                + ", ".join(missing_names)
            )
    if action in (
        PERCEUS_ACTION,
        MEASURE_OWNERSHIP_PREPARATION_PERCEUS_ACTION,
        MEASURE_PERCEUS_DIRECT_ACTION,
    ):
        if not has_expected_managed_local_drop(output):
            raise RuntimeError(
                "Perceus Core is missing the expected managed-local ownership event"
            )
    return len(encoded_output), hashlib.sha256(encoded_output).hexdigest()


def response_artifact(response_path: Path) -> JsonObject:
    response = json.loads(response_path.read_text(encoding="utf-8"))
    artifact = response.get("artifact")
    if not isinstance(artifact, dict):
        raise RuntimeError("backend benchmark worker response is missing an artifact")
    return artifact


def file_sha256(path: Path) -> str:
