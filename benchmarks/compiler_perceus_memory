        "args": [
            borrowed_param_ref_expr(function_index, param_index, parameter_type),
            literal_expr("string", "", MANAGED_PARAMETER_TYPE),
        ],
        "type": named_type(MANAGED_PARAMETER_TYPE),
        "loc": synthetic_loc(),
    }


