def has_expected_managed_local_drop(value: Any) -> bool:
    if isinstance(value, dict):
        variable = value.get("var")
        value_type = value.get("value_type")
        if (
            value.get("kind") == "drop"
            and isinstance(variable, dict)
            and variable.get("name") == "BENCH_MANAGED_LOCAL_0000"
            and isinstance(value_type, dict)
            and value_type.get("kind") == "named"
            and value_type.get("name") == "String"
            and value.get("release_policy") == "arc"
        ):
            return True
        return any(has_expected_managed_local_drop(child) for child in value.values())
    if isinstance(value, list):
        return any(has_expected_managed_local_drop(child) for child in value)
    return False


def first_expression_of_kind(value: Any, expected_kind: str) -> JsonObject | None:
    if isinstance(value, dict):
        if value.get("kind") == expected_kind:
            return value
        for child in value.values():
            found = first_expression_of_kind(child, expected_kind)
            if found is not None:
                return found
    elif isinstance(value, list):
        for child in value:
            found = first_expression_of_kind(child, expected_kind)
            if found is not None:
                return found
    return None


def validate_perceus_parameter_shape(
    core_program: JsonObject,
    function_count: int,
    params_per_function: int,
    parameter_type: str,
    body_shape: str = "linear",
    user_call_edges: int = 1,
    global_count: int = 0,
    branch_arms: int = 2,
) -> None:
    declarations = core_program.get("decls")
    if not isinstance(declarations, list):
        raise RuntimeError("Perceus Core parameter shape is missing declarations")

    functions_by_name = {
        declaration.get("name"): declaration
        for declaration in declarations
        if isinstance(declaration, dict) and declaration.get("kind") == "function"
    }
    for function_index in range(function_count):
        function_name = f"bench_worker_{function_index:04d}"
        function = functions_by_name.get(function_name)
        if not isinstance(function, dict):
            raise RuntimeError(f"Perceus Core parameter shape is missing {function_name}")
        params = function.get("params")
        expected_function_params = (
            0 if body_shape == "lambda_borrowed_boundary" else params_per_function
        )
        if not isinstance(params, list) or len(params) != expected_function_params:
            raise RuntimeError(f"Perceus Core parameter shape changed for {function_name}")
        if body_shape == "lambda_borrowed_boundary":
            outer_lambda = first_expression_of_kind(function.get("body"), "lambda")
            if not isinstance(outer_lambda, dict):
                raise RuntimeError(f"Perceus Core is missing lambda for {function_name}")
            lambda_params = outer_lambda.get("params")
            if not isinstance(lambda_params, list) or len(lambda_params) != params_per_function:
                raise RuntimeError(f"Perceus Core lambda owner shape changed for {function_name}")
            for param_index, param in enumerate(lambda_params):
                expected_name = lambda_owner_name(function_index, param_index)
                if (
                    not isinstance(param, dict)
                    or param.get("name") != core_var(expected_name, None)
                ):
                    raise RuntimeError(
                        f"Perceus Core lambda owner shape changed for {function_name}"
                    )
                expected_reads = sum(
                    1 for site in range(
                        LAMBDA_CALL_SITES_PER_FUNCTION
                        + LAMBDA_AGGREGATE_SITES_PER_FUNCTION
                        + LAMBDA_RESULT_SITES_PER_FUNCTION
                    )
                    if site % params_per_function == param_index
                )
                if count_parameter_reads(outer_lambda.get("body"), expected_name) != expected_reads:
                    raise RuntimeError(
                        f"Perceus Core lambda owner reads changed for {function_name}"
                    )
            continue
        for param_index, param in enumerate(params):
            expected_name = borrowed_param_name(function_index, param_index)
            if not isinstance(param, dict):
                raise RuntimeError(f"Perceus Core parameter shape changed for {function_name}")
            variable = param.get("name")
            value_type = param.get("type")
            expected_type = (
                heap_record_type(BORROWED_OWNER_TYPE_NAME)
                if body_shape in (
                    "borrowed_call_protection",
                    "aggregate_escape",
                    "mixed_function_owner_catalog",
                    "borrowed_boundary_fusion",
                )
                else named_type(parameter_type)
            )
            if (
                not isinstance(variable, dict)
                or variable.get("name") != expected_name
                or variable.get("def_id") is not None
                or value_type != expected_type
            ):
                raise RuntimeError(f"Perceus Core parameter shape changed for {function_name}")
            expected_reads = 1
            if body_shape == "borrowed_call_protection":
                expected_reads = 1 if param_index == 0 else 0
            elif body_shape == "aggregate_escape":
                expected_reads = (
                    AGGREGATE_ESCAPE_SITES_PER_FUNCTION
                    if param_index == 0
                    else 0
                )
            elif body_shape == "borrowed_return":
                expected_reads = (
                    RESULT_ALIAS_TERMINALS_PER_FUNCTION
                    if param_index == 0
                    else 0
                )
            elif body_shape == "mixed_function_owner_catalog":
                expected_reads = 3 * sum(
                    1
                    for site_index in range(
                        global_count,
                        MIXED_FUNCTION_OWNER_BOUNDARY_SITES_PER_FAMILY,
                    )
                    if (site_index - global_count) % params_per_function == param_index
                )
            elif body_shape == "borrowed_boundary_fusion":
                expected_reads = 2 * sum(
                    1
                    for site_index in range(BORROWED_BOUNDARY_FUSION_SLOTS_PER_FAMILY)
                    if (
                        site_index % 2 == 1
                        and (site_index // 2) % params_per_function == param_index
                    )
                )
                expected_reads += sum(
                    1
                    for site_index in range(branch_arms)
                    if (
                        site_index % 2 == 1
                        and (site_index // 2) % params_per_function == param_index
                    )
                )
            elif body_shape == "nested_user_call":
                expected_reads = (
                    1
                    if function_index == function_count - 1
                    else min(user_call_edges, function_count - function_index - 1)
                )
            elif body_shape == "mutually_recursive_calls":
                expected_reads = user_call_edges + (1 if function_index == 0 else 0)
            if count_parameter_reads(function.get("body"), expected_name) != expected_reads:
                raise RuntimeError(f"Perceus Core parameter reads changed for {function_name}")


def count_parameter_reads(value: Any, expected_name: str) -> int:
    if isinstance(value, dict):
        own_read = 0
        variable = value.get("var")
        if (
            value.get("kind") == "var"
            and isinstance(variable, dict)
            and variable.get("name") == expected_name
            and variable.get("def_id") is None
        ):
            own_read = 1
        return own_read + sum(
            count_parameter_reads(child, expected_name) for child in value.values()
        )
    if isinstance(value, list):
        return sum(count_parameter_reads(child, expected_name) for child in value)
    return 0


def validate_response(
    response_path: Path,
    global_count: int,
    function_count: int,
    action: str,
    params_per_function: int,
    parameter_type: str,
    body_shape: str = "linear",
    user_call_edges: int = 1,
    branch_arms: int = 2,
) -> tuple[int, str]:
    try:
        response = json.loads(response_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as error:
        raise RuntimeError(f"backend benchmark worker returned invalid JSON: {error}") from error

    if response.get("ok") is not True:
        raise RuntimeError(f"backend benchmark worker failed: {response.get('error', response)}")
    artifact = response.get("artifact")
    if not isinstance(artifact, dict):
        raise RuntimeError("backend benchmark worker response is missing an artifact")
    if action == END_TO_END_ACTION:
        output = artifact.get("c_code")
        if not isinstance(output, str) or not output:
            raise RuntimeError("backend benchmark worker artifact is missing generated C")
        encoded_output = output.encode("utf-8")
    else:
        output = artifact.get("core")
        if not isinstance(output, dict):
            raise RuntimeError("backend benchmark worker artifact is missing Perceus Core")
        validate_perceus_parameter_shape(
            output,
            function_count,
            params_per_function,
            parameter_type,
            body_shape,
            user_call_edges,
            global_count,
            branch_arms,
        )
        encoded_output = json.dumps(output, separators=(",", ":")).encode("utf-8")

    if action != END_TO_END_ACTION:
        expected_names = ["BENCH_UNUSED_GLOBAL_0000", "bench_worker_0000", "main"]
        if global_count > 1:
            expected_names.append(f"BENCH_UNUSED_GLOBAL_{global_count - 1:04d}")
        if function_count > 1:
            expected_names.append(f"bench_worker_{function_count - 1:04d}")
        rendered_output = encoded_output.decode("utf-8")
        missing_names = [name for name in expected_names if name not in rendered_output]
        if missing_names:
            raise RuntimeError(
                "benchmark artifact is missing fixture declarations: "
                + ", ".join(missing_names)
            )
    if action in (
        PERCEUS_ACTION,
        MEASURE_OWNERSHIP_PREPARATION_PERCEUS_ACTION,
        MEASURE_PERCEUS_DIRECT_ACTION,
    ):
        if not has_expected_managed_local_drop(output):
            raise RuntimeError(
                "Perceus Core is missing the expected managed-local ownership event"
            )
    return len(encoded_output), hashlib.sha256(encoded_output).hexdigest()


