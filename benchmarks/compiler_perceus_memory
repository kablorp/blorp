def validate_borrowed_boundary_fusion_matrix(points: list[JsonObject]) -> None:
    densities = [int(point["branch_arms"]) for point in points]
    if densities != list(BORROWED_BOUNDARY_FUSION_DENSITIES):
        raise RuntimeError(
            "borrowed-boundary fusion matrix requires 8, 32, and 96-site points: "
            f"{densities}"
        )
    counters = [point.get("work_counters") for point in points]
    if not all(isinstance(counter, dict) for counter in counters):
        raise RuntimeError("borrowed-boundary fusion matrix requires work counters")
    baseline_counters = [point.get("baseline_work_counters") for point in points]
    if not all(isinstance(counter, dict) for counter in baseline_counters):
        raise RuntimeError(
            "borrowed-boundary fusion matrix requires immediate-parent work counters"
        )

    for density, counter, baseline_counter in zip(
        densities,
        counters,
        baseline_counters,
        strict=True,
    ):
        expected_actions = BORROWED_BOUNDARY_FUSION_FUNCTIONS * density
        for name in (
            "borrowed_call_rewrite_actions",
            "borrowed_aggregate_rewrite_actions",
            "borrowed_result_rewrite_actions",
        ):
            if int(counter[name]) != expected_actions:
                raise RuntimeError(
                    f"borrowed-boundary fusion {name} changed at density {density}: "
                    f"{counter[name]} != {expected_actions}"
                )

        expected_region_counts = {
            "borrowed_function_regions_normalized": BORROWED_BOUNDARY_FUSION_FUNCTIONS,
            "borrowed_global_initializer_regions_normalized": 0,
            "lambda_regions_normalized": 0,
            "borrowed_function_parameter_owner_slots": (
                BORROWED_BOUNDARY_FUSION_FUNCTIONS
                * BORROWED_BOUNDARY_FUSION_PARAMETERS
            ),
            "borrowed_function_global_owner_slots": (
                BORROWED_BOUNDARY_FUSION_FUNCTIONS
                * BORROWED_BOUNDARY_FUSION_GLOBALS
            ),
        }
        for name, expected in expected_region_counts.items():
            if int(counter[name]) != expected:
                raise RuntimeError(
                    f"borrowed-boundary fusion {name} changed at density {density}: "
                    f"{counter[name]} != {expected}"
                )

        fallback_requests = sum(
            int(counter[name])
            for name in (
                "borrowed_call_alias_fallback_requests",
                "borrowed_aggregate_alias_fallback_requests",
                "borrowed_result_alias_fallback_requests",
            )
        )
        fallback_visits = sum(
            int(counter[name])
            for name in (
                "borrowed_call_fallback_expression_visits",
                "borrowed_aggregate_fallback_expression_visits",
                "borrowed_result_fallback_expression_visits",
            )
        )
        if fallback_requests != 0 or fallback_visits != 0:
            raise RuntimeError(
                "borrowed-boundary fusion fixture entered scalar fallback: "
                f"requests={fallback_requests}, visits={fallback_visits}"
            )

        legacy_names = (
            "borrowed_call_node_visits",
            "borrowed_aggregate_node_visits",
            "borrowed_result_node_visits",
            "borrowed_call_reconstructed_nodes",
            "borrowed_aggregate_reconstructed_nodes",
            "borrowed_result_reconstructed_nodes",
        )
        for name in legacy_names:
            if int(baseline_counter[name]) <= 0:
                raise RuntimeError(
                    f"borrowed-boundary fusion parent did not exercise {name}"
                )
            if int(counter[name]) != 0:
                raise RuntimeError(
                    f"borrowed-boundary fusion still reached legacy authority {name}: "
                    f"{counter[name]}"
                )

    fused_visits = [int(counter["borrowed_fused_node_visits"]) for counter in counters]
    if any(value == 0 for value in fused_visits):
        raise RuntimeError(
            "borrowed-boundary fusion requires one fused structural visit per "
            "expression under the union child domain; Checkpoint C has not "
            f"implemented that authority: {fused_visits}"
        )
    for density, counter, baseline_counter in zip(
        densities,
        counters,
        baseline_counters,
        strict=True,
    ):
        legacy_visits = sum(
            int(baseline_counter[name])
            for name in (
                "borrowed_call_node_visits",
                "borrowed_aggregate_node_visits",
                "borrowed_result_node_visits",
            )
        )
        maximum_visit_ratio = 0.52 if density == 8 else 0.50
        if int(counter["borrowed_fused_node_visits"]) > legacy_visits * maximum_visit_ratio:
            raise RuntimeError(
                "borrowed-boundary fusion exceeded its structural visit budget: "
                f"{counter['borrowed_fused_node_visits']} vs {legacy_visits} "
                f"at ratio {maximum_visit_ratio}"
            )
        if int(counter["borrowed_fused_reconstructed_nodes"]) <= 0:
            raise RuntimeError(
                "borrowed-boundary fusion did not report reconstructed nodes"
            )

    middle_point = points[1]
    middle_time_ratio = middle_point.get(
        "paired_window_elapsed_microseconds_ratio_median"
    )
    if not isinstance(middle_time_ratio, (int, float)) or float(middle_time_ratio) > 1.05:
        raise RuntimeError(
            "borrowed-boundary fusion 32-site direct time regressed by more than "
            f"5%: ratio {middle_time_ratio}"
        )
    middle_allocation_ratio = middle_point.get(
        "paired_window_allocations_ratio_median"
    )
    if (
        not isinstance(middle_allocation_ratio, (int, float))
        or float(middle_allocation_ratio) > 0.985
    ):
        raise RuntimeError(
            "borrowed-boundary fusion must reduce 32-site direct-window "
            f"allocations by at least 1.5%: ratio {middle_allocation_ratio}"
        )

    low_point = points[0]
    low_time_ratio = low_point.get("paired_window_elapsed_microseconds_ratio_median")
    if not isinstance(low_time_ratio, (int, float)) or float(low_time_ratio) > 1.05:
        raise RuntimeError(
            "borrowed-boundary fusion low control regressed direct time by more "
            f"than 5%: ratio {low_time_ratio}"
        )
    for metric_name in ("window_allocations", "window_releases"):
        ratio = low_point.get(f"paired_{metric_name}_ratio_median")
        if not isinstance(ratio, (int, float)) or float(ratio) > 1.02:
            raise RuntimeError(
                "borrowed-boundary fusion low control "
                f"{metric_name} regressed by more than 2%: ratio {ratio}"
            )


