#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
	echo "usage: compiler_global_header_dependency_profile plain|profile [iterations] [initializers] [references] [duplicate-percent] [modules] [fan-in]" >&2
	exit 2
fi

instrumentation=$1
shift
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-global-header-dependency-profile \
	blorp/benchmark/compiler/compiler_global_header_dependency_profile.brp \
	"$instrumentation" \
	"$@"
