#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
compiler="${BLORP_PERCEUS_COMPILER:-$repo_root/bin/blorp}"
source_file="$repo_root/benchmarks/blorp/profiles/perceus_allocations.brp"
input_rev="${BLORP_PERCEUS_INPUT_REV:-origin/main}"
dump_file="${BLORP_PERCEUS_DUMP_FILE:-}"

if [ "${BLORP_PERCEUS_SKIP_BUILD:-0}" != "1" ]; then
	BLORP_CLI_C_OPTIMIZATION=-O2 make -C "$repo_root" all >/dev/null
fi

if [ ! -x "$compiler" ]; then
	echo "compiler_perceus_allocations: compiler is not executable: $compiler" >&2
	exit 1
fi

cleanup_dump=0
if [ -z "$dump_file" ]; then
	input_dir=$("$repo_root/benchmarks/self_compile_measure" freeze --rev "$input_rev")
	dump_file=$(mktemp -t blorp_perceus_post_dce.json)
	cleanup_dump=1
	"$compiler" compile --no-format --no-embed-runtime \
		--std-dir "$input_dir/standard_library/src" \
		-o "$(mktemp -t blorp_perceus_self.c)" \
		--dump-core-after=dce \
		--dump-core-file="$dump_file" \
		"$input_dir/blorp/src/main.brp" >/dev/null
fi

cleanup() {
	if [ "$cleanup_dump" = "1" ]; then
		rm -f "$dump_file"
	fi
}
trap cleanup EXIT

cd "$repo_root"
"$compiler" run --no-format --release "$source_file" -- "$dump_file"
