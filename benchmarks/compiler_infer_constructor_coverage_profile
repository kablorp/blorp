#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation="${1:-plain}"

case "$instrumentation" in
	plain|profile)
		shift || true
		;;
	*)
		echo "usage: benchmarks/compiler_infer_constructor_coverage_profile plain|profile [iterations] [cases] [options] [unique] [duplicate-stride]" >&2
		exit 2
		;;
esac

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-infer-constructor-coverage-profile \
	blorp/benchmark/compiler/compiler_infer_constructor_coverage_profile.brp \
	"$instrumentation" \
	"$@"
