#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation="${1:-plain}"

case "$instrumentation" in
	plain|profile)
		shift || true
		;;
	*)
		echo "usage: benchmarks/compiler_core_match_binding_profile plain|profile recursive|prefix-early|prefix-late [iterations] [binding_width] [nesting_depth] [constructor_columns]" >&2
		exit 2
		;;
esac

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-core-match-binding-profile \
	blorp/benchmark/compiler/compiler_core_match_binding_profile.brp \
	"$instrumentation" \
	"$@"
