#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation="${1:-plain}"

case "$instrumentation" in
	plain|profile)
		shift || true
		;;
	*)
		echo "usage: benchmarks/compiler_inference_capture_name_profile plain|profile [iterations] [capture-width] [qualifying-percent]" >&2
		exit 2
		;;
esac

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-inference-capture-name-profile \
	blorp/benchmark/compiler/compiler_inference_capture_name_profile.brp \
	"$instrumentation" \
	"$@"
