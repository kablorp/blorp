import:
	memory: MemStats, get_mem_stats, mem_delta


record Cell {
	count: Int,
	label: String
}


record Builder {
	rows: List[Int],
	edges: List[Int]
}


record Pair {
	builder: Builder,
	cell: Cell
}


pure func list_two_levels(pair: Pair, value: Int) -> Pair:
	{ pair | builder = { pair.builder | rows = pair.builder.rows.append(value) } }


pure func scalar_two_levels(pair: Pair) -> Pair:
	{ pair | cell = { pair.cell | count = pair.cell.count + 1 } }


pure func both(pair: Pair, value: Int) -> Pair:
	{ pair |
		builder = { pair.builder | rows = pair.builder.rows.append(value) },
		cell = { pair.cell | count = pair.cell.count + 1 }
	}


func run(mode: String, count: Int) -> Int:
	var pair: Pair = {builder = {rows = [], edges = []}, cell = {count = 0, label = "x"}}
	before: MemStats = get_mem_stats()

	for i in 0..count:
		if mode == "list":
			pair = pair.list_two_levels(i)
		else if mode == "scalar":
			pair = pair.scalar_two_levels()
		else:
			pair = pair.both(i)

	print("${mode} ${count}: ${mem_delta(before, get_mem_stats()).total_allocations} allocations")
	pair.builder.rows.length() + pair.cell.count


func main(args: List[String]) -> Int:
	for mode in ["list", "scalar", "both"]:
		run(mode, 1000)
		run(mode, 10000)

	0
