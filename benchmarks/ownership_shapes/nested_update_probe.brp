import:
	memory: MemStats, get_mem_stats, mem_delta


record Counts {
	expressions: Int,
	statements: Int
}


record Mint {
	module: Int,
	counts: Counts
}


record State {
	cursor: Int,
	mint: Mint,
	diagnostics: List[Int]
}


opaque type ParseState = State


pure func counted_opaque(state: ParseState) -> ParseState:
	fields: State = from_opaque ParseState(state)
	into_opaque ParseState({ fields |
		mint = { fields.mint | counts = { fields.mint.counts | expressions = fields.mint.counts.expressions + 1 } }
	})


pure func counted_plain(fields: State) -> State:
	{ fields |
		mint = { fields.mint | counts = { fields.mint.counts | expressions = fields.mint.counts.expressions + 1 } }
	}


pure func counted_two_levels(fields: State) -> State:
	{ fields | mint = { fields.mint | module = fields.mint.module + 1 } }


pure func counted_split(fields: State) -> State:
	mint: Mint = fields.mint
	counts: Counts = mint.counts
	{ fields | mint = { mint | counts = { counts | expressions = counts.expressions + 1 } } }


func run(mode: String, count: Int) -> Int:
	before: MemStats = get_mem_stats()
	var plain: State = {cursor = 0, mint = {module = 1, counts = {expressions = 0, statements = 0}}, diagnostics = [1]}
	var hidden: ParseState = into_opaque ParseState(plain)
	var index: Int = 0

	while index < count:
		if mode == "opaque":
			hidden = hidden.counted_opaque()
		else if mode == "plain":
			plain = plain.counted_plain()
		else if mode == "two":
			plain = plain.counted_two_levels()
		else:
			plain = plain.counted_split()

		index += 1

	delta: MemStats = mem_delta(before, get_mem_stats())
	print("${mode}: ${delta.total_allocations} allocations over ${count}")
	0


func main(args: List[String]) -> Int:
	match (args.get(1), args.get(2)):
		(Some(mode), Some(count_text)):
			run(mode, count_text.parse_int().get_or(1000))
		_:
			2
