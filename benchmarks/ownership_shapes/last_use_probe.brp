import:
	memory: MemStats, get_mem_stats, mem_delta


record Builder {
	rows: List[Int],
	tag: Int
}


pure func grown(builder: Builder, value: Int) -> Builder:
	{ builder | rows = builder.rows.append(value) }


-- An immutable alias read once, then dead, before the owner is updated.
func alias_read_then_update(count: Int) -> Int:
	var builder: Builder = {rows = [], tag = 0}
	var index: Int = 0
	var total: Int = 0

	while index < count:
		second_name: Builder = builder
		total += second_name.tag
		builder = builder.grown(index)
		index += 1

	builder.rows.length() + total


-- The same with the read taken from the owner itself.
func owner_read_then_update(count: Int) -> Int:
	var builder: Builder = {rows = [], tag = 0}
	var index: Int = 0
	var total: Int = 0

	while index < count:
		total += builder.tag
		builder = builder.grown(index)
		index += 1

	builder.rows.length() + total


func main(args: List[String]) -> Int:
	count: Int = 20000
	before: MemStats = get_mem_stats()
	first: Int = alias_read_then_update(count)
	middle: MemStats = get_mem_stats()
	second: Int = owner_read_then_update(count)
	after: MemStats = get_mem_stats()
	print("alias read then update: ${mem_delta(before, middle).total_allocations} allocations (${first})")
	print("owner read then update: ${mem_delta(middle, after).total_allocations} allocations (${second})")
	0
