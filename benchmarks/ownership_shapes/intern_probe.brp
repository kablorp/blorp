import:
	memory: MemStats, get_mem_stats, mem_delta


record Table {
	texts: List[Int],
	slots: List[Int]
}


opaque type Spellings = Table


pure func appended(state: Table, value: Int) -> Table:
	{ state | texts = state.texts.append(value), slots = state.slots.append(value) }


-- The M2 shape: the hit arm returns the given table.
pure func interned_given(spellings: Spellings, value: Int) -> (Spellings, Int):
	state: Table = from_opaque Spellings(spellings)

	if value % 4 != 0:
		(into_opaque Spellings(appended(state, value)), state.texts.length())
	else:
		(spellings, 0)


-- The same, with the hit arm rebuilding the table from the alias.
pure func interned_alias(spellings: Spellings, value: Int) -> (Spellings, Int):
	state: Table = from_opaque Spellings(spellings)

	if value % 4 != 0:
		(into_opaque Spellings(appended(state, value)), 0)
	else:
		(into_opaque Spellings(state), 0)


-- The given variant without the later read of `state`.
pure func interned_given_no_read(spellings: Spellings, value: Int) -> (Spellings, Int):
	state: Table = from_opaque Spellings(spellings)

	if value % 4 != 0:
		(into_opaque Spellings(appended(state, value)), 0)
	else:
		(spellings, 0)


-- No tuple: the same two arms returning the table alone.
pure func interned_alone(spellings: Spellings, value: Int) -> Spellings:
	state: Table = from_opaque Spellings(spellings)

	if value % 4 != 0:
		into_opaque Spellings(appended(state, value))
	else:
		spellings


-- No tuple, no opaque alias.
pure func interned_plain(state: Table, value: Int) -> Table:
	if value % 4 != 0:
		appended(state, value)
	else:
		state


func run(mode: String, count: Int) -> Int:
	var spellings: Spellings = into_opaque Spellings({texts = [], slots = []})
	before: MemStats = get_mem_stats()

	for i in 0..count:
		if mode == "given":
			(next, _) = interned_given(spellings, i)
			spellings = next
		else if mode == "alias":
			(next, _) = interned_alias(spellings, i)
			spellings = next
		else if mode == "given_no_read":
			(next, _) = interned_given_no_read(spellings, i)
			spellings = next
		else if mode == "alone_via_temporary":
			next: Spellings = interned_alone(spellings, i)
			spellings = next
		else if mode == "alone":
			spellings = interned_alone(spellings, i)
		else:
			spellings = into_opaque Spellings(interned_plain(from_opaque Spellings(spellings), i))

	print("${mode} ${count}: ${mem_delta(before, get_mem_stats()).total_allocations} allocations")
	from_opaque Spellings(spellings).texts.length()


func main(args: List[String]) -> Int:
	for mode in ["given", "alias", "given_no_read", "alone", "alone_via_temporary", "plain"]:
		run(mode, 1000)
		run(mode, 10000)

	0
