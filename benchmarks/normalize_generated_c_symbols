#!/usr/bin/env python3
"""Canonicalize generated symbol names in compiler C output and hash the result.

The backend spells anonymous top-level functions and static closures as
`brp_<suffix>` and `__sc_brp_<suffix>`, where the suffix is derived from the
definition ID the Core pipeline assigned. A change that legitimately prunes or
reorders declarations before monomorphization shifts those IDs, so the names
shift too even though the emitted program is the same. `--require-identical`
compares raw bytes and reports that as DIFFERENT.

This script replaces every such name with `brp_$<n>` / `__sc_brp_$<n>`, numbered
by first occurrence in the file, and prints a SHA-256 of the rewritten text.
Two files with the same normalized hash differ only in the spelling of those
generated symbols: the renaming is one-to-one and occurrence order is preserved,
so any difference in structure, ordering, or in any other identifier survives
normalization and changes the hash.

Usage:

    benchmarks/normalize_generated_c_symbols a.c            # print hash
    benchmarks/normalize_generated_c_symbols a.c b.c        # compare, exit 1 if different
    benchmarks/normalize_generated_c_symbols --emit a.c     # print normalized text

Exit status is 0 when the hashes agree, 1 when they do not, and 2 on a usage or
I/O error.
"""

from __future__ import annotations

import argparse
import hashlib
import re
import sys
from pathlib import Path

# Both families share the `brp_` stem; the longer alternative has to come first
# so the static-closure prefix is not split by the shorter match.
GENERATED_SYMBOL_RE = re.compile(r"\b(__sc_brp_|brp_)([A-Za-z0-9]+)\b")


def normalize(text: str) -> str:
    """Rewrite generated symbol names to their first-occurrence index."""
    numbering: dict[str, int] = {}

    def replace(match: re.Match[str]) -> str:
        symbol = match.group(0)
        if symbol not in numbering:
            numbering[symbol] = len(numbering)
        return f"{match.group(1)}${numbering[symbol]}"

    return GENERATED_SYMBOL_RE.sub(replace, text)


def normalized_hash(path: Path) -> str:
    return hashlib.sha256(normalize(path.read_text()).encode("utf-8")).hexdigest()


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("files", nargs="+", type=Path, help="one file to hash, or two to compare")
    parser.add_argument(
        "--emit", action="store_true", help="print the normalized text instead of a hash"
    )
    args = parser.parse_args(argv)

    if len(args.files) > 2:
        print("normalize_generated_c_symbols: pass one or two files", file=sys.stderr)
        return 2

    try:
        if args.emit:
            if len(args.files) != 1:
                print("normalize_generated_c_symbols: --emit takes one file", file=sys.stderr)
                return 2
            sys.stdout.write(normalize(args.files[0].read_text()))
            return 0

        hashes = [(path, normalized_hash(path)) for path in args.files]
    except OSError as error:
        print(f"normalize_generated_c_symbols: {error}", file=sys.stderr)
        return 2

    for path, digest in hashes:
        print(f"{digest}  {path}")

    if len(hashes) == 2:
        identical = hashes[0][1] == hashes[1][1]
        print("normalized C: IDENTICAL" if identical else "normalized C: DIFFERENT")
        return 0 if identical else 1

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
