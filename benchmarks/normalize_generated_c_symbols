#!/usr/bin/env python3
"""Canonicalize generated symbol names in compiler C output and hash the result.

Four things in the output carry the definition ID the Core pipeline assigned:
anonymous functions and static closures (`brp_<suffix>`, `__sc_brp_<suffix>`),
the singleton of a nullary union variant (`__def_<id>_<Name>`, which also
appears embedded in longer mangled names), generated local variable suffixes
(`__v<n>`), and the `def_id=<n>` echoed in generated comments. A change that
legitimately prunes or reorders declarations before monomorphization shifts
those IDs, so all four shift even though the emitted program is the same, and
the file size can move by a few bytes when an id changes digit count.
`--require-identical` compares raw bytes and reports that as DIFFERENT.

This script renumbers each family by first occurrence in the file, keeping
everything else -- including the variant name in `__def_$<n>_<Name>` -- and
prints a SHA-256 of the rewritten text.
Two files with the same normalized hash differ only in the spelling of those
generated symbols: the renaming is one-to-one and occurrence order is preserved,
so any difference in structure, ordering, or in any other identifier survives
normalization and changes the hash.

Usage:

    benchmarks/normalize_generated_c_symbols a.c            # print hash
    benchmarks/normalize_generated_c_symbols a.c b.c        # compare, exit 1 if different
    benchmarks/normalize_generated_c_symbols --emit a.c     # print normalized text

Exit status is 0 when the hashes agree, 1 when they do not, and 2 on a usage or
I/O error.
"""

from __future__ import annotations

import argparse
import hashlib
import re
import sys
from pathlib import Path

# `brp_<suffix>` and `__sc_brp_<suffix>` name anonymous functions and static
# closures; the longer alternative comes first so the static-closure prefix is
# not split by the shorter match. `__def_<id>_<Name>` names the singleton of a
# nullary union variant, where only the numeric id is definition-derived and the
# trailing name is meaningful, so the id alone is renumbered.
# Four families carry a definition ID. `__def_` is matched without a word
# boundary because it also appears embedded in longer mangled names, preceded by
# an underscore; the prefix is distinctive enough to be unambiguous on its own.
GENERATED_SYMBOL_RE = re.compile(
    r"\b(__sc_brp_|brp_)([A-Za-z0-9]+)\b"  # anonymous functions, static closures
    r"|__def_(\d+)_"  # nullary union variant singletons
    r"|(__v)(\d+)\b"  # generated local variable suffixes
    r"|(def_id=)(\d+)\b"  # the id echoed in generated comments
)


def normalize(text: str) -> str:
    """Rewrite generated symbol names to their first-occurrence index."""
    numbering: dict[str, int] = {}

    def index_of(symbol: str) -> int:
        if symbol not in numbering:
            numbering[symbol] = len(numbering)
        return numbering[symbol]

    def replace(match: re.Match[str]) -> str:
        if match.group(3) is not None:
            return f"__def_${index_of(match.group(0))}_"
        if match.group(4) is not None:
            return f"__v${index_of(match.group(0))}"
        if match.group(6) is not None:
            return f"def_id=${index_of(match.group(0))}"
        return f"{match.group(1)}${index_of(match.group(0))}"

    return GENERATED_SYMBOL_RE.sub(replace, text)


def normalized_hash(path: Path) -> str:
    return hashlib.sha256(normalize(path.read_text()).encode("utf-8")).hexdigest()


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("files", nargs="+", type=Path, help="one file to hash, or two to compare")
    parser.add_argument(
        "--emit", action="store_true", help="print the normalized text instead of a hash"
    )
    args = parser.parse_args(argv)

    if len(args.files) > 2:
        print("normalize_generated_c_symbols: pass one or two files", file=sys.stderr)
        return 2

    try:
        if args.emit:
            if len(args.files) != 1:
                print("normalize_generated_c_symbols: --emit takes one file", file=sys.stderr)
                return 2
            sys.stdout.write(normalize(args.files[0].read_text()))
            return 0

        hashes = [(path, normalized_hash(path)) for path in args.files]
    except OSError as error:
        print(f"normalize_generated_c_symbols: {error}", file=sys.stderr)
        return 2

    for path, digest in hashes:
        print(f"{digest}  {path}")

    if len(hashes) == 2:
        identical = hashes[0][1] == hashes[1][1]
        print("normalized C: IDENTICAL" if identical else "normalized C: DIFFERENT")
        return 0 if identical else 1

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
