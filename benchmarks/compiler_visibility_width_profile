#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
instrumentation=plain

if [ "${BLORP_VISIBILITY_WIDTH_PROFILE_FUNCTIONS:-0}" = "1" ]; then
	instrumentation=profile
fi

exec "$script_dir/compiler_blorp_benchmark_runner" \
	compiler-visibility-width-profile \
	blorp/benchmark/compiler/compiler_visibility_width_profile.brp \
	"$instrumentation" \
	"$@"
