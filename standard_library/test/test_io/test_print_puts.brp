import:
	process: exit_code, shell, stdout
	system: mkstemp_path, remove_file, write_file
	test: TestSuite


func write_source_file(src: String) -> Result[String, String]:
	match mkstemp_path("blorp_io_"):
		Err(e):
			Err("mkstemp failed: " + e)
		Ok(path):
			match write_file(path, src):
				Err(e):
					_ = remove_file(path)
					Err("write failed: " + e)
				Ok(_):
					Ok(path)


func test_print_puts_and_input_capture() -> Bool:
	src: String =
		|import:
		|    io: input_or_empty
		|
		|func main(args: List[String]) -> Int:
		|    print(42)
		|    puts("A")
		|    puts(7)
		|    print(True)
		|    match input("Name: "):
		|        Some(name): print("first:" + name)
		|        None: print("first:eof")
		|    match input("Empty: "):
		|        Some(name): print("second:" + name)
		|        None: print("second:eof")
		|    fallback = input_or_empty("Missing: ")
		|    print("fallback:" + fallback)
		|    match input("EOF: "):
		|        Some(name): print("unexpected:" + name)
		|        None: print("eof")
		|    0
	expected: String = "42\nA7True\nName: first:Ada\nEmpty: second:\nMissing: fallback:\nEOF: eof\n"

	match write_source_file(src):
		Err(_):
			False
		Ok(path):
			result: Bool = match shell("printf 'Ada\\n\\n' | bin/blorp run --no-format " + path):
				Ok(out):
					out.exit_code() == 0 and out.stdout() == expected
				Err(_):
					False

			_ = remove_file(path)
			result


tests: TestSuite = {
	description = "io print/puts",
	tests = [("print, puts, and input capture", test_print_puts_and_input_capture)]
}
