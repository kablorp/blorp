import:
	dict as D
	test: TestSuite


func test_basic_dict_literal() -> Bool:
	d: Dict[String, Int] = {"name" => 42, "age" => 30}
	match D.get(d, "name"):
		Some(v): v == 42
		None: False


func test_dict_literal_length() -> Bool:
	d: Dict[String, Int] = {"a" => 1, "b" => 2, "c" => 3}
	D.length(d) == 3


func test_dict_literal_lookup() -> Bool:
	d: Dict[String, Int] = {"x" => 10, "y" => 20}
	match D.get(d, "y"):
		Some(v): v == 20
		None: False


func test_dict_literal_missing_key() -> Bool:
	d: Dict[String, Int] = {"x" => 10}
	match D.get(d, "z"):
		Some(_): False
		None: True


func test_dict_literal_single() -> Bool:
	d: Dict[String, String] = {"hello" => "world"}
	match D.get(d, "hello"):
		Some(v): v == "world"
		None: False


func test_dict_literal_overwrite() -> Bool:
	d: Dict[String, Int] = {"x" => 1, "x" => 2}
	match D.get(d, "x"):
		Some(v): v == 2
		None: False


func test_dict_literal_int_keys() -> Bool:
	d: Dict[Int, String] = {1 => "one", 2 => "two", 3 => "three"}
	match D.get(d, 2):
		Some(v): v == "two"
		None: False


tests: TestSuite = {
	description = "Dict Literal Tests",
	tests = [
		("basic dict literal", test_basic_dict_literal),
		("dict literal length", test_dict_literal_length),
		("dict literal lookup", test_dict_literal_lookup),
		("dict literal missing key", test_dict_literal_missing_key),
		("dict literal single entry", test_dict_literal_single),
		("dict literal overwrite", test_dict_literal_overwrite),
		("dict literal int keys", test_dict_literal_int_keys),
	]
}
