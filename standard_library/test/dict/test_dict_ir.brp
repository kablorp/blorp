import:
	dict: Dict, dict as dict_new, keys, set as dict_set, values
	test: TestSuite


func test_keys_int() -> Bool:
	var d: Dict[Int, String] = dict_new()
	d = dict_set(d, 1, "one")
	d = dict_set(d, 2, "two")
	d = dict_set(d, 3, "three")
	ks: List[Int] = keys(d)
	ks.length() == 3


func test_keys_string() -> Bool:
	var d: Dict[String, Int] = dict_new()
	d = dict_set(d, "a", 1)
	d = dict_set(d, "b", 2)
	ks: List[String] = keys(d)
	ks.length() == 2


func test_values() -> Bool:
	var d: Dict[String, Int] = dict_new()
	d = dict_set(d, "x", 10)
	d = dict_set(d, "y", 20)
	vs: List[Int] = values(d)
	vs.length() == 2


func test_keys_empty() -> Bool:
	d: Dict[Int, Int] = dict_new()
	keys(d).length() == 0


func test_values_empty() -> Bool:
	d: Dict[Int, Int] = dict_new()
	values(d).length() == 0


func test_keys_after_remove() -> Bool:
	var d: Dict[Int, Int] = dict_new()
	d = dict_set(d, 1, 10)
	d = dict_set(d, 2, 20)
	d = dict_set(d, 3, 30)
	d = d.remove(2)
	keys(d).length() == 2


tests: TestSuite = {
	description = "Dict IR tests",
	tests = [
		("keys int", test_keys_int),
		("keys string", test_keys_string),
		("values", test_values),
		("keys empty", test_keys_empty),
		("values empty", test_values_empty),
		("keys after remove", test_keys_after_remove),
	]
}
