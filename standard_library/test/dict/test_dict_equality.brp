import:
	dict as D
	test: TestSuite


func test_eq_int_int() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10), (2, 20)])
	b: Dict[Int, Int] = D.from_list([(1, 10), (2, 20)])
	a == b


func test_eq_string_int() -> Bool:
	a: Dict[String, Int] = D.set(D.set(D.dict(), "a", 1), "b", 2)
	b: Dict[String, Int] = D.set(D.set(D.dict(), "a", 1), "b", 2)
	a == b


func test_neq_value() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10)])
	b: Dict[Int, Int] = D.from_list([(1, 99)])
	a != b


func test_neq_size() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10)])
	b: Dict[Int, Int] = D.from_list([(1, 10), (2, 20)])
	a != b


func test_eq_empty() -> Bool:
	a: Dict[Int, Int] = D.dict()
	b: Dict[Int, Int] = D.dict()
	a == b


func test_eq_same_ref() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10)])
	a == a


tests: TestSuite = {
	description = "Dict Equality",
	tests = [
		("eq int int", test_eq_int_int),
		("eq string int", test_eq_string_int),
		("neq value", test_neq_value),
		("neq size", test_neq_size),
		("eq empty", test_eq_empty),
		("eq same ref", test_eq_same_ref),
	]
}
