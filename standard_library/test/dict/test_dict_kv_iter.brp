import:
	dict: Dict, dict, set
	test: TestSuite


func test_kv_iter_int() -> Bool:
	var d: Dict[Int, Int] = dict()
	d = set(d, 1, 10)
	d = set(d, 2, 20)
	d = set(d, 3, 30)
	var sum: Int = 0
	for (k, v) in d:
		sum = sum + k + v
	sum == 66


func test_kv_iter_string_keys() -> Bool:
	var d: Dict[String, Int] = dict()
	d = set(d, "a", 1)
	d = set(d, "b", 2)
	d = set(d, "c", 3)
	var total: Int = 0
	for (k, v) in d:
		total += v
	total == 6


func test_kv_iter_string_values() -> Bool:
	var d: Dict[Int, String] = dict()
	d = set(d, 1, "hello")
	d = set(d, 2, "world")
	var result: String = ""
	for (k, v) in d:
		result += v
	result == "helloworld" or result == "worldhello"


func test_kv_iter_string_both() -> Bool:
	var d: Dict[String, String] = dict()
	d = set(d, "name", "blorp")
	d = set(d, "lang", "fun")
	var count: Int = 0
	for (k, v) in d:
		count = count + k.length() + v.length()
	count == 4 + 5 + 4 + 3


func test_kv_iter_empty() -> Bool:
	d: Dict[Int, Int] = dict()
	var count: Int = 0
	for (k, v) in d:
		count += 1
	count == 0


func test_kv_iter_single() -> Bool:
	var d: Dict[Int, Int] = dict()
	d = set(d, 42, 99)
	var got_k: Int = 0
	var got_v: Int = 0
	for (k, v) in d:
		got_k = k
		got_v = v
	got_k == 42 and got_v == 99


func test_key_iter() -> Bool:
	var d: Dict[Int, Int] = dict()
	d = set(d, 10, 100)
	d = set(d, 20, 200)
	var sum: Int = 0
	for k in d:
		sum += k
	sum == 30


tests: TestSuite = {
	description = "Dict KV Iteration",
	tests = [
		("for (k, v) in dict with int keys and values", test_kv_iter_int),
		("for (k, v) in dict with string keys", test_kv_iter_string_keys),
		("for (k, v) in dict with string values", test_kv_iter_string_values),
		("for (k, v) in dict with string keys and values", test_kv_iter_string_both),
		("for (k, v) in empty dict", test_kv_iter_empty),
		("for (k, v) in single-entry dict", test_kv_iter_single),
		("for k in dict (key-only)", test_key_iter),
	]
}
