import:
	dict: Dict, contains, dict, get_or, set
	test: TestSuite


func test_contains_hit_and_miss() -> Bool:
	d: Dict[Int, Int] = dict()
		.set(1, 10)
		.set(2, 20)
	contains(d, 1) and not contains(d, 3)


func lookup_string_hit() -> String:
	d: Dict[String, String] = dict().set("a", "val" + "ue")
	d.get_or("a", "fallback")


func test_get_or_hit_retains_managed_value() -> Bool:
	lookup_string_hit() == "value"


func test_get_or_miss_returns_default() -> Bool:
	d: Dict[String, String] = dict()
	d.get_or("missing", "fallback") == "fallback"


tests: TestSuite = {
	description = "Dict Fast Paths",
	tests = [
		("contains hit and miss", test_contains_hit_and_miss),
		("get_or hit retains managed value", test_get_or_hit_retains_managed_value),
		("get_or miss returns default", test_get_or_miss_returns_default),
	]
}
