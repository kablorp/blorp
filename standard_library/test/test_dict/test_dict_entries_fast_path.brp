import:
	dict as D
	test: TestSuite


func test_entries_preserve_order_after_remove() -> Bool:
	var d: Dict[String, String] = D.dict()
	d = D.set(d, "a", "one")
	d = D.set(d, "b", "two")
	d = D.set(d, "c", "three")
	d = D.remove(d, "b")
	es: List[(String, String)] = D.entries(d)
	if es.length() != 2:
		False
	else:
		match es.get(0):
			Some(first):
				match es.get(1):
					Some(second): first[0] == "a" and first[1] == "one" and second[0] == "c" and second[1] == "three"
					None: False
			None: False


func test_entries_own_string_payloads() -> Bool:
	var d: Dict[String, String] = D.dict()
	d = D.set(d, "key", "value")
	es: List[(String, String)] = D.entries(d)
	d = D.dict()
	match es.get(0):
		Some(pair): pair[0] == "key" and pair[1] == "value"
		None: False


func test_entries_own_heap_string_payloads() -> Bool:
	var d: Dict[String, String] = D.dict()
	key: String = "prefix-key-suffix".substring(7, 3)
	value: String = "prefix-value-suffix".substring(7, 5)
	d = D.set(d, key, value)
	es: List[(String, String)] = D.entries(d)
	d = D.dict()
	match es.get(0):
		Some(pair): pair[0] == "key" and pair[1] == "value"
		None: False


tests: TestSuite = {
	description = "Dict Entries Fast Path",
	tests = [
		("entries preserve order after remove", test_entries_preserve_order_after_remove),
		("entries own string payloads", test_entries_own_string_payloads),
		("entries own heap string payloads", test_entries_own_heap_string_payloads),
	]
}
