import:
	dict as Dict
	test: TestSuite


func test_empty_map_has_length_zero() -> Bool:
	var map: Dict[Int, String] = Dict.dict()
	map.length() == 0


func test_with_capacity_supports_int_keys() -> Bool:
	var map: Dict[Int, String] = Dict.with_capacity(64)
	map = Dict.set(map, 42, "hello")
	Dict.get(map, 42).get_or("") == "hello"


func test_with_capacity_supports_string_keys() -> Bool:
	var map: Dict[String, Int] = Dict.with_capacity(64)
	map = Dict.set(map, "answer", 42)
	Dict.get(map, "answer").get_or(0) == 42


func test_with_capacity_supports_float_keys() -> Bool:
	var map: Dict[Float, String] = Dict.with_capacity(64)
	map = Dict.set(map, 1.5, "one point five")
	Dict.get(map, 1.5).get_or("") == "one point five"


func test_insert_and_get_with_int_key() -> Bool:
	var map: Dict[Int, String] = Dict.dict()
	map = Dict.set(map, 42, "hello")
	Dict.get(map, 42).get_or("") == "hello"


func test_get_missing_key_returns_none() -> Bool:
	var map: Dict[Int, String] = Dict.dict()
	Dict.get(map, 99).is_none()


pure func pure_lazy_list_lookup(map: Dict[String, List[Int]], key: String) -> List[Int]:
	Dict.get_or_else(
		map,
		key,
		func() -> List[Int]: [],
	)


func test_pure_get_or_else_computes_default_lazily() -> Bool:
	map: Dict[String, List[Int]] = Dict
		.dict()
		.set("present", [42])
	present: List[Int] = pure_lazy_list_lookup(map, "present")
	missing: List[Int] = pure_lazy_list_lookup(map, "missing")
	present == [42] and missing.length() == 0


func test_contains_checks_key_presence() -> Bool:
	var map: Dict[Int, String] = Dict.dict()
	map = Dict.set(map, 5, "five")
	Dict.contains(map, 5) and not Dict.contains(map, 10)


func test_remove_deletes_key() -> Bool:
	var map: Dict[Int, Int] = Dict.dict()
	map = Dict.set(map, 1, 100)
	map = Dict.remove(map, 1)
	not Dict.contains(map, 1)


func test_insert_overwrites_existing_value() -> Bool:
	var map: Dict[Int, String] = Dict.dict()
	map = Dict.set(map, 1, "first")
	map = Dict.set(map, 1, "second")
	Dict.get(map, 1).get_or("") == "second"


func test_string_keys_work() -> Bool:
	var map: Dict[String, Int] = Dict.dict()
	map = Dict.set(map, "one", 1)
	map = Dict.set(map, "two", 2)
	Dict.get(map, "one").get_or(0) == 1


func test_string_key_contains() -> Bool:
	var map: Dict[String, Int] = Dict.dict()
	map = Dict.set(map, "hello", 42)
	Dict.contains(map, "hello") and not Dict.contains(map, "world")


func test_multiple_entries_tracked_correctly() -> Bool:
	var map: Dict[Int, Int] = Dict.dict()
	map = Dict.set(map, 1, 10)
	map = Dict.set(map, 2, 20)
	map = Dict.set(map, 3, 30)
	map.length() == 3


func test_length_decreases_after_remove() -> Bool:
	var map: Dict[Int, Int] = Dict.dict()
	map = Dict.set(map, 1, 10)
	map = Dict.set(map, 2, 20)
	map = Dict.remove(map, 1)
	map.length() == 1


func test_keys_in_insertion_order() -> Bool:
	var d: Dict[Int, String] = Dict.dict()
	d = Dict.set(d, 3, "c")
	d = Dict.set(d, 1, "a")
	d = Dict.set(d, 2, "b")
	k: List[Int] = Dict.keys(d)
	k.get(0).get_or(0) == 3 and k.get(1).get_or(0) == 1 and k.get(2).get_or(0) == 2


func test_order_preserved_after_remove() -> Bool:
	var d: Dict[Int, String] = Dict.dict()
	d = Dict.set(d, 1, "a")
	d = Dict.set(d, 2, "b")
	d = Dict.set(d, 3, "c")
	d = Dict.remove(d, 2)
	k: List[Int] = Dict.keys(d)
	k.get(0).get_or(0) == 1 and k.get(1).get_or(0) == 3


func test_large_int_key() -> Bool:
	var map: Dict[Int, String] = Dict.dict()
	map = Dict.set(map, 2000000, "big")
	Dict.get(map, 2000000).get_or("") == "big"


func test_negative_large_int_key() -> Bool:
	var map: Dict[Int, String] = Dict.dict()
	map = Dict.set(map, -2000000, "neg")
	Dict.get(map, -2000000).get_or("") == "neg"


func test_max_int_key() -> Bool:
	var map: Dict[Int, String] = Dict.dict()
	map = Dict.set(map, 3000000000, "max")
	Dict.get(map, 3000000000).get_or("") == "max"


func test_zero_key() -> Bool:
	var map: Dict[Int, Int] = Dict.dict()
	map = Dict.set(map, 0, 42)
	Dict.get(map, 0).get_or(0) == 42


func test_boundary_int_keys() -> Bool:
	var map: Dict[Int, Int] = Dict.dict()
	map = Dict.set(map, 999999, 1)
	map = Dict.set(map, 1000000, 2)
	map = Dict.set(map, 1000001, 3)
	Dict.get(map, 999999).get_or(0) == 1 and Dict.get(map, 1000000).get_or(0) == 2 and Dict.get(map, 1000001).get_or(0) == 3


tests: TestSuite = {
	description = "Dict Tests",
	tests = [
		("Empty map has length 0", test_empty_map_has_length_zero),
		("With capacity supports Int keys", test_with_capacity_supports_int_keys),
		("With capacity supports String keys", test_with_capacity_supports_string_keys),
		("With capacity supports Float keys", test_with_capacity_supports_float_keys),
		("Insert and get with Int key", test_insert_and_get_with_int_key),
		("Get missing key returns None", test_get_missing_key_returns_none),
		("Pure get_or_else computes default lazily", test_pure_get_or_else_computes_default_lazily),
		("Contains checks key presence", test_contains_checks_key_presence),
		("Remove deletes key", test_remove_deletes_key),
		("Insert overwrites existing value", test_insert_overwrites_existing_value),
		("String keys work", test_string_keys_work),
		("String key contains", test_string_key_contains),
		("Multiple entries tracked correctly", test_multiple_entries_tracked_correctly),
		("Length decreases after remove", test_length_decreases_after_remove),
		("Keys in insertion order", test_keys_in_insertion_order),
		("Order preserved after remove", test_order_preserved_after_remove),
		("Large int key", test_large_int_key),
		("Negative large int key", test_negative_large_int_key),
		("Max int key", test_max_int_key),
		("Zero key", test_zero_key),
		("Boundary int keys", test_boundary_int_keys),
	]
}
