import:
	dict: contains, dict, get, length, remove, set
	test: TestSuite


-- Bool keys (uses Int hash/eq internally)
func test_dict_bool_keys() -> Bool:
	var d: Dict[Bool, String] = dict()
	d = set(d, True, "yes")
	d = set(d, False, "no")
	match get(d, True):
		Some(v): v == "yes"
		None: False


func test_dict_bool_contains() -> Bool:
	var d: Dict[Bool, Int] = dict()
	d = set(d, True, 1)
	d.contains(True) and not d.contains(False)


func test_dict_bool_overwrite() -> Bool:
	var d: Dict[Bool, Int] = dict()
	d = set(d, True, 1)
	d = set(d, True, 2)
	match get(d, True):
		Some(v): v == 2
		None: False


-- Char keys (uses Int hash/eq internally)
func test_dict_char_keys() -> Bool:
	var d: Dict[Char, Int] = dict()
	d = set(d, 'a', 1)
	d = set(d, 'b', 2)
	d = set(d, 'z', 26)
	match get(d, 'b'):
		Some(v): v == 2
		None: False


func test_dict_char_remove() -> Bool:
	var d: Dict[Char, String] = dict()
	d = set(d, 'x', "ex")
	d = set(d, 'y', "why")
	d = d.remove('x')
	not d.contains('x') and d.contains('y')


-- Float keys
func test_dict_float_keys() -> Bool:
	var d: Dict[Float, String] = dict()
	d = set(d, 3.14, "pi")
	d = set(d, 2.72, "e")
	match get(d, 3.14):
		Some(v): v == "pi"
		None: False


func test_dict_float_overwrite() -> Bool:
	var d: Dict[Float, Int] = dict()
	d = set(d, 1.5, 10)
	d = set(d, 1.5, 20)
	d.length() == 1 and match get(d, 1.5):
		Some(v): v == 20
		None: False


func test_dict_float_remove() -> Bool:
	var d: Dict[Float, Int] = dict()
	d = set(d, 1.0, 1)
	d = set(d, 2.0, 2)
	d = d.remove(1.0)
	not d.contains(1.0) and d.contains(2.0)


func test_dict_float_many() -> Bool:
	var d: Dict[Float, Int] = dict()
	for i in 0..50:
		d = set(d, to_float(i) * 0.1, i)
	d.length() == 50


tests: TestSuite = {
	description = "Dict Generic Keys",
	tests = [
		("bool keys", test_dict_bool_keys),
		("bool contains", test_dict_bool_contains),
		("bool overwrite", test_dict_bool_overwrite),
		("char keys", test_dict_char_keys),
		("char remove", test_dict_char_remove),
		("float keys", test_dict_float_keys),
		("float overwrite", test_dict_float_overwrite),
		("float remove", test_dict_float_remove),
		("float many entries", test_dict_float_many),
	]
}
