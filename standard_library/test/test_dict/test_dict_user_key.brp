-- Dict[UserType, V] works when UserType implements Hashable +
-- Equatable. The runtime routes key hashing + equality through
-- the user's impls, so two structurally-equal record values hash
-- and compare the same even if they are distinct allocations.
import:
	dict: contains, dict, get, set, with_capacity
	test: TestSuite


record Widget {
	id: Int,
	tag: Int
}


implements Equatable for Widget:
	pure func equals(a: Widget, b: Widget) -> Bool:
		a.id == b.id and a.tag == b.tag


implements Hashable for Widget:
	pure func hash(self: Widget) -> Int:
		self.id * 31 + self.tag


func test_insert_then_get() -> Bool:
	var d: Dict[Widget, Int] = dict()
	d = d.set({
			id = 1,
			tag = 10
		}, 100)
	d = d.set({
			id = 2,
			tag = 20
		}, 200)
	match d.get({
		id = 1,
		tag = 10
	}):
		Some(v): v == 100
		None: False


func test_different_allocs_same_key() -> Bool:
	-- Two identical-by-value records are distinct allocations.
	-- The dict must still treat them as the same key.
	var d: Dict[Widget, Int] = dict()
	d = d.set({
			id = 5,
			tag = 5
		}, 42)
	a: Widget = {
		id = 5,
		tag = 5
	}
	b: Widget = {
		id = 5,
		tag = 5
	}
	match d.get(a):
		Some(va):
			match d.get(b):
				Some(vb): va == 42 and vb == 42
				None: False
		None: False


func test_distinct_keys_stay_distinct() -> Bool:
	var d: Dict[Widget, Int] = dict()
	d = d.set({
			id = 1,
			tag = 1
		}, 11)
	d = d.set({
			id = 2,
			tag = 2
		}, 22)
	match d.get({
		id = 1,
		tag = 1
	}):
		Some(a):
			match d.get({
				id = 2,
				tag = 2
			}):
				Some(b): a == 11 and b == 22
				None: False
		None: False


func test_contains() -> Bool:
	var d: Dict[Widget, Int] = dict()
	d = d.set({
			id = 7,
			tag = 3
		}, 99)
	d.contains({
		id = 7,
		tag = 3
	}) and not d.contains({
		id = 7,
		tag = 4
	})


func test_with_capacity_uses_user_key_traits() -> Bool:
	var d: Dict[Widget, Int] = with_capacity(64)
	d = d.set({
			id = 9,
			tag = 2
		}, 902)
	match d.get({
		id = 9,
		tag = 2
	}):
		Some(v): v == 902
		None: False


tests: TestSuite = {
	description = "Dict with user-defined Hashable+Equatable keys",
	tests = [
		("insert then get", test_insert_then_get),
		("different allocs same key", test_different_allocs_same_key),
		("distinct keys stay distinct", test_distinct_keys_stay_distinct),
		("contains", test_contains),
		("with capacity uses user key traits", test_with_capacity_uses_user_key_traits),
	]
}
