import:
	dict as D
	test: TestSuite


func test_eq_int_int() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10), (2, 20)])
	b: Dict[Int, Int] = D.from_list([(1, 10), (2, 20)])
	a == b


func test_eq_string_int() -> Bool:
	a: Dict[String, Int] = D.set(D.set(D.dict(), "a", 1), "b", 2)
	b: Dict[String, Int] = D.set(D.set(D.dict(), "a", 1), "b", 2)
	a == b


func test_neq_value() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10)])
	b: Dict[Int, Int] = D.from_list([(1, 99)])
	a != b


func test_neq_size() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10)])
	b: Dict[Int, Int] = D.from_list([(1, 10), (2, 20)])
	a != b


func test_eq_empty() -> Bool:
	a: Dict[Int, Int] = D.dict()
	b: Dict[Int, Int] = D.dict()
	a == b


func test_eq_same_ref() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10)])
	a == a


func test_eq_ignores_insertion_order() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10), (2, 20), (3, 30)])
	b: Dict[Int, Int] = D.from_list([(3, 30), (1, 10), (2, 20)])
	a == b and not (a != b)


func test_neq_same_size_different_keys() -> Bool:
	a: Dict[Int, Int] = D.from_list([(1, 10), (2, 20)])
	b: Dict[Int, Int] = D.from_list([(1, 10), (3, 20)])
	a != b and not (a == b)


func test_string_values_compare_by_content() -> Bool:
	-- Built at runtime so equal values live in separate strings.
	suffix: String = "x" + D.from_list([(1, 1)]).length().to_string()
	a: Dict[Int, String] = D.from_list([(1, "v" + suffix)])
	b: Dict[Int, String] = D.from_list([(1, "vx1")])
	c: Dict[Int, String] = D.from_list([(1, "vx2")])
	a == b and not (a != b) and a != c


tests: TestSuite = {
	description = "Dict Equality",
	tests = [
		("eq int int", test_eq_int_int),
		("eq string int", test_eq_string_int),
		("neq value", test_neq_value),
		("neq size", test_neq_size),
		("eq empty", test_eq_empty),
		("eq same ref", test_eq_same_ref),
		("eq ignores insertion order", test_eq_ignores_insertion_order),
		("neq same size different keys", test_neq_same_size_different_keys),
		("string values compare by content", test_string_values_compare_by_content),
	]
}
