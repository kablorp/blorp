import:
	dict as Dict
	set as S
	test: TestSuite


tests: TestSuite = {
	description = "Hash table resize",
	tests = [
		("dict 100 int keys", func():
			var d: Dict[Int, Int] = Dict.dict()
			for i in 0..100:
				d = Dict.set(d, i, i * 10)
			ok1: Bool = match Dict.get(d, 0):
				Some(v): v == 0
				None: False
			ok2: Bool = match Dict.get(d, 50):
				Some(v): v == 500
				None: False
			ok3: Bool = match Dict.get(d, 99):
				Some(v): v == 990
				None: False
			ok1 and ok2 and ok3 and d.length() == 100
		),
		("dict 20 string keys", func():
			var d: Dict[String, Int] = Dict.dict()
			d = Dict.set(d, "alpha", 1)
			d = Dict.set(d, "bravo", 2)
			d = Dict.set(d, "charlie", 3)
			d = Dict.set(d, "delta", 4)
			d = Dict.set(d, "echo", 5)
			d = Dict.set(d, "foxtrot", 6)
			d = Dict.set(d, "golf", 7)
			d = Dict.set(d, "hotel", 8)
			d = Dict.set(d, "india", 9)
			d = Dict.set(d, "juliet", 10)
			d = Dict.set(d, "kilo", 11)
			d = Dict.set(d, "lima", 12)
			d = Dict.set(d, "mike", 13)
			d = Dict.set(d, "november", 14)
			d = Dict.set(d, "oscar", 15)
			d = Dict.set(d, "papa", 16)
			d = Dict.set(d, "quebec", 17)
			d = Dict.set(d, "romeo", 18)
			d = Dict.set(d, "sierra", 19)
			d = Dict.set(d, "tango", 20)
			ok_len: Bool = d.length() == 20
			ok_tango: Bool = match Dict.get(d, "tango"):
				Some(v): v == 20
				None: False
			ok_alpha: Bool = match Dict.get(d, "alpha"):
				Some(v): v == 1
				None: False
			ok_len and ok_tango and ok_alpha
		),
		("dict update after resize", func():
			var d: Dict[Int, Int] = Dict.dict()
			for i in 0..50:
				d = Dict.set(d, i, i)
			d = Dict.set(d, 25, 999)
			match Dict.get(d, 25):
				Some(v): v == 999
				None: False
		),
		("dict remove after resize", func():
			var d: Dict[Int, Int] = Dict.dict()
			for i in 0..50:
				d = Dict.set(d, i, i)
			d = Dict.remove(d, 25)
			d.length() == 49 and not Dict.contains(
				d,
				25,
			) and Dict.contains(d, 24) and Dict.contains(d, 26)
		),
		("set 100 elements", func():
			var s: Set[Int] = S.set()
			for i in 0..100:
				s = S.add(s, i)
			has_first: Bool = S.contains(s, 0)
			has_mid: Bool = S.contains(s, 50)
			has_last: Bool = S.contains(s, 99)
			no_extra: Bool = not S.contains(s, 100)
			s.length() == 100 and has_first and has_mid and has_last and no_extra
		),
		("set remove after resize", func():
			var s: Set[Int] = S.set()
			for i in 0..50:
				s = S.add(s, i)
			s = S.remove(s, 25)
			s.length() == 49 and not S.contains(s, 25) and S.contains(s, 24)
		),
		("dict keys after resize", func():
			var d: Dict[Int, Int] = Dict.dict()
			for i in 0..20:
				d = Dict.set(d, i, i * 2)
			Dict
				.keys(d)
				.length() == 20
		)
	]
}
