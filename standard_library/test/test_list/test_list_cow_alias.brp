-- Test List COW Alias Independence
import:
	list: List, append, length
	test: TestSuite


func append_in_func(lst: List[Int]) -> List[Int]:
	lst.append(99)


tests: TestSuite = {
	description = "List COW Alias Independence",
	tests = [
		("alias append", func():
			var items: List[Int] = [1, 2, 3]
			backup: List[Int] = items
			items = items.append(4)
			backup.length() == 3
		),
		("multiple aliases", func():
			var items: List[Int] = [10, 20]
			a: List[Int] = items
			b: List[Int] = items
			items = items.append(30)
			a.length() == 2 and b.length() == 2 and items.length() == 3
		),
		("function param", func():
			original: List[Int] = [1, 2, 3]
			result: List[Int] = append_in_func(original)
			original.length() == 3 and result.length() == 4
		),
		("loop alias", func():
			var items: List[Int] = [1]
			backup: List[Int] = items
			var i: Int = 0
			while i < 5:
				items = items.append(i)
				i += 1
			backup.length() == 1 and items.length() == 6
		)
	]
}
