-- Test for-in loop iteration
import:
	test: TestSuite


-- Helper functions that define for-in behavior (the core of what's tested)
func sum_list(nums: List[Int]) -> Int:
	var total: Int = 0
	for n in nums:
		total += n
	total


func count_elements(items: List[Int]) -> Int:
	var count: Int = 0
	for _ in items:
		count += 1
	count


func double_sum(nums: List[Int]) -> Int:
	var total: Int = 0
	for n in nums:
		total = total + n + n
	total


func concat_strings(items: List[String]) -> String:
	var result: String = ""
	for s in items:
		result += s
	result


func sum_floats(nums: List[Float]) -> Float:
	var total: Float = 0.0
	for n in nums:
		total += n
	total


func count_true(flags: List[Bool]) -> Int:
	var count: Int = 0
	for flag in flags:
		if flag:
			count += 1
	count


func count_some(items: List[Option[Int]]) -> Int:
	var count: Int = 0
	for item in items:
		match item:
			Some(n): count += 1
			None: void
	count


tests: TestSuite = {
	description = "For-in loop tests",
	tests = [
		("sum empty list", func(): sum_list([]) == 0),
		("sum single element", func(): sum_list([42]) == 42),
		("sum multiple elements", func(): sum_list([1, 2, 3, 4, 5]) == 15),
		("count empty list", func(): count_elements([]) == 0),
		("count multiple elements", func(): count_elements([10, 20, 30]) == 3),
		("double sum", func(): double_sum([1, 2, 3]) == 12),
		("string iteration", func(): concat_strings(["hello", " ", "world"]) == "hello world"),
		("float iteration", func(): sum_floats([1.5, 2.5, 3.0]) == 7.0),
		("bool iteration", func(): count_true([
				True,
				False,
				True,
				True
			]) == 3),
		("for-in match on generic elements", func(): count_some([
				Some(1),
				None,
				Some(2),
				None,
				Some(3)
			]) == 3),
		("for-in tuple destructuring", func():
			pairs: List[(Int, Int)] = [(1, 10), (2, 20), (3, 30)]
			var total: Int = 0
			for (key, value) in pairs:
				total = total + key + value
			total == 66
		),
		("for-in tuple wildcard first", func():
			pairs: List[(Int, Int)] = [(1, 10), (2, 20), (3, 30)]
			var total: Int = 0
			for (_, value) in pairs:
				total += value
			total == 60
		),
		("for-in tuple wildcard second", func():
			pairs: List[(Int, Int)] = [(1, 10), (2, 20), (3, 30)]
			var total: Int = 0
			for (key, _) in pairs:
				total += key
			total == 6
		)
	]
}
