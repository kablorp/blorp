import:
	list:
		binary_search,
		binary_search_by,
		chunks,
		concat,
		drop,
		flatten,
		intersperse,
		range,
		repeat,
		take,
		unique,
		windows,
	test: TestSuite
	traits: Equatable


record CleanupUniqueItem {
	id: Int,
	label: Int
}


implements Equatable for CleanupUniqueItem:
	pure func equals(a: CleanupUniqueItem, b: CleanupUniqueItem) -> Bool:
		a.id == b.id


pure func cleanup_unique_item(id: Int, label: Int) -> CleanupUniqueItem:
	{
		id = id,
		label = label
	}


func test_concat_values() -> Bool:
	result: List[Int] = [1, 2].concat([3, 4])
	ok_len: Bool = result.length() == 4
	ok_first: Bool = match result.get(0):
		Some(v): v == 1
		None: False
	ok_last: Bool = match result.get(3):
		Some(v): v == 4
		None: False
	ok_len and ok_first and ok_last


func test_concat_empty_inputs() -> Bool:
	left: List[Int] = []
	right: List[Int] = []
	left
		.concat([1, 2])
		.length() == 2 and [1, 2]
		.concat(right)
		.length() == 2 and left
		.concat(right)
		.length() == 0


func test_take_drop_slices() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	head: List[Int] = nums.take(3)
	tail: List[Int] = nums.drop(2)
	ok_head: Bool = head.length() == 3 and match head.get(2):
		Some(v): v == 3
		None: False
	ok_tail: Bool = tail.length() == 3 and match tail.get(0):
		Some(v): v == 3
		None: False
	ok_head and ok_tail


func test_take_drop_clamps() -> Bool:
	nums: List[Int] = [1, 2]
	nums
		.take(10)
		.length() == 2 and nums
		.take(0)
		.length() == 0 and nums
		.drop(10)
		.length() == 0 and nums
		.drop(0)
		.length() == 2


func test_flatten_values() -> Bool:
	nested: List[List[Int]] = [[1, 2], [], [3]]
	result: List[Int] = flatten(nested)
	ok_len: Bool = result.length() == 3
	ok_last: Bool = match result.get(2):
		Some(v): v == 3
		None: False
	ok_len and ok_last


func test_repeat_values() -> Bool:
	result: List[Int] = 7.repeat(3)
	ok_len: Bool = result.length() == 3
	ok_mid: Bool = match result.get(1):
		Some(v): v == 7
		None: False
	ok_len and ok_mid and 7
		.repeat(0)
		.length() == 0


func test_repeat_string_selects_list_repeat() -> Bool:
	result: List[String] = "x".repeat(2)
	result.length() == 2


func test_range_values() -> Bool:
	result: List[Int] = range(3, 6)
	ok_len: Bool = result.length() == 3
	ok_first: Bool = match result.get(0):
		Some(v): v == 3
		None: False
	ok_last: Bool = match result.get(2):
		Some(v): v == 5
		None: False
	ok_len and ok_first and ok_last and range(5, 3).length() == 0


func test_intersperse_values() -> Bool:
	result: List[Int] = [1, 2, 3].intersperse(0)
	var signature: Int = 0
	for v in result:
		signature = signature * 10 + v
	result.length() == 5 and signature == 10203


func test_intersperse_edges() -> Bool:
	single_result: List[Int] = [42].intersperse(0)
	var single_sum: Int = 0
	for v in single_result:
		single_sum += v
	single_result.length() == 1 and single_sum == 42


func test_windows_values() -> Bool:
	nums: List[Int] = [1, 2, 3, 4]
	result: List[List[Int]] = nums.windows(2)
	var outer_count: Int = 0
	var total_len: Int = 0
	var signature: Int = 0
	for window in result:
		outer_count += 1
		total_len += window.length()
		for v in window:
			signature = signature * 10 + v
	result.length() == 3 and outer_count == 3 and total_len == 6 and signature == 122334


func test_windows_edges() -> Bool:
	nums: List[Int] = [1, 2]
	too_large: List[List[Int]] = nums.windows(5)
	zero: List[List[Int]] = nums.windows(0)
	too_large.length() == 0 and zero.length() == 0


func test_chunks_values() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	result: List[List[Int]] = nums.chunks(2)
	var outer_count: Int = 0
	var total_len: Int = 0
	var signature: Int = 0
	for chunk in result:
		outer_count += 1
		total_len += chunk.length()
		for v in chunk:
			signature = signature * 10 + v
	result.length() == 3 and outer_count == 3 and total_len == 5 and signature == 12345


func test_chunks_edges() -> Bool:
	nums: List[Int] = [1, 2]
	zero: List[List[Int]] = nums.chunks(0)
	negative: List[List[Int]] = nums.chunks(-1)
	oversized: List[List[Int]] = nums.chunks(5)
	zero.length() == 0 and negative.length() == 0 and oversized.length() == 1


func test_unique_values() -> Bool:
	nums: List[Int] = [3, 1, 2, 1, 3]
	result: List[Int] = nums.unique()
	var signature: Int = 0
	for v in result:
		signature = signature * 10 + v
	result.length() == 3 and signature == 312


func test_unique_user_equatable_dispatch() -> Bool:
	items: List[CleanupUniqueItem] = [
		cleanup_unique_item(1, 10),
		cleanup_unique_item(2, 20),
		cleanup_unique_item(1, 30),
	]
	result: List[CleanupUniqueItem] = items.unique()
	var ids: Int = 0
	var labels: Int = 0
	for item in result:
		ids = ids * 10 + item.id
		labels = labels * 100 + item.label
	result.length() == 2 and ids == 12 and labels == 1020


func test_binary_search_values() -> Bool:
	nums: List[Int] = [1, 3, 5, 7, 9]
	found: Bool = match nums.binary_search(5):
		Some(i): i == 2
		None: False
	missing: Bool = match nums.binary_search(6):
		Some(_): False
		None: True
	empty: List[Int] = []
	empty_missing: Bool = match empty.binary_search(1):
		Some(_): False
		None: True
	found and missing and empty_missing


func test_binary_search_string_values() -> Bool:
	words: List[String] = ["ant", "bee", "cat", "dog"]
	found: Bool = match words.binary_search("cat"):
		Some(i): i == 2
		None: False
	missing: Bool = match words.binary_search("cow"):
		Some(_): False
		None: True
	found and missing


func test_binary_search_by_values() -> Bool:
	words: List[String] = ["ant", "bee", "cat", "dog"]
	cmp: pure (String, String) -> Int = pure func(a: String, b: String) -> Int:
		if a == b:
			0
		else if a < b:
			-1
		else:
			1
	found: Bool = match words.binary_search_by("cat", cmp):
		Some(i): i == 2
		None: False
	missing: Bool = match words.binary_search_by("cow", cmp):
		Some(_): False
		None: True
	found and missing


tests: TestSuite = {
	description = "List cleanup IR",
	tests = [
		("concat values", test_concat_values),
		("concat empty inputs", test_concat_empty_inputs),
		("take/drop slices", test_take_drop_slices),
		("take/drop clamps", test_take_drop_clamps),
		("flatten values", test_flatten_values),
		("repeat values", test_repeat_values),
		("repeat string selects list repeat", test_repeat_string_selects_list_repeat),
		("range values", test_range_values),
		("intersperse values", test_intersperse_values),
		("intersperse edges", test_intersperse_edges),
		("windows values", test_windows_values),
		("windows edges", test_windows_edges),
		("chunks values", test_chunks_values),
		("chunks edges", test_chunks_edges),
		("unique values", test_unique_values),
		("unique user Equatable dispatch", test_unique_user_equatable_dispatch),
		("binary search values", test_binary_search_values),
		("binary search string values", test_binary_search_string_values),
		("binary search by values", test_binary_search_by_values),
	]
}
