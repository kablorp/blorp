import:
	test: TestSuite


func match_command(args: List[String]) -> String:
	match args:
		["help"]: "help-bare"
		[_, "help"]: "help-with-prefix"
		[_, "version"]: "got-version"
		_: "unknown"


func test_exact_match() -> Bool:
	match_command(["help"]) == "help-bare"


func test_prefix_help() -> Bool:
	match_command(["cmd", "help"]) == "help-with-prefix"


func test_prefix_version() -> Bool:
	match_command(["cmd", "version"]) == "got-version"


func test_no_match() -> Bool:
	match_command(["cmd", "other"]) == "unknown"


func test_wrong_length() -> Bool:
	match_command(["a", "b", "c"]) == "unknown"


func match_ints(nums: List[Int]) -> String:
	match nums:
		[1, 2, 3]: "one-two-three"
		[0, ...rest]: "starts-with-zero"
		_: "other"


func test_int_exact() -> Bool:
	match_ints([1, 2, 3]) == "one-two-three"


func test_int_prefix() -> Bool:
	match_ints([0, 5, 10]) == "starts-with-zero"


func test_int_no_match() -> Bool:
	match_ints([5, 6, 7]) == "other"


tests: TestSuite = {
	description = "List Pattern Literals",
	tests = [
		("exact string match", test_exact_match),
		("prefix help", test_prefix_help),
		("prefix version", test_prefix_version),
		("no match", test_no_match),
		("wrong length", test_wrong_length),
		("int exact", test_int_exact),
		("int prefix", test_int_prefix),
		("int no match", test_int_no_match),
	]
}
