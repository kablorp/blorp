-- List literals retain managed record elements and release them with the list.
import:
	memory:
		MemoryCounter(ManagedAllocations, ManagedReleases, LiveManagedObjects, MemoryStatsActive, OracleStatsActive),
		read_memory_counter,
		reset_mem_stats,
	test: TestSuite


record Pair {
	a: Int,
	b: Int
}


pure func list_literal_retains_authored_records() -> Bool:
	pairs: List[Pair] = [{
			a = 0,
			b = 0
		}, {
			a = 1,
			b = 2
		}, {
			a = 2,
			b = 4
		}, {
			a = 3,
			b = 6
		}, {
			a = 4,
			b = 8
		}, {
			a = 5,
			b = 10
		}, {
			a = 6,
			b = 12
		}, {
			a = 7,
			b = 14
		}]
	var total: Int = 0
	for p in pairs:
		total += p.a + p.b
	live_objects: Int = read_memory_counter(LiveManagedObjects)
	-- This later use keeps the list and its eight record owners alive at the observation.
	live_objects == 9 and total == 84 and pairs.length() == 8


func test_record_list_literal_releases_all_owners() -> Bool:
	reset_mem_stats()
	active_before: Bool = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	values_preserved: Bool = list_literal_retains_authored_records()
	-- Eight authored records and one list, with no surviving owner after the helper.
	(
		active_before and values_preserved
		and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
		and read_memory_counter(ManagedAllocations) == 9
		and read_memory_counter(ManagedReleases) == 9
		and read_memory_counter(LiveManagedObjects) == 0
	)


tests: TestSuite = {
	description = "Managed Record List Memory",
	tests = [
		(
			"record list literal retains and releases exactly its authored owners",
			test_record_list_literal_releases_all_owners,
		),
	]
}
