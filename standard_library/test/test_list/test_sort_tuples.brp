-- Bug #15: sort_desc_by + sort_by on different tuple types crashes
-- Using sort_desc_by on List[(String, Int)] followed by sort_by on
-- List[(Int, Int)] in the same program causes exit 103/118 (RC corruption)
import:
	list: sort_by, sort_desc_by
	test: TestSuite


-- sort_by on (String, Int) by int — works alone
func test_sort_string_int_by_int() -> Bool:
	pairs: List[(String, Int)] = [("c", 3), ("a", 1), ("b", 2)]
	sorted: List[(String, Int)] = pairs.sort_by(func(p: (String, Int)): p[1])
	var first: String = ""
	var i: Int = 0
	for (name, val) in sorted:
		if i == 0:
			first = name
		i += 1
	first == "a"


-- sort_desc_by on (String, Int) — works alone
func test_sort_desc_string_int() -> Bool:
	pairs: List[(String, Int)] = [("c", 3), ("a", 1), ("b", 2)]
	sorted: List[(String, Int)] = pairs.sort_desc_by(func(p: (String, Int)): p[1])
	var first: String = ""
	var i: Int = 0
	for (name, val) in sorted:
		if i == 0:
			first = name
		i += 1
	first == "c"


-- sort_by on (Int, Int) by second element — crashes when previous tests
-- used sort_desc_by on a different tuple type
func test_sort_int_int_after_string_int() -> Bool:
	pairs: List[(Int, Int)] = [(1, 30), (2, 10), (3, 20)]
	sorted: List[(Int, Int)] = pairs.sort_by(func(p: (Int, Int)): p[1])
	var first_a: Int = 0
	var i: Int = 0
	for (a, b) in sorted:
		if i == 0:
			first_a = a
		i += 1
	first_a == 2


-- sort_by on (String, Int) by string key
func test_sort_string_int_by_string() -> Bool:
	pairs: List[(String, Int)] = [("banana", 2), ("apple", 1), ("cherry", 3)]
	sorted: List[(String, Int)] = pairs.sort_by(func(p: (String, Int)): p[0])
	var first: String = ""
	var i: Int = 0
	for (name, _) in sorted:
		if i == 0:
			first = name
		i += 1
	first == "apple"


tests: TestSuite = {
	description = "sort_by on tuple lists",
	tests = [
		("sort (String, Int) by int", test_sort_string_int_by_int),
		("sort_desc (String, Int) by int", test_sort_desc_string_int),
		("sort (Int, Int) after (String, Int)", test_sort_int_int_after_string_int),
		("sort (String, Int) by string", test_sort_string_int_by_string),
	]
}
