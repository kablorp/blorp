import:
	set: Set, add, combine, contains, from_list, remove, set as set_new, to_list
	test: TestSuite


func test_string_set_dynamic() -> Bool:
	var s: Set[String] = set_new()
	s = s.add("hello")
	dynamic: String = "hel" + "lo"
	s.contains(dynamic)


func test_string_set_dedup() -> Bool:
	var s: Set[String] = set_new()
	s = s.add("a")
	s = s.add("b")
	s = s.add("a")
	s.length() == 2


func test_float_set() -> Bool:
	var s: Set[Float] = set_new()
	s = s.add(3.14)
	s = s.add(2.71)
	s = s.add(3.14)
	s.length() == 2 and s.contains(3.14) and s.contains(2.71)


tests: TestSuite = {
	description = "Set operations",
	tests = [
		("string dynamic contains", test_string_set_dynamic),
		("string dedup", test_string_set_dedup),
		("float set", test_float_set),
		("int basic", func():
			var s: Set[Int] = set_new()
			s = s.add(1)
			s = s.add(2)
			s = s.add(1)
			s.length() == 2 and s.contains(1) and s.contains(2)
		),
		("remove", func():
			var s: Set[Int] = from_list([1, 2, 3])
			s = s.remove(2)
			s.length() == 2 and s.contains(1) and not s.contains(2)
		),
		("to_list", func():
			s: Set[Int] = from_list([3, 1, 2])
			items: List[Int] = s.to_list()
			items.length() == 3
		),
		("empty", func():
			s: Set[Int] = set_new()
			s.length() == 0 and not s.contains(42)
		),
		("combine", func():
			a: Set[Int] = from_list([1, 2])
			b: Set[Int] = from_list([2, 3])
			c: Set[Int] = combine(a, b)
			c.length() == 3
		)
	]
}
