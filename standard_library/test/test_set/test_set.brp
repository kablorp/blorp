import:
	set as S
	test: TestSuite


func test_empty_set_has_length_zero() -> Bool:
	var s: Set[Int] = S.set()
	s.length() == 0


func test_add_and_contains() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 42)
	S.contains(s, 42)


func test_contains_missing_element() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 1)
	not S.contains(s, 99)


func test_remove_deletes_element() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 10)
	s = S.remove(s, 10)
	not S.contains(s, 10)


func test_add_duplicate_is_idempotent() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 5)
	s = S.add(s, 5)
	s.length() == 1


func test_string_elements_work() -> Bool:
	var s: Set[String] = S.set()
	s = S.add(s, "hello")
	s = S.add(s, "world")
	S.contains(s, "hello") and S.contains(s, "world")


func test_length_tracks_additions() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 1)
	s = S.add(s, 2)
	s = S.add(s, 3)
	s.length() == 3


func test_length_decreases_after_remove() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 1)
	s = S.add(s, 2)
	s = S.remove(s, 1)
	s.length() == 1


func test_combine_union() -> Bool:
	var a: Set[Int] = S.set()
	a = S.add(a, 1)
	a = S.add(a, 2)
	var b: Set[Int] = S.set()
	b = S.add(b, 2)
	b = S.add(b, 3)
	var c: Set[Int] = S.combine(a, b)
	c.length() == 3 and S.contains(c, 1) and S.contains(c, 2) and S.contains(c, 3)


func test_intersect() -> Bool:
	var a: Set[Int] = S.from_list([1, 2, 3])
	var b: Set[Int] = S.from_list([2, 3, 4])
	var c: Set[Int] = S.intersect(a, b)
	c.length() == 2 and S.contains(c, 2) and S.contains(c, 3)


func test_difference() -> Bool:
	var a: Set[Int] = S.from_list([1, 2, 3])
	var b: Set[Int] = S.from_list([2, 3])
	var c: Set[Int] = S.difference(a, b)
	c.length() == 1 and S.contains(c, 1)


func test_from_list_deduplicates() -> Bool:
	var s: Set[Int] = S.from_list([1, 2, 3, 2, 1])
	s.length() == 3


func test_for_in_iterates_elements() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 10)
	s = S.add(s, 20)
	s = S.add(s, 30)
	var total: Int = 0

	for elem in s:
		total += elem

	total == 60


func test_cow_alias_independence() -> Bool:
	var a: Set[Int] = S.set()
	a = S.add(a, 1)
	a = S.add(a, 2)
	var b: Set[Int] = a
	b = S.add(b, 3)
	a.length() == 2 and b.length() == 3


func test_is_empty() -> Bool:
	var s: Set[Int] = S.set()
	S.is_empty(s)


func test_is_subset() -> Bool:
	var a: Set[Int] = S.from_list([1, 2])
	var b: Set[Int] = S.from_list([1, 2, 3])
	S.is_subset(a, b) and not S.is_subset(b, a)


func test_is_superset() -> Bool:
	var a: Set[Int] = S.from_list([1, 2, 3])
	var b: Set[Int] = S.from_list([1, 2])
	S.is_superset(a, b)


func test_insertion_order_preserved() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 30)
	s = S.add(s, 10)
	s = S.add(s, 20)
	items: List[Int] = S.to_list(s)
	items.get(0).get_or(0) == 30 and items.get(1).get_or(0) == 10 and items.get(2).get_or(0) == 20


func test_order_preserved_after_remove() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 10)
	s = S.add(s, 20)
	s = S.add(s, 30)
	s = S.remove(s, 20)
	items: List[Int] = S.to_list(s)
	items.get(0).get_or(0) == 10 and items.get(1).get_or(0) == 30


func test_set_union_alias() -> Bool:
	var a: Set[Int] = S.from_list([1, 2])
	var b: Set[Int] = S.from_list([2, 3])
	var c: Set[Int] = S.set_union(a, b)
	c.length() == 3 and S.contains(c, 1) and S.contains(c, 2) and S.contains(c, 3)


func test_set_map() -> Bool:
	var s: Set[Int] = S.from_list([1, 2, 3])
	var result: Set[Int] = S.map(s, pure func(x: Int): x * 10)
	S.contains(result, 10) and S.contains(result, 20) and S.contains(result, 30)


func test_set_filter() -> Bool:
	var s: Set[Int] = S.from_list([1, 2, 3, 4, 5])
	var result: Set[Int] = S.filter(s, pure func(x: Int): x % 2 == 0)
	result.length() == 2 and S.contains(result, 2) and S.contains(result, 4)


func test_set_fold() -> Bool:
	var s: Set[Int] = S.from_list([1, 2, 3])
	var total: Int = S.fold(
		s,
		0,
		pure func(acc: Int, x: Int): acc + x,
	)
	total == 6


tests: TestSuite = {
	description = "Set Tests",
	tests = [
		("Empty set has length 0", test_empty_set_has_length_zero),
		("Add and contains", test_add_and_contains),
		("Contains missing element", test_contains_missing_element),
		("Remove deletes element", test_remove_deletes_element),
		("Add duplicate is idempotent", test_add_duplicate_is_idempotent),
		("String elements work", test_string_elements_work),
		("Length tracks additions", test_length_tracks_additions),
		("Length decreases after remove", test_length_decreases_after_remove),
		("Combine (union)", test_combine_union),
		("Intersect", test_intersect),
		("Difference", test_difference),
		("From list deduplicates", test_from_list_deduplicates),
		("For-in iterates elements", test_for_in_iterates_elements),
		("COW alias independence", test_cow_alias_independence),
		("Is empty", test_is_empty),
		("Is subset", test_is_subset),
		("Is superset", test_is_superset),
		("Insertion order preserved", test_insertion_order_preserved),
		("Order preserved after remove", test_order_preserved_after_remove),
		("Set union alias", test_set_union_alias),
		("Set map", test_set_map),
		("Set filter", test_set_filter),
		("Set fold", test_set_fold),
	]
}
