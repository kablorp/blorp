-- Struct list literals should use inline element storage, not one box per item.
import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


struct Pair {
	a: Int,
	b: Int
}


func test_struct_list_literal_no_per_element_alloc() -> Bool:
	reset_mem_stats()
	pairs: List[Pair] = [{
			a = 0,
			b = 0
		}, {
			a = 1,
			b = 2
		}, {
			a = 2,
			b = 4
		}, {
			a = 3,
			b = 6
		}, {
			a = 4,
			b = 8
		}, {
			a = 5,
			b = 10
		}, {
			a = 6,
			b = 12
		}, {
			a = 7,
			b = 14
		}]
	var total: Int = 0
	for p in pairs:
		total += p.a + p.b
	stats: MemStats = get_mem_stats()
	total == 84 and stats.total_allocations < 5


tests: TestSuite = {
	description = "Struct List Memory",
	tests = [
		(
			"struct list literal: no per-element alloc",
			test_struct_list_literal_no_per_element_alloc,
		),
	]
}
