import:
	list: List, append, get, length
	memory: MemStats, get_mem_stats, is_unique, reset_mem_stats
	test: TestSuite


struct CanonicalPair {
	left: Int,
	right: Int
}


pure func empty_ints() -> List[Int]:
	[]


func test_repeated_empty_literals_do_not_allocate() -> Bool:
	reset_mem_stats()
	var checksum: Int = 0

	for _ in 0..1000:
		checksum += empty_ints().length()

	stats: MemStats = get_mem_stats()
	checksum == 0 and stats.total_allocations == 0 and stats.current_objects == 0


func test_first_append_detaches_canonical_empty() -> Bool:
	reset_mem_stats()
	var values: List[Int] = []
	empty_is_shared: Bool = not is_unique(values)
	values = values.append(42)
	stats: MemStats = get_mem_stats()

	(
		empty_is_shared
		and is_unique(values)
		and values.length() == 1
		and values.get(0) == Some(42)
		and stats.total_allocations == 1
		and stats.current_objects == 1
	)


func test_subsequent_append_reuses_detached_storage() -> Bool:
	reset_mem_stats()
	var values: List[Int] = []
	values = values.append(1)
	values = values.append(2)
	stats: MemStats = get_mem_stats()

	values == [1, 2] and stats.total_allocations == 1 and stats.current_objects == 1


pure func test_empty_alias_is_unchanged_after_append() -> Bool:
	var left: List[Int] = []
	right: List[Int] = left
	left = left.append(1)
	left == [1] and right.length() == 0


pure func exercise_managed_empty_append() -> Bool:
	var values: List[String] = []
	values = values.append(42.to_string())
	values = values.append(43.to_string())
	values == ["42", "43"]


func test_managed_empty_append_releases_elements() -> Bool:
	reset_mem_stats()
	valid: Bool = exercise_managed_empty_append()
	stats: MemStats = get_mem_stats()
	valid and stats.total_allocations == stats.total_releases and stats.current_objects == 0


pure func test_inline_struct_empty_append_preserves_stride() -> Bool:
	var pairs: List[CanonicalPair] = []
	pairs = pairs.append({
		left = 1,
		right = 2,
	})
	pairs = pairs.append({
		left = 3,
		right = 4,
	})
	var total: Int = 0

	for pair in pairs:
		total += pair.left + pair.right

	match pairs.get(1):
		Some(pair):
			total == 10 and pair.left == 3 and pair.right == 4
		None:
			False


pure func append_to_empty(value: Int) -> List[Int]:
	var result: List[Int] = []
	result = result.append(value)
	result


func test_concurrent_empty_consumers_detach_independently() -> Bool:
	concurrent:
		left = append_to_empty(1)
		right = append_to_empty(2)

	match left:
		Ok(left_values):
			match right:
				Ok(right_values):
					left_values == [1] and right_values == [2]
				Err(_):
					False
		Err(_):
			False


pure func test_empty_read_operations() -> Bool:
	values: List[Int] = []
	other: List[Int] = []
	var total: Int = 0

	for value in values:
		total += value

	values.length() == 0 and values == other and values.get(0) == None and total == 0


tests: TestSuite = {
	description = "Canonical empty list semantics",
	tests = [
		("repeated evaluation does not allocate", test_repeated_empty_literals_do_not_allocate),
		("first append detaches canonical empty", test_first_append_detaches_canonical_empty),
		("subsequent append reuses storage", test_subsequent_append_reuses_detached_storage),
		("alias remains empty after append", test_empty_alias_is_unchanged_after_append),
		("managed elements are released", test_managed_empty_append_releases_elements),
		("inline struct stride is preserved", test_inline_struct_empty_append_preserves_stride),
		(
			"concurrent consumers detach independently",
			test_concurrent_empty_consumers_detach_independently,
		),
		("empty read operations remain valid", test_empty_read_operations),
	]
}
