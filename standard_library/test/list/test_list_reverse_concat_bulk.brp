import:
	list: List, concat, get_or, length, reverse
	test: TestSuite


struct Pair {
	a: Int,
	b: Int
}


func test_reverse_preserves_inline_source() -> Bool:
	xs: List[Int] = [1, 2, 3, 4]
	ys: List[Int] = xs.reverse()
	xs == [1, 2, 3, 4] and ys == [4, 3, 2, 1]


func test_reverse_preserves_managed_source() -> Bool:
	xs: List[String] = ["a", "b", "c"]
	ys: List[String] = xs.reverse()
	xs == ["a", "b", "c"] and ys == ["c", "b", "a"]


func test_concat_preserves_managed_sources() -> Bool:
	left: List[String] = ["a", "b"]
	right: List[String] = ["c", "d"]
	joined: List[String] = left.concat(right)
	left == ["a", "b"] and right == ["c", "d"] and joined == ["a", "b", "c", "d"]


func test_concat_inline_structs() -> Bool:
	left: List[Pair] = [{
			a = 1,
			b = 2
		}]
	right: List[Pair] = [{
			a = 3,
			b = 4
		}, {
			a = 5,
			b = 6
		}]
	joined: List[Pair] = left.concat(right)
	first: Pair = joined.get_or(0, {
			a = 0,
			b = 0
		})
	second: Pair = joined.get_or(1, {
			a = 0,
			b = 0
		})
	third: Pair = joined.get_or(2, {
			a = 0,
			b = 0
		})
	joined.length() == 3 and first.a == 1 and first.b == 2 and second.a == 3 and second.b == 4 and third.a == 5 and third.b == 6


tests: TestSuite = {
	description = "List Reverse/Concat Bulk Copy",
	tests = [
		("reverse inline source", test_reverse_preserves_inline_source),
		("reverse managed source", test_reverse_preserves_managed_source),
		("concat managed sources", test_concat_preserves_managed_sources),
		("concat inline structs", test_concat_inline_structs),
	]
}
