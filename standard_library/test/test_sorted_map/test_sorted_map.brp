import:
	list as L
	sorted_map as SM: SortedMap
	test: TestSuite


-- Test new map is empty
func test_new_empty() -> Bool:
	m: SortedMap[Int, Int] = SM.sorted_map()
	SM.is_empty(m) and SM.map_length(m) == 0


-- Test insert and get
func test_insert_get() -> Bool:
	m: SortedMap[Int, Int] = SM.set(SM.sorted_map(), 1, 10)
	match SM.get(m, 1):
		Some(v): v == 10
		None: False


-- Test insert multiple
func test_insert_multiple() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 3, 30)
	m = SM.set(m, 1, 10)
	m = SM.set(m, 2, 20)
	SM.map_length(m) == 3


-- Test get nonexistent
func test_get_nonexistent() -> Bool:
	m: SortedMap[Int, Int] = SM.set(SM.sorted_map(), 1, 10)
	match SM.get(m, 99):
		Some(_): False
		None: True


-- Test update existing key
func test_update() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 1, 10)
	m = SM.set(m, 1, 20)
	if SM.map_length(m) != 1:
		False
	else:
		match SM.get(m, 1):
			Some(v): v == 20
			None: False


-- Test contains
func test_contains() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 1, 10)
	SM.has_key(m, 1) and not SM.has_key(m, 2)


-- Test remove
func test_remove() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 1, 10)
	m = SM.set(m, 2, 20)
	m = SM.remove(m, 1)
	SM.map_length(m) == 1 and not SM.has_key(m, 1)


-- Test remove nonexistent
func test_remove_nonexistent() -> Bool:
	m: SortedMap[Int, Int] = SM.set(SM.sorted_map(), 1, 10)
	m2: SortedMap[Int, Int] = SM.remove(m, 99)
	SM.map_length(m2) == 1


-- Test min
func test_min() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 3, 30)
	m = SM.set(m, 1, 10)
	m = SM.set(m, 2, 20)
	match SM.min(m):
		Some(pair): pair[0] == 1 and pair[1] == 10
		None: False


-- Test max
func test_max() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 1, 10)
	m = SM.set(m, 3, 30)
	m = SM.set(m, 2, 20)
	match SM.max(m):
		Some(pair): pair[0] == 3 and pair[1] == 30
		None: False


-- Test min/max empty
func test_min_max_empty() -> Bool:
	m: SortedMap[Int, Int] = SM.sorted_map()
	match SM.min(m):
		Some(_): False
		None:
			match SM.max(m):
				Some(_): False
				None: True


-- Test range query
func test_range() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 1, 10)
	m = SM.set(m, 2, 20)
	m = SM.set(m, 3, 30)
	m = SM.set(m, 4, 40)
	m = SM.set(m, 5, 50)
	r: List[(Int, Int)] = SM.range(m, 2, 4)
	L.length(r) == 3


-- Test keys
func test_keys() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 3, 30)
	m = SM.set(m, 1, 10)
	keys: List[Int] = SM.keys(m)
	match L.get(keys, 0):
		Some(k): k == 1
		None: False


-- Test values
func test_values() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 1, 10)
	m = SM.set(m, 2, 20)
	vals: List[Int] = SM.values(m)
	match L.get(vals, 0):
		Some(v): v == 10
		None: False


-- Test sorted order maintained
func test_sorted_order() -> Bool:
	var m: SortedMap[Int, Int] = SM.sorted_map()
	m = SM.set(m, 5, 50)
	m = SM.set(m, 1, 10)
	m = SM.set(m, 3, 30)
	keys: List[Int] = SM.keys(m)
	match L.get(keys, 0):
		Some(k0):
			match L.get(keys, 1):
				Some(k1):
					match L.get(keys, 2):
						Some(k2): k0 == 1 and k1 == 3 and k2 == 5
						None: False
				None: False
		None: False


tests: TestSuite = {
	description = "Sorted Map",
	tests = [
		("new empty", test_new_empty),
		("insert get", test_insert_get),
		("insert multiple", test_insert_multiple),
		("get nonexistent", test_get_nonexistent),
		("update key", test_update),
		("contains", test_contains),
		("remove", test_remove),
		("remove nonexistent", test_remove_nonexistent),
		("min", test_min),
		("max", test_max),
		("min max empty", test_min_max_empty),
		("range", test_range),
		("keys", test_keys),
		("values", test_values),
		("sorted order", test_sorted_order),
	]
}
