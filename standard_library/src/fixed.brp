-- Fixed - Fixed-point decimal type
--
-- Fixed is a decimal number with runtime-tracked scale and precision.
-- Internally stored as a scaled integer to avoid floating-point rounding errors.
--
-- Example:
-- price = fixed(19.99, 2)       -- scale=2 (cents)
-- rate = fixed(0.0825, 4)       -- scale=4 (basis points)
-- total = price * (1 + rate)    -- auto-normalizes, no type errors
--
-- Operations auto-normalize:
-- - Addition/Subtraction: converts to max scale
-- - Multiplication: scales add (0.01 * 0.01 = 0.0001)
-- - Division: uses extended precision with rounding
--
-- Negative scale is valid for large numbers:
-- millions = fixed(5000000.0, -6) -- represents 5,000,000
--
-- Arithmetic operators (+, -, *, /) and comparisons (<, >, ==, etc.)
-- are handled automatically by the compiler for Fixed types.
type Fixed = builtin


---
Create Fixed from Float with given scale (precision defaults to 18).

doctests:
    :: Create fixed with scale
    f: Fixed = fixed(19.99, 2)
    get_scale(f) == 2
---
pure func fixed(value: Float, scale: Int) -> Fixed:
	builtin("std/fixed.fixed")


---
Create Fixed with explicit precision.

doctests:
    :: Create with explicit precision
    f: Fixed = with_precision(1.5, 1, 10)
    get_precision(f) == 10
---
pure func with_precision(value: Float, scale: Int, precision: Int) -> Fixed:
	builtin("std/fixed.with_precision")


---
Create Fixed from Int.
---
pure func from_int(value: Int, scale: Int) -> Fixed:
	builtin("std/fixed.from_int")


---
Negation.
---
pure func neg(a: Fixed) -> Fixed:
	builtin("std/fixed.neg")


---
Round to a specific scale.

doctests:
    :: Round to fewer decimal places
    f: Fixed = fixed(3.14159, 5)
    r: Fixed = round_to(f, 2)
    get_scale(r) == 2
---
pure func round_to(f: Fixed, scale: Int) -> Fixed:
	builtin("std/fixed.round_to")


---
Get the scale of a Fixed value.

doctests:
    :: Get scale of fixed value
    f: Fixed = fixed(1.0, 3)
    get_scale(f) == 3
---
pure func get_scale(f: Fixed) -> Int:
	builtin("std/fixed.get_scale")


---
Get the precision of a Fixed value.

doctests:
    :: Default precision is 18
    f: Fixed = fixed(1.0, 2)
    get_precision(f) == 18
---
pure func get_precision(f: Fixed) -> Int:
	builtin("std/fixed.get_precision")


---
Convert Fixed to string representation.
---
pure func to_string(f: Fixed) -> String:
	builtin("std/fixed.to_string")


---
Convert Fixed to Int (truncates toward zero).
---
pure func to_int(f: Fixed) -> Int:
	builtin("std/fixed.to_int")


---
Convert Fixed to Float.
---
pure func to_float(f: Fixed) -> Float:
	builtin("std/fixed.to_float")


-- ============================================================================
-- Trait Implementations for Fixed
-- ============================================================================
-- Note: Addable, Subtractable, Multipliable, Divisible, Equatable, Orderable
-- are handled by built-in codegen for Fixed. The FixedPoint trait and its
-- supertraits are registered in the compiler builtin environment.
-- Only non-operator traits need explicit implementations here.
implements Stringable for Fixed:
	pure func to_string(val: Fixed) -> String:
		val.to_string()


implements HasZero for Fixed:
	pure func zero() -> Fixed:
		fixed(0.0, 0)
