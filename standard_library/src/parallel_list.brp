-- ParallelList - scoped combinators for List.parallel callbacks.
private pure func __parallel_list_map[T, U](
	self: ParallelList[T],
	f: pure (T) -> U,
) -> ParallelList[U]:
	builtin("blorp_map_parallel")


private pure func __parallel_list_filter[T](
	self: ParallelList[T],
	predicate: pure (T) -> Bool,
) -> ParallelList[T]:
	builtin("blorp_filter_parallel")


private pure func __parallel_list_filter_map[T, U](
	self: ParallelList[T],
	f: pure (T) -> Option[U],
) -> ParallelList[U]:
	builtin("blorp_filter_map_parallel")


---
Parallel map over a ParallelList.
---
pure func map[T, U](
	self: ParallelList[T],
	f: pure (T) -> U,
) -> ParallelList[U]:
	__parallel_list_map(self, f)


---
Parallel filter over a ParallelList.
---
pure func filter[T](
	self: ParallelList[T],
	predicate: pure (T) -> Bool,
) -> ParallelList[T]:
	__parallel_list_filter(self, predicate)


---
Parallel filter-map over a ParallelList.
---
pure func filter_map[T, U](
	self: ParallelList[T],
	f: pure (T) -> Option[U],
) -> ParallelList[U]:
	__parallel_list_filter_map(self, f)
