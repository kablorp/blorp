-- Stats — Statistical functions for numeric data
--
-- All functions operate on List[Float] and are pure.
-- For integer data, convert with to_float first.
--
-- Typical use: import the statistics functions you need from `stats`.
-- avg: Float = mean(data)
-- sd: Float = stddev(data)
import:
	float: sqrt


-- ============================================================================
-- Central Tendency
-- ============================================================================
---
Arithmetic mean of a list of floats.
Returns 0.0 for empty lists.

doctests:
    :: Mean of [1, 2, 3]
    mean([1.0, 2.0, 3.0]).approx_eq(2.0)

    :: Mean of single value
    mean([5.0]).approx_eq(5.0)

    :: Empty list
    mean([]) == 0.0
---
pure func mean(data: List[Float]) -> Float:
	n: Int = data.length()

	if n == 0:
		0.0
	else:
		var total: Float = 0.0

		for x in data:
			total += x

		total / to_float(n)


---
Median value (middle element, or average of two middle elements).
Returns 0.0 for empty lists.

---
pure func median(data: List[Float]) -> Float:
	n: Int = data.length()

	if n == 0:
		0.0
	else:
		median_sorted(data.sort(), n)


private pure func median_sorted(sorted: List[Float], n: Int) -> Float:
	mid: Int = n / 2

	if n % 2 == 1:
		get_float(sorted, mid)
	else:
		(get_float(sorted, mid - 1) + get_float(sorted, mid)) / 2.0


private pure func get_float(data: List[Float], idx: Int) -> Float:
	data.get_or(idx, 0.0)


---
Mode: the most frequently occurring value.
Returns None for empty lists. If multiple modes, returns the first encountered.
---
pure func mode(data: List[Float]) -> Option[Float]:
	n: Int = data.length()

	if n == 0:
		None
	else:
		var best_val: Float = 0.0
		var best_count: Int = 0

		for x in data:
			var n_matches: Int = 0

			for y in data:
				if x == y:
					n_matches += 1

			if n_matches > best_count:
				best_count = n_matches
				best_val = x

		Some(best_val)


-- ============================================================================
-- Dispersion
-- ============================================================================
---
Population variance (divides by N).

doctests:
    :: Variance of [2, 4, 4, 4, 5, 5, 7, 9]
    variance([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]).approx_eq(4.0)
---
pure func variance(data: List[Float]) -> Float:
	n: Int = data.length()

	if n == 0:
		0.0
	else:
		avg: Float = mean(data)
		var sum_sq: Float = 0.0

		for x in data:
			diff: Float = x - avg
			sum_sq += diff * diff

		sum_sq / to_float(n)


---
Sample variance (divides by N-1, Bessel's correction).
Returns 0.0 if fewer than 2 elements.
---
pure func sample_variance(data: List[Float]) -> Float:
	n: Int = data.length()

	if n < 2:
		0.0
	else:
		avg: Float = mean(data)
		var sum_sq: Float = 0.0

		for x in data:
			diff: Float = x - avg
			sum_sq += diff * diff

		sum_sq / to_float(n - 1)


---
Population standard deviation.

doctests:
    :: Stddev of [2, 4, 4, 4, 5, 5, 7, 9]
    stddev([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]).approx_eq(2.0)
---
pure func stddev(data: List[Float]) -> Float:
	sqrt(variance(data))


---
Sample standard deviation (Bessel's correction).
---
pure func sample_stddev(data: List[Float]) -> Float:
	sqrt(sample_variance(data))


-- ============================================================================
-- Range and Extremes
-- ============================================================================
---
Minimum value. Returns None for empty lists.
---
pure func min_val(data: List[Float]) -> Option[Float]:
	n: Int = data.length()

	if n == 0:
		None
	else:
		var m: Float = data.get_or(0, 0.0)

		for i in 1..n:
			match data.get(i):
				Some(x):
					if x < m:
						m = x
				None:
					void

		Some(m)


---
Maximum value. Returns None for empty lists.
---
pure func max_val(data: List[Float]) -> Option[Float]:
	n: Int = data.length()

	if n == 0:
		None
	else:
		var m: Float = data.get_or(0, 0.0)

		for i in 1..n:
			match data.get(i):
				Some(x):
					if x > m:
						m = x
				None:
					void

		Some(m)


---
Range: max - min. Returns 0.0 for empty lists.
---
pure func range(data: List[Float]) -> Float:
	match (min_val(data), max_val(data)):
		(Some(lo), Some(hi)):
			hi - lo
		_:
			0.0


-- ============================================================================
-- Percentiles and Quantiles
-- ============================================================================
---
Percentile using linear interpolation (same as numpy's default).
`p` should be in [0.0, 100.0].
---
pure func percentile(data: List[Float], p: Float) -> Float:
	n: Int = data.length()

	if n == 0:
		0.0
	else if n == 1:
		data.get_or(0, 0.0)
	else:
		sorted: List[Float] = data.sort()

		clamped: Float = if p < 0.0:
			0.0
		else if p > 100.0:
			100.0
		else:
			p

		rank: Float = clamped / 100.0 * to_float(n - 1)
		lo_idx: Int = to_int(rank)
		hi_idx: Int = lo_idx + 1
		frac: Float = rank - to_float(lo_idx)
		lo_val: Float = sorted.get_or(lo_idx, 0.0)

		if hi_idx >= n:
			lo_val
		else:
			hi_val: Float = sorted.get_or(hi_idx, 0.0)
			lo_val + frac * (hi_val - lo_val)


---
Quartiles: returns (Q1, Q2, Q3).
---
pure func quartiles(data: List[Float]) -> (Float, Float, Float):
	(percentile(data, 25.0), percentile(data, 50.0), percentile(data, 75.0))


---
Interquartile range (Q3 - Q1).
---
pure func iqr(data: List[Float]) -> Float:
	percentile(data, 75.0) - percentile(data, 25.0)


-- ============================================================================
-- Correlation and Regression
-- ============================================================================
---
Pearson correlation coefficient between two lists.
Returns 0.0 if lists differ in length or have fewer than 2 elements.
---
pure func correlation(xs: List[Float], ys: List[Float]) -> Float:
	n: Int = xs.length()

	if n != ys.length() or n < 2:
		0.0
	else:
		mx: Float = mean(xs)
		my: Float = mean(ys)
		var sum_xy: Float = 0.0
		var sum_xx: Float = 0.0
		var sum_yy: Float = 0.0

		for i in 0..n:
			xi: Float = xs.get_or(i, 0.0)
			yi: Float = ys.get_or(i, 0.0)
			dx: Float = xi - mx
			dy: Float = yi - my
			sum_xy += dx * dy
			sum_xx += dx * dx
			sum_yy += dy * dy

		denom: Float = sqrt(sum_xx * sum_yy)

		if denom == 0.0:
			0.0
		else:
			sum_xy / denom


---
Simple linear regression: returns (slope, intercept).
Fits y = slope * x + intercept using least squares.
Returns (0.0, 0.0) for insufficient data.
---
pure func linear_regression(xs: List[Float], ys: List[Float]) -> (Float, Float):
	n: Int = xs.length()

	if n != ys.length() or n < 2:
		(0.0, 0.0)
	else:
		mx: Float = mean(xs)
		my: Float = mean(ys)
		var sum_xy: Float = 0.0
		var sum_xx: Float = 0.0

		for i in 0..n:
			xi: Float = xs.get_or(i, 0.0)
			yi: Float = ys.get_or(i, 0.0)
			dx: Float = xi - mx
			dy: Float = yi - my
			sum_xy += dx * dy
			sum_xx += dx * dx

		if sum_xx == 0.0:
			(0.0, my)
		else:
			slope: Float = sum_xy / sum_xx
			intercept: Float = my - slope * mx
			(slope, intercept)


-- ============================================================================
-- Summary Statistics
-- ============================================================================
---
Compute sum of all elements.

doctests:
    :: Sum of [1, 2, 3]
    sum([1.0, 2.0, 3.0]).approx_eq(6.0)
---
pure func sum(data: List[Float]) -> Float:
	var total: Float = 0.0

	for x in data:
		total += x

	total


---
Count of elements.
---
pure func count(data: List[Float]) -> Int:
	data.length()


-- ============================================================================
-- Normalization
-- ============================================================================
---
Z-score normalization: (x - mean) / stddev for each element.
Returns original data unchanged if stddev is 0.
---
pure func zscore(data: List[Float]) -> List[Float]:
	sd: Float = stddev(data)

	if sd == 0.0:
		data
	else:
		avg: Float = mean(data)
		data.map(func(x: Float): (x - avg) / sd)


---
Min-max normalization: scale to [0.0, 1.0].
Returns original data unchanged if all values are equal.
---
pure func normalize(data: List[Float]) -> List[Float]:
	r: Float = range(data)

	if r == 0.0:
		data
	else:
		lo: Float = min_val(data).get_or(0.0)
		data.map(func(x: Float): (x - lo) / r)
