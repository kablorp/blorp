-- Int32 - Trait Implementations
--
-- Signed 32-bit integer type.
type Int32 = builtin


implements Stringable for Int32:
	pure func to_string(val: Int32) -> String:
		builtin("blorp_to_string")


implements Equatable for Int32:
	pure func equals(a: Int32, b: Int32) -> Bool:
		a == b

	pure func not_equals(a: Int32, b: Int32) -> Bool:
		a != b


implements Orderable for Int32:
	pure func less_than(a: Int32, b: Int32) -> Bool:
		a < b

	pure func greater_than(a: Int32, b: Int32) -> Bool:
		a > b

	pure func less_than_or_equal(a: Int32, b: Int32) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: Int32, b: Int32) -> Bool:
		a >= b


implements Bounded for Int32:
	pure func min(a: Int32, b: Int32) -> Int32:
		match a < b:
			True:
				a
			_:
				b

	pure func max(a: Int32, b: Int32) -> Int32:
		match a > b:
			True:
				a
			_:
				b


implements Absolute for Int32:
	pure func abs(val: Int32) -> Int32:
		match val < to_int32(0):
			True:
				-val
			_:
				val


implements Negatable for Int32:
	pure func negate(a: Int32) -> Int32:
		-a


implements HasZero for Int32:
	pure func zero() -> Int32:
		to_int32(0)


implements HasOne for Int32:
	pure func one() -> Int32:
		to_int32(1)


implements ToBool for Int32:
	pure func to_bool(val: Int32) -> Bool:
		val != to_int32(0)


implements ToInt for Int32:
	pure func to_int(val: Int32) -> Int:
		to_int(val)


implements Addable for Int32:
	pure func add(a: Int32, b: Int32) -> Int32:
		a + b


implements Subtractable for Int32:
	pure func subtract(a: Int32, b: Int32) -> Int32:
		a - b


implements Multipliable for Int32:
	pure func multiply(a: Int32, b: Int32) -> Int32:
		a * b


implements Divisible for Int32:
	pure func divide(a: Int32, b: Int32) -> Int32:
		a / b


implements Modulable for Int32:
	pure func remainder(a: Int32, b: Int32) -> Int32:
		a % b
