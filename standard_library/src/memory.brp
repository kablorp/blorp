-- blorp Memory Reporting Framework
--
-- Provides utilities for tracking and reporting memory usage.
--
-- Use `get_mem_stats`, `mem_delta`, `format_stats`, and `format_bytes` while
-- debugging allocation behavior. Counting needs a diagnostic runtime and must be
-- switched on: run with `blorp run --memory-stats` (or `BLORP_MEMORY_STATS=1`
-- on a diagnostic build), run with `--leak-check`, or call `reset_mem_stats()`.
-- `get_mem_stats()` alone never starts counting.
-- ============================================================================
-- Core Types and Builtins
-- ============================================================================
-- Memory statistics value tracks allocation patterns.
--
-- The first three fields count managed (blorp_alloc-backed) objects.
-- `bytes_allocated` is the sum of the requested sizes (headers included) of
-- the live managed objects. Only leak tracking records a per-object size, so
-- when just the counters are on (`--memory-stats` before any
-- `reset_mem_stats()`) `bytes_available` is 0 and `bytes_allocated` is 0;
-- `--leak-check` and `reset_mem_stats()` make it available.
-- `allocator_bytes_in_use` is a different quantity: the bytes the whole
-- process currently has from the system allocator (raw buffers included);
-- `allocator_bytes_available` is 0 where the platform cannot report it. A
-- figure is meaningful only when its availability field is 1.
--
-- The remaining fields are the allocation oracle's counters
-- (allocation-contract roadmap milestone 6): every OTHER heap/OS allocation
-- path the runtime has (managed-object malloc, raw malloc/calloc/realloc/
-- aligned buffers, generated cleanup scratch growth, fiber stack mmaps).
-- `oracle_stats_active` and `memory_stats_active` are 1 only when counting
-- was on when the snapshot was taken; a caller must treat 0 as an incomplete
-- measurement, never as "zero events". See `assert_no_heap_activity`.
struct MemStats {
	total_allocations: Int,
	total_releases: Int,
	current_objects: Int,
	bytes_allocated: Int,
	bytes_available: Int,
	allocator_bytes_in_use: Int,
	allocator_bytes_available: Int,
	backing_libc_malloc_events: Int,
	raw_buffer_malloc_events: Int,
	raw_buffer_calloc_events: Int,
	raw_buffer_realloc_events: Int,
	raw_buffer_aligned_events: Int,
	cleanup_scratch_events: Int,
	fiber_mmap_events: Int,
	oracle_stats_active: Int,
	-- Managed counters are valid only when this is 1. This is independent
	-- of whether the allocation oracle was activated for this snapshot.
	memory_stats_active: Int
}


-- Get current memory statistics.
-- The returned MemStats value requires no allocation, and reading never turns
-- counting on: when nothing has (see the header), the snapshot is all zeros
-- with memory_stats_active == 0. After `reset_mem_stats()` it reports zero
-- live objects unless user code has allocated something. Check
-- memory_stats_active before interpreting any managed count.
pure func get_mem_stats() -> MemStats:
	builtin("blorp_get_mem_stats")


-- Start an exact measurement epoch: zero the managed counters and count only
-- objects allocated from now on. This also turns on per-object leak tracking
-- for the rest of the process, which costs a metadata record and a mutex
-- acquisition per managed allocation and release, so use it in tests and
-- diagnostics, not in timed code. Call it while other threads are not
-- allocating if `--memory-stats` was already counting.
func reset_mem_stats() -> Void:
	builtin("blorp_reset_mem_stats")


-- Print live object type buckets for the current memory-stats epoch.
-- This is intended for test harness diagnostics after `get_mem_stats()`
-- reports live objects. It does not allocate a Blorp String for the summary.
func print_live_object_summary() -> Void:
	builtin("blorp_print_live_object_summary")


-- Check if an object has unique ownership (refcount == 1).
-- Useful for verifying COW behavior. Stack types always return True, while
-- immortal canonical values such as string and empty list literals return False.
pure func is_unique[T](obj: T) -> Bool:
	builtin("blorp_is_unique")


-- Check whether two values are the same managed allocation.
-- This is allocation identity, not equality: it answers "did this value come
-- back untouched?", never "do these values mean the same thing". Stack types
-- (Int, Bool, structs, etc.) always return False, and immortal literals such
-- as canonical string and empty list literals are unspecified.
pure func same_object[T](left: T, right: T) -> Bool:
	builtin("blorp_same_object")


-- Get the current reference count. Heap objects return their ARC count,
-- immortal literals return the runtime immortal sentinel, and stack types
-- (Int, Bool, structs, etc.) return 0.
pure func refcount[T](obj: T) -> Int:
	builtin("blorp_refcount")


-- Get the ABI memory size in bytes. Heap objects return the size of their
-- runtime header type, including static string literals; stack types return
-- their C sizeof. This does not include trailing variable-capacity storage.
pure func size_of[T](obj: T) -> Int:
	builtin("blorp_size_of")


-- ============================================================================
-- Utility Functions
-- ============================================================================
-- Format bytes with appropriate unit (B, KB, MB, GB)
private pure func round_to(x: Float, factor: Float) -> Float:
	to_float(to_int(x * factor)) / factor


pure func format_bytes(bytes: Int) -> String:
	bytes_f: Float = to_float(bytes)

	match bytes < 1024:
		True:
			bytes.to_string() + " B"
		False:
			kb: Float = bytes_f / 1024.0

			match kb < 1024.0:
				True:
					round_to(kb, 10.0).to_string() + " KB"
				False:
					mb: Float = kb / 1024.0

					match mb < 1024.0:
						True:
							round_to(mb, 10.0).to_string() + " MB"
						False:
							gb: Float = mb / 1024.0
							round_to(gb, 100.0).to_string() + " GB"


-- A byte figure for display, or "unavailable" when its availability field is
-- 0. A negative figure with the field set is a real (negative delta) number.
private pure func format_byte_count(bytes: Int, available: Int) -> String:
	if available == 0:
		"unavailable"
	else:
		format_bytes(bytes)


-- Format memory stats as a readable string
pure func format_stats(stats: MemStats) -> String:
	if stats.memory_stats_active == 0:
		"memory stats inactive: run with --memory-stats or call reset_mem_stats() (needs a runtime built with BLORP_MEMORY_DIAGNOSTICS=1)"
	else:
		"allocations: " + to_string(
			stats.total_allocations,
		) + ", releases: " + to_string(
			stats.total_releases,
		) + ", current: " + to_string(
			stats.current_objects,
		) + ", managed bytes: " + format_byte_count(stats.bytes_allocated, stats.bytes_available)


-- Difference of two byte figures, or 0 when either endpoint could not report
-- one; the availability field of the delta says which it is.
private pure func byte_delta(before: Int, before_available: Int, after: Int, after_available: Int) -> Int:
	if before_available == 0 or after_available == 0:
		0
	else:
		after - before


private pure func both_available(before: Int, after: Int) -> Int:
	if before == 0 or after == 0:
		0
	else:
		1


-- Get the delta in memory stats between two snapshots (the value to print or
-- assert on; use `format_stats` to render it). A byte delta is 0 with its
-- availability field 0 when either snapshot could not report that figure; a
-- negative delta with the field 1 is a real decrease.
pure func mem_delta(before: MemStats, after: MemStats) -> MemStats:
	-- Both endpoints must have been taken with the oracle gate active for a
	-- delta to mean anything; see assert_no_heap_activity.
	both_active: Bool = before.oracle_stats_active > 0 and after.oracle_stats_active > 0
	both_memory_active: Bool = before.memory_stats_active > 0 and after.memory_stats_active > 0

	active_flag: Int = match both_active:
		True:
			1
		False:
			0
	memory_active_flag: Int = match both_memory_active:
		True:
			1
		False:
			0

	{
		total_allocations = after.total_allocations - before.total_allocations,
		total_releases = after.total_releases - before.total_releases,
		current_objects = after.current_objects - before.current_objects,
		bytes_allocated = byte_delta(
			before.bytes_allocated,
			before.bytes_available,
			after.bytes_allocated,
			after.bytes_available,
		),
		bytes_available = both_available(before.bytes_available, after.bytes_available),
		allocator_bytes_in_use = byte_delta(
			before.allocator_bytes_in_use,
			before.allocator_bytes_available,
			after.allocator_bytes_in_use,
			after.allocator_bytes_available,
		),
		allocator_bytes_available = both_available(
			before.allocator_bytes_available,
			after.allocator_bytes_available,
		),
		backing_libc_malloc_events = after.backing_libc_malloc_events - before.backing_libc_malloc_events,
		raw_buffer_malloc_events = after.raw_buffer_malloc_events - before.raw_buffer_malloc_events,
		raw_buffer_calloc_events = after.raw_buffer_calloc_events - before.raw_buffer_calloc_events,
		raw_buffer_realloc_events = after.raw_buffer_realloc_events - before.raw_buffer_realloc_events,
		raw_buffer_aligned_events = after.raw_buffer_aligned_events - before.raw_buffer_aligned_events,
		cleanup_scratch_events = after.cleanup_scratch_events - before.cleanup_scratch_events,
		fiber_mmap_events = after.fiber_mmap_events - before.fiber_mmap_events,
		oracle_stats_active = active_flag,
		memory_stats_active = memory_active_flag
	}


-- Allocation oracle assertion (allocation-contract roadmap milestone 6).
--
-- Given a `before`/`after` MemStats pair bracketing a piece of test code,
-- confirm that NO heap activity happened on any counted path: managed
-- object requests, backing libc malloc, raw buffer malloc/calloc/realloc,
-- SIMD-aligned buffers, generated cleanup scratch growth, and fiber stack
-- mmaps. On success returns `Ok(void)`. On failure, names the first
-- counter that moved (or explains that the oracle gate was not active) so
-- a caller does not have to re-derive which path allocated.
--
-- This is test-only: it is for single-fiber test code measured under
-- `BLORP_MEMORY_STATS=1` (`blorp run --memory-stats`), since the underlying
-- counters are process-global. It does not support nested scopes or
-- concurrent fibers; a test that needs either must snapshot around each
-- fiber's own single-threaded region instead of sharing one before/after
-- pair.
pure func assert_no_heap_activity(before: MemStats, after: MemStats) -> Result[Void, String]:
	if before.memory_stats_active == 0 or after.memory_stats_active == 0:
		Err("memory stats inactive: run with --memory-stats or call reset_mem_stats() (needs a runtime built with BLORP_MEMORY_DIAGNOSTICS=1)")
	else if before.oracle_stats_active == 0 or after.oracle_stats_active == 0:
		Err((
				"allocation oracle inactive: run with BLORP_MEMORY_STATS=1 (a disabled gate "
				+ "must fail, not read as zero)"
			))
	else:
		delta: MemStats = mem_delta(before, after)

		if delta.total_allocations != 0:
			Err("managed allocation requests moved by " + delta.total_allocations.to_string())
		else:
			if delta.total_releases != 0:
				Err("managed release requests moved by " + delta.total_releases.to_string())
			else:
				if delta.backing_libc_malloc_events != 0:
					Err(
						"backing libc malloc events moved by " + delta.backing_libc_malloc_events.to_string(),
					)
				else:
					if delta.raw_buffer_malloc_events != 0:
						Err(
							"raw buffer malloc events moved by " + delta.raw_buffer_malloc_events.to_string(),
						)
					else:
						if delta.raw_buffer_calloc_events != 0:
							Err(
								"raw buffer calloc events moved by " + delta.raw_buffer_calloc_events.to_string(),
							)
						else:
							if delta.raw_buffer_realloc_events != 0:
								Err(
									"raw buffer realloc events moved by " + delta.raw_buffer_realloc_events.to_string(),
								)
							else:
								if delta.raw_buffer_aligned_events != 0:
									Err(
										"raw aligned-buffer events moved by " + delta.raw_buffer_aligned_events.to_string(),
									)
								else:
									if delta.cleanup_scratch_events != 0:
										Err(
											"cleanup scratch events moved by " + delta.cleanup_scratch_events.to_string(),
										)
									else:
										if delta.fiber_mmap_events != 0:
											Err(
												"fiber stack mmap events moved by " + delta.fiber_mmap_events.to_string(),
											)
										else:
											Ok(void)
