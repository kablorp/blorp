-- blorp Memory Reporting Framework
--
-- Provides utilities for tracking and reporting memory usage.
--
-- Use `print_mem_stats`, `measure_memory`, and `format_bytes` while
-- debugging allocation behavior.
-- ============================================================================
-- Core Types and Builtins
-- ============================================================================
-- Memory statistics value tracks allocation patterns
struct MemStats {
	total_allocations: Int,
	total_releases: Int,
	current_objects: Int,
	bytes_allocated: Int
}


-- Get current memory statistics.
-- The returned MemStats value requires no allocation, so a reset
-- followed by get_mem_stats() reports zero live objects unless user code
-- has allocated something.
pure func get_mem_stats() -> MemStats:
	builtin("blorp_get_mem_stats")


-- Reset memory statistics counters
func reset_mem_stats() -> Void:
	builtin("blorp_reset_mem_stats")


-- Print live object type buckets for the current memory-stats epoch.
-- This is intended for test harness diagnostics after `get_mem_stats()`
-- reports live objects. It does not allocate a Blorp String for the summary.
func print_live_object_summary() -> Void:
	builtin("blorp_print_live_object_summary")


-- Check if an object has unique ownership (refcount == 1).
-- Useful for verifying COW behavior. Stack types always return True, while
-- immortal canonical values such as empty list literals return False.
pure func is_unique[T](obj: T) -> Bool:
	builtin("blorp_is_unique")


-- Get the current reference count. Heap objects return their ARC count,
-- stack types (Int, Bool, structs, etc.) return 0.
pure func refcount[T](obj: T) -> Int:
	builtin("blorp_refcount")


-- Get the allocated memory size in bytes. Heap objects return their
-- allocation size, stack types return their C sizeof.
pure func size_of[T](obj: T) -> Int:
	builtin("blorp_size_of")


-- ============================================================================
-- Utility Functions
-- ============================================================================
-- Format bytes with appropriate unit (B, KB, MB, GB)
private pure func round_to(x: Float, factor: Float) -> Float:
	to_float(to_int(x * factor)) / factor


pure func format_bytes(bytes: Int) -> String:
	bytes_f: Float = to_float(bytes)

	match bytes < 1024:
		True:
			bytes.to_string() + " B"
		False:
			kb: Float = bytes_f / 1024.0

			match kb < 1024.0:
				True:
					round_to(kb, 10.0).to_string() + " KB"
				False:
					mb: Float = kb / 1024.0

					match mb < 1024.0:
						True:
							round_to(mb, 10.0).to_string() + " MB"
						False:
							gb: Float = mb / 1024.0
							round_to(gb, 100.0).to_string() + " GB"


-- Format memory stats as a readable string
pure func format_stats(stats: MemStats) -> String:
	"allocations: " + to_string(
		stats.total_allocations,
	) + ", releases: " + to_string(
		stats.total_releases,
	) + ", current: " + to_string(
		stats.current_objects,
	) + ", bytes: " + format_bytes(stats.bytes_allocated)


-- Print current memory statistics
func print_mem_stats() -> Void:
	stats: MemStats = get_mem_stats()
	print("=== Memory Stats ===")
	print("  Total allocations: " + stats.total_allocations.to_string())
	print("  Total releases:    " + stats.total_releases.to_string())
	print("  Current objects:   " + stats.current_objects.to_string())
	print("  Bytes allocated:   " + format_bytes(stats.bytes_allocated))
	print("====================")


-- Measure memory usage of a function
-- Resets stats before, runs the function, returns final stats
func measure_memory(f: () -> Void) -> MemStats:
	reset_mem_stats()
	f()
	get_mem_stats()


-- Get the delta in memory stats between two points
pure func mem_delta(before: MemStats, after: MemStats) -> MemStats:
	{
		total_allocations = after.total_allocations - before.total_allocations,
		total_releases = after.total_releases - before.total_releases,
		current_objects = after.current_objects - before.current_objects,
		bytes_allocated = after.bytes_allocated - before.bytes_allocated
	}


-- Check for memory leaks: returns true if objects are still live
pure func has_leaks(stats: MemStats) -> Bool:
	stats.current_objects > 0


-- Print memory report comparing before/after stats
func print_mem_report(label: String, before: MemStats, after: MemStats) -> Void:
	delta: MemStats = mem_delta(before, after)
	print("=== Memory Report: " + label + " ===")
	print("  New allocations: " + delta.total_allocations.to_string())
	print("  New releases:    " + delta.total_releases.to_string())
	print("  Net objects:     " + delta.current_objects.to_string())
	print("  Net bytes:       " + format_bytes(delta.bytes_allocated))

	match has_leaks(delta):
		True:
			print("  WARNING: Potential memory leak detected!")
		False:
			print("  OK: All allocations released")

	print("================================")
