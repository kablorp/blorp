-- Bool - Boolean type trait implementations
--
-- Provides standard trait implementations for the Bool type:
-- - Stringable: Convert to "True" or "False"
-- - Logical: and, or, not operations
-- - Equatable: Equality comparison
-- - ToInt, ToFloat: Type conversions (True=1, False=0)
enum Bool:
	True
	False


-- Convenience helper for method-style boolean negation
pure func negate(val: Bool) -> Bool:
	not val


-- Boolean to string conversion
implements Stringable for Bool:
	pure func to_string(val: Bool) -> String:
		match val:
			True:
				"True"
			False:
				"False"


-- Logical operators
implements Logical for Bool:
	pure func logical_and(a: Bool, b: Bool) -> Bool:
		a and b

	pure func logical_or(a: Bool, b: Bool) -> Bool:
		a or b

	pure func logical_not(a: Bool) -> Bool:
		not a


-- Comparison operators
implements Equatable for Bool:
	pure func equals(a: Bool, b: Bool) -> Bool:
		a == b

	pure func not_equals(a: Bool, b: Bool) -> Bool:
		a != b


-- Type conversions FROM Bool
implements ToInt for Bool:
	pure func to_int(val: Bool) -> Int:
		if val:
			1
		else:
			0


implements ToFloat for Bool:
	pure func to_float(val: Bool) -> Float:
		if val:
			1.0
		else:
			0.0
