-- Char - Unicode codepoint type trait implementations
--
-- Char represents a single Unicode codepoint (up to U+10FFFF).
--
-- Provides standard trait implementations for the Char type:
-- - Stringable: UTF-8 encode to single-character string
-- - ToInt: Get numeric codepoint value
-- - Equatable, Orderable: Comparison operations (by codepoint value)
type Char = builtin


-- String conversion (UTF-8 encode)
implements Stringable for Char:
	pure func to_string(val: Char) -> String:
		builtin("blorp_from_char")


-- Int conversion (codepoint value)
implements ToInt for Char:
	pure func to_int(val: Char) -> Int:
		to_int(val)


-- Comparison operators
implements Equatable for Char:
	pure func equals(a: Char, b: Char) -> Bool:
		a == b

	pure func not_equals(a: Char, b: Char) -> Bool:
		a != b


implements Orderable for Char:
	pure func less_than(a: Char, b: Char) -> Bool:
		a < b

	pure func greater_than(a: Char, b: Char) -> Bool:
		a > b

	pure func less_than_or_equal(a: Char, b: Char) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: Char, b: Char) -> Bool:
		a >= b
