-- String - String type operations
--
-- Provides operations and trait implementations for the String type.
-- Strings are immutable, UTF-8 encoded sequences of characters.
--
-- Core Operations (builtins):
-- - string, reserve, append_char, append_int: Capacity-aware construction/appends
-- - substring, split, trim, replace: String manipulation (join lives in list)
-- - starts_with, ends_with, contains, index_of: Search operations
-- - get: Character access (returns Option[Char])
-- - from_char: Create string from single character
-- - drop_left, take_left: Slicing shortcuts
-- - trim_left, trim_right: One-sided trimming
-- - count, lines, words: Counting and splitting
-- - reverse, pad_left, pad_right: Formatting
-- - remove_prefix, remove_suffix: Prefix/suffix removal
-- - is_alpha, is_digit, is_whitespace, is_alphanumeric: Char classification
-- - base64_encode, base64_decode: Base64 encoding/decoding
--
-- Trait Implementations:
-- - Stringable: Identity (string is already a string)
-- - HasLength: Get byte length (via builtin)
type String = builtin


-- ============================================================================
-- Capacity-Aware Construction and Append
-- ============================================================================
---
Create an empty string with at least the requested byte capacity.

Capacity is an implementation detail and may grow automatically during accumulation.

doctests:
    :: Empty string with capacity
    string(16).length() == 0
---
pure func string(capacity: Int) -> String:
	builtin("string.string")


---
Ensure the string has at least the requested byte capacity.

The returned value has the same text content. If the string is shared, the
runtime may copy before reserving capacity.
---
pure func reserve(self: String, capacity: Int) -> String:
	builtin("string.reserve")


---
Append a single character, reusing capacity when the string is uniquely owned.

doctests:
    :: Append single character
    append_char(string(1), 'a') == "a"
---
pure func append_char(self: String, c: Char) -> String:
	builtin("string.append_char")


---
Append an integer, reusing capacity when the string is uniquely owned.

doctests:
    :: Append integer
    append_int(string(4), -42) == "-42"
---
pure func append_int(self: String, value: Int) -> String:
	builtin("blorp_string_append_int")


-- ============================================================================
-- Core String Operations (builtins)
-- ============================================================================
---
Get a substring starting at 'start' with 'len' characters.

doctests:
    :: Substring from start
    "hello world".substring(0, 5) == "hello"

    :: Substring from middle
    "hello".substring(1, 3) == "ell"
---
pure func substring(self: String, start: Int, len: Int) -> String:
	builtin("string.substring")


---
Check if string starts with the given prefix.

doctests:
    :: Matching prefix
    "hello world".starts_with("hello") == True

    :: Non-matching prefix
    "hello".starts_with("world") == False
---
pure func starts_with(self: String, prefix: String) -> Bool:
	builtin("string.starts_with")


---
Check if string ends with the given suffix.

doctests:
    :: Matching suffix
    "hello world".ends_with("world") == True

    :: Non-matching suffix
    "hello".ends_with("world") == False
---
pure func ends_with(self: String, suffix: String) -> Bool:
	builtin("string.ends_with")


---
Check if string contains the given needle.

doctests:
    :: Contains substring
    "hello world".contains("world") == True

    :: Does not contain substring
    "hello".contains("xyz") == False
---
pure func contains(self: String, needle: String) -> Bool:
	builtin("string.contains")


-- Raw index_of builtin (returns -1 if not found)
pure func raw_index_of(self: String, needle: String) -> Int:
	builtin("string.raw_index_of")


---
Split string by delimiter.

doctests:
    :: Split by comma
    "a,b,c"
        .split(",")
        .length() == 3
---
pure func split(self: String, delim: String) -> List[String]:
	builtin("string.split")


---
Remove leading and trailing whitespace.

doctests:
    :: Trim whitespace
    trim("  hello  ") == "hello"

    :: No whitespace unchanged
    trim("no spaces") == "no spaces"
---
pure func trim(self: String) -> String:
	builtin("string.trim")


---
Replace all occurrences of old with new.

doctests:
    :: Replace word
    "hello world".replace("world", "blorp") == "hello blorp"

    :: Replace all occurrences
    "aaa".replace("a", "b") == "bbb"
---
pure func replace(self: String, old: String, new: String) -> String:
	builtin("string.replace")


---
Convert character to single-character string.

doctests:
    :: Convert char to string
    from_char('a') == "a"
---
pure func from_char(c: Char) -> String:
	builtin("blorp_from_char")


---
Get the byte length of a string.

doctests:
    :: Length of string
    "hello".length() == 5

    :: Empty string length
    "".length() == 0
---
pure func length(self: String) -> Int:
	builtin("string.length")


-- ============================================================================
-- Character Conversion
-- ============================================================================
---
Convert a string to a list of characters (byte values).

doctests:
    :: Character count matches string length
    "abc"
        .chars()
        .length() == 3

    :: Round-trip preserves content
    "hello world"
        .chars()
        .from_chars() == "hello world"

    :: Empty string returns empty list
    ""
        .chars()
        .length() == 0
---
pure func chars(self: String) -> List[Char]:
	builtin("blorp_string_chars")


---
Build a string from a list of characters.

doctests:
    :: Round-trip through chars/from_chars
    "hello"
        .chars()
        .from_chars() == "hello"

    :: Build from char list
    ['a', 'b', 'c'].from_chars() == "abc"
---
pure func from_chars(cs: List[Char]) -> String:
	builtin("blorp_from_chars")


---
Convert a String to Bytes (its raw UTF-8 encoding).

Round-trip through [Bytes.to_string] preserves content.

doctests:
    :: Round-trip
    "hello"
        .to_bytes()
        .to_string() == "hello"

    :: Empty string
    ""
        .to_bytes()
        .length() == 0
---
pure func to_bytes(self: String) -> Bytes:
	builtin("blorp_bytes_from_string")


-- ============================================================================
-- Unicode Case Conversion
-- Uses Unicode default case mappings. Output byte length and codepoint count
-- may differ from the input.
-- ============================================================================
---
Convert to uppercase using Unicode default case mappings.

doctests:
    :: Uppercase all
    "hello".upper() == "HELLO"

    :: Mixed case to upper
    "Hello World".upper() == "HELLO WORLD"

    :: Unicode expansion
    "straße".upper() == "STRASSE"
---
pure func upper(self: String) -> String:
	builtin("blorp_upper")


---
Convert to lowercase using Unicode default case mappings.

doctests:
    :: Lowercase all
    "HELLO".lower() == "hello"

    :: Mixed case to lower
    "Hello World".lower() == "hello world"

    :: Unicode expansion
    "İ".lower() == "i̇"
---
pure func lower(self: String) -> String:
	builtin("blorp_lower")


-- ============================================================================
-- ASCII Case Helpers
-- ============================================================================
---
Capitalize first ASCII letter, lowercase the rest.

doctests:
    :: Capitalize simple
    "hello".capitalize() == "Hello"

    :: Capitalize lowercases rest
    "hello WORLD".capitalize() == "Hello world"
---
pure func capitalize(self: String) -> String:
	builtin("string.capitalize")


---
Case-insensitive comparison using Unicode default case mappings.

doctests:
    :: Case insensitive match
    equal_ignore_case("Hello", "hello") == True

    :: Unicode expansion match
    equal_ignore_case("straße", "STRASSE") == True

    :: Case insensitive mismatch
    equal_ignore_case("abc", "xyz") == False
---
pure func equal_ignore_case(a: String, b: String) -> Bool:
	a.upper() == b.upper()


---
Title case: capitalize first letter of each space-separated word.

doctests:
    :: Title case words
    "hello world".title_case() == "Hello World"
---
pure func title_case(self: String) -> String:
	builtin("string.title_case")


-- ============================================================================
-- Parsing
-- ============================================================================
---
Parse a string as an integer.
Returns Some(n) on success, None on failure.

doctests:
    :: Parse valid integer
    match "42".parse_int():
        Some(v):
            v == 42
        None:
            False

    :: Parse invalid integer
    match "not a number".parse_int():
        Some(_):
            False
        None:
            True
---
pure func parse_int(self: String) -> Option[Int]:
	builtin("blorp_parse_int")


---
Parse a string as a float.
Returns Some(f) on success, None on failure.

doctests:
    :: Parse valid float
    match "3.14".parse_float():
        Some(v):
            v > 3.0
        None:
            False

    :: Parse invalid float
    match "bad".parse_float():
        Some(_):
            False
        None:
            True
---
pure func parse_float(self: String) -> Option[Float]:
	builtin("blorp_parse_float")


-- ============================================================================
-- Safe Access
-- ============================================================================
---
Bounds-checked character access.
Returns Some(char) for valid index, None for out-of-bounds.

doctests:
    :: Get valid index
    match "hello".get(0):
        Some(c):
            c == 'h'
        None:
            False

    :: Get out of bounds
    match "hello".get(10):
        Some(_):
            False
        None:
            True
---
pure func get(self: String, index: Int) -> Option[Char]:
	builtin("blorp_string_get_opt")


---
Bounds-checked character access with a a default.
Always returns Char

doctests:
    :: Get valid index
    "hello".get_or(0, 'a') == 'h'

    :: Get out of bounds
    "hello".get_or(10, 'a') == 'a'
---
pure func get_or(self: String, index: Int, default: Char) -> Char:
	self
		.get(index)
		.get_or(default)


---
Find the index of needle in string.
Returns Some(index) if found, None if not found.

doctests:
    :: Find existing substring
    match "hello world".index_of("world"):
        Some(i):
            i == 6
        None:
            False

    :: Find missing substring
    match "hello".index_of("xyz"):
        Some(_):
            False
        None:
            True
---
pure func index_of(self: String, needle: String) -> Option[Int]:
	result: Int = raw_index_of(self, needle)

	if result == -1:
		None
	else:
		Some(result)


-- ============================================================================
-- Utilities
-- ============================================================================
---
Check if the string is empty.

doctests:
    :: Empty string
    "".is_empty() == True

    :: Non-empty string
    "hello".is_empty() == False
---
pure func is_empty(self: String) -> Bool:
	length(self) == 0


---
Get the first character of the string, or None if empty.

doctests:
    :: Head of non-empty string
    match "hello".head():
        Some(c):
            c == 'h'
        None:
            False

    :: Head of empty string
    match "".head():
        Some(_):
            False
        None:
            True
---
pure func head(self: String) -> Option[Char]:
	self.get(0)


---
Get the string without the first character.
Returns empty string if input is empty.

doctests:
    :: Tail of non-empty string
    "hello".tail() == "ello"

    :: Tail of empty string
    "".tail() == ""
---
pure func tail(self: String) -> String:
	if self.length() > 0:
		self.substring(1, self.length() - 1)
	else:
		self


---
Repeat a string n times.

doctests:
    :: Repeat string
    "ab".repeat(3) == "ababab"

    :: Repeat zero times
    "x".repeat(0) == ""
---
pure func repeat(self: String, n: Int) -> String:
	builtin("string.repeat")


---
URL-encode a string (RFC 3986). Encodes all characters except
unreserved characters (A-Z, a-z, 0-9, -, _, ., ~) as %XX.

doctests:
    :: Encode spaces
    "hello world".url_encode() == "hello%20world"

    :: Encode special characters
    "a&b=c".url_encode() == "a%26b%3Dc"
---
pure func url_encode(self: String) -> String:
	builtin("blorp_url_encode")


---
URL-decode a string. Decodes %XX sequences and + as space.

doctests:
    :: Decode percent encoding
    "hello%20world".url_decode() == "hello world"

    :: Decode plus as space
    "a+b".url_decode() == "a b"
---
pure func url_decode(self: String) -> String:
	builtin("blorp_url_decode")


---
Escape a string for safe embedding in HTML.
Replaces <, >, &, ", ' with their HTML entity equivalents.

doctests:
    :: Escape angle brackets
    "<b>bold</b>".html_escape() == "&lt;b&gt;bold&lt;/b&gt;"

    :: Escape ampersand
    "a&b".html_escape() == "a&amp;b"
---
pure func html_escape(self: String) -> String:
	builtin("blorp_html_escape")


-- ============================================================================
-- Slicing
-- ============================================================================
---
Drop the first n characters from a string.
Returns empty string if n >= length.

doctests:
    :: Drop from start
    "hello".drop_left(2) == "llo"

    :: Drop zero
    "hello".drop_left(0) == "hello"

    :: Drop all
    "hi".drop_left(5) == ""

    :: Drop negative
    "hello".drop_left(-1) == "hello"
---
pure func drop_left(self: String, n: Int) -> String:
	builtin("string.drop_left")


---
Take the first n characters from a string.
Returns the full string if n >= length.

doctests:
    :: Take from start
    "hello".take_left(3) == "hel"

    :: Take zero
    "hello".take_left(0) == ""

    :: Take more than length
    "hi".take_left(10) == "hi"

    :: Take negative
    "hello".take_left(-1) == ""
---
pure func take_left(self: String, n: Int) -> String:
	builtin("string.take_left")


-- ============================================================================
-- Trimming
-- ============================================================================
---
Remove leading whitespace (spaces, tabs, newlines, carriage returns).

doctests:
    :: Trim leading spaces
    "  hello".trim_left() == "hello"

    :: No leading whitespace
    "hello  ".trim_left() == "hello  "

    :: All whitespace
    "   ".trim_left() == ""
---
pure func trim_left(self: String) -> String:
	builtin("string.trim_left")


---
Remove trailing whitespace (spaces, tabs, newlines, carriage returns).

doctests:
    :: Trim trailing spaces
    "hello  ".trim_right() == "hello"

    :: No trailing whitespace
    "  hello".trim_right() == "  hello"

    :: All whitespace
    "   ".trim_right() == ""
---
pure func trim_right(self: String) -> String:
	builtin("string.trim_right")


-- ============================================================================
-- Counting & Splitting
-- ============================================================================
---
Count non-overlapping occurrences of needle in string.

doctests:
    :: Count single char
    "hello".count("l") == 2

    :: Count substring
    "abcabcabc".count("abc") == 3

    :: Count no matches
    "hello".count("xyz") == 0

    :: Count empty needle
    "hello".count("") == 0
---
pure func count(self: String, needle: String) -> Int:
	builtin("string.count")


---
Split string on line boundaries (\n, \r\n, \r).
More robust than s.split("\n") for cross-platform text.

doctests:
    :: Split unix lines
    "a\nb\nc"
        .lines()
        .length() == 3

    :: Lines content
    "a\nb\nc"
        .lines()
        .join("|") == "a|b|c"

    :: Split single line (no newline)
    "hello"
        .lines()
        .length() == 1
---
pure func lines(self: String) -> List[String]:
	self
		.replace("\r\n", "\n")
		.replace("\r", "\n")
		.split("\n")


---
Split string on whitespace, dropping empty segments.
Handles spaces, tabs, newlines, and leading/trailing whitespace.

doctests:
    :: Split words
    "hello world"
        .words()
        .length() == 2

    :: Words content
    "hello world"
        .words()
        .join("|") == "hello|world"

    :: Multiple spaces
    "  hello   world  "
        .words()
        .join("|") == "hello|world"

    :: Empty string
    ""
        .words()
        .length() == 0
---
pure func words(self: String) -> List[String]:
	var result: List[String] = []
	var start: Int = -1
	slen: Int = self.length()

	for i in 0..slen:
		match self.get(i):
			Some(c):
				if (
					c == ' '
					or c == '\t'
					or c == '\n'
					or c == '\r'
				):
					if start >= 0:
						result = result.append(self.substring(start, i - start))
						start = -1
				else if start < 0:
					start = i
			None:
				void

	if start >= 0:
		result = result.append(self.substring(start, slen - start))

	result


-- ============================================================================
-- Prefix/Suffix Removal
-- ============================================================================
---
Remove prefix from string if present, return unchanged otherwise.

doctests:
    :: Remove existing prefix
    "hello world".remove_prefix("hello ") == "world"

    :: Prefix not present
    "hello".remove_prefix("xyz") == "hello"

    :: Empty prefix
    "hello".remove_prefix("") == "hello"
---
pure func remove_prefix(self: String, prefix: String) -> String:
	if self.starts_with(prefix):
		self.drop_left(prefix.length())
	else:
		self


---
Remove suffix from string if present, return unchanged otherwise.

doctests:
    :: Remove existing suffix
    "hello.txt".remove_suffix(".txt") == "hello"

    :: Suffix not present
    "hello".remove_suffix(".txt") == "hello"

    :: Empty suffix
    "hello".remove_suffix("") == "hello"
---
pure func remove_suffix(self: String, suffix: String) -> String:
	if self.ends_with(suffix):
		self.take_left(self.length() - suffix.length())
	else:
		self


-- ============================================================================
-- Padding & Reversal
-- ============================================================================
---
Reverse a string byte-by-byte.
Note: operates on bytes, not Unicode codepoints. Multi-byte characters will be corrupted.

doctests:
    :: Reverse word
    "hello".reverse() == "olleh"

    :: Reverse palindrome
    "racecar".reverse() == "racecar"

    :: Reverse empty
    "".reverse() == ""
---
pure func reverse(self: String) -> String:
	builtin("string.reverse")


---
Pad string on the left to reach target width using fill character.
Returns unchanged if string is already at or beyond target width.

doctests:
    :: Pad with zeros
    "42".pad_left(5, '0') == "00042"

    :: Pad with spaces
    "hi".pad_left(5, ' ') == "   hi"

    :: Already long enough
    "hello".pad_left(3, ' ') == "hello"
---
pure func pad_left(self: String, width: Int, fill: Char) -> String:
	builtin("string.pad_left")


---
Pad string on the right to reach target width using fill character.
Returns unchanged if string is already at or beyond target width.

doctests:
    :: Pad with spaces
    "hi".pad_right(5, ' ') == "hi   "

    :: Pad with dots
    "hi".pad_right(5, '.') == "hi..."

    :: Already long enough
    "hello".pad_right(3, '.') == "hello"
---
pure func pad_right(self: String, width: Int, fill: Char) -> String:
	builtin("string.pad_right")


-- ============================================================================
-- Character Classification
-- ============================================================================
---
Check if a character is an ASCII letter (a-z, A-Z).

doctests:
    :: Lowercase letter
    is_alpha('a') == True

    :: Uppercase letter
    is_alpha('Z') == True

    :: Digit is not alpha
    is_alpha('5') == False
---
pure func is_alpha(c: Char) -> Bool:
	code: Int = to_int(c)
	code >= 65 and code <= 90 or code >= 97 and code <= 122


---
Check if a character is an ASCII digit (0-9).

doctests:
    :: Digit
    is_digit('5') == True

    :: Letter is not digit
    is_digit('a') == False
---
pure func is_digit(c: Char) -> Bool:
	code: Int = to_int(c)
	code >= 48 and code <= 57


---
Check if a character is whitespace (space, tab, newline, carriage return).

doctests:
    :: Space
    is_whitespace(' ') == True

    :: Tab
    is_whitespace('\t') == True

    :: Letter is not whitespace
    is_whitespace('a') == False
---
pure func is_whitespace(c: Char) -> Bool:
	code: Int = to_int(c)
	code == 32 or code == 9 or code == 10 or code == 13


---
Check if a character is alphanumeric (letter or digit).

doctests:
    :: Letter
    is_alphanumeric('a') == True

    :: Digit
    is_alphanumeric('5') == True

    :: Punctuation is not alphanumeric
    is_alphanumeric('!') == False
---
pure func is_alphanumeric(c: Char) -> Bool:
	is_digit(c) or is_alpha(c)


-- ============================================================================
-- Base64 Encoding/Decoding (RFC 4648)
-- ============================================================================
---
Encode a string to base64.

doctests:
    :: Encode simple string
    "hello".base64_encode() == "aGVsbG8="

    :: Encode empty string
    "".base64_encode() == ""

    :: Encode with padding
    "a".base64_encode() == "YQ=="

    :: Encode no padding needed
    "abc".base64_encode() == "YWJj"
---
pure func base64_encode(self: String) -> String:
	builtin("blorp_base64_encode")


---
Decode a base64 string. Returns None for invalid input.

doctests:
    :: Decode simple string
    match "aGVsbG8=".base64_decode():
        Some(s):
            s == "hello"
        None:
            False

    :: Decode no padding
    match "YWJj".base64_decode():
        Some(s):
            s == "abc"
        None:
            False

    :: Decode invalid input
    match "!!!".base64_decode():
        Some(_):
            False
        None:
            True
---
pure func base64_decode(self: String) -> Option[String]:
	builtin("blorp_base64_decode")


-- ============================================================================
-- Trait Implementations
-- ============================================================================
-- String is already its own string representation
implements Stringable for String:
	pure func to_string(val: String) -> String:
		val


implements HasLength for String:
	pure func length(self: String) -> Int:
		builtin("string.length")


-- ============================================================================
-- Extended String Operations
-- ============================================================================
---
Split string by delimiter with a maximum number of parts.
If limit is 2, at most 2 parts are returned: the text before the first
delimiter and the rest of the string.

doctests:
    :: Split with limit 2
    "a.b.c.d".split_n(".", 2) == ["a", "b.c.d"]

    :: Split with high limit
    "a.b".split_n(".", 10) == ["a", "b"]
---
pure func split_n(self: String, delim: String, limit: Int) -> List[String]:
	if delim.length() == 0 or limit <= 0:
		[self]
	else:
		var result: List[String] = []
		var pos: Int = 0
		var parts: Int = 0
		slen: Int = self.length()
		dlen: Int = delim.length()

		while pos <= slen and parts < limit - 1:
			idx: Int = raw_index_of(
				self.substring(pos, slen - pos),
				delim,
			)

			if idx < 0:
				break
			else:
				result = result.append(self.substring(pos, idx))
				pos = pos + idx + dlen
				parts += 1

		result = result.append(self.substring(pos, slen - pos))
		result


---
Replace only the first occurrence of old with new.

doctests:
    :: Replace first match
    "abab".replace_first("ab", "x") == "xab"

    :: No match returns unchanged
    "hello".replace_first("xyz", "q") == "hello"
---
pure func replace_first(self: String, old: String, new: String) -> String:
	if old.length() == 0:
		self
	else:
		idx: Int = raw_index_of(self, old)

		if idx < 0:
			self
		else:
			self.substring(
				0,
				idx,
			) + new + self.substring(idx + old.length(), self.length() - idx - old.length())


-- Raw last_index_of builtin (returns -1 if not found) - internal use only
private pure func raw_last_index_of(self: String, needle: String) -> Int:
	builtin("string.raw_last_index_of")


---
Find the last index of needle in string.
Returns Some(index) if found, None if not found.

doctests:
    :: Find last occurrence
    match "abcabc".last_index_of("abc"):
        Some(i):
            i == 3
        None:
            False

    :: Not found
    match "hello".last_index_of("xyz"):
        Some(_):
            False
        None:
            True
---
pure func last_index_of(self: String, needle: String) -> Option[Int]:
	result: Int = raw_last_index_of(self, needle)

	if result == -1:
		None
	else:
		Some(result)


---
Remove characters in the given set from both ends of the string.

doctests:
    :: Trim hash characters
    "##hello##".trim_chars("#") == "hello"

    :: Trim multiple character types
    "xxyhelloxyy".trim_chars("xy") == "hello"
---
pure func trim_chars(self: String, chars: String) -> String:
	builtin("string.trim_chars")


---
Take the last n characters from a string.
Returns the full string if n >= length.

doctests:
    :: Take right
    "hello".take_right(3) == "llo"

    :: Take more than length
    "hi".take_right(10) == "hi"
---
pure func take_right(self: String, n: Int) -> String:
	builtin("string.take_right")


---
Drop the last n characters from a string.
Returns empty string if n >= length.

doctests:
    :: Drop right
    "hello".drop_right(2) == "hel"

    :: Drop all
    "hello".drop_right(10) == ""
---
pure func drop_right(self: String, n: Int) -> String:
	builtin("string.drop_right")


---
Center a string within the given width using a fill character.
Left side gets floor(padding/2), right side gets the rest.

doctests:
    :: Center with spaces
    "hi".center(6, ' ') == "  hi  "

    :: Already wide enough
    "hello".center(3, ' ') == "hello"
---
pure func center(self: String, width: Int, fill: Char) -> String:
	builtin("string.center")


-- ============================================================================
-- String Predicates
-- ============================================================================
---
Check if all characters in the string are ASCII digits.
Returns False for empty strings.

doctests:
    :: All digits
    "12345".is_numeric() == True

    :: Contains non-digit
    "12a".is_numeric() == False

    :: Empty string
    "".is_numeric() == False

    :: Single digit
    "0".is_numeric() == True

    :: With spaces
    "1 2".is_numeric() == False

    :: With decimal point
    "3.14".is_numeric() == False
---
pure func is_numeric(self: String) -> Bool:
	builtin("string.is_numeric")


---
Check if all characters in the string are ASCII (byte values <= 127).
Returns True for empty strings.

doctests:
    :: ASCII string
    "hello".is_ascii() == True

    :: Non-ASCII string
    "café".is_ascii() == False
---
pure func is_ascii(self: String) -> Bool:
	builtin("string.is_ascii")


---
Remove common leading whitespace from all lines in a multi-line string.
Empty lines are ignored when computing the minimum indent.

doctests:
    :: Dedent two-space indent
    dedent("  a\n  b") == "a\nb"
---
func dedent(self: String) -> String:
	all_lines: List[String] = self.split("\n")

	-- Find minimum indent of non-empty lines by comparing length vs trim_left length
	var min_indent: Option[Int] = None

	for line in all_lines:
		if line.length() > 0:
			trimmed: String = line.trim_left()
			indent_len: Int = line.length() - trimmed.length()

			match min_indent:
				None:
					min_indent = Some(indent_len)
				Some(current):
					if indent_len < current:
						min_indent = Some(indent_len)

	indent_to_strip: Int = min_indent.get_or(0)

	-- Strip min_indent from each line
	var result_lines: List[String] = []

	for line in all_lines:
		if line.length() == 0:
			result_lines = result_lines.append(line)
		else:
			result_lines = result_lines.append(line.drop_left(indent_to_strip))

	result_lines.join("\n")


-- ============================================================================
-- Unicode Operations
-- ============================================================================
---
Count the number of Unicode codepoints in a UTF-8 string.
This may differ from byte length for multi-byte characters.

doctests:
    :: ASCII string
    "hello".codepoint_length() == 5

    :: Multi-byte characters
    "café".codepoint_length() == 4
---
pure func codepoint_length(self: String) -> Int:
	builtin("blorp_codepoint_length")


---
Get a list of Unicode codepoints (as integers) from a UTF-8 string.

doctests:
    :: ASCII codepoints
    "AB".codepoints() == [65, 66]
---
pure func codepoints(self: String) -> List[Int]:
	builtin("blorp_string_codepoints")


---
Reverse a string by Unicode codepoints (preserves multi-byte characters).

doctests:
    :: Reverse ASCII
    "hello".codepoint_reverse() == "olleh"
---
pure func codepoint_reverse(self: String) -> String:
	builtin("blorp_codepoint_reverse")


-- ============================================================================
-- String Algorithms
-- ============================================================================
---
Compute the edit distance (Levenshtein distance) between two strings.
Uses dynamic programming with two rows for O(min(m,n)) space.

doctests:
    :: Same strings
    levenshtein("hello", "hello") == 0

    :: One edit
    levenshtein("kitten", "sitten") == 1

    :: Multiple edits
    levenshtein("saturday", "sunday") == 3

    :: Empty strings
    levenshtein("", "") == 0

    :: One empty
    levenshtein("abc", "") == 3

    :: Symmetric
    levenshtein("abc", "def") == levenshtein("def", "abc")

    :: Single char difference
    levenshtein("a", "b") == 1

    :: Insertion
    levenshtein("ac", "abc") == 1

    :: Deletion
    levenshtein("abc", "ac") == 1
---
pure func levenshtein(a: String, b: String) -> Int:
	builtin("blorp_string_levenshtein")


---
Find the longest common prefix of two strings.

doctests:
    :: Common prefix
    longest_common_prefix("hello", "help") == "hel"

    :: No common prefix
    longest_common_prefix("abc", "xyz") == ""

    :: One is prefix of other
    longest_common_prefix("abc", "abcdef") == "abc"

    :: Empty string
    longest_common_prefix("", "hello") == ""

    :: Identical strings
    longest_common_prefix("same", "same") == "same"

    :: Single char match
    longest_common_prefix("ab", "ac") == "a"

    :: Both empty
    longest_common_prefix("", "") == ""
---
pure func longest_common_prefix(a: String, b: String) -> String:
	builtin("string.longest_common_prefix")


---
Hamming distance between two equal-length strings.
Returns None if the strings have different lengths.

doctests:
    :: Same strings
    match hamming_distance("hello", "hello"):
        Some(d):
            d == 0
        None:
            False

    :: Different strings
    match hamming_distance("karolin", "kathrin"):
        Some(d):
            d == 3
        None:
            False

    :: Different lengths
    match hamming_distance("ab", "abc"):
        Some(_):
            False
        None:
            True

    :: All different
    match hamming_distance("abc", "xyz"):
        Some(d):
            d == 3
        None:
            False

    :: Empty strings
    match hamming_distance("", ""):
        Some(d):
            d == 0
        None:
            False

    :: Single char
    match hamming_distance("a", "b"):
        Some(d):
            d == 1
        None:
            False
---
private pure func hamming_distance_raw(a: String, b: String) -> Int:
	builtin("string.hamming_distance_raw")


pure func hamming_distance(a: String, b: String) -> Option[Int]:
	result: Int = hamming_distance_raw(a, b)

	if result < 0:
		None
	else:
		Some(result)


---
Find the longest common substring of two strings.
Returns the first longest common substring found.

doctests:
    :: Common substring
    longest_common_substring("abcdef", "zbcdf") == "bcd"

    :: No common substring
    longest_common_substring("abc", "xyz") == ""

    :: Identical strings
    longest_common_substring("hello", "hello") == "hello"

    :: Empty string
    longest_common_substring("", "hello") == ""

    :: Single char match
    longest_common_substring("axb", "cyb") == "b"

    :: Substring at start
    longest_common_substring("abcxyz", "abcdef") == "abc"

    :: Substring at end
    longest_common_substring("xyzabc", "defabc") == "abc"

    :: Both empty
    longest_common_substring("", "") == ""
---
pure func longest_common_substring(a: String, b: String) -> String:
	builtin("blorp_string_lcs")


-- ============================================================================
-- Number Formatting
-- ============================================================================
---
Convert a non-negative integer to a hexadecimal string (lowercase).
Negative numbers are prefixed with "-".

doctests:
    :: Zero
    to_hex(0) == "0"

    :: Small number
    to_hex(255) == "ff"

    :: Large number
    to_hex(4096) == "1000"

    :: Negative number
    to_hex(-1) == "-1"

    :: Sixteen
    to_hex(16) == "10"
---
pure func to_hex(n: Int) -> String:
	if n == 0:
		"0"
	else if n < 0:
		"-" + to_hex(0 - n)
	else:
		hex_chars: String = "0123456789abcdef"
		var result: String = ""
		var remaining: Int = n

		while remaining > 0:
			digit: Int = remaining % 16

			match hex_chars.get(digit):
				Some(c):
					result = from_char(c) + result
				None:
					result = "?" + result

			remaining /= 16

		result


-- ============================================================================
-- Additional String Functions
-- ============================================================================
---
Split at the first occurrence of delimiter, returning the parts before and after.
Returns None if the delimiter is not found.

doctests:
    :: Found
    match "key=value".split_once("="):
        Some(pair):
            pair[0] == "key" and pair[1] == "value"
        None:
            False

    :: Not found
    match "hello".split_once("="):
        Some(_):
            False
        None:
            True

    :: Multi-char delimiter
    match "a::b::c".split_once("::"):
        Some(pair):
            pair[0] == "a" and pair[1] == "b::c"
        None:
            False
---
pure func split_once(self: String, delim: String) -> Option[(String, String)]:
	i ?= self.index_of(delim)
	Some((self.take_left(i), self.drop_left(i + delim.length())))


---
Check if the string is empty or contains only whitespace.

doctests:
    :: Empty
    "".is_blank() == True

    :: Spaces
    "   ".is_blank() == True

    :: Not blank
    " x ".is_blank() == False

    :: Tabs and newlines
    " \t\n ".is_blank() == True
---
pure func is_blank(self: String) -> Bool:
	builtin("string.is_blank")


---
Check if the string has at least one letter and all letters are lowercase.
Non-letter characters (digits, punctuation) are ignored.

doctests:
    :: All lower
    "hello".is_lower() == True

    :: With digits
    "abc123".is_lower() == True

    :: Has upper
    "Hello".is_lower() == False

    :: Empty
    "".is_lower() == False

    :: No letters
    "123".is_lower() == False
---
pure func is_lower(self: String) -> Bool:
	builtin("string.is_lower")


---
Check if the string has at least one letter and all letters are uppercase.
Non-letter characters (digits, punctuation) are ignored.

doctests:
    :: All upper
    "HELLO".is_upper() == True

    :: With digits
    "ABC123".is_upper() == True

    :: Has lower
    "Hello".is_upper() == False

    :: Empty
    "".is_upper() == False
---
pure func is_upper(self: String) -> Bool:
	builtin("string.is_upper")


---
Add a prefix to each non-empty line. Empty lines are left unchanged.
Inverse of dedent.

doctests:
    :: Basic indent
    "a\nb".indent("  ") == "  a\n  b"

    :: Empty lines preserved
    "a\n\nb".indent("  ") == "  a\n\n  b"

    :: Single line
    "hello".indent("--") == "--hello"
---
pure func indent(self: String, prefix: String) -> String:
	if self.length() == 0:
		""
	else:
		result: List[String] = self
			.split("\n")
			.map(func(line: String):
				if line.length() == 0:
					""
				else:
					prefix + line
			)

		result.join("\n")


---
Truncate a string to max_len characters, appending suffix if truncated.
The total length including suffix will not exceed max_len.

doctests:
    :: Truncated
    "hello world".truncate(8, "...") == "hello..."

    :: Not truncated
    "hi".truncate(10, "...") == "hi"

    :: Exact length
    "hello".truncate(5, "...") == "hello"
---
pure func truncate(self: String, max_len: Int, suffix: String) -> String:
	if self.length() <= max_len:
		self
	else:
		self.take_left(max_len - suffix.length()) + suffix


---
Insert a substring at the given byte index.

doctests:
    :: Middle
    "helo".insert(3, "l") == "hello"

    :: Start
    "world".insert(0, "hello ") == "hello world"

    :: End
    "hello".insert(5, " world") == "hello world"
---
pure func insert(self: String, index: Int, substr: String) -> String:
	self.take_left(index) + substr + self.drop_left(index)


---
Format an integer in the given base (2-36).
Returns lowercase letters for digits above 9.

doctests:
    :: Binary
    to_base(10, 2) == "1010"

    :: Octal
    to_base(255, 8) == "377"

    :: Hex
    to_base(255, 16) == "ff"

    :: Decimal
    to_base(42, 10) == "42"

    :: Zero
    to_base(0, 16) == "0"
---
pure func to_base(n: Int, base: Int) -> String:
	if n == 0:
		"0"
	else:
		digits: String = "0123456789abcdefghijklmnopqrstuvwxyz"
		var result: String = ""
		var remaining: Int = n

		if remaining < 0:
			remaining = 0 - remaining

		while remaining > 0:
			digit: Int = remaining % base

			match digits.get(digit):
				Some(c):
					result = from_char(c) + result
				None:
					result = "?" + result

			remaining /= base

		if n < 0:
			"-" + result
		else:
			result


---
Find all non-overlapping occurrence positions of needle in the string.

doctests:
    :: Multiple occurrences
    "abcabc".indices_of("a") == [0, 3]

    :: No occurrences
    "hello"
        .indices_of("z")
        .length() == 0

    :: Multi-char needle
    "aabaa".indices_of("aa") == [0, 3]
---
pure func indices_of(self: String, needle: String) -> List[Int]:
	if needle.length() == 0 or self.length() == 0:
		[]
	else:
		var result: List[Int] = []
		var pos: Int = 0
		var remaining: String = self

		while remaining.length() >= needle.length():
			match remaining.index_of(needle):
				Some(i):
					result = result.append(pos + i)
					pos = pos + i + needle.length()
					remaining = remaining.drop_left(i + needle.length())
				None:
					remaining = ""

		result


-- String concatenation is handled by the + operator in the compiler
---
Convert an integer to a binary string.

doctests:
    :: Binary of 10
    to_binary(10) == "1010"

    :: Binary of 0
    to_binary(0) == "0"
---
pure func to_binary(n: Int) -> String:
	to_base(n, 2)


---
Zero-pad an integer to the given width.

doctests:
    :: Pad single digit
    zero_pad(5, 3) == "005"

    :: No padding needed
    zero_pad(123, 3) == "123"

    :: Wider than needed
    zero_pad(1234, 3) == "1234"
---
pure func zero_pad(n: Int, width: Int) -> String:
	s: String = n.to_string()
	s.pad_left(width, '0')
