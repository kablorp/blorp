-- HTML - HTML escaping, unescaping, and tag stripping
--
-- Provides utilities for safely working with HTML text.
-- escape() is re-exported from string for convenience.
-- ============================================================================
-- Escaping
-- ============================================================================
---
Escape HTML special characters: < > & " '

doctests:
    :: Escape tags
    escape("<b>bold</b>") == "&lt;b&gt;bold&lt;/b&gt;"

    :: Escape ampersand
    escape("a&b") == "a&amp;b"

    :: Passthrough safe text
    escape("hello") == "hello"
---
pure func escape(s: String) -> String:
	s.html_escape()


---
Unescape HTML entities back to plain text.
Supports &lt; &gt; &amp; &quot; &#39; &apos;

doctests:
    :: Unescape tags
    unescape("&lt;b&gt;") == "<b>"

    :: Unescape amp
    unescape("a&amp;b") == "a&b"

    :: Unescape quotes
    unescape("&quot;hi&quot;") == "\"hi\""

    :: Passthrough
    unescape("hello") == "hello"
---
pure func unescape(s: String) -> String:
	var result: String = ""
	var i: Int = 0
	var slen: Int = s.length()

	while i < slen:
		ch: String = s.substring(i, 1)

		if ch == "&":
			if matches_at(s, i, "&lt;"):
				-- Try to match entities
				result += "<"
				i += 4
			else if matches_at(s, i, "&gt;"):
				result += ">"
				i += 4
			else if matches_at(s, i, "&amp;"):
				result += "&"
				i += 5
			else if matches_at(s, i, "&quot;"):
				result += "\""
				i += 6
			else if matches_at(s, i, "&#39;"):
				result += "'"
				i += 5
			else if matches_at(s, i, "&apos;"):
				result += "'"
				i += 6
			else:
				result += "&"
				i += 1
		else:
			result += ch
			i += 1

	result


---
Strip all HTML tags from a string, keeping only text content.

doctests:
    :: Strip simple tags
    strip_tags("<b>bold</b>") == "bold"

    :: Strip nested tags
    strip_tags("<div><p>hello</p></div>") == "hello"

    :: Strip with attributes
    strip_tags("<a href=\"url\">link</a>") == "link"

    :: No tags
    strip_tags("plain text") == "plain text"
---
pure func strip_tags(s: String) -> String:
	var result: String = ""
	var i: Int = 0
	var in_tag: Bool = False
	var slen: Int = s.length()

	while i < slen:
		ch: String = s.substring(i, 1)

		if ch == "<":
			in_tag = True
		else if ch == ">":
			in_tag = False
		else if not in_tag:
			result += ch
		else:
			void

		i += 1

	result


-- ============================================================================
-- Helpers
-- ============================================================================
private pure func matches_at(s: String, pos: Int, pattern: String) -> Bool:
	plen: Int = pattern.length()
	slen: Int = s.length()

	if pos + plen > slen:
		False
	else:
		s.substring(pos, plen) == pattern
