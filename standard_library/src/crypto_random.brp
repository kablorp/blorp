---
Generate n cryptographically secure random bytes.

doctests:
    :: Random bytes has correct length
    b: Bytes = crypto_random_bytes(16)
    b.length() == 16

    :: Zero bytes returns empty
    b: Bytes = crypto_random_bytes(0)
    b.length() == 0
---
func crypto_random_bytes(n: Int) -> Bytes:
	builtin("blorp_crypto_random_bytes")


---
Generate n random bytes and return as hex string (2n characters).

doctests:
    :: Hex has correct length
    h: String = random_hex(8)
    h.length() == 16
---
func random_hex(n: Int) -> String:
	crypto_random_bytes(n).to_hex()


---
Generate a URL-safe base64 token from n random bytes.
Uses base64url encoding (- instead of +, _ instead of /, no padding).

doctests:
    :: Token is non-empty
    t: String = random_token(16)
    t.length() > 0
---
func random_token(n: Int) -> String:
	raw: String = crypto_random_bytes(n)
		.to_string()
		.base64_encode()
	no_plus: String = raw.replace("+", "-")
	no_slash: String = no_plus.replace("/", "_")
	strip_padding(no_slash)


private pure func strip_padding(s: String) -> String:
	len: Int = s.length()

	if len == 0:
		s
	else:
		last: String = s.substring(len - 1, 1)

		if last == "=":
			strip_padding(s.substring(0, len - 1))
		else:
			s
