import:
	float: log, log10, pow, round
	math: PI


-- Units - Zero-cost unit types for type-safe numeric programming
--
-- Prevents common bugs like mixing radians/degrees, dB/linear amplitude,
-- world/screen coordinates, and time unit confusion.
--
-- Unit types are opaque wrappers over Float or Int. Constructors and explicit
-- raw-value accessors are public; the representation is private to this module.
-- Same-unit arithmetic works via trait operators (+, -, ==, <, etc.).
-- Cross-unit conversions are explicit named functions.
-- ============================================================================
-- Constants
-- ============================================================================
MICROSECONDS_PER_MILLISECOND: Int = 1000

MICROSECONDS_PER_SECOND: Int = 1000000

MICROSECONDS_PER_MINUTE: Int = 60000000

MICROSECONDS_PER_HOUR: Int = 3600000000

MICROSECONDS_PER_DAY: Int = 86400000000

MICROSECONDS_PER_WEEK: Int = 604800000000

MILLISECONDS_PER_SECOND: Float = 1000.0

BYTES_PER_KILOBYTE_SI: Int = 1000

BYTES_PER_MEGABYTE_SI: Int = 1000000

BYTES_PER_GIGABYTE_SI: Int = 1000000000

BYTES_PER_KIBIBYTE_IEC: Int = 1024

BYTES_PER_MEBIBYTE_IEC: Int = 1048576

BYTES_PER_GIBIBYTE_IEC: Int = 1073741824

A4_FREQUENCY_HZ: Float = 440.0

A4_MIDI_NOTE: Int = 69

SEMITONES_PER_OCTAVE: Float = 12.0

AMPLITUDE_DB_FACTOR: Float = 20.0

SILENCE_DB_FLOOR: Float = -120.0

PERCENT_SCALE: Float = 100.0

-- ============================================================================
-- Angle
-- ============================================================================
opaque type Radians = Float

opaque type Degrees = Float


---
Create a Radians value.

doctests:
    :: Create radians
    r = rad(3.14)
    radians_value(r) > 3.0
---
pure func rad(v: Float) -> Radians:
	into_opaque Radians(v)


---
Return the raw Float backing a Radians value.
---
pure func radians_value(r: Radians) -> Float:
	from_opaque Radians(r)


---
Create a Degrees value.

doctests:
    :: Create degrees
    d = deg(90.0)
    degrees_value(d) == 90.0
---
pure func deg(v: Float) -> Degrees:
	into_opaque Degrees(v)


---
Return the raw Float backing a Degrees value.
---
pure func degrees_value(d: Degrees) -> Float:
	from_opaque Degrees(d)


---
Convert degrees to radians.

doctests:
    :: 180 degrees is pi radians
    r = to_radians(deg(180.0))
    radians_value(r) > 3.14 and radians_value(r) < 3.15
---
pure func to_radians(d: Degrees) -> Radians:
	rad(degrees_value(d) * PI / 180.0)


---
Convert radians to degrees.

doctests:
    :: pi radians is 180 degrees
    d = to_degrees(rad(3.141592653589793))
    degrees_value(d) > 179.9 and degrees_value(d) < 180.1
---
pure func to_degrees(r: Radians) -> Degrees:
	deg(radians_value(r) * 180.0 / PI)


implements Addable for Radians:
	pure func add(a: Radians, b: Radians) -> Radians:
		rad(radians_value(a) + radians_value(b))


implements Subtractable for Radians:
	pure func subtract(a: Radians, b: Radians) -> Radians:
		rad(radians_value(a) - radians_value(b))


implements Negatable for Radians:
	pure func negate(a: Radians) -> Radians:
		rad(-radians_value(a))


implements Equatable for Radians:
	pure func equals(a: Radians, b: Radians) -> Bool:
		radians_value(a) == radians_value(b)


implements Orderable for Radians:
	pure func less_than(a: Radians, b: Radians) -> Bool:
		radians_value(a) < radians_value(b)


implements Stringable for Radians:
	pure func to_string(r: Radians) -> String:
		radians_value(r).to_string() + " rad"


implements Addable for Degrees:
	pure func add(a: Degrees, b: Degrees) -> Degrees:
		deg(degrees_value(a) + degrees_value(b))


implements Subtractable for Degrees:
	pure func subtract(a: Degrees, b: Degrees) -> Degrees:
		deg(degrees_value(a) - degrees_value(b))


implements Negatable for Degrees:
	pure func negate(a: Degrees) -> Degrees:
		deg(-degrees_value(a))


implements Equatable for Degrees:
	pure func equals(a: Degrees, b: Degrees) -> Bool:
		degrees_value(a) == degrees_value(b)


implements Orderable for Degrees:
	pure func less_than(a: Degrees, b: Degrees) -> Bool:
		degrees_value(a) < degrees_value(b)


implements Stringable for Degrees:
	pure func to_string(d: Degrees) -> String:
		degrees_value(d).to_string() + " deg"


-- ============================================================================
-- Time
-- ============================================================================
opaque type Seconds = Float

opaque type Milliseconds = Float

-- Duration: integer microseconds for precise system time intervals
opaque type Duration = Int


---
Create a Seconds value.

doctests:
    :: Create seconds
    t = sec(1.5)
    seconds_value(t) == 1.5
---
pure func sec(v: Float) -> Seconds:
	into_opaque Seconds(v)


---
Return the raw Float backing a Seconds value.
---
pure func seconds_value(s: Seconds) -> Float:
	from_opaque Seconds(s)


---
Create a Milliseconds value.

doctests:
    :: Create milliseconds
    t = ms(100.0)
    milliseconds_value(t) == 100.0
---
pure func ms(v: Float) -> Milliseconds:
	into_opaque Milliseconds(v)


---
Return the raw Float backing a Milliseconds value.
---
pure func milliseconds_value(m: Milliseconds) -> Float:
	from_opaque Milliseconds(m)


---
Convert seconds to milliseconds.

doctests:
    :: 1.5 seconds is 1500 ms
    t = sec_to_ms(sec(1.5))
    milliseconds_value(t) == 1500.0
---
pure func sec_to_ms(s: Seconds) -> Milliseconds:
	ms(seconds_value(s) * MILLISECONDS_PER_SECOND)


---
Convert milliseconds to seconds.

doctests:
    :: 500 ms is 0.5 seconds
    t = ms_to_sec(ms(500.0))
    seconds_value(t) == 0.5
---
pure func ms_to_sec(m: Milliseconds) -> Seconds:
	sec(milliseconds_value(m) / MILLISECONDS_PER_SECOND)


implements Addable for Seconds:
	pure func add(a: Seconds, b: Seconds) -> Seconds:
		sec(seconds_value(a) + seconds_value(b))


implements Subtractable for Seconds:
	pure func subtract(a: Seconds, b: Seconds) -> Seconds:
		sec(seconds_value(a) - seconds_value(b))


implements Negatable for Seconds:
	pure func negate(a: Seconds) -> Seconds:
		sec(-seconds_value(a))


implements Equatable for Seconds:
	pure func equals(a: Seconds, b: Seconds) -> Bool:
		seconds_value(a) == seconds_value(b)


implements Orderable for Seconds:
	pure func less_than(a: Seconds, b: Seconds) -> Bool:
		seconds_value(a) < seconds_value(b)


implements Stringable for Seconds:
	pure func to_string(s: Seconds) -> String:
		seconds_value(s).to_string() + " s"


implements Addable for Milliseconds:
	pure func add(a: Milliseconds, b: Milliseconds) -> Milliseconds:
		ms(milliseconds_value(a) + milliseconds_value(b))


implements Subtractable for Milliseconds:
	pure func subtract(a: Milliseconds, b: Milliseconds) -> Milliseconds:
		ms(milliseconds_value(a) - milliseconds_value(b))


implements Negatable for Milliseconds:
	pure func negate(a: Milliseconds) -> Milliseconds:
		ms(-milliseconds_value(a))


implements Equatable for Milliseconds:
	pure func equals(a: Milliseconds, b: Milliseconds) -> Bool:
		milliseconds_value(a) == milliseconds_value(b)


implements Orderable for Milliseconds:
	pure func less_than(a: Milliseconds, b: Milliseconds) -> Bool:
		milliseconds_value(a) < milliseconds_value(b)


implements Stringable for Milliseconds:
	pure func to_string(m: Milliseconds) -> String:
		milliseconds_value(m).to_string() + " ms"


-- Duration (integer microseconds)
---
Create a Duration from microseconds.

doctests:
    :: Create duration
    d = microseconds(1500)
    to_microseconds(d) == 1500
---
pure func microseconds(n: Int) -> Duration:
	into_opaque Duration(n)


---
Create a Duration from milliseconds.

doctests:
    :: 100 ms in microseconds
    d = milliseconds(100)
    to_microseconds(d) == 100000
---
pure func milliseconds(n: Int) -> Duration:
	microseconds(n * MICROSECONDS_PER_MILLISECOND)


---
Create a Duration from seconds.

doctests:
    :: 2 seconds in microseconds
    d = seconds(2)
    to_microseconds(d) == 2000000
---
pure func seconds(n: Int) -> Duration:
	microseconds(n * MICROSECONDS_PER_SECOND)


---
Create a Duration from minutes.

doctests:
    :: 2 minutes in microseconds
    d = minutes(2)
    to_microseconds(d) == 120000000
---
pure func minutes(n: Int) -> Duration:
	microseconds(n * MICROSECONDS_PER_MINUTE)


---
Create a Duration from hours.

doctests:
    :: 1 hour in microseconds
    d = hours(1)
    to_microseconds(d) == 3600000000
---
pure func hours(n: Int) -> Duration:
	microseconds(n * MICROSECONDS_PER_HOUR)


---
Create a Duration from days.

doctests:
    :: 1 day in microseconds
    d = days(1)
    to_microseconds(d) == 86400000000
---
pure func days(n: Int) -> Duration:
	microseconds(n * MICROSECONDS_PER_DAY)


---
Create a Duration from weeks.

doctests:
    :: 1 week in microseconds
    d = weeks(1)
    to_microseconds(d) == 604800000000
---
pure func weeks(n: Int) -> Duration:
	microseconds(n * MICROSECONDS_PER_WEEK)


---
Return the raw microsecond value for a Duration.

doctests:
    :: Duration to microseconds
    to_microseconds(milliseconds(3)) == 3000
---
pure func to_microseconds(d: Duration) -> Int:
	from_opaque Duration(d)


---
Convert a Duration to a non-negative millisecond count for timeout APIs.
Positive sub-millisecond durations round up to 1 ms so they do not collapse
into an immediate poll. Non-positive durations return 0.

doctests:
    :: Sub-millisecond timeout rounds up
    to_timeout_milliseconds(microseconds(1)) == 1

    :: Exact millisecond is unchanged
    to_timeout_milliseconds(microseconds(1000)) == 1

    :: Non-positive timeout is immediate
    to_timeout_milliseconds(microseconds(-1)) == 0
---
pure func to_timeout_milliseconds(d: Duration) -> Int:
	microsecond_count: Int = to_microseconds(d)

	if microsecond_count <= 0:
		0
	else:
		whole_ms: Int = microsecond_count / MICROSECONDS_PER_MILLISECOND

		if microsecond_count % MICROSECONDS_PER_MILLISECOND == 0:
			whole_ms
		else:
			whole_ms + 1


---
Convert Duration to seconds as Float.

doctests:
    :: 1500000 microseconds is 1.5 seconds
    dur_to_seconds(microseconds(1500000)) == 1.5
---
pure func dur_to_seconds(d: Duration) -> Float:
	to_float(to_microseconds(d)) / to_float(MICROSECONDS_PER_SECOND)


---
Convert Duration to Seconds unit type.

doctests:
    :: Duration to Seconds
    s = dur_to_sec(microseconds(2000000))
    seconds_value(s) == 2.0
---
pure func dur_to_sec(d: Duration) -> Seconds:
	sec(dur_to_seconds(d))


---
Convert Seconds to Duration.

doctests:
    :: Seconds to Duration
    d = sec_to_dur(sec(1.5))
    to_microseconds(d) == 1500000
---
pure func sec_to_dur(s: Seconds) -> Duration:
	microseconds(to_int(seconds_value(s) * to_float(MICROSECONDS_PER_SECOND)))


---
Format a Duration in human-readable form, auto-selecting the best unit.

doctests:
    :: Format large duration
    format_duration(seconds(3)) == "3 s"

    :: Format milliseconds
    format_duration(milliseconds(150)) == "150 ms"

    :: Format microseconds
    format_duration(microseconds(42)) == "42 microseconds"
---
pure func format_duration(d: Duration) -> String:
	microsecond_count: Int = to_microseconds(d)

	if microsecond_count >= MICROSECONDS_PER_SECOND:
		(to_float(microsecond_count) / to_float(MICROSECONDS_PER_SECOND)).to_string() + " s"
	else if microsecond_count >= MICROSECONDS_PER_MILLISECOND:
		(to_float(microsecond_count) / to_float(MICROSECONDS_PER_MILLISECOND)).to_string() + " ms"
	else:
		microsecond_count.to_string() + " microseconds"


implements Addable for Duration:
	pure func add(a: Duration, b: Duration) -> Duration:
		microseconds(to_microseconds(a) + to_microseconds(b))


implements Subtractable for Duration:
	pure func subtract(a: Duration, b: Duration) -> Duration:
		microseconds(to_microseconds(a) - to_microseconds(b))


implements Negatable for Duration:
	pure func negate(a: Duration) -> Duration:
		microseconds(-to_microseconds(a))


implements Equatable for Duration:
	pure func equals(a: Duration, b: Duration) -> Bool:
		to_microseconds(a) == to_microseconds(b)


implements Orderable for Duration:
	pure func less_than(a: Duration, b: Duration) -> Bool:
		to_microseconds(a) < to_microseconds(b)


implements Stringable for Duration:
	pure func to_string(d: Duration) -> String:
		format_duration(d)


