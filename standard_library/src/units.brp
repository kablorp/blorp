implements Negatable for Pixels:
	pure func negate(a: Pixels) -> Pixels:
		px(-pixels_value(a))


implements Equatable for Pixels:
	pure func equals(a: Pixels, b: Pixels) -> Bool:
		pixels_value(a) == pixels_value(b)


implements Orderable for Pixels:
	pure func less_than(a: Pixels, b: Pixels) -> Bool:
		pixels_value(a) < pixels_value(b)


implements Stringable for Pixels:
	pure func to_string(p: Pixels) -> String:
		pixels_value(p).to_string() + " px"


-- ============================================================================
-- Audio
-- ============================================================================
opaque type Hz = Float

opaque type Db = Float

opaque type Amplitude = Float

opaque type Samples = Int

opaque type MidiNote = Int


---
Create a Hz (frequency) value.

doctests:
    :: Create Hz
    f = hz(440.0)
    hz_value(f) == 440.0
---
pure func hz(v: Float) -> Hz:
	into_opaque Hz(v)


---
Return the raw Float backing a Hz value.
---
pure func hz_value(f: Hz) -> Float:
	from_opaque Hz(f)


---
Create a Db (decibels) value.

doctests:
    :: Create dB
    d = db(-6.0)
    db_value(d) == -6.0
---
pure func db(v: Float) -> Db:
	into_opaque Db(v)


---
Return the raw Float backing a Db value.
---
pure func db_value(d: Db) -> Float:
	from_opaque Db(d)


---
Create an Amplitude value (linear, typically 0.0-1.0).

doctests:
    :: Create amplitude
    a = amp(0.5)
    amplitude_value(a) == 0.5
---
pure func amp(v: Float) -> Amplitude:
	into_opaque Amplitude(v)


---
Return the raw Float backing an Amplitude value.
---
pure func amplitude_value(a: Amplitude) -> Float:
	from_opaque Amplitude(a)


---
Create a Samples value (audio sample count).

doctests:
    :: Create samples
    s = samples(4410)
    samples_value(s) == 4410
---
pure func samples(v: Int) -> Samples:
	into_opaque Samples(v)


---
Return the raw Int backing a Samples value.
---
pure func samples_value(s: Samples) -> Int:
	from_opaque Samples(s)


---
Create a MidiNote value (0-127).

doctests:
    :: Middle C
    n = midi(60)
    midi_note_value(n) == 60
---
pure func midi(v: Int) -> MidiNote:
	into_opaque MidiNote(v)


---
Return the raw Int backing a MidiNote value.
---
pure func midi_note_value(n: MidiNote) -> Int:
	from_opaque MidiNote(n)


-- Audio conversions
---
Convert linear amplitude to decibels.

doctests:
    :: Unity gain is 0 dB
    d = amp_to_db(amp(1.0))
    db_value(d) == 0.0
---
pure func amp_to_db(a: Amplitude) -> Db:
	raw: Float = amplitude_value(a)

	if raw <= 0.0:
		db(SILENCE_DB_FLOOR)
	else:
		db(AMPLITUDE_DB_FACTOR * log10(raw))


---
Convert decibels to linear amplitude.

doctests:
    :: 0 dB is unity gain
    a = db_to_amp(db(0.0))
    amplitude_value(a) == 1.0
---
pure func db_to_amp(d: Db) -> Amplitude:
	amp(pow(10.0, db_value(d) / AMPLITUDE_DB_FACTOR))


---
Convert a MIDI note number to frequency in Hz.

doctests:
    :: A4 (MIDI 69) is 440 Hz
    f = midi_to_hz(midi(69))
    hz_value(f) == 440.0
---
pure func midi_to_hz(note: MidiNote) -> Hz:
	note_delta: Float = to_float(midi_note_value(note) - A4_MIDI_NOTE)
	hz(A4_FREQUENCY_HZ * pow(2.0, note_delta / SEMITONES_PER_OCTAVE))


---
Convert a frequency in Hz to the nearest MIDI note number.

doctests:
    :: 440 Hz is MIDI 69
    n = hz_to_midi(hz(440.0))
    midi_note_value(n) == 69
---
pure func hz_to_midi(freq: Hz) -> MidiNote:
	ratio: Float = hz_value(freq) / A4_FREQUENCY_HZ
	midi(to_int(round(SEMITONES_PER_OCTAVE * log(ratio) / log(2.0) + to_float(A4_MIDI_NOTE))))


---
Convert frequency to period in seconds.

doctests:
    :: 1000 Hz has 1 ms period
    p = hz_to_period(hz(1000.0))
    seconds_value(p) == 0.001
---
pure func hz_to_period(freq: Hz) -> Seconds:
	sec(1.0 / hz_value(freq))


---
Convert period to frequency.

doctests:
    :: 0.001 s period is 1000 Hz
    f = period_to_hz(sec(0.001))
    hz_value(f) == 1000.0
---
pure func period_to_hz(period: Seconds) -> Hz:
	hz(1.0 / seconds_value(period))


---
Convert a time in seconds to sample count at a given sample rate.

doctests:
    :: 0.1 seconds at 44100 Hz
    s = sec_to_samples(sec(0.1), hz(44100.0))
    samples_value(s) == 4410
---
pure func sec_to_samples(t: Seconds, rate: Hz) -> Samples:
	samples(to_int(seconds_value(t) * hz_value(rate)))


---
Convert sample count to time in seconds at a given sample rate.

doctests:
    :: 44100 samples at 44100 Hz is 1 second
    t = samples_to_sec(samples(44100), hz(44100.0))
    seconds_value(t) == 1.0
---
pure func samples_to_sec(s: Samples, rate: Hz) -> Seconds:
	sec(to_float(samples_value(s)) / hz_value(rate))


implements Addable for Hz:
	pure func add(a: Hz, b: Hz) -> Hz:
		hz(hz_value(a) + hz_value(b))


implements Subtractable for Hz:
	pure func subtract(a: Hz, b: Hz) -> Hz:
		hz(hz_value(a) - hz_value(b))


implements Equatable for Hz:
	pure func equals(a: Hz, b: Hz) -> Bool:
		hz_value(a) == hz_value(b)


implements Orderable for Hz:
	pure func less_than(a: Hz, b: Hz) -> Bool:
		hz_value(a) < hz_value(b)


implements Stringable for Hz:
	pure func to_string(f: Hz) -> String:
		hz_value(f).to_string() + " Hz"


implements Addable for Db:
	pure func add(a: Db, b: Db) -> Db:
		db(db_value(a) + db_value(b))


implements Subtractable for Db:
	pure func subtract(a: Db, b: Db) -> Db:
		db(db_value(a) - db_value(b))


implements Negatable for Db:
	pure func negate(a: Db) -> Db:
		db(-db_value(a))


implements Equatable for Db:
	pure func equals(a: Db, b: Db) -> Bool:
		db_value(a) == db_value(b)


implements Orderable for Db:
	pure func less_than(a: Db, b: Db) -> Bool:
		db_value(a) < db_value(b)


implements Stringable for Db:
	pure func to_string(d: Db) -> String:
		db_value(d).to_string() + " dB"


implements Addable for Amplitude:
	pure func add(a: Amplitude, b: Amplitude) -> Amplitude:
		amp(amplitude_value(a) + amplitude_value(b))


implements Subtractable for Amplitude:
	pure func subtract(a: Amplitude, b: Amplitude) -> Amplitude:
		amp(amplitude_value(a) - amplitude_value(b))


implements Equatable for Amplitude:
	pure func equals(a: Amplitude, b: Amplitude) -> Bool:
		amplitude_value(a) == amplitude_value(b)


implements Orderable for Amplitude:
	pure func less_than(a: Amplitude, b: Amplitude) -> Bool:
		amplitude_value(a) < amplitude_value(b)


implements Stringable for Amplitude:
	pure func to_string(a: Amplitude) -> String:
		amplitude_value(a).to_string() + " amp"


implements Addable for Samples:
	pure func add(a: Samples, b: Samples) -> Samples:
		samples(samples_value(a) + samples_value(b))


implements Subtractable for Samples:
	pure func subtract(a: Samples, b: Samples) -> Samples:
		samples(samples_value(a) - samples_value(b))


implements Equatable for Samples:
	pure func equals(a: Samples, b: Samples) -> Bool:
		samples_value(a) == samples_value(b)


implements Orderable for Samples:
	pure func less_than(a: Samples, b: Samples) -> Bool:
		samples_value(a) < samples_value(b)


implements Stringable for Samples:
	pure func to_string(s: Samples) -> String:
		samples_value(s).to_string() + " samples"


implements Addable for MidiNote:
	pure func add(a: MidiNote, b: MidiNote) -> MidiNote:
		midi(midi_note_value(a) + midi_note_value(b))


implements Subtractable for MidiNote:
	pure func subtract(a: MidiNote, b: MidiNote) -> MidiNote:
		midi(midi_note_value(a) - midi_note_value(b))


implements Equatable for MidiNote:
	pure func equals(a: MidiNote, b: MidiNote) -> Bool:
		midi_note_value(a) == midi_note_value(b)


implements Orderable for MidiNote:
	pure func less_than(a: MidiNote, b: MidiNote) -> Bool:
		midi_note_value(a) < midi_note_value(b)


implements Stringable for MidiNote:
	pure func to_string(n: MidiNote) -> String:
		"MIDI " + midi_note_value(n).to_string()


-- ============================================================================
-- Data
-- ============================================================================
-- DataSize: integer bytes for precise data size tracking
opaque type DataSize = Int

-- Ratio: normalized 0.0-1.0 value for percentages and fractions
opaque type Ratio = Float


---
Create a DataSize from bytes.

doctests:
    :: Create from bytes
    d = from_bytes(1024)
    data_size_bytes(d) == 1024
---
pure func from_bytes(n: Int) -> DataSize:
	into_opaque DataSize(n)


---
Return the raw byte count backing a DataSize value.
---
pure func data_size_bytes(d: DataSize) -> Int:
	from_opaque DataSize(d)


---
Create a DataSize from kilobytes (SI, 1 KB = 1000 bytes).

doctests:
    :: 1 KB
    d = kilobytes(1)
    data_size_bytes(d) == 1000
---
pure func kilobytes(n: Int) -> DataSize:
	from_bytes(n * BYTES_PER_KILOBYTE_SI)


---
Create a DataSize from megabytes (SI, 1 MB = 1,000,000 bytes).

doctests:
    :: 1 MB
    d = megabytes(1)
    data_size_bytes(d) == 1000000
---
pure func megabytes(n: Int) -> DataSize:
	from_bytes(n * BYTES_PER_MEGABYTE_SI)


---
Create a DataSize from gigabytes (SI, 1 GB = 1,000,000,000 bytes).

doctests:
    :: 1 GB
    d = gigabytes(1)
    data_size_bytes(d) == 1000000000
---
pure func gigabytes(n: Int) -> DataSize:
	from_bytes(n * BYTES_PER_GIGABYTE_SI)


---
Create a DataSize from kibibytes (IEC, 1 KiB = 1024 bytes).

doctests:
    :: 1 KiB
    d = kibibytes(1)
    data_size_bytes(d) == 1024
---
pure func kibibytes(n: Int) -> DataSize:
	from_bytes(n * BYTES_PER_KIBIBYTE_IEC)


---
Create a DataSize from mebibytes (IEC, 1 MiB = 1,048,576 bytes).

doctests:
    :: 1 MiB
    d = mebibytes(1)
    data_size_bytes(d) == 1048576
---
pure func mebibytes(n: Int) -> DataSize:
	from_bytes(n * BYTES_PER_MEBIBYTE_IEC)


---
Create a DataSize from gibibytes (IEC, 1 GiB = 1,073,741,824 bytes).

doctests:
    :: 1 GiB
    d = gibibytes(1)
    data_size_bytes(d) == 1073741824
---
pure func gibibytes(n: Int) -> DataSize:
	from_bytes(n * BYTES_PER_GIBIBYTE_IEC)


---
Format a DataSize using SI units (powers of 1000).

doctests:
    :: Format bytes
    format_size_si(from_bytes(500)) == "500 B"

    :: Format KB
    format_size_si(kilobytes(15)) == "15 KB"

    :: Format MB
    format_size_si(megabytes(3)) == "3 MB"
---
pure func format_size_si(d: DataSize) -> String:
	bytes: Int = data_size_bytes(d)

	if bytes >= BYTES_PER_GIGABYTE_SI:
		(to_float(bytes) / to_float(BYTES_PER_GIGABYTE_SI)).to_string() + " GB"
	else if bytes >= BYTES_PER_MEGABYTE_SI:
		(to_float(bytes) / to_float(BYTES_PER_MEGABYTE_SI)).to_string() + " MB"
	else if bytes >= BYTES_PER_KILOBYTE_SI:
		(to_float(bytes) / to_float(BYTES_PER_KILOBYTE_SI)).to_string() + " KB"
	else:
		bytes.to_string() + " B"


---
Format a DataSize using IEC units (powers of 1024).

doctests:
    :: Format bytes
    format_size_iec(from_bytes(500)) == "500 B"

    :: Format KiB
    format_size_iec(kibibytes(15)) == "15 KiB"
---
pure func format_size_iec(d: DataSize) -> String:
	bytes: Int = data_size_bytes(d)

	if bytes >= BYTES_PER_GIBIBYTE_IEC:
		(to_float(bytes) / to_float(BYTES_PER_GIBIBYTE_IEC)).to_string() + " GiB"
	else if bytes >= BYTES_PER_MEBIBYTE_IEC:
		(to_float(bytes) / to_float(BYTES_PER_MEBIBYTE_IEC)).to_string() + " MiB"
	else if bytes >= BYTES_PER_KIBIBYTE_IEC:
		(to_float(bytes) / to_float(BYTES_PER_KIBIBYTE_IEC)).to_string() + " KiB"
	else:
		bytes.to_string() + " B"


implements Addable for DataSize:
	pure func add(a: DataSize, b: DataSize) -> DataSize:
		from_bytes(data_size_bytes(a) + data_size_bytes(b))


implements Subtractable for DataSize:
	pure func subtract(a: DataSize, b: DataSize) -> DataSize:
		from_bytes(data_size_bytes(a) - data_size_bytes(b))


implements Equatable for DataSize:
	pure func equals(a: DataSize, b: DataSize) -> Bool:
		data_size_bytes(a) == data_size_bytes(b)


implements Orderable for DataSize:
	pure func less_than(a: DataSize, b: DataSize) -> Bool:
		data_size_bytes(a) < data_size_bytes(b)


implements Stringable for DataSize:
	pure func to_string(d: DataSize) -> String:
		format_size_si(d)


-- Ratio
---
Create a Ratio from a fraction (0.0 to 1.0).

doctests:
    :: Create from fraction
    r = fraction(0.75)
    ratio_value(r) == 0.75
---
pure func fraction(v: Float) -> Ratio:
	into_opaque Ratio(v)


---
Return the raw Float backing a Ratio value.
---
pure func ratio_value(r: Ratio) -> Float:
	from_opaque Ratio(r)


---
Create a Ratio from a percentage (0 to 100).

doctests:
    :: 50 percent
    r = percent(50.0)
    ratio_value(r) == 0.5
---
pure func percent(v: Float) -> Ratio:
	fraction(v / PERCENT_SCALE)


---
Convert a Ratio to percentage.

doctests:
    :: To percentage
    to_percent(fraction(0.75)) == 75.0
---
pure func to_percent(r: Ratio) -> Float:
	ratio_value(r) * PERCENT_SCALE


implements Addable for Ratio:
	pure func add(a: Ratio, b: Ratio) -> Ratio:
		fraction(ratio_value(a) + ratio_value(b))


implements Subtractable for Ratio:
	pure func subtract(a: Ratio, b: Ratio) -> Ratio:
		fraction(ratio_value(a) - ratio_value(b))


implements Equatable for Ratio:
	pure func equals(a: Ratio, b: Ratio) -> Bool:
		ratio_value(a) == ratio_value(b)


implements Orderable for Ratio:
	pure func less_than(a: Ratio, b: Ratio) -> Bool:
		ratio_value(a) < ratio_value(b)


implements Stringable for Ratio:
	pure func to_string(r: Ratio) -> String:
		to_percent(r).to_string() + "%"
