-- UInt8 - Trait Implementations
--
-- Unsigned 8-bit integer type.
type UInt8 = builtin


implements Stringable for UInt8:
	pure func to_string(val: UInt8) -> String:
		builtin("blorp_to_string")


implements Equatable for UInt8:
	pure func equals(a: UInt8, b: UInt8) -> Bool:
		a == b

	pure func not_equals(a: UInt8, b: UInt8) -> Bool:
		a != b


implements Orderable for UInt8:
	pure func less_than(a: UInt8, b: UInt8) -> Bool:
		a < b

	pure func greater_than(a: UInt8, b: UInt8) -> Bool:
		a > b

	pure func less_than_or_equal(a: UInt8, b: UInt8) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: UInt8, b: UInt8) -> Bool:
		a >= b


implements Bounded for UInt8:
	pure func min(a: UInt8, b: UInt8) -> UInt8:
		match a < b:
			True:
				a
			_:
				b

	pure func max(a: UInt8, b: UInt8) -> UInt8:
		match a > b:
			True:
				a
			_:
				b


implements HasZero for UInt8:
	pure func zero() -> UInt8:
		to_uint8(0)


implements HasOne for UInt8:
	pure func one() -> UInt8:
		to_uint8(1)


implements ToBool for UInt8:
	pure func to_bool(val: UInt8) -> Bool:
		val != to_uint8(0)


implements ToInt for UInt8:
	pure func to_int(val: UInt8) -> Int:
		to_int(val)


implements Addable for UInt8:
	pure func add(a: UInt8, b: UInt8) -> UInt8:
		a + b


implements Subtractable for UInt8:
	pure func subtract(a: UInt8, b: UInt8) -> UInt8:
		a - b


implements Multipliable for UInt8:
	pure func multiply(a: UInt8, b: UInt8) -> UInt8:
		a * b


implements Divisible for UInt8:
	pure func divide(a: UInt8, b: UInt8) -> UInt8:
		a / b


implements Modulable for UInt8:
	pure func remainder(a: UInt8, b: UInt8) -> UInt8:
		a % b


implements Absolute for UInt8:
	pure func abs(val: UInt8) -> UInt8:
		val
