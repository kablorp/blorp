-- FixedPoint - Fixed-point decimal type
--
-- FixedPoint is a decimal number with runtime-tracked scale and precision.
-- Internally stored as a scaled integer to avoid floating-point rounding errors.
--
-- Example:
-- price = fixed_point(19.99, 2)       -- scale=2 (cents)
-- rate = fixed_point(0.0825, 4)       -- scale=4 (basis points)
-- total = price * (1 + rate)    -- auto-normalizes, no type errors
--
-- Operations auto-normalize:
-- - Addition/Subtraction: converts to max scale
-- - Multiplication: scales add (0.01 * 0.01 = 0.0001)
-- - Division: uses extended precision with rounding
--
-- Negative scale is valid for large numbers:
-- millions = fixed_point(5000000.0, -6) -- represents 5,000,000
--
-- Arithmetic operators (+, -, *, /) and comparisons (<, >, ==, etc.)
-- are handled automatically by the compiler for FixedPoint types.
type FixedPoint = builtin


-- Declared here rather than with ToInt/ToFloat/ToChar in traits.brp only because
-- the pinned bootstrap compiler loads the prelude traits.brp and cannot resolve
-- `FixedPoint` there. Move it back to traits.brp after the next bootstrap rotation.
trait ToFixedPoint:
	pure func to_fixed_point(value: Self) -> FixedPoint


---
Create FixedPoint from Float with given scale (precision defaults to 18).

doctests:
    :: Create fixed with scale
    f: FixedPoint = fixed_point(19.99, 2)
    get_scale(f) == 2
---
pure func fixed_point(value: Float, scale: Int) -> FixedPoint:
	builtin("fixed_point.fixed_point")


---
Create FixedPoint with explicit precision.

doctests:
    :: Create with explicit precision
    f: FixedPoint = with_precision(1.5, 1, 10)
    get_precision(f) == 10
---
pure func with_precision(value: Float, scale: Int, precision: Int) -> FixedPoint:
	builtin("fixed_point.with_precision")


---
Create FixedPoint from Int.
---
pure func from_int(value: Int, scale: Int) -> FixedPoint:
	builtin("fixed_point.from_int")


---
Negation.
---
pure func neg(a: FixedPoint) -> FixedPoint:
	builtin("fixed_point.neg")


---
Round to a specific scale.

doctests:
    :: Round to fewer decimal places
    f: FixedPoint = fixed_point(3.14159, 5)
    r: FixedPoint = round_to(f, 2)
    get_scale(r) == 2
---
pure func round_to(f: FixedPoint, scale: Int) -> FixedPoint:
	builtin("fixed_point.round_to")


---
Get the scale of a FixedPoint value.

doctests:
    :: Get scale of fixed value
    f: FixedPoint = fixed_point(1.0, 3)
    get_scale(f) == 3
---
pure func get_scale(f: FixedPoint) -> Int:
	builtin("fixed_point.get_scale")


---
Get the precision of a FixedPoint value.

doctests:
    :: Default precision is 18
    f: FixedPoint = fixed_point(1.0, 2)
    get_precision(f) == 18
---
pure func get_precision(f: FixedPoint) -> Int:
	builtin("fixed_point.get_precision")


---
Convert FixedPoint to string representation.
---
pure func to_string(f: FixedPoint) -> String:
	builtin("fixed_point.to_string")


---
Convert FixedPoint to Int (truncates toward zero).
---
pure func to_int(f: FixedPoint) -> Int:
	builtin("fixed_point.to_int")


---
Convert FixedPoint to Float.
---
pure func to_float(f: FixedPoint) -> Float:
	builtin("fixed_point.to_float")


-- ============================================================================
-- Trait Implementations for FixedPoint
-- ============================================================================
implements Equatable for FixedPoint:
	pure func equals(a: FixedPoint, b: FixedPoint) -> Bool:
		builtin("fixed_point.equals")

	pure func not_equals(a: FixedPoint, b: FixedPoint) -> Bool:
		builtin("fixed_point.not_equals")


-- Arithmetic implementations use exact compiler-provided native targets.
-- Their source declarations authorize both operators and explicit trait calls.
implements Addable for FixedPoint:
	pure func add(a: FixedPoint, b: FixedPoint) -> FixedPoint:
		builtin("fixed_point.add")


implements Subtractable for FixedPoint:
	pure func subtract(a: FixedPoint, b: FixedPoint) -> FixedPoint:
		builtin("fixed_point.subtract")


implements Multipliable for FixedPoint:
	pure func multiply(a: FixedPoint, b: FixedPoint) -> FixedPoint:
		builtin("fixed_point.multiply")


implements Divisible for FixedPoint:
	pure func divide(a: FixedPoint, b: FixedPoint) -> FixedPoint:
		builtin("fixed_point.divide")


implements Stringable for FixedPoint:
	pure func to_string(val: FixedPoint) -> String:
		val.to_string()


implements HasZero for FixedPoint:
	pure func zero() -> FixedPoint:
		fixed_point(0.0, 0)
