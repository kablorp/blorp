-- UInt128 - Trait Implementations
--
-- Unsigned 128-bit integer type.
import:
	hash: hash_combine


-- 2^32; its square is the radix between a 128-bit value's 64-bit halves.
private HALF_WORD_RADIX: Int = 4294967296

type UInt128 = builtin


implements Stringable for UInt128:
	pure func to_string(val: UInt128) -> String:
		builtin("blorp_uint128_to_string")


implements Equatable for UInt128:
	pure func equals(a: UInt128, b: UInt128) -> Bool:
		builtin("uint128.equals")

	pure func not_equals(a: UInt128, b: UInt128) -> Bool:
		builtin("uint128.not_equals")


---
Hashes both 64-bit halves, so values that differ only above bit 63 still hash
apart. Dict and Set keys of UInt128 hash and compare through this impl and
Equatable.
---
implements Hashable for UInt128:
	pure func hash(self: UInt128) -> Int:
		-- 2^64 splits the value into its high and low 64-bit halves.
		half_radix: UInt128 = to_uint128(HALF_WORD_RADIX) * to_uint128(HALF_WORD_RADIX)
		hash_combine(to_int(self / half_radix).hash(), to_int(self).hash())


implements Orderable for UInt128:
	pure func less_than(a: UInt128, b: UInt128) -> Bool:
		builtin("uint128.less_than")

	pure func greater_than(a: UInt128, b: UInt128) -> Bool:
		builtin("uint128.greater_than")

	pure func less_than_or_equal(a: UInt128, b: UInt128) -> Bool:
		builtin("uint128.less_than_or_equal")

	pure func greater_than_or_equal(a: UInt128, b: UInt128) -> Bool:
		builtin("uint128.greater_than_or_equal")


implements Bounded for UInt128:
	pure func min(a: UInt128, b: UInt128) -> UInt128:
		match a < b:
			True:
				a
			_:
				b

	pure func max(a: UInt128, b: UInt128) -> UInt128:
		match a > b:
			True:
				a
			_:
				b


implements HasZero for UInt128:
	pure func zero() -> UInt128:
		to_uint128(0)


implements HasOne for UInt128:
	pure func one() -> UInt128:
		to_uint128(1)


implements ToBool for UInt128:
	pure func to_bool(val: UInt128) -> Bool:
		val != to_uint128(0)


implements ToInt for UInt128:
	pure func to_int(val: UInt128) -> Int:
		to_int(val)


implements Addable for UInt128:
	pure func add(a: UInt128, b: UInt128) -> UInt128:
		builtin("uint128.add")


implements Subtractable for UInt128:
	pure func subtract(a: UInt128, b: UInt128) -> UInt128:
		builtin("uint128.subtract")


implements Multipliable for UInt128:
	pure func multiply(a: UInt128, b: UInt128) -> UInt128:
		builtin("uint128.multiply")


implements Divisible for UInt128:
	pure func divide(a: UInt128, b: UInt128) -> UInt128:
		builtin("uint128.divide")


implements Modulable for UInt128:
	pure func remainder(a: UInt128, b: UInt128) -> UInt128:
		builtin("uint128.remainder")


implements Absolute for UInt128:
	pure func abs(val: UInt128) -> UInt128:
		val
