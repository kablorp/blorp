-- Typed filesystem resource API foundation.
--
-- This module exposes scoped file and directory handles through explicit
-- capability traits. `with` owns handle cleanup; operation traits describe what
-- a handle can do.
import:
	path: is_absolute, join
	stream: FallibleStream, collect_result
	system: file_exists


---
Opaque handle for read-only file operations.
---
resource type FileReader = builtin("blorp_file_close_reader")


---
Opaque handle for write-only file operations.
---
resource type FileWriter = builtin("blorp_file_close_writer")


---
Opaque handle for append-only file operations.
---
resource type FileAppender = builtin("blorp_file_close_appender")


---
Opaque handle for read-write file operations.
---
resource type FileReadWriter = builtin("blorp_file_close_read_writer")


---
Opaque handle for read-append file operations.
---
resource type FileReadAppender = builtin("blorp_file_close_read_appender")


---
Opaque handle for streaming directory entries.
---
resource type Directory = builtin("blorp_dir_close")


---
Directory entry kind reported by `next_entry`, `next_entries`, and `entry_stream`.

`EntryUnknown` is reserved for filesystem backends that cannot classify an
entry without returning an error. The current POSIX backend returns the
underlying `IOError` instead, so it does not emit this variant.
---
fixed union DirectoryEntryKind:
	EntryFile
	EntryDirectory
	EntrySymlink
	EntryOther
	EntryUnknown


---
A single entry from a directory stream.

`name` is the entry basename, not a joined path.
---
record DirectoryEntry {
	name: String,
	kind: DirectoryEntryKind
}


---
Private finalizer trait implemented by scoped file handles.

`with` blocks use compiler-owned cleanup builtins directly. This trait keeps the
runtime finalizers documented inside the module without exporting a manual
`close` operation that could conflict with scoped cleanup ownership.
---
private trait FileClosable:
	func close(handle: Self) -> Void


implements FileClosable for FileReader:
	func close(reader: FileReader) -> Void:
		builtin("blorp_file_close_reader")


implements FileClosable for FileWriter:
	func close(writer: FileWriter) -> Void:
		builtin("blorp_file_close_writer")


implements FileClosable for FileAppender:
	func close(appender: FileAppender) -> Void:
		builtin("blorp_file_close_appender")


implements FileClosable for FileReadWriter:
	func close(file: FileReadWriter) -> Void:
		builtin("blorp_file_close_read_writer")


implements FileClosable for FileReadAppender:
	func close(file: FileReadAppender) -> Void:
		builtin("blorp_file_close_read_appender")


implements FileClosable for Directory:
	func close(dir: Directory) -> Void:
		builtin("blorp_dir_close")


---
Read sequentially from a scoped file handle.
---
trait FileReadable:
	func read_text(handle: Self) -> Result[String, IOError]
	func read_bytes(handle: Self) -> Result[Bytes, IOError]
	func read_chunk(handle: Self, max_bytes: Int) -> Result[Bytes, IOError]
	func count_lines(handle: Self) -> Result[Int, IOError]


---
Read from a stable offset without changing the handle's current file offset.
---
trait FileReadAt:
	func read_chunk_at(handle: Self, offset: Int, max_bytes: Int) -> Result[Bytes, IOError]


---
Write at the handle's current file offset.
---
trait FileWritable:
	func write_text(handle: Self, text: String) -> Result[Void, IOError]
	func write_bytes(handle: Self, data: Bytes) -> Result[Void, IOError]
	func write_chunk(handle: Self, data: Bytes) -> Result[Int, IOError]


---
Append to the end of the file.
---
trait FileAppendable:
	func append_text(handle: Self, text: String) -> Result[Void, IOError]
	func append_bytes(handle: Self, data: Bytes) -> Result[Void, IOError]
	func append_chunk(handle: Self, data: Bytes) -> Result[Int, IOError]


---
Query metadata from an open file handle.
---
trait FileSized:
	func size(handle: Self) -> Result[Int, IOError]


---
Expose the filesystem path associated with a scoped resource.

The returned string is an ordinary value and may outlive the resource. For a
resource returned by `temporary_file` or `temporary_directory`, the path is
removed when the resource scope exits.
---
trait ResourcePath:
	func resource_path(handle: Self) -> String


---
Errors reported by typed file APIs.

Path-specific variants carry the path that was used for the operation. General
variants carry a human-readable detail string from the runtime or caller.
---
union IOError:
	NotFound(String)
	PermissionDenied(String)
	AlreadyExists(String)
	InvalidInput(String)
	Interrupted(String)
	TimedOut(String)
	Unsupported(String)
	Other(String)


implements Equatable for IOError:
	pure func equals(left: IOError, right: IOError) -> Bool:
		match (left, right):
			(NotFound(left_value), NotFound(right_value)):
				left_value == right_value
			(PermissionDenied(left_value), PermissionDenied(right_value)):
				left_value == right_value
			(AlreadyExists(left_value), AlreadyExists(right_value)):
				left_value == right_value
			(InvalidInput(left_value), InvalidInput(right_value)):
				left_value == right_value
			(Interrupted(left_value), Interrupted(right_value)):
				left_value == right_value
			(TimedOut(left_value), TimedOut(right_value)):
				left_value == right_value
			(Unsupported(left_value), Unsupported(right_value)):
				left_value == right_value
			(Other(left_value), Other(right_value)):
				left_value == right_value
			_:
				False

	pure func not_equals(left: IOError, right: IOError) -> Bool:
		not equals(left, right)


---
Return a stable, human-readable description of an I/O error.

doctests:
    :: Missing path
    message(NotFound("/tmp/missing")) == "not found: /tmp/missing"

    :: Permission denied
    message(PermissionDenied("/root/secret")) == "permission denied: /root/secret"
---
pure func message(err: IOError) -> String:
	match err:
		NotFound(path):
			"not found: " + path
		PermissionDenied(path):
			"permission denied: " + path
		AlreadyExists(path):
			"already exists: " + path
		InvalidInput(detail):
			"invalid input: " + detail
		Interrupted(detail):
			"interrupted: " + detail
		TimedOut(detail):
			"timed out: " + detail
		Unsupported(detail):
			"unsupported: " + detail
		Other(detail):
			"io error: " + detail


implements Stringable for IOError:
	pure func to_string(err: IOError) -> String:
		message(err)


---
Open a file for reading as a scoped resource.

Use with `with reader ?= open_read(path):` so the reader is closed
automatically when the block exits.
---
func open_read(path: String) -> Result[FileReader, IOError]:
	builtin("blorp_file_open_read_raw")


---
Open a file for writing as a scoped resource.

Creates the file if it is missing and truncates it if it already exists. Use
with `with writer ?= open_write(path):` so the writer is closed automatically
when the block exits.
---
func open_write(path: String) -> Result[FileWriter, IOError]:
	builtin("blorp_file_open_write_raw")


---
Open a file for appending as a scoped resource.

Creates the file if it is missing and preserves existing contents. Use with
`with appender ?= open_append(path):` so the appender is closed automatically
when the block exits.
---
func open_append(path: String) -> Result[FileAppender, IOError]:
	builtin("blorp_file_open_append_raw")


---
Open an existing file for reading and writing as a scoped resource.

The path must already exist. The file is not truncated. Use with
`with file ?= open_read_write(path):` so the handle is closed automatically
when the block exits.
---
func open_read_write(path: String) -> Result[FileReadWriter, IOError]:
	builtin("blorp_file_open_read_write_raw")


---
Open an existing file for reading and appending as a scoped resource.

The path must already exist. Reads use the current file offset, while append
operations always write at the end of the file.
---
func open_read_append(path: String) -> Result[FileReadAppender, IOError]:
	builtin("blorp_file_open_read_append_raw")


---
Open a directory as a scoped resource.

Use with `with directory ?= open_directory(path):` so the directory stream is closed
automatically when the block exits. A symbolic-link final path component is rejected
instead of being followed. Parent path components use normal operating-system path
resolution, which preserves platform paths such as macOS's `/tmp` alias.
---
func open_directory(path: String) -> Result[Directory, IOError]:
	builtin("blorp_dir_open_raw")


---
Create a scoped temporary file under `parent`.

`prefix` must be a non-empty filename prefix, not a path. The file is opened
with owner-only permissions and removed automatically on scope exit.
---
func temporary_file(parent: String, prefix: String) -> Result[FileWriter, IOError]:
	builtin("blorp_temporary_file_open_raw")


---
Create a scoped temporary directory under `parent`.

`prefix` must be a non-empty filename prefix, not a path. The generated
directory is removed recursively on scope exit.
---
func temporary_directory(parent: String, prefix: String) -> Result[Directory, IOError]:
	builtin("blorp_temporary_directory_open_raw")


private ATOMIC_TEXT_CONTENT_STRING: Int = 0

private ATOMIC_TEXT_CONTENT_PARTS: Int = 1


---
Atomically replace `path` with `text`.

The complete content is written to a collision-resistant sibling file, synced,
closed, and then renamed over the destination. A failure before the rename
leaves any existing destination unchanged.
---
func write_text_atomic(path: String, text: String) -> Result[Void, IOError]:
	write_text_atomic_raw(path, text, ATOMIC_TEXT_CONTENT_STRING)


---
Atomically replace `path` with the ordered concatenation of `parts`.

Parts are written directly to the temporary file without constructing a joined
String. Empty parts are accepted. The sync-and-rename guarantee is identical to
`write_text_atomic`.
---
func write_text_parts_atomic(path: String, parts: List[String]) -> Result[Void, IOError]:
	write_text_parts_atomic_raw(path, parts, ATOMIC_TEXT_CONTENT_PARTS)


-- Both typed wrappers use the bootstrap-known symbol. The explicit kind keeps
-- the native boundary from guessing whether the managed payload is a String or List.
private func write_text_atomic_raw(
	path: String,
	text: String,
	content_kind: Int,
) -> Result[Void, IOError]:
	builtin("blorp_file_write_text_atomic_raw")


private func write_text_parts_atomic_raw(
	path: String,
	parts: List[String],
	content_kind: Int,
) -> Result[Void, IOError]:
	builtin("blorp_file_write_text_atomic_raw")


---
Create `path` and any missing parent directories.

Existing directories are accepted. An existing non-directory path returns an
error.
---
func create_directories(path: String) -> Result[Void, IOError]:
	builtin("blorp_file_create_directories_raw")


---
Rename a filesystem path atomically within one filesystem.
---
func rename_path(source: String, destination: String) -> Result[Void, IOError]:
	builtin("blorp_file_rename_path_raw")


---
Remove a directory tree without following symbolic links.

A symbolic link encountered at any depth is removed as a link; its target is
never traversed.
---
func remove_directory_tree(path: String) -> Result[Void, IOError]:
	builtin("blorp_file_remove_directory_tree_raw")


---
Read the next entry from a scoped directory handle.

Returns `Ok(None)` after the directory stream is exhausted. Entries named `.`
and `..` are skipped.
---
@resource_result_ordinary
func next_entry(directory: Directory) -> Result[Option[DirectoryEntry], IOError]:
	builtin("blorp_dir_read_entry_raw")


---
Read the next batch of up to `limit` entries from a scoped directory handle.

Returns `Ok([])` after the directory stream is exhausted. Entries named `.`
and `..` are skipped. Passing a non-positive `limit` returns
`Err(InvalidInput(...))`.
---
@resource_result_ordinary
func next_entries(directory: Directory, limit: Int) -> Result[List[DirectoryEntry], IOError]:
	builtin("blorp_dir_read_next_entries_raw")


