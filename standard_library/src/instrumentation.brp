import:
	system: now_microseconds
	units: Duration, microseconds as make_duration_microseconds


-- General instrumentation helpers.
--
-- Benchmark harness policy lives under benchmarks/blorp/support. This module
-- only exposes small timing and optimizer-barrier primitives that are useful
-- for profiling, benchmarks, and generated-code audits.
struct SchedulerStats {
	tasks_spawned: Int,
	tasks_cancelled: Int,
	task_timeouts: Int,
	fibers_created: Int,
	fibers_reused: Int,
	fibers_completed: Int,
	fiber_resumes: Int,
	fiber_parks: Int,
	fiber_schedule_transitions: Int,
	cooperative_yields: Int,
	channel_send_parks: Int,
	channel_recv_parks: Int,
	runnable_enqueues: Int,
	run_queue_pops: Int,
	timer_inserts: Int,
	timer_expirations: Int,
	reactor_control_wakes: Int,
	reactor_poll_wakes: Int,
	reactor_ready_events: Int,
	reactor_waiter_wakes: Int,
	stack_allocations: Int,
	stack_reuses: Int,
	work_steals: Int,
	run_queue_lock_contentions: Int,
	timer_lock_contentions: Int,
	tracked_active_tasks: Int,
	tracked_parked_fibers: Int,
	worker_count: Int,
	runnable_count: Int,
	timers_pending: Int
}


---
Reset scheduler instrumentation counters and enable scheduler stats collection.

This does not shut down the worker pool or change scheduler behavior. Gauge
fields such as `tracked_active_tasks`, `tracked_parked_fibers`,
`worker_count`, `runnable_count`, and `timers_pending` are snapshots reported
by `get_scheduler_stats()`, not resettable counters.

doctests:
    :: reset clears lifecycle counters
    reset_scheduler_stats()
    get_scheduler_stats().tasks_spawned == 0
---
func reset_scheduler_stats() -> Void:
	builtin("blorp_reset_scheduler_stats")


---
Return a snapshot of scheduler instrumentation counters.

Counters are intended for tests, benchmarks, and runtime hardening. They are
lower-bound observations in concurrent programs: timing can coalesce wakeups,
but completed work must still move the relevant lifecycle counters forward.

`channel_send_parks` and `channel_recv_parks` count fiber parks caused by
bounded-channel backpressure and empty-channel receives. They are useful for
finding liveness bottlenecks separately from unrelated timer or I/O parks.

`tasks_cancelled` counts tasks whose cooperative cancellation flag was set for
the first time. It is a runtime lifecycle counter, not proof that the task had
already observed cancellation at the snapshot point.

`task_timeouts` counts task joins that observed a timeout and requested
cancellation of an unfinished child task.

`cooperative_yields` counts explicit scheduler-yield checkpoints, currently
from `yield_now()`. It is not a park counter; it is a signal that CPU-bound
or manually cooperative code gave the scheduler a chance to run other work.

`tracked_active_tasks` is a gauge of tasks that were spawned while scheduler
stats collection was enabled and have not yet completed. Unlike lifecycle
counters, it is not reset by `reset_scheduler_stats()`.

`tracked_parked_fibers` is a gauge of fibers currently yielded at a scheduler
park point that was entered while scheduler stats collection was enabled. It is
not reset by `reset_scheduler_stats()`.
---
func get_scheduler_stats() -> SchedulerStats:
	builtin("blorp_get_scheduler_stats")


---
Discard function-profile samples collected so far and begin a new measurement
window.

This is a no-op unless the program was compiled with `--profile`. The window is
process-wide and non-nestable; call it only after concurrent setup work has
joined. Starting a new window replaces any active window.
---
func begin_function_profile_window() -> Void:
	builtin("blorp_profile_window_begin")


---
End the active function-profile measurement window.

This is a no-op unless the program was compiled with `--profile`, and also a
no-op when no window is active. The normal process-exit report contains only
samples collected inside the most recently started window.
---
func end_function_profile_window() -> Void:
	builtin("blorp_profile_window_end")


---
Return the same Int value while forcing optimized builds to treat the value as
observed.

Use this in microbenchmarks when a computed Int result would otherwise be
discarded. It is an optimizer barrier, not a timing function.

doctests:
    :: black_box_int preserves the value
    black_box_int(42) == 42
---
pure func black_box_int(value: Int) -> Int:
	builtin("blorp_black_box_int")


---
Return the same Float value while forcing optimized builds to treat the value as
observed.

Use this in microbenchmarks when a computed Float result would otherwise be
discarded. It is an optimizer barrier, not a timing function.

doctests:
    :: black_box_float preserves the value
    black_box_float(3.5) == 3.5
---
pure func black_box_float(value: Float) -> Float:
	builtin("blorp_black_box_float")


---
Measure a single function call and return an elapsed Duration.
Not pure because the measured function may have side effects.

doctests:
    :: time_it returns a non-negative duration
    elapsed: Duration = time_it(func(): void)
    elapsed >= make_duration_microseconds(0)
---
func time_it(f: () -> Void) -> Duration:
	start: Int = now_microseconds()
	f()
	elapsed_duration(start, now_microseconds())


---
Measure elapsed time between two monotonic microsecond readings.

doctests:
    :: elapsed_microseconds subtracts start from end
    elapsed_microseconds(100, 550) == 450
---
pure func elapsed_microseconds(start: Int, end_time: Int) -> Int:
	end_time - start


---
Measure elapsed time between two monotonic microsecond readings as a Duration.

doctests:
    :: elapsed_duration subtracts start from end
    elapsed_duration(100, 550) == make_duration_microseconds(450)
---
pure func elapsed_duration(start: Int, end_time: Int) -> Duration:
	make_duration_microseconds(elapsed_microseconds(start, end_time))
