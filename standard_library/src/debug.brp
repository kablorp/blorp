-- Debug - Debugging utilities
--
-- These helpers are @debug_only: call them from a debug: block, compile with
-- --debug, or use them from blorp test code.
-- Universal compiler-synthesized debug representation.
@debug_only
pure func debug_string[T](value: T) -> String:
	builtin("blorp_debug_string")


-- Log a debug message to stderr.
@debug_only
pure func log(msg: String) -> Void:
	builtin("blorp_debug_log_msg")


-- Log an info-level message to stderr with timestamp
@debug_only
pure func info(msg: String) -> Void:
	builtin("blorp_debug_info")


-- Log a warning-level message to stderr with timestamp
@debug_only
pure func warn(msg: String) -> Void:
	builtin("blorp_debug_warn")


-- Log an error-level message to stderr with timestamp
@debug_only
pure func error(msg: String) -> Void:
	builtin("blorp_debug_error")


-- ============================================================================
-- Type Introspection
-- ============================================================================
--
-- Reflection primitives: report compile-time facts about an expression's
-- type as a runtime value (a String or Bool). Constant-folded per call
-- site — zero runtime cost, no reflection machinery in the binary.
--
-- These belong in [debug] because branching on these values in production
-- code is fragile: type_name's output format is not a stable API, and
-- relying on is_heap couples code to implementation-level memory-layout
-- decisions. Use for debugging, logging, error messages — not for
-- dispatch.
---
Return the compile-time type of [x] as a String literal. Constant-folded
at each call site with zero runtime cost.

doctests:
    :: Primitive types
    type_name(42) == "#42"
    type_name(3.14) == "Float"
    type_name("hi") == "String"

    :: Parameterized types render their arguments
    type_name([1, 2, 3]) == "List[Int]"
---
@debug_only
pure func type_name[T](x: T) -> String:
	builtin("debug.type_name")


---
Return True if values of [x]'s type live on the heap (reference-counted),
False if they live on the stack (primitives, structs, and stack Option/Result
layouts). Constant-folded at each call site.

doctests:
    :: Primitives live on the stack
    is_heap(42) == False
    is_heap(True) == False

    :: Lists and strings live on the heap
    is_heap([1, 2, 3]) == True
    is_heap("hello") == True

    :: Stack options do not live on the heap
    maybe: Option[Int] = Some(42)
    is_heap(maybe) == False
---
@debug_only
pure func is_heap[T](x: T) -> Bool:
	builtin("debug.is_heap")
