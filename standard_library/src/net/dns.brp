-- DNS - portable hostname resolution surface.
--
-- This first std shape intentionally exposes a compiler-owned operation rather
-- than a resolver handle. The current runtime implementation uses the platform
-- blocking resolver and returns copied address strings with typed DNS errors;
-- a future resolver service can replace the backend without making resolver
-- state ordinary data.
---
Typed DNS resolver error.
---
union DnsError:
	InvalidHost(String)
	LookupFailed(String)


---
Return a stable, human-readable description of a DNS error.

doctests:
    :: Invalid host errors include detail
    message(InvalidHost("empty")) == "invalid host: empty"

    :: Lookup errors include detail
    message(LookupFailed("no address")) == "lookup failed: no address"
---
pure func message(err: DnsError) -> String:
	match err:
		InvalidHost(detail):
			"invalid host: " + detail
		LookupFailed(detail):
			"lookup failed: " + detail


implements Stringable for DnsError:
	pure func to_string(err: DnsError) -> String:
		message(err)


---
Resolve a hostname to deduplicated IPv4 and IPv6 address strings.

This function returns ordinary copied data, not a resolver resource. The current
runtime backend uses the platform blocking resolver; code that must avoid DNS in
a networking hot path should use numeric-host TCP/UDP operations instead.

doctests:
    :: Resolve localhost
    match resolve("localhost"):
        Ok(ips):
            ips.length() > 0
        Err(_):
            True
---
func resolve(hostname: String) -> Result[List[String], DnsError]:
	builtin("blorp_dns_resolve_raw")
