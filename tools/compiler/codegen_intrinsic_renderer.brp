-- Blorp-authored renderer for the first self-hosted code-emission slice.
--
-- This tool intentionally starts at the snippet/template boundary: OCaml still
-- owns Core traversal and subexpression emission, while Blorp owns selected
-- intrinsic C expression templates. The production emitter can compare against
-- this renderer before delegating any live code emission to it.
enum CompilerCommand:
	RenderIntrinsicCommand
	RenderManifestCommand
	UnknownCommand


enum Intrinsic:
	MathSin
	MathCos
	MathTan
	MathAsin
	MathAcos
	MathAtan
	MathSinh
	MathCosh
	MathTanh
	MathAsinh
	MathAcosh
	MathAtanh
	MathExp
	MathExp2
	MathExpm1
	MathLog
	MathLog2
	MathLog10
	MathLog1p
	MathSqrt
	MathCbrt
	MathFloor
	MathCeil
	MathTrunc
	MathPow
	MathAtan2
	MathHypot
	MathFmod
	MathCopysign
	MathFma
	MathInfinity
	MathNegInfinity
	MathNan
	MathIsNan
	MathIsInf
	MathIsFinite
	BitAnd
	BitOr
	BitXor
	BitNot
	ShiftLeft
	ShiftRight
	ListLen
	ListCapacity
	StringLen
	BytesLen
	DictLen
	SetLen
	SetCapacity
	SetMask
	SetBucket
	SetFirst
	SetLast
	SetEntryKey
	SetEntryNext
	SetEntryPrevOrder
	SetEntryNextOrder
	DictCapacity
	DictMask
	DictGrowAt
	DictKeyAt
	DictValueAt
	DictMetaGet
	DictOrderGet
	DictOrderLen
	DictOrderIndexGet
	DictKeyReleaseFn
	DictValueReleaseFn
	SliceSource
	SliceStart
	SliceLen
	TensorLen
	TensorCapacity
	FixedValue
	FixedScale
	FixedPrecision


union RenderError:
	WrongArity(Intrinsic, Int, Int)
	UnsupportedIntrinsic(String)


private INTRINSICS_DICT: Dict[String, Intrinsic] = {"math_sin" => MathSin, "math_cos" => MathCos, "math_tan" => MathTan, "math_asin" => MathAsin, "math_acos" => MathAcos, "math_atan" => MathAtan, "math_sinh" => MathSinh, "math_cosh" => MathCosh, "math_tanh" => MathTanh, "math_asinh" => MathAsinh, "math_acosh" => MathAcosh, "math_atanh" => MathAtanh, "math_exp" => MathExp, "math_exp2" => MathExp2, "math_expm1" => MathExpm1, "math_log" => MathLog, "math_log2" => MathLog2, "math_log10" => MathLog10, "math_log1p" => MathLog1p, "math_sqrt" => MathSqrt, "math_cbrt" => MathCbrt, "math_floor" => MathFloor, "math_ceil" => MathCeil, "math_trunc" => MathTrunc, "math_pow" => MathPow, "math_atan2" => MathAtan2, "math_hypot" => MathHypot, "math_fmod" => MathFmod, "math_copysign" => MathCopysign, "math_fma" => MathFma, "math_infinity" => MathInfinity, "math_neg_infinity" => MathNegInfinity, "math_nan" => MathNan, "math_is_nan" => MathIsNan, "math_is_inf" => MathIsInf, "math_is_finite" => MathIsFinite, "bit_and" => BitAnd, "bit_or" => BitOr, "bit_xor" => BitXor, "bit_not" => BitNot, "shift_left" => ShiftLeft, "shift_right" => ShiftRight, "list_len" => ListLen, "list_capacity" => ListCapacity, "string_len" => StringLen, "bytes_len" => BytesLen, "dict_len" => DictLen, "set_len" => SetLen, "set_capacity" => SetCapacity, "set_mask" => SetMask, "set_bucket" => SetBucket, "set_first" => SetFirst, "set_last" => SetLast, "set_entry_key" => SetEntryKey, "set_entry_next" => SetEntryNext, "set_entry_prev_order" => SetEntryPrevOrder, "set_entry_next_order" => SetEntryNextOrder, "dict_capacity" => DictCapacity, "dict_mask" => DictMask, "dict_grow_at" => DictGrowAt, "dict_key_at" => DictKeyAt, "dict_value_at" => DictValueAt, "dict_meta_get" => DictMetaGet, "dict_order_get" => DictOrderGet, "dict_order_len" => DictOrderLen, "dict_order_index_get" => DictOrderIndexGet, "dict_key_release_fn" => DictKeyReleaseFn, "dict_value_release_fn" => DictValueReleaseFn, "slice_source" => SliceSource, "slice_start" => SliceStart, "slice_len" => SliceLen, "tensor_len" => TensorLen, "tensor_capacity" => TensorCapacity, "fixed_value" => FixedValue, "fixed_scale" => FixedScale, "fixed_precision" => FixedPrecision}


pure func usage() -> String:
	"Usage: codegen_intrinsic_renderer intrinsic <name> [rendered-arg...] | manifest"


pure func parse_command(command: String) -> CompilerCommand:
	match command:
		"intrinsic": RenderIntrinsicCommand
		"manifest": RenderManifestCommand
		_: UnknownCommand


pure func parse_intrinsic(name: String) -> Option[Intrinsic]:
	INTRINSICS_DICT.get(name)


