pure func intrinsic_arity(intrinsic: Intrinsic) -> Int:
	match intrinsic:
		MathInfinity: 0
		MathNegInfinity: 0
		MathNan: 0
		MathFma: 3
		MathPow: 2
		MathAtan2: 2
		MathHypot: 2
		MathFmod: 2
		MathCopysign: 2
		BitAnd: 2
		BitOr: 2
		BitXor: 2
		ShiftLeft: 2
		ShiftRight: 2
		SetBucket: 2
		DictKeyAt: 2
		DictValueAt: 2
		DictMetaGet: 2
		DictOrderGet: 2
		DictOrderIndexGet: 2
		MathSin: 1
		MathCos: 1
		MathTan: 1
		MathAsin: 1
		MathAcos: 1
		MathAtan: 1
		MathSinh: 1
		MathCosh: 1
		MathTanh: 1
		MathAsinh: 1
		MathAcosh: 1
		MathAtanh: 1
		MathExp: 1
		MathExp2: 1
		MathExpm1: 1
		MathLog: 1
		MathLog2: 1
		MathLog10: 1
		MathLog1p: 1
		MathSqrt: 1
		MathCbrt: 1
		MathFloor: 1
		MathCeil: 1
		MathTrunc: 1
		MathIsNan: 1
		MathIsInf: 1
		MathIsFinite: 1
		BitNot: 1
		ListLen: 1
		ListCapacity: 1
		StringLen: 1
		BytesLen: 1
		DictLen: 1
		SetLen: 1
		SetCapacity: 1
		SetMask: 1
		SetFirst: 1
		SetLast: 1
		SetEntryKey: 1
		SetEntryNext: 1
		SetEntryPrevOrder: 1
		SetEntryNextOrder: 1
		DictCapacity: 1
		DictMask: 1
		DictGrowAt: 1
		DictOrderLen: 1
		DictKeyReleaseFn: 1
		DictValueReleaseFn: 1
		SliceSource: 1
		SliceStart: 1
		SliceLen: 1
		TensorLen: 1
		TensorCapacity: 1
		FixedValue: 1
		FixedScale: 1
		FixedPrecision: 1


pure func placeholder_args(arity: Int) -> List[String]:
	if arity == 0:
		[]
	else if arity == 1:
		["@0@"]
	else if arity == 2:
		["@0@", "@1@"]
	else:
		["@0@", "@1@", "@2@"]


pure func get_arg(args: List[String], index: Int) -> String:
	match args:
		[a]:
			if index == 0:
				a
			else:
				""
		[a, b]:
			if index == 0:
				a
			else if index == 1:
				b
			else:
				""
		[a, b, c]:
			if index == 0:
				a
			else if index == 1:
				b
			else if index == 2:
				c
			else:
				""
		_: ""


pure func render_error_to_string(error: RenderError) -> String:
	match error:
		WrongArity(intrinsic, expected, got):
			"intrinsic ${intrinsic_name(intrinsic)} expected ${expected} arg(s), got ${got}"
		UnsupportedIntrinsic(name): "unsupported intrinsic: ${name}"


pure func expect_arity(
	intrinsic: Intrinsic,
	args: List[String],
	expected: Int,
) -> Result[List[String], RenderError]:
	if args.length() == expected:
		Ok(args)
	else:
		Err(WrongArity(intrinsic, expected, args.length()))


pure func render_call(c_name: String, args: List[String]) -> String:
	match args:
		[]: "${c_name}()"
		[a]: "${c_name}(${a})"
		[a, b]: "${c_name}(${a}, ${b})"
		[a, b, c]: "${c_name}(${a}, ${b}, ${c})"
		_: "${c_name}()"


pure func render_unary_call(
	intrinsic: Intrinsic,
	c_name: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 1)
	Ok(render_call(c_name, checked_args))


pure func render_binary_call(
	intrinsic: Intrinsic,
	c_name: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 2)
	Ok(render_call(c_name, checked_args))


pure func render_ternary_call(
	intrinsic: Intrinsic,
	c_name: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 3)
	Ok(render_call(c_name, checked_args))


pure func render_field_read(
	intrinsic: Intrinsic,
	c_type: String,
	field: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 1)
	Ok("((${c_type}*)${checked_args.get_arg(0)})->${field}")


pure func render_pointer_field_read(
	intrinsic: Intrinsic,
	c_type: String,
	field: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 1)
	Ok("((void*)((${c_type}*)${checked_args.get_arg(0)})->${field})")


pure func render_array_read(
	intrinsic: Intrinsic,
	c_type: String,
	field: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 2)
	Ok("((${c_type}*)${checked_args.get_arg(0)})->${field}[${checked_args.get_arg(1)}]")


pure func render_pointer_array_read(
	intrinsic: Intrinsic,
	c_type: String,
	field: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 2)
	Ok("((void*)((${c_type}*)${checked_args.get_arg(0)})->${field}[${checked_args.get_arg(1)}])")


pure func render_int_array_read(
	intrinsic: Intrinsic,
	c_type: String,
	field: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 2)
	Ok("((long)((${c_type}*)${checked_args.get_arg(0)})->${field}[${checked_args.get_arg(1)}])")


pure func render_zero_arg_expr(
	intrinsic: Intrinsic,
	expr: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 0)
	Ok(expr)


pure func render_binary_operator(
	intrinsic: Intrinsic,
	operator: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 2)
	Ok("(${checked_args.get_arg(0)} ${operator} ${checked_args.get_arg(1)})")


pure func render_unary_operator(
	intrinsic: Intrinsic,
	operator: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 1)
	Ok("(${operator}${checked_args.get_arg(0)})")


pure func render_masked_shift(
	intrinsic: Intrinsic,
	operator: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 2)
	Ok("((long)(${checked_args.get_arg(0)} ${operator} (${checked_args.get_arg(1)} & 63)))")


pure func render_fixed_int_field(
	intrinsic: Intrinsic,
	field: String,
	args: List[String],
) -> Result[String, RenderError]:
	checked_args ?= expect_arity(intrinsic, args, 1)
	Ok("(long)((blorp_Fixed*)${checked_args.get_arg(0)})->${field}")


pure func render_parsed_intrinsic(
	intrinsic: Intrinsic,
	args: List[String],
) -> Result[String, RenderError]:
	match intrinsic:
		MathSin: render_unary_call(intrinsic, "sin", args)
		MathCos: render_unary_call(intrinsic, "cos", args)
		MathTan: render_unary_call(intrinsic, "tan", args)
		MathAsin: render_unary_call(intrinsic, "asin", args)
		MathAcos: render_unary_call(intrinsic, "acos", args)
		MathAtan: render_unary_call(intrinsic, "atan", args)
		MathSinh: render_unary_call(intrinsic, "sinh", args)
		MathCosh: render_unary_call(intrinsic, "cosh", args)
		MathTanh: render_unary_call(intrinsic, "tanh", args)
		MathAsinh: render_unary_call(intrinsic, "asinh", args)
		MathAcosh: render_unary_call(intrinsic, "acosh", args)
		MathAtanh: render_unary_call(intrinsic, "atanh", args)
		MathExp: render_unary_call(intrinsic, "exp", args)
		MathExp2: render_unary_call(intrinsic, "exp2", args)
		MathExpm1: render_unary_call(intrinsic, "expm1", args)
		MathLog: render_unary_call(intrinsic, "log", args)
		MathLog2: render_unary_call(intrinsic, "log2", args)
		MathLog10: render_unary_call(intrinsic, "log10", args)
		MathLog1p: render_unary_call(intrinsic, "log1p", args)
		MathSqrt: render_unary_call(intrinsic, "sqrt", args)
		MathCbrt: render_unary_call(intrinsic, "cbrt", args)
		MathFloor: render_unary_call(intrinsic, "floor", args)
		MathCeil: render_unary_call(intrinsic, "ceil", args)
		MathTrunc: render_unary_call(intrinsic, "trunc", args)
		MathPow: render_binary_call(intrinsic, "pow", args)
		MathAtan2: render_binary_call(intrinsic, "atan2", args)
		MathHypot: render_binary_call(intrinsic, "hypot", args)
		MathFmod: render_binary_call(intrinsic, "fmod", args)
		MathCopysign: render_binary_call(intrinsic, "copysign", args)
		MathFma: render_ternary_call(intrinsic, "fma", args)
		MathInfinity: render_zero_arg_expr(intrinsic, "(1.0/0.0)", args)
		MathNegInfinity: render_zero_arg_expr(intrinsic, "(-1.0/0.0)", args)
		MathNan: render_zero_arg_expr(intrinsic, "(0.0/0.0)", args)
		MathIsNan: render_unary_call(intrinsic, "isnan", args)
		MathIsInf: render_unary_call(intrinsic, "isinf", args)
		MathIsFinite: render_unary_call(intrinsic, "isfinite", args)
		BitAnd: render_binary_operator(intrinsic, "&", args)
		BitOr: render_binary_operator(intrinsic, "|", args)
		BitXor: render_binary_operator(intrinsic, "^", args)
		BitNot: render_unary_operator(intrinsic, "~", args)
		ShiftLeft: render_masked_shift(intrinsic, "<<", args)
		ShiftRight: render_masked_shift(intrinsic, ">>", args)
		ListLen: render_field_read(intrinsic, "blorp_List", "len", args)
		ListCapacity: render_field_read(intrinsic, "blorp_List", "capacity", args)
		StringLen: render_field_read(intrinsic, "blorp_String", "len", args)
		BytesLen: render_field_read(intrinsic, "blorp_Bytes", "len", args)
		DictLen: render_field_read(intrinsic, "blorp_Dict", "size", args)
		SetLen: render_field_read(intrinsic, "blorp_Set", "size", args)
		SetCapacity: render_field_read(intrinsic, "blorp_Set", "capacity", args)
		SetMask: render_field_read(intrinsic, "blorp_Set", "mask", args)
		SetBucket: render_pointer_array_read(intrinsic, "blorp_Set", "buckets", args)
		SetFirst: render_pointer_field_read(intrinsic, "blorp_Set", "first", args)
		SetLast: render_pointer_field_read(intrinsic, "blorp_Set", "last", args)
		SetEntryKey: render_field_read(intrinsic, "blorp_SetEntry", "key", args)
		SetEntryNext: render_pointer_field_read(intrinsic, "blorp_SetEntry", "next", args)
		SetEntryPrevOrder: render_pointer_field_read(
			intrinsic,
			"blorp_SetEntry",
			"prev_order",
			args,
		)
		SetEntryNextOrder: render_pointer_field_read(
			intrinsic,
			"blorp_SetEntry",
			"next_order",
			args,
		)
		DictCapacity: render_field_read(intrinsic, "blorp_Dict", "capacity", args)
		DictMask: render_field_read(intrinsic, "blorp_Dict", "mask", args)
		DictGrowAt: render_field_read(intrinsic, "blorp_Dict", "grow_at", args)
		DictKeyAt: render_array_read(intrinsic, "blorp_Dict", "keys", args)
		DictValueAt: render_array_read(intrinsic, "blorp_Dict", "values", args)
		DictMetaGet: render_int_array_read(intrinsic, "blorp_Dict", "meta", args)
		DictOrderGet: render_array_read(intrinsic, "blorp_Dict", "order", args)
		DictOrderLen: render_field_read(intrinsic, "blorp_Dict", "order_len", args)
		DictOrderIndexGet: render_array_read(intrinsic, "blorp_Dict", "order_index", args)
		DictKeyReleaseFn: render_pointer_field_read(intrinsic, "blorp_Dict", "key_release", args)
		DictValueReleaseFn: render_pointer_field_read(
			intrinsic,
			"blorp_Dict",
			"value_release",
			args,
		)
		SliceSource: render_pointer_field_read(intrinsic, "blorp_StringSlice", "source", args)
		SliceStart: render_field_read(intrinsic, "blorp_StringSlice", "start", args)
		SliceLen: render_field_read(intrinsic, "blorp_StringSlice", "len", args)
		TensorLen: render_field_read(intrinsic, "blorp_Vector", "len", args)
		TensorCapacity: render_field_read(intrinsic, "blorp_Vector", "capacity", args)
		FixedValue: render_field_read(intrinsic, "blorp_Fixed", "value", args)
		FixedScale: render_fixed_int_field(intrinsic, "scale", args)
		FixedPrecision: render_fixed_int_field(intrinsic, "precision", args)


pure func render_intrinsic(name: String, args: List[String]) -> Result[String, RenderError]:
	match parse_intrinsic(name):
		Some(intrinsic): render_parsed_intrinsic(intrinsic, args)
		None: Err(UnsupportedIntrinsic(name))


pure func render_manifest_line(intrinsic: Intrinsic) -> Result[String, RenderError]:
	arity: Int = intrinsic_arity(intrinsic)
	template ?= render_parsed_intrinsic(intrinsic, placeholder_args(arity))
	Ok("${intrinsic_name(intrinsic)}\t${arity}\t${template}")


pure func render_manifest_lines() -> Result[List[String], RenderError]:
	var lines_result: Result[List[String], RenderError] = Ok([])
	for intrinsic in all_intrinsics():
		lines_result = match lines_result:
			Ok(lines):
				match render_manifest_line(intrinsic):
					Ok(line): Ok(lines.append(line))
					Err(error): Err(error)
			Err(error): Err(error)
	lines_result


func print_manifest() -> Int:
	match render_manifest_lines():
		Ok(lines):
			for line in lines:
				print(line)
			0
		Err(error):
			print(render_error_to_string(error))
			1


func print_result(result: Result[String, RenderError]) -> Int:
	match result:
		Ok(rendered):
			puts(rendered)
			0
		Err(error):
			print(render_error_to_string(error))
			1


func main(args: List[String]) -> Int:
	match args:
		[_, command_name, ...command_args]:
			match parse_command(command_name):
				RenderIntrinsicCommand:
					match command_args:
						[name, ...rendered_args]: print_result(
							render_intrinsic(
								name,
								rendered_args,
							),
						)
						_:
							print(usage())
							1
				RenderManifestCommand: print_manifest()
				UnknownCommand:
					print(usage())
					1
		_:
			print(usage())
			1
