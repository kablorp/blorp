import:
	./fmt_doc_json: layout_json
	string: parse_int
	system: file_exists, read_file, write_file


pure func usage() -> String:
	"Usage: fmt_layout_main <doc-json-file> [width]\n       fmt_layout_main --batch <doc-json-file> <output-file> [...]"


pure func width_from_args(args: List[String]) -> Int:
	match args.get(2):
		Some(raw):
			match raw.parse_int():
				Some(width): width
				None: 100
		None: 100


func render_doc_json_file(path: String, width: Int) -> Result[String, String]:
	if not path.file_exists():
		Err("Doc JSON file not found: " + path)
	else:
		match path.read_file():
			Err(msg): Err("failed to read Doc JSON: " + msg)
			Ok(json): width.layout_json(json)


func write_rendered_doc_json(
	input_path: String,
	output_path: String,
	width: Int,
) -> Result[Void, String]:
	match input_path.render_doc_json_file(width):
		Err(msg): Err(msg)
		Ok(rendered): output_path.write_file(rendered)


func run_batch(args: List[String]) -> Int:
	if args.length() < 4 or (args.length() - 2) % 2 != 0:
		print(usage())
		1
	else:
		var status: Int = 0
		var idx: Int = 2
		while idx < args.length() and status == 0:
			match args.get(idx):
				None:
					print("missing Doc JSON path")
					status = 1
				Some(input_path):
					match args.get(idx + 1):
						None:
							print("missing output path")
							status = 1
						Some(output_path):
							match write_rendered_doc_json(input_path, output_path, 100):
								Err(msg):
									print(msg)
									status = 1
								Ok(_): idx += 2
		status


func run_one(args: List[String]) -> Int:
	match args.get(1):
		None:
			print(usage())
			1
		Some(path):
			match path.render_doc_json_file(width_from_args(args)):
				Err(msg):
					print(msg)
					1
				Ok(rendered):
					puts(rendered)
					0


func main(args: List[String]) -> Int:
	match args.get(1):
		None:
			print(usage())
			1
		Some(command):
			if command == "--batch":
				args.run_batch()
			else:
				args.run_one()
