import:
	./fmt_expr_doc: expr_doc, expr_from_json
	./fmt_json: field, int_field, string_field
	./fmt_layout: layout
	json: parse_json
	string: parse_int, trim
	system: file_exists, read_file


pure func usage() -> String:
	"Usage: fmt_expr_main <expr-jsonl-file> [width]"


pure func width_from_args(args: List[String]) -> Int:
	match args.get(2):
		Some(raw):
			match raw.parse_int():
				Some(width): width
				None: 100
		None: 100


pure func render_expr_case(line: String, width: Int) -> Result[Option[String], String]:
	trimmed: String = line.trim()
	if trimmed == "":
		Ok(None)
	else:
		value ?= trimmed.parse_json()
		expected ?= value.string_field("expected")
		line_no ?= value.int_field("line")
		column_no ?= value.int_field("column")
		expr_value ?= value.field("expr")
		expr ?= expr_value.expr_from_json()
		actual: String = width.layout(expr.expr_doc())
		if actual == expected:
			Ok(None)
		else:
			Ok(
				Some(
					"expression parity mismatch at line " + line_no.to_string() + ", column " + column_no.to_string() + "\nexpected:\n" + expected + "actual:\n" + actual,
				),
			)


func check_expr_cases(path: String, width: Int) -> Result[Bool, String]:
	if not path.file_exists():
		Err("expression JSONL file not found: " + path)
	else:
		content ?= path.read_file()
		var status: Option[String] = None
		for line in content.split("\n"):
			match status:
				Some(_): void
				None:
					match line.render_expr_case(width):
						Err(msg): status = Some(msg)
						Ok(Some(msg)): status = Some(msg)
						Ok(None): void
		match status:
			Some(msg): Err(msg)
			None: Ok(True)


func main(args: List[String]) -> Int:
	match args.get(1):
		None:
			print(usage())
			1
		Some(path):
			match path.check_expr_cases(width_from_args(args)):
				Err(msg):
					print(msg)
					1
				Ok(_): 0
