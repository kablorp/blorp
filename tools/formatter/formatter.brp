import:
	./command_line:
		ParsedCommand(CommandMessage, CommandProgram, CommandProgramBatch),
		ProgramArgs,
		ProgramBatchArgs,
		help_text,
		is_help_arg,
		parse_command,
	./formatter_commands: render_program_json_file, write_rendered_program_json


func render_program_command(parsed: ProgramArgs) -> Result[String, String]:
	parsed.path.render_program_json_file(parsed.width)


func run_program_batch_command(parsed: ProgramBatchArgs) -> Result[Bool, String]:
	var error: Option[String] = None
	for pair in parsed.pairs:
		match error:
			Some(_): void
			None:
				match write_rendered_program_json(pair.input, pair.output, parsed.width):
					Err(msg): error = Some(msg)
					Ok(_): void
	match error:
		Some(msg): Err(msg)
		None: Ok(True)


func print_render_result(result: Result[String, String]) -> Int:
	match result:
		Err(msg):
			print(msg)
			1
		Ok(rendered):
			puts(rendered)
			0


func print_check_result(result: Result[Bool, String]) -> Int:
	match result:
		Err(msg):
			print(msg)
			1
		Ok(_): 0


func run_parsed_command(parsed: ParsedCommand) -> Int:
	match parsed:
		CommandMessage(message, status):
			print(message)
			status
		CommandProgram(args): print_render_result(args.render_program_command())
		CommandProgramBatch(args): print_check_result(args.run_program_batch_command())


func main(args: List[String]) -> Int:
	user_args: List[String] = args.drop(1)
	match user_args.get(0):
		Some(command):
			if command.is_help_arg():
				print(help_text())
				0
			else:
				command
					.parse_command(user_args.drop(1))
					.run_parsed_command()
		None:
			print(help_text())
			1
