import:
	./fmt_json: field, int_field, string_field
	./fmt_layout:
		Doc(
			Nil,
			Text,
			Hardline,
			Softline,
			SoftlineSpace,
			Indent,
			Group,
			Concat,
			IfBreak,
			LineSuffix,
		),
		layout,
	json: JsonValue, parse_json


private pure func doc_field(value: JsonValue, key: String) -> Result[Doc, String]:
	child ?= value.field(key)
	child.doc_from_json()


pure func doc_from_json(value: JsonValue) -> Result[Doc, String]:
	tag ?= value.string_field("tag")
	match tag:
		"Nil": Ok(Nil)
		"Text":
			s ?= value.string_field("text")
			Ok(Text(s))
		"Hardline": Ok(Hardline)
		"Softline": Ok(Softline)
		"SoftlineSpace": Ok(SoftlineSpace)
		"Indent":
			width ?= value.int_field("width")
			doc ?= value.doc_field("doc")
			Ok(Indent(width, doc))
		"Group":
			doc ?= value.doc_field("doc")
			Ok(Group(doc))
		"Concat":
			left ?= value.doc_field("left")
			right ?= value.doc_field("right")
			Ok(Concat(left, right))
		"IfBreak":
			broken ?= value.doc_field("broken")
			flat ?= value.doc_field("flat")
			Ok(IfBreak(broken, flat))
		"LineSuffix":
			s ?= value.string_field("text")
			Ok(LineSuffix(s))
		_: Err("unknown Doc JSON tag: " + tag)


pure func doc_from_json_string(input: String) -> Result[Doc, String]:
	value ?= input.parse_json()
	value.doc_from_json()


pure func layout_json(width: Int, input: String) -> Result[String, String]:
	doc ?= input.doc_from_json_string()
	Ok(width.layout(doc))
