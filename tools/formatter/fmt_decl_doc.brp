import:
	./fmt_expr_doc:
		Expr,
		FuncParam,
		Pattern,
		block_body_doc,
		escape_string_value,
		expr_doc,
		expr_from_json,
		func_param_from_json,
		func_params_doc,
		is_block_expr,
		pattern_doc,
		pattern_from_json,
	./fmt_json: array_field, bool_field, field, int_field, string_field
	./fmt_layout:
		Doc,
		blank_lines,
		cat,
		comma_sep,
		comma_sep_break,
		group,
		hardline,
		hardlines,
		indent,
		intersperse,
		layout,
		line_suffix,
		softline,
		softline_space,
		text,
	./fmt_type_doc: TypeExpr, type_doc, type_expr_from_json
	json: JsonValue, as_string, get_field, parse_json


record ImportSymbol {name: String, alias_name: Option[String], ctors: Option[List[String]]}


record ImportItem {
	module_name: String,
	alias_name: Option[String],
	symbols: Option[List[ImportSymbol]],
}


record TypeVariant {name: String, fields: List[TypeExpr]}


record DeclField {name: String, field_type: TypeExpr}


record TraitMethod {
	name: String,
	is_pure: Bool,
	params: List[FuncParam],
	ret: Option[TypeExpr],
	body: Option[Expr],
}


record ForeignLinkFlag {platform: Option[String], value: String}


record ForeignMetadata {includes: List[String], link_flags: List[ForeignLinkFlag]}


union FuncBody:
	ExprFuncBody(Expr)
	BuiltinFuncBody(Option[String])
	ForeignFuncBody(String, ForeignMetadata)
	NoFuncBody


record ImplMethod {
	name: String,
	is_pure: Bool,
	is_tailrec: Bool,
	is_debug_only: Bool,
	no_copy: Bool,
	type_params: List[String],
	params: List[FuncParam],
	ret: Option[TypeExpr],
	body: FuncBody,
}


union Decl:
	DocDecl(String, Decl)
	ImportDecl(ImportItem)
	VarDecl(Bool, Option[String], Option[Pattern], Bool, Option[TypeExpr], Expr)
	FuncDecl(Bool, String, Bool, Bool, Bool, Bool, List[String], List[FuncParam], Option[TypeExpr], FuncBody)
	TypeDecl(Bool, String, List[String], Bool, Bool, List[TypeVariant])
	RecordDecl(Bool, String, List[String], Bool, Bool, List[DeclField])
	TypeAliasDecl(Bool, String, List[String], TypeExpr)
	TraitDecl(Bool, String, List[String], List[String], List[TraitMethod])
	ImplDecl(Bool, String, TypeExpr, List[ImplMethod])


record FormatterComment {text_value: String, line: Int, column: Int, trailing: Bool}


record LocatedDecl {line: Int, column: Int, end_line: Int, decl: Decl}


record Program {decls: List[LocatedDecl], comments: List[FormatterComment]}


record LocatedImport {line: Int, column: Int, item: ImportItem}


union ProgramBodyItem:
	BodyDecl(LocatedDecl)
	BodyImportBlock(List[LocatedImport])
	BodyForeignBlock(List[LocatedDecl])


record ProgramParts {imports: List[LocatedImport], body: List[LocatedDecl]}


record ImportWithComments {
	item: ImportItem,
	leading: List[FormatterComment],
	trailing: Option[FormatterComment],
}


record ImportCommentCollect {
	items: List[ImportWithComments],
	remaining_comments: List[FormatterComment],
}


record ImportBlockRender {doc: Doc, remaining_comments: List[FormatterComment]}


record CommentTake {taken: List[FormatterComment], remaining: List[FormatterComment]}


record TrailingCommentTake {comment: Option[FormatterComment], remaining: List[FormatterComment]}


record RenderedDoc {doc: Doc, remaining_comments: List[FormatterComment]}


private pure func optional_string_field(
	value: JsonValue,
	key: String,
) -> Result[Option[String], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			match child.as_string():
				Some(s): Ok(Some(s))
				None: Err("expected formatter JSON field '" + key + "' to be a string")


private pure func string_array_field(value: JsonValue, key: String) -> Result[List[String], String]:
	items ?= value.array_field(key)
	var result: List[String] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.as_string():
					Some(s): result = result.append(s)
					None: error = Some(
						"expected formatter JSON field '" + key + "' to be an array of strings",
					)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func optional_string_array_field(
	value: JsonValue,
	key: String,
) -> Result[Option[List[String]], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(_):
			items ?= value.string_array_field(key)
			Ok(Some(items))


private pure func optional_int_field(value: JsonValue, key: String) -> Result[Option[Int], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(_):
			int_value ?= value.int_field(key)
			Ok(Some(int_value))


private pure func type_expr_field(value: JsonValue, key: String) -> Result[TypeExpr, String]:
	child ?= value.field(key)
	child.type_expr_from_json()


private pure func type_expr_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TypeExpr], String]:
	items ?= value.array_field(key)
	var result: List[TypeExpr] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.type_expr_from_json():
					Ok(ty): result = result.append(ty)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func optional_type_expr_field(
	value: JsonValue,
	key: String,
) -> Result[Option[TypeExpr], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			ty ?= child.type_expr_from_json()
			Ok(Some(ty))


private pure func optional_expr_field(
	value: JsonValue,
	key: String,
) -> Result[Option[Expr], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			expr_value ?= child.expr_from_json()
			Ok(Some(expr_value))


private pure func optional_pattern_field(
	value: JsonValue,
	key: String,
) -> Result[Option[Pattern], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			pattern ?= child.pattern_from_json()
			Ok(Some(pattern))


private pure func expr_field(value: JsonValue, key: String) -> Result[Expr, String]:
	child ?= value.field(key)
	child.expr_from_json()


private pure func func_param_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[FuncParam], String]:
	items ?= value.array_field(key)
	var result: List[FuncParam] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.func_param_from_json():
					Ok(param): result = result.append(param)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func import_symbol_from_json(value: JsonValue) -> Result[ImportSymbol, String]:
	name ?= value.string_field("name")
	alias_name ?= value.optional_string_field("alias")
	ctors ?= value.optional_string_array_field("ctors")
	Ok({name = name, alias_name = alias_name, ctors = ctors})


private pure func import_symbols_field(
	value: JsonValue,
	key: String,
) -> Result[Option[List[ImportSymbol]], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(_):
			items ?= value.array_field(key)
			var result: List[ImportSymbol] = []
			var error: Option[String] = None
			for item in items:
				match error:
					Some(_): void
					None:
						match item.import_symbol_from_json():
							Ok(symbol): result = result.append(symbol)
							Err(msg): error = Some(msg)
			match error:
				Some(msg): Err(msg)
				None: Ok(Some(result))


private pure func import_item_from_json(value: JsonValue) -> Result[ImportItem, String]:
	module_name ?= value.string_field("module")
	alias_name ?= value.optional_string_field("alias")
	symbols ?= value.import_symbols_field("symbols")
	Ok({module_name = module_name, alias_name = alias_name, symbols = symbols})


private pure func formatter_comment_from_json(value: JsonValue) -> Result[FormatterComment, String]:
	text_value ?= value.string_field("text")
	line ?= value.int_field("line")
	column ?= value.int_field("column")
	trailing ?= value.bool_field("trailing")
	Ok({text_value = text_value, line = line, column = column, trailing = trailing})


private pure func formatter_comments_field(
	value: JsonValue,
	key: String,
) -> Result[List[FormatterComment], String]:
	match value.get_field(key):
		None: Ok([])
		Some(_):
			items ?= value.array_field(key)
			var result: List[FormatterComment] = []
			var error: Option[String] = None
			for item in items:
				match error:
					Some(_): void
					None:
						match item.formatter_comment_from_json():
							Ok(comment): result = result.append(comment)
							Err(msg): error = Some(msg)
			match error:
				Some(msg): Err(msg)
				None: Ok(result)


private pure func string_array_field_or_empty(
	value: JsonValue,
	key: String,
) -> Result[List[String], String]:
	match value.get_field(key):
		None: Ok([])
		Some(_): value.string_array_field(key)


private pure func foreign_link_flag_from_json(value: JsonValue) -> Result[ForeignLinkFlag, String]:
	platform ?= value.optional_string_field("platform")
	flag_value ?= value.string_field("value")
	Ok({platform = platform, value = flag_value})


