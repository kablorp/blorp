		None: Ok([])
		Some(_):
			items ?= value.array_field(key)
			var result: List[ForeignLinkFlag] = []
			var error: Option[String] = None
			for item in items:
				match error:
					Some(_): void
					None:
						match item.foreign_link_flag_from_json():
							Ok(flag): result = result.append(flag)
							Err(msg): error = Some(msg)
			match error:
				Some(msg): Err(msg)
				None: Ok(result)


private pure func type_variant_from_json(value: JsonValue) -> Result[TypeVariant, String]:
	name ?= value.string_field("name")
	fields ?= value.type_expr_array_field("fields")
	Ok({name = name, fields = fields})


private pure func type_variant_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TypeVariant], String]:
	items ?= value.array_field(key)
	var result: List[TypeVariant] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.type_variant_from_json():
					Ok(variant): result = result.append(variant)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func decl_field_from_json(value: JsonValue) -> Result[DeclField, String]:
	name ?= value.string_field("name")
	field_type ?= value.type_expr_field("type")
	Ok({name = name, field_type = field_type})


private pure func decl_field_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[DeclField], String]:
	items ?= value.array_field(key)
	var result: List[DeclField] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.decl_field_from_json():
					Ok(field_value): result = result.append(field_value)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func trait_method_from_json(value: JsonValue) -> Result[TraitMethod, String]:
	name ?= value.string_field("name")
	is_pure ?= value.bool_field("pure")
	params ?= value.func_param_array_field("params")
	ret ?= value.optional_type_expr_field("return")
	body ?= value.optional_expr_field("body")
	Ok({name = name, is_pure = is_pure, params = params, ret = ret, body = body})


private pure func trait_method_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TraitMethod], String]:
	items ?= value.array_field(key)
	var result: List[TraitMethod] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.trait_method_from_json():
					Ok(method): result = result.append(method)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func impl_method_from_json(value: JsonValue) -> Result[ImplMethod, String]:
	name ?= value.string_field("name")
	is_pure ?= value.bool_field("pure")
	is_tailrec ?= value.bool_field("tailrec")
	is_debug_only ?= value.bool_field("debug_only")
	no_copy ?= value.bool_field("no_copy")
	type_params ?= value.string_array_field("type_params")
	params ?= value.func_param_array_field("params")
	ret ?= value.optional_type_expr_field("return")
	body ?= value.func_body_from_json()
	Ok(
		{
			name = name,
			is_pure = is_pure,
			is_tailrec = is_tailrec,
			is_debug_only = is_debug_only,
			no_copy = no_copy,
			type_params = type_params,
			params = params,
			ret = ret,
			body = body,
		},
	)


private pure func impl_method_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[ImplMethod], String]:
	items ?= value.array_field(key)
	var result: List[ImplMethod] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.impl_method_from_json():
					Ok(method): result = result.append(method)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func func_body_from_json(value: JsonValue) -> Result[FuncBody, String]:
	match value.get_field("body"):
		Some(child):
			body ?= child.expr_from_json()
			Ok(ExprFuncBody(body))
		None:
			kind ?= value.string_field("body_kind")
			match kind:
				"builtin":
					name ?= value.optional_string_field("builtin_name")
					Ok(BuiltinFuncBody(name))
				"foreign":
					foreign_name ?= value.string_field("foreign_name")
					includes ?= value.string_array_field_or_empty("foreign_includes")
					link_flags ?= value.foreign_link_flags_field("foreign_link_flags")
					Ok(
						ForeignFuncBody(
							foreign_name,
							{includes = includes, link_flags = link_flags},
						),
					)
				"none": Ok(NoFuncBody)
				_: Err("unknown function body JSON kind: " + kind)


pure func decl_from_json(value: JsonValue) -> Result[Decl, String]:
	tag ?= value.string_field("tag")
	match tag:
		"Doc":
			doc ?= value.string_field("doc")
			decl_value ?= value.field("decl")
			decl ?= decl_value.decl_from_json()
			Ok(DocDecl(doc, decl))
		"Import":
			item ?= value.import_item_from_json()
			Ok(ImportDecl(item))
		"Var":
			is_private ?= value.bool_field("private")
			name ?= value.optional_string_field("name")
			pattern ?= value.optional_pattern_field("pattern")
			is_mutable ?= value.bool_field("mutable")
			ty ?= value.optional_type_expr_field("type")
			value_expr ?= value.expr_field("value")
			Ok(VarDecl(is_private, name, pattern, is_mutable, ty, value_expr))
		"Func":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			is_pure ?= value.bool_field("pure")
			is_tailrec ?= value.bool_field("tailrec")
			is_debug_only ?= value.bool_field("debug_only")
			no_copy ?= value.bool_field("no_copy")
			type_params ?= value.string_array_field("type_params")
			params ?= value.func_param_array_field("params")
			ret ?= value.optional_type_expr_field("return")
			body ?= value.func_body_from_json()
			Ok(
				FuncDecl(
					is_private,
					name,
					is_pure,
					is_tailrec,
					is_debug_only,
					no_copy,
					type_params,
					params,
					ret,
					body,
				),
			)
		"Type":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			is_enum ?= value.bool_field("enum")
			is_builtin ?= value.bool_field("builtin")
			variants ?= value.type_variant_array_field("variants")
			Ok(TypeDecl(is_private, name, type_params, is_enum, is_builtin, variants))
		"Record":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			is_value ?= value.bool_field("value")
			is_builtin ?= value.bool_field("builtin")
			fields ?= value.decl_field_array_field("fields")
			Ok(RecordDecl(is_private, name, type_params, is_value, is_builtin, fields))
		"TypeAlias":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			target ?= value.type_expr_field("target")
			Ok(TypeAliasDecl(is_private, name, type_params, target))
		"Trait":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			supertraits ?= value.string_array_field("supertraits")
			methods ?= value.trait_method_array_field("methods")
			Ok(TraitDecl(is_private, name, type_params, supertraits, methods))
		"Impl":
			is_private ?= value.bool_field("private")
			trait_name ?= value.string_field("trait")
			for_type ?= value.type_expr_field("for")
			methods ?= value.impl_method_array_field("methods")
			Ok(ImplDecl(is_private, trait_name, for_type, methods))
		_: Err("unknown declaration JSON tag: " + tag)


pure func decl_from_json_string(input: String) -> Result[Decl, String]:
	value ?= input.parse_json()
	value.decl_from_json()


private pure func string_docs(items: List[String]) -> List[Doc]:
	var docs: List[Doc] = []
	for item in items:
		docs = docs.append(item.text())
	docs


private pure func type_expr_docs(types: List[TypeExpr]) -> List[Doc]:
	var docs: List[Doc] = []
	for ty in types:
		docs = docs.append(ty.type_doc())
	docs


private pure func type_params_doc(params: List[String]) -> Doc:
	if params.length() == 0:
		"".text()
	else:
		"["
			.text()
			.cat(params
					.string_docs()
					.comma_sep())
			.cat("]".text())


private pure func return_doc(ret: Option[TypeExpr]) -> Doc:
	match ret:
		Some(ty): " -> "
			.text()
			.cat(ty.type_doc())
		None: "".text()


private pure func import_symbol_doc(symbol: ImportSymbol) -> Doc:
	match symbol.ctors:
		Some(ctors):
			symbol.name
				.text()
				.cat("(".text())
				.cat(softline()
						.cat(ctors
								.string_docs()
								.comma_sep_break())
						.indent())
				.cat(softline())
				.cat(")".text())
				.group()
		None:
			match symbol.alias_name:
				Some(alias_value): symbol.name
					.text()
					.cat(" as ".text())
					.cat(alias_value.text())
				None: symbol.name.text()


private pure func import_symbol_docs(symbols: List[ImportSymbol]) -> List[Doc]:
	var docs: List[Doc] = []
	for symbol in symbols.sort_by(func(item: ImportSymbol): item.name):
		docs = docs.append(symbol.import_symbol_doc())
	docs


private pure func import_item_doc(item: ImportItem) -> Doc:
	match item.symbols:
		Some(symbols):
			prefix: Doc = match item.alias_name:
				Some(alias_value): item.module_name
					.text()
					.cat(" as ".text())
					.cat(alias_value.text())
					.cat(":".text())
				None: item.module_name
					.text()
					.cat(":".text())
			prefix
				.cat(softline_space()
						.cat(symbols
								.import_symbol_docs()
								.comma_sep_break())
						.indent())
				.group()
		None:
			match item.alias_name:
				Some(alias_value): item.module_name
					.text()
					.cat(" as ".text())
					.cat(alias_value.text())
				None: item.module_name.text()


private pure func is_std_import_item(item: ImportItem) -> Bool:
	item.module_name.starts_with("std/")


private pure func append_sorted_import_items(
	result: List[ImportItem],
	items: List[ImportItem],
) -> List[ImportItem]:
	var sorted: List[ImportItem] = result
	for item in items.sort_by(func(import_item: ImportItem): import_item.module_name):
		sorted = sorted.append(item)
	sorted


private pure func import_symbol_dedup_key(symbol: ImportSymbol) -> String:
	alias_key: String = match symbol.alias_name:
		Some(alias_value): " as " + alias_value
		None: ""
	symbol.name + alias_key


private pure func import_symbols_dedup_key(symbols: List[ImportSymbol]) -> String:
	var keys: List[String] = []
	for symbol in symbols.sort_by(func(item: ImportSymbol): item.name):
		keys = keys.append(symbol.import_symbol_dedup_key())
	keys.join(",")


private pure func import_item_dedup_key(item: ImportItem) -> String:
	value_key: String = match item.symbols:
		Some(symbols): symbols.import_symbols_dedup_key()
		None:
			match item.alias_name:
				Some(alias_value): "as:" + alias_value
				None: "*"
	item.module_name + ":" + value_key


private pure func dedup_import_items(items: List[ImportItem]) -> List[ImportItem]:
	var result: List[ImportItem] = []
	var seen: List[String] = []
	for item in items:
		key: String = item.import_item_dedup_key()
		if not seen.contains(key):
			seen = seen.append(key)
			result = result.append(item)
	result


private pure func sorted_import_items(items: List[ImportItem]) -> List[ImportItem]:
	var std_imports: List[ImportItem] = []
	var project_imports: List[ImportItem] = []
	for item in items.dedup_import_items():
		if item.is_std_import_item():
			std_imports = std_imports.append(item)
		else:
			project_imports = project_imports.append(item)
	var result: List[ImportItem] = []
	result = result.append_sorted_import_items(std_imports)
	result.append_sorted_import_items(project_imports)


private pure func import_item_docs(items: List[ImportItem]) -> List[Doc]:
	var docs: List[Doc] = []
	for item in items.sorted_import_items():
		docs = docs.append(item.import_item_doc())
	docs


private pure func import_items_doc(items: List[ImportItem]) -> Doc:
	"import:"
		.text()
		.cat(hardline()
				.cat(items
						.import_item_docs()
						.hardlines())
				.indent())


private pure func import_decl_doc(item: ImportItem) -> Doc:
	"import:"
		.text()
		.cat(hardline()
				.cat(item.import_item_doc())
				.indent())


private pure func private_doc(is_private: Bool) -> Doc:
	if is_private:
		"private ".text()
	else:
		"".text()


private pure func docstring_doc(doc: String) -> Doc:
	var result: Doc = "---"
		.text()
		.cat(hardline())
	for line in doc.split("\n"):
		result = result
			.cat(line.text())
			.cat(hardline())
	result
		.cat("---".text())
		.cat(hardline())


private pure func normalize_comment_text(raw: String) -> String:
	if raw.starts_with("--"):
		rest: String = raw
			.substring(2, raw.length() - 2)
			.trim()
		if rest == "":
			"--"
		else:
			"-- " + rest
	else:
		raw


private pure func comment_doc(comment: FormatterComment) -> Doc:
	comment.text_value
		.normalize_comment_text()
		.text()


private pure func comments_doc(comments: List[FormatterComment]) -> Doc:
	var result: Doc = "".text()
	for comment in comments:
		result = result
			.cat(comment.comment_doc())
			.cat(hardline())
	result


private pure func copy_formatter_comments(
	comments: List[FormatterComment],
) -> List[FormatterComment]:
	comments.take(comments.length())


private pure func append_remaining_comments(doc: Doc, comments: List[FormatterComment]) -> Doc:
	if comments.length() == 0:
		doc
	else:
		doc
			.cat(hardline())
			.cat(comments.comments_doc())


private pure func trailing_comment_doc(comment: Option[FormatterComment]) -> Doc:
	match comment:
		Some(value): value.text_value
			.normalize_comment_text()
			.line_suffix()
		None: "".text()


private pure func take_leading_comments(
	comments: List[FormatterComment],
	before_line: Int,
) -> CommentTake:
	var taken: List[FormatterComment] = []
	var remaining: List[FormatterComment] = []
	var taking: Bool = True
	for comment in comments:
		if taking and comment.line < before_line:
			taken = taken.append(comment)
		else:
			taking = False
			remaining = remaining.append(comment)
	{taken = taken, remaining = remaining}


private pure func take_trailing_comment(
	comments: List[FormatterComment],
	on_line: Int,
) -> TrailingCommentTake:
	match comments:
		[]: {comment = None, remaining = []}
		[first, ...rest]:
			if first.line == on_line and first.trailing:
				{comment = Some(first), remaining = rest}
			else:
				{comment = None, remaining = comments}


private pure func drain_comments_through(
	comments: List[FormatterComment],
	through_line: Int,
) -> CommentTake:
	var taken: List[FormatterComment] = []
	var remaining: List[FormatterComment] = []
	var taking: Bool = True
	for comment in comments:
		if taking and comment.line <= through_line:
			taken = taken.append(comment)
		else:
			taking = False
			remaining = remaining.append(comment)
	{taken = taken, remaining = remaining}


private pure func import_with_comments_dedup_key(item: ImportWithComments) -> String:
	item.item.import_item_dedup_key()


private pure func dedup_imports_with_comments(
	items: List[ImportWithComments],
) -> List[ImportWithComments]:
	var result: List[ImportWithComments] = []
	var seen: List[String] = []
	for item in items:
		key: String = item.import_with_comments_dedup_key()
		if not seen.contains(key):
			seen = seen.append(key)
			result = result.append(item)
	result


private pure func is_std_import_with_comments(item: ImportWithComments) -> Bool:
	item.item.is_std_import_item()


private pure func sorted_imports_with_comments(
	items: List[ImportWithComments],
) -> List[ImportWithComments]:
	var std_imports: List[ImportWithComments] = []
	var project_imports: List[ImportWithComments] = []
	for item in items.dedup_imports_with_comments():
		if item.is_std_import_with_comments():
			std_imports = std_imports.append(item)
		else:
			project_imports = project_imports.append(item)
	var result: List[ImportWithComments] = []
	for item in std_imports.sort_by(
		func(import_item: ImportWithComments): import_item.item.module_name,
	):
		result = result.append(item)
	for item in project_imports.sort_by(
		func(import_item: ImportWithComments): import_item.item.module_name,
	):
		result = result.append(item)
	result


private pure func import_with_comments_doc(item: ImportWithComments) -> Doc:
	item.leading
		.comments_doc()
		.cat(item.item.import_item_doc())
		.cat(item.trailing.trailing_comment_doc())


private pure func import_with_comments_docs(items: List[ImportWithComments]) -> List[Doc]:
	var docs: List[Doc] = []
	for item in items:
		docs = docs.append(item.import_with_comments_doc())
	docs


private pure func import_block_body_doc(items: List[ImportWithComments]) -> Doc:
	var std_imports: List[ImportWithComments] = []
	var project_imports: List[ImportWithComments] = []
	for item in items.sorted_imports_with_comments():
		if item.is_std_import_with_comments():
			std_imports = std_imports.append(item)
		else:
			project_imports = project_imports.append(item)
	std_doc: Doc = std_imports
		.import_with_comments_docs()
		.hardlines()
	project_doc: Doc = project_imports
		.import_with_comments_docs()
		.hardlines()
	if std_imports.length() == 0:
		project_doc
	else if project_imports.length() == 0:
		std_doc
	else:
		std_doc
			.cat(hardline())
			.cat(project_doc)


private pure func import_block_with_comments_doc(
	items: List[ImportWithComments],
	suffix: Doc,
) -> Doc:
	if items.length() == 0:
		"".text()
	else:
		"import:"
			.text()
			.cat(hardline()
					.cat(items.import_block_body_doc())
					.indent())
			.cat(suffix)


private pure func located_imports_last_line(imports: List[LocatedImport]) -> Int:
	var line: Int = 0
	for import_item in imports:
		if import_item.line > line:
			line = import_item.line
	line


private pure func collect_import_comments(
	imports: List[LocatedImport],
	comments: List[FormatterComment],
) -> ImportCommentCollect:
	var items: List[ImportWithComments] = []
	var remaining_comments: List[FormatterComment] = comments
	for import_item in imports:
		leading: CommentTake = remaining_comments.take_leading_comments(import_item.line)
		trailing: TrailingCommentTake = leading.remaining.take_trailing_comment(import_item.line)
		items = items.append(
			{item = import_item.item, leading = leading.taken, trailing = trailing.comment},
		)
		remaining_comments = trailing.remaining.copy_formatter_comments()
	{items = items, remaining_comments = remaining_comments}


private pure func render_import_block(
	imports: List[LocatedImport],
	comments: List[FormatterComment],
) -> ImportBlockRender:
	collected: ImportCommentCollect = imports.collect_import_comments(comments)
	drained: CommentTake = collected.remaining_comments.drain_comments_through(
		imports.located_imports_last_line(),
	)
	suffix: Doc = if drained.taken.length() == 0:
		"".text()
	else:
		hardline().cat(drained.taken.comments_doc())
	{
		doc = collected.items.import_block_with_comments_doc(suffix),
		remaining_comments = drained.remaining.copy_formatter_comments(),
	}


private pure func target_doc(name: Option[String], pattern: Option[Pattern]) -> Doc:
	match name:
		Some(var_name): var_name.text()
		None:
			match pattern:
				Some(var_pattern): var_pattern.pattern_doc()
				None: "_".text()


private pure func var_decl_doc(
	is_private: Bool,
	name: Option[String],
	pattern: Option[Pattern],
	is_mutable: Bool,
	ty: Option[TypeExpr],
	value: Expr,
) -> Doc:
	mutable_doc: Doc = if is_mutable:
		"var ".text()
	else:
		"".text()
	type_doc_part: Doc = match ty:
		Some(type_expr): ": "
			.text()
			.cat(type_expr.type_doc())
		None: "".text()
	is_private
		.private_doc()
		.cat(mutable_doc)
		.cat(target_doc(name, pattern))
		.cat(type_doc_part)
		.cat(" = ".text())
		.cat(value.expr_doc())


private pure func annotation_doc(name: String, enabled: Bool, is_private: Bool) -> Doc:
	if enabled:
		sep: Doc = if is_private:
			" ".text()
		else:
			hardline()
		name
			.text()
			.cat(sep)
	else:
		"".text()


private pure func is_foreign_func_body(body: FuncBody) -> Bool:
	match body:
		ForeignFuncBody(_, _): True
		_: False


private pure func builtin_body_doc(name: Option[String]) -> Doc:
	match name:
		Some(c_name): ("builtin(\"" + c_name.escape_string_value() + "\")").text()
		None: "builtin".text()


private pure func func_body_suffix_doc(name: String, body: FuncBody) -> Doc:
	match body:
		ExprFuncBody(expr):
			":"
				.text()
				.cat(hardline()
						.cat(expr.block_body_doc())
						.indent())
		BuiltinFuncBody(c_name):
			":"
				.text()
				.cat(hardline()
						.cat(c_name.builtin_body_doc())
						.indent())
		ForeignFuncBody(foreign_name, _):
			if foreign_name == name:
				"".text()
			else:
				" = \""
					.text()
					.cat(foreign_name
							.escape_string_value()
							.text())
					.cat("\"".text())
		NoFuncBody: ":".text()


private pure func func_decl_doc(
	is_private: Bool,
	name: String,
	is_pure: Bool,
	is_tailrec: Bool,
	is_debug_only: Bool,
	no_copy: Bool,
	type_params: List[String],
	params: List[FuncParam],
	ret: Option[TypeExpr],
	body: FuncBody,
) -> Doc:
	pure_doc: Doc = if is_pure:
		"pure ".text()
	else:
		"".text()
	foreign_body: Bool = body.is_foreign_func_body()
	foreign_doc: Doc = if foreign_body:
		"foreign ".text()
	else:
		"".text()
	head: Doc = is_private
		.private_doc()
		.cat(annotation_doc("@debug_only", is_debug_only, is_private))
		.cat(annotation_doc("@tailrec", is_tailrec, is_private))
		.cat(annotation_doc("@no_copy", no_copy and foreign_body, is_private))
		.cat(foreign_doc)
		.cat(pure_doc)
		.cat("func ".text())
		.cat(name.text())
		.cat(type_params.type_params_doc())
		.cat(params.func_params_doc())
		.cat(ret.return_doc())
	head.cat(func_body_suffix_doc(name, body))


private pure func type_variant_doc(variant: TypeVariant) -> Doc:
	if variant.fields.length() == 0:
		variant.name.text()
	else:
		variant.name
			.text()
			.cat("(".text())
			.cat(variant.fields
					.type_expr_docs()
					.comma_sep())
			.cat(")".text())


private pure func type_variant_docs(variants: List[TypeVariant]) -> List[Doc]:
	var docs: List[Doc] = []
	for variant in variants:
		docs = docs.append(variant.type_variant_doc())
	docs


private pure func type_decl_doc(
	is_private: Bool,
	name: String,
	type_params: List[String],
	is_enum: Bool,
	is_builtin: Bool,
	variants: List[TypeVariant],
) -> Doc:
	if is_builtin:
		is_private
			.private_doc()
			.cat("type ".text())
			.cat(name.text())
			.cat(type_params.type_params_doc())
			.cat(" = builtin".text())
	else:
		keyword: String = if is_enum:
			"enum "
		else:
			"union "
		is_private
			.private_doc()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_doc())
			.cat(":".text())
			.cat(hardline()
					.cat(variants
							.type_variant_docs()
							.hardlines())
					.indent())


private pure func decl_field_doc(field_value: DeclField) -> Doc:
	field_value.name
		.text()
		.cat(": ".text())
		.cat(field_value.field_type.type_doc())


private pure func decl_field_docs(fields: List[DeclField]) -> List[Doc]:
	var docs: List[Doc] = []
	for field_value in fields:
		docs = docs.append(field_value.decl_field_doc())
	docs


private pure func record_decl_doc(
	is_private: Bool,
	name: String,
	type_params: List[String],
	is_value: Bool,
	is_builtin: Bool,
	fields: List[DeclField],
) -> Doc:
	keyword: String = if is_value:
		"struct "
	else:
		"record "
	if is_builtin:
		is_private
			.private_doc()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_doc())
			.cat(" {builtin}".text())
	else:
		is_private
			.private_doc()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_doc())
			.cat(" {".text())
			.cat(softline()
					.cat(fields
							.decl_field_docs()
							.comma_sep_break())
					.indent()
					.cat(softline())
					.group())
			.cat("}".text())


private pure func type_alias_decl_doc(
	is_private: Bool,
	name: String,
	type_params: List[String],
	target: TypeExpr,
) -> Doc:
	is_private
		.private_doc()
		.cat("type alias ".text())
		.cat(name.text())
		.cat(type_params.type_params_doc())
		.cat(" = ".text())
		.cat(target.type_doc())


private pure func supertraits_doc(supertraits: List[String]) -> Doc:
	if supertraits.length() == 0:
		"".text()
	else:
		": "
			.text()
			.cat(" + "
					.text()
					.intersperse(supertraits.string_docs()))


private pure func trait_method_doc(method: TraitMethod) -> Doc:
	pure_doc: Doc = if method.is_pure:
		"pure ".text()
	else:
		"".text()
	head: Doc = pure_doc
		.cat("func ".text())
		.cat(method.name.text())
		.cat(method.params.func_params_doc())
		.cat(method.ret.return_doc())
	match method.body:
		None: head
		Some(body):
			if body.is_block_expr():
				head
					.cat(":".text())
					.cat(hardline()
							.cat(body.block_body_doc())
							.indent())
			else:
				head
					.cat(": ".text())
					.cat(body.expr_doc())


private pure func trait_method_docs(methods: List[TraitMethod]) -> List[Doc]:
	var docs: List[Doc] = []
	for method in methods:
		docs = docs.append(method.trait_method_doc())
	docs


private pure func trait_decl_doc(
	is_private: Bool,
	name: String,
	type_params: List[String],
	supertraits: List[String],
	methods: List[TraitMethod],
) -> Doc:
	needs_colon: Bool = methods.length() != 0 or supertraits.length() == 0
	colon_doc: Doc = if needs_colon:
		":".text()
	else:
		"".text()
	header: Doc = is_private
		.private_doc()
		.cat("trait ".text())
		.cat(name.text())
		.cat(type_params.type_params_doc())
		.cat(supertraits.supertraits_doc())
		.cat(colon_doc)
	if methods.length() == 0:
		header
	else:
		header.cat(hardline()
				.cat(methods
						.trait_method_docs()
						.hardlines())
				.indent())


private pure func impl_method_doc(method: ImplMethod) -> Doc:
	func_decl_doc(
		False,
		method.name,
		method.is_pure,
		method.is_tailrec,
		method.is_debug_only,
		method.no_copy,
		method.type_params,
		method.params,
		method.ret,
		method.body,
	)


private pure func impl_method_docs(methods: List[ImplMethod]) -> List[Doc]:
	var docs: List[Doc] = []
	for method in methods:
		docs = docs.append(method.impl_method_doc())
	docs


private pure func impl_decl_doc(
	is_private: Bool,
	trait_name: String,
	for_type: TypeExpr,
	methods: List[ImplMethod],
) -> Doc:
	is_private
		.private_doc()
		.cat("implements ".text())
		.cat(trait_name.text())
		.cat(" for ".text())
		.cat(for_type.type_doc())
		.cat(":".text())
		.cat(hardline()
				.cat(blank_lines(1, methods.impl_method_docs()))
				.indent())


pure func decl_doc(decl: Decl) -> Doc:
	match decl:
		DocDecl(doc, inner): doc
			.docstring_doc()
			.cat(inner.decl_doc())
		ImportDecl(item): item.import_decl_doc()
		VarDecl(is_private, name, pattern, is_mutable, ty, value): var_decl_doc(
			is_private,
			name,
			pattern,
			is_mutable,
			ty,
			value,
		)
		FuncDecl(is_private, name, is_pure, is_tailrec, is_debug_only, no_copy, type_params, params, ret, body): func_decl_doc(
			is_private,
			name,
			is_pure,
			is_tailrec,
			is_debug_only,
			no_copy,
			type_params,
			params,
			ret,
			body,
		)
		TypeDecl(is_private, name, type_params, is_enum, is_builtin, variants): type_decl_doc(
			is_private,
			name,
			type_params,
			is_enum,
			is_builtin,
			variants,
		)
		RecordDecl(is_private, name, type_params, is_value, is_builtin, fields): record_decl_doc(
			is_private,
			name,
			type_params,
			is_value,
			is_builtin,
			fields,
		)
		TypeAliasDecl(is_private, name, type_params, target): type_alias_decl_doc(
			is_private,
			name,
			type_params,
			target,
		)
		TraitDecl(is_private, name, type_params, supertraits, methods): trait_decl_doc(
			is_private,
			name,
			type_params,
			supertraits,
			methods,
		)
		ImplDecl(is_private, trait_name, for_type, methods): impl_decl_doc(
			is_private,
			trait_name,
			for_type,
			methods,
		)


private pure func decl_func_name(decl: Decl) -> Option[String]:
	match decl:
		DocDecl(_, inner): inner.decl_func_name()
		FuncDecl(_, name, _, _, _, _, _, _, _, _): Some(name)
		_: None


private pure func is_small_decl(decl: Decl) -> Bool:
	match decl:
		DocDecl(_, inner): inner.is_small_decl()
		VarDecl(_, _, _, _, _, _): True
		TypeAliasDecl(_, _, _, _): True
		_: False


private pure func foreign_block_func_doc(decl: Decl) -> Doc:
	match decl:
		DocDecl(doc, inner): doc
			.docstring_doc()
			.cat(inner.foreign_block_func_doc())
		FuncDecl(_, name, is_pure, _, is_debug_only, no_copy, type_params, params, ret, body):
			debug_doc: Doc = if is_debug_only:
				"@debug_only ".text()
			else:
				"".text()
			no_copy_doc: Doc = if no_copy:
				"@no_copy ".text()
			else:
				"".text()
			pure_doc: Doc = if is_pure:
				"pure ".text()
			else:
				"".text()
			debug_doc
				.cat(no_copy_doc)
				.cat(pure_doc)
				.cat("func ".text())
				.cat(name.text())
				.cat(type_params.type_params_doc())
				.cat(params.func_params_doc())
				.cat(ret.return_doc())
				.cat(func_body_suffix_doc(name, body))
		_: decl.decl_doc()


private pure func foreign_link_flag_key(flag: ForeignLinkFlag) -> String:
	match flag.platform:
		None: "link"
		Some("linux"): "link_linux"
		Some("macos"): "link_macos"
		Some(platform): "link_" + platform


private pure func foreign_link_flag_arg(flag: ForeignLinkFlag) -> String:
	flag.foreign_link_flag_key() + ": \"" + flag.value.escape_string_value() + "\""


private pure func foreign_block_header_doc(metadata: ForeignMetadata) -> Doc:
	var args: List[String] = []
	for include in metadata.includes:
		args = args.append("include: \"" + include.escape_string_value() + "\"")
	for flag in metadata.link_flags:
		args = args.append(flag.foreign_link_flag_arg())
	if args.length() == 0:
		"foreign:".text()
	else:
		("foreign(" + args.join(", ") + "):").text()


private pure func option_string_equal(left: Option[String], right: Option[String]) -> Bool:
	match left:
		None:
			match right:
				None: True
				Some(_): False
		Some(left_value):
			match right:
				Some(right_value): left_value == right_value
				None: False


private pure func string_lists_equal(left: List[String], right: List[String]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var same: Bool = True
		var index: Int = 0
		for left_value in left:
			match right.get(index):
				Some(right_value):
					if left_value != right_value:
						same = False
				None: same = False
			index += 1
		same


private pure func foreign_link_flag_equal(left: ForeignLinkFlag, right: ForeignLinkFlag) -> Bool:
	left.platform.option_string_equal(right.platform) and left.value == right.value


private pure func foreign_link_flags_equal(
	left: List[ForeignLinkFlag],
	right: List[ForeignLinkFlag],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var same: Bool = True
		var index: Int = 0
		for left_value in left:
			match right.get(index):
				Some(right_value):
					if not left_value.foreign_link_flag_equal(right_value):
						same = False
				None: same = False
			index += 1
		same


private pure func foreign_metadata_equal(left: ForeignMetadata, right: ForeignMetadata) -> Bool:
	left.includes.string_lists_equal(
		right.includes,
	) and left.link_flags.foreign_link_flags_equal(right.link_flags)


private pure func decl_foreign_metadata(decl: Decl) -> Option[ForeignMetadata]:
	match decl:
		DocDecl(_, inner): inner.decl_foreign_metadata()
		FuncDecl(is_private, _, _, _, _, _, _, _, _, body):
			if is_private:
				None
			else:
				match body:
					ForeignFuncBody(_, metadata): Some(metadata)
					_: None
		_: None


private pure func located_decl_foreign_metadata(located: LocatedDecl) -> Option[ForeignMetadata]:
	located.decl.decl_foreign_metadata()


private pure func located_decl_has_same_foreign_metadata(
	located: LocatedDecl,
	metadata: ForeignMetadata,
) -> Bool:
	match located.located_decl_foreign_metadata():
		Some(other): other.foreign_metadata_equal(metadata)
		None: False


private pure func foreign_block_metadata(decls: List[LocatedDecl]) -> ForeignMetadata:
	match decls.get(0):
		Some(first):
			match first.located_decl_foreign_metadata():
				Some(metadata): metadata
				None: {includes = [], link_flags = []}
		None: {includes = [], link_flags = []}


private pure func render_foreign_block_func(
	located: LocatedDecl,
	comments: List[FormatterComment],
	skip_leading: Bool,
) -> RenderedDoc:
	leading: CommentTake = if skip_leading:
		{taken = [], remaining = comments}
	else:
		comments.take_leading_comments(located.line)
	trailing: TrailingCommentTake = leading.remaining.take_trailing_comment(located.line)
	{doc = leading.taken
			.comments_doc()
			.cat(located.decl.foreign_block_func_doc())
			.cat(
				trailing.comment.trailing_comment_doc(),
			), remaining_comments = trailing.remaining.copy_formatter_comments()}


private pure func render_foreign_block(
	decls: List[LocatedDecl],
	comments: List[FormatterComment],
) -> RenderedDoc:
	var body_doc: Doc = "".text()
	var has_body_doc: Bool = False
	var remaining_comments: List[FormatterComment] = comments
	var is_first: Bool = True
	for located in decls:
		rendered: RenderedDoc = located.render_foreign_block_func(remaining_comments, is_first)
		if has_body_doc:
			body_doc = body_doc
				.cat(hardline())
				.cat(rendered.doc)
		else:
			body_doc = rendered.doc
			has_body_doc = True
		remaining_comments = rendered.remaining_comments.copy_formatter_comments()
		is_first = False
	{doc = decls
			.foreign_block_metadata()
			.foreign_block_header_doc()
			.cat(hardline()
					.cat(body_doc)
					.indent()), remaining_comments = remaining_comments}


private pure func flush_foreign_body_item(
	items: List[ProgramBodyItem],
	foreign_group: List[LocatedDecl],
) -> List[ProgramBodyItem]:
	if foreign_group.length() == 0:
		items
	else:
		items.append(BodyForeignBlock(foreign_group))


private pure func flush_import_body_item(
	items: List[ProgramBodyItem],
	import_group: List[LocatedImport],
) -> List[ProgramBodyItem]:
	if import_group.length() == 0:
		items
	else:
		items.append(BodyImportBlock(import_group))


private pure func located_decl_import(located: LocatedDecl) -> Option[LocatedImport]:
	match located.decl:
		ImportDecl(item): Some({line = located.line, column = located.column, item = item})
		_: None


private pure func program_body_items(decls: List[LocatedDecl]) -> List[ProgramBodyItem]:
	var items: List[ProgramBodyItem] = []
	var import_group: List[LocatedImport] = []
	var foreign_group: List[LocatedDecl] = []
	var foreign_metadata: Option[ForeignMetadata] = None
	for located in decls:
		match located.located_decl_import():
			Some(import_item):
				items = items.flush_foreign_body_item(foreign_group)
				foreign_group = []
				foreign_metadata = None
				import_group = import_group.append(import_item)
			None:
				items = items.flush_import_body_item(import_group)
				import_group = []
				match located.located_decl_foreign_metadata():
					Some(metadata):
						match foreign_metadata:
							Some(current):
								if current.foreign_metadata_equal(metadata):
									foreign_group = foreign_group.append(located)
								else:
									items = items.flush_foreign_body_item(foreign_group)
									foreign_group = [located]
									foreign_metadata = Some(metadata)
							None:
								foreign_group = [located]
								foreign_metadata = Some(metadata)
					None:
						items = items.flush_foreign_body_item(foreign_group)
						foreign_group = []
						foreign_metadata = None
						items = items.append(BodyDecl(located))
	items
		.flush_import_body_item(import_group)
		.flush_foreign_body_item(foreign_group)


private pure func program_body_item_func_name(item: ProgramBodyItem) -> Option[String]:
	match item:
		BodyDecl(located): located.decl.decl_func_name()
		BodyImportBlock(_): None
		BodyForeignBlock(_): None


private pure func is_small_program_body_item(item: ProgramBodyItem) -> Bool:
	match item:
		BodyDecl(located): located.decl.is_small_decl()
		BodyImportBlock(_): False
		BodyForeignBlock(_): False


private pure func is_same_function_overload_item(
	left: ProgramBodyItem,
	right: ProgramBodyItem,
) -> Bool:
	match left.program_body_item_func_name():
		Some(left_name):
			match right.program_body_item_func_name():
				Some(right_name): left_name == right_name
				None: False
		None: False


private pure func program_body_item_separator(left: ProgramBodyItem, right: ProgramBodyItem) -> Doc:
	if left.is_same_function_overload_item(right):
		hardline()
	else if left.is_small_program_body_item() and right.is_small_program_body_item():
		hardline().cat(hardline())
	else:
		hardline()
			.cat(hardline())
			.cat(hardline())


private pure func render_program_body_item(
	item: ProgramBodyItem,
	comments: List[FormatterComment],
) -> RenderedDoc:
	match item:
		BodyDecl(located):
			leading: CommentTake = comments.take_leading_comments(located.line)
			trailing: TrailingCommentTake = leading.remaining.take_trailing_comment(located.line)
			drained: CommentTake = trailing.remaining.drain_comments_through(located.end_line)
			{doc = leading.taken
					.comments_doc()
					.cat(located.decl.decl_doc())
					.cat(
						trailing.comment.trailing_comment_doc(),
					), remaining_comments = drained.remaining.copy_formatter_comments()}
		BodyImportBlock(imports):
			rendered: ImportBlockRender = imports.render_import_block(comments)
			{
				doc = rendered.doc,
				remaining_comments = rendered.remaining_comments.copy_formatter_comments(),
			}
		BodyForeignBlock(decls):
			first_line: Int = match decls.get(0):
				Some(first): first.line
				None: 0
			leading: CommentTake = comments.take_leading_comments(first_line)
			rendered: RenderedDoc = decls.render_foreign_block(
				leading.remaining.copy_formatter_comments(),
			)
			{doc = leading.taken
					.comments_doc()
					.cat(
						rendered.doc,
					), remaining_comments = rendered.remaining_comments.copy_formatter_comments()}


private pure func split_leading_imports(decls: List[LocatedDecl]) -> ProgramParts:
	var imports: List[LocatedImport] = []
	var body: List[LocatedDecl] = []
	var in_body: Bool = False
	for located in decls:
		if in_body:
			body = body.append(located)
		else:
			match located.decl:
				ImportDecl(item): imports = imports.append(
					{line = located.line, column = located.column, item = item},
				)
				_:
					in_body = True
					body = body.append(located)
	{imports = imports, body = body}


private pure func program_body_doc(
	decls: List[LocatedDecl],
	comments: List[FormatterComment],
) -> Doc:
	items: List[ProgramBodyItem] = decls.program_body_items()
	var result: Doc = "".text()
	var previous: Option[ProgramBodyItem] = None
	var remaining_comments: List[FormatterComment] = comments
	for item in items:
		rendered: RenderedDoc = item.render_program_body_item(remaining_comments)
		match previous:
			None: result = rendered.doc
			Some(prev): result = result
				.cat(prev.program_body_item_separator(item))
				.cat(rendered.doc)
		remaining_comments = rendered.remaining_comments.copy_formatter_comments()
		previous = Some(item)
	result.append_remaining_comments(remaining_comments)


private pure func program_first_decl_line(decls: List[LocatedDecl]) -> Int:
	match decls.get(0):
		Some(first): first.line
		None: 2147483647


pure func program_doc(program: Program) -> Doc:
	parts: ProgramParts = program.decls.split_leading_imports()
	if parts.imports.length() == 0:
		parts.body.program_body_doc(program.comments)
	else:
		header_comments: CommentTake = program.comments.take_leading_comments(
			program.decls.program_first_decl_line(),
		)
		import_render: ImportBlockRender = parts.imports.render_import_block(
			header_comments.remaining.copy_formatter_comments(),
		)
		import_doc: Doc = header_comments.taken
			.comments_doc()
			.cat(import_render.doc)
		body_doc: Doc = parts.body.program_body_doc(
			import_render.remaining_comments.copy_formatter_comments(),
		)
		if parts.body.length() == 0:
			import_doc.append_remaining_comments(
				import_render.remaining_comments.copy_formatter_comments(),
			)
		else:
			import_doc
				.cat(hardline())
				.cat(hardline())
				.cat(hardline())
				.cat(body_doc)


private pure func located_decl_from_json(value: JsonValue) -> Result[LocatedDecl, String]:
	match value.get_field("decl"):
		Some(decl_value):
			line ?= value.int_field("line")
			column ?= value.int_field("column")
			end_line ?= value.optional_int_field("end_line")
			decl ?= decl_value.decl_from_json()
			resolved_end: Int = match end_line:
				Some(value): value
				None: line
			Ok({line = line, column = column, end_line = resolved_end, decl = decl})
		None:
			decl ?= value.decl_from_json()
			Ok({line = 0, column = 0, end_line = 0, decl = decl})


pure func program_from_json(value: JsonValue) -> Result[Program, String]:
	items ?= value.array_field("program")
	comments ?= value.formatter_comments_field("comments")
	var result: List[LocatedDecl] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.located_decl_from_json():
					Ok(decl): result = result.append(decl)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok({decls = result, comments = comments})


pure func program_from_json_string(input: String) -> Result[Program, String]:
	value ?= input.parse_json()
	value.program_from_json()


pure func layout_decl_json(width: Int, input: String) -> Result[String, String]:
	decl ?= input.decl_from_json_string()
	Ok(width.layout(decl.decl_doc()))


pure func layout_program_json(width: Int, input: String) -> Result[String, String]:
	program ?= input.program_from_json_string()
	Ok(width.layout(program.program_doc()))
