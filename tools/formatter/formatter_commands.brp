import:
	./declaration_documents: render_program_json
	system: file_exists, read_file, write_file


func render_program_json_file(path: String, width: Int) -> Result[String, String]:
	if not path.file_exists():
		Err("program JSON file not found: " + path)
	else:
		match path.read_file():
			Err(msg):
				Err("failed to read program JSON: " + msg)
			Ok(json):
				width.render_program_json(json)


func write_rendered_program_json(
	input_path: String,
	output_path: String,
	width: Int,
) -> Result[Void, String]:
	match input_path.render_program_json_file(width):
		Err(msg):
			Err(msg)
		Ok(rendered):
			output_path.write_file(rendered)
