import:
	argparse:
		Args,
		Cli,
		ParseOutcome(Parsed, HelpRequested, VersionRequested, ParseFailed),
		arg_int,
		format_error,


record WidthArgs {
	width: Int,
	paths: List[String]
}


record ProgramArgs {
	width: Int,
	path: String
}


record ProgramBatchArgs {
	width: Int,
	pairs: List[(String, String)]
}


union ParsedCommand:
	CommandProgram(ProgramArgs)
	CommandProgramBatch(ProgramBatchArgs)
	CommandMessage(String, Int)


help_text: String = "Usage: formatter <command> [options]\n\nCommands:\n  program <program-json-file>              Render full-program formatter JSON\n  program-batch <program-json-file> <out>  Render full-program JSON input/output pairs\n\nRun `formatter <command> --help` for command options."


pure func is_help_arg(arg: String) -> Bool:
	arg == "--help" or arg == "-h"


pure func command_description(command: String) -> String:
	match command:
		"program":
			"Render full-program formatter JSON"
		"program-batch":
			"Render full-program JSON input/output pairs"
		_:
			"Run formatter command"


pure func is_known_command(command: String) -> Bool:
	command == "program" or command == "program-batch"


pure func command_cli_spec(command: String) -> Cli:
	{
		name = "formatter " + command,
		version = "0.0.0-internal",
		description = command.command_description(),
		params = [
			arg_int(
				"width",
				Some("--width"),
				Some("-w"),
				"Render width (default: 100)",
				Some("N"),
			),
		]
	}


pure func command_argv(command: String, args: List[String]) -> List[String]:
	[command].concat(args)


pure func width_args_from_parsed(parsed: Args) -> WidthArgs:
	{
		width = parsed.get_int_or("width", 100),
		paths = parsed.positional.concat(parsed.rest)
	}


pure func parse_width_args(command: String, args: List[String]) -> Result[WidthArgs, String]:
	match command
		.command_cli_spec()
		.parse(command.command_argv(args)):
		Parsed(parsed):
			Ok(parsed.width_args_from_parsed())
		HelpRequested(_):
			Err("help requested")
		VersionRequested(version):
			Err(version)
		ParseFailed(err):
			Err(err.format_error())


pure func parse_command(command: String, args: List[String]) -> ParsedCommand:
	if not command.is_known_command():
		CommandMessage("unknown formatter command: " + command, 1)
	else:
		match command
			.command_cli_spec()
			.parse(command.command_argv(args)):
			Parsed(parsed):
				width_args: WidthArgs = parsed.width_args_from_parsed()

				match command:
					"program":
						match width_args.paths.single_path("program", "program-json-file"):
							Ok(path):
								CommandProgram({
									width = width_args.width,
									path = path,
								})
							Err(msg):
								CommandMessage(msg, 1)
					"program-batch":
						match width_args.paths.batch_pairs_from_paths(
							"program-batch",
							"program-json-file",
						):
							Ok(pairs):
								CommandProgramBatch({
									width = width_args.width,
									pairs = pairs,
								})
							Err(msg):
								CommandMessage(msg, 1)
					_:
						CommandMessage("unknown formatter command: " + command, 1)
			HelpRequested(help):
				CommandMessage(help, 0)
			VersionRequested(version):
				CommandMessage(version, 0)
			ParseFailed(err):
				CommandMessage(err.format_error(), 1)


pure func single_path(paths: List[String], command: String, name: String) -> Result[String, String]:
	if paths.length() == 0:
		Err(command + " command requires <" + name + ">")
	else if paths.length() > 1:
		match paths.get(1):
			Some(extra):
				Err("unexpected argument for " + command + ": " + extra)
			None:
				Err("unexpected extra arguments for " + command)
	else:
		match paths.get(0):
			Some(path):
				Ok(path)
			None:
				Err(command + " command requires <" + name + ">")


pure func batch_pair_error(command: String, input_name: String) -> String:
	command + " command requires <" + input_name + "> <output-file> pairs"


pure func batch_pairs_from_paths(
	paths: List[String],
	command: String,
	input_name: String,
) -> Result[List[(String, String)], String]:
	-- Only even path counts reach the chunks(2) pipeline below.
	if paths.length() == 0 or paths.length() % 2 != 0:
		Err(command.batch_pair_error(input_name))
	else:
		Ok(
			paths
				.chunks(2)
				.filter_map(func(path_pair: List[String]) -> Option[(String, String)]:
					match path_pair:
						[input_path, output_path]:
							Some((input_path, output_path))
						_:
							None
				),
		)
