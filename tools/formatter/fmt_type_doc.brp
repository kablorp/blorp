import:
	./fmt_json: array_field, bool_field, field, int_field, string_field
	./fmt_layout: Doc, cat, comma_sep, layout, parens, text
	json: JsonValue, parse_json


union TypeDimOp:
	TypeDimAdd
	TypeDimSub
	TypeDimMul
	TypeDimDiv


union TypeExpr:
	NamedType(String, List[TypeExpr])
	ArrayType(TypeExpr, List[TypeExpr])
	FuncType(Bool, List[TypeExpr], TypeExpr)
	VarType(String)
	BoundVarType(String)
	ConstIntType(Int)
	TupleType(List[TypeExpr])
	SelfType
	VarDimsType(String)
	RangeType(TypeExpr)
	DimOpType(TypeDimOp, TypeExpr, TypeExpr)
	MetaType(Int)


private pure func type_expr_list_contains_func(types: List[TypeExpr]) -> Bool:
	var contains: Bool = False
	for ty in types:
		if ty.type_expr_contains_func():
			contains = True
	contains


pure func type_expr_contains_func(ty: TypeExpr) -> Bool:
	match ty:
		FuncType(_, _, _): True
		NamedType(_, args): args.type_expr_list_contains_func()
		ArrayType(elem, dims): elem.type_expr_contains_func() or dims.type_expr_list_contains_func()
		TupleType(elems): elems.type_expr_list_contains_func()
		RangeType(inner): inner.type_expr_contains_func()
		DimOpType(_, left, right): left.type_expr_contains_func() or right.type_expr_contains_func()
		_: False


private pure func dim_op_from_json(value: String) -> Result[TypeDimOp, String]:
	match value:
		"Add": Ok(TypeDimAdd)
		"Sub": Ok(TypeDimSub)
		"Mul": Ok(TypeDimMul)
		"Div": Ok(TypeDimDiv)
		_: Err("unknown type dimension operator: " + value)


private pure func dim_op_text(op: TypeDimOp) -> String:
	match op:
		TypeDimAdd: " + "
		TypeDimSub: " - "
		TypeDimMul: " * "
		TypeDimDiv: " / "


private pure func is_additive_dim(ty: TypeExpr) -> Bool:
	match ty:
		DimOpType(TypeDimAdd, _, _): True
		DimOpType(TypeDimSub, _, _): True
		_: False


private pure func type_expr_field(value: JsonValue, key: String) -> Result[TypeExpr, String]:
	child ?= value.field(key)
	child.type_expr_from_json()


private pure func type_expr_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TypeExpr], String]:
	items ?= value.array_field(key)
	var result: List[TypeExpr] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.type_expr_from_json():
					Ok(ty): result = result.append(ty)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


pure func type_expr_from_json(value: JsonValue) -> Result[TypeExpr, String]:
	tag ?= value.string_field("tag")
	match tag:
		"Named":
			name ?= value.string_field("name")
			args ?= value.type_expr_array_field("args")
			Ok(NamedType(name, args))
		"Array":
			elem ?= value.type_expr_field("elem")
			dims ?= value.type_expr_array_field("dims")
			Ok(ArrayType(elem, dims))
		"Func":
			is_pure ?= value.bool_field("pure")
			params ?= value.type_expr_array_field("params")
			return_ty ?= value.type_expr_field("return")
			Ok(FuncType(is_pure, params, return_ty))
		"Var":
			name ?= value.string_field("name")
			Ok(VarType(name))
		"BoundVar":
			source ?= value.string_field("source")
			Ok(BoundVarType(source))
		"ConstInt":
			value_int ?= value.int_field("value")
			Ok(ConstIntType(value_int))
		"Tuple":
			elems ?= value.type_expr_array_field("elems")
			Ok(TupleType(elems))
		"Self": Ok(SelfType)
		"VarDims":
			name ?= value.string_field("name")
			Ok(VarDimsType(name))
		"Range":
			inner ?= value.type_expr_field("inner")
			Ok(RangeType(inner))
		"DimOp":
			raw_op ?= value.string_field("op")
			op ?= raw_op.dim_op_from_json()
			left ?= value.type_expr_field("left")
			right ?= value.type_expr_field("right")
			Ok(DimOpType(op, left, right))
		"Meta":
			id ?= value.int_field("id")
			Ok(MetaType(id))
		_: Err("unknown type expression JSON tag: " + tag)


pure func type_expr_from_json_string(input: String) -> Result[TypeExpr, String]:
	value ?= input.parse_json()
	value.type_expr_from_json()


private pure func type_doc_list(types: List[TypeExpr]) -> List[Doc]:
	var docs: List[Doc] = []
	for ty in types:
		docs = docs.append(ty.type_doc())
	docs


private pure func array_elem_type_doc(ty: TypeExpr) -> Doc:
	match ty:
		FuncType(_, _, _): ty
			.type_doc()
			.parens()
		_: ty.type_doc()


private pure func dim_operand_doc(ty: TypeExpr) -> Doc:
	if ty.is_additive_dim():
		ty
			.type_doc()
			.parens()
	else:
		ty.type_doc()


pure func type_doc(ty: TypeExpr) -> Doc:
	match ty:
		NamedType(name, args):
			if args.length() == 0:
				name.text()
			else:
				name
					.text()
					.cat("[".text())
					.cat(args
							.type_doc_list()
							.comma_sep())
					.cat("]".text())
		ArrayType(elem, dims):
			elem
				.array_elem_type_doc()
				.cat("[".text())
				.cat(dims
						.type_doc_list()
						.comma_sep())
				.cat("]".text())
		FuncType(is_pure, params, return_ty):
			prefix: Doc = if is_pure:
				"pure ".text()
			else:
				"".text()
			prefix
				.cat("(".text())
				.cat(params
						.type_doc_list()
						.comma_sep())
				.cat(") -> ".text())
				.cat(return_ty.type_doc())
		VarType(name): name.text()
		BoundVarType(source): source.text()
		ConstIntType(value): ("#" + value.to_string()).text()
		TupleType(elems):
			"("
				.text()
				.cat(elems
						.type_doc_list()
						.comma_sep())
				.cat(")".text())
		SelfType: "Self".text()
		VarDimsType(name): (name + "...").text()
		RangeType(inner): ".."
			.text()
			.cat(inner.type_doc())
		DimOpType(op, left, right):
			match op:
				TypeDimAdd: left
					.type_doc()
					.cat(" + ".text())
					.cat(right.type_doc())
				TypeDimSub: left
					.type_doc()
					.cat(" - ".text())
					.cat(right.type_doc())
				TypeDimMul: left
					.dim_operand_doc()
					.cat(" * ".text())
					.cat(right.dim_operand_doc())
				TypeDimDiv: left
					.dim_operand_doc()
					.cat(" / ".text())
					.cat(right.dim_operand_doc())
		MetaType(id): ("?m" + id.to_string()).text()


pure func layout_type_json(width: Int, input: String) -> Result[String, String]:
	ty ?= input.type_expr_from_json_string()
	Ok(width.layout(ty.type_doc()))
