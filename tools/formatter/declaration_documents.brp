private pure func declaration_field_from_json(value: JsonValue) -> Result[DeclarationField, String]:
	name ?= value.string_field("name")
	field_type ?= value.type_expression_field("type")
	Ok({name = name, field_type = field_type})


private pure func declaration_field_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[DeclarationField], String]:
	items ?= value.array_field(key)
	var result: List[DeclarationField] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.declaration_field_from_json():
					Ok(field_value): result = result.append(field_value)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func trait_method_from_json(value: JsonValue) -> Result[TraitMethod, String]:
	name ?= value.string_field("name")
	is_pure ?= value.bool_field("pure")
	params ?= value.function_parameter_array_field("params")
	return_type ?= value.optional_type_expression_field("return")
	body ?= value.optional_expression_field("body")
	Ok({name = name, is_pure = is_pure, params = params, return_type = return_type, body = body})


private pure func trait_method_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TraitMethod], String]:
	items ?= value.array_field(key)
	var result: List[TraitMethod] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.trait_method_from_json():
					Ok(method): result = result.append(method)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func implementation_method_from_json(
	value: JsonValue,
) -> Result[ImplementationMethod, String]:
	name ?= value.string_field("name")
	is_pure ?= value.bool_field("pure")
	is_tailrec ?= value.bool_field("tailrec")
	is_debug_only ?= value.bool_field("debug_only")
	no_copy ?= value.bool_field("no_copy")
	type_params ?= value.string_array_field("type_params")
	params ?= value.function_parameter_array_field("params")
	return_type ?= value.optional_type_expression_field("return")
	where_constraints ?= value.type_constraint_array_field_or_empty("where")
	body ?= value.function_body_from_json()
	Ok(
		{
			name = name,
			is_pure = is_pure,
			is_tailrec = is_tailrec,
			is_debug_only = is_debug_only,
			no_copy = no_copy,
			type_params = type_params,
			params = params,
			return_type = return_type,
			where_constraints = where_constraints,
			body = body,
		},
	)


private pure func implementation_method_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[ImplementationMethod], String]:
	items ?= value.array_field(key)
	var result: List[ImplementationMethod] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.implementation_method_from_json():
					Ok(method): result = result.append(method)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func function_body_from_json(value: JsonValue) -> Result[FunctionBody, String]:
	match value.get_field("body"):
		Some(child):
			body ?= child.expression_from_json()
			Ok(ExpressionFunctionBody(body))
		None:
			kind ?= value.string_field("body_kind")
			match kind:
				"builtin":
					name ?= value.optional_string_field("builtin_name")
					Ok(BuiltinFunctionBody(name))
				"foreign":
					foreign_name ?= value.string_field("foreign_name")
					includes ?= value.string_array_field_or_empty("foreign_includes")
					link_flags ?= value.foreign_link_flags_field("foreign_link_flags")
					Ok(
						ForeignFunctionBody(
							foreign_name,
							{includes = includes, link_flags = link_flags},
						),
					)
				"none": Ok(NoFunctionBody)
				_: Err("unknown function body JSON kind: " + kind)


pure func declaration_from_json(value: JsonValue) -> Result[Declaration, String]:
	tag ?= value.string_field("tag")
	match tag:
		"Doc":
			doc ?= value.string_field("doc")
			decl_value ?= value.field("decl")
			decl ?= decl_value.declaration_from_json()
			Ok(DocumentedDeclaration(doc, decl))
		"Import":
			item ?= value.import_item_from_json()
			Ok(ImportDeclaration(item))
		"Var":
			is_private ?= value.bool_field("private")
			name ?= value.optional_string_field("name")
			pattern ?= value.optional_pattern_field("pattern")
			is_mutable ?= value.bool_field("mutable")
			type_expression ?= value.optional_type_expression_field("type")
			value_expr ?= value.expression_field("value")
			Ok(
				VariableDeclaration(
					is_private,
					name,
					pattern,
					is_mutable,
					type_expression,
					value_expr,
				),
			)
		"Func":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			is_pure ?= value.bool_field("pure")
			is_tailrec ?= value.bool_field("tailrec")
			is_debug_only ?= value.bool_field("debug_only")
			no_copy ?= value.bool_field("no_copy")
			type_params ?= value.string_array_field("type_params")
			params ?= value.function_parameter_array_field("params")
			return_type ?= value.optional_type_expression_field("return")
			where_constraints ?= value.type_constraint_array_field_or_empty("where")
			body ?= value.function_body_from_json()
			Ok(
				FunctionDeclaration(
					is_private,
					name,
					is_pure,
					is_tailrec,
					is_debug_only,
					no_copy,
					type_params,
					params,
					return_type,
					where_constraints,
					body,
				),
			)
		"Type":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			is_enum ?= value.bool_field("enum")
			is_builtin ?= value.bool_field("builtin")
			variants ?= value.type_variant_array_field("variants")
			Ok(TypeDeclaration(is_private, name, type_params, is_enum, is_builtin, variants))
		"Record":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			is_value ?= value.bool_field("value")
			is_builtin ?= value.bool_field("builtin")
			fields ?= value.declaration_field_array_field("fields")
			Ok(RecordDeclaration(is_private, name, type_params, is_value, is_builtin, fields))
		"TypeAlias":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			target ?= value.type_expression_field("target")
			Ok(TypeAliasDeclaration(is_private, name, type_params, target))
		"Trait":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			supertraits ?= value.string_array_field("supertraits")
			methods ?= value.trait_method_array_field("methods")
			Ok(TraitDeclaration(is_private, name, type_params, supertraits, methods))
		"Impl":
			is_private ?= value.bool_field("private")
			trait_name ?= value.string_field("trait")
			for_type ?= value.type_expression_field("for")
			methods ?= value.implementation_method_array_field("methods")
			Ok(ImplementationDeclaration(is_private, trait_name, for_type, methods))
		_: Err("unknown declaration JSON tag: " + tag)


pure func declaration_from_json_string(input: String) -> Result[Declaration, String]:
	value ?= input.parse_json()
	value.declaration_from_json()


private pure func string_documents(items: List[String]) -> List[Doc]:
	var documents: List[Doc] = []
	for item in items:
		documents = documents.append(item.text())
	documents


private pure func type_expression_documents(types: List[TypeExpression]) -> List[Doc]:
	var documents: List[Doc] = []
	for type_expression in types:
		documents = documents.append(type_expression.type_document())
	documents


private pure func type_params_document(params: List[String]) -> Doc:
	if params.length() == 0:
		"".text()
	else:
		"["
			.text()
			.cat(params
					.string_documents()
					.comma_sep())
			.cat("]".text())


private pure func return_type_document(return_type: Option[TypeExpression]) -> Doc:
	match return_type:
		Some(type_expression): " -> "
			.text()
			.cat(type_expression.type_document())
		None: "".text()


private pure func where_constraints_document(constraints: List[TypeConstraint]) -> Doc:
	if constraints.length() == 0:
		"".text()
	else:
		" where "
			.text()
			.cat(constraints
					.type_constraint_documents()
					.comma_sep())


private pure func import_symbol_document(symbol: ImportSymbol) -> Doc:
	match symbol.ctors:
		Some(ctors):
			symbol.name
				.text()
				.cat("(".text())
				.cat(softline()
						.cat(ctors
								.string_documents()
								.comma_sep_break())
						.indent())
				.cat(softline())
				.cat(")".text())
				.group()
		None:
			match symbol.alias_name:
				Some(alias_value): symbol.name
					.text()
					.cat(" as ".text())
					.cat(alias_value.text())
				None: symbol.name.text()


private pure func import_symbol_documents(symbols: List[ImportSymbol]) -> List[Doc]:
	var documents: List[Doc] = []
	for symbol in symbols.sort_by(func(item: ImportSymbol): item.name):
		documents = documents.append(symbol.import_symbol_document())
	documents


private pure func import_item_document(item: ImportItem) -> Doc:
	match item.symbols:
		Some(symbols):
			prefix: Doc = match item.alias_name:
				Some(alias_value): item.module_name
					.text()
					.cat(" as ".text())
					.cat(alias_value.text())
					.cat(":".text())
				None: item.module_name
					.text()
					.cat(":".text())
			prefix
				.cat(softline_space()
						.cat(symbols
								.import_symbol_documents()
								.comma_sep_break())
						.indent())
				.group()
		None:
			match item.alias_name:
				Some(alias_value): item.module_name
					.text()
					.cat(" as ".text())
					.cat(alias_value.text())
				None: item.module_name.text()


private pure func is_std_import_item(item: ImportItem) -> Bool:
	item.module_name.starts_with("std/")


private pure func append_sorted_import_items(
	result: List[ImportItem],
	items: List[ImportItem],
) -> List[ImportItem]:
	var sorted: List[ImportItem] = result
	for item in items.sort_by(func(import_item: ImportItem): import_item.module_name):
		sorted = sorted.append(item)
	sorted


private pure func import_symbol_dedup_key(symbol: ImportSymbol) -> String:
	alias_key: String = match symbol.alias_name:
		Some(alias_value): " as " + alias_value
		None: ""
	symbol.name + alias_key


private pure func import_symbols_dedup_key(symbols: List[ImportSymbol]) -> String:
	var keys: List[String] = []
	for symbol in symbols.sort_by(func(item: ImportSymbol): item.name):
		keys = keys.append(symbol.import_symbol_dedup_key())
	keys.join(",")


private pure func import_item_dedup_key(item: ImportItem) -> String:
	value_key: String = match item.symbols:
		Some(symbols): symbols.import_symbols_dedup_key()
		None:
			match item.alias_name:
				Some(alias_value): "as:" + alias_value
				None: "*"
	item.module_name + ":" + value_key


private pure func dedup_import_items(items: List[ImportItem]) -> List[ImportItem]:
	var result: List[ImportItem] = []
	var seen: List[String] = []
	for item in items:
		key: String = item.import_item_dedup_key()
		if not seen.contains(key):
			seen = seen.append(key)
			result = result.append(item)
	result


private pure func sorted_import_items(items: List[ImportItem]) -> List[ImportItem]:
	var std_imports: List[ImportItem] = []
	var project_imports: List[ImportItem] = []
	for item in items.dedup_import_items():
		if item.is_std_import_item():
			std_imports = std_imports.append(item)
		else:
			project_imports = project_imports.append(item)
	var result: List[ImportItem] = []
	result = result.append_sorted_import_items(std_imports)
	result.append_sorted_import_items(project_imports)


private pure func import_item_documents(items: List[ImportItem]) -> List[Doc]:
	var documents: List[Doc] = []
	for item in items.sorted_import_items():
		documents = documents.append(item.import_item_document())
	documents


private pure func import_items_document(items: List[ImportItem]) -> Doc:
	"import:"
		.text()
		.cat(hardline()
				.cat(items
						.import_item_documents()
						.hardlines())
				.indent())


private pure func import_declaration_document(item: ImportItem) -> Doc:
	"import:"
		.text()
		.cat(hardline()
				.cat(item.import_item_document())
				.indent())


private pure func private_document(is_private: Bool) -> Doc:
	if is_private:
		"private ".text()
	else:
		"".text()


private pure func docstring_document(doc: String) -> Doc:
	var result: Doc = "---"
		.text()
		.cat(hardline())
	for line in doc.split("\n"):
		result = result
			.cat(line.text())
			.cat(hardline())
	result
		.cat("---".text())
		.cat(hardline())


private pure func normalize_comment_text(raw: String) -> String:
	if raw.starts_with("--"):
		rest: String = raw
			.substring(2, raw.length() - 2)
			.trim()
		if rest == "":
			"--"
		else:
			"-- " + rest
	else:
		raw


private pure func comment_document(comment: FormatterComment) -> Doc:
	comment.text_value
		.normalize_comment_text()
		.text()


private pure func comments_document(comments: List[FormatterComment]) -> Doc:
	var result: Doc = "".text()
	for comment in comments:
		result = result
			.cat(comment.comment_document())
			.cat(hardline())
	result


private pure func copy_formatter_comments(
	comments: List[FormatterComment],
) -> List[FormatterComment]:
	comments.take(comments.length())


private pure func append_remaining_comments(document: Doc, comments: List[FormatterComment]) -> Doc:
	if comments.length() == 0:
		document
	else:
		document
			.cat(hardline())
			.cat(comments.comments_document())


private pure func trailing_comment_document(comment: Option[FormatterComment]) -> Doc:
	match comment:
		Some(value): value.text_value
			.normalize_comment_text()
			.line_suffix()
		None: "".text()


private pure func take_leading_comments(
	comments: List[FormatterComment],
	before_line: Int,
) -> CommentTake:
	var taken: List[FormatterComment] = []
	var remaining: List[FormatterComment] = []
	var taking: Bool = True
	for comment in comments:
		if taking and comment.line < before_line:
			taken = taken.append(comment)
		else:
			taking = False
			remaining = remaining.append(comment)
	{taken = taken, remaining = remaining}


private pure func take_trailing_comment(
	comments: List[FormatterComment],
	on_line: Int,
) -> TrailingCommentTake:
	match comments:
		[]: {comment = None, remaining = []}
		[first, ...rest]:
			if first.line == on_line and first.trailing:
				{comment = Some(first), remaining = rest}
			else:
				{comment = None, remaining = comments}


private pure func drain_comments_through(
	comments: List[FormatterComment],
	through_line: Int,
) -> CommentTake:
	var taken: List[FormatterComment] = []
	var remaining: List[FormatterComment] = []
	var taking: Bool = True
	for comment in comments:
		if taking and comment.line <= through_line:
			taken = taken.append(comment)
		else:
			taking = False
			remaining = remaining.append(comment)
	{taken = taken, remaining = remaining}


private pure func import_with_comments_dedup_key(item: ImportWithComments) -> String:
	item.item.import_item_dedup_key()


private pure func dedup_imports_with_comments(
	items: List[ImportWithComments],
) -> List[ImportWithComments]:
	var result: List[ImportWithComments] = []
	var seen: List[String] = []
	for item in items:
		key: String = item.import_with_comments_dedup_key()
		if not seen.contains(key):
			seen = seen.append(key)
			result = result.append(item)
	result


private pure func is_std_import_with_comments(item: ImportWithComments) -> Bool:
	item.item.is_std_import_item()


private pure func sorted_imports_with_comments(
	items: List[ImportWithComments],
) -> List[ImportWithComments]:
	var std_imports: List[ImportWithComments] = []
	var project_imports: List[ImportWithComments] = []
	for item in items.dedup_imports_with_comments():
		if item.is_std_import_with_comments():
			std_imports = std_imports.append(item)
		else:
			project_imports = project_imports.append(item)
	var result: List[ImportWithComments] = []
	for item in std_imports.sort_by(
		func(import_item: ImportWithComments): import_item.item.module_name,
	):
		result = result.append(item)
	for item in project_imports.sort_by(
		func(import_item: ImportWithComments): import_item.item.module_name,
	):
		result = result.append(item)
	result


private pure func import_with_comments_document(item: ImportWithComments) -> Doc:
	item.leading
		.comments_document()
		.cat(item.item.import_item_document())
		.cat(item.trailing.trailing_comment_document())


private pure func import_with_comments_documents(items: List[ImportWithComments]) -> List[Doc]:
	var documents: List[Doc] = []
	for item in items:
		documents = documents.append(item.import_with_comments_document())
	documents


private pure func import_block_body_document(items: List[ImportWithComments]) -> Doc:
	var std_imports: List[ImportWithComments] = []
	var project_imports: List[ImportWithComments] = []
	for item in items.sorted_imports_with_comments():
		if item.is_std_import_with_comments():
			std_imports = std_imports.append(item)
		else:
			project_imports = project_imports.append(item)
	std_document: Doc = std_imports
		.import_with_comments_documents()
		.hardlines()
	project_document: Doc = project_imports
		.import_with_comments_documents()
		.hardlines()
	if std_imports.length() == 0:
		project_document
	else if project_imports.length() == 0:
		std_document
	else:
		std_document
			.cat(hardline())
			.cat(project_document)


private pure func import_block_with_comments_document(
	items: List[ImportWithComments],
	suffix: Doc,
) -> Doc:
	if items.length() == 0:
		"".text()
	else:
		"import:"
			.text()
			.cat(hardline()
					.cat(items.import_block_body_document())
					.indent())
			.cat(suffix)


private pure func located_imports_last_line(imports: List[LocatedImport]) -> Int:
	var line: Int = 0
	for import_item in imports:
		if import_item.line > line:
			line = import_item.line
	line


private pure func collect_import_comments(
	imports: List[LocatedImport],
	comments: List[FormatterComment],
) -> ImportCommentCollect:
	var items: List[ImportWithComments] = []
	var remaining_comments: List[FormatterComment] = comments
	for import_item in imports:
		leading: CommentTake = remaining_comments.take_leading_comments(import_item.line)
		trailing: TrailingCommentTake = leading.remaining.take_trailing_comment(import_item.line)
		items = items.append(
			{item = import_item.item, leading = leading.taken, trailing = trailing.comment},
		)
		remaining_comments = trailing.remaining.copy_formatter_comments()
	{items = items, remaining_comments = remaining_comments}


private pure func render_import_block(
	imports: List[LocatedImport],
	comments: List[FormatterComment],
) -> RenderedImportBlock:
	collected: ImportCommentCollect = imports.collect_import_comments(comments)
	drained: CommentTake = collected.remaining_comments.drain_comments_through(
		imports.located_imports_last_line(),
	)
	suffix: Doc = if drained.taken.length() == 0:
		"".text()
	else:
		hardline().cat(drained.taken.comments_document())
	{
		document = collected.items.import_block_with_comments_document(suffix),
		remaining_comments = drained.remaining.copy_formatter_comments(),
	}


private pure func target_document(name: Option[String], pattern: Option[Pattern]) -> Doc:
	match name:
		Some(var_name): var_name.text()
		None:
			match pattern:
				Some(var_pattern): var_pattern.pattern_document()
				None: "_".text()


private pure func variable_declaration_document(
	is_private: Bool,
	name: Option[String],
	pattern: Option[Pattern],
	is_mutable: Bool,
	type_expression: Option[TypeExpression],
	value: Expression,
) -> Doc:
	mutable_document: Doc = if is_mutable:
		"var ".text()
	else:
		"".text()
	type_document_part: Doc = match type_expression:
		Some(type_expr): ": "
			.text()
			.cat(type_expr.type_document())
		None: "".text()
	is_private
		.private_document()
		.cat(mutable_document)
		.cat(target_document(name, pattern))
		.cat(type_document_part)
		.cat(" = ".text())
		.cat(value.expression_document())


private pure func annotation_document(name: String, enabled: Bool, is_private: Bool) -> Doc:
	if enabled:
		sep: Doc = if is_private:
			" ".text()
		else:
			hardline()
		name
			.text()
			.cat(sep)
	else:
		"".text()


private pure func is_foreign_function_body(body: FunctionBody) -> Bool:
	match body:
		ForeignFunctionBody(_, _): True
		_: False


private pure func builtin_body_document(name: Option[String]) -> Doc:
	match name:
		Some(c_name): ("builtin(\"" + c_name.escape_string_value() + "\")").text()
		None: "builtin".text()


private pure func function_body_suffix_document(name: String, body: FunctionBody) -> Doc:
	match body:
		ExpressionFunctionBody(expr):
			":"
				.text()
				.cat(hardline()
						.cat(expr.block_body_document())
						.indent())
		BuiltinFunctionBody(c_name):
			":"
				.text()
				.cat(hardline()
						.cat(c_name.builtin_body_document())
						.indent())
		ForeignFunctionBody(foreign_name, _):
			if foreign_name == name:
				"".text()
			else:
				" = \""
					.text()
					.cat(foreign_name
							.escape_string_value()
							.text())
					.cat("\"".text())
		NoFunctionBody: ":".text()


private pure func function_declaration_document(
	is_private: Bool,
	name: String,
	is_pure: Bool,
	is_tailrec: Bool,
	is_debug_only: Bool,
	no_copy: Bool,
	type_params: List[String],
	params: List[FunctionParameter],
	return_type: Option[TypeExpression],
	where_constraints: List[TypeConstraint],
	body: FunctionBody,
) -> Doc:
	pure_document: Doc = if is_pure:
		"pure ".text()
	else:
		"".text()
	foreign_body: Bool = body.is_foreign_function_body()
	foreign_document: Doc = if foreign_body:
		"foreign ".text()
	else:
		"".text()
	head: Doc = is_private
		.private_document()
		.cat(annotation_document("@debug_only", is_debug_only, is_private))
		.cat(annotation_document("@tailrec", is_tailrec, is_private))
		.cat(annotation_document("@no_copy", no_copy and foreign_body, is_private))
		.cat(foreign_document)
		.cat(pure_document)
		.cat("func ".text())
		.cat(name.text())
		.cat(type_params.type_params_document())
		.cat(params.function_parameters_document())
		.cat(return_type.return_type_document())
		.cat(where_constraints.where_constraints_document())
	head.cat(function_body_suffix_document(name, body))


private pure func type_variant_document(variant: TypeVariant) -> Doc:
	if variant.fields.length() == 0:
		variant.name.text()
	else:
		variant.name
			.text()
			.cat("(".text())
			.cat(variant.fields
					.type_expression_documents()
					.comma_sep())
			.cat(")".text())


private pure func type_variant_documents(variants: List[TypeVariant]) -> List[Doc]:
	var documents: List[Doc] = []
	for variant in variants:
		documents = documents.append(variant.type_variant_document())
	documents


private pure func type_declaration_document(
	is_private: Bool,
	name: String,
	type_params: List[String],
	is_enum: Bool,
	is_builtin: Bool,
	variants: List[TypeVariant],
) -> Doc:
	if is_builtin:
		is_private
			.private_document()
			.cat("type ".text())
			.cat(name.text())
			.cat(type_params.type_params_document())
			.cat(" = builtin".text())
	else:
		keyword: String = if is_enum:
			"enum "
		else:
			"union "
		is_private
			.private_document()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_document())
			.cat(":".text())
			.cat(hardline()
					.cat(variants
							.type_variant_documents()
							.hardlines())
					.indent())


private pure func declaration_field_document(field_value: DeclarationField) -> Doc:
	field_value.name
		.text()
		.cat(": ".text())
		.cat(field_value.field_type.type_document())


private pure func declaration_field_documents(fields: List[DeclarationField]) -> List[Doc]:
	var documents: List[Doc] = []
	for field_value in fields:
		documents = documents.append(field_value.declaration_field_document())
	documents


private pure func record_declaration_document(
	is_private: Bool,
	name: String,
	type_params: List[String],
	is_value: Bool,
	is_builtin: Bool,
	fields: List[DeclarationField],
) -> Doc:
	keyword: String = if is_value:
		"struct "
	else:
		"record "
	if is_builtin:
		is_private
			.private_document()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_document())
			.cat(" {builtin}".text())
	else:
		is_private
			.private_document()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_document())
			.cat(" {".text())
			.cat(softline()
					.cat(fields
							.declaration_field_documents()
							.comma_sep_break())
					.indent()
					.cat(softline())
					.group())
			.cat("}".text())


private pure func type_alias_declaration_document(
	is_private: Bool,
	name: String,
	type_params: List[String],
	target: TypeExpression,
) -> Doc:
	is_private
		.private_document()
		.cat("type alias ".text())
		.cat(name.text())
		.cat(type_params.type_params_document())
		.cat(" = ".text())
		.cat(target.type_document())


private pure func supertraits_document(supertraits: List[String]) -> Doc:
	if supertraits.length() == 0:
		"".text()
	else:
		": "
			.text()
			.cat(" + "
					.text()
					.intersperse(supertraits.string_documents()))


private pure func trait_method_document(method: TraitMethod) -> Doc:
	pure_document: Doc = if method.is_pure:
		"pure ".text()
	else:
		"".text()
	head: Doc = pure_document
		.cat("func ".text())
		.cat(method.name.text())
		.cat(method.params.function_parameters_document())
		.cat(method.return_type.return_type_document())
	match method.body:
		None: head
		Some(body):
			if body.is_block_expression():
				head
					.cat(":".text())
					.cat(hardline()
							.cat(body.block_body_document())
							.indent())
			else:
				head
					.cat(": ".text())
					.cat(body.expression_document())


private pure func trait_method_documents(methods: List[TraitMethod]) -> List[Doc]:
	var documents: List[Doc] = []
	for method in methods:
		documents = documents.append(method.trait_method_document())
	documents


private pure func trait_declaration_document(
	is_private: Bool,
	name: String,
	type_params: List[String],
	supertraits: List[String],
	methods: List[TraitMethod],
) -> Doc:
	needs_colon: Bool = methods.length() != 0 or supertraits.length() == 0
	colon_document: Doc = if needs_colon:
		":".text()
	else:
		"".text()
	header: Doc = is_private
		.private_document()
		.cat("trait ".text())
		.cat(name.text())
		.cat(type_params.type_params_document())
		.cat(supertraits.supertraits_document())
		.cat(colon_document)
	if methods.length() == 0:
		header
	else:
		header.cat(hardline()
				.cat(methods
						.trait_method_documents()
						.hardlines())
				.indent())


private pure func implementation_method_document(method: ImplementationMethod) -> Doc:
	function_declaration_document(
		False,
		method.name,
		method.is_pure,
		method.is_tailrec,
		method.is_debug_only,
		method.no_copy,
		method.type_params,
		method.params,
		method.return_type,
		method.where_constraints,
		method.body,
	)


private pure func implementation_method_documents(methods: List[ImplementationMethod]) -> List[Doc]:
	var documents: List[Doc] = []
	for method in methods:
		documents = documents.append(method.implementation_method_document())
	documents


private pure func implementation_declaration_document(
	is_private: Bool,
	trait_name: String,
	for_type: TypeExpression,
	methods: List[ImplementationMethod],
) -> Doc:
	is_private
		.private_document()
		.cat("implements ".text())
		.cat(trait_name.text())
		.cat(" for ".text())
		.cat(for_type.type_document())
		.cat(":".text())
		.cat(hardline()
				.cat(blank_lines(1, methods.implementation_method_documents()))
				.indent())


pure func declaration_document(decl: Declaration) -> Doc:
	match decl:
		DocumentedDeclaration(doc, inner): doc
			.docstring_document()
			.cat(inner.declaration_document())
		ImportDeclaration(item): item.import_declaration_document()
		VariableDeclaration(is_private, name, pattern, is_mutable, type_expression, value): variable_declaration_document(
			is_private,
			name,
			pattern,
			is_mutable,
			type_expression,
			value,
		)
		FunctionDeclaration(is_private, name, is_pure, is_tailrec, is_debug_only, no_copy, type_params, params, return_type, where_constraints, body): function_declaration_document(
			is_private,
			name,
			is_pure,
			is_tailrec,
			is_debug_only,
			no_copy,
			type_params,
			params,
			return_type,
			where_constraints,
			body,
		)
		TypeDeclaration(is_private, name, type_params, is_enum, is_builtin, variants): type_declaration_document(
			is_private,
			name,
			type_params,
			is_enum,
			is_builtin,
			variants,
		)
		RecordDeclaration(is_private, name, type_params, is_value, is_builtin, fields): record_declaration_document(
			is_private,
			name,
			type_params,
			is_value,
			is_builtin,
			fields,
		)
		TypeAliasDeclaration(is_private, name, type_params, target): type_alias_declaration_document(
			is_private,
			name,
			type_params,
			target,
		)
		TraitDeclaration(is_private, name, type_params, supertraits, methods): trait_declaration_document(
			is_private,
			name,
			type_params,
			supertraits,
			methods,
		)
		ImplementationDeclaration(is_private, trait_name, for_type, methods): implementation_declaration_document(
			is_private,
			trait_name,
			for_type,
			methods,
		)


private pure func declaration_function_name(decl: Declaration) -> Option[String]:
	match decl:
		DocumentedDeclaration(_, inner): inner.declaration_function_name()
		FunctionDeclaration(_, name, _, _, _, _, _, _, _, _, _): Some(name)
		_: None


private pure func is_small_declaration(decl: Declaration) -> Bool:
	match decl:
		DocumentedDeclaration(_, inner): inner.is_small_declaration()
		VariableDeclaration(_, _, _, _, _, _): True
		TypeAliasDeclaration(_, _, _, _): True
		_: False


private pure func foreign_block_function_document(decl: Declaration) -> Doc:
	match decl:
		DocumentedDeclaration(doc, inner): doc
			.docstring_document()
			.cat(inner.foreign_block_function_document())
		FunctionDeclaration(_, name, is_pure, _, is_debug_only, no_copy, type_params, params, return_type, where_constraints, body):
			debug_document: Doc = if is_debug_only:
				"@debug_only ".text()
			else:
				"".text()
			no_copy_document: Doc = if no_copy:
				"@no_copy ".text()
			else:
				"".text()
			pure_document: Doc = if is_pure:
				"pure ".text()
			else:
				"".text()
			debug_document
				.cat(no_copy_document)
				.cat(pure_document)
				.cat("func ".text())
				.cat(name.text())
				.cat(type_params.type_params_document())
				.cat(params.function_parameters_document())
				.cat(return_type.return_type_document())
				.cat(where_constraints.where_constraints_document())
				.cat(function_body_suffix_document(name, body))
		_: decl.declaration_document()


private pure func foreign_link_flag_key(flag: ForeignLinkFlag) -> String:
	match flag.platform:
		None: "link"
		Some("linux"): "link_linux"
		Some("macos"): "link_macos"
		Some(platform): "link_" + platform


private pure func foreign_link_flag_arg(flag: ForeignLinkFlag) -> String:
	flag.foreign_link_flag_key() + ": \"" + flag.value.escape_string_value() + "\""


private pure func foreign_block_header_document(metadata: ForeignMetadata) -> Doc:
	var args: List[String] = []
	for include in metadata.includes:
		args = args.append("include: \"" + include.escape_string_value() + "\"")
	for flag in metadata.link_flags:
		args = args.append(flag.foreign_link_flag_arg())
	if args.length() == 0:
		"foreign:".text()
	else:
		("foreign(" + args.join(", ") + "):").text()


private pure func option_string_equal(left: Option[String], right: Option[String]) -> Bool:
	match left:
		None:
			match right:
				None: True
				Some(_): False
		Some(left_value):
			match right:
				Some(right_value): left_value == right_value
				None: False


private pure func string_lists_equal(left: List[String], right: List[String]) -> Bool:
	if left.length() != right.length():
		False
	else:
		var same: Bool = True
		var index: Int = 0
		for left_value in left:
			match right.get(index):
				Some(right_value):
					if left_value != right_value:
						same = False
				None: same = False
			index += 1
		same


private pure func foreign_link_flag_equal(left: ForeignLinkFlag, right: ForeignLinkFlag) -> Bool:
	left.platform.option_string_equal(right.platform) and left.value == right.value


private pure func foreign_link_flags_equal(
	left: List[ForeignLinkFlag],
	right: List[ForeignLinkFlag],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var same: Bool = True
		var index: Int = 0
		for left_value in left:
			match right.get(index):
				Some(right_value):
					if not left_value.foreign_link_flag_equal(right_value):
						same = False
				None: same = False
			index += 1
		same


private pure func foreign_metadata_equal(left: ForeignMetadata, right: ForeignMetadata) -> Bool:
	left.includes.string_lists_equal(
		right.includes,
	) and left.link_flags.foreign_link_flags_equal(right.link_flags)


private pure func declaration_foreign_metadata(decl: Declaration) -> Option[ForeignMetadata]:
	match decl:
		DocumentedDeclaration(_, inner): inner.declaration_foreign_metadata()
		FunctionDeclaration(is_private, _, _, _, _, _, _, _, _, _, body):
			if is_private:
				None
			else:
				match body:
					ForeignFunctionBody(_, metadata): Some(metadata)
					_: None
		_: None


private pure func located_declaration_foreign_metadata(
	located: LocatedDeclaration,
) -> Option[ForeignMetadata]:
	located.declaration.declaration_foreign_metadata()


private pure func located_decl_has_same_foreign_metadata(
	located: LocatedDeclaration,
	metadata: ForeignMetadata,
) -> Bool:
	match located.located_declaration_foreign_metadata():
		Some(other): other.foreign_metadata_equal(metadata)
		None: False


private pure func foreign_block_metadata(declarations: List[LocatedDeclaration]) -> ForeignMetadata:
	match declarations.get(0):
		Some(first):
			match first.located_declaration_foreign_metadata():
				Some(metadata): metadata
				None: {includes = [], link_flags = []}
		None: {includes = [], link_flags = []}


private pure func render_foreign_block_function(
	located: LocatedDeclaration,
	comments: List[FormatterComment],
	skip_leading: Bool,
) -> RenderedDocument:
	leading: CommentTake = if skip_leading:
		{taken = [], remaining = comments}
	else:
		comments.take_leading_comments(located.line)
	trailing: TrailingCommentTake = leading.remaining.take_trailing_comment(located.line)
	{document = leading.taken
			.comments_document()
			.cat(located.declaration.foreign_block_function_document())
			.cat(
				trailing.comment.trailing_comment_document(),
			), remaining_comments = trailing.remaining.copy_formatter_comments()}


private pure func render_foreign_block(
	declarations: List[LocatedDeclaration],
	comments: List[FormatterComment],
) -> RenderedDocument:
	var body_document: Doc = "".text()
	var has_body_document: Bool = False
	var remaining_comments: List[FormatterComment] = comments
	var is_first: Bool = True
	for located in declarations:
		rendered: RenderedDocument = located.render_foreign_block_function(
			remaining_comments,
			is_first,
		)
		if has_body_document:
			body_document = body_document
				.cat(hardline())
				.cat(rendered.document)
		else:
			body_document = rendered.document
			has_body_document = True
		remaining_comments = rendered.remaining_comments.copy_formatter_comments()
		is_first = False
	{document = declarations
			.foreign_block_metadata()
			.foreign_block_header_document()
			.cat(hardline()
					.cat(body_document)
					.indent()), remaining_comments = remaining_comments}


private pure func flush_foreign_body_item(
	items: List[ProgramBodyItem],
	foreign_group: List[LocatedDeclaration],
) -> List[ProgramBodyItem]:
	if foreign_group.length() == 0:
		items
	else:
		items.append(BodyForeignBlock(foreign_group))


private pure func flush_import_body_item(
	items: List[ProgramBodyItem],
	import_group: List[LocatedImport],
) -> List[ProgramBodyItem]:
	if import_group.length() == 0:
		items
	else:
		items.append(BodyImportBlock(import_group))


private pure func located_declaration_import(located: LocatedDeclaration) -> Option[LocatedImport]:
	match located.declaration:
		ImportDeclaration(item): Some({line = located.line, column = located.column, item = item})
		_: None


private pure func program_body_items(
	declarations: List[LocatedDeclaration],
) -> List[ProgramBodyItem]:
	var items: List[ProgramBodyItem] = []
	var import_group: List[LocatedImport] = []
	var foreign_group: List[LocatedDeclaration] = []
	var foreign_metadata: Option[ForeignMetadata] = None
	for located in declarations:
		match located.located_declaration_import():
			Some(import_item):
				items = items.flush_foreign_body_item(foreign_group)
				foreign_group = []
				foreign_metadata = None
				import_group = import_group.append(import_item)
			None:
				items = items.flush_import_body_item(import_group)
				import_group = []
				match located.located_declaration_foreign_metadata():
					Some(metadata):
						match foreign_metadata:
							Some(current):
								if current.foreign_metadata_equal(metadata):
									foreign_group = foreign_group.append(located)
								else:
									items = items.flush_foreign_body_item(foreign_group)
									foreign_group = [located]
									foreign_metadata = Some(metadata)
							None:
								foreign_group = [located]
								foreign_metadata = Some(metadata)
					None:
						items = items.flush_foreign_body_item(foreign_group)
						foreign_group = []
						foreign_metadata = None
						items = items.append(BodyDeclaration(located))
	items
		.flush_import_body_item(import_group)
		.flush_foreign_body_item(foreign_group)


private pure func program_body_item_func_name(item: ProgramBodyItem) -> Option[String]:
	match item:
		BodyDeclaration(located): located.declaration.declaration_function_name()
		BodyImportBlock(_): None
		BodyForeignBlock(_): None


private pure func is_small_program_body_item(item: ProgramBodyItem) -> Bool:
	match item:
		BodyDeclaration(located): located.declaration.is_small_declaration()
		BodyImportBlock(_): False
		BodyForeignBlock(_): False


private pure func is_same_function_overload_item(
	left: ProgramBodyItem,
	right: ProgramBodyItem,
) -> Bool:
	match left.program_body_item_func_name():
		Some(left_name):
			match right.program_body_item_func_name():
				Some(right_name): left_name == right_name
				None: False
		None: False


private pure func program_body_item_separator(left: ProgramBodyItem, right: ProgramBodyItem) -> Doc:
	if left.is_same_function_overload_item(right):
		hardline()
	else if left.is_small_program_body_item() and right.is_small_program_body_item():
		hardline().cat(hardline())
	else:
		hardline()
			.cat(hardline())
			.cat(hardline())


private pure func render_program_body_item(
	item: ProgramBodyItem,
	comments: List[FormatterComment],
) -> RenderedDocument:
	match item:
		BodyDeclaration(located):
			leading: CommentTake = comments.take_leading_comments(located.line)
			trailing: TrailingCommentTake = leading.remaining.take_trailing_comment(located.line)
			drained: CommentTake = trailing.remaining.drain_comments_through(located.end_line)
			{document = leading.taken
					.comments_document()
					.cat(located.declaration.declaration_document())
					.cat(
						trailing.comment.trailing_comment_document(),
					), remaining_comments = drained.remaining.copy_formatter_comments()}
		BodyImportBlock(imports):
			rendered: RenderedImportBlock = imports.render_import_block(comments)
			{
				document = rendered.document,
				remaining_comments = rendered.remaining_comments.copy_formatter_comments(),
			}
		BodyForeignBlock(declarations):
			first_line: Int = match declarations.get(0):
				Some(first): first.line
				None: 0
			leading: CommentTake = comments.take_leading_comments(first_line)
			rendered: RenderedDocument = declarations.render_foreign_block(
				leading.remaining.copy_formatter_comments(),
			)
			{document = leading.taken
					.comments_document()
					.cat(
						rendered.document,
					), remaining_comments = rendered.remaining_comments.copy_formatter_comments()}


private pure func split_leading_imports(declarations: List[LocatedDeclaration]) -> ProgramParts:
	var imports: List[LocatedImport] = []
	var body: List[LocatedDeclaration] = []
	var in_body: Bool = False
	for located in declarations:
		if in_body:
			body = body.append(located)
		else:
			match located.declaration:
				ImportDeclaration(item): imports = imports.append(
					{line = located.line, column = located.column, item = item},
				)
				_:
					in_body = True
					body = body.append(located)
	{imports = imports, body = body}


private pure func program_body_document(
	declarations: List[LocatedDeclaration],
	comments: List[FormatterComment],
) -> Doc:
	items: List[ProgramBodyItem] = declarations.program_body_items()
	var result: Doc = "".text()
	var previous: Option[ProgramBodyItem] = None
	var remaining_comments: List[FormatterComment] = comments
	for item in items:
		rendered: RenderedDocument = item.render_program_body_item(remaining_comments)
		match previous:
			None: result = rendered.document
			Some(prev): result = result
				.cat(prev.program_body_item_separator(item))
				.cat(rendered.document)
		remaining_comments = rendered.remaining_comments.copy_formatter_comments()
		previous = Some(item)
	result.append_remaining_comments(remaining_comments)


private pure func program_first_decl_line(declarations: List[LocatedDeclaration]) -> Int:
	match declarations.get(0):
		Some(first): first.line
		None: 2147483647


pure func program_document(program: Program) -> Doc:
	parts: ProgramParts = program.declarations.split_leading_imports()
	if parts.imports.length() == 0:
		parts.body.program_body_document(program.comments)
	else:
		header_comments: CommentTake = program.comments.take_leading_comments(
			program.declarations.program_first_decl_line(),
		)
		import_render: RenderedImportBlock = parts.imports.render_import_block(
			header_comments.remaining.copy_formatter_comments(),
		)
		import_document: Doc = header_comments.taken
			.comments_document()
			.cat(import_render.document)
		body_document: Doc = parts.body.program_body_document(
			import_render.remaining_comments.copy_formatter_comments(),
		)
		if parts.body.length() == 0:
			import_document.append_remaining_comments(
				import_render.remaining_comments.copy_formatter_comments(),
			)
		else:
			import_document
				.cat(hardline())
				.cat(hardline())
				.cat(hardline())
				.cat(body_document)


private pure func located_declaration_from_json(
	value: JsonValue,
) -> Result[LocatedDeclaration, String]:
	match value.get_field("decl"):
		Some(decl_value):
			line ?= value.int_field("line")
			column ?= value.int_field("column")
			end_line ?= value.optional_int_field("end_line")
			declaration ?= decl_value.declaration_from_json()
			resolved_end: Int = match end_line:
				Some(value): value
				None: line
			Ok({line = line, column = column, end_line = resolved_end, declaration = declaration})
		None:
			declaration ?= value.declaration_from_json()
			Ok({line = 0, column = 0, end_line = 0, declaration = declaration})


pure func program_from_json(value: JsonValue) -> Result[Program, String]:
	items ?= value.array_field("program")
	comments ?= value.formatter_comments_field("comments")
	var result: List[LocatedDeclaration] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.located_declaration_from_json():
					Ok(decl): result = result.append(decl)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok({declarations = result, comments = comments})


pure func program_from_json_string(input: String) -> Result[Program, String]:
	value ?= input.parse_json()
	value.program_from_json()


pure func render_declaration_json(width: Int, input: String) -> Result[String, String]:
	decl ?= input.declaration_from_json_string()
	Ok(width.layout(decl.declaration_document()))


pure func render_program_json(width: Int, input: String) -> Result[String, String]:
	program ?= input.program_from_json_string()
	Ok(width.layout(program.program_document()))
