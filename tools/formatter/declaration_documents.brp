import:
	./document_layout:
		Doc,
		blank_lines,
		cat,
		comma_sep,
		comma_sep_break,
		group,
		hardline,
		hardlines,
		indent,
		intersperse,
		layout,
		line_suffix,
		softline,
		softline_space,
		text,
	./expression_documents:
		Expression,
		FunctionParameter,
		Pattern,
		block_body_document,
		escape_string_value,
		expression_document,
		expression_from_json,
		function_parameter_from_json,
		function_parameters_document,
		is_block_expression,
		pattern_document,
		pattern_from_json,
	./json_fields: array_field, bool_field, field, int_field, string_field
	./type_documents:
		TypeConstraint,
		TypeExpression,
		type_constraint_array_field_or_empty,
		type_constraint_documents,
		type_document,
		type_expression_from_json,
	json: JsonValue, as_string, get_field, parse_json


record ImportSymbol {name: String, alias_name: Option[String], ctors: Option[List[String]]}


record ImportItem {
	module_name: String,
	alias_name: Option[String],
	symbols: Option[List[ImportSymbol]],
}


record TypeVariant {name: String, fields: List[TypeExpression]}


record DeclarationField {name: String, field_type: TypeExpression}


record TraitMethod {
	name: String,
	is_pure: Bool,
	params: List[FunctionParameter],
	return_type: Option[TypeExpression],
	body: Option[Expression],
}


record ForeignLinkFlag {platform: Option[String], value: String}


record ForeignMetadata {includes: List[String], link_flags: List[ForeignLinkFlag]}


union FunctionBody:
	ExpressionFunctionBody(Expression)
	BuiltinFunctionBody(Option[String])
	ForeignFunctionBody(String, ForeignMetadata)
	NoFunctionBody


record ImplementationMethod {
	name: String,
	is_pure: Bool,
	is_tailrec: Bool,
	is_debug_only: Bool,
	no_copy: Bool,
	type_params: List[String],
	params: List[FunctionParameter],
	return_type: Option[TypeExpression],
	where_constraints: List[TypeConstraint],
	body: FunctionBody,
}


union Declaration:
	DocumentedDeclaration(String, Declaration)
	ImportDeclaration(ImportItem)
	VariableDeclaration(Bool, Option[String], Option[Pattern], Bool, Option[TypeExpression], Expression)
	FunctionDeclaration(Bool, String, Bool, Bool, Bool, Bool, List[String], List[FunctionParameter], Option[TypeExpression], List[TypeConstraint], FunctionBody)
	TypeDeclaration(Bool, String, List[String], Bool, Bool, List[TypeVariant])
	RecordDeclaration(Bool, String, List[String], Bool, Bool, List[DeclarationField])
	TypeAliasDeclaration(Bool, String, List[String], TypeExpression)
	TraitDeclaration(Bool, String, List[String], List[String], List[TraitMethod])
	ImplementationDeclaration(Bool, String, TypeExpression, List[ImplementationMethod])


record FormatterComment {text_value: String, line: Int, column: Int, trailing: Bool}


record LocatedDeclaration {line: Int, column: Int, end_line: Int, declaration: Declaration}


record Program {declarations: List[LocatedDeclaration], comments: List[FormatterComment]}


record LocatedImport {line: Int, column: Int, item: ImportItem}


union ProgramBodyItem:
	BodyDeclaration(LocatedDeclaration)
	BodyImportBlock(List[LocatedImport])
	BodyForeignBlock(List[LocatedDeclaration])


record ProgramParts {imports: List[LocatedImport], body: List[LocatedDeclaration]}


record ImportWithComments {
	item: ImportItem,
	leading: List[FormatterComment],
	trailing: Option[FormatterComment],
}


record ImportCommentCollect {
	items: List[ImportWithComments],
	remaining_comments: List[FormatterComment],
}


record RenderedImportBlock {document: Doc, remaining_comments: List[FormatterComment]}


record CommentTake {taken: List[FormatterComment], remaining: List[FormatterComment]}


record TrailingCommentTake {comment: Option[FormatterComment], remaining: List[FormatterComment]}


record RenderedDocument {document: Doc, remaining_comments: List[FormatterComment]}


private pure func optional_string_field(
	value: JsonValue,
	key: String,
) -> Result[Option[String], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			match child.as_string():
				Some(s): Ok(Some(s))
				None: Err("expected formatter JSON field '" + key + "' to be a string")


private pure func string_array_field(value: JsonValue, key: String) -> Result[List[String], String]:
	items ?= value.array_field(key)
	var result: List[String] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.as_string():
					Some(s): result = result.append(s)
					None: error = Some(
						"expected formatter JSON field '" + key + "' to be an array of strings",
					)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func optional_string_array_field(
	value: JsonValue,
	key: String,
) -> Result[Option[List[String]], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(_):
			items ?= value.string_array_field(key)
			Ok(Some(items))


private pure func optional_int_field(value: JsonValue, key: String) -> Result[Option[Int], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(_):
			int_value ?= value.int_field(key)
			Ok(Some(int_value))


private pure func type_expression_field(
	value: JsonValue,
	key: String,
) -> Result[TypeExpression, String]:
	child ?= value.field(key)
	child.type_expression_from_json()


private pure func type_expression_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TypeExpression], String]:
	items ?= value.array_field(key)
	var result: List[TypeExpression] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.type_expression_from_json():
					Ok(type_expression): result = result.append(type_expression)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func optional_type_expression_field(
	value: JsonValue,
	key: String,
) -> Result[Option[TypeExpression], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			type_expression ?= child.type_expression_from_json()
			Ok(Some(type_expression))


private pure func optional_expression_field(
	value: JsonValue,
	key: String,
) -> Result[Option[Expression], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			expr_value ?= child.expression_from_json()
			Ok(Some(expr_value))


private pure func optional_pattern_field(
	value: JsonValue,
	key: String,
) -> Result[Option[Pattern], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			pattern ?= child.pattern_from_json()
