import:
	./document_layout: Doc, comma_sep, layout, text
	./json_fields: bool_field, field, int_field, parsed_array_field, string_field
	json: JsonValue, parse_json


union TypeDimensionOperator:
	TypeDimensionAdd
	TypeDimensionSub
	TypeDimensionMul
	TypeDimensionDiv


union TypeExpression:
	NamedType(String, List[TypeExpression])
	ArrayType(TypeExpression, List[TypeExpression])
	FuncType(Bool, List[TypeExpression], TypeExpression)
	VarType(String)
	BoundVarType(String)
	ConstIntType(Int)
	TupleType(List[TypeExpression])
	SelfType
	VarDimsType(String)
	RangeType(TypeExpression)
	DimensionOperationType(TypeDimensionOperator, TypeExpression, TypeExpression)
	MetaType(Int)


record TypeConstraint {
	left: TypeExpression,
	right: TypeExpression
}


private pure func type_expression_list_contains_function(types: List[TypeExpression]) -> Bool:
	var contains: Bool = False

	for type_expression in types:
		if type_expression.type_expression_contains_function():
			contains = True
			break

	contains


pure func type_expression_contains_function(type_expression: TypeExpression) -> Bool:
	match type_expression:
		FuncType(_, _, _): True
		NamedType(_, args): args.type_expression_list_contains_function()
		ArrayType(elem, dims): (
			elem.type_expression_contains_function()
			or dims.type_expression_list_contains_function()
		)
		TupleType(elems): elems.type_expression_list_contains_function()
		RangeType(inner): inner.type_expression_contains_function()
		DimensionOperationType(_, left, right): (
			left.type_expression_contains_function()
			or right.type_expression_contains_function()
		)
		_: False


private pure func dimension_operator_from_json(
	value: String,
) -> Result[TypeDimensionOperator, String]:
	match value:
		"Add": Ok(TypeDimensionAdd)
		"Sub": Ok(TypeDimensionSub)
		"Mul": Ok(TypeDimensionMul)
		"Div": Ok(TypeDimensionDiv)
		_: Err("unknown type dimension operator: " + value)


private pure func is_additive_dimension_expression(type_expression: TypeExpression) -> Bool:
	match type_expression:
		DimensionOperationType(TypeDimensionAdd, _, _): True
		DimensionOperationType(TypeDimensionSub, _, _): True
		_: False


private pure func type_expression_field(
	value: JsonValue,
	key: String,
) -> Result[TypeExpression, String]:
	child ?= value.field(key)
	child.type_expression_from_json()


private pure func type_expression_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TypeExpression], String]:
	value.parsed_array_field(key, type_expression_from_json)


pure func type_expression_from_json(value: JsonValue) -> Result[TypeExpression, String]:
	tag ?= value.string_field("tag")

	match tag:
		"Named":
			name ?= value.string_field("name")
			args ?= value.type_expression_array_field("args")
			Ok(NamedType(name, args))
		"Array":
			elem ?= value.type_expression_field("elem")
			dims ?= value.type_expression_array_field("dims")
			Ok(ArrayType(elem, dims))
		"Func":
			is_pure ?= value.bool_field("pure")
			params ?= value.type_expression_array_field("params")
			return_ty ?= value.type_expression_field("return")
			Ok(FuncType(is_pure, params, return_ty))
		"Var":
			name ?= value.string_field("name")
			Ok(VarType(name))
		"BoundVar":
			source ?= value.string_field("source")
			Ok(BoundVarType(source))
		"ConstInt":
			value_int ?= value.int_field("value")
			Ok(ConstIntType(value_int))
		"Tuple":
			elems ?= value.type_expression_array_field("elems")
			Ok(TupleType(elems))
		"Self": Ok(SelfType)
		"VarDims":
			name ?= value.string_field("name")
			Ok(VarDimsType(name))
		"Range":
			inner ?= value.type_expression_field("inner")
			Ok(RangeType(inner))
		"DimOp":
			raw_op ?= value.string_field("op")
			op ?= raw_op.dimension_operator_from_json()
			left ?= value.type_expression_field("left")
			right ?= value.type_expression_field("right")
			Ok(DimensionOperationType(op, left, right))
		"Meta":
			id ?= value.int_field("id")
			Ok(MetaType(id))
		_: Err("unknown type expression JSON tag: " + tag)


pure func type_expression_from_json_string(input: String) -> Result[TypeExpression, String]:
	value ?= input.parse_json()
	value.type_expression_from_json()


pure func type_constraint_from_json(value: JsonValue) -> Result[TypeConstraint, String]:
	left ?= value.type_expression_field("left")
	right ?= value.type_expression_field("right")
	Ok({
		left = left,
		right = right,
	})


pure func type_constraint_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TypeConstraint], String]:
	value.parsed_array_field(key, type_constraint_from_json)


pure func type_constraint_array_field_or_empty(
	value: JsonValue,
	key: String,
) -> Result[List[TypeConstraint], String]:
	match value.get_field(key):
		None: Ok([])
		Some(_): value.type_constraint_array_field(key)


private pure func type_document_list(types: List[TypeExpression]) -> List[Doc]:
	var documents: List[Doc] = []

	for type_expression in types:
		documents = documents.append(type_expression.type_document())

	documents


private pure func array_element_type_document(type_expression: TypeExpression) -> Doc:
	match type_expression:
		FuncType(_, _, _): type_expression
			.type_document()
			.parens()
		_: type_expression.type_document()


private pure func dimension_operand_document(type_expression: TypeExpression) -> Doc:
	if type_expression.is_additive_dimension_expression():
		type_expression
			.type_document()
			.parens()
	else:
		type_expression.type_document()


pure func type_document(type_expression: TypeExpression) -> Doc:
	match type_expression:
		NamedType(name, args):
			if args.length() == 0:
				name.text()
			else:
				name
					.text()
					.cat("[".text())
					.cat(
						args
							.type_document_list()
							.comma_sep(),
					)
					.cat("]".text())
		ArrayType(elem, dims):
			elem
				.array_element_type_document()
				.cat("[".text())
				.cat(
					dims
						.type_document_list()
						.comma_sep(),
				)
				.cat("]".text())
		FuncType(is_pure, params, return_ty):
			prefix: Doc = if is_pure:
				"pure ".text()
			else:
				"".text()

			prefix
				.cat("(".text())
				.cat(
					params
						.type_document_list()
						.comma_sep(),
				)
				.cat(") -> ".text())
				.cat(return_ty.type_document())
		VarType(name): name.text()
		BoundVarType(source): source.text()
		ConstIntType(value): ("#" + value.to_string()).text()
		TupleType(elems):
			"("
				.text()
				.cat(
					elems
						.type_document_list()
						.comma_sep(),
				)
				.cat(")".text())
		SelfType: "Self".text()
		VarDimsType(name): (name + "...").text()
		RangeType(inner): ".."
			.text()
			.cat(inner.type_document())
		DimensionOperationType(op, left, right):
			match op:
				TypeDimensionAdd: left
					.type_document()
					.cat(" + ".text())
					.cat(right.type_document())
				TypeDimensionSub: left
					.type_document()
					.cat(" - ".text())
					.cat(right.type_document())
				TypeDimensionMul: left
					.dimension_operand_document()
					.cat(" * ".text())
					.cat(right.dimension_operand_document())
				TypeDimensionDiv: left
					.dimension_operand_document()
					.cat(" / ".text())
					.cat(right.dimension_operand_document())
		MetaType(id): ("?m" + id.to_string()).text()


pure func type_constraint_document(constraint: TypeConstraint) -> Doc:
	constraint.left
		.type_document()
		.cat(" == ".text())
		.cat(constraint.right.type_document())


pure func type_constraint_documents(constraints: List[TypeConstraint]) -> List[Doc]:
	var documents: List[Doc] = []

	for constraint in constraints:
		documents = documents.append(constraint.type_constraint_document())

	documents


pure func render_type_json(width: Int, input: String) -> Result[String, String]:
	type_expression ?= input.type_expression_from_json_string()
	Ok(width.layout(type_expression.type_document()))
