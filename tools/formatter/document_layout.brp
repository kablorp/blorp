-- Formatter document IR and layout engine.
-- Blorp owns the formatter document algebra and layout phase; OCaml only
-- projects parsed source into formatter JSON.
union Doc:
	Nil
	Text(String)
	Hardline
	Softline
	SoftlineSpace
	Indent(Int, Doc)
	Group(Doc)
	Concat(Doc, Doc)
	IfBreak(Doc, Doc)
	LineSuffix(String)


union LayoutMode:
	FlatMode
	BreakMode


record Command {
	indent: Int,
	mode: LayoutMode,
	document: Doc
}


record RenderState {
	output: String,
	column: Int,
	suffixes: List[String]
}


LINE_WIDTH: Int = 100


pure func command(indent: Int, mode: LayoutMode, document: Doc) -> Command:
	{
		indent = indent,
		mode = mode,
		document = document
	}


pure func render_state(output: String, column: Int, suffixes: List[String]) -> RenderState:
	{
		output = output,
		column = column,
		suffixes = suffixes
	}


pure func text(source: String) -> Doc:
	if source == "":
		Nil
	else:
		Text(source)


pure func nest(width: Int, document: Doc) -> Doc:
	Indent(width, document)


pure func if_break(broken_document: Doc, flat_document: Doc) -> Doc:
	IfBreak(broken_document, flat_document)


pure func cat(a: Doc, b: Doc) -> Doc:
	match a:
		Nil:
			b
		_:
			match b:
				Nil:
					a
				_:
					Concat(a, b)


pure func concat_documents(documents: List[Doc]) -> Doc:
	var result: Doc = Nil

	for document in documents:
		result = result.cat(document)

	result


pure func indent(document: Doc) -> Doc:
	4.nest(document)


pure func group(document: Doc) -> Doc:
	Group(document)


pure func line_suffix(source: String) -> Doc:
	LineSuffix(source)


pure func intersperse(separator: Doc, documents: List[Doc]) -> Doc:
	match documents:
		[]:
			Nil
		[x]:
			x
		[x, ...rest]:
			x
				.cat(separator)
				.cat(separator.intersperse(rest))


pure func comma_sep(documents: List[Doc]) -> Doc:
	text(", ").intersperse(documents)


pure func comma_sep_break(documents: List[Doc]) -> Doc:
	match documents:
		[]:
			Nil
		[x]:
			x.cat(text(",").if_break(Nil))
		[x, ...rest]:
			x
				.cat(text(","))
				.cat(SoftlineSpace.cat(rest.comma_sep_break()))


pure func comma_hardline_documents(documents: List[Doc]) -> Doc:
	match documents:
		[]:
			Nil
		[x]:
			x
		[x, ...rest]:
			x
				.cat(text(","))
				.cat(Hardline)
				.cat(rest.comma_hardline_documents())


pure func hardlines(documents: List[Doc]) -> Doc:
	Hardline.intersperse(documents)


pure func blank_lines(count: Int, documents: List[Doc]) -> Doc:
	var separator: Doc = Nil

	for _ in 0..count + 1:
		separator = separator.cat(Hardline)

	separator.intersperse(documents)


pure func surround(left: String, right: String, document: Doc) -> Doc:
	left
		.text()
		.cat(document.cat(right.text()))


pure func parens(document: Doc) -> Doc:
	surround("(", ")", document)


pure func push1(command_value: Command, rest: List[Command]) -> List[Command]:
	[command_value].concat(rest)


pure func push2(first: Command, second: Command, rest: List[Command]) -> List[Command]:
	[first, second].concat(rest)


pure func fits(remaining: Int, work: List[Command]) -> Bool:
	var current_remaining: Int = remaining
	var current_work: List[Command] = work
	var done: Bool = False
	var result: Bool = False

	while not done:
		if current_remaining < 0:
			result = False
			done = True
		else:
			match current_work:
				[]:
					result = True
					done = True
				[command_value, ...rest]:
					match command_value.document:
						Nil:
							current_work = rest
						Text(source):
							current_remaining -= source.length()
							current_work = rest
						Hardline:
							result = True
							done = True
						Softline:
							current_work = command(command_value.indent, FlatMode, Nil).push1(rest)
						SoftlineSpace:
							match command_value.mode:
								FlatMode:
									current_remaining -= 1
									current_work = rest
								BreakMode:
									result = True
									done = True
						Indent(extra, inner):
							current_work = command(
								command_value.indent + extra,
								command_value.mode,
								inner,
							).push1(rest)
						Group(inner):
							current_work = command(
								command_value.indent,
								FlatMode,
								inner,
							).push1(rest)
						Concat(a, b):
							current_work = command(
								command_value.indent,
								command_value.mode,
								a,
							).push2(
								command(command_value.indent, command_value.mode, b),
								rest,
							)
						IfBreak(broken_document, flat_document):
							match command_value.mode:
								FlatMode:
									current_work = command(
										command_value.indent,
										FlatMode,
										flat_document,
									).push1(rest)
								BreakMode:
									current_work = command(
										command_value.indent,
										BreakMode,
										broken_document,
									).push1(rest)
						LineSuffix(_):
							current_work = rest

	result


pure func flush_line_suffixes(state: RenderState) -> RenderState:
	if state.suffixes.length() == 0:
		state
	else:
		render_state(state.output + state.suffixes.join(""), state.column, [])


pure func emit_newline(state: RenderState, indent_width: Int) -> RenderState:
	flushed: RenderState = state.flush_line_suffixes()
	tabs: Int = indent_width / 4

	var prefix: String = ""
	var i: Int = 0

	while i < tabs:
		prefix += "\t"
		i += 1

	render_state(flushed.output + "\n" + prefix, indent_width, [])


pure func enqueue_line_suffix(state: RenderState, suffix: String) -> RenderState:
	render_state(
		state.output,
		state.column,
		state.suffixes.append(" " + suffix),
	)


pure func render_loop(width: Int, state: RenderState, work: List[Command]) -> RenderState:
	var current_state: RenderState = state
	var current_work: List[Command] = work
	var done: Bool = False

	while not done:
		match current_work:
			[]:
				current_state = current_state.flush_line_suffixes()
				done = True
			[command_value, ...rest]:
				match command_value.document:
					Nil:
						current_work = rest
					Text(source):
						current_state = render_state(
							current_state.output + source,
							current_state.column + source.length(),
							current_state.suffixes,
						)
						current_work = rest
					Hardline:
						current_state = current_state.emit_newline(command_value.indent)
						current_work = rest
					Softline:
						match command_value.mode:
							FlatMode:
								current_work = rest
							BreakMode:
								current_state = current_state.emit_newline(command_value.indent)
								current_work = rest
					SoftlineSpace:
						match command_value.mode:
							FlatMode:
								current_state = render_state(
									current_state.output + " ",
									current_state.column + 1,
									current_state.suffixes,
								)
								current_work = rest
							BreakMode:
								current_state = current_state.emit_newline(command_value.indent)
								current_work = rest
					Indent(extra, inner):
						current_work = command(
							command_value.indent + extra,
							command_value.mode,
							inner,
						).push1(rest)
					Group(inner):
						flat_command: Command = command(command_value.indent, FlatMode, inner)

						if (width - current_state.column).fits(flat_command.push1(rest)):
							current_work = flat_command.push1(rest)
						else:
							current_work = command(
								command_value.indent,
								BreakMode,
								inner,
							).push1(rest)
					Concat(a, b):
						current_work = command(command_value.indent, command_value.mode, a).push2(
							command(command_value.indent, command_value.mode, b),
							rest,
						)
					IfBreak(broken_document, flat_document):
						match command_value.mode:
							FlatMode:
								current_work = command(
									command_value.indent,
									FlatMode,
									flat_document,
								).push1(rest)
							BreakMode:
								current_work = command(
									command_value.indent,
									BreakMode,
									broken_document,
								).push1(rest)
					LineSuffix(source):
						current_state = current_state.enqueue_line_suffix(source)
						current_work = rest

	current_state


pure func render(width: Int, document: Doc) -> String:
	rendered: RenderState = render_loop(
		width,
		render_state("", 0, []),
		[command(0, BreakMode, document)],
	)
	rendered.output


pure func collapse_blank_lines(
	lines: List[String],
	blank_count: Int,
	acc: List[String],
) -> List[String]:
	-- This runs over complete rendered files, including large compiler sources.
	-- Keep it iterative so formatting is not limited by native call-stack depth.
	var result: List[String] = acc.reverse()
	var current_blank_count: Int = blank_count

	for line in lines:
		if line == "":
			if current_blank_count < 2:
				result = result.append(line)
				current_blank_count += 1
		else:
			result = result.append(line)
			current_blank_count = 0

	result


pure func drop_trailing_blanks(lines: List[String]) -> List[String]:
	-- Avoid recursive tail reconstruction for the same reason as
	-- collapse_blank_lines: formatter output can be tens of thousands of lines.
	var end_index: Int = lines.length()
	var done: Bool = False

	while end_index > 0 and not done:
		match lines.get(end_index - 1):
			Some(line):
				if line == "":
					end_index -= 1
				else:
					done = True
			None:
				done = True

	lines.take(end_index)


pure func post_process(source: String) -> String:
	var trimmed: List[String] = []

	for line in source.split("\n"):
		trimmed = trimmed.append(line.trim_right())

	collapsed: List[String] = trimmed.collapse_blank_lines(0, [])
	body: List[String] = collapsed.drop_trailing_blanks()

	if body.length() == 0:
		""
	else:
		body.join("\n") + "\n"


pure func layout(width: Int, document: Doc) -> String:
	width
		.render(document)
		.post_process()


pure func layout_default(document: Doc) -> String:
	LINE_WIDTH.layout(document)
