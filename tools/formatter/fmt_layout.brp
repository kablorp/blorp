-- Formatter document IR and layout engine.
--
-- This intentionally mirrors compiler/lib/fmt/{fmt_doc,fmt_layout}.ml so the
-- compiler can keep parsing/AST printing in OCaml while Blorp dogfoods the
-- layout phase.
union Doc:
	Nil
	Text(String)
	Hardline
	Softline
	SoftlineSpace
	Indent(Int, Doc)
	Group(Doc)
	Concat(Doc, Doc)
	IfBreak(Doc, Doc)
	LineSuffix(String)


union LayoutMode:
	FlatMode
	BreakMode


record Command {indent: Int, mode: LayoutMode, doc: Doc}


record RenderState {out: String, col: Int, suffixes: List[String]}


LINE_WIDTH: Int = 100


pure func command(indent: Int, mode: LayoutMode, doc: Doc) -> Command:
	{indent = indent, mode = mode, doc = doc}


pure func render_state(out: String, col: Int, suffixes: List[String]) -> RenderState:
	{out = out, col = col, suffixes = suffixes}


pure func text(s: String) -> Doc:
	if s == "":
		Nil
	else:
		Text(s)


pure func nil() -> Doc:
	Nil


pure func hardline() -> Doc:
	Hardline


pure func softline() -> Doc:
	Softline


pure func softline_space() -> Doc:
	SoftlineSpace


pure func nest(width: Int, doc: Doc) -> Doc:
	Indent(width, doc)


pure func if_break(broken_doc: Doc, flat_doc: Doc) -> Doc:
	IfBreak(broken_doc, flat_doc)


pure func cat(a: Doc, b: Doc) -> Doc:
	match a:
		Nil: b
		_:
			match b:
				Nil: a
				_: Concat(a, b)


pure func concat_docs(docs: List[Doc]) -> Doc:
	var result: Doc = Nil
	for doc in docs:
		result = result.cat(doc)
	result


pure func indent(doc: Doc) -> Doc:
	4.nest(doc)


pure func group(doc: Doc) -> Doc:
	Group(doc)


pure func line_suffix(s: String) -> Doc:
	LineSuffix(s)


pure func intersperse(sep: Doc, docs: List[Doc]) -> Doc:
	match docs:
		[]: Nil
		[x]: x
		[x, ...rest]: x
			.cat(sep)
			.cat(sep.intersperse(rest))


pure func comma_sep(docs: List[Doc]) -> Doc:
	text(", ").intersperse(docs)


pure func comma_sep_break(docs: List[Doc]) -> Doc:
	match docs:
		[]: Nil
		[x]: x.cat(text(",").if_break(Nil))
		[x, ...rest]: x
			.cat(text(","))
			.cat(SoftlineSpace.cat(rest.comma_sep_break()))


pure func hardlines(docs: List[Doc]) -> Doc:
	Hardline.intersperse(docs)


pure func blank_lines(n: Int, docs: List[Doc]) -> Doc:
	var sep: Doc = Nil
	for _ in 0..n + 1:
		sep = sep.cat(Hardline)
	sep.intersperse(docs)


pure func surround(left: String, right: String, doc: Doc) -> Doc:
	left
		.text()
		.cat(doc.cat(right.text()))


pure func parens(doc: Doc) -> Doc:
	surround("(", ")", doc)


pure func push1(cmd: Command, rest: List[Command]) -> List[Command]:
	[cmd].concat(rest)


pure func push2(first: Command, second: Command, rest: List[Command]) -> List[Command]:
	[first, second].concat(rest)


pure func fits(remaining: Int, work: List[Command]) -> Bool:
	if remaining < 0:
		False
	else:
		match work:
			[]: True
			[cmd, ...rest]:
				match cmd.doc:
					Nil: remaining.fits(rest)
					Text(s): (remaining - s.length()).fits(rest)
					Hardline: True
					Softline: remaining.fits(command(cmd.indent, FlatMode, Nil).push1(rest))
					SoftlineSpace:
						match cmd.mode:
							FlatMode: (remaining - 1).fits(rest)
							BreakMode: True
					Indent(extra, inner):
						remaining.fits(command(cmd.indent + extra, cmd.mode, inner).push1(rest))
					Group(inner): remaining.fits(command(cmd.indent, FlatMode, inner).push1(rest))
					Concat(a, b):
						remaining.fits(
							command(cmd.indent, cmd.mode, a).push2(
								command(
									cmd.indent,
									cmd.mode,
									b,
								),
								rest,
							),
						)
					IfBreak(broken_doc, flat_doc):
						match cmd.mode:
							FlatMode:
								remaining.fits(command(cmd.indent, FlatMode, flat_doc).push1(rest))
							BreakMode:
								remaining.fits(
									command(cmd.indent, BreakMode, broken_doc).push1(rest),
								)
					LineSuffix(_): remaining.fits(rest)


pure func flush_line_suffixes(st: RenderState) -> RenderState:
	if st.suffixes.length() == 0:
		st
	else:
		render_state(st.out + st.suffixes.join(""), st.col, [])


pure func emit_newline(st: RenderState, indent_width: Int) -> RenderState:
	flushed: RenderState = st.flush_line_suffixes()
	tabs: Int = indent_width / 4
	prefix: String = if tabs > 0:
		"\t".repeat(tabs)
	else:
		""
	render_state(flushed.out + "\n" + prefix, indent_width, [])


pure func enqueue_line_suffix(st: RenderState, suffix: String) -> RenderState:
	render_state(st.out, st.col, st.suffixes.append(" " + suffix))


pure func render_loop(width: Int, st: RenderState, work: List[Command]) -> RenderState:
	match work:
		[]: st.flush_line_suffixes()
		[cmd, ...rest]:
			match cmd.doc:
				Nil: width.render_loop(st, rest)
				Text(s): width.render_loop(
					render_state(
						st.out + s,
						st.col + s.length(),
						st.suffixes,
					),
					rest,
				)
				Hardline: width.render_loop(st.emit_newline(cmd.indent), rest)
				Softline:
					match cmd.mode:
						FlatMode: width.render_loop(st, rest)
						BreakMode: width.render_loop(st.emit_newline(cmd.indent), rest)
				SoftlineSpace:
					match cmd.mode:
						FlatMode: width.render_loop(
							render_state(
								st.out + " ",
								st.col + 1,
								st.suffixes,
							),
							rest,
						)
						BreakMode: width.render_loop(st.emit_newline(cmd.indent), rest)
				Indent(extra, inner):
					width.render_loop(st, command(cmd.indent + extra, cmd.mode, inner).push1(rest))
				Group(inner):
					flat_cmd: Command = command(cmd.indent, FlatMode, inner)
					if (width - st.col).fits(flat_cmd.push1(rest)):
						width.render_loop(st, flat_cmd.push1(rest))
					else:
						width.render_loop(st, command(cmd.indent, BreakMode, inner).push1(rest))
				Concat(a, b):
					width.render_loop(
						st,
						command(cmd.indent, cmd.mode, a).push2(
							command(
								cmd.indent,
								cmd.mode,
								b,
							),
							rest,
						),
					)
				IfBreak(broken_doc, flat_doc):
					match cmd.mode:
						FlatMode:
							width.render_loop(
								st,
								command(cmd.indent, FlatMode, flat_doc).push1(rest),
							)
						BreakMode:
							width.render_loop(
								st,
								command(cmd.indent, BreakMode, broken_doc).push1(rest),
							)
				LineSuffix(s):
					width.render_loop(st.enqueue_line_suffix(s), rest)


pure func render(width: Int, doc: Doc) -> String:
	rendered: RenderState = width.render_loop(render_state("", 0, []), [command(0, BreakMode, doc)])
	rendered.out


pure func collapse_blank_lines(
	lines: List[String],
	blank_count: Int,
	acc: List[String],
) -> List[String]:
	match lines:
		[]: acc.reverse()
		[line, ...rest]:
			if line == "":
				if blank_count < 2:
					rest.collapse_blank_lines(blank_count + 1, [line].concat(acc))
				else:
					rest.collapse_blank_lines(blank_count, acc)
			else:
				rest.collapse_blank_lines(0, [line].concat(acc))


pure func drop_trailing_blanks(lines: List[String]) -> List[String]:
	match lines:
		[]: []
		[""]: []
		[line, ...rest]: [line].concat(rest.drop_trailing_blanks())


pure func post_process(s: String) -> String:
	var trimmed: List[String] = []
	for line in s.split("\n"):
		trimmed = trimmed.append(line.trim_right())
	collapsed: List[String] = trimmed.collapse_blank_lines(0, [])
	body: List[String] = collapsed.drop_trailing_blanks()
	body.join("\n") + "\n"


pure func layout(width: Int, doc: Doc) -> String:
	width
		.render(doc)
		.post_process()


pure func layout_default(doc: Doc) -> String:
	LINE_WIDTH.layout(doc)
