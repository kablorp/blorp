import:
	./fmt_json: array_field, bool_field, field, int_field, string_field
	./fmt_layout:
		Doc,
		cat,
		comma_sep,
		comma_sep_break,
		concat_docs,
		group,
		hardline,
		hardlines,
		indent,
		layout,
		parens,
		softline,
		text,
	./fmt_type_doc: TypeExpr, type_doc, type_expr_from_json
	json: JsonValue, as_string, get_field, parse_json


record StringFlags {raw: Bool, triple: Bool}


union Literal:
	IntLiteral(String)
	Int128Literal(String)
	FloatLiteral(String)
	StringLiteral(String, StringFlags)
	BoolLiteral(Bool)
	CharLiteral(Int)


union UnaryOp:
	NegOp
	NotOp


union BinaryOp:
	AddOp
	SubOp
	MulOp
	DivOp
	ModOp
	LtOp
	GtOp
	LeOp
	GeOp
	EqOp
	NeOp


union LogicalOp:
	AndOp
	OrOp


union Pattern:
	WildcardPattern
	VarPattern(String)
	ConstructorPattern(String, List[Pattern])
	LiteralPattern(Literal)
	TuplePattern(List[Pattern])
	QualifiedPattern(String, String, List[Pattern])
	ListPattern(List[Pattern])
	ListSpreadPattern(List[Pattern], Pattern)
	OrPattern(List[Pattern])


union FuncParam:
	NameParam(String)
	TypedNameParam(String, TypeExpr)
	PatternParam(Pattern)
	TypedPatternParam(Pattern, TypeExpr)


union StringInterpPart:
	StringTextPart(String)
	StringExprPart(Expr)


union Expr:
	IdentExpr(String)
	LiteralExpr(Literal)
	VoidExpr
	BreakExpr
	ContinueExpr
	BuiltinExpr
	BuiltinRuntimeExpr(String)
	FieldAccessExpr(Expr, String)
	CallExpr(Expr, List[Expr])
	UnaryExpr(UnaryOp, Expr)
	BinaryExpr(BinaryOp, Expr, Expr)
	LogicalExpr(LogicalOp, Expr, Expr)
	TupleExpr(List[Expr])
	ListExpr(List[Expr])
	VectorExpr(List[Expr])
	RecordExpr(List[(String, Expr)])
	RecordUpdateExpr(Expr, List[(String, Expr)])
	AscriptionExpr(Expr, TypeExpr)
	RangeExpr(Expr, Expr)
	SubscriptExpr(Expr, Expr)
	SubscriptMultiExpr(Expr, List[Expr])
	DictExpr(List[(Expr, Expr)])
	AssignExpr(String, Expr)
	VarDeclExpr(String, Bool, Expr)
	TypedVarDeclExpr(String, Bool, TypeExpr, Expr)
	TupleDestructExpr(List[String], Expr)
	SubscriptAssignExpr(Expr, List[Expr], Expr)
	QuestionBindExpr(String, Expr)
	TypedQuestionBindExpr(String, TypeExpr, Expr)
	BlockExpr(List[Expr])
	IfExpr(Expr, Expr)
	IfElseExpr(Expr, Expr, Expr)
	MatchExpr(Expr, List[(Pattern, Expr)])
	WhileExpr(Expr, Expr)
	ForExpr(String, Expr, Expr)
	ForTupleExpr(List[String], Expr, Expr)
	LambdaExpr(Bool, List[FuncParam], Expr)
	TypedLambdaExpr(Bool, List[FuncParam], TypeExpr, Expr)
	FuncDeclExpr(String, Bool, List[String], List[FuncParam], Expr)
	TypedFuncDeclExpr(String, Bool, List[String], List[FuncParam], TypeExpr, Expr)
	StringInterpExpr(List[StringInterpPart], Bool)
	DebugBlockExpr(List[Expr])
	ConcurrentExpr(List[Expr], Option[Expr], Option[Int])
	ConcurrentBindExpr(String, Option[TypeExpr], Expr)
	DetachExpr(Expr)
	ConcurrentForExpr(String, Expr, Expr, Option[Expr], Option[Int])


private pure func hex_digit(n: Int) -> String:
	if n < 10:
		to_char(to_int('0') + n).to_string()
	else:
		to_char(to_int('A') + n - 10).to_string()


private pure func hex_upper(n: Int) -> String:
	if n == 0:
		"0"
	else:
		var value: Int = n
		var out: String = ""
		while value > 0:
			digit: Int = value % 16
			out = digit.hex_digit() + out
			value /= 16
		out


private pure func unicode_escape(code: Int) -> String:
	"\\u{" + code.hex_upper() + "}"


private pure func escape_char_code(code: Int, escape_single_quote: Bool) -> String:
	if code == 10:
		"\\n"
	else if code == 9:
		"\\t"
	else if code == 13:
		"\\r"
	else if code == 92:
		"\\\\"
	else if code == 34:
		"\\\""
	else if code == 39 and escape_single_quote:
		"\\'"
	else if code == 0:
		"\\0"
	else if code >= 32 and code < 127:
		to_char(code).to_string()
	else:
		code.unicode_escape()


pure func escape_string_value(s: String) -> String:
	var out: String = ""
	for c in s:
		out += escape_char_code(c.to_int(), False)
	out


private pure func escape_triple_string_value(s: String) -> String:
	var out: String = ""
	for c in s:
		code: Int = c.to_int()
		if code == 92:
			out += "\\\\"
		else if code == 9:
			out += "\\t"
		else if code == 13:
			out += "\\r"
		else if code == 0:
			out += "\\0"
		else:
			out += c.to_string()
	out


private pure func unary_op_from_json(value: String) -> Result[UnaryOp, String]:
	match value:
		"Neg": Ok(NegOp)
		"Not": Ok(NotOp)
		_: Err("unknown unary operator: " + value)


private pure func binary_op_from_json(value: String) -> Result[BinaryOp, String]:
	match value:
		"Add": Ok(AddOp)
		"Sub": Ok(SubOp)
		"Mul": Ok(MulOp)
		"Div": Ok(DivOp)
		"Mod": Ok(ModOp)
		"Lt": Ok(LtOp)
		"Gt": Ok(GtOp)
		"Le": Ok(LeOp)
		"Ge": Ok(GeOp)
		"Eq": Ok(EqOp)
		"Ne": Ok(NeOp)
		_: Err("unknown binary operator: " + value)


private pure func logical_op_from_json(value: String) -> Result[LogicalOp, String]:
	match value:
		"And": Ok(AndOp)
		"Or": Ok(OrOp)
		_: Err("unknown logical operator: " + value)


private pure func unary_text(op: UnaryOp) -> String:
	match op:
		NegOp: "-"
		NotOp: "not "


private pure func binary_text(op: BinaryOp) -> String:
	match op:
		AddOp: "+"
		SubOp: "-"
		MulOp: "*"
		DivOp: "/"
		ModOp: "%"
		LtOp: "<"
		GtOp: ">"
		LeOp: "<="
		GeOp: ">="
		EqOp: "=="
		NeOp: "!="


private pure func logical_text(op: LogicalOp) -> String:
	match op:
		AndOp: "and"
		OrOp: "or"


private pure func binary_prec(op: BinaryOp) -> Int:
	match op:
		MulOp: 7
		DivOp: 7
		ModOp: 7
		AddOp: 6
		SubOp: 6
		_: 4


private pure func logical_prec(op: LogicalOp) -> Int:
	match op:
		AndOp: 2
		OrOp: 1


private pure func expr_prec(expr: Expr) -> Int:
	match expr:
		AscriptionExpr(_, _): 0
		BinaryExpr(op, _, _): op.binary_prec()
		LogicalExpr(op, _, _): op.logical_prec()
		_: 100


private pure func needs_field_receiver_parens(expr: Expr) -> Bool:
	match expr:
		AscriptionExpr(_, _): True
		BlockExpr(_): True
		BinaryExpr(_, _, _): True
		ConcurrentExpr(_, _, _): True
		ConcurrentForExpr(_, _, _, _, _): True
		DebugBlockExpr(_): True
		ForExpr(_, _, _): True
		ForTupleExpr(_, _, _): True
		IfExpr(_, _): True
		IfElseExpr(_, _, _): True
		LogicalExpr(_, _, _): True
		MatchExpr(_, _): True
		RangeExpr(_, _): True
		UnaryExpr(_, _): True
		WhileExpr(_, _): True
		_: False


private pure func string_flags_from_json(value: JsonValue) -> Result[StringFlags, String]:
	raw ?= value.bool_field("raw")
	triple ?= value.bool_field("triple")
	Ok({raw = raw, triple = triple})


pure func literal_from_json(value: JsonValue) -> Result[Literal, String]:
	tag ?= value.string_field("tag")
	match tag:
		"Int":
			raw ?= value.string_field("value")
			Ok(IntLiteral(raw))
		"Int128":
			raw ?= value.string_field("value")
			Ok(Int128Literal(raw))
		"Float":
			raw ?= value.string_field("value")
			Ok(FloatLiteral(raw))
		"String":
			text_value ?= value.string_field("text")
			flags ?= value.string_flags_from_json()
			Ok(StringLiteral(text_value, flags))
		"Bool":
			bool_value ?= value.bool_field("value")
			Ok(BoolLiteral(bool_value))
		"Char":
			code ?= value.int_field("value")
			Ok(CharLiteral(code))
		_: Err("unknown literal JSON tag: " + tag)


private pure func literal_field(value: JsonValue, key: String) -> Result[Literal, String]:
	child ?= value.field(key)
	child.literal_from_json()


private pure func pattern_field(value: JsonValue, key: String) -> Result[Pattern, String]:
	child ?= value.field(key)
	child.pattern_from_json()


private pure func expr_field(value: JsonValue, key: String) -> Result[Expr, String]:
	child ?= value.field(key)
	child.expr_from_json()


private pure func type_expr_field(value: JsonValue, key: String) -> Result[TypeExpr, String]:
	child ?= value.field(key)
	child.type_expr_from_json()


private pure func optional_type_expr_field(
	value: JsonValue,
	key: String,
) -> Result[Option[TypeExpr], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			ty ?= child.type_expr_from_json()
			Ok(Some(ty))


private pure func optional_expr_field(
	value: JsonValue,
	key: String,
) -> Result[Option[Expr], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(child):
			expr_value ?= child.expr_from_json()
			Ok(Some(expr_value))


private pure func optional_int_field(value: JsonValue, key: String) -> Result[Option[Int], String]:
	match value.get_field(key):
		None: Ok(None)
		Some(_):
			int_value ?= value.int_field(key)
			Ok(Some(int_value))


private pure func string_array_field(value: JsonValue, key: String) -> Result[List[String], String]:
	items ?= value.array_field(key)
	var result: List[String] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.as_string():
					Some(s): result = result.append(s)
					None: error = Some(
						"expected formatter JSON field '" + key + "' to be an array of strings",
					)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func pattern_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[Pattern], String]:
	items ?= value.array_field(key)
	var result: List[Pattern] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.pattern_from_json():
					Ok(pattern): result = result.append(pattern)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func func_param_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[FuncParam], String]:
	items ?= value.array_field(key)
	var result: List[FuncParam] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.func_param_from_json():
					Ok(param): result = result.append(param)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func string_interp_part_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[StringInterpPart], String]:
	items ?= value.array_field(key)
	var result: List[StringInterpPart] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.string_interp_part_from_json():
					Ok(part): result = result.append(part)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func expr_array_field(value: JsonValue, key: String) -> Result[List[Expr], String]:
	items ?= value.array_field(key)
	var result: List[Expr] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.expr_from_json():
					Ok(expr): result = result.append(expr)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func record_expr_field_from_json(value: JsonValue) -> Result[(String, Expr), String]:
	name ?= value.string_field("name")
	expr ?= value.expr_field("value")
	Ok((name, expr))


private pure func record_expr_fields(
	value: JsonValue,
	key: String,
) -> Result[List[(String, Expr)], String]:
	items ?= value.array_field(key)
	var result: List[(String, Expr)] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.record_expr_field_from_json():
					Ok(field_value): result = result.append(field_value)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


private pure func dict_entry_from_json(value: JsonValue) -> Result[(Expr, Expr), String]:
	key ?= value.expr_field("key")
	entry_value ?= value.expr_field("value")
	Ok((key, entry_value))


private pure func dict_entries(value: JsonValue, key: String) -> Result[List[(Expr, Expr)], String]:
	items ?= value.array_field(key)
	var result: List[(Expr, Expr)] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.dict_entry_from_json():
					Ok(entry): result = result.append(entry)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


pure func pattern_from_json(value: JsonValue) -> Result[Pattern, String]:
	tag ?= value.string_field("tag")
	match tag:
		"Wildcard": Ok(WildcardPattern)
		"Var":
			name ?= value.string_field("name")
			Ok(VarPattern(name))
		"Constructor":
			name ?= value.string_field("name")
			args ?= value.pattern_array_field("args")
			Ok(ConstructorPattern(name, args))
		"Literal":
			lit ?= value.literal_field("literal")
			Ok(LiteralPattern(lit))
		"Tuple":
			elems ?= value.pattern_array_field("elems")
			Ok(TuplePattern(elems))
		"Qualified":
			module_name ?= value.string_field("module")
			name ?= value.string_field("name")
			args ?= value.pattern_array_field("args")
			Ok(QualifiedPattern(module_name, name, args))
		"List":
			elems ?= value.pattern_array_field("elems")
			match value.get_field("spread"):
				None: Ok(ListPattern(elems))
				Some(spread_value):
					spread ?= spread_value.pattern_from_json()
					Ok(ListSpreadPattern(elems, spread))
		"Or":
			elems ?= value.pattern_array_field("patterns")
			Ok(OrPattern(elems))
		_: Err("unknown pattern JSON tag: " + tag)


pure func func_param_from_json(value: JsonValue) -> Result[FuncParam, String]:
	tag ?= value.string_field("tag")
	match tag:
		"Name":
			name ?= value.string_field("name")
			Ok(NameParam(name))
		"TypedName":
			name ?= value.string_field("name")
			ty ?= value.type_expr_field("type")
			Ok(TypedNameParam(name, ty))
		"Pattern":
			pattern ?= value.pattern_field("pattern")
			Ok(PatternParam(pattern))
		"TypedPattern":
			pattern ?= value.pattern_field("pattern")
			ty ?= value.type_expr_field("type")
			Ok(TypedPatternParam(pattern, ty))
		_: Err("unknown function parameter JSON tag: " + tag)


pure func string_interp_part_from_json(value: JsonValue) -> Result[StringInterpPart, String]:
	tag ?= value.string_field("tag")
	match tag:
		"Text":
			text_value ?= value.string_field("text")
			Ok(StringTextPart(text_value))
		"Expr":
			expr_value ?= value.expr_field("expr")
			Ok(StringExprPart(expr_value))
		_: Err("unknown string interpolation part JSON tag: " + tag)


private pure func match_case_from_json(value: JsonValue) -> Result[(Pattern, Expr), String]:
	pattern ?= value.pattern_field("pattern")
	body ?= value.expr_field("body")
	Ok((pattern, body))


private pure func match_cases(
	value: JsonValue,
	key: String,
) -> Result[List[(Pattern, Expr)], String]:
	items ?= value.array_field(key)
	var result: List[(Pattern, Expr)] = []
	var error: Option[String] = None
	for item in items:
		match error:
			Some(_): void
			None:
				match item.match_case_from_json():
					Ok(case_value): result = result.append(case_value)
					Err(msg): error = Some(msg)
	match error:
		Some(msg): Err(msg)
		None: Ok(result)


pure func expr_from_json(value: JsonValue) -> Result[Expr, String]:
	tag ?= value.string_field("tag")
	match tag:
		"Ident":
			name ?= value.string_field("name")
			Ok(IdentExpr(name))
		"Literal":
			lit ?= value.literal_field("literal")
			Ok(LiteralExpr(lit))
		"Void": Ok(VoidExpr)
		"Break": Ok(BreakExpr)
		"Continue": Ok(ContinueExpr)
		"Builtin": Ok(BuiltinExpr)
		"BuiltinRuntime":
			name ?= value.string_field("name")
			Ok(BuiltinRuntimeExpr(name))
		"FieldAccess":
			receiver ?= value.expr_field("receiver")
			field_name ?= value.string_field("field")
			Ok(FieldAccessExpr(receiver, field_name))
		"Call":
			callee ?= value.expr_field("callee")
			args ?= value.expr_array_field("args")
			Ok(CallExpr(callee, args))
		"Unary":
			raw_op ?= value.string_field("op")
			op ?= raw_op.unary_op_from_json()
			inner ?= value.expr_field("expr")
			Ok(UnaryExpr(op, inner))
		"Binary":
			raw_op ?= value.string_field("op")
			op ?= raw_op.binary_op_from_json()
			left ?= value.expr_field("left")
			right ?= value.expr_field("right")
			Ok(BinaryExpr(op, left, right))
		"Logical":
			raw_op ?= value.string_field("op")
			op ?= raw_op.logical_op_from_json()
			left ?= value.expr_field("left")
			right ?= value.expr_field("right")
			Ok(LogicalExpr(op, left, right))
		"Tuple":
			elems ?= value.expr_array_field("elems")
			Ok(TupleExpr(elems))
		"List":
			elems ?= value.expr_array_field("elems")
			Ok(ListExpr(elems))
		"Vector":
			elems ?= value.expr_array_field("elems")
			Ok(VectorExpr(elems))
		"Record":
			fields ?= value.record_expr_fields("fields")
			Ok(RecordExpr(fields))
		"RecordUpdate":
			base ?= value.expr_field("base")
			fields ?= value.record_expr_fields("fields")
			Ok(RecordUpdateExpr(base, fields))
		"Ascription":
			inner ?= value.expr_field("expr")
			ty ?= value.type_expr_field("type")
			Ok(AscriptionExpr(inner, ty))
		"Range":
			left ?= value.expr_field("left")
			right ?= value.expr_field("right")
			Ok(RangeExpr(left, right))
		"Subscript":
			target ?= value.expr_field("target")
			index ?= value.expr_field("index")
			Ok(SubscriptExpr(target, index))
		"SubscriptMulti":
			target ?= value.expr_field("target")
			indices ?= value.expr_array_field("indices")
			Ok(SubscriptMultiExpr(target, indices))
		"Dict":
			entries ?= value.dict_entries("entries")
			Ok(DictExpr(entries))
		"Assign":
			name ?= value.string_field("name")
			expr ?= value.expr_field("value")
			Ok(AssignExpr(name, expr))
		"VarDecl":
			name ?= value.string_field("name")
			is_mutable ?= value.bool_field("mutable")
			expr ?= value.expr_field("value")
			ty ?= value.optional_type_expr_field("type")
			match ty:
				Some(type_expr): Ok(TypedVarDeclExpr(name, is_mutable, type_expr, expr))
				None: Ok(VarDeclExpr(name, is_mutable, expr))
		"TupleDestruct":
			names ?= value.string_array_field("names")
			expr ?= value.expr_field("value")
			Ok(TupleDestructExpr(names, expr))
		"SubscriptAssign":
			target ?= value.expr_field("target")
			indices ?= value.expr_array_field("indices")
			expr ?= value.expr_field("value")
			Ok(SubscriptAssignExpr(target, indices, expr))
		"QuestionBind":
			name ?= value.string_field("name")
			expr ?= value.expr_field("expr")
			ty ?= value.optional_type_expr_field("type")
			match ty:
				Some(type_expr): Ok(TypedQuestionBindExpr(name, type_expr, expr))
				None: Ok(QuestionBindExpr(name, expr))
		"Block":
			exprs ?= value.expr_array_field("exprs")
			Ok(BlockExpr(exprs))
		"If":
			cond ?= value.expr_field("cond")
			then_expr ?= value.expr_field("then")
			match value.get_field("else"):
				None: Ok(IfExpr(cond, then_expr))
				Some(else_value):
					else_expr ?= else_value.expr_from_json()
					Ok(IfElseExpr(cond, then_expr, else_expr))
		"Match":
			scrutinee ?= value.expr_field("scrutinee")
			cases ?= value.match_cases("cases")
			Ok(MatchExpr(scrutinee, cases))
		"While":
			cond ?= value.expr_field("cond")
			body ?= value.expr_field("body")
			Ok(WhileExpr(cond, body))
		"For":
			name ?= value.string_field("name")
			iter ?= value.expr_field("iter")
			body ?= value.expr_field("body")
			Ok(ForExpr(name, iter, body))
		"ForTuple":
			names ?= value.string_array_field("names")
			iter ?= value.expr_field("iter")
			body ?= value.expr_field("body")
			Ok(ForTupleExpr(names, iter, body))
		"Lambda":
			is_pure ?= value.bool_field("pure")
			params ?= value.func_param_array_field("params")
			body ?= value.expr_field("body")
			ret ?= value.optional_type_expr_field("return")
			match ret:
				Some(return_type): Ok(TypedLambdaExpr(is_pure, params, return_type, body))
				None: Ok(LambdaExpr(is_pure, params, body))
		"FuncDecl":
			name ?= value.string_field("name")
			is_pure ?= value.bool_field("pure")
			type_params ?= value.string_array_field("type_params")
			params ?= value.func_param_array_field("params")
			body ?= value.expr_field("body")
			ret ?= value.optional_type_expr_field("return")
			match ret:
				Some(return_type): Ok(
					TypedFuncDeclExpr(
						name,
						is_pure,
						type_params,
						params,
						return_type,
						body,
					),
				)
				None: Ok(FuncDeclExpr(name, is_pure, type_params, params, body))
		"StringInterp":
			parts ?= value.string_interp_part_array_field("parts")
			is_triple ?= value.bool_field("triple")
			Ok(StringInterpExpr(parts, is_triple))
		"DebugBlock":
			exprs ?= value.expr_array_field("exprs")
			Ok(DebugBlockExpr(exprs))
		"Concurrent":
			bindings ?= value.expr_array_field("bindings")
			timeout ?= value.optional_expr_field("timeout")
			max_threads ?= value.optional_int_field("max_threads")
			Ok(ConcurrentExpr(bindings, timeout, max_threads))
		"ConcurrentBind":
			name ?= value.string_field("name")
			ty ?= value.optional_type_expr_field("type")
			body ?= value.expr_field("value")
			Ok(ConcurrentBindExpr(name, ty, body))
		"Detach":
			body ?= value.expr_field("body")
			Ok(DetachExpr(body))
		"ConcurrentFor":
			var_name ?= value.string_field("var")
			iter ?= value.expr_field("iter")
			body ?= value.expr_field("body")
			timeout ?= value.optional_expr_field("timeout")
			max_threads ?= value.optional_int_field("max_threads")
			Ok(ConcurrentForExpr(var_name, iter, body, timeout, max_threads))
		_: Err("unknown expression JSON tag: " + tag)


pure func expr_from_json_string(input: String) -> Result[Expr, String]:
	value ?= input.parse_json()
	value.expr_from_json()


private pure func literal_doc(lit: Literal) -> Doc:
	match lit:
		IntLiteral(raw): raw.text()
		Int128Literal(raw): raw.text()
		FloatLiteral(raw): raw.text()
		StringLiteral(value, flags):
			if flags.raw:
				("r\"" + value + "\"").text()
			else if flags.triple:
				("\"\"\"" + value.escape_triple_string_value() + "\"\"\"").text()
			else:
				("\"" + value.escape_string_value() + "\"").text()
		BoolLiteral(value):
			if value:
				"True".text()
			else:
				"False".text()
		CharLiteral(code):
			if code < 128:
				("'" + escape_char_code(code, True) + "'").text()
			else:
				("'" + code.unicode_escape() + "'").text()


pure func pattern_doc(pattern: Pattern) -> Doc:
	match pattern:
		WildcardPattern: "_".text()
		VarPattern(name): name.text()
		ConstructorPattern(name, args):
			if args.length() == 0:
				(name + "()").text()
			else:
				name
					.text()
					.cat("(".text())
					.cat(args
							.pattern_doc_list()
							.comma_sep())
					.cat(")".text())
		LiteralPattern(lit): lit.literal_doc()
		TuplePattern(elems):
			"("
				.text()
				.cat(elems
						.pattern_doc_list()
						.comma_sep())
				.cat(")".text())
		QualifiedPattern(module_name, name, args):
			prefix: Doc = module_name
				.text()
				.cat(".".text())
				.cat(name.text())
			if args.length() == 0:
				prefix
			else:
				prefix
					.cat("(".text())
					.cat(args
							.pattern_doc_list()
							.comma_sep())
					.cat(")".text())
		ListPattern(elems):
			"["
				.text()
				.cat(elems
						.pattern_doc_list()
						.comma_sep())
				.cat("]".text())
		ListSpreadPattern(elems, spread):
			docs: List[Doc] = elems
				.pattern_doc_list()
				.append("..."
						.text()
						.cat(spread.pattern_doc()))
			"["
				.text()
				.cat(docs.comma_sep())
				.cat("]".text())
		OrPattern(elems): " | "
			.text()
			.intersperse(elems.pattern_doc_list())


private pure func pattern_doc_list(patterns: List[Pattern]) -> List[Doc]:
	var docs: List[Doc] = []
	for pattern in patterns:
		docs = docs.append(pattern.pattern_doc())
	docs


private pure func expr_doc_list(exprs: List[Expr]) -> List[Doc]:
	var docs: List[Doc] = []
	for expr in exprs:
		docs = docs.append(expr.expr_doc())
	docs


private pure func bracketed_expr_doc(
	open_text: String,
	close_text: String,
	exprs: List[Expr],
) -> Doc:
	open_text
		.text()
		.cat(softline()
				.cat(exprs
						.expr_doc_list()
						.comma_sep_break())
				.indent())
		.cat(softline())
		.cat(close_text.text())
		.group()


private pure func record_field_doc(field_value: (String, Expr)) -> Doc:
	field_value.0
		.text()
		.cat(" = ".text())
		.cat(field_value.1.expr_doc())


private pure func record_field_docs(fields: List[(String, Expr)]) -> List[Doc]:
	var docs: List[Doc] = []
	for field_value in fields:
		docs = docs.append(field_value.record_field_doc())
	docs


private pure func dict_entry_doc(entry: (Expr, Expr)) -> Doc:
	entry.0
		.expr_doc()
		.cat(" => ".text())
		.cat(entry.1.expr_doc())


private pure func dict_entry_docs(entries: List[(Expr, Expr)]) -> List[Doc]:
	var docs: List[Doc] = []
	for entry in entries:
		docs = docs.append(entry.dict_entry_doc())
	docs


private pure func string_docs(items: List[String]) -> List[Doc]:
	var docs: List[Doc] = []
	for item in items:
		docs = docs.append(item.text())
	docs


private pure func is_compound_assign_op(op: BinaryOp) -> Bool:
	match op:
		AddOp: True
		SubOp: True
		MulOp: True
		DivOp: True
		_: False


private pure func compound_assign_text(op: BinaryOp) -> String:
	match op:
		AddOp: "+="
		SubOp: "-="
		MulOp: "*="
		DivOp: "/="
		_: "="


private pure func assign_doc(name: String, value: Expr) -> Doc:
	match value:
		BinaryExpr(op, IdentExpr(left_name), rhs):
			if left_name == name and op.is_compound_assign_op():
				name
					.text()
					.cat(" ".text())
					.cat(op
							.compound_assign_text()
							.text())
					.cat(" ".text())
					.cat(rhs.expr_doc())
			else:
				name
					.text()
					.cat(" = ".text())
					.cat(value.expr_doc())
		_:
			name
				.text()
				.cat(" = ".text())
				.cat(value.expr_doc())


private pure func var_decl_doc(
	name: String,
	is_mutable: Bool,
	ty: Option[TypeExpr],
	value: Expr,
) -> Doc:
	prefix: Doc = if is_mutable:
		"var ".text()
	else:
		"".text()
	type_doc_part: Doc = match ty:
		Some(type_expr): ": "
			.text()
			.cat(type_expr.type_doc())
		None: "".text()
	prefix
		.cat(name.text())
		.cat(type_doc_part)
		.cat(" = ".text())
		.cat(value.expr_doc())


private pure func question_bind_doc(name: String, ty: Option[TypeExpr], value: Expr) -> Doc:
	type_doc_part: Doc = match ty:
		Some(type_expr): ": "
			.text()
			.cat(type_expr.type_doc())
		None: "".text()
	name
		.text()
		.cat(type_doc_part)
		.cat(" ?= ".text())
		.cat(value.expr_doc())


private pure func block_exprs_doc(exprs: List[Expr]) -> Doc:
	exprs
		.expr_doc_list()
		.hardlines()


pure func is_block_expr(expr: Expr) -> Bool:
	match expr:
		BlockExpr(_): True
		_: False


pure func block_body_doc(expr: Expr) -> Doc:
	match expr:
		BlockExpr(exprs): exprs.block_exprs_doc()
		_: expr.expr_doc()


private pure func match_case_doc(case_value: (Pattern, Expr)) -> Doc:
	head: Doc = case_value.0
		.pattern_doc()
		.cat(":".text())
	match case_value.1:
		BlockExpr(_):
			head.cat(hardline()
					.cat(case_value.1.block_body_doc())
					.indent())
		_: head
			.cat(" ".text())
			.cat(case_value.1.expr_doc())


private pure func match_case_docs(cases: List[(Pattern, Expr)]) -> List[Doc]:
	var docs: List[Doc] = []
	for case_value in cases:
		docs = docs.append(case_value.match_case_doc())
	docs


pure func func_param_doc(param: FuncParam) -> Doc:
	match param:
		NameParam(name): name.text()
		TypedNameParam(name, ty):
			name
				.text()
				.cat(": ".text())
				.cat(ty.type_doc())
		PatternParam(pattern): pattern.pattern_doc()
		TypedPatternParam(pattern, ty):
			pattern
				.pattern_doc()
				.cat(": ".text())
				.cat(ty.type_doc())


pure func func_param_docs(params: List[FuncParam]) -> List[Doc]:
	var docs: List[Doc] = []
	for param in params:
		docs = docs.append(param.func_param_doc())
	docs


pure func func_params_doc(params: List[FuncParam]) -> Doc:
	"("
		.text()
		.cat(params
				.func_param_docs()
				.comma_sep())
		.cat(")".text())


private pure func type_params_doc(params: List[String]) -> Doc:
	if params.length() == 0:
		"".text()
	else:
		"["
			.text()
			.cat(params
					.string_docs()
					.comma_sep())
			.cat("]".text())


private pure func return_doc(ret: Option[TypeExpr]) -> Doc:
	match ret:
		Some(ty): " -> "
			.text()
			.cat(ty.type_doc())
		None: "".text()


private pure func lambda_doc(
	is_pure: Bool,
	params: List[FuncParam],
	ret: Option[TypeExpr],
	body: Expr,
) -> Doc:
	prefix: Doc = if is_pure:
		"pure ".text()
	else:
		"".text()
	head: Doc = prefix
		.cat("func".text())
		.cat(params.func_params_doc())
		.cat(ret.return_doc())
	match body:
		BlockExpr(_):
			head
				.cat(":".text())
				.cat(hardline()
						.cat(body.block_body_doc())
						.indent())
		_:
			head
				.cat(": ".text())
				.cat(body.expr_doc())


private pure func func_decl_doc(
	name: String,
	is_pure: Bool,
	type_params: List[String],
	params: List[FuncParam],
	ret: Option[TypeExpr],
	body: Expr,
) -> Doc:
	prefix: Doc = if is_pure:
		"pure ".text()
	else:
		"".text()
	prefix
		.cat("func ".text())
		.cat(name.text())
		.cat(type_params.type_params_doc())
		.cat(params.func_params_doc())
		.cat(ret.return_doc())
		.cat(":".text())
		.cat(hardline()
				.cat(body.block_body_doc())
				.indent())


private pure func concurrent_params_doc(timeout: Option[Expr], max_threads: Option[Int]) -> Doc:
	match max_threads:
		Some(thread_count):
			match timeout:
				Some(timeout_expr):
					"(max_threads: "
						.text()
						.cat(thread_count
								.to_string()
								.text())
						.cat(", timeout: ".text())
						.cat(timeout_expr.expr_doc())
						.cat(")".text())
				None:
					("(max_threads: " + thread_count.to_string() + ")").text()
		None:
			match timeout:
				Some(timeout_expr):
					"(timeout: "
						.text()
						.cat(timeout_expr.expr_doc())
						.cat(")".text())
				None: "".text()


private pure func concurrent_bind_doc(name: String, ty: Option[TypeExpr], value: Expr) -> Doc:
	ty_doc: Doc = match ty:
		Some(type_expr):
			": "
				.text()
				.cat(type_expr.type_doc())
		None: "".text()
	name
		.text()
		.cat(ty_doc)
		.cat(" = ".text())
		.cat(value.expr_doc())


private pure func string_interp_part_doc(part: StringInterpPart, is_triple: Bool) -> Doc:
	match part:
		StringTextPart(value):
			escaped: String = if is_triple:
				value.escape_triple_string_value()
			else:
				value.escape_string_value()
			escaped.text()
		StringExprPart(value):
			"$"
				.text()
				.cat("{".text())
				.cat(value.expr_doc())
				.cat("}".text())


private pure func string_interp_part_docs(
	parts: List[StringInterpPart],
	is_triple: Bool,
) -> List[Doc]:
	var docs: List[Doc] = []
	for part in parts:
		docs = docs.append(part.string_interp_part_doc(is_triple))
	docs


private pure func string_interp_doc(parts: List[StringInterpPart], is_triple: Bool) -> Doc:
	quote: String = if is_triple:
		"\"\"\""
	else:
		"\""
	quote
		.text()
		.cat(parts
				.string_interp_part_docs(is_triple)
				.concat_docs())
		.cat(quote.text())


pure func expr_doc(expr: Expr) -> Doc:
	match expr:
		IdentExpr(name): name.text()
		LiteralExpr(lit): lit.literal_doc()
		VoidExpr: "void".text()
		BreakExpr: "break".text()
		ContinueExpr: "continue".text()
		BuiltinExpr: "builtin".text()
		BuiltinRuntimeExpr(name): ("builtin(\"" + name.escape_string_value() + "\")").text()
		FieldAccessExpr(receiver, field_name):
			receiver_doc: Doc = if receiver.needs_field_receiver_parens():
				receiver
					.expr_doc()
					.parens()
			else:
				receiver.expr_doc()
			receiver_doc
				.cat(".".text())
				.cat(field_name.text())
		CallExpr(callee, args):
			if args.length() == 0:
				callee
					.expr_doc()
					.cat("()".text())
			else:
				callee
					.expr_doc()
					.cat("("
							.text()
							.cat(softline()
									.cat(args
											.expr_doc_list()
											.comma_sep_break())
									.indent())
							.cat(softline())
							.cat(")".text())
							.group())
		UnaryExpr(op, inner):
			inner_doc: Doc = match inner:
				BinaryExpr(_, _, _): inner
					.expr_doc()
					.parens()
				LogicalExpr(_, _, _): inner
					.expr_doc()
					.parens()
				UnaryExpr(NegOp, _):
					if op == NegOp:
						inner
							.expr_doc()
							.parens()
					else:
						inner.expr_doc()
				LiteralExpr(IntLiteral(raw)):
					if op == NegOp and raw.starts_with("-"):
						inner
							.expr_doc()
							.parens()
					else:
						inner.expr_doc()
				LiteralExpr(FloatLiteral(raw)):
					if op == NegOp and raw.starts_with("-"):
						inner
							.expr_doc()
							.parens()
					else:
						inner.expr_doc()
				_: inner.expr_doc()
			op
				.unary_text()
				.text()
				.cat(inner_doc)
		BinaryExpr(op, left, right):
			prec: Int = op.binary_prec()
			left_doc: Doc = if left.expr_prec() < prec:
				left
					.expr_doc()
					.parens()
			else:
				left.expr_doc()
			right_doc: Doc = if right.expr_prec() <= prec:
				right
					.expr_doc()
					.parens()
			else:
				right.expr_doc()
			left_doc
				.cat(" ".text())
				.cat(op
						.binary_text()
						.text())
				.cat(" ".text())
				.cat(right_doc)
		LogicalExpr(op, left, right):
			prec: Int = op.logical_prec()
			left_doc: Doc = if left.expr_prec() < prec:
				left
					.expr_doc()
					.parens()
			else:
				left.expr_doc()
			right_doc: Doc = if right.expr_prec() <= prec:
				right
					.expr_doc()
					.parens()
			else:
				right.expr_doc()
			left_doc
				.cat(" ".text())
				.cat(op
						.logical_text()
						.text())
				.cat(" ".text())
				.cat(right_doc)
		TupleExpr(elems): bracketed_expr_doc("(", ")", elems)
		ListExpr(elems): bracketed_expr_doc("[", "]", elems)
		VectorExpr(elems): bracketed_expr_doc("{", "}", elems)
		RecordExpr(fields):
			"{"
				.text()
				.cat(softline()
						.cat(fields
								.record_field_docs()
								.comma_sep_break())
						.indent())
				.cat(softline())
				.cat("}".text())
				.group()
		RecordUpdateExpr(base, fields):
			"{ "
				.text()
				.cat(base.expr_doc())
				.cat(" | ".text())
				.cat(fields
						.record_field_docs()
						.comma_sep_break())
				.cat(" }".text())
				.group()
		AscriptionExpr(inner, ty):
			inner_doc: Doc = match inner:
				AscriptionExpr(_, _): inner
					.expr_doc()
					.parens()
				_: inner.expr_doc()
			inner_doc
				.cat(" as ".text())
				.cat(ty.type_doc())
		RangeExpr(left, right):
			left
				.expr_doc()
				.cat("..".text())
				.cat(right.expr_doc())
		SubscriptExpr(target, index):
			target
				.expr_doc()
				.cat("[".text())
				.cat(index.expr_doc())
				.cat("]".text())
		SubscriptMultiExpr(target, indices):
			target
				.expr_doc()
				.cat("[".text())
				.cat(indices
						.expr_doc_list()
						.comma_sep())
				.cat("]".text())
		DictExpr(entries):
			"{"
				.text()
				.cat(entries
						.dict_entry_docs()
						.comma_sep())
				.cat("}".text())
		AssignExpr(name, value): assign_doc(name, value)
		VarDeclExpr(name, is_mutable, value): var_decl_doc(name, is_mutable, None, value)
		TypedVarDeclExpr(name, is_mutable, ty, value): var_decl_doc(
			name,
			is_mutable,
			Some(ty),
			value,
		)
		TupleDestructExpr(names, value):
			"("
				.text()
				.cat(names
						.string_docs()
						.comma_sep())
				.cat(") = ".text())
				.cat(value.expr_doc())
		SubscriptAssignExpr(target, indices, value):
			target
				.expr_doc()
				.cat("[".text())
				.cat(indices
						.expr_doc_list()
						.comma_sep())
				.cat("] = ".text())
				.cat(value.expr_doc())
		QuestionBindExpr(name, value): question_bind_doc(name, None, value)
		TypedQuestionBindExpr(name, ty, value): question_bind_doc(name, Some(ty), value)
		BlockExpr(exprs): exprs.block_exprs_doc()
		IfExpr(cond, then_expr):
			"if "
				.text()
				.cat(cond.expr_doc())
				.cat(":".text())
				.cat(hardline()
						.cat(then_expr.block_body_doc())
						.indent())
		IfElseExpr(cond, then_expr, else_expr):
			if_doc: Doc = "if "
				.text()
				.cat(cond.expr_doc())
				.cat(":".text())
				.cat(hardline()
						.cat(then_expr.block_body_doc())
						.indent())
			match else_expr:
				IfExpr(_, _):
					if_doc
						.cat(hardline())
						.cat("else ".text())
						.cat(else_expr.expr_doc())
				IfElseExpr(_, _, _):
					if_doc
						.cat(hardline())
						.cat("else ".text())
						.cat(else_expr.expr_doc())
				_:
					if_doc
						.cat(hardline())
						.cat("else:".text())
						.cat(hardline()
								.cat(else_expr.block_body_doc())
								.indent())
		MatchExpr(scrutinee, cases):
			"match "
				.text()
				.cat(scrutinee.expr_doc())
				.cat(":".text())
				.cat(hardline()
						.cat(cases
								.match_case_docs()
								.hardlines())
						.indent())
		WhileExpr(cond, body):
			"while "
				.text()
				.cat(cond.expr_doc())
				.cat(":".text())
				.cat(hardline()
						.cat(body.block_body_doc())
						.indent())
		ForExpr(name, iter, body):
			"for "
				.text()
				.cat(name.text())
				.cat(" in ".text())
				.cat(iter.expr_doc())
				.cat(":".text())
				.cat(hardline()
						.cat(body.block_body_doc())
						.indent())
		ForTupleExpr(names, iter, body):
			"for ("
				.text()
				.cat(names
						.string_docs()
						.comma_sep())
				.cat(") in ".text())
				.cat(iter.expr_doc())
				.cat(":".text())
				.cat(hardline()
						.cat(body.block_body_doc())
						.indent())
		LambdaExpr(is_pure, params, body): lambda_doc(is_pure, params, None, body)
		TypedLambdaExpr(is_pure, params, ret, body): lambda_doc(is_pure, params, Some(ret), body)
		FuncDeclExpr(name, is_pure, type_params, params, body): func_decl_doc(
			name,
			is_pure,
			type_params,
			params,
			None,
			body,
		)
		TypedFuncDeclExpr(name, is_pure, type_params, params, ret, body): func_decl_doc(
			name,
			is_pure,
			type_params,
			params,
			Some(ret),
			body,
		)
		StringInterpExpr(parts, is_triple): string_interp_doc(parts, is_triple)
		DebugBlockExpr(exprs):
			"debug:"
				.text()
				.cat(hardline()
						.cat(exprs.block_exprs_doc())
						.indent())
		ConcurrentExpr(bindings, timeout, max_threads):
			"concurrent"
				.text()
				.cat(concurrent_params_doc(timeout, max_threads))
				.cat(":".text())
				.cat(hardline()
						.cat(bindings.block_exprs_doc())
						.indent())
		ConcurrentBindExpr(name, ty, value): concurrent_bind_doc(name, ty, value)
		DetachExpr(body):
			"detach "
				.text()
				.cat(body.expr_doc())
		ConcurrentForExpr(var_name, iter, body, timeout, max_threads):
			"concurrent"
				.text()
				.cat(concurrent_params_doc(timeout, max_threads))
				.cat(" for ".text())
				.cat(var_name.text())
				.cat(" in ".text())
				.cat(iter.expr_doc())
				.cat(":".text())
				.cat(hardline()
						.cat(body.block_body_doc())
						.indent())


pure func layout_expr_json(width: Int, input: String) -> Result[String, String]:
	expr ?= input.expr_from_json_string()
	Ok(width.layout(expr.expr_doc()))
