import:
	json: JsonValue


pure func missing_field(key: String) -> String:
	"missing formatter JSON field: " + key


pure func expected_field(key: String, expected: String) -> String:
	"expected formatter JSON field '" + key + "' to be " + expected


pure func field(value: JsonValue, key: String) -> Result[JsonValue, String]:
	match value.get_field(key):
		Some(child): Ok(child)
		None: Err(missing_field(key))


pure func string_field(value: JsonValue, key: String) -> Result[String, String]:
	child ?= value.field(key)

	match child.as_string():
		Some(s): Ok(s)
		None: Err(expected_field(key, "a string"))


pure func int_field(value: JsonValue, key: String) -> Result[Int, String]:
	child ?= value.field(key)

	match child.as_number():
		Some(n): Ok(to_int(n))
		None: Err(expected_field(key, "a number"))


pure func bool_field(value: JsonValue, key: String) -> Result[Bool, String]:
	child ?= value.field(key)

	match child.as_bool():
		Some(b): Ok(b)
		None: Err(expected_field(key, "a boolean"))


pure func array_field(value: JsonValue, key: String) -> Result[List[JsonValue], String]:
	child ?= value.field(key)

	match child.as_array():
		Some(items): Ok(items)
		None: Err(expected_field(key, "an array"))


pure func parsed_array_items[T](
	items: List[JsonValue],
	parse_item: pure (JsonValue) -> Result[T, String],
) -> Result[List[T], String]:
	var result: List[T] = []
	var error: Option[String] = None

	for item in items:
		match error:
			Some(_): void
			None:
				match parse_item(item):
					Ok(parsed): result = result.append(parsed)
					Err(msg): error = Some(msg)

	match error:
		Some(msg): Err(msg)
		None: Ok(result)


pure func parsed_array_field[T](
	value: JsonValue,
	key: String,
	parse_item: pure (JsonValue) -> Result[T, String],
) -> Result[List[T], String]:
	items ?= value.array_field(key)
	items.parsed_array_items(parse_item)
