-- A stacked function like Option.map
pure func map[T, U](x: T, f: pure (T) -> U) -> U:
	f(x)


func map[T, U](x: T, f: (T) -> U) -> U:
	f(x)


-- A function that calls the impure variant
func test_impure(x: Int) -> Int:
	x.map(func(n: Int):
		print("impure!")
		n + 1
	)


-- A function that calls the pure variant
func test_pure(x: Int) -> Int:
	x.map(pure func(n: Int): n + 1)
