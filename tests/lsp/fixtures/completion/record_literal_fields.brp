record Point {x: Int, y: Int}

func main(args: List[String]) -> Int:
    point: Point = {x = 1, y = 2}
    literal: Point = {x = 3, y = 4}
--                    ^literal_field
    remaining: Point = {x = 5, y = 6}
--                            ^remaining_field
    updated: Point = {point | x = 7, y = 8}
--                            ^update_field
    updated.y
