import:
	graph as Graph
	list as L
	test: TestSuite


-- Test new graph is empty
func test_new_empty() -> Bool:
	g: List[Int] = Graph.graph()
	Graph.node_count(g) == 0 and Graph.edge_count(g) == 0


-- Test add node
func test_add_node() -> Bool:
	g: List[Int] = Graph.add_node(Graph.graph(), 1)
	Graph.node_count(g) == 1


-- Test add duplicate node
func test_add_dup_node() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_node(g, 1)
	g = Graph.add_node(g, 1)
	Graph.node_count(g) == 1


-- Test add edge
func test_add_edge() -> Bool:
	g: List[Int] = Graph.add_edge(Graph.graph(), 1, 2, 1)
	Graph.has_edge(g, 1, 2) and not Graph.has_edge(g, 2, 1)


-- Test add edge auto-creates nodes
func test_edge_auto_nodes() -> Bool:
	g: List[Int] = Graph.add_edge(Graph.graph(), 1, 2, 1)
	Graph.has_node(g, 1) and Graph.has_node(g, 2)


-- Test undirected edge
func test_undirected() -> Bool:
	g: List[Int] = Graph.add_undirected_edge(Graph.graph(), 1, 2, 5)
	Graph.has_edge(g, 1, 2) and Graph.has_edge(g, 2, 1)


-- Test neighbors
func test_neighbors() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_edge(g, 1, 2, 1)
	g = Graph.add_edge(g, 1, 3, 1)
	g = Graph.add_edge(g, 2, 3, 1)
	nbrs: List[Int] = Graph.neighbors(g, 1)
	nbrs.length() == 2


-- Test BFS
func test_bfs() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_edge(g, 1, 2, 1)
	g = Graph.add_edge(g, 1, 3, 1)
	g = Graph.add_edge(g, 2, 4, 1)
	g = Graph.add_edge(g, 3, 4, 1)
	visited: List[Int] = Graph.bfs(g, 1)
	visited.length() == 4


-- Test BFS start node first
func test_bfs_start() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_edge(g, 1, 2, 1)
	visited: List[Int] = Graph.bfs(g, 1)
	match L.get(visited, 0):
		Some(v): v == 1
		None: False


-- Test DFS
func test_dfs() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_edge(g, 1, 2, 1)
	g = Graph.add_edge(g, 2, 3, 1)
	g = Graph.add_edge(g, 3, 4, 1)
	visited: List[Int] = Graph.dfs(g, 1)
	visited.length() == 4


-- Test shortest path direct
func test_shortest_direct() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_edge(g, 1, 2, 5)
	match Graph.shortest_path(g, 1, 2):
		Some(d): d == 5
		None: False


-- Test shortest path via intermediate
func test_shortest_via() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_edge(g, 1, 2, 4)
	g = Graph.add_edge(g, 1, 3, 1)
	g = Graph.add_edge(g, 3, 2, 2)
	match Graph.shortest_path(g, 1, 2):
		Some(d): d == 3
		None: False


-- Test shortest path unreachable
func test_shortest_unreachable() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_node(g, 1)
	g = Graph.add_node(g, 2)
	match Graph.shortest_path(g, 1, 2):
		Some(_): False
		None: True


-- Test topological sort
func test_topo_sort() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_edge(g, 1, 2, 1)
	g = Graph.add_edge(g, 1, 3, 1)
	g = Graph.add_edge(g, 2, 4, 1)
	g = Graph.add_edge(g, 3, 4, 1)
	sorted: List[Int] = Graph.topological_sort(g)
	sorted.length() == 4


-- Test topo sort ordering
func test_topo_order() -> Bool:
	var g: List[Int] = Graph.graph()
	g = Graph.add_edge(g, 1, 2, 1)
	g = Graph.add_edge(g, 2, 3, 1)
	sorted: List[Int] = Graph.topological_sort(g)
	match L.get(sorted, 0):
		Some(v): v == 1
		None: False


tests: TestSuite = {
	description = "Graph",
	tests = [
		("new empty", test_new_empty),
		("add node", test_add_node),
		("add dup node", test_add_dup_node),
		("add edge", test_add_edge),
		("edge auto nodes", test_edge_auto_nodes),
		("undirected", test_undirected),
		("neighbors", test_neighbors),
		("bfs", test_bfs),
		("bfs start", test_bfs_start),
		("dfs", test_dfs),
		("shortest direct", test_shortest_direct),
		("shortest via", test_shortest_via),
		("shortest unreachable", test_shortest_unreachable),
		("topo sort", test_topo_sort),
		("topo order", test_topo_order),
	],
}
