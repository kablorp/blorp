-- Set[UserType] works when UserType implements Hashable + Equatable.
-- Structural equality is honored across distinct allocations.
import:
	set: set
	test: TestSuite


record Widget {id: Int, tag: Int}


implements Equatable for Widget:
	pure func equals(a: Widget, b: Widget) -> Bool:
		a.id == b.id and a.tag == b.tag


implements Hashable for Widget:
	pure func hash(self: Widget) -> Int:
		self.id * 31 + self.tag


func test_contains_after_add() -> Bool:
	var s: Set[Widget] = set()
	s = s.add({id = 1, tag = 2})
	s.contains({id = 1, tag = 2})


func test_distinct_allocs_same_key() -> Bool:
	var s: Set[Widget] = set()
	s = s.add({id = 3, tag = 3})
	a: Widget = {id = 3, tag = 3}
	s.contains(a)


func test_distinct_keys() -> Bool:
	var s: Set[Widget] = set()
	s = s.add({id = 1, tag = 1})
	s = s.add({id = 2, tag = 2})
	s.contains(
		{id = 1, tag = 1},
	) and s.contains({id = 2, tag = 2}) and not s.contains({id = 3, tag = 3})


tests: TestSuite = {
	description = "Set with user-defined Hashable+Equatable keys",
	tests = [
		("contains after add", test_contains_after_add),
		("distinct allocs same key", test_distinct_allocs_same_key),
		("distinct keys", test_distinct_keys),
	],
}
