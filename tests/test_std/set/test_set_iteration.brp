-- Regression: `for x in s:` on a Set must yield each element exactly
-- once, in insertion order. Pre-fix the codegen routed Set for-in
-- through emit_for_list (which casts to blorp_List* and reads ->data
-- via flat indexing) — but blorp_Set is a hash-table-with-linked-list
-- with a completely different layout. Reading set->buckets as
-- list->data[i] returned random heap addresses, and the iteration
-- "size" was set->capacity (over-counted bucket slots), so the
-- visible sub-test failures were "Set for-in" expecting sum=60 but
-- getting an arbitrary number.
--
-- Long-term shape: blorp_Set carries an insertion-order linked list
-- (first / next_order). The fix walks that chain directly — no list
-- materialization, no allocation, O(n) over actual entries.
import:
	set as S
	test: TestSuite


-- Sum elements via for-in. Insertion order: 10, 20, 30. Expect 60.
func test_for_in_sum_int() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 10)
	s = S.add(s, 20)
	s = S.add(s, 30)
	var total: Int = 0
	for elem in s:
		total += elem
	total == 60


-- Each element yielded exactly once even when added more than once
-- (Set deduplicates on add).
func test_for_in_unique_visit() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 1)
	s = S.add(s, 2)
	s = S.add(s, 1) -- duplicate add — should be a no-op
	s = S.add(s, 3)
	var count: Int = 0
	for _ in s:
		count += 1
	count == 3


-- String elements (RC payload) — exercises the key_release path during
-- iteration without leaking.
func test_for_in_strings() -> Bool:
	var s: Set[String] = S.set()
	s = S.add(s, "alpha")
	s = S.add(s, "beta")
	s = S.add(s, "gamma")
	var found_beta: Bool = False
	for x in s:
		if x == "beta":
			found_beta = True
	found_beta


-- Empty set yields no elements.
func test_for_in_empty() -> Bool:
	s: Set[Int] = S.set()
	var count: Int = 0
	for _ in s:
		count += 1
	count == 0


-- After remove, the removed element is not yielded.
func test_for_in_after_remove() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 1)
	s = S.add(s, 2)
	s = S.add(s, 3)
	s = S.remove(s, 2)
	var total: Int = 0
	for elem in s:
		total += elem
	total == 4 -- 1 + 3


-- Reassign-during-iter: the body assigns a new value to [s] each
-- iteration, but the loop continues over the ORIGINAL set captured
-- at loop entry. Pins the contract that the iter target is borrowed
-- for the body's duration even when the source variable is reassigned.
-- The original {1, 2, 3} is iterated; the reassignments don't redirect
-- the loop. Set add is COW (returns a new blorp_Set*), so the original
-- stays alive for the borrow's lifetime.
func test_for_in_reassign_during_iter() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 1)
	s = S.add(s, 2)
	s = S.add(s, 3)
	var total: Int = 0
	for elem in s:
		total += elem
		s = S.add(s, elem + 100) -- reassign s to a new (larger) set
	-- Original sum is 6; the new s should have 6 elements (originals + 3 added).
	total == 6 and s.length() == 6


tests: TestSuite = {
	description = "Set for-in iteration",
	tests = [
		("for-in sum (Int)", test_for_in_sum_int),
		("for-in unique visit (dedup)", test_for_in_unique_visit),
		("for-in strings (RC keys)", test_for_in_strings),
		("for-in empty set", test_for_in_empty),
		("for-in after remove", test_for_in_after_remove),
		("for-in with reassign during iter", test_for_in_reassign_during_iter),
	],
}
