import:
	set as S
	test: TestSuite


-- Test Set functionality with qualified imports
tests: TestSuite = {
	description = "Set Tests",
	tests = [
		("Empty set has length 0", func():
			var s: Set[Int] = S.set()
			s.length() == 0
		),
		("Add and contains", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 42)
			S.contains(s, 42)
		),
		("Contains missing element", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 1)
			not S.contains(s, 99)
		),
		("Remove deletes element", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 10)
			s = S.remove(s, 10)
			not S.contains(s, 10)
		),
		("Add duplicate is idempotent", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 5)
			s = S.add(s, 5)
			s.length() == 1
		),
		("String elements work", func():
			var s: Set[String] = S.set()
			s = S.add(s, "hello")
			s = S.add(s, "world")
			S.contains(s, "hello") and S.contains(s, "world")
		),
		("Length tracks additions", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 1)
			s = S.add(s, 2)
			s = S.add(s, 3)
			s.length() == 3
		),
		("Length decreases after remove", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 1)
			s = S.add(s, 2)
			s = S.remove(s, 1)
			s.length() == 1
		),
		("Combine (union)", func():
			var a: Set[Int] = S.set()
			a = S.add(a, 1)
			a = S.add(a, 2)
			var b: Set[Int] = S.set()
			b = S.add(b, 2)
			b = S.add(b, 3)
			var c: Set[Int] = S.combine(a, b)
			c.length() == 3 and S.contains(c, 1) and S.contains(c, 2) and S.contains(c, 3)
		),
		("Intersect", func():
			var a: Set[Int] = S.from_list([1, 2, 3])
			var b: Set[Int] = S.from_list([2, 3, 4])
			var c: Set[Int] = S.intersect(a, b)
			c.length() == 2 and S.contains(c, 2) and S.contains(c, 3)
		),
		("Difference", func():
			var a: Set[Int] = S.from_list([1, 2, 3])
			var b: Set[Int] = S.from_list([2, 3])
			var c: Set[Int] = S.difference(a, b)
			c.length() == 1 and S.contains(c, 1)
		),
		("From list deduplicates", func():
			var s: Set[Int] = S.from_list([1, 2, 3, 2, 1])
			s.length() == 3
		),
		("For-in iterates elements", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 10)
			s = S.add(s, 20)
			s = S.add(s, 30)
			var total: Int = 0

			for elem in s:
				total += elem

			total == 60
		),
		("COW alias independence", func():
			var a: Set[Int] = S.set()
			a = S.add(a, 1)
			a = S.add(a, 2)
			var b: Set[Int] = a
			b = S.add(b, 3)
			a.length() == 2 and b.length() == 3
		),
		("Is empty", func():
			var s: Set[Int] = S.set()
			S.is_empty(s)
		),
		("Is subset", func():
			var a: Set[Int] = S.from_list([1, 2])
			var b: Set[Int] = S.from_list([1, 2, 3])
			S.is_subset(a, b) and not S.is_subset(b, a)
		),
		("Is superset", func():
			var a: Set[Int] = S.from_list([1, 2, 3])
			var b: Set[Int] = S.from_list([1, 2])
			S.is_superset(a, b)
		),
		("Insertion order preserved", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 30)
			s = S.add(s, 10)
			s = S.add(s, 20)
			items: List[Int] = S.to_list(s)
			match items.get(0):
				Some(v):
					v == 30
				None:
					False and match items.get(1):
				Some(v):
					v == 10
				None:
					False and match items.get(2):
				Some(v):
					v == 20
				None:
					False
		),
		("Order preserved after remove", func():
			var s: Set[Int] = S.set()
			s = S.add(s, 10)
			s = S.add(s, 20)
			s = S.add(s, 30)
			s = S.remove(s, 20)
			items: List[Int] = S.to_list(s)
			match items.get(0):
				Some(v):
					v == 10
				None:
					False and match items.get(1):
				Some(v):
					v == 30
				None:
					False
		),
		("Set union alias", func():
			var a: Set[Int] = S.from_list([1, 2])
			var b: Set[Int] = S.from_list([2, 3])
			var c: Set[Int] = S.set_union(a, b)
			c.length() == 3 and S.contains(c, 1) and S.contains(c, 2) and S.contains(c, 3)
		),
		("Set map", func():
			var s: Set[Int] = S.from_list([1, 2, 3])
			var result: Set[Int] = S.map(s, pure func(x: Int): x * 10)
			S.contains(result, 10) and S.contains(result, 20) and S.contains(result, 30)
		),
		("Set filter", func():
			var s: Set[Int] = S.from_list([1, 2, 3, 4, 5])
			var result: Set[Int] = S.filter(s, pure func(x: Int): x % 2 == 0)
			result.length() == 2 and S.contains(result, 2) and S.contains(result, 4)
		),
		("Set fold", func():
			var s: Set[Int] = S.from_list([1, 2, 3])
			var total: Int = S.fold(
				s,
				0,
				pure func(acc: Int, x: Int): acc + x,
			)
			total == 6
		),
	]
}
