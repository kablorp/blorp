import:
	set as S
	test: TestSuite


func test_eq_int() -> Bool:
	a: Set[Int] = S.from_list([1, 2, 3])
	b: Set[Int] = S.from_list([1, 2, 3])
	a == b


func test_eq_string() -> Bool:
	a: Set[String] = S.from_list(["a", "b"])
	b: Set[String] = S.from_list(["a", "b"])
	a == b


func test_neq_element() -> Bool:
	a: Set[Int] = S.from_list([1, 2, 3])
	b: Set[Int] = S.from_list([1, 2, 4])
	a != b


func test_neq_size() -> Bool:
	a: Set[Int] = S.from_list([1, 2])
	b: Set[Int] = S.from_list([1, 2, 3])
	a != b


func test_eq_empty() -> Bool:
	a: Set[Int] = S.set()
	b: Set[Int] = S.set()
	a == b


func test_eq_same_ref() -> Bool:
	a: Set[Int] = S.from_list([1, 2, 3])
	a == a


func test_eq_order_independent() -> Bool:
	-- Sets should be equal regardless of insertion order
	a: Set[Int] = S.from_list([3, 1, 2])
	b: Set[Int] = S.from_list([1, 2, 3])
	a == b


tests: TestSuite = {
	description = "Set Equality",
	tests = [
		("eq int", test_eq_int),
		("eq string", test_eq_string),
		("neq element", test_neq_element),
		("neq size", test_neq_size),
		("eq empty", test_eq_empty),
		("eq same ref", test_eq_same_ref),
		("eq order independent", test_eq_order_independent),
	],
}
