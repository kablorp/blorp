import:
	cache as C: Cache
	test: TestSuite


-- ===== Basic put/get =====
func test_put_get() -> Bool:
	var c = C.cache(10)
	c = C.put(c, "a", "one")
	match C.get(c, "a"):
		Some(v): v == "one"
		None: False


func test_get_missing() -> Bool:
	var c: Cache[String, String] = C.cache(10)
	match C.get(c, "missing"):
		Some(_): False
		None: True


func test_overwrite() -> Bool:
	var c = C.cache(10)
	c = C.put(c, "a", "first")
	c = C.put(c, "a", "second")
	match C.get(c, "a"):
		Some(v): v == "second"
		None: False


func test_size() -> Bool:
	var c: Cache[String, String] = C.cache(10)
	s0: Int = C.length(c)
	c = C.put(c, "a", "one")
	s1: Int = C.length(c)
	c = C.put(c, "b", "two")
	s2: Int = C.length(c)
	s0 == 0 and s1 == 1 and s2 == 2


func test_contains() -> Bool:
	var c: Cache[String, String] = C.cache(10)
	c = C.put(c, "x", "val")
	C.contains(c, "x") and not C.contains(c, "y")


-- ===== Eviction =====
func test_eviction_basic() -> Bool:
	-- Capacity 2: put a, b, c → a should be evicted
	var c = C.cache(2)
	c = C.put(c, "a", "one")
	c = C.put(c, "b", "two")
	c = C.put(c, "c", "three")
	not C.contains(c, "a")


func test_eviction_preserves_recent() -> Bool:
	-- Capacity 2: put a, b, c → b and c should survive
	var c = C.cache(2)
	c = C.put(c, "a", "one")
	c = C.put(c, "b", "two")
	c = C.put(c, "c", "three")
	C.contains(c, "b") and C.contains(c, "c")


func test_touch_prevents_eviction() -> Bool:
	-- Capacity 2: put a, put b, touch a, put c → b evicted, not a
	var c = C.cache(2)
	c = C.put(c, "a", "one")
	c = C.put(c, "b", "two")
	c = C.touch(c, "a")
	c = C.put(c, "c", "three")
	C.contains(c, "a") and not C.contains(c, "b") and C.contains(c, "c")


func test_capacity_one() -> Bool:
	var c = C.cache(1)
	c = C.put(c, "a", "one")
	c = C.put(c, "b", "two")
	C.length(c) == 1 and C.contains(c, "b") and not C.contains(c, "a")


-- ===== Remove =====
func test_remove() -> Bool:
	var c = C.cache(10)
	c = C.put(c, "a", "one")
	c = C.put(c, "b", "two")
	c = C.remove(c, "a")
	C.length(c) == 1 and not C.contains(c, "a") and C.contains(c, "b")


func test_remove_missing() -> Bool:
	var c = C.cache(10)
	c = C.put(c, "a", "one")
	c = C.remove(c, "nonexistent")
	C.length(c) == 1


-- ===== Churn =====
-- NOTE: test_many_puts triggers exit 118 (leak detector) due to known Dict COW
-- aliasing issue with tuple values during eviction. All assertions pass correctly.
-- The leak occurs during cleanup, not during cache operations.
func test_many_puts() -> Bool:
	var c = C.cache(3)
	c = C.put(c, "a", "1")
	c = C.put(c, "b", "2")
	c = C.put(c, "c", "3")
	c = C.put(c, "d", "4")
	c = C.put(c, "e", "5")
	-- Only last 3 should survive
	C.length(
		c,
	) == 3 and C.contains(
		c,
		"c",
	) and C.contains(
		c,
		"d",
	) and C.contains(c, "e") and not C.contains(c, "a") and not C.contains(c, "b")


tests: TestSuite = {
	description = "LRU Cache",
	tests = [
		("put and get", test_put_get),
		("get missing", test_get_missing),
		("overwrite", test_overwrite),
		("size", test_size),
		("contains", test_contains),
		("eviction basic", test_eviction_basic),
		("eviction preserves recent", test_eviction_preserves_recent),
		("touch prevents eviction", test_touch_prevents_eviction),
		("capacity one", test_capacity_one),
		("remove", test_remove),
		("remove missing", test_remove_missing),
		("many puts", test_many_puts),
	],
}
