import:
	instrumentation: black_box_float, black_box_int, elapsed_duration, elapsed_microseconds, time_it
	test: TestSuite
	units: Duration, to_microseconds


func test_black_box_int() -> Bool:
	black_box_int(42) == 42


func test_black_box_float() -> Bool:
	black_box_float(3.5) == 3.5


func test_elapsed_microseconds() -> Bool:
	elapsed_microseconds(100, 550) == 450


func test_elapsed_duration() -> Bool:
	duration: Duration = elapsed_duration(100, 550)
	to_microseconds(duration) == 450


func test_time_it() -> Bool:
	elapsed: Duration = time_it(func(): void)
	to_microseconds(elapsed) >= 0


tests: TestSuite = {
	description = "Instrumentation",
	tests = [
		("black_box_int", test_black_box_int),
		("black_box_float", test_black_box_float),
		("elapsed microseconds", test_elapsed_microseconds),
		("elapsed duration", test_elapsed_duration),
		("time_it", test_time_it),
	]
}
