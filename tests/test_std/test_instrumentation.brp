import:
	instrumentation: black_box_float, black_box_int, elapsed_us, time_it
	test: TestSuite


func test_black_box_int() -> Bool:
	black_box_int(42) == 42


func test_black_box_float() -> Bool:
	black_box_float(3.5) == 3.5


func test_elapsed_us() -> Bool:
	elapsed_us(100, 550) == 450


func test_time_it() -> Bool:
	elapsed: Int = time_it(func(): void)
	elapsed >= 0


tests: TestSuite = {
	description = "Instrumentation",
	tests = [
		("black_box_int", test_black_box_int),
		("black_box_float", test_black_box_float),
		("elapsed_us", test_elapsed_us),
		("time_it", test_time_it),
	],
}
