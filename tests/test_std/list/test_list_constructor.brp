import:
	list: list
	test: TestSuite


func test_empty_length() -> Bool:
	xs: List[Int] = list(100)
	xs.length() == 0


func test_is_empty() -> Bool:
	xs: List[String] = list(16)
	xs.is_empty()


func test_small_capacity() -> Bool:
	xs: List[Float] = list(1)
	xs.length() == 0


func test_zero_capacity() -> Bool:
	-- Runtime clamps to min 1 slot; caller still sees length 0.
	xs: List[Int] = list(0)
	xs.length() == 0


func test_append_works() -> Bool:
	var xs: List[Int] = list(32)
	for i in 0..10:
		xs = xs.append(i * 2)
	xs.length() == 10


func test_append_past_capacity_grows() -> Bool:
	-- Request small capacity, append beyond it — growth still works.
	var xs: List[Int] = list(2)
	for i in 0..20:
		xs = xs.append(i)
	match xs.get(19):
		Some(v): v == 19
		None: False


func test_element_values_preserved() -> Bool:
	var xs: List[Int] = list(8)
	for i in 0..5:
		xs = xs.append(i * i)
	match xs.get(4):
		Some(v): v == 16
		None: False


tests: TestSuite = {
	description = "List constructor list(n)",
	tests = [
		("empty length is 0", test_empty_length),
		("is_empty returns true", test_is_empty),
		("capacity 1 works", test_small_capacity),
		("capacity 0 clamps at runtime", test_zero_capacity),
		("append after list(n) works", test_append_works),
		("append past capacity grows", test_append_past_capacity_grows),
		("element values preserved", test_element_values_preserved),
	]
}
