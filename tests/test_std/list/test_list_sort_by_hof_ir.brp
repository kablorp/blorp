import:
	list: get, length, sort_by, sort_desc_by
	memory: MemStats, get_mem_stats, mem_delta
	test: TestSuite


struct SortPoint {idx: Int, depth: Float}


func test_sort_by_orders_by_key() -> Bool:
	words: List[String] = ["pear", "fig", "apple", "kiwi"]
	sorted: List[String] = words.sort_by(func(s: String): s.length())
	match sorted.get(0):
		Some(first):
			match sorted.get(3):
				Some(last): first == "fig" and last == "apple"
				None: False
		None: False


func test_sort_by_is_stable_for_equal_keys() -> Bool:
	pairs: List[(Int, String)] = [(2, "a"), (1, "b"), (2, "c"), (1, "d")]
	sorted: List[(Int, String)] = pairs.sort_by(func(p: (Int, String)): p.0)
	match sorted.get(0):
		Some(first):
			match sorted.get(1):
				Some(second):
					match sorted.get(2):
						Some(third):
							match sorted.get(3):
								Some(fourth):
									first.1 == "b" and second.1 == "d" and third.1 == "a" and fourth.1 == "c"
								None: False
						None: False
				None: False
		None: False


func test_sort_desc_by_is_stable_for_equal_keys() -> Bool:
	pairs: List[(Int, String)] = [(2, "a"), (1, "b"), (2, "c"), (1, "d")]
	sorted: List[(Int, String)] = pairs.sort_desc_by(func(p: (Int, String)): p.0)
	match sorted.get(0):
		Some(first):
			match sorted.get(1):
				Some(second):
					match sorted.get(2):
						Some(third):
							match sorted.get(3):
								Some(fourth):
									first.1 == "a" and second.1 == "c" and third.1 == "b" and fourth.1 == "d"
								None: False
						None: False
				None: False
		None: False


func sort_managed_once(items: List[(String, String)]) -> Int:
	sorted: List[(String, String)] = items.sort_by(func(p: (String, String)): p.1 + "!")
	sorted.length()


func test_sort_by_managed_values_and_keys_do_not_leak() -> Bool:
	items: List[(String, String)] = [("bear", "b"), ("ant", "a"), ("cat", "c"), ("dog", "d")]
	before: MemStats = get_mem_stats()
	var i: Int = 0
	var total: Int = 0
	while i < 30:
		total += sort_managed_once(items)
		i += 1
	after: MemStats = get_mem_stats()
	delta: MemStats = mem_delta(before, after)
	match items.get(0):
		Some(first):
			total == 120 and first.0 == "bear" and delta.current_objects <= 8
		None:
			False


func test_sort_by_value_struct_orders_by_field() -> Bool:
	points: List[SortPoint] = [
		{idx = 1, depth = 3.0},
		{idx = 2, depth = 1.0},
		{idx = 3, depth = 2.0},
	]
	sorted: List[SortPoint] = points.sort_by(func(p: SortPoint): p.depth)
	match sorted.get(0):
		Some(first):
			match sorted.get(1):
				Some(second):
					match sorted.get(2):
						Some(third): first.idx == 2 and second.idx == 3 and third.idx == 1
						None: False
				None: False
		None: False


tests: TestSuite = {
	description = "List sort_by IR HOF",
	tests = [
		("sort_by orders by key", test_sort_by_orders_by_key),
		("sort_by is stable for equal keys", test_sort_by_is_stable_for_equal_keys),
		("sort_desc_by is stable for equal keys", test_sort_desc_by_is_stable_for_equal_keys),
		(
			"sort_by managed values and keys do not leak",
			test_sort_by_managed_values_and_keys_do_not_leak,
		),
		("sort_by value struct orders by field", test_sort_by_value_struct_orders_by_field),
	],
}
