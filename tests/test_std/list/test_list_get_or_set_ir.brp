import:
	memory: MemStats, get_mem_stats, mem_delta
	test: TestSuite


func test_get_or_in_bounds() -> Bool:
	[10, 20, 30].get_or(1, 0) == 20


func test_get_or_out_of_bounds() -> Bool:
	[10, 20, 30].get_or(99, 7) == 7


func test_set_in_bounds() -> Bool:
	[1, 2, 3].set(1, 99) == [1, 99, 3]


func test_set_out_of_bounds_returns_original() -> Bool:
	[1, 2, 3].set(99, 99) == [1, 2, 3]


func touch_strings(items: List[String]) -> Int:
	updated: List[String] = items.set(1, "bee")
	updated
		.get_or(0, "")
		.length() + updated
		.get_or(1, "")
		.length()


func test_managed_strings_do_not_leak() -> Bool:
	items: List[String] = ["ant", "bat", "cat"]
	before: MemStats = get_mem_stats()
	var total: Int = 0
	var i: Int = 0
	while i < 50:
		total += touch_strings(items)
		i += 1
	after: MemStats = get_mem_stats()
	delta: MemStats = mem_delta(before, after)
	total == 300 and delta.current_objects <= 8


tests: TestSuite = {
	description = "List get_or/set IR",
	tests = [
		("get_or in bounds", test_get_or_in_bounds),
		("get_or out of bounds", test_get_or_out_of_bounds),
		("set in bounds", test_set_in_bounds),
		("set out of bounds returns original", test_set_out_of_bounds_returns_original),
		("managed strings do not leak", test_managed_strings_do_not_leak),
	]
}
