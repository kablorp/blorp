import:
	list: get, map_indexed, zip_with
	test: TestSuite


func label_index(i: Int, _: Int) -> String:
	if i == 0:
		"zero"
	else if i == 1:
		"one"
	else:
		"many"


func append_index(x: Int, s: String) -> String:
	s + x.to_string()


func test_map_indexed_managed_output() -> Bool:
	nums: List[Int] = [10, 20, 30]
	labels: List[String] = nums.map_indexed(label_index)
	match labels.get(0):
		Some(first):
			match labels.get(2):
				Some(third): first == "zero" and third == "many"
				None: False
		None: False


func test_zip_with_managed_output_uses_shorter_length() -> Bool:
	nums: List[Int] = [1, 2]
	words: List[String] = ["a", "b", "c"]
	zipped: List[String] = nums.zip_with(words, append_index)
	match zipped.get(0):
		Some(first):
			match zipped.get(1):
				Some(second): zipped.length() == 2 and first == "a1" and second == "b2"
				None: False
		None: False


tests: TestSuite = {
	description = "List output HOF IR",
	tests = [
		("map_indexed managed output", test_map_indexed_managed_output),
		(
			"zip_with managed output uses shorter length",
			test_zip_with_managed_output_uses_shorter_length,
		),
	],
}
