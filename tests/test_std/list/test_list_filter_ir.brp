import:
	list: filter, get, length
	memory: MemStats, get_mem_stats, mem_delta
	test: TestSuite


pure func filter_long_words_once(words: List[String]) -> Int:
	long_words: List[String] = words.filter(pure func(s: String): s.length() > 3)
	long_words.length()


func test_filter_managed_elements_no_leak_or_dangling_alias() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin", "eel", "fox", "goat"]
	before: MemStats = get_mem_stats()
	var i: Int = 0
	var total: Int = 0
	while i < 30:
		total += filter_long_words_once(words)
		i += 1
	after: MemStats = get_mem_stats()
	delta: MemStats = mem_delta(before, after)
	match words.get(1):
		Some(word):
			total == 90 and word == "bear" and delta.current_objects <= 5
		None:
			False


func test_filter_preserves_string_values() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin"]
	long_words: List[String] = words.filter(pure func(s: String): s.length() > 3)
	match long_words.get(1):
		Some(word): word == "dolphin"
		None: False


tests: TestSuite = {
	description = "List filter IR ownership",
	tests = [
		(
			"filter managed elements no leak or dangling alias",
			test_filter_managed_elements_no_leak_or_dangling_alias,
		),
		("filter preserves string values", test_filter_preserves_string_values),
	],
}
