import:
	list: chunks, get, scan, windows
	test: TestSuite


-- ============================================================================
-- windows
-- ============================================================================
pure func test_windows_basic() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	w: List[List[Int]] = windows(nums, 3)
	w.length() == 3


pure func test_windows_size_2() -> Bool:
	nums: List[Int] = [10, 20, 30, 40]
	w: List[List[Int]] = windows(nums, 2)

	-- Should have 3 windows: [10,20], [20,30], [30,40]
	w.length() == 3


pure func test_windows_size_1() -> Bool:
	nums: List[Int] = [1, 2, 3]
	w: List[List[Int]] = windows(nums, 1)
	w.length() == 3


pure func test_windows_full_size() -> Bool:
	nums: List[Int] = [1, 2, 3]
	w: List[List[Int]] = windows(nums, 3)
	w.length() == 1


pure func test_windows_too_large() -> Bool:
	nums: List[Int] = [1, 2]
	w: List[List[Int]] = windows(nums, 5)
	w.length() == 0


pure func test_windows_zero() -> Bool:
	nums: List[Int] = [1, 2, 3]
	w: List[List[Int]] = windows(nums, 0)
	w.length() == 0


pure func test_windows_negative() -> Bool:
	nums: List[Int] = [1, 2, 3]
	w: List[List[Int]] = windows(nums, -1)
	w.length() == 0


pure func test_windows_content() -> Bool:
	nums: List[Int] = [1, 2, 3, 4]
	w: List[List[Int]] = windows(nums, 2)

	-- Each window has length 2
	w.length() == 3


-- ============================================================================
-- chunks
-- ============================================================================
pure func test_chunks_even() -> Bool:
	nums: List[Int] = [1, 2, 3, 4]
	c: List[List[Int]] = chunks(nums, 2)
	c.length() == 2


pure func test_chunks_uneven() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	c: List[List[Int]] = chunks(nums, 2)

	-- 3 chunks: [1,2], [3,4], [5]
	c.length() == 3


pure func test_chunks_last_smaller() -> Bool:
	-- 7 elements chunked by 3 gives [3, 3, 1] sizes
	nums: List[Int] = [1, 2, 3, 4, 5, 6, 7]
	c: List[List[Int]] = chunks(nums, 3)
	c.length() == 3


pure func test_chunks_size_1() -> Bool:
	nums: List[Int] = [1, 2, 3]
	c: List[List[Int]] = chunks(nums, 1)
	c.length() == 3


pure func test_chunks_full_size() -> Bool:
	nums: List[Int] = [1, 2, 3]
	c: List[List[Int]] = chunks(nums, 3)
	c.length() == 1


pure func test_chunks_larger_than_list() -> Bool:
	nums: List[Int] = [1, 2]
	c: List[List[Int]] = chunks(nums, 5)
	c.length() == 1


pure func test_chunks_zero() -> Bool:
	nums: List[Int] = [1, 2, 3]
	c: List[List[Int]] = chunks(nums, 0)
	c.length() == 0


pure func test_chunks_content() -> Bool:
	nums: List[Int] = [10, 20, 30, 40]
	c: List[List[Int]] = chunks(nums, 2)

	-- 2 chunks of 2 elements each
	c.length() == 2


-- ============================================================================
-- scan
-- ============================================================================
pure func test_scan_sum() -> Bool:
	nums: List[Int] = [1, 2, 3]
	s: List[Int] = scan(nums, 0, pure func(acc: Int, x: Int): acc + x)

	-- [0, 1, 3, 6]
	s.length() == 4


pure func test_scan_includes_init() -> Bool:
	nums: List[Int] = [10, 20]
	s: List[Int] = scan(nums, 0, pure func(acc: Int, x: Int): acc + x)

	-- First element should be the init value (0)
	match get(s, 0):
		Some(v): v == 0
		None: False


pure func test_scan_running_product() -> Bool:
	nums: List[Int] = [2, 3, 4]
	s: List[Int] = scan(nums, 1, pure func(acc: Int, x: Int): acc * x)

	-- [1, 2, 6, 24]
	last: Int = match get(s, 3):
		Some(v): v
		None: 0
	last == 24


pure func test_scan_empty() -> Bool:
	nums: List[Int] = []
	s: List[Int] = scan(nums, 42, pure func(acc: Int, x: Int): acc + x)

	-- Just the init value
	s.length() == 1


pure func test_scan_values() -> Bool:
	nums: List[Int] = [1, 2, 3]
	s: List[Int] = scan(nums, 0, pure func(acc: Int, x: Int): acc + x)

	-- Verify all intermediate values: [0, 1, 3, 6]
	v0: Int = match get(s, 0):
		Some(v): v
		None: -1
	v1: Int = match get(s, 1):
		Some(v): v
		None: -1
	v2: Int = match get(s, 2):
		Some(v): v
		None: -1
	v3: Int = match get(s, 3):
		Some(v): v
		None: -1
	v0 == 0 and v1 == 1 and v2 == 3 and v3 == 6


pure func test_windows_empty() -> Bool:
	nums: List[Int] = []
	w: List[List[Int]] = windows(nums, 2)
	w.length() == 0


pure func test_chunks_empty() -> Bool:
	nums: List[Int] = []
	c: List[List[Int]] = chunks(nums, 3)
	c.length() == 0


pure func test_chunks_negative() -> Bool:
	nums: List[Int] = [1, 2, 3]
	c: List[List[Int]] = chunks(nums, -1)
	c.length() == 0


tests: TestSuite = {
	description = "List Windows, Chunks, and Scan",
	tests = [
		("windows basic", test_windows_basic),
		("windows size 2", test_windows_size_2),
		("windows size 1", test_windows_size_1),
		("windows full size", test_windows_full_size),
		("windows too large", test_windows_too_large),
		("windows zero", test_windows_zero),
		("windows negative", test_windows_negative),
		("windows content", test_windows_content),
		("windows empty", test_windows_empty),
		("chunks even", test_chunks_even),
		("chunks uneven", test_chunks_uneven),
		("chunks last smaller", test_chunks_last_smaller),
		("chunks size 1", test_chunks_size_1),
		("chunks full size", test_chunks_full_size),
		("chunks larger than list", test_chunks_larger_than_list),
		("chunks zero", test_chunks_zero),
		("chunks negative", test_chunks_negative),
		("chunks empty", test_chunks_empty),
		("chunks content", test_chunks_content),
		("scan sum", test_scan_sum),
		("scan includes init", test_scan_includes_init),
		("scan running product", test_scan_running_product),
		("scan empty", test_scan_empty),
		("scan values", test_scan_values),
	]
}
