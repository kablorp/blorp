import:
	list: filter_map, get, length
	memory: MemStats, get_mem_stats, mem_delta
	test: TestSuite


pure func long_word_length(s: String) -> Option[Int]:
	if s.length() > 3:
		Some(s.length())
	else:
		None


pure func shout_long_word(s: String) -> Option[String]:
	if s.length() > 3:
		Some(s + "!")
	else:
		None


pure func filter_map_managed_once(words: List[String]) -> Int:
	kept: List[String] = words.filter_map(shout_long_word)
	kept.length()


func test_filter_map_preserves_values() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin"]
	lengths: List[Int] = words.filter_map(long_word_length)
	shouted: List[String] = words.filter_map(shout_long_word)
	match lengths.get(0):
		Some(first):
			match lengths.get(1):
				Some(second):
					match shouted.get(1):
						Some(word): first == 4 and second == 7 and word == "dolphin!"
						None: False
				None: False
		None: False


func test_filter_map_managed_result_no_leak_or_dangling_alias() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin", "eel", "fox", "goat"]
	before: MemStats = get_mem_stats()
	var i: Int = 0
	var total: Int = 0
	while i < 30:
		total += filter_map_managed_once(words)
		i += 1
	after: MemStats = get_mem_stats()
	delta: MemStats = mem_delta(before, after)
	match words.get(1):
		Some(word):
			total == 90 and word == "bear" and delta.current_objects <= 5
		None:
			False


tests: TestSuite = {
	description = "List filter_map IR ownership",
	tests = [
		("filter_map preserves values", test_filter_map_preserves_values),
		(
			"filter_map managed result no leak or dangling alias",
			test_filter_map_managed_result_no_leak_or_dangling_alias,
		),
	],
}
