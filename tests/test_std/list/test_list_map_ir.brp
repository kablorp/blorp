import:
	list: get, length, map
	memory: MemStats, get_mem_stats, mem_delta
	test: TestSuite


func range_list(n: Int) -> List[Int]:
	var result: List[Int] = []
	var i: Int = 0
	while i < n:
		result = result.append(i)
		i += 1
	result


pure func map_managed_once(nums: List[Int]) -> Int:
	result: List[(Int, Int)] = nums.map(pure func(x: Int): (x, x))
	result.length()


func test_map_managed_result_no_leak() -> Bool:
	nums: List[Int] = range_list(128)
	before: MemStats = get_mem_stats()
	var i: Int = 0
	var total: Int = 0
	while i < 30:
		total += map_managed_once(nums)
		i += 1
	after: MemStats = get_mem_stats()
	delta: MemStats = mem_delta(before, after)
	total == 3840 and delta.current_objects <= 5


pure func map_last_doubled_value() -> Int:
	nums: List[Int] = [1, 2, 3]
	doubled: List[Int] = nums.map(pure func(x: Int): x * 2)
	match get(doubled, 2):
		Some(v): v
		None: 0


func test_map_preserves_values() -> Bool:
	map_last_doubled_value() == 6


tests: TestSuite = {
	description = "List map IR ownership",
	tests = [
		("map managed result no leak", test_map_managed_result_no_leak),
		("map preserves values", test_map_preserves_values),
	],
}
