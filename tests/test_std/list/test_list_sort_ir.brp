import:
	list: get, length, sort
	memory: MemStats, get_mem_stats, mem_delta
	test: TestSuite


func test_sort_orders_ints() -> Bool:
	sort([5, 1, 3, 1, 2]) == [1, 1, 2, 3, 5]


func test_sort_orders_strings() -> Bool:
	sorted: List[String] = ["pear", "fig", "apple", "kiwi"].sort()
	match sorted.get(0):
		Some(first):
			match sorted.get(3):
				Some(last): first == "apple" and last == "pear"
				None: False
		None: False


func sort_strings_once(items: List[String]) -> Int:
	sorted: List[String] = items.sort()
	sorted.length()


func test_sort_managed_strings_do_not_leak() -> Bool:
	items: List[String] = ["bear", "ant", "cat", "dog"]
	before: MemStats = get_mem_stats()
	var i: Int = 0
	var total: Int = 0
	while i < 30:
		total += sort_strings_once(items)
		i += 1
	after: MemStats = get_mem_stats()
	delta: MemStats = mem_delta(before, after)
	total == 120 and delta.current_objects <= 8


tests: TestSuite = {
	description = "List sort IR",
	tests = [
		("sort orders ints", test_sort_orders_ints),
		("sort orders strings", test_sort_orders_strings),
		("sort managed strings do not leak", test_sort_managed_strings_do_not_leak),
	]
}
