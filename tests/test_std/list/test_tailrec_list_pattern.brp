import:
	test: TestSuite


@tailrec
func sum_recursive(lst: List[Int], acc: Int) -> Int:
	match lst:
		[]: acc
		[x, ...rest]: sum_recursive(rest, acc + x)


func test_tailrec_list_pattern_sum() -> Bool:
	sum_recursive([1, 2, 3, 4, 5], 0) == 15


tests: TestSuite = {
	description = "Tailrec List Pattern",
	tests = [("tailrec list pattern sum", test_tailrec_list_pattern_sum)],
}
