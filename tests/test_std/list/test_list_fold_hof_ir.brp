import:
	list: fold_left, fold_right
	test: TestSuite


func append_word(acc: String, word: String) -> String:
	acc + word


func prepend_word(word: String, acc: String) -> String:
	word + acc


func keep_acc(acc: String, _: Int) -> String:
	acc


func dynamic_seed() -> String:
	"se" + "ed"


func joined_left() -> String:
	words: List[String] = ["a", "b", "c"]
	words.fold_left("", append_word)


func joined_right() -> String:
	words: List[String] = ["a", "b", "c"]
	words.fold_right("", prepend_word)


func test_fold_left_int_accumulator() -> Bool:
	nums: List[Int] = [1, 2, 3, 4]
	nums.fold_left(0, func(acc: Int, n: Int): acc + n) == 10


func test_fold_left_product_accumulator() -> Bool:
	nums: List[Int] = [2, 3, 4]
	nums.fold_left(1, func(acc: Int, n: Int): acc * n) == 24


func test_fold_left_managed_accumulator() -> Bool:
	joined_left() == "abc"


func test_fold_right_managed_accumulator() -> Bool:
	joined_right() == "abc"


func test_fold_right_order() -> Bool:
	nums: List[Int] = [1, 2, 3]
	nums.fold_right(0, func(n: Int, acc: Int): n - acc) == 2


func test_fold_left_callback_can_return_previous_managed_accumulator() -> Bool:
	nums: List[Int] = [1, 2]
	nums.fold_left(dynamic_seed(), keep_acc) == "seed"


func test_fold_left_empty_keeps_managed_init() -> Bool:
	empty: List[Int] = []
	empty.fold_left(dynamic_seed(), keep_acc) == "seed"


tests: TestSuite = {
	description = "List fold HOF IR",
	tests = [
		("fold_left int accumulator", test_fold_left_int_accumulator),
		("fold_left product accumulator", test_fold_left_product_accumulator),
		("fold_left managed accumulator", test_fold_left_managed_accumulator),
		("fold_right managed accumulator", test_fold_right_managed_accumulator),
		("fold_right order", test_fold_right_order),
		(
			"fold_left callback can return previous managed accumulator",
			test_fold_left_callback_can_return_previous_managed_accumulator,
		),
		("fold_left empty keeps managed init", test_fold_left_empty_keeps_managed_init),
	],
}
