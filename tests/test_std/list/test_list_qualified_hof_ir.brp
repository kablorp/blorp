import:
	list as L
	test: TestSuite


func consume_int(_: Int) -> Void:
	void


func test_qualified_filter() -> Bool:
	result: List[Int] = L.filter([1, 2, 3, 4, 5, 6], func(x: Int): x % 2 == 0)
	result == [2, 4, 6]


func test_qualified_filter_map() -> Bool:
	result: List[Int] = L.filter_map([1, 2, 3, 4], func(x: Int) -> Option[Int]:
		if x % 2 == 0:
			Some(x * 10)
		else:
			None
	)
	result == [20, 40]


func test_qualified_flat_map() -> Bool:
	result: List[Int] = L.flat_map([1, 2, 3], func(x: Int): [x, x + 10])
	result == [1, 11, 2, 12, 3, 13]


func test_qualified_predicates() -> Bool:
	nums: List[Int] = [2, 4, 6]
	L.all(nums, func(x: Int): x % 2 == 0) and L.any(nums, func(x: Int): x > 5)


func test_qualified_for_each() -> Bool:
	L.for_each([1, 2, 3], consume_int)
	True


tests: TestSuite = {
	description = "List qualified HOF IR",
	tests = [
		("qualified filter", test_qualified_filter),
		("qualified filter_map", test_qualified_filter_map),
		("qualified flat_map", test_qualified_flat_map),
		("qualified predicates", test_qualified_predicates),
		("qualified for_each", test_qualified_for_each),
	],
}
