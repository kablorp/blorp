import:
	list: scan
	test: TestSuite


func append_word(acc: String, word: String) -> String:
	acc + word


func keep_acc(acc: String, _: Int) -> String:
	acc


func dynamic_seed() -> String:
	"se" + "ed"


func test_scan_managed_accumulator() -> Bool:
	words: List[String] = ["a", "b", "c"]
	words.scan("", append_word) == ["", "a", "ab", "abc"]


func test_scan_callback_can_return_previous_managed_accumulator() -> Bool:
	nums: List[Int] = [1, 2]
	nums.scan(dynamic_seed(), keep_acc) == ["seed", "seed", "seed"]


func test_scan_empty_list_keeps_init() -> Bool:
	empty: List[String] = []
	empty.scan(dynamic_seed(), append_word) == ["seed"]


tests: TestSuite = {
	description = "List scan HOF IR",
	tests = [
		("scan managed accumulator", test_scan_managed_accumulator),
		(
			"scan callback can return previous managed accumulator",
			test_scan_callback_can_return_previous_managed_accumulator,
		),
		("scan empty list keeps init", test_scan_empty_list_keeps_init),
	],
}
