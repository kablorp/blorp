import:
	list: sort
	test: TestSuite


func test_eq_int() -> Bool:
	[1, 2, 3] == [1, 2, 3]


func test_eq_string() -> Bool:
	["a", "b", "c"] == ["a", "b", "c"]


func test_eq_bool() -> Bool:
	[True, False, True] == [True, False, True]


func test_eq_empty() -> Bool:
	a: List[Int] = []
	b: List[Int] = []
	a == b


func test_neq_values() -> Bool:
	[1, 2, 3] != [1, 2, 4]


func test_neq_length() -> Bool:
	[1, 2] != [1, 2, 3]


func test_eq_same_ref() -> Bool:
	a: List[Int] = [1, 2, 3]
	a == a


func test_sort_eq() -> Bool:
	sort([3, 1, 2]) == [1, 2, 3]


func test_sort_string_eq() -> Bool:
	sort(["c", "a", "b"]) == ["a", "b", "c"]


func test_neq_string() -> Bool:
	["hello"] != ["world"]


tests: TestSuite = {
	description = "List Equality",
	tests = [
		("eq int", test_eq_int),
		("eq string", test_eq_string),
		("eq bool", test_eq_bool),
		("eq empty", test_eq_empty),
		("neq values", test_neq_values),
		("neq length", test_neq_length),
		("eq same ref", test_eq_same_ref),
		("sort eq", test_sort_eq),
		("sort string eq", test_sort_string_eq),
		("neq string", test_neq_string),
	],
}
