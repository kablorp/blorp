-- fold_right should process elements right-to-left
import:
	list: fold_right
	test: TestSuite


-- String concatenation is non-commutative: order matters
pure func test_fold_right_order() -> Bool:
	items: List[String] = ["a", "b", "c"]
	-- fold_right should process c, then b, then a
	-- f("c", "") -> "c", f("b", "c") -> "bc", f("a", "bc") -> "abc"
	result: String = fold_right(items, "", pure func(elem: String, acc: String): elem + acc)
	result == "abc"


-- Compare with fold_left which processes a, then b, then c
pure func test_fold_right_vs_left() -> Bool:
	items: List[Int] = [1, 2, 3]
	-- fold_right: f(3, init) -> f(2, ...) -> f(1, ...)
	-- Building a list: [1, 2, 3] fold_right with prepend should give [1, 2, 3]
	right_result: String = fold_right(items, "", pure func(x: Int, acc: String): to_string(x) + acc)
	-- fold_right processes 3 first, then 2, then 1
	-- f(3, "") -> "3", f(2, "3") -> "23", f(1, "23") -> "123"
	right_result == "123"


-- Subtraction: fold_right([1,2,3], 0, sub) = 1 - (2 - (3 - 0)) = 1 - (2 - 3) = 1 - (-1) = 2
pure func test_fold_right_subtraction() -> Bool:
	items: List[Int] = [1, 2, 3]
	result: Int = fold_right(items, 0, pure func(x: Int, acc: Int): x - acc)
	result == 2


tests: TestSuite = {
	description = "fold_right correctness",
	tests = [
		("fold_right order", test_fold_right_order),
		("fold_right vs left", test_fold_right_vs_left),
		("fold_right subtraction", test_fold_right_subtraction),
	],
}
