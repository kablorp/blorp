import:
	list as L: filter, filter_map, fold_left, get_or, length, map, range
	test: TestSuite


record FusionItem {
	id: Int,
	label: String
}


pure func dynamic_word(base: String) -> String:
	base + "!"


pure func count_long_filtered(words: List[String]) -> Int:
	kept: List[String] = words.filter(func(s: String): s.length() > 4)
	kept.length()


func test_filter_map_fold_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	result: Int = xs
		.filter(func(x: Int): x % 2 == 0)
		.map(func(x: Int): x * 10)
		.fold_left(0, func(acc: Int, x: Int): acc + x)
	result == 120


func test_filter_map_hof_fold_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	result: Int = xs
		.filter_map(func(x: Int) -> Option[Int]:
			if x % 2 == 0:
				Some(x * 10)
			else:
				None
		)
		.fold_left(0, func(acc: Int, x: Int): acc + x)
	result == 120


func test_filter_map_hof_collect_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	ys: List[Int] = xs.filter_map(func(x: Int) -> Option[Int]:
		if x % 2 == 0:
			Some(x * 10)
		else:
			None
	)
	ys.length() == 3 and ys.get_or(
		0,
		-1,
	) == 20 and ys.get_or(1, -1) == 40 and ys.get_or(2, -1) == 60


func test_filter_map_fold_qualified() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	result: Int = L.fold_left(
		L.map(
			L.filter(
				xs,
				func(x: Int): x > 2,
			),
			func(x: Int): x + 1,
		),
		0,
		func(acc: Int, x: Int): acc + x,
	)
	result == 22


func test_filter_map_fold_bare() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	result: Int = fold_left(
		map(
			filter(
				xs,
				func(x: Int): x < 5,
			),
			func(x: Int): x * 2,
		),
		0,
		func(acc: Int, x: Int): acc + x,
	)
	result == 20


func test_range_map_filter_collect() -> Bool:
	xs: List[Int] = range(0, 6)
		.map(func(x: Int): x * 3)
		.filter(func(x: Int): x % 2 == 0)
	xs.length() == 3 and xs.get_or(0, -1) == 0 and xs.get_or(1, -1) == 6 and xs.get_or(2, -1) == 12


func test_range_map_collect() -> Bool:
	xs: List[Int] = range(0, 5).map(func(x: Int): x * 2)
	xs.length() == 5 and xs.get_or(0, -1) == 0 and xs.get_or(4, -1) == 8


func test_range_filter_length() -> Bool:
	range(0, 10)
		.filter(func(x: Int): x % 2 == 0)
		.length() == 5


func test_range_filter_map_fold() -> Bool:
	result: Int = range(0, 7)
		.filter(func(x: Int): x % 2 == 1)
		.map(func(x: Int): x * 10)
		.fold_left(0, func(acc: Int, x: Int): acc + x)
	result == 90


func test_range_filter_map_hof_fold() -> Bool:
	result: Int = range(0, 7)
		.filter_map(func(x: Int) -> Option[Int]:
			if x % 2 == 1:
				Some(x * 10)
			else:
				None
		)
		.fold_left(0, func(acc: Int, x: Int): acc + x)
	result == 90


func test_filter_map_collect_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	ys: List[Int] = xs
		.filter(func(x: Int): x % 2 == 0)
		.map(func(x: Int): x * 10)
	ys.length() == 3 and ys.get_or(
		0,
		-1,
	) == 20 and ys.get_or(1, -1) == 40 and ys.get_or(2, -1) == 60


func test_single_filter_collect_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	ys: List[Int] = xs.filter(func(x: Int): x % 2 == 0)
	ys.length() == 3 and ys.get_or(0, -1) == 2 and ys.get_or(1, -1) == 4 and ys.get_or(2, -1) == 6


func test_single_map_collect_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3]
	ys: List[Int] = xs.map(func(x: Int): x * 10)
	ys.length() == 3 and ys.get_or(
		0,
		-1,
	) == 10 and ys.get_or(1, -1) == 20 and ys.get_or(2, -1) == 30


func test_filter_map_length_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	xs
		.filter(func(x: Int): x % 2 == 0)
		.map(func(x: Int): x * 10)
		.length() == 3


func test_filter_length_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	xs
		.filter(func(x: Int): x % 2 == 0)
		.length() == 3


func test_map_filter_length_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	xs
		.map(func(x: Int): x * 3)
		.filter(func(x: Int): x % 2 == 0)
		.length() == 3


func test_map_filter_collect_ufcs() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5, 6]
	ys: List[Int] = xs
		.map(func(x: Int): x * 3)
		.filter(func(x: Int): x % 2 == 0)
	ys.length() == 3 and ys.get_or(0, -1) == 6 and ys.get_or(1, -1) == 12 and ys.get_or(2, -1) == 18


func test_float_filter_map_fold_ufcs() -> Bool:
	xs: List[Float] = [1.0, 2.0, 3.0, 4.0]
	result: Float = xs
		.filter(func(x: Float): x > 1.5)
		.map(func(x: Float): x * 0.5)
		.fold_left(0.0, func(acc: Float, x: Float): acc + x)
	result == 4.5


func test_float_filter_map_hof_fold_ufcs() -> Bool:
	xs: List[Float] = [1.0, 2.0, 3.0, 4.0]
	result: Float = xs
		.filter_map(func(x: Float) -> Option[Float]:
			if x > 1.5:
				Some(x * 0.5)
			else:
				None
		)
		.fold_left(0.0, func(acc: Float, x: Float): acc + x)
	result == 4.5


func test_float_filter_map_hof_collect_ufcs() -> Bool:
	xs: List[Float] = [1.0, 2.0, 3.0, 4.0]
	ys: List[Float] = xs.filter_map(func(x: Float) -> Option[Float]:
		if x > 1.5:
			Some(x * 0.5)
		else:
			None
	)
	ys.length() == 3 and ys.get_or(
		0,
		0.0,
	) == 1.0 and ys.get_or(1, 0.0) == 1.5 and ys.get_or(2, 0.0) == 2.0


func test_float_filter_map_collect_ufcs() -> Bool:
	xs: List[Float] = [1.0, 2.0, 3.0, 4.0]
	ys: List[Float] = xs
		.filter(func(x: Float): x > 1.5)
		.map(func(x: Float): x * 0.5)
	ys.length() == 3 and ys.get_or(
		0,
		0.0,
	) == 1.0 and ys.get_or(1, 0.0) == 1.5 and ys.get_or(2, 0.0) == 2.0


func test_range_map_float_filter_collect() -> Bool:
	ys: List[Float] = range(0, 5)
		.map(func(x: Int): to_float(x) * 0.5)
		.filter(func(x: Float): x > 1.0)
	ys.length() == 2 and ys.get_or(0, 0.0) == 1.5 and ys.get_or(1, 0.0) == 2.0


func test_string_filter_map_collect_ufcs() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin"]
	shouted: List[String] = words
		.filter(func(s: String): s.length() > 3)
		.map(func(s: String): s + "!")
	shouted.length() == 2 and shouted.get_or(
		0,
		"",
	) == "bear!" and shouted.get_or(1, "") == "dolphin!"


func test_single_string_filter_collect_ufcs() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin"]
	kept: List[String] = words.filter(func(s: String): s.length() > 3)
	kept.length() == 2 and kept.get_or(0, "") == "bear" and kept.get_or(1, "") == "dolphin"


func test_single_string_filter_collect_shared_source() -> Bool:
	words: List[String] = [
		dynamic_word("ant"),
		dynamic_word("bear"),
		dynamic_word("cat"),
		dynamic_word("dolphin"),
	]
	count: Int = count_long_filtered(words)
	second: String = words.get_or(1, "")
	fourth: String = words.get_or(3, "")
	count == 2 and second == "bear!" and fourth == "dolphin!"


func test_single_string_map_collect_ufcs() -> Bool:
	words: List[String] = ["ant", "bear"]
	shouted: List[String] = words.map(func(s: String): s + "!")
	shouted.length() == 2 and shouted.get_or(0, "") == "ant!" and shouted.get_or(1, "") == "bear!"


func test_string_filter_map_hof_collect_shared_source() -> Bool:
	words: List[String] = [
		dynamic_word("ant"),
		dynamic_word("bear"),
		dynamic_word("cat"),
		dynamic_word("dolphin"),
	]
	kept: List[String] = words.filter_map(func(s: String) -> Option[String]:
		if s.length() > 4:
			Some(s)
		else:
			None
	)
	kept.length() == 2 and kept.get_or(
		0,
		"",
	) == "bear!" and kept.get_or(1, "") == "dolphin!" and words.get_or(1, "") == "bear!"


func test_string_filter_map_hof_map_collect_shared_source() -> Bool:
	words: List[String] = [
		dynamic_word("ant"),
		dynamic_word("bear"),
		dynamic_word("cat"),
		dynamic_word("dolphin"),
	]
	shouted: List[String] = words
		.filter_map(func(s: String) -> Option[String]:
			if s.length() > 4:
				Some(s)
			else:
				None
		)
		.map(func(s: String): s + "?")
	shouted.length() == 2 and shouted.get_or(
		0,
		"",
	) == "bear!?" and shouted.get_or(1, "") == "dolphin!?" and words.get_or(3, "") == "dolphin!"


func test_string_filter_map_length_ufcs() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin"]
	words
		.filter(func(s: String): s.length() > 3)
		.map(func(s: String): s + "!")
		.length() == 2


func test_string_filter_length_ufcs() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin"]
	words
		.filter(func(s: String): s.length() > 3)
		.length() == 2


func test_string_map_filter_length_ufcs() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin"]
	words
		.map(func(s: String): s + "!")
		.filter(func(s: String): s.length() > 4)
		.length() == 2


func test_record_filter_map_collect_ufcs() -> Bool:
	items: List[FusionItem] = [{
			id = 1,
			label = "ant"
		}, {
			id = 2,
			label = "bear"
		}, {
			id = 3,
			label = "cat"
		}]
	mapped: List[FusionItem] = items
		.filter(func(item: FusionItem): item.id > 1)
		.map(func(item: FusionItem): { item |
				label = item.label + "!"
			})
	first: FusionItem = mapped.get_or(0, {
			id = 0,
			label = ""
		})
	second: FusionItem = mapped.get_or(1, {
			id = 0,
			label = ""
		})
	mapped.length() == 2 and first.id == 2 and first.label == "bear!" and second.id == 3 and second.label == "cat!"


tests: TestSuite = {
	description = "List pipeline fusion",
	tests = [
		("filter map fold UFCS", test_filter_map_fold_ufcs),
		("filter_map HOF fold UFCS", test_filter_map_hof_fold_ufcs),
		("filter_map HOF collect UFCS", test_filter_map_hof_collect_ufcs),
		("filter map fold qualified", test_filter_map_fold_qualified),
		("filter map fold bare", test_filter_map_fold_bare),
		("range map filter collect", test_range_map_filter_collect),
		("range map collect", test_range_map_collect),
		("range filter length", test_range_filter_length),
		("range filter map fold", test_range_filter_map_fold),
		("range filter_map HOF fold", test_range_filter_map_hof_fold),
		("filter map collect UFCS", test_filter_map_collect_ufcs),
		("single filter collect UFCS", test_single_filter_collect_ufcs),
		("single map collect UFCS", test_single_map_collect_ufcs),
		("filter map length UFCS", test_filter_map_length_ufcs),
		("filter length UFCS", test_filter_length_ufcs),
		("map filter length UFCS", test_map_filter_length_ufcs),
		("map filter collect UFCS", test_map_filter_collect_ufcs),
		("float filter map fold UFCS", test_float_filter_map_fold_ufcs),
		("float filter_map HOF fold UFCS", test_float_filter_map_hof_fold_ufcs),
		("float filter_map HOF collect UFCS", test_float_filter_map_hof_collect_ufcs),
		("float filter map collect UFCS", test_float_filter_map_collect_ufcs),
		("range map float filter collect", test_range_map_float_filter_collect),
		("string filter map collect UFCS", test_string_filter_map_collect_ufcs),
		("single string filter collect UFCS", test_single_string_filter_collect_ufcs),
		(
			"single string filter collect shared source",
			test_single_string_filter_collect_shared_source,
		),
		("single string map collect UFCS", test_single_string_map_collect_ufcs),
		(
			"string filter_map HOF collect shared source",
			test_string_filter_map_hof_collect_shared_source,
		),
		(
			"string filter_map HOF map collect shared source",
			test_string_filter_map_hof_map_collect_shared_source,
		),
		("string filter map length UFCS", test_string_filter_map_length_ufcs),
		("string filter length UFCS", test_string_filter_length_ufcs),
		("string map filter length UFCS", test_string_map_filter_length_ufcs),
		("record filter map collect UFCS", test_record_filter_map_collect_ufcs),
	]
}
