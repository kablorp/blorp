import:
	list: max_by, min_by, product, sum
	test: TestSuite
	traits: Addable, HasOne, HasZero, Multipliable


struct Score {value: Int}


implements Addable for Score:
	pure func add(a: Score, b: Score) -> Score:
		{value = a.value + b.value}


implements HasZero for Score:
	pure func zero() -> Score:
		{value = 0}


struct Factor {value: Int}


implements Multipliable for Factor:
	pure func multiply(a: Factor, b: Factor) -> Factor:
		{value = a.value * b.value}


implements HasOne for Factor:
	pure func one() -> Factor:
		{value = 1}


pure func test_sum_basic() -> Bool:
	sum([1, 2, 3, 4, 5]) == 15


pure func test_sum_single() -> Bool:
	sum([42]) == 42


pure func test_sum_negative() -> Bool:
	sum([1, 0 - 2, 3]) == 2


pure func test_sum_float() -> Bool:
	values: List[Float] = [1.0, 2.5, 3.5]
	sum(values) == 7.0


pure func test_sum_empty_float() -> Bool:
	values: List[Float] = []
	sum(values) == 0.0


pure func test_sum_custom_addable() -> Bool:
	values: List[Score] = [{value = 1}, {value = 2}, {value = 3}]
	total: Score = sum(values)
	total.value == 6


pure func test_product_basic() -> Bool:
	product([1, 2, 3, 4]) == 24


pure func test_product_single() -> Bool:
	product([7]) == 7


pure func test_product_zero() -> Bool:
	product([5, 0, 3]) == 0


pure func test_product_float() -> Bool:
	values: List[Float] = [2.0, 3.0, 4.0]
	product(values) == 24.0


pure func test_product_custom_multipliable() -> Bool:
	values: List[Factor] = [{value = 2}, {value = 3}, {value = 4}]
	total: Factor = product(values)
	total.value == 24


pure func test_min_by_identity() -> Bool:
	nums: List[Int] = [3, 1, 4, 1, 5]
	min_by(nums, pure func(x: Int): x) == Some(1)


pure func test_min_by_negation() -> Bool:
	nums: List[Int] = [3, 1, 2]
	min_by(nums, pure func(x: Int): 0 - x) == Some(3)


pure func test_min_by_single() -> Bool:
	nums: List[Int] = [42]
	min_by(nums, pure func(x: Int): x) == Some(42)


pure func test_max_by_identity() -> Bool:
	nums: List[Int] = [3, 1, 4, 1, 5]
	max_by(nums, pure func(x: Int): x) == Some(5)


pure func test_max_by_negation() -> Bool:
	nums: List[Int] = [3, 1, 2]
	max_by(nums, pure func(x: Int): 0 - x) == Some(1)


pure func test_max_by_single() -> Bool:
	nums: List[Int] = [42]
	max_by(nums, pure func(x: Int): x) == Some(42)


tests: TestSuite = {
	description = "List Numeric Reductions",
	tests = [
		("sum basic", test_sum_basic),
		("sum single", test_sum_single),
		("sum negative", test_sum_negative),
		("sum float", test_sum_float),
		("sum empty float", test_sum_empty_float),
		("sum custom addable", test_sum_custom_addable),
		("product basic", test_product_basic),
		("product single", test_product_single),
		("product zero", test_product_zero),
		("product float", test_product_float),
		("product custom multipliable", test_product_custom_multipliable),
		("min_by identity", test_min_by_identity),
		("min_by negation", test_min_by_negation),
		("min_by single", test_min_by_single),
		("max_by identity", test_max_by_identity),
		("max_by negation", test_max_by_negation),
		("max_by single", test_max_by_single),
	],
}
