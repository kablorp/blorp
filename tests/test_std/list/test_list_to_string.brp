import:
	test: TestSuite


tests: TestSuite = {
	description = "List to_string",
	tests = [
		("int list to_string", func():
			nums: List[Int] = [1, 2, 3]
			nums.to_string() == "[1, 2, 3]"
		),
		("float list to_string", func():
			nums: List[Float] = [1.5, 2.0, 3.14]
			s: String = nums.to_string()
			-- Check starts with [1.5
			s.length() > 5
		),
		("string list to_string", func():
			words: List[String] = ["hello", "world"]
			words.to_string() == "[\"hello\", \"world\"]"
		),
		("bool list to_string", func():
			flags: List[Bool] = [True, False, True]
			flags.to_string() == "[True, False, True]"
		),
		("empty list to_string", func():
			empty: List[Int] = []
			empty.to_string() == "[]"
		),
		("single element list", func():
			one: List[Int] = [42]
			one.to_string() == "[42]"
		),
		("list in string interpolation", func():
			nums: List[Int] = [1, 2, 3]
			s: String = "list: ${nums}"
			s == "list: [1, 2, 3]"
		),
		("method syntax to_string", func():
			nums: List[Int] = [10, 20]
			nums.to_string() == "[10, 20]"
		)
	]
}
