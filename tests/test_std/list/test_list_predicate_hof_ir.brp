import:
	list: all, any, count, find, find_index, for_each
	test: TestSuite


func consume_int(_: Int) -> Void:
	void


func long_word(s: String) -> Bool:
	s.length() > 3


func test_predicate_queries_preserve_values() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5, 6]
	all_positive: Bool = nums.all(func(x: Int): x > 0)
	not_all_small: Bool = not nums.all(func(x: Int): x < 4)
	has_four: Bool = nums.any(func(x: Int): x == 4)
	has_no_large: Bool = not nums.any(func(x: Int): x > 9)
	evens: Int = nums.count(func(x: Int): x % 2 == 0)
	all_positive and not_all_small and has_four and has_no_large and evens == 3


pure func test_pure_predicate_queries_preserve_values() -> Bool:
	nums: List[Int] = [2, 4, 6]
	all_even: Bool = nums.all(pure func(x: Int): x % 2 == 0)
	any_gt_four: Bool = nums.any(pure func(x: Int): x > 4)
	even_count: Int = nums.count(pure func(x: Int): x % 2 == 0)
	all_even and any_gt_four and even_count == 3


func test_empty_predicate_identities() -> Bool:
	empty: List[Int] = []
	all_empty: Bool = empty.all(func(x: Int): x > 0)
	any_empty: Bool = empty.any(func(x: Int): x > 0)
	count_empty: Int = empty.count(func(x: Int): x > 0)
	all_empty and not any_empty and count_empty == 0


func test_find_index_returns_first_match() -> Bool:
	nums: List[Int] = [1, 3, 4, 6]
	match nums.find_index(func(x: Int): x % 2 == 0):
		Some(i): i == 2
		None: False


func find_long_word() -> Option[String]:
	words: List[String] = ["ant", "bear", "cat"]
	words.find(long_word)


func test_find_returns_retained_managed_value() -> Bool:
	match find_long_word():
		Some(word): word == "bear"
		None: False


func test_for_each_compiles_and_runs() -> Bool:
	nums: List[Int] = [1, 2, 3]
	nums.for_each(consume_int)
	True


tests: TestSuite = {
	description = "List predicate HOF IR",
	tests = [
		("predicate queries preserve values", test_predicate_queries_preserve_values),
		("pure predicate queries preserve values", test_pure_predicate_queries_preserve_values),
		("empty predicate identities", test_empty_predicate_identities),
		("find_index returns first match", test_find_index_returns_first_match),
		("find returns retained managed value", test_find_returns_retained_managed_value),
		("for_each compiles and runs", test_for_each_compiles_and_runs),
	],
}
