import:
	test: TestSuite


func expand_label(n: Int) -> List[String]:
	if n == 1:
		["one", "uno"]
	else if n == 2:
		[]
	else:
		["many"]


func test_flat_map_string_values() -> Bool:
	nums: List[Int] = [1, 2, 3]
	labels: List[String] = nums.flat_map(expand_label)
	match labels.get(0):
		Some(first):
			match labels.get(2):
				Some(third): labels.length() == 3 and first == "one" and third == "many"
				None: False
		None: False


tests: TestSuite = {
	description = "List flat_map HOF IR",
	tests = [("flat_map preserves managed inner values", test_flat_map_string_values)],
}
