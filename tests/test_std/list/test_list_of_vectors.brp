import:
	list: get
	test: TestSuite


-- Test #20: List[T[#N]] array type normalization
func test_list_of_int_vectors() -> Bool:
	v1: Int[#3] = {1, 2, 3}
	v2: Int[#3] = {4, 5, 6}
	vecs: List[Int[#3]] = [v1, v2]
	match get(vecs, 0):
		Some(v): v[0] == 1 and v[1] == 2 and v[2] == 3
		None: False


func test_list_of_float_vectors() -> Bool:
	v1: Float[#2] = {1.5, 2.5}
	v2: Float[#2] = {3.5, 4.5}
	vecs: List[Float[#2]] = [v1, v2]
	match get(vecs, 1):
		Some(v): v[0] == 3.5 and v[1] == 4.5
		None: False


func test_list_length() -> Bool:
	v1: Int[#2] = {10, 20}
	v2: Int[#2] = {30, 40}
	v3: Int[#2] = {50, 60}
	vecs: List[Int[#2]] = [v1, v2, v3]
	vecs.length() == 3


tests: TestSuite = {
	description = "List of vectors",
	tests = [
		("list of int vectors", test_list_of_int_vectors),
		("list of float vectors", test_list_of_float_vectors),
		("list length", test_list_length),
	]
}
