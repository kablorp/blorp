import:
	test: TestSuite


func short_word(s: String) -> Bool:
	s.length() < 4


func test_take_while_string_values() -> Bool:
	words: List[String] = ["ant", "bee", "bear", "cat"]
	kept: List[String] = words.take_while(short_word)
	match kept.get(0):
		Some(first):
			match kept.get(1):
				Some(second): kept.length() == 2 and first == "ant" and second == "bee"
				None: False
		None: False


func test_drop_while_string_values() -> Bool:
	words: List[String] = ["ant", "bee", "bear", "cat"]
	kept: List[String] = words.drop_while(short_word)
	match kept.get(0):
		Some(first):
			match kept.get(1):
				Some(second): kept.length() == 2 and first == "bear" and second == "cat"
				None: False
		None: False


tests: TestSuite = {
	description = "List while HOF IR",
	tests = [
		("take_while preserves managed values", test_take_while_string_values),
		("drop_while preserves managed values", test_drop_while_string_values),
	],
}
