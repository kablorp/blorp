-- Test list pattern matching
import:
	list: List, length
	test: TestSuite


-- Empty list
func test_empty_match() -> Bool:
	xs: List[Int] = []

	r: String = match xs:
		[]:
			"empty"
		[_, ...rest]:
			"non-empty"

	r == "empty"


-- Single element
func test_single() -> Bool:
	xs: List[Int] = [42]

	r: Int = match xs:
		[]:
			0
		[x, ..._]:
			x

	r == 42


-- Exact two elements
func test_exact_two() -> Bool:
	xs: List[Int] = [10, 20]

	r: Int = match xs:
		[a, b]:
			a + b
		_:
			0

	r == 30


-- Head and rest
func test_head_rest() -> Bool:
	xs: List[Int] = [1, 2, 3]

	r: Int = match xs:
		[]:
			0
		[x, ...rest]:
			x + rest.length()

	r == 3


-- Spread wildcard
func test_spread_wildcard() -> Bool:
	xs: List[Int] = [5, 6, 7]

	r: Int = match xs:
		[]:
			0
		[x, ..._]:
			x

	r == 5


-- Rest binding is empty
func test_rest_empty() -> Bool:
	xs: List[Int] = [99]

	r: Int = match xs:
		[]:
			-1
		[x, ...rest]:
			rest.length()

	r == 0


-- Multi-tier: [], [x], [a, b, ...rest]
func test_multi_tier_empty() -> Bool:
	xs: List[Int] = []

	r: String = match xs:
		[]:
			"empty"
		[x]:
			"one"
		[a, b, ...rest]:
			"many"

	r == "empty"


func test_multi_tier_one() -> Bool:
	xs: List[Int] = [1]

	r: String = match xs:
		[]:
			"empty"
		[x]:
			"one"
		[a, b, ...rest]:
			"many"

	r == "one"


func test_multi_tier_many() -> Bool:
	xs: List[Int] = [1, 2, 3, 4]

	r: String = match xs:
		[]:
			"empty"
		[x]:
			"one"
		[a, b, ...rest]:
			"many"

	r == "many"


-- String list
func test_string_list() -> Bool:
	xs: List[String] = ["hello", "world"]

	r: String = match xs:
		[]:
			""
		[s, ..._]:
			s

	r == "hello"


-- Spread captures tail
func test_spread_tail() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5]

	r: Int = match xs:
		[]:
			0
		[head, ...tail]:
			tail.length()

	r == 4


-- Catch-all with [...rest]
func test_catch_all_spread() -> Bool:
	xs: List[Int] = [1, 2, 3]

	r: Int = match xs:
		[...rest]:
			rest.length()

	r == 3


-- Catch-all with [..._]
func test_catch_all_discard() -> Bool:
	xs: List[Int] = [1, 2, 3]

	r: String = match xs:
		[..._]:
			"any"

	r == "any"


-- Two element extract
func test_two_elem_extract() -> Bool:
	xs: List[Int] = [10, 20, 30]

	r: Int = match xs:
		[]:
			0
		[x]:
			x
		[a, b, ...rest]:
			a * b

	r == 200


-- Earlier spread arms must keep source-order priority over later exact arms.
func test_spread_before_exact_preserves_order() -> Bool:
	xs: List[Int] = [42]

	r: Int = match xs:
		[x, ...rest]:
			1
		[x]:
			2
		_:
			3

	r == 1


-- Spread arms at different fixed-head lengths must compile and fall through in order.
func test_multi_spread_lengths_preserve_order() -> Bool:
	one: Int = match [1]:
		[0, ...rest]:
			10
		[x, y, ...tail]:
			20
		_:
			30

	two: Int = match [1, 2]:
		[0, ...rest]:
			10
		[x, y, ...tail]:
			20
		_:
			30

	zero_head: Int = match [0, 9, 8]:
		[0, ...rest]:
			10
		[x, y, ...tail]:
			20
		_:
			30

	one == 30 and two == 20 and zero_head == 10


tests: TestSuite = {
	description = "List Pattern Matching",
	tests = [
		("empty match", test_empty_match),
		("single element", test_single),
		("exact two", test_exact_two),
		("head and rest", test_head_rest),
		("spread wildcard", test_spread_wildcard),
		("rest is empty", test_rest_empty),
		("multi-tier empty", test_multi_tier_empty),
		("multi-tier one", test_multi_tier_one),
		("multi-tier many", test_multi_tier_many),
		("string list", test_string_list),
		("spread tail", test_spread_tail),
		("catch-all spread", test_catch_all_spread),
		("catch-all discard", test_catch_all_discard),
		("two elem extract", test_two_elem_extract),
		("spread before exact preserves order", test_spread_before_exact_preserves_order),
		("multi-spread lengths preserve order", test_multi_spread_lengths_preserve_order),
	]
}
