import:
	list: get, reverse
	test: TestSuite


-- ============================================================================
-- Length (IR: CKIntrinsic "list_len" → direct field read)
-- ============================================================================
func test_length_empty() -> Bool:
	xs: List[Int] = []
	xs.length() == 0


func test_length_three() -> Bool:
	length([1, 2, 3]) == 3


func test_length_strings() -> Bool:
	length(["a", "b", "c"]) == 3


func test_length_after_append() -> Bool:
	length([1, 2].append(3)) == 3


-- ============================================================================
-- Get (IR: blorp bounds check + CKIntrinsic "list_get" + CUnbox)
-- ============================================================================
func test_get_valid() -> Bool:
	match get([10, 20, 30], 1):
		Some(v): v == 20
		None: False


func test_get_first() -> Bool:
	match get([42], 0):
		Some(v): v == 42
		None: False


func test_get_last() -> Bool:
	match get([1, 2, 3], 2):
		Some(v): v == 3
		None: False


func test_get_out_of_bounds() -> Bool:
	match get([1, 2, 3], 5):
		Some(_): False
		None: True


func test_get_negative() -> Bool:
	match get([1, 2, 3], -1):
		Some(_): False
		None: True


func test_get_empty() -> Bool:
	xs: List[Int] = []
	match get(xs, 0):
		Some(_): False
		None: True


func test_get_string() -> Bool:
	match get(["hello", "world"], 1):
		Some(v): v == "world"
		None: False


-- ============================================================================
-- Append (IR: list_ensure_capacity + list_retain_for + list_set + list_set_len)
-- ============================================================================
func test_append_int() -> Bool:
	[1, 2].append(3) == [1, 2, 3]


func test_append_to_empty() -> Bool:
	xs: List[Int] = []
	xs.append(1) == [1]


func test_append_string() -> Bool:
	["a", "b"].append("c") == ["a", "b", "c"]


func test_append_preserves_original() -> Bool:
	original: List[Int] = [1, 2]
	_ = original.append(3)
	original.length() == 2


func test_append_multiple() -> Bool:
	var xs: List[Int] = []
	xs = xs
		.append(1)
		.append(2)
		.append(3)
	xs == [1, 2, 3]


-- ============================================================================
-- Set Index (IR: list_ensure_unique + list_release_elem + list_retain_for + list_set)
-- ============================================================================
func test_set_index_valid() -> Bool:
	match [1, 2, 3].set_index(1, 99):
		Some(r): r == [1, 99, 3]
		None: False


func test_set_index_first() -> Bool:
	match [10, 20].set_index(0, 5):
		Some(r): r == [5, 20]
		None: False


func test_set_index_last() -> Bool:
	match [10, 20, 30].set_index(2, 99):
		Some(r): r == [10, 20, 99]
		None: False


func test_set_index_oob() -> Bool:
	match [1, 2].set_index(5, 99):
		Some(_): False
		None: True


func test_set_index_negative() -> Bool:
	match [1, 2].set_index(-1, 99):
		Some(_): False
		None: True


func test_set_index_string() -> Bool:
	match ["a", "b", "c"].set_index(1, "x"):
		Some(r): r == ["a", "x", "c"]
		None: False


-- ============================================================================
-- Remove (IR: list_ensure_unique + list_release_elem + shift loop + list_set_len)
-- ============================================================================
func test_remove_middle() -> Bool:
	match [1, 2, 3].remove(1):
		Some(r): r == [1, 3]
		None: False


func test_remove_first() -> Bool:
	match [1, 2, 3].remove(0):
		Some(r): r == [2, 3]
		None: False


func test_remove_last() -> Bool:
	match [1, 2, 3].remove(2):
		Some(r): r == [1, 2]
		None: False


func test_remove_oob() -> Bool:
	match [1, 2].remove(5):
		Some(_): False
		None: True


func test_remove_negative() -> Bool:
	match [1, 2].remove(-1):
		Some(_): False
		None: True


func test_remove_single() -> Bool:
	match [42].remove(0):
		Some(r): r.length() == 0
		None: False


func test_remove_string() -> Bool:
	match ["a", "b", "c"].remove(1):
		Some(r): r == ["a", "c"]
		None: False


-- ============================================================================
-- Insert (IR: list_ensure_capacity + shift loop + list_retain_for + list_set + list_set_len)
-- ============================================================================
func test_insert_middle() -> Bool:
	match [1, 3].insert(1, 2):
		Some(r): r == [1, 2, 3]
		None: False


func test_insert_beginning() -> Bool:
	match [2, 3].insert(0, 1):
		Some(r): r == [1, 2, 3]
		None: False


func test_insert_end() -> Bool:
	match [1, 2].insert(2, 3):
		Some(r): r == [1, 2, 3]
		None: False


func test_insert_oob() -> Bool:
	match [1, 2].insert(5, 3):
		Some(_): False
		None: True


func test_insert_negative() -> Bool:
	match [1, 2].insert(-1, 0):
		Some(_): False
		None: True


func test_insert_into_empty() -> Bool:
	xs: List[Int] = []
	match xs.insert(0, 42):
		Some(r): r == [42]
		None: False


func test_insert_string() -> Bool:
	match ["a", "c"].insert(1, "b"):
		Some(r): r == ["a", "b", "c"]
		None: False


-- ============================================================================
-- Tail (IR: list_ensure_unique + list_release_elem + shift loop + list_set_len)
-- ============================================================================
func test_tail_basic() -> Bool:
	[1, 2, 3].tail() == [2, 3]


func test_tail_two() -> Bool:
	[1, 2].tail() == [2]


func test_tail_single() -> Bool:
	xs: List[Int] = [1].tail()
	xs.length() == 0


func test_tail_string() -> Bool:
	["a", "b", "c"].tail() == ["b", "c"]


-- ============================================================================
-- Reverse (IR: list_ensure_unique + swap loop with list_get/list_set)
-- ============================================================================
func test_reverse_basic() -> Bool:
	reverse([1, 2, 3]) == [3, 2, 1]


func test_reverse_single() -> Bool:
	reverse([42]) == [42]


func test_reverse_empty() -> Bool:
	xs: List[Int] = []
	reverse(xs) == xs


func test_reverse_two() -> Bool:
	reverse([1, 2]) == [2, 1]


func test_reverse_string() -> Bool:
	reverse(["a", "b", "c"]) == ["c", "b", "a"]


func test_reverse_preserves_original() -> Bool:
	original: List[Int] = [1, 2, 3]
	_ = reverse(original)
	original == [1, 2, 3]


-- ============================================================================
-- ARC correctness: String elements (RC type)
-- ============================================================================
func test_arc_append_string() -> Bool:
	xs: List[String] = ["a", "b"]
	ys: List[String] = xs.append("c")
	ys == ["a", "b", "c"]


func test_arc_set_index_string() -> Bool:
	match ["hello", "world"].set_index(0, "hi"):
		Some(r): r == ["hi", "world"]
		None: False


func test_arc_remove_string() -> Bool:
	match ["x", "y", "z"].remove(0):
		Some(r): r == ["y", "z"]
		None: False


func test_arc_insert_string() -> Bool:
	match ["a", "c"].insert(1, "b"):
		Some(r): r == ["a", "b", "c"]
		None: False


func test_arc_tail_string() -> Bool:
	["first", "second", "third"].tail() == ["second", "third"]


func test_arc_reverse_string() -> Bool:
	reverse(["x", "y", "z"]) == ["z", "y", "x"]


-- ============================================================================
-- Composition: multiple IR ops chained
-- ============================================================================
func test_chain_append_reverse() -> Bool:
	reverse([1, 2].append(3)) == [3, 2, 1]


func test_chain_remove_then_get() -> Bool:
	match [10, 20, 30].remove(0):
		Some(r):
			match get(r, 0):
				Some(v): v == 20
				None: False
		None: False


func test_chain_insert_then_reverse() -> Bool:
	match [1, 3].insert(1, 2):
		Some(r): reverse(r) == [3, 2, 1]
		None: False


tests: TestSuite = {
	description = "List IR Intrinsics",
	tests = [
		("length empty", test_length_empty),
		("length three", test_length_three),
		("length strings", test_length_strings),
		("length after append", test_length_after_append),
		("get valid", test_get_valid),
		("get first", test_get_first),
		("get last", test_get_last),
		("get oob", test_get_out_of_bounds),
		("get negative", test_get_negative),
		("get empty", test_get_empty),
		("get string", test_get_string),
		("append int", test_append_int),
		("append empty", test_append_to_empty),
		("append string", test_append_string),
		("append preserves", test_append_preserves_original),
		("append multiple", test_append_multiple),
		("set valid", test_set_index_valid),
		("set first", test_set_index_first),
		("set last", test_set_index_last),
		("set oob", test_set_index_oob),
		("set negative", test_set_index_negative),
		("set string", test_set_index_string),
		("remove middle", test_remove_middle),
		("remove first", test_remove_first),
		("remove last", test_remove_last),
		("remove oob", test_remove_oob),
		("remove negative", test_remove_negative),
		("remove single", test_remove_single),
		("remove string", test_remove_string),
		("insert middle", test_insert_middle),
		("insert beginning", test_insert_beginning),
		("insert end", test_insert_end),
		("insert oob", test_insert_oob),
		("insert negative", test_insert_negative),
		("insert empty", test_insert_into_empty),
		("insert string", test_insert_string),
		("tail basic", test_tail_basic),
		("tail two", test_tail_two),
		("tail single", test_tail_single),
		("tail string", test_tail_string),
		("reverse basic", test_reverse_basic),
		("reverse single", test_reverse_single),
		("reverse empty", test_reverse_empty),
		("reverse two", test_reverse_two),
		("reverse string", test_reverse_string),
		("reverse preserves", test_reverse_preserves_original),
		("arc append string", test_arc_append_string),
		("arc set string", test_arc_set_index_string),
		("arc remove string", test_arc_remove_string),
		("arc insert string", test_arc_insert_string),
		("arc tail string", test_arc_tail_string),
		("arc reverse string", test_arc_reverse_string),
		("chain append+reverse", test_chain_append_reverse),
		("chain remove+get", test_chain_remove_then_get),
		("chain insert+reverse", test_chain_insert_then_reverse),
	],
}
