-- Test argparse module
import:
	argparse:
		Args,
		Cli,
		Param,
		ParseError(UnknownArg, MissingRequired, InvalidValue, MissingValue, DuplicateArg),
		ParseOutcome(Parsed, HelpRequested, VersionRequested, ParseFailed),
		flag,
		format_error,
		get_flag,
		get_float_or,
		get_int_or,
		get_string_or,
		option,
		option_float,
		option_int,
		parse,
		positional,
		required,
		with_default,
	test: TestSuite


-- Helpers to access Args fields from typed context
pure func positional_count(result: Args) -> Int:
	var count: Int = 0
	for p in result.positional:
		count += 1
	count


pure func rest_count(result: Args) -> Int:
	var count: Int = 0
	for r in result.rest:
		count += 1
	count


-- ============================================================================
-- Helper: build a standard parser for tests
-- ============================================================================
pure func test_parser() -> Cli:
	{
		name = "myapp",
		version = "1.0.0",
		description = "A test app",
		params = [
			flag("verbose", "--verbose", "-v", "Enable verbose output"),
			option("output", "--output", "-o", "Output file", "FILE"),
			option_int("count", "--count", "-n", "Number of iterations", "N"),
			option_float("rate", "--rate", "-r", "Rate value", "RATE"),
			positional("input", "Input file"),
		]
	}


-- ============================================================================
-- Flag parsing tests
-- ============================================================================
func test_long_flag() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--verbose", "input.txt"]
	match parse(p, args):
		Parsed(result): get_flag(result, "verbose")
		_: False


func test_short_flag() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "-v", "input.txt"]
	match parse(p, args):
		Parsed(result): get_flag(result, "verbose")
		_: False


func test_flag_absent() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "input.txt"]
	match parse(p, args):
		Parsed(result): not get_flag(result, "verbose")
		_: False


-- ============================================================================
-- Option parsing tests
-- ============================================================================
func test_long_option_space() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--output", "out.txt", "input.txt"]
	match parse(p, args):
		Parsed(result): get_string_or(result, "output", "") == "out.txt"
		_: False


func test_long_option_equals() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--output=out.txt", "input.txt"]
	match parse(p, args):
		Parsed(result): get_string_or(result, "output", "") == "out.txt"
		_: False


func test_short_option_space() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "-o", "out.txt", "input.txt"]
	match parse(p, args):
		Parsed(result): get_string_or(result, "output", "") == "out.txt"
		_: False


func test_short_option_attached() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "-oout.txt", "input.txt"]
	match parse(p, args):
		Parsed(result): get_string_or(result, "output", "") == "out.txt"
		_: False


-- ============================================================================
-- Int and Float options
-- ============================================================================
func test_int_option() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--count", "42", "input.txt"]
	match parse(p, args):
		Parsed(result): get_int_or(result, "count", 0) == 42
		_: False


func test_int_option_equals() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--count=7", "input.txt"]
	match parse(p, args):
		Parsed(result): get_int_or(result, "count", 0) == 7
		_: False


func test_float_option() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--rate", "3.14", "input.txt"]
	match parse(p, args):
		Parsed(result): get_float_or(result, "rate", 0.0) == 3.14
		_: False


func test_invalid_int() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--count", "abc", "input.txt"]
	match parse(p, args):
		ParseFailed(err):
			match err:
				InvalidValue(name, raw): name == "count" and raw == "abc"
				_: False
		_: False


-- ============================================================================
-- Positional arguments
-- ============================================================================
func test_positional() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "input.txt"]
	match parse(p, args):
		Parsed(result):
			get_string_or(result, "input", "") == "input.txt" and positional_count(result) == 1
		_: False


func test_positional_with_flags() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--verbose", "-o", "out.txt", "input.txt"]
	match parse(p, args):
		Parsed(result):
			get_flag(
				result,
				"verbose",
			) and get_string_or(
				result,
				"output",
				"",
			) == "out.txt" and get_string_or(result, "input", "") == "input.txt"
		_: False


-- ============================================================================
-- Separator and rest args
-- ============================================================================
func test_separator() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "input.txt", "--", "extra1", "extra2"]
	match parse(p, args):
		Parsed(result): rest_count(result) == 2
		_: False


-- ============================================================================
-- Combined short flags
-- ============================================================================
func test_combined_flags() -> Bool:
	parser: Cli = {
		name = "app",
		version = "1.0",
		description = "test",
		params = [
			flag("verbose", "--verbose", "-v", "Verbose"),
			flag("force", "--force", "-f", "Force"),
			flag("debug", "--debug", "-d", "Debug"),
		]
	}
	args: List[String] = ["app", "-vfd"]
	match parse(parser, args):
		Parsed(result):
			get_flag(result, "verbose") and get_flag(result, "force") and get_flag(result, "debug")
		_: False


-- ============================================================================
-- Required args and defaults
-- ============================================================================
func test_missing_required() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--verbose"]
	match parse(p, args):
		ParseFailed(err):
			match err:
				MissingRequired(name): name == "input"
				_: False
		_: False


func test_missing_required_reports_first() -> Bool:
	parser: Cli = {
		name = "app",
		version = "1.0",
		description = "test",
		params = [
			required(option("input", "--input", "-i", "Input file", "FILE")),
			required(option("output", "--output", "-o", "Output file", "FILE")),
		]
	}
	args: List[String] = ["app"]
	match parse(parser, args):
		ParseFailed(err):
			match err:
				MissingRequired(name): name == "input"
				_: False
		_: False


func test_default_value() -> Bool:
	parser: Cli = {
		name = "app",
		version = "1.0",
		description = "test",
		params = [with_default(option_int("count", "--count", "-n", "Count", "N"), "10")]
	}
	args: List[String] = ["app"]
	match parse(parser, args):
		Parsed(result): get_int_or(result, "count", 0) == 10
		_: False


-- ============================================================================
-- Unknown args and missing values
-- ============================================================================
func test_unknown_arg() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--unknown", "input.txt"]
	match parse(p, args):
		ParseFailed(err):
			match err:
				UnknownArg(arg): arg == "--unknown"
				_: False
		_: False


func test_missing_value() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--output"]
	match parse(p, args):
		ParseFailed(err):
			match err:
				MissingValue(arg): arg == "--output"
				_: False
		_: False


-- ============================================================================
-- Help and version
-- ============================================================================
func test_help_long() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--help"]
	match parse(p, args):
		HelpRequested(text): text.contains("myapp") and text.contains("verbose")
		_: False


func test_help_short() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "-h"]
	match parse(p, args):
		HelpRequested(text): text.contains("Usage:")
		_: False


func test_version() -> Bool:
	p: Cli = test_parser()
	args: List[String] = ["myapp", "--version"]
	match parse(p, args):
		VersionRequested(ver): ver.contains("1.0.0")
		_: False


-- ============================================================================
-- Error formatting
-- ============================================================================
func test_format_error_unknown() -> Bool:
	format_error(UnknownArg("--bad")) == "unknown argument: --bad"


func test_format_error_missing_req() -> Bool:
	format_error(MissingRequired("input")) == "missing required argument: input"


-- ============================================================================
-- Builder functions
-- ============================================================================
func test_builder_flag() -> Bool:
	spec: Param = flag("verbose", "--verbose", "-v", "Verbose")
	spec.name == "verbose" and spec.long == "--verbose" and spec.short == "-v" and spec.required == False


func test_builder_option() -> Bool:
	spec: Param = option("output", "--output", "-o", "Output", "FILE")
	spec.name == "output" and spec.metavar == "FILE"


func test_builder_required() -> Bool:
	spec: Param = required(option("output", "--output", "-o", "Output", "FILE"))
	spec.required == True


func test_builder_with_default() -> Bool:
	spec: Param = with_default(option_int("count", "--count", "-n", "Count", "N"), "10")
	spec.default_value == "10" and spec.required == False


-- ============================================================================
-- Test Suite
-- ============================================================================
tests: TestSuite = {
	description = "Argparse",
	tests = [
		("long flag", test_long_flag),
		("short flag", test_short_flag),
		("flag absent", test_flag_absent),
		("long option space", test_long_option_space),
		("long option equals", test_long_option_equals),
		("short option space", test_short_option_space),
		("short option attached", test_short_option_attached),
		("int option", test_int_option),
		("int option equals", test_int_option_equals),
		("float option", test_float_option),
		("invalid int value", test_invalid_int),
		("positional arg", test_positional),
		("positional with flags", test_positional_with_flags),
		("separator rest args", test_separator),
		("combined short flags", test_combined_flags),
		("missing required", test_missing_required),
		("missing required reports first", test_missing_required_reports_first),
		("default value", test_default_value),
		("unknown arg error", test_unknown_arg),
		("missing value error", test_missing_value),
		("help long", test_help_long),
		("help short", test_help_short),
		("version", test_version),
		("format error unknown", test_format_error_unknown),
		("format error missing", test_format_error_missing_req),
		("builder flag", test_builder_flag),
		("builder option", test_builder_option),
		("builder required", test_builder_required),
		("builder with_default", test_builder_with_default),
	],
}
