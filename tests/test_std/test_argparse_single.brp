import:
	argparse:
		Cli,
		ParseError(UnknownArg, MissingRequired),
		ParseOutcome(Parsed, ParseFailed),
		arg,
		arg_int,
		flag,
		get_flag,
		get_string_or,
		parse,
		positional,
	test: TestSuite


pure func test_parser() -> Cli:
	{
		name = "myapp",
		version = "1.0.0",
		description = "A test app",
		params = [
			flag("verbose", Some("--verbose"), Some("-v"), "Enable verbose output"),
			arg("output", Some("--output"), Some("-o"), "Output file", Some("FILE")),
			arg_int("count", Some("--count"), Some("-n"), "Number of iterations", Some("N")),
			positional("input", "Input file"),
		]
	}


func test_long_flag() -> Bool:
	args: List[String] = ["myapp", "--verbose", "input.txt"]
	match parse(test_parser(), args):
		Parsed(result): get_flag(result, "verbose")
		_: False


func test_option_equals() -> Bool:
	args: List[String] = ["myapp", "--output=out.txt", "input.txt"]
	match parse(test_parser(), args):
		Parsed(result): get_string_or(result, "output", "") == "out.txt"
		_: False


func test_missing_required() -> Bool:
	args: List[String] = ["myapp", "--verbose"]
	match parse(test_parser(), args):
		ParseFailed(err):
			match err:
				MissingRequired(name): name == "input"
				_: False
		_: False


tests: TestSuite = {
	description = "Argparse",
	tests = [
		("long flag", test_long_flag),
		("option equals", test_option_equals),
		("missing required", test_missing_required),
	]
}
