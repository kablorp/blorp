import:
	hash:
		crc32,
		crc32_bytes,
		hash,
		hash_bytes,
		hmac_sha256,
		md5,
		md5_bytes,
		sha1,
		sha1_bytes,
		sha256,
		sha256_bytes,
		sha512,
		sha512_bytes,
	test: TestSuite


pure func test_hash_deterministic() -> Bool:
	hash("hello") == hash("hello")


pure func test_hash_different() -> Bool:
	hash("hello") != hash("world")


pure func test_hash_empty() -> Bool:
	hash("") == hash("")


pure func test_hash_bytes_deterministic() -> Bool:
	hash_bytes("test".to_bytes()) == hash_bytes("test".to_bytes())


pure func test_sha256_empty() -> Bool:
	sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"


pure func test_sha256_hello() -> Bool:
	sha256("hello") == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"


pure func test_sha256_abc() -> Bool:
	sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"


pure func test_sha256_length() -> Bool:
	sha256("anything").length() == 64


pure func test_md5_empty() -> Bool:
	md5("") == "d41d8cd98f00b204e9800998ecf8427e"


pure func test_md5_hello() -> Bool:
	md5("hello") == "5d41402abc4b2a76b9719d911017c592"


pure func test_md5_abc() -> Bool:
	md5("abc") == "900150983cd24fb0d6963f7d28e17f72"


pure func test_md5_length() -> Bool:
	md5("anything").length() == 32


pure func test_sha256_long_input() -> Bool:
	s: String = (
		"The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the "
		+ "lazy dog."
	)

	sha256(s).length() == 64


pure func test_md5_long_input() -> Bool:
	s: String = (
		"The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the "
		+ "lazy dog."
	)

	md5(s).length() == 32


-- SHA-1 tests
pure func test_sha1_empty() -> Bool:
	sha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709"


pure func test_sha1_abc() -> Bool:
	sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d"


pure func test_sha1_hello() -> Bool:
	sha1("hello") == "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d"


pure func test_sha1_length() -> Bool:
	sha1("anything").length() == 40


-- SHA-512 tests
pure func test_sha512_empty() -> Bool:
	sha512("") == (
		"cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0"
		+ "ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
	)


pure func test_sha512_abc() -> Bool:
	sha512("abc") == (
		"ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a8"
		+ "36ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
	)


pure func test_sha512_length() -> Bool:
	sha512("anything").length() == 128


-- CRC32 tests
pure func test_crc32_empty() -> Bool:
	crc32("") == 0


pure func test_crc32_deterministic() -> Bool:
	crc32("hello") == crc32("hello")


pure func test_crc32_different() -> Bool:
	crc32("hello") != crc32("world")


pure func test_crc32_known_vector() -> Bool:
	-- IEEE 802.3 check value
	crc32("123456789") == 3421780262


-- _bytes variant tests
pure func test_sha256_bytes() -> Bool:
	sha256_bytes("hello".to_bytes()) == sha256("hello")


pure func test_md5_bytes() -> Bool:
	md5_bytes("hello".to_bytes()) == md5("hello")


pure func test_sha1_bytes() -> Bool:
	sha1_bytes("hello".to_bytes()) == sha1("hello")


pure func test_sha512_bytes() -> Bool:
	sha512_bytes("hello".to_bytes()) == sha512("hello")


pure func test_crc32_bytes() -> Bool:
	crc32_bytes("hello".to_bytes()) == crc32("hello")


-- HMAC-SHA256 tests
pure func test_hmac_sha256_length() -> Bool:
	hmac_sha256("key", "message").length() == 64


pure func test_hmac_sha256_deterministic() -> Bool:
	hmac_sha256("secret", "data") == hmac_sha256("secret", "data")


pure func test_hmac_sha256_different_keys() -> Bool:
	hmac_sha256("key1", "msg") != hmac_sha256("key2", "msg")


pure func test_hmac_sha256_different_msgs() -> Bool:
	hmac_sha256("key", "msg1") != hmac_sha256("key", "msg2")


pure func test_hmac_sha256_known_vector() -> Bool:
	-- RFC 4231 Test Case 2
	hmac_sha256(
		"Jefe",
		"what do ya want for nothing?",
	) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"


tests: TestSuite = {
	description = "Hash Module",
	tests = [
		("hash deterministic", test_hash_deterministic),
		("hash different", test_hash_different),
		("hash empty", test_hash_empty),
		("hash_bytes deterministic", test_hash_bytes_deterministic),
		("sha256 empty", test_sha256_empty),
		("sha256 hello", test_sha256_hello),
		("sha256 abc", test_sha256_abc),
		("sha256 length", test_sha256_length),
		("md5 empty", test_md5_empty),
		("md5 hello", test_md5_hello),
		("md5 abc", test_md5_abc),
		("md5 length", test_md5_length),
		("sha256 long input", test_sha256_long_input),
		("md5 long input", test_md5_long_input),
		("sha1 empty", test_sha1_empty),
		("sha1 abc", test_sha1_abc),
		("sha1 hello", test_sha1_hello),
		("sha1 length", test_sha1_length),
		("sha512 empty", test_sha512_empty),
		("sha512 abc", test_sha512_abc),
		("sha512 length", test_sha512_length),
		("crc32 empty", test_crc32_empty),
		("crc32 deterministic", test_crc32_deterministic),
		("crc32 different", test_crc32_different),
		("crc32 known vector", test_crc32_known_vector),
		("sha256_bytes", test_sha256_bytes),
		("md5_bytes", test_md5_bytes),
		("sha1_bytes", test_sha1_bytes),
		("sha512_bytes", test_sha512_bytes),
		("crc32_bytes", test_crc32_bytes),
		("hmac_sha256 length", test_hmac_sha256_length),
		("hmac_sha256 deterministic", test_hmac_sha256_deterministic),
		("hmac_sha256 different keys", test_hmac_sha256_different_keys),
		("hmac_sha256 different msgs", test_hmac_sha256_different_msgs),
		("hmac_sha256 known vector", test_hmac_sha256_known_vector),
	],
}
