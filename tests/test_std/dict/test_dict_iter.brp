import:
	dict as Dict
	test: TestSuite


func test_keys_count() -> Bool:
	var d: Dict[String, String] = Dict.dict()
	d = Dict.set(d, "a", "1")
	d = Dict.set(d, "b", "2")
	Dict
		.keys(d)
		.length() == 2


func test_values_count() -> Bool:
	var d: Dict[String, String] = Dict.dict()
	d = Dict.set(d, "a", "one")
	d = Dict.set(d, "b", "two")
	Dict
		.values(d)
		.length() == 2


func test_entries_count() -> Bool:
	var d: Dict[String, String] = Dict.dict()
	d = Dict.set(d, "a", "1")
	d = Dict.set(d, "b", "2")
	Dict
		.entries(d)
		.length() == 2


tests: TestSuite = {
	description = "Dict Iteration",
	tests = [
		("keys returns correct count", test_keys_count),
		("values returns correct count", test_values_count),
		("entries returns correct count", test_entries_count),
	],
}
