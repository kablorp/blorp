import:
	dict as D
	test: TestSuite


-- Tests Dict.fold and other multi-char type param module functions.
-- Regression: monomorphization failed for type params like Acc, Key, Val
-- because is_type_variable only recognized single-char names (T, A, K).
func test_dict_fold_sum() -> Bool:
	d: Dict[String, Int] = {"a" => 1, "b" => 2, "c" => 3}
	total: Int = D.fold(d, 0, func(acc: Int, k: String, v: Int): acc + v)
	total == 6


func test_dict_fold_keys() -> Bool:
	d: Dict[String, Int] = {"x" => 10, "y" => 20}
	keys: String = D.fold(d, "", func(acc: String, k: String, v: Int): acc + k)
	-- Order is insertion order
	keys == "xy"


func test_dict_fold_empty() -> Bool:
	d: Dict[String, Int] = {}
	total: Int = D.fold(d, 42, func(acc: Int, k: String, v: Int): acc + v)
	total == 42


tests: TestSuite = {
	description = "Dict fold",
	tests = [
		("fold sum", test_dict_fold_sum),
		("fold keys", test_dict_fold_keys),
		("fold empty", test_dict_fold_empty),
	],
}
