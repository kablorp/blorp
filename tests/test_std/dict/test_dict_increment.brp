import:
	dict: Dict, count_by, dict, get_or, increment
	test: TestSuite
	traits: Addable, HasOne, HasZero


struct Step {
	value: Int
}


implements Addable for Step:
	pure func add(a: Step, b: Step) -> Step:
		{value = a.value + b.value}


implements HasOne for Step:
	pure func one() -> Step:
		{value = 1}


implements HasZero for Step:
	pure func zero() -> Step:
		{value = 0}


pure func test_increment_float_value() -> Bool:
	d: Dict[String, Float] = dict()
	d2: Dict[String, Float] = increment(d, "hits")
	d2.get_or("hits", 0.0) == 1.0


pure func test_increment_custom_value() -> Bool:
	d: Dict[String, Step] = dict()
	d2: Dict[String, Step] = increment(d, "hits")
	total: Step = d2.get_or("hits", {value = 0})
	total.value == 1


func test_count_by_still_counts_ints() -> Bool:
	counts: Dict[String, Int] = count_by(["a", "b", "a"], pure func(x: String): x)
	counts.get_or("a", 0) == 2 and counts.get_or("b", 0) == 1


tests: TestSuite = {
	description = "Dict Increment",
	tests = [
		("increment float value", test_increment_float_value),
		("increment custom value", test_increment_custom_value),
		("count_by still counts ints", test_count_by_still_counts_ints),
	]
}
