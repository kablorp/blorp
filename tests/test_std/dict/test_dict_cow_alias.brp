-- Test Dict COW Alias Independence
-- Verifies that aliasing a dict and then mutating the original
-- does NOT corrupt the alias.
import:
	dict as D
	test: TestSuite


-- Test: backup dict unchanged after alias + set
func test_alias_set() -> Bool:
	dict: Dict[String, Int] = D.dict()
	dict2: Dict[String, Int] = D.set(dict, "a", 1)
	backup: Dict[String, Int] = dict2
	dict3: Dict[String, Int] = D.set(dict2, "b", 2)
	-- backup should only have "a", not "b"
	D.contains(backup, "a") and not D.contains(backup, "b") and D.contains(dict3, "b")


-- Test: function param does not corrupt caller's dict
func add_key(d: Dict[String, Int]) -> Dict[String, Int]:
	D.set(d, "added", 99)


func test_function_param() -> Bool:
	original: Dict[String, Int] = D.dict()
	original2: Dict[String, Int] = D.set(original, "keep", 1)
	result: Dict[String, Int] = add_key(original2)
	D.contains(
		original2,
		"keep",
	) and not D.contains(original2, "added") and D.contains(result, "added")


tests: TestSuite = {
	description = "Dict COW Alias Independence",
	tests = [("alias set", test_alias_set), ("function param", test_function_param)],
}
