-- Regression: returning a dict local after using entries() must not release
-- the returned dictionary before the caller receives it.
import:
	dict as D
	test: TestSuite


func copy_from_entries(d: Dict[String, Int]) -> Dict[String, Int]:
	var result: Dict[String, Int] = D.dict()
	entries = D.entries(d)
	for pair in entries:
		result = D.set(result, pair[0], pair[1])
	result


func merge_from_entries(a: Dict[String, Int], b: Dict[String, Int]) -> Dict[String, Int]:
	var result: Dict[String, Int] = a
	entries = D.entries(b)
	for pair in entries:
		result = D.set(result, pair[0], pair[1])
	result


func test_return_fresh_result_after_entries() -> Bool:
	d: Dict[String, Int] = D.from_list([("a", 1), ("b", 2)])
	copied: Dict[String, Int] = copy_from_entries(d)
	copied.length() == 2 and D.contains(copied, "a") and D.contains(copied, "b")


func test_return_alias_result_after_entries() -> Bool:
	a: Dict[String, Int] = D.from_list([("x", 1)])
	b: Dict[String, Int] = D.from_list([("y", 2)])
	merged: Dict[String, Int] = merge_from_entries(a, b)
	merged.length() == 2 and D.contains(merged, "x") and D.contains(merged, "y") and a.length() == 1


tests: TestSuite = {
	description = "Dict Return Local After Entries",
	tests = [
		("return fresh result after entries", test_return_fresh_result_after_entries),
		("return alias result after entries", test_return_alias_result_after_entries),
	]
}
