import:
	dict as Dict
	list: append, get, length
	test: TestSuite


-- Regression: Dict get_or must work when list functions are also imported.
-- The fix ensures dict's internal get call resolves to dict's builtin,
-- not list's get from selective_imports.
-- (lookup_builtin_with_context must prefer current_module's builtin)
func test_dict_get_or_with_list_imports() -> Bool:
	-- get_or internally calls dict's get, not list's get
	d: Dict[String, Int] = Dict.set(Dict.dict(), "a", 42)
	Dict.get_or(d, "a", 0) == 42


func test_dict_get_or_default() -> Bool:
	d: Dict[String, Int] = Dict.dict()
	Dict.get_or(d, "missing", 99) == 99


func test_dict_get_with_qualified() -> Bool:
	d: Dict[String, Int] = Dict.set(Dict.dict(), "key", 7)
	match Dict.get(d, "key"):
		Some(v): v == 7
		None: False


func test_list_get_still_works() -> Bool:
	nums: List[Int] = [10, 20, 30]
	match get(nums, 1):
		Some(v): v == 20
		None: False


func test_dict_and_list_together() -> Bool:
	-- Both dict (qualified) and list (selective) in same function
	d: Dict[String, Int] = Dict.set(Dict.dict(), "x", 5)
	nums: List[Int] = [1, 2, 3]
	dict_val: Int = Dict.get_or(d, "x", 0)
	list_len: Int = nums.length()
	dict_val == 5 and list_len == 3


func test_dict_contains_with_list() -> Bool:
	d: Dict[String, Int] = Dict.set(Dict.dict(), "hello", 1)
	nums: List[Int] = [10]
	Dict.contains(d, "hello") and nums.length() == 1


func test_dict_get_match_list_value() -> Bool:
	-- Regression: match on Dict.get() must correctly type-resolve values
	-- when value type is a complex pointer type (List), not a primitive.
	-- (receiver_resolved_ret must include Dict to avoid String.get pollution
	-- which would mistype the extracted value as int32_t instead of void*)
	var d: Dict[String, List[Int]] = Dict.dict()
	d = Dict.set(d, "nums", [1, 2, 3])
	result: List[Int] = match Dict.get(d, "nums"):
		Some(existing): existing.append(4)
		None: [0]
	result.length() == 4


tests: TestSuite = {
	description = "Dict Get with List Imports",
	tests = [
		("dict get_or with list imports", test_dict_get_or_with_list_imports),
		("dict get_or returns default", test_dict_get_or_default),
		("dict get qualified", test_dict_get_with_qualified),
		("list get still works", test_list_get_still_works),
		("dict and list together", test_dict_and_list_together),
		("dict contains with list", test_dict_contains_with_list),
		("dict get match with list value", test_dict_get_match_list_value),
	],
}
