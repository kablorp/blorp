import:
	dict as Dict
	test: TestSuite


-- Test Dict functionality with qualified imports
tests: TestSuite = {
	description = "Dict Tests",
	tests = [
		("Empty map has length 0", func():
			var map: Dict[Int, String] = Dict.dict()
			map.length() == 0
		),
		("With capacity supports Int keys", func():
			var map: Dict[Int, String] = Dict.with_capacity(64)
			map = Dict.set(map, 42, "hello")

			match Dict.get(map, 42):
				Some(v):
					v == "hello"
				None:
					False
		),
		("With capacity supports String keys", func():
			var map: Dict[String, Int] = Dict.with_capacity(64)
			map = Dict.set(map, "answer", 42)

			match Dict.get(map, "answer"):
				Some(v):
					v == 42
				None:
					False
		),
		("With capacity supports Float keys", func():
			var map: Dict[Float, String] = Dict.with_capacity(64)
			map = Dict.set(map, 1.5, "one point five")

			match Dict.get(map, 1.5):
				Some(v):
					v == "one point five"
				None:
					False
		),
		("Insert and get with Int key", func():
			var map: Dict[Int, String] = Dict.dict()
			map = Dict.set(map, 42, "hello")

			match Dict.get(map, 42):
				Some(v):
					v == "hello"
				None:
					False
		),
		("Get missing key returns None", func():
			var map: Dict[Int, String] = Dict.dict()

			match Dict.get(map, 99):
				Some(_):
					False
				None:
					True
		),
		("Contains checks key presence", func():
			var map: Dict[Int, String] = Dict.dict()
			map = Dict.set(map, 5, "five")
			Dict.contains(map, 5) and not Dict.contains(map, 10)
		),
		("Remove deletes key", func():
			var map: Dict[Int, Int] = Dict.dict()
			map = Dict.set(map, 1, 100)
			map = Dict.remove(map, 1)
			not Dict.contains(map, 1)
		),
		("Insert overwrites existing value", func():
			var map: Dict[Int, String] = Dict.dict()
			map = Dict.set(map, 1, "first")
			map = Dict.set(map, 1, "second")

			match Dict.get(map, 1):
				Some(v):
					v == "second"
				None:
					False
		),
		("String keys work", func():
			var map: Dict[String, Int] = Dict.dict()
			map = Dict.set(map, "one", 1)
			map = Dict.set(map, "two", 2)

			match Dict.get(map, "one"):
				Some(v):
					v == 1
				None:
					False
		),
		("String key contains", func():
			var map: Dict[String, Int] = Dict.dict()
			map = Dict.set(map, "hello", 42)
			Dict.contains(map, "hello") and not Dict.contains(map, "world")
		),
		("Multiple entries tracked correctly", func():
			var map: Dict[Int, Int] = Dict.dict()
			map = Dict.set(map, 1, 10)
			map = Dict.set(map, 2, 20)
			map = Dict.set(map, 3, 30)
			map.length() == 3
		),
		("Length decreases after remove", func():
			var map: Dict[Int, Int] = Dict.dict()
			map = Dict.set(map, 1, 10)
			map = Dict.set(map, 2, 20)
			map = Dict.remove(map, 1)
			map.length() == 1
		),
		("Keys in insertion order", func():
			var d: Dict[Int, String] = Dict.dict()
			d = Dict.set(d, 3, "c")
			d = Dict.set(d, 1, "a")
			d = Dict.set(d, 2, "b")
			k: List[Int] = Dict.keys(d)
			match k.get(0):
				Some(v):
					v == 3
				None:
					False and match k.get(1):
				Some(v):
					v == 1
				None:
					False and match k.get(2):
				Some(v):
					v == 2
				None:
					False
		),
		("Order preserved after remove", func():
			var d: Dict[Int, String] = Dict.dict()
			d = Dict.set(d, 1, "a")
			d = Dict.set(d, 2, "b")
			d = Dict.set(d, 3, "c")
			d = Dict.remove(d, 2)
			k: List[Int] = Dict.keys(d)
			match k.get(0):
				Some(v):
					v == 1
				None:
					False and match k.get(1):
				Some(v):
					v == 3
				None:
					False
		),
		("Large int key", func():
			var map: Dict[Int, String] = Dict.dict()
			map = Dict.set(map, 2000000, "big")

			match Dict.get(map, 2000000):
				Some(v):
					v == "big"
				None:
					False
		),
		("Negative large int key", func():
			var map: Dict[Int, String] = Dict.dict()
			map = Dict.set(map, -2000000, "neg")

			match Dict.get(map, -2000000):
				Some(v):
					v == "neg"
				None:
					False
		),
		("Max int key", func():
			var map: Dict[Int, String] = Dict.dict()
			map = Dict.set(map, 3000000000, "max")

			match Dict.get(map, 3000000000):
				Some(v):
					v == "max"
				None:
					False
		),
		("Zero key", func():
			var map: Dict[Int, Int] = Dict.dict()
			map = Dict.set(map, 0, 42)

			match Dict.get(map, 0):
				Some(v):
					v == 42
				None:
					False
		),
		("Boundary int keys", func():
			var map: Dict[Int, Int] = Dict.dict()
			map = Dict.set(map, 999999, 1)
			map = Dict.set(map, 1000000, 2)
			map = Dict.set(map, 1000001, 3)
			match Dict.get(map, 999999):
				Some(v):
					v == 1
				None:
					False and match Dict.get(map, 1000000):
				Some(v):
					v == 2
				None:
					False and match Dict.get(map, 1000001):
				Some(v):
					v == 3
				None:
					False
		),
	]
}
