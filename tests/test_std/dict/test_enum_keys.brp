import:
	dict as D
	set as S
	test: TestSuite


enum Color:
	Red
	Green
	Blue


func test_dict_enum_keys() -> Bool:
	var d: Dict[Color, String] = D.dict()
	d = D.set(d, Red, "red")
	d = D.set(d, Blue, "blue")
	D.contains(d, Red) and not D.contains(d, Green) and match D.get(d, Blue):
		Some(v): v == "blue"
		None: False


func test_dict_enum_overwrite() -> Bool:
	var d: Dict[Color, Int] = D.dict()
	d = D.set(d, Green, 1)
	d = D.set(d, Green, 2)
	D.length(d) == 1 and match D.get(d, Green):
		Some(v): v == 2
		None: False


func test_set_enum_keys() -> Bool:
	var s: Set[Color] = S.set()
	s = S.add(s, Red)
	s = S.add(s, Blue)
	S.contains(s, Red) and S.contains(s, Blue) and not S.contains(s, Green)


tests: TestSuite = {
	description = "Enum keys in dict and set",
	tests = [
		("dict enum keys", test_dict_enum_keys),
		("dict enum overwrite", test_dict_enum_overwrite),
		("set enum keys", test_set_enum_keys),
	],
}
