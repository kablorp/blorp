import:
	dict as D
	test: TestSuite


-- Tests that empty {} literal correctly creates a Dict when typed as Dict.
-- Regression: codegen was emitting blorp_vector_new(0) for empty {} regardless
-- of type annotation, causing heap-buffer-overflow when dict operations ran on
-- a vector-sized allocation.
func test_empty_dict_string_int() -> Bool:
	d: Dict[String, Int] = {}
	D.length(d) == 0


func test_empty_dict_set() -> Bool:
	var d: Dict[String, Int] = {}
	d = D.set(d, "a", 1)
	d = D.set(d, "b", 2)
	D.length(d) == 2


func test_empty_dict_int_string() -> Bool:
	var d: Dict[Int, String] = {}
	d = D.set(d, 1, "hello")
	d = D.set(d, 2, "world")
	D.length(d) == 2


func test_empty_dict_get() -> Bool:
	var d: Dict[String, Int] = {}
	d = D.set(d, "key", 42)
	match D.get(d, "key"):
		Some(v): v == 42
		None: False


tests: TestSuite = {
	description = "Dict empty literal",
	tests = [
		("empty dict length", test_empty_dict_string_int),
		("empty dict set", test_empty_dict_set),
		("empty dict int key", test_empty_dict_int_string),
		("empty dict get", test_empty_dict_get),
	],
}
