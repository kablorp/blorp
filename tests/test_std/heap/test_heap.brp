import:
	heap as H: Heap
	list as L
	test: TestSuite


-- Test new heap is empty
func test_new_empty() -> Bool:
	h: Heap[Int] = H.heap()
	H.size(h) == 0 and H.is_empty(h)


-- Test push increases size
func test_push_one() -> Bool:
	h: Heap[Int] = H.push(H.heap(), 5)
	H.size(h) == 1


-- Test push two elements
func test_push_two() -> Bool:
	var h: Heap[Int] = H.heap()
	h = H.push(h, 3)
	h = H.push(h, 1)
	H.size(h) == 2


-- Test push three elements
func test_push_three() -> Bool:
	var h: Heap[Int] = H.heap()
	h = H.push(h, 3)
	h = H.push(h, 1)
	h = H.push(h, 2)
	H.size(h) == 3


-- Test peek returns minimum
func test_peek_min() -> Bool:
	var h: Heap[Int] = H.heap()
	h = H.push(h, 3)
	h = H.push(h, 1)
	h = H.push(h, 2)

	match H.peek(h):
		Some(v):
			v == 1
		None:
			False


-- Test peek on empty returns None
func test_peek_empty() -> Bool:
	h: Heap[Int] = H.heap()

	match H.peek(h):
		Some(_):
			False
		None:
			True


-- Test pop returns minimum
func test_pop_min() -> Bool:
	var h: Heap[Int] = H.heap()
	h = H.push(h, 3)
	h = H.push(h, 1)
	h = H.push(h, 2)

	match H.pop(h):
		Some(pair):
			pair[0] == 1
		None:
			False


-- Test pop decreases size
func test_pop_size() -> Bool:
	var h: Heap[Int] = H.heap()
	h = H.push(h, 3)
	h = H.push(h, 1)

	match H.pop(h):
		Some(pair):
			H.size(pair[1]) == 1
		None:
			False


-- Test pop on empty returns None
func test_pop_empty() -> Bool:
	h: Heap[Int] = H.heap()

	match H.pop(h):
		Some(_):
			False
		None:
			True


-- Test from_list preserves min
func test_from_list_min() -> Bool:
	h: Heap[Int] = H.from_list([5, 3, 1, 4, 2])

	match H.peek(h):
		Some(v):
			v == 1
		None:
			False


-- Test from_list size
func test_from_list_size() -> Bool:
	h: Heap[Int] = H.from_list([5, 3, 1, 4, 2])
	H.size(h) == 5


-- Test to_sorted_list
func test_to_sorted() -> Bool:
	h: Heap[Int] = H.from_list([5, 3, 1, 4, 2])
	sorted: List[Int] = H.to_sorted(h)

	match L.get(sorted, 0):
		Some(v0):
			match L.get(sorted, 1):
				Some(v1):
					match L.get(sorted, 2):
						Some(v2):
							v0 == 1 and v1 == 2 and v2 == 3
						None:
							False
				None:
					False
		None:
			False


-- Test single element
func test_single() -> Bool:
	h: Heap[Int] = H.push(H.heap(), 42)

	match H.peek(h):
		Some(v):
			v == 42
		None:
			False


-- Test pop all elements in order
func test_pop_all() -> Bool:
	var h: Heap[Int] = H.heap()
	h = H.push(h, 2)
	h = H.push(h, 1)

	match H.pop(h):
		Some(p1):
			match H.pop(p1[1]):
				Some(p2):
					p1[0] == 1 and p2[0] == 2 and H.is_empty(p2[1])
				None:
					False
		None:
			False


-- Test duplicate values
func test_duplicates() -> Bool:
	h: Heap[Int] = H.from_list([3, 1, 1, 2, 3])

	match H.peek(h):
		Some(v):
			v == 1 and H.size(h) == 5
		None:
			False


tests: TestSuite = {
	description = "Min-Heap",
	tests = [
		("new empty", test_new_empty),
		("push one", test_push_one),
		("push two", test_push_two),
		("push three", test_push_three),
		("peek min", test_peek_min),
		("peek empty", test_peek_empty),
		("pop min", test_pop_min),
		("pop size", test_pop_size),
		("pop empty", test_pop_empty),
		("from_list min", test_from_list_min),
		("from_list size", test_from_list_size),
		("to_sorted", test_to_sorted),
		("single element", test_single),
		("pop all", test_pop_all),
		("duplicates", test_duplicates),
	]
}
