import:
	heap as H: Heap
	list as L
	test: TestSuite


-- Core heap operations that exercise set_index through list_swap
func test_push_two() -> Bool:
	var h: Heap[Int] = H.heap()
	h = H.push(h, 3)
	h = H.push(h, 1)
	H.size(h) == 2


func test_push_maintains_min() -> Bool:
	var h: Heap[Int] = H.heap()
	h = H.push(h, 3)
	h = H.push(h, 1)
	match H.peek(h):
		Some(v): v == 1
		None: False


func test_pop_returns_min() -> Bool:
	var h: Heap[Int] = H.heap()
	h = H.push(h, 3)
	h = H.push(h, 1)
	h = H.push(h, 2)
	match H.pop(h):
		Some(pair): pair[0] == 1
		None: False


func test_from_list_sorted() -> Bool:
	h: Heap[Int] = H.from_list([5, 3, 1, 4, 2])
	sorted: List[Int] = H.to_sorted(h)
	match L.get(sorted, 0):
		Some(v0):
			match L.get(sorted, 4):
				Some(v4): v0 == 1 and v4 == 5
				None: False
		None: False


tests: TestSuite = {
	description = "Heap COW",
	tests = [
		("push two", test_push_two),
		("push maintains min", test_push_maintains_min),
		("pop returns min", test_pop_returns_min),
		("from_list sorted", test_from_list_sorted),
	],
}
