import:
	deque as Deque
	list as L
	test: TestSuite


-- Test new deque is empty
func test_new_empty() -> Bool:
	d: (List[Int], List[Int]) = Deque.deque()
	Deque.is_empty(d) and Deque.length(d) == 0


-- Test push front
func test_push_front() -> Bool:
	var d: (List[Int], List[Int]) = Deque.deque()
	d = Deque.push_front(d, 1)
	Deque.length(d) == 1


-- Test push back
func test_push_back() -> Bool:
	var d: (List[Int], List[Int]) = Deque.deque()
	d = Deque.push_back(d, 1)
	Deque.length(d) == 1


-- Test push front then peek front
func test_push_front_peek() -> Bool:
	var d: (List[Int], List[Int]) = Deque.deque()
	d = Deque.push_front(d, 1)
	d = Deque.push_front(d, 2)
	match Deque.peek_front(d):
		Some(v): v == 2
		None: False


-- Test push back then peek back
func test_push_back_peek() -> Bool:
	var d: (List[Int], List[Int]) = Deque.deque()
	d = Deque.push_back(d, 1)
	d = Deque.push_back(d, 2)
	match Deque.peek_back(d):
		Some(v): v == 2
		None: False


-- Test pop front returns LIFO from front
func test_pop_front() -> Bool:
	var d: (List[Int], List[Int]) = Deque.deque()
	d = Deque.push_front(d, 1)
	d = Deque.push_front(d, 2)
	match Deque.pop_front(d):
		Some(pair): pair[0] == 2
		None: False


-- Test pop back returns LIFO from back
func test_pop_back() -> Bool:
	var d: (List[Int], List[Int]) = Deque.deque()
	d = Deque.push_back(d, 1)
	d = Deque.push_back(d, 2)
	match Deque.pop_back(d):
		Some(pair): pair[0] == 2
		None: False


-- Test pop front on empty
func test_pop_front_empty() -> Bool:
	d: (List[Int], List[Int]) = Deque.deque()
	match Deque.pop_front(d):
		Some(_): False
		None: True


-- Test pop back on empty
func test_pop_back_empty() -> Bool:
	d: (List[Int], List[Int]) = Deque.deque()
	match Deque.pop_back(d):
		Some(_): False
		None: True


-- Test push back then pop front (FIFO)
func test_fifo() -> Bool:
	var d: (List[Int], List[Int]) = Deque.deque()
	d = Deque.push_back(d, 1)
	d = Deque.push_back(d, 2)
	d = Deque.push_back(d, 3)
	match Deque.pop_front(d):
		Some(pair): pair[0] == 1
		None: False


-- Test to_list preserves order
func test_to_list() -> Bool:
	var d: (List[Int], List[Int]) = Deque.deque()
	d = Deque.push_back(d, 1)
	d = Deque.push_back(d, 2)
	d = Deque.push_back(d, 3)
	lst: List[Int] = Deque.to_list(d)
	match L.get(lst, 0):
		Some(v): v == 1
		None: False


-- Test mixed operations
func test_mixed() -> Bool:
	var d: (List[Int], List[Int]) = Deque.deque()
	d = Deque.push_front(d, 2)
	d = Deque.push_back(d, 3)
	d = Deque.push_front(d, 1)

	-- Should be: [1, 2, 3]
	Deque.length(d) == 3


-- Test peek on empty
func test_peek_empty() -> Bool:
	d: (List[Int], List[Int]) = Deque.deque()
	match Deque.peek_front(d):
		Some(_): False
		None: True


tests: TestSuite = {
	description = "Deque",
	tests = [
		("new empty", test_new_empty),
		("push front", test_push_front),
		("push back", test_push_back),
		("push front peek", test_push_front_peek),
		("push back peek", test_push_back_peek),
		("pop front", test_pop_front),
		("pop back", test_pop_back),
		("pop front empty", test_pop_front_empty),
		("pop back empty", test_pop_back_empty),
		("fifo order", test_fifo),
		("to_list", test_to_list),
		("mixed ops", test_mixed),
		("peek empty", test_peek_empty),
	],
}
