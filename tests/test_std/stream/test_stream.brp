import:
	list: length
	option: Option(Some, None)
	stream as S:
		all,
		any,
		collect,
		count,
		find,
		fold,
		from_lines,
		from_list,
		from_range,
		repeat,
		unfold,
	system: remove_file, write_file
	test: TestSuite


-- ============================================================================
-- Source tests
-- ============================================================================
func test_from_list() -> Bool:
	items: List[Int] = collect(from_list([1, 2, 3]))
	items == [1, 2, 3]


func test_from_list_empty() -> Bool:
	items: List[Int] = collect(from_list([]))
	items.length() == 0


func test_from_range() -> Bool:
	items: List[Int] = collect(from_range(0, 5))
	items == [0, 1, 2, 3, 4]


-- ============================================================================
-- Intermediate operation tests
-- ============================================================================
func test_map() -> Bool:
	items: List[Int] = collect(S.map(from_list([1, 2, 3]), func(x: Int): x * 2))
	items == [2, 4, 6]


func test_map_int_to_string_collect() -> Bool:
	items: List[String] = collect(S.map(from_list([1, 2, 3]), func(x: Int): x.to_string()))
	first_ok: Bool = match items.get(0):
		Some(s): s == "1"
		None: False
	third_ok: Bool = match items.get(2):
		Some(s): s == "3"
		None: False
	items.length() == 3 and first_ok and third_ok


func test_filter() -> Bool:
	items: List[Int] = collect(S.filter(from_list([1, 2, 3, 4, 5]), func(x: Int): x % 2 == 0))
	items == [2, 4]


func test_filter_map() -> Bool:
	items: List[Int] = collect(
		S.filter_map(from_list([1, 2, 3, 4, 5]), func(x: Int):
			if x > 3:
				Some(x * 10)
			else:
				None
		)
	)
	items == [40, 50]


func keep_long_string(s: String) -> Option[String]:
	if s.length() > 1:
		Some(s)
	else:
		None


func test_filter_map_string_nullable() -> Bool:
	items: List[String] = collect(S.filter_map(from_list(["a", "bee", "cat"]), keep_long_string))
	first_ok: Bool = match items.get(0):
		Some(s): s == "bee"
		None: False
	second_ok: Bool = match items.get(1):
		Some(s): s == "cat"
		None: False
	items.length() == 2 and first_ok and second_ok


func test_take() -> Bool:
	items: List[Int] = collect(S.take(from_list([1, 2, 3, 4, 5]), 3))
	items == [1, 2, 3]


func test_drop() -> Bool:
	items: List[Int] = collect(S.drop(from_list([1, 2, 3, 4, 5]), 2))
	items == [3, 4, 5]


func test_take_while() -> Bool:
	items: List[Int] = collect(S.take_while(from_list([1, 2, 3, 4, 5]), func(x: Int): x < 4))
	items == [1, 2, 3]


func test_enumerate() -> Bool:
	pairs: List[(Int, String)] = collect(S.enumerate(from_list(["a", "b", "c"])))
	pairs.length() == 3


func test_chain() -> Bool:
	var s: Stream[Int] = from_list([1, 2, 3, 4, 5])
	s = S.filter(s, func(x: Int): x > 1)
	s = S.map(s, func(x: Int): x * 10)
	s = S.take(s, 2)
	items: List[Int] = collect(s)
	items == [20, 30]


func test_for_loop_over_stream() -> Bool:
	var total: Int = 0
	for n in from_list([1, 2, 3]):
		total += n
	total == 6


func test_repeat_string_collect() -> Bool:
	items: List[String] = collect(S.take(repeat("h" + "a"), 3))
	first_ok: Bool = match items.get(0):
		Some(s): s == "ha"
		None: False
	third_ok: Bool = match items.get(2):
		Some(s): s == "ha"
		None: False
	items.length() == 3 and first_ok and third_ok


func unfold_int_step(n: Int) -> Option[(Int, Int)]:
	if n < 3:
		Some((n, n + 1))
	else:
		None


func test_unfold_int_collect() -> Bool:
	items: List[Int] = collect(unfold(0, unfold_int_step))
	items == [0, 1, 2]


func unfold_string_step(n: Int) -> Option[(String, Int)]:
	if n < 3:
		Some((n.to_string(), n + 1))
	else:
		None


func test_unfold_string_collect() -> Bool:
	items: List[String] = collect(unfold(0, unfold_string_step))
	first_ok: Bool = match items.get(0):
		Some(s): s == "0"
		None: False
	third_ok: Bool = match items.get(2):
		Some(s): s == "2"
		None: False
	items.length() == 3 and first_ok and third_ok


func unfold_string_state_step(state: String) -> Option[(String, String)]:
	if state.length() < 4:
		Some((state, state + "a"))
	else:
		None


func test_unfold_managed_state_collect() -> Bool:
	items: List[String] = collect(unfold("a" + "", unfold_string_state_step))
	first_ok: Bool = match items.get(0):
		Some(s): s == "a"
		None: False
	third_ok: Bool = match items.get(2):
		Some(s): s == "aaa"
		None: False
	items.length() == 3 and first_ok and third_ok


func test_from_lines_collect() -> Bool:
	path: String = "/tmp/blorp_stream_from_lines_collect.txt"
	_ = write_file(path, "alpha\nbeta\r\n")
	items: List[String] = collect(from_lines(path))
	_ = remove_file(path)
	first_ok: Bool = match items.get(0):
		Some(s): s == "alpha"
		None: False
	second_ok: Bool = match items.get(1):
		Some(s): s == "beta"
		None: False
	items.length() == 2 and first_ok and second_ok


func test_from_lines_missing_is_empty_compat() -> Bool:
	items: List[String] = collect(from_lines("/tmp/blorp_stream_missing_compat.txt"))
	items.length() == 0


-- ============================================================================
-- Terminal operation tests
-- ============================================================================
func test_fold() -> Bool:
	total: Int = fold(from_list([1, 2, 3, 4]), 0, func(acc: Int, x: Int): acc + x)
	total == 10


func test_count() -> Bool:
	n: Int = count(S.filter(from_list([1, 2, 3, 4, 5]), func(x: Int): x > 2))
	n == 3


func test_count_enumerate() -> Bool:
	count(S.enumerate(from_list(["a", "b", "c"]))) == 3


func test_find() -> Bool:
	result: Option[Int] = find(from_list([1, 2, 3, 4, 5]), func(x: Int): x > 3)
	match result:
		Some(v): v == 4
		None: False


func test_any() -> Bool:
	any(from_list([1, 2, 3]), func(x: Int): x == 2)


func test_all() -> Bool:
	all(from_list([2, 4, 6]), func(x: Int): x % 2 == 0)


func test_all_false() -> Bool:
	not all(from_list([2, 3, 6]), func(x: Int): x % 2 == 0)


-- ============================================================================
-- Infinite stream tests
-- ============================================================================
func test_take_from_range() -> Bool:
	-- Use range as an infinite-like source with take
	items: List[Int] = collect(S.take(from_range(0, 1000), 5))
	items == [0, 1, 2, 3, 4]


func test_from_lines_file() -> Bool:
	path: String = "/tmp/__blorp_stream_lines"
	_ = write_file(path, "one\ntwo\r\nthree")
	items: List[String] = collect(S.from_lines(path))
	_ = remove_file(path)
	items == ["one", "two", "three"]


func test_from_lines_rejects_nul_path() -> Bool:
	path: String = "/tmp/__blorp_stream_lines_nul"
	_ = write_file(path, "visible")
	items: List[String] = collect(S.from_lines(path + "\0hidden"))
	_ = remove_file(path)
	items.length() == 0


-- ============================================================================
-- Test suite
-- ============================================================================
tests: TestSuite = {
	description = "Stream",
	tests = [
		("from_list", test_from_list),
		("from_list empty", test_from_list_empty),
		("from_range", test_from_range),
		("map", test_map),
		("map int to string collect", test_map_int_to_string_collect),
		("filter", test_filter),
		("filter_map", test_filter_map),
		("filter_map string nullable", test_filter_map_string_nullable),
		("take", test_take),
		("drop", test_drop),
		("take_while", test_take_while),
		("enumerate", test_enumerate),
		("chain", test_chain),
		("for loop over stream", test_for_loop_over_stream),
		("repeat string collect", test_repeat_string_collect),
		("unfold int collect", test_unfold_int_collect),
		("unfold string collect", test_unfold_string_collect),
		("unfold managed state collect", test_unfold_managed_state_collect),
		("from_lines collect", test_from_lines_collect),
		("from_lines missing is empty compat", test_from_lines_missing_is_empty_compat),
		("fold", test_fold),
		("count", test_count),
		("count enumerate", test_count_enumerate),
		("find", test_find),
		("any", test_any),
		("all", test_all),
		("all false", test_all_false),
		("take from range", test_take_from_range),
		("from_lines file", test_from_lines_file),
		("from_lines rejects NUL path", test_from_lines_rejects_nul_path),
	],
}
