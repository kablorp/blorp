import:
	list: length
	option: Option(Some, None)
	stream as S: all, any, collect, count, find, fold, from_list, from_range
	test: TestSuite


-- ============================================================================
-- Source tests
-- ============================================================================
func test_from_list() -> Bool:
	items: List[Int] = collect(from_list([1, 2, 3]))
	items == [1, 2, 3]


func test_from_list_empty() -> Bool:
	items: List[Int] = collect(from_list([]))
	items.length() == 0


func test_from_range() -> Bool:
	items: List[Int] = collect(from_range(0, 5))
	items == [0, 1, 2, 3, 4]


-- ============================================================================
-- Intermediate operation tests
-- ============================================================================
func test_map() -> Bool:
	items: List[Int] = collect(S.map(from_list([1, 2, 3]), func(x: Int): x * 2))
	items == [2, 4, 6]


func test_filter() -> Bool:
	items: List[Int] = collect(S.filter(from_list([1, 2, 3, 4, 5]), func(x: Int): x % 2 == 0))
	items == [2, 4]


func test_filter_map() -> Bool:
	items: List[Int] = collect(
		S.filter_map(from_list([1, 2, 3, 4, 5]), func(x: Int):
			if x > 3:
				Some(x * 10)
			else:
				None
		)
	)
	items == [40, 50]


func keep_long_string(s: String) -> Option[String]:
	if s.length() > 1:
		Some(s)
	else:
		None


func test_filter_map_string_nullable() -> Bool:
	items: List[String] = collect(S.filter_map(from_list(["a", "bee", "cat"]), keep_long_string))
	first_ok: Bool = match items.get(0):
		Some(s): s == "bee"
		None: False
	second_ok: Bool = match items.get(1):
		Some(s): s == "cat"
		None: False
	items.length() == 2 and first_ok and second_ok


func test_take() -> Bool:
	items: List[Int] = collect(S.take(from_list([1, 2, 3, 4, 5]), 3))
	items == [1, 2, 3]


func test_drop() -> Bool:
	items: List[Int] = collect(S.drop(from_list([1, 2, 3, 4, 5]), 2))
	items == [3, 4, 5]


func test_take_while() -> Bool:
	items: List[Int] = collect(S.take_while(from_list([1, 2, 3, 4, 5]), func(x: Int): x < 4))
	items == [1, 2, 3]


func test_enumerate() -> Bool:
	pairs: List[(Int, String)] = collect(S.enumerate(from_list(["a", "b", "c"])))
	pairs.length() == 3


func test_chain() -> Bool:
	var s: Stream[Int] = from_list([1, 2, 3, 4, 5])
	s = S.filter(s, func(x: Int): x > 1)
	s = S.map(s, func(x: Int): x * 10)
	s = S.take(s, 2)
	items: List[Int] = collect(s)
	items == [20, 30]


-- ============================================================================
-- Terminal operation tests
-- ============================================================================
func test_fold() -> Bool:
	total: Int = fold(from_list([1, 2, 3, 4]), 0, func(acc: Int, x: Int): acc + x)
	total == 10


func test_count() -> Bool:
	n: Int = count(S.filter(from_list([1, 2, 3, 4, 5]), func(x: Int): x > 2))
	n == 3


func test_count_enumerate() -> Bool:
	count(S.enumerate(from_list(["a", "b", "c"]))) == 3


func test_find() -> Bool:
	result: Option[Int] = find(from_list([1, 2, 3, 4, 5]), func(x: Int): x > 3)
	match result:
		Some(v): v == 4
		None: False


func test_any() -> Bool:
	any(from_list([1, 2, 3]), func(x: Int): x == 2)


func test_all() -> Bool:
	all(from_list([2, 4, 6]), func(x: Int): x % 2 == 0)


func test_all_false() -> Bool:
	not all(from_list([2, 3, 6]), func(x: Int): x % 2 == 0)


-- ============================================================================
-- Infinite stream tests
-- ============================================================================
func test_take_from_range() -> Bool:
	-- Use range as an infinite-like source with take
	items: List[Int] = collect(S.take(from_range(0, 1000), 5))
	items == [0, 1, 2, 3, 4]


-- ============================================================================
-- Test suite
-- ============================================================================
tests: TestSuite = {
	description = "Stream",
	tests = [
		("from_list", test_from_list),
		("from_list empty", test_from_list_empty),
		("from_range", test_from_range),
		("map", test_map),
		("filter", test_filter),
		("filter_map", test_filter_map),
		("filter_map string nullable", test_filter_map_string_nullable),
		("take", test_take),
		("drop", test_drop),
		("take_while", test_take_while),
		("enumerate", test_enumerate),
		("chain", test_chain),
		("fold", test_fold),
		("count", test_count),
		("count enumerate", test_count_enumerate),
		("find", test_find),
		("any", test_any),
		("all", test_all),
		("all false", test_all_false),
		("take from range", test_take_from_range),
	],
}
