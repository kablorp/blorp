import:
	process: run, shell
	system: mkstemp_path, remove_file, write_file
	test: TestSuite


func write_source_file(src: String) -> Result[String, String]:
	match mkstemp_path("blorp_io_"):
		Err(e): Err("mkstemp failed: " + e)
		Ok(path):
			match write_file(path, src):
				Err(e):
					_ = remove_file(path)
					Err("write failed: " + e)
				Ok(_): Ok(path)


func run_source(src: String) -> (Bool, String, Int):
	match write_source_file(src):
		Err(e): (False, e, 1)
		Ok(path):
			result: (Bool, String, Int) = match run("./blorp", ["run", "--no-format", path]):
				Ok(out): (out.2 == 0, out.0, out.2)
				Err(e): (False, "run failed: " + e, 1)
			_ = remove_file(path)
			result


func test_print_accepts_stringable_and_puts_omits_newline() -> Bool:
	src: String = "func main(args: List[String]) -> Int:\n    print(42)\n    puts(\"A\")\n    puts(7)\n    print(True)\n    0\n"
	result: (Bool, String, Int) = run_source(src)
	result.0 and result.1 == "42\nA7True\n" and result.2 == 0


func test_err_print_is_available_from_prelude_and_writes_stderr() -> Bool:
	src: String = "func main(args: List[String]) -> Int:\n    err_print(\"problem\")\n    0\n"
	match write_source_file(src):
		Err(_): False
		Ok(path):
			result: Bool = match run("./blorp", ["run", "--no-format", path]):
				Ok(out): out.2 == 0 and out.0 == "" and out.1 == "problem\n"
				Err(_): False
			_ = remove_file(path)
			result


func test_input_is_available_from_prelude() -> Bool:
	src: String = "func main(args: List[String]) -> Int:\n    match input(\"Name: \"):\n        Some(name): print(name)\n        None: print(\"eof\")\n    0\n"
	match write_source_file(src):
		Err(_): False
		Ok(path):
			result: Bool = match shell("printf 'Ada\\n' | ./blorp run --no-format " + path):
				Ok(out): out.2 == 0 and out.0 == "Name: Ada\n"
				Err(_): False
			_ = remove_file(path)
			result


func test_input_reports_eof() -> Bool:
	src: String = "func main(args: List[String]) -> Int:\n    match input(\"Name: \"):\n        Some(_): print(\"line\")\n        None: print(\"eof\")\n    0\n"
	match write_source_file(src):
		Err(_): False
		Ok(path):
			result: Bool = match shell("printf '' | ./blorp run --no-format " + path):
				Ok(out): out.2 == 0 and out.0 == "Name: eof\n"
				Err(_): False
			_ = remove_file(path)
			result


func test_input_distinguishes_empty_line_from_eof() -> Bool:
	src: String = "func main(args: List[String]) -> Int:\n    match input(\"Name: \"):\n        Some(name): print(\"line:\" + name)\n        None: print(\"eof\")\n    0\n"
	match write_source_file(src):
		Err(_): False
		Ok(path):
			empty_line: Bool = match shell("printf '\\n' | ./blorp run --no-format " + path):
				Ok(out): out.2 == 0 and out.0 == "Name: line:\n"
				Err(_): False
			eof: Bool = match shell("printf '' | ./blorp run --no-format " + path):
				Ok(out): out.2 == 0 and out.0 == "Name: eof\n"
				Err(_): False
			_ = remove_file(path)
			empty_line and eof


func test_input_or_empty_preserves_empty_string_eof() -> Bool:
	src: String = "import:\n    io: input_or_empty\n\nfunc main(args: List[String]) -> Int:\n    name = input_or_empty(\"Name: \")\n    print(\"value:\" + name)\n    0\n"
	match write_source_file(src):
		Err(_): False
		Ok(path):
			result: Bool = match run("./blorp", ["run", "--no-format", path]):
				Ok(out): out.2 == 0 and out.0 == "Name: value:\n"
				Err(_): False
			_ = remove_file(path)
			result


tests: TestSuite = {
	description = "io print/puts",
	tests = [
		(
			"print accepts Stringable and puts omits newline",
			test_print_accepts_stringable_and_puts_omits_newline,
		),
		(
			"err_print is available from prelude and writes stderr",
			test_err_print_is_available_from_prelude_and_writes_stderr,
		),
		("input is available from prelude", test_input_is_available_from_prelude),
		("input reports EOF", test_input_reports_eof),
		("input distinguishes empty line from EOF", test_input_distinguishes_empty_line_from_eof),
		(
			"input_or_empty preserves empty string EOF",
			test_input_or_empty_preserves_empty_string_eof,
		),
	],
}
