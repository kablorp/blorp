import:
	list: contains, drop, find, flatten, reverse, take
	test: TestSuite


-- Test new list utility functions
-- ============================================================================
-- reverse
-- ============================================================================
func test_reverse_basic() -> Bool:
	reversed: List[Int] = reverse([1, 2, 3])
	ok1: Bool = match reversed.get(0):
		Some(v): v == 3
		None: False
	ok2: Bool = match reversed.get(2):
		Some(v): v == 1
		None: False
	ok1 and ok2


func test_reverse_empty() -> Bool:
	reversed: List[Int] = reverse([])
	reversed.length() == 0


func test_reverse_single() -> Bool:
	reversed: List[Int] = reverse([42])
	match reversed.get(0):
		Some(v): v == 42
		None: False


-- ============================================================================
-- find
-- ============================================================================
func test_find_present() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	match nums.find(func(x: Int): x > 3):
		Some(v): v == 4
		None: False


func test_find_absent() -> Bool:
	nums: List[Int] = [1, 2, 3]
	match nums.find(func(x: Int): x > 10):
		Some(_): False
		None: True


func test_find_empty() -> Bool:
	nums: List[Int] = []
	match nums.find(func(x: Int): x > 0):
		Some(_): False
		None: True


-- ============================================================================
-- contains
-- ============================================================================
func test_contains_present() -> Bool:
	nums: List[Int] = [1, 2, 3]
	nums.contains(2)


func test_contains_absent() -> Bool:
	nums: List[Int] = [1, 2, 3]
	not nums.contains(5)


func test_contains_string() -> Bool:
	words: List[String] = ["a", "b", "c"]
	words.contains("b")


-- ============================================================================
-- take / drop
-- ============================================================================
func test_take_basic() -> Bool:
	result: List[Int] = [1, 2, 3, 4, 5].take(3)
	ok1: Bool = result.length() == 3
	ok2: Bool = match result.get(0):
		Some(v): v == 1
		None: False
	ok3: Bool = match result.get(2):
		Some(v): v == 3
		None: False
	ok1 and ok2 and ok3


func test_take_more_than_length() -> Bool:
	result: List[Int] = [1, 2].take(10)
	result.length() == 2


func test_take_zero() -> Bool:
	result: List[Int] = [1, 2, 3].take(0)
	result.length() == 0


func test_drop_basic() -> Bool:
	result: List[Int] = [1, 2, 3, 4, 5].drop(2)
	ok1: Bool = result.length() == 3
	ok2: Bool = match result.get(0):
		Some(v): v == 3
		None: False
	ok1 and ok2


func test_drop_all() -> Bool:
	result: List[Int] = [1, 2, 3].drop(3)
	result.length() == 0


func test_drop_zero() -> Bool:
	result: List[Int] = [1, 2, 3].drop(0)
	result.length() == 3


-- ============================================================================
-- flatten
-- ============================================================================
func test_flatten_basic() -> Bool:
	nested: List[List[Int]] = [[1, 2], [3, 4], [5]]
	result: List[Int] = flatten(nested)
	ok1: Bool = result.length() == 5
	ok2: Bool = match result.get(0):
		Some(v): v == 1
		None: False
	ok3: Bool = match result.get(4):
		Some(v): v == 5
		None: False
	ok1 and ok2 and ok3


func test_flatten_empty_inner() -> Bool:
	nested: List[List[Int]] = [[], [1], []]
	result: List[Int] = flatten(nested)
	result.length() == 1


func test_flatten_empty() -> Bool:
	nested: List[List[Int]] = []
	result: List[Int] = flatten(nested)
	result.length() == 0


tests: TestSuite = {
	description = "List Utilities",
	tests = [
		("reverse basic", test_reverse_basic),
		("reverse empty", test_reverse_empty),
		("reverse single", test_reverse_single),
		("find present", test_find_present),
		("find absent", test_find_absent),
		("find empty", test_find_empty),
		("contains present", test_contains_present),
		("contains absent", test_contains_absent),
		("contains string", test_contains_string),
		("take basic", test_take_basic),
		("take more than length", test_take_more_than_length),
		("take zero", test_take_zero),
		("drop basic", test_drop_basic),
		("drop all", test_drop_all),
		("drop zero", test_drop_zero),
		("flatten basic", test_flatten_basic),
		("flatten empty inner", test_flatten_empty_inner),
		("flatten empty", test_flatten_empty),
	],
}
