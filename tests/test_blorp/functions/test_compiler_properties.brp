-- ============================================================================
-- List Generators & Properties
-- ============================================================================
-- Generate a program with random list operations
pure func gen_list_program(state: Int) -> (String, Int):
	len_r: (Int, Int) = rng_int(state, 0, 10)
	op_r: (Int, Int) = rng_int(len_r.1, 0, 5)
	-- Build list literal
	var st: Int = op_r.1
	var elems: String = ""
	var j: Int = 0
	while j < len_r.0:
		val: (Int, Int) = rng_int(st, 0, 100)
		if j > 0:
			elems += ", "
		elems += val.0.to_string()
		st = val.1
		j += 1
	list_lit: String = "[" + elems + "]"
	op: String = match op_r.0:
		0: "    print(xs.length().to_string())"
		1: "    ys: List[Int] = xs.append(999)\n    print(ys.length().to_string())"
		2: "    sorted: List[Int] = sort(xs)\n    print(sorted.length().to_string())"
		3: "    match get(xs, 0):\n        Some(v): print(v.to_string())\n        None: print(\"empty\")"
		_: "    var total: Int = 0\n    for x in xs:\n        total = total + x\n    print(total.to_string())"
	imports: String = match op_r.0:
		1: "    list: List, append\n"
		2: "    list: List, sort\n"
		3: "    list: List, get\n    option: Option(Some, None)\n"
		_: "    list: List\n"
	src: String = "import:\n" + imports + "\nfunc main(args: List[String]) -> Int:\n    xs: List[Int] = " + list_lit + "\n" + op + "\n    0\n"
	(src, st)


func test_list_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 700)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_list_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): list program didn't type-check: " + result.1,
			)
			all_ok = False
		i += 1
	all_ok


func test_list_programs_run() -> Bool:
	var state: Int = rng_new(SEED + 701)
	var all_ok: Bool = True
	var i: Int = 0
	while i < RUN_CASES and all_ok:
		prog: (String, Int) = gen_list_program(state)
		state = prog.1
		result: (Bool, String, Int) = compile_and_run(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): list program crashed (exit " + result.2.to_string() + ")",
			)
			all_ok = False
		i += 1
	all_ok


-- ============================================================================
-- Set & Dict Generators & Properties
-- ============================================================================
pure func gen_set_program(state: Int) -> (String, Int):
	len_r: (Int, Int) = rng_int(state, 1, 8)
	var st: Int = len_r.1
	var adds: String = ""
	var j: Int = 0
	while j < len_r.0:
		val: (Int, Int) = rng_int(st, 0, 50)
		adds = adds + "    s = S.add(s, " + val.0.to_string() + ")\n"
		st = val.1
		j += 1
	src: String = "import:\n    set as S\n    list: length\n\nfunc main(args: List[String]) -> Int:\n    var s: Set[Int] = S.set()\n" + adds + "    print(S.to_list(s).length().to_string())\n    0\n"
	(src, st)


pure func gen_dict_program(state: Int) -> (String, Int):
	len_r: (Int, Int) = rng_int(state, 1, 6)
	var st: Int = len_r.1
	var sets: String = ""
	var j: Int = 0
	while j < len_r.0:
		val: (Int, Int) = rng_int(st, 0, 100)
		sets = sets + "    d = D.set(d, \"k" + j.to_string() + "\", " + val.0.to_string() + ")\n"
		st = val.1
		j += 1
	src: String = "import:\n    dict as D\n    list: length\n\nfunc main(args: List[String]) -> Int:\n    var d: Dict[String, Int] = D.dict()\n" + sets + "    print(D.keys(d).length().to_string())\n    0\n"
	(src, st)


func test_set_programs_run() -> Bool:
	var state: Int = rng_new(SEED + 800)
	var all_ok: Bool = True
	var i: Int = 0
	while i < RUN_CASES and all_ok:
		prog: (String, Int) = gen_set_program(state)
		state = prog.1
		result: (Bool, String, Int) = compile_and_run(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): set program crashed (exit " + result.2.to_string() + ")",
			)
			all_ok = False
		i += 1
	all_ok


func test_dict_programs_run() -> Bool:
	var state: Int = rng_new(SEED + 801)
	var all_ok: Bool = True
