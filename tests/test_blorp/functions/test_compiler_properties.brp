tests: TestSuite = {
	description = "Compiler Properties",
	tests = [
		("arithmetic programs type-check", test_arith_programs_typecheck),
		("if/else programs type-check", test_if_programs_typecheck),
		("Option programs type-check", test_option_programs_typecheck),
		("pure function programs type-check", test_pure_func_programs_typecheck),
		("type errors rejected", test_type_errors_rejected),
		("purity violations rejected", test_purity_violations_rejected),
		("arithmetic programs run", test_arith_programs_run),
		("pure functions deterministic", test_pure_func_deterministic),
		("parser doesnt crash on fuzz", test_parser_doesnt_crash),
		("safe arithmetic never crashes", test_safe_arithmetic_never_crashes),
		("vector programs type-check", test_vector_programs_typecheck),
		("vector programs run", test_vector_programs_run),
		("matrix programs type-check", test_matrix_programs_typecheck),
		("list programs type-check", test_list_programs_typecheck),
		("list programs run", test_list_programs_run),
		("set programs run", test_set_programs_run),
		("dict programs run", test_dict_programs_run),
		("record programs type-check", test_record_programs_typecheck),
		("record programs run", test_record_programs_run),
		("generic programs type-check", test_generic_programs_typecheck),
		("generic programs run", test_generic_programs_run),
		("match programs type-check", test_match_programs_typecheck),
		("match programs run", test_match_programs_run),
		("type error variants rejected", test_type_error_variants_rejected),
	],
}
