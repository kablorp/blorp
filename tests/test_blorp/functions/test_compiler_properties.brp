-- ============================================================================
-- Record Generators & Properties
-- ============================================================================
pure func gen_record_program(state: Int) -> (String, Int):
	x_r: (Int, Int) = rng_int(state, 0, 100)
	y_r: (Int, Int) = rng_int(x_r.1, 0, 100)
	op_r: (Int, Int) = rng_int(y_r.1, 0, 3)
	op: String = match op_r.0:
		0: "    print((p.x + p.y).to_string())"
		1: "    q: Point = { p | x = 99 }\n    print(q.x.to_string())"
		_: "    print(p.x.to_string() + \",\" + p.y.to_string())"
	src: String = "record Point {x: Int, y: Int}\n\nfunc main(args: List[String]) -> Int:\n    p: Point = {x = " + to_string(
		x_r.0,
	) + ", y = " + y_r.0.to_string() + "}\n" + op + "\n    0\n"
	(src, op_r.1)


func test_record_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 900)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_record_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): record program didn't type-check: " + result.1,
			)
			all_ok = False
		i += 1
	all_ok


func test_record_programs_run() -> Bool:
	var state: Int = rng_new(SEED + 901)
	var all_ok: Bool = True
	var i: Int = 0
	while i < RUN_CASES and all_ok:
		prog: (String, Int) = gen_record_program(state)
		state = prog.1
		result: (Bool, String, Int) = compile_and_run(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): record program crashed (exit " + result.2.to_string() + ")",
			)
			all_ok = False
		i += 1
	all_ok


-- ============================================================================
-- Generic Function Generators & Properties
-- ============================================================================
-- Generate programs that use generic functions with different type instantiations
func gen_generic_src(v: Int, n: Int) -> String:
	if v == 0:
		"pure func identity[T](x: T) -> T:\n    x\n\nfunc main(args: List[String]) -> Int:\n    a: Int = identity(" + to_string(
			n,
		) + ")\n    b: String = identity(\"hello\")\n    print(a.to_string() + \" \" + b)\n    0\n"
	else if v == 1:
		"pure func first[A, B](a: A, b: B) -> A:\n    a\n\nfunc main(args: List[String]) -> Int:\n    x: Int = first(" + to_string(
			n,
		) + ", \"text\")\n    print(x.to_string())\n    0\n"
	else if v == 2:
		"import:\n    list: List, length\n\npure func count[T](items: List[T]) -> Int:\n    items.length()\n\nfunc main(args: List[String]) -> Int:\n    a: Int = count([1, 2, 3])\n    print(a.to_string())\n    0\n"
	else:
		"import:\n    option: Option(Some, None)\n\npure func my_unwrap[T](opt: Option[T], d: T) -> T:\n    match opt:\n        Some(val): val\n        None: d\n\nfunc main(args: List[String]) -> Int:\n    a: Int = my_unwrap(Some(" + to_string(
			n,
		) + "), 0)\n    print(a.to_string())\n    0\n"


func gen_generic_program(state: Int) -> (String, Int):
	variant_r: (Int, Int) = rng_int(state, 0, 4)
	val_r: (Int, Int) = rng_int(variant_r.1, 1, 50)
	(gen_generic_src(variant_r.0, val_r.0), val_r.1)


func test_generic_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 1000)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_generic_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): generic program didn't type-check: " + result.1,
			)
			all_ok = False
		i += 1
	all_ok


func test_generic_programs_run() -> Bool:
	var state: Int = rng_new(SEED + 1001)
	var all_ok: Bool = True
	var i: Int = 0
	while i < RUN_CASES and all_ok:
		prog: (String, Int) = gen_generic_program(state)
		state = prog.1
		result: (Bool, String, Int) = compile_and_run(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): generic program crashed (exit " + result.2.to_string() + ")",
			)
			all_ok = False
		i += 1
	all_ok


-- ============================================================================
-- Pattern Matching Generators & Properties
-- ============================================================================
-- Generate programs with various pattern match shapes
func gen_match_src(v: Int, n: Int) -> String:
	if v == 0:
		"union Shape:\n    Circle(Float)\n    Rect(Float, Float)\n\npure func area(s: Shape) -> Float:\n    match s:\n        Circle(r): 3.14 * r * r\n        Rect(w, h): w * h\n\nfunc main(args: List[String]) -> Int:\n    print(area(Circle(5.0)).to_string())\n    print(area(Rect(3.0, 4.0)).to_string())\n    0\n"
	else if v == 1:
		"import:\n    list: List\n\nfunc describe(xs: List[Int]) -> String:\n    match xs:\n        []: \"empty\"\n        [x]: \"one: \" + x.to_string()\n        [x, y, ...rest]: \"many: \" + x.to_string()\n\nfunc main(args: List[String]) -> Int:\n    print(describe([]))\n    print(describe([" + to_string(
			n,
		) + "]))\n    print(describe([1, 2, 3]))\n    0\n"
	else if v == 2:
		"func swap(pair: (Int, String)) -> (String, Int):\n    (pair.1, pair.0)\n\nfunc main(args: List[String]) -> Int:\n    result: (String, Int) = swap((" + to_string(
			n,
		) + ", \"hello\"))\n    print(result.0 + \" \" + result.1.to_string())\n    0\n"
	else if v == 3:
		"func classify(n: Int) -> String:\n    match n:\n        0: \"zero\"\n        1 | 2 | 3: \"small\"\n        _: \"big\"\n\nfunc main(args: List[String]) -> Int:\n    print(classify(" + to_string(
			n,
		) + "))\n    0\n"
	else:
		"import:\n    option: Option(Some, None)\n    list: List, get\n\nfunc safe_first(xs: List[Int]) -> String:\n    match get(xs, 0):\n        Some(val):\n            if val > 50:\n                \"big\"\n            else:\n                \"small\"\n        None: \"empty\"\n\nfunc main(args: List[String]) -> Int:\n    print(safe_first([" + to_string(
			n,
		) + "]))\n    print(safe_first([]))\n    0\n"


func gen_match_program(state: Int) -> (String, Int):
	variant_r: (Int, Int) = rng_int(state, 0, 5)
	val_r: (Int, Int) = rng_int(variant_r.1, 0, 100)
	(gen_match_src(variant_r.0, val_r.0), val_r.1)


func test_match_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 1100)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_match_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): match program didn't type-check: " + result.1,
			)
			all_ok = False
		i += 1
	all_ok


func test_match_programs_run() -> Bool:
	var state: Int = rng_new(SEED + 1101)
	var all_ok: Bool = True
	var i: Int = 0
	while i < RUN_CASES and all_ok:
		prog: (String, Int) = gen_match_program(state)
		state = prog.1
		result: (Bool, String, Int) = compile_and_run(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): match program crashed (exit " + result.2.to_string() + ")",
			)
			all_ok = False
		i += 1
	all_ok


-- ============================================================================
-- Type Error Generators (should be rejected)
-- ============================================================================
-- Generate programs with various type errors
func gen_type_error_src(v: Int) -> String:
	if v == 0:
		"func main(args: List[String]) -> Int:\n    x: Int = 1 + \"hello\"\n    0\n"
	else if v == 1:
		"func foo() -> Int:\n    \"not an int\"\n\nfunc main(args: List[String]) -> Int:\n    0\n"
	else if v == 2:
		"func main(args: List[String]) -> Int:\n    x: Int = True\n    0\n"
	else if v == 3:
		"pure func add(a: Int, b: Int) -> Int:\n    a + b\n\nfunc main(args: List[String]) -> Int:\n    print(add(1, \"two\").to_string())\n    0\n"
	else if v == 4:
		"func main(args: List[String]) -> Int:\n    x: Int = 42\n    x = 99\n    0\n"
	else:
		"pure func bad() -> Int:\n    print(\"side effect\")\n    0\n\nfunc main(args: List[String]) -> Int:\n    0\n"


-- Bool used where Int expected
func gen_type_error_variant(state: Int) -> (String, Int):
	variant_r: (Int, Int) = rng_int(state, 0, 6)
	(gen_type_error_src(variant_r.0), variant_r.1)


func test_type_error_variants_rejected() -> Bool:
	var state: Int = rng_new(SEED + 1200)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_type_error_variant(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if result.0:
			print("  FAIL (seed=" + SEED.to_string() + "): type error program was accepted")
			all_ok = False
		i += 1
	all_ok


