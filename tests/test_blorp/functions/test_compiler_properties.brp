-- Property-based compiler testing
--
-- Generates random blorp programs and verifies compiler properties:
-- 1. Well-typed programs compile without errors
-- 2. Ill-typed programs are rejected
-- 3. Compiled programs produce correct results
-- 4. The parser never crashes (returns errors gracefully)
import:
	process: run
	random: rng_bool, rng_int, rng_new
	string: contains
	system: mkstemp_path, remove_file, write_file
	test: TestSuite
	time: now


BLORP: String = "./blorp"

-- Time-based seed so each run covers different programs.
-- Printed in errors for reproducibility.
SEED: Int = now() / 1000

TYPECHECK_CASES: Int = 1

RUN_CASES: Int = 1

FUZZ_CASES: Int = 1


-- ============================================================================
-- Helpers
-- ============================================================================
func write_source_file(src: String) -> Result[String, String]:
	match mkstemp_path("blorp_prop_"):
		Err(e): Err("mkstemp failed: " + e)
		Ok(path):
			match write_file(path, src):
				Err(e):
					_ = remove_file(path)
					Err("write failed: " + e)
				Ok(_): Ok(path)


func compile_check(src: String) -> (Bool, String):
	-- Returns (success, stderr)
	match write_source_file(src):
		Err(e): (False, e)
		Ok(path):
			result: (Bool, String) = match run(BLORP, ["check", path]):
				Ok(out): (out.2 == 0, out.1)
				Err(e): (False, "run failed: " + e)
			_ = remove_file(path)
			result


func compile_and_run(src: String) -> (Bool, String, Int):
	-- Returns (success, stdout, exit_code)
	match write_source_file(src):
		Err(e): (False, e, 1)
		Ok(path):
			result: (Bool, String, Int) = match run(BLORP, ["run", path]):
				Ok(out): (out.2 == 0, out.0, out.2)
				Err(e): (False, "run failed: " + e, 1)
			_ = remove_file(path)
			result


-- ============================================================================
-- Program Generators
-- ============================================================================
-- Generate a valid arithmetic expression
pure func gen_arith_expr(state: Int, depth: Int) -> (String, Int):
	if depth <= 0:
		r: (Int, Int) = rng_int(state, 0, 100)
		(r.0.to_string(), r.1)
	else:
		op_r: (Int, Int) = rng_int(state, 0, 4)
		op: String = match op_r.0:
			0: " + "
			1: " - "
			2: " * "
			_: " / "
		left: (String, Int) = gen_arith_expr(op_r.1, depth - 1)
		right: (String, Int) = gen_arith_expr(left.1, depth - 1)
		("(" + left.0 + op + right.0 + ")", right.1)


-- Generate a valid program that prints an arithmetic result
pure func gen_arith_program(state: Int) -> (String, Int):
	expr: (String, Int) = gen_arith_expr(state, 3)
	src: String = "func main(args: List[String]) -> Int:\n    result: Int = " + expr.0 + "\n    print(result.to_string())\n    0\n"
	(src, expr.1)


-- Generate a valid program with if/else
pure func gen_if_program(state: Int) -> (String, Int):
	val_r: (Int, Int) = rng_int(state, 0, 200)
	thresh_r: (Int, Int) = rng_int(val_r.1, 0, 200)
	src: String = "func main(args: List[String]) -> Int:\n    x: Int = " + to_string(
		val_r.0,
	) + "\n    result: String = if x > " + to_string(
		thresh_r.0,
	) + ":\n        \"big\"\n    else:\n        \"small\"\n    print(result)\n    0\n"
	(src, thresh_r.1)


-- Generate a valid program with match on Option
pure func gen_option_program(state: Int) -> (String, Int):
	val_r: (Int, Int) = rng_int(state, 0, 100)
	use_some: (Bool, Int) = rng_bool(val_r.1)
	opt_expr: String = if use_some.0:
		"Some(" + val_r.0.to_string() + ")"
	else:
		"None"
	src: String = "import:\n    option: Option(Some, None)\n\nfunc main(args: List[String]) -> Int:\n    x: Option[Int] = " + opt_expr + "\n    result: Int = match x:\n        Some(v): v\n        None: 0\n    print(result.to_string())\n    0\n"
	(src, use_some.1)


-- Generate a valid program with a pure function
pure func gen_pure_func_program(state: Int) -> (String, Int):
	a_r: (Int, Int) = rng_int(state, 1, 50)
	b_r: (Int, Int) = rng_int(a_r.1, 1, 50)
	src: String = "pure func add(a: Int, b: Int) -> Int:\n    a + b\n\nfunc main(args: List[String]) -> Int:\n    print(to_string(add(" + to_string(
		a_r.0,
	) + ", " + b_r.0.to_string() + ")))\n    0\n"
	(src, b_r.1)


-- Generate a program with a type error (Int + String)
pure func gen_type_error_program(state: Int) -> (String, Int):
	val_r: (Int, Int) = rng_int(state, 0, 100)
	src: String = "func main(args: List[String]) -> Int:\n    x: Int = " + to_string(
		val_r.0,
	) + " + \"hello\"\n    0\n"
	(src, val_r.1)


-- Generate a program with a purity violation
pure func gen_purity_error_program(state: Int) -> (String, Int):
	src: String = "pure func bad() -> Void:\n    print(\"side effect\")\n\nfunc main(args: List[String]) -> Int:\n    0\n"
	(src, state)


-- Generate random garbage strings to fuzz the parser
pure func gen_fuzz_string(state: Int, max_len: Int) -> (String, Int):
	len_r: (Int, Int) = rng_int(state, 1, max_len)
	var st: Int = len_r.1
	var result: String = ""
	var i: Int = 0
	while i < len_r.0:
		ch_r: (Int, Int) = rng_int(st, 32, 127)
		result += to_char(ch_r.0).to_string()
		st = ch_r.1
		i += 1
	(result, st)


-- ============================================================================
-- Property Tests
-- ============================================================================
-- Property: random arithmetic programs type-check
func test_arith_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 42)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_arith_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): arithmetic program didn't type-check: " + result.1,
			)
			all_ok = False
		i += 1
	all_ok


-- Property: random if/else programs type-check
func test_if_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 123)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_if_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + SEED.to_string() + "): if program didn't type-check: " + result.1,
			)
			all_ok = False
		i += 1
	all_ok


-- Property: random Option programs type-check
func test_option_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 999)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_option_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): option program didn't type-check: " + result.1,
			)
			all_ok = False
		i += 1
	all_ok


-- Property: pure function programs type-check
func test_pure_func_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 777)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_pure_func_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): pure func program didn't type-check: " + result.1,
			)
			all_ok = False
		i += 1
	all_ok


-- Property: type error programs are rejected
func test_type_errors_rejected() -> Bool:
	var state: Int = rng_new(SEED + 55)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_type_error_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if result.0:
			print("  FAIL (seed=" + SEED.to_string() + "): type error program was accepted")
			all_ok = False
		i += 1
	all_ok


-- Property: purity violations are rejected
func test_purity_violations_rejected() -> Bool:
	result: (Bool, String) = compile_check(
		"pure func bad() -> Void:\n    print(\"oops\")\n\nfunc main(args: List[String]) -> Int:\n    0\n",
	)
	if result.0:
		print("  FAIL (seed=" + SEED.to_string() + "): purity violation was accepted")
		False
	else:
		result.1.contains("impure")


-- Property: arithmetic programs run correctly (safe division by zero)
func test_arith_programs_run() -> Bool:
	var state: Int = rng_new(SEED + 314)
	var all_ok: Bool = True
	var i: Int = 0
	while i < RUN_CASES and all_ok:
		prog: (String, Int) = gen_arith_program(state)
		state = prog.1
		result: (Bool, String, Int) = compile_and_run(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): arithmetic program crashed (exit " + result.2.to_string() + ")",
			)
			all_ok = False
		i += 1
	all_ok


-- Property: pure function results are deterministic
func test_pure_func_deterministic() -> Bool:
	-- Run the same program twice, results should match
	src: String = "pure func compute(x: Int) -> Int:\n    (x * 7 + 3) / 2\n\nfunc main(args: List[String]) -> Int:\n    print(compute(42).to_string())\n    0\n"
	r1: (Bool, String, Int) = compile_and_run(src)
	r2: (Bool, String, Int) = compile_and_run(src)
	if not r1.0 or not r2.0:
		print("  FAIL (seed=" + SEED.to_string() + "): pure function program crashed")
		False
	else:
		r1.1 == r2.1


-- Property: parser doesn't crash on random input
func test_parser_doesnt_crash() -> Bool:
	var state: Int = rng_new(SEED + 666)
	var all_ok: Bool = True
	var i: Int = 0
	while i < FUZZ_CASES and all_ok:
		fuzz: (String, Int) = gen_fuzz_string(state, 50)
		state = fuzz.1
		-- Compiler should return an error, not crash (exit != signal)
		match write_source_file(fuzz.0):
			Ok(path):
				match run(BLORP, ["check", path]):
					Ok(out):
						-- Exit code 1 = error (good), exit code > 128 = signal (crash)
						if out.2 > 128:
							print(
								"  FAIL: parser crashed on fuzz input (signal " + to_string(
									out.2 - 128,
								) + ")",
							)
							all_ok = False
					Err(_): void
				_ = remove_file(path)
			Err(_): void
		i += 1
	all_ok


-- Property: safe arithmetic never crashes
func test_safe_arithmetic_never_crashes() -> Bool:
	-- Generate programs with division by zero, modulo by zero, overflow
	var state: Int = rng_new(SEED + 1234)
	var all_ok: Bool = True
	var i: Int = 0
	while i < RUN_CASES and all_ok:
		a_r: (Int, Int) = rng_int(state, -1000, 1000)
		src: String = "func main(args: List[String]) -> Int:\n    x: Int = " + to_string(
			a_r.0,
		) + " / 0\n    y: Int = " + to_string(
			a_r.0,
		) + " % 0\n    print(x.to_string() + \" \" + y.to_string())\n    0\n"
		state = a_r.1
		result: (Bool, String, Int) = compile_and_run(src)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): safe arithmetic crashed (exit " + result.2.to_string() + ")",
			)
			all_ok = False
		i += 1
	all_ok


-- ============================================================================
-- Vector / Tensor Generators & Properties
-- ============================================================================
-- Generate a program that creates and operates on a fixed-size Vector
pure func gen_vector_program(state: Int) -> (String, Int):
	size_r: (Int, Int) = rng_int(state, 2, 8)
	val_r: (Int, Int) = rng_int(size_r.1, 1, 50)
	op_r: (Int, Int) = rng_int(val_r.1, 0, 3)
	op: String = match op_r.0:
		0: "    var total: Float = 0.0\n    for i in 0..length(v):\n        total = total + v[i]\n    print(total.to_string())"
		1: "    v2: Float[#" + to_string(
			size_r.0,
		) + "] = vector(" + to_string(
			val_r.0 + 1,
		) + ".0, " + to_string(
			size_r.0,
		) + ")\n    for i in 0..length(v):\n        print((v[i] + v2[i]).to_string())"
		_: "    print(v.length().to_string())"
	fval: String = val_r.0.to_string() + ".0"
	src: String = "import:\n    vector: length\n\nfunc main(args: List[String]) -> Int:\n    v: Float[#" + to_string(
		size_r.0,
	) + "] = vector(" + fval + ", " + size_r.0.to_string() + ")\n" + op + "\n    0\n"
	(src, op_r.1)


-- Generate a program that creates and operates on a Matrix
pure func gen_matrix_program(state: Int) -> (String, Int):
	rows_r: (Int, Int) = rng_int(state, 2, 5)
	cols_r: (Int, Int) = rng_int(rows_r.1, 2, 5)
	val_r: (Int, Int) = rng_int(cols_r.1, 1, 20)
	fval: String = val_r.0.to_string() + ".0"
	src: String = "import:\n    vector: length\n\nfunc main(args: List[String]) -> Int:\n    m: Float[#" + to_string(
		rows_r.0,
	) + ", #" + to_string(
		cols_r.0,
	) + "] = matrix(" + fval + ", " + to_string(
		rows_r.0,
	) + ", " + cols_r.0.to_string() + ")\n    print(m.length().to_string())\n    0\n"
	(src, val_r.1)


func test_vector_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 500)
	var all_ok: Bool = True
	var i: Int = 0
	while i < TYPECHECK_CASES and all_ok:
		prog: (String, Int) = gen_vector_program(state)
		state = prog.1
		result: (Bool, String) = compile_check(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): vector program didn't type-check: " + result.1,
			)
			all_ok = False
		i += 1
	all_ok


func test_vector_programs_run() -> Bool:
	var state: Int = rng_new(SEED + 501)
	var all_ok: Bool = True
	var i: Int = 0
	while i < RUN_CASES and all_ok:
		prog: (String, Int) = gen_vector_program(state)
		state = prog.1
		result: (Bool, String, Int) = compile_and_run(prog.0)
		if not result.0:
			print(
				"  FAIL (seed=" + to_string(
					SEED,
				) + "): vector program crashed (exit " + result.2.to_string() + ")",
			)
			all_ok = False
		i += 1
	all_ok


func test_matrix_programs_typecheck() -> Bool:
	var state: Int = rng_new(SEED + 600)
