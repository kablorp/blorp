import:
	test: TestSuite


tests: TestSuite = {
	description = "Sort tests",
	tests = [
		("sort int basic", func():
			sorted: List[Int] = [3, 1, 4, 1, 5, 9, 2, 6].sort()
			match sorted.get(0):
				Some(v): v == 1
				None: False
		),
		("sort int last element", func():
			sorted: List[Int] = [3, 1, 4, 1, 5, 9, 2, 6].sort()
			match sorted.get(7):
				Some(v): v == 9
				None: False
		),
		("sort int empty", func():
			empty: List[Int] = []
			empty
				.sort()
				.length() == 0
		),
		("sort int single", func():
			sorted: List[Int] = [42].sort()
			sorted.length() == 1 and match sorted.get(0):
				Some(v): v == 42
				None: False
		),
		("sort int sorted", func():
			sorted: List[Int] = [1, 2, 3, 4, 5].sort()
			match sorted.get(0):
				Some(v): v == 1
				None: False
			and match sorted.get(4):
				Some(v): v == 5
				None: False
		),
		("sort int reversed", func():
			sorted: List[Int] = [5, 4, 3, 2, 1].sort()
			match sorted.get(0):
				Some(v): v == 1
				None: False
			and match sorted.get(4):
				Some(v): v == 5
				None: False
		),
		("sort int negative", func():
			sorted: List[Int] = [3, -1, 0, -5, 2].sort()
			match sorted.get(0):
				Some(v): v == -5
				None: False
			and match sorted.get(4):
				Some(v): v == 3
				None: False
		),
		("sort int duplicates", func():
			sorted: List[Int] = [5, 3, 3, 1, 5, 2, 1].sort()
			sorted == [1, 1, 2, 3, 3, 5, 5]
		),
		("sort int method syntax", func():
			sorted: List[Int] = [3, 1, 2].sort()
			sorted == [1, 2, 3]
		),
		("sort preserves original when shared", func():
			nums: List[Int] = [3, 1, 2]
			nums_ref: List[Int] = nums
			sorted: List[Int] = nums.sort()
			match nums.get(0):
				Some(v): v == 3
				None: False
			and match sorted.get(0):
				Some(v): v == 1
				None: False
			and nums_ref.length() == 3
		),
		("sort string", func():
			sorted: List[String] = ["banana", "apple", "cherry"].sort()
			match sorted.get(0):
				Some(v): v == "apple"
				None: False
			and match sorted.get(2):
				Some(v): v == "cherry"
				None: False
		),
		("sort string empty", func():
			empty: List[String] = []
			empty
				.sort()
				.length() == 0
		),
		("sort float", func():
			sorted: List[Float] = [3.14, 1.0, 2.71, 0.5].sort()
			match sorted.get(0):
				Some(v): v == 0.5
				None: False
			and match sorted.get(3):
				Some(v): v == 3.14
				None: False
		),
		("sort stability", func():
			-- Sort strings by length only; equal-length strings should preserve order
			-- "hi" and "ab" both have length 2; "hi" comes first in input
			xs: List[String] = ["hello", "hi", "hey", "ab"]
			sorted: List[String] = xs.sort()
			-- Lexicographic sort: "ab" < "hello" < "hey" < "hi"
			sorted == ["ab", "hello", "hey", "hi"]
		)
	]
}
