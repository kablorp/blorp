import:
	dict as D
	list: List, append, contains, get, length, remove, sort
	set as S
	test: TestSuite


-- Regression tests for overloaded builtins
-- Ensures correct dispatch when multiple modules export the same function name.
-- Critical for typed AST: builtin resolution must use module context, not types.
-- ============================================================================
-- contains: List, Dict, Set
-- ============================================================================
func test_list_contains() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5]
	xs.contains(3) and not xs.contains(99)


func test_dict_contains() -> Bool:
	var d: Dict[String, Int] = D.dict()
	d = D.set(d, "a", 1)
	d = D.set(d, "b", 2)
	D.contains(d, "a") and not D.contains(d, "z")


func test_set_contains() -> Bool:
	var s: Set[Int] = S.set()
	s = S.add(s, 10)
	s = S.add(s, 20)
	S.contains(s, 10) and not S.contains(s, 99)


-- ============================================================================
-- get: List, Dict
-- ============================================================================
func test_list_get() -> Bool:
	xs: List[String] = ["alpha", "beta", "gamma"]
	match get(xs, 1):
		Some(v): v == "beta"
		None: False


func test_dict_get() -> Bool:
	d: Dict[String, Int] = D.set(D.dict(), "key", 42)
	match D.get(d, "key"):
		Some(v): v == 42
		None: False


func test_dict_get_missing() -> Bool:
	d: Dict[String, Int] = D.dict()
	match D.get(d, "nope"):
		Some(_): False
		None: True


-- ============================================================================
-- set/remove: Dict, Set, List
-- ============================================================================
func test_dict_set_and_remove() -> Bool:
	d: Dict[String, Int] = D.set(D.dict(), "x", 100)
	d2: Dict[String, Int] = D.remove(d, "x")
	not D.contains(d2, "x")


func test_set_add_and_remove() -> Bool:
	s: Set[Int] = S.add(S.add(S.set(), 1), 2)
	s2: Set[Int] = S.remove(s, 1)
	not S.contains(s2, 1) and S.contains(s2, 2)


func test_list_remove() -> Bool:
	xs: List[Int] = [10, 20, 30, 40]
	match xs.remove(1):
		Some(ys): ys.length() == 3
		None: False


-- ============================================================================
-- length: List, Dict, Set
-- ============================================================================
func test_list_length() -> Bool:
	xs: List[Int] = [1, 2, 3]
	xs.length() == 3


func test_dict_length() -> Bool:
	var d: Dict[String, Int] = D.dict()
	d = D.set(d, "a", 1)
	d = D.set(d, "b", 2)
	D.length(d) == 2


func test_set_length() -> Bool:
	s: Set[Int] = S.add(S.add(S.add(S.set(), 1), 2), 3)
	S.length(s) == 3


-- ============================================================================
-- append and sort
-- ============================================================================
func test_list_append() -> Bool:
	xs: List[Int] = append([1, 2], 3)
	xs.length() == 3


func test_sort_int() -> Bool:
	xs: List[Int] = sort([3, 1, 2])
	match get(xs, 0):
		Some(v): v == 1
		None: False


func test_sort_string() -> Bool:
	xs: List[String] = sort(["banana", "apple", "cherry"])
	match get(xs, 0):
		Some(v): v == "apple"
		None: False


-- ============================================================================
-- Mixed usage: multiple overloads in same function
-- ============================================================================
func test_mixed_contains() -> Bool:
	xs: List[Int] = [1, 2, 3]
	d: Dict[String, Int] = D.set(D.dict(), "key", 1)
	list_has: Bool = xs.contains(2)
	dict_has: Bool = D.contains(d, "key")
	list_has and dict_has


func test_mixed_length() -> Bool:
	xs: List[Int] = [1, 2, 3, 4]
	l_len: Int = xs.length()
	d_len: Int = D.length(D.set(D.dict(), "a", 1))
	l_len == 4 and d_len == 1


func test_generic_list_ops() -> Bool:
	ints: List[Int] = [10, 20, 30]
	strs: List[String] = ["a", "b", "c"]
	ints.contains(20) and strs.contains("b") and ints.length() == 3 and strs.length() == 3


tests: TestSuite = {
	description = "Overloaded Builtins",
	tests = [
		("list contains", test_list_contains),
		("dict contains", test_dict_contains),
		("set contains", test_set_contains),
		("list get", test_list_get),
		("dict get", test_dict_get),
		("dict get missing", test_dict_get_missing),
		("dict set and remove", test_dict_set_and_remove),
		("set add and remove", test_set_add_and_remove),
		("list remove", test_list_remove),
		("list length", test_list_length),
		("dict length", test_dict_length),
		("set length", test_set_length),
		("list append", test_list_append),
		("sort int", test_sort_int),
		("sort string", test_sort_string),
		("mixed contains", test_mixed_contains),
		("mixed length", test_mixed_length),
		("generic list ops", test_generic_list_ops),
	]
}
