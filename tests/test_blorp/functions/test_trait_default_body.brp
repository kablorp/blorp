-- Runtime: the default-body synthesizer must produce a working
-- method, not just one that typechecks. This test asserts that the
-- synthesized Orderable comparison defaults for a user record give the expected
-- answer — proving the UFCS rewrite + impl-method registration
-- actually dispatches at runtime, not just at typecheck.
import:
	test: TestSuite


record Weight {grams: Int}


implements Equatable for Weight:
	pure func equals(a: Weight, b: Weight) -> Bool:
		a.grams == b.grams


implements Orderable for Weight:
	pure func less_than(a: Weight, b: Weight) -> Bool:
		a.grams < b.grams


pure func test_synthesized_gt() -> Bool:
	heavy: Weight = {grams = 200}
	light: Weight = {grams = 100}
	heavy > light and not (light > heavy)


pure func test_synthesized_le() -> Bool:
	a: Weight = {grams = 100}
	b: Weight = {grams = 200}
	c: Weight = {grams = 100}
	a <= b and a <= c and not (b <= a)


pure func test_synthesized_ge() -> Bool:
	a: Weight = {grams = 200}
	b: Weight = {grams = 100}
	c: Weight = {grams = 200}
	a >= b and a >= c and not (b >= a)


pure func test_synthesized_ne() -> Bool:
	a: Weight = {grams = 100}
	b: Weight = {grams = 200}
	c: Weight = {grams = 100}
	a != b and not (a != c)


tests: TestSuite = {
	description = "Trait default bodies synthesize correctly",
	tests = [
		("synthesized greater_than", test_synthesized_gt),
		("synthesized less_than_or_equal", test_synthesized_le),
		("synthesized greater_than_or_equal", test_synthesized_ge),
		("synthesized not_equals", test_synthesized_ne),
	],
}
