-- Test lambda functionality
import:
	test: TestSuite


func test_lambda_basic() -> Bool:
	var f: (Int) -> Int = func(x: Int) -> Int:
		x + 1
	f(10) == 11


func test_pure_lambda() -> Bool:
	var g = pure func(a: Int, b: Int) -> Int:
		a * b
	g(6, 7) == 42


tests: TestSuite = {
	description = "Lambda",
	tests = [
		("Basic lambda returns correct result", test_lambda_basic),
		("Pure lambda multiplication works", test_pure_lambda),
	],
}
