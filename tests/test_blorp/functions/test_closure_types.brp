-- Test closure calls with typed return values
import:
	test: TestSuite


func apply_int(f: (Int) -> Int, x: Int) -> Int:
	f(x)


func check_with(pred: (Int) -> Bool, x: Int) -> Bool:
	pred(x)


func make_scaler(scale: Float) -> (Int) -> Float:
	func(n: Int): scale * to_float(n)


tests: TestSuite = {
	description = "Closure typed returns",
	tests = [
		("int closure return", func(): apply_int(pure func(n: Int) -> Int: n * 2, 21) == 42),
		("bool closure true", func(): check_with(pure func(n: Int) -> Bool: n > 0, 5)),
		("bool closure false", func(): not check_with(pure func(n: Int) -> Bool: n > 0, -1)),
		("float capture preserves value", func():
			x: Float = 3.14
			f: (Int) -> Float = func(n: Int): x + to_float(n)
			f(0) == 3.14
		),
		("float capture addition", func():
			x: Float = 2.5
			f: (Int) -> Float = func(n: Int): x + to_float(n)
			f(1) == 3.5
		),
		("float capture multiply", func():
			scale: Float = 0.5
			f: (Int) -> Float = func(n: Int): scale * to_float(n)
			f(6) == 3.0
		),
		("mixed float and int capture", func():
			x: Float = 3.14
			n: Int = 10
			f: () -> Int = func(): n + 1
			f() == 11
		),
		("float param capture", func(): make_scaler(2.5)(4) == 10.0)
	]
}
