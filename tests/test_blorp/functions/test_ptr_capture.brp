import:
	test: TestSuite


-- Test that Ptr (foreign pointer) can be captured in closures
-- without causing crashes from incorrect retain/release on raw pointers.
-- We use blorp_malloc_checked as our foreign alloc since it's in the runtime.
foreign:
	func alloc_block(size: Int) -> Ptr = "blorp_malloc_checked"
	func free_block(p: Ptr) -> Void = "free"


-- Capture a Ptr in a lambda and return it
func capture_ptr_in_lambda(p: Ptr) -> Ptr:
	getter: () -> Ptr = func(): p
	getter()


-- Capture a Ptr in a lambda alongside other types
func capture_ptr_with_int(p: Ptr, n: Int) -> (Ptr, Int):
	getter: () -> (Ptr, Int) = func(): (p, n)
	getter()


func test_ptr_lambda_capture() -> Bool:
	p: Ptr = alloc_block(64)
	p2: Ptr = capture_ptr_in_lambda(p)

	-- p2 should be the same raw pointer
	free_block(p2)
	True


func test_ptr_mixed_capture() -> Bool:
	p: Ptr = alloc_block(32)
	result: (Ptr, Int) = capture_ptr_with_int(p, 42)
	free_block(result[0])
	result[1] == 42


tests: TestSuite = {
	description = "Ptr Capture in Closures",
	tests = [
		("ptr lambda capture", test_ptr_lambda_capture),
		("ptr mixed capture", test_ptr_mixed_capture),
	],
}
