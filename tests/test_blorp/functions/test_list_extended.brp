import:
	list:
		count,
		drop_last,
		drop_while,
		enumerate,
		find_index,
		flat_map,
		index_of,
		intersperse,
		last,
		map_indexed,
		partition,
		range,
		repeat,
		split_at,
		take_while,
		unique,
		unzip,
		zip_with,
	test: TestSuite


-- Test extended list utility functions (18 new functions)
-- ============================================================================
-- last
-- ============================================================================
func test_last_nonempty() -> Bool:
	nums: List[Int] = [10, 20, 30]
	match last(nums):
		Some(v): v == 30
		None: False


func test_last_single() -> Bool:
	nums: List[Int] = [42]
	match last(nums):
		Some(v): v == 42
		None: False


func test_last_empty() -> Bool:
	empty: List[Int] = []
	match last(empty):
		Some(_): False
		None: True


-- ============================================================================
-- drop_last
-- ============================================================================
func test_drop_last_basic() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = drop_last(nums)
	result.length() == 2


func test_drop_last_preserves_order() -> Bool:
	nums: List[Int] = [10, 20, 30]
	result: List[Int] = drop_last(nums)
	ok1: Bool = match result.get(0):
		Some(v): v == 10
		None: False
	ok2: Bool = match result.get(1):
		Some(v): v == 20
		None: False
	ok1 and ok2


func test_drop_last_empty() -> Bool:
	empty: List[Int] = []
	result: List[Int] = drop_last(empty)
	result.length() == 0


func test_drop_last_single() -> Bool:
	nums: List[Int] = [1]
	result: List[Int] = drop_last(nums)
	result.length() == 0


-- ============================================================================
-- flat_map
-- ============================================================================
func test_flat_map_duplicate() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.flat_map(func(x: Int): [x, x])
	result.length() == 6


func test_flat_map_expand() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.flat_map(func(x: Int): [x, x + 10])
	ok1: Bool = match result.get(0):
		Some(v): v == 1
		None: False
	ok2: Bool = match result.get(1):
		Some(v): v == 11
		None: False
	ok1 and ok2


func helper_empty_if_small(x: Int) -> List[Int]:
	if x > 10:
		[x]
	else:
		[]


func test_flat_map_empty_results() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.flat_map(helper_empty_if_small)
	result.length() == 0


-- ============================================================================
-- map_indexed
-- ============================================================================
func test_map_indexed_basic() -> Bool:
	nums: List[Int] = [10, 20, 30]
	result: List[Int] = nums.map_indexed(func(i: Int, x: Int): i * x)
	ok0: Bool = match result.get(0):
		Some(v): v == 0
		None: False
	ok2: Bool = match result.get(2):
		Some(v): v == 60
		None: False
	ok0 and ok2


func test_map_indexed_index_only() -> Bool:
	names: List[String] = ["a", "b", "c"]
	result: List[Int] = names.map_indexed(func(i: Int, s: String): i)
	match result.get(2):
		Some(v): v == 2
		None: False


-- ============================================================================
-- enumerate
-- ============================================================================
func test_enumerate_basic() -> Bool:
	names: List[String] = ["a", "b", "c"]
	result: List[(Int, String)] = enumerate(names)
	result.length() == 3


func make_enumerated_names() -> List[(Int, String)]:
	names: List[String] = ["a", "b", "c"]
	names.enumerate()


func test_enumerate_string_values_survive_source_scope() -> Bool:
	result: List[(Int, String)] = make_enumerated_names()
	match result.get(1):
		Some(pair): pair.0 == 1 and pair.1 == "b"
		None: False


func test_enumerate_indices() -> Bool:
	nums: List[Int] = [10, 20]
	result: List[(Int, Int)] = enumerate(nums)
	match result.get(0):
		Some(pair): pair.0 == 0 and pair.1 == 10
		None: False


func test_enumerate_empty() -> Bool:
	empty: List[Int] = []
	result: List[(Int, Int)] = enumerate(empty)
	result.length() == 0


-- ============================================================================
-- intersperse
-- ============================================================================
func test_intersperse_basic() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.intersperse(0)
	result.length() == 5


func test_intersperse_values() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.intersperse(0)
	ok1: Bool = match result.get(1):
		Some(v): v == 0
		None: False
	ok3: Bool = match result.get(3):
		Some(v): v == 0
		None: False
	ok1 and ok3


func test_intersperse_single() -> Bool:
	nums: List[Int] = [42]
	result: List[Int] = nums.intersperse(0)
	result.length() == 1


func test_intersperse_empty() -> Bool:
	empty: List[Int] = []
	result: List[Int] = empty.intersperse(0)
	result.length() == 0


-- ============================================================================
-- find_index
-- ============================================================================
func test_find_index_found() -> Bool:
	nums: List[Int] = [1, 3, 4, 6]
	match nums.find_index(func(x: Int): x % 2 == 0):
		Some(i): i == 2
		None: False


func test_find_index_not_found() -> Bool:
	nums: List[Int] = [1, 3, 5]
	match nums.find_index(func(x: Int): x % 2 == 0):
		Some(_): False
		None: True


func test_find_index_first_match() -> Bool:
	nums: List[Int] = [2, 4, 6]
	match nums.find_index(func(x: Int): x % 2 == 0):
		Some(i): i == 0
		None: False


-- ============================================================================
-- index_of
-- ============================================================================
func test_index_of_found() -> Bool:
	nums: List[Int] = [10, 20, 30]
	match nums.index_of(20):
		Some(i): i == 1
		None: False


func test_index_of_not_found() -> Bool:
	nums: List[Int] = [10, 20, 30]
	match nums.index_of(99):
		Some(_): False
		None: True


func test_index_of_first_occurrence() -> Bool:
	nums: List[Int] = [1, 2, 1, 2]
	match nums.index_of(2):
		Some(i): i == 1
		None: False


-- ============================================================================
-- count
-- ============================================================================
func test_count_basic() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5, 6]
	nums.count(func(x: Int): x % 2 == 0) == 3


func test_count_none() -> Bool:
	nums: List[Int] = [1, 3, 5]
	nums.count(func(x: Int): x % 2 == 0) == 0


func test_count_all() -> Bool:
	nums: List[Int] = [2, 4, 6]
	nums.count(func(x: Int): x % 2 == 0) == 3


func test_count_empty() -> Bool:
	empty: List[Int] = []
	empty.count(func(x: Int): x > 0) == 0


-- ============================================================================
-- take_while
-- ============================================================================
func test_take_while_basic() -> Bool:
	nums: List[Int] = [1, 2, 3, 5, 1]
	result: List[Int] = nums.take_while(func(x: Int): x < 4)
	result.length() == 3


func test_take_while_all() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.take_while(func(x: Int): x < 10)
	result.length() == 3


func test_take_while_none() -> Bool:
	nums: List[Int] = [5, 6, 7]
	result: List[Int] = nums.take_while(func(x: Int): x < 3)
	result.length() == 0


func test_take_while_preserves_order() -> Bool:
	nums: List[Int] = [1, 2, 3, 10]
	result: List[Int] = nums.take_while(func(x: Int): x < 5)
	match result.get(2):
		Some(v): v == 3
		None: False


-- ============================================================================
-- drop_while
-- ============================================================================
func test_drop_while_basic() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	result: List[Int] = nums.drop_while(func(x: Int): x < 3)
	result.length() == 3


func test_drop_while_none() -> Bool:
	nums: List[Int] = [5, 6, 7]
	result: List[Int] = nums.drop_while(func(x: Int): x < 3)
	result.length() == 3


func test_drop_while_all() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.drop_while(func(x: Int): x < 10)
	result.length() == 0


func test_drop_while_first_element() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	result: List[Int] = nums.drop_while(func(x: Int): x < 3)
	match result.get(0):
		Some(v): v == 3
		None: False


-- ============================================================================
-- partition
-- ============================================================================
func test_partition_basic() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	result: (List[Int], List[Int]) = nums.partition(func(x: Int): x % 2 == 0)
	evens: List[Int] = result.0
	odds: List[Int] = result.1
	evens.length() == 2 and odds.length() == 3


func test_partition_values() -> Bool:
	nums: List[Int] = [1, 2, 3, 4]
	result: (List[Int], List[Int]) = nums.partition(func(x: Int): x % 2 == 0)
	evens: List[Int] = result.0
	match evens.get(0):
		Some(v): v == 2
		None: False


func test_partition_empty() -> Bool:
	empty: List[Int] = []
	result: (List[Int], List[Int]) = empty.partition(func(x: Int): x > 0)
	result.0.length() == 0 and result.1.length() == 0


func test_partition_all_match() -> Bool:
	nums: List[Int] = [2, 4, 6]
	result: (List[Int], List[Int]) = nums.partition(func(x: Int): x % 2 == 0)
	result.0.length() == 3 and result.1.length() == 0


-- ============================================================================
-- split_at
-- ============================================================================
func test_split_at_middle() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	result: (List[Int], List[Int]) = nums.split_at(2)
	left: List[Int] = result.0
	right: List[Int] = result.1
	left.length() == 2 and right.length() == 3


func test_split_at_zero() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: (List[Int], List[Int]) = nums.split_at(0)
	result.0.length() == 0 and result.1.length() == 3


func test_split_at_end() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: (List[Int], List[Int]) = nums.split_at(3)
	result.0.length() == 3 and result.1.length() == 0


-- ============================================================================
-- zip_with
-- ============================================================================
func test_zip_with_add() -> Bool:
	a: List[Int] = [1, 2, 3]
	b: List[Int] = [10, 20, 30]
	result: List[Int] = a.zip_with(b, func(x: Int, y: Int): x + y)
	match result.get(0):
		Some(v): v == 11
		None: False


func test_zip_with_shorter() -> Bool:
	a: List[Int] = [1, 2]
	b: List[Int] = [10, 20, 30]
	result: List[Int] = a.zip_with(b, func(x: Int, y: Int): x + y)
	result.length() == 2


func test_zip_with_empty() -> Bool:
	empty: List[Int] = []
	b: List[Int] = [1, 2, 3]
	result: List[Int] = empty.zip_with(b, func(x: Int, y: Int): x + y)
	result.length() == 0


-- ============================================================================
-- unzip
-- ============================================================================
func test_unzip_basic() -> Bool:
	pairs: List[(Int, String)] = [(1, "a"), (2, "b"), (3, "c")]
	result: (List[Int], List[String]) = unzip(pairs)
	result.0.length() == 3 and result.1.length() == 3


func make_unzipped_names() -> (List[Int], List[String]):
	pairs: List[(Int, String)] = [(1, "a"), (2, "b"), (3, "c")]
	unzip(pairs)


func test_unzip_string_values_survive_source_scope() -> Bool:
	result: (List[Int], List[String]) = make_unzipped_names()
	names: List[String] = result.1
	names.get_or(1, "missing") == "b"


func test_unzip_values() -> Bool:
	pairs: List[(Int, Int)] = [(10, 1), (20, 2)]
	result: (List[Int], List[Int]) = unzip(pairs)
	firsts: List[Int] = result.0
	match firsts.get(0):
		Some(v): v == 10
		None: False


func test_unzip_empty() -> Bool:
	empty: List[(Int, Int)] = []
	result: (List[Int], List[Int]) = unzip(empty)
	result.0.length() == 0 and result.1.length() == 0


-- ============================================================================
-- repeat
-- ============================================================================
func test_repeat_basic() -> Bool:
	result: List[Int] = 42.repeat(3)
	result.length() == 3


func test_repeat_values() -> Bool:
	result: List[Int] = 7.repeat(2)
	match result.get(1):
		Some(v): v == 7
		None: False


func test_repeat_zero() -> Bool:
	result: List[Int] = 1.repeat(0)
	result.length() == 0


-- ============================================================================
-- range
-- ============================================================================
func test_range_basic() -> Bool:
	result: List[Int] = range(1, 5)
	result.length() == 4


func test_range_first_element() -> Bool:
	result: List[Int] = range(3, 7)
	match result.get(0):
		Some(v): v == 3
		None: False


func test_range_last_element() -> Bool:
	result: List[Int] = range(0, 5)
	match result.get(4):
		Some(v): v == 4
		None: False


func test_range_empty() -> Bool:
	result: List[Int] = range(5, 3)
	result.length() == 0


func test_range_single() -> Bool:
	result: List[Int] = range(0, 1)
	result.length() == 1


-- ============================================================================
-- unique
-- ============================================================================
func test_unique_basic() -> Bool:
	nums: List[Int] = [1, 2, 3, 2, 1, 4]
	result: List[Int] = unique(nums)
	result.length() == 4


func test_unique_preserves_order() -> Bool:
	nums: List[Int] = [3, 1, 2, 1, 3]
	result: List[Int] = unique(nums)
	match result.get(0):
		Some(v): v == 3
		None: False


func test_unique_already_unique() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = unique(nums)
	result.length() == 3


func test_unique_all_same() -> Bool:
	nums: List[Int] = [5, 5, 5, 5]
	result: List[Int] = unique(nums)
	result.length() == 1


func test_unique_empty() -> Bool:
	empty: List[Int] = []
	result: List[Int] = unique(empty)
	result.length() == 0


-- ============================================================================
-- Test Suite
-- ============================================================================
tests: TestSuite = {
	description = "List Extended Functions",
	tests = [
		("last nonempty", test_last_nonempty),
		("last single", test_last_single),
		("last empty", test_last_empty),
		("drop_last basic", test_drop_last_basic),
		("drop_last preserves order", test_drop_last_preserves_order),
		("drop_last empty", test_drop_last_empty),
		("drop_last single", test_drop_last_single),
		("flat_map duplicate", test_flat_map_duplicate),
		("flat_map expand", test_flat_map_expand),
		("flat_map empty results", test_flat_map_empty_results),
		("map_indexed basic", test_map_indexed_basic),
		("map_indexed index only", test_map_indexed_index_only),
		("enumerate basic", test_enumerate_basic),
		(
			"enumerate string values survive source scope",
			test_enumerate_string_values_survive_source_scope,
		),
		("enumerate indices", test_enumerate_indices),
		("enumerate empty", test_enumerate_empty),
		("intersperse basic", test_intersperse_basic),
		("intersperse values", test_intersperse_values),
		("intersperse single", test_intersperse_single),
		("intersperse empty", test_intersperse_empty),
		("find_index found", test_find_index_found),
		("find_index not found", test_find_index_not_found),
		("find_index first match", test_find_index_first_match),
		("index_of found", test_index_of_found),
		("index_of not found", test_index_of_not_found),
		("index_of first occurrence", test_index_of_first_occurrence),
		("count basic", test_count_basic),
		("count none", test_count_none),
		("count all", test_count_all),
		("count empty", test_count_empty),
		("take_while basic", test_take_while_basic),
		("take_while all", test_take_while_all),
		("take_while none", test_take_while_none),
		("take_while preserves order", test_take_while_preserves_order),
		("drop_while basic", test_drop_while_basic),
		("drop_while none", test_drop_while_none),
		("drop_while all", test_drop_while_all),
		("drop_while first element", test_drop_while_first_element),
		("partition basic", test_partition_basic),
		("partition values", test_partition_values),
		("partition empty", test_partition_empty),
		("partition all match", test_partition_all_match),
		("split_at middle", test_split_at_middle),
		("split_at zero", test_split_at_zero),
		("split_at end", test_split_at_end),
		("zip_with add", test_zip_with_add),
		("zip_with shorter", test_zip_with_shorter),
		("zip_with empty", test_zip_with_empty),
		("unzip basic", test_unzip_basic),
		("unzip string values survive source scope", test_unzip_string_values_survive_source_scope),
		("unzip values", test_unzip_values),
		("unzip empty", test_unzip_empty),
		("repeat basic", test_repeat_basic),
		("repeat values", test_repeat_values),
		("repeat zero", test_repeat_zero),
		("range basic", test_range_basic),
		("range first element", test_range_first_element),
		("range last element", test_range_last_element),
		("range empty", test_range_empty),
		("range single", test_range_single),
		("unique basic", test_unique_basic),
		("unique preserves order", test_unique_preserves_order),
		("unique already unique", test_unique_already_unique),
		("unique all same", test_unique_all_same),
		("unique empty", test_unique_empty),
	],
}
