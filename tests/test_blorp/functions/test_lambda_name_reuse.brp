-- Test that sibling lambdas can reuse variable names
import:
	test: TestSuite


tests: TestSuite = {
	description = "Lambda name reuse",
	tests = [
		("float capture first", func():
			x: Float = 3.14
			f: (Int) -> Float = func(n: Int): x + to_float(n)
			f(0) == 3.14
		),
		("float capture second same name", func():
			x: Float = 2.5
			f: (Int) -> Float = func(n: Int): x + to_float(n)
			f(1) == 3.5
		),
		("float capture third same name", func():
			x: Float = 0.5
			f: (Int) -> Float = func(n: Int): x * to_float(n)
			f(6) == 3.0
		),
		("int capture reused name", func():
			n: Int = 10
			f: () -> Int = func(): n + 1
			f() == 11
		),
		("int capture same name again", func():
			n: Int = 20
			f: () -> Int = func(): n + 1
			f() == 21
		),
		("mixed captures same names", func():
			x: Float = 1.5
			n: Int = 3
			f: () -> Int = func(): n + 1
			x == 1.5 and f() == 4
		)
	]
}
