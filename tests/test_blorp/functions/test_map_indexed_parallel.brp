import:
	float: to_float32
	tensor: get
	test: TestSuite
	vector: ParallelVector, parallel


struct Pair {x: Int, y: Int}


pure func vget(v: Int[#10], i: Int) -> Int:
	match get(v, i):
		Some(val): val
		None: 0


func test_basic_indexed_map() -> Bool:
	v = vector(0, 10)
	result: Int[#10] = v.parallel(pure func(chunk: ParallelVector[Int, #10]):
		chunk.map_indexed(pure func(i: ..#10, val: Int): i * 2)
	)
	vget(result, 0) == 0 and vget(result, 3) == 6 and vget(result, 9) == 18


func test_indexed_map_with_element() -> Bool:
	v = vector(0, 5)
	result: Int[#5] = v.parallel(pure func(chunk: ParallelVector[Int, #5]):
		chunk.map_indexed(pure func(i: ..#5, val: Int): i + val + 1)
	)
	match get(result, 0):
		Some(r0):
			match get(result, 4):
				Some(r4): r0 == 1 and r4 == 5
				None: False
		None: False


func test_indexed_map_float() -> Bool:
	v = vector(0.0, 5)
	result: Float[#5] = v.parallel(pure func(chunk: ParallelVector[Float, #5]):
		chunk.map_indexed(pure func(i: ..#5, val: Float): to_float(i) + 0.5)
	)
	match get(result, 2):
		Some(val): val > 2.4 and val < 2.6
		None: False


func test_indexed_map_float32() -> Bool:
	v: Float32[#5] = vector(0.0, 5)
	result: Float32[#5] = v.parallel(pure func(chunk: ParallelVector[Float32, #5]):
		chunk.map_indexed(pure func(i: ..#5, val: Float32): val + to_float32(i) + to_float32(0.25))
	)
	match get(result, 2):
		Some(val): val > to_float32(2.2) and val < to_float32(2.3)
		None: False


func test_indexed_map_inline_struct_input() -> Bool:
	v: Pair[#3] = {{x = 1, y = 10}, {x = 2, y = 20}, {x = 3, y = 30}}
	result: Int[#3] = v.parallel(pure func(chunk: ParallelVector[Pair, #3]):
		chunk.map_indexed(pure func(i: ..#3, p: Pair): p.x + p.y + i)
	)
	match get(result, 1):
		Some(val): val == 23
		None: False


func test_indexed_map_tuple() -> Bool:
	v = vector(0.0, 5)
	result: (Float, Float)[#5] = v.parallel(pure func(chunk: ParallelVector[Float, #5]):
		chunk.map_indexed(pure func(i: ..#5, val: Float): (to_float(i), to_float(i) * 2.0))
	)
	match get(result, 3):
		Some(t):
			t.0 > 2.9 and t.0 < 3.1 and t.1 > 5.9 and t.1 < 6.1
		None: False


tests: TestSuite = {
	description = "Parallel vector indexed map",
	tests = [
		("basic indexed map", test_basic_indexed_map),
		("indexed map with element", test_indexed_map_with_element),
		("indexed map float", test_indexed_map_float),
		("indexed map float32", test_indexed_map_float32),
		("indexed map inline struct input", test_indexed_map_inline_struct_input),
		("indexed map tuple", test_indexed_map_tuple),
	],
}
