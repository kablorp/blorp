import:
	../../../benchmarks/blorp/support/benchmark:
		BenchmarkFloatResult,
		BenchmarkResult,
		bench_float,
		bench_int,
	test: TestSuite


func test_bench_int_checksum() -> Bool:
	result: BenchmarkResult = bench_int(5, func(i: Int) -> Int: i + 1)
	result.checksum == 15 and result.elapsed_us >= 0


func test_bench_float_checksum() -> Bool:
	result: BenchmarkFloatResult = bench_float(5, func(i: Int) -> Float: to_float(i) + 0.5)
	result.checksum == 12.5 and result.elapsed_us >= 0


tests: TestSuite = {
	description = "Benchmark Helpers",
	tests = [
		("bench_int consumes results", test_bench_int_checksum),
		("bench_float consumes results", test_bench_float_checksum),
	],
}
