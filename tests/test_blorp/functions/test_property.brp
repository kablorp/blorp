import:
	list: length
	property:
		Gen,
		check,
		check2,
		check_shrink,
		gen_bool,
		gen_const,
		gen_float,
		gen_int,
		gen_list,
		gen_map,
		gen_option,
		gen_string,
	random: rng_new
	test: TestSuite


-- ============================================================================
-- Generator Tests
-- ============================================================================
func test_gen_int_range() -> Bool:
	gen: Gen[Int] = gen_int(10, 20)
	r: (Int, Int) = gen(rng_new(42))
	r.0 >= 10 and r.0 < 20


func test_gen_float_range() -> Bool:
	gen: Gen[Float] = gen_float()
	r: (Float, Int) = gen(rng_new(42))
	r.0 >= 0.0 and r.0 < 1.0


func test_gen_bool() -> Bool:
	gen: Gen[Bool] = gen_bool()
	-- Same seed must produce same result (determinism)
	r1: (Bool, Int) = gen(rng_new(42))
	r2: (Bool, Int) = gen(rng_new(42))
	r1.0 == r2.0


func test_gen_const() -> Bool:
	gen: Gen[Int] = gen_const(42)
	r: (Int, Int) = gen(rng_new(99))
	r.0 == 42


func test_gen_map() -> Bool:
	gen: Gen[Int] = gen_map(gen_int(1, 10), pure func(x: Int): x * 2)
	r: (Int, Int) = gen(rng_new(42))
	r.0 >= 2 and r.0 < 20


func test_gen_string() -> Bool:
	gen: Gen[String] = gen_string(10)
	r: (String, Int) = gen(rng_new(42))
	r.0.length() >= 0 and r.0.length() < 10


func test_gen_list() -> Bool:
	gen: Gen[List[Int]] = gen_list(gen_int(0, 100), 5)
	r: (List[Int], Int) = gen(rng_new(42))
	r.0.length() >= 0 and r.0.length() < 5


func test_gen_option_some() -> Bool:
	-- Run enough times that at least one is Some
	gen: Gen[Option[Int]] = gen_option(gen_int(0, 100))
	var found_some: Bool = False
	var state: Int = rng_new(42)
	var i: Int = 0
	while i < 20:
		r: (Option[Int], Int) = gen(state)
		match r.0:
			Some(_): found_some = True
			None: void
		state = r.1
		i += 1
	found_some


-- ============================================================================
-- Property Checking Tests
-- ============================================================================
func test_check_passing() -> Bool:
	check("x + 0 == x", 100, gen_int(-1000, 1000), pure func(x: Int): x + 0 == x)


func test_check_identity() -> Bool:
	check("x * 1 == x", 100, gen_int(-1000, 1000), pure func(x: Int): x * 1 == x)


func test_check_commutative() -> Bool:
	check2(
		"a + b == b + a",
		100,
		gen_int(
			-1000,
			1000,
		),
		gen_int(
			-1000,
			1000,
		),
		pure func(a: Int, b: Int): a + b == b + a,
	)


func test_check_list_length() -> Bool:
	check(
		"list length >= 0",
		50,
		gen_list(
			gen_int(
				0,
				10,
			),
			10,
		),
		pure func(xs: List[Int]): xs.length() >= 0,
	)


func test_check_bool_double_neg() -> Bool:
	check("not not x == x", 100, gen_bool(), pure func(x: Bool): not not x == x)


-- ============================================================================
-- Shrinking Tests
-- ============================================================================
func test_shrink_finds_minimal() -> Bool:
	-- Property: x < 50 — will fail for x >= 50
	-- Shrinking should find 50 as the smallest counterexample
	-- (We just test that check_shrink correctly identifies failure)
	not check_shrink("x < 50", 200, gen_int(0, 100), pure func(x: Int): x < 50)


-- ============================================================================
-- Test Suite
-- ============================================================================
tests: TestSuite = {
	description = "Property-Based Testing",
	tests = [
		("gen_int range", test_gen_int_range),
		("gen_float range", test_gen_float_range),
		("gen_bool", test_gen_bool),
		("gen_const", test_gen_const),
		("gen_map", test_gen_map),
		("gen_string", test_gen_string),
		("gen_list", test_gen_list),
		("gen_option produces Some", test_gen_option_some),
		("check passing property", test_check_passing),
		("check identity", test_check_identity),
		("check commutative", test_check_commutative),
		("check list length", test_check_list_length),
		("check bool double negation", test_check_bool_double_neg),
		("shrink finds minimal", test_shrink_finds_minimal),
	],
}
