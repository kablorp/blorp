import:
	test: TestSuite
	vector: all, any, fold, map


func test_map_then_fold() -> Bool:
	v: Int[#3] = {1, 2, 3}
	result: Int = v
		.map(func(x: Int) -> Int: x * 2)
		.fold(0, func(a: Int, b: Int) -> Int: a + b)
	result == 12


func test_map_then_map() -> Bool:
	v: Int[#3] = {1, 2, 3}
	result: Int[#3] = v
		.map(func(x: Int) -> Int: x + 1)
		.map(func(x: Int) -> Int: x * 2)
	result[0] == 4 and result[1] == 6 and result[2] == 8


func test_map_then_all() -> Bool:
	v: Int[#3] = {1, 2, 3}
	v
		.map(func(x: Int) -> Int: x * 10)
		.all(func(x: Int) -> Bool: x >= 10)


func test_map_then_any() -> Bool:
	v: Int[#3] = {1, 2, 3}
	v
		.map(func(x: Int) -> Int: x - 2)
		.any(func(x: Int) -> Bool: x > 0)


tests: TestSuite = {
	description = "Method-chained HOFs",
	tests = [
		("map then fold", test_map_then_fold),
		("map then map", test_map_then_map),
		("map then all", test_map_then_all),
		("map then any", test_map_then_any),
	]
}
