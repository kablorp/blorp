-- Regression tests for UFCS module dispatch.
-- Dict/sorted_map modules define functions with the same names as list builtins.
-- Monomorphized module functions must dispatch to the correct version.
import:
	dict as D
	test: TestSuite


func test_dict_from_list() -> Bool:
	d: Dict[String, Int] = D.from_list([("a", 1), ("b", 2), ("c", 3)])
	d.length() == 3


func test_dict_merge() -> Bool:
	a: Dict[String, Int] = D.from_list([("x", 1)])
	b: Dict[String, Int] = D.from_list([("y", 2)])
	merged: Dict[String, Int] = D.merge(a, b)
	merged.length() == 2


func test_dict_fold() -> Bool:
	d: Dict[String, Int] = D.from_list([("a", 1), ("b", 2), ("c", 3)])
	total: Int = D.fold(d, 0, func(acc: Int, k: String, v: Int): acc + v)
	total == 6


func test_dict_reverse() -> Bool:
	d: Dict[String, Int] = D.from_list([("a", 1), ("b", 2), ("c", 3)])
	rd: Dict[String, Int] = D.reverse(d)
	rd.length() == 3


func test_dict_filter() -> Bool:
	d: Dict[String, Int] = D.from_list([("a", 1), ("b", 2), ("c", 3)])
	filtered: Dict[String, Int] = D.filter(d, func(k: String, v: Int): v > 1)
	filtered.length() == 2


tests: TestSuite = {
	description = "UFCS Module Dispatch",
	tests = [
		("dict from_list", test_dict_from_list),
		("dict merge", test_dict_merge),
		("dict fold", test_dict_fold),
		("dict reverse", test_dict_reverse),
		("dict filter", test_dict_filter),
	],
}
