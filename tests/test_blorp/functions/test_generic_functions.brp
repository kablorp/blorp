-- Test generic function type parameters (user-defined generics)
import:
	test: TestSuite


func identity[T](x: T) -> T:
	x


func first[A, B](a: A, b: B) -> A:
	a


func second[A, B](a: A, b: B) -> B:
	b


-- Generic function calls need named functions (monomorphization ordering)
func test_identity_int() -> Bool:
	identity(42) == 42


func test_identity_bool() -> Bool:
	identity(True) == True


func test_pair_first() -> Bool:
	first(10, True) == 10


func test_pair_second() -> Bool:
	second(10, True) == True


tests: TestSuite = {
	description = "Generic Type Parameters",
	tests = [
		("identity Int", test_identity_int),
		("identity Bool", test_identity_bool),
		("pair first[Int,Bool]", test_pair_first),
		("pair second[Int,Bool]", test_pair_second),
	]
}
