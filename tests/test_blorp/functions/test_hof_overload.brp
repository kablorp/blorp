-- Regression tests for Phase 2.7: pure/impure HOF overload resolution
-- AND named-function closure wrapping (Part B).
--
-- Before the fix:
-- (a) Passing a top-level named function as a callback arg crashed
-- at runtime (exit 106/118) because the raw C function pointer
-- wasn't wrapped in a closure. [Part B]
-- (b) Pure/impure overload pairs of stdlib HOFs had a reactive dedup
-- hack renaming one variant with a `__pure` suffix that no call
-- site ever referenced. [Part A]
--
-- After: named-function callbacks run correctly AND the overload
-- resolution picks the right variant based on callback purity.
import:
	test: TestSuite


-- ============================================================================
-- Part B: Named functions as callback arguments
-- ============================================================================
func add_one_impure(x: Int) -> Int:
	print("")
	x + 1


pure func add_one_pure(x: Int) -> Int:
	x + 1


func is_positive(x: Int) -> Bool:
	x > 0


-- Impure context, impure callback by name.
func test_impure_map_by_name() -> Bool:
	xs: List[Int] = [1, 2, 3]
	ys: List[Int] = xs.map(add_one_impure)
	ys.get_or(0, 0) == 2 and ys.get_or(1, 0) == 3 and ys.get_or(2, 0) == 4


-- Impure context, pure callback by name.
func test_impure_ctx_pure_callback_by_name() -> Bool:
	xs: List[Int] = [10, 20, 30]
	ys: List[Int] = xs.map(add_one_pure)
	ys.get_or(0, 0) == 11 and ys.get_or(2, 0) == 31


-- filter with named predicate.
func test_impure_filter_by_name() -> Bool:
	xs: List[Int] = [-1, 2, -3, 4]
	ys: List[Int] = xs.filter(is_positive)
	length(ys) == 2


-- Assigning a named function to a local binding, then passing the
-- binding to a HOF. Before the fix, the CLet RHS wasn't wrapped, so
-- `f` was a raw function pointer at the HOF call site.
func test_fn_via_local_binding() -> Bool:
	f: (Int) -> Int = add_one_impure
	xs: List[Int] = [1, 2, 3]
	ys: List[Int] = xs.map(f)
	ys.get_or(0, 0) == 2 and ys.get_or(2, 0) == 4


-- ============================================================================
-- Part A: Pure/impure overload resolution with lambdas
-- ============================================================================
func noisy_inc(x: Int) -> Int:
	print("")
	x + 1


func test_impure_ctx_impure_lambda() -> Bool:
	xs: List[Int] = [1, 2, 3]
	ys: List[Int] = xs.map(func(x: Int): noisy_inc(x))
	ys.get_or(0, 0) == 2 and ys.get_or(1, 0) == 3


pure func test_pure_ctx_pure_lambda() -> Bool:
	xs: List[Int] = [10, 20, 30]
	ys: List[Int] = xs.map(func(x: Int): x + 1)
	ys.get_or(0, 0) == 11 and ys.get_or(2, 0) == 31


func test_impure_ctx_pure_lambda() -> Bool:
	xs: List[Int] = [1, 2, 3]
	ys: List[Int] = xs.map(func(x: Int): x * 2)
	ys.get_or(0, 0) == 2 and ys.get_or(1, 0) == 4


tests: TestSuite = {
	description = "HOF overload + named-function closure wrap",
	tests = [
		("impure map by name", test_impure_map_by_name),
		("impure ctx / pure callback", test_impure_ctx_pure_callback_by_name),
		("impure filter by name", test_impure_filter_by_name),
		("fn via local binding", test_fn_via_local_binding),
		("impure ctx / impure lambda", test_impure_ctx_impure_lambda),
		("pure ctx / pure lambda", test_pure_ctx_pure_lambda),
		("impure ctx / pure lambda", test_impure_ctx_pure_lambda),
	],
}
-- Part B: named-function callbacks
-- Part A: overload tie-break on callback purity (lambdas)
