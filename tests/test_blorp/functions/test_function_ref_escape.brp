import:
	list: map
	test: TestSuite


-- Tests for function references that escape their scope
-- These exercise the compound literal closure lifetime issue:
-- when a zero-capture closure is returned, stored in a container,
-- or passed across thread boundaries, the stack-allocated compound
-- literal may be freed before it's used.
-- A simple pure function with no captures
pure func double(x: Int) -> Int:
	x * 2


pure func triple(x: Int) -> Int:
	x * 3


pure func add_one(x: Int) -> Int:
	x + 1


-- Test 1: Return a bare function reference from a function
func get_doubler() -> (Int) -> Int:
	double


func test_return_function_ref() -> Bool:
	f: (Int) -> Int = get_doubler()
	f(5) == 10


-- Test 2: Return a zero-capture lambda from a function
func get_incrementer() -> (Int) -> Int:
	func(x: Int): x + 1


func test_return_zero_capture_lambda() -> Bool:
	f: (Int) -> Int = get_incrementer()
	f(42) == 43


-- Test 3: Store function references in a list, use later
func test_function_refs_in_list() -> Bool:
	fns: List[(Int) -> Int] = [double, triple, add_one]
	results: List[Int] = fns.map(func(f: (Int) -> Int): f(10))
	results.length() == 3


-- Test 4: Return function ref, store in list, then use
func test_returned_ref_in_list() -> Bool:
	f: (Int) -> Int = get_doubler()
	g: (Int) -> Int = get_incrementer()
	fns: List[(Int) -> Int] = [f, g]
	results: List[Int] = fns.map(func(fn: (Int) -> Int): fn(5))
	results.length() == 2


-- Test 5: Chain of returns - function returns function ref,
-- caller returns it again
func get_math_fn(name: String) -> (Int) -> Int:
	match name:
		"double": double
		"triple": triple
		_: add_one


func test_chain_return() -> Bool:
	f: (Int) -> Int = get_math_fn("triple")
	f(4) == 12


-- Test 6: Zero-capture lambda stored in a record
func test_zero_capture_in_tuple() -> Bool:
	pair: ((Int) -> Int, (Int) -> Int) = (double, triple)
	pair[0](3) == 6 and pair[1](3) == 9


tests: TestSuite = {
	description = "Function Reference Escape",
	tests = [
		("return function ref", test_return_function_ref),
		("return zero-capture lambda", test_return_zero_capture_lambda),
		("function refs in list", test_function_refs_in_list),
		("returned ref in list", test_returned_ref_in_list),
		("chain return", test_chain_return),
		("zero capture in tuple", test_zero_capture_in_tuple),
	],
}
