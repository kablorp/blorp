-- Test generic module functions called with primitive type arguments.
-- This tests:
-- 1. Codegen param_needs_boxing in selective import fallback path
-- 2. Type checker module-qualified generic function type param freshening
-- 3. Cache module with explicit [K, V] type params
import:
	cache as C
	dict as D
	list as L
	option: Option(Some, None), get_or, map
	test: TestSuite


-- ===== Option module with primitives =====
func test_option_map_int() -> Bool:
	get_or(map(Some(42), func(x: Int): x * 2), 0) == 84


func test_option_get_or_int() -> Bool:
	get_or(Some(10), 0) == 10 and None.get_or(99) == 99


func test_option_map_float() -> Bool:
	get_or(map(Some(3.14), func(x: Float): x * 2.0), 0.0) > 6.27


func test_option_get_or_float() -> Bool:
	get_or(Some(2.5), 0.0) == 2.5


func test_option_map_bool() -> Bool:
	get_or(map(Some(True), func(x: Bool): not x), True) == False


func test_option_get_or_bool() -> Bool:
	get_or(Some(False), True) == False and None.get_or(True) == True


func test_option_map_char() -> Bool:
	get_or(map(Some('a'), func(c: Char): c), 'z') == 'a'


func test_option_get_or_char() -> Bool:
	get_or(Some('x'), '?') == 'x' and None.get_or('!') == '!'


-- ===== List module with primitives =====
func test_list_fold_int() -> Bool:
	L.fold_left([1, 2, 3, 4, 5], 0, func(acc: Int, x: Int): acc + x) == 15


func test_list_contains_int() -> Bool:
	L.contains([10, 20, 30], 20) and not L.contains([10, 20, 30], 25)


func test_list_fold_float() -> Bool:
	L.fold_left([1.5, 2.5, 3.0], 0.0, func(acc: Float, x: Float): acc + x) == 7.0


func test_list_contains_bool() -> Bool:
	L.contains([True, False, True], False) and L.length([True, False]) == 2


-- ===== Dict module with primitives =====
func test_dict_int_values() -> Bool:
	var d: Dict[String, Int] = D.dict()
	d = D.set(d, "one", 1)
	d = D.set(d, "two", 2)
	d = D.set(d, "three", 3)
	match D.get(d, "two"):
		Some(v): v == 2
		None: False


func test_dict_int_keys() -> Bool:
	var d: Dict[Int, String] = D.dict()
	d = D.set(d, 1, "one")
	d = D.set(d, 2, "two")
	match D.get(d, 1):
		Some(v): v == "one"
		None: False


-- ===== Cache with primitives =====
func test_cache_string_int() -> Bool:
	var c = C.cache(10)
	c = C.put(c, "answer", 42)
	c = C.put(c, "zero", 0)
	match C.get(c, "answer"):
		Some(v): v == 42
		None: False


func test_cache_int_int() -> Bool:
	var c = C.cache(5)
	c = C.put(c, 1, 100)
	c = C.put(c, 2, 200)
	match C.get(c, 1):
		Some(v): v == 100
		None: False


func test_cache_string_float() -> Bool:
	var c = C.cache(5)
	c = C.put(c, "pi", 3.14)
	match C.get(c, "pi"):
		Some(v): v == 3.14
		None: False


func test_cache_string_bool() -> Bool:
	var c = C.cache(5)
	c = C.put(c, "flag", True)
	match C.get(c, "flag"):
		Some(v): v == True
		None: False


func test_cache_eviction_int() -> Bool:
	var c = C.cache(2)
	c = C.put(c, "a", 1)
	c = C.put(c, "b", 2)
	c = C.put(c, "c", 3)
	not C.contains(c, "a") and C.contains(c, "b") and C.contains(c, "c")


func test_cache_touch_int() -> Bool:
	var c = C.cache(2)
	c = C.put(c, "a", 1)
	c = C.put(c, "b", 2)
	c = C.touch(c, "a")
	c = C.put(c, "c", 3)
	C.contains(c, "a") and not C.contains(c, "b") and C.contains(c, "c")


-- ===== Nested generics with primitives =====
func test_list_of_option_int() -> Bool:
	xs: List[Option[Int]] = [Some(1), None, Some(3)]
	L.length(xs) == 3


func test_option_of_list_int() -> Bool:
	match Some([1, 2, 3]):
		Some(xs): L.length(xs) == 3
		None: False


tests: TestSuite = {
	description = "Generic Module Functions with Primitives",
	tests = [
		("option map Int", test_option_map_int),
		("option get_or Int", test_option_get_or_int),
		("option map Float", test_option_map_float),
		("option get_or Float", test_option_get_or_float),
		("option map Bool", test_option_map_bool),
		("option get_or Bool", test_option_get_or_bool),
		("option map Char", test_option_map_char),
		("option get_or Char", test_option_get_or_char),
		("list fold Int", test_list_fold_int),
		("list contains Int", test_list_contains_int),
		("list fold Float", test_list_fold_float),
		("list contains Bool", test_list_contains_bool),
		("dict Int values", test_dict_int_values),
		("dict Int keys", test_dict_int_keys),
		("cache String->Int", test_cache_string_int),
		("cache Int->Int", test_cache_int_int),
		("cache String->Float", test_cache_string_float),
		("cache String->Bool", test_cache_string_bool),
		("cache eviction Int", test_cache_eviction_int),
		("cache touch Int", test_cache_touch_int),
		("List[Option[Int]]", test_list_of_option_int),
		("Option[List[Int]]", test_option_of_list_int),
	]
}
