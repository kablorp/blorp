import:
	test: TestSuite
	vector: all, any, fold, map


-- Test vector higher-order functions (map, fold, all, any)
func test_map_double() -> Bool:
	v: Int[#3] = {1, 2, 3}
	result: Int[#3] = v.map(pure func(x: Int) -> Int: x * 2)
	result[0] == 2 and result[1] == 4 and result[2] == 6


func test_fold_sum() -> Bool:
	v: Int[#4] = {1, 2, 3, 4}
	total: Int = v.fold(0, pure func(acc: Int, x: Int) -> Int: acc + x)
	total == 10


func test_all_positive() -> Bool:
	v: Int[#3] = {1, 2, 3}
	v.all(pure func(x: Int) -> Bool: x > 0)


func test_all_negative() -> Bool:
	v: Int[#3] = {1, -1, 3}
	not v.all(pure func(x: Int) -> Bool: x > 0)


func test_any_positive() -> Bool:
	v: Int[#3] = {-1, 2, -3}
	v.any(pure func(x: Int) -> Bool: x > 0)


func test_any_none() -> Bool:
	v: Int[#3] = {-1, -2, -3}
	not v.any(pure func(x: Int) -> Bool: x > 0)


tests: TestSuite = {
	description = "Vector HOF tests",
	tests = [
		("map double", test_map_double),
		("fold sum", test_fold_sum),
		("all positive", test_all_positive),
		("all not all positive", test_all_negative),
		("any positive", test_any_positive),
		("any none positive", test_any_none),
	],
}
