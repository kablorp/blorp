-- Regression: parameters may shadow prelude function names. The backend must
-- emit the local parameter, not the prelude function's generated C symbol.
import:
	test: TestSuite


pure func echo_input(input: String) -> String:
	input


pure func call_input(input: pure (String) -> String) -> String:
	input("ok")


func test_parameter_named_input() -> Bool:
	echo_input("local") == "local"


func test_function_parameter_named_input() -> Bool:
	call_input(func(value: String): value + "!") == "ok!"


tests: TestSuite = {
	description = "Prelude Parameter Shadow Codegen",
	tests = [
		("parameter named input", test_parameter_named_input),
		("function parameter named input", test_function_parameter_named_input),
	],
}
