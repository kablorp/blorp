import:
	test: TestSuite


func __nested_test_nested_basic_greet_0(name: String) -> String:
	"hello, " + name


func test_nested_basic() -> Bool:
	void
	__nested_test_nested_basic_greet_0("world") == "hello, world"


pure func __nested_test_nested_generic_identity_1[T](x: T) -> T:
	x


func test_nested_generic() -> Bool:
	void
	__nested_test_nested_generic_identity_1(
		42,
	) == 42 and __nested_test_nested_generic_identity_1("s") == "s"


pure func __nested_test_nested_recursion_sum_to_2(n: Int, acc: Int) -> Int:
	if n <= 0:
		acc
	else:
		__nested_test_nested_recursion_sum_to_2(n - 1, acc + n)


func test_nested_recursion() -> Bool:
	void
	__nested_test_nested_recursion_sum_to_2(10, 0) == 55


-- Two nested funcs can call each other if declared in order.
pure func __nested_test_two_nested_double_3(n: Int) -> Int:
	n * 2


pure func __nested_test_two_nested_quadruple_4(n: Int) -> Int:
	__nested_test_two_nested_double_3(__nested_test_two_nested_double_3(n))


func test_two_nested() -> Bool:
	void
	void
	__nested_test_two_nested_quadruple_4(3) == 12


tests: TestSuite = {
	description = "Nested function declarations",
	tests = [
		("basic", test_nested_basic),
		("generic", test_nested_generic),
		("recursion", test_nested_recursion),
		("two nested", test_two_nested),
	],
}
