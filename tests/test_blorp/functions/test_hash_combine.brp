-- Runtime: [hash_combine] is a global builtin that users lean on
-- when writing multi-field [Hashable] impls. The contract:
-- * deterministic within a run (same inputs → same output);
-- * different inputs produce different outputs with high
-- probability (no trivial collisions like swapping operands);
-- * chainable, associative in the "fold this sequence of hashes"
-- sense (the caller decides order).
-- Absolute values aren't asserted — the runtime seed shifts between
-- runs, same as Hashable primitives.
import:
	test: TestSuite


pure func test_deterministic() -> Bool:
	hash_combine(1, 2) == hash_combine(1, 2)


pure func test_sensitive_to_seed() -> Bool:
	hash_combine(1, 42) != hash_combine(2, 42)


pure func test_sensitive_to_value() -> Bool:
	hash_combine(7, 1) != hash_combine(7, 2)


pure func test_order_matters() -> Bool:
	-- Swapping seed and value must change the result: combine
	-- isn't commutative, so chains preserve field-order information.
	hash_combine(3, 5) != hash_combine(5, 3)


-- End-to-end: a user record uses hash_combine to mix multi-field
-- hashes. Two distinct records must produce distinct hashes with
-- overwhelming probability, and equal records must agree.
record Point {x: Int, y: Int, z: Int}


implements Equatable for Point:
	pure func equals(a: Point, b: Point) -> Bool:
		a.x == b.x and a.y == b.y and a.z == b.z


implements Hashable for Point:
	pure func hash(self: Point) -> Int:
		var h: Int = self.x.hash()
		h = hash_combine(h, self.y.hash())
		h = hash_combine(h, self.z.hash())
		h


pure func test_record_equal_hashes() -> Bool:
	a: Point = {x = 1, y = 2, z = 3}
	b: Point = {x = 1, y = 2, z = 3}
	a.hash() == b.hash()


pure func test_record_distinct_hashes() -> Bool:
	a: Point = {x = 1, y = 2, z = 3}
	b: Point = {x = 3, y = 2, z = 1}
	-- Different field order encodes different records. hash_combine
	-- must preserve that, else every permutation collides.
	a.hash() != b.hash()


tests: TestSuite = {
	description = "hash_combine builtin",
	tests = [
		("deterministic", test_deterministic),
		("sensitive to seed", test_sensitive_to_seed),
		("sensitive to value", test_sensitive_to_value),
		("order matters", test_order_matters),
		("record equal hashes", test_record_equal_hashes),
		("record distinct hashes", test_record_distinct_hashes),
	],
}
