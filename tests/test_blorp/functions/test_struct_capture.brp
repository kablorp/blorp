-- Test capturing struct values in closures
import:
	geometry: Vec2, vec2, vec2_add, vec2_scale
	test: TestSuite


func test_capture_struct() -> Bool:
	v: Vec2 = vec2(3.0, 4.0)
	f: () -> Float = func(): v.x + v.y
	f() == 7.0


func test_capture_struct_in_operation() -> Bool:
	a: Vec2 = vec2(1.0, 2.0)
	b: Vec2 = vec2(3.0, 4.0)
	f: () -> Vec2 = func(): vec2_add(a, b)
	result: Vec2 = f()
	result.x == 4.0 and result.y == 6.0


func test_capture_struct_with_other_values() -> Bool:
	v: Vec2 = vec2(5.0, 0.0)
	scale: Float = 2.0
	f: () -> Vec2 = func(): vec2_scale(v, scale)
	result: Vec2 = f()
	result.x == 10.0


tests: TestSuite = {
	description = "Struct Capture in Closures",
	tests = [
		("capture struct field access", test_capture_struct),
		("capture struct in operation", test_capture_struct_in_operation),
		("capture struct with other values", test_capture_struct_with_other_values),
	],
}
