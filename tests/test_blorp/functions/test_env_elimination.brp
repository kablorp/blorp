-- Test that __env elimination doesn't break any calling patterns
-- This covers: direct calls, closures, HOF, module calls, recursion
import:
	list: List, filter, fold_left, length, map
	test: TestSuite


-- Pure function with no captures (should not need __env)
pure func add(a: Int, b: Int) -> Int:
	a + b


-- Impure function (should not need __env)
func greet(name: String) -> String:
	"Hello, ${name}!"


-- Recursive function (should not need __env)
pure func fib(n: Int) -> Int:
	if n <= 1:
		n
	else:
		fib(n - 1) + fib(n - 2)


-- Function that takes a closure parameter
pure func apply_twice(
	f: pure (Int) -> Int,
	x: Int,
) -> Int:
	f(f(x))


-- Function that returns a closure (closure captures variable)
func make_adder(n: Int) -> (Int) -> Int:
	func(x: Int): x + n


-- Test direct function calls
func test_direct_call() -> Bool:
	add(3, 4) == 7


-- Test recursion
func test_recursion() -> Bool:
	fib(10) == 55


-- Test closures with captures
func test_closure_captures() -> Bool:
	add5: (Int) -> Int = make_adder(5)
	add5(10) == 15


-- Test HOF with lambda (no captures)
func test_hof_lambda() -> Bool:
	result: Int = apply_twice(func(x: Int): x * 2, 3)
	result == 12


-- Test HOF with module functions (map, filter, fold)
func test_hof_module() -> Bool:
	lst: List[Int] = [1, 2, 3, 4, 5]
	doubled: List[Int] = lst.map(func(x: Int): x * 2)
	evens: List[Int] = lst.filter(func(x: Int): x % 2 == 0)
	total: Int = lst.fold_left(0, func(acc: Int, x: Int): acc + x)
	doubled.length() == 5 and evens.length() == 2 and total == 15


-- Test passing a named function as a closure
pure func double_it(x: Int) -> Int:
	x * 2


func test_named_as_closure() -> Bool:
	result: Int = apply_twice(double_it, 3)
	result == 12


-- Test nested closures
func test_nested_closures() -> Bool:
	a: Int = 10
	f: (Int) -> Int = func(x: Int): x + a
	g: (Int) -> Int = func(x: Int): f(x) + a
	g(5) == 25


-- Test string operations across function calls
func test_string_calls() -> Bool:
	result: String = greet("World")
	result == "Hello, World!"


tests: TestSuite = {
	description = "Env Elimination Correctness",
	tests = [
		("direct call", test_direct_call),
		("recursion", test_recursion),
		("closure captures", test_closure_captures),
		("HOF lambda", test_hof_lambda),
		("HOF module functions", test_hof_module),
		("named function as closure", test_named_as_closure),
		("nested closures", test_nested_closures),
		("string calls", test_string_calls),
	]
}
