-- Phase 2.7 tasks 48/49: pure/impure overload tiebreak by callback purity.
--
-- When a function name like `flat_map` has both a pure and an impure
-- overload, the call site's callback purity must select the right one:
-- - impure callback can only satisfy the impure overload's signature
-- - pure callback can satisfy either; prefer the pure overload (more
-- specific) so pure callers still benefit from purity-aware passes
--
-- Without the tiebreak, `nums.flat_map(impure_helper)` resolves to the
-- pure overload's signature and rejects the impure callback at typecheck.
import:
	list: flat_map, map
	test: TestSuite


func impure_helper(x: Int) -> List[Int]:
	if x > 10:
		[x]
	else:
		[]


pure func pure_helper(x: Int) -> List[Int]:
	[x, x + 1]


-- Impure callback must select the impure flat_map overload.
func test_flat_map_impure_callback() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.flat_map(impure_helper)
	result.length() == 0


-- Pure callback should still resolve (prefers pure overload).
func test_flat_map_pure_callback() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.flat_map(pure_helper)
	result.length() == 6


-- Same shape for `map`, which also has the paired overload.
func impure_double(x: Int) -> Int:
	x * 2


func test_map_impure_callback() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.map(impure_double)
	match result.get(2):
		Some(v): v == 6
		None: False


pure func pure_double(x: Int) -> Int:
	x * 2


func test_map_pure_callback() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.map(pure_double)
	match result.get(0):
		Some(v): v == 2
		None: False


tests: TestSuite = {
	description = "Pure/impure overload tiebreak (Phase 2.7 tasks 48/49)",
	tests = [
		("flat_map with impure callback", test_flat_map_impure_callback),
		("flat_map with pure callback", test_flat_map_pure_callback),
		("map with impure callback", test_map_impure_callback),
		("map with pure callback", test_map_pure_callback),
	],
}
