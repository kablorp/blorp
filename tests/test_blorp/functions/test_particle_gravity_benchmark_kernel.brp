import:
	../../../benchmarks/blorp/support/particle_gravity_kernel:
		build_particle_tree,
		particle_gravity_callback,
		run_particle_gravity_kernel,
	test: TestSuite


func test_dead_particle_has_zero_accel() -> Bool:
	tree_result = build_particle_tree(7)
	tree = tree_result.0
	acc = particle_gravity_callback(tree, 3, 0.0)
	acc.x == 0.0 and acc.y == 0.0 and acc.z == 0.0


func test_kernel_checksum_is_deterministic() -> Bool:
	tree_result = build_particle_tree(11)
	tree = tree_result.0
	alive: Float[#64] = vector(1.0, 64)
	a: Float = run_particle_gravity_kernel(4, 64, tree, alive)
	b: Float = run_particle_gravity_kernel(4, 64, tree, alive)
	a == b and a > 0.0


tests: TestSuite = {
	description = "particle gravity benchmark kernel",
	tests = [
		("dead particle has zero acceleration", test_dead_particle_has_zero_accel),
		("kernel checksum is deterministic", test_kernel_checksum_is_deterministic),
	],
}
