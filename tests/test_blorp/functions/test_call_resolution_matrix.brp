import:
	dict as D
	heap as H: Heap
	list: reverse
	test: TestSuite


record Runner {
	run: (Int) -> Int
}


func run(box: Runner, x: Int) -> Int:
	0


func test_field_call_wins() -> Bool:
	box: Runner = {run = func(x: Int): x * 2}
	box.run(5) == 10


pure func add_to(self: Int, amount: Int) -> Int:
	self + amount


func test_local_method_call() -> Bool:
	3.add_to(4) == 7


func apply(
	f: (Int) -> Int,
	x: Int,
) -> Int:
	f(x)
pure func apply(
	f: pure (Int) -> Int,
	x: Int,
) -> Int:
	f(x)


func noisy_add_one(x: Int) -> Int:
	print("")
	x + 1


pure func quiet_add_one(x: Int) -> Int:
	x + 1


pure func test_bare_overload_pure() -> Bool:
	apply(quiet_add_one, 2) == 3


func test_selective_import_bare_call() -> Bool:
	reverse([1, 2, 3]) == [3, 2, 1]


func test_qualified_module_call() -> Bool:
	d: Dict[String, Int] = D.from_list([("a", 1), ("b", 2)])
	D.length(d) == 2


func test_prelude_method_only_call() -> Bool:
	[1, 2, 3].map(func(x: Int): x + 1) == [2, 3, 4]


func test_imported_type_method_only_call() -> Bool:
	var h: Heap[Int] = H.heap()
	h = h.push(2)
	h = h.push(1)
	h.size() == 2


func test_first_class_call() -> Bool:
	f: (Int) -> Int = noisy_add_one
	f(5) == 6


func test_constructor_call() -> Bool:
	match Some(4):
		Some(x): x == 4
		None: False


trait Weighted:
	pure func weight(self: Self) -> Int


record WeightBox {
	value: Int
}


implements Weighted for WeightBox:
	pure func weight(self: WeightBox) -> Int:
		self.value


pure func generic_trait_method_call[T:Weighted](x: T) -> Int:
	weight(x)


func test_generic_trait_method_call() -> Bool:
	box: WeightBox = {value = 8}
	generic_trait_method_call(box) == 8


tests: TestSuite = {
	description = "Call resolution matrix",
	tests = [
		("field call wins", test_field_call_wins),
		("local method call", test_local_method_call),
		("bare overload pure", test_bare_overload_pure),
		("selective import bare call", test_selective_import_bare_call),
		("qualified module call", test_qualified_module_call),
		("prelude method-only call", test_prelude_method_only_call),
		("imported type method-only call", test_imported_type_method_only_call),
		("first-class call", test_first_class_call),
		("constructor call", test_constructor_call),
		("generic trait method call", test_generic_trait_method_call),
	]
}
