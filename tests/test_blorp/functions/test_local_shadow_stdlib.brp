-- Regression: local functions with names matching stdlib builtins
-- must resolve to the local definition, not the stdlib version.
-- (resolve_c_name_with_module must prefer local (None-module) definitions)
import:
	list: get
	test: TestSuite


-- Local 'count' that counts list length (1 arg, not stdlib's 2-arg count)
func count(items: List[Int]) -> Int:
	var n: Int = 0
	for _ in items:
		n += 1
	n


-- Local function that uses a common name
func format(val: Int) -> String:
	"value=" + val.to_string()


func test_local_count_basic() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	count(nums) == 5


func test_local_count_empty() -> Bool:
	nums: List[Int] = []
	count(nums) == 0


func test_local_format() -> Bool:
	format(42) == "value=42"


func test_local_with_stdlib_get() -> Bool:
	-- Both local functions and stdlib imports work together
	nums: List[Int] = [10, 20, 30]
	n: Int = count(nums)
	match get(nums, 1):
		Some(v): n == 3 and v == 20
		None: False


tests: TestSuite = {
	description = "Local Function Shadowing Stdlib",
	tests = [
		("local count basic", test_local_count_basic),
		("local count empty", test_local_count_empty),
		("local format function", test_local_format),
		("local with stdlib get", test_local_with_stdlib_get),
	]
}
