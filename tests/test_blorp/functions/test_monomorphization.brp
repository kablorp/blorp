-- Test monomorphization: specialized function generation for generic functions
import:
	test: TestSuite
	vector: fold, map


func identity[T](x: T) -> T:
	x


func first_of[A, B](a: A, b: B) -> A:
	a


func second_of[A, B](a: A, b: B) -> B:
	b


func apply_identity[T](x: T) -> T:
	identity(x)


func value_or_default[T](opt: Option[T], default: T) -> T:
	match opt:
		Some(v): v
		None: default


func apply_fn[T](x: T, f: (T) -> T) -> T:
	f(x)


-- All mono tests use named functions (monomorphization ordering requires it)
func test_mono_identity_int() -> Bool:
	identity(42) == 42


func test_mono_identity_float() -> Bool:
	identity(3.14) == 3.14


func test_mono_identity_string() -> Bool:
	identity("hello") == "hello"


func test_mono_identity_bool() -> Bool:
	identity(True) == True


func test_mono_pair() -> Bool:
	first_of(42, True) == 42 and second_of(42, True) == True


func test_mono_transitive() -> Bool:
	apply_identity(99) == 99


func test_mono_option_int() -> Bool:
	value_or_default(Some(10), 0) == 10 and value_or_default(None, 42) == 42


func test_mono_option_string() -> Bool:
	value_or_default(Some("yes"), "no") == "yes"


func test_mono_apply_fn() -> Bool:
	apply_fn(5, func(x: Int) -> Int: x * 2) == 10


func test_mono_vector_fold_int() -> Bool:
	v: Int[#3] = {1, 2, 3}
	total: Int = v.fold(0, func(acc: Int, x: Int) -> Int: acc + x)
	total == 6


func test_mono_vector_fold_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	total: Float = v.fold(0.0, func(acc: Float, x: Float) -> Float: acc + x)
	total == 6.0


func test_mono_vector_map() -> Bool:
	v: Int[#3] = {10, 20, 30}
	doubled: Int[#3] = v.map(func(x: Int) -> Int: x * 2)
	doubled[0] == 20 and doubled[1] == 40 and doubled[2] == 60


tests: TestSuite = {
	description = "Monomorphization",
	tests = [
		("identity Int", test_mono_identity_int),
		("identity Float", test_mono_identity_float),
		("identity String", test_mono_identity_string),
		("identity Bool", test_mono_identity_bool),
		("two-param pair", test_mono_pair),
		("transitive identity", test_mono_transitive),
		("Option[Int] match", test_mono_option_int),
		("Option[String] match", test_mono_option_string),
		("closure parameter", test_mono_apply_fn),
		("vector fold Int", test_mono_vector_fold_int),
		("vector fold Float", test_mono_vector_fold_float),
		("vector map Int", test_mono_vector_map),
	],
}
