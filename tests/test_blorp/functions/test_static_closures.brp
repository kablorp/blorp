import:
	list: all, any, filter, find, map
	test: TestSuite


-- Named functions passed as HOF args (no captures — should be static closures)
pure func double(x: Int) -> Int:
	x * 2


pure func is_even(x: Int) -> Bool:
	x % 2 == 0


func sum(nums: List[Int]) -> Int:
	var total: Int = 0
	for n in nums:
		total += n
	total


func test_named_func_map() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	result: List[Int] = nums.map(double)
	result.length() == 5 and sum(result) == 30


func test_named_func_filter() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5, 6]
	evens: List[Int] = nums.filter(is_even)
	evens.length() == 3


func test_named_func_any_all() -> Bool:
	nums: List[Int] = [2, 4, 6, 8]
	nums.any(is_even) and nums.all(is_even)


func test_named_func_find() -> Bool:
	nums: List[Int] = [1, 3, 5, 4, 7]
	match nums.find(is_even):
		Some(v): v == 4
		None: False


-- Non-capturing lambdas (should also be static closures)
func test_noncapturing_lambda_map() -> Bool:
	nums: List[Int] = [1, 2, 3]
	result: List[Int] = nums.map(func(x: Int): x * 3)
	sum(result) == 18


func test_noncapturing_lambda_filter() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5, 6]
	odds: List[Int] = nums.filter(func(x: Int): x % 2 != 0)
	odds.length() == 3


-- Multiple HOF calls in sequence (each should reuse its static singleton)
func test_multiple_hof_calls() -> Bool:
	a: List[Int] = [1, 2, 3]
	b: List[Int] = [4, 5, 6]
	ra: List[Int] = a.map(double)
	rb: List[Int] = b.map(double)
	sum(ra) == 12 and sum(rb) == 30


-- HOF in a loop (same static closure reused each iteration)
func test_hof_in_loop() -> Bool:
	var total: Int = 0
	var i: Int = 0
	while i < 5:
		nums: List[Int] = [1, 2, 3]
		doubled: List[Int] = nums.map(double)
		total += sum(doubled)
		i += 1
	total == 60


tests: TestSuite = {
	description = "Static Closures",
	tests = [
		("named func map", test_named_func_map),
		("named func filter", test_named_func_filter),
		("named func any/all", test_named_func_any_all),
		("named func find", test_named_func_find),
		("noncapturing lambda map", test_noncapturing_lambda_map),
		("noncapturing lambda filter", test_noncapturing_lambda_filter),
		("multiple hof calls", test_multiple_hof_calls),
		("hof in loop", test_hof_in_loop),
	],
}
