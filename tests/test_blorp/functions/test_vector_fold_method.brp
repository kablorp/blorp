import:
	test: TestSuite
	vector: fold


func test_fold_method_int() -> Bool:
	v: Int[#3] = {1, 2, 3}
	total: Int = v.fold(0, func(acc: Int, x: Int) -> Int: acc + x)
	total == 6


func test_fold_method_string() -> Bool:
	v: Int[#3] = {1, 2, 3}
	s: String = v.fold("", func(acc: String, x: Int) -> String: acc + x.to_string())
	s == "123"


tests: TestSuite = {
	description = "fold method syntax",
	tests = [
		("fold method int", test_fold_method_int),
		("fold method string", test_fold_method_string),
	],
}
