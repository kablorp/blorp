import:
	test: TestSuite


@tail_recursive
func countdown(n: Int) -> Void:
	if n <= 0:
		void
	else:
		countdown(n - 1)


@tail_recursive
func print_countdown(n: Int) -> Void:
	if n <= 0:
		print("done")
	else:
		print("${n}")
		print_countdown(n - 1)


func test_void_tailrec_basic() -> Bool:
	countdown(100)
	True


func test_void_tailrec_with_print() -> Bool:
	print_countdown(3)
	True


@tail_recursive
func count_down_match(n: Int) -> Void:
	match n:
		0: void
		_: count_down_match(n - 1)


func test_void_tailrec_match() -> Bool:
	count_down_match(50)
	True


tests: TestSuite = {
	description = "Tailrec Void Functions",
	tests = [
		("basic void tailrec", test_void_tailrec_basic),
		("void tailrec with print", test_void_tailrec_with_print),
		("void tailrec with match", test_void_tailrec_match),
	],
}
