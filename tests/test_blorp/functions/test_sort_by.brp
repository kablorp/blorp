import:
	list: List, get, sort_by, sort_desc_by
	string: substring
	test: TestSuite


func test_sort_by_descending() -> Bool:
	sorted: List[Int] = [3, 1, 4, 1, 5].sort_by(func(x: Int): 0 - x)
	match sorted.get(0):
		Some(v): v == 5
		None: False
	and match sorted.get(4):
		Some(v): v == 1
		None: False


func test_sort_by_float_key() -> Bool:
	sorted: List[String] = sort_by(["hi", "hello", "hey"], func(s: String): s
			.length()
			.to_float())
	match sorted.get(0):
		Some(v): v == "hi"
		None: False
	and match sorted.get(2):
		Some(v): v == "hello"
		None: False


func test_sort_by_string_key() -> Bool:
	-- Sort ints by their string representation (lexicographic)
	sorted: List[Int] = [3, 1, 20, 10, 2].sort_by(func(x: Int): x.to_string())

	-- Lexicographic: "1" < "10" < "2" < "20" < "3"
	match sorted.get(0):
		Some(v): v == 1
		None: False
	and match sorted.get(4):
		Some(v): v == 3
		None: False


func test_sort_by_float_descending() -> Bool:
	sorted: List[Int] = [1, 2, 3, 4, 5].sort_by(func(x: Int): 0.0 - x.to_float())
	match sorted.get(0):
		Some(v): v == 5
		None: False
	and match sorted.get(4):
		Some(v): v == 1
		None: False


func test_sort_by_stable() -> Bool:
	-- Sort by first character (string key), verify stability
	sorted: List[String] = [
		"banana",
		"apple",
		"blueberry",
		"avocado",
	].sort_by(
		func(s: String): s.substring(0, 1),
	)

	-- "a" group: apple, avocado (stable order preserved)
	-- "b" group: banana, blueberry (stable order preserved)
	match sorted.get(0):
		Some(v): v == "apple"
		None: False
	and match sorted.get(1):
		Some(v): v == "avocado"
		None: False
	and match sorted.get(2):
		Some(v): v == "banana"
		None: False


func test_sort_desc_by() -> Bool:
	sorted: List[Int] = [1, 3, 2].sort_desc_by(func(x: Int): x)
	sorted == [3, 2, 1]


func test_sort_by_empty() -> Bool:
	empty: List[Int] = []
	empty
		.sort_by(func(x: Int): x)
		.length() == 0


func test_sort_by_single() -> Bool:
	[42].sort_by(func(x: Int): x) == [42]


tests: TestSuite = {
	description = "Sort_by tests",
	tests = [
		("sort_by descending", test_sort_by_descending),
		("sort_by float key", test_sort_by_float_key),
		("sort_by string key", test_sort_by_string_key),
		("sort_by float descending", test_sort_by_float_descending),
		("sort_by stable", test_sort_by_stable),
		("sort_desc_by", test_sort_desc_by),
		("sort_by empty", test_sort_by_empty),
		("sort_by single", test_sort_by_single),
	]
}
