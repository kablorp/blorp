import:
	test: TestSuite


union Choice[T]:
	Picked(T)
	Missing


record Label {
	text: String
}


record Box[T] {
	value: T
}


union Wrapped[T]:
	WrappedValue(Box[T])
	WrappedMissing


func choose_text() -> Choice[String]:
	Picked("hello")


func choose_number() -> Choice[Int]:
	Picked(41)


func choose_label() -> Choice[Label]:
	Picked({text = "label"})


func test_string_payload() -> Bool:
	chosen: Choice[String] = choose_text()

	match chosen:
		Picked(text):
			text == "hello"
		Missing:
			False


func test_int_payload() -> Bool:
	chosen: Choice[Int] = choose_number()

	match chosen:
		Picked(number):
			number + 1 == 42
		Missing:
			False


func test_record_payload() -> Bool:
	chosen: Choice[Label] = choose_label()

	match chosen:
		Picked(label):
			label.text == "label"
		Missing:
			False


func test_generic_record_payload() -> Bool:
	wrapped: Wrapped[String] = WrappedValue({value = "boxed"})

	match wrapped:
		WrappedValue(box):
			box.value == "boxed"
		WrappedMissing:
			False


tests: TestSuite = {
	description = "Generic union payload layout",
	tests = [
		("String payload", test_string_payload),
		("Int payload", test_int_payload),
		("record payload", test_record_payload),
		("generic record payload", test_generic_record_payload),
	]
}
