import:
	list as L
	tensor: get
	test: TestSuite
	vector: map, map_indexed_parallel


-- Reproduction: named closure + inline lambda in same while body.
-- The named closure steals a __clos_tmp intended for the inline lambda.
func test_named_plus_inline_lambdas_in_while() -> Bool:
	var i: Int = 0
	var total: Int = 0
	while i < 100:
		f: pure (Int) -> Int = pure func(x: Int): x + 1
		items: List[Int] = [1, 2, 3]
		result: List[Int] = L.map(items, f)
		mapped: List[Int] = L.map(items, pure func(x: Int): x * 2)
		total = total + L.length(result) + L.length(mapped)
		i += 1
	total == 600


-- Particle sim pattern: named closure with RC captures inside conditional
-- inside while + inline lambdas elsewhere in while body
pure func lookup(v: Float[#100], i: Int) -> Float:
	match get(v, i):
		Some(val): val
		None: 0.0


record DataRec {ax: Float[#100], ay: Float[#100], n: Int}


func test_particle_sim_pattern() -> Bool:
	var i: Int = 0
	var total: Float = 0.0
	var do_gravity: Bool = True
	var px = vector(0.0, 100)
	var py = vector(0.0, 100)
	while i < 100:
		if do_gravity:
			-- Build a record (like build_octree)
			data: DataRec = {ax = px, ay = py, n = 100}
			-- Snapshot mutable vectors (like snap_px/py/pz)
			snap_px: Float[#100] = px
			snap_py: Float[#100] = py
			-- Named closure capturing RC objects
			compute: pure (Int, Float) -> (Float, Float) = pure func(idx: Int, val: Float):
				if val > 0.5:
					(
						lookup(data.ax, idx) + lookup(snap_px, idx),
						lookup(data.ay, idx) + lookup(snap_py, idx),
					)
				else:
					(0.0, 0.0)
			alive = vector(0.0, 100)
			result: (Float, Float)[#100] = map_indexed_parallel(alive, compute)
			void
		-- Inline lambdas in same while body
		speed_sq = vector(0.0, 100)
		speeds: Float[#100] = speed_sq.map(func(s: Float): s + 1.0)
		items: List[Int] = [3, 1, 2]
		mapped: List[Int] = L.map(items, pure func(x: Int): x * 10)
		total += to_float(L.length(mapped))
		i += 1
	total > 0.0


-- Named closure + TWO inline lambdas (vector map + list map)
func test_named_plus_two_inline_in_while() -> Bool:
	var i: Int = 0
	var total: Float = 0.0
	while i < 100:
		v = vector(0.0, 100)
		compute: pure (Int, Float) -> Float = pure func(idx: Int, val: Float): to_float(idx)
		result: Float[#100] = map_indexed_parallel(v, compute)
		speeds: Float[#100] = v.map(func(s: Float): s + 1.0)
		items: List[Int] = [1, 2, 3]
		mapped: List[Int] = L.map(items, pure func(x: Int): x * 10)
		total += to_float(L.length(mapped))
		i += 1
	total > 0.0


-- Control: inline lambda only (no named), should always work
func test_inline_closure_in_while() -> Bool:
	var i: Int = 0
	var total: Int = 0
	while i < 100:
		items: List[Int] = [1, 2, 3]
		result: List[Int] = L.map(items, pure func(x: Int): x * 2)
		total += L.length(result)
		i += 1
	total == 300


tests: TestSuite = {
	description = "Named closure in while loop (double-release bug)",
	tests = [
		("named + inline lambdas in while", test_named_plus_inline_lambdas_in_while),
		("particle sim pattern", test_particle_sim_pattern),
		("named + two inline in while", test_named_plus_two_inline_in_while),
		("inline closure in while (control)", test_inline_closure_in_while),
	],
}
