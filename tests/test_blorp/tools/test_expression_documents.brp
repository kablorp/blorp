func test_expr_json_error() -> Bool:
	match "{\"tag\":\"Unary\",\"op\":\"Bang\",\"expr\":{\"tag\":\"Ident\",\"name\":\"x\"}}".expression_from_json_string():
		Ok(_): False
		Err(msg): msg == "unknown unary operator: Bang"


tests: TestSuite = {
	description = "Blorp formatter expression docs",
	tests = [
		("string literal escaping", test_string_literal_escaping),
		("unicode string literal preserved", test_unicode_string_literal_preserved),
		("char literal escaping", test_char_literal_escaping),
		("simple call and field access", test_simple_call_and_field_access),
		(
			"nested call args expand when parent breaks",
			test_nested_call_args_expand_when_parent_breaks,
		),
		("empty call args never break", test_empty_call_args_never_break),
		("block call argument forces multiline args", test_block_call_arg_forces_multiline_args),
		("trailing block lambda call argument", test_trailing_block_lambda_call_arg_doc),
		("leading block lambda call argument", test_leading_block_lambda_call_arg_doc),
		("UFCS chain expression doc", test_ufcs_chain_expr_doc),
		("binary precedence parentheses", test_binary_precedence_parentheses),
		("binary precedence flat", test_binary_precedence_flat),
		("unary negation parentheses", test_unary_negation_parentheses),
		("builtin runtime call", test_builtin_runtime_call),
		("tuple expression doc", test_tuple_expr_doc),
		("list expression doc", test_list_expr_doc),
		("short numeric list expression doc", test_short_numeric_list_expr_doc),
		("long numeric list expression doc", test_long_numeric_list_expr_doc),
		("compact simple collection call arg doc", test_compact_simple_collection_call_arg_doc),
		("vector expression doc", test_vector_expr_doc),
		("short numeric vector expression doc", test_short_numeric_vector_expr_doc),
		("shaped vector expression doc", test_shaped_vector_expr_doc),
		("record expression doc", test_record_expr_doc),
		("record update expression doc", test_record_update_expr_doc),
		("ascription expression doc", test_ascription_expr_doc),
		("range expression doc", test_range_expr_doc),
		("subscript expression doc", test_subscript_expr_doc),
		("subscript multi expression doc", test_subscript_multi_expr_doc),
		("dict expression doc", test_dict_expr_doc),
		("field range receiver parenthesized", test_field_range_receiver_parenthesized),
		("assign expression doc", test_assign_expr_doc),
		("compound assign expression doc", test_compound_assign_expr_doc),
		("var declaration expression doc", test_var_decl_expr_doc),
		("tuple destructure expression doc", test_tuple_destruct_expr_doc),
		("subscript assignment expression doc", test_subscript_assign_expr_doc),
		("question bind expression doc", test_question_bind_expr_doc),
		("block expression doc", test_block_expr_doc),
		("if expression doc", test_if_expr_doc),
		("while expression doc", test_while_expr_doc),
		("for expression doc", test_for_expr_doc),
		("for tuple expression doc", test_for_tuple_expr_doc),
		("with expression doc", test_with_expr_doc),
		("match expression doc", test_match_expr_doc),
		("match trailing expression doc", test_match_trailing_expr_doc),
		("lambda expression doc", test_lambda_expr_doc),
		("block lambda expression doc", test_block_lambda_expr_doc),
		("function declaration expression doc", test_func_decl_expr_doc),
		("string interpolation expression doc", test_string_interp_expr_doc),
		("triple string interpolation expression doc", test_triple_string_interp_expr_doc),
		("debug block expression doc", test_debug_block_expr_doc),
		("debug block comment expression doc", test_debug_block_comment_expr_doc),
		("concurrent expression doc", test_concurrent_expr_doc),
		("detach expression doc", test_detach_expr_doc),
		("concurrent for expression doc", test_concurrent_for_expr_doc),
		("expr JSON rejects unknown operator", test_expr_json_error),
	],
}
