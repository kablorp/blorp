func test_list_expr_doc() -> Bool:
	match 100.render_expression_json(list_json()):
		Ok(flat): match 8.render_expression_json(list_json()):
			Ok(broken): flat == "[alpha, beta]\n" and broken == "[\n\talpha,\n\tbeta,\n]\n"
			Err(_): False
		Err(_): False


func test_short_numeric_list_expr_doc() -> Bool:
	match 1.render_expression_json(short_numeric_list_json()):
		Ok(short_rendered): match 1.render_expression_json(mixed_numeric_list_json()):
			Ok(mixed_rendered):
				short_ok: Bool = short_rendered == "[1, 2, 3, 4, 5, 6, 7, 8]\n"
				mixed_ok: Bool = mixed_rendered == "[-1, 2.5, 3]\n"
				short_ok and mixed_ok
			Err(_): False
		Err(_): False


func test_long_numeric_list_expr_doc() -> Bool:
	match 100.render_expression_json(long_numeric_list_json()):
		Ok(rendered):
			rendered == "[\n\t1,\n\t2,\n\t3,\n\t4,\n\t5,\n\t6,\n\t7,\n\t8,\n\t9,\n]\n"
		Err(_): False


func test_compact_simple_collection_call_arg_doc() -> Bool:
	match 100.render_expression_json(compact_numeric_list_call_json()):
		Ok(nums_rendered): match 100.render_expression_json(compact_char_list_call_json()):
			Ok(chars_rendered): match 100.render_expression_json(compact_tuple_list_call_json()):
				Ok(tuples_rendered): match 100.render_expression_json(
					compact_call_list_call_json(),
				):
					Ok(calls_rendered):
						nums_ok: Bool = nums_rendered == "sum([1, 2, 3, 4])\n"
						chars_ok: Bool = chars_rendered == "encode_utf8(['H', 'i'])\n"
						tuples_ok: Bool = tuples_rendered == "from_list([(1, \"a\"), (2, \"b\")])\n"
						calls_ok: Bool = calls_rendered == "line_string([coord(0.0, 0.0), coord(1.0, 1.0)])\n"
						nums_ok and chars_ok and tuples_ok and calls_ok
					Err(_): False
				Err(_): False
			Err(_): False
		Err(_): False


