func test_string_literal_escaping() -> Bool:
	match 100.render_expression_json(string_escape_json()):
		Ok(rendered): rendered == "\"line\\n\\\"q\\\"\\\\\"\n"
		Err(_): False


func test_unicode_string_literal_preserved() -> Bool:
	match 100.render_expression_json(unicode_string_json()):
		Ok(rendered): rendered == "\"a — b\"\n"
		Err(_): False


func test_char_literal_escaping() -> Bool:
	match 100.render_expression_json(char_escape_json()):
		Ok(rendered): rendered == "'\\n'\n"
		Err(_): False


func test_simple_call_and_field_access() -> Bool:
	match 100.render_expression_json(call_json()):
		Ok(rendered): rendered == "add(1, value.name)\n"
		Err(_): False


func test_nested_call_args_expand_when_parent_breaks() -> Bool:
	match 40.render_expression_json(nested_call_json()):
		Ok(rendered):
			rendered == "Some(\n\tbit_or(\n\t\tbit_or(\n\t\t\tshift_left(\n\t\t\t\tb3,\n\t\t\t\t24,\n\t\t\t),\n\t\t\tshift_left(\n\t\t\t\tb2,\n\t\t\t\t16,\n\t\t\t),\n\t\t),\n\t\tbit_or(\n\t\t\tshift_left(\n\t\t\t\tb1,\n\t\t\t\t8,\n\t\t\t),\n\t\t\tb0,\n\t\t),\n\t),\n)\n"
		Err(_): False


func test_empty_call_args_never_break() -> Bool:
	match 1.render_expression_json(empty_call_json()):
