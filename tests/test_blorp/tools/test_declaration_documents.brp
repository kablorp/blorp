import:
	../../../tools/formatter/declaration_documents:
		declaration_from_json_string,
		render_declaration_json,
		render_program_json,
	test: TestSuite


func selective_import_json() -> String:
	"{\"tag\":\"Import\",\"module\":\"list\",\"symbols\":[{\"name\":\"append\"},{\"name\":\"get\"},{\"name\":\"Option\",\"ctors\":[\"Some\",\"None\"]}]}"


func qualified_import_json() -> String:
	"{\"tag\":\"Import\",\"module\":\"dict\",\"alias\":\"D\"}"


func var_decl_json() -> String:
	"{\"tag\":\"Var\",\"private\":false,\"name\":\"total\",\"mutable\":true,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"0\"}}}"


func private_var_decl_json() -> String:
	"{\"tag\":\"Var\",\"private\":true,\"name\":\"name\",\"mutable\":false,\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"String\",\"text\":\"blorp\",\"raw\":false,\"triple\":false}}}"


func func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"add\",\"pure\":true,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[\"T\"],\"params\":[{\"tag\":\"TypedName\",\"name\":\"x\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"y\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body\":{\"tag\":\"Binary\",\"op\":\"Add\",\"left\":{\"tag\":\"Ident\",\"name\":\"x\"},\"right\":{\"tag\":\"Ident\",\"name\":\"y\"}}}"


func function_param_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"d_map\",\"pure\":true,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[\"A\",\"B\"],\"params\":[{\"tag\":\"TypedName\",\"name\":\"decoder\",\"type\":{\"tag\":\"Named\",\"name\":\"Decoder\",\"args\":[{\"tag\":\"Var\",\"name\":\"A\"}]}},{\"tag\":\"TypedName\",\"name\":\"f\",\"type\":{\"tag\":\"Func\",\"pure\":true,\"params\":[{\"tag\":\"Var\",\"name\":\"A\"}],\"return\":{\"tag\":\"Var\",\"name\":\"B\"}}}],\"return\":{\"tag\":\"Named\",\"name\":\"Decoder\",\"args\":[{\"tag\":\"Var\",\"name\":\"B\"}]},\"body\":{\"tag\":\"Lambda\",\"pure\":true,\"params\":[{\"tag\":\"Name\",\"name\":\"v\"}],\"body\":{\"tag\":\"Block\",\"exprs\":[{\"tag\":\"QuestionBind\",\"name\":\"val\",\"expr\":{\"tag\":\"Call\",\"callee\":{\"tag\":\"Ident\",\"name\":\"decoder\"},\"args\":[{\"tag\":\"Ident\",\"name\":\"v\"}]}},{\"tag\":\"Call\",\"callee\":{\"tag\":\"Ident\",\"name\":\"Ok\"},\"args\":[{\"tag\":\"Call\",\"callee\":{\"tag\":\"Ident\",\"name\":\"f\"},\"args\":[{\"tag\":\"Ident\",\"name\":\"val\"}]}]}]}}}"


func four_short_params_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"ray_aabb\",\"pure\":true,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"r\",\"type\":{\"tag\":\"Named\",\"name\":\"Ray\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"box\",\"type\":{\"tag\":\"Named\",\"name\":\"AABB3\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"t_min\",\"type\":{\"tag\":\"Named\",\"name\":\"Float\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"t_max\",\"type\":{\"tag\":\"Named\",\"name\":\"Float\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Bool\",\"args\":[]},\"body\":{\"tag\":\"Ident\",\"name\":\"ok\"}}"


func where_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"needs_sum\",\"pure\":true,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[\"T\",\"#M\",\"#N\",\"#R\"],\"params\":[],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"where\":[{\"left\":{\"tag\":\"DimOp\",\"op\":\"Add\",\"left\":{\"tag\":\"Var\",\"name\":\"#M\"},\"right\":{\"tag\":\"Var\",\"name\":\"#N\"}},\"right\":{\"tag\":\"Var\",\"name\":\"#R\"}}],\"body\":{\"tag\":\"Ident\",\"name\":\"ok\"}}"


func doc_func_decl_json() -> String:
	"{\"tag\":\"Doc\",\"doc\":{\"tag\":\"Plain\",\"text\":\"Adds two numbers.\\nKeeps overflow wrapping.\"},\"decl\":" + func_decl_json() + "}"


func doctest_doc_func_decl_json() -> String:
	"{\"tag\":\"Doc\",\"doc\":{\"tag\":\"Doctests\",\"prefix\":[\"Example docs.\",\"\"],\"groups\":[{\"description\":\"unformatted list\",\"imports\":[],\"body\":{\"tag\":\"Block\",\"exprs\":[{\"tag\":\"VarDecl\",\"name\":\"xs\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"List\",\"args\":[{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}]},\"value\":{\"tag\":\"List\",\"elems\":[{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"1\"}},{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"2\"}}]}},{\"tag\":\"Binary\",\"op\":\"Eq\",\"left\":{\"tag\":\"Call\",\"callee\":{\"tag\":\"FieldAccess\",\"receiver\":{\"tag\":\"Ident\",\"name\":\"xs\"},\"field\":\"length\"},\"args\":[]},\"right\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"2\"}}}]}}]},\"decl\":" + no_body_func_decl_json() + "}"


func annotated_private_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":true,\"name\":\"loop\",\"pure\":true,\"tailrec\":true,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"n\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body\":{\"tag\":\"Ident\",\"name\":\"n\"}}"


func builtin_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"read_clock\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body_kind\":\"builtin\",\"builtin_name\":\"blorp_read_clock\"}"


func foreign_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"floor\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"x\",\"type\":{\"tag\":\"Named\",\"name\":\"Float\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Float\",\"args\":[]},\"body_kind\":\"foreign\",\"foreign_name\":\"c_floor\"}"


func foreign_func_decl_json_named(name: String, foreign_name: String) -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"" + name + "\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"x\",\"type\":{\"tag\":\"Named\",\"name\":\"Float\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Float\",\"args\":[]},\"body_kind\":\"foreign\",\"foreign_name\":\"" + foreign_name + "\",\"foreign_includes\":[\"math.h\"],\"foreign_link_flags\":[{\"value\":\"-lm\"}]}"


func no_body_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"pending\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"x\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body_kind\":\"none\"}"


func long_signature_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":true,\"name\":\"make_param\",\"pure\":true,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"name\",\"type\":{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"kind\",\"type\":{\"tag\":\"Named\",\"name\":\"ArgKind\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"long\",\"type\":{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"short\",\"type\":{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"help\",\"type\":{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"req\",\"type\":{\"tag\":\"Named\",\"name\":\"Bool\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"vtype\",\"type\":{\"tag\":\"Named\",\"name\":\"ValueType\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"metavar\",\"type\":{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Param\",\"args\":[]},\"body_kind\":\"none\"}"


func blank_body_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"grouped\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body\":{\"tag\":\"Block\",\"blank_before\":[false,true,false],\"exprs\":[{\"tag\":\"VarDecl\",\"name\":\"a\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"1\"}}},{\"tag\":\"VarDecl\",\"name\":\"b\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"2\"}}},{\"tag\":\"Binary\",\"op\":\"Add\",\"left\":{\"tag\":\"Ident\",\"name\":\"a\"},\"right\":{\"tag\":\"Ident\",\"name\":\"b\"}}]}}"


func comment_body_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"grouped\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body\":{\"tag\":\"Block\",\"exprs\":[{\"tag\":\"VarDecl\",\"name\":\"a\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"1\"}}},{\"tag\":\"VarDecl\",\"name\":\"b\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"2\"}}},{\"tag\":\"Binary\",\"op\":\"Add\",\"left\":{\"tag\":\"Ident\",\"name\":\"a\"},\"right\":{\"tag\":\"Ident\",\"name\":\"b\"}}],\"items\":[{\"tag\":\"Expression\",\"blank_before\":false,\"expr\":{\"tag\":\"VarDecl\",\"name\":\"a\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"1\"}}}},{\"tag\":\"Comment\",\"blank_before\":true,\"text\":\"-- keep this with the block\"},{\"tag\":\"Expression\",\"blank_before\":false,\"expr\":{\"tag\":\"VarDecl\",\"name\":\"b\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"2\"}}}},{\"tag\":\"Expression\",\"blank_before\":false,\"expr\":{\"tag\":\"Binary\",\"op\":\"Add\",\"left\":{\"tag\":\"Ident\",\"name\":\"a\"},\"right\":{\"tag\":\"Ident\",\"name\":\"b\"}}}]}}"


func trailing_comment_body_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"grouped\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body\":{\"tag\":\"Block\",\"exprs\":[{\"tag\":\"VarDecl\",\"name\":\"a\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"1\"}}},{\"tag\":\"VarDecl\",\"name\":\"b\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"2\"}}},{\"tag\":\"Binary\",\"op\":\"Add\",\"left\":{\"tag\":\"Ident\",\"name\":\"a\"},\"right\":{\"tag\":\"Ident\",\"name\":\"b\"}}],\"items\":[{\"tag\":\"Expression\",\"blank_before\":false,\"trailing\":\"-- first\",\"expr\":{\"tag\":\"VarDecl\",\"name\":\"a\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"1\"}}}},{\"tag\":\"Expression\",\"blank_before\":false,\"trailing\":\"-- second\",\"expr\":{\"tag\":\"VarDecl\",\"name\":\"b\",\"mutable\":false,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"2\"}}}},{\"tag\":\"Expression\",\"blank_before\":false,\"trailing\":\"-- result\",\"expr\":{\"tag\":\"Binary\",\"op\":\"Add\",\"left\":{\"tag\":\"Ident\",\"name\":\"a\"},\"right\":{\"tag\":\"Ident\",\"name\":\"b\"}}}]}}"


func type_alias_decl_json() -> String:
	"{\"tag\":\"TypeAlias\",\"private\":false,\"name\":\"Pair\",\"type_params\":[\"A\",\"B\"],\"target\":{\"tag\":\"Tuple\",\"elems\":[{\"tag\":\"Var\",\"name\":\"A\"},{\"tag\":\"Var\",\"name\":\"B\"}]}}"


func union_decl_json() -> String:
	"{\"tag\":\"Type\",\"private\":false,\"name\":\"Option\",\"type_params\":[\"T\"],\"enum\":false,\"builtin\":false,\"resource\":false,\"variants\":[{\"name\":\"Some\",\"fields\":[{\"tag\":\"Var\",\"name\":\"T\"}]},{\"name\":\"None\",\"fields\":[]}]}"


func enum_decl_json() -> String:
	"{\"tag\":\"Type\",\"private\":false,\"name\":\"Color\",\"type_params\":[],\"enum\":true,\"builtin\":false,\"resource\":false,\"variants\":[{\"name\":\"Red\",\"fields\":[]},{\"name\":\"Green\",\"fields\":[]}]}"


func builtin_type_decl_json() -> String:
	"{\"tag\":\"Type\",\"private\":true,\"name\":\"Int\",\"type_params\":[],\"enum\":false,\"builtin\":true,\"resource\":false,\"variants\":[]}"


func record_decl_json() -> String:
	"{\"tag\":\"Record\",\"private\":false,\"name\":\"Point\",\"type_params\":[],\"value\":false,\"builtin\":false,\"fields\":[{\"name\":\"x\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}},{\"name\":\"y\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}}]}"


func struct_decl_json() -> String:
	"{\"tag\":\"Record\",\"private\":true,\"name\":\"Box\",\"type_params\":[\"T\"],\"value\":true,\"builtin\":false,\"fields\":[{\"name\":\"value\",\"type\":{\"tag\":\"Var\",\"name\":\"T\"}}]}"


func builtin_record_decl_json() -> String:
	"{\"tag\":\"Record\",\"private\":false,\"name\":\"List\",\"type_params\":[\"T\"],\"value\":false,\"builtin\":true,\"fields\":[]}"


func trait_decl_json() -> String:
	"{\"tag\":\"Trait\",\"private\":false,\"name\":\"Incrementable\",\"type_params\":[],\"supertraits\":[],\"methods\":[{\"name\":\"increment\",\"pure\":false,\"params\":[{\"tag\":\"TypedName\",\"name\":\"self\",\"type\":{\"tag\":\"Self\"}}],\"return\":{\"tag\":\"Self\"}}]}"


func trait_default_decl_json() -> String:
	"{\"tag\":\"Trait\",\"private\":false,\"name\":\"Named\",\"type_params\":[],\"supertraits\":[],\"methods\":[{\"name\":\"name\",\"pure\":true,\"params\":[{\"tag\":\"TypedName\",\"name\":\"self\",\"type\":{\"tag\":\"Self\"}}],\"return\":{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]},\"body\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"String\",\"text\":\"item\",\"raw\":false,\"triple\":false}}}]}"


func trait_super_only_decl_json() -> String:
	"{\"tag\":\"Trait\",\"private\":true,\"name\":\"Serializable\",\"type_params\":[],\"supertraits\":[\"Printable\",\"Equatable\"],\"methods\":[]}"


func impl_decl_json() -> String:
	"{\"tag\":\"Impl\",\"private\":false,\"trait\":\"Incrementable\",\"for\":{\"tag\":\"Named\",\"name\":\"Counter\",\"args\":[]},\"methods\":[{\"name\":\"increment\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"self\",\"type\":{\"tag\":\"Named\",\"name\":\"Counter\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Counter\",\"args\":[]},\"body\":{\"tag\":\"RecordUpdate\",\"base\":{\"tag\":\"Ident\",\"name\":\"self\"},\"fields\":[{\"name\":\"value\",\"value\":{\"tag\":\"Binary\",\"op\":\"Add\",\"left\":{\"tag\":\"FieldAccess\",\"receiver\":{\"tag\":\"Ident\",\"name\":\"self\"},\"field\":\"value\"},\"right\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"1\"}}}}]}}]}"


func impl_builtin_decl_json() -> String:
	"{\"tag\":\"Impl\",\"private\":false,\"trait\":\"Stringable\",\"for\":{\"tag\":\"Named\",\"name\":\"Char\",\"args\":[]},\"methods\":[{\"name\":\"to_string\",\"pure\":true,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"resource_result_ordinary\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"val\",\"type\":{\"tag\":\"Named\",\"name\":\"Char\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]},\"body_kind\":\"builtin\",\"builtin_name\":\"blorp_from_char\"}]}"


func body_program_json() -> String:
	"{\"program\":[" + var_decl_json() + "," + type_alias_decl_json() + "," + func_decl_json() + "," + func_decl_json() + "]}"


func import_program_json() -> String:
	"{\"program\":[" + selective_import_json() + "," + qualified_import_json() + "," + var_decl_json() + "]}"


func duplicate_import_program_json() -> String:
	"{\"program\":[" + qualified_import_json() + "," + qualified_import_json() + "," + selective_import_json() + "," + var_decl_json() + "]}"


func duplicate_import_comments_program_json() -> String:
	"{\"comments\":[{\"text\":\"-- duplicate import rationale\",\"line\":3,\"column\":2,\"trailing\":false}],\"program\":[{\"line\":2,\"column\":2,\"decl\":" + qualified_import_json() + "},{\"line\":4,\"column\":2,\"decl\":" + qualified_import_json() + "},{\"line\":6,\"column\":1,\"decl\":" + var_decl_json() + "}]}"


func option_some_import_json() -> String:
	"{\"tag\":\"Import\",\"module\":\"option\",\"symbols\":[{\"name\":\"Option\",\"ctors\":[\"Some\"]}]}"


func option_none_import_json() -> String:
	"{\"tag\":\"Import\",\"module\":\"option\",\"symbols\":[{\"name\":\"Option\",\"ctors\":[\"None\"]}]}"


func distinct_constructor_import_program_json() -> String:
	"{\"comments\":[{\"text\":\"-- some constructor\",\"line\":3,\"column\":2,\"trailing\":false},{\"text\":\"-- none constructor\",\"line\":5,\"column\":2,\"trailing\":false}],\"program\":[{\"line\":2,\"column\":2,\"decl\":" + qualified_import_json() + "},{\"line\":4,\"column\":2,\"decl\":" + option_some_import_json() + "},{\"line\":6,\"column\":2,\"decl\":" + option_none_import_json() + "},{\"line\":8,\"column\":1,\"decl\":" + var_decl_json() + "}]}"


func body_import_program_json() -> String:
	"{\"program\":[" + type_alias_decl_json() + "," + selective_import_json() + "," + qualified_import_json() + "," + var_decl_json() + "]}"


func commented_program_json() -> String:
	"{\"comments\":[{\"text\":\"-- file header\",\"line\":1,\"column\":1,\"trailing\":false},{\"text\":\"--count\",\"line\":2,\"column\":20,\"trailing\":true},{\"text\":\"-- alias comment\",\"line\":3,\"column\":1,\"trailing\":false},{\"text\":\"-- eof\",\"line\":5,\"column\":1,\"trailing\":false}],\"program\":[{\"line\":2,\"column\":1,\"decl\":" + var_decl_json() + "},{\"line\":4,\"column\":1,\"decl\":" + type_alias_decl_json() + "}]}"


func import_comments_program_json() -> String:
	"{\"comments\":[{\"text\":\"-- file header\",\"line\":1,\"column\":1,\"trailing\":false},{\"text\":\"-- dict import\",\"line\":3,\"column\":2,\"trailing\":false},{\"text\":\"--dict trailing\",\"line\":4,\"column\":12,\"trailing\":true},{\"text\":\"-- list import\",\"line\":5,\"column\":2,\"trailing\":false},{\"text\":\"-- body comment\",\"line\":7,\"column\":1,\"trailing\":false}],\"program\":[{\"line\":4,\"column\":2,\"decl\":" + qualified_import_json() + "},{\"line\":6,\"column\":2,\"decl\":" + selective_import_json() + "},{\"line\":8,\"column\":1,\"decl\":" + var_decl_json() + "}]}"


func foreign_program_json() -> String:
	"{\"program\":[" + foreign_func_decl_json() + "," + builtin_func_decl_json() + "]}"


func foreign_comments_program_json() -> String:
	"{\"comments\":[{\"text\":\"-- file header\",\"line\":1,\"column\":1,\"trailing\":false},{\"text\":\"-- foreign block comment\",\"line\":2,\"column\":1,\"trailing\":false},{\"text\":\"-- floor comment\",\"line\":4,\"column\":2,\"trailing\":false},{\"text\":\"--floor trailing\",\"line\":5,\"column\":48,\"trailing\":true},{\"text\":\"-- ceil comment\",\"line\":6,\"column\":2,\"trailing\":false},{\"text\":\"-- body comment\",\"line\":8,\"column\":1,\"trailing\":false}],\"program\":[{\"line\":5,\"column\":2,\"decl\":" + foreign_func_decl_json_named(
		"floor",
		"c_floor",
	) + "},{\"line\":7,\"column\":2,\"decl\":" + foreign_func_decl_json_named(
		"ceil",
		"c_ceil",
	) + "},{\"line\":9,\"column\":1,\"decl\":" + var_decl_json() + "}]}"


func test_selective_import_doc() -> Bool:
	match 100.render_declaration_json(selective_import_json()):
		Ok(rendered): rendered == "import:\n\tlist: Option(Some, None), append, get\n"
		Err(_): False


func test_qualified_import_doc() -> Bool:
	match 100.render_declaration_json(qualified_import_json()):
		Ok(rendered): rendered == "import:\n\tdict as D\n"
		Err(_): False


func test_var_decl_doc() -> Bool:
	match 100.render_declaration_json(var_decl_json()):
		Ok(rendered): rendered == "var total: Int = 0\n"
		Err(_): False


func test_private_var_decl_doc() -> Bool:
	match 100.render_declaration_json(private_var_decl_json()):
		Ok(rendered): rendered == "private name = \"blorp\"\n"
		Err(_): False


func test_func_decl_doc() -> Bool:
	match 100.render_declaration_json(func_decl_json()):
		Ok(rendered): rendered == "pure func add[T](x: Int, y: Int) -> Int:\n\tx + y\n"
		Err(_): False


func test_function_param_func_decl_doc() -> Bool:
	match 100.render_declaration_json(function_param_func_decl_json()):
		Ok(rendered):
			rendered == "pure func d_map[A, B](\n\tdecoder: Decoder[A],\n\tf: pure (A) -> B,\n) -> Decoder[B]:\n\tpure func(v):\n\t\tval ?= decoder(v)\n\t\tOk(f(val))\n"
		Err(_): False


func test_four_short_params_func_decl_doc() -> Bool:
	match 100.render_declaration_json(four_short_params_func_decl_json()):
		Ok(rendered):
			rendered == "pure func ray_aabb(r: Ray, box: AABB3, t_min: Float, t_max: Float) -> Bool:\n\tok\n"
		Err(_): False


func test_where_func_decl_doc() -> Bool:
	match 100.render_declaration_json(where_func_decl_json()):
		Ok(rendered):
			rendered == "pure func needs_sum[T, #M, #N, #R]() -> Int where #M + #N == #R:\n\tok\n"
		Err(_): False


func test_doc_func_decl_doc() -> Bool:
	match 100.render_declaration_json(doc_func_decl_json()):
		Ok(rendered): rendered == "---\nAdds two numbers.\nKeeps overflow wrapping.\n---\npure func add[T](x: Int, y: Int) -> Int:\n\tx + y\n"
		Err(_): False


func test_doctest_doc_func_decl_doc() -> Bool:
	match 100.render_declaration_json(doctest_doc_func_decl_json()):
		Ok(rendered):
			rendered == "---\nExample docs.\n\ndoctests:\n    :: unformatted list\n    xs: List[Int] = [1, 2]\n    xs.length() == 2\n---\nfunc pending(x: Int) -> Int:\n"
		Err(_): False


