import:
	./compile_time_import_dependency as Dep


IMPORTED_BASE: Int = 41

SharedName: Int = 41

private PRIVATE_OFFSET: Int = 1

BASE_WORDS: List[String] = ["these", "args"]


pure func imported_plus(value: Int) -> Int:
	value + IMPORTED_BASE


pure func imported_reads_private(value: Int) -> Int:
	value + PRIVATE_OFFSET


pure func imported_reads_qualified_dependency(value: Int) -> Int:
	value + Dep.DEPENDENCY_OFFSET


pure func join_upper(args: List[String]) -> String:
	args
		.join("AHHH")
		.upper()
