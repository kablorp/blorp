import:
	../../../tools/formatter/fmt_type_doc: layout_type_json, type_expr_from_json_string
	test: TestSuite


func named_json() -> String:
	"{\"tag\":\"Named\",\"name\":\"Dict\",\"args\":[{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]},{\"tag\":\"Named\",\"name\":\"List\",\"args\":[{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}]}]}"


func pure_func_json() -> String:
	"{\"tag\":\"Func\",\"pure\":true,\"params\":[{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]}],\"return\":{\"tag\":\"Named\",\"name\":\"Option\",\"args\":[{\"tag\":\"Named\",\"name\":\"Bool\",\"args\":[]}]}}"


func array_func_json() -> String:
	"{\"tag\":\"Array\",\"elem\":{\"tag\":\"Func\",\"pure\":true,\"params\":[{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}],\"return\":{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]}},\"dims\":[{\"tag\":\"Var\",\"name\":\"#N\"}]}"


func dim_precedence_json() -> String:
	"{\"tag\":\"Named\",\"name\":\"Tensor\",\"args\":[{\"tag\":\"DimOp\",\"op\":\"Mul\",\"left\":{\"tag\":\"DimOp\",\"op\":\"Add\",\"left\":{\"tag\":\"Var\",\"name\":\"#M\"},\"right\":{\"tag\":\"Var\",\"name\":\"#N\"}},\"right\":{\"tag\":\"Var\",\"name\":\"#K\"}}]}"


func misc_json() -> String:
	"{\"tag\":\"Tuple\",\"elems\":[{\"tag\":\"Self\"},{\"tag\":\"Range\",\"inner\":{\"tag\":\"ConstInt\",\"value\":8}},{\"tag\":\"VarDims\",\"name\":\"#Ds\"},{\"tag\":\"BoundVar\",\"source\":\"T:Stringable\"},{\"tag\":\"Meta\",\"id\":7}]}"


func test_named_type_doc() -> Bool:
	match 100.layout_type_json(named_json()):
		Ok(rendered): rendered == "Dict[String, List[Int]]\n"
		Err(_): False


func test_pure_func_type_doc() -> Bool:
	match 100.layout_type_json(pure_func_json()):
		Ok(rendered): rendered == "pure (Int, String) -> Option[Bool]\n"
		Err(_): False


func test_array_function_elem_is_parenthesized() -> Bool:
	match 100.layout_type_json(array_func_json()):
		Ok(rendered): rendered == "(pure (Int) -> String)[#N]\n"
		Err(_): False


func test_dim_precedence() -> Bool:
	match 100.layout_type_json(dim_precedence_json()):
		Ok(rendered): rendered == "Tensor[(#M + #N) * #K]\n"
		Err(_): False


func test_misc_type_doc() -> Bool:
	match 100.layout_type_json(misc_json()):
		Ok(rendered): rendered == "(Self, ..#8, #Ds..., T:Stringable, ?m7)\n"
		Err(_): False


func test_type_doc_json_error() -> Bool:
	match "{\"tag\":\"DimOp\",\"op\":\"Pow\",\"left\":{\"tag\":\"Var\",\"name\":\"#M\"},\"right\":{\"tag\":\"Var\",\"name\":\"#N\"}}".type_expr_from_json_string():
		Ok(_): False
		Err(msg): msg == "unknown type dimension operator: Pow"


tests: TestSuite = {
	description = "Blorp formatter type docs",
	tests = [
		("named type docs", test_named_type_doc),
		("pure function type docs", test_pure_func_type_doc),
		("array function element type is parenthesized", test_array_function_elem_is_parenthesized),
		("dimension precedence", test_dim_precedence),
		("misc type docs", test_misc_type_doc),
		("type doc JSON rejects unknown dimension op", test_type_doc_json_error),
	],
}
