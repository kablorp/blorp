import:
	../../../tools/formatter/fmt_decl_doc:
		decl_from_json_string,
		layout_decl_json,
		layout_program_json,
	test: TestSuite


func selective_import_json() -> String:
	"{\"tag\":\"Import\",\"module\":\"list\",\"symbols\":[{\"name\":\"append\"},{\"name\":\"get\"},{\"name\":\"Option\",\"ctors\":[\"Some\",\"None\"]}]}"


func qualified_import_json() -> String:
	"{\"tag\":\"Import\",\"module\":\"dict\",\"alias\":\"D\"}"


func var_decl_json() -> String:
	"{\"tag\":\"Var\",\"private\":false,\"name\":\"total\",\"mutable\":true,\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"0\"}}}"


func private_var_decl_json() -> String:
	"{\"tag\":\"Var\",\"private\":true,\"name\":\"name\",\"mutable\":false,\"value\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"String\",\"text\":\"blorp\",\"raw\":false,\"triple\":false}}}"


func func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"add\",\"pure\":true,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"type_params\":[\"T\"],\"params\":[{\"tag\":\"TypedName\",\"name\":\"x\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}},{\"tag\":\"TypedName\",\"name\":\"y\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body\":{\"tag\":\"Binary\",\"op\":\"Add\",\"left\":{\"tag\":\"Ident\",\"name\":\"x\"},\"right\":{\"tag\":\"Ident\",\"name\":\"y\"}}}"


func doc_func_decl_json() -> String:
	"{\"tag\":\"Doc\",\"doc\":\"Adds two numbers.\\nKeeps overflow wrapping.\",\"decl\":" + func_decl_json() + "}"


func annotated_private_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":true,\"name\":\"loop\",\"pure\":true,\"tailrec\":true,\"debug_only\":false,\"no_copy\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"n\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body\":{\"tag\":\"Ident\",\"name\":\"n\"}}"


func builtin_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"read_clock\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"type_params\":[],\"params\":[],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body_kind\":\"builtin\",\"builtin_name\":\"blorp_read_clock\"}"


func foreign_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"floor\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"x\",\"type\":{\"tag\":\"Named\",\"name\":\"Float\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Float\",\"args\":[]},\"body_kind\":\"foreign\",\"foreign_name\":\"c_floor\"}"


func no_body_func_decl_json() -> String:
	"{\"tag\":\"Func\",\"private\":false,\"name\":\"pending\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"x\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]},\"body_kind\":\"none\"}"


func type_alias_decl_json() -> String:
	"{\"tag\":\"TypeAlias\",\"private\":false,\"name\":\"Pair\",\"type_params\":[\"A\",\"B\"],\"target\":{\"tag\":\"Tuple\",\"elems\":[{\"tag\":\"Var\",\"name\":\"A\"},{\"tag\":\"Var\",\"name\":\"B\"}]}}"


func union_decl_json() -> String:
	"{\"tag\":\"Type\",\"private\":false,\"name\":\"Option\",\"type_params\":[\"T\"],\"enum\":false,\"builtin\":false,\"variants\":[{\"name\":\"Some\",\"fields\":[{\"tag\":\"Var\",\"name\":\"T\"}]},{\"name\":\"None\",\"fields\":[]}]}"


func enum_decl_json() -> String:
	"{\"tag\":\"Type\",\"private\":false,\"name\":\"Color\",\"type_params\":[],\"enum\":true,\"builtin\":false,\"variants\":[{\"name\":\"Red\",\"fields\":[]},{\"name\":\"Green\",\"fields\":[]}]}"


func builtin_type_decl_json() -> String:
	"{\"tag\":\"Type\",\"private\":true,\"name\":\"Int\",\"type_params\":[],\"enum\":false,\"builtin\":true,\"variants\":[]}"


func record_decl_json() -> String:
	"{\"tag\":\"Record\",\"private\":false,\"name\":\"Point\",\"type_params\":[],\"value\":false,\"builtin\":false,\"fields\":[{\"name\":\"x\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}},{\"name\":\"y\",\"type\":{\"tag\":\"Named\",\"name\":\"Int\",\"args\":[]}}]}"


func struct_decl_json() -> String:
	"{\"tag\":\"Record\",\"private\":true,\"name\":\"Box\",\"type_params\":[\"T\"],\"value\":true,\"builtin\":false,\"fields\":[{\"name\":\"value\",\"type\":{\"tag\":\"Var\",\"name\":\"T\"}}]}"


func builtin_record_decl_json() -> String:
	"{\"tag\":\"Record\",\"private\":false,\"name\":\"List\",\"type_params\":[\"T\"],\"value\":false,\"builtin\":true,\"fields\":[]}"


func trait_decl_json() -> String:
	"{\"tag\":\"Trait\",\"private\":false,\"name\":\"Incrementable\",\"type_params\":[],\"supertraits\":[],\"methods\":[{\"name\":\"increment\",\"pure\":false,\"params\":[{\"tag\":\"TypedName\",\"name\":\"self\",\"type\":{\"tag\":\"Self\"}}],\"return\":{\"tag\":\"Self\"}}]}"


func trait_default_decl_json() -> String:
	"{\"tag\":\"Trait\",\"private\":false,\"name\":\"Named\",\"type_params\":[],\"supertraits\":[],\"methods\":[{\"name\":\"name\",\"pure\":true,\"params\":[{\"tag\":\"TypedName\",\"name\":\"self\",\"type\":{\"tag\":\"Self\"}}],\"return\":{\"tag\":\"Named\",\"name\":\"String\",\"args\":[]},\"body\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"String\",\"text\":\"item\",\"raw\":false,\"triple\":false}}}]}"


func trait_super_only_decl_json() -> String:
	"{\"tag\":\"Trait\",\"private\":true,\"name\":\"Serializable\",\"type_params\":[],\"supertraits\":[\"Printable\",\"Equatable\"],\"methods\":[]}"


func impl_decl_json() -> String:
	"{\"tag\":\"Impl\",\"private\":false,\"trait\":\"Incrementable\",\"for\":{\"tag\":\"Named\",\"name\":\"Counter\",\"args\":[]},\"methods\":[{\"name\":\"increment\",\"pure\":false,\"tailrec\":false,\"debug_only\":false,\"no_copy\":false,\"type_params\":[],\"params\":[{\"tag\":\"TypedName\",\"name\":\"self\",\"type\":{\"tag\":\"Named\",\"name\":\"Counter\",\"args\":[]}}],\"return\":{\"tag\":\"Named\",\"name\":\"Counter\",\"args\":[]},\"body\":{\"tag\":\"RecordUpdate\",\"base\":{\"tag\":\"Ident\",\"name\":\"self\"},\"fields\":[{\"name\":\"value\",\"value\":{\"tag\":\"Binary\",\"op\":\"Add\",\"left\":{\"tag\":\"FieldAccess\",\"receiver\":{\"tag\":\"Ident\",\"name\":\"self\"},\"field\":\"value\"},\"right\":{\"tag\":\"Literal\",\"literal\":{\"tag\":\"Int\",\"value\":\"1\"}}}}]}}]}"


func body_program_json() -> String:
	"{\"program\":[" + var_decl_json() + "," + type_alias_decl_json() + "," + func_decl_json() + "," + func_decl_json() + "]}"


func import_program_json() -> String:
	"{\"program\":[" + selective_import_json() + "," + qualified_import_json() + "," + var_decl_json() + "]}"


func duplicate_import_program_json() -> String:
	"{\"program\":[" + qualified_import_json() + "," + qualified_import_json() + "," + selective_import_json() + "," + var_decl_json() + "]}"


func foreign_program_json() -> String:
	"{\"program\":[" + foreign_func_decl_json() + "," + builtin_func_decl_json() + "]}"


func test_selective_import_doc() -> Bool:
	match 100.layout_decl_json(selective_import_json()):
		Ok(rendered): rendered == "import:\n\tlist: Option(Some, None), append, get\n"
		Err(_): False


func test_qualified_import_doc() -> Bool:
	match 100.layout_decl_json(qualified_import_json()):
		Ok(rendered): rendered == "import:\n\tdict as D\n"
		Err(_): False


func test_var_decl_doc() -> Bool:
	match 100.layout_decl_json(var_decl_json()):
		Ok(rendered): rendered == "var total: Int = 0\n"
		Err(_): False


func test_private_var_decl_doc() -> Bool:
	match 100.layout_decl_json(private_var_decl_json()):
		Ok(rendered): rendered == "private name = \"blorp\"\n"
		Err(_): False


func test_func_decl_doc() -> Bool:
	match 100.layout_decl_json(func_decl_json()):
		Ok(rendered): rendered == "pure func add[T](x: Int, y: Int) -> Int:\n\tx + y\n"
		Err(_): False


func test_doc_func_decl_doc() -> Bool:
	match 100.layout_decl_json(doc_func_decl_json()):
		Ok(rendered): rendered == "---\nAdds two numbers.\nKeeps overflow wrapping.\n---\npure func add[T](x: Int, y: Int) -> Int:\n\tx + y\n"
		Err(_): False


func test_annotated_private_func_decl_doc() -> Bool:
	match 100.layout_decl_json(annotated_private_func_decl_json()):
		Ok(rendered): rendered == "private @tailrec pure func loop(n: Int) -> Int:\n\tn\n"
		Err(_): False


func test_builtin_func_decl_doc() -> Bool:
	match 100.layout_decl_json(builtin_func_decl_json()):
		Ok(rendered): rendered == "func read_clock() -> Int:\n\tbuiltin(\"blorp_read_clock\")\n"
		Err(_): False


func test_foreign_func_decl_doc() -> Bool:
	match 100.layout_decl_json(foreign_func_decl_json()):
		Ok(rendered): rendered == "foreign func floor(x: Float) -> Float = \"c_floor\"\n"
		Err(_): False


func test_no_body_func_decl_doc() -> Bool:
	match 100.layout_decl_json(no_body_func_decl_json()):
		Ok(rendered): rendered == "func pending(x: Int) -> Int:\n"
		Err(_): False


func test_type_alias_decl_doc() -> Bool:
	match 100.layout_decl_json(type_alias_decl_json()):
		Ok(rendered): rendered == "type alias Pair[A, B] = (A, B)\n"
		Err(_): False


func test_union_decl_doc() -> Bool:
	match 100.layout_decl_json(union_decl_json()):
		Ok(rendered): rendered == "union Option[T]:\n\tSome(T)\n\tNone\n"
		Err(_): False


func test_enum_decl_doc() -> Bool:
	match 100.layout_decl_json(enum_decl_json()):
		Ok(rendered): rendered == "enum Color:\n\tRed\n\tGreen\n"
		Err(_): False


func test_builtin_type_decl_doc() -> Bool:
	match 100.layout_decl_json(builtin_type_decl_json()):
		Ok(rendered): rendered == "private type Int = builtin\n"
		Err(_): False


func test_record_decl_doc() -> Bool:
	match 100.layout_decl_json(record_decl_json()):
		Ok(rendered): rendered == "record Point {x: Int, y: Int}\n"
		Err(_): False


func test_struct_decl_doc() -> Bool:
	match 100.layout_decl_json(struct_decl_json()):
		Ok(rendered): rendered == "private struct Box[T] {value: T}\n"
		Err(_): False


func test_builtin_record_decl_doc() -> Bool:
	match 100.layout_decl_json(builtin_record_decl_json()):
		Ok(rendered): rendered == "record List[T] {builtin}\n"
		Err(_): False


func test_trait_decl_doc() -> Bool:
	match 100.layout_decl_json(trait_decl_json()):
		Ok(rendered): rendered == "trait Incrementable:\n\tfunc increment(self: Self) -> Self\n"
		Err(_): False


func test_trait_default_decl_doc() -> Bool:
	match 100.layout_decl_json(trait_default_decl_json()):
		Ok(rendered): rendered == "trait Named:\n\tpure func name(self: Self) -> String: \"item\"\n"
		Err(_): False


func test_trait_super_only_decl_doc() -> Bool:
	match 100.layout_decl_json(trait_super_only_decl_json()):
		Ok(rendered): rendered == "private trait Serializable: Printable + Equatable\n"
		Err(_): False


func test_impl_decl_doc() -> Bool:
	match 100.layout_decl_json(impl_decl_json()):
		Ok(rendered): rendered == "implements Incrementable for Counter:\n\tfunc increment(self: Counter) -> Counter:\n\t\t{ self | value = self.value + 1 }\n"
		Err(_): False


func test_body_program_doc() -> Bool:
	match 100.layout_program_json(body_program_json()):
		Ok(rendered): rendered == "var total: Int = 0\n\ntype alias Pair[A, B] = (A, B)\n\n\npure func add[T](x: Int, y: Int) -> Int:\n\tx + y\npure func add[T](x: Int, y: Int) -> Int:\n\tx + y\n"
		Err(_): False


func test_import_program_doc() -> Bool:
	match 100.layout_program_json(import_program_json()):
		Ok(rendered): rendered == "import:\n\tdict as D\n\tlist: Option(Some, None), append, get\n\n\nvar total: Int = 0\n"
		Err(_): False


func test_duplicate_import_program_doc() -> Bool:
	match 100.layout_program_json(duplicate_import_program_json()):
		Ok(rendered): rendered == "import:\n\tdict as D\n\tlist: Option(Some, None), append, get\n\n\nvar total: Int = 0\n"
		Err(_): False


func test_foreign_program_doc() -> Bool:
	match 100.layout_program_json(foreign_program_json()):
		Ok(rendered): rendered == "foreign:\n\tfunc floor(x: Float) -> Float = \"c_floor\"\n\n\nfunc read_clock() -> Int:\n\tbuiltin(\"blorp_read_clock\")\n"
		Err(_): False


func test_decl_json_error() -> Bool:
	match "{\"tag\":\"Unknown\"}".decl_from_json_string():
		Ok(_): False
		Err(msg): msg == "unknown declaration JSON tag: Unknown"


tests: TestSuite = {
	description = "Blorp formatter declaration docs",
	tests = [
		("selective import declaration doc", test_selective_import_doc),
		("qualified import declaration doc", test_qualified_import_doc),
		("variable declaration doc", test_var_decl_doc),
		("private variable declaration doc", test_private_var_decl_doc),
		("function declaration doc", test_func_decl_doc),
		("docstring function declaration doc", test_doc_func_decl_doc),
		("annotated private function declaration doc", test_annotated_private_func_decl_doc),
		("builtin function declaration doc", test_builtin_func_decl_doc),
		("foreign function declaration doc", test_foreign_func_decl_doc),
		("no-body function declaration doc", test_no_body_func_decl_doc),
		("type alias declaration doc", test_type_alias_decl_doc),
		("union declaration doc", test_union_decl_doc),
		("enum declaration doc", test_enum_decl_doc),
		("builtin type declaration doc", test_builtin_type_decl_doc),
		("record declaration doc", test_record_decl_doc),
		("struct declaration doc", test_struct_decl_doc),
		("builtin record declaration doc", test_builtin_record_decl_doc),
		("trait declaration doc", test_trait_decl_doc),
		("trait default declaration doc", test_trait_default_decl_doc),
		("trait super-only declaration doc", test_trait_super_only_decl_doc),
		("impl declaration doc", test_impl_decl_doc),
		("body program doc", test_body_program_doc),
		("import program doc", test_import_program_doc),
		("duplicate import program doc", test_duplicate_import_program_doc),
		("foreign program doc", test_foreign_program_doc),
		("decl JSON rejects unknown tag", test_decl_json_error),
	],
}
