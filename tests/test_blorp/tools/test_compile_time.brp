import:
	option: Option(Some, None)
	test: TestSuite


union CompileTimeChoice:
	ChoiceValue(Int)
	ChoiceEmpty


record CompileTimePoint {
	x: Int,
	y: Int
}


private pure func compile_time_double(value: Int) -> Int:
	value * 2


private pure func compile_time_block_value(value: Int) -> Int:
	inner: Int = value + 1
	compile_time_double(inner)


private pure func compile_time_label(prefix: String) -> String:
	prefix + "_call"


private pure func compile_time_interpolate(prefix: String, suffix: String) -> String:
	"${prefix}_${suffix}"


private pure func choice_score(choice: CompileTimeChoice) -> Int:
	match choice:
		ChoiceValue(value): value + 1
		ChoiceEmpty: 0


private pure func compile_time_list_sum(values: List[Int]) -> Int:
	var total: Int = 0
	for value in values:
		total += value
	total


private pure func compile_time_range_sum(limit: Int) -> Int:
	var total: Int = 0
	for value in 0..limit:
		total += value
	total


private pure func compile_time_while_sum(limit: Int) -> Int:
	var index: Int = 0
	var total: Int = 0
	while index < limit:
		total += index
		index += 1
	total


private pure func compile_time_shift_y(point: CompileTimePoint) -> CompileTimePoint:
	{ point |
		y = point.y + 1
	}


private pure func compile_time_tuple_sum(pair: (Int, Int)) -> Int:
	(left, right) = pair
	left + right


private pure func compile_time_factorial(value: Int) -> Int:
	if value <= 1:
		1
	else:
		value * compile_time_factorial(value - 1)


compile_time:
	private BASE: Int = 1 + 2
	ANSWER: Int = BASE * 14
	LABEL: String = "compile" + "_time"
	INTERP_LABEL: String = "${LABEL}_value"
	INTERP_PRIMITIVES: String = "n=${ANSWER}, flag=${True}, char=${'Z'}"
	FLAGS: List[Bool] = [True, False, ANSWER == 42]
	CALL_VALUE: Int = compile_time_block_value(20)
	CALL_LABEL: String = compile_time_label("pure")
	CALL_INTERP_LABEL: String = compile_time_interpolate("pure", "interp")
	CHOICE: CompileTimeChoice = ChoiceValue(41)
	EMPTY_CHOICE: CompileTimeChoice = ChoiceEmpty
	CHOICE_SCORE: Int = choice_score(CHOICE)
	EMPTY_SCORE: Int = choice_score(EMPTY_CHOICE)
	MAYBE: Option[Int] = Some(41)
	OPTION_SCORE: Int = match MAYBE:
		Some(value): value + 1
		None: 0
	NONE_VALUE: Option[Int] = None
	NONE_SCORE: Int = match NONE_VALUE:
		Some(value): value
		None: 0
	LIST_SUM: Int = compile_time_list_sum([10, 20, 12])
	RANGE_SUM: Int = compile_time_range_sum(5)
	WHILE_SUM: Int = compile_time_while_sum(5)
	POINT: CompileTimePoint = {
		x = 10,
		y = 31
	}
	SHIFTED_POINT: CompileTimePoint = compile_time_shift_y({ POINT |
			x = 11
		})
	TUPLE_SUM: Int = compile_time_tuple_sum((20, 22))
	FACTORIAL_FIVE: Int = compile_time_factorial(5)


func test_compile_time_arithmetic() -> Bool:
	ANSWER == 42


func test_compile_time_string() -> Bool:
	LABEL == "compile_time"


func test_compile_time_string_interp() -> Bool:
	INTERP_LABEL == "compile_time_value" and CALL_INTERP_LABEL == "pure_interp" and INTERP_PRIMITIVES == "n=42, flag=True, char=Z"


func test_compile_time_list() -> Bool:
	FLAGS.length() == 3


func test_compile_time_pure_call() -> Bool:
	CALL_VALUE == 42


func test_compile_time_pure_string_call() -> Bool:
	CALL_LABEL == "pure_call"


func test_compile_time_union_match() -> Bool:
	CHOICE_SCORE == 42 and EMPTY_SCORE == 0 and choice_score(CHOICE) == 42


func test_compile_time_option_match() -> Bool:
	OPTION_SCORE == 42 and NONE_SCORE == 0


func test_compile_time_for_list() -> Bool:
	LIST_SUM == 42


func test_compile_time_for_range() -> Bool:
	RANGE_SUM == 10


func test_compile_time_while() -> Bool:
	WHILE_SUM == 10


func test_compile_time_record_update() -> Bool:
	SHIFTED_POINT.x == 11 and SHIFTED_POINT.y == 32


func test_compile_time_tuple_destructure() -> Bool:
	TUPLE_SUM == 42


func test_compile_time_recursion() -> Bool:
	FACTORIAL_FIVE == 120


tests: TestSuite = {
	description = "compile_time",
	tests = [
		("arithmetic", test_compile_time_arithmetic),
		("string", test_compile_time_string),
		("string_interp", test_compile_time_string_interp),
		("list", test_compile_time_list),
		("pure_call", test_compile_time_pure_call),
		("pure_string_call", test_compile_time_pure_string_call),
		("union_match", test_compile_time_union_match),
		("option_match", test_compile_time_option_match),
		("for_list", test_compile_time_for_list),
		("for_range", test_compile_time_for_range),
		("while", test_compile_time_while),
		("record_update", test_compile_time_record_update),
		("tuple_destructure", test_compile_time_tuple_destructure),
		("recursion", test_compile_time_recursion),
	]
}
