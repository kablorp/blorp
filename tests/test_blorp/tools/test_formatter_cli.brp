import:
	../../../tools/formatter/command_line:
		ParsedCommand(CommandMessage, CommandProgramBatch),
		parse_command,
		parse_width_args,
	test: TestSuite


func test_default_width() -> Bool:
	match parse_width_args("program", ["input.json"]):
		Ok(parsed):
			if parsed.width != 100:
				False
			else if parsed.paths.length() != 1:
				False
			else:
				match parsed.paths.get(0):
					Some(path): path == "input.json"
					None: False
		Err(_): False


func test_width_option() -> Bool:
	match parse_width_args(
		"program",
		["--width=80", "input.json"],
	):
		Ok(parsed):
			if parsed.width != 80:
				False
			else if parsed.paths.length() != 1:
				False
			else:
				match parsed.paths.get(0):
					Some(path): path == "input.json"
					None: False
		Err(_): False


func test_dash_dash_path() -> Bool:
	match parse_width_args(
		"program",
		["--", "--input.json"],
	):
		Ok(parsed):
			if parsed.width != 100:
				False
			else if parsed.paths.length() != 1:
				False
			else:
				match parsed.paths.get(0):
					Some(path): path == "--input.json"
					None: False
		Err(_): False


func test_unknown_option() -> Bool:
	match parse_width_args(
		"program",
		["--bogus", "input.json"],
	):
		Ok(_): False
		Err(msg): msg == "unknown argument: --bogus"


func test_unknown_command_help_is_rejected() -> Bool:
	match parse_command("does-not-exist", ["--help"]):
		CommandMessage(msg, status): msg == "unknown formatter command: does-not-exist" and status == 1
		_: False


func test_program_batch_pairs() -> Bool:
	match parse_command(
		"program-batch",
		["one.json", "one.brp", "two.json", "two.brp"],
	):
		CommandProgramBatch(args):
			args.pairs.length() == 2 and match args.pairs.get(0):
				Some(pair): pair[0] == "one.json" and pair[1] == "one.brp"
				None: False
		_: False


tests: TestSuite = {
	description = "Blorp formatter CLI parsing",
	tests = [
		("default width", test_default_width),
		("width option", test_width_option),
		("dash dash path", test_dash_dash_path),
		("unknown option", test_unknown_option),
		("unknown command help is rejected", test_unknown_command_help_is_rejected),
		("program batch pairs", test_program_batch_pairs),
	]
}
