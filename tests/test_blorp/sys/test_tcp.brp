-- TCP resource tests.
--
-- TCP handles are scoped resources. Tests keep listener/stream values inside
-- `with` blocks and communicate with detached clients through channels.
import:
	bytes as B
	net/tcp:
		IpFamily(IPv4),
		TcpError,
		TcpStream,
		accept,
		chunks,
		connect_ip,
		connect_loopback,
		connections_continue_on_error,
		connections_stop_on_error,
		dns_name,
		ipv4,
		is_timed_out,
		lines,
		listen_any_interface_any_port,
		listen_ip_any_port,
		listen_loopback_any_port,
		local_port,
		message,
		port,
		read_chunk,
		set_reuse_addr,
		set_stream_timeout,
		set_timeout,
		write_all,
	stream: ResourceSource, collect_result, find_result
	string: contains, starts_with
	test: TestSuite


pure func is_socket_permission_error(err: TcpError) -> Bool:
	detail_msg: String = message(err)
	detail_msg.contains("Operation not permitted") or detail_msg.contains("Permission denied")


pure func is_invalid_message(message: String, detail: String) -> Bool:
	message.starts_with("invalid input: ") and message.contains(detail)


pure func long_host() -> String:
	var host: String = ""
	var i: Int = 0
	while i < 256:
		host += "a"
		i += 1
	host


func client_echo_once(port_num: Int, value: Int) -> Result[Int, TcpError]:
	remote ?= port(port_num)
	with stream ?= connect_loopback(IPv4, remote):
		payload: Bytes = B
			.bytes(1)
			.fill(value)
		ignored ?= write_all(stream, payload)
		reply ?= read_chunk(stream, 64)
		match reply.get(0):
			Some(byte): Ok(byte)
			None: Ok(-1)


func client_echo_once_ip(port_num: Int, value: Int) -> Result[Int, TcpError]:
	remote ?= port(port_num)
	address = ipv4(to_uint8(127), to_uint8(0), to_uint8(0), to_uint8(1))
	with stream ?= connect_ip(address, remote):
		payload: Bytes = B
			.bytes(1)
			.fill(value)
		ignored ?= write_all(stream, payload)
		reply ?= read_chunk(stream, 64)
		match reply.get(0):
			Some(byte): Ok(byte)
			None: Ok(-1)


func detached_echo_client(port: Int, value: Int, done: Channel[Int]) -> Bool:
	actual: Int = match client_echo_once(port, value):
		Ok(byte): byte
		Err(_): -1000
	_ = send(done, actual)
	actual == value


func detached_echo_client_ip(port: Int, value: Int, done: Channel[Int]) -> Bool:
	actual: Int = match client_echo_once_ip(port, value):
		Ok(byte): byte
		Err(_): -1000
	_ = send(done, actual)
	actual == value


pure func delayed_connect_sleep_ms() -> Int:
	50


pure func continue_source_accept_timeout_ms() -> Int:
	10


pure func concurrent_echo_accept_timeout_ms() -> Int:
	1000


func delayed_connect_only_result(port_num: Int) -> Result[Int, TcpError]:
	sleep(delayed_connect_sleep_ms())
	remote ?= port(port_num)
	with _ ?= connect_loopback(IPv4, remote):
		Ok(1)


func delayed_connect_only(port: Int, done: Channel[Int]) -> Bool:
	status: Int = match delayed_connect_only_result(port):
		Ok(value): value
		Err(_): -1
	_ = send(done, status)
	status > 0


func client_write_once(port_num: Int, text: String) -> Result[Void, TcpError]:
	remote ?= port(port_num)
	with stream ?= connect_loopback(IPv4, remote):
		ignored ?= write_all(stream, text.to_bytes())
		Ok(void)


func detached_write_client(port: Int, text: String, done: Channel[Bool]) -> Bool:
	ok: Bool = match client_write_once(port, text):
		Ok(_): True
		Err(_): False
	_ = send(done, ok)
	ok


func scoped_echo_once() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 16):
		port_num ?= local_port(listener)
		done: Channel[Int] = channel(1)
		detach detached_echo_client(port_num, 42, done)
		with peer ?= accept(listener):
			data ?= read_chunk(peer, 64)
			ignored ?= write_all(peer, data)
			match recv(done):
				Some(actual): Ok(actual == 42)
				None: Ok(False)


func scoped_ip_echo_once() -> Result[Bool, TcpError]:
	address = ipv4(to_uint8(127), to_uint8(0), to_uint8(0), to_uint8(1))
	with listener ?= listen_ip_any_port(address, 16):
		port_num ?= local_port(listener)
		done: Channel[Int] = channel(1)
		detach detached_echo_client_ip(port_num, 43, done)
		with peer ?= accept(listener):
			data ?= read_chunk(peer, 64)
			ignored ?= write_all(peer, data)
			match recv(done):
				Some(actual): Ok(actual == 43)
				None: Ok(False)


func test_ip_tcp_echo_round_trip() -> Bool:
	match scoped_ip_echo_once():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func test_chunks_stream_reads_bytes() -> Bool:
	match scoped_chunks_stream_reads_bytes():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_chunks_stream_reads_bytes() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 16):
		port_num ?= local_port(listener)
		done: Channel[Bool] = channel(1)
		detach detached_write_client(port_num, "hello", done)
		with peer ?= accept(listener):
			first ?= chunks(peer, 2).find_result(func(chunk: Bytes): chunk.length() == 2)
			client_ok: Bool = match recv(done):
				Some(ok): ok
				None: False
			match first:
				Some(chunk): Ok(client_ok and chunk.to_string() == "he")
				None: Ok(False)


pure func expected_tcp_lines(items: List[String]) -> Bool:
	if items.length() != 3:
		False
	else:
		first_ok: Bool = match items.get(0):
			Some(line): line == "alpha"
			None: False
		second_ok: Bool = match items.get(1):
			Some(line): line == "beta"
			None: False
		third_ok: Bool = match items.get(2):
			Some(line): line == "gamma"
			None: False
		first_ok and second_ok and third_ok


func test_lines_stream_reads_text() -> Bool:
	match scoped_lines_stream_reads_text():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_lines_stream_reads_text() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 16):
		port_num ?= local_port(listener)
		done: Channel[Bool] = channel(1)
		detach detached_write_client(port_num, "alpha\nbeta\r\ngamma", done)
		with peer ?= accept(listener):
			items ?= lines(peer).collect_result()
			client_ok: Bool = match recv(done):
				Some(ok): ok
				None: False
			Ok(client_ok and expected_tcp_lines(items))


func test_listen_and_local_port() -> Bool:
	match scoped_listen_and_local_port():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_listen_and_local_port() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		port_num ?= local_port(listener)
		Ok(port_num > 0)


func test_listen_any_interface() -> Bool:
	match scoped_listen_any_interface():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_listen_any_interface() -> Result[Bool, TcpError]:
	with listener ?= listen_any_interface_any_port(IPv4, 1):
		port_num ?= local_port(listener)
		Ok(port_num > 0)


func test_connections_source_shape() -> Bool:
	match scoped_connections_source_shape():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_connections_source_shape() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		stop_source: ResourceSource[TcpStream, TcpError] = connections_stop_on_error(listener)
		continue_source: ResourceSource[TcpStream, TcpError] = connections_continue_on_error(
			listener,
		)
		Ok(True)


func test_connections_source_for_echo() -> Bool:
	match scoped_connections_source_for_echo():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_connections_source_for_echo() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 16):
		port_num ?= local_port(listener)
		done: Channel[Int] = channel(1)
		detach detached_echo_client(port_num, 77, done)
		var echoed: Bool = False
		for peer in connections_stop_on_error(listener):
			match read_chunk(peer, 64):
				Ok(data):
					match write_all(peer, data):
						Ok(_): echoed = True
						Err(_): echoed = False
				Err(_): echoed = False
			break
		match recv(done):
			Some(actual): Ok(echoed and actual == 77)
			None: Ok(False)


func test_connections_source_concurrent_echo() -> Bool:
	match scoped_connections_source_concurrent_echo():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_connections_source_concurrent_echo() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 16):
		ignored ?= set_timeout(listener, concurrent_echo_accept_timeout_ms())
		port_num ?= local_port(listener)
		done: Channel[Int] = channel(1)
		detach detached_echo_client(port_num, 88, done)
		for peer in connections_stop_on_error(listener) concurrently(limit: 2):
			match read_chunk(peer, 64):
				Ok(data): _ = write_all(peer, data)
				Err(_): void
		match recv(done):
			Some(actual): Ok(actual == 88)
			None: Ok(False)


func test_connections_continue_skips_accept_timeout() -> Bool:
	match scoped_connections_continue_skips_accept_timeout():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_connections_continue_skips_accept_timeout() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 16):
		ignored ?= set_timeout(listener, continue_source_accept_timeout_ms())
		port_num ?= local_port(listener)
		done: Channel[Int] = channel(1)
		detach delayed_connect_only(port_num, done)
		var accepted: Bool = False
		for peer in connections_continue_on_error(listener):
			accepted = True
			break
		client_connected: Bool = match recv_timeout(done, 1000):
			Some(status): status > 0
			None: False
		Ok(accepted and client_connected)


func test_scoped_echo_round_trip() -> Bool:
	match scoped_echo_once():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func test_invalid_port_is_typed() -> Bool:
	match port(-1):
		Ok(_): False
		Err(err): is_invalid_message(message(err), "port")


func test_invalid_dns_name_is_typed() -> Bool:
	match dns_name(long_host()):
		Ok(_): False
		Err(err): is_invalid_message(message(err), "DNS")


func test_read_chunk_invalid_size_is_typed() -> Bool:
	match scoped_invalid_read_size():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_invalid_read_size() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		port_num ?= local_port(listener)
		remote ?= port(port_num)
		with client ?= connect_loopback(IPv4, remote):
			with peer ?= accept(listener):
				negative: Bool = match read_chunk(peer, -1):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "max_bytes")
				zero: Bool = match read_chunk(peer, 0):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "max_bytes")
				too_large: Bool = match read_chunk(peer, 67108865):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "max_bytes")
				Ok(negative and zero and too_large)


func test_set_timeout_invalid_is_typed() -> Bool:
	match scoped_invalid_timeout():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_invalid_timeout() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		listener_ok: Bool = match set_timeout(listener, -1):
			Ok(_): False
			Err(err): is_invalid_message(message(err), "timeout")
		port_num ?= local_port(listener)
		remote ?= port(port_num)
		with client ?= connect_loopback(IPv4, remote):
			with peer ?= accept(listener):
				client_ok: Bool = match set_stream_timeout(client, -1):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "timeout")
				peer_ok: Bool = match set_stream_timeout(peer, -1):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "timeout")
				Ok(listener_ok and client_ok and peer_ok)


func test_set_reuse_addr() -> Bool:
	match scoped_set_reuse_addr():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_set_reuse_addr() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		ignored ?= set_reuse_addr(listener)
		Ok(True)


func test_accept_timeout_reports_error() -> Bool:
	match scoped_accept_timeout():
		Ok(_): False
		Err(err):
			if is_timed_out(err):
				True
			else:
				is_socket_permission_error(err)


func scoped_accept_timeout() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		ignored ?= set_timeout(listener, 10)
		with _ ?= accept(listener):
			Ok(False)


pure func keepalive_chunk_count() -> Int:
	40


pure func keepalive_write_delay_ms() -> Int:
	10


pure func keepalive_read_timeout_ms() -> Int:
	250


pure func keepalive_idle_after_writes_ms() -> Int:
	keepalive_read_timeout_ms() + 100


func keepalive_timeout_client_result(
	port_num: Int,
	count: Int,
	delay_ms: Int,
	idle_ms: Int,
) -> Result[Bool, TcpError]:
	sleep(delay_ms)
	remote ?= port(port_num)
	with stream ?= connect_loopback(IPv4, remote):
		var i: Int = 0
		var writes_ok: Bool = True
		while i < count and writes_ok:
			sleep(delay_ms)
			payload: Bytes = B
				.bytes(1)
				.fill(65)
			match write_all(stream, payload):
				Ok(_): i += 1
				Err(_): writes_ok = False
		sleep(idle_ms)
		Ok(writes_ok and i == count)


func keepalive_timeout_client(port: Int, done: Channel[Bool]) -> Bool:
	ok: Bool = match keepalive_timeout_client_result(
		port,
		keepalive_chunk_count(),
		keepalive_write_delay_ms(),
		keepalive_idle_after_writes_ms(),
	):
		Ok(value): value
		Err(_): False
	_ = send(done, ok)
	ok


func test_keepalive_reads_do_not_inherit_stale_timeout() -> Bool:
	match scoped_keepalive_reads_do_not_inherit_stale_timeout():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_keepalive_reads_do_not_inherit_stale_timeout() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		port_num ?= local_port(listener)
		done: Channel[Bool] = channel(1)
		detach keepalive_timeout_client(port_num, done)
		with peer ?= accept(listener):
			ignored ?= set_stream_timeout(peer, keepalive_read_timeout_ms())
			var count: Int = 0
			var reads_ok: Bool = True
			while count < keepalive_chunk_count() and reads_ok:
				match read_chunk(peer, 1):
					Ok(chunk):
						reads_ok = chunk.length() == 1
						count += 1
					Err(_):
						reads_ok = False
			idle_timed_out: Bool = match read_chunk(peer, 1):
				Ok(_): False
				Err(err): is_timed_out(err)
			client_ok: Bool = match recv_timeout(done, 1000):
				Some(ok): ok
				None: False
			Ok(reads_ok and count == keepalive_chunk_count() and idle_timed_out and client_ok)


func test_read_timeout_reports_error() -> Bool:
	match scoped_read_timeout():
		Ok(_): False
		Err(err):
			if is_timed_out(err):
				True
			else:
				is_socket_permission_error(err)


func scoped_read_timeout() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 1):
		port_num ?= local_port(listener)
		remote ?= port(port_num)
		with _ ?= connect_loopback(IPv4, remote):
			with peer ?= accept(listener):
				ignored ?= set_stream_timeout(peer, 10)
				data ?= read_chunk(peer, 64)
				Ok(False)


tests: TestSuite = {
	description = "TCP Resource Tests",
	tests = [
		("listen and local_port use scoped listener", test_listen_and_local_port),
		("listen on any interface uses passive bind", test_listen_any_interface),
		("connections exposes scoped resource source shape", test_connections_source_shape),
		("connections source for loop echo", test_connections_source_for_echo),
		("connections source concurrent echo", test_connections_source_concurrent_echo),
		("TCP chunks stream reads bytes", test_chunks_stream_reads_bytes),
		("TCP lines stream reads text", test_lines_stream_reads_text),
		(
			"connections continue skips accept timeout",
			test_connections_continue_skips_accept_timeout,
		),
		("scoped TCP echo round trip", test_scoped_echo_round_trip),
		("invalid TCP port is typed", test_invalid_port_is_typed),
		("invalid DNS name is typed", test_invalid_dns_name_is_typed),
		("IP TCP echo round trip", test_ip_tcp_echo_round_trip),
		("read_chunk invalid sizes are typed", test_read_chunk_invalid_size_is_typed),
		("set_timeout invalid values are typed", test_set_timeout_invalid_is_typed),
		("set_reuse_addr on scoped listener", test_set_reuse_addr),
		("accept timeout reports an error", test_accept_timeout_reports_error),
		(
			"keepalive reads do not inherit stale timeouts",
			test_keepalive_reads_do_not_inherit_stale_timeout,
		),
		("read timeout reports an error", test_read_timeout_reports_error),
	]
}
