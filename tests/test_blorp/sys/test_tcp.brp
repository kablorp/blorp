-- TCP resource tests.
--
-- TCP handles are scoped resources. Tests keep listener/stream values inside
-- `with` blocks and communicate with detached clients through channels.
import:
	bytes as B
	net/tcp:
		TcpError,
		TcpStream,
		accept,
		connect,
		connections_continue_on_error,
		connections_stop_on_error,
		listen,
		local_port,
		message,
		read_chunk,
		set_reuse_addr,
		set_stream_timeout,
		set_timeout,
		write_all,
	stream: ResourceSource
	string: contains, starts_with
	test: TestSuite


pure func is_socket_permission_error(err: TcpError) -> Bool:
	detail_msg: String = message(err)
	detail_msg.contains("Operation not permitted") or detail_msg.contains("Permission denied")


pure func is_invalid_message(message: String, detail: String) -> Bool:
	message.starts_with("invalid input: ") and message.contains(detail)


pure func long_host() -> String:
	var host: String = ""
	var i: Int = 0
	while i < 256:
		host += "a"
		i += 1
	host


func client_echo_once(port: Int, value: Int) -> Result[Int, TcpError]:
	with stream ?= connect("127.0.0.1", port):
		payload: Bytes = B
			.bytes(1)
			.fill(value)
		ignored ?= write_all(stream, payload)
		reply ?= read_chunk(stream, 64)
		match reply.get(0):
			Some(byte): Ok(byte)
			None: Ok(-1)


func detached_echo_client(port: Int, value: Int, done: Channel[Int]) -> Bool:
	actual: Int = match client_echo_once(port, value):
		Ok(byte): byte
		Err(_): -1000
	_ = send(done, actual)
	actual == value


func scoped_echo_once() -> Result[Bool, TcpError]:
	with listener ?= listen("127.0.0.1", 0, 16):
		port ?= local_port(listener)
		done: Channel[Int] = channel(1)
		detach detached_echo_client(port, 42, done)
		with peer ?= accept(listener):
			data ?= read_chunk(peer, 64)
			ignored ?= write_all(peer, data)
			match recv(done):
				Some(actual): Ok(actual == 42)
				None: Ok(False)


func test_listen_and_local_port() -> Bool:
	match scoped_listen_and_local_port():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_listen_and_local_port() -> Result[Bool, TcpError]:
	with listener ?= listen("127.0.0.1", 0, 1):
		port ?= local_port(listener)
		Ok(port > 0)


func test_listen_any_host() -> Bool:
	match scoped_listen_any_host():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_listen_any_host() -> Result[Bool, TcpError]:
	with listener ?= listen("", 0, 1):
		port ?= local_port(listener)
		Ok(port > 0)


func test_connections_source_shape() -> Bool:
	match scoped_connections_source_shape():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_connections_source_shape() -> Result[Bool, TcpError]:
	with listener ?= listen("127.0.0.1", 0, 1):
		stop_source: ResourceSource[TcpStream, TcpError] = connections_stop_on_error(listener)
		continue_source: ResourceSource[TcpStream, TcpError] = connections_continue_on_error(
			listener,
		)
		Ok(True)


func test_connections_source_for_echo() -> Bool:
	match scoped_connections_source_for_echo():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_connections_source_for_echo() -> Result[Bool, TcpError]:
	with listener ?= listen("127.0.0.1", 0, 16):
		port ?= local_port(listener)
		done: Channel[Int] = channel(1)
		detach detached_echo_client(port, 77, done)
		var echoed: Bool = False
		for peer in connections_stop_on_error(listener):
			match read_chunk(peer, 64):
				Ok(data):
					match write_all(peer, data):
						Ok(_): echoed = True
						Err(_): echoed = False
				Err(_): echoed = False
			break
		match recv(done):
			Some(actual): Ok(echoed and actual == 77)
			None: Ok(False)


func test_scoped_echo_round_trip() -> Bool:
	match scoped_echo_once():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func test_invalid_listen_port_is_typed() -> Bool:
	match invalid_listen_port_result():
		Ok(_): False
		Err(err): is_invalid_message(message(err), "port")


func invalid_listen_port_result() -> Result[Bool, TcpError]:
	with _ ?= listen("127.0.0.1", -1, 1):
		Ok(False)


func test_invalid_listen_host_is_typed() -> Bool:
	match invalid_listen_host_result():
		Ok(_): False
		Err(err): is_invalid_message(message(err), "host")


func invalid_listen_host_result() -> Result[Bool, TcpError]:
	with _ ?= listen(long_host(), 0, 1):
		Ok(False)


func test_invalid_connect_port_is_typed() -> Bool:
	match invalid_connect_port_result():
		Ok(_): False
		Err(err): is_invalid_message(message(err), "port")


func invalid_connect_port_result() -> Result[Bool, TcpError]:
	with _ ?= connect("127.0.0.1", 70000):
		Ok(False)


func test_read_chunk_invalid_size_is_typed() -> Bool:
	match scoped_invalid_read_size():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_invalid_read_size() -> Result[Bool, TcpError]:
	with listener ?= listen("127.0.0.1", 0, 1):
		port ?= local_port(listener)
		with client ?= connect("127.0.0.1", port):
			with peer ?= accept(listener):
				negative: Bool = match read_chunk(peer, -1):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "max_bytes")
				zero: Bool = match read_chunk(peer, 0):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "max_bytes")
				too_large: Bool = match read_chunk(peer, 67108865):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "max_bytes")
				Ok(negative and zero and too_large)


func test_set_timeout_invalid_is_typed() -> Bool:
	match scoped_invalid_timeout():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_invalid_timeout() -> Result[Bool, TcpError]:
	with listener ?= listen("127.0.0.1", 0, 1):
		listener_ok: Bool = match set_timeout(listener, -1):
			Ok(_): False
			Err(err): is_invalid_message(message(err), "timeout")
		port ?= local_port(listener)
		with client ?= connect("127.0.0.1", port):
			with peer ?= accept(listener):
				client_ok: Bool = match set_stream_timeout(client, -1):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "timeout")
				peer_ok: Bool = match set_stream_timeout(peer, -1):
					Ok(_): False
					Err(err): is_invalid_message(message(err), "timeout")
				Ok(listener_ok and client_ok and peer_ok)


func test_set_reuse_addr() -> Bool:
	match scoped_set_reuse_addr():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


func scoped_set_reuse_addr() -> Result[Bool, TcpError]:
	with listener ?= listen("127.0.0.1", 0, 1):
		ignored ?= set_reuse_addr(listener)
		Ok(True)


func test_accept_timeout_reports_error() -> Bool:
	match scoped_accept_timeout():
		Ok(ok): ok
		Err(_): True


func scoped_accept_timeout() -> Result[Bool, TcpError]:
	with listener ?= listen("127.0.0.1", 0, 1):
		ignored ?= set_timeout(listener, 10)
		with _ ?= accept(listener):
			Ok(False)


tests: TestSuite = {
	description = "TCP Resource Tests",
	tests = [
		("listen and local_port use scoped listener", test_listen_and_local_port),
		("listen on any host uses passive bind", test_listen_any_host),
		("connections exposes scoped resource source shape", test_connections_source_shape),
		("connections source for loop echo", test_connections_source_for_echo),
		("scoped TCP echo round trip", test_scoped_echo_round_trip),
		("listen invalid port is typed", test_invalid_listen_port_is_typed),
		("listen invalid host is typed", test_invalid_listen_host_is_typed),
		("connect invalid port is typed", test_invalid_connect_port_is_typed),
		("read_chunk invalid sizes are typed", test_read_chunk_invalid_size_is_typed),
		("set_timeout invalid values are typed", test_set_timeout_invalid_is_typed),
		("set_reuse_addr on scoped listener", test_set_reuse_addr),
		("accept timeout reports an error", test_accept_timeout_reports_error),
	]
}
