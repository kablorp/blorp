-- Test TCP networking basics
-- Uses loopback self-connection pattern: listen, connect, accept, write, read, close
import:
	bytes as B
	net/tcp as Tcp
	string: contains
	test: TestSuite


pure func is_socket_permission_error(err: String) -> Bool:
	err.contains("Operation not permitted") or err.contains("Permission denied")


tests: TestSuite = {
	description = "TCP Tests",
	tests = [
		(
			"Listen and close",
			func():
				match Tcp.listen("127.0.0.1", 0, 1):
					Ok(fd):
						match Tcp.local_port(fd):
							Ok(port):
								Tcp.close(fd)
								port > 0
							Err(_):
								Tcp.close(fd)
								False
					Err(e): is_socket_permission_error(e)
		)
		,
		(
			"Listen on invalid port fails",
			func():
				match Tcp.listen("127.0.0.1", -1, 1):
					Ok(fd):
						Tcp.close(fd)
						False
					Err(_): True
		)
		,
		(
			"Self-connect write and read round-trip",
			func():
				match Tcp.listen("127.0.0.1", 0, 1):
					Ok(server_fd):
						match Tcp.local_port(server_fd):
							Ok(port):
								match Tcp.connect("127.0.0.1", port):
									Ok(client_fd):
										match Tcp.accept(server_fd):
											Ok(peer_fd):
												msg: Bytes = "hello tcp".to_bytes()
												match Tcp.write(client_fd, msg):
													Ok(_):
														match Tcp.read(peer_fd, 1024):
															Ok(data):
																result: Bool = B.to_string(
																	data,
																) == "hello tcp"
																Tcp.close(peer_fd)
																Tcp.close(client_fd)
																Tcp.close(server_fd)
																result
															Err(_):
																Tcp.close(peer_fd)
																Tcp.close(client_fd)
																Tcp.close(server_fd)
																False
													Err(_):
														Tcp.close(peer_fd)
														Tcp.close(client_fd)
														Tcp.close(server_fd)
														False
											Err(_):
												Tcp.close(client_fd)
												Tcp.close(server_fd)
												False
									Err(_):
										Tcp.close(server_fd)
										False
							Err(_):
								Tcp.close(server_fd)
								False
					Err(e): is_socket_permission_error(e)
		)
		,
		(
			"Set timeout succeeds",
			func():
				match Tcp.listen("127.0.0.1", 0, 1):
					Ok(fd):
						match Tcp.set_timeout(fd, 1000):
							Ok(_):
								Tcp.close(fd)
								True
							Err(_):
								Tcp.close(fd)
								False
					Err(e): is_socket_permission_error(e)
		)
		,
		(
			"Write empty bytes succeeds",
			func():
				match Tcp.listen("127.0.0.1", 0, 1):
					Ok(server_fd):
						match Tcp.local_port(server_fd):
							Ok(port):
								match Tcp.connect("127.0.0.1", port):
									Ok(client_fd):
										match Tcp.accept(server_fd):
											Ok(peer_fd):
												empty: Bytes = B.bytes(0)
												match Tcp.write(client_fd, empty):
													Ok(n):
														Tcp.close(peer_fd)
														Tcp.close(client_fd)
														Tcp.close(server_fd)
														n == 0
													Err(_):
														Tcp.close(peer_fd)
														Tcp.close(client_fd)
														Tcp.close(server_fd)
														False
											Err(_):
												Tcp.close(client_fd)
												Tcp.close(server_fd)
												False
									Err(_):
										Tcp.close(server_fd)
										False
							Err(_):
								Tcp.close(server_fd)
								False
					Err(e): is_socket_permission_error(e)
		)
	]
}
