import:
	./ffi_support/ffi_module: ffi_module_answer
	test: TestSuite


foreign(include: "ffi_local_header.h"):
	func ffi_local_answer() -> Int


func test_local_header_include() -> Bool:
	ffi_local_answer() == 42 and ffi_module_answer() == 7


tests: TestSuite = {
	description = "FFI Local Header",
	tests = [("local header include", test_local_header_include)],
}
