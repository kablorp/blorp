import:
	process:
		ProcessExit(Exited),
		ProcessStdin(InheritStdin),
		ProcessStream(InheritStream),
		command,
		run_command,
	process_session: ProcessSessionCommandExecution(SessionCommandCompleted), run_session_command


func inherited_stdin_is_observable() -> Bool:
	stdin_request = { command(
		"sh",
		["-c", "IFS= read -r value; printf 'stdin:%s' \"$value\""],
	) | stdin = InheritStdin }

	match run_command(stdin_request):
		Err(_):
			False
		Ok(result):
			result.exit == Exited(0) and result.stdout.to_string() == "stdin:inherit-input"


func session_inherited_stdin_is_observable() -> Bool:
	stdin_request = { command(
		"sh",
		["-c", "IFS= read -r value; printf 'session-stdin:%s' \"$value\""],
	) | stdin = InheritStdin }

	match run_session_command(stdin_request):
		SessionCommandCompleted(result):
			(
				result.exit == Exited(0)
				and result.stdout.to_string() == "session-stdin:session-inherit-input"
			)
		_:
			False


func inherited_stdout_is_observable() -> Bool:
	stdout_request = { command(
		"sh",
		["-c", "printf 'inherited-stdout-marker'; printf captured-stderr >&2"],
	) | stdout = InheritStream }

	match run_command(stdout_request):
		Err(_):
			False
		Ok(result):
			(
				result.exit == Exited(0)
				and result.stdout.length() == 0
				and result.stderr.to_string() == "captured-stderr"
			)


func inherited_stderr_is_observable() -> Bool:
	stderr_request = { command(
		"sh",
		["-c", "printf captured-stdout; printf 'inherited-stderr-marker' >&2"],
	) | stderr = InheritStream }

	match run_command(stderr_request):
		Err(_):
			False
		Ok(result):
			(
				result.exit == Exited(0)
				and result.stdout.to_string() == "captured-stdout"
				and result.stderr.length() == 0
			)


func main(args: List[String]) -> Int:
	passed: Bool = match args.get(1):
		Some("blocking"):
			(
				inherited_stdin_is_observable()
				and inherited_stdout_is_observable()
				and inherited_stderr_is_observable()
			)
		Some("session"):
			session_inherited_stdin_is_observable()
		_:
			False

	if passed:
		0
	else:
		1
