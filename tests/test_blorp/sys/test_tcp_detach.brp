-- Detach remains useful with TCP resources when tasks acquire their own
-- streams. Accepted streams are scoped resources and must not be detached.
import:
	bytes as B
	net/tcp:
		IpFamily(IPv4),
		TcpError,
		accept,
		connect_loopback,
		listen_loopback_any_port,
		local_port,
		message,
		port,
		read_chunk,
		write_all,
	string: contains
	test: TestSuite


pure func is_socket_permission_error(err: TcpError) -> Bool:
	detail_msg: String = message(err)
	detail_msg.contains("Operation not permitted") or detail_msg.contains("Permission denied")


func send_one_byte(port: Int, value: Int, done: Channel[Int]) -> Bool:
	result: Int = match send_one_byte_result(port, value):
		Ok(n): n
		Err(_): -1000
	_ = send(done, result)
	result == value


func send_one_byte_result(port_num: Int, value: Int) -> Result[Int, TcpError]:
	remote ?= port(port_num)
	with stream ?= connect_loopback(IPv4, remote):
		payload: Bytes = B
			.bytes(1)
			.fill(value)
		ignored ?= write_all(stream, payload)
		Ok(value)


func recv_or_zero(done: Channel[Int]) -> Int:
	match recv(done):
		Some(value): value
		None: 0


func scoped_detached_clients() -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 4):
		port_num ?= local_port(listener)
		done: Channel[Int] = channel(2)
		detach send_one_byte(port_num, 7, done)
		detach send_one_byte(port_num, 9, done)
		with first ?= accept(listener):
			first_data ?= read_chunk(first, 1)
			with second ?= accept(listener):
				second_data ?= read_chunk(second, 1)
				total: Int = recv_or_zero(done) + recv_or_zero(done)
				Ok(first_data.length() == 1 and second_data.length() == 1 and total == 16)


func test_detached_clients_can_use_scoped_tcp() -> Bool:
	match scoped_detached_clients():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


tests: TestSuite = {
	description = "TCP Detach Resource Tests",
	tests = [
		(
			"detached clients acquire their own scoped streams",
			test_detached_clients_can_use_scoped_tcp,
		),
	]
}
