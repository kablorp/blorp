import:
	memory: format_bytes
	test: TestSuite


func test_format_bytes_small() -> Bool:
	format_bytes(100) == "100 B"


func test_format_bytes_kb() -> Bool:
	format_bytes(2048) == "2 KB"


func test_format_bytes_mb() -> Bool:
	format_bytes(5242880) == "5 MB"


func test_format_bytes_zero() -> Bool:
	format_bytes(0) == "0 B"


tests: TestSuite = {
	description = "Memory Utils",
	tests = [
		("format small", test_format_bytes_small),
		("format KB", test_format_bytes_kb),
		("format MB", test_format_bytes_mb),
		("format zero", test_format_bytes_zero),
	],
}
