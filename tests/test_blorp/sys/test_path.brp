import:
	path: basename, dirname, extension, is_absolute, join, normalize, stem
	test: TestSuite


pure func test_join_basic() -> Bool:
	"foo".join("bar") == "foo/bar"


pure func test_join_trailing_slash() -> Bool:
	"foo/".join("bar") == "foo/bar"


pure func test_join_absolute_second() -> Bool:
	"foo".join("/bar") == "/bar"


pure func test_join_empty_first() -> Bool:
	"".join("bar") == "bar"


pure func test_join_empty_second() -> Bool:
	"foo".join("") == "foo/"


pure func test_dirname_simple() -> Bool:
	dirname("/foo/bar/baz.txt") == "/foo/bar"


pure func test_dirname_root() -> Bool:
	dirname("/foo") == "/"


pure func test_dirname_no_dir() -> Bool:
	dirname("file.txt") == "."


pure func test_dirname_trailing_slash() -> Bool:
	dirname("/foo/bar/") == "/foo"


pure func test_basename_simple() -> Bool:
	basename("/foo/bar/baz.txt") == "baz.txt"


pure func test_basename_no_dir() -> Bool:
	basename("file.txt") == "file.txt"


pure func test_basename_trailing_slash() -> Bool:
	basename("/foo/bar/") == "bar"


pure func test_basename_root() -> Bool:
	basename("/") == ""


pure func test_extension_txt() -> Bool:
	extension("file.txt") == Some(".txt")


pure func test_extension_none() -> Bool:
	match extension("Makefile"):
		None: True
		Some(_): False


pure func test_extension_multiple_dots() -> Bool:
	extension("archive.tar.gz") == Some(".gz")


pure func test_extension_hidden_file() -> Bool:
	match extension(".gitignore"):
		None: True
		Some(_): False


pure func test_stem_simple() -> Bool:
	stem("file.txt") == "file"


pure func test_stem_no_ext() -> Bool:
	stem("Makefile") == "Makefile"


pure func test_stem_full_path() -> Bool:
	stem("/foo/bar/baz.tar.gz") == "baz.tar"


pure func test_is_absolute_yes() -> Bool:
	is_absolute("/foo/bar")


pure func test_is_absolute_no() -> Bool:
	not is_absolute("foo/bar")


pure func test_is_absolute_empty() -> Bool:
	not is_absolute("")


pure func test_normalize_dotdot() -> Bool:
	normalize("/foo/bar/../baz") == "/foo/baz"


pure func test_normalize_dot() -> Bool:
	normalize("/foo/./bar") == "/foo/bar"


pure func test_normalize_double_slash() -> Bool:
	normalize("/foo//bar") == "/foo/bar"


pure func test_normalize_clean() -> Bool:
	normalize("/foo/bar") == "/foo/bar"


pure func test_normalize_relative() -> Bool:
	normalize("foo/bar/../baz") == "foo/baz"


pure func test_normalize_only_dots() -> Bool:
	normalize(".") == "."


pure func test_normalize_parent_at_root() -> Bool:
	normalize("/..") == "/"


tests: TestSuite = {
	description = "Path Module",
	tests = [
		("join basic", test_join_basic),
		("join trailing slash", test_join_trailing_slash),
		("join absolute second", test_join_absolute_second),
		("join empty first", test_join_empty_first),
		("join empty second", test_join_empty_second),
		("dirname simple", test_dirname_simple),
		("dirname root", test_dirname_root),
		("dirname no dir", test_dirname_no_dir),
		("dirname trailing slash", test_dirname_trailing_slash),
		("basename simple", test_basename_simple),
		("basename no dir", test_basename_no_dir),
		("basename trailing slash", test_basename_trailing_slash),
		("basename root", test_basename_root),
		("extension .txt", test_extension_txt),
		("extension none", test_extension_none),
		("extension multiple dots", test_extension_multiple_dots),
		("extension hidden file", test_extension_hidden_file),
		("stem simple", test_stem_simple),
		("stem no ext", test_stem_no_ext),
		("stem full path", test_stem_full_path),
		("is_absolute yes", test_is_absolute_yes),
		("is_absolute no", test_is_absolute_no),
		("is_absolute empty", test_is_absolute_empty),
		("normalize dotdot", test_normalize_dotdot),
		("normalize dot", test_normalize_dot),
		("normalize double slash", test_normalize_double_slash),
		("normalize clean", test_normalize_clean),
		("normalize relative", test_normalize_relative),
		("normalize only dots", test_normalize_only_dots),
		("normalize parent at root", test_normalize_parent_at_root),
	],
}
