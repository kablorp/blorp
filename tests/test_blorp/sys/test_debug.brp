-- Test debug module functions
-- Must be run with --debug flag: ./blorp test --debug tests/test_blorp/sys/
import:
	debug as debug: LogFilter(ErrorsOnly, InfoAndAbove)
	test: TestSuite


-- Test that debug.log works (writes to stderr, not stdout)
func test_debug_log() -> Bool:
	debug:
		debug.log("hello from debug")
	True


-- Test that debug.info produces output
func test_debug_info() -> Bool:
	debug:
		debug.info("info message")
	True


-- Test that debug.warn produces output
func test_debug_warn() -> Bool:
	debug:
		debug.warn("warning message")
	True


-- Test that debug.error produces output
func test_debug_error() -> Bool:
	debug:
		debug.error("error message")
	True


-- Test that set_log_filter accepts severity thresholds
func test_set_log_filter() -> Bool:
	debug:
		debug.set_log_filter(ErrorsOnly)
		debug.error("error message")
		debug.set_log_filter(InfoAndAbove)
	True


-- Test debug functions in a pure function
pure func pure_with_debug(x: Int) -> Int:
	debug:
		debug.log("pure debug")
	x * 2


func test_debug_in_pure() -> Bool:
	pure_with_debug(21) == 42


tests: TestSuite = {
	description = "Debug Module",
	tests = [
		("debug.log works", test_debug_log),
		("debug.info works", test_debug_info),
		("debug.warn works", test_debug_warn),
		("debug.error works", test_debug_error),
		("set_log_filter works", test_set_log_filter),
		("debug in pure function", test_debug_in_pure),
	]
}
