import:
	system: getenv, setenv
	test: TestSuite


func test_getenv_exists() -> Bool:
	-- PATH should exist on all systems
	match getenv("PATH"):
		Some(_): True
		None: False


func test_getenv_missing() -> Bool:
	-- Random name unlikely to exist
	match getenv("BLORP_TEST_UNLIKELY_VAR_12345"):
		Some(_): False
		None: True


func test_setenv_and_getenv() -> Bool:
	-- Set a variable and read it back
	success: Bool = setenv("BLORP_TEST_VAR", "hello_world")
	if success:
		match getenv("BLORP_TEST_VAR"):
			Some(v): v == "hello_world"
			None: False
	else:
		False


func test_setenv_overwrite() -> Bool:
	-- Set, then overwrite
	ok1: Bool = setenv("BLORP_TEST_VAR2", "first")
	ok2: Bool = setenv("BLORP_TEST_VAR2", "second")
	if ok1 and ok2:
		match getenv("BLORP_TEST_VAR2"):
			Some(v): v == "second"
			None: False
	else:
		False


func test_empty_value() -> Bool:
	-- Set to empty string
	ok: Bool = setenv("BLORP_EMPTY_VAR", "")
	if ok:
		match getenv("BLORP_EMPTY_VAR"):
			Some(v): v == ""
			None: False
	else:
		False


tests: TestSuite = {
	description = "Environment Variables",
	tests = [
		("getenv exists", test_getenv_exists),
		("getenv missing", test_getenv_missing),
		("setenv and getenv", test_setenv_and_getenv),
		("setenv overwrite", test_setenv_overwrite),
		("empty value", test_empty_value),
	],
}
