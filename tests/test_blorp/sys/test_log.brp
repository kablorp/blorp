import:
	log as L: Logger
	string: contains, length
	test: TestSuite


-- Logger construction
func test_new_default() -> Bool:
	logger: Logger = L.logger()
	logger.level == 1 and logger.json == False and logger.context_text.length() == 0


func test_with_level() -> Bool:
	logger: Logger = L.with_level(L.logger(), 0)
	logger.level == 0


func test_with_json() -> Bool:
	logger: Logger = L.with_json(L.logger())
	logger.json == True


func test_with_fields() -> Bool:
	logger: Logger = L.with_fields(L.logger(), [("service", "api")])
	logger.context_text.contains("service=api")


func test_with_fields_append() -> Bool:
	l1: Logger = L.with_fields(L.logger(), [("service", "api")])
	l2: Logger = L.with_fields(l1, [("version", "1.0")])
	l2.context_text.contains("service=api") and l2.context_text.contains("version=1.0")


-- Level constants
func test_level_constants() -> Bool:
	L.DEBUG() == 0 and L.INFO() == 1 and L.WARN() == 2 and L.ERROR() == 3 and L.OFF() == 4


-- Text formatting
func test_format_text_simple() -> Bool:
	L.format_text("INFO", "hello", []) == "INFO  hello"


func test_format_text_with_fields() -> Bool:
	L.format_text("WARN", "slow", [("ms", "500")]) == "WARN  slow  ms=500"


func test_format_text_multi_fields() -> Bool:
	result: String = L.format_text("ERROR", "fail", [("code", "500"), ("path", "/api")])
	result == "ERROR  fail  code=500 path=/api"


-- JSON formatting
func test_format_json_simple() -> Bool:
	result: String = L.format_json("INFO", "hello", [])
	result == "{\"level\":\"INFO\",\"msg\":\"hello\"}"


func test_format_json_with_fields() -> Bool:
	result: String = L.format_json("WARN", "slow", [("ms", "500")])
	contains(
		result,
		"\"level\":\"WARN\"",
	) and result.contains("\"msg\":\"slow\"") and result.contains("\"ms\":\"500\"")


func test_format_json_escaping() -> Bool:
	result: String = L.format_json("INFO", "said \"hi\"", [])
	result.contains("said \\\"hi\\\"")


func test_format_json_escape_tabs_cr() -> Bool:
	result: String = L.format_json("INFO", "a\tb\rc", [])
	result.contains("a\\tb\\rc")


-- Actual logging (side-effect tests — just verify no crash)
func test_log_info() -> Bool:
	logger: Logger = L.logger()
	L.info(logger, "test message")
	True


func test_log_filtered() -> Bool:
	logger: Logger = L.with_level(L.logger(), 2)
	L.debug(logger, "should be filtered")
	L.info(logger, "should be filtered")
	L.warn(logger, "should appear")
	True


func test_log_json_output() -> Bool:
	logger: Logger = L.with_json(L.logger())
	L.info(logger, "json test")
	True


func test_log_with_context() -> Bool:
	logger: Logger = L.with_fields(L.logger(), [("service", "api")])
	L.info(logger, "started")
	True


func test_log_with_extra_fields() -> Bool:
	logger: Logger = L.logger()
	L.info_f(logger, "request", [("method", "GET"), ("path", "/api")])
	True


tests: TestSuite = {
	description = "Log",
	tests = [
		("new default", test_new_default),
		("with level", test_with_level),
		("with json", test_with_json),
		("with fields", test_with_fields),
		("with fields append", test_with_fields_append),
		("level constants", test_level_constants),
		("format text simple", test_format_text_simple),
		("format text with fields", test_format_text_with_fields),
		("format text multi fields", test_format_text_multi_fields),
		("format json simple", test_format_json_simple),
		("format json with fields", test_format_json_with_fields),
		("format json escaping", test_format_json_escaping),
		("format json escape tabs cr", test_format_json_escape_tabs_cr),
		("log info", test_log_info),
		("log filtered", test_log_filtered),
		("log json output", test_log_json_output),
		("log with context", test_log_with_context),
		("log with extra fields", test_log_with_extra_fields),
	],
}
