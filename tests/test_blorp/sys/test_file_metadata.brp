import:
	system:
		file_exists,
		file_modified,
		file_size,
		mkdir,
		mkstemp_path,
		remove_dir,
		remove_file,
		temp_dir,
		walk_dir,
		write_file,
	test: TestSuite


-- file_size tests
func test_file_size() -> Bool:
	match mkstemp_path("blorp_fsize_"):
		Ok(path):
			_ = write_file(path, "hello")
			r: Result[Int, String] = file_size(path)
			_ = remove_file(path)
			match r:
				Ok(n): n == 5
				Err(_): False
		Err(_): False


func test_file_size_empty() -> Bool:
	match mkstemp_path("blorp_fsize_empty_"):
		Ok(path):
			_ = write_file(path, "")
			r: Result[Int, String] = file_size(path)
			_ = remove_file(path)
			match r:
				Ok(n): n == 0
				Err(_): False
		Err(_): False


func test_file_size_missing() -> Bool:
	match mkstemp_path("blorp_missing_"):
		Ok(path):
			_ = remove_file(path)
			r: Result[Int, String] = file_size(path)
			match r:
				Ok(_): False
				Err(_): True
		Err(_): False


-- file_modified tests
func test_file_modified() -> Bool:
	match mkstemp_path("blorp_fmod_"):
		Ok(path):
			_ = write_file(path, "data")
			r: Result[Int, String] = file_modified(path)
			_ = remove_file(path)
			match r:
				Ok(t): t > 1000000000
				Err(_): False
		Err(_): False


func test_file_modified_missing() -> Bool:
	match mkstemp_path("blorp_fmod_missing_"):
		Ok(path):
			_ = remove_file(path)
			r: Result[Int, String] = file_modified(path)
			match r:
				Ok(_): False
				Err(_): True
		Err(_): False


-- temp_dir tests
func test_temp_dir() -> Bool:
	temp_dir().length() > 0


-- mkstemp tests
func test_mkstemp() -> Bool:
	r: Result[String, String] = mkstemp_path("blorp_test_")
	match r:
		Ok(path):
			exists: Bool = file_exists(path)
			_ = remove_file(path)
			exists
		Err(_): False


-- walk_dir tests
func test_walk_dir() -> Bool:
	match mkstemp_path("blorp_walk_"):
		Ok(path):
			_ = remove_file(path)
			_ = mkdir(path)
			_ = write_file(path + "/a.txt", "a")
			_ = write_file(path + "/b.txt", "b")
			files: List[String] = walk_dir(path)
			_ = remove_file(path + "/a.txt")
			_ = remove_file(path + "/b.txt")
			_ = remove_dir(path)
			files.length() == 2
		Err(_): False


func test_walk_dir_empty() -> Bool:
	match mkstemp_path("blorp_walk_empty_"):
		Ok(path):
			_ = remove_file(path)
			_ = mkdir(path)
			files: List[String] = walk_dir(path)
			_ = remove_dir(path)
			files.length() == 0
		Err(_): False


func test_walk_dir_nested() -> Bool:
	match mkstemp_path("blorp_walk_nested_"):
		Ok(path):
			_ = remove_file(path)
			_ = mkdir(path)
			_ = mkdir(path + "/sub")
			_ = write_file(path + "/top.txt", "t")
			_ = write_file(path + "/sub/deep.txt", "d")
			files: List[String] = walk_dir(path)
			_ = remove_file(path + "/top.txt")
			_ = remove_file(path + "/sub/deep.txt")
			_ = remove_dir(path + "/sub")
			_ = remove_dir(path)
			files.length() == 2
		Err(_): False


tests: TestSuite = {
	description = "File Metadata",
	tests = [
		("file size", test_file_size),
		("file size empty", test_file_size_empty),
		("file size missing", test_file_size_missing),
		("file modified", test_file_modified),
		("file modified missing", test_file_modified_missing),
		("temp dir", test_temp_dir),
		("mkstemp", test_mkstemp),
		("walk dir", test_walk_dir),
		("walk dir empty", test_walk_dir_empty),
		("walk dir nested", test_walk_dir_nested),
	],
}
