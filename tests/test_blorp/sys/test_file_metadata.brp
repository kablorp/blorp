import:
	system:
		file_exists,
		file_modified,
		file_size,
		mkdir,
		mkstemp_path,
		remove_dir,
		remove_file,
		temp_dir,
		walk_dir,
		write_file,
	test: TestSuite


-- file_size tests
func test_file_size() -> Bool:
	_ = write_file("/tmp/__blorp_test_fsize", "hello")
	r: Result[Int, String] = file_size("/tmp/__blorp_test_fsize")
	_ = remove_file("/tmp/__blorp_test_fsize")
	match r:
		Ok(n): n == 5
		Err(_): False


func test_file_size_empty() -> Bool:
	_ = write_file("/tmp/__blorp_test_fsize_e", "")
	r: Result[Int, String] = file_size("/tmp/__blorp_test_fsize_e")
	_ = remove_file("/tmp/__blorp_test_fsize_e")
	match r:
		Ok(n): n == 0
		Err(_): False


func test_file_size_missing() -> Bool:
	r: Result[Int, String] = file_size("/tmp/__blorp_nonexistent_xyz")
	match r:
		Ok(_): False
		Err(_): True


-- file_modified tests
func test_file_modified() -> Bool:
	_ = write_file("/tmp/__blorp_test_fmod", "data")
	r: Result[Int, String] = file_modified("/tmp/__blorp_test_fmod")
	_ = remove_file("/tmp/__blorp_test_fmod")
	match r:
		Ok(t): t > 1000000000
		Err(_): False


func test_file_modified_missing() -> Bool:
	r: Result[Int, String] = file_modified("/tmp/__blorp_nonexistent_xyz")
	match r:
		Ok(_): False
		Err(_): True


-- temp_dir tests
func test_temp_dir() -> Bool:
	temp_dir().length() > 0


-- mkstemp tests
func test_mkstemp() -> Bool:
	r: Result[String, String] = mkstemp_path("blorp_test_")
	match r:
		Ok(path):
			exists: Bool = file_exists(path)
			_ = remove_file(path)
			exists
		Err(_): False


-- walk_dir tests
func test_walk_dir() -> Bool:
	_ = mkdir("/tmp/__blorp_test_walk")
	_ = write_file("/tmp/__blorp_test_walk/a.txt", "a")
	_ = write_file("/tmp/__blorp_test_walk/b.txt", "b")
	files: List[String] = walk_dir("/tmp/__blorp_test_walk")
	_ = remove_file("/tmp/__blorp_test_walk/a.txt")
	_ = remove_file("/tmp/__blorp_test_walk/b.txt")
	_ = remove_dir("/tmp/__blorp_test_walk")
	files.length() == 2


func test_walk_dir_empty() -> Bool:
	_ = mkdir("/tmp/__blorp_test_walk_e")
	files: List[String] = walk_dir("/tmp/__blorp_test_walk_e")
	_ = remove_dir("/tmp/__blorp_test_walk_e")
	files.length() == 0


func test_walk_dir_nested() -> Bool:
	_ = mkdir("/tmp/__blorp_test_walk_n")
	_ = mkdir("/tmp/__blorp_test_walk_n/sub")
	_ = write_file("/tmp/__blorp_test_walk_n/top.txt", "t")
	_ = write_file("/tmp/__blorp_test_walk_n/sub/deep.txt", "d")
	files: List[String] = walk_dir("/tmp/__blorp_test_walk_n")
	_ = remove_file("/tmp/__blorp_test_walk_n/top.txt")
	_ = remove_file("/tmp/__blorp_test_walk_n/sub/deep.txt")
	_ = remove_dir("/tmp/__blorp_test_walk_n/sub")
	_ = remove_dir("/tmp/__blorp_test_walk_n")
	files.length() == 2


tests: TestSuite = {
	description = "File Metadata",
	tests = [
		("file size", test_file_size),
		("file size empty", test_file_size_empty),
		("file size missing", test_file_size_missing),
		("file modified", test_file_modified),
		("file modified missing", test_file_modified_missing),
		("temp dir", test_temp_dir),
		("mkstemp", test_mkstemp),
		("walk dir", test_walk_dir),
		("walk dir empty", test_walk_dir_empty),
		("walk dir nested", test_walk_dir_nested),
	]
}
