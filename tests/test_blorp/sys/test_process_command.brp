import:
	fs: IOError, resource_path, temporary_directory
	process:
		ProcessCaptureLimit(BoundedCapture, UnboundedCapture),
		ProcessEnvironmentChange,
		ProcessError(InvalidCommand, ProcessOutputLimitExceeded),
		ProcessExit(Exited, Signaled, TimedOut),
		ProcessGroup(InheritProcessGroup, NewProcessGroup),
		ProcessStdin(BytesStdin),
		ProcessStream(NullStream),
		command,
		run_command,
	string: remove_suffix, repeat
	system: exec, exec_output, file_exists, getenv, setenv, temp_dir
	test: TestSuite, process_spawn_fallback_probe_for_test
	units: from_bytes, milliseconds, seconds


func test_command_preserves_argument_boundaries() -> Bool:
	request = command(
		"sh",
		["-c", "printf '%s|%s|%s' \"$1\" \"$2\" \"$3\"", "sh", "two words", "", "quote\"value"],
	)

	match run_command(request):
		Ok(result):
			(
				result.exit == Exited(0)
				and result.stdout.to_string() == "two words||quote\"value"
				and result.stderr.length() == 0
			)
		Err(_):
			False


func test_command_streams_stdin_and_drains_both_outputs() -> Bool:
	input_text: String = "i".repeat(100000)
	request = { command(
		"sh",
		["-c", "cat; i=0; while [ $i -lt 100000 ]; do printf o; printf e >&2; i=$((i+1)); done"],
	) | stdin = BytesStdin(input_text.to_bytes()) }

	match run_command(request):
		Ok(result):
			(
				result.exit == Exited(0)
				and result.stdout.length() == 200000
				and result.stderr.length() == 100000
			)
		Err(_):
			False


func test_command_applies_child_only_environment_and_cwd() -> Bool:
	name: String = "BLORP_PROCESS_COMMAND_CHILD_ONLY"
	before = getenv(name)
	change: ProcessEnvironmentChange = {
		name = name,
		value = Some("child value")
	}
	request = { command(
		"sh",
		["-c", "printf '%s|%s' \"$BLORP_PROCESS_COMMAND_CHILD_ONLY\" \"$PWD\""],
	) |
		cwd = Some(temp_dir()),
		environment = [change]
	}

	match run_command(request):
		Ok(result):
			(
				getenv(name) == before
				and result.exit == Exited(0)
				and result.stdout
					.to_string()
					.starts_with("child value|")
				and result.stdout
					.to_string()
					.ends_with(temp_dir().remove_suffix("/"))
			)
		Err(_):
			False


func test_command_can_remove_child_environment_value() -> Bool:
	name: String = "BLORP_PROCESS_COMMAND_REMOVE_CHILD_ONLY"
	parent_set: Bool = setenv(name, "parent value")
	change: ProcessEnvironmentChange = {
		name = name,
		value = None
	}
	request = { command(
		"sh",
		[
			"-c",
			(
				"if printenv BLORP_PROCESS_COMMAND_REMOVE_CHILD_ONLY >/dev/null 2>&1; then exit "
				+ "1; else exit 0; fi"
			),
		],
	) | environment = [change] }

	match run_command(request):
		Ok(result):
			parent_set and result.exit == Exited(0) and getenv(name) == Some("parent value")
		Err(_):
			False


func test_command_reports_signal_exit() -> Bool:
	match (
		run_command(
			command(
				"sh",
				["-c", "kill -TERM $$"],
			),
		)
	):
		Ok(result):
			match result.exit:
				Signaled(signal):
					signal > 0
				_:
					False
		Err(_):
			False


func test_command_reports_timeout() -> Bool:
	request = { command(
		"sh",
		["-c", "trap '' TERM; while true; do sleep 1; done"],
	) |
		timeout = Some(milliseconds(100)),
		process_group = NewProcessGroup
	}

	match run_command(request):
		Ok(result):
			result.exit == TimedOut
		Err(_):
			False


func test_command_missing_program_is_structured_error() -> Bool:
	match run_command(command("__blorp_missing_process_command__", [])):
		Ok(_):
			False
		Err(error):
			error
				.to_string()
				.contains("program not found")


func test_repeated_spawn_failures_release_launch_resources() -> Bool:
	var failures_are_structured: Bool = True
	before = exec_output("ls -1 /dev/fd 2>/dev/null | wc -l")

	for _ in 0..64:
		match run_command(command("__blorp_repeated_missing_process__", [])):
			Ok(_):
				failures_are_structured = False
			Err(_):
				void

	after = exec_output("ls -1 /dev/fd 2>/dev/null | wc -l")

	match (
		run_command(
			command(
				"sh",
				["-c", "exit 0"],
			),
		)
	):
		Ok(result):
			failures_are_structured and result.exit == Exited(0) and before == after
		Err(_):
			False


func test_forced_fallback_spawn_owns_every_descriptor_and_child() -> Bool:
	process_spawn_fallback_probe_for_test()


func test_concurrent_process_launches_complete_independently() -> Bool:
	var launches_succeeded: Bool = True

	for _ in 0..16:
		concurrent:
			first = run_command(
				command(
					"sh",
					["-c", "printf first"],
				),
			)
			second = run_command(
				command(
					"sh",
					["-c", "printf second"],
				),
			)

		match first:
			Ok(Ok(result)):
				if result.exit != Exited(0) or result.stdout.to_string() != "first":
					launches_succeeded = False
			_:
				launches_succeeded = False

		match second:
			Ok(Ok(result)):
				if result.exit != Exited(0) or result.stdout.to_string() != "second":
					launches_succeeded = False
			_:
				launches_succeeded = False

	launches_succeeded


func create_marker_after_exec_starts(started: String, marker: String) -> Result[Bool, ProcessError]:
	var spins: Int = 0

	while not file_exists(started) and spins < 100000:
		spins += 1
		yield_now()

	if not file_exists(started):
		Ok(False)
	else:
		result ?= run_command(
			command(
				"sh",
				["-c", "printf ready > \"$1\"", "sh", marker],
			),
		)
		Ok(result.exit == Exited(0))


func exercise_exec_releases_spawn_lock() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_exec_spawn_lock_"):
		started: String = directory.resource_path() + "/started"
		marker: String = directory.resource_path() + "/marker"
		shell_command: String = "printf started > '" + started + "'; " + "i=0; while [ ! -f '" + marker + "' ] && [ $i -lt 100 ]; do " + "sleep 0.01; i=$((i+1)); done; [ -f '" + marker + "' ]"

		concurrent:
			exec_status = exec(shell_command)
			marker_result = create_marker_after_exec_starts(started, marker)

		exec_succeeded: Bool = match exec_status:
			Ok(status):
				status == 0
			Err(_):
				False

		marker_created: Bool = match marker_result:
			Ok(Ok(created)):
				created
			_:
				False

		Ok(exec_succeeded and marker_created and file_exists(marker))


func test_exec_releases_spawn_lock_after_launch() -> Bool:
	match exercise_exec_releases_spawn_lock():
		Ok(result):
			result
		Err(_):
			False


func test_command_rejects_duplicate_environment_changes() -> Bool:
	first: ProcessEnvironmentChange = {
		name = "BLORP_DUPLICATE_ENVIRONMENT",
		value = Some("first")
	}
	second: ProcessEnvironmentChange = {
		name = "BLORP_DUPLICATE_ENVIRONMENT",
		value = None
	}
	request = { command(
		"sh",
		["-c", "exit 99"],
	) | environment = [first, second] }

	match run_command(request):
		Ok(_):
			False
		Err(InvalidCommand(detail)):
			detail.contains("duplicate environment change")
		Err(_):
			False


func test_command_null_streams_are_not_captured() -> Bool:
	request = { command(
		"sh",
		["-c", "printf ignored; printf ignored >&2"],
	) |
		stdout = NullStream,
		stderr = NullStream
	}

	match run_command(request):
		Ok(result):
			result.exit == Exited(0) and result.stdout.length() == 0 and result.stderr.length() == 0
		Err(_):
			False


func test_command_enforces_its_capture_limit() -> Bool:
	request = { command(
		"sh",
		["-c", "printf 12345"],
	) | capture_limit = BoundedCapture(from_bytes(4)) }

	match run_command(request):
		Err(ProcessOutputLimitExceeded(_)):
			True
		_:
			False


func test_command_supports_explicit_unbounded_capture() -> Bool:
	_ = setenv("BLORP_PROCESS_MAX_OUTPUT_BYTES", "4")
	request = { command(
		"sh",
		["-c", "printf 12345"],
	) | capture_limit = UnboundedCapture }

	result: Bool = match run_command(request):
		Ok(completed):
			completed.exit == Exited(0) and completed.stdout.to_string() == "12345"
		_:
			False

	_ = setenv("BLORP_PROCESS_MAX_OUTPUT_BYTES", "16777216")
	result


func test_command_rejects_a_negative_capture_limit() -> Bool:
	request = { command(
		"sh",
		["-c", "exit 99"],
	) | capture_limit = BoundedCapture(from_bytes(-1)) }

	match run_command(request):
		Err(InvalidCommand(detail)):
			detail.contains("capture limit")
		_:
			False


func exercise_timeout_kills_descendants() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_process_group_"):
		marker: String = directory.resource_path() + "/descendant-survived"
		request = { command(
			"sh",
			["-c", "(sleep 0.5; printf survived > \"$1\"; printf done) & exit 0", "sh", marker],
		) | timeout = Some(milliseconds(100)) }

		match run_command(request):
			Err(_):
				Ok(False)
			Ok(result):
				_ = run_command(
					command(
						"sh",
						["-c", "sleep 0.8"],
					),
				)
				timed_out: Bool = result.exit == TimedOut
				marker_exists: Bool = file_exists(marker)
				Ok(timed_out and not marker_exists)


func test_command_timeout_kills_descendants() -> Bool:
	match exercise_timeout_kills_descendants():
		Ok(result):
			result
		Err(_):
			False


func test_command_timeout_preserves_captured_output() -> Bool:
	request = { command(
		"sh",
		["-c", "trap 'printf terminated; exit 0' TERM; while :; do sleep 1; done"],
	) | timeout = Some(seconds(2)) }

	match run_command(request):
		Ok(result):
			result.exit == TimedOut and result.stdout.to_string() == "terminated"
		Err(_):
			False


func exercise_inherited_group_timeout_closes_descendant_pipe() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_inherited_process_group_"):
		started: String = directory.resource_path() + "/descendant-started"
		marker: String = directory.resource_path() + "/descendant-finished"
		request = { command(
			"sh",
			[
				"-c",
				"printf started > \"$1\"; (sleep 4; printf finished > \"$2\") & exit 0",
				"sh",
				started,
				marker,
			],
		) |
			timeout = Some(seconds(2)),
			process_group = InheritProcessGroup
		}

		match run_command(request):
			Err(_):
				Ok(False)
			Ok(result):
				descendant_started: Bool = file_exists(started)
				returned_before_descendant: Bool = not file_exists(marker)

				match (
					run_command(
						command(
							"sh",
							["-c", "sleep 2.1"],
						),
					)
				):
					Err(_):
						Ok(False)
					Ok(wait_result):
						Ok(
							(
								result.exit == TimedOut
								and descendant_started
								and returned_before_descendant
								and wait_result.exit == Exited(0)
								and file_exists(marker)
							),
						)


func test_inherited_group_timeout_closes_descendant_pipe() -> Bool:
	match exercise_inherited_group_timeout_closes_descendant_pipe():
		Ok(result):
			result
		Err(_):
			False


tests: TestSuite = {
	description = "Structured process commands",
	tests = [
		("preserves argument boundaries", test_command_preserves_argument_boundaries),
		(
			"streams stdin and drains both outputs",
			test_command_streams_stdin_and_drains_both_outputs,
		),
		(
			"applies child-only environment and cwd",
			test_command_applies_child_only_environment_and_cwd,
		),
		("can remove a child environment value", test_command_can_remove_child_environment_value),
		("reports signal exit", test_command_reports_signal_exit),
		("reports timeout", test_command_reports_timeout),
		("missing program is a structured error", test_command_missing_program_is_structured_error),
		(
			"repeated spawn failures release launch resources",
			test_repeated_spawn_failures_release_launch_resources,
		),
		(
			"forced fallback owns every descriptor and child",
			test_forced_fallback_spawn_owns_every_descriptor_and_child,
		),
		(
			"concurrent process launches complete independently",
			test_concurrent_process_launches_complete_independently,
		),
		("exec releases spawn lock after launch", test_exec_releases_spawn_lock_after_launch),
		(
			"rejects duplicate environment changes",
			test_command_rejects_duplicate_environment_changes,
		),
		("null streams are not captured", test_command_null_streams_are_not_captured),
		("enforces its capture limit", test_command_enforces_its_capture_limit),
		("supports explicit unbounded capture", test_command_supports_explicit_unbounded_capture),
		("rejects a negative capture limit", test_command_rejects_a_negative_capture_limit),
		(
			"timeout kills descendants after the leader exits",
			test_command_timeout_kills_descendants,
		),
		("timeout preserves captured output", test_command_timeout_preserves_captured_output),
		(
			"inherited group timeout closes a descendant-held pipe",
			test_inherited_group_timeout_closes_descendant_pipe,
		),
	]
}
