import:
	net/dns as DNS: DnsError(InvalidHost, LookupFailed)
	string: contains, starts_with
	test: TestSuite


func test_dns_message_formats_errors() -> Bool:
	DNS.message(
		InvalidHost(
			"empty",
		),
	) == "invalid host: empty" and DNS.message(
		LookupFailed("missing host"),
	) == "lookup failed: missing host"


func test_dns_resolve_localhost_returns_addresses() -> Bool:
	match DNS.resolve("localhost"):
		Ok(addresses): addresses.length() > 0
		Err(_): False


func test_dns_empty_host_is_invalid() -> Bool:
	match DNS.resolve(""):
		Ok(_): False
		Err(err):
			DNS
				.message(err)
				.starts_with("invalid host: ") and DNS
				.message(err)
				.contains("hostname must not be empty")


func test_dns_raw_space_is_invalid() -> Bool:
	match DNS.resolve("bad host"):
		Ok(_): False
		Err(err): DNS
			.message(err)
			.contains("hostname contains invalid character")


tests: TestSuite = {
	description = "DNS Tests",
	tests = [
		("DNS message formats errors", test_dns_message_formats_errors),
		("DNS resolve localhost returns addresses", test_dns_resolve_localhost_returns_addresses),
		("DNS empty host is invalid", test_dns_empty_host_is_invalid),
		("DNS raw space is invalid", test_dns_raw_space_is_invalid),
	]
}
