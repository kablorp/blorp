import:
	std/option: Option(Some, None)
	std/rate_limit:
		FixedWindow,
		TokenBucket,
		acquire,
		acquire_n,
		acquire_window,
		fixed_window,
		remaining,
		reset,
		reset_window,
		token_bucket,
		wait_time,
		window_remaining,
		window_resets_in,
	std/test: TestSuite


-- ============================================================================
-- Token Bucket Tests
-- ============================================================================
func test_creation() -> Bool:
	b: TokenBucket = token_bucket(10.0, 10)
	b.max_tokens == 10.0 and b.tokens == 10.0


func test_acquire_success() -> Bool:
	b: TokenBucket = token_bucket(10.0, 10)
	match acquire(b, 1000000):
		Some(b2): b2.tokens == 9.0
		None: False


func test_acquire_drains() -> Bool:
	-- 3-burst bucket: drain all 3, 4th should fail
	var b: TokenBucket = token_bucket(10.0, 3)
	match acquire(b, 100):
		Some(b2):
			b = b2
			match acquire(b, 100):
				Some(b3):
					b = b3
					match acquire(b, 100):
						Some(b4):
							-- 4th acquire should fail (no time for refill)
							match acquire(b4, 100):
								Some(_): False
								None: True
						None: False
				None: False
		None: False


func test_refill() -> Bool:
	-- Drain a 10-token bucket, then wait 1 second for refill
	var b: TokenBucket = token_bucket(10.0, 10)
	-- Drain all tokens at t=0
	var i: Int = 0
	while i < 10:
		match acquire(b, 0):
			Some(b2): b = b2
			None: void
		i += 1
	-- After 1 second at 10 tokens/s, should have exactly 10 tokens (clamped at max)
	remaining(b, 1000000) == 10


func test_burst() -> Bool:
	b: TokenBucket = token_bucket(100.0, 5)
	b.tokens == 5.0 and b.max_tokens == 5.0


func test_acquire_n() -> Bool:
	b: TokenBucket = token_bucket(10.0, 10)
	match acquire_n(b, 7, 1000000):
		Some(b2): b2.tokens == 3.0
		None: False


func test_acquire_n_fail() -> Bool:
	b: TokenBucket = token_bucket(10.0, 3)
	match acquire_n(b, 5, 1000000):
		Some(_): False
		None: True


func test_remaining() -> Bool:
	b: TokenBucket = token_bucket(10.0, 10)
	remaining(b, 0) == 10


func test_wait_available() -> Bool:
	b: TokenBucket = token_bucket(10.0, 10)
	wait_time(b, 5, 0) == 0


func test_wait_needs_refill() -> Bool:
	-- Drain bucket, then check wait time
	var b: TokenBucket = token_bucket(10.0, 1)
	match acquire(b, 0):
		Some(b2):
			-- Now empty. Wait for 1 token at 10/s = 100000 us
			wait_time(b2, 1, 0) > 0
		None: False


func test_reset_bucket() -> Bool:
	var b: TokenBucket = token_bucket(10.0, 10)
	match acquire_n(b, 8, 0):
		Some(b2):
			r: TokenBucket = reset(b2)
			r.tokens == 10.0
		None: False


-- ============================================================================
-- Token Bucket Edge Cases
-- ============================================================================
func test_negative_rate_clamped() -> Bool:
	-- Negative rate should be clamped to 0 (no refill, not token drain)
	b: TokenBucket = token_bucket(-5.0, 3)
	b.refill_rate == 0.0 and b.tokens == 3.0


func test_zero_burst_deny_all() -> Bool:
	-- Zero burst means no tokens ever available
	b: TokenBucket = token_bucket(10.0, 0)
	match acquire(b, 1000000):
		Some(_): False
		None: True


func test_negative_burst_clamped() -> Bool:
	-- Negative burst clamped to 0
	b: TokenBucket = token_bucket(10.0, -5)
	b.tokens == 0.0 and b.max_tokens == 0.0


func test_acquire_n_zero() -> Bool:
	-- Acquiring 0 tokens always succeeds, leaves tokens unchanged
	b: TokenBucket = token_bucket(10.0, 10)
	match acquire_n(b, 0, 0):
		Some(b2): b2.tokens == 10.0
		None: False


func test_clock_skew() -> Bool:
	-- Passing a smaller now_us than last_refill should not break
	b: TokenBucket = token_bucket(10.0, 10)
	match acquire(b, 1000000):
		Some(b2):
			-- Clock goes backward
			match acquire(b2, 500000):
				Some(b3): b3.tokens == 8.0
				None: False
		None: False


func test_wait_zero_rate() -> Bool:
	-- Zero-rate bucket: wait_time returns large sentinel
	b: TokenBucket = token_bucket(0.0, 1)
	match acquire(b, 0):
		Some(b2):
			-- No refill possible, should return large value
			wait_time(b2, 1, 100) > 1000000000
		None: False


func test_acquire_n_negative_clamped() -> Bool:
	-- Negative n should be clamped to 0 (no-op, not adding tokens)
	b: TokenBucket = token_bucket(10.0, 10)
	match acquire_n(b, -3, 0):
		Some(b2): b2.tokens == 10.0
		None: False


func test_acquire_n_exact_boundary() -> Bool:
	-- Acquire exactly all available tokens
	b: TokenBucket = token_bucket(10.0, 5)
	match acquire_n(b, 5, 0):
		Some(b2): b2.tokens == 0.0
		None: False


-- ============================================================================
-- Fixed Window Tests
-- ============================================================================
func test_window_creation() -> Bool:
	w: FixedWindow = fixed_window(100, 60)
	w.max_requests == 100 and w.window_us == 60000000


func test_window_acquire() -> Bool:
	w: FixedWindow = fixed_window(10, 1)
	match acquire_window(w, 100):
		Some(w2): w2.current_count == 1
		None: False


func test_window_drains() -> Bool:
	-- 2-request window: fill it, 3rd should fail
	var w: FixedWindow = fixed_window(2, 1)
	match acquire_window(w, 100):
		Some(w2):
			match acquire_window(w2, 200):
				Some(w3):
					match acquire_window(w3, 300):
						Some(_): False
						None: True
				None: False
		None: False


func test_window_resets() -> Bool:
	-- 1-request/1-second window: fill it, advance past window, should work
	var w: FixedWindow = fixed_window(1, 1)
	match acquire_window(w, 100):
		Some(w2):
			-- At limit within window
			match acquire_window(w2, 200):
				None:
					-- Advance past window (1.5 seconds)
					match acquire_window(w2, 1500000):
						Some(w3): w3.current_count == 1
						None: False
				Some(_): False
		None: False


func test_window_remaining() -> Bool:
	var w: FixedWindow = fixed_window(10, 1)
	match acquire_window(w, 100):
		Some(w2):
			match acquire_window(w2, 200):
				Some(w3): window_remaining(w3) == 8
				None: False
		None: False


func test_reset_window() -> Bool:
	var w: FixedWindow = fixed_window(10, 1)
	match acquire_window(w, 100):
		Some(w2):
			r: FixedWindow = reset_window(w2)
			r.current_count == 0
		None: False


-- ============================================================================
-- Fixed Window Edge Cases
-- ============================================================================
func test_window_resets_in() -> Bool:
	-- Create a window, acquire at t=0, then check countdown
	var w: FixedWindow = fixed_window(10, 1)
	match acquire_window(w, 0):
		Some(w2):
			-- Window started at 0, size=1000000us
			-- At t=300000, time remaining = 700000
			window_resets_in(w2, 300000) == 700000
		None: False


func test_window_resets_in_past() -> Bool:
	-- Time past window end returns 0
	var w: FixedWindow = fixed_window(10, 1)
	match acquire_window(w, 0):
		Some(w2):
			-- At t=2000000, well past the 1s window
			window_resets_in(w2, 2000000) == 0
		None: False


func test_zero_window_seconds_clamped() -> Bool:
	-- Zero window_seconds clamped to 1
	w: FixedWindow = fixed_window(10, 0)
	w.window_us == 1000000


func test_negative_max_requests_clamped() -> Bool:
	-- Negative max_requests clamped to 0 (deny all)
	w: FixedWindow = fixed_window(-5, 1)
	-- Even first acquire should fail (max_requests=0 denies everything)
	match acquire_window(w, 1000001):
		Some(_): False
		None: True


func test_window_multiple_resets() -> Bool:
	-- Drain, advance past window, drain again, advance again
	var w: FixedWindow = fixed_window(1, 1)
	-- First window
	match acquire_window(w, 100):
		Some(w2):
			-- Advance to second window
			match acquire_window(w2, 1200000):
				Some(w3):
					-- Advance to third window
					match acquire_window(w3, 2400000):
						Some(w4): w4.current_count == 1
						None: False
				None: False
		None: False


tests: TestSuite = {
	description = "Rate Limiting",
	tests = [
		("bucket creation", test_creation),
		("acquire success", test_acquire_success),
		("acquire drains", test_acquire_drains),
		("refill", test_refill),
		("burst", test_burst),
		("acquire_n", test_acquire_n),
		("acquire_n fail", test_acquire_n_fail),
		("remaining", test_remaining),
		("wait available", test_wait_available),
		("wait needs refill", test_wait_needs_refill),
		("reset bucket", test_reset_bucket),
		("negative rate clamped", test_negative_rate_clamped),
		("zero burst deny all", test_zero_burst_deny_all),
		("negative burst clamped", test_negative_burst_clamped),
		("acquire_n zero", test_acquire_n_zero),
		("acquire_n negative clamped", test_acquire_n_negative_clamped),
		("clock skew", test_clock_skew),
		("wait zero rate", test_wait_zero_rate),
		("acquire_n exact boundary", test_acquire_n_exact_boundary),
		("window creation", test_window_creation),
		("window acquire", test_window_acquire),
		("window drains", test_window_drains),
		("window resets", test_window_resets),
		("window remaining", test_window_remaining),
		("reset window", test_reset_window),
		("window resets in", test_window_resets_in),
		("window resets in past", test_window_resets_in_past),
		("zero window seconds clamped", test_zero_window_seconds_clamped),
		("negative max requests clamped", test_negative_max_requests_clamped),
		("window multiple resets", test_window_multiple_resets),
	],
}
