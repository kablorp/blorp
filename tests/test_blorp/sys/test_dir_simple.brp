-- Simple test of directory functions
import:
	system: is_directory, list_dir
	test: TestSuite


func test_is_directory() -> Bool:
	is_directory("tests")


func test_list_dir_not_empty() -> Bool:
	files: List[String] = list_dir("tests")
	count: Int = files.length()
	count > 0


func test_file_not_directory() -> Bool:
	is_dir: Bool = is_directory("tests/test_blorp/sys/test_dir_simple.brp")
	is_dir == False


tests: TestSuite = {
	description = "Directory Functions",
	tests = [
		("tests/ is a directory", test_is_directory),
		("list_dir returns entries", test_list_dir_not_empty),
		("file is not a directory", test_file_not_directory),
	],
}
