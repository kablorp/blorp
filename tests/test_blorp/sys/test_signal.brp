import:
	process: raise_signal, sig_hup, sig_int, sig_term, sig_usr1, sig_usr2, signal_received
	test: TestSuite
	time: sleep


-- Signal constants
func test_sig_hup() -> Bool:
	sig_hup() == 1


func test_sig_int() -> Bool:
	sig_int() == 2


func test_sig_term() -> Bool:
	sig_term() == 15


func test_sig_usr1() -> Bool:
	sig_usr1() == 10


func test_sig_usr2() -> Bool:
	sig_usr2() == 12


-- signal_received is false initially
func test_received_false() -> Bool:
	not signal_received(sig_usr1())


-- Raise SIGUSR1 and check flag
func test_raise_and_check() -> Bool:
	raise_signal(sig_usr1())
	sleep(10)
	signal_received(sig_usr1())


-- Flag clears after check
func test_flag_clears() -> Bool:
	raise_signal(sig_usr2())
	sleep(10)
	_ = signal_received(sig_usr2())
	not signal_received(sig_usr2())


-- Multiple raises only need one check
func test_multiple_raises() -> Bool:
	raise_signal(sig_usr2())
	raise_signal(sig_usr2())
	sleep(10)
	signal_received(sig_usr2())


tests: TestSuite = {
	description = "Signal",
	tests = [
		("sig_hup constant", test_sig_hup),
		("sig_int constant", test_sig_int),
		("sig_term constant", test_sig_term),
		("sig_usr1 constant", test_sig_usr1),
		("sig_usr2 constant", test_sig_usr2),
		("received false initially", test_received_false),
		("raise and check", test_raise_and_check),
		("flag clears after check", test_flag_clears),
		("multiple raises", test_multiple_raises),
	]
}
