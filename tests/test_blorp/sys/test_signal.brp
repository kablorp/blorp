import:
	process: Signal(Hangup, Interrupt, Terminate, User1, User2), raise_signal, signal_received
	test: TestSuite
	time: sleep


-- Signal values
func test_signal_values() -> Bool:
	Hangup != Interrupt and Interrupt != Terminate and User1 != User2


-- signal_received is false initially
func test_received_false() -> Bool:
	not signal_received(User1)


-- Raise SIGUSR1 and check flag
func test_raise_and_check() -> Bool:
	raise_signal(User1)
	sleep(10)
	signal_received(User1)


-- Flag clears after check
func test_flag_clears() -> Bool:
	raise_signal(User2)
	sleep(10)
	_ = signal_received(User2)
	not signal_received(User2)


-- Multiple raises only need one check
func test_multiple_raises() -> Bool:
	raise_signal(User2)
	raise_signal(User2)
	sleep(10)
	signal_received(User2)


tests: TestSuite = {
	description = "Signal",
	tests = [
		("signal values", test_signal_values),
		("received false initially", test_received_false),
		("raise and check", test_raise_and_check),
		("flag clears after check", test_flag_clears),
		("multiple raises", test_multiple_raises),
	]
}
