import:
	bytes as B
	file:
		IOError(InvalidInput, NotFound),
		bytes,
		chunks,
		chunks_with_size,
		count_lines,
		count_lines_rw,
		lines,
		open_append,
		open_read,
		open_read_write,
		open_write,
		read_bytes,
		read_chunk,
		read_chunk_rw,
		read_text,
		read_text_rw,
		windows,
		write_bytes,
		write_bytes_rw,
		write_chunk,
		write_chunk_rw,
		write_text,
		write_text_rw,
	list: get
	stream: all_result, any_result, collect_result, count_result, find_result, fold_result
	system: append_file, file_exists, file_size, list_dir, remove_file, write_file
	test: TestSuite


func open_existing(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		Ok(1)


func fail_int(path: String) -> Result[Int, IOError]:
	Err(NotFound(path))


func open_then_short_circuit(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		value ?= fail_int(path)
		Ok(value)


func break_inside_resource_body(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		var total: Int = 0
		for n in [1, 2, 3]:
			total += n
			if n == 1:
				break
		Ok(total)


func continue_inside_resource_body(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		var total: Int = 0
		for n in [1, 2, 3]:
			if n == 2:
				continue
			total += n
		Ok(total)


func open_writer(path: String) -> Result[Int, IOError]:
	with writer ?= open_write(path):
		Ok(1)


func open_appender(path: String) -> Result[Int, IOError]:
	with writer ?= open_append(path):
		Ok(1)


func open_read_writer(path: String) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		Ok(1)


func read_text_with_rw_handle(path: String) -> Result[String, IOError]:
	with file ?= open_read_write(path):
		file.read_text_rw()


func overwrite_prefix_then_read_tail(path: String, prefix: String) -> Result[String, IOError]:
	with file ?= open_read_write(path):
		ignored ?= file.write_text_rw(prefix)
		file.read_text_rw()


func write_bytes_with_rw_handle(path: String, data: Bytes) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		match file.write_bytes_rw(data):
			Ok(_): Ok(1)
			Err(err): Err(err)


func write_chunk_with_rw_handle(path: String, data: Bytes) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		file.write_chunk_rw(data)


func read_chunk_with_rw_handle(path: String, size: Int) -> Result[Bytes, IOError]:
	with file ?= open_read_write(path):
		file.read_chunk_rw(size)


func count_lines_with_rw_handle(path: String) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		file.count_lines_rw()


func write_text_with_handle(path: String, text: String) -> Result[Int, IOError]:
	with writer ?= open_write(path):
		match writer.write_text(text):
			Ok(_): Ok(1)
			Err(err): Err(err)


func read_text_with_handle(path: String) -> Result[String, IOError]:
	with reader ?= open_read(path):
		reader.read_text()


func write_bytes_with_handle(path: String, data: Bytes) -> Result[Int, IOError]:
	with writer ?= open_write(path):
		match writer.write_bytes(data):
			Ok(_): Ok(1)
			Err(err): Err(err)


func write_chunk_with_handle(path: String, data: Bytes) -> Result[Int, IOError]:
	with writer ?= open_write(path):
		writer.write_chunk(data)


func read_bytes_with_handle(path: String) -> Result[Bytes, IOError]:
	with reader ?= open_read(path):
		reader.read_bytes()


func read_two_chunks(path: String) -> Result[String, IOError]:
	with reader ?= open_read(path):
		first ?= reader.read_chunk(5)
		second ?= reader.read_chunk(20)
		Ok(B.to_string(first) + "|" + B.to_string(second))


func read_past_eof(path: String) -> Result[String, IOError]:
	with reader ?= open_read(path):
		first ?= reader.read_chunk(5)
		second ?= reader.read_chunk(5)
		Ok(B.to_string(first) + "|" + B.to_string(second))


func read_invalid_chunk_size(path: String) -> Result[Bytes, IOError]:
	with reader ?= open_read(path):
		reader.read_chunk(0)


func collect_chunks_with_handle(path: String) -> Result[List[Bytes], IOError]:
	with reader ?= open_read(path):
		reader
			.chunks()
			.collect_result()


func collect_chunks_via_local(path: String) -> Result[List[Bytes], IOError]:
	with reader ?= open_read(path):
		stream = reader.chunks()
		stream.collect_result()


func collect_chunks_with_explicit_size(
	path: String,
	chunk_size: Int,
) -> Result[List[Bytes], IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.collect_result()


func count_chunks_with_explicit_size(path: String, chunk_size: Int) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.count_result()


func any_chunk_matches(path: String, chunk_size: Int, text: String) -> Result[Bool, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.any_result(func(chunk: Bytes): B.to_string(chunk) == text)


func all_chunks_non_empty(path: String, chunk_size: Int) -> Result[Bool, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.all_result(func(chunk: Bytes): chunk.length() > 0)


func total_chunk_bytes(path: String, chunk_size: Int) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.fold_result(0, func(total: Int, chunk: Bytes): total + chunk.length())


func concat_chunk_bytes(path: String, chunk_size: Int) -> Result[Bytes, IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.fold_result(B.bytes(0), func(total: Bytes, chunk: Bytes): total.append(chunk))


func find_chunk_bytes(
	path: String,
	chunk_size: Int,
	text: String,
) -> Result[Option[Bytes], IOError]:
	with reader ?= open_read(path):
		reader
			.chunks_with_size(chunk_size)
			.find_result(func(chunk: Bytes): B.to_string(chunk) == text)


func collect_file_lines(path: String) -> Result[List[String], IOError]:
	with reader ?= open_read(path):
		reader
			.lines()
			.collect_result()


func find_line(path: String, text: String) -> Result[Option[String], IOError]:
	with reader ?= open_read(path):
		reader
			.lines()
			.find_result(func(line: String): line == text)


func count_file_lines(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		reader.count_lines()


func collect_file_bytes(path: String) -> Result[List[UInt8], IOError]:
	with reader ?= open_read(path):
		reader
			.bytes()
			.collect_result()


func collect_file_windows(path: String, size: Int) -> Result[List[Bytes], IOError]:
	with reader ?= open_read(path):
		reader
			.windows(size)
			.collect_result()


func open_read_then_sleep(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		sleep(10000)
		Ok(1)


func run_cancelled_open_read(path: String) -> Bool:
	concurrent(timeout: 5):
		opened = open_read_then_sleep(path)
	match opened:
		Ok(_): False
		Err(_): True


func open_fd_count() -> Int:
	dev_fds: List[String] = list_dir("/dev/fd")
	if dev_fds.length() > 0:
		dev_fds.length()
	else:
		proc_fds: List[String] = list_dir("/proc/self/fd")
		proc_fds.length()


func size_is(path: String, expected: Int) -> Bool:
	match file_size(path):
		Ok(n): n == expected
		Err(_): False


func test_open_read_missing_not_found() -> Bool:
	path: String = "/tmp/__blorp_file_resource_missing"
	_ = remove_file(path)
	match open_existing(path):
		Err(NotFound(p)): p == path
		_: False


func test_open_read_existing_closes() -> Bool:
	path: String = "/tmp/__blorp_file_resource_existing"
	_ = write_file(path, "hello")
	ok: Bool = match open_existing(path):
		Ok(n): n == 1
		Err(_): False
	_ = remove_file(path)
	ok


func test_normal_with_cleans_up_file_handles() -> Bool:
	path: String = "/tmp/__blorp_file_resource_normal_cleanup"
	_ = write_file(path, "hello")
	before: Int = open_fd_count()
	var ok: Bool = True
	var i: Int = 0
	while i < 20 and ok:
		reader_ok: Bool = match open_existing(path):
			Ok(n): n == 1
			Err(_): False
		writer_ok: Bool = match open_writer(path):
			Ok(n): n == 1
			Err(_): False
		_ = write_file(path, "hello")
		read_write_ok: Bool = match open_read_writer(path):
			Ok(n): n == 1
			Err(_): False
		ok = reader_ok and writer_ok and read_write_ok
		i += 1
	after: Int = open_fd_count()
	_ = remove_file(path)
	if before == 0 or after == 0:
		ok
	else:
		ok and after <= before + 3


func test_open_write_creates_and_truncates() -> Bool:
	path: String = "/tmp/__blorp_file_resource_write"
	_ = write_file(path, "existing")
	opened: Bool = match open_writer(path):
		Ok(n): n == 1
		Err(_): False
	ok: Bool = opened and file_exists(path) and size_is(path, 0)
	_ = remove_file(path)
	ok


func test_open_append_creates_and_preserves() -> Bool:
	missing: String = "/tmp/__blorp_file_resource_append_missing"
	existing: String = "/tmp/__blorp_file_resource_append_existing"
	_ = remove_file(missing)
	_ = write_file(existing, "data")
	created: Bool = match open_appender(missing):
		Ok(n): n == 1
		Err(_): False
	preserved: Bool = match open_appender(existing):
		Ok(n): n == 1
		Err(_): False
	ok: Bool = created and file_exists(
		missing,
	) and size_is(missing, 0) and preserved and size_is(existing, 4)
	_ = remove_file(missing)
	_ = remove_file(existing)
	ok


func test_open_read_write_existing_only() -> Bool:
	existing: String = "/tmp/__blorp_file_resource_rw_existing"
	missing: String = "/tmp/__blorp_file_resource_rw_missing"
	_ = write_file(existing, "data")
	_ = remove_file(missing)
	opened: Bool = match open_read_writer(existing):
		Ok(n): n == 1
		Err(_): False
	missing_err: Bool = match open_read_writer(missing):
		Err(NotFound(p)): p == missing
		_: False
	ok: Bool = opened and size_is(existing, 4) and missing_err
	_ = remove_file(existing)
	ok


func test_read_write_handle_reads_text() -> Bool:
	path: String = "/tmp/__blorp_file_resource_rw_read_text"
	_ = write_file(path, "read-write text")
	ok: Bool = match read_text_with_rw_handle(path):
		Ok(text): text == "read-write text"
		Err(_): False
	_ = remove_file(path)
	ok


func test_read_write_handle_writes_text_at_current_offset() -> Bool:
	path: String = "/tmp/__blorp_file_resource_rw_write_text"
	_ = write_file(path, "abcdef")
	tail_ok: Bool = match overwrite_prefix_then_read_tail(path, "XY"):
		Ok(tail): tail == "cdef"
		Err(_): False
	file_ok: Bool = match read_text_with_handle(path):
		Ok(text): text == "XYcdef"
		Err(_): False
	_ = remove_file(path)
	tail_ok and file_ok


func test_read_write_handle_bytes_and_chunk() -> Bool:
	bytes_path: String = "/tmp/__blorp_file_resource_rw_bytes"
	chunk_path: String = "/tmp/__blorp_file_resource_rw_chunk"
	_ = write_file(bytes_path, "abcdef")
	_ = write_file(chunk_path, "abcdef")
	bytes_written: Bool = match write_bytes_with_rw_handle(bytes_path, "12".to_bytes()):
		Ok(n): n == 1
		Err(_): False
	bytes_read: Bool = match read_text_with_handle(bytes_path):
		Ok(text): text == "12cdef"
		Err(_): False
	chunk_written: Bool = match write_chunk_with_rw_handle(chunk_path, "XYZ".to_bytes()):
		Ok(n): n == 3
		Err(_): False
	chunk_read: Bool = match read_text_with_handle(chunk_path):
		Ok(text): text == "XYZdef"
		Err(_): False
	_ = remove_file(bytes_path)
	_ = remove_file(chunk_path)
	bytes_written and bytes_read and chunk_written and chunk_read


func test_read_write_handle_read_chunk_and_count_lines() -> Bool:
	path: String = "/tmp/__blorp_file_resource_rw_read_chunk"
	_ = write_file(path, "one\ntwo\nthree")
	chunk_ok: Bool = match read_chunk_with_rw_handle(path, 3):
		Ok(data): B.to_string(data) == "one"
		Err(_): False
	count_ok: Bool = match count_lines_with_rw_handle(path):
		Ok(n): n == 3
		Err(_): False
	_ = remove_file(path)
	chunk_ok and count_ok


func test_write_then_read_text() -> Bool:
	path: String = "/tmp/__blorp_file_resource_text"
	_ = remove_file(path)
	wrote: Bool = match write_text_with_handle(path, "hello\nresource"):
		Ok(n): n == 1
		Err(_): False
	read_back: Bool = match read_text_with_handle(path):
		Ok(text): text == "hello\nresource"
		Err(_): False
	ok: Bool = wrote and read_back
	_ = remove_file(path)
	ok


func test_write_then_read_bytes() -> Bool:
	path: String = "/tmp/__blorp_file_resource_bytes"
	_ = remove_file(path)
	src: Bytes = "hello bytes".to_bytes()
	wrote: Bool = match write_bytes_with_handle(path, src):
		Ok(n): n == 1
		Err(_): False
	read_back: Bool = match read_bytes_with_handle(path):
		Ok(data): B.to_string(data) == "hello bytes"
		Err(_): False
	ok: Bool = wrote and read_back
	_ = remove_file(path)
	ok


func test_write_chunk_returns_count() -> Bool:
	path: String = "/tmp/__blorp_file_resource_write_chunk"
	_ = remove_file(path)
	wrote: Bool = match write_chunk_with_handle(path, "chunked".to_bytes()):
		Ok(n): n == 7
		Err(_): False
	read_back: Bool = match read_text_with_handle(path):
		Ok(text): text == "chunked"
		Err(_): False
	_ = remove_file(path)
	wrote and read_back


func test_write_chunk_empty_returns_zero() -> Bool:
	path: String = "/tmp/__blorp_file_resource_write_chunk_empty"
	_ = write_file(path, "existing")
	wrote: Bool = match write_chunk_with_handle(path, B.bytes(0)):
		Ok(n): n == 0
		Err(_): False
	read_back: Bool = match read_text_with_handle(path):
		Ok(text): text == ""
		Err(_): False
	_ = remove_file(path)
	wrote and read_back


func test_read_chunk_advances_reader() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunk"
	_ = write_file(path, "hello world")
	ok: Bool = match read_two_chunks(path):
		Ok(text): text == "hello| world"
		Err(_): False
	_ = remove_file(path)
	ok


func test_read_chunk_eof_is_empty() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunk_eof"
	_ = write_file(path, "hello")
	ok: Bool = match read_past_eof(path):
		Ok(text): text == "hello|"
		Err(_): False
	_ = remove_file(path)
	ok


func test_read_chunk_invalid_size() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunk_invalid"
	_ = write_file(path, "hello")
	ok: Bool = match read_invalid_chunk_size(path):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	_ = remove_file(path)
	ok


func test_collect_chunks_inside_with() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunks"
	_ = write_file(path, "abcdefghijklmnopqrstuvwxyz")
	ok: Bool = match collect_chunks_with_handle(path):
		Ok(parts):
			combined: Bytes = B.concat(parts)
			B.to_string(combined) == "abcdefghijklmnopqrstuvwxyz"
		Err(_): False
	_ = remove_file(path)
	ok


func test_collect_chunks_large_file() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunks_large"
	data: Bytes = B
		.bytes(70000)
		.fill(65)
	wrote: Bool = match write_bytes_with_handle(path, data):
		Ok(_): True
		Err(_): False
	ok: Bool = if wrote:
		match collect_chunks_with_handle(path):
			Ok(parts):
				if parts.length() > 1:
					combined: Bytes = B.concat(parts)
					combined.length() == 70000
				else:
					False
			Err(_): False
	else:
		False
	_ = remove_file(path)
	ok


func test_collect_chunks_via_local() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunks_local"
	_ = write_file(path, "local stream")
	ok: Bool = match collect_chunks_via_local(path):
		Ok(parts):
			combined: Bytes = B.concat(parts)
			B.to_string(combined) == "local stream"
		Err(_): False
	_ = remove_file(path)
	ok


func test_collect_chunks_with_explicit_size() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunks_sized"
	_ = write_file(path, "abcdefghij")
	ok: Bool = match collect_chunks_with_explicit_size(path, 4):
		Ok(parts):
			combined: Bytes = B.concat(parts)
			parts.length() == 3 and B.to_string(combined) == "abcdefghij"
		Err(_): False
	_ = remove_file(path)
	ok


func test_collect_chunks_with_invalid_size() -> Bool:
	path: String = "/tmp/__blorp_file_resource_chunks_bad_size"
	_ = write_file(path, "hello")
	zero_ok: Bool = match collect_chunks_with_explicit_size(path, 0):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	negative_ok: Bool = match collect_chunks_with_explicit_size(path, -4):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	_ = remove_file(path)
	zero_ok and negative_ok


func test_fallible_stream_count_result() -> Bool:
	path: String = "/tmp/__blorp_file_resource_stream_count"
	_ = write_file(path, "abcdefghij")
	ok: Bool = match count_chunks_with_explicit_size(path, 4):
		Ok(n): n == 3
		Err(_): False
	_ = remove_file(path)
	ok


func test_fallible_stream_predicate_results() -> Bool:
	path: String = "/tmp/__blorp_file_resource_stream_predicates"
	_ = write_file(path, "abcdefghij")
	any_ok: Bool = match any_chunk_matches(path, 4, "efgh"):
		Ok(found): found
		Err(_): False
	all_ok: Bool = match all_chunks_non_empty(path, 4):
		Ok(all_non_empty): all_non_empty
		Err(_): False
	_ = remove_file(path)
	any_ok and all_ok


func test_fallible_stream_fold_result() -> Bool:
	path: String = "/tmp/__blorp_file_resource_stream_fold"
	_ = write_file(path, "abcdefghij")
	ok: Bool = match total_chunk_bytes(path, 4):
		Ok(n): n == 10
		Err(_): False
	_ = remove_file(path)
	ok


func test_fallible_stream_fold_result_managed_acc() -> Bool:
	path: String = "/tmp/__blorp_file_resource_stream_fold_managed"
	_ = write_file(path, "abcdefghij")
	ok: Bool = match concat_chunk_bytes(path, 4):
		Ok(bytes): B.to_string(bytes) == "abcdefghij"
		Err(_): False
	_ = remove_file(path)
	ok


func test_fallible_stream_terminal_error_result() -> Bool:
	path: String = "/tmp/__blorp_file_resource_stream_terminal_error"
	_ = write_file(path, "abcdefghij")
	count_ok: Bool = match count_chunks_with_explicit_size(path, 0):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	any_ok: Bool = match any_chunk_matches(path, 0, "abcd"):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	all_ok: Bool = match all_chunks_non_empty(path, 0):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	fold_ok: Bool = match total_chunk_bytes(path, 0):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	_ = remove_file(path)
	count_ok and any_ok and all_ok and fold_ok


func test_fallible_stream_find_result() -> Bool:
	path: String = "/tmp/__blorp_file_resource_stream_find"
	_ = write_file(path, "abcdefghij")
	found_ok: Bool = match find_chunk_bytes(path, 4, "efgh"):
		Ok(Some(chunk)): B.to_string(chunk) == "efgh"
		_: False
	missing_ok: Bool = match find_chunk_bytes(path, 4, "zzzz"):
		Ok(None): True
		_: False
	error_ok: Bool = match find_chunk_bytes(path, 0, "abcd"):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	_ = remove_file(path)
	found_ok and missing_ok and error_ok


func test_file_lines_stream() -> Bool:
	path: String = "/tmp/__blorp_file_resource_lines"
	long_line: Bytes = B
		.bytes(70000)
		.fill(97)
	_ = write_bytes_with_handle(path, long_line)
	_ = append_file(path, "\ntail\r\nlast\n")
	ok: Bool = match collect_file_lines(path):
		Ok(lines):
			first_ok: Bool = match lines.get(0):
				Some(line): line.length() == 70000
				None: False
			second_ok: Bool = match lines.get(1):
				Some(line): line == "tail"
				None: False
			third_ok: Bool = match lines.get(2):
				Some(line): line == "last"
				None: False
			lines.length() == 3 and first_ok and second_ok and third_ok
		Err(_): False
	_ = remove_file(path)
	ok


func test_file_lines_find_result() -> Bool:
	path: String = "/tmp/__blorp_file_resource_lines_find"
	_ = write_file(path, "alpha\nbeta\ngamma\n")
	found_ok: Bool = match find_line(path, "beta"):
		Ok(Some(line)): line == "beta"
		_: False
	missing_ok: Bool = match find_line(path, "delta"):
		Ok(None): True
		_: False
	_ = remove_file(path)
	found_ok and missing_ok


func test_file_count_lines() -> Bool:
	empty: String = "/tmp/__blorp_file_resource_count_empty"
	no_trailing: String = "/tmp/__blorp_file_resource_count_notrail"
	trailing: String = "/tmp/__blorp_file_resource_count_trailing"
	large: String = "/tmp/__blorp_file_resource_count_large"
	_ = write_file(empty, "")
	_ = write_file(no_trailing, "one\ntwo")
	_ = write_file(trailing, "one\ntwo\n")
	large_content: Bytes = B
		.bytes(70000)
		.fill(120)
	_ = write_bytes_with_handle(large, large_content)
	_ = append_file(large, "\ny\nz")
	empty_ok: Bool = match count_file_lines(empty):
		Ok(n): n == 0
		Err(_): False
	no_trailing_ok: Bool = match count_file_lines(no_trailing):
		Ok(n): n == 2
		Err(_): False
	trailing_ok: Bool = match count_file_lines(trailing):
		Ok(n): n == 2
		Err(_): False
	large_ok: Bool = match count_file_lines(large):
		Ok(n): n == 3
		Err(_): False
	_ = remove_file(empty)
	_ = remove_file(no_trailing)
	_ = remove_file(trailing)
	_ = remove_file(large)
	empty_ok and no_trailing_ok and trailing_ok and large_ok


func test_file_bytes_stream() -> Bool:
	path: String = "/tmp/__blorp_file_resource_byte_stream"
	_ = write_file(path, "abc")
	ok: Bool = match collect_file_bytes(path):
		Ok(bytes):
			first_ok: Bool = match bytes.get(0):
				Some(byte): to_int(byte) == 97
				None: False
			third_ok: Bool = match bytes.get(2):
				Some(byte): to_int(byte) == 99
				None: False
			bytes.length() == 3 and first_ok and third_ok
		Err(_): False
	_ = remove_file(path)
	ok


func test_file_bytes_stream_empty() -> Bool:
	path: String = "/tmp/__blorp_file_resource_byte_stream_empty"
	_ = write_file(path, "")
	ok: Bool = match collect_file_bytes(path):
		Ok(bytes): bytes.length() == 0
		Err(_): False
	_ = remove_file(path)
	ok


func test_file_windows_stream() -> Bool:
	path: String = "/tmp/__blorp_file_resource_window_stream"
	_ = write_file(path, "abcdef")
	ok: Bool = match collect_file_windows(path, 3):
		Ok(windows):
			first_ok: Bool = match windows.get(0):
				Some(window): B.to_string(window) == "abc"
				None: False
			second_ok: Bool = match windows.get(1):
				Some(window): B.to_string(window) == "bcd"
				None: False
			last_ok: Bool = match windows.get(3):
				Some(window): B.to_string(window) == "def"
				None: False
			windows.length() == 4 and first_ok and second_ok and last_ok
		Err(_): False
	_ = remove_file(path)
	ok


func test_file_windows_stream_short_file() -> Bool:
	path: String = "/tmp/__blorp_file_resource_window_stream_short"
	_ = write_file(path, "ab")
	ok: Bool = match collect_file_windows(path, 3):
		Ok(windows): windows.length() == 0
		Err(_): False
	_ = remove_file(path)
	ok


func test_file_windows_stream_invalid_size() -> Bool:
	path: String = "/tmp/__blorp_file_resource_window_stream_invalid"
	_ = write_file(path, "abc")
	zero_ok: Bool = match collect_file_windows(path, 0):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	negative_ok: Bool = match collect_file_windows(path, -2):
		Err(InvalidInput(detail)): detail.length() > 0
		_: False
	_ = remove_file(path)
	zero_ok and negative_ok


func test_with_body_question_bind_returns_error() -> Bool:
	path: String = "/tmp/__blorp_file_resource_body_qb"
	_ = write_file(path, "hello")
	ok: Bool = match open_then_short_circuit(path):
		Err(NotFound(p)): p == path
		_: False
	_ = remove_file(path)
	ok


func test_body_question_bind_cleans_up_reader() -> Bool:
	path: String = "/tmp/__blorp_file_resource_body_qb_cleanup"
	_ = write_file(path, "hello")
	before: Int = open_fd_count()
	var ok: Bool = True
	var i: Int = 0
	while i < 20 and ok:
		ok = match open_then_short_circuit(path):
			Err(NotFound(p)): p == path
			_: False
		i += 1
	after: Int = open_fd_count()
	_ = remove_file(path)
	if before == 0 or after == 0:
		ok
	else:
		ok and after <= before + 3


func test_loop_break_continue_clean_up_reader() -> Bool:
	path: String = "/tmp/__blorp_file_resource_loop_cleanup"
	_ = write_file(path, "hello")
	before: Int = open_fd_count()
	var ok: Bool = True
	var i: Int = 0
	while i < 20 and ok:
		break_ok: Bool = match break_inside_resource_body(path):
			Ok(total): total == 1
			Err(_): False
		continue_ok: Bool = match continue_inside_resource_body(path):
			Ok(total): total == 4
			Err(_): False
		ok = break_ok and continue_ok
		i += 1
	after: Int = open_fd_count()
	_ = remove_file(path)
	if before == 0 or after == 0:
		ok
	else:
		ok and after <= before + 3


func test_timeout_cleans_up_open_reader() -> Bool:
	path: String = "/tmp/__blorp_file_resource_timeout_cleanup"
	_ = write_file(path, "hello")
	before: Int = open_fd_count()
	var ok: Bool = True
	var i: Int = 0
	while i < 20 and ok:
		ok = run_cancelled_open_read(path)
		i += 1
	sleep(20)
	after: Int = open_fd_count()
	_ = remove_file(path)
	if before == 0 or after == 0:
		ok
	else:
		ok and after <= before + 3


tests: TestSuite = {
	description = "typed file resources",
	tests = [
		("open_read missing returns NotFound", test_open_read_missing_not_found),
		("open_read existing closes", test_open_read_existing_closes),
		("normal with cleans up file handles", test_normal_with_cleans_up_file_handles),
		("open_write creates and truncates", test_open_write_creates_and_truncates),
		("open_append creates and preserves", test_open_append_creates_and_preserves),
		("open_read_write existing only", test_open_read_write_existing_only),
		("read-write handle reads text", test_read_write_handle_reads_text),
		(
			"read-write handle writes text at current offset",
			test_read_write_handle_writes_text_at_current_offset,
		),
		("read-write handle bytes and chunk", test_read_write_handle_bytes_and_chunk),
		(
			"read-write handle read chunk and count lines",
			test_read_write_handle_read_chunk_and_count_lines,
		),
		("write_text then read_text", test_write_then_read_text),
		("write_bytes then read_bytes", test_write_then_read_bytes),
		("write_chunk returns count", test_write_chunk_returns_count),
		("write_chunk empty returns zero", test_write_chunk_empty_returns_zero),
		("read_chunk advances reader", test_read_chunk_advances_reader),
		("read_chunk EOF is empty", test_read_chunk_eof_is_empty),
		("read_chunk invalid size", test_read_chunk_invalid_size),
		("collect chunks inside with", test_collect_chunks_inside_with),
		("collect chunks large file", test_collect_chunks_large_file),
		("collect chunks via local", test_collect_chunks_via_local),
		("collect chunks explicit size", test_collect_chunks_with_explicit_size),
		("collect chunks invalid size", test_collect_chunks_with_invalid_size),
		("fallible stream count result", test_fallible_stream_count_result),
		("fallible stream predicate results", test_fallible_stream_predicate_results),
		("fallible stream fold result", test_fallible_stream_fold_result),
		("fallible stream fold result managed acc", test_fallible_stream_fold_result_managed_acc),
		("fallible stream terminal error result", test_fallible_stream_terminal_error_result),
		("fallible stream find result", test_fallible_stream_find_result),
		("file lines stream", test_file_lines_stream),
		("file lines find result", test_file_lines_find_result),
		("file count lines", test_file_count_lines),
		("file bytes stream", test_file_bytes_stream),
		("file bytes stream empty", test_file_bytes_stream_empty),
		("file windows stream", test_file_windows_stream),
		("file windows stream short file", test_file_windows_stream_short_file),
		("file windows stream invalid size", test_file_windows_stream_invalid_size),
		("with body ?= returns error", test_with_body_question_bind_returns_error),
		("with body ?= cleans up reader", test_body_question_bind_cleans_up_reader),
		("loop break and continue clean up reader", test_loop_break_continue_clean_up_reader),
		("timeout cleans up open reader", test_timeout_cleans_up_open_reader),
	]
}
