import:
	bytes: bytes
	fs: IOError, resource_path, temporary_directory
	process:
		ProcessCaptureLimit(BoundedCapture, UnboundedCapture),
		ProcessEnvironmentChange,
		ProcessError(InvalidCommand, ProcessOutputLimitExceeded, ProgramNotFound, SpawnFailed),
		ProcessExit(Exited, Signaled, TimedOut),
		ProcessStdin(BytesStdin, InheritStdin),
		ProcessStream(InheritStream),
		command,
		run_command,
	process_session:
		ProcessSessionActivity,
		ProcessSessionCommandExecution(
			SessionCommandCompleted,
			SessionCommandFailed,
			SessionCommandInterrupted,
		),
		ProcessWrite(StdinClosed, WriteWouldBlock, Wrote),
		close_stdin,
		kill_session,
		poll_session,
		run_session_command,
		run_session_command_until,
		session_command,
		session_exit,
		session_state,
		session_with_capture_limit,
		session_with_cwd,
		session_with_environment,
		session_with_timeout,
		start_session,
		write_stdin,
		write_stdin_from,
	string: parse_int, repeat, trim
	system: file_exists, setenv, temp_dir
	test: TestSuite
	time: now
	units: from_bytes, milliseconds


private SIMULTANEOUS_OUTPUT_BYTES: Int = 65536

private SESSION_COMMAND_INPUT_BYTES: Int = 262144


func append_activity(
	stdout: Bytes,
	stderr: Bytes,
	activity: ProcessSessionActivity,
) -> (Bytes, Bytes):
	(stdout.append(activity.stdout), stderr.append(activity.stderr))


func stream_feedback() -> Result[Bool, ProcessError]:
	request ?= session_with_environment(
		session_command(
			"sh",
			[
				"-c",
				"read value; printf 'out:%s:%s' \"$value\" \"$BLORP_SESSION_VALUE\"; printf 'err:%s' \"$value\" >&2",
			],
		),
		[
			{
				name = "BLORP_SESSION_VALUE",
				value = Some("configured")
			},
		],
	)

	with session ?= start_session(request):
		write ?= write_stdin(session, "payload\n".to_bytes())

		write_succeeded: Bool = match write:
			Wrote(count):
				count == 8
			_:
				False

		ignored ?= close_stdin(session)
		var stdout: Bytes = bytes(0)
		var stderr: Bytes = bytes(0)
		var exit: Option[ProcessExit] = None
		var streams_open: Bool = True
		var failure: Option[ProcessError] = None
		var polls: Int = 0

		while (
			failure.is_none()
			and (exit.is_none() or streams_open)
			and polls < 100
		):
			polls += 1

			match poll_session(session, from_bytes(4096), milliseconds(20)):
				Ok(activity):
					output = append_activity(stdout, stderr, activity)
					stdout = output[0]
					stderr = output[1]

					streams_open = activity.stdout_open or activity.stderr_open

					match session_state(session):
						Ok(state):
							exit = session_exit(state)
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(
					(
						write_succeeded
						and exit == Some(Exited(0))
						and stdout.to_string() == "out:payload:configured"
						and stderr.to_string() == "err:payload"
					),
				)


func drain_simultaneous_output() -> Result[Bool, ProcessError]:
	request = session_with_timeout(
		session_command(
			"sh",
			[
				"-c",
				"(printf '%${SIMULTANEOUS_OUTPUT_BYTES}s' '' | tr ' ' o) & (printf '%${SIMULTANEOUS_OUTPUT_BYTES}s' '' | tr ' ' e >&2) & wait",
			],
		),
		Some(milliseconds(5000)),
	)

	with session ?= start_session(request):
		ignored ?= close_stdin(session)
		var stdout: Bytes = bytes(0)
		var stderr: Bytes = bytes(0)
		var exit: Option[ProcessExit] = None
		var streams_open: Bool = True
		var failure: Option[ProcessError] = None
		var polls: Int = 0

		while (
			failure.is_none()
			and (exit.is_none() or streams_open)
			and polls < 200
		):
			polls += 1

			match poll_session(session, from_bytes(1024), milliseconds(20)):
				Ok(activity):
					output = append_activity(stdout, stderr, activity)
					stdout = output[0]
					stderr = output[1]

					streams_open = activity.stdout_open or activity.stderr_open

					match session_state(session):
						Ok(state):
							exit = session_exit(state)
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(
					(
						exit == Some(Exited(0))
						and stdout.to_string() == repeat("o", SIMULTANEOUS_OUTPUT_BYTES)
						and stderr.to_string() == repeat("e", SIMULTANEOUS_OUTPUT_BYTES)
					),
				)


func observe_session_timeout() -> Result[Bool, ProcessError]:
	request = session_with_timeout(
		session_command(
			"sh",
			["-c", "trap '' TERM; while true; do sleep 1; done"],
		),
		Some(milliseconds(20)),
	)

	with session ?= start_session(request):
		ignored ?= close_stdin(session)
		var exit: Option[ProcessExit] = None
		var failure: Option[ProcessError] = None
		var streams_open: Bool = True
		var polls: Int = 0

		while (
			failure.is_none()
			and (exit.is_none() or streams_open)
			and polls < 100
		):
			polls += 1

			match poll_session(session, from_bytes(256), milliseconds(20)):
				Ok(activity):
					streams_open = activity.stdout_open or activity.stderr_open

					match session_state(session):
						Ok(state):
							exit = session_exit(state)
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(exit == Some(TimedOut))


