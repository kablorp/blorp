	request = session_with_timeout(
		session_command(
			"sh",
			["-c", "(sleep 5) & exit 0"],
		),
		Some(milliseconds(50)),
	)

	with session ?= start_session(request):
		ignored ?= close_stdin(session)
		var exit: Option[ProcessExit] = None
		var failure: Option[ProcessError] = None
		var streams_open: Bool = True
		var polls: Int = 0

		while (
			failure.is_none()
			and (exit.is_none() or streams_open)
			and polls < 100
		):
			polls += 1

			match poll_session(session, from_bytes(256), milliseconds(20)):
				Ok(activity):
					streams_open = activity.stdout_open or activity.stderr_open

					match session_state(session):
						Ok(state):
							exit = session_exit(state)
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(exit == Some(TimedOut) and not streams_open)


func observe_completed_child_after_deadline() -> Result[Bool, ProcessError]:
	request = session_with_timeout(
		session_command(
			"sh",
			["-c", "exit 7"],
		),
		Some(milliseconds(50)),
	)

	with session ?= start_session(request):
		_ = close_stdin(session)
		wait_result ?= run_command(
			command(
				"sh",
				["-c", "sleep 0.1"],
			),
		)
		state ?= session_state(session)

		Ok(wait_result.exit == Exited(0) and session_exit(state) == Some(Exited(7)))


func observe_poll_wait_uses_milliseconds() -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_command(
			"sh",
			["-c", "sleep 2"],
		),
	):
		_ = close_stdin(session)
		started_at: Int = now()
		var streams_open: Bool = True
		var failure: Option[ProcessError] = None

		for poll_index in 0..4:
			if failure.is_none():
				match poll_session(session, from_bytes(16), milliseconds(5)):
					Ok(activity):
						streams_open = (
							streams_open
							and activity.stdout_open
							and activity.stderr_open
						)
					Err(error):
						failure = Some(error)

		elapsed_milliseconds: Int = (now() - started_at) / 1000

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(elapsed_milliseconds < 120 and streams_open)


func start_missing_program() -> Result[Bool, ProcessError]:
	with session ?= start_session(session_command("__blorp_missing_session_program__", [])):
		Ok(False)


func observe_single_poll_cleanup() -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_command(
			"sh",
			["-c", "printf ok"],
		),
	):
		ignored ?= close_stdin(session)
		activity ?= poll_session(session, from_bytes(16), milliseconds(100))
		Ok(activity.stdout.length() <= 2)


func observe_capture_limit() -> Result[Bool, ProcessError]:
	request ?= session_with_capture_limit(
		session_command(
			"sh",
			["-c", "printf '%4096s' '' | tr ' ' x"],
		),
		BoundedCapture(from_bytes(1024)),
	)

	with session ?= start_session(request):
		ignored ?= close_stdin(session)
		var limit_observed: Bool = False
		var failure: Option[ProcessError] = None
		var polls: Int = 0

		while (
			not limit_observed
			and failure.is_none()
			and polls < 100
		):
			polls += 1

			match poll_session(session, from_bytes(4096), milliseconds(20)):
				Ok(activity):
					void
				Err(ProcessOutputLimitExceeded(detail)):
					limit_observed = detail.contains("configured limit")
				Err(error):
					failure = Some(error)

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(limit_observed)


func observe_closed_stdin_and_kill() -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_command(
			"sh",
			["-c", "sleep 5"],
		),
	):
		ignored ?= close_stdin(session)
		ignored_again ?= close_stdin(session)
		write ?= write_stdin(session, "ignored".to_bytes())
		killed ?= kill_session(session)
		var exit: Option[ProcessExit] = None
		var failure: Option[ProcessError] = None
		var streams_open: Bool = True
		var polls: Int = 0

		while (
			failure.is_none()
			and (exit.is_none() or streams_open)
			and polls < 100
		):
			polls += 1

			match poll_session(session, from_bytes(256), milliseconds(20)):
				Ok(activity):
					streams_open = activity.stdout_open or activity.stderr_open

					match session_state(session):
						Ok(state):
							exit = session_exit(state)
						Err(error):
							failure = Some(error)
				Err(error):
					failure = Some(error)

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(write == StdinClosed and exit == Some(Signaled(9)))


func observe_kill_bounds_escaped_output_drain() -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_command(
			"python3",
			[
				"-c",
				(
					"import os, time; pid = os.fork(); (os.setsid(), time.sleep(5)) if pid == 0 else "
					+ "(print(pid, flush=True), time.sleep(5))"
				),
			],
		),
	):
		ignored ?= close_stdin(session)
		var output: Bytes = bytes(0)
		var escaped_pid: Option[Int] = None
		var startup_polls: Int = 0
		var failure: Option[ProcessError] = None

		while (
			escaped_pid.is_none()
			and failure.is_none()
			and startup_polls < 100
		):
			startup_polls += 1

			match poll_session(session, from_bytes(256), milliseconds(20)):
				Err(error):
					failure = Some(error)
				Ok(activity):
					output = output.append(activity.stdout)
					escaped_pid = output
						.to_string()
						.trim()
						.parse_int()

		if failure.is_none():
			match kill_session(session):
				Err(error):
					failure = Some(error)
				Ok(_):
					void

		started_at: Int = now()
		var exit: Option[ProcessExit] = None
		var streams_open: Bool = True
		var drain_polls: Int = 0

		while (
			failure.is_none()
			and (exit.is_none() or streams_open)
			and drain_polls < 100
		):
			drain_polls += 1

			match poll_session(session, from_bytes(256), milliseconds(20)):
				Err(error):
					failure = Some(error)
				Ok(activity):
					streams_open = activity.stdout_open or activity.stderr_open

					match session_state(session):
						Err(error):
							failure = Some(error)
						Ok(state):
							exit = session_exit(state)

		elapsed_milliseconds: Int = (now() - started_at) / 1000

		match escaped_pid:
			Some(value):
				_ = run_command(
					command(
						"kill",
						["-KILL", value.to_string()],
					),
				)
			None:
				void

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(
					(
						escaped_pid.is_some()
						and elapsed_milliseconds < 1000
						and exit == Some(Signaled(9))
						and not streams_open
					),
				)


func observe_scope_kills_detached_descendant() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_process_session_group_"):
		marker: String = directory.resource_path() + "/descendant-survived"

		match (
			start_session(
				session_command(
					"sh",
					[
						"-c",
						"(exec </dev/null >/dev/null 2>&1; sleep 0.5; printf survived > \"$1\") & exit 0",
						"sh",
						marker,
					],
				),
			)
		):
			Err(_):
				Ok(False)
			Ok(started_session):
				var leader_exited: Bool = False
				var streams_open: Bool = True
				var polls: Int = 0

				with session = started_session:
					_ = close_stdin(session)

					while (not leader_exited or streams_open) and polls < 100:
						polls += 1

						match poll_session(session, from_bytes(256), milliseconds(20)):
							Err(_):
								polls = 100
							Ok(activity):
								streams_open = activity.stdout_open or activity.stderr_open

								match session_state(session):
									Ok(state):
										leader_exited = session_exit(state) == Some(Exited(0))
									Err(_):
										polls = 100

				match (
					run_command(
						command(
							"sh",
							["-c", "sleep 0.8"],
						),
					)
				):
					Err(_):
						Ok(False)
					Ok(_):
						Ok(leader_exited and not streams_open and not file_exists(marker))


func observe_write_backpressure() -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_command(
			"sh",
			["-c", "sleep 5"],
		),
	):
		input = repeat("x", 1048576).to_bytes()
		write ?= write_stdin(session, input)
		ignored ?= kill_session(session)

		Ok(
			match write:
				Wrote(count):
					count < input.length()
				WriteWouldBlock:
					True
				StdinClosed:
					False
		)


func observe_write_recovery_delivers_exact_input() -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_command(
			"sh",
			["-c", "count=$(wc -c | tr -d '[:space:]'); printf '%s' \"$count\""],
		),
	):
		input: Bytes = repeat("x", 1048576).to_bytes()
		var offset: Int = 0
		var output: Bytes = bytes(0)
		var failure: Option[ProcessError] = None
		var protocol_valid: Bool = True
		var saw_backpressure: Bool = False
		var saw_writable: Bool = False
		var iterations: Int = 0

		while (
			offset < input.length()
			and failure.is_none()
			and protocol_valid
			and iterations < 1000
		):
			iterations += 1

			match write_stdin_from(session, input, offset):
				Err(error):
					failure = Some(error)
				Ok(Wrote(count)):
					if count <= 0:
						protocol_valid = False
					else:
						offset += count
						saw_backpressure = saw_backpressure or offset < input.length()
				Ok(WriteWouldBlock):
					saw_backpressure = True
				Ok(StdinClosed):
					protocol_valid = False

			if failure.is_none() and protocol_valid:
				match poll_session(session, from_bytes(256), milliseconds(20)):
					Err(error):
						failure = Some(error)
					Ok(activity):
						output = output.append(activity.stdout)
						saw_writable = saw_writable or activity.stdin_writable

		if failure.is_none() and offset == input.length():
			match close_stdin(session):
				Err(error):
					failure = Some(error)
				Ok(_):
					void

		var exit: Option[ProcessExit] = None
		var streams_open: Bool = True
		var drain_polls: Int = 0

		while (
			failure.is_none()
			and (exit.is_none() or streams_open)
			and drain_polls < 100
		):
			drain_polls += 1

			match poll_session(session, from_bytes(256), milliseconds(20)):
				Err(error):
					failure = Some(error)
				Ok(activity):
					output = output.append(activity.stdout)
					streams_open = activity.stdout_open or activity.stderr_open

					match session_state(session):
						Err(error):
							failure = Some(error)
						Ok(state):
							exit = session_exit(state)

		match failure:
			Some(error):
				Err(error)
			None:
				Ok((
						protocol_valid
						and offset == input.length()
						and saw_backpressure
						and saw_writable
						and exit == Some(Exited(0))
						and not streams_open
						and output.to_string() == input
							.length()
							.to_string()
					))


private func interrupt_immediately() -> Option[Int]:
	Some(2)


func session_command_delivers_large_input() -> Bool:
	input: Bytes = repeat("x", SESSION_COMMAND_INPUT_BYTES).to_bytes()
	request = { command(
		"sh",
		[
			"-c",
			"count=$(wc -c | tr -d '[:space:]'); printf 'out:%s' \"$count\"; printf 'err:done' >&2",
		],
	) | stdin = BytesStdin(input) }

	match run_session_command(request):
		SessionCommandCompleted(result):
			(
				result.exit == Exited(0)
				and result.stdout.to_string() == "out:${SESSION_COMMAND_INPUT_BYTES.to_string()}"
				and result.stderr.to_string() == "err:done"
			)
		_:
			False


func session_command_reports_interruption() -> Bool:
	match (
		run_session_command_until(
			command(
				"sh",
				["-c", "trap '' TERM; sleep 5"],
			),
			interrupt_immediately,
		)
	):
		SessionCommandInterrupted(signal, _, _):
			signal == 2
		_:
			False


func session_command_reports_post_start_interruption() -> Result[Bool, IOError]:
	with directory ?= temporary_directory(temp_dir(), "blorp_session_interrupt_"):
		marker: String = directory.resource_path() + "/started"
		request = { command(
			"sh",
			[
				"-c",
				"printf started > \"$1\"; printf before; printf warning >&2; trap '' TERM; sleep 5",
				"sh",
				marker,
			],
		) | timeout = Some(milliseconds(2000)) }
		interrupt_when_started: () -> Option[Int] = func():
			if file_exists(marker):
				Some(2)
			else:
				None

		match run_session_command_until(request, interrupt_when_started):
			SessionCommandInterrupted(signal, stdout, stderr):
				Ok(
					(
						signal == 2
						and stdout.to_string() == "before"
						and stderr.to_string() == "warning"
					),
				)
			_:
				Ok(False)


func session_command_preserves_output_before_timeout() -> Bool:
	request = { command(
		"sh",
		["-c", "printf before; printf warning >&2; trap '' TERM; sleep 5"],
	) | timeout = Some(milliseconds(20)) }

	match run_session_command(request):
		SessionCommandCompleted(result):
			(
				result.exit == TimedOut
				and result.stdout.to_string() == "before"
				and result.stderr.to_string() == "warning"
			)
		_:
			False


func session_command_reports_capture_limit() -> Bool:
	request = { command(
		"sh",
		["-c", "printf '%4096s' '' | tr ' ' x"],
	) | capture_limit = BoundedCapture(from_bytes(1024)) }

	match run_session_command(request):
		SessionCommandFailed(ProcessOutputLimitExceeded(detail)):
			detail.contains("configured limit")
		_:
			False


func session_command_supports_explicit_unbounded_capture() -> Bool:
	_ = setenv("BLORP_PROCESS_MAX_OUTPUT_BYTES", "4")
	request = { command(
		"sh",
		["-c", "printf 12345"],
	) | capture_limit = UnboundedCapture }

	result: Bool = match run_session_command(request):
		SessionCommandCompleted(completed):
			completed.exit == Exited(0) and completed.stdout.to_string() == "12345"
		_:
			False

	_ = setenv("BLORP_PROCESS_MAX_OUTPUT_BYTES", "16777216")
	result


func session_command_bounds_escaped_output_drain() -> Bool:
	request = { command(
		"python3",
		[
			"-c",
			(
				"import os, time; pid = os.fork(); (os.setsid(), time.sleep(5)) if pid == 0 else "
				+ "(print(pid, flush=True), time.sleep(5))"
			),
		],
	) | timeout = Some(milliseconds(200)) }
	started_at: Int = now()

	match run_session_command(request):
		SessionCommandCompleted(result):
			elapsed_milliseconds: Int = (now() - started_at) / 1000
			pid: Option[Int] = result.stdout
				.to_string()
				.trim()
				.parse_int()

			match pid:
				Some(value):
					_ = run_command(
						command(
							"kill",
							["-KILL", value.to_string()],
						),
					)
				None:
					void

			passed: Bool = result.exit == TimedOut and elapsed_milliseconds < 1000 and pid.is_some()

			if not passed:
				print_error(
					"escaped drain mismatch: elapsed=${elapsed_milliseconds.to_string()} timed_out=${(result.exit == TimedOut).to_string()} stdout=${result.stdout.to_string()} stderr=${result.stderr.to_string()}",
				)

			passed
		_:
			False


func session_command_rejects_inherited_output() -> Bool:
	request = { command(
		"sh",
		["-c", "exit 0"],
	) | stdout = InheritStream }

	match run_session_command(request):
		SessionCommandFailed(InvalidCommand(detail)):
			detail.contains("captured stdout and stderr")
		_:
			False


func session_command_accepts_inherited_stdin() -> Bool:
	request = { command(
		"sh",
		["-c", "printf inherited-session-stdin"],
	) | stdin = InheritStdin }

	match run_session_command(request):
		SessionCommandCompleted(result):
			result.exit == Exited(0) and result.stdout.to_string() == "inherited-session-stdin"
		_:
			False


func start_empty_program() -> Result[Bool, ProcessError]:
	with session ?= start_session(session_command("", [])):
		Ok(False)


func start_nul_program() -> Result[Bool, ProcessError]:
	with session ?= start_session(session_command("sh\0hidden", [])):
		Ok(False)


func start_with_nul_argument() -> Result[Bool, ProcessError]:
	with session ?= start_session(session_command("sh", ["embedded\0nul"])):
		Ok(False)


func start_with_missing_cwd() -> Result[Bool, ProcessError]:
	request = session_with_cwd(
		session_command(
			"sh",
			["-c", "exit 0"],
		),
		Some("/__blorp_missing_process_session_cwd__"),
	)

	with session ?= start_session(request):
		Ok(False)


func start_with_invalid_cwd(cwd: String) -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_with_cwd(
			session_command(
				"sh",
				["-c", "exit 0"],
			),
			Some(cwd),
		),
	):
		Ok(False)


func start_with_environment_change(
	name: String,
	value: Option[String],
) -> Result[Bool, ProcessError]:
	request ?= session_with_environment(
		session_command(
			"sh",
			["-c", "exit 0"],
		),
		[
			{
				name = name,
				value = value
			},
		],
	)

	with session ?= start_session(request):
		Ok(False)


func observe_invalid_poll_bounds() -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_command(
			"sh",
			["-c", "sleep 1"],
		),
	):
		negative_is_invalid: Bool = match poll_session(session, from_bytes(-1), milliseconds(0)):
			Err(InvalidCommand(detail)):
				detail.contains("poll bounds")
			_:
				False

		zero_is_invalid: Bool = match poll_session(session, from_bytes(0), milliseconds(0)):
			Err(InvalidCommand(detail)):
				detail.contains("poll bounds")
			_:
				False

		oversized_is_invalid: Bool = match poll_session(
			session,
			from_bytes(16 * 1024 * 1024 + 1),
			milliseconds(0),
		):
			Err(InvalidCommand(detail)):
				detail.contains("poll bounds")
			_:
				False

		Ok(negative_is_invalid and zero_is_invalid and oversized_is_invalid)


func observe_invalid_write_offset() -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_command(
			"sh",
			["-c", "sleep 1"],
		),
	):
		input: Bytes = "input".to_bytes()

		negative_is_invalid: Bool = match write_stdin_from(session, input, -1):
			Err(InvalidCommand(detail)):
				detail.contains("offset")
			_:
				False

		oversized_is_invalid: Bool = match write_stdin_from(session, input, input.length() + 1):
			Err(InvalidCommand(detail)):
				detail.contains("offset")
			_:
				False

		ignored ?= kill_session(session)
		Ok(negative_is_invalid and oversized_is_invalid)


func observe_negative_poll_wait_is_immediate() -> Result[Bool, ProcessError]:
	with session ?= start_session(
		session_command(
			"sh",
			["-c", "sleep 1"],
		),
	):
		ignored ?= close_stdin(session)
		started_at: Int = now()
		ignored ?= poll_session(session, from_bytes(16), milliseconds(-1))
		elapsed_milliseconds: Int = (now() - started_at) / 1000

		Ok(elapsed_milliseconds < 50)


func test_session_streams_bidirectional_feedback() -> Bool:
	stream_feedback() == Ok(True)


func test_session_drains_stdout_and_stderr_together() -> Bool:
	drain_simultaneous_output() == Ok(True)


