func test_session_rejects_empty_program() -> Bool:
	match start_empty_program():
		Err(InvalidCommand(detail)):
			detail.contains("empty")
		_:
			False


func test_session_rejects_nul_program() -> Bool:
	match start_nul_program():
		Err(InvalidCommand(detail)):
			detail.contains("NUL")
		_:
			False


func test_session_rejects_duplicate_environment_changes() -> Bool:
	match (
		session_with_environment(
			session_command(
				"sh",
				["-c", "exit 0"],
			),
			[
				{
					name = "DUPLICATE",
					value = Some("first")
				},
				{
					name = "DUPLICATE",
					value = None
				},
			],
		)
	):
		Err(InvalidCommand(detail)):
			detail.contains("duplicate environment change")
		_:
			False


func test_session_rejects_malformed_environment_changes() -> Bool:
	empty_name_is_rejected: Bool = match start_with_environment_change("", Some("value")):
		Err(InvalidCommand(detail)):
			detail.contains("empty")
		_:
			False

	equals_name_is_rejected: Bool = match start_with_environment_change("A=B", Some("value")):
		Err(InvalidCommand(detail)):
			detail.contains("contains '='")
		_:
			False

	nul_name_is_rejected: Bool = match start_with_environment_change("A\0B", Some("value")):
		Err(InvalidCommand(detail)):
			detail.contains("NUL")
		_:
			False

	nul_value_is_rejected: Bool = match start_with_environment_change("A", Some("x\0y")):
		Err(InvalidCommand(detail)):
			detail.contains("NUL")
		_:
			False

	(
		empty_name_is_rejected
		and equals_name_is_rejected
		and nul_name_is_rejected
		and nul_value_is_rejected
	)


func test_session_rejects_nul_argument() -> Bool:
	match start_with_nul_argument():
		Err(InvalidCommand(detail)):
			detail.contains("NUL")
		_:
			False


func test_session_rejects_malformed_cwd() -> Bool:
	empty_is_rejected: Bool = match start_with_invalid_cwd(""):
		Err(InvalidCommand(detail)):
			detail.contains("empty")
		_:
			False

	nul_is_rejected: Bool = match start_with_invalid_cwd("/tmp\0hidden"):
		Err(InvalidCommand(detail)):
			detail.contains("NUL")
		_:
			False

	empty_is_rejected and nul_is_rejected


func test_session_rejects_missing_cwd() -> Bool:
	match start_with_missing_cwd():
		Err(SpawnFailed(detail)):
			detail.contains("working directory")
		_:
			False


func test_session_rejects_negative_capture_limit() -> Bool:
	match (
		session_with_capture_limit(
			session_command(
				"sh",
				["-c", "exit 0"],
			),
			BoundedCapture(from_bytes(-1)),
		)
	):
		Err(InvalidCommand(detail)):
			detail.contains("capture limit")
		_:
			False


