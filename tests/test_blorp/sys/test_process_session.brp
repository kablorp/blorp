func test_session_preserves_exit_observed_after_deadline() -> Bool:
	observe_completed_child_after_deadline() == Ok(True)


func test_session_poll_wait_uses_milliseconds() -> Bool:
	observe_poll_wait_uses_milliseconds() == Ok(True)


func test_session_reports_missing_program() -> Bool:
	match start_missing_program():
		Err(ProgramNotFound(detail)):
			detail.contains("program not found") or detail.contains("posix_spawnp")
		_:
			False


