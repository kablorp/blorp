import:
	test: TestSuite


func test_to_string_int() -> Bool:
	42.to_string() == "42"


func test_to_string_float() -> Bool:
	3.14.to_string() == "3.14"


func test_to_string_bool() -> Bool:
	True.to_string() == "True" and False.to_string() == "False"


func test_to_string_list() -> Bool:
	to_string([1, 2, 3]) == "[1, 2, 3]"


func test_print_returns_void() -> Bool:
	-- print returns Void, we just verify it doesn't crash
	print("")
	True


func test_print_error_returns_void() -> Bool:
	-- print_error returns Void, we just verify it doesn't crash
	print_error("")
	True


tests: TestSuite = {
	description = "I/O",
	tests = [
		("to_string int", test_to_string_int),
		("to_string float", test_to_string_float),
		("to_string bool", test_to_string_bool),
		("to_string list", test_to_string_list),
		("print returns void", test_print_returns_void),
		("print_error returns void", test_print_error_returns_void),
	]
}
