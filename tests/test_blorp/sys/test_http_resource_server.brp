-- High-concurrency HTTP-over-TCP resource server smoke.
--
-- The server loop owns only scoped TcpStream resources. Request routing and
-- response construction use ordinary net/http values, so user code does not
-- need resource parameters or shared mutable state.
import:
	channel: Channel, channel, recv_timeout, send
	net/http as HTTP: Request, Response
	net/tcp:
		IpFamily(IPv4),
		TcpError,
		connect_loopback,
		connections_stop_on_error,
		listen_loopback_any_port,
		local_port,
		message,
		port,
		read_chunk,
		set_stream_timeout,
		set_timeout,
		write_all,
	string: contains
	test: TestSuite


http_stream_timeout_ms: Int = 1000

http_client_result_timeout_ms: Int = 5000

-- Intentionally force each HTTP message to span multiple TCP reads.
http_read_chunk_size: Int = 8

http_listener_backlog: Int = 32


pure func is_socket_permission_error(err: TcpError) -> Bool:
	detail: String = message(err)
	detail.contains("Operation not permitted") or detail.contains("Permission denied")


pure func route(req: Request) -> Response:
	HTTP.ok_text("handled " + req.path)


func client_get(port_num: Int, path: String) -> Result[Bool, TcpError]:
	remote ?= port(port_num)

	with stream ?= connect_loopback(IPv4, remote):
		ignored_timeout ?= set_stream_timeout(stream, http_stream_timeout_ms)
		request: Bytes = ("GET " + path + " HTTP/1.1\r\nHost: localhost\r\n\r\n").to_bytes()
		ignored ?= write_all(stream, request)
		var raw: Bytes = "".to_bytes()
		var reading: Bool = True
		var read_error: Option[TcpError] = None

		-- format_response adds Connection: close, so EOF frames this response.
		-- A reusable keep-alive client must honor Content-Length or chunked coding.
		while reading:
			match read_chunk(stream, http_read_chunk_size):
				Ok(chunk):
					if chunk.length() == 0:
						reading = False
					else:
						raw = raw.append(chunk)
				Err(err):
					read_error = Some(err)
					reading = False

		match read_error:
			Some(err):
				Err(err)
			None:
				text: String = raw.to_string()
				Ok(text.contains("HTTP/1.1 200 OK") and text.contains("handled " + path))


func detached_client(port: Int, path: String, results: Channel[Bool]):
	match client_get(port, path):
		Ok(ok):
			_ = send(results, ok)
		Err(_):
			_ = send(results, False)


func launch_clients(port: Int, count: Int, results: Channel[Bool]):
	var i: Int = 0

	while i < count:
		path: String = "/item-${i}"
		detach detached_client(port, path, results)
		i += 1


func collect_client_results(results: Channel[Bool], count: Int) -> Bool:
	var seen: Int = 0
	var ok: Bool = True

	while seen < count:
		match recv_timeout(results, http_client_result_timeout_ms):
			Some(value):
				ok = ok and value
				seen += 1
			None:
				ok = False
				seen = count

	ok


func run_resource_http_server(client_count: Int) -> Result[Bool, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, http_listener_backlog):
		ignored ?= set_timeout(listener, http_stream_timeout_ms)
		port_num ?= local_port(listener)
		results: Channel[Bool] = channel(client_count)
		launch_clients(port_num, client_count, results)

		for peer in connections_stop_on_error(listener) concurrently(limit: 4):
			match set_stream_timeout(peer, http_stream_timeout_ms):
				Ok(_):
					var raw: Bytes = "".to_bytes()
					var reading: Bool = True

					-- TCP reads are arbitrary chunks; wait for the complete HTTP header.
					-- This smoke sends bodyless GETs; production framing must also
					-- bound header growth and honor request body framing.
					while reading:
						match read_chunk(peer, http_read_chunk_size):
							Ok(chunk):
								if chunk.length() == 0:
									reading = False
								else:
									raw = raw.append(chunk)
									reading = not raw
										.to_string()
										.contains("\r\n\r\n")
							Err(_):
								reading = False

					response: Response = match HTTP.parse_request(raw):
						Ok(req):
							route(req)
						Err(msg):
							HTTP.error_response(400, msg)

					match write_all(
						peer,
						HTTP.format_response(response),
					):
						Ok(_):
							void
						Err(_):
							void
				Err(_):
					void

		Ok(collect_client_results(results, client_count))


func test_concurrent_resource_http_server() -> Bool:
	match run_resource_http_server(4):
		Ok(ok):
			ok
		Err(err):
			is_socket_permission_error(err)


tests: TestSuite = {
	description = "HTTP resource server tests",
	tests = [("concurrent resource HTTP server", test_concurrent_resource_http_server)]
}
