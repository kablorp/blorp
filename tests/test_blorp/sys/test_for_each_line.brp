-- Test for_each_line streaming file I/O
import:
	system: append_file, for_each_line, mkstemp_path, read_file, remove_file, write_file
	test: TestSuite


tests: TestSuite = {
	description = "for_each_line",
	tests = [
		("basic line processing", test_basic),
		("line numbers are 1-indexed", test_line_numbers),
		("missing file returns Err", test_missing_file),
		("empty file processes zero lines", test_empty_file),
	],
}


func test_basic() -> Bool:
	match mkstemp_path("blorp_fel_in_"):
		Ok(in_path):
			match mkstemp_path("blorp_fel_out_"):
				Ok(out_path):
					_ = write_file(in_path, "hello\nworld\nfoo\n")
					_ = write_file(out_path, "")
					result: Result[Void, String] = for_each_line(
						in_path,
						func(num: Int, line: String):
							append_file(out_path, line)
							append_file(out_path, "\n")
							void
					)
					ok: Bool = match result:
						Ok(_):
							match read_file(out_path):
								Ok(content): equals(content, "hello\nworld\nfoo\n")
								Err(_): False
						Err(_): False
					_ = remove_file(in_path)
					_ = remove_file(out_path)
					ok
				Err(_):
					_ = remove_file(in_path)
					False
		Err(_): False


func test_line_numbers() -> Bool:
	match mkstemp_path("blorp_fel_nums_"):
		Ok(in_path):
			match mkstemp_path("blorp_fel_nums_out_"):
				Ok(out_path):
					_ = write_file(in_path, "a\nb\nc\n")
					_ = write_file(out_path, "")
					_ = for_each_line(
						in_path,
						func(num: Int, line: String):
							append_file(out_path, num.to_string())
							append_file(out_path, "\n")
							void
					)
					ok: Bool = match read_file(out_path):
						Ok(content): equals(content, "1\n2\n3\n")
						Err(_): False
					_ = remove_file(in_path)
					_ = remove_file(out_path)
					ok
				Err(_):
					_ = remove_file(in_path)
					False
		Err(_): False


func test_missing_file() -> Bool:
	match mkstemp_path("blorp_fel_missing_"):
		Ok(path):
			_ = remove_file(path)
			result: Result[Void, String] = for_each_line(
				path,
				func(num: Int, line: String):
					void
			)
			match result:
				Err(_): True
				Ok(_): False
		Err(_): False


func test_empty_file() -> Bool:
	match mkstemp_path("blorp_fel_empty_"):
		Ok(in_path):
			match mkstemp_path("blorp_fel_empty_out_"):
				Ok(out_path):
					_ = write_file(in_path, "")
					_ = write_file(out_path, "")
					_ = for_each_line(
						in_path,
						func(num: Int, line: String):
							append_file(out_path, "x\n")
							void
					)
					ok: Bool = match read_file(out_path):
						Ok(content): equals(content, "")
						Err(_): False
					_ = remove_file(in_path)
					_ = remove_file(out_path)
					ok
				Err(_):
					_ = remove_file(in_path)
					False
		Err(_): False
