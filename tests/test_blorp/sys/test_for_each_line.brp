-- Test for_each_line streaming file I/O
import:
	system: append_file, for_each_line, read_file, write_file
	test: TestSuite


tests: TestSuite = {
	description = "for_each_line",
	tests = [
		("basic line processing", test_basic),
		("line numbers are 1-indexed", test_line_numbers),
		("missing file returns Err", test_missing_file),
		("empty file processes zero lines", test_empty_file),
	],
}


func test_basic() -> Bool:
	_ = write_file("/tmp/blorp_fel_in.txt", "hello\nworld\nfoo\n")
	_ = write_file("/tmp/blorp_fel_out.txt", "")
	result: Result[Void, String] = for_each_line("/tmp/blorp_fel_in.txt", func(
		num: Int,
		line: String,
	):
		append_file("/tmp/blorp_fel_out.txt", line)
		append_file("/tmp/blorp_fel_out.txt", "\n")
		void
	)
	match result:
		Ok(_):
			match read_file("/tmp/blorp_fel_out.txt"):
				Ok(content): equals(content, "hello\nworld\nfoo\n")
				Err(_): False
		Err(_): False


func test_line_numbers() -> Bool:
	_ = write_file("/tmp/blorp_fel_nums.txt", "a\nb\nc\n")
	_ = write_file("/tmp/blorp_fel_nums_out.txt", "")
	_ = for_each_line("/tmp/blorp_fel_nums.txt", func(num: Int, line: String):
		append_file("/tmp/blorp_fel_nums_out.txt", num.to_string())
		append_file("/tmp/blorp_fel_nums_out.txt", "\n")
		void
	)
	match read_file("/tmp/blorp_fel_nums_out.txt"):
		Ok(content): equals(content, "1\n2\n3\n")
		Err(_): False


func test_missing_file() -> Bool:
	result: Result[Void, String] = for_each_line("/tmp/blorp_nonexistent_foreach.txt", func(
		num: Int,
		line: String,
	):
		append_file("/tmp/blorp_fel_never.txt", "should not run")
		void
	)
	match result:
		Err(_): True
		Ok(_): False


func test_empty_file() -> Bool:
	_ = write_file("/tmp/blorp_fel_empty.txt", "")
	_ = write_file("/tmp/blorp_fel_empty_out.txt", "")
	_ = for_each_line("/tmp/blorp_fel_empty.txt", func(num: Int, line: String):
		append_file("/tmp/blorp_fel_empty_out.txt", "x\n")
		void
	)
	match read_file("/tmp/blorp_fel_empty_out.txt"):
		Ok(content): equals(content, "")
		Err(_): False
