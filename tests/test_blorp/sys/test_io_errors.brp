-- Test I/O error messages from Result-based file functions
import:
	bytes as B
	string: contains
	system: mkstemp_path, read_bytes, read_file, remove_file, write_bytes, write_file
	test: TestSuite


tests: TestSuite = {
	description = "I/O Error Messages",
	tests = [
		("read_file missing has error msg", test_read_file_err_msg),
		("write_file bad path has error msg", test_write_file_err_msg),
		("read_bytes missing has error msg", test_read_bytes_err_msg),
		("write_bytes bad path has error msg", test_write_bytes_err_msg),
		("read_file success returns Ok", test_read_file_ok),
		("write_file success returns Ok", test_write_file_ok),
	],
}


func test_read_file_err_msg() -> Bool:
	match mkstemp_path("blorp_missing_io_"):
		Ok(path):
			_ = remove_file(path)
			match read_file(path):
				Err(msg): msg.contains("No such file")
				Ok(_): False
		Err(_): False


func test_write_file_err_msg() -> Bool:
	match write_file("/nonexistent_dir/blorp_io_err_test.txt", "data"):
		Err(msg): msg.length() > 0
		Ok(_): False


func test_read_bytes_err_msg() -> Bool:
	match mkstemp_path("blorp_missing_bytes_io_"):
		Ok(path):
			_ = remove_file(path)
			match read_bytes(path):
				Err(msg): msg.contains("No such file")
				Ok(_): False
		Err(_): False


func test_write_bytes_err_msg() -> Bool:
	match write_bytes("/nonexistent_dir/blorp_io_err_test.bin", B.bytes(1)):
		Err(msg): msg.length() > 0
		Ok(_): False


func test_read_file_ok() -> Bool:
	match mkstemp_path("blorp_io_ok_"):
		Ok(path):
			_ = write_file(path, "hello")
			ok: Bool = match read_file(path):
				Ok(content): equals(content, "hello")
				Err(_): False
			_ = remove_file(path)
			ok
		Err(_): False


func test_write_file_ok() -> Bool:
	match mkstemp_path("blorp_io_write_ok_"):
		Ok(path):
			ok: Bool = match write_file(path, "data"):
				Ok(_): True
				Err(_): False
			_ = remove_file(path)
			ok
		Err(_): False
