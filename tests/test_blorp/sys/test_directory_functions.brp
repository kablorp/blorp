-- Test directory walking functions
import:
	fs: IOError, entries, open_dir
	stream: count_result
	system: is_directory
	test: TestSuite


func count_entries(path: String) -> Result[Int, IOError]:
	with dir ?= open_dir(path):
		entries(dir).count_result()


func test_tests_is_directory() -> Bool:
	is_directory("tests")


func test_file_not_directory() -> Bool:
	is_dir: Bool = is_directory("tests/test_blorp/sys/test_directory_functions.brp")
	is_dir == False


func test_directory_entries_has_entries() -> Bool:
	match count_entries("tests"):
		Ok(count): count > 0
		Err(_): False


tests: TestSuite = {
	description = "Directory Walking",
	tests = [
		("tests/ is a directory", test_tests_is_directory),
		("file is not a directory", test_file_not_directory),
		("directory entries stream returns entries", test_directory_entries_has_entries),
	]
}
