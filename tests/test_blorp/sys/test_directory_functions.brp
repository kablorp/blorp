-- Test directory walking functions
import:
	system: is_directory, list_dir
	test: TestSuite


func test_tests_is_directory() -> Bool:
	is_directory("tests")


func test_file_not_directory() -> Bool:
	is_dir: Bool = is_directory("tests/test_blorp/sys/test_directory_functions.brp")
	is_dir == False


func test_list_dir_has_entries() -> Bool:
	files: List[String] = list_dir("tests")
	count: Int = files.length()
	count > 0


tests: TestSuite = {
	description = "Directory Walking",
	tests = [
		("tests/ is a directory", test_tests_is_directory),
		("file is not a directory", test_file_not_directory),
		("list_dir returns entries", test_list_dir_has_entries),
	],
}
