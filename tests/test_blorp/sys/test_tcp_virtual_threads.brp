-- TCP virtual-thread parking with scoped resources.
import:
	instrumentation: SchedulerStats, get_scheduler_stats, reset_scheduler_stats
	net/tcp: TcpError, accept, connect, listen, local_port, message, read_chunk, write_all
	string: contains
	test: TestSuite


pure func is_socket_permission_error(err: TcpError) -> Bool:
	detail_msg: String = message(err)
	detail_msg.contains("Operation not permitted") or detail_msg.contains("Permission denied")


func read_one_client(port: Int, results: Channel[Int]) -> Bool:
	n: Int = match read_one_client_result(port):
		Ok(value): value
		Err(_): -1000
	_ = send(results, n)
	n == 1


func read_one_client_result(port: Int) -> Result[Int, TcpError]:
	with stream ?= connect("127.0.0.1", port):
		data ?= read_chunk(stream, 1)
		Ok(data.length())


func recv_or_zero(results: Channel[Int]) -> Int:
	match recv(results):
		Some(value): value
		None: 0


func scoped_fanout() -> Result[Bool, TcpError]:
	with listener ?= listen("127.0.0.1", 0, 8):
		port ?= local_port(listener)
		results: Channel[Int] = channel(8)
		reset_scheduler_stats()
		detach read_one_client(port, results)
		detach read_one_client(port, results)
		detach read_one_client(port, results)
		detach read_one_client(port, results)
		with peer ?= accept(listener):
			ignored_a ?= write_all(peer, "x".to_bytes())
			with peer ?= accept(listener):
				ignored_b ?= write_all(peer, "x".to_bytes())
				with peer ?= accept(listener):
					ignored_c ?= write_all(peer, "x".to_bytes())
					with peer ?= accept(listener):
						ignored_d ?= write_all(peer, "x".to_bytes())
						total: Int = recv_or_zero(
							results,
						) + recv_or_zero(results) + recv_or_zero(results) + recv_or_zero(results)
						stats: SchedulerStats = get_scheduler_stats()
						Ok(total == 4 and stats.fiber_parks >= 1)


func test_tcp_clients_park_on_virtual_threads() -> Bool:
	match scoped_fanout():
		Ok(ok): ok
		Err(err): is_socket_permission_error(err)


tests: TestSuite = {
	description = "TCP Virtual Thread Tests",
	tests = [("TCP clients park on virtual threads", test_tcp_clients_park_on_virtual_threads)]
}
