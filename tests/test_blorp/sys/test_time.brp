-- Test date/time support (Elm-inspired, POSIX-time-centric)
import:
	test: TestSuite
	time:
		format_time,
		from_parts,
		hours,
		now,
		parse_time,
		to_day,
		to_hour,
		to_iso,
		to_minute,
		to_month,
		to_second,
		to_weekday,
		to_year,


-- Known timestamp: 2021-01-01 00:00:00 UTC = 1609459200 seconds
-- In microseconds: 1609459200000000
known_us: Int = 1609459200000000

tests: TestSuite = {
	description = "Date/Time Support",
	tests = [
		("to_year", test_to_year),
		("to_month", test_to_month),
		("to_day", test_to_day),
		("to_hour", test_to_hour),
		("to_minute", test_to_minute),
		("to_second", test_to_second),
		("to_weekday", test_to_weekday),
		("from_parts round-trip", test_from_parts),
		("format", test_format),
		("format rejects NUL format", test_format_rejects_nul_format),
		("parse valid", test_parse_valid),
		("parse invalid", test_parse_invalid),
		("parse rejects NUL input", test_parse_rejects_nul_input),
		("parse rejects NUL format", test_parse_rejects_nul_format),
		("now increases", test_now_increases),
		("duration arithmetic", test_duration),
		("to_iso format", test_to_iso),
	]
}


func test_to_year() -> Bool:
	to_year(known_us) == 2021


func test_to_month() -> Bool:
	to_month(known_us) == 1


func test_to_day() -> Bool:
	to_day(known_us) == 1


func test_to_hour() -> Bool:
	to_hour(known_us) == 0


func test_to_minute() -> Bool:
	to_minute(known_us) == 0


func test_to_second() -> Bool:
	to_second(known_us) == 0


func test_to_weekday() -> Bool:
	-- 2021-01-01 was a Friday (5)
	to_weekday(known_us) == 5


func test_from_parts() -> Bool:
	result: Int = from_parts(2021, 1, 1, 0, 0, 0)
	result == known_us


func test_format() -> Bool:
	result: String = format_time(known_us, "%Y-%m-%d")
	equals(result, "2021-01-01")


func test_format_rejects_nul_format() -> Bool:
	result: String = format_time(known_us, "%Y\0hidden")
	result == ""


func test_parse_valid() -> Bool:
	match parse_time("2021-01-01 00:00:00", "%Y-%m-%d %H:%M:%S"):
		Some(us): us == known_us
		None: False


func test_parse_invalid() -> Bool:
	match parse_time("not-a-date", "%Y-%m-%d"):
		None: True
		_: False


func test_parse_rejects_nul_input() -> Bool:
	match parse_time("2021-01-01\0hidden", "%Y-%m-%d"):
		None: True
		_: False


func test_parse_rejects_nul_format() -> Bool:
	match parse_time("2021-01-01", "%Y-%m-%d\0hidden"):
		None: True
		_: False


func test_now_increases() -> Bool:
	t1: Int = now()
	t2: Int = now()
	t2 >= t1


func test_duration() -> Bool:
	one_hour: Int = hours(1)
	later: Int = known_us + one_hour
	to_hour(later) == 1


func test_to_iso() -> Bool:
	result: String = to_iso(known_us)
	equals(result, "2021-01-01T00:00:00Z")
