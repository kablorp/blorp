import:
	system:
		exec_output,
		file_exists,
		getcwd,
		mkdir,
		mkstemp_path,
		read_file,
		remove_dir,
		remove_file,
		rename,
		write_file,
	test: TestSuite


-- ============================================================================
-- getcwd
-- ============================================================================
func test_getcwd_nonempty() -> Bool:
	cwd: String = getcwd()
	cwd.length() > 0


func test_getcwd_starts_with_slash() -> Bool:
	cwd: String = getcwd()
	cwd.starts_with("/")


func test_getcwd_deterministic() -> Bool:
	getcwd() == getcwd()


-- ============================================================================
-- mkdir / remove_dir
-- ============================================================================
func test_mkdir_creates_dir() -> Bool:
	match mkstemp_path("blorp_mkdir_"):
		Ok(path):
			_ = remove_file(path)
			result: Bool = mkdir(path)
			exists: Bool = file_exists(path)
			_ = remove_dir(path)
			result and exists
		Err(_): False


func test_mkdir_duplicate_fails() -> Bool:
	match mkstemp_path("blorp_mkdir_dup_"):
		Ok(path):
			_ = remove_file(path)
			_ = mkdir(path)
			result: Bool = mkdir(path)
			_ = remove_dir(path)
			not result
		Err(_): False


func test_remove_dir_success() -> Bool:
	match mkstemp_path("blorp_rmdir_"):
		Ok(path):
			_ = remove_file(path)
			_ = mkdir(path)
			remove_dir(path) == True
		Err(_): False


func test_remove_dir_nonexistent() -> Bool:
	match mkstemp_path("blorp_rmdir_missing_"):
		Ok(path):
			_ = remove_file(path)
			remove_dir(path) == False
		Err(_): False


-- ============================================================================
-- remove_file
-- ============================================================================
func test_remove_file_success() -> Bool:
	match mkstemp_path("blorp_rmfile_"):
		Ok(path):
			_ = write_file(path, "test data")
			remove_file(path) == True
		Err(_): False


func test_remove_file_nonexistent() -> Bool:
	match mkstemp_path("blorp_rmfile_missing_"):
		Ok(path):
			_ = remove_file(path)
			remove_file(path) == False
		Err(_): False


func test_remove_file_verify_gone() -> Bool:
	match mkstemp_path("blorp_rmfile_gone_"):
		Ok(path):
			_ = write_file(path, "data")
			_ = remove_file(path)
			file_exists(path) == False
		Err(_): False


-- ============================================================================
-- rename
-- ============================================================================
func test_rename_file() -> Bool:
	match mkstemp_path("blorp_rename_src_"):
		Ok(src):
			match mkstemp_path("blorp_rename_dst_"):
				Ok(dst):
					_ = remove_file(dst)
					_ = write_file(src, "rename test")
					result: Bool = rename(src, dst)
					dst_exists: Bool = file_exists(dst)
					src_gone: Bool = not file_exists(src)
					_ = remove_file(dst)
					result and dst_exists and src_gone
				Err(_):
					_ = remove_file(src)
					False
		Err(_): False


func test_rename_preserves_content() -> Bool:
	match mkstemp_path("blorp_rename_content_src_"):
		Ok(src):
			match mkstemp_path("blorp_rename_content_dst_"):
				Ok(dst):
					_ = remove_file(dst)
					_ = write_file(src, "preserved content")
					_ = rename(src, dst)
					content: Result[String, String] = read_file(dst)
					_ = remove_file(dst)
					match content:
						Ok(s): s == "preserved content"
						Err(_): False
				Err(_):
					_ = remove_file(src)
					False
		Err(_): False


func test_rename_nonexistent_fails() -> Bool:
	match mkstemp_path("blorp_rename_missing_src_"):
		Ok(src):
			match mkstemp_path("blorp_rename_missing_dst_"):
				Ok(dst):
					_ = remove_file(src)
					_ = remove_file(dst)
					result: Bool = rename(src, dst) == False
					_ = remove_file(dst)
					result
				Err(_):
					_ = remove_file(src)
					False
		Err(_): False


-- ============================================================================
-- exec_output
-- ============================================================================
func test_exec_output_echo() -> Bool:
	r: Result[String, String] = exec_output("echo hello")
	match r:
		Ok(s): s == "hello"
		Err(_): False


func test_exec_output_multiword() -> Bool:
	r: Result[String, String] = exec_output("echo hello world")
	match r:
		Ok(s): s == "hello world"
		Err(_): False


func test_exec_output_failed_command() -> Bool:
	r: Result[String, String] = exec_output("false")
	match r:
		Ok(_): False
		Err(_): True


func test_exec_output_empty_command() -> Bool:
	r: Result[String, String] = exec_output("")
	match r:
		Ok(_): False
		Err(e): e == "empty command"


func test_exec_output_strips_newline() -> Bool:
	r: Result[String, String] = exec_output("printf 'no newline'")
	match r:
		Ok(s): s == "no newline"
		Err(_): False


tests: TestSuite = {
	description = "Filesystem Operations",
	tests = [
		("getcwd nonempty", test_getcwd_nonempty),
		("getcwd starts with /", test_getcwd_starts_with_slash),
		("getcwd deterministic", test_getcwd_deterministic),
		("mkdir creates dir", test_mkdir_creates_dir),
		("mkdir duplicate fails", test_mkdir_duplicate_fails),
		("remove_dir success", test_remove_dir_success),
		("remove_dir nonexistent", test_remove_dir_nonexistent),
		("remove_file success", test_remove_file_success),
		("remove_file nonexistent", test_remove_file_nonexistent),
		("remove_file verify gone", test_remove_file_verify_gone),
		("rename file", test_rename_file),
		("rename preserves content", test_rename_preserves_content),
		("rename nonexistent fails", test_rename_nonexistent_fails),
		("exec_output echo", test_exec_output_echo),
		("exec_output multiword", test_exec_output_multiword),
		("exec_output failed command", test_exec_output_failed_command),
		("exec_output empty command", test_exec_output_empty_command),
		("exec_output strips newline", test_exec_output_strips_newline),
	],
}
