-- Tests for read_file/read_bytes safety on non-seekable and edge-case files
import:
	string: length
	system: exec, read_bytes, read_file
	test: TestSuite


-- Test: read_file on a FIFO (non-seekable) returns Err instead of crashing
-- This exercises the ftell() == -1 guard
func test_read_fifo_returns_err() -> Bool:
	fifo_path: String = "/tmp/__blorp_test_fifo_safety"
	-- Create a FIFO
	_ = exec("rm -f /tmp/__blorp_test_fifo_safety && mkfifo /tmp/__blorp_test_fifo_safety")
	-- Write something to the FIFO in background so it doesn't block
	_ = exec("echo hello > /tmp/__blorp_test_fifo_safety &")
	result: Result[String, String] = read_file(fifo_path)
	-- Clean up
	_ = exec("rm -f /tmp/__blorp_test_fifo_safety")
	-- Should return Err (not crash) because FIFO is non-seekable
	match result:
		Ok(_): True -- Some systems may handle FIFOs; passing is OK
		Err(_): True -- Expected: ftell returns -1 on non-seekable


-- Test: read_bytes on a FIFO returns Err instead of crashing
func test_read_bytes_fifo_returns_err() -> Bool:
	fifo_path: String = "/tmp/__blorp_test_fifo_bytes_safety"
	_ = exec(
		"rm -f /tmp/__blorp_test_fifo_bytes_safety && mkfifo /tmp/__blorp_test_fifo_bytes_safety",
	)
	_ = exec("echo hello > /tmp/__blorp_test_fifo_bytes_safety &")
	result: Result[Bytes, String] = read_bytes(fifo_path)
	_ = exec("rm -f /tmp/__blorp_test_fifo_bytes_safety")
	match result:
		Ok(_): True
		Err(_): True


-- Test: read_file on normal file still works
func test_read_normal_file() -> Bool:
	_ = exec("printf 'test content' > /tmp/__blorp_test_read_normal")
	match read_file("/tmp/__blorp_test_read_normal"):
		Ok(content):
			_ = exec("rm -f /tmp/__blorp_test_read_normal")
			content == "test content"
		Err(_):
			_ = exec("rm -f /tmp/__blorp_test_read_normal")
			False


-- Test: read_file on empty file returns empty string
func test_read_empty_file() -> Bool:
	_ = exec("touch /tmp/__blorp_test_read_empty")
	match read_file("/tmp/__blorp_test_read_empty"):
		Ok(content):
			_ = exec("rm -f /tmp/__blorp_test_read_empty")
			content.length() == 0
		Err(_):
			_ = exec("rm -f /tmp/__blorp_test_read_empty")
			False


tests: TestSuite = {
	description = "Read File Safety",
	tests = [
		("read_file FIFO safety", test_read_fifo_returns_err),
		("read_bytes FIFO safety", test_read_bytes_fifo_returns_err),
		("read normal file", test_read_normal_file),
		("read empty file", test_read_empty_file),
	],
}
