import:
	debug: type_name
	test: TestSuite


func test_type_name_int() -> Bool:
	type_name(42) == "#42"


func test_type_name_string() -> Bool:
	type_name("hello") == "String"


func test_type_name_bool() -> Bool:
	type_name(True) == "Bool"


func test_type_name_float() -> Bool:
	type_name(3.14) == "Float"


func test_type_name_list() -> Bool:
	type_name([1, 2, 3]) == "List[Int]"


func test_type_name_option() -> Bool:
	x: Option[Int] = Some(42)
	type_name(x) == "Option[Int]"


func test_type_name_char() -> Bool:
	type_name('a') == "Char"


tests: TestSuite = {
	description = "Debug Utilities",
	tests = [
		("type_name Int", test_type_name_int),
		("type_name String", test_type_name_string),
		("type_name Bool", test_type_name_bool),
		("type_name Float", test_type_name_float),
		("type_name List", test_type_name_list),
		("type_name Option", test_type_name_option),
		("type_name Char", test_type_name_char),
	],
}
