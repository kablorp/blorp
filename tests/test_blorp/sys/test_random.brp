-- Test random number generation
import:
	random: choice, random_bool, random_float, random_int, seed_random
	test: TestSuite


tests: TestSuite = {
	description = "Random Number Generation",
	tests = [
		("seeded determinism", test_seeded_determinism),
		("int range", test_int_range),
		("float range", test_float_range),
		("random_bool works", test_random_bool),
		("choice empty list", test_choice_empty),
		("choice non-empty list", test_choice_nonempty),
		("equal range returns min", test_equal_range),
		("inverted range returns min", test_inverted_range),
	],
}


func test_seeded_determinism() -> Bool:
	seed_random(42)
	a1: Int = random_int(0, 100)
	a2: Int = random_int(0, 100)
	a3: Int = random_int(0, 100)
	seed_random(42)
	b1: Int = random_int(0, 100)
	b2: Int = random_int(0, 100)
	b3: Int = random_int(0, 100)
	a1 == b1 and a2 == b2 and a3 == b3


func test_int_range() -> Bool:
	seed_random(123)
	var all_in_range: Bool = True
	var i: Int = 0
	while i < 100:
		val: Int = random_int(10, 20)
		if val < 10 or val >= 20:
			all_in_range = False
		i += 1
	all_in_range


func test_float_range() -> Bool:
	seed_random(456)
	var all_in_range: Bool = True
	var i: Int = 0
	while i < 100:
		val: Float = random_float()
		if val < 0.0 or val >= 1.0:
			all_in_range = False
		i += 1
	all_in_range


func test_random_bool() -> Bool:
	seed_random(789)
	var saw_true: Bool = False
	var saw_false: Bool = False
	var i: Int = 0
	while i < 100:
		if random_bool():
			saw_true = True
		else:
			saw_false = True
		i += 1
	saw_true and saw_false


func test_choice_empty() -> Bool:
	seed_random(100)
	items: List[Int] = []
	result: Option[Int] = choice(items)
	match result:
		None: True
		_: False


func test_choice_nonempty() -> Bool:
	seed_random(200)
	items: List[Int] = [10, 20, 30, 40, 50]
	var all_valid: Bool = True
	var i: Int = 0
	while i < 20:
		result: Option[Int] = choice(items)
		match result:
			Some(v):
				if v != 10 and v != 20 and v != 30 and v != 40 and v != 50:
					all_valid = False
			None:
				all_valid = False
		i += 1
	all_valid


func test_equal_range() -> Bool:
	seed_random(300)
	random_int(5, 5) == 5


func test_inverted_range() -> Bool:
	seed_random(400)
	random_int(10, 5) == 10
