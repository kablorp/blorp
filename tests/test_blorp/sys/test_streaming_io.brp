import:
	system: append_file, file_size, for_each_chunk, read_file, remove_file, write_file
	test: TestSuite


func test_for_each_chunk_basic() -> Bool:
	_ = write_file("/tmp/__blorp_chunk_basic", "hello world!")
	_ = write_file("/tmp/__blorp_chunk_basic_out", "")
	result: Result[Void, String] = for_each_chunk("/tmp/__blorp_chunk_basic", 4096, func(
		chunk: String,
	):
		append_file("/tmp/__blorp_chunk_basic_out", chunk)
		void
	)
	match result:
		Ok(_):
			match read_file("/tmp/__blorp_chunk_basic_out"):
				Ok(content):
					_ = remove_file("/tmp/__blorp_chunk_basic")
					_ = remove_file("/tmp/__blorp_chunk_basic_out")
					content == "hello world!"
				Err(_): False
		Err(_): False


func test_for_each_chunk_small() -> Bool:
	_ = write_file("/tmp/__blorp_chunk_small", "abcdefghij")
	_ = write_file("/tmp/__blorp_chunk_small_out", "")
	result: Result[Void, String] = for_each_chunk("/tmp/__blorp_chunk_small", 3, func(
		chunk: String,
	):
		append_file("/tmp/__blorp_chunk_small_out", chunk.length().to_string())
		void
	)
	match result:
		Ok(_):
			match read_file("/tmp/__blorp_chunk_small_out"):
				Ok(content):
					_ = remove_file("/tmp/__blorp_chunk_small")
					_ = remove_file("/tmp/__blorp_chunk_small_out")
					-- 10 bytes / 3 byte chunks = "3331" (3+3+3+1)
					content == "3331"
				Err(_): False
		Err(_): False


func test_for_each_chunk_missing_file() -> Bool:
	noop: (String) -> Void = func(chunk: String):
		void
	result: Result[Void, String] = for_each_chunk("/tmp/__blorp_nonexistent_chunk_file", 1024, noop)
	match result:
		Err(_): True
		Ok(_): False


func test_for_each_chunk_empty_file() -> Bool:
	_ = write_file("/tmp/__blorp_chunk_empty", "")
	_ = write_file("/tmp/__blorp_chunk_empty_out", "")
	result: Result[Void, String] = for_each_chunk("/tmp/__blorp_chunk_empty", 1024, func(
		chunk: String,
	):
		append_file("/tmp/__blorp_chunk_empty_out", "x")
		void
	)
	match result:
		Ok(_):
			match read_file("/tmp/__blorp_chunk_empty_out"):
				Ok(content):
					_ = remove_file("/tmp/__blorp_chunk_empty")
					_ = remove_file("/tmp/__blorp_chunk_empty_out")
					content == ""
				Err(_): False
		Err(_): False


func test_file_size_basic() -> Bool:
	_ = write_file("/tmp/__blorp_fsize2", "hello")
	r: Result[Int, String] = file_size("/tmp/__blorp_fsize2")
	_ = remove_file("/tmp/__blorp_fsize2")
	match r:
		Ok(n): n == 5
		Err(_): False


func test_file_size_missing() -> Bool:
	r: Result[Int, String] = file_size("/tmp/__blorp_nonexistent_fsize")
	match r:
		Ok(_): False
		Err(_): True


tests: TestSuite = {
	description = "Streaming I/O",
	tests = [
		("for_each_chunk basic", test_for_each_chunk_basic),
		("for_each_chunk small chunks", test_for_each_chunk_small),
		("for_each_chunk missing file", test_for_each_chunk_missing_file),
		("for_each_chunk empty file", test_for_each_chunk_empty_file),
		("file_size basic", test_file_size_basic),
		("file_size missing", test_file_size_missing),
	],
}
