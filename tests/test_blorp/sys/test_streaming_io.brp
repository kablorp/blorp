import:
	system: append_file, file_size, for_each_chunk, mkstemp_path, read_file, remove_file, write_file
	test: TestSuite


func test_for_each_chunk_basic() -> Bool:
	match mkstemp_path("blorp_chunk_basic_"):
		Ok(in_path):
			match mkstemp_path("blorp_chunk_basic_out_"):
				Ok(out_path):
					_ = write_file(in_path, "hello world!")
					_ = write_file(out_path, "")
					result: Result[Void, String] = for_each_chunk(
						in_path,
						4096,
						func(chunk: String):
							append_file(out_path, chunk)
							void
					)
					ok: Bool = match result:
						Ok(_):
							match read_file(out_path):
								Ok(content): content == "hello world!"
								Err(_): False
						Err(_): False
					_ = remove_file(in_path)
					_ = remove_file(out_path)
					ok
				Err(_):
					_ = remove_file(in_path)
					False
		Err(_): False


func test_for_each_chunk_small() -> Bool:
	match mkstemp_path("blorp_chunk_small_"):
		Ok(in_path):
			match mkstemp_path("blorp_chunk_small_out_"):
				Ok(out_path):
					_ = write_file(in_path, "abcdefghij")
					_ = write_file(out_path, "")
					result: Result[Void, String] = for_each_chunk(
						in_path,
						3,
						func(chunk: String):
							append_file(
								out_path,
								chunk.length().to_string()
							)
							void
					)
					ok: Bool = match result:
						Ok(_):
							match read_file(out_path):
								Ok(content):
									-- 10 bytes / 3 byte chunks = "3331" (3+3+3+1)
									content == "3331"
								Err(_): False
						Err(_): False
					_ = remove_file(in_path)
					_ = remove_file(out_path)
					ok
				Err(_):
					_ = remove_file(in_path)
					False
		Err(_): False


func test_for_each_chunk_missing_file() -> Bool:
	noop: (String) -> Void = func(chunk: String):
		void
	match mkstemp_path("blorp_chunk_missing_"):
		Ok(path):
			_ = remove_file(path)
			result: Result[Void, String] = for_each_chunk(path, 1024, noop)
			match result:
				Err(_): True
				Ok(_): False
		Err(_): False


func test_for_each_chunk_empty_file() -> Bool:
	match mkstemp_path("blorp_chunk_empty_"):
		Ok(in_path):
			match mkstemp_path("blorp_chunk_empty_out_"):
				Ok(out_path):
					_ = write_file(in_path, "")
					_ = write_file(out_path, "")
					result: Result[Void, String] = for_each_chunk(
						in_path,
						1024,
						func(chunk: String):
							append_file(out_path, "x")
							void
					)
					ok: Bool = match result:
						Ok(_):
							match read_file(out_path):
								Ok(content): content == ""
								Err(_): False
						Err(_): False
					_ = remove_file(in_path)
					_ = remove_file(out_path)
					ok
				Err(_):
					_ = remove_file(in_path)
					False
		Err(_): False


func test_file_size_basic() -> Bool:
	match mkstemp_path("blorp_stream_fsize_"):
		Ok(path):
			_ = write_file(path, "hello")
			r: Result[Int, String] = file_size(path)
			_ = remove_file(path)
			match r:
				Ok(n): n == 5
				Err(_): False
		Err(_): False


func test_file_size_missing() -> Bool:
	match mkstemp_path("blorp_stream_fsize_missing_"):
		Ok(path):
			_ = remove_file(path)
			r: Result[Int, String] = file_size(path)
			match r:
				Ok(_): False
				Err(_): True
		Err(_): False


tests: TestSuite = {
	description = "Streaming I/O",
	tests = [
		("for_each_chunk basic", test_for_each_chunk_basic),
		("for_each_chunk small chunks", test_for_each_chunk_small),
		("for_each_chunk missing file", test_for_each_chunk_missing_file),
		("for_each_chunk empty file", test_for_each_chunk_empty_file),
		("file_size basic", test_file_size_basic),
		("file_size missing", test_file_size_missing),
	],
}
