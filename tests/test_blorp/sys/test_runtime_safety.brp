-- Tests for runtime safety fixes: join overflow, bytes append, string concat, regex
import:
	bytes as B
	list as L: join
	regex as RE
	string: length
	test: TestSuite


-- ============================================================================
-- Join safety tests (regression for checked arithmetic in blorp_join)
-- ============================================================================
-- Test: join with separator works correctly
func test_join_basic() -> Bool:
	parts: List[String] = ["hello", "world", "foo"]
	result: String = parts.join(", ")
	result == "hello, world, foo"


-- Test: join with empty separator
func test_join_empty_sep() -> Bool:
	parts: List[String] = ["a", "b", "c"]
	result: String = parts.join("")
	result == "abc"


-- Test: join single element
func test_join_single() -> Bool:
	parts: List[String] = ["hello"]
	result: String = parts.join(", ")
	result == "hello"


-- Test: join empty list
func test_join_empty() -> Bool:
	parts: List[String] = []
	result: String = parts.join(", ")
	result.length() == 0


-- Test: join with long separator
func test_join_long_sep() -> Bool:
	parts: List[String] = ["a", "b"]
	result: String = parts.join("---separator---")
	result == "a---separator---b"


-- ============================================================================
-- Bytes append safety tests (regression for checked arithmetic)
-- ============================================================================
-- Test: bytes append works correctly
func test_bytes_append() -> Bool:
	a: Bytes = "hello".to_bytes()
	b: Bytes = " world".to_bytes()
	c: Bytes = B.append(a, b)
	B.to_string(c) == "hello world"


-- Test: bytes append empty
func test_bytes_append_empty() -> Bool:
	a: Bytes = "hello".to_bytes()
	b: Bytes = B.bytes(0)
	c: Bytes = B.append(a, b)
	B.to_string(c) == "hello"


-- ============================================================================
-- String concat safety tests (regression for growth overflow guard)
-- ============================================================================
-- Test: string concat works correctly
func test_string_concat() -> Bool:
	a: String = "hello"
	b: String = " world"
	c: String = a + b
	c == "hello world"


-- Test: multiple concats (exercises concat_consume growth path)
func test_string_concat_chain() -> Bool:
	var s: String = ""
	s += "a"
	s += "bb"
	s += "ccc"
	s += "dddd"
	s == "abbcccdddd"


-- ============================================================================
-- Regex safety tests (verify regex works after removing const-cast writes)
-- ============================================================================
-- Test: regex test works
func test_regex_test() -> Bool:
	match RE.test_regex("hello", "hello world"):
		Ok(b): b
		Err(_): False


-- Test: regex test no match
func test_regex_test_no_match() -> Bool:
	match RE.test_regex("xyz", "hello world"):
		Ok(b): not b
		Err(_): False


-- Test: regex find works
func test_regex_find() -> Bool:
	match RE.find("[0-9]+", "hello 42 world"):
		Ok(result):
			match result:
				Some(matches): L.length(matches) > 0
				None: False
		Err(_): False


-- Test: regex with special characters
func test_regex_special_chars() -> Bool:
	match RE.test_regex("foo\\.bar", "foo.bar"):
		Ok(b): b
		Err(_): False


tests: TestSuite = {
	description = "Runtime Safety",
	tests = [
		("join basic", test_join_basic),
		("join empty separator", test_join_empty_sep),
		("join single element", test_join_single),
		("join empty list", test_join_empty),
		("join long separator", test_join_long_sep),
		("bytes append", test_bytes_append),
		("bytes append empty", test_bytes_append_empty),
		("string concat", test_string_concat),
		("string concat chain", test_string_concat_chain),
		("regex test", test_regex_test),
		("regex test no match", test_regex_test_no_match),
		("regex find", test_regex_find),
		("regex special chars", test_regex_special_chars),
	],
}
