import:
	process: ProcessExit(Exited), ProcessStdin(BytesStdin), command, run_command
	test: TestSuite


func test_process_feedback_streams_all_three_pipes() -> Bool:
	request = { command(
		"sh",
		["-c", "read value; printf 'out:%s' \"$value\"; printf 'err:%s' \"$value\" >&2"],
	) | stdin = BytesStdin("payload\n".to_bytes()) }

	match run_command(request):
		Ok(result):
			(
				result.exit == Exited(0)
				and result.stdout.to_string() == "out:payload"
				and result.stderr.to_string() == "err:payload"
			)
		Err(_):
			False


tests: TestSuite = {
	description = "Process feedback fixture",
	tests = [("streams stdin, stdout, and stderr", test_process_feedback_streams_all_three_pipes)]
}
