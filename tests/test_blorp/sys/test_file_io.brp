-- Test file I/O functions
import:
	bytes as B
	system: mkstemp_path, read_bytes, read_file, remove_file, write_bytes, write_file
	test: TestSuite


tests: TestSuite = {
	description = "File I/O",
	tests = [
		("write and read file", test_write_read),
		("read nonexistent file", test_read_nonexistent),
		("write_bytes and read_bytes round-trip", test_bytes_roundtrip),
		("write_bytes preserves raw bytes", test_bytes_raw),
		("read_bytes nonexistent returns Err", test_bytes_nonexistent),
	],
}


func test_write_read() -> Bool:
	match mkstemp_path("blorp_file_"):
		Ok(path):
			content: String = "Hello, blorp!"
			result: Bool = match write_file(path, content):
				Err(_): False
				Ok(_):
					match read_file(path):
						Ok(data): equals(data, content)
						Err(_): False
			_ = remove_file(path)
			result
		Err(_): False


func test_read_nonexistent() -> Bool:
	match mkstemp_path("blorp_missing_file_"):
		Ok(path):
			_ = remove_file(path)
			match read_file(path):
				Err(_): True
				Ok(_): False
		Err(_): False


func test_bytes_roundtrip() -> Bool:
	match mkstemp_path("blorp_bytes_"):
		Ok(path):
			src: Bytes = "hello binary".to_bytes()
			result: Bool = match write_bytes(path, src):
				Err(_): False
				Ok(_):
					match read_bytes(path):
						Ok(got): B.to_string(got) == "hello binary"
						Err(_): False
			_ = remove_file(path)
			result
		Err(_): False


func check_byte(b: Bytes, idx: Int, expected: Int) -> Bool:
	match B.get(b, idx):
		Some(v): v == expected
		None: False


func test_bytes_raw() -> Bool:
	match mkstemp_path("blorp_bytes_raw_"):
		Ok(path):
			var src: Bytes = B.bytes(4)
			src = B.set_index(src, 0, 0)
			src = B.set_index(src, 1, 255)
			src = B.set_index(src, 2, 128)
			src = B.set_index(src, 3, 1)
			_ = write_bytes(path, src)
			result: Bool = match read_bytes(path):
				Ok(got): check_byte(
					got,
					0,
					0,
				) and check_byte(got, 1, 255) and check_byte(got, 2, 128) and check_byte(got, 3, 1)
				Err(_): False
			_ = remove_file(path)
			result
		Err(_): False


func test_bytes_nonexistent() -> Bool:
	match mkstemp_path("blorp_missing_bytes_"):
		Ok(path):
			_ = remove_file(path)
			match read_bytes(path):
				Err(_): True
				Ok(_): False
		Err(_): False
