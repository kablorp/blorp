import:
	test: TestSuite
	time:
		Instant,
		format_rfc3339,
		from_iso,
		instant_from_posix_microseconds,
		instant_to_posix_microseconds,
		parse_rfc3339,


func is_none(value: Option[Int]) -> Bool:
	match value:
		None: True
		Some(_): False


func instant_is_none(value: Option[Instant]) -> Bool:
	match value:
		None: True
		Some(_): False


func test_from_iso_rejects_invalid_day() -> Bool:
	is_none(from_iso("2024-02-31T00:00:00Z"))


func test_from_iso_rejects_unknown_zone_marker() -> Bool:
	is_none(from_iso("2024-01-15T10:30:00X"))


func test_from_iso_rejects_trailing_junk() -> Bool:
	is_none(from_iso("2024-01-15T10:30:00Zjunk"))


func test_from_iso_rejects_nondigit_offset() -> Bool:
	is_none(from_iso("2024-01-15T10:30:00+aa:bb"))


func test_from_iso_rejects_empty_fraction() -> Bool:
	is_none(from_iso("2024-01-15T10:30:00.Z"))


func test_from_iso_rejects_missing_offset() -> Bool:
	is_none(from_iso("2024-01-15T10:30:00"))


func test_from_iso_rejects_offset_without_colon() -> Bool:
	is_none(from_iso("2024-01-15T10:30:00+0530"))


func test_from_iso_rejects_offset_hour_above_range() -> Bool:
	is_none(from_iso("2024-01-15T10:30:00+24:00"))


func test_from_iso_rejects_offset_minute_above_range() -> Bool:
	is_none(from_iso("2024-01-15T10:30:00+05:60"))


func test_from_iso_accepts_upper_offset_boundary() -> Bool:
	match from_iso("2024-01-15T23:59:59+14:00"):
		Some(value): value == 1705312799000000
		None: False


func test_from_iso_accepts_lower_offset_boundary() -> Bool:
	match from_iso("2024-01-15T00:00:00-12:00"):
		Some(value): value == 1705320000000000
		None: False


func test_from_iso_accepts_positive_zero_offset() -> Bool:
	match from_iso("2024-01-15T10:30:00+00:00"):
		Some(value): value == 1705314600000000
		None: False


func test_from_iso_rejects_unknown_zero_offset() -> Bool:
	is_none(from_iso("2024-01-15T10:30:00-00:00"))


func test_from_iso_truncates_fraction_after_microseconds() -> Bool:
	match from_iso("2024-01-15T10:30:00.123456789Z"):
		Some(value): value == 1705314600123456
		None: False


func test_parse_rfc3339_accepts_lowercase_t_and_z() -> Bool:
	match parse_rfc3339("2024-01-15t10:30:00z"):
		Some(instant): instant_to_posix_microseconds(instant) == 1705314600000000
		None: False


func test_parse_rfc3339_rejects_date_only() -> Bool:
	instant_is_none(parse_rfc3339("2024-01-15"))


func test_parse_rfc3339_rejects_no_offset_datetime() -> Bool:
	instant_is_none(parse_rfc3339("2024-01-15T10:30:00"))


func test_parse_rfc3339_rejects_leap_second() -> Bool:
	instant_is_none(parse_rfc3339("2024-01-15T10:30:60Z"))


func test_parse_rfc3339_rejects_unknown_offset_marker() -> Bool:
	instant_is_none(parse_rfc3339("2024-01-15T10:30:00-00:00"))


func test_parse_rfc3339_accepts_positive_zero_offset() -> Bool:
	match parse_rfc3339("2024-01-15T10:30:00+00:00"):
		Some(instant): instant_to_posix_microseconds(instant) == 1705314600000000
		None: False


func test_format_rfc3339_preserves_microseconds() -> Bool:
	t: Instant = instant_from_posix_microseconds(1705314600123456)
	format_rfc3339(t) == "2024-01-15T10:30:00.123456Z"


func test_format_rfc3339_preserves_negative_microsecond_fraction() -> Bool:
	t: Instant = instant_from_posix_microseconds(-1)
	format_rfc3339(t) == "1969-12-31T23:59:59.999999Z"


tests: TestSuite = {
	description = "Time ISO/RFC3339 strictness",
	tests = [
		("from_iso rejects invalid day", test_from_iso_rejects_invalid_day),
		("from_iso rejects unknown zone marker", test_from_iso_rejects_unknown_zone_marker),
		("from_iso rejects trailing junk", test_from_iso_rejects_trailing_junk),
		("from_iso rejects nondigit offset", test_from_iso_rejects_nondigit_offset),
		("from_iso rejects empty fraction", test_from_iso_rejects_empty_fraction),
		("from_iso rejects missing offset", test_from_iso_rejects_missing_offset),
		("from_iso rejects offset without colon", test_from_iso_rejects_offset_without_colon),
		("from_iso rejects offset hour above range", test_from_iso_rejects_offset_hour_above_range),
		(
			"from_iso rejects offset minute above range",
			test_from_iso_rejects_offset_minute_above_range,
		),
		("from_iso accepts upper offset boundary", test_from_iso_accepts_upper_offset_boundary),
		("from_iso accepts lower offset boundary", test_from_iso_accepts_lower_offset_boundary),
		("from_iso accepts positive zero offset", test_from_iso_accepts_positive_zero_offset),
		("from_iso rejects unknown zero offset", test_from_iso_rejects_unknown_zero_offset),
		(
			"from_iso truncates fraction after microseconds",
			test_from_iso_truncates_fraction_after_microseconds,
		),
		("parse_rfc3339 accepts lowercase t and z", test_parse_rfc3339_accepts_lowercase_t_and_z),
		("parse_rfc3339 rejects date only", test_parse_rfc3339_rejects_date_only),
		("parse_rfc3339 rejects no offset datetime", test_parse_rfc3339_rejects_no_offset_datetime),
		("parse_rfc3339 rejects leap second", test_parse_rfc3339_rejects_leap_second),
		(
			"parse_rfc3339 rejects unknown offset marker",
			test_parse_rfc3339_rejects_unknown_offset_marker,
		),
		(
			"parse_rfc3339 accepts positive zero offset",
			test_parse_rfc3339_accepts_positive_zero_offset,
		),
		("format_rfc3339 preserves microseconds", test_format_rfc3339_preserves_microseconds),
		(
			"format_rfc3339 preserves negative microsecond fraction",
			test_format_rfc3339_preserves_negative_microsecond_fraction,
		),
	]
}
