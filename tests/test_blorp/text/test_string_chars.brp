import:
	string: chars, from_chars, length
	test: TestSuite


pure func test_chars_round_trip() -> Bool:
	from_chars(chars("hello")) == "hello"


pure func test_chars_empty() -> Bool:
	from_chars(chars("")) == ""


pure func test_chars_single() -> Bool:
	from_chars(chars("x")) == "x"


pure func test_from_chars_abc() -> Bool:
	from_chars(['a', 'b', 'c']) == "abc"


pure func test_chars_length() -> Bool:
	s: String = "hello world"
	cs: List[Char] = chars(s)
	from_chars(cs).length() == s.length()


pure func test_chars_preserves_spaces() -> Bool:
	from_chars(chars("a b c")) == "a b c"


pure func test_chars_special() -> Bool:
	from_chars(chars("!@#")) == "!@#"


tests: TestSuite = {
	description = "String Character Conversion",
	tests = [
		("chars round trip", test_chars_round_trip),
		("chars empty", test_chars_empty),
		("chars single", test_chars_single),
		("from_chars abc", test_from_chars_abc),
		("chars length", test_chars_length),
		("chars preserves spaces", test_chars_preserves_spaces),
		("chars special", test_chars_special),
	],
}
