import:
	list as L
	string: indent, indices_of, insert, is_blank, is_lower, is_upper, split_once, to_base, truncate
	test: TestSuite


-- ===== split_once =====
func test_split_once_found() -> Bool:
	match split_once("key=value", "="):
		Some(pair): pair.0 == "key" and pair.1 == "value"
		None: False


func test_split_once_multi_char() -> Bool:
	match split_once("a::b::c", "::"):
		Some(pair): pair.0 == "a" and pair.1 == "b::c"
		None: False


func test_split_once_not_found() -> Bool:
	match split_once("hello", "="):
		Some(_): False
		None: True


func test_split_once_at_start() -> Bool:
	match split_once("=value", "="):
		Some(pair): pair.0 == "" and pair.1 == "value"
		None: False


func test_split_once_at_end() -> Bool:
	match split_once("key=", "="):
		Some(pair): pair.0 == "key" and pair.1 == ""
		None: False


func test_split_once_empty() -> Bool:
	match split_once("", "="):
		Some(_): False
		None: True


-- ===== is_blank =====
func test_is_blank_empty() -> Bool:
	is_blank("") == True


func test_is_blank_spaces() -> Bool:
	is_blank("   ") == True


func test_is_blank_tabs_newlines() -> Bool:
	is_blank(" \t\n ") == True


func test_is_blank_not_blank() -> Bool:
	is_blank("  x  ") == False


func test_is_blank_single_char() -> Bool:
	is_blank("a") == False


-- ===== is_lower / is_upper =====
func test_is_lower_all() -> Bool:
	is_lower("hello") == True


func test_is_lower_with_digits() -> Bool:
	is_lower("hello123") == True


func test_is_lower_with_upper() -> Bool:
	is_lower("Hello") == False


func test_is_lower_empty() -> Bool:
	is_lower("") == False


func test_is_lower_no_letters() -> Bool:
	is_lower("123") == False


func test_is_upper_all() -> Bool:
	is_upper("HELLO") == True


func test_is_upper_with_digits() -> Bool:
	is_upper("HELLO123") == True


func test_is_upper_with_lower() -> Bool:
	is_upper("Hello") == False


func test_is_upper_empty() -> Bool:
	is_upper("") == False


-- ===== indent =====
func test_indent_basic() -> Bool:
	indent("a\nb", "  ") == "  a\n  b"


func test_indent_empty_lines() -> Bool:
	indent("a\n\nb", "  ") == "  a\n\n  b"


func test_indent_single_line() -> Bool:
	indent("hello", "--") == "--hello"


func test_indent_empty() -> Bool:
	indent("", "  ") == ""


-- ===== truncate =====
func test_truncate_long() -> Bool:
	truncate("hello world", 8, "...") == "hello..."


func test_truncate_short() -> Bool:
	truncate("hi", 10, "...") == "hi"


func test_truncate_exact() -> Bool:
	truncate("hello", 5, "...") == "hello"


func test_truncate_empty_suffix() -> Bool:
	truncate("hello world", 5, "") == "hello"


-- ===== insert =====
func test_insert_middle() -> Bool:
	"helo".insert(3, "l") == "hello"


func test_insert_start() -> Bool:
	"world".insert(0, "hello ") == "hello world"


func test_insert_end() -> Bool:
	"hello".insert(5, " world") == "hello world"


-- ===== to_base =====
func test_to_base_binary() -> Bool:
	to_base(10, 2) == "1010"


func test_to_base_octal() -> Bool:
	to_base(255, 8) == "377"


func test_to_base_hex() -> Bool:
	to_base(255, 16) == "ff"


func test_to_base_decimal() -> Bool:
	to_base(42, 10) == "42"


func test_to_base_zero() -> Bool:
	to_base(0, 16) == "0"


-- ===== indices_of =====
func test_indices_of_found() -> Bool:
	result: List[Int] = indices_of("abcabc", "a")
	L.length(result) == 2 and match L.get(result, 0):
		Some(i): i == 0
		None: False


func test_indices_of_multi_char() -> Bool:
	result: List[Int] = indices_of("aabaa", "aa")
	L.length(result) == 2 and match L.get(result, 0):
		Some(i): i == 0
		None: False


func test_indices_of_none() -> Bool:
	result: List[Int] = indices_of("hello", "z")
	L.length(result) == 0


func test_indices_of_empty() -> Bool:
	result: List[Int] = indices_of("", "a")
	L.length(result) == 0


tests: TestSuite = {
	description = "New String Functions",
	tests = [
		("split_once found", test_split_once_found),
		("split_once multi-char delim", test_split_once_multi_char),
		("split_once not found", test_split_once_not_found),
		("split_once at start", test_split_once_at_start),
		("split_once at end", test_split_once_at_end),
		("split_once empty", test_split_once_empty),
		("is_blank empty", test_is_blank_empty),
		("is_blank spaces", test_is_blank_spaces),
		("is_blank tabs newlines", test_is_blank_tabs_newlines),
		("is_blank not blank", test_is_blank_not_blank),
		("is_blank single char", test_is_blank_single_char),
		("is_lower all lowercase", test_is_lower_all),
		("is_lower with digits", test_is_lower_with_digits),
		("is_lower with upper", test_is_lower_with_upper),
		("is_lower empty", test_is_lower_empty),
		("is_lower no letters", test_is_lower_no_letters),
		("is_upper all caps", test_is_upper_all),
		("is_upper with digits", test_is_upper_with_digits),
		("is_upper with lower", test_is_upper_with_lower),
		("is_upper empty", test_is_upper_empty),
		("indent basic", test_indent_basic),
		("indent empty lines", test_indent_empty_lines),
		("indent single line", test_indent_single_line),
		("indent empty", test_indent_empty),
		("truncate long", test_truncate_long),
		("truncate short", test_truncate_short),
		("truncate exact", test_truncate_exact),
		("truncate empty suffix", test_truncate_empty_suffix),
		("insert middle", test_insert_middle),
		("insert start", test_insert_start),
		("insert end", test_insert_end),
		("to_base binary", test_to_base_binary),
		("to_base octal", test_to_base_octal),
		("to_base hex", test_to_base_hex),
		("to_base decimal", test_to_base_decimal),
		("to_base zero", test_to_base_zero),
		("indices_of found", test_indices_of_found),
		("indices_of multi-char", test_indices_of_multi_char),
		("indices_of none", test_indices_of_none),
		("indices_of empty", test_indices_of_empty),
	],
}
