import:
	string: parse_float, parse_int
	test: TestSuite


-- Test parse_int and parse_float builtins
func test_parse_int_valid() -> Bool:
	match parse_int("42"):
		Some(n): n == 42
		None: False


func test_parse_int_negative() -> Bool:
	match parse_int("-7"):
		Some(n): n == -7
		None: False


func test_parse_int_zero() -> Bool:
	match parse_int("0"):
		Some(n): n == 0
		None: False


func test_parse_int_empty() -> Bool:
	match parse_int(""):
		Some(n): False
		None: True


func test_parse_int_invalid() -> Bool:
	match parse_int("abc"):
		Some(n): False
		None: True


func test_parse_int_trailing() -> Bool:
	match parse_int("42abc"):
		Some(n): False
		None: True


func test_parse_float_valid() -> Bool:
	match parse_float("3.14"):
		Some(f): f == 3.14
		None: False


func test_parse_float_integer() -> Bool:
	match parse_float("42"):
		Some(f): f == 42.0
		None: False


func test_parse_float_negative() -> Bool:
	match parse_float("-2.5"):
		Some(f): f == -2.5
		None: False


func test_parse_float_empty() -> Bool:
	match parse_float(""):
		Some(f): False
		None: True


func test_parse_float_invalid() -> Bool:
	match parse_float("xyz"):
		Some(f): False
		None: True


tests: TestSuite = {
	description = "Parse number tests",
	tests = [
		("parse_int valid", test_parse_int_valid),
		("parse_int negative", test_parse_int_negative),
		("parse_int zero", test_parse_int_zero),
		("parse_int empty", test_parse_int_empty),
		("parse_int invalid", test_parse_int_invalid),
		("parse_int trailing chars", test_parse_int_trailing),
		("parse_float valid", test_parse_float_valid),
		("parse_float integer", test_parse_float_integer),
		("parse_float negative", test_parse_float_negative),
		("parse_float empty", test_parse_float_empty),
		("parse_float invalid", test_parse_float_invalid),
	],
}
