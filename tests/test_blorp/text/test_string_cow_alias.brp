-- Test String COW Alias Independence
-- Verifies that aliasing a string and then appending to the original
-- does NOT corrupt the alias.
import:
	string: string
	test: TestSuite


-- Test: aliased string unchanged after append
func test_string_alias_unchanged() -> Bool:
	sb: String = string(50)
	sb2: String = sb.append_str("hello")
	ref: String = sb2
	sb3: String = sb2.append_str(" world")
	ref == "hello" and sb3 == "hello world"


-- Test: multiple refs preserved after mutation
func test_multiple_refs_preserved() -> Bool:
	sb: String = string(50)
	sb2: String = sb.append_str("base")
	ref1: String = sb2
	ref2: String = sb2
	ref3: String = sb2
	modified: String = ref1.append_str(" modified")

	(
		sb2 == "base"
		and ref1 == "base"
		and ref2 == "base"
		and ref3 == "base"
		and modified == "base modified"
	)


-- Test: function param does not corrupt caller's string
func append_helper(s: String) -> String:
	s.append_str(" added")


func test_function_param() -> Bool:
	sb: String = string(50)
	original: String = sb.append_str("keep")
	result: String = append_helper(original)
	original == "keep" and result == "keep added"


func test_append_self() -> Bool:
	original: String = string(8).append_str("ab")
	doubled: String = original.append_str(original)
	original == "ab" and doubled == "abab"


func test_accumulator_alias_unchanged() -> Bool:
	var accumulator: String = string(16).append_str("hello")
	saved: String = accumulator
	accumulator += " world"
	saved == "hello" and accumulator == "hello world"


func test_accumulator_append_self() -> Bool:
	var accumulator: String = "ab"
	accumulator += accumulator
	accumulator == "abab"


tests: TestSuite = {
	description = "String COW Alias Independence",
	tests = [
		("string alias unchanged", test_string_alias_unchanged),
		("multiple refs preserved", test_multiple_refs_preserved),
		("function param", test_function_param),
		("append self", test_append_self),
		("accumulator alias unchanged", test_accumulator_alias_unchanged),
		("accumulator append self", test_accumulator_append_self),
	]
}
