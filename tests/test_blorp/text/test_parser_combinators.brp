-- Test parser combinators
import:
	parser:
		ParseResult(Failure, Success),
		end_of_input,
		is_success,
		literal,
		optional,
		sep_by,
		take_while1,
	string: is_digit
	test: TestSuite


-- Helper: parse a number as String (avoids Char generic issue in sep_by)
pure func parse_num(input: String) -> ParseResult[String]:
	take_while1(is_digit, input)


-- Helper: parse comma as String
pure func comma_str(input: String) -> ParseResult[String]:
	literal(",", input)


func test_sep_by_comma_ints() -> Bool:
	match sep_by(parse_num, comma_str, "1,22,333"):
		Success(items, rest):
			items.length() == 3 and rest == ""
		Failure(_, _): False


func test_sep_by_single() -> Bool:
	match sep_by(parse_num, comma_str, "42"):
		Success(items, rest):
			items.length() == 1 and rest == ""
		Failure(_, _): False


func test_sep_by_empty() -> Bool:
	match sep_by(parse_num, comma_str, "abc"):
		Success(items, rest):
			items.length() == 0 and rest == "abc"
		Failure(_, _): False


func test_sep_by_trailing() -> Bool:
	match sep_by(parse_num, comma_str, "1,2 rest"):
		Success(items, rest):
			items.length() == 2 and rest == " rest"
		Failure(_, _): False


func test_optional_present() -> Bool:
	-- optional always returns Success, check that it succeeds
	is_success(optional(parse_num, "5abc"))


func test_optional_absent() -> Bool:
	-- optional with non-matching input still succeeds (returns None)
	is_success(optional(parse_num, "abc"))


func test_end_of_input_empty() -> Bool:
	is_success(end_of_input(""))


func test_end_of_input_not_empty() -> Bool:
	not is_success(end_of_input("abc"))


tests: TestSuite = {
	description = "Parser combinators",
	tests = [
		("sep_by comma ints", test_sep_by_comma_ints),
		("sep_by single", test_sep_by_single),
		("sep_by empty", test_sep_by_empty),
		("sep_by trailing", test_sep_by_trailing),
		("optional present", test_optional_present),
		("optional absent", test_optional_absent),
		("end_of_input empty", test_end_of_input_empty),
		("end_of_input not empty", test_end_of_input_not_empty),
	],
}
