import:
	test: TestSuite
	vector: sum


-- Test range slicing: v[start..end]
-- Basic slice: v[1..4] on 5-element vector
func test_basic_slice() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	s: Int[#3] = v[1..4]
	s[0] == 20 and s[1] == 30 and s[2] == 40


-- Full slice: v[0..5] == original
func test_full_slice() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	s: Int[#5] = v[0..5]
	s[0] == 10 and s[4] == 50


-- Single element slice: v[2..3]
func test_single_slice() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	s: Int[#1] = v[2..3]
	s[0] == 30


-- Sum of slice
func test_slice_sum() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	s: Int[#3] = v[1..4]
	sum(s) == 9


-- Float slice
func test_float_slice() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	s: Float[#2] = v[1..3]
	s[0] == 2.0 and s[1] == 3.0


-- Slice of slice: v[1..5][0..2]
func test_slice_of_slice() -> Bool:
	v: Int[#6] = {10, 20, 30, 40, 50, 60}
	s1: Int[#4] = v[1..5]
	s2: Int[#2] = s1[0..2]
	s2[0] == 20 and s2[1] == 30


-- Slice in reduction: sum(v[1..4])
func test_slice_in_reduction() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	sum(v[1..4]) == 9


tests: TestSuite = {
	description = "Range Slicing",
	tests = [
		("basic slice", test_basic_slice),
		("full slice", test_full_slice),
		("single element slice", test_single_slice),
		("slice sum", test_slice_sum),
		("float slice", test_float_slice),
		("slice of slice", test_slice_of_slice),
		("slice in reduction", test_slice_in_reduction),
	]
}
