-- Test unicode escape sequences at runtime
import:
	test: TestSuite


func test_cafe_length() -> Bool:
	s: String = "café"
	s.length() == 5


func test_emoji_length() -> Bool:
	s: String = "😀"
	s.length() == 4


func test_ascii_escape() -> Bool:
	"AB" == "AB"


func test_interp_unicode() -> Bool:
	x: Int = 42
	s: String = "café: ${x.to_string()}"
	s.length() > 5


tests: TestSuite = {
	description = "Unicode Escapes",
	tests = [
		("cafe length", test_cafe_length),
		("emoji length", test_emoji_length),
		("ascii escape", test_ascii_escape),
		("interp unicode", test_interp_unicode),
	],
}
