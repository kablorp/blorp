-- Deterministic test: String builtin allocation patterns
import:
	list: join
	string as Str
	test: TestSuite


-- split returns list of strings
func test_split_alloc() -> Bool:
	parts: List[String] = Str.split("a,b,c,d", ",")
	parts.length() == 4


-- join returns single string
func test_join_alloc() -> Bool:
	parts: List[String] = ["hello", "world", "test"]
	result: String = parts.join(" ")
	result == "hello world test"


-- replace returns new string
func test_replace_alloc() -> Bool:
	s: String = Str.replace("hello world", "world", "blorp")
	s == "hello blorp"


-- substring returns new string
func test_substring_alloc() -> Bool:
	s: String = Str.substring("hello world", 6, 5)
	s == "world"


-- trim returns new string
func test_trim_alloc() -> Bool:
	s: String = Str.trim("  hello  ")
	s == "hello"


-- upper/lower return new strings
func test_case_alloc() -> Bool:
	upper: String = Str.upper("hello")
	lower: String = Str.lower("HELLO")
	upper == "HELLO" and lower == "hello"


-- starts_with/ends_with (no alloc)
func test_starts_ends() -> Bool:
	s: String = "hello world"
	Str.starts_with(s, "hello") and Str.ends_with(s, "world")


-- contains (no alloc)
func test_contains() -> Bool:
	s: String = "hello world"
	Str.contains(s, "lo wo") and not Str.contains(s, "xyz")


-- index_of returns Option
func test_index_of() -> Bool:
	s: String = "hello world"
	match Str.index_of(s, "world"):
		Some(idx): idx == 6
		None: False


-- Multiple string operations
func test_chain_ops() -> Bool:
	s: String = "  Hello, World!  "
	trimmed: String = Str.trim(s)
	lower: String = Str.lower(trimmed)
	Str.starts_with(lower, "hello")


tests: TestSuite = {
	description = "Deterministic: String Builtin Allocs",
	tests = [
		("split alloc", test_split_alloc),
		("join alloc", test_join_alloc),
		("replace alloc", test_replace_alloc),
		("substring alloc", test_substring_alloc),
		("trim alloc", test_trim_alloc),
		("case alloc", test_case_alloc),
		("starts/ends", test_starts_ends),
		("contains", test_contains),
		("index_of", test_index_of),
		("chain ops", test_chain_ops),
	]
}
