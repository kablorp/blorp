import:
	string: string
	test: TestSuite


-- Test capacity-aware String functionality
-- Test basic string building
func test_append_char_basic() -> Bool:
	sb: String = string(16)
	sb2: String = sb.append_char('h')
	sb3: String = sb2.append_char('i')
	sb3 == "hi"


func test_append_char_unicode() -> Bool:
	e_accent: String = string(16).append_char('\u{E9}')
	cjk: String = string(16).append_char('\u{4E16}')
	emoji: String = string(16).append_char('\u{1F600}')
	e_accent == "é" and cjk == "世" and emoji == "😀" and e_accent.length() == 2 and cjk.length() == 3 and emoji.length() == 4


func test_append_char_invalid_codepoint_replacement() -> Bool:
	negative: String = string(16).append_char(to_char(-1))
	too_large: String = string(16).append_char(to_char(1114112))
	negative == "�" and too_large == "�" and negative.length() == 3 and too_large.length() == 3


-- Test append string
func test_append_string() -> Bool:
	sb: String = string(16)
	sb2: String = sb.append_str("hello")
	sb3: String = sb2.append_str(" world")
	sb3 == "hello world"


-- Test length tracking
func test_length() -> Bool:
	sb: String = string(16)
	sb2: String = sb.append_str("test")
	sb2.length() == 4


-- Test with capacity
func test_with_capacity() -> Bool:
	sb: String = string(100)
	var current: String = sb
	var i: Int = 0
	while i < 50:
		current = current.append_char('a')
		i += 1
	current.length() == 50


-- Test appending an integer string
func test_append_int() -> Bool:
	sb: String = string(16)
	sb2: String = sb.append_str(42.to_string())
	sb2 == "42"


-- Test appending a float string
func test_append_float() -> Bool:
	sb: String = string(16)
	sb2: String = sb.append_str(3.14.to_string())
	sb2.length() > 0


-- Test newline append via capacity-aware string
func test_append_line() -> Bool:
	sb: String = string(16)
	sb2: String = sb
		.append_str("hi")
		.append_char('\n')
	sb2.length() == 3


-- Test reset by constructing a new empty String
func test_clear() -> Bool:
	sb: String = string(16)
	sb2: String = sb.append_str("hello")
	cleared: String = string(16)
	cleared.length() == 0


func test_negative_capacity_is_safe() -> Bool:
	sb: String = string(-10)
	sb.append_char('x') == "x"


tests: TestSuite = {
	description = "String Capacity Tests",
	tests = [
		("append char basic", test_append_char_basic),
		("append char unicode", test_append_char_unicode),
		(
			"append char invalid codepoint replacement",
			test_append_char_invalid_codepoint_replacement,
		),
		("append string", test_append_string),
		("length tracking", test_length),
		("with capacity", test_with_capacity),
		("append int string", test_append_int),
		("append float string", test_append_float),
		("append line", test_append_line),
		("reset", test_clear),
		("negative capacity is safe", test_negative_capacity_is_safe),
	],
}
