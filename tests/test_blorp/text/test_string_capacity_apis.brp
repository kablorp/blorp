import:
	string: append, append_char, append_int, append_str, reserve, string
	test: TestSuite


func test_string_capacity_constructor() -> Bool:
	s: String = string(2)
	s.length() == 0


func test_string_append_char() -> Bool:
	var s: String = string(1)
	s = append_char(s, 'a')
	s = append_char(s, 'b')
	s == "ab"


func test_string_append_method_style() -> Bool:
	var s: String = string(1)
	s = s.append_char('x')
	s = s.append_str("yz")
	s == "xyz"


func test_string_append_alias() -> Bool:
	string(1).append("hi") == "hi"


func test_string_append_int() -> Bool:
	var s: String = string(8)
	s = append_int(s, 42)
	s = s.append_char(',')
	s = s.append_int(-7)
	s = s.append_char(',')
	s = s.append_int(0)
	s == "42,-7,0"


func test_string_reserve_method_style() -> Bool:
	var s: String = ""
	s = s.reserve(2)
	s = s.append_char('o')
	s = s.append_char('k')
	s == "ok"


tests: TestSuite = {
	description = "String capacity-aware APIs",
	tests = [
		("string capacity constructor", test_string_capacity_constructor),
		("append char from string module", test_string_append_char),
		("method-style string appends", test_string_append_method_style),
		("append alias", test_string_append_alias),
		("append int", test_string_append_int),
		("method-style reserve", test_string_reserve_method_style),
	]
}
