-- Test string repeat function
import:
	string: repeat
	test: TestSuite


func test_repeat_basic() -> Bool:
	"ab".repeat(3) == "ababab"


func test_repeat_single() -> Bool:
	"x".repeat(5) == "xxxxx"


func test_repeat_zero() -> Bool:
	"hello".repeat(0) == ""


func test_repeat_one() -> Bool:
	"hello".repeat(1) == "hello"


func test_repeat_empty_string() -> Bool:
	"".repeat(100) == ""


tests: TestSuite = {
	description = "String Repeat",
	tests = [
		("repeat basic", test_repeat_basic),
		("repeat single char", test_repeat_single),
		("repeat zero times", test_repeat_zero),
		("repeat once", test_repeat_one),
		("repeat empty string", test_repeat_empty_string),
	],
}
