import:
	codec: Value(VString, VRecord, VBool, VInt, VNull, VList, VFloat)
	list: get, length
	test: TestSuite
	yaml: encode, parse


pure func value_equal(a: Value, b: Value) -> Bool:
	match (a, b):
		(VNull, VNull):
			True
		(VBool(x), VBool(y)):
			x == y
		(VInt(x), VInt(y)):
			x == y
		(VFloat(x), VFloat(y)):
			x == y
		(VString(x), VString(y)):
			x == y
		(VList(xs), VList(ys)):
			if xs.length() != ys.length():
				False
			else:
				var ok: Bool = True
				var i: Int = 0

				while i < xs.length() and ok:
					match (xs.get(i), ys.get(i)):
						(Some(x), Some(y)):
							ok = value_equal(x, y)
						_:
							ok = False

					i += 1

				ok
		(VRecord(xs), VRecord(ys)):
			if xs.length() != ys.length():
				False
			else:
				var ok: Bool = True
				var i: Int = 0

				while i < xs.length() and ok:
					match (xs.get(i), ys.get(i)):
						(Some(x), Some(y)):
							ok = x[0] == y[0] and value_equal(x[1], y[1])
						_:
							ok = False

					i += 1

				ok
		_:
			False


func roundtrips(v: Value) -> Bool:
	match parse(encode(v)):
		Ok(parsed):
			value_equal(v, parsed)
		Err(_):
			False


-- ============================================================================
-- Scalar Parsing
-- ============================================================================
func test_parse_int() -> Bool:
	match parse("42"):
		Ok(VInt(n)):
			n == 42
		_:
			False


func test_parse_negative_int() -> Bool:
	match parse("-7"):
		Ok(VInt(n)):
			n == -7
		_:
			False


func test_parse_float() -> Bool:
	match parse("3.14"):
		Ok(VFloat(f)):
			f > 3.13 and f < 3.15
		_:
			False


func test_parse_bool_true() -> Bool:
	match parse("true"):
		Ok(VBool(b)):
			b == True
		_:
			False


func test_parse_bool_false() -> Bool:
	match parse("false"):
		Ok(VBool(b)):
			b == False
		_:
			False


func test_parse_bool_yes() -> Bool:
	match parse("yes"):
		Ok(VString(s)):
			s == "yes"
		_:
			False


func test_parse_bool_words_are_yaml12_strings() -> Bool:
	yes_string: Bool = match parse("yes"):
		Ok(VString(s)):
			s == "yes"
		_:
			False

	no_string: Bool = match parse("no"):
		Ok(VString(s)):
			s == "no"
		_:
			False

	on_string: Bool = match parse("on"):
		Ok(VString(s)):
			s == "on"
		_:
			False

	off_string: Bool = match parse("off"):
		Ok(VString(s)):
			s == "off"
		_:
			False

	yes_string and no_string and on_string and off_string


func test_parse_null() -> Bool:
	match parse("null"):
		Ok(VNull):
			True
		_:
			False


func test_parse_null_tilde() -> Bool:
	match parse("~"):
		Ok(VNull):
			True
		_:
			False


func test_parse_string() -> Bool:
	match parse("hello world"):
		Ok(VString(s)):
			s == "hello world"
		_:
			False


func test_parse_double_quoted() -> Bool:
	match parse("\"hello\\nworld\""):
		Ok(VString(s)):
			s.length() == 11
		_:
			False


func test_parse_single_quoted() -> Bool:
	match parse("'hello world'"):
		Ok(VString(s)):
			s == "hello world"
		_:
			False


-- ============================================================================
-- Mapping Parsing
-- ============================================================================
func test_parse_simple_mapping() -> Bool:
	match parse("name: Alice"):
		Ok(VRecord(pairs)):
			match get(pairs, 0):
				Some(pair):
					pair[0] == "name"
				None:
					False
		_:
			False


func test_parse_mapping_value() -> Bool:
	match parse("name: Alice"):
		Ok(VRecord(pairs)):
			match get(pairs, 0):
				Some(pair):
					match pair[1]:
						VString(s):
							s == "Alice"
						_:
							False
				None:
					False
		_:
			False


func test_parse_mapping_int_value() -> Bool:
	match parse("age: 30"):
		Ok(VRecord(pairs)):
			match get(pairs, 0):
				Some(pair):
					match pair[1]:
						VInt(n):
							n == 30
						_:
							False
				None:
					False
		_:
			False


func test_parse_multi_key_mapping() -> Bool:
	source: String = "name: Alice\nage: 30"

	match parse(source):
		Ok(VRecord(pairs)):
			pairs.length() == 2
		_:
			False


-- ============================================================================
-- Sequence Parsing
-- ============================================================================
func test_parse_sequence() -> Bool:
	source: String = "- 1\n- 2\n- 3"

	match parse(source):
		Ok(VList(items)):
			items.length() == 3
		_:
			False


func test_parse_sequence_values() -> Bool:
	source: String = "- hello\n- world"

	match parse(source):
		Ok(VList(items)):
			match get(items, 0):
				Some(VString(s)):
					s == "hello"
				_:
					False
		_:
			False


func test_parse_sequence_item_with_nested_mapping_on_next_line() -> Bool:
	source: String = "-\n  name: Alice\n-\n  name: Bob"

	match parse(source):
		Ok(VList(items)):
			match get(items, 0):
				Some(VRecord(pairs)):
					match get(pairs, 0):
						Some(pair):
							pair[0] == "name"
						None:
							False
				_:
					False
		_:
			False


func test_parse_sequence_item_with_nested_sequence_on_next_line() -> Bool:
	source: String = "-\n  - 1\n  - 2"

	match parse(source):
		Ok(VList(items)):
			match get(items, 0):
				Some(VList(nested)):
					nested.length() == 2
				_:
					False
		_:
			False


-- ============================================================================
-- Flow Syntax
-- ============================================================================
func test_parse_flow_sequence() -> Bool:
	match parse("[1, 2, 3]"):
		Ok(VList(items)):
			items.length() == 3
		_:
			False


func test_parse_flow_mapping() -> Bool:
	match parse("{name: Alice, age: 30}"):
		Ok(VRecord(pairs)):
			pairs.length() == 2
		_:
			False


func test_parse_empty_flow_sequence() -> Bool:
	match parse("[]"):
		Ok(VList(items)):
			items.length() == 0
		_:
			False


func test_parse_empty_flow_mapping() -> Bool:
	match parse("{}"):
		Ok(VRecord(pairs)):
			pairs.length() == 0
		_:
			False


-- ============================================================================
-- Document Start Marker
-- ============================================================================
func test_parse_with_document_marker() -> Bool:
	match parse("---\n42"):
		Ok(VInt(n)):
			n == 42
		_:
			False


-- ============================================================================
-- Encoding
-- ============================================================================
func test_encode_null() -> Bool:
	encode(VNull) == "null"


func test_encode_int() -> Bool:
	encode(VInt(42)) == "42"


func test_encode_bool_true() -> Bool:
	encode(VBool(True)) == "true"


func test_encode_string_simple() -> Bool:
	encode(VString("hello")) == "hello"


func test_encode_string_needs_quote() -> Bool:
	result: String = encode(VString("key: value"))
	result == "\"key: value\""


func test_encode_empty_list() -> Bool:
	encode(VList([])) == "[]"


func test_encode_empty_record() -> Bool:
	encode(VRecord([])) == "{}"


func test_parse_encode_roundtrip_scalars() -> Bool:
	(
		roundtrips(VString("yes"))
		and roundtrips(VString("key: value"))
		and roundtrips(VInt(42))
		and roundtrips(VBool(False))
	)


func test_parse_encode_roundtrip_nested_values() -> Bool:
	doc: Value = VRecord([
		("name", VString("Alice")),
		("items", VList([VInt(1), VInt(2)])),
		("meta", VRecord([("active", VBool(True))])),
	])
	roundtrips(doc)


func test_parse_encode_roundtrip_sequence_of_records() -> Bool:
	doc: Value = VList([
		VRecord([("name", VString("Alice"))]),
		VRecord([("name", VString("Bob"))]),
	])
	roundtrips(doc)


-- ============================================================================
-- Empty Input
-- ============================================================================
func test_parse_empty() -> Bool:
	match parse(""):
		Ok(VNull):
			True
		_:
			False


func is_err[T, E](result: Result[T, E]) -> Bool:
	match result:
		Ok(_):
			False
		Err(_):
			True


func expect_yaml_ok(source: String) -> Bool:
	match parse(source):
		Ok(_):
			True
		Err(_):
			False


func expect_yaml_err(source: String) -> Bool:
	match parse(source):
		Ok(_):
			False
		Err(_):
			True


func test_rejects_unsupported_features() -> Bool:
	anchor: Bool = is_err(parse("&defaults {a: 1}"))
	alias_value: Bool = is_err(parse("*defaults"))
	tag: Bool = is_err(parse("value: !str 1"))
	directive: Bool = is_err(parse("%YAML 1.2\n---\nvalue"))
	anchor and alias_value and tag and directive


func test_rejects_multi_document_and_trailing_input() -> Bool:
	multi_doc: Bool = is_err(parse("---\na: 1\n---\nb: 2"))
	trailing_scalar: Bool = is_err(parse("42\n43"))
	multi_doc and trailing_scalar


func test_rejects_unknown_double_quoted_escape() -> Bool:
	match parse("\"bad\\q\""):
		Ok(_):
			False
		Err(e):
			e.line == 1 and e.column == 6 and e.message == "invalid escape sequence"


func test_comments_and_inline_comments() -> Bool:
	source: String = "# header\nname: Alice # person\nitems:\n  - 1 # one\n  - 2"

	match parse(source):
		Ok(VRecord(pairs)):
			pairs.length() == 2
		_:
			False


func test_mixed_nested_sequence_mapping_indentation() -> Bool:
	source: String = "users:\n  - name: Alice\n    roles:\n      - admin\n      - dev\n  - name: Bob\n    roles:\n      - ops"

	match parse(source):
		Ok(VRecord(pairs)):
			match pairs.get(0):
				Some(pair):
					match pair[1]:
						VList(users):
							users.length() == 2
						_:
							False
				None:
					False
		_:
			False


func test_double_quoted_supported_escape_subset() -> Bool:
	match parse("\"a\\n\\t\\\\\\\"\\/b\""):
		Ok(VString(s)):
			s.length() == 7
		_:
			False


func test_double_quoted_rejected_escape_subset() -> Bool:
	cr: Bool = expect_yaml_err("\"\\r\"")
	backspace: Bool = expect_yaml_err("\"\\b\"")
	formfeed: Bool = expect_yaml_err("\"\\f\"")
	unicode: Bool = expect_yaml_err("\"\\u0041\"")
	cr and backspace and formfeed and unicode


func test_rejects_malformed_flow_collections() -> Bool:
	trailing_seq: Bool = expect_yaml_err("[1,]")
	double_comma_seq: Bool = expect_yaml_err("[1,,2]")
	missing_colon_map: Bool = expect_yaml_err("{name Alice}")
	trailing_map: Bool = expect_yaml_err("{name: Alice,}")
	trailing_seq and double_comma_seq and missing_colon_map and trailing_map


func test_encode_parse_normalizes_supported_sources() -> Bool:
	mapping_ok: Bool = match parse("name: Alice # person\nage: 30"):
		Ok(v):
			encode(v) == "name: Alice\nage: 30"
		Err(_):
			False

	flow_ok: Bool = match parse("{name: Alice, age: 30}"):
		Ok(v):
			encode(v) == "name: Alice\nage: 30"
		Err(_):
			False

	sequence_ok: Bool = match parse("[1, 2, 3]"):
		Ok(v):
			encode(v) == "- 1\n- 2\n- 3"
		Err(_):
			False

	mapping_ok and flow_ok and sequence_ok


func test_rejects_block_scalar_indicators() -> Bool:
	top_literal: Bool = is_err(parse("|"))
	mapping_literal: Bool = is_err(parse("text: |\n  hello"))
	mapping_chomped: Bool = is_err(parse("text: |-\n  hello"))
	mapping_folded: Bool = is_err(parse("text: >\n  hello"))
	top_literal and mapping_literal and mapping_chomped and mapping_folded


-- ============================================================================
-- Test Suite
-- ============================================================================
tests: TestSuite = {
	description = "YAML Tests",
	tests = [
		("parse int", test_parse_int),
		("parse negative int", test_parse_negative_int),
		("parse float", test_parse_float),
		("parse bool true", test_parse_bool_true),
		("parse bool false", test_parse_bool_false),
		("parse bool yes", test_parse_bool_yes),
		("parse bool words are yaml12 strings", test_parse_bool_words_are_yaml12_strings),
		("parse null", test_parse_null),
		("parse null tilde", test_parse_null_tilde),
		("parse string", test_parse_string),
		("parse double quoted", test_parse_double_quoted),
		("parse single quoted", test_parse_single_quoted),
		("parse simple mapping", test_parse_simple_mapping),
		("parse mapping value", test_parse_mapping_value),
		("parse mapping int value", test_parse_mapping_int_value),
		("parse multi key mapping", test_parse_multi_key_mapping),
		("parse sequence", test_parse_sequence),
		("parse sequence values", test_parse_sequence_values),
		(
			"parse sequence item with nested mapping on next line",
			test_parse_sequence_item_with_nested_mapping_on_next_line,
		),
		(
			"parse sequence item with nested sequence on next line",
			test_parse_sequence_item_with_nested_sequence_on_next_line,
		),
		("parse flow sequence", test_parse_flow_sequence),
		("parse flow mapping", test_parse_flow_mapping),
		("parse empty flow sequence", test_parse_empty_flow_sequence),
		("parse empty flow mapping", test_parse_empty_flow_mapping),
		("parse with document marker", test_parse_with_document_marker),
		("encode null", test_encode_null),
		("encode int", test_encode_int),
		("encode bool true", test_encode_bool_true),
		("encode string simple", test_encode_string_simple),
		("encode string needs quote", test_encode_string_needs_quote),
		("encode empty list", test_encode_empty_list),
		("encode empty record", test_encode_empty_record),
		("parse encode roundtrip scalars", test_parse_encode_roundtrip_scalars),
		("parse encode roundtrip nested values", test_parse_encode_roundtrip_nested_values),
		(
			"parse encode roundtrip sequence of records",
			test_parse_encode_roundtrip_sequence_of_records,
		),
		("parse empty", test_parse_empty),
		("rejects unsupported features", test_rejects_unsupported_features),
		(
			"rejects multi document and trailing input",
			test_rejects_multi_document_and_trailing_input,
		),
		("rejects unknown double quoted escape", test_rejects_unknown_double_quoted_escape),
		("comments and inline comments", test_comments_and_inline_comments),
		(
			"mixed nested sequence mapping indentation",
			test_mixed_nested_sequence_mapping_indentation,
		),
		("double quoted supported escape subset", test_double_quoted_supported_escape_subset),
		("double quoted rejected escape subset", test_double_quoted_rejected_escape_subset),
		("rejects malformed flow collections", test_rejects_malformed_flow_collections),
		(
			"encode parse normalizes supported sources",
			test_encode_parse_normalizes_supported_sources,
		),
		("rejects block scalar indicators", test_rejects_block_scalar_indicators),
	]
}
