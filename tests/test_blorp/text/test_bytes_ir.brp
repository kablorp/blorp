import:
	bytes:
		append as bytes_append,
		blit as bytes_blit,
		bytes as bytes_new,
		fill as bytes_fill,
		get as bytes_get,
		index_of as bytes_index_of,
		set_index as bytes_set,
		slice as bytes_slice,
	test: TestSuite


-- ============================================================================
-- New / Length
-- ============================================================================
func test_new_length() -> Bool:
	b: Bytes = bytes_new(10)
	b.length() == 10


func test_new_zero() -> Bool:
	b: Bytes = bytes_new(0)
	b.length() == 0


-- ============================================================================
-- Get
-- ============================================================================
func test_get_zeroed() -> Bool:
	b: Bytes = bytes_new(5)
	match bytes_get(b, 0):
		Some(v): v == 0
		None: False


func test_get_oob() -> Bool:
	b: Bytes = bytes_new(5)
	match bytes_get(b, 10):
		Some(_): False
		None: True


func test_get_negative() -> Bool:
	b: Bytes = bytes_new(5)
	match bytes_get(b, -1):
		Some(_): False
		None: True


-- ============================================================================
-- Set Index
-- ============================================================================
func test_set_and_get() -> Bool:
	b: Bytes = bytes_set(bytes_new(3), 1, 42)
	match bytes_get(b, 1):
		Some(v): v == 42
		None: False


func test_set_preserves_others() -> Bool:
	b: Bytes = bytes_set(bytes_new(3), 1, 42)
	match bytes_get(b, 0):
		Some(v): v == 0
		None: False


-- ============================================================================
-- Slice
-- ============================================================================
func test_slice_basic() -> Bool:
	b: Bytes = bytes_set(bytes_set(bytes_new(5), 1, 10), 2, 20)
	s: Bytes = bytes_slice(b, 1, 2)
	s.length() == 2


func test_slice_values() -> Bool:
	b: Bytes = bytes_set(bytes_set(bytes_new(5), 1, 10), 2, 20)
	s: Bytes = bytes_slice(b, 1, 2)
	match bytes_get(s, 0):
		Some(v): v == 10
		None: False


-- ============================================================================
-- Append
-- ============================================================================
func test_append_length() -> Bool:
	a: Bytes = bytes_new(3)
	b: Bytes = bytes_new(4)
	bytes_append(a, b).length() == 7


func test_append_values() -> Bool:
	a: Bytes = bytes_set(bytes_new(2), 0, 1)
	b: Bytes = bytes_set(bytes_new(2), 0, 2)
	c: Bytes = bytes_append(a, b)
	match bytes_get(c, 0):
		Some(v1):
			match bytes_get(c, 2):
				Some(v2): v1 == 1 and v2 == 2
				None: False
		None: False


-- ============================================================================
-- Fill
-- ============================================================================
func test_fill() -> Bool:
	b: Bytes = bytes_fill(bytes_new(3), 255)
	match bytes_get(b, 2):
		Some(v): v == 255
		None: False


-- ============================================================================
-- Index Of
-- ============================================================================
func test_index_of_found() -> Bool:
	b: Bytes = bytes_set(bytes_new(5), 3, 42)
	match bytes_index_of(b, 42, 0):
		Some(i): i == 3
		None: False


func test_index_of_not_found() -> Bool:
	b: Bytes = bytes_new(5)
	match bytes_index_of(b, 99, 0):
		Some(_): False
		None: True


func test_index_of_from_start() -> Bool:
	b: Bytes = bytes_set(bytes_set(bytes_new(5), 1, 42), 3, 42)
	match bytes_index_of(b, 42, 2):
		Some(i): i == 3
		None: False


-- ============================================================================
-- Blit
-- ============================================================================
func test_blit_basic() -> Bool:
	dst: Bytes = bytes_new(5)
	src: Bytes = bytes_set(bytes_set(bytes_new(3), 0, 10), 1, 20)
	result: Bytes = bytes_blit(dst, 1, src, 0, 2)
	match bytes_get(result, 1):
		Some(v1):
			match bytes_get(result, 2):
				Some(v2): v1 == 10 and v2 == 20
				None: False
		None: False


tests: TestSuite = {
	description = "Bytes IR Intrinsics",
	tests = [
		("new length", test_new_length),
		("new zero", test_new_zero),
		("get zeroed", test_get_zeroed),
		("get oob", test_get_oob),
		("get negative", test_get_negative),
		("set and get", test_set_and_get),
		("set preserves", test_set_preserves_others),
		("slice basic", test_slice_basic),
		("slice values", test_slice_values),
		("append length", test_append_length),
		("append values", test_append_values),
		("fill", test_fill),
		("index_of found", test_index_of_found),
		("index_of not found", test_index_of_not_found),
		("index_of from start", test_index_of_from_start),
		("blit", test_blit_basic),
	],
}
