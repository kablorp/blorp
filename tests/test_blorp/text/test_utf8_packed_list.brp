import:
	bytes: decode_utf8, encode_utf8
	string: from_chars
	test: TestSuite


func test_decode_get_set() -> Bool:
	match decode_utf8("ABC".to_bytes()):
		Some(chars):
			updated: List[Char] = chars.set(1, 'Z')
			from_chars(updated) == "AZC"
		None:
			False


func test_decode_round_trip() -> Bool:
	match decode_utf8(encode_utf8(['h', 'i'])):
		Some(chars):
			from_chars(chars) == "hi"
		None:
			False


tests: TestSuite = {
	description = "UTF-8 packed List[Char]",
	tests = [
		("decode get/set", test_decode_get_set),
		("decode round trip", test_decode_round_trip),
	],
}
