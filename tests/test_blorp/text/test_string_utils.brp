-- Test string utility functions
import:
	list: join
	string: contains, ends_with, index_of, replace, split, starts_with, substring, trim
	test: TestSuite


tests: TestSuite = {
	description = "String Utilities",
	tests = [
		("substring basic", test_substring_basic),
		("substring edge cases", test_substring_edge),
		("starts_with", test_starts_with),
		("ends_with", test_ends_with),
		("contains", test_contains),
		("index_of", test_index_of),
		("split", test_split),
		("join", test_join),
		("trim", test_trim),
		("replace", test_replace),
	],
}


func test_substring_basic() -> Bool:
	s: String = "Hello, World!"
	sub1: String = s.substring(0, 5)
	sub2: String = s.substring(7, 5)
	equals(sub1, "Hello") and equals(sub2, "World")


func test_substring_edge() -> Bool:
	s: String = "Hello"
	empty: String = s.substring(100, 5)
	full: String = s.substring(0, 100)
	equals(empty, "") and equals(full, "Hello")


func test_starts_with() -> Bool:
	s: String = "Hello, World!"
	s.starts_with("Hello") and s.starts_with("") and not s.starts_with("World")


func test_ends_with() -> Bool:
	s: String = "Hello, World!"
	s.ends_with("World!") and s.ends_with("") and not s.ends_with("Hello")


func test_contains() -> Bool:
	s: String = "Hello, World!"
	s.contains("World") and s.contains("") and not s.contains("xyz")


pure func check_index(result: Option[Int], expected: Int) -> Bool:
	match result:
		Some(v): v == expected
		None: False


pure func check_none(result: Option[Int]) -> Bool:
	match result:
		Some(_): False
		None: True


func test_index_of() -> Bool:
	s: String = "Hello, World!"
	check_index(
		index_of(
			s,
			"World",
		),
		7,
	) and check_none(s.index_of("xyz")) and check_index(s.index_of(""), 0)


func test_split() -> Bool:
	s: String = "a,b,c"
	parts: List[String] = s.split(",")
	equals(parts.length(), 3) and equals(parts.join(","), s)


func test_join() -> Bool:
	parts: List[String] = ["a", "b", "c"]
	joined: String = parts.join("-")
	equals(joined, "a-b-c")


func test_trim() -> Bool:
	s1: String = "  hello  "
	s2: String = "\t\nspaces\r\n"
	equals(trim(s1), "hello") and equals(trim(s2), "spaces")


func test_replace() -> Bool:
	s: String = "hello world world"
	r: String = s.replace("world", "there")
	equals(r, "hello there there")
