-- Test StringSlice functionality
import:
	slice as SS: from_string, get, is_empty
	test: TestSuite


-- Test basic slice creation
func test_from_string() -> Bool:
	s: String = "hello"
	slice: StringSlice = from_string(s)
	SS.length(slice) == 5


-- Test get (bounds-checked, returns Option)
func test_char_at() -> Bool:
	s: String = "abc"
	slice: StringSlice = from_string(s)
	ok1: Bool = match get(slice, 1):
		Some(c): c == 'b'
		None: False
	ok2: Bool = match get(slice, 10):
		Some(_): False
		None: True
	ok1 and ok2


-- Test subslice (zero-copy)
func test_substring() -> Bool:
	s: String = "hello world"
	slice: StringSlice = from_string(s)
	sub: StringSlice = SS.substring(slice, 0, 5)
	SS.to_string(sub) == "hello"


-- Test materialize
func test_to_string() -> Bool:
	s: String = "test"
	slice: StringSlice = from_string(s)
	SS.to_string(slice) == "test"


-- Test has_prefix
func test_starts_with() -> Bool:
	s: String = "hello world"
	slice: StringSlice = from_string(s)
	SS.starts_with(slice, "hello")


-- Test empty
func test_is_empty() -> Bool:
	s: String = ""
	slice: StringSlice = from_string(s)
	is_empty(slice)


-- Test chained subslices (zero-copy)
func test_chained_substring() -> Bool:
	s: String = "abcdefghij"
	slice: StringSlice = from_string(s)
	sub1: StringSlice = SS.substring(slice, 2, 6) -- "cdefgh"
	sub2: StringSlice = SS.substring(sub1, 1, 3) -- "def"
	SS.to_string(sub2) == "def"


-- Test ends_with
func test_ends_with() -> Bool:
	s: StringSlice = from_string("hello")
	SS.ends_with(s, "llo") and not SS.ends_with(s, "xyz")


-- Test contains
func test_contains() -> Bool:
	s: StringSlice = from_string("hello world")
	SS.contains(s, "world") and not SS.contains(s, "xyz")


-- Test index_of
func test_index_of() -> Bool:
	s: StringSlice = from_string("hello world")
	match SS.index_of(s, "world"):
		Some(i): i == 6
		None: False


-- Test trim
func test_trim() -> Bool:
	s: StringSlice = from_string("  hello  ")
	SS.to_string(SS.trim(s)) == "hello"


tests: TestSuite = {
	description = "StringSlice Tests",
	tests = [
		("from_string", test_from_string),
		("char_at", test_char_at),
		("substring", test_substring),
		("to_string", test_to_string),
		("starts_with", test_starts_with),
		("is_empty", test_is_empty),
		("chained substring", test_chained_substring),
		("ends_with", test_ends_with),
		("contains", test_contains),
		("index_of", test_index_of),
		("trim", test_trim),
	]
}
