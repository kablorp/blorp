import:
	html: escape, strip_tags, unescape
	test: TestSuite


-- Escape tests
func test_escape_tags() -> Bool:
	escape("<b>bold</b>") == "&lt;b&gt;bold&lt;/b&gt;"


func test_escape_amp() -> Bool:
	escape("a&b") == "a&amp;b"


func test_escape_quotes() -> Bool:
	escape("say \"hi\"") == "say &quot;hi&quot;"


func test_escape_passthrough() -> Bool:
	escape("hello") == "hello"


func test_escape_empty() -> Bool:
	escape("") == ""


-- Unescape tests
func test_unescape_lt_gt() -> Bool:
	unescape("&lt;b&gt;") == "<b>"


func test_unescape_amp() -> Bool:
	unescape("a&amp;b") == "a&b"


func test_unescape_quot() -> Bool:
	unescape("&quot;hi&quot;") == "\"hi\""


func test_unescape_apos() -> Bool:
	unescape("&#39;hi&#39;") == "'hi'"


func test_unescape_passthrough() -> Bool:
	unescape("hello") == "hello"


func test_unescape_unknown() -> Bool:
	unescape("&foo;") == "&foo;"


func test_roundtrip() -> Bool:
	unescape(escape("<div>a&b</div>")) == "<div>a&b</div>"


-- Strip tags tests
func test_strip_simple() -> Bool:
	strip_tags("<b>bold</b>") == "bold"


func test_strip_nested() -> Bool:
	strip_tags("<div><p>hello</p></div>") == "hello"


func test_strip_attrs() -> Bool:
	strip_tags("<a href=\"url\">link</a>") == "link"


func test_strip_none() -> Bool:
	strip_tags("plain text") == "plain text"


func test_strip_empty() -> Bool:
	strip_tags("") == ""


func test_strip_mixed() -> Bool:
	strip_tags("before<b>bold</b>after") == "beforeboldafter"


tests: TestSuite = {
	description = "HTML",
	tests = [
		("escape tags", test_escape_tags),
		("escape amp", test_escape_amp),
		("escape quotes", test_escape_quotes),
		("escape passthrough", test_escape_passthrough),
		("escape empty", test_escape_empty),
		("unescape lt gt", test_unescape_lt_gt),
		("unescape amp", test_unescape_amp),
		("unescape quot", test_unescape_quot),
		("unescape apos", test_unescape_apos),
		("unescape passthrough", test_unescape_passthrough),
		("unescape unknown", test_unescape_unknown),
		("roundtrip", test_roundtrip),
		("strip simple", test_strip_simple),
		("strip nested", test_strip_nested),
		("strip attrs", test_strip_attrs),
		("strip none", test_strip_none),
		("strip empty", test_strip_empty),
		("strip mixed", test_strip_mixed),
	],
}
