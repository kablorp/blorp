import:
	test: TestSuite
	toml as T: TomlError, TomlValue(TomlString, TomlInt, TomlTable, TomlArray, TomlBool, TomlFloat)


-- Basic string values
func test_string_value() -> Bool:
	result: Result[TomlValue, String] = T.parse("name = \"Alice\"")
	match result:
		Ok(toml): T.get_string(toml, "name") == Some("Alice")
		Err(_): False


func test_literal_string() -> Bool:
	result: Result[TomlValue, String] = T.parse("path = 'C:\\Users\\foo'")
	match result:
		Ok(toml): T.get_string(toml, "path") == Some("C:\\Users\\foo")
		Err(_): False


-- Integer values
func test_int_value() -> Bool:
	result: Result[TomlValue, String] = T.parse("port = 8080")
	match result:
		Ok(toml): T.get_int(toml, "port") == Some(8080)
		Err(_): False


-- Float values
func test_float_value() -> Bool:
	result: Result[TomlValue, String] = T.parse("pi = 3.14")
	match result:
		Ok(toml): T.get_float(toml, "pi") == Some(3.14)
		Err(_): False


-- Boolean values
func test_bool_true() -> Bool:
	result: Result[TomlValue, String] = T.parse("enabled = true")
	match result:
		Ok(toml): T.get_bool(toml, "enabled") == Some(True)
		Err(_): False


func test_bool_false() -> Bool:
	result: Result[TomlValue, String] = T.parse("debug = false")
	match result:
		Ok(toml): T.get_bool(toml, "debug") == Some(False)
		Err(_): False


-- Comments
func test_comments() -> Bool:
	source: String = "# This is a comment\nname = \"Bob\""
	result: Result[TomlValue, String] = T.parse(source)
	match result:
		Ok(toml): T.get_string(toml, "name") == Some("Bob")
		Err(_): False


-- Multiple keys
func test_multiple_keys() -> Bool:
	source: String = "host = \"localhost\"\nport = 9090"
	result: Result[TomlValue, String] = T.parse(source)
	match result:
		Ok(toml): T.get_string(
			toml,
			"host",
		) == Some("localhost") and T.get_int(toml, "port") == Some(9090)
		Err(_): False


-- Table sections (stored as flat keys: section.key)
func test_table_section() -> Bool:
	source: String = "[server]\nhost = \"localhost\"\nport = 8080"
	result: Result[TomlValue, String] = T.parse(source)
	match result:
		Ok(toml): T.get_string(
			toml,
			"server.host",
		) == Some("localhost") and T.get_int(toml, "server.port") == Some(8080)
		Err(_): False


func test_valid_subset_fixture() -> Bool:
	source: String = "# app config\ntitle = \"Example\"\n[owner]\nname = \"Ada\"\nactive = true\n[database]\nports = [8000, 8001]\npoint = { x = 1, y = 2 }"
	match T.parse(source):
		Ok(toml):
			title_ok: Bool = T.get_string(toml, "title") == Some("Example")
			owner_ok: Bool = T.get_string(toml, "owner.name") == Some("Ada")
			active_ok: Bool = T.get_bool(toml, "owner.active") == Some(True)
			ports_ok: Bool = match T.lookup(toml, "database.ports"):
				Some(TomlArray(items)): items.length() == 2
				_: False
			point_ok: Bool = match T.lookup(toml, "database.point"):
				Some(point): T.get_int(point, "x") == Some(1) and T.get_int(point, "y") == Some(2)
				None: False
			title_ok and owner_ok and active_ok and ports_ok and point_ok
		Err(_): False


-- Missing key
func test_missing_key() -> Bool:
	result: Result[TomlValue, String] = T.parse("name = \"Alice\"")
	match result:
		Ok(toml): T.get_string(toml, "age") == None
		Err(_): False


-- Empty input
func test_empty() -> Bool:
	result: Result[TomlValue, String] = T.parse("")
	match result:
		Ok(_): True
		Err(_): False


-- Escape sequences in strings
func test_escape_sequences() -> Bool:
	result: Result[TomlValue, String] = T.parse("msg = \"hello\\nworld\"")
	match result:
		Ok(toml): T.get_string(toml, "msg") == Some("hello\nworld")
		Err(_): False


-- Inline table
func test_inline_table() -> Bool:
	result: Result[TomlValue, String] = T.parse("point = { x = 1, y = 2 }")
	match result:
		Ok(toml):
			match T.lookup(toml, "point"):
				Some(pt): T.get_int(pt, "x") == Some(1) and T.get_int(pt, "y") == Some(2)
				None: False
		Err(_): False


-- Arrays
func test_string_array() -> Bool:
	result: Result[TomlValue, String] = T.parse("colors = [\"red\", \"green\", \"blue\"]")
	match result:
		Ok(toml):
			match T.lookup(toml, "colors"):
				Some(arr):
					match arr:
						TomlArray(items):
							match items:
								[TomlString(a), TomlString(b), TomlString(c)]:
									a == "red" and b == "green" and c == "blue"
								_: False
						_: False
				None: False
		Err(_): False


pure func is_toml_int(v: TomlValue, expected: Int) -> Bool:
	match v:
		TomlInt(n): n == expected
		_: False


func test_int_array() -> Bool:
	result: Result[TomlValue, String] = T.parse("nums = [1, 2, 3]")
	match result:
		Ok(toml):
			match T.lookup(toml, "nums"):
				Some(arr):
					match arr:
						TomlArray(items):
							match items:
								[a, b, c]:
									is_toml_int(a, 1) and is_toml_int(b, 2) and is_toml_int(c, 3)
								_: False
						_: False
				None: False
		Err(_): False


func test_empty_array() -> Bool:
	result: Result[TomlValue, String] = T.parse("items = []")
	match result:
		Ok(toml):
			match T.lookup(toml, "items"):
				Some(arr):
					match arr:
						TomlArray(items):
							match items:
								[]: True
								_: False
						_: False
				None: False
		Err(_): False


-- Inline comments
func test_inline_comment() -> Bool:
	result: Result[TomlValue, String] = T.parse("port = 8080 # HTTP port")
	match result:
		Ok(toml): T.get_int(toml, "port") == Some(8080)
		Err(_): False


func test_inline_comment_string() -> Bool:
	result: Result[TomlValue, String] = T.parse("name = \"Alice\" # user name")
	match result:
		Ok(toml): T.get_string(toml, "name") == Some("Alice")
		Err(_): False


func test_hash_in_string() -> Bool:
	result: Result[TomlValue, String] = T.parse("msg = \"hello # world\"")
	match result:
		Ok(toml): T.get_string(toml, "msg") == Some("hello # world")
		Err(_): False


func is_err[T](result: Result[T, String]) -> Bool:
	match result:
		Ok(_): False
		Err(_): True


func expect_toml_ok(input: String) -> Bool:
	match T.parse_detailed(input):
		Ok(_): True
		Err(_): False


func expect_toml_err(input: String) -> Bool:
	match T.parse_detailed(input):
		Ok(_): False
		Err(_): True


func test_rejects_malformed_line() -> Bool:
	is_err(T.parse("this is not toml"))


func test_rejects_missing_key() -> Bool:
	is_err(T.parse(" = 1"))


func test_rejects_bad_table_header() -> Bool:
	missing_close: Bool = is_err(T.parse("[server\nhost = \"localhost\""))
	empty_name: Bool = is_err(T.parse("[]\nhost = \"localhost\""))
	trailing_text: Bool = is_err(T.parse("[server] trailing"))
	array_table: Bool = is_err(T.parse("[[server]]\nhost = \"localhost\""))
	missing_close and empty_name and trailing_text and array_table


func test_rejects_unknown_values() -> Bool:
	bare_string: Bool = is_err(T.parse("name = Alice"))
	date_value: Bool = is_err(T.parse("date = 1979-05-27"))
	invalid_bool: Bool = is_err(T.parse("enabled = True"))
	bare_string and date_value and invalid_bool


func test_rejects_bad_arrays() -> Bool:
	missing_close: Bool = is_err(T.parse("items = [1, 2"))
	trailing_comma: Bool = is_err(T.parse("items = [1,]"))
	bad_item: Bool = is_err(T.parse("items = [1, nope]"))
	missing_close and trailing_comma and bad_item


func test_rejects_bad_inline_tables() -> Bool:
	missing_close: Bool = is_err(T.parse("point = { x = 1, y = 2"))
	missing_eq: Bool = is_err(T.parse("point = { x = 1, y }"))
	trailing_comma: Bool = is_err(T.parse("point = { x = 1, }"))
	missing_close and missing_eq and trailing_comma


func test_rejects_duplicate_keys() -> Bool:
	top_level: Bool = is_err(T.parse("port = 1\nport = 2"))
	table_key: Bool = is_err(T.parse("[server]\nport = 1\nport = 2"))
	inline_key: Bool = is_err(T.parse("point = { x = 1, x = 2 }"))
	top_level and table_key and inline_key


func test_error_includes_line_and_column_for_malformed_line() -> Bool:
	match T.parse("ok = 1\nnot toml"):
		Ok(_): False
		Err(e): e.contains("line 2") and e.contains("column 1")


func test_error_includes_line_and_column_for_bad_value() -> Bool:
	match T.parse("ok = 1\nname = Alice"):
		Ok(_): False
		Err(e): e.contains("line 2") and e.contains("column 8")


func test_parse_detailed_success() -> Bool:
	match T.parse_detailed("name = \"Alice\""):
		Ok(toml): T.get_string(toml, "name") == Some("Alice")
		Err(_): False


func test_parse_detailed_error_fields() -> Bool:
	match T.parse_detailed("ok = 1\nname = Alice"):
		Ok(_): False
		Err(e):
			e.line == 2 and e.column == 8 and e.message == "invalid value"


func test_format_parse_error() -> Bool:
	err: TomlError = {line = 4, column = 2, message = "bad key"}
	T.format_parse_error(err) == "line 4, column 2: bad key"


func test_toml_conformance_valid_subset_examples() -> Bool:
	values: List[String] = [
		"title = \"TOML Example\"",
		"# comment\nname = 'literal value'\nactive = true\ncount = 42",
		"[server]\nhost = \"localhost\"\nport = 8080",
		"point = { x = 1, y = 2 }\ncolors = [\"red\", \"green\", \"blue\"]",
		"nums = [1, 2, 3]\nratio = 1.25e-2\npath = 'C:\\Users\\example'",
	]
	var ok: Bool = True
	var i: Int = 0
	while i < values.length() and ok:
		match values.get(i):
			Some(input): ok = expect_toml_ok(input)
			None: ok = False
		i += 1
	ok


func test_toml_conformance_invalid_subset_examples() -> Bool:
	values: List[String] = [
		"bare = unquoted",
		"enabled = True",
		"date = 1979-05-27",
		"n = 1_000",
		"text = \"\"\"hello\"\"\"",
		"\"quoted\" = \"key\"",
		"items = [1,,2]",
		"point = { x = 1, x = 2 }",
		"[[products]]\nname = \"Hammer\"",
	]
	var ok: Bool = True
	var i: Int = 0
	while i < values.length() and ok:
		match values.get(i):
			Some(input): ok = expect_toml_err(input)
			None: ok = False
		i += 1
	ok


func test_rejects_unsupported_toml_features() -> Bool:
	date_value: Bool = is_err(T.parse("date = 1979-05-27"))
	time_value: Bool = is_err(T.parse("time = 07:32:00"))
	multiline_basic: Bool = is_err(T.parse("text = \"\"\"hello\"\"\""))
	multiline_literal: Bool = is_err(T.parse("text = '''hello'''"))
	numeric_separator: Bool = is_err(T.parse("n = 1_000"))
	infinity: Bool = is_err(T.parse("x = inf"))
	not_a_number: Bool = is_err(T.parse("x = nan"))
	quoted_key: Bool = is_err(T.parse("\"host\" = \"localhost\""))
	unicode_escape: Bool = is_err(T.parse("text = \"\\u0041\""))
	date_value and time_value and multiline_basic and multiline_literal and numeric_separator and infinity and not_a_number and quoted_key and unicode_escape


func test_rejects_invalid_conformance_style_examples() -> Bool:
	array_missing_comma: Bool = is_err(T.parse("items = [1 2]"))
	basic_string_newline: Bool = is_err(T.parse("text = \"hello\nworld\""))
	bad_inline_table_value: Bool = is_err(T.parse("point = { x = 1, y = nope }"))
	table_redefinition: Bool = is_err(T.parse("[server]\nhost = \"a\"\n[server]\nport = 1"))
	array_missing_comma and basic_string_newline and bad_inline_table_value and table_redefinition


func test_parser_and_decoder_errors_are_distinct() -> Bool:
	parser_error: Bool = match T.parse("port = nope"):
		Ok(_): False
		Err(e): e.contains("line 1") and e.contains("column 8")
	decoder_error: Bool = match T.parse("host = \"localhost\""):
		Ok(toml):
			match T.int_decoder("port", toml):
				Ok(_): False
				Err(e): e.path == "port" and e.message == "missing or not an integer"
		Err(_): False
	parser_error and decoder_error


-- Mixed types
func test_mixed_types() -> Bool:
	source: String = "name = \"test\"\ncount = 42\nratio = 0.5\nactive = true"
	result: Result[TomlValue, String] = T.parse(source)
	match result:
		Ok(toml):
			T.get_string(
				toml,
				"name",
			) == Some(
				"test",
			) and T.get_int(toml, "count") == Some(42) and T.get_bool(toml, "active") == Some(True)
		Err(_): False


tests: TestSuite = {
	description = "TOML",
	tests = [
		("string value", test_string_value),
		("literal string", test_literal_string),
		("int value", test_int_value),
		("float value", test_float_value),
		("bool true", test_bool_true),
		("bool false", test_bool_false),
		("comments", test_comments),
		("multiple keys", test_multiple_keys),
		("table section", test_table_section),
		("valid subset fixture", test_valid_subset_fixture),
		("missing key", test_missing_key),
		("empty input", test_empty),
		("escape sequences", test_escape_sequences),
		("inline table", test_inline_table),
		("mixed types", test_mixed_types),
		("string array", test_string_array),
		("int array", test_int_array),
		("empty array", test_empty_array),
		("inline comment", test_inline_comment),
		("inline comment string", test_inline_comment_string),
		("hash in string", test_hash_in_string),
		("rejects malformed line", test_rejects_malformed_line),
		("rejects missing key", test_rejects_missing_key),
		("rejects bad table header", test_rejects_bad_table_header),
		("rejects unknown values", test_rejects_unknown_values),
		("rejects bad arrays", test_rejects_bad_arrays),
		("rejects bad inline tables", test_rejects_bad_inline_tables),
		("rejects duplicate keys", test_rejects_duplicate_keys),
		(
			"error includes line and column for malformed line",
			test_error_includes_line_and_column_for_malformed_line,
		),
		(
			"error includes line and column for bad value",
			test_error_includes_line_and_column_for_bad_value,
		),
		("parse_detailed success", test_parse_detailed_success),
		("parse_detailed error fields", test_parse_detailed_error_fields),
		("format parse error", test_format_parse_error),
		("toml conformance valid subset examples", test_toml_conformance_valid_subset_examples),
		("toml conformance invalid subset examples", test_toml_conformance_invalid_subset_examples),
		("rejects unsupported toml features", test_rejects_unsupported_toml_features),
		(
			"rejects invalid conformance style examples",
			test_rejects_invalid_conformance_style_examples,
		),
		("parser and decoder errors are distinct", test_parser_and_decoder_errors_are_distinct),
	],
}
