import:
	test: TestSuite


func test_three_part_concat() -> Bool:
	a: String = "hello"
	b: String = " "
	c: String = "world"
	result: String = a + b + c
	result == "hello world"


func test_four_part_concat() -> Bool:
	result: String = "a" + "b" + "c" + "d"
	result == "abcd"


func test_five_part_mixed() -> Bool:
	name: String = "blorp"
	result: String = "Hello " + name + "! " + "Version " + "1.0"
	result == "Hello blorp! Version 1.0"


func test_concat_with_to_string() -> Bool:
	n: Int = 42
	result: String = "value=" + n.to_string() + " done"
	result == "value=42 done"


func test_two_part_unchanged() -> Bool:
	-- Two parts should still use concat_consume (no regression)
	result: String = "hello" + " world"
	result == "hello world"


func test_nested_concat_in_condition() -> Bool:
	a: String = "x"
	b: String = "y"
	c: String = "z"
	a + b + c == "xyz"


func test_concat_with_call_result() -> Bool:
	n: Int = 42
	result: String = "[" + n.to_string() + "]"
	result == "[42]"


func test_long_chain() -> Bool:
	-- 6-part chain
	result: String = "a" + "b" + "c" + "d" + "e" + "f"
	result == "abcdef"


func test_mixed_vars_and_literals() -> Bool:
	x: String = "X"
	y: String = "Y"
	result: String = "(" + x + "," + y + ")"
	result == "(X,Y)"


tests: TestSuite = {
	description = "String Concat Chain",
	tests = [
		("three part concat", test_three_part_concat),
		("four part concat", test_four_part_concat),
		("five part mixed", test_five_part_mixed),
		("concat with to_string", test_concat_with_to_string),
		("two part unchanged", test_two_part_unchanged),
		("nested in condition", test_nested_concat_in_condition),
		("concat with call result", test_concat_with_call_result),
		("long chain", test_long_chain),
		("mixed vars and literals", test_mixed_vars_and_literals),
	],
}
