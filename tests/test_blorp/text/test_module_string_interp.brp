import:
	./helpers/string_interp_module: format_pair, format_score
	test: TestSuite


func test_interp_int() -> Bool:
	format_score(42) == "Score: 42"


func test_interp_string_and_int() -> Bool:
	format_pair("health", 100) == "health: 100"


tests: TestSuite = {
	description = "Module String Interpolation",
	tests = [
		("interp int in module", test_interp_int),
		("interp string+int in module", test_interp_string_and_int),
	],
}
