import:
	codec:
		DecodeError,
		Decoder,
		Value(VString, VRecord, VBool, VInt, VNull, VList, VFloat),
		d_bool,
		d_float,
		d_int,
		d_list,
		d_string,
		field,
		format_error,
		get_field,
		map2,
		map3,
		optional,
		value_to_string,
	test: TestSuite


-- ============================================================================
-- Primitive Decoder Tests
-- ============================================================================
func test_decode_string_ok() -> Bool:
	match d_string(VString("hello")):
		Ok(s): s == "hello"
		_: False


func test_decode_string_reject_int() -> Bool:
	match d_string(VInt(42)):
		Err(_): True
		_: False


func test_decode_int_from_vint() -> Bool:
	match d_int(VInt(42)):
		Ok(n): n == 42
		_: False


func test_decode_int_from_vfloat() -> Bool:
	match d_int(VFloat(3.9)):
		Ok(n): n == 3
		_: False


func test_decode_int_from_vstring() -> Bool:
	match d_int(VString("99")):
		Ok(n): n == 99
		_: False


func test_decode_int_reject_bad_string() -> Bool:
	match d_int(VString("abc")):
		Err(_): True
		_: False


func test_decode_float_from_vfloat() -> Bool:
	match d_float(VFloat(3.14)):
		Ok(f): f > 3.13 and f < 3.15
		_: False


func test_decode_float_from_vint() -> Bool:
	match d_float(VInt(5)):
		Ok(f): f > 4.99 and f < 5.01
		_: False


func test_decode_bool_true() -> Bool:
	match d_bool(VBool(True)):
		Ok(b): b == True
		_: False


func test_decode_bool_reject_string() -> Bool:
	match d_bool(VString("true")):
		Err(_): True
		_: False


-- ============================================================================
-- Value Accessor Tests
-- ============================================================================
func test_get_field_found() -> Bool:
	v: Value = VRecord([("name", VString("Alice"))])
	match get_field(v, "name"):
		Some(VString(s)): s == "Alice"
		_: False


func test_get_field_missing() -> Bool:
	v: Value = VRecord([("x", VInt(1))])
	match get_field(v, "y"):
		None: True
		_: False


func test_value_to_string_null() -> Bool:
	value_to_string(VNull) == "null"


func test_value_to_string_int() -> Bool:
	value_to_string(VInt(42)) == "42"


func test_value_to_string_string() -> Bool:
	value_to_string(VString("hi")) == "\"hi\""


-- ============================================================================
-- Combinator Tests
-- ============================================================================
func test_field_decode() -> Bool:
	v: Value = VRecord([("name", VString("Alice")), ("age", VInt(30))])
	dec: Decoder[String] = field("name", d_string)
	match dec(v):
		Ok(s): s == "Alice"
		_: False


func test_field_missing() -> Bool:
	v: Value = VRecord([("x", VInt(1))])
	dec: Decoder[String] = field("name", d_string)
	match dec(v):
		Err(e): e.message == "missing field: name"
		_: False


func test_optional_present() -> Bool:
	v: Value = VRecord([("email", VString("a@b.c"))])
	dec: Decoder[Option[String]] = optional("email", d_string)
	match dec(v):
		Ok(Some(s)): s == "a@b.c"
		_: False


func test_optional_missing() -> Bool:
	v: Value = VRecord([("x", VInt(1))])
	dec: Decoder[Option[String]] = optional("email", d_string)
	match dec(v):
		Ok(None): True
		_: False


func test_optional_null() -> Bool:
	v: Value = VRecord([("email", VNull)])
	dec: Decoder[Option[String]] = optional("email", d_string)
	match dec(v):
		Ok(None): True
		_: False


func test_list_decode() -> Bool:
	v: Value = VList([VInt(1), VInt(2), VInt(3)])
	match d_list(d_int)(v):
		Ok(items): items.length() == 3
		_: False


func test_map2_decode() -> Bool:
	v: Value = VRecord([("x", VInt(1)), ("y", VInt(2))])
	dec: Decoder[Int] = map2(func(a: Int, b: Int): a + b, field("x", d_int), field("y", d_int))
	match dec(v):
		Ok(n): n == 3
		_: False


func test_map3_decode() -> Bool:
	v: Value = VRecord([("a", VInt(10)), ("b", VInt(20)), ("c", VInt(30))])
	dec: Decoder[Int] = map3(
		func(a: Int, b: Int, c: Int): a + b + c,
		field(
			"a",
			d_int,
		),
		field(
			"b",
			d_int,
		),
		field(
			"c",
			d_int,
		),
	)
	match dec(v):
		Ok(n): n == 60
		_: False


-- ============================================================================
-- Error Formatting
-- ============================================================================
func test_format_error_no_path() -> Bool:
	e: DecodeError = {path = [], message = "bad value"}
	format_error(e) == "bad value"


func test_format_error_with_path() -> Bool:
	e: DecodeError = {path = ["user", "name"], message = "expected string"}
	format_error(e) == "at user.name: expected string"


-- ============================================================================
-- Encode Trait Tests
-- ============================================================================
func test_encode_int() -> Bool:
	match VInt(42):
		VInt(n): n == 42
		_: False


func test_encode_string() -> Bool:
	match VString("hello"):
		VString(s): s == "hello"
		_: False


func test_encode_bool() -> Bool:
	match VBool(True):
		VBool(b): b == True
		_: False


func test_encode_float() -> Bool:
	match VFloat(3.14):
		VFloat(f): f > 3.13 and f < 3.15
		_: False


-- ============================================================================
-- Test Suite
-- ============================================================================
tests: TestSuite = {
	description = "Codec Tests",
	tests = [
		("decode string ok", test_decode_string_ok),
		("decode string reject int", test_decode_string_reject_int),
		("decode int from VInt", test_decode_int_from_vint),
		("decode int from VFloat", test_decode_int_from_vfloat),
		("decode int from VString", test_decode_int_from_vstring),
		("decode int reject bad string", test_decode_int_reject_bad_string),
		("decode float from VFloat", test_decode_float_from_vfloat),
		("decode float from VInt", test_decode_float_from_vint),
		("decode bool true", test_decode_bool_true),
		("decode bool reject string", test_decode_bool_reject_string),
		("get_field found", test_get_field_found),
		("get_field missing", test_get_field_missing),
		("value_to_string null", test_value_to_string_null),
		("value_to_string int", test_value_to_string_int),
		("value_to_string string", test_value_to_string_string),
		("format error no path", test_format_error_no_path),
		("format error with path", test_format_error_with_path),
		("encode int", test_encode_int),
		("encode string", test_encode_string),
		("encode bool", test_encode_bool),
		("encode float", test_encode_float),
		("field decode", test_field_decode),
		("field missing", test_field_missing),
		("optional present", test_optional_present),
		("optional missing", test_optional_missing),
		("optional null", test_optional_null),
		("list decode", test_list_decode),
		("map2 decode", test_map2_decode),
		("map3 decode", test_map3_decode),
	],
}
