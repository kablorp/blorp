-- Test new string API functions
import:
	string:
		center,
		dedent,
		drop_right,
		is_ascii,
		is_numeric,
		last_index_of,
		replace_first,
		split_n,
		take_right,
		trim_chars,
	test: TestSuite


-- split_n tests
func test_split_n_basic() -> Bool:
	"a.b.c.d".split_n(".", 2) == ["a", "b.c.d"]


func test_split_n_high_limit() -> Bool:
	"a.b".split_n(".", 10) == ["a", "b"]


func test_split_n_one() -> Bool:
	"a.b.c".split_n(".", 1) == ["a.b.c"]


func test_split_n_three() -> Bool:
	"a.b.c.d".split_n(".", 3) == ["a", "b", "c.d"]


-- replace_first tests
func test_replace_first_basic() -> Bool:
	"abab".replace_first("ab", "x") == "xab"


func test_replace_first_no_match() -> Bool:
	"hello".replace_first("xyz", "q") == "hello"


func test_replace_first_empty() -> Bool:
	"".replace_first("a", "b") == ""


-- last_index_of tests
func test_last_index_of_found() -> Bool:
	match "abcabc".last_index_of("abc"):
		Some(i): i == 3
		None: False


func test_last_index_of_single() -> Bool:
	match "hello".last_index_of("ell"):
		Some(i): i == 1
		None: False


func test_last_index_of_not_found() -> Bool:
	match "hello".last_index_of("xyz"):
		Some(_): False
		None: True


-- trim_chars tests
func test_trim_chars_basic() -> Bool:
	"##hello##".trim_chars("#") == "hello"


func test_trim_chars_multiple() -> Bool:
	"xxyhelloxyy".trim_chars("xy") == "hello"


func test_trim_chars_none() -> Bool:
	"hello".trim_chars("#") == "hello"


-- take_right tests
func test_take_right_basic() -> Bool:
	"hello".take_right(3) == "llo"


func test_take_right_all() -> Bool:
	"hi".take_right(10) == "hi"


func test_take_right_zero() -> Bool:
	"hello".take_right(0) == ""


-- drop_right tests
func test_drop_right_basic() -> Bool:
	"hello".drop_right(2) == "hel"


func test_drop_right_all() -> Bool:
	"hello".drop_right(10) == ""


func test_drop_right_zero() -> Bool:
	"hello".drop_right(0) == "hello"


-- center tests
func test_center_basic() -> Bool:
	"hi".center(6, ' ') == "  hi  "


func test_center_odd() -> Bool:
	"hi".center(7, '-') == "--hi---"


func test_center_already_wide() -> Bool:
	"hello".center(3, ' ') == "hello"


-- is_numeric tests
func test_is_numeric_true() -> Bool:
	is_numeric("12345")


func test_is_numeric_false() -> Bool:
	not is_numeric("12a")


func test_is_numeric_empty() -> Bool:
	not is_numeric("")


-- is_ascii tests
func test_is_ascii_true() -> Bool:
	is_ascii("hello world!")


func test_is_ascii_false() -> Bool:
	not is_ascii("café")


func test_is_ascii_empty() -> Bool:
	is_ascii("")


-- dedent tests
func test_dedent_basic() -> Bool:
	dedent("  a\n  b") == "a\nb"


func test_dedent_mixed() -> Bool:
	dedent("    a\n  b\n    c") == "  a\nb\n  c"


func test_dedent_no_indent() -> Bool:
	dedent("a\nb") == "a\nb"


tests: TestSuite = {
	description = "String API",
	tests = [
		("split_n basic", test_split_n_basic),
		("split_n high limit", test_split_n_high_limit),
		("split_n one", test_split_n_one),
		("split_n three", test_split_n_three),
		("replace_first basic", test_replace_first_basic),
		("replace_first no match", test_replace_first_no_match),
		("replace_first empty", test_replace_first_empty),
		("last_index_of found", test_last_index_of_found),
		("last_index_of single", test_last_index_of_single),
		("last_index_of not found", test_last_index_of_not_found),
		("trim_chars basic", test_trim_chars_basic),
		("trim_chars multiple", test_trim_chars_multiple),
		("trim_chars none", test_trim_chars_none),
		("take_right basic", test_take_right_basic),
		("take_right all", test_take_right_all),
		("take_right zero", test_take_right_zero),
		("drop_right basic", test_drop_right_basic),
		("drop_right all", test_drop_right_all),
		("drop_right zero", test_drop_right_zero),
		("center basic", test_center_basic),
		("center odd", test_center_odd),
		("center already wide", test_center_already_wide),
		("is_numeric true", test_is_numeric_true),
		("is_numeric false", test_is_numeric_false),
		("is_numeric empty", test_is_numeric_empty),
		("is_ascii true", test_is_ascii_true),
		("is_ascii false", test_is_ascii_false),
		("is_ascii empty", test_is_ascii_empty),
		("dedent basic", test_dedent_basic),
		("dedent mixed", test_dedent_mixed),
		("dedent no indent", test_dedent_no_indent),
	],
}
