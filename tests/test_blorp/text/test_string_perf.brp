import:
	list as L: join
	memory: MemStats, get_mem_stats, mem_delta
	string: replace, split
	test: TestSuite


-- ===== Split correctness (single-byte delimiter) =====
func test_split_single_char() -> Bool:
	parts: List[String] = "a,b,c".split(",")
	L.length(parts) == 3 and match L.get(parts, 0):
		Some(s): s == "a"
		None: False


func test_split_space() -> Bool:
	parts: List[String] = "the quick brown fox".split(" ")
	L.length(parts) == 4 and match L.get(parts, 3):
		Some(s): s == "fox"
		None: False


func test_split_no_delimiter() -> Bool:
	parts: List[String] = "hello".split(",")
	L.length(parts) == 1 and match L.get(parts, 0):
		Some(s): s == "hello"
		None: False


func test_split_empty_parts() -> Bool:
	parts: List[String] = "a,,b".split(",")
	L.length(parts) == 3 and match L.get(parts, 1):
		Some(s): s == ""
		None: False


func test_split_trailing_delimiter() -> Bool:
	parts: List[String] = "a,b,".split(",")
	L.length(parts) == 3 and match L.get(parts, 2):
		Some(s): s == ""
		None: False


func test_split_leading_delimiter() -> Bool:
	parts: List[String] = ",a,b".split(",")
	L.length(parts) == 3 and match L.get(parts, 0):
		Some(s): s == ""
		None: False


func test_split_multi_char_delimiter() -> Bool:
	parts: List[String] = "a::b::c".split("::")
	L.length(parts) == 3 and match L.get(parts, 1):
		Some(s): s == "b"
		None: False


func test_split_empty_string() -> Bool:
	parts: List[String] = "".split(",")
	L.length(parts) == 1 and match L.get(parts, 0):
		Some(s): s == ""
		None: False


func test_split_empty_delimiter() -> Bool:
	parts: List[String] = "abc".split("")
	L.length(parts) == 1 and match L.get(parts, 0):
		Some(s): s == "abc"
		None: False


func test_split_single_byte_long_gap() -> Bool:
	chunk: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
	source: String = chunk + chunk + chunk + chunk + chunk + "|tail"
	parts: List[String] = source.split("|")
	L.length(parts) == 2 and match L.get(parts, 1):
		Some(s): s == "tail"
		None: False


func test_split_single_char_string() -> Bool:
	parts: List[String] = "x".split(",")
	L.length(parts) == 1 and match L.get(parts, 0):
		Some(s): s == "x"
		None: False


-- ===== Replace correctness =====
func test_replace_single_char() -> Bool:
	"hello".replace("l", "r") == "herro"


func test_replace_no_match() -> Bool:
	"hello".replace("z", "x") == "hello"


func test_replace_multi_char() -> Bool:
	"the cat and the dog".replace("the", "a") == "a cat and a dog"


func test_replace_to_longer() -> Bool:
	"ab".replace("a", "xyz") == "xyzb"


func test_replace_to_shorter() -> Bool:
	"aaa".replace("aa", "b") == "ba"


func test_replace_to_empty() -> Bool:
	"hello".replace("l", "") == "heo"


func test_replace_empty_string() -> Bool:
	"".replace("a", "b") == ""


-- ===== Split+join roundtrip =====
func test_split_join_roundtrip() -> Bool:
	s: String = "alpha-beta-gamma-delta"
	s
		.split("-")
		.join("-") == s


-- ===== Allocation efficiency =====
func do_split_single_byte() -> Void:
	var i: Int = 0
	while i < 500:
		parts: List[String] = "a b c d e f g h".split(" ")
		i += 1


func test_split_alloc_efficiency() -> Bool:
	before: MemStats = get_mem_stats()
	do_split_single_byte()
	after: MemStats = get_mem_stats()
	delta: MemStats = mem_delta(before, after)
	delta.current_objects <= 2


func do_replace_work() -> Void:
	var i: Int = 0
	while i < 500:
		result: String = "the cat and the dog and the bird".replace("the", "a")
		i += 1


func test_replace_alloc_efficiency() -> Bool:
	before: MemStats = get_mem_stats()
	do_replace_work()
	after: MemStats = get_mem_stats()
	delta: MemStats = mem_delta(before, after)
	delta.current_objects <= 2


tests: TestSuite = {
	description = "String Split/Replace",
	tests = [
		("split single char delim", test_split_single_char),
		("split space", test_split_space),
		("split no delimiter", test_split_no_delimiter),
		("split empty parts", test_split_empty_parts),
		("split trailing delim", test_split_trailing_delimiter),
		("split leading delim", test_split_leading_delimiter),
		("split multi char delim", test_split_multi_char_delimiter),
		("split empty string", test_split_empty_string),
		("split empty delimiter", test_split_empty_delimiter),
		("split single-byte long gap", test_split_single_byte_long_gap),
		("split single char string", test_split_single_char_string),
		("replace single char", test_replace_single_char),
		("replace no match", test_replace_no_match),
		("replace multi char", test_replace_multi_char),
		("replace to longer", test_replace_to_longer),
		("replace to shorter", test_replace_to_shorter),
		("replace to empty", test_replace_to_empty),
		("replace empty string", test_replace_empty_string),
		("split join roundtrip", test_split_join_roundtrip),
		("split alloc efficiency", test_split_alloc_efficiency),
		("replace alloc efficiency", test_replace_alloc_efficiency),
	],
}
