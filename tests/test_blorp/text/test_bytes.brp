-- Test Bytes functionality
import:
	bytes as B: to_string
	test: TestSuite


tests: TestSuite = {
	description = "Bytes Tests",
	tests = [
		("New bytes has correct length", func():
			b: Bytes = B.bytes(10)
			B.length(b) == 10
		),
		("New bytes are zero-filled", func():
			b: Bytes = B.bytes(5)
			match B.get(b, 0):
				Some(v): v == 0
				None: False
		),
		("Empty bytes has length 0", func():
			b: Bytes = B.bytes(0)
			B.length(b) == 0
		),
		("From string round-trip", func():
			b: Bytes = "hello".to_bytes()
			B.to_string(b) == "hello"
		),
		("Selective import to_string uses bytes conversion", func():
			"hello"
				.to_bytes()
				.to_string() == "hello"
		),
		("From string preserves length", func():
			b: Bytes = "test".to_bytes()
			B.length(b) == 4
		),
		("Get valid index returns Some", func():
			b: Bytes = "A".to_bytes()
			match B.get(b, 0):
				Some(v): v == 65
				None: False
		),
		("Get out of bounds returns None", func():
			b: Bytes = B.bytes(3)
			match B.get(b, 10):
				Some(_): False
				None: True
		),
		("Get negative index returns None", func():
			b: Bytes = B.bytes(3)
			match B.get(b, -1):
				Some(_): False
				None: True
		),
		("Set and get back", func():
			var b: Bytes = B.bytes(3)
			b = B.set_index(b, 1, 42)
			match B.get(b, 1):
				Some(v): v == 42
				None: False
		),
		("Set clamps to 0-255", func():
			var b: Bytes = B.bytes(2)
			b = B.set_index(b, 0, 300)
			b = B.set_index(b, 1, -5)
			ok1: Bool = match B.get(b, 0):
				Some(v): v == 255
				None: False
			ok2: Bool = match B.get(b, 1):
				Some(v): v == 0
				None: False
			ok1 and ok2
		),
		("Set on unique modifies in place", func():
			var b: Bytes = B.bytes(3)
			b = B.set_index(b, 0, 42)
			b = B.set_index(b, 1, 99)
			ok1: Bool = match B.get(b, 0):
				Some(v): v == 42
				None: False
			ok2: Bool = match B.get(b, 1):
				Some(v): v == 99
				None: False
			ok1 and ok2
		),
		("Slice middle", func():
			b: Bytes = "hello".to_bytes()
			s: Bytes = B.slice(b, 1, 3)
			B.to_string(s) == "ell"
		),
		("Slice empty on OOB start", func():
			b: Bytes = "hi".to_bytes()
			s: Bytes = B.slice(b, 100, 1)
			B.length(s) == 0
		),
		("Slice clamps length", func():
			b: Bytes = "hi".to_bytes()
			s: Bytes = B.slice(b, 0, 100)
			B.to_string(s) == "hi"
		),
		("Append two buffers", func():
			a: Bytes = "hel".to_bytes()
			b: Bytes = "lo".to_bytes()
			c: Bytes = B.append(a, b)
			B.to_string(c) == "hello"
		),
		("Append empty right", func():
			a: Bytes = "test".to_bytes()
			c: Bytes = B.append(a, B.bytes(0))
			B.to_string(c) == "test"
		),
		("Fill with value", func():
			var b: Bytes = B.bytes(4)
			b = B.fill(b, 255)
			ok1: Bool = match B.get(b, 0):
				Some(v): v == 255
				None: False
			ok2: Bool = match B.get(b, 3):
				Some(v): v == 255
				None: False
			ok1 and ok2
		),
		("Index of found", func():
			b: Bytes = "hello".to_bytes()
			-- 'l' is 108
			B.index_of(b, 108, 0) == Some(2)
		),
		("Index of not found", func():
			b: Bytes = "hello".to_bytes()
			match B.index_of(b, 0, 0):
				None: True
				Some(_): False
		),
		("Index of with start offset", func():
			b: Bytes = "hello".to_bytes()
			-- 'l' is 108, second 'l' at index 3
			B.index_of(b, 108, 3) == Some(3)
		),
		("Index of with OOB start returns None", func():
			b: Bytes = "hello".to_bytes()
			match B.index_of(b, 108, 100):
				Some(_): False
				None: True
		),
		("Concat list of buffers", func():
			parts: List[Bytes] = ["a".to_bytes(), "b".to_bytes(), "c".to_bytes()]
			B.to_string(B.concat(parts)) == "abc"
		),
		("Concat empty list", func():
			parts: List[Bytes] = []
			B.length(B.concat(parts)) == 0
		),
		("Write and read int16 big-endian", func():
			var b: Bytes = B.bytes(4)
			b = B.write_int16_be(b, 0, 4660)
			match B.read_int16_be(b, 0):
				Some(v): v == 4660
				None: False
		),
		("Write and read int16 little-endian", func():
			var b: Bytes = B.bytes(4)
			b = B.write_int16_le(b, 0, 4660)
			match B.read_int16_le(b, 0):
				Some(v): v == 4660
				None: False
		),
		("Int16 BE byte order is correct", func():
			var b: Bytes = B.bytes(2)
			b = B.write_int16_be(b, 0, 258)
			hi: Bool = match B.get(b, 0):
				Some(v): v == 1
				None: False
			lo: Bool = match B.get(b, 1):
				Some(v): v == 2
				None: False
			hi and lo
		),
		("Int16 LE byte order is correct", func():
			var b: Bytes = B.bytes(2)
			b = B.write_int16_le(b, 0, 258)
			lo: Bool = match B.get(b, 0):
				Some(v): v == 2
				None: False
			hi: Bool = match B.get(b, 1):
				Some(v): v == 1
				None: False
			lo and hi
		),
		("Write and read int32 big-endian", func():
			var b: Bytes = B.bytes(8)
			b = B.write_int32_be(b, 0, 305419896)
			match B.read_int32_be(b, 0):
				Some(v): v == 305419896
				None: False
		),
		("Write and read int32 little-endian", func():
			var b: Bytes = B.bytes(8)
			b = B.write_int32_le(b, 0, 305419896)
			match B.read_int32_le(b, 0):
				Some(v): v == 305419896
				None: False
		),
		("Read int16 OOB returns None", func():
			b: Bytes = B.bytes(1)
			match B.read_int16_be(b, 0):
				Some(_): False
				None: True
		),
		("Read int32 OOB returns None", func():
			b: Bytes = B.bytes(2)
			match B.read_int32_be(b, 0):
				Some(_): False
				None: True
		),
		("To hex for known bytes", func():
			var b: Bytes = B.bytes(3)
			b = B.set_index(b, 0, 222)
			b = B.set_index(b, 1, 173)
			b = B.set_index(b, 2, 190)
			B.to_hex(b) == "deadbe"
		),
		("To hex empty", func():
			B.to_hex(B.bytes(0)) == ""
		),
		("HasLength trait works", func():
			b: Bytes = "abc".to_bytes()
			b.length() == 3
		),
		("is_empty on empty", func():
			B.is_empty(B.bytes(0)) == True
		),
		("is_empty on non-empty", func():
			B.is_empty(B.bytes(1)) == False
		),
		("blit copies region into dst", func():
			src: Bytes = "hello".to_bytes()
			var dst: Bytes = B.bytes(5)
			dst = B.blit(dst, 0, src, 1, 3)
			s: Bytes = B.slice(dst, 0, 3)
			B.to_string(s) == "ell"
		),
		("blit with dst_offset", func():
			src: Bytes = "XYZ".to_bytes()
			var dst: Bytes = "aaaaa".to_bytes()
			dst = B.blit(dst, 2, src, 0, 3)
			B.to_string(dst) == "aaXYZ"
		),
		("blit clamps len to src available", func():
			src: Bytes = "hi".to_bytes()
			var dst: Bytes = B.bytes(10)
			dst = B.blit(dst, 0, src, 0, 100)
			match B.get(dst, 0):
				Some(v): v == 104
				None: False
		),
		("blit clamps len to dst available", func():
			src: Bytes = "hello".to_bytes()
			var dst: Bytes = B.bytes(2)
			dst = B.blit(dst, 0, src, 0, 5)
			B.length(dst) == 2
		),
		("blit OOB dst_offset returns dst unchanged", func():
			src: Bytes = "hi".to_bytes()
			dst: Bytes = "abc".to_bytes()
			result: Bytes = B.blit(dst, 100, src, 0, 2)
			B.to_string(result) == "abc"
		),
		("blit OOB src_offset returns dst unchanged", func():
			src: Bytes = "hi".to_bytes()
			dst: Bytes = "abc".to_bytes()
			result: Bytes = B.blit(dst, 0, src, 100, 2)
			B.to_string(result) == "abc"
		)
	]
}
