-- Test string ordering comparison operators
import:
	test: TestSuite


func test_less_than() -> Bool:
	"apple" < "banana"


func test_greater_than() -> Bool:
	"banana" > "apple"


func test_less_or_equal_same() -> Bool:
	"hello" <= "hello"


func test_less_or_equal_less() -> Bool:
	"aaa" <= "bbb"


func test_greater_or_equal_same() -> Bool:
	"world" >= "world"


func test_greater_or_equal_greater() -> Bool:
	"z" >= "a"


func test_prefix_ordering() -> Bool:
	"abc" < "abcd"


func test_equal_strings_not_less() -> Bool:
	not ("same" < "same")


tests: TestSuite = {
	description = "String Comparison",
	tests = [
		("less than", test_less_than),
		("greater than", test_greater_than),
		("le same", test_less_or_equal_same),
		("le less", test_less_or_equal_less),
		("ge same", test_greater_or_equal_same),
		("ge greater", test_greater_or_equal_greater),
		("prefix ordering", test_prefix_ordering),
		("equal not less", test_equal_strings_not_less),
	],
}
