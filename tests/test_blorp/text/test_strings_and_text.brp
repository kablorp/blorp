-- Deterministic test: String operations and Char
import:
	list: join
	string as Str
	test: TestSuite


-- String length
func test_string_length() -> Bool:
	"hello".length() == 5 and "".length() == 0


-- Substring
func test_substring() -> Bool:
	Str.substring("hello world", 0, 5) == "hello" and Str.substring("hello", 1, 3) == "ell"


-- starts_with / ends_with
func test_starts_ends() -> Bool:
	Str.starts_with(
		"hello world",
		"hello",
	) and Str.ends_with("hello world", "world") and not Str.starts_with("hello", "world")


-- contains
func test_string_contains() -> Bool:
	Str.contains("hello world", "world") and not Str.contains("hello", "xyz")


-- split and join
func test_split_join() -> Bool:
	parts: List[String] = Str.split("a,b,c", ",")
	parts.length() == 3 and parts.join(",") == "a,b,c"


-- trim
func test_trim() -> Bool:
	Str.trim("  hello  ") == "hello" and Str.trim("no spaces") == "no spaces"


-- replace
func test_replace() -> Bool:
	Str.replace(
		"hello world",
		"world",
		"blorp",
	) == "hello blorp" and Str.replace("aaa", "a", "b") == "bbb"


-- upper / lower
func test_case_conversion() -> Bool:
	Str.upper("hello") == "HELLO" and Str.lower("HELLO") == "hello"


-- capitalize / title_case
func test_capitalize() -> Bool:
	Str.capitalize("hello") == "Hello" and Str.title_case("hello world") == "Hello World"


-- equal_ignore_case
func test_equal_ignore_case() -> Bool:
	Str.equal_ignore_case("Hello", "hello") and not Str.equal_ignore_case("abc", "xyz")


-- parse_int
func test_parse_int() -> Bool:
	match Str.parse_int("42"):
		Some(v): v == 42
		None: False
	and match Str.parse_int("bad"):
		Some(_): False
		None: True


-- parse_float
func test_parse_float() -> Bool:
	match Str.parse_float("3.14"):
		Some(v): v > 3.0
		None: False
	and match Str.parse_float("bad"):
		Some(_): False
		None: True


-- Safe character access
func test_string_get() -> Bool:
	match Str.get("hello", 0):
		Some(c): c == 'h'
		None: False
	and match Str.get("hello", 10):
		Some(_): False
		None: True


-- index_of
func test_index_of() -> Bool:
	match Str.index_of("hello world", "world"):
		Some(i): i == 6
		None: False
	and match Str.index_of("hello", "xyz"):
		Some(_): False
		None: True


-- is_empty
func test_string_is_empty() -> Bool:
	Str.is_empty("") and not Str.is_empty("a")


-- head / tail
func test_string_head_tail() -> Bool:
	match Str.head("hello"):
		Some(c): c == 'h'
		None: False
	and Str.tail("hello") == "ello" and Str.tail("") == ""


-- repeat
func test_string_repeat() -> Bool:
	Str.repeat("ab", 3) == "ababab" and Str.repeat("x", 0) == ""


-- String interpolation with various types
func test_interpolation() -> Bool:
	n: Int = 42
	f: Float = 3.14
	b: Bool = True
	"n=${n}" == "n=42" and "f=${f}" == "f=3.14" and "b=${b}" == "b=True"


-- String concatenation
func test_string_concat() -> Bool:
	"hello" + " " + "world" == "hello world"


-- Capacity-aware String append
func test_string_builder() -> Bool:
	var sb: String = Str.string(16)
	sb = sb.append_str("hello")
	sb = sb.append_char(' ')
	sb = sb.append_str("world")
	sb == "hello world"


-- String with initial capacity
func test_sb_capacity() -> Bool:
	var sb: String = Str.string(100)
	for i in 0..10:
		sb = sb.append_str(i.to_string())
	sb == "0123456789"


-- from_char
func test_from_char() -> Bool:
	Str.from_char('a') == "a" and Str.from_char('Z') == "Z"


-- Char to_int
func test_char_to_int() -> Bool:
	to_int('a') == 97 and to_int('A') == 65


tests: TestSuite = {
	description = "Deterministic: Strings and Text",
	tests = [
		("String length", test_string_length),
		("Substring", test_substring),
		("starts/ends_with", test_starts_ends),
		("String contains", test_string_contains),
		("split/join", test_split_join),
		("trim", test_trim),
		("replace", test_replace),
		("Case conversion", test_case_conversion),
		("capitalize/title_case", test_capitalize),
		("equal_ignore_case", test_equal_ignore_case),
		("parse_int", test_parse_int),
		("parse_float", test_parse_float),
		("String get", test_string_get),
		("index_of", test_index_of),
		("String is_empty", test_string_is_empty),
		("String head/tail", test_string_head_tail),
		("String repeat", test_string_repeat),
		("Interpolation", test_interpolation),
		("String concat", test_string_concat),
		("String append", test_string_builder),
		("String with capacity", test_sb_capacity),
		("from_char", test_from_char),
		("Char to_int", test_char_to_int),
	],
}
