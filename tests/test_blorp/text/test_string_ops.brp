-- Test String operations: head, tail, is_empty
import:
	string: head, is_empty, tail
	test: TestSuite


func test_head_nonempty() -> Bool:
	match head("hello"):
		Some(c): c == 'h'
		None: False


func test_head_empty() -> Bool:
	match head(""):
		Some(_): False
		None: True


func test_tail_nonempty() -> Bool:
	tail("hello") == "ello"


func test_tail_single() -> Bool:
	tail("x") == ""


func test_tail_empty() -> Bool:
	tail("") == ""


func test_is_empty_true() -> Bool:
	is_empty("")


func test_is_empty_false() -> Bool:
	not is_empty("hello")


tests: TestSuite = {
	description = "String Operations",
	tests = [
		("head nonempty", test_head_nonempty),
		("head empty", test_head_empty),
		("tail nonempty", test_tail_nonempty),
		("tail single char", test_tail_single),
		("tail empty", test_tail_empty),
		("is_empty true", test_is_empty_true),
		("is_empty false", test_is_empty_false),
	]
}
