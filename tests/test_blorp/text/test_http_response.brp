import:
	bytes as B
	net/http: Header, Response, error_response, format_response, get_header, ok_text, status_text
	string: contains
	test: TestSuite


-- Test HTTP response formatting and header utilities (pure, no networking)
func test_get_header_found() -> Bool:
	headers: List[Header] = [
		{name = "Content-Type", value = "text/html"},
		{name = "Host", value = "example.com"},
	]
	match get_header(headers, "Host"):
		Some(v): v == "example.com"
		None: False


func test_get_header_case_insensitive() -> Bool:
	headers: List[Header] = [{name = "Content-Type", value = "text/html"}]
	match get_header(headers, "content-type"):
		Some(v): v == "text/html"
		None: False


func test_get_header_missing() -> Bool:
	headers: List[Header] = [{name = "Host", value = "localhost"}]
	match get_header(headers, "Accept"):
		Some(_): False
		None: True


func test_format_simple_response() -> Bool:
	resp: Response = ok_text("hello")
	raw: Bytes = format_response(resp)
	raw_str: String = B.to_string(raw)
	raw_str.contains("HTTP/1.1 200 OK") and raw_str.contains("hello")


func test_format_content_length() -> Bool:
	resp: Response = ok_text("body")
	raw: Bytes = format_response(resp)
	raw_str: String = B.to_string(raw)
	raw_str.contains("Content-Length: 4")


func test_format_error_response() -> Bool:
	resp: Response = error_response(404, "not found")
	raw: Bytes = format_response(resp)
	raw_str: String = B.to_string(raw)
	raw_str.contains("404 Not Found") and raw_str.contains("not found")


func test_status_text_known() -> Bool:
	status_text(
		200,
	) == "OK" and status_text(404) == "Not Found" and status_text(500) == "Internal Server Error"


func test_status_text_unknown() -> Bool:
	status_text(999) == "Unknown"


func test_ok_text_convenience() -> Bool:
	resp: Response = ok_text("test body")
	resp.status_code == 200 and resp.status_text == "OK" and B.to_string(resp.body) == "test body"


func test_error_response_convenience() -> Bool:
	resp: Response = error_response(403, "forbidden")
	resp.status_code == 403 and resp.status_text == "Forbidden"


tests: TestSuite = {
	description = "HTTP Response Formatting",
	tests = [
		("Get header finds existing", test_get_header_found),
		("Get header case insensitive", test_get_header_case_insensitive),
		("Get header missing returns None", test_get_header_missing),
		("Format simple response", test_format_simple_response),
		("Format response includes Content-Length", test_format_content_length),
		("Format error response", test_format_error_response),
		("Status text for known codes", test_status_text_known),
		("Status text for unknown code", test_status_text_unknown),
		("Ok text convenience response", test_ok_text_convenience),
		("Error response convenience", test_error_response_convenience),
	],
}
