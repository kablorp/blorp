import:
	slice as S
	test: TestSuite


func test_from_string() -> Bool:
	s: S.StringSlice = S.from_string("hello")
	S.length(s) == 5


func test_to_string() -> Bool:
	s: S.StringSlice = S.from_string("hello world")
	S.to_string(s) == "hello world"


func test_substring() -> Bool:
	s: S.StringSlice = S.from_string("hello world")
	sub: S.StringSlice = S.substring(s, 0, 5)
	S.to_string(sub) == "hello"


func test_substring_mid() -> Bool:
	s: S.StringSlice = S.from_string("hello world")
	sub: S.StringSlice = S.substring(s, 6, 5)
	S.to_string(sub) == "world"


func test_starts_with_true() -> Bool:
	s: S.StringSlice = S.from_string("hello")
	S.starts_with(s, "hel")


func test_starts_with_false() -> Bool:
	s: S.StringSlice = S.from_string("hello")
	not S.starts_with(s, "xyz")


func test_get_valid() -> Bool:
	s: S.StringSlice = S.from_string("hello")
	match S.get(s, 0):
		Some(c): c == 'h'
		None: False


func test_get_oob() -> Bool:
	s: S.StringSlice = S.from_string("hello")
	match S.get(s, 10):
		Some(_): False
		None: True


func test_empty() -> Bool:
	s: S.StringSlice = S.from_string("")
	S.length(s) == 0


func test_chained_substring() -> Bool:
	s: S.StringSlice = S.from_string("abcdefghij")
	sub: S.StringSlice = S.substring(s, 2, 6)
	sub2: S.StringSlice = S.substring(sub, 1, 3)
	S.to_string(sub2) == "def"


tests: TestSuite = {
	description = "Slice IR tests",
	tests = [
		("from_string", test_from_string),
		("to_string", test_to_string),
		("substring begin", test_substring),
		("substring mid", test_substring_mid),
		("starts_with true", test_starts_with_true),
		("starts_with false", test_starts_with_false),
		("get valid", test_get_valid),
		("get oob", test_get_oob),
		("empty slice", test_empty),
		("chained substring", test_chained_substring),
	],
}
