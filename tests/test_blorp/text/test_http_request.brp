-- Test HTTP request parsing (pure, no networking)
import:
	bytes as B
	net/http: Header, parse_query_string, parse_request
	test: TestSuite


func test_parse_simple_get() -> Bool:
	raw: Bytes = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n".to_bytes()
	match parse_request(raw):
		Ok(req):
			req.method == "GET" and req.path == "/" and req.version == "HTTP/1.1"
		Err(_): False


func test_parse_get_with_path() -> Bool:
	raw: Bytes = "GET /hello/world HTTP/1.1\r\nHost: example.com\r\n\r\n".to_bytes()
	match parse_request(raw):
		Ok(req): req.path == "/hello/world"
		Err(_): False


func test_parse_get_with_query() -> Bool:
	raw: Bytes = "GET /search?q=test&page=1 HTTP/1.1\r\nHost: example.com\r\n\r\n".to_bytes()
	match parse_request(raw):
		Ok(req):
			req.path == "/search" and req.query == "q=test&page=1"
		Err(_): False


func test_parse_post_with_body() -> Bool:
	raw: Bytes = "POST /api HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello".to_bytes()
	match parse_request(raw):
		Ok(req):
			req.method == "POST" and B.to_string(req.body) == "hello"
		Err(_): False


func test_parse_multiple_headers() -> Bool:
	raw: Bytes = "GET / HTTP/1.1\r\nHost: localhost\r\nAccept: text/html\r\nUser-Agent: test\r\n\r\n".to_bytes()
	match parse_request(raw):
		Ok(req):
			hdrs: List[Header] = req.headers
			hdrs.length() == 3
		Err(_): False


func test_parse_missing_terminator() -> Bool:
	raw: Bytes = "GET / HTTP/1.1\r\nHost: localhost".to_bytes()
	match parse_request(raw):
		Ok(_): False
		Err(msg): msg == "malformed request: missing header terminator"


func test_parse_query_string_basic() -> Bool:
	result: List[(String, String)] = parse_query_string("foo=bar&baz=qux")
	result.length() == 2


func test_parse_empty_query_string() -> Bool:
	result: List[(String, String)] = parse_query_string("")
	result.length() == 0


func test_parse_query_key_no_value() -> Bool:
	result: List[(String, String)] = parse_query_string("key")
	result.length() == 1


func test_get_empty_query_after_qmark() -> Bool:
	raw: Bytes = "GET /path? HTTP/1.1\r\nHost: localhost\r\n\r\n".to_bytes()
	match parse_request(raw):
		Ok(req): req.path == "/path" and req.query == ""
		Err(_): False


tests: TestSuite = {
	description = "HTTP Request Parsing",
	tests = [
		("Parse simple GET request", test_parse_simple_get),
		("Parse GET with path", test_parse_get_with_path),
		("Parse GET with query string", test_parse_get_with_query),
		("Parse POST with body", test_parse_post_with_body),
		("Parse multiple headers", test_parse_multiple_headers),
		("Parse request missing terminator", test_parse_missing_terminator),
		("Parse query string", test_parse_query_string_basic),
		("Parse empty query string", test_parse_empty_query_string),
		("Parse query key without value", test_parse_query_key_no_value),
		("GET with empty query after ?", test_get_empty_query_after_qmark),
	]
}
