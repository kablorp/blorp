import:
	list: List, append
	string: chars
	test: TestSuite


-- Basic: count characters
func test_basic_count() -> Bool:
	var n: Int = 0
	for c in "hello":
		n += 1
	n == 5


-- Collect chars to list and compare with chars()
pure func test_char_values() -> Bool:
	var result: List[Char] = []
	for c in "abc":
		result = result.append(c)
	result == chars("abc")


-- Empty string: body never executes
func test_empty_string() -> Bool:
	var n: Int = 0
	for c in "":
		n += 1
	n == 0


-- Unicode: cafe with accent is 4 codepoints
func test_unicode_cafe() -> Bool:
	var n: Int = 0
	for c in "café":
		n += 1
	n == 4


-- Multi-byte CJK: 3 codepoints
func test_multibyte_cjk() -> Bool:
	var n: Int = 0
	for c in "日本語":
		n += 1
	n == 3


-- Emoji: "hi" + party popper = 3 codepoints
func test_emoji() -> Bool:
	var n: Int = 0
	for c in "hi🎉":
		n += 1
	n == 3


-- Count specific character
func test_count_char() -> Bool:
	var n: Int = 0
	for c in "hello":
		if c == 'l':
			n += 1
	n == 2


-- Break: early exit
func test_break() -> Bool:
	var n: Int = 0
	for c in "abcdef":
		if c == 'd':
			break
		n += 1
	n == 3


-- Continue: skip specific chars
func test_continue() -> Bool:
	var n: Int = 0
	for c in "abcdef":
		if c == 'b' or c == 'd':
			continue
		n += 1
	n == 4


-- String variable
func test_string_variable() -> Bool:
	s: String = "test"
	var n: Int = 0
	for c in s:
		n += 1
	n == 4


-- String parameter
func count_via_for(s: String) -> Int:
	var n: Int = 0
	for c in s:
		n += 1
	n


func test_string_param() -> Bool:
	count_via_for("hello") == 5


-- Wildcard
func test_wildcard() -> Bool:
	var n: Int = 0
	for _ in "abc":
		n += 1
	n == 3


-- Nested loops
func test_nested() -> Bool:
	var n: Int = 0
	for c in "ab":
		for d in "xy":
			n += 1
	n == 4


-- String expression (concatenation)
func test_string_expr() -> Bool:
	var n: Int = 0
	for c in "ab" + "cd":
		n += 1
	n == 4


-- Compare with chars()
pure func test_matches_chars() -> Bool:
	s: String = "hello"
	var via_for: List[Char] = []
	for c in s:
		via_for = via_for.append(c)
	via_for == chars(s)


tests: TestSuite = {
	description = "String For-In Iteration",
	tests = [
		("basic count", test_basic_count),
		("char values", test_char_values),
		("empty string", test_empty_string),
		("unicode cafe", test_unicode_cafe),
		("multibyte cjk", test_multibyte_cjk),
		("emoji", test_emoji),
		("count specific char", test_count_char),
		("break", test_break),
		("continue", test_continue),
		("string variable", test_string_variable),
		("string param", test_string_param),
		("wildcard", test_wildcard),
		("nested loops", test_nested),
		("string expression", test_string_expr),
		("matches chars()", test_matches_chars),
	]
}
