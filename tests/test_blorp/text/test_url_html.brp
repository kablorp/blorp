-- Test URL encoding/decoding and HTML escaping
import:
	string: html_escape, url_decode, url_encode
	test: TestSuite


func test_url_encode_basic() -> Bool:
	url_encode("hello world") == "hello%20world"


func test_url_encode_special() -> Bool:
	url_encode("a&b=c") == "a%26b%3Dc"


func test_url_encode_unreserved() -> Bool:
	url_encode("abc-_.~") == "abc-_.~"


func test_url_encode_empty() -> Bool:
	url_encode("") == ""


func test_url_decode_basic() -> Bool:
	url_decode("hello%20world") == "hello world"


func test_url_decode_plus() -> Bool:
	url_decode("a+b") == "a b"


func test_url_decode_mixed() -> Bool:
	url_decode("hello%20world%21") == "hello world!"


func test_url_decode_passthrough() -> Bool:
	url_decode("abc") == "abc"


func test_url_roundtrip() -> Bool:
	original: String = "hello world & goodbye"
	url_decode(url_encode(original)) == original


func test_html_escape_tags() -> Bool:
	html_escape("<b>bold</b>") == "&lt;b&gt;bold&lt;/b&gt;"


func test_html_escape_amp() -> Bool:
	html_escape("a&b") == "a&amp;b"


func test_html_escape_quotes() -> Bool:
	html_escape("say \"hi\"") == "say &quot;hi&quot;"


func test_html_escape_passthrough() -> Bool:
	html_escape("hello") == "hello"


func test_html_escape_empty() -> Bool:
	html_escape("") == ""


tests: TestSuite = {
	description = "URL/HTML Encoding",
	tests = [
		("url_encode basic", test_url_encode_basic),
		("url_encode special", test_url_encode_special),
		("url_encode unreserved", test_url_encode_unreserved),
		("url_encode empty", test_url_encode_empty),
		("url_decode basic", test_url_decode_basic),
		("url_decode plus", test_url_decode_plus),
		("url_decode mixed", test_url_decode_mixed),
		("url_decode passthrough", test_url_decode_passthrough),
		("url roundtrip", test_url_roundtrip),
		("html_escape tags", test_html_escape_tags),
		("html_escape amp", test_html_escape_amp),
		("html_escape quotes", test_html_escape_quotes),
		("html_escape passthrough", test_html_escape_passthrough),
		("html_escape empty", test_html_escape_empty),
	],
}
