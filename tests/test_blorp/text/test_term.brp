import:
	string: contains, length as str_len
	term: bold, color256, pad_left, pad_right, progress_bar, red, rgb, styled, table
	test: TestSuite


func test_red() -> Bool:
	s: String = red("error")
	str_len(s) > str_len("error")


func test_bold() -> Bool:
	s: String = bold("title")
	str_len(s) > str_len("title")


func test_compose_bold_red() -> Bool:
	s: String = bold(red("important"))
	str_len(s) > str_len("important")


func test_styled() -> Bool:
	s: String = styled("text", [bold, red])
	str_len(s) > str_len("text")


func test_color256() -> Bool:
	s: String = color256("hi", 196)
	str_len(s) > str_len("hi")


func test_rgb_color() -> Bool:
	s: String = rgb("hi", 255, 100, 50)
	str_len(s) > str_len("hi")


func test_pad_right() -> Bool:
	"hi".pad_right(5) == "hi   "


func test_pad_left() -> Bool:
	"hi".pad_left(5) == "   hi"


func test_pad_exact() -> Bool:
	"hello".pad_right(5) == "hello"


func test_pad_shorter() -> Bool:
	"hello!".pad_right(3) == "hello!"


func test_progress_bar_zero() -> Bool:
	bar: String = progress_bar(0, 100, 10)
	bar.contains("0%")


func test_progress_bar_half() -> Bool:
	bar: String = progress_bar(50, 100, 10)
	bar.contains("50%")


func test_progress_bar_full() -> Bool:
	bar: String = progress_bar(100, 100, 10)
	bar.contains("100%")


func test_table_basic() -> Bool:
	t: String = table(["Name", "Age"], [["Alice", "30"], ["Bob", "25"]])
	t.contains("Alice") and t.contains("Bob") and t.contains("Name")


func test_table_alignment() -> Bool:
	t: String = table(["A", "B"], [["short", "x"], ["longer text", "y"]])
	t.contains("---")


tests: TestSuite = {
	description = "Terminal Formatting",
	tests = [
		("red adds ANSI codes", test_red),
		("bold adds ANSI codes", test_bold),
		("compose bold+red", test_compose_bold_red),
		("styled applies list of styles", test_styled),
		("color256", test_color256),
		("rgb color", test_rgb_color),
		("pad_right", test_pad_right),
		("pad_left", test_pad_left),
		("pad exact width", test_pad_exact),
		("pad shorter than width", test_pad_shorter),
		("progress bar zero", test_progress_bar_zero),
		("progress bar half", test_progress_bar_half),
		("progress bar full", test_progress_bar_full),
		("table basic", test_table_basic),
		("table alignment", test_table_alignment),
	]
}
