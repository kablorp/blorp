-- Test regular expressions
import:
	regex: find, find_all, replace_all, test_regex
	result: Result(Ok, Err)
	test: TestSuite


tests: TestSuite = {
	description = "Regular Expressions",
	tests = [
		("test literal match", test_literal_match),
		("test no match", test_no_match),
		("test char class", test_char_class),
		("test anchors", test_anchors),
		("test quantifiers", test_quantifiers),
		("find with groups", test_find_groups),
		("find no match", test_find_no_match),
		("replace all", test_replace_all),
		("find all matches", test_find_all),
		("invalid pattern", test_invalid_pattern),
		("invalid find pattern", test_invalid_find),
	],
}


func test_literal_match() -> Bool:
	match test_regex("hello", "say hello world"):
		Ok(b): b
		_: False


func test_no_match() -> Bool:
	match test_regex("xyz", "hello world"):
		Ok(b): not b
		_: False


func test_char_class() -> Bool:
	match test_regex("[0-9]+", "abc123def"):
		Ok(b): b
		_: False


func test_anchors() -> Bool:
	r1: Result[Bool, String] = test_regex("^hello", "hello world")
	r2: Result[Bool, String] = test_regex("^hello", "say hello")
	match r1:
		Ok(b1):
			match r2:
				Ok(b2): b1 and not b2
				_: False
		_: False


func test_quantifiers() -> Bool:
	match test_regex("ab*c", "ac"):
		Ok(b): b
		_: False


func test_find_groups() -> Bool:
	match "([0-9]+)-([0-9]+)".find("date: 2024-01"):
		Ok(opt):
			match opt:
				Some(captures):
					captures.length() == 3
				_: False
		_: False


func test_find_no_match() -> Bool:
	match "[0-9]+".find("no numbers here"):
		Ok(opt):
			match opt:
				None: True
				_: False
		_: False


func test_replace_all() -> Bool:
	match "[0-9]+".replace_all("X", "abc123def456"):
		Ok(result): equals(result, "abcXdefX")
		_: False


func test_find_all() -> Bool:
	match find_all("[0-9]+", "abc123def456ghi789"):
		Ok(matches):
			matches.length() == 3
		_: False


func test_invalid_pattern() -> Bool:
	match test_regex("[a-z", "hello"):
		Err(_): True
		_: False


func test_invalid_find() -> Bool:
	match "(unclosed".find("text"):
		Err(_): True
		_: False
