import:
	csv:
		CsvConfig,
		CsvError,
		format_csv,
		format_csv_row,
		format_csv_with_config,
		format_error,
		parse_csv,
		parse_csv_with_config,
		parse_csv_with_headers,
		try_parse_csv,
		try_parse_csv_with_config,
		tsv_config,
	dict as D
	list: get, length
	test: TestSuite


-- ============================================================================
-- Helpers
-- ============================================================================
pure func cell(rows: List[List[String]], r: Int, c: Int) -> String:
	match get(rows, r):
		Some(row):
			match get(row, c):
				Some(val): val
				None: "MISSING_COL"
		None: "MISSING_ROW"


pure func row_len(rows: List[List[String]], r: Int) -> Int:
	match get(rows, r):
		Some(row): row.length()
		None: -1


-- ============================================================================
-- Basic Parsing
-- ============================================================================
func test_parse_empty() -> Bool:
	parse_csv("").length() == 0


func test_parse_single_field() -> Bool:
	rows: List[List[String]] = parse_csv("hello")
	rows.length() == 1 and row_len(rows, 0) == 1 and cell(rows, 0, 0) == "hello"


func test_parse_single_row() -> Bool:
	rows: List[List[String]] = parse_csv("a,b,c")
	row_len(
		rows,
		0,
	) == 3 and cell(rows, 0, 0) == "a" and cell(rows, 0, 1) == "b" and cell(rows, 0, 2) == "c"


func test_parse_multiple_rows() -> Bool:
	rows: List[List[String]] = parse_csv("a,b\nc,d")
	length(
		rows,
	) == 2 and cell(
		rows,
		0,
		0,
	) == "a" and cell(rows, 0, 1) == "b" and cell(rows, 1, 0) == "c" and cell(rows, 1, 1) == "d"


func test_parse_three_rows() -> Bool:
	rows: List[List[String]] = parse_csv("a,b\nc,d\ne,f")
	rows.length() == 3 and cell(rows, 2, 0) == "e" and cell(rows, 2, 1) == "f"


func test_parse_trailing_newline() -> Bool:
	rows: List[List[String]] = parse_csv("a,b\nc,d\n")
	rows.length() == 2


func test_parse_trailing_crlf() -> Bool:
	rows: List[List[String]] = parse_csv("a,b\r\nc,d\r\n")
	rows.length() == 2 and cell(rows, 0, 0) == "a" and cell(rows, 1, 0) == "c"


func test_parse_mixed_line_endings() -> Bool:
	rows: List[List[String]] = parse_csv("a\nb\r\nc")
	length(
		rows,
	) == 3 and cell(rows, 0, 0) == "a" and cell(rows, 1, 0) == "b" and cell(rows, 2, 0) == "c"


func test_parse_bare_cr() -> Bool:
	rows: List[List[String]] = parse_csv("a\rb")
	rows.length() == 2 and cell(rows, 0, 0) == "a" and cell(rows, 1, 0) == "b"


-- ============================================================================
-- Quoted Fields
-- ============================================================================
func test_quoted_simple() -> Bool:
	rows: List[List[String]] = parse_csv("\"hello\",world")
	cell(rows, 0, 0) == "hello" and cell(rows, 0, 1) == "world"


func test_quoted_with_comma() -> Bool:
	rows: List[List[String]] = parse_csv("\"a,b\",c")
	row_len(rows, 0) == 2 and cell(rows, 0, 0) == "a,b" and cell(rows, 0, 1) == "c"


func test_quoted_with_newline() -> Bool:
	rows: List[List[String]] = parse_csv("\"line1\nline2\",b")
	rows.length() == 1 and cell(rows, 0, 0) == "line1\nline2"


func test_quoted_with_crlf_inside() -> Bool:
	rows: List[List[String]] = parse_csv("\"a\r\nb\",c")
	rows.length() == 1 and cell(rows, 0, 0) == "a\r\nb"


func test_quoted_escaped_quote() -> Bool:
	rows: List[List[String]] = parse_csv("\"say \"\"hello\"\"\",b")
	cell(rows, 0, 0) == "say \"hello\"" and cell(rows, 0, 1) == "b"


func test_quoted_empty() -> Bool:
	rows: List[List[String]] = parse_csv("\"\",b")
	cell(rows, 0, 0) == "" and cell(rows, 0, 1) == "b"


func test_quoted_only_quotes() -> Bool:
	rows: List[List[String]] = parse_csv("\"\"\"\"")
	cell(rows, 0, 0) == "\""


func test_all_quoted() -> Bool:
	rows: List[List[String]] = parse_csv("\"a\",\"b\",\"c\"")
	row_len(
		rows,
		0,
	) == 3 and cell(rows, 0, 0) == "a" and cell(rows, 0, 1) == "b" and cell(rows, 0, 2) == "c"


func test_quoted_at_end_of_row() -> Bool:
	rows: List[List[String]] = parse_csv("a,\"b\"")
	cell(rows, 0, 0) == "a" and cell(rows, 0, 1) == "b"


func test_quoted_multiple_newlines() -> Bool:
	rows: List[List[String]] = parse_csv("\"a\n\nb\",c")
	rows.length() == 1 and cell(rows, 0, 0) == "a\n\nb"


func test_quoted_with_delimiter_and_quote() -> Bool:
	rows: List[List[String]] = parse_csv("\"a,\"\"b\"\"\",c")
	cell(rows, 0, 0) == "a,\"b\"" and cell(rows, 0, 1) == "c"


-- ============================================================================
-- Empty and Edge Cases
-- ============================================================================
func test_empty_fields_middle() -> Bool:
	rows: List[List[String]] = parse_csv("a,,c")
	row_len(
		rows,
		0,
	) == 3 and cell(rows, 0, 0) == "a" and cell(rows, 0, 1) == "" and cell(rows, 0, 2) == "c"


func test_all_empty_fields() -> Bool:
	rows: List[List[String]] = parse_csv(",,")
	row_len(
		rows,
		0,
	) == 3 and cell(rows, 0, 0) == "" and cell(rows, 0, 1) == "" and cell(rows, 0, 2) == ""


func test_trailing_comma() -> Bool:
	rows: List[List[String]] = parse_csv("a,b,")
	row_len(rows, 0) == 3 and cell(rows, 0, 2) == ""


func test_leading_comma() -> Bool:
	rows: List[List[String]] = parse_csv(",a,b")
	row_len(rows, 0) == 3 and cell(rows, 0, 0) == "" and cell(rows, 0, 1) == "a"


func test_single_comma() -> Bool:
	rows: List[List[String]] = parse_csv(",")
	row_len(rows, 0) == 2 and cell(rows, 0, 0) == "" and cell(rows, 0, 1) == ""


func test_whitespace_preserved() -> Bool:
	rows: List[List[String]] = parse_csv(" a , b ")
	cell(rows, 0, 0) == " a " and cell(rows, 0, 1) == " b "


func test_ragged_rows() -> Bool:
	rows: List[List[String]] = parse_csv("a,b,c\nd,e\nf")
	row_len(rows, 0) == 3 and row_len(rows, 1) == 2 and row_len(rows, 2) == 1


func test_single_newline() -> Bool:
	rows: List[List[String]] = parse_csv("\n")
	rows.length() == 1 and row_len(rows, 0) == 1 and cell(rows, 0, 0) == ""


func test_multiple_empty_rows() -> Bool:
	rows: List[List[String]] = parse_csv("\n\n")
	rows.length() == 2


func test_unicode_fields() -> Bool:
	rows: List[List[String]] = parse_csv("name,city\nAlice,Tokyo")
	cell(rows, 1, 1) == "Tokyo"


func test_lenient_unterminated_quote() -> Bool:
	rows: List[List[String]] = parse_csv("\"unterminated")
	rows.length() == 1 and cell(rows, 0, 0) == "unterminated"


func test_lenient_unterminated_quote_with_data() -> Bool:
	rows: List[List[String]] = parse_csv("a,\"unclosed,more\nb,c")
	rows.length() >= 1


func test_quoted_empty_adjacent() -> Bool:
	rows: List[List[String]] = parse_csv("\"\",\"\"")
	row_len(rows, 0) == 2 and cell(rows, 0, 0) == "" and cell(rows, 0, 1) == ""


func test_only_newlines() -> Bool:
	rows: List[List[String]] = parse_csv("\n\n\n")
	rows.length() == 3


-- ============================================================================
-- Formatting
-- ============================================================================
func test_format_simple() -> Bool:
	format_csv([["a", "b"], ["c", "d"]]) == "a,b\r\nc,d"


func test_format_with_comma() -> Bool:
	format_csv([["a,b", "c"]]) == "\"a,b\",c"


func test_format_with_quote() -> Bool:
	format_csv([["say \"hi\"", "b"]]) == "\"say \"\"hi\"\"\",b"


func test_format_with_newline() -> Bool:
	format_csv([["line1\nline2", "b"]]) == "\"line1\nline2\",b"


func test_format_with_cr() -> Bool:
	format_csv([["a\rb", "c"]]) == "\"a\rb\",c"


func test_format_single_row_func() -> Bool:
	format_csv_row(["a", "b", "c"]) == "a,b,c"


func test_format_empty_list() -> Bool:
	format_csv([]) == ""


func test_format_single_row_no_special() -> Bool:
	format_csv([["hello", "world"]]) == "hello,world"


func test_format_empty_fields() -> Bool:
	format_csv([["", "", ""]]) == ",,"


func test_format_single_empty_field() -> Bool:
	format_csv([[""]]) == ""


func test_format_quoted_only_quote() -> Bool:
	format_csv([["\""]]) == "\"\"\"\""


func test_format_field_with_crlf() -> Bool:
	format_csv([["a\r\nb"]]) == "\"a\r\nb\""


-- ============================================================================
-- Roundtrip
-- ============================================================================
func test_roundtrip_simple() -> Bool:
	original: List[List[String]] = [["a", "b"], ["c", "d"]]
	rt: List[List[String]] = parse_csv(format_csv(original))
	cell(
		rt,
		0,
		0,
	) == "a" and cell(rt, 0, 1) == "b" and cell(rt, 1, 0) == "c" and cell(rt, 1, 1) == "d"


func test_roundtrip_quoted() -> Bool:
	original: List[List[String]] = [["a,b", "say \"hi\""], ["line1\nline2", "normal"]]
	rt: List[List[String]] = parse_csv(format_csv(original))
	cell(
		rt,
		0,
		0,
	) == "a,b" and cell(
		rt,
		0,
		1,
	) == "say \"hi\"" and cell(rt, 1, 0) == "line1\nline2" and cell(rt, 1, 1) == "normal"


func test_roundtrip_empty_fields() -> Bool:
	original: List[List[String]] = [["", "a", ""], ["b", "", "c"]]
	rt: List[List[String]] = parse_csv(format_csv(original))
	cell(
		rt,
		0,
		0,
	) == "" and cell(
		rt,
		0,
		1,
	) == "a" and cell(rt, 0, 2) == "" and cell(rt, 1, 1) == "" and cell(rt, 1, 2) == "c"


func test_roundtrip_just_quotes() -> Bool:
	original: List[List[String]] = [["\"", "\"\""]]
	rt: List[List[String]] = parse_csv(format_csv(original))
	cell(rt, 0, 0) == "\"" and cell(rt, 0, 1) == "\"\""


func test_roundtrip_mixed_special() -> Bool:
	original: List[List[String]] = [["a,b", "c\nd", "e\"f", "normal"]]
	rt: List[List[String]] = parse_csv(format_csv(original))
	cell(
		rt,
		0,
		0,
	) == "a,b" and cell(
		rt,
		0,
		1,
	) == "c\nd" and cell(rt, 0, 2) == "e\"f" and cell(rt, 0, 3) == "normal"


-- ============================================================================
-- Config (TSV + custom delimiter)
-- ============================================================================
func test_tsv_parse() -> Bool:
	rows: List[List[String]] = parse_csv_with_config("a\tb\tc", tsv_config())
	row_len(rows, 0) == 3 and cell(rows, 0, 0) == "a" and cell(rows, 0, 2) == "c"


func test_tsv_format() -> Bool:
	format_csv_with_config([["a", "b"], ["c", "d"]], tsv_config()) == "a\tb\r\nc\td"


func test_tsv_with_commas() -> Bool:
	rows: List[List[String]] = parse_csv_with_config("a,b\tc", tsv_config())
	row_len(rows, 0) == 2 and cell(rows, 0, 0) == "a,b" and cell(rows, 0, 1) == "c"


func test_tsv_quoted_with_tab() -> Bool:
	rows: List[List[String]] = parse_csv_with_config("\"a\tb\"\tc", tsv_config())
	cell(rows, 0, 0) == "a\tb" and cell(rows, 0, 1) == "c"


func test_custom_delimiter() -> Bool:
	config: CsvConfig = {
		delimiter = '|',
		quote_char = '\"'
	}
	rows: List[List[String]] = parse_csv_with_config("a|b|c", config)
	row_len(rows, 0) == 3 and cell(rows, 0, 1) == "b"


func test_custom_delimiter_format() -> Bool:
	config: CsvConfig = {
		delimiter = ';',
		quote_char = '\"'
	}
	format_csv_with_config([["a", "b;c", "d"]], config) == "a;\"b;c\";d"


func test_custom_quote_char() -> Bool:
	config: CsvConfig = {
		delimiter = ',',
		quote_char = '\''
	}
	rows: List[List[String]] = parse_csv_with_config("'a,b',c", config)
	cell(rows, 0, 0) == "a,b" and cell(rows, 0, 1) == "c"


func test_tsv_roundtrip() -> Bool:
	config: CsvConfig = tsv_config()
	original: List[List[String]] = [["a\tb", "c"], ["d", "e"]]
	rt: List[List[String]] = parse_csv_with_config(format_csv_with_config(original, config), config)
	cell(rt, 0, 0) == "a\tb" and cell(rt, 0, 1) == "c"


-- ============================================================================
-- Strict Parsing
-- ============================================================================
func test_try_parse_valid() -> Bool:
	match try_parse_csv("a,b\nc,d"):
		Ok(rows): rows.length() == 2 and cell(rows, 0, 0) == "a"
		Err(_): False


func test_try_parse_unterminated_quote() -> Bool:
	match try_parse_csv("\"unterminated"):
		Ok(_): False
		Err(e): e.line == 1 and e.column == 1


func test_try_parse_unterminated_second_row() -> Bool:
	match try_parse_csv("a,b\n\"unclosed"):
		Ok(_): False
		Err(e): e.line == 2


func test_try_parse_unterminated_mid_field() -> Bool:
	match try_parse_csv("ok,\"oops"):
		Ok(_): False
		Err(e): e.line == 1


func test_try_parse_quoted_ok() -> Bool:
	match try_parse_csv("\"a,b\",\"c\"\"d\""):
		Ok(rows): cell(rows, 0, 0) == "a,b" and cell(rows, 0, 1) == "c\"d"
		Err(_): False


func test_try_parse_with_config() -> Bool:
	match try_parse_csv_with_config("a\t\"b", tsv_config()):
		Ok(_): False
		Err(e): e.line == 1


func test_format_error_msg() -> Bool:
	err: CsvError = {
		line = 3,
		column = 15,
		message = "unterminated quoted field"
	}
	format_error(err) == "line 3, column 15: unterminated quoted field"


-- ============================================================================
-- Header-Aware
-- ============================================================================
func test_headers_basic() -> Bool:
	dicts: List[Dict[String, String]] = parse_csv_with_headers("name,age\nAlice,30\nBob,25")
	if dicts.length() != 2:
		False
	else:
		match get(dicts, 0):
			Some(d): D.get_or(d, "name", "") == "Alice" and D.get_or(d, "age", "") == "30"
			None: False


func test_headers_second_row() -> Bool:
	dicts: List[Dict[String, String]] = parse_csv_with_headers("name,age\nAlice,30\nBob,25")
	if dicts.length() != 2:
		False
	else:
		match get(dicts, 1):
			Some(d): D.get_or(d, "name", "") == "Bob" and D.get_or(d, "age", "") == "25"
			None: False


func test_headers_empty_input() -> Bool:
	parse_csv_with_headers("").length() == 0


func test_headers_only_no_data() -> Bool:
	parse_csv_with_headers("name,age\n").length() == 0


func test_headers_short_row() -> Bool:
	dicts: List[Dict[String, String]] = parse_csv_with_headers("a,b,c\n1,2")
	if dicts.length() != 1:
		False
	else:
		match get(dicts, 0):
			Some(d): D.get_or(d, "a", "") == "1" and D.get_or(d, "b", "") == "2"
			None: False


func test_headers_quoted() -> Bool:
	dicts: List[Dict[String, String]] = parse_csv_with_headers("\"first name\",age\n\"Alice B\",30")
	if dicts.length() != 1:
		False
	else:
		match get(dicts, 0):
			Some(d): D.get_or(d, "first name", "") == "Alice B"
			None: False


-- ============================================================================
-- Real-World Patterns
-- ============================================================================
func test_typical_csv() -> Bool:
	csv: String = "id,name,email,active\n1,Alice,alice@example.com,true\n2,Bob,bob@example.com,false"
	rows: List[List[String]] = parse_csv(csv)
	length(
		rows,
	) == 3 and cell(
		rows,
		0,
		0,
	) == "id" and cell(rows, 1, 2) == "alice@example.com" and cell(rows, 2, 3) == "false"


func test_csv_with_quoted_commas() -> Bool:
	csv: String = "name,address\n\"Smith, John\",\"123 Main St, Apt 4\""
	rows: List[List[String]] = parse_csv(csv)
	length(
		rows,
	) == 2 and cell(rows, 1, 0) == "Smith, John" and cell(rows, 1, 1) == "123 Main St, Apt 4"


func test_csv_with_multiline_field() -> Bool:
	csv: String = "id,notes\n1,\"First line\nSecond line\"\n2,simple"
	rows: List[List[String]] = parse_csv(csv)
	length(
		rows,
	) == 3 and cell(rows, 1, 1) == "First line\nSecond line" and cell(rows, 2, 1) == "simple"


