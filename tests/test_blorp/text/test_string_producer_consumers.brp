import:
	list as L
	string: contains, replace, reverse, split, trim
	test: TestSuite


func test_direct_replace_length() -> Bool:
	"red blue red"
		.replace("red", "green")
		.length() == 16


func test_direct_split_length() -> Bool:
	"a,b,c"
		.split(",")
		.length() == 3


func test_direct_reverse_length() -> Bool:
	"abcdef"
		.reverse()
		.length() == 6


func test_direct_trim_length() -> Bool:
	"   hello   "
		.trim()
		.length() == 5


func test_escaped_replace_still_reusable() -> Bool:
	result: String = "red blue red".replace("red", "green")
	result.length() == 16 and result.contains("blue") and result == "green blue green"


func test_escaped_split_still_reusable() -> Bool:
	parts: List[String] = "a,b,c".split(",")
	middle_ok: Bool = match L.get(parts, 1):
		Some(part): part == "b"
		None: False
	parts.length() == 3 and middle_ok


func test_escaped_reverse_still_reusable() -> Bool:
	result: String = "abcdef".reverse()
	result.length() == 6 and result == "fedcba"


func test_escaped_trim_still_reusable() -> Bool:
	result: String = "   hello   ".trim()
	result.length() == 5 and result == "hello"


tests: TestSuite = {
	description = "String producer/consumer semantics",
	tests = [
		("direct replace length", test_direct_replace_length),
		("direct split length", test_direct_split_length),
		("direct reverse length", test_direct_reverse_length),
		("direct trim length", test_direct_trim_length),
		("escaped replace reusable", test_escaped_replace_still_reusable),
		("escaped split reusable", test_escaped_split_still_reusable),
		("escaped reverse reusable", test_escaped_reverse_still_reusable),
		("escaped trim reusable", test_escaped_trim_still_reusable),
	]
}
