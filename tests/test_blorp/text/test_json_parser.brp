import:
	json:
		JsonError,
		JsonValue(JsonObject, JsonNumber, JsonVector, JsonString, JsonNull, JsonBool),
		as_array,
		as_bool,
		as_number,
		as_string,
		format_error,
		get_field,
		is_null,
		parse,
		parse_json,
		parse_json_detailed,
		to_string,
	parser: ParseResult(Failure, Success)
	string: from_char
	test: TestSuite


-- Test JSON Parser
-- Helper to build JSON string with quotes
func make_json_string(content: String) -> String:
	"\"" + content + "\""


-- Helper to build JSON object
func json_obj(content: String) -> String:
	"{" + content + "}"


func expect_json_ok(source: String) -> Bool:
	match parse_json_detailed(source):
		Ok(_): True
		Err(_): False


func expect_json_err(source: String) -> Bool:
	match parse_json_detailed(source):
		Ok(_): False
		Err(_): True


-- Test parsing null
func test_parse_null() -> Bool:
	result: ParseResult[JsonValue] = parse("null")
	match result:
		Success(v, _): is_null(v)
		Failure(_, _): False


-- Test parsing true
func test_parse_true() -> Bool:
	result: ParseResult[JsonValue] = parse("true")
	match result:
		Success(v, _):
			match as_bool(v):
				Some(b): b == True
				None: False
		Failure(_, _): False


-- Test parsing false
func test_parse_false() -> Bool:
	result: ParseResult[JsonValue] = parse("false")
	match result:
		Success(v, _):
			match as_bool(v):
				Some(b): b == False
				None: False
		Failure(_, _): False


-- Test parsing integer
func test_parse_integer() -> Bool:
	result: ParseResult[JsonValue] = parse("42")
	match result:
		Success(v, _):
			match as_number(v):
				Some(n): n == 42.0
				None: False
		Failure(_, _): False


-- Test parsing negative number
func test_parse_negative() -> Bool:
	result: ParseResult[JsonValue] = parse("-123")
	match result:
		Success(v, _):
			match as_number(v):
				Some(n): n == -123.0
				None: False
		Failure(_, _): False


-- Test parsing decimal
func test_parse_decimal() -> Bool:
	result: ParseResult[JsonValue] = parse("3.14")
	match result:
		Success(v, _):
			match as_number(v):
				Some(n):
					-- Check approximately equal
					diff: Float = n - 3.14
					match diff < 0.0:
						True: -diff < 0.01
						False: diff < 0.01
				None: False
		Failure(_, _): False


-- Test parsing string
func test_parse_string() -> Bool:
	-- Build the JSON: "hello"
	source: String = make_json_string("hello")
	result: ParseResult[JsonValue] = parse(source)
	match result:
		Success(v, _):
			match as_string(v):
				Some(s): s == "hello"
				None: False
		Failure(_, _): False


-- Test parsing empty array
func test_parse_empty_array() -> Bool:
	result: ParseResult[JsonValue] = parse("[]")
	match result:
		Success(v, _):
			match as_array(v):
				Some(arr): arr.length() == 0
				None: False
		Failure(_, _): False


-- Test parsing array with numbers
func test_parse_number_array() -> Bool:
	result: ParseResult[JsonValue] = parse("[1, 2, 3]")
	match result:
		Success(v, _):
			match as_array(v):
				Some(arr): arr.length() == 3
				None: False
		Failure(_, _): False


-- Test parsing empty object
func test_parse_empty_object() -> Bool:
	result: ParseResult[JsonValue] = parse(json_obj(""))
	match result:
		Success(v, _):
			match get_field(v, "anything"):
				Some(_): False
				None: True
		Failure(_, _): False


-- Test JSON roundtrip (parse then serialize)
func test_roundtrip_null() -> Bool:
	s: String = JsonNull.to_string()
	s == "null"


func test_roundtrip_bool_true() -> Bool:
	s: String = JsonBool(True).to_string()
	s == "true"


func test_roundtrip_bool_false() -> Bool:
	s: String = JsonBool(False).to_string()
	s == "false"


func test_parse_json_rejects_trailing_input() -> Bool:
	match parse_json("true false"):
		Ok(_): False
		Err(_): True


func test_parse_json_allows_trailing_whitespace() -> Bool:
	match parse_json("true \n\t"):
		Ok(v):
			match as_bool(v):
				Some(b): b == True
				None: False
		Err(_): False


func test_parse_exponent_number() -> Bool:
	match parse_json("-1.25e+2"):
		Ok(v):
			match as_number(v):
				Some(n): n > -125.01 and n < -124.99
				None: False
		Err(_): False


func test_rejects_malformed_numbers() -> Bool:
	bad_leading_zero: Bool = match parse_json("01"):
		Ok(_): False
		Err(_): True
	bad_fraction: Bool = match parse_json("1."):
		Ok(_): False
		Err(_): True
	bad_exponent: Bool = match parse_json("1e"):
		Ok(_): False
		Err(_): True
	bad_minus: Bool = match parse_json("-"):
		Ok(_): False
		Err(_): True
	bad_leading_zero and bad_fraction and bad_exponent and bad_minus


func test_string_escape_decoding() -> Bool:
	match parse_json("\"a\\bb\\fc\\/d\""):
		Ok(v):
			match as_string(v):
				Some(s):
					expected: String = "a" + from_char(
						to_char(8),
					) + "b" + from_char(to_char(12)) + "c/d"
					s == expected
				None: False
		Err(_): False


func test_unicode_escape_decoding() -> Bool:
	match parse_json("\"\\u0041\\u00E9\""):
		Ok(v):
			match as_string(v):
				Some(s):
					expected: String = from_char(to_char(65)) + from_char(to_char(233))
					s == expected
				None: False
		Err(_): False


func test_unicode_surrogate_pair_decoding() -> Bool:
	match parse_json("\"\\uD83D\\uDE00\""):
		Ok(v):
			match as_string(v):
				Some(s): s == from_char(to_char(128512))
				None: False
		Err(_): False


func test_rejects_bad_string_escapes() -> Bool:
	bad_escape: Bool = match parse_json("\"\\x\""):
		Ok(_): False
		Err(_): True
	bad_hex: Bool = match parse_json("\"\\u12G4\""):
		Ok(_): False
		Err(_): True
	unpaired_high: Bool = match parse_json("\"\\uD83D\""):
		Ok(_): False
		Err(_): True
	unpaired_low: Bool = match parse_json("\"\\uDE00\""):
		Ok(_): False
		Err(_): True
	bad_escape and bad_hex and unpaired_high and unpaired_low


func test_rejects_unterminated_string() -> Bool:
	match parse_json("\"abc"):
		Ok(_): False
		Err(_): True


func test_rejects_unmatched_delimiters() -> Bool:
	open_array: Bool = match parse_json("[1, 2"):
		Ok(_): False
		Err(_): True
	open_object: Bool = match parse_json("{\"a\": 1"):
		Ok(_): False
		Err(_): True
	trailing_comma: Bool = match parse_json("[1,]"):
		Ok(_): False
		Err(_): True
	wrong_close: Bool = match parse_json("{]"):
		Ok(_): False
		Err(_): True
	open_array and open_object and trailing_comma and wrong_close


func test_rejects_duplicate_object_keys() -> Bool:
	match parse_json("{\"a\": 1, \"a\": 2}"):
		Ok(_): False
		Err(_): True


func test_duplicate_object_key_error_points_to_duplicate_key() -> Bool:
	source: String = "{\n  \"a\": 1,\n  \"a\": 2\n}"
	match parse_json_detailed(source):
		Ok(_): False
		Err(e): e.line == 3 and e.column == 3 and e.message == "duplicate object key"


func test_parse_failure_uses_scanner_positioned_error() -> Bool:
	match parse("[\n  \"\\x\"\n]"):
		Success(_, _): False
		Failure(message, rest):
			message.contains("line 2") and message.contains("column 4") and rest.starts_with("\\x")


func test_serializer_escapes_control_chars() -> Bool:
	raw: String = "a" + from_char(
		to_char(1),
	) + from_char(to_char(8)) + from_char(to_char(12)) + "\n"
	JsonString(raw).to_string() == "\"a\\u0001\\b\\f\\n\""


func test_serializer_maps_non_finite_numbers_to_null() -> Bool:
	inf: Float = 1.0 / 0.0
	nan: Float = 0.0 / 0.0
	JsonNumber(inf).to_string() == "null" and JsonVector([JsonNumber(nan)]).to_string() == "[null]"


func test_parse_json_trailing_error_includes_position() -> Bool:
	match parse_json("true\nfalse"):
		Ok(_): False
		Err(e): e.contains("line 2") and e.contains("column 1")


func test_parse_json_nested_error_includes_position() -> Bool:
	match parse_json("[\n  \"\\x\"\n]"):
		Ok(_): False
		Err(e): e.contains("line 2") and e.contains("column 4")


func test_parse_json_detailed_trailing_error() -> Bool:
	match parse_json_detailed("true\nfalse"):
		Ok(_): False
		Err(e):
			e.line == 2 and e.column == 1 and e.message == "unexpected trailing input"


func test_parse_json_detailed_nested_error() -> Bool:
	match parse_json_detailed("[\n  \"\\x\"\n]"):
		Ok(_): False
		Err(e):
			e.line == 2 and e.column == 4 and e.message == "invalid string escape"


func test_json_format_error() -> Bool:
	err: JsonError = {line = 3, column = 7, message = "bad value"}
	format_error(err) == "line 3, column 7: bad value"


func test_parse_rfc_shaped_nested_fixture() -> Bool:
	source: String = "{\"Image\":{\"Width\":800,\"Height\":600,\"Title\":\"View from 15th Floor\",\"Thumbnail\":{\"Url\":\"http://www.example.com/image/481989943\",\"Height\":125,\"Width\":100},\"Animated\":false,\"IDs\":[116,943,234,38793]}}"
	match parse_json(source):
		Ok(root):
			match get_field(root, "Image"):
				Some(image):
					match get_field(image, "IDs"):
						Some(ids):
							match as_array(ids):
								Some(items): items.length() == 4
								None: False
						None: False
				None: False
		Err(_): False


func test_parse_deeply_nested_arrays() -> Bool:
	var source: String = "0"
	var i: Int = 0
	while i < 32:
		source = "[" + source + "]"
		i += 1
	match parse_json(source):
		Ok(_): True
		Err(_): False


func test_json_conformance_valid_scalars() -> Bool:
	values: List[String] = [
		"null",
		"true",
		"false",
		"0",
		"-0",
		"1234567890",
		"-12.34e+56",
		"\"\"",
		"\"plain text\"",
		"\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"",
		"\"\\u0000\\u001F\\u007F\"",
	]
	var ok: Bool = True
	var i: Int = 0
	while i < values.length() and ok:
		match values.get(i):
			Some(input): ok = expect_json_ok(input)
			None: ok = False
		i += 1
	ok


func test_json_conformance_valid_containers() -> Bool:
	values: List[String] = [
		"[]",
		"{}",
		"[true,false,null,\"x\",0,-1,1.5e-2]",
		"{\"a\":[],\"b\":{},\"c\":{\"d\":[1,2,3]}}",
		" \n\t {\"space\" : [ 1 , 2 , 3 ] } \r\n",
	]
	var ok: Bool = True
	var i: Int = 0
	while i < values.length() and ok:
		match values.get(i):
			Some(input): ok = expect_json_ok(input)
			None: ok = False
		i += 1
	ok


func test_json_conformance_invalid_numbers() -> Bool:
	values: List[String] = [
		"+1",
		"01",
		"-01",
		".1",
		"1.",
		"1e",
		"1e+",
		"1e-",
		"0x10",
		"NaN",
		"Infinity",
	]
	var ok: Bool = True
	var i: Int = 0
	while i < values.length() and ok:
		match values.get(i):
			Some(input): ok = expect_json_err(input)
			None: ok = False
		i += 1
	ok


func test_json_conformance_invalid_structures() -> Bool:
	values: List[String] = [
		"",
		",",
		"[1,,2]",
		"[1,]",
		"{\"a\"}",
		"{\"a\":}",
		"{\"a\":1,}",
		"{a:1}",
		"'{\"a\":1}'",
		"// comment\ntrue",
	]
	var ok: Bool = True
	var i: Int = 0
	while i < values.length() and ok:
		match values.get(i):
			Some(input): ok = expect_json_err(input)
			None: ok = False
		i += 1
	ok


func test_json_conformance_invalid_strings() -> Bool:
	raw_control: String = "\"" + from_char(to_char(1)) + "\""
	values: List[String] = [
		raw_control,
		"\"\\v\"",
		"\"\\u\"",
		"\"\\u12\"",
		"\"\\uD800x\"",
		"\"\\uD800\\u0041\"",
		"\"\\uDC00\"",
		"\"unterminated",
	]
	var ok: Bool = True
	var i: Int = 0
	while i < values.length() and ok:
		match values.get(i):
			Some(input): ok = expect_json_err(input)
			None: ok = False
		i += 1
	ok


tests: TestSuite = {
	description = "JSON Parser Tests",
	tests = [
		("parse null", test_parse_null),
		("parse true", test_parse_true),
		("parse false", test_parse_false),
		("parse integer", test_parse_integer),
		("parse negative", test_parse_negative),
		("parse decimal", test_parse_decimal),
		("parse string", test_parse_string),
		("parse empty array", test_parse_empty_array),
		("parse number array", test_parse_number_array),
		("parse empty object", test_parse_empty_object),
		("roundtrip null", test_roundtrip_null),
		("roundtrip bool true", test_roundtrip_bool_true),
		("roundtrip bool false", test_roundtrip_bool_false),
		("parse_json rejects trailing input", test_parse_json_rejects_trailing_input),
		("parse_json allows trailing whitespace", test_parse_json_allows_trailing_whitespace),
		("parse exponent number", test_parse_exponent_number),
		("rejects malformed numbers", test_rejects_malformed_numbers),
		("string escape decoding", test_string_escape_decoding),
		("unicode escape decoding", test_unicode_escape_decoding),
		("unicode surrogate pair decoding", test_unicode_surrogate_pair_decoding),
		("rejects bad string escapes", test_rejects_bad_string_escapes),
		("rejects unterminated string", test_rejects_unterminated_string),
		("rejects unmatched delimiters", test_rejects_unmatched_delimiters),
		("rejects duplicate object keys", test_rejects_duplicate_object_keys),
		(
			"duplicate object key error points to duplicate key",
			test_duplicate_object_key_error_points_to_duplicate_key,
		),
		(
			"parse failure uses scanner positioned error",
			test_parse_failure_uses_scanner_positioned_error,
		),
		("serializer escapes control chars", test_serializer_escapes_control_chars),
		(
			"serializer maps non finite numbers to null",
			test_serializer_maps_non_finite_numbers_to_null,
		),
		(
			"parse_json trailing error includes position",
			test_parse_json_trailing_error_includes_position,
		),
		(
			"parse_json nested error includes position",
			test_parse_json_nested_error_includes_position,
		),
		("parse_json_detailed trailing error", test_parse_json_detailed_trailing_error),
		("parse_json_detailed nested error", test_parse_json_detailed_nested_error),
		("json format_error", test_json_format_error),
		("parse rfc shaped nested fixture", test_parse_rfc_shaped_nested_fixture),
		("parse deeply nested arrays", test_parse_deeply_nested_arrays),
		("json conformance valid scalars", test_json_conformance_valid_scalars),
		("json conformance valid containers", test_json_conformance_valid_containers),
		("json conformance invalid numbers", test_json_conformance_invalid_numbers),
		("json conformance invalid structures", test_json_conformance_invalid_structures),
		("json conformance invalid strings", test_json_conformance_invalid_strings),
	],
}
