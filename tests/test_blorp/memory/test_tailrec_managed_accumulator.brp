import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


@tail_recursive
pure func collect_labels(remaining: Int, acc: List[String]) -> List[String]:
	if remaining <= 0:
		acc
	else:
		collect_labels(remaining - 1, acc.append("item-${remaining}"))


func test_tailrec_managed_accumulator_releases_intermediates() -> Bool:
	reset_mem_stats()
	var ok: Bool = True
	var i: Int = 0

	while i < 200:
		empty: List[String] = []
		labels: List[String] = collect_labels(8, empty)
		ok = ok and labels.length() == 8 and labels.get_or(0, "") == "item-8"
		i += 1

	stats: MemStats = get_mem_stats()
	ok and stats.total_allocations > 0 and stats.total_releases > 0 and stats.current_objects < 80


tests: TestSuite = {
	description = "Tailrec Managed Accumulator",
	tests = [
		(
			"tailrec managed accumulator releases intermediates",
			test_tailrec_managed_accumulator_releases_intermediates,
		),
	]
}
