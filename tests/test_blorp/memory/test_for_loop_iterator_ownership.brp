import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


func test_owned_list_iterator_with_break_is_released() -> Bool:
	reset_mem_stats()
	var total: Int = 0
	var i: Int = 0

	while i < 200:
		for n in [1, 2, 3]:
			total += n
			break

		i += 1

	stats: MemStats = get_mem_stats()

	(
		total == 200
		and stats.total_allocations > 0
		and stats.total_releases > 0
		and stats.current_objects < 20
	)


func test_owned_list_iterator_with_continue_is_released() -> Bool:
	reset_mem_stats()
	var total: Int = 0
	var i: Int = 0

	while i < 200:
		for n in [1, 2, 3]:
			if n == 2:
				continue

			total += n

		i += 1

	stats: MemStats = get_mem_stats()

	(
		total == 800
		and stats.total_allocations > 0
		and stats.total_releases > 0
		and stats.current_objects < 20
	)


tests: TestSuite = {
	description = "For Loop Iterator Ownership",
	tests = [
		(
			"owned list iterator with break is released",
			test_owned_list_iterator_with_break_is_released,
		),
		(
			"owned list iterator with continue is released",
			test_owned_list_iterator_with_continue_is_released,
		),
	]
}
