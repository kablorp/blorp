import:
	test: TestSuite


union WorkError:
	Failed(String)


pure func accumulated_result() -> Result[Int, WorkError]:
	var failure: Option[WorkError] = None
	failure = Some(Failed("expected failure"))

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(0)


func test_returns_owned_payload_from_mutable_option() -> Bool:
	match accumulated_result():
		Err(Failed(message)):
			message == "expected failure"
		_:
			False


tests: TestSuite = {
	description = "Mutable Option payload ownership",
	tests = [
		(
			"returns owned payload from mutable option",
			test_returns_owned_payload_from_mutable_option,
		),
	]
}
