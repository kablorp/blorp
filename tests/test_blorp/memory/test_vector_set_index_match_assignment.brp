import:
	tensor: get_or, set_index
	test: TestSuite


pure func set_twice_through_match() -> Int:
	var values: Int[#4] = vector(0, 4)
	match set_index(values, 0, 11):
		Some(next_values):
			values = next_values
			match set_index(values, 1, 31):
				Some(next_next_values):
					values = next_next_values
				None: void
		None: void
	get_or(values, 0, 0) + get_or(values, 1, 0)


func test_vector_set_index_match_assignment_keeps_target_alive() -> Bool:
	set_twice_through_match() == 42


tests: TestSuite = {
	description = "vector set_index match assignment ownership",
	tests = [
		(
			"vector set_index match assignment keeps target alive",
			test_vector_set_index_match_assignment_keeps_target_alive,
		),
	],
}
