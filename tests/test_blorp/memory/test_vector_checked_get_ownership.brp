import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


func test_managed_vector_reads_do_not_retain_extra_refs() -> Bool:
	reset_mem_stats()
	var i: Int = 0
	var total: Int = 0
	while i < 50:
		values: (Int, Int)[#16] = vector((1, 2), 16)
		for j in 0..length(values):
			pair: (Int, Int) = values[j]
			total += pair.0
		i += 1
	stats: MemStats = get_mem_stats()
	total == 800 and stats.current_objects <= 5


tests: TestSuite = {
	description = "Vector Checked Get Ownership",
	tests = [
		(
			"managed vector reads do not retain extra refs",
			test_managed_vector_reads_do_not_retain_extra_refs,
		),
	],
}
