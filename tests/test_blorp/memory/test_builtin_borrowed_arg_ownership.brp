import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	process: run
	string: trim
	system: exec_output, remove_file, setenv, write_bytes
	test: TestSuite


func write_bytes_with_owned_local() -> Bool:
	path: String = "/tmp/blorp_builtin_borrowed_arg_ownership.bin"
	src: Bytes = "owned bytes".to_bytes()
	ok: Bool = match write_bytes(path, src):
		Ok(_): True
		Err(_): False
	_ = remove_file(path)
	ok


func run_with_inline_args() -> Bool:
	match run("echo", ["hello"]):
		Ok(out): trim(out.0) == "hello"
		Err(_): False


func exec_output_with_owned_command() -> Bool:
	command: String = "printf " + "ok"
	match exec_output(command):
		Ok(out): out == "ok"
		Err(_): False


func setenv_with_owned_value() -> Bool:
	value: String = "owned_" + "value"
	setenv("BLORP_BORROWED_ARG_OWNERSHIP", value)


func test_write_bytes_borrowed_arg_drops_local() -> Bool:
	reset_mem_stats()
	ok: Bool = write_bytes_with_owned_local()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_process_run_drops_inline_arg_list() -> Bool:
	reset_mem_stats()
	ok: Bool = run_with_inline_args()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_exec_output_drops_owned_command() -> Bool:
	reset_mem_stats()
	ok: Bool = exec_output_with_owned_command()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_setenv_drops_owned_value() -> Bool:
	reset_mem_stats()
	ok: Bool = setenv_with_owned_value()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


tests: TestSuite = {
	description = "Builtin Borrowed Arg Ownership",
	tests = [
		("write_bytes borrowed arg drops local", test_write_bytes_borrowed_arg_drops_local),
		("process run drops inline arg list", test_process_run_drops_inline_arg_list),
		("exec_output drops owned command", test_exec_output_drops_owned_command),
		("setenv drops owned value", test_setenv_drops_owned_value),
	],
}
