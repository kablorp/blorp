import:
	list: find
	memory: MemStats, get_mem_stats, reset_mem_stats
	process: run, stdout
	string: trim
	system: exec_output, remove_file, setenv, write_bytes
	test: TestSuite


record BorrowedArgNode {
	items: List[String]
}


record BorrowedArgOuter {
	node: BorrowedArgNode
}


record BorrowedArgProgram {
	module_name: String
}


record BorrowedArgModule {
	program: BorrowedArgProgram
}


record ConditionallyStoredName {
	name: String
}


opaque type BorrowedArgDocumentText = String


record BorrowedArgText {
	value: BorrowedArgDocumentText
}


opaque type BorrowedArgTextSnapshot = BorrowedArgText


private union BorrowedArgListResolution:
	BorrowedArgListMissing
	BorrowedArgListFound(String)
	BorrowedArgListAmbiguous(List[String])


private pure func borrowed_arg_item_count(items: List[String]) -> Int:
	items.length()


private pure func nested_owned_borrowed_arg() -> BorrowedArgOuter:
	{node = {items = ["nested"]}}


private pure func nested_owned_projection_result() -> List[String]:
	nested_owned_borrowed_arg().node.items


private pure func owned_borrowed_arg_module() -> BorrowedArgModule:
	{program = {module_name = "main"}}


private pure func nested_owned_projection_list_element() -> List[String]:
	[owned_borrowed_arg_module().program.module_name]


private pure func borrowed_arg_text_value(
	snapshot: BorrowedArgTextSnapshot,
) -> BorrowedArgDocumentText:
	representation: BorrowedArgText = from BorrowedArgTextSnapshot(snapshot)
	representation.value


private pure func compare_owned_call_results() -> Bool:
	left_value: BorrowedArgDocumentText = into BorrowedArgDocumentText("sa" + "me")
	right_value: BorrowedArgDocumentText = into BorrowedArgDocumentText("sam" + "e")
	left: BorrowedArgTextSnapshot = into BorrowedArgTextSnapshot({value = left_value})
	right: BorrowedArgTextSnapshot = into BorrowedArgTextSnapshot({value = right_value})
	borrowed_arg_text_value(left) == borrowed_arg_text_value(right)


private pure func owned_order_key(value: String) -> String:
	"loaded:" + value


private pure func order_owned_call_results() -> Bool:
	owned_order_key("alpha") < owned_order_key("zeta")


private pure func count_list_prefixes() -> Int:
	var pending: List[String] = ["alpha", "beta"]
	var count: Int = 0

	while pending.length() > 0:
		match pending:
			[]:
				void
			[_, ...remaining]:
				pending = remaining
				count += 1

	count


private pure func filtered_managed_record_count() -> Int:
	nodes: List[BorrowedArgNode] = [{items = ["kept"]}]
	nodes
		.filter(func(node): node.items.length() == 1)
		.length()


private pure func resolve_owned_list(values: List[String]) -> BorrowedArgListResolution:
	match values:
		[]:
			BorrowedArgListMissing
		[value]:
			BorrowedArgListFound(value)
		_:
			BorrowedArgListAmbiguous(values)


private pure func list_match_branch_transfer_count() -> Int:
	missing = resolve_owned_list([])
	found = resolve_owned_list(["found"])

	count: Int = match missing:
		BorrowedArgListMissing:
			1
		_:
			0

	match found:
		BorrowedArgListFound(value):
			count + value.length()
		_:
			count


func write_bytes_with_owned_local() -> Bool:
	path: String = "/tmp/blorp_builtin_borrowed_arg_ownership.bin"
	src: Bytes = "owned bytes".to_bytes()

	ok: Bool = match write_bytes(path, src):
		Ok(_):
			True
		Err(_):
			False

	_ = remove_file(path)
	ok


func run_with_inline_args() -> Bool:
	match run("echo", ["hello"]):
		Ok(out):
			trim(out.stdout()) == "hello"
		Err(_):
			False


func exec_output_with_owned_command() -> Bool:
	command: String = "printf " + "ok"

	match exec_output(command):
		Ok(out):
			out == "ok"
		Err(_):
			False


func setenv_with_owned_value() -> Bool:
	value: String = "owned_" + "value"
	setenv("BLORP_BORROWED_ARG_OWNERSHIP", value)


private pure func find_managed_list_item() -> Bool:
	nodes: List[BorrowedArgNode] = [{items = ["found"]}]

	match nodes.find(func(_node: BorrowedArgNode): True):
		Some(node):
			node.items.length() == 1
		None:
			False


private pure func flat_map_managed_list_item_count() -> Int:
	["managed"]
		.flat_map(func(value: String): [value])
		.length()


private pure func conditionally_store_then_borrow(name: String, store: Bool) -> Int:
	stored = if store:
		Some({name = name})
	else:
		None

	length = name.length()

	match stored:
		Some(value):
			length + value.name.length()
		None:
			length


func test_write_bytes_borrowed_arg_drops_local() -> Bool:
	reset_mem_stats()
	ok: Bool = write_bytes_with_owned_local()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_process_run_drops_inline_arg_list() -> Bool:
	reset_mem_stats()
	ok: Bool = run_with_inline_args()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_nested_owned_projection_borrow_drops_all_owners() -> Bool:
	reset_mem_stats()
	count: Int = borrowed_arg_item_count(nested_owned_borrowed_arg().node.items)
	stats: MemStats = get_mem_stats()
	count == 1 and stats.current_objects == 0


func test_nested_owned_projection_result_drops_all_owners() -> Bool:
	reset_mem_stats()
	count: Int = nested_owned_projection_result().length()
	stats: MemStats = get_mem_stats()
	count == 1 and stats.current_objects == 0


func test_nested_owned_projection_list_element_transfers_owner() -> Bool:
	reset_mem_stats()
	names: List[String] = nested_owned_projection_list_element()
	valid: Bool = names == ["main"]
	stats: MemStats = get_mem_stats()
	valid and stats.current_objects == 0


func test_exec_output_drops_owned_command() -> Bool:
	reset_mem_stats()
	ok: Bool = exec_output_with_owned_command()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_setenv_drops_owned_value() -> Bool:
	reset_mem_stats()
	ok: Bool = setenv_with_owned_value()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_find_managed_element_drops_list_and_result() -> Bool:
	reset_mem_stats()
	ok: Bool = find_managed_list_item()
	stats: MemStats = get_mem_stats()
	ok and stats.current_objects == 0


func test_flat_map_managed_elements_drop_input_and_result() -> Bool:
	reset_mem_stats()
	count: Int = flat_map_managed_list_item_count()
	stats: MemStats = get_mem_stats()
	count == 1 and stats.current_objects == 0


func test_let_rhs_non_consuming_branch_releases_reserved_owner() -> Bool:
	reset_mem_stats()
	length: Int = conditionally_store_then_borrow("ma" + "in", False)
	stats: MemStats = get_mem_stats()
	length == 4 and stats.current_objects == 0


func test_binary_borrow_drops_owned_call_results() -> Bool:
	reset_mem_stats()
	equal: Bool = compare_owned_call_results()
	stats: MemStats = get_mem_stats()
	equal and stats.current_objects == 0


func test_binary_ordering_drops_owned_call_results() -> Bool:
	reset_mem_stats()
	ordered: Bool = order_owned_call_results()
	stats: MemStats = get_mem_stats()
	ordered and stats.current_objects == 0


func test_mutable_prefix_assignment_releases_replaced_list() -> Bool:
	reset_mem_stats()
	count: Int = count_list_prefixes()
	stats: MemStats = get_mem_stats()
	count == 2 and stats.current_objects == 0


func test_filter_managed_elements_drop_input_and_result() -> Bool:
	reset_mem_stats()
	count: Int = filtered_managed_record_count()
	stats: MemStats = get_mem_stats()
	count == 1 and stats.current_objects == 0


func test_list_match_drops_owner_in_non_transfer_branches() -> Bool:
	reset_mem_stats()
	count: Int = list_match_branch_transfer_count()
	stats: MemStats = get_mem_stats()
	count == 6 and stats.current_objects == 0


tests: TestSuite = {
	description = "Builtin Borrowed Arg Ownership",
	tests = [
		("write_bytes borrowed arg drops local", test_write_bytes_borrowed_arg_drops_local),
		("process run drops inline arg list", test_process_run_drops_inline_arg_list),
		(
			"nested owned projection borrow drops all owners",
			test_nested_owned_projection_borrow_drops_all_owners,
		),
		(
			"nested owned projection result drops all owners",
			test_nested_owned_projection_result_drops_all_owners,
		),
		(
			"nested owned projection list element transfers owner",
			test_nested_owned_projection_list_element_transfers_owner,
		),
		("exec_output drops owned command", test_exec_output_drops_owned_command),
		("setenv drops owned value", test_setenv_drops_owned_value),
		(
			"find managed element drops list and result",
			test_find_managed_element_drops_list_and_result,
		),
		(
			"flat_map managed elements drop input and result",
			test_flat_map_managed_elements_drop_input_and_result,
		),
		(
			"let rhs non-consuming branch releases reserved owner",
			test_let_rhs_non_consuming_branch_releases_reserved_owner,
		),
		("binary borrow drops owned call results", test_binary_borrow_drops_owned_call_results),
		("binary ordering drops owned call results", test_binary_ordering_drops_owned_call_results),
		(
			"mutable prefix assignment releases replaced list",
			test_mutable_prefix_assignment_releases_replaced_list,
		),
		(
			"filter managed elements drop input and result",
			test_filter_managed_elements_drop_input_and_result,
		),
		(
			"list match drops owner in non-transfer branches",
			test_list_match_drops_owner_in_non_transfer_branches,
		),
	]
}
