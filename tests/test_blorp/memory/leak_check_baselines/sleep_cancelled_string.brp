import:
	test: cancel_after_parked_for_test


func payload(label: String) -> String:
	label + "-payload"


func blocked_sleep() -> Int:
	marker: String = payload("blocked-sleep")
	sleep(10000)
	if marker == "blocked-sleep-payload":
		1
	else:
		2


func run_cancelled_sleep_case() -> Bool:
	cancel_after_parked_for_test(func(): blocked_sleep())


func main(args: List[String]) -> Int:
	if run_cancelled_sleep_case():
		0
	else:
		1
