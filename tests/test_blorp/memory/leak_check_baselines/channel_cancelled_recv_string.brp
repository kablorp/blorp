import:
	channel: wait_recv
	test: cancel_after_parked_for_test


func payload(label: String) -> String:
	label + "-payload"


func blocked_recv(ch: Channel[Int]) -> Int:
	marker: String = payload("blocked-recv")
	received: Int = match recv(ch):
		Some(value): value
		None: -1
	if marker == "blocked-recv-payload":
		received
	else:
		-2


func blocked_wait_recv(ch: Channel[Int]) -> Int:
	marker: String = payload("blocked-wait-recv")
	received: Int = match wait_recv(ch):
		Ok(value): value
		Err(_): -1
	if marker == "blocked-wait-recv-payload":
		received
	else:
		-2


func blocked_recv_timeout(ch: Channel[Int]) -> Int:
	marker: String = payload("blocked-recv-timeout")
	received: Int = match recv_timeout(ch, 1000):
		Some(value): value
		None: -1
	if marker == "blocked-recv-timeout-payload":
		received
	else:
		-2


func channel_still_usable_after_cancel(ch: Channel[Int]) -> Bool:
	if send(ch, 7):
		match recv(ch):
			Some(value): value == 7
			None: False
	else:
		False


func run_cancelled_recv_case() -> Bool:
	ch: Channel[Int] = channel(1)
	cancelled: Bool = cancel_after_parked_for_test(func(): blocked_recv(ch))
	cancelled and channel_still_usable_after_cancel(ch)


func run_cancelled_wait_recv_case() -> Bool:
	ch: Channel[Int] = channel(1)
	cancelled: Bool = cancel_after_parked_for_test(func(): blocked_wait_recv(ch))
	cancelled and channel_still_usable_after_cancel(ch)


func run_cancelled_recv_timeout_case() -> Bool:
	ch: Channel[Int] = channel(1)
	cancelled: Bool = cancel_after_parked_for_test(func(): blocked_recv_timeout(ch))
	cancelled and channel_still_usable_after_cancel(ch)


func main(args: List[String]) -> Int:
	if (
		run_cancelled_recv_case()
		and run_cancelled_wait_recv_case()
		and run_cancelled_recv_timeout_case()
	):
		0
	else:
		1
