import:
	net/tcp: TcpError, accept, connect, listen, local_port, message, read_chunk
	string: contains
	test: cancel_after_parked_for_test


pure func is_socket_permission_error(err: TcpError) -> Bool:
	detail: String = message(err)
	detail.contains("Operation not permitted") or detail.contains("Permission denied")


func payload(label: String) -> String:
	label + "-payload"


func listen_probe() -> Result[Bool, TcpError]:
	with _ ?= listen("127.0.0.1", 0, 1):
		Ok(True)


func blocked_read_result() -> Result[Int, TcpError]:
	marker: String = payload("blocked-read")
	with listener ?= listen("127.0.0.1", 0, 1):
		port ?= local_port(listener)
		with _ ?= connect("127.0.0.1", port):
			with peer ?= accept(listener):
				data ?= read_chunk(peer, 64)
				if marker == "blocked-read-payload":
					Ok(data.length())
				else:
					Ok(-2)


func blocked_read() -> Int:
	match blocked_read_result():
		Ok(value): value
		Err(_): -1


func run_cancelled_read_case() -> Bool:
	match listen_probe():
		Ok(_): cancel_after_parked_for_test(func(): blocked_read())
		Err(err): is_socket_permission_error(err)


func main(args: List[String]) -> Int:
	if run_cancelled_read_case():
		0
	else:
		1
