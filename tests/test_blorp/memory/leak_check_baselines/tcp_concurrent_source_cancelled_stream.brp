import:
	net/tcp:
		IpFamily(IPv4),
		TcpError,
		connect_loopback,
		connections_stop_on_error,
		listen_loopback_any_port,
		local_port,
		message,
		port,
		read_chunk,
	string: contains
	test: cancel_after_parked_for_test


pure func is_socket_permission_error(err: TcpError) -> Bool:
	detail: String = message(err)
	detail.contains("Operation not permitted") or detail.contains("Permission denied")


func listen_probe() -> Result[Bool, TcpError]:
	with _ ?= listen_loopback_any_port(IPv4, 1):
		Ok(True)


func payload(label: String) -> String:
	label + "-payload"


func parent_parked_joining_resource_child() -> Result[Int, TcpError]:
	with listener ?= listen_loopback_any_port(IPv4, 16):
		port_num ?= local_port(listener)
		remote ?= port(port_num)
		with _ ?= connect_loopback(IPv4, remote):
			for peer in connections_stop_on_error(listener) concurrently(limit: 1):
				marker: String = payload("resource-child")
				match read_chunk(peer, 64):
					Ok(_): _ = marker
					Err(_): _ = marker
			Ok(1)


func blocked_resource_fanout() -> Int:
	match parent_parked_joining_resource_child():
		Ok(value): value
		Err(_): -1


func run_cancelled_resource_source_case() -> Bool:
	cancel_after_parked_for_test(func(): blocked_resource_fanout())


func main(args: List[String]) -> Int:
	match listen_probe():
		Ok(_):
			if run_cancelled_resource_source_case():
				0
			else:
				1
		Err(err):
			if is_socket_permission_error(err):
				0
			else:
				1
