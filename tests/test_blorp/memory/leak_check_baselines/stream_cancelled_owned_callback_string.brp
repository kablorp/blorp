import:
	stream: any, count, filter, from_list, map
	test: cancel_after_parked_for_test


func payload(label: String) -> String:
	label + "-payload"


func parked_predicate(value: String) -> Bool:
	sleep(1000)
	value.length() > 0


func parked_consumer(value: String) -> Int:
	sleep(1000)
	value.length()


func cancelled_filter_predicate() -> Int:
	count(filter(map(
				from_list([1]),
				func(item: Int): payload("filter"),
			), parked_predicate))


func cancelled_terminal_predicate() -> Int:
	if any(map(
			from_list([1]),
			func(item: Int): payload("terminal"),
		), parked_predicate):
		1
	else:
		0


func run_cancelled_owned_callback_cases() -> Bool:
	first: Bool = cancel_after_parked_for_test(func(): cancelled_filter_predicate())
	second: Bool = cancel_after_parked_for_test(func(): cancelled_terminal_predicate())
	first and second


func main(args: List[String]) -> Int:
	if run_cancelled_owned_callback_cases():
		0
	else:
		1
