import:
	test: cancel_after_parked_for_test


func payload(label: String) -> String:
	label + "-payload"


func select_result_then_sleep(ch: Channel[Result[String, String]]) -> Int:
	var got: Int = 0
	select:
		value from ch:
			sleep(10000)
			match value:
				Ok(text): got = text.length()
				Err(err): got = err.length()
		_ after 10000:
			got = -1
	got


func run_cancelled_select_result_case() -> Bool:
	ch: Channel[Result[String, String]] = channel(1)
	item: Result[String, String] = Ok(payload("select-result"))
	_ = send(ch, item)
	cancel_after_parked_for_test(func(): select_result_then_sleep(ch))


func main(args: List[String]) -> Int:
	if run_cancelled_select_result_case():
		0
	else:
		1
