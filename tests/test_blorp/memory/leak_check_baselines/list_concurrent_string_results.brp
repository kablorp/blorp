import:
	units: milliseconds


func payload(n: Int) -> String:
	"item-" + n.to_string()


func delayed_payload(n: Int) -> String:
	value: String = payload(n)
	sleep(1)
	value


func slow_owned_payload(n: Int) -> String:
	value: String = payload(n)
	sleep(1000)
	value


func test_concurrent_string_results() -> Bool:
	nums: List[Int] = [1, 2, 3]
	results: List[Result[String, ConcurrencyError]] = nums.concurrent(
		2,
		func(n: Int): delayed_payload(n),
	)
	var count: Int = 0
	var all_ok: Bool = True
	for result in results:
		match result:
			Ok(value):
				if value.starts_with("item-"):
					count += 1
				else:
					all_ok = False
			Err(_): all_ok = False
	all_ok and count == 3


func test_concurrent_timeout_releases_cancelled_string_locals() -> Bool:
	nums: List[Int] = [1, 2, 3]
	results: List[Result[String, ConcurrencyError]] = nums.concurrent_with_timeout(
		2,
		milliseconds(10),
		func(n: Int): slow_owned_payload(n),
	)
	var timed_out: Int = 0
	for result in results:
		match result:
			Ok(_): void
			Err(_): timed_out += 1
	timed_out > 0


func main(args: List[String]) -> Int:
	if test_concurrent_string_results() and test_concurrent_timeout_releases_cancelled_string_locals():
		0
	else:
		1
