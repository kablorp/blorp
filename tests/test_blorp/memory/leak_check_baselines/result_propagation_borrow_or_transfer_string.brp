private pure func consume_or_error(key: String, succeeds: Bool) -> Result[Int, String]:
	if succeeds:
		Ok(1)
	else:
		Err(key)


private pure func decode_key(key: String, valid: Bool) -> Result[Int, String]:
	value ?= consume_or_error(key, True)

	if valid:
		Ok(value)
	else:
		Err(key)


func main(args: List[String]) -> Int:
	match decode_key("schema", True):
		Ok(value):
			value - 1
		Err(_):
			1
