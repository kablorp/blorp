import:
	net/udp: Datagram, UdpError, bind, datagrams, message, socket
	stream: find_result
	string: contains
	test: cancel_after_parked_for_test


pure func is_socket_permission_error(err: UdpError) -> Bool:
	detail: String = message(err)
	detail.contains("Operation not permitted") or detail.contains("Permission denied")


func payload(label: String) -> String:
	label + "-payload"


func socket_probe() -> Result[Bool, UdpError]:
	with sock ?= socket():
		ignored ?= bind(sock, "127.0.0.1", 0)
		Ok(True)


func blocked_stream_result() -> Result[Int, UdpError]:
	marker: String = payload("blocked-datagram-stream")
	with sock ?= socket():
		ignored ?= bind(sock, "127.0.0.1", 0)
		found ?= sock
			.datagrams(64)
			.find_result(func(datagram: Datagram): True)
		if marker == "blocked-datagram-stream-payload":
			match found:
				Some(datagram): Ok(datagram.data.length())
				None: Ok(0)
		else:
			Ok(-2)


func blocked_stream() -> Int:
	match blocked_stream_result():
		Ok(value): value
		Err(_): -1


func run_cancelled_stream_case() -> Bool:
	match socket_probe():
		Ok(_): cancel_after_parked_for_test(func(): blocked_stream())
		Err(err): is_socket_permission_error(err)


func main(args: List[String]) -> Int:
	if run_cancelled_stream_case():
		0
	else:
		1
