import:
	net/udp: Datagram, UdpError, bind, datagrams, local_port, message, send_to, socket
	stream: find_result
	string: contains
	test: cancel_after_parked_for_test


pure func is_socket_permission_error(err: UdpError) -> Bool:
	detail: String = message(err)
	detail.contains("Operation not permitted") or detail.contains("Permission denied")


func parked_predicate(datagram: Datagram) -> Bool:
	sleep(1000)
	datagram.data.length() > 0


func socket_probe() -> Result[Bool, UdpError]:
	with sock ?= socket():
		ignored ?= bind(sock, "127.0.0.1", 0)
		Ok(True)


func blocked_predicate_result() -> Result[Int, UdpError]:
	with receiver ?= socket():
		ignored ?= bind(receiver, "127.0.0.1", 0)
		port ?= local_port(receiver)

		with sender ?= socket():
			sent ?= send_to(sender, "payload".to_bytes(), "127.0.0.1", port)
			found ?= receiver
				.datagrams(64)
				.find_result(parked_predicate)

			match found:
				Some(datagram):
					Ok(datagram.data.length() + sent)
				None:
					Ok(0)


func blocked_predicate() -> Int:
	match blocked_predicate_result():
		Ok(value):
			value
		Err(_):
			-1


func run_cancelled_predicate_case() -> Bool:
	match socket_probe():
		Ok(_):
			cancel_after_parked_for_test(func(): blocked_predicate())
		Err(err):
			is_socket_permission_error(err)


func main(args: List[String]) -> Int:
	if run_cancelled_predicate_case():
		0
	else:
		1
