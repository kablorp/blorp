import:
	list: range


func main(args: List[String]) -> Int:
	results: List[Result[Int, ConcurrencyError]] = concurrent(max_threads: 2)  for i in range(0, 8):
		i + 1
	var total: Int = 0
	for result in results:
		match result:
			Ok(n): total += n
			Err(_): total -= 1000
	if total == 36:
		0
	else:
		1
