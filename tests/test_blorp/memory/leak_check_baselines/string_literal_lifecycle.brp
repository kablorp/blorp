record LabelBox {
	label: String
}


GLOBAL_BOX: LabelBox = {label = "shared"}


func accepts(value: String) -> Bool:
	value == "temporary"


func make_label_box() -> LabelBox:
	{label = GLOBAL_BOX.label}


func main(args: List[String]) -> Int:
	var index: Int = 0
	var result: Int = 0

	while index < 100:
		if not accepts("temporary"):
			result = 1

		box: LabelBox = make_label_box()

		if box.label != "shared":
			result = 1

		index += 1

	result
