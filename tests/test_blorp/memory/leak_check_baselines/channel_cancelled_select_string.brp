import:
	test: cancel_after_parked_for_test


func payload(label: String) -> String:
	label + "-payload"


func blocked_select(ch: Channel[Int]) -> Int:
	marker: String = payload("blocked-select")
	var received: Int = -1
	select:
		value from ch:
			received = value
		_ after 10000:
			received = -2

	if marker == "blocked-select-payload":
		received
	else:
		-3


func selected_value_then_park(ch: Channel[String]) -> Int:
	marker: String = payload("selected-select")
	var received: Int = -1
	select:
		value from ch:
			sleep(10000)
			received = value.length()
		_ after 10000:
			received = -2

	if marker == "selected-select-payload":
		received
	else:
		-3


func int_channel_still_usable_after_cancel(ch: Channel[Int]) -> Bool:
	if send(ch, 7):
		match recv(ch):
			Some(value):
				value == 7
			None:
				False
	else:
		False


func string_channel_still_usable_after_cancel(ch: Channel[String]) -> Bool:
	if send(ch, payload("usable")):
		match recv(ch):
			Some(value):
				value == "usable-payload"
			None:
				False
	else:
		False


func run_cancelled_blocked_select_case() -> Bool:
	ch: Channel[Int] = channel(1)
	cancelled: Bool = cancel_after_parked_for_test(func(): blocked_select(ch))
	cancelled and int_channel_still_usable_after_cancel(ch)


func run_cancelled_selected_value_case() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("selected-value"))
	cancelled: Bool = cancel_after_parked_for_test(func(): selected_value_then_park(ch))
	cancelled and string_channel_still_usable_after_cancel(ch)


func main(args: List[String]) -> Int:
	if run_cancelled_blocked_select_case() and run_cancelled_selected_value_case():
		0
	else:
		1
