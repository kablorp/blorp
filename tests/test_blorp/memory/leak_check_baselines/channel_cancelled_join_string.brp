import:
	test: cancel_after_parked_for_test


func payload(label: String) -> String:
	label + "-payload"


func blocked_child(ch: Channel[Int]) -> Int:
	marker: String = payload("blocked-child")
	received: Int = match recv(ch):
		Some(value): value
		None: -1
	if marker == "blocked-child-payload":
		received
	else:
		-2


func parent_parked_in_join(ch: Channel[Int]) -> Int:
	marker: String = payload("parent-join")
	concurrent:
		child = blocked_child(ch)
	match child:
		Ok(value):
			if marker == "parent-join-payload":
				value
			else:
				-2
		Err(_): -1


func channel_still_usable_after_cancel(ch: Channel[Int]) -> Bool:
	if send(ch, 7):
		match recv(ch):
			Some(value): value == 7
			None: False
	else:
		False


func run_cancelled_join_case() -> Bool:
	ch: Channel[Int] = channel(1)
	cancelled: Bool = cancel_after_parked_for_test(func(): parent_parked_in_join(ch))
	cancelled and channel_still_usable_after_cancel(ch)


func main(args: List[String]) -> Int:
	if run_cancelled_join_case():
		0
	else:
		1
