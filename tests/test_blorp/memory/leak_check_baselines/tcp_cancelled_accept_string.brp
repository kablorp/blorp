import:
	net/tcp: TcpError, accept, listen, message
	string: contains
	test: cancel_after_parked_for_test


pure func is_socket_permission_error(err: TcpError) -> Bool:
	detail: String = message(err)
	detail.contains("Operation not permitted") or detail.contains("Permission denied")


func payload(label: String) -> String:
	label + "-payload"


func listen_probe() -> Result[Bool, TcpError]:
	with _ ?= listen("127.0.0.1", 0, 1):
		Ok(True)


func blocked_accept_result() -> Result[Int, TcpError]:
	marker: String = payload("blocked-accept")
	with listener ?= listen("127.0.0.1", 0, 1):
		with _ ?= accept(listener):
			if marker == "blocked-accept-payload":
				Ok(1)
			else:
				Ok(-2)


func blocked_accept() -> Int:
	match blocked_accept_result():
		Ok(value): value
		Err(_): -1


func run_cancelled_accept_case() -> Bool:
	match listen_probe():
		Ok(_): cancel_after_parked_for_test(func(): blocked_accept())
		Err(err): is_socket_permission_error(err)


func main(args: List[String]) -> Int:
	if run_cancelled_accept_case():
		0
	else:
		1
