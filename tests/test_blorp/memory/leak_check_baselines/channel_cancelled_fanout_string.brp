import:
	test: cancel_after_parked_for_test


func payload(label: String) -> String:
	label + "-payload"


func blocked_child(ch: Channel[Int], item: Int) -> Int:
	marker: String = payload("blocked-fanout")
	received: Int = match recv(ch):
		Some(value): value + item
		None: -1
	if marker == "blocked-fanout-payload":
		received
	else:
		-2


func parent_parked_in_fanout(ch: Channel[Int]) -> Int:
	marker: String = payload("parent-fanout")
	for item in [1, 2, 3] concurrently(limit: 2):
		_ = blocked_child(ch, item)
	if marker == "parent-fanout-payload":
		1
	else:
		-2


func channel_still_usable_after_cancel(ch: Channel[Int]) -> Bool:
	if send(ch, 7):
		match recv(ch):
			Some(value): value == 7
			None: False
	else:
		False


func run_cancelled_fanout_case() -> Bool:
	ch: Channel[Int] = channel(1)
	cancelled: Bool = cancel_after_parked_for_test(func(): parent_parked_in_fanout(ch))
	cancelled and channel_still_usable_after_cancel(ch)


func main(args: List[String]) -> Int:
	if run_cancelled_fanout_case():
		0
	else:
		1
