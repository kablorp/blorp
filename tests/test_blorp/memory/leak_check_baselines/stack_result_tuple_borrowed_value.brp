import:
	result: Result(Ok, Err)


private pure func duplicate_result(
	value: Result[String, String],
) -> (Result[String, String], Result[String, String]):
	(value, value)


func main(args: List[String]) -> Int:
	value: Result[String, String] = Err("shared")
	pair = duplicate_result(value)

	original_ok: Bool = match value:
		Err(text):
			text == "shared"
		_:
			False

	pair_ok: Bool = match pair:
		(Err(first), Err(second)):
			first == "shared" and second == "shared"
		_:
			False

	if original_ok and pair_ok:
		0
	else:
		1
