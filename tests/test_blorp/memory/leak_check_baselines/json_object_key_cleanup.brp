import:
	json: parse_json


func main(args: List[String]) -> Int:
	match parse_json(
		"{\"schema\":1,\"domain\":\"compiler\",\"action\":\"parse_source\",\"payload\":{\"path\":\"/tmp/tiny.brp\",\"module\":\"bench/tiny\",\"text\":\"func main(args: List[String]): 0\",\"ast_phase\":\"raw_parse\",\"include_comments\":false}}",
	):
		Ok(_):
			0
		Err(_):
			1
