import:
	test: cancel_after_parked_for_test


func payload(n: Int) -> String:
	"dynamic-child-" + n.to_string()


func slow_payload(n: Int) -> String:
	marker: String = payload(n)
	sleep(10000)
	marker


func parent_parked_in_dynamic_join() -> Int:
	nums: List[Int] = [1, 2, 3, 4]
	results: List[Result[String, ConcurrencyError]] = nums.concurrent(
		2,
		func(n: Int): slow_payload(n),
	)
	results.length()


func main(args: List[String]) -> Int:
	if cancel_after_parked_for_test(func(): parent_parked_in_dynamic_join()):
		0
	else:
		1
