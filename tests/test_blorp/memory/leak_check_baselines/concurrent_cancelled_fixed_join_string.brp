import:
	test: cancel_after_parked_for_test


func payload(label: String) -> String:
	label + "-payload"


func slow_payload(label: String) -> String:
	marker: String = payload(label)
	sleep(10000)
	marker


func parent_parked_in_fixed_join() -> Int:
	concurrent:
		child = slow_payload("fixed-child")
	match child:
		Ok(value): value.length()
		Err(_): -1


func main(args: List[String]) -> Int:
	if cancel_after_parked_for_test(func(): parent_parked_in_fixed_join()):
		0
	else:
		1
