import:
	channel: RecvAttempt(RecvSealed, RecvValue), recv_timeout_attempt, try_recv_attempt, wait_recv


func payload(label: String) -> String:
	label + "-payload"


func test_recv_string() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("recv"))
	match recv(ch):
		Some(value): value == "recv-payload"
		None: False


func test_try_recv_string() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("try-recv"))
	match try_recv(ch):
		Some(value): value == "try-recv-payload"
		None: False


func test_recv_timeout_string() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("recv-timeout"))
	match recv_timeout(ch, 1):
		Some(value): value == "recv-timeout-payload"
		None: False


func test_wait_recv_string() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("wait-recv"))
	match wait_recv(ch):
		Ok(value): value == "wait-recv-payload"
		Err(_): False


func test_try_recv_attempt_string() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("try-recv-attempt"))
	attempt: RecvAttempt[String] = try_recv_attempt(ch)
	match attempt:
		RecvValue(value): value == "try-recv-attempt-payload"
		_: False


func test_recv_timeout_attempt_string() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("recv-timeout-attempt"))
	attempt: RecvAttempt[String] = recv_timeout_attempt(ch, 1)
	match attempt:
		RecvValue(value): value == "recv-timeout-attempt-payload"
		_: False


func test_try_recv_attempt_sealed_buffered_string() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("try-sealed-buffered"))
	seal(ch)
	first: RecvAttempt[String] = try_recv_attempt(ch)
	first_ok: Bool = match first:
		RecvValue(value): value == "try-sealed-buffered-payload"
		_: False
	second: RecvAttempt[String] = try_recv_attempt(ch)
	second_ok: Bool = match second:
		RecvSealed: True
		_: False
	first_ok and second_ok


func test_recv_timeout_attempt_sealed_buffered_string() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, payload("timeout-sealed-buffered"))
	seal(ch)
	first: RecvAttempt[String] = recv_timeout_attempt(ch, 1)
	first_ok: Bool = match first:
		RecvValue(value): value == "timeout-sealed-buffered-payload"
		_: False
	second: RecvAttempt[String] = recv_timeout_attempt(ch, 1)
	second_ok: Bool = match second:
		RecvSealed: True
		_: False
	first_ok and second_ok


func main(args: List[String]) -> Int:
	if (
		test_recv_string()
		and test_try_recv_string()
		and test_recv_timeout_string()
		and test_wait_recv_string()
		and test_try_recv_attempt_string()
		and test_recv_timeout_attempt_string()
		and test_try_recv_attempt_sealed_buffered_string()
		and test_recv_timeout_attempt_sealed_buffered_string()
	):
		0
	else:
		1
