import:
	test: TestSuite


record RenderArgs {
	value: String,
	temp_seed: String
}


union RenderOp:
	Render(RenderArgs)


GLOBAL_TEMP_SEED: String = "render"


pure func render_op(value: String) -> RenderOp:
	Render({
		value = value,
		temp_seed = GLOBAL_TEMP_SEED,
	})


pure func rendered_seed(op: RenderOp) -> String:
	match op:
		Render(args):
			args.temp_seed


pure func global_record_union_payload_remains_owned() -> Bool:
	first: String = rendered_seed(render_op("first"))
	second: String = rendered_seed(render_op("second"))
	first + second == "renderrender"


tests: TestSuite = {
	description = "Global Record Union Lifecycle Tests",
	tests = [
		(
			"global remains owned through nested record and union payload",
			global_record_union_payload_remains_owned,
		),
	]
}
