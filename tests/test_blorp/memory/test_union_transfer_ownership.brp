import:
	test: TestSuite


record Payload {
	text: String
}


union WrappedPayload:
	Wrapped(Payload)
	Empty


func payload(text: String) -> Payload:
	{text = text}


func wrap_payload(text: String) -> WrappedPayload:
	item: Payload = payload(text)
	Wrapped(item)


func churn_payload_records() -> Int:
	var items: List[Payload] = []
	var index: Int = 0

	while index < 128:
		items = items.append(payload("noise-${index.to_string()}"))
		index += 1

	items.length()


func test_transferred_union_payload_survives_local_drop() -> Bool:
	wrapped: WrappedPayload = wrap_payload("kept")
	_ = churn_payload_records()

	match wrapped:
		Wrapped(item):
			item.text == "kept"
		Empty:
			False


tests: TestSuite = {
	description = "Union Transfer Ownership",
	tests = [
		(
			"transferred union payload survives local drop",
			test_transferred_union_payload_survives_local_drop,
		),
	]
}
