import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


func test_discarded_vector_add_releases_result() -> Bool:
	reset_mem_stats()
	a: Float[#64] = vector(1.0, 64)
	b: Float[#64] = vector(2.0, 64)
	var i: Int = 0
	while i < 200:
		_ = a + b
		i += 1
	stats: MemStats = get_mem_stats()
	stats.current_objects <= 8


tests: TestSuite = {
	description = "Discarded Vector Result",
	tests = [("discarded vector add releases result", test_discarded_vector_add_releases_result)],
}
