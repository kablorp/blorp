import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


foreign(include: "ffi_ownership_header.h"):
	func ffi_string_score(text: String) -> Int = "ffi_ownership_string_score"
	func ffi_bytes_score(data: Bytes) -> Int = "ffi_ownership_bytes_score"


func run_string_boundary_calls() -> Int:
	var total: Int = 0
	var i: Int = 0

	while i < 200:
		text: String = "foreign-string-" + i.to_string()
		total += ffi_string_score(text)
		i += 1

	total


func run_bytes_boundary_calls() -> Int:
	var total: Int = 0
	var i: Int = 0

	while i < 200:
		data: Bytes = ("foreign-bytes-" + i.to_string()).to_bytes()
		total += ffi_bytes_score(data)
		i += 1

	total


func test_default_foreign_string_copies_are_released() -> Bool:
	reset_mem_stats()
	score: Int = run_string_boundary_calls()
	stats: MemStats = get_mem_stats()

	(
		score > 0
		and stats.total_allocations > 0
		and stats.total_releases > 0
		and stats.current_objects == 0
	)


func test_default_foreign_bytes_copies_are_released() -> Bool:
	reset_mem_stats()
	score: Int = run_bytes_boundary_calls()
	stats: MemStats = get_mem_stats()

	(
		score > 0
		and stats.total_allocations > 0
		and stats.total_releases > 0
		and stats.current_objects == 0
	)


tests: TestSuite = {
	description = "Foreign Defensive Copy Ownership",
	tests = [
		(
			"default foreign string copies are released",
			test_default_foreign_string_copies_are_released,
		),
		(
			"default foreign bytes copies are released",
			test_default_foreign_bytes_copies_are_released,
		),
	]
}
