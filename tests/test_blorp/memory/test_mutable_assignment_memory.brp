func test_repeated_dict_list_grid_stays_bounded() -> Bool:
	reset_mem_stats()
	var grid: Dict[Int, List[Int]] = D.dict()
	var i: Int = 0
	while i < 100:
		grid = build_probe_grid(64)
		i += 1
	stats: MemStats = get_mem_stats()
	D
		.get_or(grid, 0, [])
		.length() == 8 and stats.current_objects < 200 and stats.bytes_allocated < 500000


func test_repeated_append_sort_assignment_stays_bounded() -> Bool:
	reset_mem_stats()
	var draw_list: List[(Int, Float)] = []
	var frame: Int = 0
	while frame < 100:
		draw_list = []
		var i: Int = 0
		while i < 128:
			draw_list = L.append(draw_list, (i, to_float(128 - i)))
			i += 1
		draw_list = L.sort_by(draw_list, func(item: (Int, Float)): item[1])
		frame += 1
	stats: MemStats = get_mem_stats()
	draw_list.length() == 128 and stats.current_objects < 300 and stats.bytes_allocated < 800000


func test_loop_local_mutable_list_released_each_iteration() -> Bool:
	reset_mem_stats()
	var frame: Int = 0
	var total: Int = 0
	while frame < 100:
		var xs: List[(Int, Float)] = []
		var i: Int = 0
		while i < 128:
			xs = L.append(xs, (i, to_float(128 - i)))
			i += 1
		xs = L.sort_by(xs, func(item: (Int, Float)): item[1])
		total += xs.length()
		frame += 1
	stats: MemStats = get_mem_stats()
	total == 12800 and stats.current_objects < 80 and stats.bytes_allocated < 200000


pure func vget16(v: Float[#16], i: Int) -> Float:
	match get(v, i):
		Some(val): val
		None: 0.0


func test_loop_local_closure_capture_alias_released_each_iteration() -> Bool:
	reset_mem_stats()
	var out: Float[#16] = vector(0.0, 16)
	var frame: Int = 0
	var total: Float = 0.0
	while frame < 50:
		payload: Float[#16] = vector(1.0, 16)
		snap: Float[#16] = payload
		compute: pure (Int, Float) -> Float = pure func(i: Int, x: Float):
			x + vget16(snap, i)
		out = payload.parallel(pure func(chunk: ParallelVector[Float, #16]):
			chunk.map_indexed(pure func(i: ..#16, x: Float): compute(i, x))
		)
		match get(out, 0):
			Some(val): total += val
			None: total += 0.0
		frame += 1
	stats: MemStats = get_mem_stats()
	total > 90.0 and stats.current_objects < 20 and stats.bytes_allocated < 100000


func test_value_struct_vector_fill_and_set_releases_boxes() -> Bool:
	reset_mem_stats()
	var frame: Int = 0
	var checksum: Int = 0
	while frame < 50:
		var nodes: SmallNode[#128] = vector(EMPTY_SMALL_NODE, 128)
		var i: Int = 0
		while i < 128:
			updated: SmallNode = { EMPTY_SMALL_NODE | x = to_float(i), y = to_float(frame), id = i }
			match set_index(nodes, i, updated):
				Some(new_nodes): nodes = new_nodes
				None: void
			i += 1
		sample: SmallNode = get_or(nodes, 17, EMPTY_SMALL_NODE)
		checksum += sample.id
		frame += 1
	stats: MemStats = get_mem_stats()
	checksum == 850 and stats.current_objects < 80 and stats.bytes_allocated < 200000


func test_vector_fill_of_lists_releases_nested_elements() -> Bool:
	reset_mem_stats()
	var frame: Int = 0
	var total: Int = 0
	while frame < 100:
		inner: List[Int] = [frame, frame + 1]
		groups: List[Int][#8] = vector(inner, 8)
		total += groups.length()
		frame += 1
	stats: MemStats = get_mem_stats()
	total == 800 and stats.current_objects < 80 and stats.bytes_allocated < 200000


pure func pair_list(x: Int) -> List[Int]:
	[x, x + 1]


