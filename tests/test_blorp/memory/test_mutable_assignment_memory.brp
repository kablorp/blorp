func test_substring_from_branch_assigned_string_var_keeps_owner_alive() -> Bool:
	after_scheme: String = "example.com/path"
	slash_idx: Int = after_scheme.raw_index_of("/")
	var remainder: String = "/"
	if slash_idx == -1:
		void
	else:
		remainder = after_scheme.substring(slash_idx, after_scheme.length() - slash_idx)
	frag_idx: Int = remainder.raw_index_of("#")
	var before_frag: String = ""
	if frag_idx == -1:
		before_frag = remainder.substring(0, remainder.length())
	else:
		before_frag = remainder.substring(0, frag_idx)
	before_frag == "/path" and remainder == "/path"


