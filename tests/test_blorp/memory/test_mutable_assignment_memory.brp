import:
	dict as D
	list as L
	matrix as M
	memory: MemStats, get_mem_stats, reset_mem_stats
	option: Option(Some), to_result
	result: Result(Ok, Err)
	tensor: get, get_or, set_index
	test: TestSuite
	vector: ParallelVector, map, parallel


record IntListHolder {values: List[Int]}


record IntVectorHolder {values: Int[#4]}


record MiniSimState {a: Float[#8], b: Float[#8]}


struct SmallNode {
	x: Float,
	y: Float,
	id: Int
}


union HolderResult:
	HolderOk(Int)
	HolderErr(IntListHolder)


union StringError:
	TextError(String)


union ShadowStringChoice:
	ShadowString(String)
	UseOuterString


EMPTY_SMALL_NODE: SmallNode = {
	x = 0.0,
	y = 0.0,
	id = 0
}


func test_repeated_list_assignment_releases_old_value() -> Bool:
	reset_mem_stats()
	var xs: List[Int] = []
	var i: Int = 0
	while i < 1000:
		xs = [i]
		i += 1
	stats: MemStats = get_mem_stats()
	xs.length() == 1 and stats.current_objects < 50 and stats.bytes_allocated < 100000


func test_repeated_vector_arithmetic_assignment_releases_old_values() -> Bool:
	reset_mem_stats()
	var v: Float[#3] = {1.0, 2.0, 3.0}
	var i: Int = 0
	while i < 1000:
		v += {1.0, 1.0, 1.0}
		i += 1
	stats: MemStats = get_mem_stats()
	v[0] > 900.0 and stats.current_objects < 80 and stats.bytes_allocated < 200000


func alias_length(xs: List[Int]) -> Int:
	var ys: List[Int] = xs
	ys.length()


func alias_record(xs: List[Int]) -> IntListHolder:
	var ys: List[Int] = xs
	{values = ys}


func make_list_holder(n: Int) -> IntListHolder:
	{values = [n]}


func choose_holder_result(use_error: Bool, error: IntListHolder) -> HolderResult:
	if use_error:
		HolderErr(error)
	else:
		HolderOk(1)


func choose_holder_result_from_option(opt: Option[Int], error: IntListHolder) -> HolderResult:
	match opt:
		Some(n): HolderOk(n)
		None: HolderErr(error)


func question_bind_success_with_managed_error(i: Int) -> Result[Int, IntListHolder]:
	n ?= Some(1).to_result(make_list_holder(i))
	Ok(n)


func question_bind_success_with_managed_result(i: Int) -> Result[IntListHolder, Int]:
	n ?= Some(1).to_result(0)
	Ok(make_list_holder(i + n))


func question_bind_forward_managed_result(i: Int) -> Result[IntListHolder, Int]:
	holder ?= Some(make_list_holder(i)).to_result(0)
	Ok(holder)


func question_bind_option_with_managed_result(i: Int) -> Option[IntListHolder]:
	n ?= Some(1)
	Some(make_list_holder(i + n))


func local_record() -> IntListHolder:
	xs: List[Int] = [1]
	{values = xs}


func local_mutable_record() -> IntListHolder:
	var xs: List[Int] = []
	xs = [1]
	{values = xs}


func local_mutable_vector_tuple() -> (Float[#4], Float[#4], Float[#4]):
	var xs = vector(0.0, 4)
	var ys = vector(0.0, 4)
	var zs = vector(0.0, 4)
	for i in 0..4:
		val: Float = to_float(i + 1)
		xs[i] = val
		ys[i] = val + 1.0
		zs[i] = val + 2.0
	(xs, ys, zs)


func update_mini_sim_state(in_a: Float[#8], in_b: Float[#8], step: Int) -> MiniSimState:
	var a = in_a
	var b = in_b
	idx: Int = step % 8
	match set_index(a, idx, to_float(step)):
		Some(next): a = next
		None: void
	match set_index(b, idx, to_float(step + 1)):
		Some(next): b = next
		None: void
	{a = a, b = b}


func wrap_vector_arg(values: Int[#4]) -> IntVectorHolder:
	{values = values}


func make_owned_string(n: Int) -> String:
	"value-" + n.to_string()


func choose_shadowed_string(c: ShadowStringChoice, n: Int) -> String:
	value: String = make_owned_string(n)
	match c:
		ShadowString(value): value
		UseOuterString: value


func choose_nested_shadowed_string(c: ShadowStringChoice, n: Int) -> String:
	value: String = make_owned_string(n)
	if n >= 0:
		match c:
			ShadowString(value): value
			UseOuterString: value
	else:
		value


func render_string_error(err: StringError) -> String:
	match err:
		TextError(message): "error: ${message}"


func build_probe_grid(n: Int) -> Dict[Int, List[Int]]:
	var grid: Dict[Int, List[Int]] = D.dict()
	var i: Int = 0
	while i < n:
		key: Int = i % 8
		match D.get(grid, key):
			Some(existing): grid = D.set(grid, key, L.append(existing, i))
			None: grid = D.set(grid, key, [i])
		i += 1
	grid


func test_repeated_parameter_alias_does_not_leak_refs() -> Bool:
	reset_mem_stats()
	var total: Int = 0
	var i: Int = 0
	while i < 1000:
		total += alias_length([i])
		i += 1
	stats: MemStats = get_mem_stats()
	total == 1000 and stats.current_objects < 50 and stats.bytes_allocated < 100000


func test_repeated_alias_record_return_stays_bounded() -> Bool:
	reset_mem_stats()
	var holder: IntListHolder = {values = []}
	var i: Int = 0
	while i < 1000:
		holder = alias_record([i])
		i += 1
	stats: MemStats = get_mem_stats()
	holder.values.length() == 1 and stats.current_objects < 80 and stats.bytes_allocated < 150000


func test_record_field_local_alias_outlives_source() -> Bool:
	reset_mem_stats()
	var total: Int = 0
	var i: Int = 0
	while i < 100:
		holder: IntListHolder = local_record()
		total += holder.values.length()
		i += 1
	stats: MemStats = get_mem_stats()
	total == 100 and stats.current_objects < 80 and stats.bytes_allocated < 200000


func test_record_field_mutable_alias_outlives_source() -> Bool:
	reset_mem_stats()
	var total: Int = 0
	var i: Int = 0
	while i < 100:
		holder: IntListHolder = local_mutable_record()
		total += holder.values.length()
		i += 1
	stats: MemStats = get_mem_stats()
	total == 100 and stats.current_objects < 80 and stats.bytes_allocated < 200000


func test_tuple_field_mutable_alias_outlives_source() -> Bool:
	reset_mem_stats()
	var total: Float = 0.0
	var i: Int = 0
	while i < 100:
		parts: (Float[#4], Float[#4], Float[#4]) = local_mutable_vector_tuple()
		xs: Float[#4] = parts[0]
		ys: Float[#4] = parts[1]
		zs: Float[#4] = parts[2]
		total += get_or(xs, 0, 0.0)
		total += get_or(ys, 0, 0.0)
		total += get_or(zs, 0, 0.0)
		i += 1
	stats: MemStats = get_mem_stats()
	total > 590.0 and stats.current_objects < 80 and stats.bytes_allocated < 200000


func test_record_field_replacement_after_cow_update_stays_owned() -> Bool:
	reset_mem_stats()
	var a: Float[#8] = vector(0.0, 8)
	var b: Float[#8] = vector(1.0, 8)
	var frame: Int = 0
	var total: Float = 0.0
	while frame < 100:
		result: MiniSimState = update_mini_sim_state(a, b, frame)
		a = result.a
		b = result.b
		total += get_or(a, frame % 8, 0.0)
		frame += 1
	stats: MemStats = get_mem_stats()
	total > 4000.0 and stats.current_objects < 20 and stats.bytes_allocated < 100000


func test_wrapped_call_arg_does_not_consume_caller_owner() -> Bool:
	reset_mem_stats()
	var xs: Int[#4] = vector(7, 4)
	var total: Int = 0
	var i: Int = 0
	while i < 100:
		holder: IntVectorHolder = wrap_vector_arg(xs)
		total += holder.values.length()
		i += 1
	if total < 0:
		xs = vector(0, 4)
	total += get_or(xs, 0, 0)
	stats: MemStats = get_mem_stats()
	total == 407 and stats.current_objects < 80 and stats.bytes_allocated < 200000


func test_list_literal_owned_call_elements_do_not_leak() -> Bool:
	reset_mem_stats()
	var total: Int = 0
	var i: Int = 0
	while i < 100:
		holders: List[IntListHolder] = [make_list_holder(i), make_list_holder(i + 1)]
		total += holders.length()
		i += 1
	stats: MemStats = get_mem_stats()
	total == 200 and stats.current_objects < 80 and stats.bytes_allocated < 200000


