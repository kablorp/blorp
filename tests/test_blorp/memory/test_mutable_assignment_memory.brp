pure func pair_from_zip(a: Int, b: Int) -> List[Int]:
	[a, b]


func test_vector_parallel_zip_map_managed_result_releases_nested_elements() -> Bool:
	reset_mem_stats()
	left: Int[#8] = vector(1, 8)
	right: Int[#8] = vector(2, 8)
	var frame: Int = 0
	var total: Int = 0
	while frame < 100:
		groups: List[Int][#8] = left.parallel(pure func(chunk: ParallelVector[Int, #8]):
			chunk.zip_map(right, pair_from_zip)
		)
		total += groups.length()
		frame += 1
	stats: MemStats = get_mem_stats()
	total == 800 and stats.current_objects < 80 and stats.bytes_allocated < 200000


func get_owned_group() -> Option[List[Int]]:
