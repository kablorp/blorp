tests: TestSuite = {
	description = "Mutable Assignment Memory",
	tests = [
		(
			"repeated list assignment releases old value",
			test_repeated_list_assignment_releases_old_value,
		),
		(
			"repeated vector arithmetic assignment releases old values",
			test_repeated_vector_arithmetic_assignment_releases_old_values,
		),
		(
			"repeated parameter alias does not leak refs",
			test_repeated_parameter_alias_does_not_leak_refs,
		),
		(
			"repeated alias record return stays bounded",
			test_repeated_alias_record_return_stays_bounded,
		),
		("record field local alias outlives source", test_record_field_local_alias_outlives_source),
		(
			"record field mutable alias outlives source",
			test_record_field_mutable_alias_outlives_source,
		),
		(
			"tuple field mutable alias outlives source",
			test_tuple_field_mutable_alias_outlives_source,
		),
		(
			"record field replacement after cow update stays owned",
			test_record_field_replacement_after_cow_update_stays_owned,
		),
		(
			"wrapped call arg does not consume caller owner",
			test_wrapped_call_arg_does_not_consume_caller_owner,
		),
