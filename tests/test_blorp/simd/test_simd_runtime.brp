-- Test with runtime values to see actual SIMD instructions
import:
	test: TestSuite


func add_vectors(a: Float[#4], b: Float[#4]) -> Float[#4]:
	a + b


func test_vector_add_0() -> Bool:
	x: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	y: Float[#4] = {5.0, 6.0, 7.0, 8.0}
	z: Float[#4] = add_vectors(x, y)
	z[0] == 6.0


func test_vector_add_1() -> Bool:
	x: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	y: Float[#4] = {5.0, 6.0, 7.0, 8.0}
	z: Float[#4] = add_vectors(x, y)
	z[1] == 8.0


func test_vector_add_2() -> Bool:
	x: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	y: Float[#4] = {5.0, 6.0, 7.0, 8.0}
	z: Float[#4] = add_vectors(x, y)
	z[2] == 10.0


func test_vector_add_3() -> Bool:
	x: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	y: Float[#4] = {5.0, 6.0, 7.0, 8.0}
	z: Float[#4] = add_vectors(x, y)
	z[3] == 12.0


tests: TestSuite = {
	description = "SIMD Runtime",
	tests = [
		("Vector add via function [0]", test_vector_add_0),
		("Vector add via function [1]", test_vector_add_1),
		("Vector add via function [2]", test_vector_add_2),
		("Vector add via function [3]", test_vector_add_3),
	],
}
