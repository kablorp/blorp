-- Simplest possible SIMD test
import:
	test: TestSuite


func test_simd_array_first_element() -> Bool:
	a: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	first: Float = a[0]
	first == 1.0


tests: TestSuite = {
	description = "SIMD Simple",
	tests = [("SIMD array first element", test_simd_array_first_element)]
}
