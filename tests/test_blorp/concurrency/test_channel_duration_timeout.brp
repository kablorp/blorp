import:
	channel:
		RecvAttempt(RecvSealed, RecvTimedOut, RecvValue),
		SendAttempt(SendTimedOut),
		recv_timeout_attempt_for,
		recv_timeout_for,
		send_timeout_attempt_for,
		send_timeout_for,
		sleep_for,
	system: now_microseconds
	test: TestSuite
	units: from_milliseconds, microseconds


func test_recv_timeout_duration_immediate() -> Bool:
	ch: Channel[Int] = channel(1)
	match recv_timeout_for(ch, from_milliseconds(0)):
		None: True
		Some(_): False


func test_recv_timeout_duration_receives_ready_value() -> Bool:
	ch: Channel[Int] = channel(1)
	_ = send(ch, 42)
	match recv_timeout_for(ch, microseconds(1)):
		Some(value): value == 42
		None: False


func test_recv_timeout_duration_sealed_returns_none() -> Bool:
	ch: Channel[Int] = channel(1)
	seal(ch)
	match recv_timeout_for(ch, from_milliseconds(1)):
		None: True
		Some(_): False


func test_recv_timeout_attempt_duration_receives_value() -> Bool:
	ch: Channel[Int] = channel(1)
	_ = send(ch, 42)
	match recv_timeout_attempt_for(ch, microseconds(1)):
		RecvValue(value): value == 42
		_: False


func test_recv_timeout_attempt_duration_reports_timeout() -> Bool:
	ch: Channel[Int] = channel(1)
	match recv_timeout_attempt_for(ch, microseconds(1)):
		RecvTimedOut: True
		_: False


func test_recv_timeout_attempt_duration_reports_sealed() -> Bool:
	ch: Channel[Int] = channel(1)
	seal(ch)
	match recv_timeout_attempt_for(ch, from_milliseconds(1)):
		RecvSealed: True
		_: False


func test_send_timeout_duration_accepts_ready_capacity() -> Bool:
	ch: Channel[String] = channel(1)
	if send_timeout_for(ch, "hello", microseconds(1)):
		recv(ch) == Some("hello")
	else:
		False


func test_send_timeout_attempt_duration_times_out() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, "first")
	attempt: SendAttempt = send_timeout_attempt_for(ch, "second", microseconds(1))
	match attempt:
		SendTimedOut: True
		_: False


func test_sleep_duration_returns() -> Bool:
	start: Int = now_microseconds()
	sleep_for(microseconds(1))
	now_microseconds() >= start


tests: TestSuite = {
	description = "Duration-based channel timeouts",
	tests = [
		("recv timeout duration immediate", test_recv_timeout_duration_immediate),
		(
			"recv timeout duration receives ready value",
			test_recv_timeout_duration_receives_ready_value,
		),
		(
			"recv timeout duration sealed returns none",
			test_recv_timeout_duration_sealed_returns_none,
		),
		(
			"recv timeout attempt duration receives value",
			test_recv_timeout_attempt_duration_receives_value,
		),
		(
			"recv timeout attempt duration reports timeout",
			test_recv_timeout_attempt_duration_reports_timeout,
		),
		(
			"recv timeout attempt duration reports sealed",
			test_recv_timeout_attempt_duration_reports_sealed,
		),
		(
			"send timeout duration accepts ready capacity",
			test_send_timeout_duration_accepts_ready_capacity,
		),
		("send timeout attempt duration times out", test_send_timeout_attempt_duration_times_out),
		("sleep duration returns", test_sleep_duration_returns),
	]
}
