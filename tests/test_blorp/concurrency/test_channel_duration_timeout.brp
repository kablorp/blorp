import:
	channel:
		RecvAttempt(RecvSealed, RecvTimedOut, RecvValue),
		SendAttempt(SendTimedOut),
		recv_timeout_attempt_for,
		send_timeout_attempt_for,
		sleep_for,
	system: now_microseconds
	test: TestSuite
	units: microseconds, milliseconds


func test_recv_timeout_attempt_duration_receives_value() -> Bool:
	ch: Channel[Int] = channel(1)
	_ = send(ch, 42)
	match recv_timeout_attempt_for(ch, microseconds(1)):
		RecvValue(value): value == 42
		_: False


func test_recv_timeout_attempt_duration_reports_timeout() -> Bool:
	ch: Channel[Int] = channel(1)
	match recv_timeout_attempt_for(ch, microseconds(1)):
		RecvTimedOut: True
		_: False


func test_recv_timeout_attempt_duration_reports_sealed() -> Bool:
	ch: Channel[Int] = channel(1)
	seal(ch)
	match recv_timeout_attempt_for(ch, milliseconds(1)):
		RecvSealed: True
		_: False


func test_send_timeout_attempt_duration_times_out() -> Bool:
	ch: Channel[String] = channel(1)
	_ = send(ch, "first")
	attempt: SendAttempt = send_timeout_attempt_for(ch, "second", microseconds(1))
	match attempt:
		SendTimedOut: True
		_: False


func test_sleep_duration_returns() -> Bool:
	start: Int = now_microseconds()
	sleep_for(microseconds(1))
	now_microseconds() >= start


tests: TestSuite = {
	description = "Duration-based channel timeouts",
	tests = [
		(
			"recv timeout attempt duration receives value",
			test_recv_timeout_attempt_duration_receives_value,
		),
		(
			"recv timeout attempt duration reports timeout",
			test_recv_timeout_attempt_duration_reports_timeout,
		),
		(
			"recv timeout attempt duration reports sealed",
			test_recv_timeout_attempt_duration_reports_sealed,
		),
		("send timeout attempt duration times out", test_send_timeout_attempt_duration_times_out),
		("sleep duration returns", test_sleep_duration_returns),
	]
}
