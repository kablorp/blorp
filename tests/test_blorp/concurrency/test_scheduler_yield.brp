import:
	instrumentation: SchedulerStats, get_scheduler_stats, reset_scheduler_stats
	test: TestSuite, cooperative_checkpoint_probe_for_test


func yielding_value(value: Int) -> Int:
	yield_now()
	value


func cooperative_spin_until_signal(started: Channel[Int], signal: Channel[Int]) -> Bool:
	_ = send(started, 1)
	var observed: Bool = False

	-- Keep this event-driven instead of iteration-bounded. yield_now() is a
	-- scheduling hint, so the test should fail only if cooperative progress
	-- stops until the concurrent block timeout, not because CI needed more
	-- arbitrary spin iterations than a local machine.
	while not observed:
		yield_now()

		match try_recv(signal):
			Some(_):
				observed = True
			None:
				void

	observed


func send_after_spin_started(started: Channel[Int], signal: Channel[Int]) -> Bool:
	match recv(started):
		Some(_):
			send(signal, 1)
		None:
			False


func test_yield_now_outside_fiber_returns() -> Bool:
	reset_scheduler_stats()
	yield_now()
	stats: SchedulerStats = get_scheduler_stats()
	stats.cooperative_yields >= 1


func test_yield_now_inside_fiber_returns() -> Bool:
	reset_scheduler_stats()

	concurrent(max_threads: 1):
		first = yielding_value(1)
		second = yielding_value(2)

	stats: SchedulerStats = get_scheduler_stats()

	first_ok: Bool = match first:
		Ok(value):
			value == 1
		Err(_):
			False

	second_ok: Bool = match second:
		Ok(value):
			value == 2
		Err(_):
			False

	first_ok and second_ok and stats.cooperative_yields >= 2


func test_yield_now_allows_cpu_mixed_progress() -> Bool:
	reset_scheduler_stats()
	started: Channel[Int] = channel(1)
	signal: Channel[Int] = channel(1)

	concurrent(max_threads: 2, timeout: 5000):
		spin_observed = cooperative_spin_until_signal(started, signal)
		signal_sent = send_after_spin_started(started, signal)

	stats: SchedulerStats = get_scheduler_stats()

	observed_ok: Bool = match spin_observed:
		Ok(value):
			value
		Err(_):
			False

	sent_ok: Bool = match signal_sent:
		Ok(value):
			value
		Err(_):
			False

	observed_ok and sent_ok and stats.cooperative_yields >= 1


func test_cooperative_checkpoint_probe_yields_from_fiber() -> Bool:
	reset_scheduler_stats()

	concurrent(max_threads: 1, timeout: 1000):
		probed = cooperative_checkpoint_probe_for_test()

	match probed:
		Ok(value):
			value
		Err(_):
			False


tests: TestSuite = {
	description = "Scheduler yield",
	tests = [
		("yield_now outside fiber returns", test_yield_now_outside_fiber_returns),
		("yield_now inside fiber returns", test_yield_now_inside_fiber_returns),
		("yield_now allows CPU mixed progress", test_yield_now_allows_cpu_mixed_progress),
		(
			"cooperative checkpoint probe yields from fiber",
			test_cooperative_checkpoint_probe_yields_from_fiber,
		),
	]
}
