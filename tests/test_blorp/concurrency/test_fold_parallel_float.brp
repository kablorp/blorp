import:
	test: TestSuite
	vector: fold


-- Test #10: fold on Float vectors
func test_fold_float_sum() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	total: Float = fold(v, 0.0, pure func(acc: Float, x: Float) -> Float: acc + x)
	total == 6.0


func test_fold_float_product() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	result: Float = fold(v, 1.0, pure func(acc: Float, x: Float) -> Float: acc * x)
	result == 24.0


tests: TestSuite = {
	description = "fold float",
	tests = [("float sum", test_fold_float_sum), ("float product", test_fold_float_product)]
}
