import:
	test: TestSuite
	vector: fold_parallel


-- Test #10: fold_parallel on Float vectors
pure func test_fold_parallel_float_sum() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	total: Float = fold_parallel(v, 0.0, pure func(acc: Float, x: Float) -> Float: acc + x)
	total == 6.0


pure func test_fold_parallel_float_product() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	result: Float = fold_parallel(v, 1.0, pure func(acc: Float, x: Float) -> Float: acc * x)
	result == 24.0


tests: TestSuite = {
	description = "fold_parallel float",
	tests = [
		("float sum", test_fold_parallel_float_sum),
		("float product", test_fold_parallel_float_product),
	],
}
