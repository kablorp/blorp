import:
	test: TestSuite


func delayed_value() -> Int:
	yield_now()
	41


func user_result(ok: Bool) -> Result[Int, String]:
	if ok:
		Ok(7)
	else:
		Err("nope")


func test_task_result_alias_annotation() -> Bool:
	concurrent:
		answer: TaskResult[Int] = delayed_value()
	match answer:
		Ok(v): v == 41
		Err(_): False


func test_task_result_preserves_user_result() -> Bool:
	concurrent:
		answer: TaskResult[Result[Int, String]] = user_result(True)
	match answer:
		Ok(Ok(v)): v == 7
		Ok(Err(_)): False
		Err(_): False


tests: TestSuite = {
	description = "TaskResult alias",
	tests = [
		("annotation", test_task_result_alias_annotation),
		("nested user result", test_task_result_preserves_user_result),
	]
}
