import:
	memory: get_mem_stats, reset_mem_stats
	test: TestSuite


func delayed_value() -> Int:
	yield_now()
	41


func user_result(ok: Bool) -> Result[Int, String]:
	if ok:
		Ok(7)
	else:
		Err("nope")


func test_task_result_alias_annotation() -> Bool:
	concurrent:
		answer: TaskResult[Int] = delayed_value()

	match answer:
		Ok(v):
			v == 41
		Err(_):
			False


func test_task_result_preserves_user_result() -> Bool:
	concurrent:
		answer: TaskResult[Result[Int, String]] = user_result(True)

	match answer:
		Ok(Ok(v)):
			v == 7
		Ok(Err(_)):
			False
		Err(_):
			False


private TASK_JOIN_RETIRE_STRESS_ITERATIONS: Int = 10000


func test_task_join_retires_runtime_reference_before_return() -> Bool:
	var iteration: Int = 0
	var retired: Bool = True

	while iteration < TASK_JOIN_RETIRE_STRESS_ITERATIONS and retired:
		reset_mem_stats()

		concurrent:
			answer: TaskResult[Int] = delayed_value()

		retired = match answer:
			Ok(value):
				value == 41 and get_mem_stats().current_objects == 0
			Err(_):
				False

		iteration += 1

	retired


tests: TestSuite = {
	description = "TaskResult alias",
	tests = [
		("annotation", test_task_result_alias_annotation),
		("nested user result", test_task_result_preserves_user_result),
		(
			"join retires runtime reference before return",
			test_task_join_retires_runtime_reference_before_return,
		),
	]
}
