-- Regression: `concurrent for` in expression position must produce a
-- List[Result[T, ConcurrencyError]] holding one Result per spawned
-- iteration. The pre-fix implementation emitted a stmt-expr with no
-- trailing value, so callers got `void` where they expected a List
-- and C compilation failed with "blorp_List* x = void".
import:
	test: TestSuite


pure func double_it(x: Int) -> Int:
	x * 2


-- Simplest collecting form.
func test_collects_into_list() -> Bool:
	nums: List[Int] = [1, 2, 3]
	results: List[Result[Int, ConcurrencyError]] = concurrent for n in nums:
		double_it(n)
	results.length() == 3


-- Each result is Ok with the doubled value.
func test_each_result_is_ok() -> Bool:
	nums: List[Int] = [10, 20, 30]
	results: List[Result[Int, ConcurrencyError]] = concurrent for n in nums:
		double_it(n)
	var sum: Int = 0
	var all_ok: Bool = True
	for r in results:
		match r:
			Ok(v): sum += v
			Err(_): all_ok = False
	all_ok and sum == 120


-- Empty input returns empty list (no spawn, no allocation past list header).
func test_empty_input() -> Bool:
	nums: List[Int] = []
	results: List[Result[Int, ConcurrencyError]] = concurrent for n in nums:
		double_it(n)
	results.length() == 0


-- Heap-element body (String): exercises the Result-in-list path with a
-- non-trivial payload. The list's elem_release is set so when the
-- list eventually drops, each Result is released. (The further leak
-- of the String inside each Result is a separate runtime bug:
-- `blorp_result_ok` always sets `release_mask = 0`, so Result_destroy
-- doesn't cascade into String. Tracked separately; not in scope here.)
pure func tag_with_value(n: Int) -> String:
	"v=${n}"


func test_string_body() -> Bool:
	nums: List[Int] = [1, 2, 3]
	results: List[Result[String, ConcurrencyError]] = concurrent for n in nums:
		tag_with_value(n)
	var found_first: Bool = False
	for r in results:
		match r:
			Ok(s):
				if s == "v=1":
					found_first = True
			Err(_): void
	found_first and results.length() == 3


tests: TestSuite = {
	description = "concurrent for in expression position",
	tests = [
		("collects into list", test_collects_into_list),
		("each result is Ok", test_each_result_is_ok),
		("empty input → empty list", test_empty_input),
		("string body collects", test_string_body),
	],
}
