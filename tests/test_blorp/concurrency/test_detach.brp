-- Tests for detach (fire-and-forget concurrency)
import:
	test: TestSuite


-- detach launches work on thread pool, observe via channel
func test_detach_basic() -> Bool:
	ch: Channel[Int] = channel(1)
	detach send(ch, 42)
	opt: Option[Int] = recv(ch)
	match opt:
		Some(v): v == 42
		None: False


-- detach with function call
func do_send(ch: Channel[String], msg: String) -> Bool:
	send(ch, msg)


func test_detach_func_call() -> Bool:
	ch: Channel[String] = channel(1)
	detach do_send(ch, "hello")
	opt: Option[String] = recv(ch)
	match opt:
		Some(v): v == "hello"
		None: False


-- multiple detaches
func test_detach_multiple() -> Bool:
	ch: Channel[Int] = channel(3)
	detach send(ch, 1)
	detach send(ch, 2)
	detach send(ch, 3)
	var sum: Int = 0
	var i: Int = 0
	while i < 3:
		r: Option[Int] = recv(ch)
		match r:
			Some(v): sum += v
			None: sum = sum
		i += 1
	sum == 6


tests: TestSuite = {
	description = "Detach Tests",
	tests = [
		("detach basic", test_detach_basic),
		("detach function call", test_detach_func_call),
		("detach multiple", test_detach_multiple),
	],
}
