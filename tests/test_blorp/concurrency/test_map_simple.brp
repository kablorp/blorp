-- Simple test for list parallel pipelines
import:
	test: TestSuite


func test_simple() -> Bool:
	nums: List[Int] = [1, 2, 3]
	doubled: List[Int] = nums.parallel(
		pure func(chunk: ParallelList[Int]): chunk.map(pure func(x: Int): x * 2),
	)
	doubled.length() == 3


tests: TestSuite = {
	description = "Simple Parallel List",
	tests = [("simple", test_simple)]
}
