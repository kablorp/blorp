-- Tests for concurrent for (dynamic fan-out)
import:
	list: get, length
	test: TestSuite


pure func double(x: Int) -> Int:
	x * 2


-- Basic concurrent for
func test_concurrent_for_basic() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	results: List[Result[Int, ConcurrencyError]] = concurrent for n in nums:
		double(n)

	-- Check all results are Ok and correct
	var all_ok: Bool = True
	var sum: Int = 0
	for r in results:
		match r:
			Ok(v): sum += v
			Err(_): all_ok = False
	all_ok and sum == 30


-- Concurrent for with empty list
func test_concurrent_for_empty() -> Bool:
	nums: List[Int] = []
	results: List[Result[Int, ConcurrencyError]] = concurrent for n in nums:
		n * 2
	results.length() == 0


-- Concurrent for with single element
func test_concurrent_for_single() -> Bool:
	nums: List[Int] = [42]
	results: List[Result[Int, ConcurrencyError]] = concurrent for n in nums:
		n + 1
	match get(results, 0):
		Some(r):
			match r:
				Ok(v): v == 43
				Err(_): False
		None: False


-- Concurrent for with timeout
func test_concurrent_for_timeout() -> Bool:
	nums: List[Int] = [1, 2, 3]
	results: List[Result[Int, ConcurrencyError]] = concurrent(timeout: 5000) for n in nums:
		n * 10
	var sum: Int = 0
	for r in results:
		match r:
			Ok(v): sum += v
			Err(_): void
	sum == 60


-- Migration spelling: for ... concurrently(limit: N)
func test_concurrently_loop_limit_spelling() -> Bool:
	nums: List[Int] = [1, 2, 3, 4]
	results: List[Result[Int, ConcurrencyError]] = for n in nums concurrently(limit: 2):
		double(n)

	var all_ok: Bool = True
	var sum: Int = 0
	for r in results:
		match r:
			Ok(v): sum += v
			Err(_): all_ok = False
	all_ok and sum == 20


tests: TestSuite = {
	description = "Concurrent For Tests",
	tests = [
		("basic concurrent for", test_concurrent_for_basic),
		("concurrent for empty list", test_concurrent_for_empty),
		("concurrent for single element", test_concurrent_for_single),
		("concurrent for with timeout", test_concurrent_for_timeout),
		("for concurrently limit spelling", test_concurrently_loop_limit_spelling),
	],
}
