import:
	test: TestSuite


func produce_bytes_result() -> Result[Bytes, String]:
	Ok("x".to_bytes())


func test_concurrent_managed_result_released_after_match() -> Bool:
	concurrent(timeout: 1000):
		produced = produce_bytes_result()
	match produced:
		Ok(result):
			match result:
				Ok(data): data.length() == 1
				Err(_): False
		Err(_): False


tests: TestSuite = {
	description = "Concurrent Managed Result Ownership",
	tests = [
		(
			"managed result returned from concurrent task is released after match",
			test_concurrent_managed_result_released_after_match,
		),
	],
}
