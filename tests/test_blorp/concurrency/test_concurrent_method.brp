import:
	test: TestSuite
	units: from_milliseconds


func slow_increment(n: Int) -> Int:
	yield_now()
	n + 1


func test_concurrent_method_preserves_order() -> Bool:
	nums: List[Int] = [1, 2, 3, 4]
	results: List[Result[Int, ConcurrencyError]] = nums.concurrent(
		2,
		func(n: Int): slow_increment(n),
	)
	match results.get(0):
		Some(Ok(first)):
			match results.get(3):
				Some(Ok(last)): first == 2 and last == 5
				_: False
		_: False


func test_concurrent_method_nonpositive_limit_is_serial() -> Bool:
	nums: List[Int] = [3, 4]
	results: List[Result[Int, ConcurrencyError]] = nums.concurrent(
		0,
		func(n: Int): slow_increment(n),
	)
	var total: Int = 0
	var all_ok: Bool = True
	for result in results:
		match result:
			Ok(v): total += v
			Err(_): all_ok = False
	all_ok and total == 9


func test_concurrent_method_with_timeout_succeeds() -> Bool:
	nums: List[Int] = [1, 2, 3]
	results: List[Result[Int, ConcurrencyError]] = nums.concurrent_with_timeout(
		2,
		from_milliseconds(100),
		func(n: Int): n * 2,
	)
	var total: Int = 0
	var all_ok: Bool = True
	for result in results:
		match result:
			Ok(v): total += v
			Err(_): all_ok = False
	all_ok and total == 12


func slow_identity(n: Int) -> Int:
	sleep(50)
	n


func test_concurrent_method_with_timeout_expires() -> Bool:
	nums: List[Int] = [1, 2, 3]
	results: List[Result[Int, ConcurrencyError]] = nums.concurrent_with_timeout(
		2,
		from_milliseconds(1),
		func(n: Int): slow_identity(n),
	)
	var timed_out: Int = 0
	for result in results:
		match result:
			Ok(_): void
			Err(_): timed_out += 1
	timed_out > 0


tests: TestSuite = {
	description = "List.concurrent",
	tests = [
		("preserves order", test_concurrent_method_preserves_order),
		("nonpositive limit is serial", test_concurrent_method_nonpositive_limit_is_serial),
		("timeout succeeds", test_concurrent_method_with_timeout_succeeds),
		("timeout expires", test_concurrent_method_with_timeout_expires),
	]
}
