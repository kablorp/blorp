-- Tests for detach with zero-capture closures
-- The detach body has no free variables, so it becomes a compound
-- literal closure. The worker thread may execute after the enclosing
-- function returns, causing use-after-free.
import:
	test: TestSuite


-- A standalone function with no arguments that writes to a global channel
func test_detach_zero_capture_lambda() -> Bool:
	ch: Channel[Int] = channel(1)

	-- The lambda captures 'ch', so it has captures -- safe
	-- But let's test a pattern where only the channel is captured
	detach send(ch, 99)
	result: Option[Int] = recv(ch)
	match result:
		Some(v): v == 99
		None: False


-- Detach calling a function that takes no arguments
-- The synthetic lambda wrapping the call has zero captures
-- because top-level functions are in known_functions
func compute_value() -> Int:
	42


func test_detach_zero_arg_function() -> Bool:
	ch: Channel[Int] = channel(1)

	-- This detaches a call to compute_value() and sends result to channel
	-- The lambda captures ch (1 capture), so this is actually safe
	val: Int = compute_value()
	detach send(ch, val)
	result: Option[Int] = recv(ch)
	match result:
		Some(v): v == 42
		None: False


tests: TestSuite = {
	description = "Detach Zero Capture",
	tests = [
		("detach zero capture lambda", test_detach_zero_capture_lambda),
		("detach zero arg function", test_detach_zero_arg_function),
	],
}
