import:
	test: TestSuite


func test_detach_send_recv() -> Bool:
	ch: Channel[Int] = channel(2)

	-- Detach 10 senders (more than channel capacity)
	var i: Int = 0
	while i < 10:
		detach send(ch, i)
		i += 1

	-- Receive all 10 values
	var count: Int = 0
	while count < 10:
		match recv(ch):
			Some(v):
				count += 1
			None: void
	count == 10


func test_detach_channel_close() -> Bool:
	ch: Channel[Int] = channel(3)
	detach send(ch, 1)
	detach send(ch, 2)
	detach send(ch, 3)
	sleep(50)
	close(ch)
	var total: Int = 0
	for v in ch:
		total += v
	total > 0


tests: TestSuite = {
	description = "Detach Channel Tests",
	tests = [
		("detach send recv", test_detach_send_recv),
		("detach channel close", test_detach_channel_close),
	],
}
