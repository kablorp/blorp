import:
	test: TestSuite


func test_detach_send_recv() -> Bool:
	ch: Channel[Int] = channel(2)

	-- Detach 10 senders (more than channel capacity)
	var i: Int = 0
	while i < 10:
		value: Int = i
		detach send(ch, value)
		i += 1

	-- Receive all 10 values
	var count: Int = 0
	while count < 10:
		match recv(ch):
			Some(v):
				count += 1
			None: void
	count == 10


func test_detach_channel_seal() -> Bool:
	ch: Channel[Int] = channel(3)
	_ = send(ch, 10)
	_ = send(ch, 20)
	seal(ch)
	var total: Int = 0
	for v in ch:
		total += v
	total == 30 and not send(ch, 30)


tests: TestSuite = {
	description = "Detach Channel Tests",
	tests = [
		("detach send recv", test_detach_send_recv),
		("detach channel seal", test_detach_channel_seal),
	]
}
