-- Tests for list concurrent collection and statement fan-out.
import:
	list: get, length
	test: TestSuite
	units: from_milliseconds


pure func double(x: Int) -> Int:
	x * 2


-- Basic list concurrent collection
func test_list_concurrent_basic() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	results: List[Result[Int, ConcurrencyError]] = nums.concurrent(2, func(n: Int): double(n))

	-- Check all results are Ok and correct
	var all_ok: Bool = True
	var sum: Int = 0
	for r in results:
		match r:
			Ok(v): sum += v
			Err(_): all_ok = False
	all_ok and sum == 30


-- List concurrent collection with empty list
func test_list_concurrent_empty() -> Bool:
	nums: List[Int] = []
	results: List[Result[Int, ConcurrencyError]] = nums.concurrent(2, func(n: Int): n * 2)
	results.length() == 0


-- List concurrent collection with single element
func test_list_concurrent_single() -> Bool:
	nums: List[Int] = [42]
	results: List[Result[Int, ConcurrencyError]] = nums.concurrent(2, func(n: Int): n + 1)
	match get(results, 0):
		Some(r):
			match r:
				Ok(v): v == 43
				Err(_): False
		None: False


-- List concurrent collection with timeout
func test_list_concurrent_timeout() -> Bool:
	nums: List[Int] = [1, 2, 3]
	results: List[Result[Int, ConcurrencyError]] = nums.concurrent_with_timeout(
		2,
		from_milliseconds(5000),
		func(n: Int): n * 10,
	)
	var sum: Int = 0
	for r in results:
		match r:
			Ok(v): sum += v
			Err(_): void
	sum == 60


-- Migration spelling: for ... concurrently(limit: N)
func test_concurrently_loop_limit_spelling() -> Bool:
	nums: List[Int] = [1, 2, 3, 4]
	out: Channel[Int] = channel(4)
	for n in nums concurrently(limit: 2):
		_ = send(out, double(n))
	seal(out)

	var sum: Int = 0
	var count: Int = 0
	for v in out:
		sum += v
		count += 1
	count == 4 and sum == 20


tests: TestSuite = {
	description = "List concurrent collection and concurrent loop tests",
	tests = [
		("basic List.concurrent", test_list_concurrent_basic),
		("List.concurrent empty list", test_list_concurrent_empty),
		("List.concurrent single element", test_list_concurrent_single),
		("List.concurrent_with_timeout", test_list_concurrent_timeout),
		("for concurrently limit spelling", test_concurrently_loop_limit_spelling),
	],
}
