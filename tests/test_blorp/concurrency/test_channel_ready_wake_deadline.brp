-- These tests force representative late-resume schedules with one worker and a
-- busy loop. They guard ready-before-deadline regressions, not every possible
-- scheduler interleaving.
import:
	system: setenv
	test: TestSuite
	time: now


func busy_for_ms(ms: Int) -> Void:
	start: Int = now()
	var done: Bool = False
	while not done:
		elapsed_ms: Int = (now() - start) / 1000
		if elapsed_ms >= ms:
			done = True


func recv_timeout_waits_for_ready_value(ch: Channel[Int]) -> Bool:
	match recv_timeout(ch, 50):
		Some(v): v == 42
		None: False


func send_then_delay_receiver_resume(ch: Channel[Int]) -> Bool:
	sleep(10)
	sent_ok: Bool = send(ch, 42)
	busy_for_ms(80)
	sent_ok


-- REGRESSION: a recv_timeout woken by a send before its deadline must receive
-- the value even if the scheduler resumes it after the nominal deadline.
func test_recv_timeout_ready_wake_survives_late_resume() -> Bool:
	_ = setenv("BLORP_THREADS", "1")
	ch: Channel[Int] = channel(1)
	concurrent(timeout: 1000):
		received = recv_timeout_waits_for_ready_value(ch)
		sent = send_then_delay_receiver_resume(ch)
	received_ok: Bool = match received:
		Ok(v): v
		Err(_): False
	sent_ok: Bool = match sent:
		Ok(v): v
		Err(_): False
	received_ok and sent_ok


func send_timeout_waits_for_ready_slot(ch: Channel[String]) -> Bool:
	send_timeout(ch, "second", 50)


func recv_then_delay_sender_resume(ch: Channel[String]) -> Bool:
	sleep(10)
	first_ok: Bool = match recv(ch):
		Some(v): v == "first"
		None: False
	busy_for_ms(80)
	first_ok


-- REGRESSION: a send_timeout woken by freed capacity before its deadline must
-- send the value even if the scheduler resumes it after the nominal deadline.
func test_send_timeout_ready_wake_survives_late_resume() -> Bool:
	_ = setenv("BLORP_THREADS", "1")
	ch: Channel[String] = channel(1)
	_ = send(ch, "first")
	concurrent(timeout: 1000):
		sent = send_timeout_waits_for_ready_slot(ch)
		drained = recv_then_delay_sender_resume(ch)
	sent_ok: Bool = match sent:
		Ok(v): v
		Err(_): False
	drained_ok: Bool = match drained:
		Ok(v): v
		Err(_): False
	final_ok: Bool = match recv_timeout(ch, 200):
		Some(v): v == "second"
		None: False
	sent_ok and drained_ok and final_ok


tests: TestSuite = {
	description = "Concurrency: channel ready wake deadlines",
	tests = [
		(
			"recv_timeout ready wake survives late resume",
			test_recv_timeout_ready_wake_survives_late_resume,
		),
		(
			"send_timeout ready wake survives late resume",
			test_send_timeout_ready_wake_survives_late_resume,
		),
	]
}
