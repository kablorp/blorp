import:
	test: TestSuite
	units: from_milliseconds, microseconds


func test_concurrent_block_duration_timeout() -> Bool:
	concurrent(timeout: from_milliseconds(100)):
		a = 21 * 2
	match a:
		Ok(v): v == 42
		Err(_): False


func test_concurrent_loop_duration_timeout() -> Bool:
	nums: List[Int] = [1, 2, 3]
	out: Channel[Int] = channel(3)
	for n in nums concurrently(limit: 2, timeout: from_milliseconds(100)):
		_ = send(out, n * 2)
	seal(out)
	var count: Int = 0
	var total: Int = 0
	for value in out:
		count += 1
		total += value
	count == 3 and total == 12


func test_duration_timeout_rounds_microseconds() -> Bool:
	concurrent(timeout: microseconds(1)):
		a = 1
	match a:
		Ok(v): v == 1
		Err(_): False


tests: TestSuite = {
	description = "Duration timeout syntax",
	tests = [
		("concurrent block accepts Duration timeout", test_concurrent_block_duration_timeout),
		("concurrent loop accepts Duration timeout", test_concurrent_loop_duration_timeout),
		("Duration timeout syntax rounds microseconds", test_duration_timeout_rounds_microseconds),
	]
}
