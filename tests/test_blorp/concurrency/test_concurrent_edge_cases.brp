-- Edge case tests for concurrent blocks and concurrent for
import:
	test: TestSuite


-- concurrent for with timeout that expires
func test_concurrent_for_timeout_expires() -> Bool:
	items: List[Int] = [1, 2, 3]
	results: List[Result[Int, ConcurrencyError]] = concurrent(timeout: 10) for item in items:
		sleep(200)
		item * 2
	var timed_out_count: Int = 0
	for r in results:
		match r:
			Ok(_): void
			Err(_): timed_out_count += 1
	timed_out_count == 3


-- concurrent for with timeout that does NOT expire
func test_concurrent_for_timeout_succeeds() -> Bool:
	items: List[Int] = [10, 20, 30]
	results: List[Result[Int, ConcurrencyError]] = concurrent(timeout: 500) for item in items:
		item * 2
	var ok_count: Int = 0
	for r in results:
		match r:
			Ok(_): ok_count += 1
			Err(_): void
	ok_count == 3


-- for ... concurrently(timeout: -1) should use an immediate deadline.
func test_concurrently_loop_negative_timeout_expires() -> Bool:
	items: List[Int] = [1, 2, 3]
	results: List[Result[Int, ConcurrencyError]] = for item in items concurrently(limit: 2, timeout: -1):
		sleep(50)
		item * 2
	var timed_out_count: Int = 0
	for r in results:
		match r:
			Ok(_): void
			Err(_): timed_out_count += 1
	timed_out_count == 3


-- concurrent block with RC body type (String) + timeout that succeeds
func string_task(s: String) -> String:
	s + " done"


func test_concurrent_rc_body_with_timeout() -> Bool:
	concurrent(timeout: 500):
		a = string_task("hello")
		b = string_task("world")
	a_ok: Bool = match a:
		Ok(v): v == "hello done"
		Err(_): False
	b_ok: Bool = match b:
		Ok(v): v == "world done"
		Err(_): False
	a_ok and b_ok


-- concurrent block with RC body type (String) + timeout that expires
func slow_string_task(s: String) -> String:
	sleep(200)
	s + " done"


func test_concurrent_rc_body_timeout_expires() -> Bool:
	concurrent(timeout: 10):
		a = slow_string_task("hello")
	match a:
		Ok(_): False
		Err(_): True


-- Helper for nested concurrent
func nested_inner() -> Int:
	concurrent:
		inner1 = inner_task(5)
		inner2 = inner_task(10)
	r1: Int = match inner1:
		Ok(v): v
		Err(_): 0
	r2: Int = match inner2:
		Ok(v): v
		Err(_): 0
	r1 + r2


func inner_task(x: Int) -> Int:
	sleep(10)
	x * 2


func test_nested_concurrent() -> Bool:
	concurrent:
		outer = nested_inner()
	match outer:
		Ok(v): v == 30
		Err(_): False


-- Helper for nested concurrent with inner timeout
func nested_inner_timeout() -> Bool:
	concurrent(timeout: 10):
		a = slow_string_task("test")
	match a:
		Ok(_): False
		Err(_): True


func test_nested_concurrent_inner_timeout() -> Bool:
	concurrent:
		outer = nested_inner_timeout()
	match outer:
		Ok(v): v
		Err(_): False


tests: TestSuite = {
	description = "Concurrency: edge cases",
	tests = [
		("concurrent for timeout expires", test_concurrent_for_timeout_expires),
		("concurrent for timeout succeeds", test_concurrent_for_timeout_succeeds),
		(
			"concurrently loop negative timeout expires",
			test_concurrently_loop_negative_timeout_expires,
		),
		("concurrent RC body with timeout", test_concurrent_rc_body_with_timeout),
		("concurrent RC body timeout expires", test_concurrent_rc_body_timeout_expires),
		("nested concurrent blocks", test_nested_concurrent),
		("nested concurrent inner timeout", test_nested_concurrent_inner_timeout),
	],
}
