import:
	test: TestSuite


func slow_double(n: Int) -> Int:
	yield_now()
	n * 2


func test_map_concurrently_preserves_order() -> Bool:
	nums: List[Int] = [1, 2, 3, 4]
	results: List[Result[Int, ConcurrencyError]] = nums.map_concurrently(
		2,
		func(n: Int): slow_double(n),
	)
	match results.get(0):
		Some(Ok(a)):
			match results.get(3):
				Some(Ok(d)): a == 2 and d == 8
				_: False
		_: False


func test_map_concurrently_nonpositive_limit_is_serial() -> Bool:
	nums: List[Int] = [3, 4]
	results: List[Result[Int, ConcurrencyError]] = nums.map_concurrently(
		0,
		func(n: Int): slow_double(n),
	)
	var total: Int = 0
	var all_ok: Bool = True
	for result in results:
		match result:
			Ok(v): total += v
			Err(_): all_ok = False
	all_ok and total == 14


tests: TestSuite = {
	description = "List.map_concurrently",
	tests = [
		("preserves order", test_map_concurrently_preserves_order),
		("nonpositive limit is serial", test_map_concurrently_nonpositive_limit_is_serial),
	],
}
