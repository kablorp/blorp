-- Block-level timeout semantics tests
-- concurrent(timeout: N): should be a BLOCK-level deadline, not per-join.
-- With 3 tasks each taking 80ms and a 100ms timeout:
-- Block-level: total wall time ~80ms (parallel), all succeed within 100ms
-- Per-join (current bug): each join gets fresh 100ms, total could be 300ms
-- We test with sequential-ish tasks to expose the difference.
import:
	test: TestSuite


-- Task that sleeps for a given number of ms
func slow_task(ms: Int) -> Int:
	sleep(ms)
	ms


-- Block timeout should apply to the ENTIRE block, not each join independently.
-- If the block timeout is 150ms and we have 3 tasks each taking 60ms:
-- - With fibers (parallel): all 3 run in ~60ms, well within 150ms, all Ok
-- - This test verifies the basic case works
func test_block_timeout_all_succeed() -> Bool:
	concurrent(timeout: 200):
		a = slow_task(30)
		b = slow_task(30)
		c = slow_task(30)
	a_ok: Bool = match a:
		Ok(v): v == 30
		Err(_): False
	b_ok: Bool = match b:
		Ok(v): v == 30
		Err(_): False
	c_ok: Bool = match c:
		Ok(v): v == 30
		Err(_): False
	a_ok and b_ok and c_ok


-- Block timeout should cause later tasks to timeout if the block deadline has passed.
-- 3 tasks: first takes 10ms, second takes 200ms, third takes 10ms.
-- With a 50ms block timeout, the second task should timeout.
func test_block_timeout_one_expires() -> Bool:
	concurrent(timeout: 50):
		a = slow_task(10)
		b = slow_task(200)
		c = slow_task(10)
	a_ok: Bool = match a:
		Ok(v): v == 10
		Err(_): False
	b_timed_out: Bool = match b:
		Ok(_): False
		Err(_): True
	c_ok: Bool = match c:
		Ok(v): v == 10
		Err(_): False
	a_ok and b_timed_out and c_ok


-- With timeout 0, all tasks should timeout immediately (or nearly)
func test_block_timeout_zero() -> Bool:
	concurrent(timeout: 0):
		a = slow_task(50)
	match a:
		Ok(_): False
		Err(_): True


tests: TestSuite = {
	description = "Concurrency: block-level timeout",
	tests = [
		("block timeout all succeed", test_block_timeout_all_succeed),
		("block timeout one expires", test_block_timeout_one_expires),
		("block timeout zero", test_block_timeout_zero),
	],
}
