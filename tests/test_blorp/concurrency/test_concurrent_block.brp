-- Tests for concurrent: block (structured concurrency)
import:
	test: TestSuite


-- Basic concurrent block with two bindings
func test_concurrent_basic() -> Bool:
	concurrent:
		a = 21 * 2
		b = 10 + 5
	match a:
		Ok(v):
			match b:
				Ok(w): v == 42 and w == 15
				Err(_): False
		Err(_): False


-- Concurrent block with function calls
func compute_square(n: Int) -> Int:
	n * n


func test_concurrent_func_calls() -> Bool:
	concurrent:
		x = compute_square(6)
		y = compute_square(7)
	match x:
		Ok(v):
			match y:
				Ok(w): v == 36 and w == 49
				Err(_): False
		Err(_): False


-- Concurrent block with captured variables
func test_concurrent_capture() -> Bool:
	base: Int = 100
	concurrent:
		a = base + 1
		b = base + 2
	match a:
		Ok(v):
			match b:
				Ok(w): v == 101 and w == 102
				Err(_): False
		Err(_): False


-- Concurrent block with timeout (no timeout expected)
func test_concurrent_timeout_ok() -> Bool:
	concurrent(timeout: 5000):
		a = 42
	match a:
		Ok(v): v == 42
		Err(_): False


-- Concurrent block with timeout that triggers
func slow_compute() -> Int:
	sleep(3000)
	42


func test_concurrent_timeout_expires() -> Bool:
	concurrent(timeout: 50):
		a = slow_compute()
	match a:
		Ok(_): False
		Err(_): True


-- Concurrent block with string results
func test_concurrent_strings() -> Bool:
	concurrent:
		greeting = "hello"
		name = "world"
	match greeting:
		Ok(g):
			match name:
				Ok(n): g == "hello" and n == "world"
				Err(_): False
		Err(_): False


-- Single binding concurrent block
func test_concurrent_single() -> Bool:
	concurrent:
		x = 99
	match x:
		Ok(v): v == 99
		Err(_): False


tests: TestSuite = {
	description = "Concurrent Block Tests",
	tests = [
		("basic concurrent block", test_concurrent_basic),
		("concurrent with function calls", test_concurrent_func_calls),
		("concurrent with captured variables", test_concurrent_capture),
		("concurrent with timeout (ok)", test_concurrent_timeout_ok),
		("concurrent timeout expires", test_concurrent_timeout_expires),
		("concurrent with strings", test_concurrent_strings),
		("single binding concurrent", test_concurrent_single),
	],
}
