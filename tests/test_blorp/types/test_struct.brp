import:
	test: TestSuite


struct Vec2 {x: Float, y: Float}


-- Structs with identical field layouts for disambiguation testing
struct Radians {value: Float}


struct Degrees {value: Float}


struct Color {r: Int, g: Int, b: Int}


struct Flags {a: Bool, b: Bool}


struct CharPair {first: Char, second: Char}


struct Mixed {name_len: Int, score: Float, active: Bool}


-- Nested struct
struct Rect {origin: Vec2, size: Vec2}


-- Helper functions
pure func vec2_add(a: Vec2, b: Vec2) -> Vec2:
	{x = a.x + b.x, y = a.y + b.y}


pure func vec2_scale(v: Vec2, s: Float) -> Vec2:
	{x = v.x * s, y = v.y * s}


pure func rect_area(r: Rect) -> Float:
	r.size.x * r.size.y


func test_int_fields() -> Bool:
	c: Color = {r = 255, g = 128, b = 0}
	c.r == 255 and c.g == 128 and c.b == 0


func test_float_fields() -> Bool:
	v: Vec2 = {x = 3.14, y = 2.71}
	v.x == 3.14 and v.y == 2.71


func test_bool_fields() -> Bool:
	f: Flags = {a = True, b = False}
	f.a == True and f.b == False


func test_char_fields() -> Bool:
	p: CharPair = {first = 'A', second = 'B'}
	p.first == 'A' and p.second == 'B'


func test_mixed_primitives() -> Bool:
	m: Mixed = {name_len = 5, score = 9.5, active = True}
	m.name_len == 5 and m.score == 9.5 and m.active == True


func test_single_field_update() -> Bool:
	v: Vec2 = {x = 1.0, y = 2.0}
	v2: Vec2 = { v | x = 10.0 }
	v2.x == 10.0 and v2.y == 2.0


func test_multi_field_update() -> Bool:
	c: Color = {r = 0, g = 0, b = 0}
	c2: Color = { c | r = 255, g = 128 }
	c2.r == 255 and c2.g == 128 and c2.b == 0


func test_pass_to_function() -> Bool:
	a: Vec2 = {x = 1.0, y = 2.0}
	b: Vec2 = {x = 3.0, y = 4.0}
	result: Vec2 = vec2_add(a, b)
	result.x == 4.0 and result.y == 6.0


func test_return_from_function() -> Bool:
	v: Vec2 = {x = 2.0, y = 3.0}
	scaled: Vec2 = vec2_scale(v, 2.0)
	scaled.x == 4.0 and scaled.y == 6.0


func test_nested_struct() -> Bool:
	r: Rect = {origin = {x = 0.0, y = 0.0}, size = {x = 10.0, y = 5.0}}
	r.origin.x == 0.0 and r.size.x == 10.0


func test_struct_in_if_else() -> Bool:
	flag: Bool = True
	v: Vec2 = if flag:
		{x = 1.0, y = 2.0}
	else:
		{x = 3.0, y = 4.0}
	v.x == 1.0 and v.y == 2.0


func test_mutable_struct() -> Bool:
	var v: Vec2 = {x = 1.0, y = 2.0}
	v = {x = 10.0, y = 20.0}
	v.x == 10.0 and v.y == 20.0


func test_struct_in_loop() -> Bool:
	var total: Vec2 = {x = 0.0, y = 0.0}
	for i in 0..3:
		total = vec2_add(total, {x = 1.0, y = 2.0})
	total.x == 3.0 and total.y == 6.0


func test_field_equality() -> Bool:
	a: Vec2 = {x = 1.0, y = 2.0}
	b: Vec2 = {x = 1.0, y = 2.0}
	a.x == b.x and a.y == b.y


func test_chained_update() -> Bool:
	v1: Vec2 = {x = 0.0, y = 0.0}
	v2: Vec2 = { v1 | x = 5.0 }
	v3: Vec2 = { v2 | y = 10.0 }
	v3.x == 5.0 and v3.y == 10.0


func test_original_unchanged() -> Bool:
	orig: Vec2 = {x = 1.0, y = 2.0}
	copy: Vec2 = { orig | x = 99.0 }
	orig.x == 1.0 and copy.x == 99.0


func test_nested_struct_update() -> Bool:
	r: Rect = {origin = {x = 0.0, y = 0.0}, size = {x = 10.0, y = 5.0}}
	r2: Rect = { r | origin = {x = 1.0, y = 1.0} }
	r2.origin.x == 1.0 and r2.size.x == 10.0


func test_expression_in_update() -> Bool:
	v: Vec2 = {x = 3.0, y = 4.0}
	v2: Vec2 = { v | x = v.x + 1.0 }
	v2.x == 4.0 and v2.y == 4.0


pure func to_radians(d: Degrees) -> Radians:
	{value = d.value * 3.14159 / 180.0}


func test_struct_disambiguation() -> Bool:
	-- Two structs with identical field layout {value: Float}
	-- must be correctly distinguished by type annotation
	deg: Degrees = {value = 90.0}
	rad: Radians = to_radians(deg)
	rad.value > 1.57 and rad.value < 1.58


tests: TestSuite = {
	description = "Struct Value Types",
	tests = [
		("int fields", test_int_fields),
		("float fields", test_float_fields),
		("bool fields", test_bool_fields),
		("char fields", test_char_fields),
		("mixed primitives", test_mixed_primitives),
		("single field update", test_single_field_update),
		("multi field update", test_multi_field_update),
		("pass to function", test_pass_to_function),
		("return from function", test_return_from_function),
		("nested struct", test_nested_struct),
		("struct in if-else", test_struct_in_if_else),
		("mutable struct", test_mutable_struct),
		("struct in loop", test_struct_in_loop),
		("field equality", test_field_equality),
		("chained update", test_chained_update),
		("original unchanged", test_original_unchanged),
		("nested struct update", test_nested_struct_update),
		("expression in update", test_expression_in_update),
		(
			"rect area",
			func(): rect_area({origin = {x = 0.0, y = 0.0}, size = {x = 10.0, y = 5.0}}) == 50.0,
		),
		("struct disambiguation", test_struct_disambiguation),
	],
}
