-- Test tuple pattern matching in match expressions
import:
	test: TestSuite


func classify_pair(p: (Int, Int)) -> String:
	match p:
		(0, 0): "origin"
		(0, _): "y-axis"
		(_, 0): "x-axis"
		(_, _): "other"


func test_match_origin() -> Bool:
	classify_pair((0, 0)) == "origin"


func test_match_y_axis() -> Bool:
	classify_pair((0, 5)) == "y-axis"


func test_match_x_axis() -> Bool:
	classify_pair((3, 0)) == "x-axis"


func test_match_other() -> Bool:
	classify_pair((1, 2)) == "other"


func extract_first(p: (Int, String)) -> Int:
	match p:
		(n, _): n


func test_extract_binding() -> Bool:
	extract_first((42, "hello")) == 42


func match_nonzero(p: (Int, Int)) -> String:
	match p:
		(1, 2): "one-two"
		(3, 4): "three-four"
		(_, _): "other"


func test_nonzero_first() -> Bool:
	match_nonzero((1, 2)) == "one-two"


func test_nonzero_second() -> Bool:
	match_nonzero((3, 4)) == "three-four"


func test_nonzero_fallthrough() -> Bool:
	match_nonzero((5, 6)) == "other"


tests: TestSuite = {
	description = "Tuple pattern matching",
	tests = [
		("match origin", test_match_origin),
		("match y-axis", test_match_y_axis),
		("match x-axis", test_match_x_axis),
		("match other", test_match_other),
		("extract binding", test_extract_binding),
		("nonzero first arm", test_nonzero_first),
		("nonzero second arm", test_nonzero_second),
		("nonzero fallthrough", test_nonzero_fallthrough),
	],
}
