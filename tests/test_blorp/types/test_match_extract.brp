-- Test extracting typed values from generic variants in match arms
import:
	test: TestSuite


func unwrap_int(opt: Option[Int]) -> Int:
	match opt:
		Some(n): n
		None: 0


func test_unwrap_int() -> Bool:
	unwrap_int(Some(42)) == 42


func double_option(opt: Option[Int]) -> Int:
	match opt:
		Some(n): n * 2
		None: 0


func test_double_option() -> Bool:
	double_option(Some(21)) == 42


func unwrap_string(opt: Option[String]) -> String:
	match opt:
		Some(s): s
		None: "default"


func test_unwrap_string() -> Bool:
	unwrap_string(Some("hello")) == "hello"


func test_unwrap_string_none() -> Bool:
	unwrap_string(None) == "default"


func concat_option(opt: Option[String]) -> String:
	match opt:
		Some(s): s + " world"
		None: "none"


func test_concat_option() -> Bool:
	concat_option(Some("hello")) == "hello world"


-- Non-generic variant with String field
union Named:
	WithName(String)
	Anonymous


func get_name(n: Named) -> String:
	match n:
		WithName(name): name
		Anonymous: "unknown"


func test_non_generic_string() -> Bool:
	get_name(WithName("alice")) == "alice"


func test_non_generic_string_fallback() -> Bool:
	get_name(Anonymous) == "unknown"


func unwrap_float(opt: Option[Float]) -> Float:
	match opt:
		Some(f): f
		None: 0.0


func test_unwrap_float() -> Bool:
	unwrap_float(Some(3.14)) == 3.14


func double_float_option(opt: Option[Float]) -> Float:
	match opt:
		Some(f): f * 2.0
		None: 0.0


func test_double_float_option() -> Bool:
	double_float_option(Some(21.5)) == 43.0


tests: TestSuite = {
	description = "Match extraction",
	tests = [
		("unwrap int", test_unwrap_int),
		("double option", test_double_option),
		("unwrap string", test_unwrap_string),
		("unwrap string none", test_unwrap_string_none),
		("concat option string", test_concat_option),
		("non-generic variant string", test_non_generic_string),
		("non-generic variant fallback", test_non_generic_string_fallback),
		("unwrap float", test_unwrap_float),
		("double float option", test_double_float_option),
	]
}
