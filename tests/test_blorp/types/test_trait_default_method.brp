-- Default method bodies on traits.
--
-- Typecheck synthesizes a [func_decl] copy of each default into each impl
-- that omits the method, substituting Self → impl's for-type in the
-- signature AND in type annotations inside the body. Dispatch and codegen
-- then treat the synthesized method like any other impl method.
import:
	test: TestSuite


-- (1) Default body that doesn't depend on any other trait method.
trait HasGreeting:
	pure func hg_id(self: Self) -> Int
	pure func greeting(self: Self) -> String:
		"hello"


record HGWidget {
	id: Int
}


implements HasGreeting for HGWidget:
	pure func hg_id(self: HGWidget) -> Int:
		self.id


func test_default_used() -> Bool:
	w: HGWidget = {id = 1}
	greeting(w) == "hello"


-- (2) Default body that calls another trait method on Self — the canonical
-- "mixin" pattern. The impl supplies the primitive; the trait supplies the
-- derived method.
trait Showable:
	pure func sh_name(self: Self) -> String
	pure func display(self: Self) -> String:
		"<" + sh_name(self) + ">"


record SWidget {
	id: Int
}


implements Showable for SWidget:
	pure func sh_name(self: SWidget) -> String:
		"widget"


func test_default_calls_required() -> Bool:
	w: SWidget = {id = 1}
	display(w) == "<widget>"


-- (3) Impl override takes precedence over a default body.
-- Regression pin: this path already works.
trait Named:
	pure func named(self: Self) -> String:
		"default name"


record NWidget {
	id: Int
}


implements Named for NWidget:
	pure func named(self: NWidget) -> String:
		"overridden"


func test_override_wins() -> Bool:
	w: NWidget = {id = 1}
	named(w) == "overridden"


-- (4) Default body with [Self] in an interior type annotation. The
-- synthesizer must substitute Self inside the body's type annotations,
-- not just in the method's param/return types. Without that, this
-- miscompiles: [local: Self] inside the synthesized SelfBodyWidget impl
-- would still reference the trait's Self, which is [TySelf] — not a
-- resolvable type by itself.
trait SelfBody:
	pure func tag(self: Self) -> String
	pure func render_tag(self: Self) -> String:
		local: Self = self
		"<" + tag(local) + ">"


record SBWidget {
	id: Int
}


implements SelfBody for SBWidget:
	pure func tag(self: SBWidget) -> String:
		"sb"


func test_default_body_has_self_annotation() -> Bool:
	w: SBWidget = {id = 7}
	render_tag(w) == "<sb>"


tests: TestSuite = {
	description = "Trait Default Method Dispatch",
	tests = [
		("default body used when impl omits it", test_default_used),
		("default body calls required method on Self", test_default_calls_required),
		("impl override takes precedence over default", test_override_wins),
		("default body with Self in type annotation", test_default_body_has_self_annotation),
	]
}
