-- Test that get_or produces correct results when fused with
-- Option-returning builtins. Each test verifies both the Some and None paths.
import:
	dict as D
	list: get
	option: get_or
	string: parse_int
	test: TestSuite


-- List get + get_or: Some path
func test_list_get_some() -> Bool:
	xs: List[Int] = [10, 20, 30]
	get(xs, 1).get_or(-1) == 20


-- List get + get_or: None path (out of bounds)
func test_list_get_none() -> Bool:
	xs: List[Int] = [10, 20, 30]
	get(xs, 99).get_or(-1) == -1


-- List get + get_or with String (RC type)
func test_list_get_string_some() -> Bool:
	xs: List[String] = ["hello", "world"]
	get(xs, 0).get_or("default") == "hello"


func test_list_get_string_none() -> Bool:
	xs: List[String] = ["hello", "world"]
	get(xs, 99).get_or("default") == "default"


-- Dict get + get_or
func test_dict_get_some() -> Bool:
	d: Dict[String, Int] = {"a" => 1, "b" => 2}
	D
		.get(d, "b")
		.get_or(0) == 2


func test_dict_get_none() -> Bool:
	d: Dict[String, Int] = {"a" => 1}
	D
		.get(d, "z")
		.get_or(0) == 0


-- checked_div + get_or
func test_checked_div_some() -> Bool:
	checked_div(10, 3).get_or(0) == 3


func test_checked_div_none() -> Bool:
	checked_div(10, 0).get_or(-1) == -1


-- checked_mod + get_or
func test_checked_mod_some() -> Bool:
	checked_mod(10, 3).get_or(0) == 1


func test_checked_mod_none() -> Bool:
	checked_mod(10, 0).get_or(-1) == -1


-- parse_int + get_or
func test_parse_int_some() -> Bool:
	parse_int("42").get_or(0) == 42


func test_parse_int_none() -> Bool:
	parse_int("abc").get_or(0) == 0


-- Nested: get_or in a loop (hot path)
func test_loop_fusion() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5]
	var sum: Int = 0
	for i in 0..10:
		sum += get(xs, i).get_or(0)
	sum == 15


tests: TestSuite = {
	description = "get_or fusion",
	tests = [
		("list get some", test_list_get_some),
		("list get none", test_list_get_none),
		("list get string some", test_list_get_string_some),
		("list get string none", test_list_get_string_none),
		("dict get some", test_dict_get_some),
		("dict get none", test_dict_get_none),
		("checked_div some", test_checked_div_some),
		("checked_div none", test_checked_div_none),
		("checked_mod some", test_checked_mod_some),
		("checked_mod none", test_checked_mod_none),
		("parse_int some", test_parse_int_some),
		("parse_int none", test_parse_int_none),
		("loop fusion", test_loop_fusion),
	]
}
