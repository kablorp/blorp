-- Test tuple destructuring for non-Int element types
import:
	test: TestSuite


func get_float_pair() -> (Float, Float):
	(3.14, 2.72)


func test_float_destruct() -> Bool:
	(a, b) = get_float_pair()
	a == 3.14


func get_string_pair() -> (String, String):
	("hello", "world")


func test_string_destruct() -> Bool:
	(a, b) = get_string_pair()
	a == "hello"


func get_bool_pair() -> (Bool, Bool):
	(True, False)


func test_bool_destruct() -> Bool:
	(a, b) = get_bool_pair()
	a == True


func get_mixed_pair() -> (Int, String):
	(42, "answer")


func test_mixed_destruct() -> Bool:
	(n, s) = get_mixed_pair()
	n == 42


func test_mixed_second() -> Bool:
	(_, s) = get_mixed_pair()
	s == "answer"


tests: TestSuite = {
	description = "Tuple Destruct Types",
	tests = [
		("float destruct", test_float_destruct),
		("string destruct", test_string_destruct),
		("bool destruct", test_bool_destruct),
		("mixed int+string", test_mixed_destruct),
		("mixed second elem", test_mixed_second),
	],
}
