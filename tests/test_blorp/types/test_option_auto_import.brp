import:
	list: get
	test: TestSuite


-- Test #23: Option/Some/None auto-imported (no explicit import needed)
func test_some_none() -> Bool:
	opt: Option[Int] = Some(42)
	match opt:
		Some(x): x == 42
		None: False


func test_list_get_no_import() -> Bool:
	nums: List[Int] = [10, 20, 30]
	match get(nums, 0):
		Some(v): v == 10
		None: False


func test_none_match() -> Bool:
	opt: Option[String] = None
	match opt:
		Some(_): False
		None: True


tests: TestSuite = {
	description = "Option auto-import",
	tests = [
		("some/none pattern", test_some_none),
		("list get no import", test_list_get_no_import),
		("none match", test_none_match),
	],
}
