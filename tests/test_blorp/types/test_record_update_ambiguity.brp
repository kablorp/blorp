import:
	test: TestSuite


record Small {x: Int, y: Int}


record Big {x: Int, y: Int, z: Int}


func test_update_small() -> Bool:
	s: Small = {x = 1, y = 2}
	s2: Small = { s | x = 10 }
	s2.x == 10 and s2.y == 2


func test_update_big() -> Bool:
	b: Big = {x = 1, y = 2, z = 3}
	b2: Big = { b | x = 10 }
	b2.x == 10 and b2.y == 2 and b2.z == 3


func test_update_both_exist() -> Bool:
	-- Both Small and Big have x,y fields
	-- Updating a Small should produce a Small, not a Big
	s: Small = {x = 1, y = 2}
	s2: Small = { s | x = 99 }
	s2.x == 99


func test_update_preserves_type() -> Bool:
	b: Big = {x = 1, y = 2, z = 3}
	b2: Big = { b | y = 20 }
	b2.z == 3


-- Bug 9: COW self-assignment path uses field-name matching, not typed AST
-- When s = { s | x = 99 }, the COW path may pick Big instead of Small
func test_cow_self_assign_small() -> Bool:
	var s: Small = {x = 1, y = 2}
	s = { s | x = 99 }
	s.x == 99 and s.y == 2


func test_cow_self_assign_big() -> Bool:
	var b: Big = {x = 1, y = 2, z = 3}
	b = { b | x = 99 }
	b.x == 99 and b.y == 2 and b.z == 3


func test_cow_self_assign_small_two_fields() -> Bool:
	var s: Small = {x = 1, y = 2}
	s = { s | x = 10, y = 20 }
	s.x == 10 and s.y == 20


tests: TestSuite = {
	description = "Record Update Ambiguity",
	tests = [
		("update small", test_update_small),
		("update big", test_update_big),
		("update both exist", test_update_both_exist),
		("update preserves type", test_update_preserves_type),
		("cow self-assign small", test_cow_self_assign_small),
		("cow self-assign big", test_cow_self_assign_big),
		("cow self-assign small two fields", test_cow_self_assign_small_two_fields),
	],
}
