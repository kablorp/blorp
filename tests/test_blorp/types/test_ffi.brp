import:
	test: TestSuite


-- FFI: call C math functions via foreign block with named args
foreign(include: "math.h"):
	func c_sin(x: Float) -> Float = "sin"
	func c_cos(x: Float) -> Float = "cos"
	func c_fabs(x: Float) -> Float = "fabs"
	func c_sqrt(x: Float) -> Float = "sqrt"
	func c_floor(x: Float) -> Float = "floor"
	func c_ceil(x: Float) -> Float = "ceil"


-- Helper: approximate equality check (impure because it calls foreign)
func approx_eq(a: Float, b: Float) -> Bool:
	c_fabs(a - b) < 0.0001


func test_sin() -> Bool:
	approx_eq(c_sin(0.0), 0.0) and approx_eq(c_sin(1.5707963), 1.0)


func test_cos() -> Bool:
	approx_eq(c_cos(0.0), 1.0) and approx_eq(c_cos(3.1415926), -1.0)


func test_fabs() -> Bool:
	approx_eq(c_fabs(-3.14), 3.14) and approx_eq(c_fabs(2.71), 2.71)


func test_sqrt() -> Bool:
	approx_eq(c_sqrt(4.0), 2.0) and approx_eq(c_sqrt(9.0), 3.0)


func test_floor() -> Bool:
	approx_eq(c_floor(3.7), 3.0) and approx_eq(c_floor(-2.3), -3.0)


func test_ceil() -> Bool:
	approx_eq(c_ceil(3.2), 4.0) and approx_eq(c_ceil(-2.7), -2.0)


func test_compose() -> Bool:
	x: Float = 1.234
	s: Float = c_sin(x)
	c: Float = c_cos(x)
	approx_eq(s * s + c * c, 1.0)


func test_foreign_composition() -> Bool:
	approx_eq(c_sqrt(16.0), 4.0)


tests: TestSuite = {
	description = "C FFI",
	tests = [
		("sin", test_sin),
		("cos", test_cos),
		("fabs", test_fabs),
		("sqrt", test_sqrt),
		("floor", test_floor),
		("ceil", test_ceil),
		("compose sin^2+cos^2=1", test_compose),
		("foreign composition", test_foreign_composition),
	],
}
-- sin^2(x) + cos^2(x) = 1 for any x
-- Compose multiple foreign calls
