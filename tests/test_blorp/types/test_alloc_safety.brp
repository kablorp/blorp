import:
	dict as Dict
	set as S
	test: TestSuite


-- Test large list creation and access
func test_large_list() -> Bool:
	var lst: List[Int] = []
	for i in 0..1000:
		lst = lst.append(i)
	ok1: Bool = lst.length() == 1000
	ok2: Bool = match lst.get(999):
		Some(v): v == 999
		None: False
	ok1 and ok2


-- Test large dict creation
func test_large_dict() -> Bool:
	var d: Dict[Int, Int] = Dict.dict()
	for i in 0..500:
		d = Dict.set(d, i, i * 3)
	ok1: Bool = d.length() == 500
	ok2: Bool = match Dict.get(d, 499):
		Some(v): v == 1497
		None: False
	ok1 and ok2


-- Test large set creation
func test_large_set() -> Bool:
	var s: Set[Int] = S.set()
	for i in 0..500:
		s = S.add(s, i)
	ok1: Bool = s.length() == 500
	ok2: Bool = S.contains(s, 499)
	ok3: Bool = not S.contains(s, 500)
	ok1 and ok2 and ok3


-- Test string concatenation scaling
func test_string_concat() -> Bool:
	var s: String = ""
	for i in 0..100:
		s += "ab"
	s.length() == 200


-- Test list of options (exercises Option + list allocation together)
func test_list_of_options() -> Bool:
	var lst: List[Option[Int]] = []
	for i in 0..200:
		lst = lst.append(Some(i))
	ok1: Bool = lst.length() == 200
	ok2: Bool = match lst.get(199):
		Some(opt):
			match opt:
				Some(v): v == 199
				None: False
		None: False
	ok1 and ok2


tests: TestSuite = {
	description = "Allocation safety",
	tests = [
		("large list", test_large_list),
		("large dict", test_large_dict),
		("large set", test_large_set),
		("string concat scaling", test_string_concat),
		("list of options", test_list_of_options),
	],
}
