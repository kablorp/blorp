import:
	test: TestSuite


func test_to_string() -> Bool:
	True.to_string() == "True" and False.to_string() == "False"


func test_equality() -> Bool:
	True == True and False == False and True != False


func test_to_int() -> Bool:
	to_int(True) == 1 and to_int(False) == 0


func test_to_float() -> Bool:
	to_float(True) == 1.0 and to_float(False) == 0.0


func test_and() -> Bool:
	(True and True) == True and (True and False) == False and (False and False) == False


func test_or() -> Bool:
	(True or False) == True and (False or False) == False and (True or True) == True


func test_not() -> Bool:
	not True == False and not False == True


tests: TestSuite = {
	description = "Bool",
	tests = [
		("to_string", test_to_string),
		("equality", test_equality),
		("to_int", test_to_int),
		("to_float", test_to_float),
		("and", test_and),
		("or", test_or),
		("not", test_not),
	]
}
