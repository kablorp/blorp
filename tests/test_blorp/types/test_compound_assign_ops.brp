-- Test compound assignment operators
import:
	test: TestSuite


func test_plus_eq() -> Bool:
	var x: Int = 10
	x += 5
	x == 15


func test_minus_eq() -> Bool:
	var x: Int = 10
	x -= 3
	x == 7


func test_times_eq() -> Bool:
	var x: Int = 10
	x *= 4
	x == 40


func test_div_eq() -> Bool:
	var x: Int = 20
	x /= 4
	x == 5


func test_all_ops() -> Bool:
	var x: Int = 100
	x += 20
	x -= 10
	x *= 2
	x /= 11
	x == 20


func test_float_compound() -> Bool:
	var f: Float = 10.0
	f += 2.5
	f -= 0.5
	f *= 2.0
	f /= 3.0
	f == 8.0


tests: TestSuite = {
	description = "Compound Assignment Operators",
	tests = [
		("+=", test_plus_eq),
		("-=", test_minus_eq),
		("*=", test_times_eq),
		("/=", test_div_eq),
		("all operators", test_all_ops),
		("float compound", test_float_compound),
	],
}
