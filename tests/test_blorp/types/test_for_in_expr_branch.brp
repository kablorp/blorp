import:
	test: TestSuite


record Item {value: Int}


record Point {x: Float, y: Float}


func sum_or_default(items: List[Item], use_items: Bool) -> Int:
	if use_items:
		var total: Int = 0
		for item in items:
			total += item.value
		total
	else:
		0


-- Float elements in expression branch
func sum_x_coords(points: List[Point], use_points: Bool) -> Float:
	if use_points:
		var total: Float = 0.0
		for p in points:
			total += p.x
		total
	else:
		0.0


-- Nested if/else with for-in in multiple branches
func conditional_sum(items: List[Item], mode: Int) -> Int:
	if mode == 1:
		var total: Int = 0
		for item in items:
			total += item.value
		total
	else if mode == 2:
		var total: Int = 0
		for item in items:
			total += item.value * 2
		total
	else:
		-1


func test_for_in_if_branch() -> Bool:
	items: List[Item] = [{value = 10}, {value = 20}, {value = 30}]
	sum_or_default(items, True) == 60


func test_for_in_else_default() -> Bool:
	items: List[Item] = [{value = 10}]
	sum_or_default(items, False) == 0


func test_float_record_for_in_expr() -> Bool:
	pts: List[Point] = [{x = 1.5, y = 2.0}, {x = 3.5, y = 4.0}]
	sum_x_coords(pts, True) == 5.0


func test_nested_branches() -> Bool:
	items: List[Item] = [{value = 5}, {value = 10}]
	conditional_sum(items, 1) == 15


func test_nested_branches_mode2() -> Bool:
	items: List[Item] = [{value = 5}, {value = 10}]
	conditional_sum(items, 2) == 30


func test_nested_branches_default() -> Bool:
	items: List[Item] = [{value = 5}]
	conditional_sum(items, 99) == -1


tests: TestSuite = {
	description = "For-in Expression Branch",
	tests = [
		("for in if branch", test_for_in_if_branch),
		("else default", test_for_in_else_default),
		("float record for-in expr", test_float_record_for_in_expr),
		("nested branches mode 1", test_nested_branches),
		("nested branches mode 2", test_nested_branches_mode2),
		("nested branches default", test_nested_branches_default),
	],
}
