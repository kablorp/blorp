-- Dimension peeling via subscript syntax.
-- m[i] on a 2D tensor yields a 1D row; m[i][j] equals m[i, j].
-- Runtime copy-based peeling via blorp_tensor_slice_row.
-- Covers both construction paths that must agree with flat peeling:
-- matrix(val, rows, cols) — flat constructor
-- {{a,b,c}, {d,e,f}}       — nested literal, flattened at core_emit
import:
	tensor: matrix
	test: TestSuite


func test_subscript_peel_length() -> Bool:
	m: Int[#2, #3] = matrix(0, 2, 3)
	row: Int[#3] = m[0]
	row.length() == 3


func test_subscript_peel_element() -> Bool:
	m: Int[#2, #3] = matrix(7, 2, 3)
	row: Int[#3] = m[0]
	row[0] == 7 and row[1] == 7 and row[2] == 7


func test_subscript_peel_equivalence() -> Bool:
	var m: Int[#2, #2] = matrix(0, 2, 2)
	m[0, 0] = 10
	m[0, 1] = 20
	m[1, 0] = 30
	m[1, 1] = 40
	m[0][0] == m[0, 0] and m[0][1] == m[0, 1] and m[1][0] == m[1, 0] and m[1][1] == m[1, 1]


func test_subscript_peel_row_identity() -> Bool:
	var m: Int[#2, #2] = matrix(0, 2, 2)
	m[0, 0] = 1
	m[0, 1] = 2
	m[1, 0] = 3
	m[1, 1] = 4
	row0: Int[#2] = m[0]
	row1: Int[#2] = m[1]
	row0[0] == 1 and row0[1] == 2 and row1[0] == 3 and row1[1] == 4


-- Nested-literal construction: exercises the core_emit CVector
-- flattening path (T[#M, #N] literal emits blorp_tensor_new
-- with flat row-major data[], not a vector-of-vectors).
func test_nested_literal_peel_first_row() -> Bool:
	m: Int[#2, #3] = {
		{10, 20, 30},
		{40, 50, 60},
	}
	row: Int[#3] = m[0]
	row[0] == 10 and row[1] == 20 and row[2] == 30


func test_nested_literal_peel_second_row() -> Bool:
	m: Int[#2, #3] = {
		{10, 20, 30},
		{40, 50, 60},
	}
	row: Int[#3] = m[1]
	row[0] == 40 and row[1] == 50 and row[2] == 60


func test_nested_literal_peel_equivalence() -> Bool:
	-- m[i][j] (peel then scalar) must equal m[i, j] (flat 2D access)
	-- for a nested-literal-constructed matrix.
	m: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	m[0][0] == m[0, 0] and m[0][1] == m[0, 1] and m[1][0] == m[1, 0] and m[1][1] == m[1, 1]


func test_nested_literal_peel_float() -> Bool:
	-- Float element type stresses the heap-boxing path for literals
	-- (each Float is boxed via blorp_box_float when stored in data[]).
	m: Float[#2, #2] = {
		{1.5, 2.5},
		{3.5, 4.5},
	}
	row: Float[#2] = m[1]
	row[0] == 3.5 and row[1] == 4.5


tests: TestSuite = {
	description = "Tensor subscript dimension peeling",
	tests = [
		("peel row length", test_subscript_peel_length),
		("peel row element access", test_subscript_peel_element),
		("m[i][j] == m[i,j]", test_subscript_peel_equivalence),
		("distinct rows", test_subscript_peel_row_identity),
		("nested literal peel row 0", test_nested_literal_peel_first_row),
		("nested literal peel row 1", test_nested_literal_peel_second_row),
		("nested literal peel equivalence", test_nested_literal_peel_equivalence),
		("nested literal peel Float", test_nested_literal_peel_float),
	]
}
