import:
	test: TestSuite


-- 4-variant enum (2 bits per element)
enum Base:
	A
	C
	G
	T


-- 2-variant enum (1 bit per element, like Bool)
enum OnOff:
	On
	Off


-- Small enum for testing
enum Suit:
	Hearts
	Diamonds
	Clubs
	Spades


-- Test 1: Basic packed enum tensor literal
func test_enum_tensor_literal() -> Bool:
	dna: Base[#4] = {A, C, G, T}
	dna[0] == A and dna[1] == C and dna[2] == G and dna[3] == T


-- Test 2: Subscript set on packed tensor
func test_enum_tensor_set() -> Bool:
	var dna: Base[#4] = {A, C, G, T}
	dna[1] = G
	dna[1] == G


-- Test 3: Bool tensor (1-bit packing)
func test_bool_tensor() -> Bool:
	flags: Bool[#4] = {True, False, True, False}
	flags[0] == True and flags[1] == False and flags[2] == True and flags[3] == False


-- Test 4: Bool tensor set
func test_bool_tensor_set() -> Bool:
	var flags: Bool[#4] = {True, False, True, False}
	flags[1] = True
	flags[1] == True


-- Test 5: For-loop iteration over packed tensor
func test_enum_tensor_for_loop() -> Bool:
	dna: Base[#4] = {A, C, G, T}
	var count: Int = 0
	for base in dna:
		count += 1
	count == 4


-- Test 6: Enum tensor constructed with vector()
func test_enum_tensor_vector() -> Bool:
	dna: Base[#10] = vector(A, 10)
	dna[0] == A and dna[9] == A


-- Test 7: Enum tensor vector() with non-zero fill
func test_enum_tensor_new_fill() -> Bool:
	dna: Base[#5] = vector(G, 5)
	dna[0] == G and dna[4] == G


-- Test 8: Bool tensor vector() fill
func test_bool_tensor_vector_fill() -> Bool:
	flags: Bool[#5] = vector(True, 5)
	flags[0] == True and flags[4] == True


-- Test 9: COW semantics on packed tensor
func test_enum_tensor_cow() -> Bool:
	a: Base[#4] = {A, C, G, T}
	var b: Base[#4] = a
	b[0] = T
	-- a should be unchanged (COW copy)
	a[0] == A and b[0] == T


-- Test 10: Large packed tensor (stress test bit packing)
func test_large_packed_tensor() -> Bool:
	dna: Base[#1000] = vector(C, 1000)
	dna[0] == C and dna[999] == C and dna[500] == C


-- Test 11: Large packed tensor with modification
func test_large_packed_tensor_set() -> Bool:
	var dna: Base[#100] = vector(A, 100)
	dna[50] = T
	dna[99] = G
	dna[0] == A and dna[50] == T and dna[99] == G


-- Test 12: 2D packed enum tensor
func test_2d_packed_tensor() -> Bool:
	grid: Base[#2, #3] = {
		{A, C, G},
		{T, A, C},
	}
	grid[0, 0] == A and grid[0, 2] == G and grid[1, 0] == T and grid[1, 2] == C


-- Test 13: 2D packed enum tensor set
func test_2d_packed_tensor_set() -> Bool:
	var grid: Base[#2, #3] = {
		{A, C, G},
		{T, A, C},
	}
	grid[1, 1] = G
	grid[1, 1] == G


-- Test 14: 2D packed enum tensor matrix() fill
func test_2d_packed_tensor_fill() -> Bool:
	grid: Base[#2, #3] = matrix(T, 2, 3)
	grid[0, 0] == T and grid[1, 2] == T


-- Test 15: Suit tensor (4 variants, 2 bits)
func test_suit_tensor() -> Bool:
	hand: Suit[#5] = {Hearts, Diamonds, Clubs, Spades, Hearts}
	hand[0] == Hearts and hand[3] == Spades


-- Test 16: OnOff tensor (2 variants, 1 bit)
func test_onoff_tensor() -> Bool:
	switches: OnOff[#8] = {On, Off, On, Off, On, Off, On, Off}
	switches[0] == On and switches[1] == Off and switches[6] == On


-- Test 17: to_string for packed enum tensor
func test_packed_tensor_to_string() -> Bool:
	dna: Base[#3] = {A, C, G}
	s: String = "${dna}"
	s == "{A, C, G}"


-- Test 18: Bool tensor to_string
func test_bool_tensor_to_string() -> Bool:
	flags: Bool[#3] = {True, False, True}
	s: String = "${flags}"
	s == "{True, False, True}"


-- Test 19: For-loop with match on packed elements
func test_for_loop_match() -> Bool:
	dna: Base[#4] = {A, C, G, T}
	var a_count: Int = 0
	for base in dna:
		match base:
			A: a_count += 1
			_: void
	a_count == 1


tests: TestSuite = {
	description = "Packed Enum Tensor Tests",
	tests = [
		("enum tensor literal", test_enum_tensor_literal),
		("enum tensor set", test_enum_tensor_set),
		("bool tensor", test_bool_tensor),
		("bool tensor set", test_bool_tensor_set),
		("enum tensor for loop", test_enum_tensor_for_loop),
		("enum tensor vector()", test_enum_tensor_vector),
		("enum tensor vector() fill", test_enum_tensor_new_fill),
		("bool tensor vector() fill", test_bool_tensor_vector_fill),
		("enum tensor COW", test_enum_tensor_cow),
		("large packed tensor", test_large_packed_tensor),
		("large packed tensor set", test_large_packed_tensor_set),
		("2D packed tensor", test_2d_packed_tensor),
		("2D packed tensor set", test_2d_packed_tensor_set),
		("2D packed tensor fill", test_2d_packed_tensor_fill),
		("suit tensor", test_suit_tensor),
		("onoff tensor", test_onoff_tensor),
		("packed tensor to_string", test_packed_tensor_to_string),
		("bool tensor to_string", test_bool_tensor_to_string),
		("for loop with match", test_for_loop_match),
	],
}
