-- Range expression tests
import:
	test: TestSuite


func test_basic_range() -> Bool:
	var total: Int = 0
	for i in 0..5:
		total += i
	total == 10


func test_range_start_end() -> Bool:
	var total: Int = 0
	for i in 3..6:
		total += i
	total == 12


func test_empty_range() -> Bool:
	var total: Int = 0
	for i in 5..5:
		total += 1
	total == 0


func test_negative_range() -> Bool:
	var total: Int = 0
	for i in -3..0:
		total += i
	total == -6


func test_backwards_range() -> Bool:
	var total: Int = 0
	for i in 5..3:
		total += i
	total == 9


func test_range_with_expressions() -> Bool:
	var start: Int = 2
	var end_val: Int = 7
	var total: Int = 0
	for i in start..end_val:
		total += i
	total == 20


func test_range_value_fields() -> Bool:
	r = 2..6
	r.start == 2 and r.end == 6


func test_range_value_for_loop() -> Bool:
	r = 1..4
	var total: Int = 0
	for i in r:
		total += i
	total == 6


func test_backwards_range_value_for_loop() -> Bool:
	r = 5..2
	var total: Int = 0
	for i in r:
		total += i
	total == 12


pure func sum_range_values(r: Range) -> Int:
	var total: Int = 0
	for i in r:
		total += i
	total


func test_range_parameter_for_loop() -> Bool:
	sum_range_values(1..4) == 6 and sum_range_values(4..1) == 9 and sum_range_values(2..2) == 0


func test_range_length() -> Bool:
	(0..5).length() == 5 and (5..2).length() == 3 and (4..4).length() == 0


func test_range_is_empty() -> Bool:
	(3..3).is_empty() == True and (3..4).is_empty() == False and (4..3).is_empty() == False


func test_range_contains() -> Bool:
	asc_start = (2..5).contains(2)
	asc_mid = (2..5).contains(4)
	asc_end = (2..5).contains(5)
	desc_start = (5..2).contains(5)
	desc_mid = (5..2).contains(3)
	desc_end = (5..2).contains(2)
	asc_start and asc_mid and not asc_end and desc_start and desc_mid and not desc_end


func test_range_to_list() -> Bool:
	up = (1..4).to_list()
	down = (4..1).to_list()
	up == [1, 2, 3] and down == [4, 3, 2]


func test_range_fold() -> Bool:
	sum_up = (1..5).fold(0, pure func(acc: Int, x: Int): acc + x)
	sum_down = (5..2).fold(0, pure func(acc: Int, x: Int): acc + x)
	sum_up == 10 and sum_down == 12


func test_range_for_each() -> Bool:
	(0..3).for_each(func(_x: Int): void)
	True


tests: TestSuite = {
	description = "Range Expressions",
	tests = [
		("0..5 sums to 10", test_basic_range),
		("3..6 sums to 12", test_range_start_end),
		("5..5 is empty", test_empty_range),
		("-3..0 works with negatives", test_negative_range),
		("5..3 iterates down to 4", test_backwards_range),
		("range with variable bounds", test_range_with_expressions),
		("range value exposes bounds", test_range_value_fields),
		("range value is iterable", test_range_value_for_loop),
		("range value iterates backward", test_backwards_range_value_for_loop),
		("range parameter is iterable", test_range_parameter_for_loop),
		("range length", test_range_length),
		("range is_empty", test_range_is_empty),
		("range contains", test_range_contains),
		("range to_list", test_range_to_list),
		("range fold", test_range_fold),
		("range for_each", test_range_for_each),
	]
}
