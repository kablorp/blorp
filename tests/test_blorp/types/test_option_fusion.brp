import:
	test: TestSuite


-- User-defined functions returning Option[Primitive] — these are NOT
-- in the fusible_option_raw builtin list, so they exercise the
-- generalized fusion path.
pure func half_if_even(n: Int) -> Option[Int]:
	match n % 2 == 0:
		True: Some(n / 2)
		_: None


pure func safe_sqrt(x: Float) -> Option[Float]:
	match x >= 0.0:
		True: Some(sqrt(x))
		_: None


pure func is_ascii_alpha(c: Char) -> Option[Bool]:
	val: Int = to_int(c)
	match val >= 65 == True:
		True:
			match val <= 122:
				True: Some(True)
				_: None
		_: None


-- Test: match on user function returning Option[Int]
func test_match_option_int_some() -> Bool:
	result: Int = match half_if_even(42):
		Some(v): v
		None: -1
	result == 21


func test_match_option_int_none() -> Bool:
	result: Int = match half_if_even(7):
		Some(v): v
		None: -1
	result == -1


-- Test: match on user function returning Option[Float]
func test_match_option_float_some() -> Bool:
	result: Float = match safe_sqrt(16.0):
		Some(v): v
		None: -1.0
	result == 4.0


func test_match_option_float_none() -> Bool:
	result: Float = match safe_sqrt(-1.0):
		Some(v): v
		None: -1.0
	result == -1.0


-- Test: match on user function returning Option[Bool]
func test_match_option_bool() -> Bool:
	result: Bool = match is_ascii_alpha(to_char(65)):
		Some(v): v
		_: False
	result


-- Test: expression in Some arm (not just returning the value)
func test_some_arm_expression() -> Bool:
	result: Int = match half_if_even(100):
		Some(v): v * 2 + 1
		None: 0
	result == 101


-- Test: nested match on Option[Int]
func test_nested_option_match() -> Bool:
	a: Int = match half_if_even(20):
		Some(v):
			match half_if_even(v):
				Some(inner): inner
				None: -1
		None: -2
	a == 5


-- Test: Option[Int] in loop
func test_option_in_loop() -> Bool:
	var total: Int = 0
	for i in 0..10:
		match half_if_even(i):
			Some(v): total += v
			None: void

	-- evens: 0,2,4,6,8 → halved: 0,1,2,3,4 → sum = 10
	total == 10


-- Test: ?= propagation with user function returning Option[Int]
func option_int_value() -> Option[Int]:
	a ?= half_if_even(100)
	b ?= half_if_even(a)
	Some(a + b)


func test_question_bind_option_int() -> Bool:
	result: Option[Int] = option_int_value()

	-- 100 → 50 → 25, so a=50, b=25, a+b=75
	match result:
		Some(v): v == 75
		None: False


-- Test: ?= propagation that returns None
func option_none_value() -> Option[Int]:
	a ?= half_if_even(7)
	Some(a + 1)


func test_question_bind_option_none() -> Bool:
	result: Option[Int] = option_none_value()
	match result:
		Some(_): False
		None: True


-- Test: Option[Int] used as variable (should still work correctly)
func test_option_as_variable() -> Bool:
	opt: Option[Int] = half_if_even(42)
	result: Int = match opt:
		Some(v): v
		None: 0
	result == 21


-- Test: multiple calls in sequence
func test_multiple_option_calls() -> Bool:
	a: Int = match half_if_even(8):
		Some(v): v
		None: 0
	b: Int = match half_if_even(6):
		Some(v): v
		None: 0
	c: Int = match half_if_even(5):
		Some(v): v
		None: 0
	a == 4 and b == 3 and c == 0


-- Test: Option[Float32] (exercises blorp_unbox_float32 extraction)
pure func safe_sqrt_f32(x: Float32) -> Option[Float32]:
	match x >= to_float32(0):
		True: Some(to_float32(2))
		_: None


func test_match_option_float32() -> Bool:
	result: Float32 = match safe_sqrt_f32(to_float32(4)):
		Some(v): v
		None: to_float32(-1)
	result == to_float32(2)


-- Test: Option[Int32] (exercises sized int extraction)
pure func half_if_positive_i32(n: Int32) -> Option[Int32]:
	match n > to_int32(0):
		True: Some(n / to_int32(2))
		_: None


func test_match_option_int32() -> Bool:
	result: Int32 = match half_if_positive_i32(to_int32(42)):
		Some(v): v
		_: to_int32(0)
	result == to_int32(21)


-- Test: Option[Char] direct function call
func char_if_uppercase(c: Char) -> Option[Char]:
	val: Int = to_int(c)
	match val >= 65 and val <= 90:
		True: Some(c)
		_: None


func test_match_option_char() -> Bool:
	result: Char = match char_if_uppercase(to_char(65)):
		Some(c): c
		_: to_char(0)
	result == to_char(65)


tests: TestSuite = {
	description = "Generalized Option Fusion",
	tests = [
		("match Option[Int] Some", test_match_option_int_some),
		("match Option[Int] None", test_match_option_int_none),
		("match Option[Float] Some", test_match_option_float_some),
		("match Option[Float] None", test_match_option_float_none),
		("match Option[Bool]", test_match_option_bool),
		("Some arm expression", test_some_arm_expression),
		("nested Option match", test_nested_option_match),
		("Option in loop", test_option_in_loop),
		("?= Option[Int]", test_question_bind_option_int),
		("?= returns None", test_question_bind_option_none),
		("Option as variable", test_option_as_variable),
		("multiple sequential calls", test_multiple_option_calls),
		("match Option[Float32]", test_match_option_float32),
		("match Option[Int32]", test_match_option_int32),
		("match Option[Char]", test_match_option_char),
	]
}
