-- Runtime tests for if/else expression
import:
	test: TestSuite


pure func test_if_true() -> Bool:
	x: Int = if True:
		42
	else:
		0
	x == 42


pure func test_if_false() -> Bool:
	x: Int = if False:
		42
	else:
		0
	x == 0


pure func test_if_comparison() -> Bool:
	x: Int = if 5 > 3:
		1
	else:
		0
	x == 1


pure func test_if_nested() -> Bool:
	val: Int = 0
	result: String = if val > 0:
		"positive"
	else if val < 0:
		"negative"
	else:
		"zero"
	result == "zero"


pure func test_if_inline() -> Bool:
	x: Int = if 1 > 0:
		100
	else:
		200
	x == 100


tests: TestSuite = {
	description = "If Expression Tests",
	tests = [
		("if True returns then branch", test_if_true),
		("if False returns else branch", test_if_false),
		("if with comparison", test_if_comparison),
		("nested if/else", test_if_nested),
		("inline if expression", test_if_inline),
	],
}
