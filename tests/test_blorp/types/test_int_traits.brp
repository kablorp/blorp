import:
	test: TestSuite


func test_int_to_string() -> Bool:
	neg: Int = -1
	42.to_string() == "42" and neg.to_string() == "-1" and 0.to_string() == "0"


func test_int_equality() -> Bool:
	42 == 42 and 0 != 1


func test_int_ordering() -> Bool:
	1 < 2 and 2 > 1 and 1 <= 1 and 2 >= 2


func test_int_arithmetic() -> Bool:
	3 + 4 == 7 and 10 - 3 == 7 and 2 * 5 == 10 and 10 / 3 == 3 and 10 % 3 == 1


func test_int_safe_div_zero() -> Bool:
	10 / 0 == 0 and 10 % 0 == 0


func test_int_negation() -> Bool:
	-5 == -5 and -0 == 0


func test_int_conversions() -> Bool:
	to_float(42) == 42.0 and to_int(3.7) == 3


tests: TestSuite = {
	description = "Int Traits",
	tests = [
		("to_string", test_int_to_string),
		("equality", test_int_equality),
		("ordering", test_int_ordering),
		("arithmetic", test_int_arithmetic),
		("safe div zero", test_int_safe_div_zero),
		("negation", test_int_negation),
		("conversions", test_int_conversions),
	]
}
