-- Deterministic test: tuples, records, destructuring, record update
import:
	test: TestSuite


-- 2-tuple creation and access
func test_pair_access() -> Bool:
	p: (Int, String) = (42, "hello")
	p.0 == 42 and p.1 == "hello"


-- 3-tuple creation and access
func test_triple_access() -> Bool:
	t: (Int, Float, Bool) = (1, 2.5, True)
	t.0 == 1 and t.1 == 2.5 and t.2 == True


-- 4-tuple creation and access
func test_quad_access() -> Bool:
	q: (Int, Int, Int, Int) = (10, 20, 30, 40)
	q.0 == 10 and q.1 == 20 and q.2 == 30 and q.3 == 40


-- Tuple destructuring
func test_tuple_destruct() -> Bool:
	p: (Int, String) = (99, "world")
	(a, b) = p
	var ok: Bool = a == 99
	ok = ok and b == "world"
	ok


-- Tuple destructuring with wildcard
func test_tuple_wildcard() -> Bool:
	p: (Int, Int) = (7, 8)
	(_, second) = p
	var ok: Bool = second == 8
	ok


-- 3-tuple destructuring
func test_triple_destruct() -> Bool:
	t: (Int, Int, Int) = (1, 2, 3)
	(a, b, c) = t
	var ok: Bool = a + b + c == 6
	ok


-- Tuple in loop (accumulation)
func test_tuple_accumulate() -> Bool:
	var total: Int = 0
	for i in 0..10:
		p: (Int, Int) = (i, i * 2)
		total = total + p.0 + p.1
	total == 135


-- Record definition and access
record Point {x: Int, y: Int}


func test_record_create() -> Bool:
	p: Point = {x = 3, y = 4}
	p.x == 3 and p.y == 4


func test_record_literal_field_order() -> Bool:
	p: Point = {y = 4, x = 3}
	p.x == 3 and p.y == 4


-- Record update syntax
func test_record_update() -> Bool:
	p: Point = {x = 1, y = 2}
	q: Point = { p | x = 10 }
	q.x == 10 and q.y == 2 and p.x == 1


-- Record update multiple fields
func test_record_update_multi() -> Bool:
	p: Point = {x = 5, y = 5}
	q: Point = { p | x = 0, y = 0 }
	q.x == 0 and q.y == 0


-- Record with expressions in update
func test_record_update_expr() -> Bool:
	p: Point = {x = 10, y = 20}
	q: Point = { p | x = p.x + 1, y = p.y * 2 }
	q.x == 11 and q.y == 40


-- Nested record
record Rect {origin: Point, size: Point}


func test_nested_record() -> Bool:
	r: Rect = {origin = {x = 0, y = 0}, size = {x = 100, y = 50}}
	r.origin.x == 0 and r.size.x == 100


-- Record in loop
func test_record_loop() -> Bool:
	var total: Int = 0
	for i in 0..10:
		p: Point = {x = i, y = i + 1}
		total = total + p.x + p.y
	total == 100


-- Pattern matching on tuples
func test_tuple_match() -> Bool:
	p: (Int, Int) = (1, 2)
	result: Int = match p:
		(1, y): y
		_: 0
	result == 2


func test_managed_tuple_if_fields() -> Bool:
	p: (String, Int) = if True:
		("managed-left", 42)
	else:
		("managed-right", 0)
	p.0 == "managed-left" and p.1 == 42


func test_tuple_match_rhs_fields() -> Bool:
	key: Int = 1
	p: (Int, Int) = match key:
		0: (1, 2)
		_: (20, 22)
	p.0 + p.1 == 42


-- For-in tuple destructuring
func test_for_in_destruct() -> Bool:
	pairs: List[(Int, Int)] = [(1, 10), (2, 20), (3, 30)]
	var total: Int = 0
	for (a, b) in pairs:
		total = total + a + b
	total == 66


tests: TestSuite = {
	description = "Deterministic: Tuples and Records",
	tests = [
		("Pair access", test_pair_access),
		("Triple access", test_triple_access),
		("Quad access", test_quad_access),
		("Tuple destructuring", test_tuple_destruct),
		("Tuple wildcard", test_tuple_wildcard),
		("Triple destructuring", test_triple_destruct),
		("Tuple accumulation", test_tuple_accumulate),
		("Record creation", test_record_create),
		("Record literal field order", test_record_literal_field_order),
		("Record update", test_record_update),
		("Record update multi", test_record_update_multi),
		("Record update expr", test_record_update_expr),
		("Nested record", test_nested_record),
		("Record in loop", test_record_loop),
		("Tuple pattern match", test_tuple_match),
		("Managed tuple if fields", test_managed_tuple_if_fields),
		("Tuple match RHS fields", test_tuple_match_rhs_fields),
		("For-in tuple destruct", test_for_in_destruct),
	],
}
