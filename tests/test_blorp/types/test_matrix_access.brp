-- Test 2D matrix runtime-checked access helpers.
import:
	matrix:
		column_count,
		diagonal,
		get,
		get_column,
		get_column_or,
		get_or,
		get_row,
		get_row_or,
		identity,
		row_count,
		set_column,
		set_diagonal,
		set_row,
		trace,
	test: TestSuite


func test_matrix_get_some() -> Bool:
	m: Int[#3, #4] = matrix(0, 3, 4)
	match get(m, 1, 2):
		Some(v): v == 0
		None: False


func test_matrix_get_oob_row() -> Bool:
	m: Int[#3, #4] = matrix(0, 3, 4)
	match get(m, 10, 0):
		Some(_): False
		None: True


func test_matrix_get_oob_col() -> Bool:
	m: Int[#3, #4] = matrix(0, 3, 4)
	match get(m, 0, 10):
		Some(_): False
		None: True


func test_matrix_get_or() -> Bool:
	m: Int[#3, #4] = matrix(0, 3, 4)
	val: Int = m.get_or(1, 2, -1)
	oob: Int = m.get_or(10, 10, -999)
	val == 0 and oob == -999


func test_matrix_get_or_float() -> Bool:
	m: Float[#2, #3] = matrix(0.0, 2, 3)
	val: Float = m.get_or(0, 0, -1.0)
	val == 0.0


func test_matrix_row_count() -> Bool:
	m: Int[#2, #3] = matrix(0, 2, 3)
	m.row_count() == 2


func test_matrix_column_count() -> Bool:
	m: Int[#2, #3] = matrix(0, 2, 3)
	m.column_count() == 3


func test_matrix_diagonal() -> Bool:
	m: Int[#3, #3] = {
		{1, 2, 3},
		{4, 5, 6},
		{7, 8, 9},
	}
	d: Int[#3] = m.diagonal()
	d[0] == 1 and d[1] == 5 and d[2] == 9


func test_matrix_trace() -> Bool:
	m: Int[#3, #3] = {
		{1, 2, 3},
		{4, 5, 6},
		{7, 8, 9},
	}
	m.trace() == 15


func test_matrix_set_diagonal() -> Bool:
	m: Int[#3, #3] = {
		{1, 2, 3},
		{4, 5, 6},
		{7, 8, 9},
	}
	updated: Int[#3, #3] = m.set_diagonal({10, 20, 30})
	updated[0, 0] == 10 and updated[1, 1] == 20 and updated[2, 2] == 30 and updated[0, 1] == 2


func test_matrix_identity() -> Bool:
	id: Int[#3, #3] = identity(3)
	id[0, 0] == 1 and id[1, 1] == 1 and id[2, 2] == 1 and id[0, 1] == 0 and id[2, 0] == 0


func test_matrix_get_row_some() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	match m.get_row(1):
		Some(row): row[0] == 4 and row[1] == 5 and row[2] == 6
		None: False


func test_matrix_get_row_oob() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	match m.get_row(9):
		Some(_): False
		None: True


func test_matrix_get_row_or() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	fallback: Int[#3] = {7, 8, 9}
	row: Int[#3] = m.get_row_or(1, fallback)
	oob: Int[#3] = m.get_row_or(9, fallback)
	row[0] == 4 and row[2] == 6 and oob[0] == 7 and oob[2] == 9


func test_matrix_get_column_or() -> Bool:
	m: Int[#3, #2] = {
		{1, 2},
		{3, 4},
		{5, 6},
	}
	col: Int[#3] = m.get_column_or(1, -1)
	oob: Int[#3] = m.get_column_or(9, -1)
	col[0] == 2 and col[1] == 4 and col[2] == 6 and oob[0] == -1 and oob[2] == -1


func test_matrix_get_column_some() -> Bool:
	m: Int[#3, #2] = {
		{1, 2},
		{3, 4},
		{5, 6},
	}
	match m.get_column(1):
		Some(col): col[0] == 2 and col[1] == 4 and col[2] == 6
		None: False


func test_matrix_get_column_oob() -> Bool:
	m: Int[#3, #2] = {
		{1, 2},
		{3, 4},
		{5, 6},
	}
	match m.get_column(9):
		Some(_): False
		None: True


func test_matrix_set_row() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	updated: Int[#2, #3] = m.set_row(1, {7, 8, 9})
	updated[0, 0] == 1 and updated[1, 0] == 7 and updated[1, 2] == 9


func test_matrix_set_row_oob_unchanged() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	updated: Int[#2, #3] = m.set_row(9, {7, 8, 9})
	updated[0, 0] == 1 and updated[1, 2] == 6


func test_matrix_set_column() -> Bool:
	m: Int[#3, #2] = {
		{1, 2},
		{3, 4},
		{5, 6},
	}
	updated: Int[#3, #2] = m.set_column(1, {7, 8, 9})
	updated[0, 0] == 1 and updated[0, 1] == 7 and updated[2, 1] == 9


func test_matrix_set_column_oob_unchanged() -> Bool:
	m: Int[#3, #2] = {
		{1, 2},
		{3, 4},
		{5, 6},
	}
	updated: Int[#3, #2] = m.set_column(9, {7, 8, 9})
	updated[0, 1] == 2 and updated[2, 1] == 6


tests: TestSuite = {
	description = "Matrix 2D Access",
	tests = [
		("get Some", test_matrix_get_some),
		("get OOB row", test_matrix_get_oob_row),
		("get OOB col", test_matrix_get_oob_col),
		("get_or", test_matrix_get_or),
		("get_or Float", test_matrix_get_or_float),
		("row_count", test_matrix_row_count),
		("column_count", test_matrix_column_count),
		("diagonal", test_matrix_diagonal),
		("trace", test_matrix_trace),
		("set_diagonal", test_matrix_set_diagonal),
		("identity", test_matrix_identity),
		("get_row Some", test_matrix_get_row_some),
		("get_row OOB", test_matrix_get_row_oob),
		("get_row_or", test_matrix_get_row_or),
		("get_column_or", test_matrix_get_column_or),
		("get_column Some", test_matrix_get_column_some),
		("get_column OOB", test_matrix_get_column_oob),
		("set_row", test_matrix_set_row),
		("set_row OOB unchanged", test_matrix_set_row_oob_unchanged),
		("set_column", test_matrix_set_column),
		("set_column OOB unchanged", test_matrix_set_column_oob_unchanged),
	],
}
