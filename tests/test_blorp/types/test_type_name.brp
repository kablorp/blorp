import:
	debug: type_name
	tensor: length, set_all
	test: TestSuite


func test_int() -> Bool:
	type_name(42) == "#42"


func test_float() -> Bool:
	type_name(3.14) == "Float"


func test_string() -> Bool:
	type_name("hello") == "String"


func test_bool() -> Bool:
	type_name(True) == "Bool"


func test_list() -> Bool:
	type_name([1, 2, 3]) == "List[Int]"


func test_option() -> Bool:
	x: Option[Int] = Some(42)
	type_name(x) == "Option[Int]"


func test_tuple() -> Bool:
	t = (1, "hello")
	type_name(t) == "(#1, String)"


func test_vector() -> Bool:
	v: Int[#3] = {1, 2, 3}
	type_name(v) == "Int[#3]"


func test_matrix() -> Bool:
	m: Float[#2, #3] = matrix(0.0, 2, 3)
	type_name(m) == "Float[#2, #3]"


-- Variadic dimension resolution tests
pure func identity_tensor(t: Float[#Ds...]) -> Float[#Ds...]:
	t


func test_vardims_resolution() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	r = identity_tensor(v)
	type_name(r) == "Float[#3]"


func test_vardims_set_all() -> Bool:
	v: Int[#3] = {1, 2, 3}
	r: Int[#3] = set_all(v, 0)
	type_name(r) == "Int[#3]"


func test_return_type() -> Bool:
	type_name(length({1, 2, 3})) == "#3"


tests: TestSuite = {
	description = "type_name introspection",
	tests = [
		("Int", test_int),
		("Float", test_float),
		("String", test_string),
		("Bool", test_bool),
		("List[Int]", test_list),
		("Option[Int]", test_option),
		("tuple", test_tuple),
		("Vector", test_vector),
		("Matrix", test_matrix),
		("vardims resolution", test_vardims_resolution),
		("vardims set_all", test_vardims_set_all),
		("return type", test_return_type),
	]
}
