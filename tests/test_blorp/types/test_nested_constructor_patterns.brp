-- Regression test: nested constructor pattern matching
-- Ensures Some(Some(x)), Ok(VInt(n)), etc. compile and run correctly.
import:
	option: Option(Some, None)
	result: Result(Ok, Err)
	test: TestSuite


func test_some_some() -> Bool:
	o: Option[Option[Int]] = Some(Some(42))
	match o:
		Some(Some(x)): x == 42
		Some(None): False
		None: False


func test_some_none() -> Bool:
	o: Option[Option[Int]] = Some(None)
	match o:
		Some(Some(_)): False
		Some(None): True
		None: False


func test_none_outer() -> Bool:
	o: Option[Option[Int]] = None
	match o:
		Some(Some(_)): False
		Some(None): False
		None: True


func test_ok_some() -> Bool:
	r: Result[Option[Int], String] = Ok(Some(7))
	match r:
		Ok(Some(v)): v == 7
		Ok(None): False
		Err(_): False


func test_ok_none() -> Bool:
	r: Result[Option[Int], String] = Ok(None)
	match r:
		Ok(Some(_)): False
		Ok(None): True
		Err(_): False


func test_err_with_nested() -> Bool:
	r: Result[Option[Int], String] = Err("fail")
	match r:
		Ok(Some(_)): False
		Ok(None): False
		Err(e): e == "fail"


func test_nested_with_wildcard_default() -> Bool:
	o: Option[Option[Int]] = Some(Some(99))
	match o:
		Some(Some(0)): False
		Some(Some(1)): False
		_: True


func test_literal_in_nested() -> Bool:
	o: Option[Option[Int]] = Some(Some(42))
	match o:
		Some(Some(42)): True
		Some(Some(_)): False
		Some(None): False
		None: False


tests: TestSuite = {
	description = "Nested constructor pattern match",
	tests = [
		("Some(Some(x))", test_some_some),
		("Some(None)", test_some_none),
		("None outer", test_none_outer),
		("Ok(Some(v))", test_ok_some),
		("Ok(None)", test_ok_none),
		("Err with nested", test_err_with_nested),
		("nested with wildcard default", test_nested_with_wildcard_default),
		("literal in nested ctor", test_literal_in_nested),
	]
}
