import:
	test: TestSuite


-- Test record update syntax
record Point {
	x: Int,
	y: Int
}


record LabelledPoint {
	label: String,
	alternate: String
}


func test_single_field_update() -> Bool:
	p: Point = {
		x = 1,
		y = 2
	}
	q: Point = { p | x = 10 }
	q.x == 10 and q.y == 2


func test_multi_field_update() -> Bool:
	p: Point = {
		x = 1,
		y = 2
	}
	q: Point = { p |
		x = 0,
		y = 0
	}
	q.x == 0 and q.y == 0


func test_expr_in_update() -> Bool:
	p: Point = {
		x = 5,
		y = 10
	}
	q: Point = { p | x = p.x + 1 }
	q.x == 6 and q.y == 10


func test_original_unchanged() -> Bool:
	p: Point = {
		x = 1,
		y = 2
	}
	q: Point = { p | x = 99 }
	p.x == 1 and p.y == 2 and q.x == 99


func test_chained_update() -> Bool:
	p: Point = {
		x = 0,
		y = 0
	}
	q: Point = { { p | x = 1 } | y = 2 }
	q.x == 1 and q.y == 2


func test_mutable_self_update_preserves_value_semantics() -> Bool:
	var current: Point = {
		x = 1,
		y = 2
	}
	original: Point = current
	current = { current | x = current.x + 1 }
	original.x == 1 and original.y == 2 and current.x == 2 and current.y == 2


func test_mutable_self_update_retains_managed_fields() -> Bool:
	var current: LabelledPoint = {
		label = "left",
		alternate = "right"
	}
	current = { current | label = current.alternate }
	current.label == "right" and current.alternate == "right"


func test_nested_update_reuses_temporary_with_managed_fields() -> Bool:
	var current: LabelledPoint = {
		label = "left",
		alternate = "right"
	}
	original: LabelledPoint = current
	current = { { current | label = current.alternate } | alternate = current.label }

	(
		original.label == "left"
		and original.alternate == "right"
		and current.label == "right"
		and current.alternate == "left"
	)


tests: TestSuite = {
	description = "Record Update",
	tests = [
		("Single field update", test_single_field_update),
		("Multi field update", test_multi_field_update),
		("Expression in update value", test_expr_in_update),
		("Original unchanged", test_original_unchanged),
		("Chained updates", test_chained_update),
		(
			"Mutable self update preserves value semantics",
			test_mutable_self_update_preserves_value_semantics,
		),
		(
			"Mutable self update retains managed fields",
			test_mutable_self_update_retains_managed_fields,
		),
		(
			"Nested update reuses a temporary with managed fields",
			test_nested_update_reuses_temporary_with_managed_fields,
		),
	]
}
