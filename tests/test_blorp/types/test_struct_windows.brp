-- Struct elements in windows: w[j] must unbox past blorp_Object header
import:
	tensor: windows
	test: TestSuite


struct Pt {
	x: Int,
	y: Int
}


func mk(x: Int, y: Int) -> Pt:
	{
		x = x,
		y = y
	}


func test_struct_window_access() -> Bool:
	v: Pt[#4] = {mk(1, 2), mk(3, 4), mk(5, 6), mk(7, 8)}
	var sum_x: Int = 0
	for w in windows(v, 2):
		a: Pt = w[0]
		b: Pt = w[1]
		sum_x = sum_x + a.x + b.x

	-- windows: [1,3], [3,5], [5,7] → sum_x = (1+3)+(3+5)+(5+7) = 24
	sum_x == 24


func test_struct_window_single() -> Bool:
	v: Pt[#3] = {mk(10, 20), mk(30, 40), mk(50, 60)}
	var sum_y: Int = 0
	for w in windows(v, 1):
		p: Pt = w[0]
		sum_y += p.y
	sum_y == 120


tests: TestSuite = {
	description = "Struct windows",
	tests = [
		("struct window access", test_struct_window_access),
		("struct window single", test_struct_window_single),
	]
}
