-- Struct subscript assignment: v[i] = StructValue should work
import:
	test: TestSuite


struct Point {x: Int, y: Int}


func make_point(x: Int, y: Int) -> Point:
	{x = x, y = y}


-- Assign struct via literal index
func test_struct_assign_literal() -> Bool:
	p: Point = make_point(0, 0)
	var v: Point[#3] = {p, p, p}
	v[1] = make_point(42, 99)
	r: Point = v[1]
	r.x == 42 and r.y == 99


-- Assign struct via loop
func test_struct_assign_loop() -> Bool:
	p: Point = make_point(0, 0)
	var v: Point[#3] = {p, p, p}
	for i in 0..3:
		v[i] = make_point(i, i * 10)
	p0: Point = v[0]
	p1: Point = v[1]
	p2: Point = v[2]
	p0.x == 0 and p1.x == 1 and p2.x == 2 and p0.y == 0 and p1.y == 10 and p2.y == 20


-- Read struct back after assign
func test_struct_roundtrip() -> Bool:
	p: Point = make_point(0, 0)
	var v: Point[#2] = {p, p}
	v[0] = make_point(100, 200)
	v[1] = make_point(300, 400)
	a: Point = v[0]
	b: Point = v[1]
	a.x == 100 and a.y == 200 and b.x == 300 and b.y == 400


tests: TestSuite = {
	description = "Struct subscript assignment",
	tests = [
		("struct assign literal", test_struct_assign_literal),
		("struct assign loop", test_struct_assign_loop),
		("struct roundtrip", test_struct_roundtrip),
	],
}
