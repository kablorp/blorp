-- Test compound assignment operators
import:
	test: TestSuite


func test_plus_eq() -> Bool:
	var x: Int = 10
	x += 5
	x == 15


func test_minus_eq() -> Bool:
	var x: Int = 10
	x -= 3
	x == 7


func test_star_eq() -> Bool:
	var x: Int = 4
	x *= 3
	x == 12


func test_slash_eq() -> Bool:
	var x: Int = 20
	x /= 4
	x == 5


func test_chained() -> Bool:
	var x: Int = 10
	x += 5
	x *= 2
	x -= 10
	x /= 4
	x == 5


func test_float_plus_eq() -> Bool:
	var x: Float = 1.5
	x += 2.5
	x == 4.0


tests: TestSuite = {
	description = "Compound Assignment",
	tests = [
		("+=", test_plus_eq),
		("-=", test_minus_eq),
		("*=", test_star_eq),
		("/=", test_slash_eq),
		("chained", test_chained),
		("float +=", test_float_plus_eq),
	]
}
