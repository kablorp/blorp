import:
	test: TestSuite


-- Define custom traits
trait Description:
	pure func Description(value: Self) -> String


trait Mergeable:
	pure func merge_vals(a: Self, b: Self) -> Self


-- Implement Description for Int
implements Description for Int:
	pure func Description(value: Int) -> String:
		"Int(" + value.to_string() + ")"


-- Implement Description for Bool
implements Description for Bool:
	pure func Description(value: Bool) -> String:
		match value:
			True: "Bool(true)"
			False: "Bool(false)"


-- Implement Description for String
implements Description for String:
	pure func Description(value: String) -> String:
		"String(\"" + value + "\")"


-- Implement Mergeable for Int (addition)
implements Mergeable for Int:
	pure func merge_vals(a: Int, b: Int) -> Int:
		a + b


-- Implement Mergeable for String (concatenation)
implements Mergeable for String:
	pure func merge_vals(a: String, b: String) -> String:
		a + b


-- Test functions
func test_Description_int() -> Bool:
	Description(42) == "Int(42)"


func test_Description_bool_true() -> Bool:
	Description(True) == "Bool(true)"


func test_Description_bool_false() -> Bool:
	Description(False) == "Bool(false)"


func test_Description_string() -> Bool:
	Description("hello") == "String(\"hello\")"


func test_merge_vals_int() -> Bool:
	merge_vals(10, 20) == 30


func test_merge_vals_string() -> Bool:
	merge_vals("hello", " world") == "hello world"


tests: TestSuite = {
	description = "Trait Dispatch",
	tests = [
		("Description Int", test_Description_int),
		("Description Bool true", test_Description_bool_true),
		("Description Bool false", test_Description_bool_false),
		("Description String", test_Description_string),
		("merge_vals Int", test_merge_vals_int),
		("merge_vals String", test_merge_vals_string),
	],
}
