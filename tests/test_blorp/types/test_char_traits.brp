import:
	test: TestSuite


func test_char_to_string() -> Bool:
	'a'.to_string() == "a" and 'Z'.to_string() == "Z"


func test_char_equality() -> Bool:
	'a' == 'a' and 'a' != 'b'


func test_char_ordering() -> Bool:
	'a' < 'b' and 'z' > 'a'


func test_char_to_int() -> Bool:
	to_int('a') == 97 and to_int('A') == 65


func test_to_char() -> Bool:
	to_char(97) == 'a' and to_char(65) == 'A'


tests: TestSuite = {
	description = "Char Traits",
	tests = [
		("to_string", test_char_to_string),
		("equality", test_char_equality),
		("ordering", test_char_ordering),
		("to_int", test_char_to_int),
		("to_char", test_to_char),
	]
}
