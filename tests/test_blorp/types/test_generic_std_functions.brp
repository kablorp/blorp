import:
	float as F
	int as I
	test: TestSuite


-- Test: concrete int.clamp
func test_clamp_int() -> Bool:
	I.clamp(15, 0, 10) == 10 and I.clamp(-5, 0, 10) == 0 and I.clamp(5, 0, 10) == 5


-- Test: concrete float.lerp
func test_lerp_float() -> Bool:
	r: Float = F.lerp(0.0, 10.0, 0.5)
	r == 5.0


-- Test: concrete float.clamp
func test_clamp_float() -> Bool:
	r: Float = F.clamp(15.0, 0.0, 10.0)
	r == 10.0


-- Test: LOCAL generic function with Integer bound (monomorphized)
func local_clamp[T:Integer](val: T, lo: T, hi: T) -> T:
	match val < lo:
		True: lo
		_:
			match val > hi:
				True: hi
				_: val


func test_local_clamp_int() -> Bool:
	local_clamp(15, 0, 10) == 10


func test_local_clamp_int32() -> Bool:
	r: Int32 = local_clamp(to_int32(50), to_int32(0), to_int32(20))
	r == to_int32(20)


func test_local_clamp_uint8() -> Bool:
	r: UInt8 = local_clamp(to_uint8(200), to_uint8(0), to_uint8(100))
	r == to_uint8(100)


-- Test: LOCAL generic function with FloatingPoint bound
func local_lerp[T:FloatingPoint](a: T, b: T, t: T) -> T:
	a + (b - a) * t


func test_local_lerp_float() -> Bool:
	r: Float = local_lerp(0.0, 10.0, 0.5)
	r == 5.0


-- Test: generic vector ops
func double_vec[T:Integer, #N](v: T[#N]) -> T[#N]:
	v + v


func test_generic_vec_int() -> Bool:
	a: Int[#3] = vector(5, 3)
	b: Int[#3] = double_vec(a)
	b[0] == 10


-- Test: trait method dispatch (checked_div through generic)
func safe_div[T:Integer](a: T, b: T) -> Option[T]:
	checked_div(a, b)


func test_checked_div_generic() -> Bool:
	match safe_div(10, 3):
		Some(v): v == 3
		None: False


func test_checked_div_zero() -> Bool:
	match safe_div(10, 0):
		Some(_): False
		None: True


-- Test: bitwise ops through generic
func bitwise_mask[T:Integer](x: T, m: T) -> T:
	bit_and(x, m)


func test_bitwise_generic() -> Bool:
	bitwise_mask(255, 15) == 15


tests: TestSuite = {
	description = "Generic Std Library Functions",
	tests = [
		("clamp Int", test_clamp_int),
		("lerp Float", test_lerp_float),
		("clamp Float", test_clamp_float),
		("local clamp Int", test_local_clamp_int),
		("local clamp Int32", test_local_clamp_int32),
		("local clamp UInt8", test_local_clamp_uint8),
		("local lerp Float", test_local_lerp_float),
		("generic vec Int", test_generic_vec_int),
		("checked_div generic", test_checked_div_generic),
		("checked_div zero", test_checked_div_zero),
		("bitwise generic", test_bitwise_generic),
	]
}
