-- Regression test: matching on Option returned from a module function
-- must work correctly. The Option is heap-allocated by the module function;
-- the match must use heap (pointer) access, not stack access.
import:
	string: index_of, parse_int
	tensor: get
	test: TestSuite


-- Match on string.index_of which returns Option[Int] from a module function
func test_index_of_match() -> Bool:
	s: String = "hello world"
	match s.index_of("world"):
		Some(i): i == 6
		None: False


func test_index_of_none() -> Bool:
	s: String = "hello"
	match s.index_of("xyz"):
		Some(_): False
		None: True


-- Match on parse_int which returns Option[Int]
func test_parse_int_match() -> Bool:
	match parse_int("42"):
		Some(v): v == 42
		None: False


-- Match on tensor.get which returns Option[T]
func test_vector_get_match() -> Bool:
	v: Int[#3] = {10, 20, 30}
	match get(v, 1):
		Some(val): val == 20
		None: False


-- Chain: module function Option used in if-expression
func test_option_in_if() -> Bool:
	result: Bool = match parse_int("99"):
		Some(n): n > 50
		None: False
	result


tests: TestSuite = {
	description = "Option from module functions",
	tests = [
		("index_of Some", test_index_of_match),
		("index_of None", test_index_of_none),
		("parse_int match", test_parse_int_match),
		("vector get match", test_vector_get_match),
		("option in if", test_option_in_if),
	]
}
