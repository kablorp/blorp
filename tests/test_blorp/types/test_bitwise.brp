import:
	test: TestSuite


-- bit_and
func test_bit_and_int() -> Bool:
	bit_and(255, 15) == 15


func test_bit_and_int8() -> Bool:
	a: Int8 = 127
	b: Int8 = 15
	result: Int8 = bit_and(a, b)
	to_int(result) == 15


func test_bit_and_uint32() -> Bool:
	a: UInt32 = 4294967295
	b: UInt32 = 255
	result: UInt32 = bit_and(a, b)
	to_int(result) == 255


-- bit_or
func test_bit_or_int() -> Bool:
	bit_or(240, 15) == 255


func test_bit_or_uint8() -> Bool:
	a: UInt8 = 240
	b: UInt8 = 15
	result: UInt8 = bit_or(a, b)
	to_int(result) == 255


-- bit_xor
func test_bit_xor_int() -> Bool:
	bit_xor(255, 255) == 0


func test_bit_xor_int16() -> Bool:
	a: Int16 = 255
	b: Int16 = 170
	result: Int16 = bit_xor(a, b)
	to_int(result) == 85


-- bit_not
func test_bit_not_uint8() -> Bool:
	a: UInt8 = 0
	result: UInt8 = bit_not(a)
	to_int(result) == 255


func test_bit_not_int() -> Bool:
	bit_not(0) == -1


-- shift_left
func test_shift_left_int() -> Bool:
	shift_left(1, 8) == 256


func test_shift_left_uint8() -> Bool:
	a: UInt8 = 1
	result: UInt8 = shift_left(a, 4)
	to_int(result) == 16


-- shift_right
func test_shift_right_int() -> Bool:
	shift_right(256, 4) == 16


func test_shift_right_uint16() -> Bool:
	a: UInt16 = 65280
	result: UInt16 = shift_right(a, 8)
	to_int(result) == 255


-- Combined operations
func test_extract_byte() -> Bool:
	-- Extract second byte from an Int
	val: Int = 4660
	byte1: Int = bit_and(shift_right(val, 8), 255)
	byte0: Int = bit_and(val, 255)
	byte1 == 18 and byte0 == 52


func test_set_bit() -> Bool:
	-- Set bit 3 of a UInt8
	val: UInt8 = 0
	result: UInt8 = bit_or(val, shift_left(to_uint8(1), 3))
	to_int(result) == 8


func test_toggle_bit() -> Bool:
	-- Toggle bit 0
	val: Int = 5
	toggled: Int = bit_xor(val, 1)
	toggled == 4


tests: TestSuite = {
	description = "Bitwise Operations",
	tests = [
		("bit_and Int", test_bit_and_int),
		("bit_and Int8", test_bit_and_int8),
		("bit_and UInt32", test_bit_and_uint32),
		("bit_or Int", test_bit_or_int),
		("bit_or UInt8", test_bit_or_uint8),
		("bit_xor Int", test_bit_xor_int),
		("bit_xor Int16", test_bit_xor_int16),
		("bit_not UInt8", test_bit_not_uint8),
		("bit_not Int", test_bit_not_int),
		("shift_left Int", test_shift_left_int),
		("shift_left UInt8", test_shift_left_uint8),
		("shift_right Int", test_shift_right_int),
		("shift_right UInt16", test_shift_right_uint16),
		("extract byte", test_extract_byte),
		("set bit", test_set_bit),
		("toggle bit", test_toggle_bit),
	]
}
