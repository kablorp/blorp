import:
	dict as D
	list as L
	test: TestSuite


struct Point {x: Float, y: Float}


struct Small {value: Int}


-- ===== List[Struct] =====
func test_list_append_get() -> Bool:
	pts: List[Point] = [{x = 1.0, y = 2.0}, {x = 3.0, y = 4.0}]
	match L.get(pts, 0):
		Some(p): p.x == 1.0 and p.y == 2.0
		None: False


func test_list_single_field_struct() -> Bool:
	items: List[Small] = [{value = 11}, {value = 22}]
	match L.get(items, 1):
		Some(item): item.value == 22
		None: False


func test_list_length() -> Bool:
	pts: List[Point] = [{x = 0.0, y = 0.0}, {x = 1.0, y = 1.0}, {x = 2.0, y = 2.0}]
	L.length(pts) == 3


func test_list_second_element() -> Bool:
	pts: List[Point] = [{x = 10.0, y = 20.0}, {x = 30.0, y = 40.0}]
	match L.get(pts, 1):
		Some(p): p.x == 30.0 and p.y == 40.0
		None: False


-- ===== Dict[String, Struct] =====
func test_dict_set_get() -> Bool:
	var d: Dict[String, Point] = D.dict()
	d = D.set(d, "origin", {x = 0.0, y = 0.0})
	d = D.set(d, "target", {x = 5.0, y = 10.0})
	match D.get(d, "target"):
		Some(p): p.x == 5.0 and p.y == 10.0
		None: False


-- ===== Option[Struct] in list =====
func test_option_struct_in_list() -> Bool:
	opts: List[Option[Point]] = [Some({x = 1.0, y = 2.0}), None]
	match L.get(opts, 0):
		Some(opt):
			match opt:
				Some(p): p.x == 1.0
				None: False
		None: False


-- ===== Struct as record field =====
record Line {start: Point, finish: Point, width: Float}


func test_struct_in_record() -> Bool:
	ln: Line = {start = {x = 0.0, y = 0.0}, finish = {x = 10.0, y = 10.0}, width = 2.0}
	ln.start.x == 0.0 and ln.finish.y == 10.0 and ln.width == 2.0


tests: TestSuite = {
	description = "Structs in Containers",
	tests = [
		("list append and get", test_list_append_get),
		("list single-field struct", test_list_single_field_struct),
		("list length", test_list_length),
		("list second element", test_list_second_element),
		("dict set and get", test_dict_set_get),
		("option struct in list", test_option_struct_in_list),
		("struct in record field", test_struct_in_record),
	],
}
