-- Phase 3.2 follow-up: Equatable and Orderable carry default bodies in
-- std/traits.brp, so user impls can provide only the minimum core method
-- and the rest synthesize automatically.
--
-- Equatable: user provides `equals`; `not_equals` defaults to
-- `not equals(a, b)`.
-- Orderable: user provides `less_than`; the other comparison methods default
-- to expressions over `less_than`.
import:
	test: TestSuite
	traits: Equatable, Orderable


record Age {years: Int}


implements Equatable for Age:
	pure func equals(a: Age, b: Age) -> Bool:
		-- Only `equals` provided. `not_equals` is inherited from the trait default.
		a.years == b.years


implements Orderable for Age:
	pure func less_than(a: Age, b: Age) -> Bool:
		-- Only `less_than` provided. The other comparisons inherit trait defaults.
		a.years < b.years


func test_ne_default() -> Bool:
	a: Age = {years = 10}
	b: Age = {years = 10}
	c: Age = {years = 20}
	-- `!=` goes through `Equatable.not_equals` with the default `not equals(a, b)`.
	a == b and a != c and not (a != b)


func test_gt_default() -> Bool:
	a: Age = {years = 10}
	b: Age = {years = 20}
	b > a and not (a > b)


func test_le_default() -> Bool:
	a: Age = {years = 10}
	b: Age = {years = 10}
	c: Age = {years = 20}
	-- `less_than_or_equal(a, b)` defaults to `not less_than(b, a)`.
	a <= b and a <= c and not (c <= a)


func test_ge_default() -> Bool:
	a: Age = {years = 10}
	b: Age = {years = 10}
	c: Age = {years = 5}
	a >= b and a >= c and not (c >= a)


tests: TestSuite = {
	description = "Trait Default Bodies",
	tests = [
		("not_equals defaults from equals", test_ne_default),
		("greater_than defaults from less_than", test_gt_default),
		("less_than_or_equal defaults from less_than", test_le_default),
		("greater_than_or_equal defaults from less_than", test_ge_default),
	],
}
