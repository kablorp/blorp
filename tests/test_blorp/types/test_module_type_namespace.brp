import:
	./helpers/type_namespace_a as A
	./helpers/type_namespace_b as B
	./helpers/type_namespace_forwarder as F
	test: TestSuite


func test_same_named_records_stay_module_local() -> Bool:
	A.get(A.make()) == 1 and B.get(B.make()) == 2


func test_same_named_structs_stay_module_local() -> Bool:
	A.point_value(A.make_point()) == 3 and B.point_value(B.make_point()) == 4


func test_same_named_unions_stay_module_local() -> Bool:
	A.choice_value(A.make_choice()) == 5 and B.choice_value(B.make_choice()) == 6


func test_imported_type_references_follow_owner_module() -> Bool:
	F.get_y(F.pass(B.make())) == 2


func test_explicit_qualified_annotations_keep_owner() -> Bool:
	a: A.Thing = A.make()
	b: B.Thing = B.make()
	a.x == 1 and b.y == 2


tests: TestSuite = {
	description = "Module Type Namespace",
	tests = [
		("same named records stay module local", test_same_named_records_stay_module_local),
		("same named structs stay module local", test_same_named_structs_stay_module_local),
		("same named unions stay module local", test_same_named_unions_stay_module_local),
		(
			"imported type references follow owner module",
			test_imported_type_references_follow_owner_module,
		),
		(
			"explicit qualified annotations keep owner",
			test_explicit_qualified_annotations_keep_owner,
		),
	],
}
