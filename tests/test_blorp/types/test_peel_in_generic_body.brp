-- Generic function containing dim peeling via a refined index.
-- Regression: specialize previously walked the generic body
-- itself (not just its monomorphized copies) and, because the body's
-- remaining dims are TyVars (like #N), tripped a failwith in the
-- tensor_peel → tensor_slice_row rewrite.
-- Fix: skip generic CDFunc bodies in specialize_decl — emit
-- already skips generic bodies (only concrete monomorphized copies
-- are emitted), so running specialize on them is wasted work
-- that additionally demands post-mono concrete dims the body doesn't
-- have.
import:
	tensor: matrix
	test: TestSuite


-- Generic body with peel via a refinement-typed index. #M and #N
-- are TyVars here; validate_index accepts `i: ..#M` against dim #M.
-- specialize on the generic body would see tensor_peel with
-- remaining dim TyVar "#N" and try to extract a constant — the bug.
pure func peel_at[T, #M, #N](m: T[#M, #N], i: ..#M) -> T[#N]:
	m[i]


-- 3D generic peel — remaining dims are [TyVar "#N", TyVar "#K"].
-- Exercises the product_opt / result_first_dim extraction paths.
pure func peel_plane[T, #M, #N, #K](t: T[#M, #N, #K], i: ..#M) -> T[#N, #K]:
	t[i]


func test_generic_peel_2d_known_index() -> Bool:
	m: Int[#2, #3] = matrix(7, 2, 3)
	i: Int = 0
	if i >= 0 and i < m.length():
		row: Int[#3] = peel_at(m, i)
		row.length() == 3 and row[0] == 7 and row[1] == 7 and row[2] == 7
	else:
		False


func test_generic_peel_2d_distinct() -> Bool:
	var m: Int[#2, #3] = matrix(0, 2, 3)
	m[0, 0] = 1
	m[0, 1] = 2
	m[0, 2] = 3
	m[1, 0] = 4
	m[1, 1] = 5
	m[1, 2] = 6
	i: Int = 1
	if i >= 0 and i < m.length():
		row: Int[#3] = peel_at(m, i)
		row[0] == 4 and row[1] == 5 and row[2] == 6
	else:
		False


-- Two monomorphizations of the same generic — mono queue stress.
func test_generic_peel_two_instantiations() -> Bool:
	small: Int[#2, #3] = matrix(1, 2, 3)
	big: Int[#4, #5] = matrix(9, 4, 5)
	si: Int = 0
	bi: Int = 0
	if (
		si >= 0
		and si < small.length()
		and bi >= 0
		and bi < big.length()
	):
		sr: Int[#3] = peel_at(small, si)
		br: Int[#5] = peel_at(big, bi)
		sr.length() == 3 and br.length() == 5 and sr[0] == 1 and br[0] == 9
	else:
		False


tests: TestSuite = {
	description = "Dim peeling inside generic function bodies",
	tests = [
		("generic peel 2D (known index)", test_generic_peel_2d_known_index),
		("generic peel 2D distinct rows", test_generic_peel_2d_distinct),
		("two monomorphizations", test_generic_peel_two_instantiations),
	]
}
