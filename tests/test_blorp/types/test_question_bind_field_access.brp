-- Bug #14: ?= propagation preserves type info on bound variables
-- Field access on ?= bound records fails because codegen emits void*
import:
	test: TestSuite


record Point {x: Int, y: Int}


func make_point(x: Int, y: Int) -> Result[Point, String]:
	Ok({x = x, y = y})


func validate_point(p: Point) -> Result[Point, String]:
	if p.x < 0 or p.y < 0:
		Err("negative coordinate")
	else:
		Ok(p)


-- Access field on a ?= bound record variable
func field_access_value() -> Result[Int, String]:
	p ?= make_point(3, 4)
	validated ?= validate_point(p)
	Ok(validated.x + validated.y)


func test_question_bind_field_access() -> Bool:
	result: Result[Int, String] = field_access_value()
	match result:
		Ok(v): v == 7
		Err(_): False


-- Access field on first ?= bound variable
func single_bind_field_value() -> Result[Int, String]:
	p ?= make_point(10, 20)
	Ok(p.x + p.y)


func test_question_bind_single_bind_field() -> Bool:
	result: Result[Int, String] = single_bind_field_value()
	match result:
		Ok(v): v == 30
		Err(_): False


-- Chain through multiple records, accessing fields at each step
func get_x(p: Point) -> Result[Int, String]:
	Ok(p.x)


func chain_field_access_value() -> Result[Int, String]:
	p ?= make_point(5, 7)
	x ?= get_x(p)
	Ok(x)


func test_question_bind_chain_field_access() -> Bool:
	result: Result[Int, String] = chain_field_access_value()
	match result:
		Ok(v): v == 5
		Err(_): False


-- Error path still works
func field_access_error_value() -> Result[Int, String]:
	p ?= make_point(3, 4)
	validated ?= validate_point({x = -1, y = 2})
	Ok(validated.x)


func test_question_bind_field_access_error() -> Bool:
	result: Result[Int, String] = field_access_error_value()
	match result:
		Ok(_): False
		Err(e): e == "negative coordinate"


tests: TestSuite = {
	description = "?= field access on bound records",
	tests = [
		("field access on bound record", test_question_bind_field_access),
		("single bind field access", test_question_bind_single_bind_field),
		("chain with field access", test_question_bind_chain_field_access),
		("error path works", test_question_bind_field_access_error),
	],
}
