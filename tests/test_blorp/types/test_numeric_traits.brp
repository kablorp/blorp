import:
	test: TestSuite


-- Test Integer trait bound is validated at call site
func identity_int[T:Integer](x: T) -> T:
	x


func test_integer_bound_int() -> Bool:
	result: Int = identity_int(42)
	result == 42


func test_integer_bound_int32() -> Bool:
	a: Int32 = to_int32(99)
	result: Int32 = identity_int(a)
	result == to_int32(99)


func test_integer_bound_uint8() -> Bool:
	a: UInt8 = to_uint8(200)
	result: UInt8 = identity_int(a)
	result == to_uint8(200)


-- Test SignedInteger bound
func identity_signed[T:SignedInteger](x: T) -> T:
	x


func test_signed_int() -> Bool:
	result: Int = identity_signed(42)
	result == 42


func test_signed_int16() -> Bool:
	a: Int16 = to_int16(-100)
	result: Int16 = identity_signed(a)
	result == to_int16(-100)


-- Test FloatingPoint bound
func identity_float[T:FloatingPoint](x: T) -> T:
	x


func test_float_bound() -> Bool:
	result: Float = identity_float(3.14)
	result == 3.14


func test_float32_bound() -> Bool:
	a: Float32 = to_float32(2)
	result: Float32 = identity_float(a)
	result == to_float32(2)


-- Test that concrete Int functions still work with checked_div
func test_concrete_checked_div() -> Bool:
	result: Option[Int] = checked_div(10, 0)
	match result:
		None: True
		_: False


-- Test Float32 sqrt (standalone function, not through trait)
func test_float32_sqrt() -> Bool:
	x: Float32 = sqrt(to_float32(4))
	x == to_float32(2)


tests: TestSuite = {
	description = "Numeric Type Family Traits",
	tests = [
		("Integer bound accepts Int", test_integer_bound_int),
		("Integer bound accepts Int32", test_integer_bound_int32),
		("Integer bound accepts UInt8", test_integer_bound_uint8),
		("SignedInteger bound accepts Int", test_signed_int),
		("SignedInteger bound accepts Int16", test_signed_int16),
		("FloatingPoint bound accepts Float", test_float_bound),
		("FloatingPoint bound accepts Float32", test_float32_bound),
		("Concrete checked_div still works", test_concrete_checked_div),
		("Float32 sqrt works", test_float32_sqrt),
	],
}
