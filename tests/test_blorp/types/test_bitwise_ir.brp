import:
	test: TestSuite


func test_bit_and() -> Bool:
	bit_and(255, 15) == 15


func test_bit_or() -> Bool:
	bit_or(240, 15) == 255


func test_bit_xor() -> Bool:
	bit_xor(255, 15) == 240


func test_bit_not() -> Bool:
	bit_not(0) == -1


func test_shift_left() -> Bool:
	shift_left(1, 8) == 256


func test_shift_right() -> Bool:
	shift_right(256, 4) == 16


func test_compose() -> Bool:
	val: Int = 43981
	bit_and(shift_right(val, 8), 255) == 171


tests: TestSuite = {
	description = "Bitwise Ops",
	tests = [
		("bit_and", test_bit_and),
		("bit_or", test_bit_or),
		("bit_xor", test_bit_xor),
		("bit_not", test_bit_not),
		("shift_left", test_shift_left),
		("shift_right", test_shift_right),
		("compose", test_compose),
	],
}
