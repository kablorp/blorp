import:
	test: TestSuite


-- Test tuple accessor syntax
func test_tuple_first_element() -> Bool:
	pair: (Int, Int) = (1, 2)
	first: Int = pair.0
	first == 1


func test_tuple_second_element() -> Bool:
	pair: (Int, Int) = (1, 2)
	second: Int = pair.1
	second == 2


tests: TestSuite = {
	description = "Tuple Accessor",
	tests = [
		("First element accessor pair.0", test_tuple_first_element),
		("Second element accessor pair.1", test_tuple_second_element),
	],
}
