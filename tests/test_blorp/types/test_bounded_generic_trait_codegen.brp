import:
	string: contains
	test: TestSuite


record Box[T] {
	value: T
}


implements Stringable for Box[T:Stringable]:
	pure func to_string(self: Box[T]) -> String:
		"Box(" + self.value.to_string() + ")"


func test_box_string_to_string() -> Bool:
	box: Box[String] = {value = "red"}
	box.to_string() == "Box(red)"


func test_list_box_string_to_string() -> Bool:
	boxes: List[Box[String]] = [{value = "red"}, {value = "blue"}]
	s: String = boxes.to_string()
	s.contains("Box(red)") and s.contains("Box(blue)")


tests: TestSuite = {
	description = "bounded generic trait codegen",
	tests = [
		("Box[String].to_string", test_box_string_to_string),
		("List[Box[String]].to_string", test_list_box_string_to_string),
	]
}
