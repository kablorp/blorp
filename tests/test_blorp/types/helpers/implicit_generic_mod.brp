-- Helper module with implicit single-char generic parameters.
-- Used by test_cross_module_implicit_generic.brp to verify that
-- qualified calls (M.func(...)) correctly generalize implicit type
-- params after typecheck persistence.
-- NOTE: multi-char implicit generics (Elem, Acc) require explicit
-- brackets ([Elem]). Single-char uppercase (T, A, B) is
-- auto-generalized by the is_type_variable heuristic.
pure func identity(x: T) -> T:
	x


pure func pick_first(a: T, b: T) -> T:
	a


pure func wrap_in_list(x: T) -> List[T]:
	[x]
