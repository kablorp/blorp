import:
	list: List
	test: TestSuite


-- User-defined variant type
union Shape:
	Circle(Float)
	Rect(Int, Int)
	Point


-- Test that basic pattern matching on user-defined variants works
func test_user_variant_match() -> Bool:
	s: Shape = Circle(3.14)
	match s:
		Circle(r): r > 3.0 and r < 4.0
		Rect(_, _): False
		Point: False


-- Test nullary constructor for user-defined variant
func test_user_variant_nullary() -> Bool:
	s: Shape = Point
	match s:
		Circle(_): False
		Rect(_, _): False
		Point: True


-- Test user-defined variants stored in a List
func test_variant_in_list() -> Bool:
	shapes: List[Shape] = [Circle(1.0), Rect(2, 3), Point, Circle(4.0)]
	match shapes.get(0):
		Some(s):
			match s:
				Circle(r): r > 0.9 and r < 1.1
				Rect(_, _): False
				Point: False
		None: False


-- Test multiple list accesses of variant values
func test_variant_list_multiple_access() -> Bool:
	shapes: List[Shape] = [Circle(1.0), Rect(2, 3), Point]
	ok1: Bool = match shapes.get(0):
		Some(s):
			match s:
				Circle(_): True
				Rect(_, _): False
				Point: False
		None: False
	ok2: Bool = match shapes.get(1):
		Some(s):
			match s:
				Rect(w, h): w == 2 and h == 3
				Circle(_): False
				Point: False
		None: False
	ok3: Bool = match shapes.get(2):
		Some(s):
			match s:
				Point: True
				Circle(_): False
				Rect(_, _): False
		None: False
	ok1 and ok2 and ok3


-- Test Option created in a loop (exercises allocator churn)
func test_option_in_loop() -> Bool:
	nums: List[Int] = [10, 20, 30, 40, 50]
	var total: Int = 0
	for i in 0..5:
		match nums.get(i):
			Some(v): total += v
			None: void
	total == 150


-- Test Result values from runtime functions
func test_result_basic() -> Bool:
	r: Result[Int, String] = Ok(42)
	match r:
		Ok(v): v == 42
		Err(_): False


func test_result_err() -> Bool:
	r: Result[Int, String] = Err("bad")
	match r:
		Ok(_): False
		Err(msg): msg == "bad"


-- Test Option equality still works with header
func test_option_eq_with_header() -> Bool:
	a: Option[Int] = Some(42)
	b: Option[Int] = Some(42)
	a == b


-- Test None equality still works with header
func test_none_eq_with_header() -> Bool:
	a: Option[Int] = None
	b: Option[Int] = None
	a == b


tests: TestSuite = {
	description = "Variant allocation (ARC-compatible)",
	tests = [
		("user variant match", test_user_variant_match),
		("user variant nullary", test_user_variant_nullary),
		("variant in list", test_variant_in_list),
		("variant list multiple access", test_variant_list_multiple_access),
		("option in loop", test_option_in_loop),
		("result ok", test_result_basic),
		("result err", test_result_err),
		("option eq with header", test_option_eq_with_header),
		("none eq with header", test_none_eq_with_header),
	],
}
