-- Deterministic test: ADTs, pattern matching, type aliases, exhaustiveness
import:
	test: TestSuite


-- Simple union type
union Color:
	Red
	Green
	Blue


func color_name(c: Color) -> String:
	match c:
		Red: "red"
		Green: "green"
		Blue: "blue"


func test_simple_union() -> Bool:
	color_name(Red) == "red" and color_name(Blue) == "blue"


-- Union with data
union Shape:
	Circle(Float)
	Rectangle(Float, Float)
	Point


func describe_shape(s: Shape) -> String:
	match s:
		Circle(_): "circle"
		Rectangle(_, _): "rectangle"
		Point: "point"


func test_union_with_data() -> Bool:
	describe_shape(Circle(5.0)) == "circle" and describe_shape(Point) == "point"


-- Extracting data from union
func get_radius(s: Shape) -> Float:
	match s:
		Circle(r): r
		_: 0.0


func test_union_extract() -> Bool:
	get_radius(Circle(3.14)) > 3.0 and get_radius(Point) == 0.0


-- Pattern matching on Int literals
func classify(n: Int) -> String:
	match n:
		0: "zero"
		1: "one"
		_: "other"


func test_literal_pattern() -> Bool:
	classify(0) == "zero" and classify(1) == "one" and classify(99) == "other"


-- Nested pattern matching
func test_nested_option_match() -> Bool:
	x: Option[Int] = Some(42)
	result: Int = match x:
		Some(v):
			if v > 0:
				v
			else:
				0
		None: 0
	result == 42


-- Pattern matching returning different types
union Expr:
	Lit(Int)
	Add(Int, Int)
	Neg(Int)


func eval_expr(e: Expr) -> Int:
	match e:
		Lit(n): n
		Add(a, b): a + b
		Neg(n): 0 - n


func test_expr_eval() -> Bool:
	eval_expr(Lit(5)) == 5 and eval_expr(Add(3, 4)) == 7 and eval_expr(Neg(10)) == -10


-- Wildcard pattern
func test_wildcard() -> Bool:
	c: Color = Green
	result: Bool = match c:
		Red: False
		_: True
	result


-- Match on Bool
func test_match_bool() -> Bool:
	x: Bool = True
	match x:
		True: True
		False: False


-- Match on String
func test_match_string() -> Bool:
	s: String = "hello"
	match s:
		"hello": True
		_: False


-- Record with union field
record Tagged {label: String, color: Color}


func test_record_with_union() -> Bool:
	t: Tagged = {label = "item", color = Red}
	t.label == "item" and color_name(t.color) == "red"


-- Option chaining via match
func add_options(a: Option[Int], b: Option[Int]) -> Option[Int]:
	match a:
		Some(x):
			match b:
				Some(y): Some(x + y)
				None: None
		None: None


func test_option_chain() -> Bool:
	match add_options(Some(10), Some(20)):
		Some(v): v == 30
		None: False
	and match add_options(Some(10), None):
		Some(_): False
		None: True


-- Chained function calls with union
union Counter:
	Stopped
	Counting(Int)
	Finished(Int)


func tick(c: Counter) -> Counter:
	match c:
		Stopped: Counting(1)
		Counting(n):
			if n >= 3:
				Finished(n)
			else:
				Counting(n + 1)
		Finished(n): Finished(n)


func test_state_machine() -> Bool:
	result: Counter = tick(tick(tick(tick(Stopped))))
	match result:
		Finished(n): n == 3
		_: False


-- Tuple pattern in match
func test_tuple_pattern_match() -> Bool:
	p: (Int, Int) = (3, 4)
	result: Int = match p:
		(0, _): 0
		(_, 0): 0
		(a, b): a + b
	result == 7


-- Multiple constructors with same shape
union Direction:
	North
	South
	East
	West


func is_vertical(d: Direction) -> Bool:
	match d:
		North: True
		South: True
		_: False


func test_direction() -> Bool:
	is_vertical(North) and is_vertical(South) and not is_vertical(East) and not is_vertical(West)


-- Match with guard-like pattern (if in arm body)
func test_match_with_guard() -> Bool:
	xs: List[Int] = [1, 2, 3]
	result: String = match xs.length():
		0: "empty"
		1: "single"
		_: "many"
	result == "many"


tests: TestSuite = {
	description = "Deterministic: Patterns and Types",
	tests = [
		("Simple union", test_simple_union),
		("Union with data", test_union_with_data),
		("Union extract", test_union_extract),
		("Literal pattern", test_literal_pattern),
		("Nested option match", test_nested_option_match),
		("Expr eval", test_expr_eval),
		("Wildcard pattern", test_wildcard),
		("Match Bool", test_match_bool),
		("Match String", test_match_string),
		("Record with union", test_record_with_union),
		("Option chain match", test_option_chain),
		("State machine", test_state_machine),
		("Tuple pattern", test_tuple_pattern_match),
		("Direction enum", test_direction),
		("Match with guard", test_match_with_guard),
	],
}
