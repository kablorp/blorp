-- type_name(x) / is_heap(x) inside a generic function body must report
-- the monomorphized concrete type, not the unresolved type variable.
-- Infer defers the fold when the arg type still carries tyvars; the
-- post-mono pass in core_specialize folds each mono copy separately.
import:
	debug: is_heap, type_name
	test: TestSuite


struct DebugPoint {
	x: Int,
	y: Int
}


type alias DebugPointAlias = DebugPoint

type alias MaybeDebugInt = Option[Int]


pure func identify[T](x: T) -> String:
	type_name(x)


pure func weigh[T](x: T) -> Bool:
	is_heap(x)


func test_concrete_int() -> Bool:
	identify(7) == "Int"


func test_concrete_string() -> Bool:
	identify("hi") == "String"


func test_concrete_float() -> Bool:
	identify(3.14) == "Float"


-- is_heap: stack primitives (Int, Bool, Char) fold to False;
-- heap-managed (String, List) fold to True. Each mono copy gets its
-- own fold — a regression would bake one answer across all copies.
func test_is_heap_int() -> Bool:
	weigh(7) == False


func test_is_heap_bool() -> Bool:
	weigh(True) == False


func test_is_heap_string() -> Bool:
	weigh("hi") == True


func test_is_heap_list() -> Bool:
	xs: List[Int] = [1, 2, 3]
	weigh(xs) == True


func test_is_heap_stack_option() -> Bool:
	x: MaybeDebugInt = Some(1)
	weigh(x) == False


func test_is_heap_struct_alias() -> Bool:
	p: DebugPointAlias = {
		x = 1,
		y = 2
	}
	weigh(p) == False


-- Bounded type param: [T: Stringable] is encoded as [TyVar "T:Stringable"]
-- by the parser. My first pattern arm (TyVar _) must catch it so infer
-- defers instead of eagerly folding to the literal string "T:Stringable".
pure func show[T:Stringable](x: T) -> String:
	type_name(x)


func test_bounded_int() -> Bool:
	show(7) == "Int"


func test_bounded_float() -> Bool:
	show(3.14) == "Float"


-- Even nested, mono should resolve the type.
pure func __nested_test_nested_generic_tag_0[T](x: T) -> String:
	type_name(x)


func test_nested_generic() -> Bool:
	void

	(
		__nested_test_nested_generic_tag_0(42) == "Int"
		and __nested_test_nested_generic_tag_0("s") == "String"
	)


tests: TestSuite = {
	description = "type_name / is_heap inside generic function bodies",
	tests = [
		("type_name Int", test_concrete_int),
		("type_name String", test_concrete_string),
		("type_name Float", test_concrete_float),
		("is_heap Int (stack)", test_is_heap_int),
		("is_heap Bool (stack)", test_is_heap_bool),
		("is_heap String (heap)", test_is_heap_string),
		("is_heap List (heap)", test_is_heap_list),
		("is_heap stack Option", test_is_heap_stack_option),
		("is_heap struct alias", test_is_heap_struct_alias),
		("bounded T: Stringable, Int", test_bounded_int),
		("bounded T: Stringable, Float", test_bounded_float),
		("nested generic", test_nested_generic),
	]
}
