-- Phase 2.5 regression: constructor wrapping a list pattern with a
-- trailing wildcard catchall used to fall through classify_arms to a
-- raw CMatch, which the emitter then refused to compile (exit at
-- compile time). This test pins the working behaviour post-fix.
--
-- Not exercised here (hits a deeper accessor-rendering gap in emit —
-- the list element needs an unbox cast before any inner tag access):
-- Some([Some(x), ...]) — triply-nested constructor-in-list-in-constructor.
-- That's filed as a follow-up.
import:
	test: TestSuite


pure func first_or_default(xs: Option[List[Int]]) -> Int:
	match xs:
		Some([x, ...rest]): x
		Some([]): 0
		None: -1
		_: -99


func test_some_nonempty() -> Bool:
	first_or_default(Some([7, 8, 9])) == 7


func test_some_empty() -> Bool:
	first_or_default(Some([])) == 0


func test_none() -> Bool:
	first_or_default(None) == -1


tests: TestSuite = {
	description = "Constructor wrapping list pattern + catchall",
	tests = [
		("Some([head, ...])", test_some_nonempty),
		("Some([])", test_some_empty),
		("None", test_none),
	],
}
