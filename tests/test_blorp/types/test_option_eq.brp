import:
	test: TestSuite


func test_some_int_eq() -> Bool:
	Some(42) == Some(42)


func test_some_int_neq() -> Bool:
	Some(1) != Some(2)


func test_none_eq() -> Bool:
	a: Option[Int] = None
	b: Option[Int] = None
	a == b


func test_some_vs_none() -> Bool:
	n: Option[Int] = None
	not (Some(1) == n)


func test_none_vs_some() -> Bool:
	a: Option[Int] = None
	a != Some(5)


func test_some_string_eq() -> Bool:
	Some("hello") == Some("hello")


func test_some_string_neq() -> Bool:
	Some("hello") != Some("world")


func test_some_bool_eq() -> Bool:
	Some(True) == Some(True) and Some(True) != Some(False)


func test_some_float_eq() -> Bool:
	Some(1.5) == Some(1.5) and Some(1.5) != Some(2.5)


func test_var_option_eq() -> Bool:
	a: Option[Int] = Some(100)
	b: Option[Int] = Some(100)
	a == b


tests: TestSuite = {
	description = "Option equality",
	tests = [
		("Some(Int) ==", test_some_int_eq),
		("Some(Int) !=", test_some_int_neq),
		("None == None", test_none_eq),
		("Some vs None", test_some_vs_none),
		("None vs Some", test_none_vs_some),
		("Some(String) ==", test_some_string_eq),
		("Some(String) !=", test_some_string_neq),
		("Some(Bool) equality", test_some_bool_eq),
		("Some(Float) equality", test_some_float_eq),
		("Var Option ==", test_var_option_eq),
	],
}
