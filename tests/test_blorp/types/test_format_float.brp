-- Test format() builtin for float precision formatting
import:
	float: format
	test: TestSuite


func test_format_2_decimals() -> Bool:
	format(3.14159, 2) == "3.14"


func test_format_0_decimals() -> Bool:
	format(3.14159, 0) == "3"


func test_format_4_decimals() -> Bool:
	format(0.001, 4) == "0.0010"


func test_format_negative() -> Bool:
	format(-1.5, 1) == "-1.5"


func test_format_zero() -> Bool:
	format(0.0, 3) == "0.000"


func test_format_large() -> Bool:
	format(12345.6789, 2) == "12345.68"


tests: TestSuite = {
	description = "Float format()",
	tests = [
		("format 2 decimals", test_format_2_decimals),
		("format 0 decimals", test_format_0_decimals),
		("format 4 decimals", test_format_4_decimals),
		("format negative", test_format_negative),
		("format zero", test_format_zero),
		("format large", test_format_large),
	]
}
