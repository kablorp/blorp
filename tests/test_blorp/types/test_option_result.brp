import:
	option: Option(Some, None), and_then, filter, get_or, get_or_else, is_none, is_some, map
	result as R: Result(Ok, Err), from_option, is_err, is_ok, swap, to_option
	test: TestSuite


-- Deterministic test: Option, Result, try blocks, ? operator
-- Basic Option creation
func test_option_some() -> Bool:
	x: Option[Int] = Some(42)
	is_some(x) and not is_none(x)


-- None handling
func test_option_none() -> Bool:
	x: Option[Int] = None
	is_none(x) and not is_some(x)


-- get_or
func test_get_or() -> Bool:
	n: Option[Int] = None
	get_or(Some(42), 0) == 42 and n.get_or(0) == 0


func fallback_value() -> Int:
	99


func test_get_or_else() -> Bool:
	n: Option[Int] = None
	get_or_else(Some(42), fallback_value) == 42 and n.get_or_else(fallback_value) == 99


-- Option map
func test_option_map() -> Bool:
	result: Option[Int] = map(Some(5), func(x: Int): x * 2)
	match result:
		Some(v): v == 10
		None: False


-- Option and_then
func test_option_and_then() -> Bool:
	result: Option[Int] = and_then(Some(5), func(x: Int) -> Option[Int]:
		if x > 0:
			Some(x * 3)
		else:
			None
	)
	match result:
		Some(v): v == 15
		None: False


-- Option filter
func test_option_filter() -> Bool:
	kept: Option[Int] = filter(Some(10), func(x: Int): x > 5)
	dropped: Option[Int] = filter(Some(3), func(x: Int): x > 5)
	is_some(kept) and is_none(dropped)


-- Option equality
func test_option_eq() -> Bool:
	Some(42) == Some(42) and Some(1) != Some(2) and Some(1) != None


-- None equality
func test_none_eq() -> Bool:
	a: Option[Int] = None
	b: Option[Int] = None
	a == b


-- Option to Result manual conversion
func test_option_to_result() -> Bool:
	opt: Option[Int] = Some(42)
	result: Result[Int, String] = match opt:
		Some(v): Ok(v)
		None: Err("missing")
	match result:
		Ok(v): v == 42
		Err(_): False


-- Basic Result creation
func test_result_ok() -> Bool:
	r: Result[Int, String] = Ok(42)
	is_ok(r) and not is_err(r)


-- Result Err
func test_result_err() -> Bool:
	r: Result[Int, String] = Err("oops")
	is_err(r) and not is_ok(r)


-- Result get_or
func test_result_unwrap() -> Bool:
	ok: Result[Int, String] = Ok(42)
	err: Result[Int, String] = Err("bad")
	R.get_or(ok, 0) == 42 and R.get_or(err, 0) == 0


-- Result map_err
func test_result_map_err() -> Bool:
	r: Result[Int, String] = Err("bad")
	mapped: Result[Int, String] = R.map_err(r, func(e: String): e + "!")
	match mapped:
		Ok(_): False
		Err(e): e == "bad!"


-- Result from_option
func test_from_option() -> Bool:
	some: Option[Int] = Some(42)
	none: Option[Int] = None
	match from_option(some, "missing"):
		Ok(v): v == 42
		Err(_): False
	and match from_option(none, "missing"):
		Ok(_): False
		Err(e): e == "missing"


-- Result to_option/swap conversion
func test_result_to_option() -> Bool:
	ok: Result[Int, String] = Ok(42)
	err: Result[Int, String] = Err("fail")
	match to_option(ok):
		Some(v): v == 42
		None: False
	and match to_option(swap(err)):
		Some(e): e == "fail"
		None: False


-- ? operator on Option
func safe_div_opt(a: Int, b: Int) -> Option[Int]:
	if b == 0:
		None
	else:
		Some(a / b)


func test_question_option() -> Bool:
	result: Option[Int] = try:
		x ?= safe_div_opt(10, 2)
		y ?= safe_div_opt(x, 1)
		y + 1
	match result:
		Some(v): v == 6
		None: False


-- ? operator short-circuit on None
func test_question_none() -> Bool:
	result: Option[Int] = try:
		x ?= Some(10)
		y: Option[Int] = None
		z ?= y
		x + z
	is_none(result)


-- try block with Result
func make_ok(n: Int) -> Result[Int, String]:
	Ok(n)


func make_err(msg: String) -> Result[Int, String]:
	Err(msg)


func test_try_result() -> Bool:
	result: Result[Int, String] = try:
		x ?= make_ok(10)
		y ?= make_ok(20)
		x + y
	match result:
		Ok(v): v == 30
		Err(_): False


-- try block short-circuit on Err
func test_try_result_err() -> Bool:
	result: Result[Int, String] = try:
		x ?= make_ok(10)
		y ?= make_err("fail")
		x + y
	match result:
		Ok(_): False
		Err(e): e == "fail"


-- Pattern matching Option in loop
func test_option_loop() -> Bool:
	xs: List[Int] = [1, 2, 3, 4, 5]
	var total: Int = 0
	for i in 0..7:
		match xs.get(i):
			Some(v): total += v
			None: void
	total == 15


tests: TestSuite = {
	description = "Deterministic: Option and Result",
	tests = [
		("Option Some", test_option_some),
		("Option None", test_option_none),
		("get_or", test_get_or),
		("get_or_else", test_get_or_else),
		("Option map", test_option_map),
		("Option and_then", test_option_and_then),
		("Option filter", test_option_filter),
		("Option equality", test_option_eq),
		("None equality", test_none_eq),
		("Option to Result", test_option_to_result),
		("Result Ok", test_result_ok),
		("Result Err", test_result_err),
		("Result get_or", test_result_unwrap),
		("Result map_err", test_result_map_err),
		("Result from_option", test_from_option),
		("Result to Option", test_result_to_option),
		("? on Option", test_question_option),
		("? short-circuit None", test_question_none),
		("try Result", test_try_result),
		("try Result Err", test_try_result_err),
		("Option in loop", test_option_loop),
	],
}
