-- Phase 3.2 regression: binary and unary operators on non-primitive
-- types dispatch through the trait system.
--
-- Before Phase 3.2, `v + w` where `v, w: Vec2` emitted a raw C `+` on
-- struct pointers — either a compile error or garbage. Now the lowering
-- routes to `Addable.add(v, w)` for any type whose operands aren't a
-- hardcoded-primitive fast-path (`Int`, `Float`, `String`, `List`, …).
-- `trait_resolve` then mangles the call to `Addable_add_Vec2`.
import:
	test: TestSuite


record Vec2 {
	x: Float,
	y: Float
}


implements Addable for Vec2:
	pure func add(a: Vec2, b: Vec2) -> Vec2:
		{
			x = a.x + b.x,
			y = a.y + b.y
		}


implements Subtractable for Vec2:
	pure func subtract(a: Vec2, b: Vec2) -> Vec2:
		{
			x = a.x - b.x,
			y = a.y - b.y
		}


implements Multipliable for Vec2:
	pure func multiply(a: Vec2, b: Vec2) -> Vec2:
		{
			x = a.x * b.x,
			y = a.y * b.y
		}


implements Negatable for Vec2:
	pure func negate(a: Vec2) -> Vec2:
		{
			x = -a.x,
			y = -a.y
		}


implements Equatable for Vec2:
	pure func equals(a: Vec2, b: Vec2) -> Bool:
		a.x == b.x and a.y == b.y

	pure func not_equals(a: Vec2, b: Vec2) -> Bool:
		not (a.x == b.x and a.y == b.y)


implements Orderable for Vec2:
	pure func less_than(a: Vec2, b: Vec2) -> Bool:
		-- WARNING: lexicographic ordering on a 2D vector is a TEST FIXTURE
		-- for the comparison dispatch arms. It is not a semantic recommendation.
		-- Real game / geometry code sorts vectors by magnitude, depth, or a
		-- named key function, never by `<`.
		a.x < b.x or a.x == b.x and a.y < b.y

	pure func greater_than(a: Vec2, b: Vec2) -> Bool:
		a.x > b.x or a.x == b.x and a.y > b.y

	pure func less_than_or_equal(a: Vec2, b: Vec2) -> Bool:
		a.x < b.x or a.x == b.x and a.y <= b.y

	pure func greater_than_or_equal(a: Vec2, b: Vec2) -> Bool:
		a.x > b.x or a.x == b.x and a.y >= b.y


func test_vec2_add() -> Bool:
	a: Vec2 = {
		x = 1.0,
		y = 2.0
	}
	b: Vec2 = {
		x = 3.0,
		y = 4.0
	}
	sum: Vec2 = a + b
	sum.x == 4.0 and sum.y == 6.0


func test_vec2_sub() -> Bool:
	a: Vec2 = {
		x = 5.0,
		y = 7.0
	}
	b: Vec2 = {
		x = 1.0,
		y = 2.0
	}
	d: Vec2 = a - b
	d.x == 4.0 and d.y == 5.0


func test_vec2_mul() -> Bool:
	a: Vec2 = {
		x = 2.0,
		y = 3.0
	}
	b: Vec2 = {
		x = 4.0,
		y = 5.0
	}
	p: Vec2 = a * b
	p.x == 8.0 and p.y == 15.0


func test_vec2_neg() -> Bool:
	a: Vec2 = {
		x = 1.5,
		y = -2.5
	}
	n: Vec2 = -a
	n.x == -1.5 and n.y == 2.5


func test_vec2_eq() -> Bool:
	a: Vec2 = {
		x = 1.0,
		y = 2.0
	}
	b: Vec2 = {
		x = 1.0,
		y = 2.0
	}
	c: Vec2 = {
		x = 1.0,
		y = 3.0
	}
	a == b and not (a == c)


func test_vec2_ne() -> Bool:
	a: Vec2 = {
		x = 1.0,
		y = 2.0
	}
	b: Vec2 = {
		x = 9.0,
		y = 9.0
	}
	a != b and not (a != a)


func test_vec2_lt() -> Bool:
	a: Vec2 = {
		x = 1.0,
		y = 2.0
	}
	b: Vec2 = {
		x = 2.0,
		y = 0.0
	}
	a < b and not (b < a)


func test_primitive_fast_path() -> Bool:
	-- Regression: primitives must NOT route through the trait dispatch.
	-- Keep this test here so a future change that accidentally routes
	-- Int + Int through `Addable_add_Int` is caught by the suite.
	1 + 2 == 3 and 2.0 * 3.0 == 6.0 and "a" + "b" == "ab"


tests: TestSuite = {
	description = "Operator Overload",
	tests = [
		("vec2 add", test_vec2_add),
		("vec2 subtract", test_vec2_sub),
		("vec2 multiply", test_vec2_mul),
		("vec2 negate", test_vec2_neg),
		("vec2 equals", test_vec2_eq),
		("vec2 not_equals", test_vec2_ne),
		("vec2 less_than", test_vec2_lt),
		("primitive fast path", test_primitive_fast_path),
	]
}
