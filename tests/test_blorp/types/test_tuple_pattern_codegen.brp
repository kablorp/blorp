-- Regression test: tuple pattern matching compilation
-- Ensures (a, b), (0, _), (Some(x), None) etc. compile via CMatch (decision tree).
import:
	option: Option(Some, None)
	test: TestSuite


func test_simple_bind() -> Bool:
	p: (Int, Int) = (3, 7)
	match p:
		(a, b): a + b == 10


func test_literal_first() -> Bool:
	p: (Int, Int) = (0, 5)
	match p:
		(0, y): y == 5
		(_, _): False


func test_literal_both() -> Bool:
	p: (Int, Int) = (0, 0)
	match p:
		(0, 0): True
		(0, _): False
		_: False


func test_literal_fallthrough() -> Bool:
	p: (Int, Int) = (1, 2)
	match p:
		(0, 0): False
		(0, _): False
		_: True


func test_ctor_in_tuple() -> Bool:
	p: (Option[Int], Option[Int]) = (Some(1), None)
	match p:
		(Some(x), None): x == 1
		(None, Some(_)): False
		_: False


func test_ctor_second_match() -> Bool:
	p: (Option[Int], Option[Int]) = (None, Some(42))
	match p:
		(Some(_), None): False
		(None, Some(y)): y == 42
		_: False


func test_wildcard_default() -> Bool:
	p: (Option[Int], Option[Int]) = (None, None)
	match p:
		(Some(_), None): False
		(None, Some(_)): False
		_: True


func test_triple_bind() -> Bool:
	t: (Int, Int, Int) = (1, 2, 3)
	match t:
		(a, b, c): a + b + c == 6


tests: TestSuite = {
	description = "Tuple pattern match",
	tests = [
		("simple bind", test_simple_bind),
		("literal first element", test_literal_first),
		("literal both elements", test_literal_both),
		("literal fallthrough to default", test_literal_fallthrough),
		("constructor in tuple", test_ctor_in_tuple),
		("constructor second match", test_ctor_second_match),
		("wildcard default", test_wildcard_default),
		("triple bind", test_triple_bind),
	]
}
