-- Test all type conversions
import:
	test: TestSuite


func test_int_to_float() -> Bool:
	i: Int = 42
	i_f: Float = to_float(i)
	i_f == 42.0


func test_int_to_bool_nonzero() -> Bool:
	i: Int = 42
	i_b: Bool = to_bool(i)
	i_b == True


func test_float_to_int() -> Bool:
	f: Float = 3.14
	f_i: Int = to_int(f)
	f_i == 3


func test_float_to_bool_nonzero() -> Bool:
	f: Float = 3.14
	f_b: Bool = to_bool(f)
	f_b == True


func test_bool_true_to_int() -> Bool:
	b: Bool = True
	b_i: Int = to_int(b)
	b_i == 1


func test_bool_true_to_float() -> Bool:
	b: Bool = True
	b_f: Float = to_float(b)
	b_f == 1.0


func test_zero_to_bool() -> Bool:
	zero: Int = 0
	zero_b: Bool = to_bool(zero)
	zero_b == False


func test_bool_false_to_int() -> Bool:
	false_b: Bool = False
	false_i: Int = to_int(false_b)
	false_i == 0


tests: TestSuite = {
	description = "Type Conversions",
	tests = [
		("Int to Float conversion", test_int_to_float),
		("Int to Bool (nonzero)", test_int_to_bool_nonzero),
		("Float to Int conversion", test_float_to_int),
		("Float to Bool (nonzero)", test_float_to_bool_nonzero),
		("Bool True to Int", test_bool_true_to_int),
		("Bool True to Float", test_bool_true_to_float),
		("Zero Int to Bool", test_zero_to_bool),
		("Bool False to Int", test_bool_false_to_int),
	]
}
