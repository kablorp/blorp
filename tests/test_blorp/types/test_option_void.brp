import:
	test: TestSuite


func touch(n: Int) -> Void:
	void


func test_some_void() -> Bool:
	result: Option[Void] = Some(1).map(touch)
	match result:
		Some(_): True
		None: False


func test_none_void() -> Bool:
	source: Option[Int] = None
	result: Option[Void] = source.map(touch)
	match result:
		Some(_): False
		None: True


func test_void_option_discarded_in_loop() -> Bool:
	var i: Int = 0
	while i < 2:
		i += 1
		Some(i).map(touch)
	i == 2


tests: TestSuite = {
	description = "Option[Void]",
	tests = [
		("Some(Void)", test_some_void),
		("None(Void)", test_none_void),
		("discarded in loop", test_void_option_discarded_in_loop),
	]
}
