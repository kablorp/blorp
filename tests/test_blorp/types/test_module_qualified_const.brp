import:
	./helpers/constants_mod as CM
	test: TestSuite


func test_module_qualified_int_const() -> Bool:
	CM.MY_INT == 42


func test_module_qualified_float_const() -> Bool:
	CM.MY_FLOAT > 3.13 and CM.MY_FLOAT < 3.15


func test_module_qualified_bool_const() -> Bool:
	CM.MY_BOOL


func test_module_qualified_char_const() -> Bool:
	CM.MY_CHAR == 'X'


func test_module_qualified_string_const() -> Bool:
	CM.MY_STRING == "hello"


tests: TestSuite = {
	description = "Module-Qualified Constants",
	tests = [
		("int const", test_module_qualified_int_const),
		("float const", test_module_qualified_float_const),
		("bool const", test_module_qualified_bool_const),
		("char const", test_module_qualified_char_const),
		("string const", test_module_qualified_string_const),
	]
}
