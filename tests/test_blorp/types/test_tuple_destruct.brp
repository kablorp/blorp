import:
	test: TestSuite


func make_pair() -> (Int, String):
	(42, "hello")


func test_basic_destructure() -> Bool:
	(a, b) = (1, "test")
	a == 1 and b == "test"


func test_from_function() -> Bool:
	(num, str) = make_pair()
	num == 42 and str == "hello"


func test_wildcard_first() -> Bool:
	(_, b) = (99, "keep")
	b == "keep"


func test_wildcard_second() -> Bool:
	(a, _) = (100, "ignore")
	a == 100


func test_nested_usage() -> Bool:
	(x, y) = (10, 20)
	x + y == 30


tests: TestSuite = {
	description = "Tuple Destructuring",
	tests = [
		("basic destructure", test_basic_destructure),
		("from function", test_from_function),
		("wildcard first", test_wildcard_first),
		("wildcard second", test_wildcard_second),
		("nested usage", test_nested_usage),
	],
}
