-- Test to_string for vectors and matrices
import:
	tensor: length, matrix
	test: TestSuite


func test_vector_to_string() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	s: String = v.to_string()
	-- Should contain the three values
	s.length() > 5


func test_matrix_to_string() -> Bool:
	m: Float[#2, #2] = {
		{1.0, 2.0},
		{3.0, 4.0},
	}
	s: String = m.to_string()
	-- Should contain nested braces for 2D format
	s.length() > 10


func test_int_vector_to_string() -> Bool:
	v: Int[#3] = {10, 20, 30}
	s: String = v.to_string()
	s.length() > 5


func test_int_matrix_to_string() -> Bool:
	m: Int[#2, #3] = matrix(0, 2, 3)
	s: String = m.to_string()
	-- 2D int matrix should have nested braces
	s.length() > 10


tests: TestSuite = {
	description = "Tensor to_string",
	tests = [
		("vector to_string", test_vector_to_string),
		("matrix to_string", test_matrix_to_string),
		("int vector to_string", test_int_vector_to_string),
		("int matrix to_string", test_int_matrix_to_string),
	],
}
