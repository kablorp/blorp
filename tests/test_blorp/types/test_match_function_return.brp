import:
	test: TestSuite


union Outcome:
	Parsed(String)
	Failed


func parse_like() -> Outcome:
	Parsed("ok")


func test_match_function_return_with_wildcard() -> Bool:
	match parse_like():
		Parsed(value): value == "ok"
		_: False


tests: TestSuite = {
	description = "Match on function return",
	tests = [
		(
			"constructor arm beats wildcard for function return",
			test_match_function_return_with_wildcard,
		),
	]
}
