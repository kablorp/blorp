import:
	test: TestSuite


new type UserId = String

new type Box[T] = T


pure func user_id_length(id: UserId) -> Int:
	id
		.value()
		.length()


func test_new_type_construct_and_unwrap() -> Bool:
	id: UserId = UserId("abc")
	user_id_length(id) == 3


func test_generic_new_type_construct_and_unwrap() -> Bool:
	boxed: Box[Int] = Box(42)
	boxed.value() == 42


tests: TestSuite = {
	description = "new type tests",
	tests = [
		("construct and unwrap", test_new_type_construct_and_unwrap),
		("generic construct and unwrap", test_generic_new_type_construct_and_unwrap),
	],
}
