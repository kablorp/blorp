import:
	result: Result(Ok, Err)
	test: TestSuite


pure func classify(x: Int) -> Result[Int, Bool]:
	if x > 0:
		Ok(x)
	else:
		Err(False)


pure func payload_or_zero(r: Result[Int, Bool]) -> Int:
	match r:
		Ok(v): v
		Err(_): 0


pure func classify_text(x: Int) -> Result[Int, String]:
	if x > 0:
		Ok(x)
	else:
		Err("bad")


pure func text_payload_or_empty(r: Result[Int, String]) -> String:
	match r:
		Ok(_): ""
		Err(msg): msg


func test_ok_payload() -> Bool:
	match classify(7):
		Ok(v): v == 7
		Err(_): False


func test_err_payload() -> Bool:
	match classify(0):
		Ok(_): False
		Err(flag): flag == False


func test_stack_result_argument() -> Bool:
	payload_or_zero(classify(9)) == 9 and payload_or_zero(classify(-1)) == 0


func test_managed_err_payload() -> Bool:
	text_payload_or_empty(classify_text(0)) == "bad"


func test_managed_ok_payload() -> Bool:
	match classify_text(4):
		Ok(v): v == 4
		Err(_): False


func call_result_callback(
	f: (Int) -> Result[String, String],
	n: Int,
) -> Result[String, String]:
	f(n)


func test_closure_result_return_ownership() -> Bool:
	f: (Int) -> Result[String, String] = func(n: Int) -> Result[String, String]:
		if n > 0:
			Ok("ok")
		else:
			Err("bad")
	match call_result_callback(f, 1):
		Ok(s): s == "ok"
		Err(_): False


tests: TestSuite = {
	description = "Stack Result",
	tests = [
		("ok payload", test_ok_payload),
		("err payload", test_err_payload),
		("argument passing", test_stack_result_argument),
		("managed err payload", test_managed_err_payload),
		("managed ok payload", test_managed_ok_payload),
		("closure result return ownership", test_closure_result_return_ownership),
	],
}
