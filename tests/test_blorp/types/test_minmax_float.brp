import:
	float: max, min
	int: max as int_max, min as int_min
	test: TestSuite


func test_min_float() -> Bool:
	min(3.0, 7.0) == 3.0


func test_max_float() -> Bool:
	max(3.0, 7.0) == 7.0


func test_min_float_fractional() -> Bool:
	min(0.2, 0.8) == 0.2


func test_max_float_fractional() -> Bool:
	max(0.2, 0.8) == 0.8


func test_min_float_negative() -> Bool:
	min(-1.5, 0.5) == -1.5


func test_max_float_negative() -> Bool:
	max(-1.5, 0.5) == 0.5


func test_min_int() -> Bool:
	int_min(3, 7) == 3


func test_max_int() -> Bool:
	int_max(3, 7) == 7


func test_nested_min_max() -> Bool:
	max(max(0.2, 0.5), 0.8) == 0.8


func test_nested_min() -> Bool:
	min(min(0.9, 0.5), 0.3) == 0.3


tests: TestSuite = {
	description = "Min/Max Float Type Dispatch",
	tests = [
		("min float", test_min_float),
		("max float", test_max_float),
		("min float fractional", test_min_float_fractional),
		("max float fractional", test_max_float_fractional),
		("min float negative", test_min_float_negative),
		("max float negative", test_max_float_negative),
		("min int", test_min_int),
		("max int", test_max_int),
		("nested min max", test_nested_min_max),
		("nested min", test_nested_min),
	]
}
