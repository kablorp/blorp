import:
	geometry: Vec2, Vec3, vec2, vec3
	test: TestSuite


-- Vec2 tests
func test_vec2_add() -> Bool:
	a: Vec2 = vec2(1.0, 2.0)
	b: Vec2 = vec2(3.0, 4.0)
	c: Vec2 = a + b
	c == vec2(4.0, 6.0)


func test_vec2_sub() -> Bool:
	a: Vec2 = vec2(5.0, 7.0)
	b: Vec2 = vec2(2.0, 3.0)
	c: Vec2 = a - b
	c == vec2(3.0, 4.0)


func test_vec2_mul() -> Bool:
	a: Vec2 = vec2(2.0, 3.0)
	b: Vec2 = vec2(4.0, 5.0)
	c: Vec2 = a * b
	c == vec2(8.0, 15.0)


func test_vec2_div() -> Bool:
	a: Vec2 = vec2(10.0, 6.0)
	b: Vec2 = vec2(2.0, 3.0)
	c: Vec2 = a / b
	c == vec2(5.0, 2.0)


func test_vec2_neg() -> Bool:
	a: Vec2 = vec2(3.0, -4.0)
	b: Vec2 = -a
	b == vec2(-3.0, 4.0)


-- Vec3 tests
func test_vec3_add() -> Bool:
	a: Vec3 = vec3(1.0, 2.0, 3.0)
	b: Vec3 = vec3(4.0, 5.0, 6.0)
	c: Vec3 = a + b
	c == vec3(5.0, 7.0, 9.0)


func test_vec3_sub() -> Bool:
	a: Vec3 = vec3(5.0, 7.0, 9.0)
	b: Vec3 = vec3(1.0, 2.0, 3.0)
	c: Vec3 = a - b
	c == vec3(4.0, 5.0, 6.0)


func test_vec3_mul() -> Bool:
	a: Vec3 = vec3(2.0, 3.0, 4.0)
	b: Vec3 = vec3(5.0, 6.0, 7.0)
	c: Vec3 = a * b
	c == vec3(10.0, 18.0, 28.0)


func test_vec3_div() -> Bool:
	a: Vec3 = vec3(10.0, 12.0, 14.0)
	b: Vec3 = vec3(2.0, 3.0, 7.0)
	c: Vec3 = a / b
	c == vec3(5.0, 4.0, 2.0)


func test_vec3_neg() -> Bool:
	a: Vec3 = vec3(1.0, -2.0, 3.0)
	b: Vec3 = -a
	b == vec3(-1.0, 2.0, -3.0)


tests: TestSuite = {
	description = "Vec2/Vec3 Operators",
	tests = [
		("Vec2 add", test_vec2_add),
		("Vec2 sub", test_vec2_sub),
		("Vec2 mul", test_vec2_mul),
		("Vec2 div", test_vec2_div),
		("Vec2 neg", test_vec2_neg),
		("Vec3 add", test_vec3_add),
		("Vec3 sub", test_vec3_sub),
		("Vec3 mul", test_vec3_mul),
		("Vec3 div", test_vec3_div),
		("Vec3 neg", test_vec3_neg),
	],
}
