-- Test primitive type pattern matching
import:
	test: TestSuite


-- Int pattern matching
func test_int_zero() -> Bool:
	match 0:
		0: True
		_: False


func test_int_one() -> Bool:
	match 1:
		0: False
		1: True
		_: False


func test_int_other() -> Bool:
	match 42:
		0: False
		1: False
		_: True


-- String pattern matching
func test_string_hello() -> Bool:
	match "hello":
		"hello": True
		"world": False
		_: False


func test_string_world() -> Bool:
	match "world":
		"hello": False
		"world": True
		_: False


func test_string_other() -> Bool:
	match "foo":
		"hello": False
		"world": False
		_: True


-- Char pattern matching
func test_char_a() -> Bool:
	match 'a':
		'a': True
		'b': False
		_: False


func test_char_other() -> Bool:
	match 'z':
		'a': False
		'b': False
		other: True


tests: TestSuite = {
	description = "Primitive Pattern Matching",
	tests = [
		("Int match 0", test_int_zero),
		("Int match 1", test_int_one),
		("Int match other", test_int_other),
		("String match hello", test_string_hello),
		("String match world", test_string_world),
		("String match other", test_string_other),
		("Char match a", test_char_a),
		("Char match other", test_char_other),
	],
}
