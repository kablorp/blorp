import:
	list: get
	test: TestSuite


-- Helper for Result tests
func make_ok(x: Int) -> Result[Int, String]:
	Ok(x)


func make_err(msg: String) -> Result[Int, String]:
	Err(msg)


-- Option tests
func test_option_all_succeed() -> Bool:
	xs: List[Int] = [10, 20, 30]
	result: Option[Int] = try:
		a ?= xs.get(0)
		b ?= xs.get(1)
		a + b
	result == Some(30)


func test_option_first_fails() -> Bool:
	xs: List[Int] = []
	result: Option[Int] = try:
		a ?= xs.get(0)
		b ?= xs.get(1)
		a + b
	result == None


func test_option_second_fails() -> Bool:
	xs: List[Int] = [10]
	result: Option[Int] = try:
		a ?= xs.get(0)
		b ?= xs.get(1)
		a + b
	result == None


func test_option_typed_binding() -> Bool:
	xs: List[Int] = [42]
	result: Option[Int] = try:
		a: Int ?= xs.get(0)
		a * 2
	result == Some(84)


func test_option_plain_computation() -> Bool:
	xs: List[Int] = [5, 10]
	result: Option[Int] = try:
		a ?= xs.get(0)
		c: Int = a * 3
		b ?= xs.get(1)
		c + b
	result == Some(25)


func test_option_no_bindings() -> Bool:
	result: Option[Int] = try:
		42
	result == Some(42)


func test_option_float() -> Bool:
	xs: List[Float] = [1.5, 2.5]
	result: Option[Float] = try:
		a ?= xs.get(0)
		b ?= xs.get(1)
		a + b
	match result:
		Some(x): x == 4.0
		None: False


func test_option_string() -> Bool:
	xs: List[String] = ["hello", " world"]
	result: Option[String] = try:
		a ?= xs.get(0)
		b ?= xs.get(1)
		a + b
	result == Some("hello world")


func test_option_bool() -> Bool:
	xs: List[Bool] = [True]
	result: Option[Bool] = try:
		a ?= xs.get(0)
		a
	match result:
		Some(v): v == True
		None: False


-- Result tests
func test_result_all_succeed() -> Bool:
	result: Result[Int, String] = try:
		a ?= make_ok(10)
		b ?= make_ok(20)
		a + b
	match result:
		Ok(x): x == 30
		Err(_): False


func test_result_first_fails() -> Bool:
	result: Result[Int, String] = try:
		a ?= make_err("oops")
		b ?= make_ok(20)
		a + b
	match result:
		Ok(_): False
		Err(e): e == "oops"


func test_result_propagates_err() -> Bool:
	result: Result[Int, String] = try:
		a ?= make_ok(10)
		b ?= make_err("second failed")
		a + b
	match result:
		Ok(_): False
		Err(e): e == "second failed"


-- Try block as expression in different contexts
func test_try_in_var_decl() -> Bool:
	xs: List[Int] = [100]
	r: Option[Int] = try:
		x ?= xs.get(0)
		x + 1
	r == Some(101)


tests: TestSuite = {
	description = "try: Block Tests",
	tests = [
		("option all succeed", test_option_all_succeed),
		("option first fails", test_option_first_fails),
		("option second fails", test_option_second_fails),
		("option typed binding", test_option_typed_binding),
		("option plain computation", test_option_plain_computation),
		("option no bindings", test_option_no_bindings),
		("option float", test_option_float),
		("option string", test_option_string),
		("option bool", test_option_bool),
		("result all succeed", test_result_all_succeed),
		("result first fails", test_result_first_fails),
		("result propagates err", test_result_propagates_err),
		("try in var decl", test_try_in_var_decl),
	],
}
