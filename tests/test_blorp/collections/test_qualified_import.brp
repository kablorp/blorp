-- Test qualified imports: expressions and patterns
import:
	option as O
	test: TestSuite


-- Test 1: Qualified expression - O.Some(42)
func test_qualified_expr() -> Bool:
	x: Option[Int] = O.Some(42)

	match x:
		Some(v):
			v == 42
		None:
			False


-- Test 2: Qualified pattern - O.Some(v) in match
func test_qualified_pattern() -> Bool:
	x: Option[Int] = Some(100)

	match x:
		O.Some(v):
			v == 100
		O.None:
			False


-- Test 3: Both qualified expression and pattern
func test_both_qualified() -> Bool:
	x: Option[Int] = O.Some(99)

	match x:
		O.Some(v):
			v == 99
		O.None:
			False


-- Test 4: Default alias - import std/option (no 'as' clause)
-- Note: Using O since we already imported with alias
func test_nullary_pattern() -> Bool:
	x: Option[Int] = O.None

	match x:
		O.Some(_):
			False
		O.None:
			True


tests: TestSuite = {
	description = "Qualified Import Tests",
	tests = [
		("qualified expression O.Some()", test_qualified_expr),
		("qualified pattern O.Some(v)", test_qualified_pattern),
		("both qualified expr and pattern", test_both_qualified),
		("nullary qualified pattern O.None", test_nullary_pattern),
	]
}
