import:
	deque as Deque
	heap as H: Heap
	list as L
	sorted_map as SM: SortedMap
	test: TestSuite


-- Test generic collections with non-Int types
-- ============================================================================
-- Heap with String
-- ============================================================================
func test_heap_string_push_peek() -> Bool:
	var h: Heap[String] = H.heap()
	h = H.push(h, "cherry")
	h = H.push(h, "apple")
	h = H.push(h, "banana")
	match H.peek(h):
		Some(v): v == "apple"
		None: False


func test_heap_string_pop_order() -> Bool:
	var h: Heap[String] = H.heap()
	h = H.push(h, "cherry")
	h = H.push(h, "apple")
	h = H.push(h, "banana")
	match H.pop(h):
		Some(p1):
			p1[0] == "apple" and match H.pop(p1[1]):
				Some(p2): p2[0] == "banana"
				None: False
		None: False


func test_heap_string_from_list() -> Bool:
	h: Heap[String] = H.from_list([
		"delta",
		"alpha",
		"charlie",
		"bravo"
	])
	match H.peek(h):
		Some(v): v == "alpha"
		None: False


func test_heap_string_to_sorted() -> Bool:
	h: Heap[String] = H.from_list(["cherry", "apple", "banana"])
	sorted: List[String] = H.to_sorted(h)
	match L.get(sorted, 0):
		Some(v0):
			match L.get(sorted, 1):
				Some(v1):
					match L.get(sorted, 2):
						Some(v2): v0 == "apple" and v1 == "banana" and v2 == "cherry"
						None: False
				None: False
		None: False


-- ============================================================================
-- Deque with String
-- ============================================================================
func test_deque_string_push_pop() -> Bool:
	var d: (List[String], List[String]) = Deque.deque()
	d = Deque.push_front(d, "hello")
	d = Deque.push_back(d, "world")
	match Deque.pop_front(d):
		Some(pair): pair[0] == "hello"
		None: False


func test_deque_string_fifo() -> Bool:
	var d: (List[String], List[String]) = Deque.deque()
	d = Deque.push_back(d, "first")
	d = Deque.push_back(d, "second")
	d = Deque.push_back(d, "third")
	match Deque.pop_front(d):
		Some(pair): pair[0] == "first"
		None: False


func test_deque_string_to_list() -> Bool:
	var d: (List[String], List[String]) = Deque.deque()
	d = Deque.push_back(d, "a")
	d = Deque.push_back(d, "b")
	d = Deque.push_back(d, "c")
	lst: List[String] = Deque.to_list(d)
	lst.length() == 3 and match L.get(lst, 0):
		Some(v): v == "a"
		None: False


func test_deque_string_peek() -> Bool:
	var d: (List[String], List[String]) = Deque.deque()
	d = Deque.push_front(d, "front")
	d = Deque.push_back(d, "back")
	match Deque.peek_front(d):
		Some(f):
			match Deque.peek_back(d):
				Some(b): f == "front" and b == "back"
				None: False
		None: False


-- ============================================================================
-- SortedMap with String keys
-- ============================================================================
func test_sorted_map_string_keys() -> Bool:
	var m: SortedMap[String, Int] = SM.sorted_map()
	m = SM.set(m, "charlie", 3)
	m = SM.set(m, "alpha", 1)
	m = SM.set(m, "bravo", 2)
	SM.map_length(m) == 3


func test_sorted_map_string_lookup() -> Bool:
	var m: SortedMap[String, Int] = SM.sorted_map()
	m = SM.set(m, "x", 10)
	m = SM.set(m, "y", 20)
	match SM.get(m, "x"):
		Some(v): v == 10
		None: False


func test_sorted_map_string_sorted_order() -> Bool:
	var m: SortedMap[String, Int] = SM.sorted_map()
	m = SM.set(m, "cherry", 3)
	m = SM.set(m, "apple", 1)
	m = SM.set(m, "banana", 2)
	keys: List[String] = SM.keys(m)
	match L.get(keys, 0):
		Some(k0):
			match L.get(keys, 1):
				Some(k1):
					match L.get(keys, 2):
						Some(k2): k0 == "apple" and k1 == "banana" and k2 == "cherry"
						None: False
				None: False
		None: False


func test_sorted_map_string_delete() -> Bool:
	var m: SortedMap[String, Int] = SM.sorted_map()
	m = SM.set(m, "a", 1)
	m = SM.set(m, "b", 2)
	m = SM.remove(m, "a")
	SM.map_length(m) == 1 and not SM.has_key(m, "a")


func test_sorted_map_string_min_max() -> Bool:
	var m: SortedMap[String, Int] = SM.sorted_map()
	m = SM.set(m, "zebra", 3)
	m = SM.set(m, "alpha", 1)
	m = SM.set(m, "mid", 2)
	match SM.min(m):
		Some(min_pair):
			match SM.max(m):
				Some(max_pair): min_pair[0] == "alpha" and max_pair[0] == "zebra"
				None: False
		None: False


func test_sorted_map_string_range() -> Bool:
	var m: SortedMap[String, Int] = SM.sorted_map()
	m = SM.set(m, "a", 1)
	m = SM.set(m, "b", 2)
	m = SM.set(m, "c", 3)
	m = SM.set(m, "d", 4)
	r: List[(String, Int)] = SM.range(m, "b", "c")
	r.length() == 2


tests: TestSuite = {
	description = "Generic Collections",
	tests = [
		("heap string push/peek", test_heap_string_push_peek),
		("heap string pop order", test_heap_string_pop_order),
		("heap string from_list", test_heap_string_from_list),
		("heap string to_sorted", test_heap_string_to_sorted),
		("deque string push/pop", test_deque_string_push_pop),
		("deque string fifo", test_deque_string_fifo),
		("deque string to_list", test_deque_string_to_list),
		("deque string peek", test_deque_string_peek),
		("sorted_map string keys", test_sorted_map_string_keys),
		("sorted_map string lookup", test_sorted_map_string_lookup),
		("sorted_map string sorted order", test_sorted_map_string_sorted_order),
		("sorted_map string delete", test_sorted_map_string_delete),
		("sorted_map string min/max", test_sorted_map_string_min_max),
		("sorted_map string range", test_sorted_map_string_range),
	]
}
