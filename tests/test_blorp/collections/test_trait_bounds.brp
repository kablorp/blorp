-- Phase 4.1: Verify generic module functions work through monomorphization
import:
	list: sort
	test: TestSuite


func test_sort_int() -> Bool:
	sort([3, 1, 2]) == [1, 2, 3]


func test_sort_string() -> Bool:
	sort(["c", "a", "b"]) == ["a", "b", "c"]


tests: TestSuite = {
	description = "Generic Module Functions",
	tests = [("sort Int", test_sort_int), ("sort String", test_sort_string)],
}
