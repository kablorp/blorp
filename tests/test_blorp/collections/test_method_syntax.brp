import:
	test: TestSuite


-- Test UFCS method call syntax: obj.func() rewrites to func(obj)
func test_list_length_method() -> Bool:
	nums: List[Int] = [1, 2, 3, 4, 5]
	nums.length() == 5


func test_empty_list_length_method() -> Bool:
	empty: List[String] = []
	empty.length() == 0


func test_string_length_method() -> Bool:
	s: String = "hello"
	s.length() == 5


tests: TestSuite = {
	description = "Method Syntax (UFCS)",
	tests = [
		("list length method", test_list_length_method),
		("empty list length method", test_empty_list_length_method),
		("string length method", test_string_length_method),
	],
}
