-- Test unified `get` for element access across collection types
-- Validates that the P0 rename (get_index -> get, get_char -> get) works correctly
import:
	list: get
	slice as Slice
	string as Str
	test: TestSuite


-- ============================================================================
-- List.get (Prelude builtin)
-- ============================================================================
pure func test_list_get_in_bounds() -> Bool:
	items: List[Int] = [10, 20, 30]
	match get(items, 1):
		Some(v): v == 20
		None: False


pure func test_list_get_out_of_bounds() -> Bool:
	items: List[Int] = [10, 20, 30]
	match get(items, 5):
		Some(_): False
		None: True


pure func test_list_get_negative_index() -> Bool:
	items: List[Int] = [10, 20, 30]
	match get(items, -1):
		Some(_): False
		None: True


pure func test_list_get_empty() -> Bool:
	items: List[Int] = []
	match get(items, 0):
		Some(_): False
		None: True


-- ============================================================================
-- String.get (module builtin)
-- ============================================================================
pure func test_string_get_in_bounds() -> Bool:
	s: String = "hello"
	match Str.get(s, 1):
		Some(c): c == 'e'
		None: False


pure func test_string_get_out_of_bounds() -> Bool:
	s: String = "hello"
	match Str.get(s, 10):
		Some(_): False
		None: True


-- ============================================================================
-- StringSlice.get
-- ============================================================================
pure func test_slice_get_in_bounds() -> Bool:
	slice: StringSlice = Slice.from_string("world")
	match Slice.get(slice, 0):
		Some(c): c == 'w'
		None: False


pure func test_slice_get_out_of_bounds() -> Bool:
	slice: StringSlice = Slice.from_string("hi")
	match Slice.get(slice, 5):
		Some(_): False
		None: True


tests: TestSuite = {
	description = "Collection get Tests",
	tests = [
		("list get in bounds", test_list_get_in_bounds),
		("list get out of bounds", test_list_get_out_of_bounds),
		("list get negative index", test_list_get_negative_index),
		("list get empty list", test_list_get_empty),
		("string get in bounds", test_string_get_in_bounds),
		("string get out of bounds", test_string_get_out_of_bounds),
		("slice get in bounds", test_slice_get_in_bounds),
		("slice get out of bounds", test_slice_get_out_of_bounds),
	],
}
