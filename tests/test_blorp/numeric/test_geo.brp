import:
	std/float: approx_eq
	std/option: Option(Some, None)
	std/test: TestSuite
	geographic:
		BBox,
		Coord,
		LineString,
		Polygon,
		Projected,
		bbox,
		bbox_contains,
		bbox_overlaps,
		bearing,
		bounds,
		coord,
		destination,
		from_mercator,
		haversine,
		line_length,
		line_string,
		midpoint,
		point_in_polygon,
		polygon,
		polygon_area,
		polygon_centroid,
		polygon_perimeter,
		polygon_with_holes,
		to_mercator,


-- ============================================================================
-- Distance tests
-- ============================================================================
pure func test_haversine_nyc_london() -> Bool:
	nyc: Coord = coord(-74.006, 40.7128)
	london: Coord = coord(-0.1276, 51.5074)
	d: Float = haversine(nyc, london)

	-- ~5570 km
	d > 5500000.0 and d < 5600000.0


pure func test_haversine_same_point() -> Bool:
	p: Coord = coord(10.0, 20.0)
	approx_eq(haversine(p, p), 0.0)


pure func test_haversine_antipodal() -> Bool:
	-- North pole to south pole = half circumference ~ 20015 km
	a: Coord = coord(0.0, 90.0)
	b: Coord = coord(0.0, -90.0)
	d: Float = haversine(a, b)
	d > 20000000.0 and d < 20100000.0


pure func test_bearing_east() -> Bool:
	a: Coord = coord(0.0, 0.0)
	b: Coord = coord(1.0, 0.0)
	br: Float = bearing(a, b)
	br > 89.0 and br < 91.0


pure func test_bearing_north() -> Bool:
	a: Coord = coord(0.0, 0.0)
	b: Coord = coord(0.0, 1.0)
	br: Float = bearing(a, b)
	br < 1.0 or br > 359.0


pure func test_bearing_south() -> Bool:
	a: Coord = coord(0.0, 1.0)
	b: Coord = coord(0.0, 0.0)
	br: Float = bearing(a, b)
	br > 179.0 and br < 181.0


pure func test_destination_north() -> Bool:
	start: Coord = coord(0.0, 0.0)
	dest: Coord = destination(start, 0.0, 1000000.0)

	-- ~9 degrees north
	dest.lat > 8.0 and dest.lat < 10.0 and approx_eq(dest.lon, 0.0)


pure func test_destination_roundtrip() -> Bool:
	start: Coord = coord(-74.006, 40.7128)
	br: Float = 45.0
	dist: Float = 100000.0
	dest: Coord = destination(start, br, dist)

	-- Distance back should be ~100km
	d: Float = haversine(start, dest)
	d > 99000.0 and d < 101000.0


pure func test_destination_zero_distance() -> Bool:
	-- Zero distance should return approximately the same point
	start: Coord = coord(10.0, 20.0)
	dest: Coord = destination(start, 45.0, 0.0)
	approx_eq(dest.lon, start.lon) and approx_eq(dest.lat, start.lat)


pure func test_midpoint_equator() -> Bool:
	a: Coord = coord(0.0, 0.0)
	b: Coord = coord(2.0, 0.0)
	m: Coord = midpoint(a, b)
	approx_eq(m.lon, 1.0) and approx_eq(m.lat, 0.0)


pure func test_midpoint_meridian() -> Bool:
	a: Coord = coord(0.0, 10.0)
	b: Coord = coord(0.0, 20.0)
	m: Coord = midpoint(a, b)
	approx_eq(m.lon, 0.0) and m.lat > 14.9 and m.lat < 15.1


-- ============================================================================
-- Spatial predicate tests
-- ============================================================================
pure func test_bbox_contains_inside() -> Bool:
	bb: BBox = bbox(-74.1, 40.6, -73.9, 40.8)
	bbox_contains(bb, coord(-74.0, 40.7))


pure func test_bbox_contains_outside() -> Bool:
	bb: BBox = bbox(-74.1, 40.6, -73.9, 40.8)
	not bbox_contains(bb, coord(-75.0, 40.7))


pure func test_bbox_overlaps_yes() -> Bool:
	a: BBox = bbox(0.0, 0.0, 2.0, 2.0)
	b: BBox = bbox(1.0, 1.0, 3.0, 3.0)
	bbox_overlaps(a, b)


pure func test_bbox_overlaps_no() -> Bool:
	a: BBox = bbox(0.0, 0.0, 1.0, 1.0)
	b: BBox = bbox(2.0, 2.0, 3.0, 3.0)
	not bbox_overlaps(a, b)


pure func test_point_in_polygon_inside() -> Bool:
	sq: Polygon = polygon([
		coord(0.0, 0.0),
		coord(10.0, 0.0),
		coord(10.0, 10.0),
		coord(0.0, 10.0),
		coord(0.0, 0.0)
	])
	point_in_polygon(coord(5.0, 5.0), sq)


pure func test_point_in_polygon_outside() -> Bool:
	sq: Polygon = polygon([
		coord(0.0, 0.0),
		coord(10.0, 0.0),
		coord(10.0, 10.0),
		coord(0.0, 10.0),
		coord(0.0, 0.0)
	])
	not point_in_polygon(coord(15.0, 5.0), sq)


pure func test_point_in_polygon_with_hole() -> Bool:
	exterior: List[Coord] = [
		coord(0.0, 0.0),
		coord(20.0, 0.0),
		coord(20.0, 20.0),
		coord(0.0, 20.0),
		coord(0.0, 0.0),
	]
	hole: List[Coord] = [
		coord(5.0, 5.0),
		coord(15.0, 5.0),
		coord(15.0, 15.0),
		coord(5.0, 15.0),
		coord(5.0, 5.0),
	]
	poly: Polygon = polygon_with_holes(exterior, [hole])

	-- Point in the hole should be outside
	not point_in_polygon(coord(10.0, 10.0), poly) and point_in_polygon(coord(2.0, 2.0), poly)


-- Point in exterior but not in hole should be inside
-- ============================================================================
-- Measurement tests
-- ============================================================================
pure func test_bounds_basic() -> Bool:
	cs: List[Coord] = [coord(1.0, 2.0), coord(3.0, 4.0), coord(0.0, 1.0)]
	match bounds(cs):
		Some(bb):
			approx_eq(
				bb.min_lon,
				0.0,
			) and approx_eq(
				bb.min_lat,
				1.0,
			) and approx_eq(bb.max_lon, 3.0) and approx_eq(bb.max_lat, 4.0)
		None: False


pure func test_bounds_empty() -> Bool:
	cs: List[Coord] = []
	match bounds(cs):
		Some(_): False
		None: True


pure func test_line_length_equator() -> Bool:
	ls: LineString = line_string([coord(0.0, 0.0), coord(1.0, 0.0)])
	d: Float = line_length(ls)

	-- 1 degree at equator ~ 111.2 km
	d > 111000.0 and d < 112000.0


pure func test_line_length_multi_segment() -> Bool:
	ls: LineString = line_string([coord(0.0, 0.0), coord(1.0, 0.0), coord(2.0, 0.0)])
	d: Float = line_length(ls)

	-- 2 degrees at equator ~ 222.4 km
	d > 222000.0 and d < 224000.0


pure func test_line_length_single_point() -> Bool:
	-- Single point line has zero length
	ls: LineString = line_string([coord(5.0, 10.0)])
	line_length(ls) == 0.0


pure func test_polygon_perimeter() -> Bool:
	sq: Polygon = polygon([
		coord(0.0, 0.0),
		coord(1.0, 0.0),
		coord(1.0, 1.0),
		coord(0.0, 1.0),
		coord(0.0, 0.0)
	])
	p: Float = polygon_perimeter(sq)

	-- Perimeter of a ~111km square > 400km
	p > 400000.0


pure func test_polygon_area_positive() -> Bool:
	sq: Polygon = polygon([
		coord(0.0, 0.0),
		coord(1.0, 0.0),
		coord(1.0, 1.0),
		coord(0.0, 1.0),
		coord(0.0, 0.0)
	])
	a: Float = polygon_area(sq)

	-- ~12,300 km^2 (1 degree square at equator)
	a > 10000000000.0


pure func test_polygon_area_with_hole() -> Bool:
	-- Area with hole should be less than area without
	exterior: List[Coord] = [
		coord(0.0, 0.0),
		coord(2.0, 0.0),
		coord(2.0, 2.0),
		coord(0.0, 2.0),
		coord(0.0, 0.0),
	]
	hole: List[Coord] = [
		coord(0.5, 0.5),
		coord(1.5, 0.5),
		coord(1.5, 1.5),
		coord(0.5, 1.5),
		coord(0.5, 0.5),
	]
	poly_no_hole: Polygon = polygon(exterior)
	poly_with_hole: Polygon = polygon_with_holes(exterior, [hole])
	area_full: Float = polygon_area(poly_no_hole)
	area_holed: Float = polygon_area(poly_with_hole)
	area_holed > 0.0 and area_holed < area_full


pure func test_polygon_centroid() -> Bool:
	sq: Polygon = polygon([
		coord(0.0, 0.0),
		coord(2.0, 0.0),
		coord(2.0, 2.0),
		coord(0.0, 2.0),
		coord(0.0, 0.0)
	])
	c: Coord = polygon_centroid(sq)
	approx_eq(c.lon, 1.0) and approx_eq(c.lat, 1.0)


-- ============================================================================
-- Projection tests
-- ============================================================================
pure func test_mercator_origin() -> Bool:
	p: Projected = to_mercator(coord(0.0, 0.0))
	approx_eq(p.x, 0.0) and approx_eq(p.y, 0.0)


pure func test_mercator_roundtrip() -> Bool:
	orig: Coord = coord(-74.006, 40.7128)
	rt: Coord = from_mercator(to_mercator(orig))
	approx_eq(rt.lon, orig.lon) and approx_eq(rt.lat, orig.lat)


pure func test_mercator_symmetry() -> Bool:
	-- Equal and opposite longitudes should give equal and opposite x
	a: Projected = to_mercator(coord(10.0, 0.0))
	b: Projected = to_mercator(coord(-10.0, 0.0))
	approx_eq(a.x, -b.x)


pure func test_mercator_pole_clamped() -> Bool:
	-- Latitude at poles should be clamped (no infinity/NaN)
	p: Projected = to_mercator(coord(0.0, 90.0))

	-- Should produce a finite y value (clamped at 85.06)
	p.y > 0.0 and p.y < 30000000.0


pure func test_mercator_south_pole_clamped() -> Bool:
	p: Projected = to_mercator(coord(0.0, -90.0))
	p.y < 0.0 and p.y > -30000000.0


-- ============================================================================
-- Test suite
-- ============================================================================
tests: TestSuite = {
	description = "Geo Module",
	tests = [
		("haversine NYC-London", test_haversine_nyc_london),
		("haversine same point", test_haversine_same_point),
		("haversine antipodal", test_haversine_antipodal),
		("bearing east", test_bearing_east),
		("bearing north", test_bearing_north),
		("bearing south", test_bearing_south),
		("destination north", test_destination_north),
		("destination roundtrip", test_destination_roundtrip),
		("destination zero distance", test_destination_zero_distance),
		("midpoint equator", test_midpoint_equator),
		("midpoint meridian", test_midpoint_meridian),
		("bbox contains inside", test_bbox_contains_inside),
		("bbox contains outside", test_bbox_contains_outside),
		("bbox overlaps yes", test_bbox_overlaps_yes),
		("bbox overlaps no", test_bbox_overlaps_no),
		("point in polygon inside", test_point_in_polygon_inside),
		("point in polygon outside", test_point_in_polygon_outside),
		("point in polygon with hole", test_point_in_polygon_with_hole),
		("bounds basic", test_bounds_basic),
		("bounds empty", test_bounds_empty),
		("line length equator", test_line_length_equator),
		("line length multi segment", test_line_length_multi_segment),
		("line length single point", test_line_length_single_point),
		("polygon perimeter", test_polygon_perimeter),
		("polygon area positive", test_polygon_area_positive),
		("polygon area with hole", test_polygon_area_with_hole),
		("polygon centroid", test_polygon_centroid),
		("mercator origin", test_mercator_origin),
		("mercator roundtrip", test_mercator_roundtrip),
		("mercator symmetry", test_mercator_symmetry),
		("mercator pole clamped", test_mercator_pole_clamped),
		("mercator south pole clamped", test_mercator_south_pole_clamped),
	]
}
