-- Test vector reduction and numeric operations
import:
	test: TestSuite
	traits: Equatable, Orderable
	vector: argmax, argmin, dot, max, mean, min, norm, product, sum


record Ranked {
	score: Int
}


implements Equatable for Ranked:
	pure func equals(a: Ranked, b: Ranked) -> Bool:
		a.score == b.score


implements Orderable for Ranked:
	pure func less_than(a: Ranked, b: Ranked) -> Bool:
		a.score < b.score


-- ============================================================================
-- max / min (type-dispatched generic)
-- ============================================================================
func test_max_int() -> Bool:
	v: Int[#5] = {3, 1, 4, 1, 5}
	max(v) == 5


func test_min_int() -> Bool:
	v: Int[#5] = {3, 1, 4, 1, 5}
	min(v) == 1


func test_max_float() -> Bool:
	v: Float[#4] = {1.5, 3.7, 2.1, 0.8}
	max(v) == 3.7


func test_min_float() -> Bool:
	v: Float[#4] = {1.5, 3.7, 2.1, 0.8}
	min(v) == 0.8


func test_arg_indices_orderable_without_zero() -> Bool:
	v: Ranked[#3] = {{score = 2}, {score = 9}, {score = 1}}
	argmax(v) == 1 and argmin(v) == 2


-- ============================================================================
-- mean (type-dispatched generic)
-- ============================================================================
func test_mean_int() -> Bool:
	v: Int[#4] = {2, 4, 6, 8}
	mean(v) == 5.0


func test_mean_float() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	mean(v) == 2.5


func test_single_element() -> Bool:
	vi: Int[#1] = {42}
	vf: Float[#1] = {3.14}
	max(vi) == 42 and min(vi) == 42 and max(vf) == 3.14 and min(vf) == 3.14


func test_mean_large_ints() -> Bool:
	v: Int[#4] = {4000000000, 4000000000, 4000000000, 4000000000}
	mean(v) == 4000000000.0


-- ============================================================================
-- sum
-- ============================================================================
func test_sum_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	sum(v) == 6.0


-- ============================================================================
-- product
-- ============================================================================
func test_product_int() -> Bool:
	v: Int[#3] = {2, 3, 5}
	product(v) == 30


func test_product_float() -> Bool:
	v: Float[#3] = {2.0, 3.0, 5.0}
	product(v) == 30.0


-- ============================================================================
-- dot product
-- ============================================================================
func test_dot_int() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	dot(a, b) == 32


func test_dot_float() -> Bool:
	a: Float[#2] = {1.0, 2.0}
	b: Float[#2] = {3.0, 4.0}
	dot(a, b) == 11.0


-- ============================================================================
-- norm (Euclidean L2)
-- ============================================================================
func test_norm() -> Bool:
	v: Float[#2] = {3.0, 4.0}
	norm(v) == 5.0


-- ============================================================================
-- scale: v * scalar (operator syntax)
-- ============================================================================
func test_scale_int() -> Bool:
	v: Int[#3] = {1, 2, 3}
	r: Int[#3] = v * 10
	r[0] == 10 and r[1] == 20 and r[2] == 30


func test_scale_float() -> Bool:
	v: Float[#2] = {1.0, 2.0}
	r: Float[#2] = v * 2.5
	r[0] == 2.5 and r[1] == 5.0


-- ============================================================================
-- add: element-wise addition (operator syntax)
-- ============================================================================
func test_vadd_int() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	r: Int[#3] = a + b
	r[0] == 5 and r[1] == 7 and r[2] == 9


func test_vadd_float() -> Bool:
	a: Float[#2] = {1.0, 2.0}
	b: Float[#2] = {3.0, 4.0}
	r: Float[#2] = a + b
	r[0] == 4.0 and r[1] == 6.0


-- ============================================================================
-- Single-element vector edge cases
-- ============================================================================
func test_single_sum() -> Bool:
	vi: Int[#1] = {42}
	sum(vi) == 42


func test_single_mean() -> Bool:
	vi: Int[#1] = {42}
	mean(vi) == 42.0


tests: TestSuite = {
	description = "Vector Reductions",
	tests = [
		("max int", test_max_int),
		("min int", test_min_int),
		("max float", test_max_float),
		("min float", test_min_float),
		("arg indices orderable without zero", test_arg_indices_orderable_without_zero),
		("mean int", test_mean_int),
		("mean float", test_mean_float),
		("single element", test_single_element),
		("mean large ints", test_mean_large_ints),
		("sum float", test_sum_float),
		("product int", test_product_int),
		("product float", test_product_float),
		("dot int", test_dot_int),
		("dot float", test_dot_float),
		("norm", test_norm),
		("scale int", test_scale_int),
		("scale float", test_scale_float),
		("vadd int", test_vadd_int),
		("vadd float", test_vadd_float),
		("single sum", test_single_sum),
		("single mean", test_single_mean),
	]
}
