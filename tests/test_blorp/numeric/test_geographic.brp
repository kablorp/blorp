import:
	float: abs, approx_eq
	geographic:
		BBox,
		Coord,
		LineString,
		Polygon,
		bbox,
		bbox_contains,
		bbox_overlaps,
		bearing,
		bounds,
		coord,
		destination,
		from_mercator,
		haversine,
		line_length,
		line_string,
		midpoint,
		point_in_polygon,
		polygon,
		polygon_area,
		polygon_perimeter,
		to_mercator,
	test: TestSuite


-- Haversine distance between London and Paris (~343 km)
func test_haversine() -> Bool:
	london: Coord = coord(-0.1278, 51.5074)
	paris: Coord = coord(2.3522, 48.8566)
	d: Float = haversine(london, paris)
	d > 340000.0 and d < 350000.0


-- Distance from a point to itself is 0
func test_haversine_same_point() -> Bool:
	p: Coord = coord(10.0, 20.0)
	haversine(p, p) == 0.0


-- Bearing from equator/prime meridian going east is ~90 degrees
func test_bearing_east() -> Bool:
	a: Coord = coord(0.0, 0.0)
	b: Coord = coord(1.0, 0.0)
	b_deg: Float = bearing(a, b)
	abs(b_deg - 90.0) < 1.0


-- Midpoint of two points on the equator
func test_midpoint() -> Bool:
	a: Coord = coord(0.0, 0.0)
	b: Coord = coord(2.0, 0.0)
	m: Coord = midpoint(a, b)
	approx_eq(m.lon, 1.0) and approx_eq(m.lat, 0.0)


-- Destination: go north 111km from equator ≈ 1 degree latitude
func test_destination() -> Bool:
	start: Coord = coord(0.0, 0.0)
	dest: Coord = destination(start, 0.0, 111000.0)
	abs(dest.lat - 1.0) < 0.1


-- BBox contains
func test_bbox_contains() -> Bool:
	bb: BBox = bbox(-10.0, -10.0, 10.0, 10.0)
	bbox_contains(bb, coord(0.0, 0.0)) and not bbox_contains(bb, coord(20.0, 0.0))


-- BBox overlaps
func test_bbox_overlaps() -> Bool:
	a: BBox = bbox(0.0, 0.0, 10.0, 10.0)
	b: BBox = bbox(5.0, 5.0, 15.0, 15.0)
	c: BBox = bbox(20.0, 20.0, 30.0, 30.0)
	bbox_overlaps(a, b) and not bbox_overlaps(a, c)


-- Bounds of a set of coordinates
func test_bounds() -> Bool:
	coords: List[Coord] = [coord(1.0, 2.0), coord(3.0, 4.0), coord(0.0, 1.0)]
	match bounds(coords):
		Some(bb): approx_eq(bb.min_lon, 0.0) and approx_eq(bb.max_lat, 4.0)
		None: False


-- Point in polygon (unit square)
func test_point_in_polygon() -> Bool:
	sq: Polygon = polygon([
		coord(0.0, 0.0),
		coord(1.0, 0.0),
		coord(1.0, 1.0),
		coord(0.0, 1.0)
	])
	point_in_polygon(coord(0.5, 0.5), sq) and not point_in_polygon(coord(2.0, 2.0), sq)


-- Line length
func test_line_length() -> Bool:
	ls: LineString = line_string([coord(0.0, 0.0), coord(1.0, 0.0)])
	l: Float = line_length(ls)
	l > 100000.0 -- ~111 km along equator


-- Polygon area (small square at equator, ~1 degree side ≈ 12,300 km²)
func test_polygon_area() -> Bool:
	sq: Polygon = polygon([
		coord(0.0, 0.0),
		coord(1.0, 0.0),
		coord(1.0, 1.0),
		coord(0.0, 1.0)
	])
	a: Float = polygon_area(sq)
	a > 10000000000.0 and a < 20000000000.0


-- Polygon perimeter
func test_polygon_perimeter() -> Bool:
	sq: Polygon = polygon([
		coord(0.0, 0.0),
		coord(1.0, 0.0),
		coord(1.0, 1.0),
		coord(0.0, 1.0)
	])
	p: Float = polygon_perimeter(sq)
	p > 300000.0 -- ~333 km (3 edges of ~111 km)


-- Mercator round-trip
func test_mercator_roundtrip() -> Bool:
	c: Coord = coord(10.0, 45.0)
	rt: Coord = from_mercator(to_mercator(c))
	approx_eq(rt.lon, c.lon) and approx_eq(rt.lat, c.lat)


tests: TestSuite = {
	description = "Geographic Functions",
	tests = [
		("haversine london-paris", test_haversine),
		("haversine same point", test_haversine_same_point),
		("bearing east", test_bearing_east),
		("midpoint", test_midpoint),
		("destination north", test_destination),
		("bbox contains", test_bbox_contains),
		("bbox overlaps", test_bbox_overlaps),
		("bounds", test_bounds),
		("point in polygon", test_point_in_polygon),
		("line length", test_line_length),
		("polygon area", test_polygon_area),
		("polygon perimeter", test_polygon_perimeter),
		("mercator roundtrip", test_mercator_roundtrip),
	]
}
