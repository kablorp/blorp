-- Test that Float32 subscript assignment works with vector()
import:
	float: to_float32
	option: get_or
	tensor: get
	test: TestSuite


func test_float32_subscript_assign() -> Bool:
	-- vector(0.0, N) with Float32 annotation should create Float32 vector
	var v: Float32[#4] = vector(0.0, 4)
	v[0] = to_float32(1.5)
	v[1] = to_float32(2.5)
	val: Float32 = get_or(get(v, 0), to_float32(0.0))
	val == to_float32(1.5)


func test_float32_vector_multiple_assigns() -> Bool:
	-- Multiple subscript assigns on Float32 vector
	var v: Float32[#4] = vector(0.0, 4)
	v[0] = to_float32(10.0)
	v[1] = to_float32(20.0)
	v[2] = to_float32(30.0)

	-- Just check it compiles and runs without crashing
	True


tests: TestSuite = {
	description = "Float32 subscript assign",
	tests = [
		("float32 subscript assign", test_float32_subscript_assign),
		("float32 vector multiple assigns", test_float32_vector_multiple_assigns),
	]
}
