import:
	test: TestSuite


-- Test: 2D/3D tensor literal construction and subscript
func test_2d_construction() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	True


func test_2d_first_row() -> Bool:
	m: Int[#2, #3] = {
		{10, 20, 30},
		{40, 50, 60},
	}
	row: Int[#3] = m[0]
	row[0] == 10 and row[1] == 20 and row[2] == 30


func test_2d_second_row() -> Bool:
	m: Int[#2, #3] = {
		{10, 20, 30},
		{40, 50, 60},
	}
	row: Int[#3] = m[1]
	row[0] == 40 and row[1] == 50 and row[2] == 60


func test_2d_length() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	m.length() == 2


func test_2d_loop_rows() -> Bool:
	m: Int[#2, #3] = {
		{10, 20, 30},
		{40, 50, 60},
	}
	var sum: Int = 0
	for i in 0..length(m):
		row: Int[#3] = m[i]
		sum += row[0]
	sum == 50


func test_2d_float() -> Bool:
	m: Float[#2, #2] = {
		{1.5, 2.5},
		{3.5, 4.5},
	}
	row: Float[#2] = m[0]
	row[0] == 1.5 and row[1] == 2.5


func test_3d_construction() -> Bool:
	t: Int[#2, #2, #2] = {
		{
			{1, 2},
			{3, 4},
		},
		{
			{5, 6},
			{7, 8},
		},
	}
	plane: Int[#2, #2] = t[0]
	row: Int[#2] = plane[0]
	row[0] == 1 and row[1] == 2


func test_3d_second_plane() -> Bool:
	t: Int[#2, #2, #2] = {
		{
			{1, 2},
			{3, 4},
		},
		{
			{5, 6},
			{7, 8},
		},
	}
	plane: Int[#2, #2] = t[1]
	row: Int[#2] = plane[0]
	row[0] == 5 and row[1] == 6


tests: TestSuite = {
	description = "2D/3D Tensor Literals",
	tests = [
		("2D construction", test_2d_construction),
		("2D first row", test_2d_first_row),
		("2D second row", test_2d_second_row),
		("2D length", test_2d_length),
		("2D loop rows", test_2d_loop_rows),
		("2D float", test_2d_float),
		("3D construction", test_3d_construction),
		("3D second plane", test_3d_second_plane),
	],
}
