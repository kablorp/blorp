-- Test Float32 vector get_or and arithmetic operations
import:
	float: to_float32
	option: get_or
	tensor: get
	test: TestSuite


func test_float32_get_or() -> Bool:
	-- get_or on Float32 vector element should work
	var v: Float32[#4] = vector(0.0, 4)
	v[0] = to_float32(1.5)
	val: Float32 = get_or(get(v, 0), to_float32(0.0))
	val == to_float32(1.5)


func test_float32_get_or_default() -> Bool:
	-- get_or with out-of-bounds should return default
	var v: Float32[#4] = vector(0.0, 4)
	v[0] = to_float32(1.0)
	val: Float32 = get_or(get(v, 10), to_float32(99.0))
	val == to_float32(99.0)


func test_float32_vector_add() -> Bool:
	-- Float32 vector addition
	var a: Float32[#4] = vector(0.0, 4)
	var b: Float32[#4] = vector(0.0, 4)
	a[0] = to_float32(1.0)
	a[1] = to_float32(2.0)
	b[0] = to_float32(3.0)
	b[1] = to_float32(4.0)
	c: Float32[#4] = a + b
	get_or(get(c, 0), to_float32(0.0)) == to_float32(4.0)


func test_float32_vector_scalar_mul() -> Bool:
	-- Float32 vector * scalar
	var v: Float32[#4] = vector(0.0, 4)
	v[0] = to_float32(2.0)
	v[1] = to_float32(3.0)
	result: Float32[#4] = v * to_float32(2.0)
	get_or(get(result, 0), to_float32(0.0)) == to_float32(4.0)


tests: TestSuite = {
	description = "Float32 get_or and arithmetic",
	tests = [
		("float32 get_or", test_float32_get_or),
		("float32 get_or default", test_float32_get_or_default),
		("float32 vector add", test_float32_vector_add),
		("float32 vector scalar mul", test_float32_vector_scalar_mul),
	],
}
