-- enumerate inside windows: for (i, val) in enumerate(w) where w is a window view
import:
	tensor: enumerate, windows
	test: TestSuite


-- Basic: enumerate elements within each window
func test_enumerate_in_window() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	var sum: Int = 0
	for w in windows(v, 3):
		for (i, val) in enumerate(w):
			sum = sum + i + val
	-- 3 windows, each enumerated:
	-- w0=[10,20,30]: (0+10)+(1+20)+(2+30)=63
	-- w1=[20,30,40]: (0+20)+(1+30)+(2+40)=93
	-- w2=[30,40,50]: (0+30)+(1+40)+(2+50)=123
	sum == 279


-- Index within window is proven for subscript
func test_enumerate_window_subscript() -> Bool:
	v: Int[#4] = {1, 2, 3, 4}
	var ok: Bool = True
	for w in windows(v, 2):
		for (i, val) in enumerate(w):
			if w[i] != val:
				ok = False
	ok


tests: TestSuite = {
	description = "Enumerate in windows",
	tests = [
		("enumerate in window", test_enumerate_in_window),
		("enumerate window subscript", test_enumerate_window_subscript),
	],
}
