import:
	test: TestSuite


-- Test #13: to_string(v[i]) on float vectors preserves decimal
func test_to_string_float_subscript() -> Bool:
	v: Float[#2] = {3.5, 4.5}
	v[0].to_string() == "3.500000" or v[0].to_string() == "3.5"


func test_to_string_float_subscript_second() -> Bool:
	v: Float[#2] = {3.5, 4.5}
	s: String = v[1].to_string()
	s == "4.500000" or s == "4.5"


func test_to_string_via_var_still_works() -> Bool:
	v: Float[#2] = {3.5, 4.5}
	x: Float = v[0]
	x.to_string() == "3.500000" or x.to_string() == "3.5"


func test_string_interp_float_subscript() -> Bool:
	v: Float[#2] = {3.5, 4.5}
	s: String = "${v[0]}"
	s == "3.500000" or s == "3.5"


tests: TestSuite = {
	description = "Float subscript to_string",
	tests = [
		("to_string float subscript", test_to_string_float_subscript),
		("to_string float subscript second", test_to_string_float_subscript_second),
		("to_string via var still works", test_to_string_via_var_still_works),
		("string interp float subscript", test_string_interp_float_subscript),
	],
}
