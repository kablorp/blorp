-- Regression: scalar OP tensor (scalar on the LEFT) must dispatch to
-- the SIMD scalar/tensor runtime helpers. Pre-fix, only `tensor OP
-- scalar` was specialized; the reverse arrangement fell through to a
-- raw C `double * blorp_Vector*` and failed C compile.
--
-- Commutative ops (Add, Mul) swap to `tensor OP scalar`. Non-commutative
-- ops (Sub, Div, Mod) dispatch to the `_rev` runtime variant which
-- computes `scalar - vector_elem` etc., matching mathematical semantics.
import:
	test: TestSuite


-- Commutative: scalar * vector.
func test_scalar_mul_vector_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	r: Float[#3] = 2.0 * v
	r[0] == 2.0 and r[1] == 4.0 and r[2] == 6.0


-- Commutative: scalar + vector.
func test_scalar_add_vector_int() -> Bool:
	v: Int[#3] = {10, 20, 30}
	r: Int[#3] = 5 + v
	r[0] == 15 and r[1] == 25 and r[2] == 35


-- Non-commutative: scalar - vector. Each element becomes (scalar - v[i]).
func test_scalar_sub_vector_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	r: Float[#3] = 10.0 - v
	r[0] == 9.0 and r[1] == 8.0 and r[2] == 7.0


-- Non-commutative: scalar / vector.
func test_scalar_div_vector_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 4.0}
	r: Float[#3] = 8.0 / v
	r[0] == 8.0 and r[1] == 4.0 and r[2] == 2.0


-- Mixed in expression: vector + (scalar * vector).
func test_mixed_scalar_vector_chain() -> Bool:
	a: Float[#3] = {1.0, 2.0, 3.0}
	b: Float[#3] = {10.0, 20.0, 30.0}
	r: Float[#3] = a + 2.0 * b
	r[0] == 21.0 and r[1] == 42.0 and r[2] == 63.0


-- Non-commutative on Int — exercises blorp_vector_scalar_op_rev_int.
func test_scalar_sub_vector_int() -> Bool:
	v: Int[#3] = {1, 2, 3}
	r: Int[#3] = 100 - v
	r[0] == 99 and r[1] == 98 and r[2] == 97


-- (Float32 / Float16 rev coverage is verified indirectly by the
-- existing test_float32_vector and test_float16_vector "rev scalar
-- sub" sub-tests, which use the `vector()` factory that produces a
-- properly packed f32/f16 layout. Adding a literal-built Float32 case
-- here surfaces a separate pre-existing layout bug — literal
-- `{to_float32(...)}` builds a generic 8-byte-slot vector that the
-- packed-f32 SIMD helpers can't read; that's its own fix.)
tests: TestSuite = {
	description = "scalar OP tensor dispatch (commutative + reverse)",
	tests = [
		("scalar * vector (Float)", test_scalar_mul_vector_float),
		("scalar + vector (Int)", test_scalar_add_vector_int),
		("scalar - vector (Float)", test_scalar_sub_vector_float),
		("scalar / vector (Float)", test_scalar_div_vector_float),
		("a + 2.0 * b chain", test_mixed_scalar_vector_chain),
		("scalar - vector (Int)", test_scalar_sub_vector_int),
	],
}
