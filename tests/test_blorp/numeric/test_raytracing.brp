import:
	float: abs
	geometry:
		AABB3,
		BvhNode,
		Camera,
		Ray,
		Vec3,
		aabb3,
		aabb3_from_sphere,
		aabb3_merge,
		bvh_build,
		bvh_hit,
		camera,
		camera_ray,
		hit_plane,
		hit_sphere,
		hit_triangle,
		ray,
		ray_aabb,
		ray_at,
		vec3,
		vec3_max,
		vec3_min,
		vec3_neg,
		vec3_normalize,
		vec3_reflect,
	test: TestSuite


-- Vec3 extension tests
func test_vec3_neg() -> Bool:
	v: Vec3 = vec3_neg(vec3(1.0, -2.0, 3.0))
	abs(v.x - -1.0) < 0.001 and abs(v.y - 2.0) < 0.001 and abs(v.z - -3.0) < 0.001


func test_vec3_reflect() -> Bool:
	-- Reflect (1, -1, 0) off horizontal surface (normal = 0, 1, 0)
	v: Vec3 = vec3_reflect(vec3(1.0, -1.0, 0.0), vec3(0.0, 1.0, 0.0))
	abs(v.x - 1.0) < 0.001 and abs(v.y - 1.0) < 0.001


func test_vec3_min_max() -> Bool:
	a: Vec3 = vec3(1.0, 5.0, 3.0)
	b: Vec3 = vec3(4.0, 2.0, 6.0)
	mn: Vec3 = vec3_min(a, b)
	mx: Vec3 = vec3_max(a, b)
	abs(
		mn.x - 1.0,
	) < 0.001 and abs(mn.y - 2.0) < 0.001 and abs(mx.x - 4.0) < 0.001 and abs(mx.z - 6.0) < 0.001


-- Ray tests
func test_ray_at() -> Bool:
	r: Ray = ray(vec3(0.0, 0.0, 0.0), vec3(1.0, 0.0, 0.0))
	p: Vec3 = ray_at(r, 5.0)
	abs(p.x - 5.0) < 0.001 and abs(p.y) < 0.001


-- Sphere intersection tests
func test_hit_sphere_direct() -> Bool:
	-- Ray from origin along +Z, sphere at (0,0,5) radius 1
	r: Ray = ray(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 1.0))
	match hit_sphere(r, vec3(0.0, 0.0, 5.0), 1.0, 0.001, 1000.0):
		Some(h): abs(h.t - 4.0) < 0.001 and h.front_face
		None: False


func test_hit_sphere_miss() -> Bool:
	-- Ray along +X, sphere at (0,0,5) — miss
	r: Ray = ray(vec3(0.0, 0.0, 0.0), vec3(1.0, 0.0, 0.0))
	match hit_sphere(r, vec3(0.0, 0.0, 5.0), 1.0, 0.001, 1000.0):
		Some(_): False
		None: True


func test_hit_sphere_inside() -> Bool:
	-- Ray origin inside sphere — should hit back face
	r: Ray = ray(vec3(0.0, 0.0, 5.0), vec3(0.0, 0.0, 1.0))
	match hit_sphere(r, vec3(0.0, 0.0, 5.0), 2.0, 0.001, 1000.0):
		Some(h): not h.front_face
		None: False


func test_hit_sphere_normal() -> Bool:
	-- Normal at top of sphere should point up
	r: Ray = ray(vec3(0.0, 10.0, 0.0), vec3(0.0, -1.0, 0.0))
	match hit_sphere(r, vec3(0.0, 0.0, 0.0), 1.0, 0.001, 1000.0):
		Some(h): abs(h.normal.y - 1.0) < 0.001
		None: False


-- Plane intersection tests
func test_hit_plane() -> Bool:
	-- Ray pointing down, plane at y=0
	r: Ray = ray(vec3(0.0, 5.0, 0.0), vec3(0.0, -1.0, 0.0))
	match hit_plane(r, vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), 0.001, 1000.0):
		Some(h): abs(h.t - 5.0) < 0.001
		None: False


func test_hit_plane_parallel() -> Bool:
	-- Ray parallel to plane — miss
	r: Ray = ray(vec3(0.0, 5.0, 0.0), vec3(1.0, 0.0, 0.0))
	match hit_plane(r, vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), 0.001, 1000.0):
		Some(_): False
		None: True


-- AABB tests
func test_ray_aabb_hit() -> Bool:
	r: Ray = ray(vec3(-5.0, 0.0, 0.0), vec3(1.0, 0.0, 0.0))
	box: AABB3 = aabb3(vec3(-1.0, -1.0, -1.0), vec3(1.0, 1.0, 1.0))
	ray_aabb(r, box, 0.001, 1000.0)


func test_ray_aabb_miss() -> Bool:
	r: Ray = ray(vec3(-5.0, 5.0, 0.0), vec3(1.0, 0.0, 0.0))
	box: AABB3 = aabb3(vec3(-1.0, -1.0, -1.0), vec3(1.0, 1.0, 1.0))
	not ray_aabb(r, box, 0.001, 1000.0)


func test_aabb3_merge() -> Bool:
	a: AABB3 = aabb3(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
	b: AABB3 = aabb3(vec3(-1.0, -1.0, -1.0), vec3(0.5, 0.5, 0.5))
	m: AABB3 = aabb3_merge(a, b)
	abs(m.min.x - -1.0) < 0.001 and abs(m.max.x - 1.0) < 0.001


func test_aabb3_from_sphere() -> Bool:
	box: AABB3 = aabb3_from_sphere(vec3(0.0, 0.0, 0.0), 1.0)
	abs(box.min.x - -1.0) < 0.001 and abs(box.max.x - 1.0) < 0.001


-- Triangle intersection
func test_hit_triangle() -> Bool:
	-- Ray along -Z into a triangle in the XY plane at z=0
	r: Ray = ray(vec3(0.25, 0.25, 5.0), vec3(0.0, 0.0, -1.0))
	v0: Vec3 = vec3(0.0, 0.0, 0.0)
	v1: Vec3 = vec3(1.0, 0.0, 0.0)
	v2: Vec3 = vec3(0.0, 1.0, 0.0)
	match hit_triangle(r, v0, v1, v2, 0.001, 1000.0):
		Some(h): abs(h.t - 5.0) < 0.001
		None: False


func test_hit_triangle_miss() -> Bool:
	-- Ray misses the triangle
	r: Ray = ray(vec3(5.0, 5.0, 5.0), vec3(0.0, 0.0, -1.0))
	v0: Vec3 = vec3(0.0, 0.0, 0.0)
	v1: Vec3 = vec3(1.0, 0.0, 0.0)
	v2: Vec3 = vec3(0.0, 1.0, 0.0)
	match hit_triangle(r, v0, v1, v2, 0.001, 1000.0):
		Some(_): False
		None: True


-- Camera tests
func test_camera_center_ray() -> Bool:
	-- Camera at origin looking at -Z, center ray should go roughly toward -Z
	cam: Camera = camera(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, -1.0), vec3(0.0, 1.0, 0.0), 90.0, 1.0)
	r: Ray = camera_ray(cam, 0.5, 0.5)

	-- Center ray direction should be close to (0, 0, -1)
	d: Vec3 = vec3_normalize(r.direction)
	abs(d.z - -1.0) < 0.01


-- BVH tests
func test_bvh_single() -> Bool:
	items: List[(Int, AABB3)] = [(0, aabb3_from_sphere(vec3(0.0, 0.0, -5.0), 1.0))]
	bvh: BvhNode = bvh_build(items)

	-- Ray toward the sphere should hit
	r: Ray = ray(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, -1.0))
	match bvh_hit(bvh, r, 0.001, 1000.0):
		Some(result): result[0] == 0
		None: False


func test_bvh_multi() -> Bool:
	items: List[(Int, AABB3)] = [
		(0, aabb3_from_sphere(vec3(-3.0, 0.0, -5.0), 1.0)),
		(1, aabb3_from_sphere(vec3(0.0, 0.0, -5.0), 1.0)),
		(2, aabb3_from_sphere(vec3(3.0, 0.0, -5.0), 1.0)),
	]
	bvh: BvhNode = bvh_build(items)

	-- Ray toward center sphere
	r: Ray = ray(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, -1.0))
	match bvh_hit(bvh, r, 0.001, 1000.0):
		Some(result): result[0] == 1
		None: False


func test_bvh_miss() -> Bool:
	items: List[(Int, AABB3)] = [(0, aabb3_from_sphere(vec3(0.0, 0.0, -5.0), 1.0))]
	bvh: BvhNode = bvh_build(items)

	-- Ray going away from sphere
	r: Ray = ray(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 1.0))
	match bvh_hit(bvh, r, 0.001, 1000.0):
		Some(_): False
		None: True


func test_camera_corner_ray() -> Bool:
	-- Corner ray should diverge from center
	cam: Camera = camera(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, -1.0), vec3(0.0, 1.0, 0.0), 90.0, 1.0)
	r: Ray = camera_ray(cam, 0.0, 0.0)
	d: Vec3 = vec3_normalize(r.direction)

	-- Should point toward lower-left
	d.x < 0.0 and d.y < 0.0 and d.z < 0.0


tests: TestSuite = {
	description = "Ray Tracing Primitives",
	tests = [
		("vec3 negate", test_vec3_neg),
		("vec3 reflect", test_vec3_reflect),
		("vec3 min/max", test_vec3_min_max),
		("ray at", test_ray_at),
		("sphere hit direct", test_hit_sphere_direct),
		("sphere miss", test_hit_sphere_miss),
		("sphere inside", test_hit_sphere_inside),
		("sphere normal", test_hit_sphere_normal),
		("plane hit", test_hit_plane),
		("plane parallel miss", test_hit_plane_parallel),
		("aabb hit", test_ray_aabb_hit),
		("aabb miss", test_ray_aabb_miss),
		("aabb merge", test_aabb3_merge),
		("aabb from sphere", test_aabb3_from_sphere),
		("triangle hit", test_hit_triangle),
		("triangle miss", test_hit_triangle_miss),
		("bvh single", test_bvh_single),
		("bvh multi", test_bvh_multi),
		("bvh miss", test_bvh_miss),
		("camera center ray", test_camera_center_ray),
		("camera corner ray", test_camera_corner_ray),
	]
}
