import:
	float: is_inf
	test: TestSuite


-- Test safe division
-- blorp uses safe arithmetic by default to avoid panics
-- Normal integer division
func test_int_division() -> Bool:
	10 / 2 == 5


-- Division by zero returns 0
func test_int_div_by_zero() -> Bool:
	10 / 0 == 0


-- Integer division truncates
func test_int_division_truncate() -> Bool:
	7 / 2 == 3


-- Float division (unchanged — IEEE 754)
func test_float_division() -> Bool:
	d: Float = 10.0 / 2.0
	d == 5.0


-- Float division by zero returns inf (IEEE 754)
func test_float_div_by_zero() -> Bool:
	e: Float = 10.0 / 0.0
	is_inf(e)


-- Modulo by zero returns 0
func test_mod_by_zero() -> Bool:
	10 % 0 == 0


-- Normal modulo
func test_normal_mod() -> Bool:
	10 % 3 == 1


-- checked_div returns Some on success
func test_checked_div_success() -> Bool:
	match checked_div(10, 2):
		Some(v): v == 5
		None: False


-- checked_div returns None on zero
func test_checked_div_zero() -> Bool:
	match checked_div(10, 0):
		Some(_): False
		None: True


-- checked_mod returns Some on success
func test_checked_mod_success() -> Bool:
	match checked_mod(10, 3):
		Some(v): v == 1
		None: False


-- checked_mod returns None on zero
func test_checked_mod_zero() -> Bool:
	match checked_mod(10, 0):
		Some(_): False
		None: True


tests: TestSuite = {
	description = "Safe Division",
	tests = [
		("int division", test_int_division),
		("int div by zero returns 0", test_int_div_by_zero),
		("int division truncates", test_int_division_truncate),
		("float division", test_float_division),
		("float div by zero returns 0", test_float_div_by_zero),
		("mod by zero returns 0", test_mod_by_zero),
		("normal mod", test_normal_mod),
		("checked_div success", test_checked_div_success),
		("checked_div zero", test_checked_div_zero),
		("checked_mod success", test_checked_mod_success),
		("checked_mod zero", test_checked_mod_zero),
	]
}
