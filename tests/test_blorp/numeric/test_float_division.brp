import:
	float: cos
	test: TestSuite


-- Regression test for float division dispatch bug.
-- Previously, to_float(record.field) in a complex expression like
-- pi * to_float(x) / to_float(record.field) used integer division
-- (blorp_checked_div_int) instead of float division, silently
-- truncating results.
record Config {count: Int, rate: Float}


func test_to_float_division_simple() -> Bool:
	-- to_float(5) / to_float(3) should be ~1.666, not 1
	result: Float = to_float(5) / to_float(3)
	result > 1.6 and result < 1.7


func test_to_float_record_field_division() -> Bool:
	config: Config = {count = 5, rate = 0.5}
	-- to_float(10) / to_float(config.count) should be 2.0, not 2 (int)
	-- This specific pattern was the bug: record field access inside to_float
	result: Float = to_float(10) / to_float(config.count)
	result > 1.99 and result < 2.01


func test_complex_expr_with_record_division() -> Bool:
	config: Config = {count = 5, rate = 0.5}
	pi: Float = 3.14159265358979
	-- pi * to_float(1) / to_float(config.count) should be ~0.628
	-- Bug produced 0.0 (integer division: (long)(3.14) / 5 = 0)
	result: Float = pi * to_float(1) / to_float(config.count)
	result > 0.62 and result < 0.64


func test_loop_with_record_division() -> Bool:
	config: Config = {count = 4, rate = 0.5}
	pi: Float = 3.14159265358979
	-- In a loop, verify each iteration gets correct float division
	var ok: Bool = True
	for i in 1..4:
		val: Float = pi * to_float(i) / to_float(config.count)
		expected: Float = pi * to_float(i) / 4.0
		if val < expected - 0.001:
			ok = False
		if val > expected + 0.001:
			ok = False
	ok


func test_cosine_lr_schedule() -> Bool:
	-- This is the exact pattern from neural_bigram.brp that triggered the bug
	pi: Float = 3.14159265358979
	base_lr: Float = 0.5
	total_epochs: Float = to_float(5)
	-- Epoch 1: cos(pi * 1/5) = cos(0.628) ≈ 0.809
	-- lr = 0.5 * 0.5 * (1 + 0.809) = 0.452
	progress: Float = to_float(1) / total_epochs
	lr: Float = base_lr * 0.5 * (1.0 + cos(pi * progress))
	lr > 0.45 and lr < 0.46


func test_float_div_both_to_float() -> Bool:
	-- to_float(7) / to_float(2) should be 3.5, not 3
	result: Float = to_float(7) / to_float(2)
	result > 3.49 and result < 3.51


tests: TestSuite = {
	description = "Float Division Dispatch",
	tests = [
		("to_float simple division", test_to_float_division_simple),
		("to_float record field division", test_to_float_record_field_division),
		("complex expr with record division", test_complex_expr_with_record_division),
		("loop with record field division", test_loop_with_record_division),
		("cosine LR schedule pattern", test_cosine_lr_schedule),
		("float div both to_float", test_float_div_both_to_float),
	],
}
