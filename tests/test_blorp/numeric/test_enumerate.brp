-- Runtime tests for enumerate
import:
	tensor: enumerate
	test: TestSuite


-- Basic: sum elements with their indices
pure func test_enumerate_sum() -> Bool:
	v: Int[#4] = {10, 20, 30, 40}
	var sum: Int = 0
	for (i, val) in enumerate(v):
		sum = sum + i + val
	-- (0+10) + (1+20) + (2+30) + (3+40) = 106
	sum == 106


-- Proven index: v[i] matches val
pure func test_enumerate_index_matches() -> Bool:
	v: Int[#5] = {5, 10, 15, 20, 25}
	var ok: Bool = True
	for (i, val) in enumerate(v):
		if v[i] != val:
			ok = False
	ok


-- Find index of first match
pure func test_find_index() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	var found: Int = -1
	for (i, val) in enumerate(v):
		if val == 3 and found == -1:
			found = i
	found == 2


-- Float vector
pure func test_enumerate_float() -> Bool:
	v: Float[#3] = {1.5, 2.5, 3.5}
	var sum: Float = 0.0
	for (i, val) in enumerate(v):
		sum += val
	sum == 7.5


-- Break inside enumerate
func test_enumerate_break() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	var found: Int = -1
	for (i, val) in enumerate(v):
		if val == 3:
			found = i
			break
	found == 2


-- Single element vector
pure func test_enumerate_single() -> Bool:
	v: Int[#1] = {42}
	var count: Int = 0
	var result: Int = 0
	for (i, val) in enumerate(v):
		count += 1
		result = val
	count == 1 and result == 42


-- String vector (RC elements)
func test_enumerate_string() -> Bool:
	v: String[#3] = {"hello", "world", "!"}
	var count: Int = 0
	for (i, val) in enumerate(v):
		count += val.length()
	count == 11


tests: TestSuite = {
	description = "Enumerate: runtime",
	tests = [
		("enumerate sum", test_enumerate_sum),
		("enumerate index matches", test_enumerate_index_matches),
		("find index", test_find_index),
		("enumerate float", test_enumerate_float),
		("enumerate break", test_enumerate_break),
		("enumerate single element", test_enumerate_single),
		("enumerate string (RC)", test_enumerate_string),
	],
}
