import:
	string: contains
	test: TestSuite


-- Test #24: Vector to_string prints readable format
func test_int_vec_to_string() -> Bool:
	v: Int[#3] = {1, 2, 3}
	s: String = v.to_string()
	s.contains("1") and s.contains("2") and s.contains("3")


func test_float_vec_to_string() -> Bool:
	v: Float[#2] = {3.5, 4.5}
	s: String = v.to_string()
	s.contains("3.5") and s.contains("4.5")


func test_single_element() -> Bool:
	v: Int[#1] = {42}
	s: String = v.to_string()
	s.contains("42")


tests: TestSuite = {
	description = "Vector to_string",
	tests = [
		("int vec", test_int_vec_to_string),
		("float vec", test_float_vec_to_string),
		("single element", test_single_element),
	],
}
