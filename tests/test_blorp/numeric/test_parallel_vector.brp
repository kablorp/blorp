import:
	list: get
	test: TestSuite
	vector: ParallelVector, parallel


pure func get_or_zero(values: List[Int], index: Int) -> Int:
	match get(values, index):
		Some(value): value
		None: 0


func test_parallel_vector_map() -> Bool:
	values: Int[#4] = {1, 2, 3, 4}
	result: Int[#4] = values.parallel(pure func(chunk: ParallelVector[Int, #4]):
		chunk.map(pure func(x: Int) -> Int: x * 3)
	)
	result[0] == 3 and result[1] == 6 and result[2] == 9 and result[3] == 12


func test_parallel_vector_map_indexed() -> Bool:
	values: Int[#4] = {10, 10, 10, 10}
	result: Int[#4] = values.parallel(pure func(chunk: ParallelVector[Int, #4]):
		chunk.map_indexed(pure func(i: ..#4, x: Int) -> Int: x + i)
	)
	result[0] == 10 and result[1] == 11 and result[2] == 12 and result[3] == 13


func test_parallel_vector_zip_map() -> Bool:
	left: Int[#3] = {1, 2, 3}
	right: Int[#3] = {10, 20, 30}
	result: Int[#3] = left.parallel(pure func(chunk: ParallelVector[Int, #3]):
		chunk.zip_map(right, pure func(a: Int, b: Int) -> Int: a + b)
	)
	result[0] == 11 and result[1] == 22 and result[2] == 33


func test_parallel_vector_map_chain() -> Bool:
	values: Int[#4] = {1, 2, 3, 4}
	result: Int[#4] = values.parallel(pure func(chunk: ParallelVector[Int, #4]):
		chunk
			.map(pure func(x: Int) -> Int: x + 1)
			.map(pure func(x: Int) -> Int: x * 2)
	)
	result[0] == 4 and result[1] == 6 and result[2] == 8 and result[3] == 10


func test_parallel_vector_zip_map_chain() -> Bool:
	left: Int[#3] = {1, 2, 3}
	right: Int[#3] = {10, 20, 30}
	result: Int[#3] = left.parallel(pure func(chunk: ParallelVector[Int, #3]):
		chunk
			.zip_map(right, pure func(a: Int, b: Int) -> Int: a + b)
			.map(pure func(x: Int) -> Int: x * 2)
	)
	result[0] == 22 and result[1] == 44 and result[2] == 66


func test_parallel_vector_reused_capture_chain() -> Bool:
	left: Int[#3] = {1, 2, 3}
	right: Int[#3] = {10, 20, 30}
	result: Int[#3] = left.parallel(pure func(chunk: ParallelVector[Int, #3]):
		chunk
			.zip_map(right, pure func(a: Int, b: Int) -> Int: a + b)
			.zip_map(right, pure func(a: Int, b: Int) -> Int: a * b)
			.map(pure func(x: Int) -> Int: x + 1)
	)
	result[0] == 111 and result[1] == 441 and result[2] == 991


func test_parallel_vector_managed_result_chain() -> Bool:
	left: Int[#3] = {1, 2, 3}
	right: Int[#3] = {10, 20, 30}
	result: List[Int][#3] = left.parallel(pure func(chunk: ParallelVector[Int, #3]):
		chunk
			.zip_map(right, pure func(a: Int, b: Int) -> List[Int]: [a, b, a + b])
			.map(pure func(row: List[Int]) -> List[Int]: row.append(row.length()))
	)
	first: List[Int] = result[0]
	third: List[Int] = result[2]
	first.length() == 4 and get_or_zero(
		first,
		2,
	) == 11 and get_or_zero(first, 3) == 3 and get_or_zero(third, 2) == 33


tests: TestSuite = {
	description = "Parallel Vector",
	tests = [
		("parallel vector map", test_parallel_vector_map),
		("parallel vector map indexed", test_parallel_vector_map_indexed),
		("parallel vector zip map", test_parallel_vector_zip_map),
		("parallel vector map chain", test_parallel_vector_map_chain),
		("parallel vector zip-map chain", test_parallel_vector_zip_map_chain),
		("parallel vector reused capture chain", test_parallel_vector_reused_capture_chain),
		("parallel vector managed result chain", test_parallel_vector_managed_result_chain),
	],
}
