import:
	tensor as T: get_or
	test: TestSuite


-- Generic vget using length(v) for bounds
pure func vget[#N](v: Float[#N], i: Int) -> Float:
	v.get_or(i, 0.0)


-- Generic vset using set_index
pure func vset[#N](v: Float[#N], i: Int, val: Float) -> Float[#N]:
	match T.set_index(v, i, val):
		Some(updated):
			updated
		None:
			v


-- Create zeros with same size as another vector
func zeros_like[#N](v: Float[#N]) -> Float[#N]:
	vector(0.0, v.length())


-- Sum using generic subscript
pure func vec_sum[#N](v: Float[#N]) -> Float:
	var total: Float = 0.0

	for i in 0..length(v):
		total += v[i]

	total


-- Create vector from dim param
func make_vec(len: #N) -> Float[#N]:
	vector(0.0, len)


pure func dim_value_to_string[#N](len: #N) -> String:
	len.to_string()


-- ===== Tests =====
func test_vget_basic() -> Bool:
	v: Float[#5] = {10.0, 20.0, 30.0, 40.0, 50.0}
	vget(v, 0) == 10.0 and vget(v, 4) == 50.0


func test_vget_out_of_bounds() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	vget(v, 5) == 0.0 and vget(v, -1) == 0.0


func test_vset_basic() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	v2 = vset(v, 1, 99.0)
	vget(v2, 1) == 99.0


func test_zeros_like() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	z = zeros_like(v)
	z.length() == 4 and vget(z, 0) == 0.0 and vget(z, 3) == 0.0


func test_vec_sum() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	vec_sum(v) == 10.0


func test_vec_sum_different_size() -> Bool:
	v: Float[#2] = {5.0, 7.0}
	vec_sum(v) == 12.0


func test_make_vec() -> Bool:
	v = make_vec(5)
	v.length() == 5


func test_dim_literal_valid() -> Bool:
	x: #42 = 42
	x == 42


func test_dim_compatible_with_int() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	n: Int = v.length()
	n == 3


func test_generic_with_different_sizes() -> Bool:
	a: Float[#3] = {1.0, 2.0, 3.0}
	b: Float[#5] = {10.0, 20.0, 30.0, 40.0, 50.0}
	vec_sum(a) == 6.0 and vec_sum(b) == 150.0


func test_dim_length_to_string() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	v
		.length()
		.to_string() == "4"


func test_generic_dim_to_string() -> Bool:
	dim_value_to_string(5) == "5"


tests: TestSuite = {
	description = "Dimension Parameter Values",
	tests = [
		("vget basic", test_vget_basic),
		("vget out of bounds", test_vget_out_of_bounds),
		("vset basic", test_vset_basic),
		("zeros_like", test_zeros_like),
		("vec_sum", test_vec_sum),
		("vec_sum different size", test_vec_sum_different_size),
		("make_vec", test_make_vec),
		("dim literal valid", test_dim_literal_valid),
		("dim compatible with int", test_dim_compatible_with_int),
		("generic with different sizes", test_generic_with_different_sizes),
		("dim length to string", test_dim_length_to_string),
		("generic dim to string", test_generic_dim_to_string),
	]
}
