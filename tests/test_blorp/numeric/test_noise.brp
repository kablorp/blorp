import:
	float: abs
	noise: fbm_2d, fbm_3d, value_noise_1d, value_noise_2d, value_noise_3d
	test: TestSuite


-- Value noise is deterministic
func test_1d_deterministic() -> Bool:
	value_noise_1d(5.5) == value_noise_1d(5.5)


-- Value noise output is in [0, 1]
func test_1d_range() -> Bool:
	var ok: Bool = True
	var i: Int = 0
	while i < 100:
		v: Float = value_noise_1d(to_float(i) * 0.37)
		if v < 0.0 or v > 1.0:
			ok = False
		i += 1
	ok


-- Different inputs produce different outputs (not constant)
func test_1d_varies() -> Bool:
	a: Float = value_noise_1d(0.0)
	b: Float = value_noise_1d(0.5)
	c: Float = value_noise_1d(1.0)
	not (a == b and b == c)


-- 2D noise is deterministic
func test_2d_deterministic() -> Bool:
	value_noise_2d(1.5, 2.3) == value_noise_2d(1.5, 2.3)


-- 2D noise output is in [0, 1]
func test_2d_range() -> Bool:
	var ok: Bool = True
	var i: Int = 0
	while i < 100:
		x: Float = to_float(i) * 0.31
		y: Float = to_float(i) * 0.47
		v: Float = value_noise_2d(x, y)
		if v < 0.0 or v > 1.0:
			ok = False
		i += 1
	ok


-- 3D noise is deterministic
func test_3d_deterministic() -> Bool:
	value_noise_3d(1.0, 2.0, 3.0) == value_noise_3d(1.0, 2.0, 3.0)


-- 3D noise output is in [0, 1]
func test_3d_range() -> Bool:
	v: Float = value_noise_3d(0.5, 1.5, 2.5)
	v >= 0.0 and v <= 1.0


-- fBm 2D is deterministic
func test_fbm_2d_deterministic() -> Bool:
	fbm_2d(1.5, 2.3, 4, 0.5) == fbm_2d(1.5, 2.3, 4, 0.5)


-- fBm 2D output is in [0, 1] (normalized by max amplitude)
func test_fbm_2d_range() -> Bool:
	v: Float = fbm_2d(3.7, 8.1, 6, 0.5)
	v >= 0.0 and v <= 1.0


-- fBm 3D is deterministic
func test_fbm_3d_deterministic() -> Bool:
	fbm_3d(1.0, 2.0, 3.0, 4, 0.5) == fbm_3d(1.0, 2.0, 3.0, 4, 0.5)


-- Noise is continuous: nearby inputs produce nearby outputs
func test_continuity() -> Bool:
	a: Float = value_noise_1d(5.0)
	b: Float = value_noise_1d(5.001)
	abs(a - b) < 0.1


tests: TestSuite = {
	description = "Noise Functions",
	tests = [
		("1d deterministic", test_1d_deterministic),
		("1d range", test_1d_range),
		("1d varies", test_1d_varies),
		("2d deterministic", test_2d_deterministic),
		("2d range", test_2d_range),
		("3d deterministic", test_3d_deterministic),
		("3d range", test_3d_range),
		("fbm 2d deterministic", test_fbm_2d_deterministic),
		("fbm 2d range", test_fbm_2d_range),
		("fbm 3d deterministic", test_fbm_3d_deterministic),
		("continuity", test_continuity),
	]
}
