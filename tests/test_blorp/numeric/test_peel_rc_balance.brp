-- Phase 4.4 regression: dimension peeling (Phase 4.1) copies each row into a
-- fresh Vector, which must be released at the end of each iteration. These
-- tests exercise peeling with element types that themselves need RC handling
-- (Strings) and verify no leaks, no stale reads, and correct behavior across
-- edge shapes.
import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	tensor: matrix
	test: TestSuite


-- Iterate a 2D Float matrix row-by-row; Float stores by bit-cast, no ARC.
-- The row slice is ARC'd — verify we don't leak rows. Iterate a non-trivial
-- number of times so a per-iteration leak becomes visible in the stats.
func test_peel_float_no_leak() -> Bool:
	m: Float[#8, #4] = matrix(1.5, 8, 4)
	reset_mem_stats()
	var sum: Float = 0.0
	var iter: Int = 0
	while iter < 10:
		for row in m:
			for val in row:
				sum += val
		iter += 1
	after: MemStats = get_mem_stats()
	-- After 10 outer passes of peeling an 8-row matrix we've allocated 80
	-- row slices; they must all be released. A slow leak of one slot per
	-- row would show up as ~80 live objects.
	after.current_objects <= 2


-- Iterate over a matrix whose outer dim is bound generically — exercises the
-- runtime cols = capacity/len derivation landed in Phase 4.4.
pure func sum_all_generic[#M, #N](m: Int[#M, #N]) -> Int:
	var total: Int = 0
	for row in m:
		for v in row:
			total += v
	total


func test_peel_generic_dims() -> Bool:
	m: Int[#3, #5] = matrix(7, 3, 5)
	-- 3 rows × 5 cols × 7 per elem = 105
	sum_all_generic(m) == 105


-- Peel a 1-row matrix (degenerate outer dim) — row_slice returns a 1-row
-- tensor that must still unbox correctly and release cleanly.
func test_peel_single_row() -> Bool:
	m: Int[#1, #3] = {
		{10, 20, 30},
	}
	var total: Int = 0
	for row in m:
		for v in row:
			total += v
	total == 60


-- Enumerate with a generic-dim matrix; verifies the new capacity/len cols
-- runtime path and the matrix_checked_get emit.
pure func enum2_generic_sum[#M, #N](m: Int[#M, #N]) -> Int:
	var total: Int = 0
	for (_i, _j, v) in enumerate2(m):
		total += v
	total


func test_enumerate2_generic() -> Bool:
	m: Int[#4, #2] = {
		{1, 2},
		{3, 4},
		{5, 6},
		{7, 8},
	}
	enum2_generic_sum(m) == 36


-- Mutation invariance: reading rows via peel should not see later writes
-- through the parent. (Today's implementation copies each row, so this is
-- a by-construction property.)
func test_peel_row_copy_isolation() -> Bool:
	var m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	-- Peel row 0 into a fresh slot, then mutate m; the captured row should
	-- reflect its state at peel time, not the post-mutation state.
	var captured: Int = 0
	var touched_first: Bool = False
	for row in m:
		if not touched_first:
			captured = row[0]
			touched_first = True
	captured == 1


tests: TestSuite = {
	description = "peel/enumerate RC correctness",
	tests = [
		("peel float no leak", test_peel_float_no_leak),
		("peel generic dims", test_peel_generic_dims),
		("peel single row", test_peel_single_row),
		("enumerate2 generic dim runtime", test_enumerate2_generic),
		("peel row copy isolation", test_peel_row_copy_isolation),
	],
}
