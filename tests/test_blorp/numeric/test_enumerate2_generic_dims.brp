-- Phase 4.4 regression: enumerate2 over a matrix with a generic column dim.
-- Before 2026-04-21 this hard-errored at lower because cols wasn't a literal.
import:
	test: TestSuite


pure func sum_indices[#M, #N](m: Int[#M, #N]) -> Int:
	var total: Int = 0
	for (i, j, v) in enumerate2(m):
		total = total + i + j + v
	total


func test_generic_dims_sum() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	-- indices: (0,0,1)=1 (0,1,2)=3 (0,2,3)=5 (1,0,4)=5 (1,1,5)=7 (1,2,6)=9
	-- sum: 1+3+5+5+7+9 = 30
	sum_indices(m) == 30


func test_generic_dims_flat_rect() -> Bool:
	m: Int[#3, #2] = {
		{10, 20},
		{30, 40},
		{50, 60},
	}
	-- (0,0,10)=10 (0,1,20)=21 (1,0,30)=31 (1,1,40)=42 (2,0,50)=52 (2,1,60)=63
	-- sum: 10+21+31+42+52+63 = 219
	sum_indices(m) == 219


func test_generic_dims_single_row() -> Bool:
	-- 1xN edge case
	m: Int[#1, #4] = {
		{1, 2, 3, 4},
	}
	sum_indices(m) == 0 + 0 + 1 + (0 + 1 + 2) + (0 + 2 + 3) + (0 + 3 + 4)


tests: TestSuite = {
	description = "enumerate2 generic dims",
	tests = [
		("generic dims 2x3", test_generic_dims_sum),
		("generic dims 3x2 rectangular", test_generic_dims_flat_rect),
		("generic dims 1x4 single row", test_generic_dims_single_row),
	],
}
