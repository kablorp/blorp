import:
	test: TestSuite


-- Basic declaration
func test_basic_decl() -> Bool:
	a: Float16 = 3.0
	b: Float16 = 0.0
	c: Float16 = -1.5
	expected_a: Float16 = 3.0
	expected_b: Float16 = 0.0
	expected_c: Float16 = -1.5
	a == expected_a and b == expected_b and c == expected_c


-- Arithmetic
func test_arithmetic() -> Bool:
	a: Float16 = 10.0
	b: Float16 = 3.0
	c: Float16 = a + b
	d: Float16 = a - b
	e: Float16 = a * b
	expected_sum: Float16 = 13.0
	expected_diff: Float16 = 7.0
	expected_prod: Float16 = 30.0
	c == expected_sum and d == expected_diff and e == expected_prod


-- Negation
func test_negation() -> Bool:
	a: Float16 = 5.0
	b: Float16 = -a
	c: Float16 = -b
	neg5: Float16 = -5.0
	pos5: Float16 = 5.0
	b == neg5 and c == pos5


-- Comparison
func test_comparison() -> Bool:
	a: Float16 = 1.0
	b: Float16 = 2.0
	a < b and b > a and a <= a and a >= a and a == a and a != b


-- Division by zero returns inf (IEEE 754)
func test_safe_div() -> Bool:
	a: Float16 = 10.0
	b: Float16 = 0.0
	c: Float16 = a / b
	inf16: Float16 = to_float16(1.0 / 0.0)
	c == inf16


-- Conversion from Int
func test_to_float16_from_int() -> Bool:
	a: Float16 = to_float16(42)
	expected: Float16 = 42.0
	a == expected


-- Conversion from Float
func test_to_float16_from_float() -> Bool:
	a: Float16 = to_float16(3.0)
	expected: Float16 = 3.0
	a == expected


-- Conversion from Float32
func test_to_float16_from_float32() -> Bool:
	a: Float32 = 5.0
	b: Float16 = to_float16(a)
	expected: Float16 = 5.0
	b == expected


-- Conversion from Bool
func test_to_float16_from_bool() -> Bool:
	a: Float16 = to_float16(True)
	b: Float16 = to_float16(False)
	one: Float16 = 1.0
	zero: Float16 = 0.0
	a == one and b == zero


-- to_int from Float16
func test_to_int() -> Bool:
	a: Float16 = 42.0
	b: Int = to_int(a)
	b == 42


-- to_float from Float16
func test_to_float() -> Bool:
	a: Float16 = 3.0
	b: Float = to_float(a)
	b == 3.0


-- to_float32 from Float16
func test_to_float32() -> Bool:
	a: Float16 = 3.0
	b: Float32 = to_float32(a)
	expected: Float32 = 3.0
	b == expected


-- to_string
func test_to_string() -> Bool:
	a: Float16 = 3.5
	s: String = a.to_string()
	s == "3.5"


-- String interpolation
func test_interpolation() -> Bool:
	a: Float16 = 2.5
	s: String = "val=${a}"
	s == "val=2.5"


-- to_bool
func test_to_bool() -> Bool:
	a: Float16 = 1.0
	b: Float16 = 0.0
	to_bool(a) == True and to_bool(b) == False


-- Struct field
struct Point16 {x: Float16, y: Float16}


func test_struct_fields() -> Bool:
	p: Point16 = {x = 1.0, y = 2.0}
	one: Float16 = 1.0
	two: Float16 = 2.0
	p.x == one and p.y == two


-- Option[Float16]
func test_option_float16() -> Bool:
	a: Option[Float16] = Some(to_float16(3))
	match a:
		Some(v):
			three: Float16 = 3.0
			v == three
		None: False


-- List[Float16]
func test_list_float16() -> Bool:
	xs: List[Float16] = [to_float16(1), to_float16(2), to_float16(3)]
	xs.length() == 3


tests: TestSuite = {
	description = "Float16 Tests",
	tests = [
		("basic declaration", test_basic_decl),
		("arithmetic", test_arithmetic),
		("negation", test_negation),
		("comparison", test_comparison),
		("safe division", test_safe_div),
		("to_float16 from Int", test_to_float16_from_int),
		("to_float16 from Float", test_to_float16_from_float),
		("to_float16 from Float32", test_to_float16_from_float32),
		("to_float16 from Bool", test_to_float16_from_bool),
		("to_int from Float16", test_to_int),
		("to_float from Float16", test_to_float),
		("to_float32 from Float16", test_to_float32),
		("to_string", test_to_string),
		("interpolation", test_interpolation),
		("to_bool", test_to_bool),
		("struct fields", test_struct_fields),
		("Option[Float16]", test_option_float16),
		("List[Float16]", test_list_float16),
	],
}
