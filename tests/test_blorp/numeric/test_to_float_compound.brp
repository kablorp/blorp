import:
	test: TestSuite


-- to_float(compound_expr) should use Int->Float cast, not String parser
func test_to_float_subtraction() -> Bool:
	a: Int = 100
	b: Int = 69
	result: Float = to_float(a - b)
	result == 31.0


func test_to_float_addition() -> Bool:
	x: Int = 10
	y: Int = 20
	result: Float = to_float(x + y)
	result == 30.0


func test_to_float_multiplication() -> Bool:
	m: Int = 7
	n: Int = 6
	result: Float = to_float(m * n)
	result == 42.0


tests: TestSuite = {
	description = "to_float() Compound Expression Dispatch",
	tests = [
		("to_float subtraction", test_to_float_subtraction),
		("to_float addition", test_to_float_addition),
		("to_float multiplication", test_to_float_multiplication),
	]
}
