import:
	matrix: matrix_vector_multiply, outer_multiply, transposed_matrix_vector_multiply
	test: TestSuite


func test_matrix_vector_multiply_int() -> Bool:
	w: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	x: Int[#2] = {10, 20}
	y: Int[#2] = matrix_vector_multiply(w, x)
	y[0] == 50 and y[1] == 110


func test_outer_multiply_float32() -> Bool:
	a: Float32[#2] = {to_float32(2), to_float32(3)}
	b: Float32[#3] = {to_float32(4), to_float32(5), to_float32(6)}
	m: Float32[#2, #3] = outer_multiply(a, b)
	m[0, 0] == to_float32(8) and m[0, 2] == to_float32(12) and m[1, 1] == to_float32(15)


func test_transposed_matrix_vector_multiply_int() -> Bool:
	w: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	x: Int[#2] = {10, 20}
	y: Int[#3] = transposed_matrix_vector_multiply(w, x)
	y[0] == 90 and y[1] == 120 and y[2] == 150


func test_transposed_matrix_vector_multiply_float32() -> Bool:
	w: Float32[#2, #2] = {
		{to_float32(1), to_float32(2)},
		{to_float32(3), to_float32(4)},
	}
	x: Float32[#2] = {to_float32(5), to_float32(6)}
	y: Float32[#2] = transposed_matrix_vector_multiply(w, x)
	y[0] == to_float32(23) and y[1] == to_float32(34)


tests: TestSuite = {
	description = "Matrix Vector Ops",
	tests = [
		("matrix_vector_multiply int", test_matrix_vector_multiply_int),
		("outer_multiply float32", test_outer_multiply_float32),
		("transposed_matrix_vector_multiply int", test_transposed_matrix_vector_multiply_int),
		(
			"transposed_matrix_vector_multiply float32",
			test_transposed_matrix_vector_multiply_float32,
		),
	],
}
