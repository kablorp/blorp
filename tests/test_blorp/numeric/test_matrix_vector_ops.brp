import:
	float: to_float16
	matrix: multiply_transposed_vector, multiply_vector, outer
	test: TestSuite


func test_multiply_vector_int() -> Bool:
	w: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	x: Int[#2] = {10, 20}
	y: Int[#2] = multiply_vector(w, x)
	y[0] == 50 and y[1] == 110


func test_outer_float32() -> Bool:
	a: Float32[#2] = {to_float32(2), to_float32(3)}
	b: Float32[#3] = {to_float32(4), to_float32(5), to_float32(6)}
	m: Float32[#2, #3] = outer(a, b)
	m[0, 0] == to_float32(8) and m[0, 2] == to_float32(12) and m[1, 1] == to_float32(15)


func test_multiply_transposed_vector_int() -> Bool:
	w: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	x: Int[#2] = {10, 20}
	y: Int[#3] = multiply_transposed_vector(w, x)
	y[0] == 90 and y[1] == 120 and y[2] == 150


func test_multiply_transposed_vector_float32() -> Bool:
	w: Float32[#2, #2] = {
		{to_float32(1), to_float32(2)},
		{to_float32(3), to_float32(4)},
	}
	x: Float32[#2] = {to_float32(5), to_float32(6)}
	y: Float32[#2] = multiply_transposed_vector(w, x)
	y[0] == to_float32(23) and y[1] == to_float32(34)


func test_multiply_vector_float16() -> Bool:
	w: Float16[#2, #2] = {
		{to_float16(1), to_float16(2)},
		{to_float16(3), to_float16(4)},
	}
	x: Float16[#2] = {to_float16(10), to_float16(20)}
	y: Float16[#2] = multiply_vector(w, x)
	y[0] == to_float16(50) and y[1] == to_float16(110)


func test_outer_float16() -> Bool:
	a: Float16[#2] = {to_float16(2), to_float16(3)}
	b: Float16[#3] = {to_float16(4), to_float16(5), to_float16(6)}
	m: Float16[#2, #3] = outer(a, b)
	m[0, 0] == to_float16(8) and m[0, 2] == to_float16(12) and m[1, 1] == to_float16(15)


func test_multiply_transposed_vector_float16() -> Bool:
	w: Float16[#2, #2] = {
		{to_float16(1), to_float16(2)},
		{to_float16(3), to_float16(4)},
	}
	x: Float16[#2] = {to_float16(5), to_float16(6)}
	y: Float16[#2] = multiply_transposed_vector(w, x)
	y[0] == to_float16(23) and y[1] == to_float16(34)


tests: TestSuite = {
	description = "Matrix Vector Ops",
	tests = [
		("multiply_vector int", test_multiply_vector_int),
		("outer float32", test_outer_float32),
		("multiply_transposed_vector int", test_multiply_transposed_vector_int),
		("multiply_transposed_vector float32", test_multiply_transposed_vector_float32),
		("multiply_vector float16", test_multiply_vector_float16),
		("outer float16", test_outer_float16),
		("multiply_transposed_vector float16", test_multiply_transposed_vector_float16),
	],
}
