import:
	test: TestSuite


func indices(v: Int[#3]) -> List[Int]:
	[10]


func test_local_indices_wins() -> Bool:
	v: Int[#3] = {1, 2, 3}
	var total: Int = 0
	for i in indices(v):
		total += i
	total == 10


tests: TestSuite = {
	description = "tensor indices loop-view shadowing",
	tests = [("local indices wins", test_local_indices_wins)],
}
