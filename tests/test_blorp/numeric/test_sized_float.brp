import:
	float: abs
	test: TestSuite


func test_float32_arithmetic() -> Bool:
	a: Float32 = to_float32(3.0)
	b: Float32 = to_float32(2.0)
	c: Float32 = a + b
	to_float(c) == 5.0


func test_float32_comparison() -> Bool:
	a: Float32 = to_float32(3.0)
	b: Float32 = to_float32(2.0)
	a > b and b < a and a != b


func test_float32_to_string() -> Bool:
	a: Float32 = to_float32(3.14)
	s: String = a.to_string()
	s.length() > 0


func test_float32_negation() -> Bool:
	a: Float32 = to_float32(5.0)
	b: Float32 = -a
	to_float(b) == -5.0


func test_float32_conversion() -> Bool:
	a: Float32 = to_float32(42.5)
	b: Float = to_float(a)
	abs(b - 42.5) < 0.01


tests: TestSuite = {
	description = "Sized Float",
	tests = [
		("float32 arithmetic", test_float32_arithmetic),
		("float32 comparison", test_float32_comparison),
		("float32 to_string", test_float32_to_string),
		("float32 negation", test_float32_negation),
		("float32 conversion", test_float32_conversion),
	],
}
