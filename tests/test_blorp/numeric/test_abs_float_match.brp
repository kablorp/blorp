import:
	test: TestSuite


-- abs() should dispatch to fabs for Float vars extracted from match arms
func abs_of_optional_float(opt: Option[Float]) -> Float:
	match opt:
		Some(v): abs(v)
		None: 0.0


func test_abs_positive() -> Bool:
	abs_of_optional_float(Some(3.14)) == 3.14


func test_abs_negative() -> Bool:
	abs_of_optional_float(Some(-2.5)) == 2.5


func test_abs_zero() -> Bool:
	abs_of_optional_float(Some(0.0)) == 0.0


func test_abs_none() -> Bool:
	abs_of_optional_float(None) == 0.0


tests: TestSuite = {
	description = "abs() Float Match Dispatch",
	tests = [
		("abs positive float", test_abs_positive),
		("abs negative float", test_abs_negative),
		("abs zero", test_abs_zero),
		("abs none", test_abs_none),
	]
}
