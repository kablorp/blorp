-- Test element-wise unary math on matrices
import:
	float: abs, sqrt
	matrix: get_cell_or
	test: TestSuite


func test_sqrt_matrix() -> Bool:
	m: Float[#2, #2] = {
		{4.0, 9.0},
		{16.0, 25.0},
	}
	r: Float[#2, #2] = sqrt(m)
	r.get_cell_or(0, 0, 0.0) == 2.0 and r.get_cell_or(1, 1, 0.0) == 5.0


func test_abs_matrix() -> Bool:
	m: Float[#2, #2] = {
		{-1.0, 2.0},
		{-3.0, 4.0},
	}
	r: Float[#2, #2] = abs(m)
	r.get_cell_or(0, 0, 0.0) == 1.0 and r.get_cell_or(1, 0, 0.0) == 3.0


func test_sobel_magnitude() -> Bool:
	-- The pattern that motivated this: sqrt(gx*gx + gy*gy)
	gx: Float[#2, #2] = {
		{3.0, 0.0},
		{0.0, 4.0},
	}
	gy: Float[#2, #2] = {
		{4.0, 0.0},
		{0.0, 3.0},
	}
	mag: Float[#2, #2] = sqrt(gx * gx + gy * gy)
	mag.get_cell_or(0, 0, 0.0) == 5.0 and mag.get_cell_or(1, 1, 0.0) == 5.0


tests: TestSuite = {
	description = "Matrix Element-wise Math",
	tests = [
		("sqrt matrix", test_sqrt_matrix),
		("abs matrix", test_abs_matrix),
		("sobel magnitude", test_sobel_magnitude),
	],
}
