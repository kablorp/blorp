import:
	float: almost_equal, approx_eq
	test: TestSuite


-- Test #17: approx_eq for floating-point comparisons
func test_multiply_rounding() -> Bool:
	approx_eq(3.0 * 0.2, 0.6)


func test_divide_rounding() -> Bool:
	approx_eq(1.0 / 3.0 * 3.0, 1.0)


func test_exact_equal() -> Bool:
	approx_eq(1.5, 1.5)


func test_not_approx_equal() -> Bool:
	not approx_eq(1.0, 2.0)


func test_custom_epsilon() -> Bool:
	almost_equal(1.0, 1.01, 0.1)


tests: TestSuite = {
	description = "Approximate equality",
	tests = [
		("multiply rounding", test_multiply_rounding),
		("divide rounding", test_divide_rounding),
		("exact equal", test_exact_equal),
		("not approx equal", test_not_approx_equal),
		("custom epsilon", test_custom_epsilon),
	],
}
