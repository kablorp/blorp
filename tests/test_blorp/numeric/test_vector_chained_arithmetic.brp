import:
	test: TestSuite


func test_add_three_vectors() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	c: Int[#3] = {7, 8, 9}
	result: Int[#3] = a + b + c
	result[0] == 12 and result[1] == 15 and result[2] == 18


func test_add_three_float_vectors() -> Bool:
	a: Float[#3] = {1.0, 2.0, 3.0}
	b: Float[#3] = {4.0, 5.0, 6.0}
	c: Float[#3] = {7.0, 8.0, 9.0}
	result: Float[#3] = a + b + c
	result[0] == 12.0 and result[1] == 15.0 and result[2] == 18.0


func test_vector_plus_scalar_times_vector() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	result: Int[#3] = a + b * 2
	result[0] == 9 and result[1] == 12 and result[2] == 15


func test_sub_then_div() -> Bool:
	a: Int[#3] = {10, 20, 30}
	b: Int[#3] = {2, 4, 6}
	c: Int[#3] = {2, 2, 2}
	result: Int[#3] = (a - b) / c
	result[0] == 4 and result[1] == 8 and result[2] == 12


tests: TestSuite = {
	description = "Vector Chained Arithmetic",
	tests = [
		("add three int vectors", test_add_three_vectors),
		("add three float vectors", test_add_three_float_vectors),
		("vector plus scalar*vector", test_vector_plus_scalar_times_vector),
		("sub then div", test_sub_then_div),
	],
}
