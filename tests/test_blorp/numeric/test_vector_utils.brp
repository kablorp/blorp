import:
	float: approx_eq
	list as L
	test: TestSuite
	vector: lerp, scale, to_list


func test_scale() -> Bool:
	var v: Float[#3] = vector(0.0, 3)
	v[0] = 1.0
	v[1] = 2.0
	v[2] = 3.0
	result: Float[#3] = scale(v, 2.0)
	approx_eq(result[0], 2.0) and approx_eq(result[1], 4.0) and approx_eq(result[2], 6.0)


func test_scale_zero() -> Bool:
	v: Float[#3] = vector(5.0, 3)
	result: Float[#3] = scale(v, 0.0)
	approx_eq(result[0], 0.0) and approx_eq(result[1], 0.0)


func test_lerp_zero() -> Bool:
	a: Float[#3] = vector(1.0, 3)
	b: Float[#3] = vector(10.0, 3)
	result: Float[#3] = lerp(a, b, 0.0)
	approx_eq(result[0], 1.0) and approx_eq(result[1], 1.0)


func test_lerp_one() -> Bool:
	a: Float[#3] = vector(1.0, 3)
	b: Float[#3] = vector(10.0, 3)
	result: Float[#3] = lerp(a, b, 1.0)
	approx_eq(result[0], 10.0) and approx_eq(result[1], 10.0)


func test_lerp_half() -> Bool:
	a: Float[#3] = vector(0.0, 3)
	b: Float[#3] = vector(10.0, 3)
	result: Float[#3] = lerp(a, b, 0.5)
	approx_eq(result[0], 5.0) and approx_eq(result[1], 5.0)


func test_to_list() -> Bool:
	var v: Float[#4] = vector(0.0, 4)
	v[0] = 1.0
	v[1] = 2.0
	v[2] = 3.0
	v[3] = 4.0
	lst: List[Float] = to_list(v)
	L.length(lst) == 4 and match L.get(lst, 0):
		Some(x): approx_eq(x, 1.0)
		None: False


func test_to_list_values() -> Bool:
	var v: Float[#3] = vector(0.0, 3)
	v[0] = 10.0
	v[1] = 20.0
	v[2] = 30.0
	lst: List[Float] = to_list(v)
	match L.get(lst, 2):
		Some(x): approx_eq(x, 30.0)
		None: False


tests: TestSuite = {
	description = "Vector Utilities",
	tests = [
		("scale", test_scale),
		("scale zero", test_scale_zero),
		("lerp 0.0", test_lerp_zero),
		("lerp 1.0", test_lerp_one),
		("lerp 0.5", test_lerp_half),
		("to_list", test_to_list),
		("to_list values", test_to_list_values),
	],
}
