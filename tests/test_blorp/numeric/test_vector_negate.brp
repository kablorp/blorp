import:
	test: TestSuite


-- Test #11: Unary vector negation
func test_negate_int_vector() -> Bool:
	v: Int[#3] = {1, 2, 3}
	neg: Int[#3] = -v
	neg[0] == -1 and neg[1] == -2 and neg[2] == -3


func test_negate_float_vector() -> Bool:
	v: Float[#2] = {3.5, -4.0}
	neg: Float[#2] = -v
	x: Float = neg[0]
	y: Float = neg[1]
	x == -3.5 and y == 4.0


func test_double_negate() -> Bool:
	v: Int[#3] = {10, 20, 30}
	result: Int[#3] = -(-v)
	result[0] == 10 and result[1] == 20 and result[2] == 30


tests: TestSuite = {
	description = "Vector negation",
	tests = [
		("negate int vector", test_negate_int_vector),
		("negate float vector", test_negate_float_vector),
		("double negate", test_double_negate),
	]
}
