-- Runtime tests for negative indexing
import:
	matrix: set_cell
	tensor: set_index
	test: TestSuite


struct NegativeIndexPoint {
	value: Int
}


-- v[-1] accesses last element
pure func test_last() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	v[-1] == 50


-- v[-5] accesses first element
pure func test_first_neg() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	v[-5] == 10


-- v[-2] accesses second to last
pure func test_second_to_last() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	v[-2] == 40


-- Mixed positive and negative
pure func test_mixed() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	v[0] == v[-5] and v[4] == v[-1] and v[2] == v[-3]


-- Float vector
pure func test_float() -> Bool:
	v: Float[#3] = {1.5, 2.5, 3.5}
	v[-1] == 3.5


pure func test_sized_float_read_write() -> Bool:
	var float32_values: Float32[#3] = vector(0.0, 3)
	var float16_values: Float16[#3] = vector(0.0, 3)
	float32_values[-1] = to_float32(3.5)
	float16_values[-1] = to_float16(2.5)

	float32_values[-1] == to_float32(3.5) and float16_values[-1] == to_float16(2.5)


pure func generic_last[#N](values: Int[#N]) -> Int:
	values[-1]


pure func test_generic_dimension() -> Bool:
	values: Int[#4] = {3, 6, 9, 12}
	generic_last(values) == 12


pure func generic_last_point[#N](values: NegativeIndexPoint[#N]) -> Int:
	values[-1].value


pure func test_generic_inline_struct_dimension() -> Bool:
	values: NegativeIndexPoint[#3] = {{value = 3}, {value = 6}, {value = 9}}
	generic_last_point(values) == 9


pure func generic_matrix_edges[#M, #N](values: Int[#M, #N]) -> Bool:
	values[-1, 0] == 40 and values[0, -1] == 30 and values[-1, -1] == 60


pure func test_matrix_axes_use_their_own_dimensions() -> Bool:
	values: Int[#2, #3] = {
		{10, 20, 30},
		{40, 50, 60},
	}
	generic_matrix_edges(values)


pure func generic_last_tensor3[#A, #B, #C](values: Int[#A, #B, #C]) -> Int:
	values[-1, -1, -1]


pure func test_ranked_tensor_axes_use_their_own_dimensions() -> Bool:
	values: Int[#2, #2, #2] = {
		{
			{1, 2},
			{3, 4},
		},
		{
			{5, 6},
			{7, 8},
		},
	}
	generic_last_tensor3(values) == 8


pure func test_rank_five_read() -> Bool:
	values: Int[#2, #1, #1, #1, #2] = tensor5(8, 2, 1, 1, 1, 2)
	values[-1, -1, -1, -1, -1] == 8


pure func generic_last_row[#M, #N](values: Int[#M, #N]) -> Int[#N]:
	values[-1]


pure func test_generic_row_peel() -> Bool:
	values: Int[#2, #3] = {
		{10, 20, 30},
		{40, 50, 60},
	}
	row = generic_last_row(values)
	row[0] == 40 and row[2] == 60


pure func make_string_matrix() -> String[#2, #2]:
	{
		{"one", "two"},
		{"three", "four"},
	}


pure func test_temporary_managed_row() -> Bool:
	make_string_matrix()[-1][-1] == "four"


pure func replace_last[#N](values: Int[#N], replacement: Int) -> Int[#N]:
	var result = values
	result[-1] = replacement
	result


pure func replace_last_cell[#M, #N](values: Int[#M, #N], replacement: Int) -> Int[#M, #N]:
	var result = values
	result[-1, -1] = replacement
	result


pure func replace_last_string[#N](values: String[#N], replacement: String) -> String[#N]:
	var result = values
	result[-1] = replacement
	result


pure func test_negative_assignment() -> Bool:
	vector: Int[#3] = {1, 2, 3}
	matrix_values: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	strings: String[#3] = {"one", "two", "three"}
	updated_vector = replace_last(vector, 9)
	updated_matrix = replace_last_cell(matrix_values, 12)
	updated_strings = replace_last_string(strings, "last")

	updated_vector[2] == 9 and updated_matrix[1, 2] == 12 and updated_strings[2] == "last"


pure func test_self_alias_assignment() -> Bool:
	var vector: String[#3] = {"one", "two", "three"}
	var matrix_values: String[#2, #2] = {
		{"one", "two"},
		{"three", "four"},
	}
	vector[-1] = vector[-1]
	matrix_values[-1, -1] = matrix_values[-1, -1]
	vector[-1] == "three" and matrix_values[-1, -1] == "four"


pure func test_self_alias_functional_updates() -> Bool:
	vector: String[#3] = {"one", "two", "three"}
	matrix_values: String[#2, #2] = {
		{"one", "two"},
		{"three", "four"},
	}

	vector_ok = match set_index(vector, 2, vector[2]):
		Some(updated):
			updated[2] == "three"
		None:
			False

	updated_matrix = set_cell(matrix_values, 1, 1, matrix_values[1, 1])

	vector_ok and updated_matrix[1, 1] == "four"


tests: TestSuite = {
	description = "Negative indexing: runtime",
	tests = [
		("last element", test_last),
		("first via negative", test_first_neg),
		("second to last", test_second_to_last),
		("mixed positive negative", test_mixed),
		("float vector", test_float),
		("sized float read and write", test_sized_float_read_write),
		("generic dimension", test_generic_dimension),
		("generic inline struct dimension", test_generic_inline_struct_dimension),
		("matrix axes use their own dimensions", test_matrix_axes_use_their_own_dimensions),
		(
			"ranked tensor axes use their own dimensions",
			test_ranked_tensor_axes_use_their_own_dimensions,
		),
		("rank five read", test_rank_five_read),
		("generic row peel", test_generic_row_peel),
		("temporary managed row", test_temporary_managed_row),
		("negative assignment", test_negative_assignment),
		("self-alias assignment", test_self_alias_assignment),
		("self-alias functional updates", test_self_alias_functional_updates),
	]
}
