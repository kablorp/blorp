-- Test that multiply works at runtime
import:
	float: to_float16, to_float32
	matrix: multiply
	test: TestSuite


func test_multiply_int() -> Bool:
	a: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	b: Int[#2, #2] = {
		{5, 6},
		{7, 8},
	}
	c: Int[#2, #2] = multiply(a, b)
	c[0, 0] == 19 and c[0, 1] == 22 and c[1, 0] == 43 and c[1, 1] == 50


func test_multiply_float() -> Bool:
	a: Float[#2, #2] = {
		{1.0, 2.0},
		{3.0, 4.0},
	}
	b: Float[#2, #2] = {
		{5.0, 6.0},
		{7.0, 8.0},
	}
	c: Float[#2, #2] = multiply(a, b)
	c[0, 0] == 19.0 and c[0, 1] == 22.0 and c[1, 0] == 43.0 and c[1, 1] == 50.0


func test_multiply_float32() -> Bool:
	a: Float32[#2, #2] = {
		{to_float32(1.0), to_float32(2.0)},
		{to_float32(3.0), to_float32(4.0)},
	}
	b: Float32[#2, #2] = {
		{to_float32(5.0), to_float32(6.0)},
		{to_float32(7.0), to_float32(8.0)},
	}
	c: Float32[#2, #2] = multiply(a, b)
	c[0, 0] == to_float32(
		19.0,
	) and c[0, 1] == to_float32(
		22.0,
	) and c[1, 0] == to_float32(43.0) and c[1, 1] == to_float32(50.0)


func test_multiply_float16() -> Bool:
	a: Float16[#2, #2] = {
		{to_float16(1.0), to_float16(2.0)},
		{to_float16(3.0), to_float16(4.0)},
	}
	b: Float16[#2, #2] = {
		{to_float16(5.0), to_float16(6.0)},
		{to_float16(7.0), to_float16(8.0)},
	}
	c: Float16[#2, #2] = multiply(a, b)
	c[0, 0] == to_float16(
		19.0,
	) and c[0, 1] == to_float16(
		22.0,
	) and c[1, 0] == to_float16(43.0) and c[1, 1] == to_float16(50.0)


tests: TestSuite = {
	description = "Matrix Multiplication",
	tests = [
		("multiply int 2x2", test_multiply_int),
		("multiply float 2x2", test_multiply_float),
		("multiply float32 2x2", test_multiply_float32),
		("multiply float16 2x2", test_multiply_float16),
	]
}
