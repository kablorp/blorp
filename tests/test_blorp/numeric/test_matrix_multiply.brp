-- Test that matrix_multiply works at runtime
import:
	float: to_float32
	matrix: matrix_multiply
	test: TestSuite


func test_matrix_multiply_int() -> Bool:
	a: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	b: Int[#2, #2] = {
		{5, 6},
		{7, 8},
	}
	c: Int[#2, #2] = matrix_multiply(a, b)
	c[0, 0] == 19 and c[0, 1] == 22 and c[1, 0] == 43 and c[1, 1] == 50


func test_matrix_multiply_float() -> Bool:
	a: Float[#2, #2] = {
		{1.0, 2.0},
		{3.0, 4.0},
	}
	b: Float[#2, #2] = {
		{5.0, 6.0},
		{7.0, 8.0},
	}
	c: Float[#2, #2] = matrix_multiply(a, b)
	c[0, 0] == 19.0 and c[0, 1] == 22.0 and c[1, 0] == 43.0 and c[1, 1] == 50.0


func test_matrix_multiply_float32() -> Bool:
	a: Float32[#2, #2] = {
		{to_float32(1.0), to_float32(2.0)},
		{to_float32(3.0), to_float32(4.0)},
	}
	b: Float32[#2, #2] = {
		{to_float32(5.0), to_float32(6.0)},
		{to_float32(7.0), to_float32(8.0)},
	}
	c: Float32[#2, #2] = matrix_multiply(a, b)
	c[0, 0] == to_float32(
		19.0,
	) and c[0, 1] == to_float32(
		22.0,
	) and c[1, 0] == to_float32(43.0) and c[1, 1] == to_float32(50.0)


tests: TestSuite = {
	description = "Matrix Multiplication",
	tests = [
		("matrix_multiply int 2x2", test_matrix_multiply_int),
		("matrix_multiply float 2x2", test_matrix_multiply_float),
		("matrix_multiply float32 2x2", test_matrix_multiply_float32),
	],
}
