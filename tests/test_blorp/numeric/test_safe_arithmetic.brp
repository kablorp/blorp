import:
	test: TestSuite


-- Test safe arithmetic
-- blorp uses safe-by-default arithmetic:
-- - Integer overflow wraps (two's complement via -fwrapv)
-- - Division/modulo by zero returns 0
-- - Division/modulo by zero returns 0
-- ============================================================================
-- Integer overflow wrapping (two's complement)
-- ============================================================================
-- Addition overflow wraps to negative (two's complement)
func test_add_overflow() -> Bool:
	-- 9e18 + 9e18 = 18e18, which exceeds 2^63-1 (9.22e18)
	big: Int = 1000000000 * 1000000000 * 9
	result: Int = big + big
	-- Must wrap to a negative value (two's complement)
	result < 0


-- Subtraction underflow wraps to positive
func test_sub_underflow() -> Bool:
	big: Int = 1000000000 * 1000000000 * 9
	neg_big: Int = -big
	result: Int = neg_big - big
	-- -9e18 - 9e18 = -18e18, underflows, wraps to positive
	result > 0


-- Multiplication overflow wraps to negative
func test_mul_overflow() -> Bool:
	-- 3037000500^2 overflows (just past sqrt(2^63-1) = 3037000499)
	big: Int = 3037000500
	result: Int = big * big
	-- Must wrap to a negative value
	result < 0


-- Normal addition works
func test_add_normal() -> Bool:
	100 + 200 == 300


-- Normal subtraction works
func test_sub_normal() -> Bool:
	300 - 100 == 200


-- Normal multiplication works
func test_mul_normal() -> Bool:
	15 * 20 == 300


-- Negative addition
func test_add_negative() -> Bool:
	-10 + -20 == -30


-- Subtraction producing negative
func test_sub_negative() -> Bool:
	10 - 20 == -10


-- Multiplication with negatives
func test_mul_negative() -> Bool:
	-5 * 6 == -30


-- ============================================================================
-- Division/mod (returns 0 on divide-by-zero)
-- ============================================================================
-- div works for normal values
func test_div() -> Bool:
	10 / 2 == 5


-- mod works for normal values
func test_mod() -> Bool:
	10 % 3 == 1


-- ============================================================================
-- Test Suite
-- ============================================================================
tests: TestSuite = {
	description = "Safe Arithmetic",
	tests = [
		("add overflow wraps", test_add_overflow),
		("sub underflow wraps", test_sub_underflow),
		("mul overflow wraps", test_mul_overflow),
		("normal addition", test_add_normal),
		("normal subtraction", test_sub_normal),
		("normal multiplication", test_mul_normal),
		("negative addition", test_add_negative),
		("subtraction to negative", test_sub_negative),
		("multiply with negatives", test_mul_negative),
		("div", test_div),
		("mod", test_mod),
	],
}
