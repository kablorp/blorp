-- Phase 4.2 shadow regression: a user function named like a built-in
-- element-wise math function must NOT be silently rewritten to the
-- built-in runtime call.
import:
	test: TestSuite


-- User-defined tensor function with the SAME NAME as a stdlib scalar
-- elementwise function. The stdlib 'sqrt' has signature (Float) -> Float;
-- this user 'sqrt' has signature (...) -> .... It must run
-- instead of the blorp_vector_sqrt rewrite.
pure func sqrt[#N](v: Float[#N]) -> Float[#N]:
	-- Return the input unchanged, not the element-wise square-root.
	v


func test_user_sqrt_wins() -> Bool:
	v: Float[#3] = {4.0, 9.0, 16.0}
	out: Float[#3] = sqrt(v)

	-- If blorp_vector_sqrt ran, out would be {2.0, 3.0, 4.0}.
	-- If user sqrt ran (identity), out would be {4.0, 9.0, 16.0}.
	out[0] == 4.0 and out[1] == 9.0 and out[2] == 16.0


tests: TestSuite = {
	description = "user function shadows stdlib elementwise name",
	tests = [("user sqrt identity wins", test_user_sqrt_wins)]
}
