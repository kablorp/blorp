import:
	float: approx_eq, clamp, lerp
	math: PI
	test: TestSuite
	vector: argmax, argmin, cross, cumulative_sum


func test_argmax_int() -> Bool:
	v: Int[#4] = {3, 7, 1, 5}
	argmax(v) == 1


func test_argmin_int() -> Bool:
	v: Int[#4] = {3, 7, 1, 5}
	argmin(v) == 2


func test_cumulative_sum_int() -> Bool:
	v: Int[#4] = {1, 2, 3, 4}
	cs: Int[#4] = cumulative_sum(v)
	cs[0] == 1 and cs[1] == 3 and cs[2] == 6 and cs[3] == 10


func test_cross() -> Bool:
	a: Float[#3] = {1.0, 0.0, 0.0}
	b: Float[#3] = {0.0, 1.0, 0.0}
	c: Float[#3] = cross(a, b)
	x: Float = c[0]
	y: Float = c[1]
	z: Float = c[2]
	approx_eq(x, 0.0) and approx_eq(y, 0.0) and approx_eq(z, 1.0)


func test_pi() -> Bool:
	approx_eq(PI, 3.141592653589793)


func test_lerp() -> Bool:
	approx_eq(lerp(0.0, 10.0, 0.5), 5.0) and approx_eq(lerp(0.0, 10.0, 0.0), 0.0)


func test_clamp() -> Bool:
	approx_eq(
		clamp(
			5.0,
			0.0,
			10.0,
		),
		5.0,
	) and approx_eq(clamp(-1.0, 0.0, 10.0), 0.0) and approx_eq(clamp(15.0, 0.0, 10.0), 10.0)


tests: TestSuite = {
	description = "New vector/math operations",
	tests = [
		("argmax int", test_argmax_int),
		("argmin int", test_argmin_int),
		("cumulative_sum int", test_cumulative_sum_int),
		("cross product", test_cross),
		("pi", test_pi),
		("lerp", test_lerp),
		("clamp", test_clamp),
	]
}
