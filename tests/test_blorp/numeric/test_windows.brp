import:
	list: append
	tensor: windows
	test: TestSuite


func test_windows_basic() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	var sums: List[Int] = []
	for w in windows(v, 3):
		sums = sums.append(w[0] + w[1] + w[2])
	sums == [60, 90, 120]


func test_windows_float() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	var avgs: List[Float] = []
	for w in windows(v, 2):
		avgs = avgs.append((w[0] + w[1]) / 2.0)
	avgs == [1.5, 2.5, 3.5]


func test_windows_single() -> Bool:
	v: Int[#3] = {1, 2, 3}
	var result: List[Int] = []
	for w in windows(v, 1):
		result = result.append(w[0])
	result == [1, 2, 3]


func test_windows_full_size() -> Bool:
	v: Int[#3] = {1, 2, 3}
	var result: Int = 0
	for w in windows(v, 3):
		result = w[0] + w[1] + w[2]
	result == 6


func test_windows_length() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	var count: Int = 0
	for w in windows(v, 3):
		count += w.length()
	count == 9


tests: TestSuite = {
	description = "Windows Loop Combinator",
	tests = [
		("basic int windows", test_windows_basic),
		("float windows", test_windows_float),
		("single element windows", test_windows_single),
		("full size window", test_windows_full_size),
		("window length", test_windows_length),
	]
}
