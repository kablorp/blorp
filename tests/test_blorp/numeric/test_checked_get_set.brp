import:
	test: TestSuite


func test_checked_get_int() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	checked_get(v, 0) == 10 and checked_get(v, 4) == 50


func test_checked_get_float() -> Bool:
	v: Float[#3] = {1.5, 2.5, 3.5}
	checked_get(v, 1) == 2.5


func test_checked_set_int() -> Bool:
	v: Int[#3] = {1, 2, 3}
	w: Int[#3] = checked_set(v, 0, 99)
	w[0] == 99 and w[1] == 2 and w[2] == 3


func test_checked_set_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	w: Float[#3] = checked_set(v, 1, 9.5)
	w[0] == 1.0 and w[1] == 9.5 and w[2] == 3.0 and v[1] == 2.0


func test_checked_set_cow() -> Bool:
	v: Int[#3] = {1, 2, 3}
	w: Int[#3] = checked_set(v, 0, 99)
	v[0] == 1 and w[0] == 99


func test_checked_slice() -> Bool:
	v: Int[#5] = {10, 20, 30, 40, 50}
	s: Int[#3] = checked_slice(v, 1, 4)
	s[0] == 20 and s[1] == 30 and s[2] == 40


func test_matrix_checked_get() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	matrix_checked_get(m, 0, 1) == 2 and matrix_checked_get(m, 1, 2) == 6


func test_matrix_checked_get_float() -> Bool:
	m: Float[#2, #2] = {
		{1.5, 2.5},
		{3.5, 4.5},
	}
	matrix_checked_get(m, 0, 0) == 1.5 and matrix_checked_get(m, 1, 1) == 4.5


func test_matrix_checked_set_float() -> Bool:
	m: Float[#2, #2] = matrix(0.0, 2, 2)
	n: Float[#2, #2] = matrix_checked_set(m, 1, 0, 3.25)
	n[1, 0] == 3.25 and m[1, 0] == 0.0


func test_subscript_is_checked_get() -> Bool:
	v: Int[#4] = {5, 10, 15, 20}
	v[0] == checked_get(v, 0) and v[3] == checked_get(v, 3)


func test_multi_index_is_matrix_checked_get() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	m[0, 1] == 2 and m[1, 2] == 6


func test_subscript_assign_is_checked_set() -> Bool:
	var v: Int[#3] = {1, 2, 3}
	v[1] = 42
	w: Int[#3] = checked_set({1, 2, 3}, 1, 42)
	v[0] == w[0] and v[1] == w[1] and v[2] == w[2]


func test_2d_nested_loop() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	var sum: Int = 0
	for i in 0..length(m):
		for j in 0..length(m[i]):
			sum += m[i][j]
	sum == 21


func test_proven_loop_checked_get() -> Bool:
	v: Int[#4] = {10, 20, 30, 40}
	var sum: Int = 0
	for i in 0..length(v):
		sum += checked_get(v, i)
	sum == 100


tests: TestSuite = {
	description = "checked_get/set/slice Tests",
	tests = [
		("checked_get int", test_checked_get_int),
		("checked_get float", test_checked_get_float),
		("checked_set int", test_checked_set_int),
		("checked_set float", test_checked_set_float),
		("checked_set cow", test_checked_set_cow),
		("checked_slice", test_checked_slice),
		("matrix_checked_get", test_matrix_checked_get),
		("matrix_checked_get float", test_matrix_checked_get_float),
		("matrix_checked_set float", test_matrix_checked_set_float),
		("subscript == checked_get", test_subscript_is_checked_get),
		("multi-index == matrix_checked_get", test_multi_index_is_matrix_checked_get),
		("subscript assign == checked_set", test_subscript_assign_is_checked_set),
		("2d nested loop", test_2d_nested_loop),
		("proven loop checked_get", test_proven_loop_checked_get),
	]
}
