-- Deterministic test: Vectors, matrices, math, safe arithmetic
import:
	float: approx_eq, ceil, cos, exp, floor, log, pi, pow, round, sin, sqrt
	tensor: get, length, set_index
	test: TestSuite
	vector: argmax, argmin, dot, max, mean, min, norm, product, sum


-- Vector literal (brace syntax)
func test_vector_literal() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	v[0] == 1 and v[4] == 5


-- Vector zeros
func test_vector_zeros() -> Bool:
	v: Int[#3] = {0, 0, 0}
	v[0] == 0 and v[1] == 0 and v[2] == 0


-- Vector length
func test_vector_length() -> Bool:
	v: Int[#4] = {10, 20, 30, 40}
	v.length() == 4


-- Vector get (safe)
func test_vector_get() -> Bool:
	v: Int[#3] = {10, 20, 30}
	match get(v, 1):
		Some(val): val == 20
		None: False
	and match get(v, 10):
		Some(_): False
		None: True


-- Vector set_index
func test_vector_set_index() -> Bool:
	v: Int[#3] = {1, 2, 3}
	match v.set_index(1, 99):
		Some(updated): updated[1] == 99
		None: False


-- Vector sum
func test_vector_sum() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	sum(v) == 15


-- Vector product
func test_vector_product() -> Bool:
	v: Int[#4] = {1, 2, 3, 4}
	product(v) == 24


-- Vector max/min
func test_vector_max_min() -> Bool:
	v: Int[#5] = {3, 1, 4, 1, 5}
	max(v) == 5 and min(v) == 1


-- Vector mean
func test_vector_mean() -> Bool:
	v: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	approx_eq(mean(v), 2.5)


-- Vector dot product
func test_vector_dot() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	dot(a, b) == 32


-- Vector argmax/argmin
func test_vector_argmax() -> Bool:
	v: Int[#4] = {10, 40, 20, 30}
	argmax(v) == 1 and argmin(v) == 0


-- Element-wise arithmetic
func test_vector_elementwise() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	c: Int[#3] = a + b
	c[0] == 5 and c[1] == 7 and c[2] == 9


-- Scalar broadcast
func test_vector_scalar() -> Bool:
	v: Int[#3] = {10, 20, 30}
	doubled: Int[#3] = v * 2
	doubled[0] == 20 and doubled[1] == 40 and doubled[2] == 60


-- Vector subtraction
func test_vector_sub() -> Bool:
	a: Int[#3] = {10, 20, 30}
	b: Int[#3] = {1, 2, 3}
	c: Int[#3] = a - b
	c[0] == 9 and c[1] == 18 and c[2] == 27


-- Float norm
func test_vector_norm() -> Bool:
	v: Float[#3] = {3.0, 4.0, 0.0}
	approx_eq(norm(v), 5.0)


-- Float math: sqrt, pow
func test_float_math() -> Bool:
	sqrt(4.0) == 2.0 and pow(2.0, 3.0) == 8.0 and sqrt(9.0) == 3.0


-- Trig functions
func test_trig() -> Bool:
	approx_eq(sin(0.0), 0.0) and approx_eq(cos(0.0), 1.0)


-- Rounding
func test_rounding() -> Bool:
	floor(3.7) == 3.0 and ceil(3.2) == 4.0 and round(3.5) == 4.0


-- exp / log
func test_exp_log() -> Bool:
	approx_eq(exp(0.0), 1.0) and approx_eq(log(1.0), 0.0)


-- Pi constant
func test_pi() -> Bool:
	pi() > 3.14 and pi() < 3.15


-- Safe division by zero returns 0
func test_safe_div_zero() -> Bool:
	10 / 0 == 0 and 10 % 0 == 0


-- abs for Int (builtin)
func test_abs() -> Bool:
	abs(-5) == 5 and abs(5) == 5 and abs(0) == 0


tests: TestSuite = {
	description = "Deterministic: Vectors and Math",
	tests = [
		("Vector literal", test_vector_literal),
		("Vector zeros", test_vector_zeros),
		("Vector length", test_vector_length),
		("Vector get", test_vector_get),
		("Vector set_index", test_vector_set_index),
		("Vector sum", test_vector_sum),
		("Vector product", test_vector_product),
		("Vector max/min", test_vector_max_min),
		("Vector mean", test_vector_mean),
		("Vector dot", test_vector_dot),
		("Vector argmax/argmin", test_vector_argmax),
		("Element-wise arithmetic", test_vector_elementwise),
		("Scalar broadcast", test_vector_scalar),
		("Vector subtraction", test_vector_sub),
		("Vector norm", test_vector_norm),
		("Float math", test_float_math),
		("Trig functions", test_trig),
		("Rounding", test_rounding),
		("exp/log", test_exp_log),
		("Pi constant", test_pi),
		("Safe div zero", test_safe_div_zero),
		("abs", test_abs),
	],
}
