import:
	option: get_or
	tensor as T
	test: TestSuite
	vector: dot, exp, log, max, min, norm, sum


-- Float16 vector operation tests
-- ============================================================================
-- Factory and element access
-- ============================================================================
func test_zeros_float16() -> Bool:
	v: Float16[#4] = vector(0.0, 4)
	s: Float16 = sum(v)
	s == to_float16(0.0)


func test_set_get_index() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(1.5)):
		Some(v2): v = v2
		None: void
	match T.set_index(v, 1, to_float16(2.5)):
		Some(v2): v = v2
		None: void
	val0: Float16 = get_or(T.get(v, 0), to_float16(0.0))
	val1: Float16 = get_or(T.get(v, 1), to_float16(0.0))
	val0 == to_float16(1.5) and val1 == to_float16(2.5)


-- ============================================================================
-- Arithmetic operations
-- ============================================================================
func test_vector_add() -> Bool:
	var a: Float16[#4] = vector(0.0, 4)
	var b: Float16[#4] = vector(0.0, 4)
	match T.set_index(a, 0, to_float16(1.0)):
		Some(v): a = v
		None: void
	match T.set_index(a, 1, to_float16(2.0)):
		Some(v): a = v
		None: void
	match T.set_index(b, 0, to_float16(3.0)):
		Some(v): b = v
		None: void
	match T.set_index(b, 1, to_float16(4.0)):
		Some(v): b = v
		None: void
	c: Float16[#4] = a + b
	val0: Float16 = get_or(T.get(c, 0), to_float16(0.0))
	val1: Float16 = get_or(T.get(c, 1), to_float16(0.0))
	val0 == to_float16(4.0) and val1 == to_float16(6.0)


func test_vector_sub() -> Bool:
	var a: Float16[#4] = vector(0.0, 4)
	var b: Float16[#4] = vector(0.0, 4)
	match T.set_index(a, 0, to_float16(5.0)):
		Some(v): a = v
		None: void
	match T.set_index(b, 0, to_float16(3.0)):
		Some(v): b = v
		None: void
	c: Float16[#4] = a - b
	val0: Float16 = get_or(T.get(c, 0), to_float16(0.0))
	val0 == to_float16(2.0)


func test_vector_mul() -> Bool:
	var a: Float16[#4] = vector(0.0, 4)
	var b: Float16[#4] = vector(0.0, 4)
	match T.set_index(a, 0, to_float16(2.0)):
		Some(v): a = v
		None: void
	match T.set_index(b, 0, to_float16(3.0)):
		Some(v): b = v
		None: void
	c: Float16[#4] = a * b
	val0: Float16 = get_or(T.get(c, 0), to_float16(0.0))
	val0 == to_float16(6.0)


func test_vector_div() -> Bool:
	var a: Float16[#4] = vector(0.0, 4)
	var b: Float16[#4] = vector(0.0, 4)
	match T.set_index(a, 0, to_float16(6.0)):
		Some(v): a = v
		None: void
	match T.set_index(b, 0, to_float16(3.0)):
		Some(v): b = v
		None: void
	c: Float16[#4] = a / b
	val0: Float16 = get_or(T.get(c, 0), to_float16(0.0))
	val0 == to_float16(2.0)


-- ============================================================================
-- Scalar operations
-- ============================================================================
func test_scalar_mul() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(2.0)):
		Some(r): v = r
		None: void
	match T.set_index(v, 1, to_float16(3.0)):
		Some(r): v = r
		None: void
	result: Float16[#4] = v * to_float16(2.0)
	val0: Float16 = get_or(T.get(result, 0), to_float16(0.0))
	val1: Float16 = get_or(T.get(result, 1), to_float16(0.0))
	val0 == to_float16(4.0) and val1 == to_float16(6.0)


func test_scalar_add() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(1.0)):
		Some(r): v = r
		None: void
	result: Float16[#4] = v + to_float16(10.0)
	val0: Float16 = get_or(T.get(result, 0), to_float16(0.0))
	val1: Float16 = get_or(T.get(result, 1), to_float16(0.0))
	val0 == to_float16(11.0) and val1 == to_float16(10.0)


func test_rev_scalar_sub() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(3.0)):
		Some(r): v = r
		None: void
	result: Float16[#4] = to_float16(10.0) - v
	val0: Float16 = get_or(T.get(result, 0), to_float16(0.0))
	val1: Float16 = get_or(T.get(result, 1), to_float16(0.0))
	val0 == to_float16(7.0) and val1 == to_float16(10.0)


-- ============================================================================
-- Reductions
-- ============================================================================
func test_sum() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(1.0)):
		Some(r): v = r
		None: void
	match T.set_index(v, 1, to_float16(2.0)):
		Some(r): v = r
		None: void
	match T.set_index(v, 2, to_float16(3.0)):
		Some(r): v = r
		None: void
	s: Float16 = sum(v)
	s == to_float16(6.0)


func test_max() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(1.0)):
		Some(r): v = r
		None: void
	match T.set_index(v, 1, to_float16(5.0)):
		Some(r): v = r
		None: void
	match T.set_index(v, 2, to_float16(3.0)):
		Some(r): v = r
		None: void
	m: Float16 = max(v)
	m == to_float16(5.0)


func test_min() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(5.0)):
		Some(r): v = r
		None: void
	match T.set_index(v, 1, to_float16(1.0)):
		Some(r): v = r
		None: void
	match T.set_index(v, 2, to_float16(3.0)):
		Some(r): v = r
		None: void
	match T.set_index(v, 3, to_float16(7.0)):
		Some(r): v = r
		None: void
	m: Float16 = min(v)
	m == to_float16(1.0)


func test_dot() -> Bool:
	var a: Float16[#4] = vector(0.0, 4)
	var b: Float16[#4] = vector(0.0, 4)
	match T.set_index(a, 0, to_float16(1.0)):
		Some(r): a = r
		None: void
	match T.set_index(a, 1, to_float16(2.0)):
		Some(r): a = r
		None: void
	match T.set_index(b, 0, to_float16(3.0)):
		Some(r): b = r
		None: void
	match T.set_index(b, 1, to_float16(4.0)):
		Some(r): b = r
		None: void
	d: Float16 = dot(a, b)
	d == to_float16(11.0)


-- ============================================================================
-- Math operations
-- ============================================================================
func test_norm() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(3.0)):
		Some(r): v = r
		None: void
	match T.set_index(v, 1, to_float16(4.0)):
		Some(r): v = r
		None: void
	n: Float16 = norm(v)
	n == to_float16(5.0)


func test_exp() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	result: Float16[#4] = exp(v)
	val0: Float16 = get_or(T.get(result, 0), to_float16(0.0))
	val0 == to_float16(1.0)


func test_log() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(1.0)):
		Some(r): v = r
		None: void
	result: Float16[#4] = log(v)
	val0: Float16 = get_or(T.get(result, 0), to_float16(0.0))
	val0 == to_float16(0.0)


-- ============================================================================
-- Equality
-- ============================================================================
func test_equality() -> Bool:
	var a: Float16[#4] = vector(0.0, 4)
	var b: Float16[#4] = vector(0.0, 4)
	match T.set_index(a, 0, to_float16(1.0)):
		Some(r): a = r
		None: void
	match T.set_index(b, 0, to_float16(1.0)):
		Some(r): b = r
		None: void
	a == b


func test_inequality() -> Bool:
	var a: Float16[#4] = vector(0.0, 4)
	var b: Float16[#4] = vector(0.0, 4)
	match T.set_index(a, 0, to_float16(1.0)):
		Some(r): a = r
		None: void
	match T.set_index(b, 0, to_float16(2.0)):
		Some(r): b = r
		None: void
	a != b


-- ============================================================================
-- Negation
-- ============================================================================
func test_negate() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(3.0)):
		Some(r): v = r
		None: void
	neg: Float16[#4] = -v
	val0: Float16 = get_or(T.get(neg, 0), to_float16(0.0))
	val0 == to_float16(-3.0)


-- ============================================================================
-- COW self-assignment
-- ============================================================================
func test_cow_self_add() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	match T.set_index(v, 0, to_float16(1.0)):
		Some(r): v = r
		None: void
	var inc: Float16[#4] = vector(0.0, 4)
	match T.set_index(inc, 0, to_float16(2.0)):
		Some(r): inc = r
		None: void
	v += inc
	val0: Float16 = get_or(T.get(v, 0), to_float16(0.0))
	val0 == to_float16(3.0)


func test_cow_exp() -> Bool:
	var v: Float16[#4] = vector(0.0, 4)
	v = exp(v)
	val0: Float16 = get_or(T.get(v, 0), to_float16(0.0))
	val0 == to_float16(1.0)


-- ============================================================================
-- TestSuite
-- ============================================================================
tests: TestSuite = {
	description = "Float16 Vector Operations",
	tests = [
		("zeros Float16", test_zeros_float16),
		("set/get index", test_set_get_index),
		("vector add", test_vector_add),
		("vector sub", test_vector_sub),
		("vector mul", test_vector_mul),
		("vector div", test_vector_div),
		("scalar mul", test_scalar_mul),
		("scalar add", test_scalar_add),
		("rev scalar sub", test_rev_scalar_sub),
		("sum", test_sum),
		("max", test_max),
		("min", test_min),
		("dot", test_dot),
		("norm", test_norm),
		("exp", test_exp),
		("log", test_log),
		("equality", test_equality),
		("inequality", test_inequality),
		("negate", test_negate),
		("cow self-add", test_cow_self_add),
		("cow exp", test_cow_exp),
	]
}
