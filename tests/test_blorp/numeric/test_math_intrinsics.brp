import:
	float: cbrt, copysign, fma, fmod, hypot
	test: TestSuite


func test_sqrt() -> Bool:
	sqrt(4.0) == 2.0 and sqrt(9.0) == 3.0 and sqrt(0.0) == 0.0


func test_pow() -> Bool:
	pow(2.0, 3.0) == 8.0 and pow(10.0, 0.0) == 1.0


func test_trig() -> Bool:
	sin(0.0) == 0.0 and cos(0.0) == 1.0


func test_floor_ceil() -> Bool:
	floor(3.7) == 3.0 and ceil(3.2) == 4.0


func test_round_trunc() -> Bool:
	round(3.5) == 4.0 and trunc(3.9) == 3.0


func test_exp_log() -> Bool:
	exp(0.0) == 1.0 and log(1.0) == 0.0


func test_hyperbolic() -> Bool:
	sinh(0.0) == 0.0 and cosh(0.0) == 1.0 and tanh(0.0) == 0.0


func test_is_nan() -> Bool:
	not is_nan(1.0) and is_nan(0.0 / 0.0)


func test_is_finite() -> Bool:
	is_finite(1.0) and not is_finite(1.0 / 0.0)


func test_atan2() -> Bool:
	atan2(0.0, 1.0) == 0.0


func test_fma() -> Bool:
	fma(2.0, 3.0, 4.0) == 10.0


func test_cbrt() -> Bool:
	cbrt(27.0) == 3.0


func test_log2_log10() -> Bool:
	log2(8.0) == 3.0 and log10(1000.0) == 3.0


func test_copysign() -> Bool:
	copysign(3.0, -1.0) == -3.0 and copysign(-3.0, 1.0) == 3.0


func test_fmod() -> Bool:
	fmod(10.0, 3.0) == 1.0


func test_hypot() -> Bool:
	hypot(3.0, 4.0) == 5.0


-- Float32 tests (cast-through-Float64 path)
func test_sqrt_f32() -> Bool:
	x: Float32 = 4.0.to_float32()
	result: Float32 = sqrt(x)
	result == 2.0.to_float32()


func test_sin_f32() -> Bool:
	x: Float32 = 0.0.to_float32()
	result: Float32 = sin(x)
	result == 0.0.to_float32()


func test_floor_f32() -> Bool:
	x: Float32 = 3.7.to_float32()
	result: Float32 = floor(x)
	result == 3.0.to_float32()


func test_pow_f32() -> Bool:
	a: Float32 = 2.0.to_float32()
	b: Float32 = 3.0.to_float32()
	result: Float32 = pow(a, b)
	result == 8.0.to_float32()


func test_is_nan_f32() -> Bool:
	x: Float32 = 1.0.to_float32()
	not is_nan(x)


-- Float16 tests
func test_sqrt_f16() -> Bool:
	x: Float16 = 4.0.to_float16()
	result: Float16 = sqrt(x)
	result == 2.0.to_float16()


func test_floor_f16() -> Bool:
	x: Float16 = 3.5.to_float16()
	result: Float16 = floor(x)
	result == 3.0.to_float16()


tests: TestSuite = {
	description = "Math intrinsic tests",
	tests = [
		("sqrt", test_sqrt),
		("pow", test_pow),
		("trig", test_trig),
		("floor/ceil", test_floor_ceil),
		("round/trunc", test_round_trunc),
		("exp/log", test_exp_log),
		("hyperbolic", test_hyperbolic),
		("is_nan", test_is_nan),
		("is_finite", test_is_finite),
		("atan2", test_atan2),
		("fma", test_fma),
		("cbrt", test_cbrt),
		("log2/log10", test_log2_log10),
		("copysign", test_copysign),
		("fmod", test_fmod),
		("hypot", test_hypot),
		("sqrt f32", test_sqrt_f32),
		("sin f32", test_sin_f32),
		("floor f32", test_floor_f32),
		("pow f32", test_pow_f32),
		("is_nan f32", test_is_nan_f32),
		("sqrt f16", test_sqrt_f16),
		("floor f16", test_floor_f16),
	]
}
