import:
	int:
		INT_MAX,
		INT_MIN,
		add_checked,
		add_saturating,
		clamp,
		divide_checked,
		factorial,
		gcd,
		is_even,
		is_odd,
		is_power_of_two,
		lcm,
		mod_checked,
		multiply_checked,
		multiply_saturating,
		next_power_of_two,
		sign,
		subtract_checked,
		subtract_saturating,
	math as M
	result: Result(Ok, Err), is_err
	test: TestSuite


-- Checked arithmetic
func test_divide_checked_ok() -> Bool:
	match divide_checked(10, 3):
		Ok(val): val == 3
		Err(_): False


func test_divide_checked_zero() -> Bool:
	match divide_checked(10, 0):
		Ok(_): False
		Err(e):
			match e:
				M.DivByZero: True
				_: False


func test_mod_checked_ok() -> Bool:
	match mod_checked(10, 3):
		Ok(val): val == 1
		Err(_): False


func test_mod_checked_zero() -> Bool:
	is_err(mod_checked(10, 0))


func test_divide_checked_float() -> Bool:
	match M.divide_checked_float(10.0, 3.0):
		Ok(val): val > 3.3 and val < 3.4
		Err(_): False


func test_add_checked_ok() -> Bool:
	match add_checked(100, 200):
		Ok(val): val == 300
		Err(_): False


func test_add_checked_overflow() -> Bool:
	is_err(add_checked(INT_MAX, 1))


func test_add_checked_underflow() -> Bool:
	is_err(add_checked(INT_MIN, -1))


func test_subtract_checked_ok() -> Bool:
	match subtract_checked(100, 30):
		Ok(val): val == 70
		Err(_): False


func test_subtract_checked_underflow() -> Bool:
	is_err(subtract_checked(INT_MIN, 1))


func test_multiply_checked_ok() -> Bool:
	match multiply_checked(7, 8):
		Ok(val): val == 56
		Err(_): False


func test_multiply_checked_overflow() -> Bool:
	is_err(multiply_checked(INT_MAX, 2))


-- Saturating arithmetic
func test_add_saturating() -> Bool:
	add_saturating(INT_MAX, 1) == INT_MAX


func test_subtract_saturating() -> Bool:
	subtract_saturating(INT_MIN, 1) == INT_MIN


func test_multiply_saturating() -> Bool:
	multiply_saturating(INT_MAX, 2) == INT_MAX


-- Utilities
func test_clamp_in_range() -> Bool:
	clamp(5, 0, 10) == 5


func test_clamp_below() -> Bool:
	clamp(-5, 0, 10) == 0


func test_clamp_above() -> Bool:
	clamp(15, 0, 10) == 10


func test_sign_positive() -> Bool:
	sign(42) == 1


func test_sign_negative() -> Bool:
	sign(-7) == -1


func test_sign_zero() -> Bool:
	sign(0) == 0


func test_is_even() -> Bool:
	is_even(4) and not is_even(3)


func test_is_odd() -> Bool:
	is_odd(3) and not is_odd(4)


-- Number theory
func test_gcd() -> Bool:
	gcd(12, 8) == 4


func test_gcd_coprime() -> Bool:
	gcd(7, 13) == 1


func test_lcm() -> Bool:
	lcm(4, 6) == 12


func test_factorial() -> Bool:
	factorial(5) == 120


func test_factorial_zero() -> Bool:
	factorial(0) == 1


func test_factorial_negative() -> Bool:
	factorial(-1) == 1


func test_gcd_zero() -> Bool:
	gcd(0, 5) == 5 and gcd(5, 0) == 5


func test_is_power_of_two() -> Bool:
	is_power_of_two(8) and not is_power_of_two(6)


func test_next_power_of_two() -> Bool:
	next_power_of_two(5) == 8 and next_power_of_two(8) == 8


tests: TestSuite = {
	description = "Math Module Tests",
	tests = [
		("divide checked ok", test_divide_checked_ok),
		("divide checked zero", test_divide_checked_zero),
		("mod checked ok", test_mod_checked_ok),
		("mod checked zero", test_mod_checked_zero),
		("divide checked float", test_divide_checked_float),
		("add checked ok", test_add_checked_ok),
		("add checked overflow", test_add_checked_overflow),
		("add checked underflow", test_add_checked_underflow),
		("subtract checked ok", test_subtract_checked_ok),
		("subtract checked underflow", test_subtract_checked_underflow),
		("multiply checked ok", test_multiply_checked_ok),
		("multiply checked overflow", test_multiply_checked_overflow),
		("add saturating", test_add_saturating),
		("subtract saturating", test_subtract_saturating),
		("multiply saturating", test_multiply_saturating),
		("clamp in range", test_clamp_in_range),
		("clamp below", test_clamp_below),
		("clamp above", test_clamp_above),
		("sign positive", test_sign_positive),
		("sign negative", test_sign_negative),
		("sign zero", test_sign_zero),
		("is even", test_is_even),
		("is odd", test_is_odd),
		("gcd", test_gcd),
		("gcd coprime", test_gcd_coprime),
		("lcm", test_lcm),
		("factorial", test_factorial),
		("factorial zero", test_factorial_zero),
		("factorial negative", test_factorial_negative),
		("gcd zero", test_gcd_zero),
		("is power of two", test_is_power_of_two),
		("next power of two", test_next_power_of_two),
	],
}
