import:
	float: abs
	math: E, PI, TAU
	test: TestSuite


func test_pi() -> Bool:
	abs(PI - 3.14159265358979) < 0.00001


func test_e() -> Bool:
	abs(E - 2.71828182845904) < 0.00001


func test_tau() -> Bool:
	abs(TAU - 6.28318530717958) < 0.00001


func test_tau_is_2pi() -> Bool:
	abs(TAU - 2.0 * PI) < 0.00001


tests: TestSuite = {
	description = "Math Constants",
	tests = [("PI", test_pi), ("E", test_e), ("TAU", test_tau), ("TAU = 2*PI", test_tau_is_2pi)],
}
