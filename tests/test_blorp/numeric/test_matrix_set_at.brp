import:
	matrix: get_or, set_at
	tensor: matrix
	test: TestSuite


func test_set_at_updates_cell() -> Bool:
	m: Float[#2, #2] = matrix(0.0, 2, 2)
	m2: Float[#2, #2] = set_at(m, 1, 0, 4.5)
	m2.get_or(1, 0, 0.0) == 4.5 and m2.get_or(0, 0, 0.0) == 0.0


func test_set_at_out_of_bounds_is_noop() -> Bool:
	m: Float[#2, #2] = matrix(1.0, 2, 2)
	m2: Float[#2, #2] = set_at(m, 9, 0, 4.5)
	m3: Float[#2, #2] = set_at(m, 0, 5, 4.5)
	row_oob_unchanged: Bool = m2.get_or(0, 0, 0.0) == 1.0 and m2.get_or(1, 1, 0.0) == 1.0
	col_oob_unchanged: Bool = m3.get_or(0, 0, 0.0) == 1.0 and m3.get_or(1, 1, 0.0) == 1.0
	row_oob_unchanged and col_oob_unchanged


tests: TestSuite = {
	description = "Matrix set_at",
	tests = [
		("updates cell", test_set_at_updates_cell),
		("out of bounds is noop", test_set_at_out_of_bounds_is_noop),
	],
}
