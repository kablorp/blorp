import:
	float: approx_eq
	random:
		RngState,
		RngStep,
		rng_bool,
		rng_float,
		rng_int,
		rng_new,
		rng_next,
		rng_next_state,
		rng_state_equal,
		rng_value,
	test: TestSuite


-- Determinism tests
pure func test_rng_deterministic() -> Bool:
	r1: RngStep[Int] = rng_next(rng_new(42))
	r2: RngStep[Int] = rng_next(rng_new(42))
	r1.rng_value() == r2.rng_value() and rng_state_equal(r1.rng_next_state(), r2.rng_next_state())


pure func test_rng_different_seeds() -> Bool:
	r1: RngStep[Int] = rng_next(rng_new(1))
	r2: RngStep[Int] = rng_next(rng_new(2))
	r1.rng_value() != r2.rng_value()


pure func test_rng_sequence() -> Bool:
	s0: RngState = rng_new(42)
	r1: RngStep[Int] = rng_next(s0)
	r2: RngStep[Int] = rng_next(r1.rng_next_state())
	r3: RngStep[Int] = rng_next(r2.rng_next_state())

	-- Each value should be different
	r1.rng_value() != r2.rng_value() and r2.rng_value() != r3.rng_value()


-- Float tests
pure func test_rng_float_range() -> Bool:
	s0: RngState = rng_new(123)
	var state: RngState = s0
	var all_in_range: Bool = True
	for i in 0..100:
		r: RngStep[Float] = rng_float(state)
		if r.rng_value() < 0.0 or r.rng_value() >= 1.0:
			all_in_range = False
		state = r.rng_next_state()
	all_in_range


pure func test_rng_float_deterministic() -> Bool:
	r1: RngStep[Float] = rng_float(rng_new(42))
	r2: RngStep[Float] = rng_float(rng_new(42))
	approx_eq(r1.rng_value(), r2.rng_value())


-- Int range tests
pure func test_rng_int_range() -> Bool:
	s0: RngState = rng_new(42)
	var state: RngState = s0
	var all_in_range: Bool = True
	for i in 0..100:
		r: RngStep[Int] = rng_int(state, 0, 10)
		if r.rng_value() < 0 or r.rng_value() >= 10:
			all_in_range = False
		state = r.rng_next_state()
	all_in_range


pure func test_rng_int_single_value() -> Bool:
	r: RngStep[Int] = rng_int(rng_new(42), 5, 6)
	r.rng_value() == 5


-- Bool tests
pure func test_rng_bool_deterministic() -> Bool:
	r1: RngStep[Bool] = rng_bool(rng_new(42))
	r2: RngStep[Bool] = rng_bool(rng_new(42))
	r1.rng_value() == r2.rng_value()


pure func test_rng_bool_both_values() -> Bool:
	-- Over many samples, should get both True and False
	var state: RngState = rng_new(42)
	var got_true: Bool = False
	var got_false: Bool = False
	for i in 0..100:
		r: RngStep[Bool] = rng_bool(state)
		if r.rng_value():
			got_true = True
		else:
			got_false = True
		state = r.rng_next_state()
	got_true and got_false


tests: TestSuite = {
	description = "Pure PRNG (SplitMix64)",
	tests = [
		("deterministic", test_rng_deterministic),
		("different seeds", test_rng_different_seeds),
		("sequence", test_rng_sequence),
		("float range", test_rng_float_range),
		("float deterministic", test_rng_float_deterministic),
		("int range", test_rng_int_range),
		("int single value", test_rng_int_single_value),
		("bool deterministic", test_rng_bool_deterministic),
		("bool both values", test_rng_bool_both_values),
	]
}
