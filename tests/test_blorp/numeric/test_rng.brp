import:
	float: approx_eq
	random: rng_bool, rng_float, rng_int, rng_new, rng_next
	test: TestSuite


-- Determinism tests
pure func test_rng_deterministic() -> Bool:
	r1: (Int, Int) = rng_next(rng_new(42))
	r2: (Int, Int) = rng_next(rng_new(42))
	r1[0] == r2[0] and r1[1] == r2[1]


pure func test_rng_different_seeds() -> Bool:
	r1: (Int, Int) = rng_next(rng_new(1))
	r2: (Int, Int) = rng_next(rng_new(2))
	r1[0] != r2[0]


pure func test_rng_sequence() -> Bool:
	s0: Int = rng_new(42)
	r1: (Int, Int) = rng_next(s0)
	r2: (Int, Int) = rng_next(r1[1])
	r3: (Int, Int) = rng_next(r2[1])

	-- Each value should be different
	r1[0] != r2[0] and r2[0] != r3[0]


-- Float tests
pure func test_rng_float_range() -> Bool:
	s0: Int = rng_new(123)
	var state: Int = s0
	var all_in_range: Bool = True
	for i in 0..100:
		r: (Float, Int) = rng_float(state)
		if r[0] < 0.0 or r[0] >= 1.0:
			all_in_range = False
		state = r[1]
	all_in_range


pure func test_rng_float_deterministic() -> Bool:
	r1: (Float, Int) = rng_float(rng_new(42))
	r2: (Float, Int) = rng_float(rng_new(42))
	approx_eq(r1[0], r2[0])


-- Int range tests
pure func test_rng_int_range() -> Bool:
	s0: Int = rng_new(42)
	var state: Int = s0
	var all_in_range: Bool = True
	for i in 0..100:
		r: (Int, Int) = rng_int(state, 0, 10)
		if r[0] < 0 or r[0] >= 10:
			all_in_range = False
		state = r[1]
	all_in_range


pure func test_rng_int_single_value() -> Bool:
	r: (Int, Int) = rng_int(rng_new(42), 5, 6)
	r[0] == 5


-- Bool tests
pure func test_rng_bool_deterministic() -> Bool:
	r1: (Bool, Int) = rng_bool(rng_new(42))
	r2: (Bool, Int) = rng_bool(rng_new(42))
	r1[0] == r2[0]


pure func test_rng_bool_both_values() -> Bool:
	-- Over many samples, should get both True and False
	var state: Int = rng_new(42)
	var got_true: Bool = False
	var got_false: Bool = False
	for i in 0..100:
		r: (Bool, Int) = rng_bool(state)
		if r[0]:
			got_true = True
		else:
			got_false = True
		state = r[1]
	got_true and got_false


tests: TestSuite = {
	description = "Pure PRNG (SplitMix64)",
	tests = [
		("deterministic", test_rng_deterministic),
		("different seeds", test_rng_different_seeds),
		("sequence", test_rng_sequence),
		("float range", test_rng_float_range),
		("float deterministic", test_rng_float_deterministic),
		("int range", test_rng_int_range),
		("int single value", test_rng_int_single_value),
		("bool deterministic", test_rng_bool_deterministic),
		("bool both values", test_rng_bool_both_values),
	],
}
