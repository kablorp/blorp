-- Windows edge cases: break, continue, empty, oversize
import:
	tensor: windows
	test: TestSuite


-- Break inside windows loop
func test_windows_break() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	var found_sum: Int = 0
	for w in windows(v, 2):
		if w[0] + w[1] > 5:
			found_sum = w[0] + w[1]
			break
	-- First window with sum > 5: [3,4]=7
	found_sum == 7


-- Continue inside windows loop
func test_windows_continue() -> Bool:
	v: Int[#5] = {1, 2, 3, 4, 5}
	var sum: Int = 0
	for w in windows(v, 2):
		if w[0] % 2 == 0:
			continue
		sum = sum + w[0] + w[1]
	-- odd-start windows: [1,2]=3, [3,4]=7, [5, -] doesn't exist → sum=10
	sum == 10


-- Window size == vector size: exactly 1 window
func test_windows_full() -> Bool:
	v: Int[#3] = {10, 20, 30}
	var count: Int = 0
	for w in windows(v, 3):
		count += 1
	count == 1


-- String windows (RC element type)
func test_windows_string() -> Bool:
	v: String[#4] = {"a", "b", "c", "d"}
	var pairs: List[String] = []
	for w in windows(v, 2):
		pairs = pairs.append(w[0] + w[1])
	pairs == ["ab", "bc", "cd"]


tests: TestSuite = {
	description = "Windows edge cases",
	tests = [
		("break in windows", test_windows_break),
		("continue in windows", test_windows_continue),
		("full size window", test_windows_full),
		("string windows (RC)", test_windows_string),
	],
}
