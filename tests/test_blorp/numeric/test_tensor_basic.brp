import:
	list as L
	tensor: get, is_empty, length, set_index
	test: TestSuite
	vector: to_list


-- Test Vector utility operations
-- ============================================================================
-- get: bounds-checked element access
-- ============================================================================
pure func test_get_valid() -> Bool:
	v: Int[#3] = {10, 20, 30}
	match get(v, 1):
		Some(val): val == 20
		None: False


pure func test_get_oob() -> Bool:
	v: Int[#3] = {10, 20, 30}
	match get(v, 5):
		Some(_): False
		None: True


pure func test_get_first() -> Bool:
	v: Int[#3] = {10, 20, 30}
	match get(v, 0):
		Some(val): val == 10
		None: False


pure func test_get_last() -> Bool:
	v: Int[#3] = {10, 20, 30}
	match get(v, 2):
		Some(val): val == 30
		None: False


-- ============================================================================
-- set_index: bounds-checked element update
-- ============================================================================
pure func test_set_index_valid() -> Bool:
	v: Int[#3] = {10, 20, 30}
	match v.set_index(1, 99):
		Some(_): True
		None: False


pure func test_set_index_oob() -> Bool:
	v: Int[#3] = {10, 20, 30}
	match v.set_index(5, 99):
		Some(_): False
		None: True


-- ============================================================================
-- is_empty
-- ============================================================================
pure func test_is_empty_nonempty() -> Bool:
	v: Int[#3] = {1, 2, 3}
	is_empty(v) == False


-- ============================================================================
-- length
-- ============================================================================
pure func test_length() -> Bool:
	v: Int[#4] = {10, 20, 30, 40}
	v.length() == 4


-- ============================================================================
-- subscript: v[i] syntax
-- ============================================================================
pure func test_subscript() -> Bool:
	v: Int[#3] = {10, 20, 30}
	v[0] == 10 and v[1] == 20 and v[2] == 30


-- ============================================================================
-- to_list: convert vector to list
-- ============================================================================
pure func test_to_list() -> Bool:
	v: Int[#3] = {10, 20, 30}
	lst: List[Int] = to_list(v)
	match L.get(lst, 0):
		Some(a): match L.get(lst, 1):
			Some(b): match L.get(lst, 2):
				Some(c): a == 10 and b == 20 and c == 30
				None: False
			None: False
		None: False


tests: TestSuite = {
	description = "Vector Utility Tests",
	tests = [
		("get valid index", test_get_valid),
		("get out of bounds", test_get_oob),
		("get first", test_get_first),
		("get last", test_get_last),
		("set_index valid", test_set_index_valid),
		("set_index out of bounds", test_set_index_oob),
		("is_empty nonempty", test_is_empty_nonempty),
		("length", test_length),
		("subscript", test_subscript),
		("to_list", test_to_list),
	]
}
