import:
	float: abs, to_float32
	test: TestSuite
	vector: max, min


func test_float_minmax() -> Bool:
	v: Float[#4] = {1.5, 3.7, 2.1, 0.8}
	abs(max(v) - 3.7) < 0.001 and abs(min(v) - 0.8) < 0.001


func test_float32_minmax() -> Bool:
	v: Float32[#4] = {to_float32(1.0), to_float32(5.0), to_float32(3.0), to_float32(2.0)}
	max(v) == to_float32(5.0) and min(v) == to_float32(1.0)


tests: TestSuite = {
	description = "Vector Float min/max",
	tests = [("Float min/max", test_float_minmax), ("Float32 min/max", test_float32_minmax)],
}
