import:
	matrix: ParallelMatrix, parallel
	test: TestSuite


func test_parallel_matrix_map() -> Bool:
	values: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	result: Int[#2, #3] = values.parallel(pure func(chunk: ParallelMatrix[Int, #2, #3]):
		chunk.map(pure func(x: Int) -> Int: x * 2)
	)
	result[0, 0] == 2 and result[0, 1] == 4 and result[0, 2] == 6 and result[1, 0] == 8 and result[1, 1] == 10 and result[1, 2] == 12


func test_parallel_matrix_map_indexed() -> Bool:
	values: Int[#2, #3] = {
		{0, 0, 0},
		{0, 0, 0},
	}
	result: Int[#2, #3] = values.parallel(pure func(chunk: ParallelMatrix[Int, #2, #3]):
		chunk.map_indexed(pure func(row: ..#2, col: ..#3, x: Int) -> Int: row * 10 + col + x)
	)
	result[0, 0] == 0 and result[0, 1] == 1 and result[0, 2] == 2 and result[1, 0] == 10 and result[1, 1] == 11 and result[1, 2] == 12


func test_parallel_matrix_zip_map() -> Bool:
	left: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	right: Int[#2, #2] = {
		{10, 20},
		{30, 40},
	}
	result: Int[#2, #2] = left.parallel(pure func(chunk: ParallelMatrix[Int, #2, #2]):
		chunk.zip_map(right, pure func(a: Int, b: Int) -> Int: a + b)
	)
	result[0, 0] == 11 and result[0, 1] == 22 and result[1, 0] == 33 and result[1, 1] == 44


func test_parallel_matrix_map_chain() -> Bool:
	values: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	result: Int[#2, #2] = values.parallel(pure func(chunk: ParallelMatrix[Int, #2, #2]):
		chunk
			.map(pure func(x: Int) -> Int: x + 1)
			.map(pure func(x: Int) -> Int: x * 3)
	)
	result[0, 0] == 6 and result[0, 1] == 9 and result[1, 0] == 12 and result[1, 1] == 15


func test_parallel_matrix_indexed_zip_chain() -> Bool:
	left: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	right: Int[#2, #2] = {
		{10, 20},
		{30, 40},
	}
	result: Int[#2, #2] = left.parallel(pure func(chunk: ParallelMatrix[Int, #2, #2]):
		chunk
			.zip_map(right, pure func(a: Int, b: Int) -> Int: a + b)
			.map_indexed(pure func(row: ..#2, col: ..#2, x: Int) -> Int: x + row * 10 + col)
	)
	result[0, 0] == 11 and result[0, 1] == 23 and result[1, 0] == 43 and result[1, 1] == 55


func test_parallel_matrix_distinct_zip_chain() -> Bool:
	left: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	first: Int[#2, #2] = {
		{10, 20},
		{30, 40},
	}
	second: Int[#2, #2] = {
		{100, 200},
		{300, 400},
	}
	result: Int[#2, #2] = left.parallel(pure func(chunk: ParallelMatrix[Int, #2, #2]):
		chunk
			.zip_map(first, pure func(a: Int, b: Int) -> Int: a + b)
			.zip_map(second, pure func(a: Int, b: Int) -> Int: a + b)
	)
	result[0, 0] == 111 and result[0, 1] == 222 and result[1, 0] == 333 and result[1, 1] == 444


tests: TestSuite = {
	description = "Parallel Matrix",
	tests = [
		("parallel matrix map", test_parallel_matrix_map),
		("parallel matrix map indexed", test_parallel_matrix_map_indexed),
		("parallel matrix zip map", test_parallel_matrix_zip_map),
		("parallel matrix map chain", test_parallel_matrix_map_chain),
		("parallel matrix indexed zip chain", test_parallel_matrix_indexed_zip_chain),
		("parallel matrix distinct zip chain", test_parallel_matrix_distinct_zip_chain),
	],
}
