import:
	float: abs
	test: TestSuite


func test_basic_fmod() -> Bool:
	abs(7.5 % 2.5 - 0.0) < 0.001


func test_non_integer_fmod() -> Bool:
	abs(10.0 % 3.0 - 1.0) < 0.001


func test_negative_fmod() -> Bool:
	abs(-7.5 % 2.5 - 0.0) < 0.001


func test_small_fmod() -> Bool:
	abs(1.5 % 0.4 - 0.3) < 0.001


func test_zero_divisor_fmod() -> Bool:
	7.5 % 0.0 == 0.0


tests: TestSuite = {
	description = "Float Modulo",
	tests = [
		("basic fmod", test_basic_fmod),
		("non-integer fmod", test_non_integer_fmod),
		("negative fmod", test_negative_fmod),
		("small fmod", test_small_fmod),
		("zero divisor fmod", test_zero_divisor_fmod),
	]
}
