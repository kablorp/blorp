import:
	float: approx_eq
	geometry:
		AABB2,
		Circle2,
		Vec2,
		Vec3,
		aabb2_circle2_overlaps,
		aabb2_contains_point,
		aabb2_overlaps,
		circle2_contains_point,
		circle2_overlaps,
		point_in_triangle,
		vec2,
		vec2_add,
		vec2_cross,
		vec2_distance,
		vec2_distance_sq,
		vec2_div,
		vec2_dot,
		vec2_length,
		vec2_length_sq,
		vec2_lerp,
		vec2_mul,
		vec2_normalize,
		vec2_rotate,
		vec2_scale,
		vec2_sub,
		vec3,
		vec3_add,
		vec3_cross,
		vec3_distance,
		vec3_div,
		vec3_dot,
		vec3_length,
		vec3_length_sq,
		vec3_lerp,
		vec3_mul,
		vec3_normalize,
		vec3_scale,
		vec3_sub,
	math: PI
	test: TestSuite


-- Vec2 tests
pure func test_vec2_constructor() -> Bool:
	v: Vec2 = vec2(3.0, 4.0)
	approx_eq(v.x, 3.0) and approx_eq(v.y, 4.0)


pure func test_vec2_add() -> Bool:
	c: Vec2 = vec2_add(vec2(1.0, 2.0), vec2(3.0, 4.0))
	approx_eq(c.x, 4.0) and approx_eq(c.y, 6.0)


pure func test_vec2_sub() -> Bool:
	c: Vec2 = vec2_sub(vec2(5.0, 7.0), vec2(2.0, 3.0))
	approx_eq(c.x, 3.0) and approx_eq(c.y, 4.0)


pure func test_vec2_mul() -> Bool:
	c: Vec2 = vec2_mul(vec2(2.0, 3.0), vec2(4.0, 5.0))
	approx_eq(c.x, 8.0) and approx_eq(c.y, 15.0)


pure func test_vec2_div() -> Bool:
	c: Vec2 = vec2_div(vec2(6.0, 8.0), vec2(2.0, 4.0))
	approx_eq(c.x, 3.0) and approx_eq(c.y, 2.0)


pure func test_vec2_scale() -> Bool:
	v: Vec2 = vec2_scale(vec2(2.0, 3.0), 4.0)
	approx_eq(v.x, 8.0) and approx_eq(v.y, 12.0)


pure func test_vec2_dot() -> Bool:
	-- Perpendicular vectors have zero dot product
	d: Float = vec2_dot(vec2(1.0, 0.0), vec2(0.0, 1.0))
	approx_eq(d, 0.0)


pure func test_vec2_dot_parallel() -> Bool:
	d: Float = vec2_dot(vec2(2.0, 3.0), vec2(2.0, 3.0))
	approx_eq(d, 13.0)


pure func test_vec2_cross() -> Bool:
	c: Float = vec2_cross(vec2(1.0, 0.0), vec2(0.0, 1.0))
	approx_eq(c, 1.0)


pure func test_vec2_length() -> Bool:
	l: Float = vec2_length(vec2(3.0, 4.0))
	approx_eq(l, 5.0)


pure func test_vec2_length_sq() -> Bool:
	l: Float = vec2_length_sq(vec2(3.0, 4.0))
	approx_eq(l, 25.0)


pure func test_vec2_normalize() -> Bool:
	n: Vec2 = vec2_normalize(vec2(3.0, 4.0))
	approx_eq(vec2_length(n), 1.0)


pure func test_vec2_normalize_zero() -> Bool:
	n: Vec2 = vec2_normalize(vec2(0.0, 0.0))
	approx_eq(n.x, 0.0) and approx_eq(n.y, 0.0)


pure func test_vec2_distance() -> Bool:
	d: Float = vec2_distance(vec2(0.0, 0.0), vec2(3.0, 4.0))
	approx_eq(d, 5.0)


pure func test_vec2_distance_sq() -> Bool:
	d: Float = vec2_distance_sq(vec2(0.0, 0.0), vec2(3.0, 4.0))
	approx_eq(d, 25.0)


pure func test_vec2_lerp() -> Bool:
	v: Vec2 = vec2_lerp(vec2(0.0, 0.0), vec2(10.0, 10.0), 0.5)
	approx_eq(v.x, 5.0) and approx_eq(v.y, 5.0)


pure func test_vec2_lerp_endpoints() -> Bool:
	a: Vec2 = vec2(1.0, 2.0)
	b: Vec2 = vec2(5.0, 6.0)
	v0: Vec2 = vec2_lerp(a, b, 0.0)
	v1: Vec2 = vec2_lerp(a, b, 1.0)
	approx_eq(v0.x, 1.0) and approx_eq(v1.x, 5.0)


pure func test_vec2_rotate() -> Bool:
	v: Vec2 = vec2_rotate(vec2(1.0, 0.0), PI / 2.0)
	approx_eq(v.x, 0.0) and approx_eq(v.y, 1.0)


-- Vec3 tests
pure func test_vec3_constructor() -> Bool:
	v: Vec3 = vec3(1.0, 2.0, 3.0)
	approx_eq(v.x, 1.0) and approx_eq(v.z, 3.0)


pure func test_vec3_add() -> Bool:
	c: Vec3 = vec3_add(vec3(1.0, 2.0, 3.0), vec3(4.0, 5.0, 6.0))
	approx_eq(c.x, 5.0) and approx_eq(c.y, 7.0) and approx_eq(c.z, 9.0)


pure func test_vec3_sub() -> Bool:
	c: Vec3 = vec3_sub(vec3(5.0, 7.0, 9.0), vec3(1.0, 2.0, 3.0))
	approx_eq(c.z, 6.0)


pure func test_vec3_mul() -> Bool:
	c: Vec3 = vec3_mul(vec3(2.0, 3.0, 4.0), vec3(5.0, 6.0, 7.0))
	approx_eq(c.x, 10.0) and approx_eq(c.z, 28.0)


pure func test_vec3_div() -> Bool:
	c: Vec3 = vec3_div(vec3(10.0, 12.0, 14.0), vec3(2.0, 3.0, 7.0))
	approx_eq(c.x, 5.0) and approx_eq(c.y, 4.0)


pure func test_vec3_scale() -> Bool:
	v: Vec3 = vec3_scale(vec3(1.0, 2.0, 3.0), 2.0)
	approx_eq(v.z, 6.0)


pure func test_vec3_dot() -> Bool:
	d: Float = vec3_dot(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
	approx_eq(d, 0.0)


pure func test_vec3_cross() -> Bool:
	-- x cross y = z
	c: Vec3 = vec3_cross(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
	approx_eq(c.x, 0.0) and approx_eq(c.y, 0.0) and approx_eq(c.z, 1.0)


pure func test_vec3_length() -> Bool:
	l: Float = vec3_length(vec3(1.0, 2.0, 2.0))
	approx_eq(l, 3.0)


pure func test_vec3_length_sq() -> Bool:
	l: Float = vec3_length_sq(vec3(1.0, 2.0, 2.0))
	approx_eq(l, 9.0)


pure func test_vec3_normalize() -> Bool:
	n: Vec3 = vec3_normalize(vec3(0.0, 3.0, 4.0))
	approx_eq(vec3_length(n), 1.0)


pure func test_vec3_distance() -> Bool:
	d: Float = vec3_distance(vec3(0.0, 0.0, 0.0), vec3(1.0, 2.0, 2.0))
	approx_eq(d, 3.0)


pure func test_vec3_lerp() -> Bool:
	v: Vec3 = vec3_lerp(vec3(0.0, 0.0, 0.0), vec3(10.0, 10.0, 10.0), 0.5)
	approx_eq(v.x, 5.0) and approx_eq(v.z, 5.0)


-- Collision tests
pure func test_aabb2_overlaps_yes() -> Bool:
	a: AABB2 = {
		min_x = 0.0,
		min_y = 0.0,
		max_x = 2.0,
		max_y = 2.0
	}
	b: AABB2 = {
		min_x = 1.0,
		min_y = 1.0,
		max_x = 3.0,
		max_y = 3.0
	}
	aabb2_overlaps(a, b)


pure func test_aabb2_overlaps_no() -> Bool:
	a: AABB2 = {
		min_x = 0.0,
		min_y = 0.0,
		max_x = 1.0,
		max_y = 1.0
	}
	b: AABB2 = {
		min_x = 2.0,
		min_y = 2.0,
		max_x = 3.0,
		max_y = 3.0
	}
	not aabb2_overlaps(a, b)


pure func test_aabb2_contains_point_yes() -> Bool:
	box: AABB2 = {
		min_x = 0.0,
		min_y = 0.0,
		max_x = 10.0,
		max_y = 10.0
	}
	aabb2_contains_point(box, vec2(5.0, 5.0))


pure func test_aabb2_contains_point_no() -> Bool:
	box: AABB2 = {
		min_x = 0.0,
		min_y = 0.0,
		max_x = 10.0,
		max_y = 10.0
	}
	not aabb2_contains_point(box, vec2(15.0, 5.0))


pure func test_circle2_overlaps_yes() -> Bool:
	a: Circle2 = {
		cx = 0.0,
		cy = 0.0,
		radius = 2.0
	}
	b: Circle2 = {
		cx = 3.0,
		cy = 0.0,
		radius = 2.0
	}
	circle2_overlaps(a, b)


pure func test_circle2_overlaps_no() -> Bool:
	a: Circle2 = {
		cx = 0.0,
		cy = 0.0,
		radius = 1.0
	}
	b: Circle2 = {
		cx = 5.0,
		cy = 0.0,
		radius = 1.0
	}
	not circle2_overlaps(a, b)


pure func test_circle2_contains_point_yes() -> Bool:
	c: Circle2 = {
		cx = 0.0,
		cy = 0.0,
		radius = 5.0
	}
	circle2_contains_point(c, vec2(3.0, 4.0))


pure func test_circle2_contains_point_no() -> Bool:
	c: Circle2 = {
		cx = 0.0,
		cy = 0.0,
		radius = 2.0
	}
	not circle2_contains_point(c, vec2(3.0, 4.0))


pure func test_aabb2_circle2_overlaps_yes() -> Bool:
	box: AABB2 = {
		min_x = 0.0,
		min_y = 0.0,
		max_x = 4.0,
		max_y = 4.0
	}
	c: Circle2 = {
		cx = 5.0,
		cy = 2.0,
		radius = 2.0
	}
	aabb2_circle2_overlaps(box, c)


pure func test_aabb2_circle2_overlaps_no() -> Bool:
	box: AABB2 = {
		min_x = 0.0,
		min_y = 0.0,
		max_x = 2.0,
		max_y = 2.0
	}
	c: Circle2 = {
		cx = 10.0,
		cy = 10.0,
		radius = 1.0
	}
	not aabb2_circle2_overlaps(box, c)


pure func test_point_in_triangle_yes() -> Bool:
	point_in_triangle(vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(4.0, 0.0), vec2(0.0, 4.0))


pure func test_point_in_triangle_no() -> Bool:
	not point_in_triangle(vec2(5.0, 5.0), vec2(0.0, 0.0), vec2(4.0, 0.0), vec2(0.0, 4.0))


tests: TestSuite = {
	description = "Geometry Module",
	tests = [
		("vec2 constructor", test_vec2_constructor),
		("vec2 add", test_vec2_add),
		("vec2 sub", test_vec2_sub),
		("vec2 mul", test_vec2_mul),
		("vec2 div", test_vec2_div),
		("vec2 scale", test_vec2_scale),
		("vec2 dot", test_vec2_dot),
		("vec2 dot parallel", test_vec2_dot_parallel),
		("vec2 cross", test_vec2_cross),
		("vec2 length", test_vec2_length),
		("vec2 length_sq", test_vec2_length_sq),
		("vec2 normalize", test_vec2_normalize),
		("vec2 normalize zero", test_vec2_normalize_zero),
		("vec2 distance", test_vec2_distance),
		("vec2 distance_sq", test_vec2_distance_sq),
		("vec2 lerp", test_vec2_lerp),
		("vec2 lerp endpoints", test_vec2_lerp_endpoints),
		("vec2 rotate", test_vec2_rotate),
		("vec3 constructor", test_vec3_constructor),
		("vec3 add", test_vec3_add),
		("vec3 sub", test_vec3_sub),
		("vec3 mul", test_vec3_mul),
		("vec3 div", test_vec3_div),
		("vec3 scale", test_vec3_scale),
		("vec3 dot", test_vec3_dot),
		("vec3 cross", test_vec3_cross),
		("vec3 length", test_vec3_length),
		("vec3 length_sq", test_vec3_length_sq),
		("vec3 normalize", test_vec3_normalize),
		("vec3 distance", test_vec3_distance),
		("vec3 lerp", test_vec3_lerp),
		("aabb2 overlaps yes", test_aabb2_overlaps_yes),
		("aabb2 overlaps no", test_aabb2_overlaps_no),
		("aabb2 contains point yes", test_aabb2_contains_point_yes),
		("aabb2 contains point no", test_aabb2_contains_point_no),
		("circle2 overlaps yes", test_circle2_overlaps_yes),
		("circle2 overlaps no", test_circle2_overlaps_no),
		("circle2 contains point yes", test_circle2_contains_point_yes),
		("circle2 contains point no", test_circle2_contains_point_no),
		("aabb2 circle2 overlaps yes", test_aabb2_circle2_overlaps_yes),
		("aabb2 circle2 overlaps no", test_aabb2_circle2_overlaps_no),
		("point in triangle yes", test_point_in_triangle_yes),
		("point in triangle no", test_point_in_triangle_no),
	]
}
