-- Test negation codegen edge cases
import:
	test: TestSuite


func test_negate_negative_int() -> Bool:
	x: Int = -(-1)
	x == 1


func test_negate_negative_float() -> Bool:
	x: Float = -(-1.5)
	x == 1.5


func test_double_negate_var() -> Bool:
	y: Int = 5
	x: Int = -(-y)
	x == 5


tests: TestSuite = {
	description = "Negation tests",
	tests = [
		("negate negative int literal", test_negate_negative_int),
		("negate negative float literal", test_negate_negative_float),
		("double negate variable", test_double_negate_var),
	],
}
