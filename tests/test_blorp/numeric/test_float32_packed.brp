import:
	memory: MemStats, get_mem_stats, reset_mem_stats
	tensor as T
	test: TestSuite


-- Basic packed Float32 vector creation and access
func test_f32_zeros_and_subscript() -> Bool:
	var v: Float32[#10] = vector(0.0, 10)
	v[0] = to_float32(1.5)
	v[9] = to_float32(9.5)
	to_float(v[0]) > 1.4 and to_float(v[0]) < 1.6 and to_float(v[9]) > 9.4 and to_float(v[9]) < 9.6


-- 2D Float32 tensor (matrix) creation
func test_f32_matrix_new() -> Bool:
	var m: Float32[#4, #3] = {
		{to_float32(0.0), to_float32(0.0), to_float32(0.0)},
		{to_float32(0.0), to_float32(0.0), to_float32(0.0)},
		{to_float32(0.0), to_float32(0.0), to_float32(0.0)},
		{to_float32(0.0), to_float32(0.0), to_float32(0.0)},
	}
	m[0, 0] = to_float32(1.0)
	m[1, 2] = to_float32(2.0)
	m[3, 1] = to_float32(3.0)
	to_float(m[0, 0]) > 0.9 and to_float(m[1, 2]) > 1.9 and to_float(m[3, 1]) > 2.9


-- Float32 matrix row peel preserves packed f32 storage
func test_f32_matrix_row_peel() -> Bool:
	m: Float32[#2, #3] = {
		{to_float32(1.0), to_float32(2.0), to_float32(3.0)},
		{to_float32(4.0), to_float32(5.0), to_float32(6.0)},
	}
	row: Float32[#3] = m[1]
	to_float(row[0]) > 3.9 and to_float(row[1]) > 4.9 and to_float(row[2]) > 5.9


-- Float32 vector arithmetic (SIMD path)
func test_f32_vector_add() -> Bool:
	a: Float32[#4] = {to_float32(1.0), to_float32(2.0), to_float32(3.0), to_float32(4.0)}
	b: Float32[#4] = {to_float32(10.0), to_float32(20.0), to_float32(30.0), to_float32(40.0)}
	c: Float32[#4] = a + b
	to_float(
		c[0],
	) > 10.9 and to_float(c[1]) > 21.9 and to_float(c[2]) > 32.9 and to_float(c[3]) > 43.9


-- Float32 scalar multiply (broadcast)
func test_f32_scalar_mul() -> Bool:
	v: Float32[#4] = {to_float32(1.0), to_float32(2.0), to_float32(3.0), to_float32(4.0)}
	r: Float32[#4] = v * to_float32(3.0)
	to_float(r[0]) > 2.9 and to_float(r[1]) > 5.9 and to_float(r[2]) > 8.9 and to_float(r[3]) > 11.9


-- Float32 COW vector arithmetic (var reassignment)
func test_f32_cow_add() -> Bool:
	var v: Float32[#4] = {to_float32(1.0), to_float32(2.0), to_float32(3.0), to_float32(4.0)}
	b: Float32[#4] = {to_float32(0.5), to_float32(0.5), to_float32(0.5), to_float32(0.5)}
	v += b
	to_float(v[0]) > 1.4 and to_float(v[1]) > 2.4 and to_float(v[2]) > 3.4 and to_float(v[3]) > 4.4


-- T.set_index for Float32 (COW set)
func test_f32_set_index() -> Bool:
	var v: Float32[#10] = vector(0.0, 10)
	v = T
		.set_index(v, 5, to_float32(42.0))
		.get_or(v)
	to_float(v[5]) > 41.9 and to_float(v[5]) < 42.1


-- T.get for Float32 (option-wrapped get)
func test_f32_get_opt() -> Bool:
	var v: Float32[#10] = vector(0.0, 10)
	v[3] = to_float32(7.5)
	result: Option[Float32] = T.get(v, 3)
	match result:
		Some(val): to_float(val) > 7.4 and to_float(val) < 7.6
		None: False


-- TODO: Float32 try block fusion test needs codegen fix for to_float inside try
-- Float32 COW through T.set_index (proper COW path)
func test_f32_shared_cow() -> Bool:
	var a: Float32[#4] = vector(0.0, 4)
	a[0] = to_float32(1.0)
	a[1] = to_float32(2.0)
	b: Float32[#4] = a
	-- Use set_index for COW (subscript assignment is in-place, no COW)
	a = T
		.set_index(a, 0, to_float32(99.0))
		.get_or(a)
	to_float(a[0]) > 98.9 and to_float(b[0]) > 0.9 and to_float(b[0]) < 1.1


-- Float32 memory: packed should use half the memory of void*
func test_f32_no_leak() -> Bool:
	reset_mem_stats()
	var i: Int = 0
	while i < 100:
		v = vector(0.0, 1000)
		_ = v
		i += 1
	s: MemStats = get_mem_stats()
	s.current_objects <= 3


-- Float32 vector equality
func test_f32_equality() -> Bool:
	a: Float32[#4] = {to_float32(1.0), to_float32(2.0), to_float32(3.0), to_float32(4.0)}
	b: Float32[#4] = {to_float32(1.0), to_float32(2.0), to_float32(3.0), to_float32(4.0)}
	c: Float32[#4] = {to_float32(1.0), to_float32(2.0), to_float32(3.0), to_float32(5.0)}
	a == b and a != c


-- For-loop iteration reads packed Float32 storage through the same typed
-- tensor access path as subscript/indexed reads.
func test_f32_for_loop() -> Bool:
	v: Float32[#4] = {to_float32(1.0), to_float32(2.0), to_float32(3.0), to_float32(4.0)}
	var total: Float = 0.0
	for x in v:
		total += to_float(x)
	total > 9.9 and total < 10.1


tests: TestSuite = {
	description = "Packed Float32 vector storage",
	tests = [
		("f32 zeros and subscript", test_f32_zeros_and_subscript),
		("f32 matrix new", test_f32_matrix_new),
		("f32 matrix row peel", test_f32_matrix_row_peel),
		("f32 vector add", test_f32_vector_add),
		("f32 scalar mul", test_f32_scalar_mul),
		("f32 cow add", test_f32_cow_add),
		("f32 set_index", test_f32_set_index),
		("f32 get opt", test_f32_get_opt),
		("f32 shared cow", test_f32_shared_cow),
		("f32 no leak", test_f32_no_leak),
		("f32 equality", test_f32_equality),
		("f32 for loop", test_f32_for_loop),
	],
}
