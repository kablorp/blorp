import:
	fixed as F
	test: TestSuite


-- Test basic fixed creation
func test_fixed_create() -> Bool:
	price: Fixed = F.fixed(19.99, 2)
	F.to_string(price) == "19.99"


-- Test fixed addition with same scale
func test_fixed_add_same_scale() -> Bool:
	a: Fixed = F.fixed(10.5, 2)
	b: Fixed = F.fixed(5.25, 2)
	result: Fixed = a + b
	F.to_string(result) == "15.75"


-- Test fixed addition with different scales (auto-normalize)
func test_fixed_add_diff_scale() -> Bool:
	price: Fixed = F.fixed(19.99, 2)
	tax_rate: Fixed = F.fixed(0.0825, 4)
	result: Fixed = price + tax_rate
	-- Result should be at scale 4
	F.get_scale(result) == 4


-- Test fixed multiplication
func test_fixed_mul() -> Bool:
	price: Fixed = F.fixed(10.0, 2)
	quantity: Fixed = F.fixed(3.0, 1)
	result: Fixed = price * quantity
	-- 10.00 * 3.0 = 30.000 (scale 3)
	F.get_scale(result) == 3


-- Test fixed subtraction
func test_fixed_sub() -> Bool:
	a: Fixed = F.fixed(100.0, 2)
	b: Fixed = F.fixed(25.5, 2)
	result: Fixed = a - b
	F.to_string(result) == "74.50"


-- Test fixed division
func test_fixed_div() -> Bool:
	a: Fixed = F.fixed(10.0, 2)
	b: Fixed = F.fixed(2.0, 2)
	result: Fixed = a / b
	F.to_string(result) == "5.0000000000"


-- Test fixed division by zero preserves infallible arithmetic
func test_fixed_div_by_zero() -> Bool:
	a: Fixed = F.fixed(10.0, 2)
	b: Fixed = F.fixed(0.0, 2)
	result: Fixed = a / b
	F.to_string(result) == "0.00"


-- Test fixed comparison
func test_fixed_compare() -> Bool:
	a: Fixed = F.fixed(10.0, 1)
	b: Fixed = F.fixed(10.0, 2)
	-- Same value, different scale - should be equal
	a == b


-- Test fixed ordering comparisons
func test_fixed_ordering() -> Bool:
	small: Fixed = F.fixed(9.99, 2)
	large: Fixed = F.fixed(10.0, 1)
	same: Fixed = F.fixed(9.99, 3)
	small < large and small <= same and large > small and large >= same and small != large and small == same


-- Test constructors that route through std builtin wrappers
func test_fixed_constructor_wrappers() -> Bool:
	from_int: Fixed = F.from_int(42, 2)
	with_precision: Fixed = F.with_precision(1.2345, 4, 6)
	F.to_string(from_int) == "42.00" and F.get_precision(with_precision) == 6


-- Test round_to
func test_round_to() -> Bool:
	price: Fixed = F.fixed(19.999, 3)
	rounded: Fixed = F.round_to(price, 2)
	F.to_string(rounded) == "20.00"


tests: TestSuite = {
	description = "Fixed-point decimal type",
	tests = [
		("fixed creation", test_fixed_create),
		("add same scale", test_fixed_add_same_scale),
		("add different scale", test_fixed_add_diff_scale),
		("multiplication", test_fixed_mul),
		("subtraction", test_fixed_sub),
		("division", test_fixed_div),
		("division by zero", test_fixed_div_by_zero),
		("comparison across scales", test_fixed_compare),
		("ordering comparisons", test_fixed_ordering),
		("constructor wrappers", test_fixed_constructor_wrappers),
		("round_to", test_round_to),
	],
}
