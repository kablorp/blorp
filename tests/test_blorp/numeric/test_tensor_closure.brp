-- Test 2D tensor multi-index subscript inside closures
import:
	test: TestSuite


func test_2d_subscript_in_closure() -> Bool:
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	f: () -> Int = func(): m[0, 2]
	f() == 3


func test_2d_subscript_captured_read() -> Bool:
	m: Float[#2, #2] = {
		{1.5, 2.5},
		{3.5, 4.5},
	}
	f: () -> Float = func(): m[1, 1]
	f() == 4.5


tests: TestSuite = {
	description = "Tensor Closure Subscript",
	tests = [
		("2D subscript in closure", test_2d_subscript_in_closure),
		("2D subscript captured read", test_2d_subscript_captured_read),
	]
}
