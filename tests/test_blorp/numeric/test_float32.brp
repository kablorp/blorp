import:
	test: TestSuite


-- Basic declaration
func test_basic_decl() -> Bool:
	a: Float32 = 3.0
	b: Float32 = 0.0
	c: Float32 = -1.5
	expected_a: Float32 = 3.0
	expected_b: Float32 = 0.0
	expected_c: Float32 = -1.5
	a == expected_a and b == expected_b and c == expected_c


-- Arithmetic
func test_arithmetic() -> Bool:
	a: Float32 = 10.0
	b: Float32 = 3.0
	c: Float32 = a + b
	d: Float32 = a - b
	e: Float32 = a * b
	f: Float32 = a / b
	expected_sum: Float32 = 13.0
	expected_diff: Float32 = 7.0
	expected_prod: Float32 = 30.0
	expected_quot: Float32 = a / b
	c == expected_sum and d == expected_diff and e == expected_prod and f == expected_quot


-- Negation
func test_negation() -> Bool:
	a: Float32 = 5.0
	b: Float32 = -a
	c: Float32 = -b
	neg5: Float32 = -5.0
	pos5: Float32 = 5.0
	b == neg5 and c == pos5


-- Comparison
func test_comparison() -> Bool:
	a: Float32 = 1.0
	b: Float32 = 2.0
	a < b and b > a and a <= a and a >= a and a == a and a != b


-- Division by zero returns inf (IEEE 754)
func test_safe_div() -> Bool:
	a: Float32 = 10.0
	b: Float32 = 0.0
	c: Float32 = a / b
	inf32: Float32 = to_float32(1.0 / 0.0)
	c == inf32


-- Conversion from Int
func test_to_float32_from_int() -> Bool:
	a: Float32 = to_float32(42)
	expected: Float32 = 42.0
	a == expected


-- Conversion from Float
func test_to_float32_from_float() -> Bool:
	a: Float32 = to_float32(3.0)
	expected: Float32 = 3.0
	a == expected


-- Conversion from Bool
func test_to_float32_from_bool() -> Bool:
	a: Float32 = to_float32(True)
	b: Float32 = to_float32(False)
	one: Float32 = 1.0
	zero: Float32 = 0.0
	a == one and b == zero


-- to_int from Float32
func test_to_int() -> Bool:
	a: Float32 = 42.7
	b: Int = to_int(a)
	b == 42


-- to_float from Float32
func test_to_float() -> Bool:
	a: Float32 = 3.0
	b: Float = to_float(a)
	b == 3.0


-- to_string
func test_to_string() -> Bool:
	a: Float32 = 3.5
	s: String = a.to_string()
	s == "3.5"


-- String interpolation
func test_interpolation() -> Bool:
	a: Float32 = 2.5
	s: String = "val=${a}"
	s == "val=2.5"


-- to_bool
func test_to_bool() -> Bool:
	a: Float32 = 1.0
	b: Float32 = 0.0
	to_bool(a) == True and to_bool(b) == False


-- Struct field
struct Point32 {x: Float32, y: Float32}


func test_struct_fields() -> Bool:
	p: Point32 = {x = 1.0, y = 2.0}
	one: Float32 = 1.0
	two: Float32 = 2.0
	p.x == one and p.y == two


-- Option[Float32]
func test_option_float32() -> Bool:
	a: Option[Float32] = Some(to_float32(3))
	match a:
		Some(v):
			three: Float32 = 3.0
			v == three
		None: False


-- List[Float32]
func test_list_float32() -> Bool:
	xs: List[Float32] = [to_float32(1), to_float32(2), to_float32(3)]
	xs.length() == 3


tests: TestSuite = {
	description = "Float32 Tests",
	tests = [
		("basic declaration", test_basic_decl),
		("arithmetic", test_arithmetic),
		("negation", test_negation),
		("comparison", test_comparison),
		("safe division", test_safe_div),
		("to_float32 from Int", test_to_float32_from_int),
		("to_float32 from Float", test_to_float32_from_float),
		("to_float32 from Bool", test_to_float32_from_bool),
		("to_int from Float32", test_to_int),
		("to_float from Float32", test_to_float),
		("to_string", test_to_string),
		("interpolation", test_interpolation),
		("to_bool", test_to_bool),
		("struct fields", test_struct_fields),
		("Option[Float32]", test_option_float32),
		("List[Float32]", test_list_float32),
	],
}
