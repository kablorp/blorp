-- Test the benchmark framework
import:
	../../benchmarks/blorp/support/benchmark: bench, format_duration, run_benchmarks
	instrumentation: time_it


-- Simple function to benchmark
func compute_sum(n: Int) -> Int:
	var sum: Int = 0
	var i: Int = 0
	while i < n:
		sum += i
		i += 1
	sum


func main(args: List[String]) -> Int:
	-- Test format_duration with different values
	print("Testing format_duration:")
	print("  500 us: " + format_duration(500))
	print("  1500 us: " + format_duration(1500))
	print("  1500000 us: " + format_duration(1500000))
	-- Test time_it
	print("")
	print("Testing time_it:")
	elapsed: Int = time_it(func():
		result: Int = compute_sum(1000)
		print("  computed sum: " + to_string(result))
	)
	print("  elapsed: " + format_duration(elapsed))
	-- Test bench
	print("")
	print("Testing bench:")
	total: Int = bench(10, func(): compute_sum(100))
	print("  10 iterations: " + format_duration(total))
	-- Test run_benchmarks
	benchmarks: List[(String, () -> Int)] = [
		("sum 100", func(): bench(100, func(): compute_sum(100))),
		("sum 1000", func(): bench(10, func(): compute_sum(1000))),
	]
	run_benchmarks("Compute Sum Benchmarks", benchmarks)
