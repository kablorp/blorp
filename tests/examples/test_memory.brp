-- Test for std/memory module
import:
	memory: format_bytes, format_stats, has_leaks, measure_memory, mem_delta, print_mem_stats


-- Helper to create some allocations
func allocate_strings(n: Int) -> Void:
	var i: Int = 0
	while i < n:
		print("allocating " + to_string(i))
		i += 1


func main(args: List[String]) -> Int:
	print("Testing format_bytes:")
	print("  500 bytes: " + format_bytes(500))
	print("  2048 bytes: " + format_bytes(2048))
	print("  1572864 bytes: " + format_bytes(1572864))
	print("  2147483648 bytes: " + format_bytes(2147483648))
	print("")
	print("Testing format_stats:")
	stats: MemStats = MemStats
	{total_allocations = 100, total_releases = 95, current_objects = 5, bytes_allocated = 4096}
	print("  " + format_stats(stats))
	print("")
	print("Testing measure_memory:")
	measured: MemStats = measure_memory(func():
		allocate_strings(10)
	)
	print("  Allocations: " + to_string(measured.total_allocations))
	print("  Releases: " + to_string(measured.total_releases))
	print("  Has leaks: " + to_string(has_leaks(measured)))
	print("")
	print("Testing mem_delta:")
	before: MemStats = MemStats
	{total_allocations = 10, total_releases = 5, current_objects = 5, bytes_allocated = 1000}
	after: MemStats = MemStats
	{total_allocations = 25, total_releases = 20, current_objects = 5, bytes_allocated = 1500}
	delta: MemStats = mem_delta(before, after)
	print("  Delta allocations: " + to_string(delta.total_allocations))
	print("  Delta releases: " + to_string(delta.total_releases))
	print("")
	print("Testing print_mem_stats:")
	reset_mem_stats()
	allocate_strings(5)
	print_mem_stats()
