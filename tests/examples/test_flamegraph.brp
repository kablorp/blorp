-- Test for flamegraph visualization with nested function calls
pure func inner_work(n: Int) -> Int:
	var sum: Int = 0
	var i: Int = 0
	while i < n:
		sum += i
		i += 1
	sum


pure func helper(n: Int) -> Int:
	inner_work(n) + inner_work(n / 2)


func slow_func(n: Int) -> Int:
	var total: Int = 0
	var i: Int = 0
	while i < 10:
		total += helper(n)
		i += 1
	total


func fast_func(x: Int) -> Int:
	x * 2


func main(args: List[String]) -> Int:
	print("Testing flamegraph...")
	-- Nested function calls to show call hierarchy
	result1: Int = slow_func(1000)
	-- Call slow_func multiple times
	var j: Int = 0
	while j < 3:
		slow_func(500)
		j += 1
	-- A few fast function calls
	fast_func(42)
	fast_func(100)
	print("Done!")
