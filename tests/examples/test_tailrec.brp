-- Test for @tail_recursive annotation
@tail_recursive
func factorial(n: Int, acc: Int) -> Int:
	if n <= 1:
		acc
	else:
		factorial(n - 1, n * acc)


func main(args: List[String]) -> Void:
	print("Factorial of 5: " + to_string(factorial(5, 1)))
	print("Factorial of 10: " + to_string(factorial(10, 1)))
