-- Test for profiling feature
func slow_func(n: Int) -> Int:
	var sum: Int = 0
	var i: Int = 0
	while i < n:
		sum += i
		i += 1
	sum


func fast_func(x: Int) -> Int:
	x * 2


func main(args: List[String]) -> Int:
	print("Testing profiling...")
	result1: Int = slow_func(10000)
	print("slow_func result: " + to_string(result1))
	result2: Int = fast_func(42)
	print("fast_func result: " + to_string(result2))
	-- Call slow_func a few more times
	var j: Int = 0
	while j < 5:
		slow_func(1000)
		j += 1
