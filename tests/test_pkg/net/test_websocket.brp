import:
	bytes as B
	hash: sha1
	net/http as Http
	net/tcp as Tcp
	pkg/net/websocket as WS
	string: contains
	test: TestSuite


pure func is_socket_permission_error(err: String) -> Bool:
	err.contains("Operation not permitted") or err.contains("Permission denied")


pure func websocket_accept(key: String) -> String:
	combined: String = key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
	hex: String = sha1(combined)
	match B.from_hex(hex):
		Some(raw):
			B
				.to_string(raw)
				.base64_encode()
		None: ""


func write_upgrade_response(peer: TcpStream, accept: String) -> Bool:
	response: String = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n"
	match Tcp.write(peer, response.to_bytes()):
		Ok(_): True
		Err(_): False


func serve_websocket_handshake_once(listener: TcpListener) -> Bool:
	match Tcp.accept(listener):
		Ok(peer):
			match Tcp.read(peer, 4096):
				Ok(request_bytes):
					match Http.parse_request(request_bytes):
						Ok(req):
							match Http.get_header(req.headers, "Sec-WebSocket-Key"):
								Some(key):
									accept: String = websocket_accept(key)
									wrote: Bool = write_upgrade_response(peer, accept)
									_ = Tcp.read(peer, 16)
									Tcp.close(peer)
									wrote and req.path == "/chat" and req.query == "x=1"
								None:
									Tcp.close(peer)
									False
						Err(_):
							Tcp.close(peer)
							False
				Err(_):
					Tcp.close(peer)
					False
		Err(_): False


func websocket_client_connect(port: Int) -> Bool:
	url: String = "ws://127.0.0.1:" + port.to_string() + "/chat?x=1"
	match WS.connect(url):
		Ok(ws):
			WS.close(ws)
			True
		Err(e):
			print("WebSocket client error: " + e)
			False


func test_websocket_loopback_handshake() -> Bool:
	match Tcp.listen("127.0.0.1", 0, 1):
		Ok(listener):
			match Tcp.local_port(listener):
				Ok(port):
					concurrent(max_threads: 1, timeout: 1000):
						served = serve_websocket_handshake_once(listener)
						client = websocket_client_connect(port)
					Tcp.close(listener)
					served_ok: Bool = match served:
						Ok(result): result
						Err(_): False
					client_ok: Bool = match client:
						Ok(result): result
						Err(_): False
					served_ok and client_ok
				Err(_):
					Tcp.close(listener)
					False
		Err(e): is_socket_permission_error(e)


tests: TestSuite = {
	description = "pkg/net/websocket runtime tests",
	tests = [("loopback HTTP upgrade handshake", test_websocket_loopback_handshake)],
}
