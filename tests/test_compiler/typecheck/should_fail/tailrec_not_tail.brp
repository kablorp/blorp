-- EXPECT: error: @tail_recursive function 'bad_factorial' has recursive call not in tail position. The recursive call's result must be returned directly, not used in further computation.
-- Test that @tail_recursive rejects non-tail recursive calls
-- Error: @tail_recursive function 'bad_factorial' has recursive call not in tail position
@tail_recursive
func bad_factorial(n: Int) -> Int:
	if n <= 1:
		1
	else:
		n * bad_factorial(n - 1)
