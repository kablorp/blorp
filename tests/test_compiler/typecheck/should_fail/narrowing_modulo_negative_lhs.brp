-- EXPECT: error: Subscript index must be a compile-time constant or a loop variable proven in-bounds (e.g., for i in 0..length(v): v[i]). Use get() for runtime-checked access
-- Test: Modulo with potentially-negative dividend should NOT narrow,
-- because C's truncated modulo returns negative values for negative LHS.
-- (-7) % 5 == -2, which is NOT in [0, 5).
func main(args: List[String]) -> Int:
	v: Int[#5] = {1, 2, 3, 4, 5}
	i: Int = -7
	idx: Int = i % 5
	v[idx]
