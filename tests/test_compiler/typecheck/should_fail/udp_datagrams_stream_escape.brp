-- EXPECT: error: Function 'bad' return type cannot contain a one-shot stream type
import:
	net/udp: Datagram, UdpError, bind, datagrams, socket
	stream: FallibleStream


func bad() -> Result[FallibleStream[Datagram, UdpError], UdpError]:
	with sock ?= socket():
		ignored ?= bind(sock, "127.0.0.1", 0)
		Ok(datagrams(sock, 64))
