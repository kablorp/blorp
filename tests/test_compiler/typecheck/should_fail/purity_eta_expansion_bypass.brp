-- EXPECT: error: Pure function 'apply' has impure callback parameter 'f'. Use 'pure (Int) -> Int' for the parameter type
-- An impure function wrapped in a non-pure lambda and passed to a pure
-- function with an unannotated callback param. The lambda body invokes the
-- impure function, so the call must be rejected.
func side_effect(x: Int) -> Int:
	print(to_string(x))
	x


pure func apply(x: Int, f: (Int) -> Int) -> Int:
	f(x)


pure func sneaky(x: Int) -> Int:
	apply(x, func(y: Int) -> Int: side_effect(y))
