-- EXPECT: error: Cannot assign to outer variable 'total' inside `for ... concurrently` body (data race)
-- Test: Mutating an outer var inside for ... concurrently body should be rejected (data race)
func main(args: List[String]) -> Int:
	var total: Int = 0
	for item in [10, 20, 30] concurrently(limit: 2):
		total += item
	total
