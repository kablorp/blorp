-- EXPECT: conflicting
-- Two impls of the same trait for the same concrete type must be rejected
-- at type-checking time, not at C-compilation time (Development Rule 4:
-- catch at the earliest phase where the information exists).
trait Show:
	pure func show(self: Self) -> String


implements Show for Int:
	pure func show(self: Int) -> String:
		"first"


implements Show for Int:
	pure func show(self: Int) -> String:
		"second"


func main(args: List[String]) -> Int:
	0
