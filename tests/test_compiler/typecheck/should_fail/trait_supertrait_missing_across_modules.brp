-- EXPECT: error: impl Discountable for Item: supertrait 'Priceable' is not implemented
-- Step 6 regression: the supertrait-check from M's [Discountable:
-- Priceable] must reach across modules — Item here doesn't impl
-- Priceable, so the Discountable impl must be rejected. Without the
-- session-scoped trait registry (steps 2/3) this check would find
-- no Priceable trait def and silently pass, defeating the coherence
-- guarantee.
import:
	../helpers/trait_chain_m: Discountable


record Item {cents: Int}


implements Discountable for Item:
	pure func discount_pct(self: Item) -> Int:
		10


func main(args: List[String]) -> Int:
	0
