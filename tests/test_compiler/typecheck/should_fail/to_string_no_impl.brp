-- EXPECT: does not implement trait Stringable
-- A record type without a Stringable impl must fail at typecheck time, not
-- fall through to a runtime-specific to_string helper with the wrong calling
-- convention. See [core_specialize.specialize_to_string] fallthrough.
record Pair {a: Int, b: Int}


func main(args: List[String]) -> Int:
	p: Pair = {a = 1, b = 2}
	s: String = to_string(p)
	0
