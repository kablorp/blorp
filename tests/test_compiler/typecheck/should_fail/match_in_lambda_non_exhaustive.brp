-- EXPECT: error: Non-exhaustive match on type 'Option'
-- ERROR: Non-exhaustive match inside lambda body using outer-scope value
-- Tests check_matches_in_expr recursion into ELambda
import:
	option: Option(Some, None)


func apply(f: () -> Int) -> Int:
	f()


func process(opt: Option[Int]) -> Int:
	handler: () -> Int = func():
		match opt:
			Some(x): x
	apply(handler)


func main(args: List[String]) -> Int:
	process(Some(42))
