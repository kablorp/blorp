-- EXPECT: Function 'wrong_return' returns wrong type
-- expect: error
-- BUG: Generic function returns x: T but declared return type is U
-- Since both T and U are type params treated as wildcards, T matches U
func wrong_return[T, U](x: T, y: U) -> U:
	x


func main(args: List[String]) -> Int:
	wrong_return(42, 99)
