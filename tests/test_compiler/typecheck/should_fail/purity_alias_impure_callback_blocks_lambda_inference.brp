-- EXPECT: error: Argument type mismatch: in call to 'accept_pure', argument 1 ('f') expected pure (Int) -> Int, got (Int) -> Int
-- An impure callback hidden behind a type alias must prevent contextual
-- inference from upgrading an unannotated lambda to pure.
type alias ImpureCallback = (Int) -> Int

type alias PureCallback = pure (Int) -> Int


pure func accept_pure(f: PureCallback) -> Int:
	f(1)


func passes_impure_callback(cb: ImpureCallback) -> Int:
	accept_pure(func(n: Int): cb(n))
