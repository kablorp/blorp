-- EXPECT: error: Pure function 'sneaky' cannot call impure function 'f'
-- Test: Impure function called through record field access in pure function.
-- The checker correctly catches the call via EFieldAccess.
record Callback {f: (Int) -> Int}


func side_effect(x: Int) -> Int:
	print(to_string(x))
	x


pure func sneaky(x: Int) -> Int:
	cb: Callback = {f = side_effect}
	cb.f(x)
