-- EXPECT: error: Pure function 'bad' cannot call impure function 'impure_double'
-- Pure function cannot pass an impure callback to pure map.
-- (Prior to the body-preferring dedup landing 2026-04-21 this flagged 'map'
-- itself; now the pure overload is correctly selected and the callback
-- argument is flagged directly, which is the more accurate diagnostic.)
import:
	list: List, map


func impure_double(x: Int) -> Int:
	print(to_string(x))
	x * 2


pure func bad(xs: List[Int]) -> List[Int]:
	xs.map(impure_double)


func main(args: List[String]) -> Int:
	0
