-- EXPECT: Nested parallelism
-- ERROR: Nested parallelism is not supported
-- Calling a parallel operation from inside another parallel operation's callback
func test_nested_parallel() -> Void:
	outer: List[List[Int]] = [[1, 2], [3, 4]]
	result = outer.parallel(pure func(chunk: ParallelList[List[Int]]):
		chunk.map(pure func(inner: List[Int]):
			inner.parallel(pure func(inner_chunk: ParallelList[Int]):
				inner_chunk.map(pure func(x: Int): x * 2)
			)
		)
	)
-- This should fail: calling parallel inside another parallel callback
