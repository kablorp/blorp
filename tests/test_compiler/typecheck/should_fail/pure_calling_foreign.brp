-- EXPECT: error: Pure function 'use_sin' cannot call impure function 'c_sin'
-- Test: pure function calling foreign should be rejected (foreign funcs are always impure)
foreign(include: "math.h"):
	func c_sin(x: Float) -> Float = "sin"


pure func use_sin(x: Float) -> Float:
	c_sin(x)


func main(args: List[String]) -> Int:
	0
