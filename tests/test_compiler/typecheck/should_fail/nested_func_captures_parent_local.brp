-- Nested functions cannot capture parent-scope identifiers because
-- they are hoisted to top level. A reference to a parent local should
-- produce a dedicated "cannot capture parent-scope identifier" error,
-- not the generic "undefined identifier" fallback.

func main(args: List[String]):
	greeting: String = "hello"
	func shout() -> String:
		greeting + "!"
	print(shout())

-- EXPECT: cannot capture parent-scope identifier
-- EXPECT: greeting
