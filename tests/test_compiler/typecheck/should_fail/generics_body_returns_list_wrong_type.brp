-- EXPECT: List element type mismatch: expected T, got #1
-- expect: error
-- Generic function returns List[Int] but declared return is List[T].
-- The function's type parameter T is rigid in the body, so Int literals
-- cannot satisfy it.
func bad[T](x: T) -> List[T]:
	[1, 2, 3]


func main(args: List[String]) -> Int:
	result: List[String] = bad("hello")
	0
