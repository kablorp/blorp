-- EXPECT: Cannot compare type parameters T and U — equality requires
-- expect: error
-- BUG: T == U should be rejected even when both have Equatable bound
-- Equatable means the type can be compared with itself, not with other types
func eq_both_bounded[T:Equatable, U:Equatable](x: T, y: U) -> Bool:
	x == y


func main(args: List[String]) -> Int:
	match eq_both_bounded(42, "hello"):
		True: 1
		False: 0
