-- 2. Check visibility when resolving trait methods
import:
	../helpers/priv_impl_mod: Gadget
	traits: Stringable


func show[T:Stringable](x: T) -> String:
	to_string(x)


func main(args: List[String]) -> Int:
	g: Gadget = {name = "widget"}
	s: String = show(g)
	0
