-- EXPECT: error: Pure function 'bad' cannot call impure function 'for ... concurrently'
-- EXPECT: error: Pure function 'bad' cannot call impure function 'for ... concurrently'
-- for ... concurrently is inherently impure (spawns threads).
-- The purity checker correctly rejects this.
pure func bad(nums: List[Int]) -> Int:
	for n in nums concurrently(limit: 2):
		n * 2
	0
