-- EXPECT: error: Cannot iterate directly over FallibleStream because retrieving an item may fail
-- EXPECT: help: Collect it with collect_result() or use a fallible stream terminal operation
-- EXPECT-NOT-CONTAINS: Cannot access field on type Void
-- EXPECT-NOT-CONTAINS: Type Void does not implement trait Stringable
-- RUN-BLORP-CHECK
import:
	fs: IOError, entry_stream, open_directory


func bad() -> Result[Void, IOError]:
	with directory ?= open_directory("."):
		for entry in directory.entry_stream():
			print(entry.name)
		for (entry, other) in directory.entry_stream():
			print(entry.name + other.name)

		Ok(void)


func main(args: List[String]):
	match bad():
		Ok(_):
			void
		Err(_):
			void
