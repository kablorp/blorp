-- EXPECT: can only be used in the standard library
-- [type Name = builtin] declares a compiler-provided primitive. Allowing
-- it in user code would produce a cryptic C-compile error on first use
-- (the type has no representation outside the runtime). Reject at
-- type-check time so the error is clear.
type Potato = builtin


