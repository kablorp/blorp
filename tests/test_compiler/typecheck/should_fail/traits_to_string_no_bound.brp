-- EXPECT: Type parameter T requires trait bound Stringable to call to_
-- expect: error
-- BUG: to_string on type param T without Stringable bound should be rejected
-- to_string is not registered as a trait function for Stringable,
-- so check_trait_bound_on_arg returns Ok immediately
func stringify[T](x: T) -> String:
	to_string(x)


func main(args: List[String]) -> Int:
	stringify(42)
	0
