-- EXPECT: error: scoped resource 'stream' is unavailable while session is in scope
import:
	net/tcp as TCP
	net/tls as TLS: TlsError


func bad() -> Result[Int, TlsError]:
	with stream ?= TCP.connect("127.0.0.1", 1) on err => TLS.Transport(TCP.message(err)):
		with session ?= TLS.connect(stream, "localhost"):
			_ = TCP.set_stream_timeout(stream, 1)
			Ok(0)
