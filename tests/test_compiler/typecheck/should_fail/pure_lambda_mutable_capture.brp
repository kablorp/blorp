-- EXPECT: error: Closure cannot capture mutable variable: counter. Use explicit state threading instead.
-- Test that lambdas cannot capture mutable variables
-- This would cause data races in parallel execution
func test_mutable_capture() -> Int:
	var counter: Int = 0
	f: (Int) -> Int = func(x: Int): x + counter
	f(10)
-- This should fail: lambda captures mutable 'counter'
