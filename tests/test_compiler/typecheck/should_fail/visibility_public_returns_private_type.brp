-- EXPECT: private type
-- BUG: A public function can return a private record type, leaking it to importers.
-- The private type becomes usable (though opaque) outside the module. The compiler
-- should either warn at the module definition site or prevent annotation with the
-- private type name at the import site.
import:
	../helpers/leaky_types_mod: default_config, is_debug


func main(args: List[String]) -> Int:
	c: Config = default_config()
	if is_debug(c):
		1
	else:
		0
