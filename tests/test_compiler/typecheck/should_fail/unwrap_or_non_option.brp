-- EXPECT: expects 3 arguments
-- Calling get_or on a non-Option value via UFCS inside try: must be rejected.
-- nl is List[String] (extracted by ?=), not Option[T].
import:
	list: List, append, set_index
	option: Option(Some, None), get_or


func test() -> Option[List[String]]:
	lst: List[String] = [""]
	try:
		nl ?= lst.set_index(0, "x")
		nl.get_or(lst)
