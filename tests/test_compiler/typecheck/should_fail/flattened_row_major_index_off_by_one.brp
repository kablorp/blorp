-- EXPECT: Subscript index must be a compile-time constant or a loop variable proven in-bounds
import:
	tensor: length, vector


pure func bad_flatten[T, #M, #N](m: T[#M, #N]) -> T[#M * #N]:
	first_row: T[#N] = m[0]
	var out: T[#M * #N] = vector(first_row[0], length(m) * length(first_row))
	for row in 0..length(m):
		values: T[#N] = m[row]
		for col in 0..length(values):
			out[row * length(values) + col + 1] = values[col]
	out
