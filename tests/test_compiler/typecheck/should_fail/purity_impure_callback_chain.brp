-- EXPECT: impure
-- Multi-level indirection through pure functions with unannotated callback
-- params must not allow impure code to execute within a pure context. Each
-- level passes the impure callback through to the next.
pure func level3(x: Int, f: (Int) -> Int) -> Int:
	f(x)


pure func level2(x: Int, f: (Int) -> Int) -> Int:
	level3(x, f)


pure func level1(x: Int) -> Int:
	level2(x, func(y: Int) -> Int:
		print(to_string(y))
		y
	)
