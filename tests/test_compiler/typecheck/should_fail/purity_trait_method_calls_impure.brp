-- EXPECT: error: Pure function 'process' cannot call impure function 'print'
-- Test: Pure trait method implementation calls impure function.
-- The checker correctly checks purity of impl method bodies.
trait Processor:
	pure func process(self: Self) -> Int


record MyProcessor {value: Int}


implements Processor for MyProcessor:
	pure func process(self: MyProcessor) -> Int:
		print(to_string(self.value))
		self.value
