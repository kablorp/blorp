import:
	list: fold_left


-- EXPECT: cannot call impure function
-- Test that HOFs with impure callbacks cannot be called from pure functions
-- fold_left with an impure callback should fail in a pure function context
func log_and_add(acc: Int, x: Int) -> Int:
	print(to_string(x))
	acc + x


pure func bad(nums: List[Int]) -> Int:
	nums.fold_left(0, log_and_add)
