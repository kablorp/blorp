-- EXPECT: does not implement
-- EXPECT: Addable
-- EXPECT: std/traits
-- Calling `+` on a type that doesn't implement Addable should surface
-- Addable's home module in the diagnostic so users know where the trait
-- is declared (not just that one exists). Track B: qualified diagnostics.
record MyBox {value: String}


func main(args: List[String]) -> Int:
	a: MyBox = {value = "a"}
	b: MyBox = {value = "b"}
	_ = a + b
	0
