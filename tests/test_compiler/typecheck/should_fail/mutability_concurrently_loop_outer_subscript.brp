-- EXPECT: Cannot assign to outer variable 'totals' inside concurrent for
-- Mutating a captured collection through subscript assignment is still an
-- outer mutation and must be rejected.
func main(args: List[String]) -> Int:
	var totals: Int[#3] = {0, 0, 0}
	for item in [1, 2, 3] concurrently(limit: 2):
		totals[0] = item
	0
