-- EXPECT: error: `for ... concurrently(...)` is statement-only and does not collect results
-- EXPECT: help: Use `items.concurrent(limit, func(item): ...)` to collect one Result per input, or `items.concurrent_with_timeout(limit, timeout, func(item): ...)` when collected fan-out needs a deadline.
func main(args: List[String]) -> Int:
	nums: List[Int] = [1, 2, 3]
	results: List[Result[Int, ConcurrencyError]] = for n in nums concurrently(limit: 2):
		n * 2
	results.length()
