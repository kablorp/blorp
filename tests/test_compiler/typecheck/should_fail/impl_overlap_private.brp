-- EXPECT: conflicting
-- Two [private implements] blocks for the same trait/type emit the same
-- mangled C symbol (Show_show_Int) even though they are scoped private.
-- Coherence must reject the overlap at type-check time, not leave it for
-- the C compiler's redefinition error.
trait Show:
	pure func show(self: Self) -> String


private implements Show for Int:
	pure func show(self: Int) -> String:
		"first"


private implements Show for Int:
	pure func show(self: Int) -> String:
		"second"


func main(args: List[String]) -> Int:
	0
