-- EXPECT: error: Type parameter Element does not have bound Stringable (required by stringify)
-- Multi-character generic parameters must not silently satisfy a callee's
-- bound unless the caller forwards that bound explicitly.
pure func stringify[Item:Stringable](value: Item) -> String:
	to_string(value)


pure func wrapper[Element](value: Element) -> String:
	stringify(value)


func main(args: List[String]) -> Int:
	_ = wrapper(42)
	0
