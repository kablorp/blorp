	with listener ?= Tcp.listen("127.0.0.1", 0, 1):
		make_source: () -> ResourceSource[TcpStream, TcpError] = func():
			Tcp.connections_stop_on_error(listener)
		_ = make_source
		Ok(0)


func main(args: List[String]) -> Int:
	0
