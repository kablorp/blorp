-- EXPECT: cannot call impure function
-- 4-level transitive purity violation.
func side_effect(x: Int) -> Int:
	print(to_string(x))
	x


pure func level3(x: Int) -> Int:
	side_effect(x)


pure func level2(x: Int) -> Int:
	level3(x)


pure func level1(x: Int) -> Int:
	level2(x)


func main(args: List[String]) -> Int:
	level1(42)
