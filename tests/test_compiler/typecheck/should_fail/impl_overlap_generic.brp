-- EXPECT: error: conflicting implementation of trait 'Show' for type 'List[T]'
-- Two generic impls of the same trait for the same type constructor overlap:
-- both match every List[T]. This is the simplest generic-overlap case and
-- must be rejected by the coherence check.
trait Show:
	pure func show(self: Self) -> String


implements Show for List[T]:
	pure func show(self: List[T]) -> String:
		"first"


implements Show for List[T]:
	pure func show(self: List[T]) -> String:
		"second"


func main(args: List[String]) -> Int:
	0
