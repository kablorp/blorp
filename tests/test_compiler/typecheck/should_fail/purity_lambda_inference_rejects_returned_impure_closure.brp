-- EXPECT: error: Argument type mismatch: in call to 'accept', argument 1 ('f') expected pure () -> Int, got () -> Int
-- Regression: contextual purity inference must reject an unannotated lambda that
-- invokes a returned impure closure.
pure func accept(f: pure () -> Int) -> Int:
	f()


pure func make_impure() -> () -> Int:
	func() -> Int:
		print("side effect")
		1


func test() -> Int:
	accept(func() -> Int:
		make_impure()()
	)
