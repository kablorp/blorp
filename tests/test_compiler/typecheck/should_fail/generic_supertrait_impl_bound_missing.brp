-- EXPECT: supertrait 'Equatable' is not implemented
-- expect: error
-- Box[Element: Stringable] is not enough to satisfy Hashable's Equatable
-- supertrait requirement, even though Box has a generic Equatable impl
-- for Element: Equatable.
record Box[Element] {value: Element}


implements Equatable for Box[Element:Equatable]:
	pure func equals[Element:Equatable](a: Box[Element], b: Box[Element]) -> Bool:
		a.value == b.value


implements Hashable for Box[Element:Stringable]:
	pure func hash[Element:Stringable](self: Box[Element]) -> Int:
		length(self.value.to_string())


func main(args: List[String]) -> Int:
	0
