-- EXPECT: expected pure
-- Test passing impure lambda where pure is expected
-- This should fail: lambda calls print (impure)
func apply(f: pure (Int) -> Int, x: Int) -> Int:
	f(x)


func main(args: List[String]) -> Int:
	-- This lambda is impure because it calls print
	result = apply(func(n: Int) -> Int:
		print(to_string(n))
		n * 2
	, 10)
	print(to_string(result))
	0
