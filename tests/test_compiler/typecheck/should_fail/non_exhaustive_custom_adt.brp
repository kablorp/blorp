-- EXPECT: Non-exhaustive match on type 'Shape'
-- EXPECT: Missing constructors: Triangle
-- ERROR: Non-exhaustive match on custom 3+ variant union
-- Tests check_adt_exhaustiveness with user-defined types
-- Uses variants with args since nullary constructors parse as PatVar
union Shape:
	Circle(Int)
	Square(Int)
	Triangle(Int)


func area(s: Shape) -> Int:
	match s:
		Circle(r): r * r
		Square(side): side * side
