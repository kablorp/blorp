-- EXPECT: impure
-- A pure function accepts a callback parameter without a 'pure' annotation.
-- An impure function reference is passed as that callback. The compiler should reject
-- this because the pure function will invoke the impure callback, violating purity.
--
pure func apply(x: Int, f: (Int) -> Int) -> Int:
	f(x)


func side_effect(x: Int) -> Int:
	print(to_string(x))
	x


pure func sneaky(x: Int) -> Int:
	apply(x, side_effect)
