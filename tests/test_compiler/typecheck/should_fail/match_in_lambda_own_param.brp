-- EXPECT: error: Non-exhaustive match on type 'Option'
-- ERROR: Non-exhaustive match in lambda using lambda's own parameter
-- Tests that check_matches_in_expr sets up lambda param scope
import:
	option: Option(Some, None)


func apply(f: (Option[Int]) -> Int) -> Int:
	f(Some(42))


func main(args: List[String]) -> Int:
	handler: (Option[Int]) -> Int = func(x: Option[Int]):
		match x:
			Some(v): v
	apply(handler)
