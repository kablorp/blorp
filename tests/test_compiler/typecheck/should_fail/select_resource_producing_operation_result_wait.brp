-- EXPECT: error: resource-producing select arms are not implemented yet
-- EXPECT: note: `blorp_tcp_accept_raw` parks the current fiber and returns independently-owned resource.
import:
	net/tcp as Tcp: TcpError


func bad() -> Result[Int, TcpError]:
	with listener ?= Tcp.listen("127.0.0.1", 0, 1):
		select:
			stream from Tcp.accept(listener):
				_ = stream
		Ok(0)
