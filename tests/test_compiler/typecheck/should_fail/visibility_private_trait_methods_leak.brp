-- EXPECT: error: 'secret_method' is private in module '../helpers/trait_mod' and cannot be imported
-- BUG: Methods from a private trait are publicly exported because the impl block
-- is not wrapped in private. The trait SecretTrait is private, but its impl for
-- Widget exports 'secret_method' as a public function. The compiler should either:
-- 1. Automatically treat impl methods for private traits as private, OR
-- 2. Error when implementing a private trait with a public impl block
import:
	../helpers/trait_mod: Widget, secret_method


func main(args: List[String]) -> Int:
	w: Widget = {id = 42}
	x: Int = secret_method(w)
	0
