-- EXPECT: Type parameter T does not have bound Equatable (required by
-- expect: error
-- BUG: wrapper[T] calls needs_bound[T: Equatable] without declaring the bound
-- The trait bound should propagate: if you call a function requiring T: Equatable,
-- your own T must also have that bound
func needs_bound[T:Equatable](x: T, y: T) -> Bool:
	x == y


func wrapper[T](x: T, y: T) -> Bool:
	needs_bound(x, y)


func main(args: List[String]) -> Int:
	match wrapper(1, 2):
		True: 1
		False: 0
