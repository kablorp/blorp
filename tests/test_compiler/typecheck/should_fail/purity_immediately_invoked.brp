-- EXPECT: cannot call impure function
-- Test: Expression-level callee (immediately invoked return value) in pure function.
-- The checker's strict mode catches non-ident callees via check_non_ident_callee.
pure func get_fn() -> (Int) -> Int:
	func(x: Int) -> Int:
		print(to_string(x))
		x


pure func bad(x: Int) -> Int:
	get_fn()(x)
