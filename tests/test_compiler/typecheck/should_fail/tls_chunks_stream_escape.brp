-- EXPECT: error: Function 'bad' return type cannot contain a one-shot stream type
import:
	net/tcp as TCP
	net/tls as TLS: TlsError
	stream: FallibleStream


func bad() -> Result[FallibleStream[Bytes, TlsError], TlsError]:
	with tcp_stream ?= TCP.connect("127.0.0.1", 1) on err => TLS.Transport(TCP.message(err)):
		with session ?= TLS.connect(tcp_stream, "localhost"):
			Ok(TLS.chunks(session, 64))
