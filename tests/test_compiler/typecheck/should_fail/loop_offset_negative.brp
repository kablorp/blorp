-- EXPECT: error: Loop offset i - 1: index range [-1, 8] exceeds dimension of size 10. Adjust loop bounds to ensure all accesses are in [0, 10)
-- Loop offset underflow: v[i-1] in for i in 0..length(v) underflows at i=0
pure func bad_negative_offset(v: Float[#10]) -> Float:
	var sum: Float = 0.0
	for i in 0..10:
		sum += v[i - 1]
	sum
