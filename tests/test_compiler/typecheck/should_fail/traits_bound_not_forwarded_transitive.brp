-- EXPECT: Type parameter T does not have bound Equatable (required by
-- expect: error
-- BUG: Two-level forwarding without bounds
-- outer[T] -> middle[T] -> needs_bound[T: Equatable]
-- Neither outer nor middle declare the Equatable bound
func needs_bound[T:Equatable](x: T, y: T) -> Bool:
	x == y


func middle[T](x: T, y: T) -> Bool:
	needs_bound(x, y)


func outer[T](x: T, y: T) -> Bool:
	middle(x, y)


func main(args: List[String]) -> Int:
	match outer(1, 2):
		True: 1
		False: 0
