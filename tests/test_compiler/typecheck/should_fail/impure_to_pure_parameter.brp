-- EXPECT: expected pure
-- Test passing impure function where pure is required
-- This should fail
func apply_twice(f: pure (Int) -> Int, x: Int) -> Int:
	f(f(x))


-- impure function (calls print)
func impure_double(x: Int) -> Int:
	print(to_string(x))
	x + x


func main(args: List[String]) -> Int:
	result = apply_twice(impure_double, 3)
	print(to_string(result))
	0
