-- EXPECT: already registered
-- EXPECT: distinct set of method names
-- Two unrelated user traits claiming the same method name — the
-- compiler should flag this at the second trait's registration so
-- users don't silently get first-registered-wins dispatch.
trait Serializer:
	pure func encode(value: Self) -> String


trait Formatter:
	pure func encode(value: Self) -> String


func main(args: List[String]) -> Int:
	0
