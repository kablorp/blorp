-- EXPECT: Pure function 'bad' cannot call impure function 'impure_apply'
-- A pure callback argument does not make an impure higher-order callee pure.
func impure_apply(x: Int, f: pure (Int) -> Int) -> Int:
	print("side effect")
	f(x)


pure func double(x: Int) -> Int:
	x * 2


pure func bad(x: Int) -> Int:
	impure_apply(x, double)
