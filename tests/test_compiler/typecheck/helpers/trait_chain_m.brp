-- Module M: middle of a three-module trait supertrait chain.
-- Declares a trait that extends P's [Priceable]. Notably, M does
-- NOT re-export P's trait; the importing file downstream will
-- never `import: trait_chain_p` directly.
import:
	../helpers/trait_chain_p: Priceable


trait Discountable: Priceable:
	pure func discount_pct(self: Self) -> Int
