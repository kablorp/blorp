-- @tailrec functions with list destructuring patterns must declare
-- pattern variables (like `head`) as C locals, not confuse them
-- with module functions that share the same name.
@tailrec
func sum_list(items: List[Int], acc: Int) -> Int:
	match items:
		[]: acc
		[head, ...rest]: sum_list(rest, acc + head)


func main(args: List[String]) -> Int:
	result: Int = sum_list([10, 20, 30], 0)
	if result != 60:
		print("FAIL: expected 60, got " + to_string(result))
		1
	else:
		0
