import:
	pkg/net/dns as DNS
	pkg/net/tls as TLS
	pkg/net/udp as UDP


func main(args: List[String]) -> Int:
	-- TCP-backed package clients are intentionally excluded here until they
	-- migrate from ordinary handle storage to scoped TCP resources.
	if args.length() < 0:
		_ = DNS.resolve("localhost")
		_ = UDP.socket()
		_ = TLS.connect("localhost", 443)
	0
