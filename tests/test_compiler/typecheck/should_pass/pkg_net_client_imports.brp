import:
	pkg/net/dns as DNS
	pkg/net/http_client as HTTP
	pkg/net/smtp as SMTP
	pkg/net/tls as TLS
	pkg/net/udp as UDP
	pkg/net/websocket as WS


func main(args: List[String]) -> Int:
	if args.length() < 0:
		_ = DNS.resolve("localhost")
		_ = HTTP.request("GET", "http://example.com/", [], None)
		_ = SMTP.build_message("from", "to", "subject", "body", "text/plain")
		_ = UDP.socket()
		_ = TLS.connect("localhost", 443)
		_ = WS.apply_mask("ping".to_bytes(), "mask".to_bytes())
	0
