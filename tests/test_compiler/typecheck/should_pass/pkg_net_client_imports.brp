import:
	pkg/net/dns as DNS
	pkg/net/http_client: request
	pkg/net/smtp as SMTP: Config
	pkg/net/tls as TLS
	pkg/net/udp as UDP
	pkg/net/websocket as WS: Message(Text), Transport, WebSocket


func close_ws(ws: WebSocket) -> Void:
	WS.close(ws)


func keep_transport(transport: Transport) -> Transport:
	transport


func main(args: List[String]) -> Int:
	cfg: Config = {host = "localhost", port = 25, username = "", password = "", use_tls = False}
	msg: Message = Text("hello")
	if args.length() < 0:
		_ = DNS.resolve("localhost")
		_ = UDP.socket()
		_ = TLS.connect("localhost", 443)
		_ = request("GET", "http://localhost", [], None)
		_ = SMTP.send_email(cfg, "to@example.com", "subject", "body")
	match msg:
		Text(s):
			if s.length() == 5:
				0
			else:
				1
		_: 1
