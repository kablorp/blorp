record Cache[K, V] {
	capacity: Int,
	data: Dict[K, (V, Int)],
	counter: Int
}


func make_cache[K, V](key: Result[K, String]) -> Result[Cache[K, V], String]:
	k ?= key
	cache: Cache[K, V] = {
		capacity = 1,
		data = {},
		counter = 0
	}
	Ok(cache)


func main(args: List[String]) -> Int:
	c: Result[Cache[String, Int], String] = make_cache(Ok("x"))
	0
