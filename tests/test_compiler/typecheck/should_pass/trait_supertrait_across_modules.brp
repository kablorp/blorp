-- Step 6 regression: a supertrait chain spanning three modules must
-- resolve cleanly.
--
-- Module P declares [Priceable]; M declares [Discountable: Priceable]
-- and imports P; this file imports only M and Priceable (needed to
-- impl it locally). The session-scoped trait registry carries P's
-- [Priceable] def to the typecheck state here, so:
-- (1) the supertrait relation [Discountable: Priceable] is
-- resolvable when validating the [implements Discountable for
-- Item] impl (the supertrait check requires Priceable to be
-- implemented);
-- (2) bound propagation [T: Discountable] transitively requires
-- [T: Priceable].
import:
	../helpers/trait_chain_m: Discountable
	../helpers/trait_chain_p: Priceable


record Item {cents: Int}


implements Priceable for Item:
	pure func price_cents(self: Item) -> Int:
		self.cents


-- Validating this impl must succeed: the supertrait check confirms
-- Item implements Priceable (which we declared directly above). If
-- the session-scoped trait registry weren't consulting P's Priceable
-- def, validate_impl would silently skip the supertrait requirement
-- and we'd lose the coherence guarantee.
implements Discountable for Item:
	pure func discount_pct(self: Item) -> Int:
		10


func main(args: List[String]) -> Int:
	0
