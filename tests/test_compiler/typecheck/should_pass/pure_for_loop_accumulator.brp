-- Test: Pure function with for-loop accumulator pattern
-- Local mutation via for-loop is allowed in pure functions
pure func sum_to(n: Int) -> Int:
	var total: Int = 0
	var i: Int = 1
	while i <= n:
		total += i
		i += 1
	total


pure func factorial(n: Int) -> Int:
	var result: Int = 1
	var i: Int = n
	while i > 1:
		result *= i
		i -= 1
	result


pure func sum_squares(a: Int, b: Int) -> Int:
	var total: Int = 0
	total += a * a
	total += b * b
	total
