compile_time:
	SOME_TWENTY: Option[Int] = Some(20)
	SOME_FORTY_TWO: Option[Int] = Some(42)
	NONE_INT: Option[Int] = None
	OK_TWENTY: Result[Int, String] = Ok(20)
	ERR_MISS: Result[Int, String] = Err("miss")
	ERR_MISSING: Result[Int, String] = Err("missing")
	OPTION_MAP: Option[Int] = SOME_TWENTY.map(func(value: Int) -> Int: value + 22)
	OPTION_FILTER_KEEP: Option[Int] = SOME_FORTY_TWO.filter(func(value: Int) -> Bool: value > 40)
	OPTION_FILTER_DROP: Option[Int] = SOME_TWENTY.filter(func(value: Int) -> Bool: value > 40)
	OPTION_AND_THEN: Option[Int] = SOME_TWENTY.and_then(
		func(value: Int) -> Option[Int]: Some(value + 22),
	)
	OPTION_DEFAULT: Int = NONE_INT.get_or_else(func() -> Int: 42)
	RESULT_MAP: Result[Int, String] = OK_TWENTY.map(func(value: Int) -> Int: value + 22)
	RESULT_MAP_ERR: Result[Int, String] = ERR_MISS.map_err(
		func(value: String) -> String: value + "ing",
	)
	RESULT_AND_THEN: Result[Int, String] = OK_TWENTY.and_then(
		func(value: Int) -> Result[Int, String]: Ok(value + 22),
	)
	RESULT_DEFAULT: Int = ERR_MISSING.get_or_else(func(error: String) -> Int:
		if error == "missing":
			7
		else:
			0
	)


func main(args: List[String]) -> Int:
	option_map_ok: Bool = match OPTION_MAP:
		Some(value): value == 42
		None: False

	option_filter_keep_ok: Bool = match OPTION_FILTER_KEEP:
		Some(value): value == 42
		None: False

	option_filter_drop_ok: Bool = match OPTION_FILTER_DROP:
		Some(_): False
		None: True

	option_and_then_ok: Bool = match OPTION_AND_THEN:
		Some(value): value == 42
		None: False

	result_map_ok: Bool = match RESULT_MAP:
		Ok(value): value == 42
		Err(_): False

	result_map_err_ok: Bool = match RESULT_MAP_ERR:
		Ok(_): False
		Err(value): value == "missing"

	result_and_then_ok: Bool = match RESULT_AND_THEN:
		Ok(value): value == 42
		Err(_): False

	if (
		option_map_ok
		and option_filter_keep_ok
		and option_filter_drop_ok
		and option_and_then_ok
		and OPTION_DEFAULT == 42
		and result_map_ok
		and result_map_err_ok
		and result_and_then_ok
		and RESULT_DEFAULT == 7
	):
		0
	else:
		1
