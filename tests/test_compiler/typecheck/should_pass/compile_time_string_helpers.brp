compile_time:
	SLICE: String = "hello world".substring(6, 5)
	NEGATIVE_START_SLICE: String = "hello".substring(-5, 3)
	NEGATIVE_LEN_SLICE: String = "hello".substring(0, -1)
	OVERLONG_SLICE: String = "hello".substring(3, 100)
	START_BEYOND_SLICE: String = "hello".substring(100, 5)
	DROP_LEFT: String = "abcdef".drop_left(2)
	DROP_LEFT_NEGATIVE: String = "abcdef".drop_left(-2)
	DROP_LEFT_OVERLONG: String = "abcdef".drop_left(99)
	TAKE_LEFT: String = "abcdef".take_left(3)
	TAKE_LEFT_NEGATIVE: String = "abcdef".take_left(-2)
	TAKE_LEFT_OVERLONG: String = "abcdef".take_left(99)
	TRIMMED: String = "\t hello \r\n".trim()
	TRIMMED_LEFT: String = "\n hello ".trim_left()
	TRIMMED_RIGHT: String = " hello \r\n".trim_right()
	REVERSED: String = "stressed".reverse()
	COUNT_TWO: Int = "aaaa".count("aa")
	COUNT_EMPTY: Int = "aaaa".count("")
	SPLIT_COMMA: List[String] = "a,b,c".split(",")
	SPLIT_EMPTY_PARTS: List[String] = "a,,b".split(",")
	SPLIT_MULTI: List[String] = "a::b::c".split("::")
	SPLIT_EMPTY_DELIM: List[String] = "abc".split("")
	SPLIT_NO_MATCH: List[String] = "abc".split(",")
	REPLACED_LONGER: String = "ab".replace("a", "xyz")
	REPLACED_SHORTER: String = "aaa".replace("aa", "b")
	REPLACED_EMPTY: String = "hello".replace("l", "")
	REPLACED_NO_MATCH: String = "hello".replace("z", "x")
	REPLACED_EMPTY_NEEDLE: String = "ab".replace("", "x")
	REPEATED: String = "ab".repeat(3)
	REPEATED_ZERO: String = "hi".repeat(0)
	REPEATED_NEGATIVE: String = "hi".repeat(-2)
	HAS_PREFIX: Bool = "hello".starts_with("hel")
	MISSING_PREFIX: Bool = "hi".starts_with("hello")
	HAS_SUFFIX: Bool = "hello".ends_with("llo")
	MISSING_SUFFIX: Bool = "hello".ends_with("world")
	HAS_NEEDLE: Bool = "hello world".contains("lo wo")
	EMPTY_NEEDLE: Bool = "hello".contains("")
	MISSING_NEEDLE: Bool = "hello".contains("xyz")
	NEEDLE_INDEX: Int = "hello world".raw_index_of("world")
	MISSING_INDEX: Int = "hello".raw_index_of("xyz")
	NEEDLE_OPTION: Option[Int] = "hello world".index_of("world")
	MISSING_OPTION: Option[Int] = "hello".index_of("xyz")
	FIRST_CHAR: Option[Char] = "hello".get(0)
	MISSING_CHAR: Option[Char] = "hello".get(99)
	FALLBACK_CHAR: Char = "hello".get_or(99, '?')
	FROM_CHAR: String = from_char('Z')
	CHARS: List[Char] = "az".chars()
	FROM_CHARS: String = from_chars(['o', 'k'])


func main(args: List[String]) -> Int:
	if (
		SLICE == "world"
		and NEGATIVE_START_SLICE == "hel"
		and NEGATIVE_LEN_SLICE == ""
		and OVERLONG_SLICE == "lo"
		and START_BEYOND_SLICE == ""
		and DROP_LEFT == "cdef"
		and DROP_LEFT_NEGATIVE == "abcdef"
		and DROP_LEFT_OVERLONG == ""
		and TAKE_LEFT == "abc"
		and TAKE_LEFT_NEGATIVE == ""
		and TAKE_LEFT_OVERLONG == "abcdef"
		and TRIMMED == "hello"
		and TRIMMED_LEFT == "hello "
		and TRIMMED_RIGHT == " hello"
		and REVERSED == "desserts"
		and COUNT_TWO == 2
		and COUNT_EMPTY == 0
		and SPLIT_COMMA == ["a", "b", "c"]
		and SPLIT_EMPTY_PARTS == ["a", "", "b"]
		and SPLIT_MULTI == ["a", "b", "c"]
		and SPLIT_EMPTY_DELIM == ["abc"]
		and SPLIT_NO_MATCH == ["abc"]
		and REPLACED_LONGER == "xyzb"
		and REPLACED_SHORTER == "ba"
		and REPLACED_EMPTY == "heo"
		and REPLACED_NO_MATCH == "hello"
		and REPLACED_EMPTY_NEEDLE == "ab"
		and REPEATED == "ababab"
		and REPEATED_ZERO == ""
		and REPEATED_NEGATIVE == ""
		and HAS_PREFIX
		and not MISSING_PREFIX
		and HAS_SUFFIX
		and not MISSING_SUFFIX
		and HAS_NEEDLE
		and EMPTY_NEEDLE
		and not MISSING_NEEDLE
		and NEEDLE_INDEX == 6
		and MISSING_INDEX == -1
		and match NEEDLE_OPTION:
			Some(index): index == 6
			None: False
		and match MISSING_OPTION:
			Some(_): False
			None: True
		and match FIRST_CHAR:
			Some(char): char == 'h'
			None: False
		and match MISSING_CHAR:
			Some(_): False
			None: True
		and FALLBACK_CHAR == '?'
		and FROM_CHAR == "Z"
		and CHARS == ['a', 'z']
		and FROM_CHARS == "ok"
	):
		0
	else:
		1
