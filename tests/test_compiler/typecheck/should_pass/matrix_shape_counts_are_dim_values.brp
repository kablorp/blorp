rows: #2 = values.row_count()

columns: #3 = values.column_count()


func row_sized_vector[#M, #N](m: Int[#M, #N]) -> Int[#M]:
	vector(0, m.row_count())


func column_sized_vector[#M, #N](m: Int[#M, #N]) -> Int[#N]:
