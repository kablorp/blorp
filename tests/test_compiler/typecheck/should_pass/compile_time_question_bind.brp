import:
	result: Result(Ok, Err)


private pure func option_sum(left: Option[Int], right: Option[Int]) -> Option[Int]:
	left_value ?= left
	right_value ?= right
	Some(left_value + right_value)


private pure func result_sum(
	left: Result[Int, String],
	right: Result[Int, String],
) -> Result[Int, String]:
	left_value ?= left
	right_value ?= right
	Ok(left_value + right_value)


compile_time:
	OPTION_SOME: Option[Int] = option_sum(Some(20), Some(22))
	OPTION_NONE: Option[Int] = option_sum(Some(20), None)
	RESULT_OK: Result[Int, String] = result_sum(Ok(20), Ok(22))
	RESULT_ERR: Result[Int, String] = result_sum(Ok(20), Err("stop"))


func main(args: List[String]) -> Int:
	option_some_ok: Bool = match OPTION_SOME:
		Some(value): value == 42
		None: False

	option_none_ok: Bool = match OPTION_NONE:
		Some(_): False
		None: True

	result_ok_ok: Bool = match RESULT_OK:
		Ok(value): value == 42
		Err(_): False

	result_err_ok: Bool = match RESULT_ERR:
		Ok(_): False
		Err(value): value == "stop"

	if option_some_ok and option_none_ok and result_ok_ok and result_err_ok:
		0
	else:
		1
