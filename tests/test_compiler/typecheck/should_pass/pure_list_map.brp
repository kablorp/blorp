-- Pure functions can call pure list HOF overloads
import:
	list: List, filter, filter_map, flat_map, fold_left, map, map_indexed
	option: Option(Some, None)


pure func double_all(xs: List[Int]) -> List[Int]:
	xs.map(pure func(x: Int): x * 2)


pure func evens(xs: List[Int]) -> List[Int]:
	xs.filter(pure func(x: Int): x % 2 == 0)


pure func with_index(xs: List[Int]) -> List[Int]:
	xs.map_indexed(pure func(i: Int, x: Int): i + x)


pure func expand(xs: List[Int]) -> List[Int]:
	xs.flat_map(pure func(x: Int): [x, x])


pure func total(xs: List[Int]) -> Int:
	xs.fold_left(0, pure func(acc: Int, x: Int): acc + x)


pure func to_positive(x: Int) -> Option[Int]:
	if x > 0:
		Some(x)
	else:
		None


pure func keep_positive(xs: List[Int]) -> List[Int]:
	xs.filter_map(to_positive)


func main(args: List[String]) -> Int:
	0
