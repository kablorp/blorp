-- Short type names (1-2 chars) must not be confused with type variables.
-- Db, Hz, etc. are concrete types, not generic parameters.
-- Trait dispatch must find the correct impl for each type.
struct Db {value: Float}


struct Hz {value: Float}


struct Px {value: Int}


implements Addable for Db:
	pure func add(a: Db, b: Db) -> Db:
		{value = a.value + b.value}


implements Addable for Hz:
	pure func add(a: Hz, b: Hz) -> Hz:
		{value = a.value + b.value}


implements Addable for Px:
	pure func add(a: Px, b: Px) -> Px:
		{value = a.value + b.value}


func main(args: List[String]):
	d1: Db = {value = -3.0}
	d2: Db = {value = -6.0}
	d3: Db = d1 + d2
	h1: Hz = {value = 440.0}
	h2: Hz = {value = 220.0}
	h3: Hz = h1 + h2
	p1: Px = {value = 10}
	p2: Px = {value = 20}
	p3: Px = p1 + p2
	print(to_string(d3.value))
	print(to_string(h3.value))
	print(to_string(p3.value))
