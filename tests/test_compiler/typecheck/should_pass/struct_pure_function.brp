-- Test: pure functions can accept and return structs
struct Vec2 {
	x: Float,
	y: Float
}


pure func vec2_add(a: Vec2, b: Vec2) -> Vec2:
	{
		x = a.x + b.x,
		y = a.y + b.y
	}


pure func vec2_scale(v: Vec2, s: Float) -> Vec2:
	{
		x = v.x * s,
		y = v.y * s
	}


func main(args: List[String]) -> Int:
	a: Vec2 = {
		x = 1.0,
		y = 2.0
	}
	b: Vec2 = {
		x = 3.0,
		y = 4.0
	}
	result: Vec2 = vec2_add(a, b)
	0
