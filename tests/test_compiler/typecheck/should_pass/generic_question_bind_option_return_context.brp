record Cache[K, V] {capacity: Int, data: Dict[K, (V, Int)], counter: Int}


func make_cache[K, V](key: Option[K]) -> Option[Cache[K, V]]:
	k ?= key
	cache: Cache[K, V] = {capacity = 1, data = {}, counter = 0}
	Some(cache)


func main(args: List[String]) -> Int:
	c: Option[Cache[String, Int]] = make_cache(Some("x"))
	0
