-- Dimension parameters are allowed on type aliases.
type alias Columns[T, #N] = T[#N]

type alias FloatRow[#N] = Float[#N]


func count_columns[T, #N](items: Columns[T, #N]) -> Int:
	length(items)


func row_sum(row: FloatRow[#2]) -> Float:
	row[0] + row[1]


func main(args: List[String]) -> Int:
	row: FloatRow[#2] = {1.0, 2.0}
	if count_columns(row) == 2 and row_sum(row) == 3.0:
		0
	else:
		1
