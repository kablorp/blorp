-- Trait method calls with proper bounds should succeed
import:
	traits: Equatable, Integer


-- equals with Equatable bound: OK
func check_eq[T:Equatable](x: T, y: T) -> Bool:
	equals(x, y)


-- to_string with Stringable via Integer supertrait: OK
func show[T:Integer](x: T) -> String:
	to_string(x)


-- Bound forwarding when caller has the bound: OK
func needs_eq[T:Equatable](x: T, y: T) -> Bool:
	x == y


func wrapper[T:Equatable](x: T, y: T) -> Bool:
	needs_eq(x, y)


-- Transitive: Integer implies Equatable
func int_eq[T:Integer](x: T, y: T) -> Bool:
	needs_eq(x, y)


func main(args: List[String]) -> Int:
	0
