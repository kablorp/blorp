-- A pure function that takes a pure-function parameter must type-check.
-- Regression for pure callback parameters used by UI-style helper APIs.
union Msg:
	UpdateInput(String)
	Reset


pure func on_input[M](handler: pure (String) -> M) -> M:
	handler("hello")


pure func html_map[A, B](
	f: pure (A) -> B,
	x: A,
) -> B:
	f(x)


func main(args: List[String]) -> Int:
	-- pure lambda passed where `pure (String) -> Msg` is expected
	_ = on_input(func(s: String): UpdateInput(s))
	_ = html_map(func(x: Int): x + 1, 41)
	0
