func accepts_float32(x: Float32) -> Bool:
	True


func accepts_int32(x: Int32) -> Bool:
	True


func list_len(xs: List[Int]) -> Int:
	xs.length()


func option_len(value: Option[String]) -> Int:
	match value:
		Some(s): s.length()
		None: 0


func choose(flag: Bool) -> Int32:
	match flag:
		True: 1 as Int32
		False: 2 as Int32


func main(args: List[String]) -> Int:
	f_ok: Bool = accepts_float32(123.45 as Float32)
	i_ok: Bool = accepts_int32(123 as Int32)
	empty_len: Int = list_len([] as List[Int])
	none_len: Int = option_len(None as Option[String])
	chosen: Int32 = choose(True)
	if f_ok and i_ok and empty_len == 0 and none_len == 0:
		0
	else:
		1
