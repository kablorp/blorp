import:
	pkg/net/udp as UDP


func keep_udp(sock: UDP.UdpSocket) -> UDP.UdpSocket:
	sock


func bind_udp(sock: UDP.UdpSocket) -> Result[Void, String]:
	UDP.bind(sock, "127.0.0.1", 0)


func read_udp(sock: UDP.UdpSocket) -> Result[Bytes, String]:
	UDP.recvfrom(sock, 16)


func close_udp(sock: UDP.UdpSocket) -> Void:
	UDP.close(sock)
