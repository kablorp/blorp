-- Modules should be able to use String UFCS methods without explicit import.
-- String is a prelude type — its methods are always available via UFCS.
import:
	../helpers/uses_string_prelude: find_equals, get_prefix, has_dash, strip


func main(args: List[String]) -> Int:
	match find_equals("key=value"):
		Some(pos): print(to_string(pos))
		None: print("none")
	print(get_prefix("hello"))
	print(to_string(has_dash("--flag")))
	print(strip("  hi  "))
	0
