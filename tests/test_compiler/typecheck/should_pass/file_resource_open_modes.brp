import:
	file: IOError, open_append, open_read_write, open_write


func writer(path: String) -> Result[Int, IOError]:
	with handle ?= open_write(path):
		Ok(1)


func appender(path: String) -> Result[Int, IOError]:
	with handle ?= open_append(path):
		Ok(1)


func read_writer(path: String) -> Result[Int, IOError]:
	with handle ?= open_read_write(path):
		Ok(1)
