-- Loop bodies are statement position: values produced by body expressions
-- are evaluated and discarded because while/for loops return Void.
func for_body_discards_value(nums: List[Int]) -> Int:
	for n in nums:
		n + 1
	0


func while_body_discards_value() -> Int:
	var i: Int = 0
	while i < 3:
		i += 1
		42
	0
