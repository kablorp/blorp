-- Test: Pure higher-order function with pure callback
-- Demonstrates that closures/callbacks in pure context must be pure
-- Pure: applies a pure function twice
pure func apply_twice(x: Int, f: pure (Int) -> Int) -> Int:
	f(f(x))


-- Pure: uses apply_twice with pure lambda
pure func quadruple(n: Int) -> Int:
	apply_twice(n, pure func(x): x * 2)
