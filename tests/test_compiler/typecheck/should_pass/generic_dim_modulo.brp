-- Modulo narrowing with generic #N dimensions
-- Ring buffer with length(v) as modulus
pure func ring[#N](v: Int[#N], i: Int) -> Int:
	v[i % length(v)]


-- In a loop
pure func fill_ring[#N](v: Float[#N], total: Int) -> Float:
	var sum: Float = 0.0
	for i in 0..total:
		sum += v[i % length(v)]
	sum
