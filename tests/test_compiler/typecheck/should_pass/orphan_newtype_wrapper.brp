-- TEST: Phase 3.4 — the newtype-wrapper pattern satisfies the orphan
-- rule. The user owns `MyNumbers` (declared here), so an impl of any
-- stdlib trait on the wrapped-List record is accepted.
import:
	traits: Stringable


record MyNumbers {values: List[Int]}


-- OK: MyNumbers is declared in this module. The impl can freely use
-- the underlying List[Int] — only the outermost `for Type` name
-- needs to match a local declaration.
implements Stringable for MyNumbers:
	pure func to_string(n: MyNumbers) -> String:
		"numbers"


func main(args: List[String]):
	void
