-- Iterating a 3D tensor peels to matrices, then to vectors, then to scalars
func sum_3d(t: Float[#2, #3, #4]) -> Float:
	var total: Float = 0.0
	for matrix in t:
		for row in matrix:
			for val in row:
				total += val
	total


