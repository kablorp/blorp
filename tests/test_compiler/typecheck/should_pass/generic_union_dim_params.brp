-- Dimension parameters are allowed on union data types.
union Window[#N]:
	Samples(Float[#N])
	Empty


func count_samples[#N](w: Window[#N]) -> Int:
	match w:
		Samples(samples): length(samples)
		Empty: 0


func main(args: List[String]) -> Int:
	samples: Float[#4] = {1.0, 2.0, 3.0, 4.0}
	window: Window[#4] = Samples(samples)
	count_samples(window)
