import:
	net/tls as TLS: TlsError, TlsSession


type alias SessionHandle = TlsSession


func tls_types_are_importable() -> Int:
	err: TlsError = TLS.Unsupported("native TLS not built")
	if TLS
		.message(err)
		.contains("unsupported"):
		1
	else:
		0


func main(args: List[String]) -> Int:
	tls_types_are_importable()
