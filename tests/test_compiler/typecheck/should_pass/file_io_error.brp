import:
	file: IOError(AlreadyExists, Interrupted, InvalidInput, NotFound, Other, PermissionDenied, TimedOut, Unsupported), message


pure func classify(err: IOError) -> String:
	match err:
		NotFound(path): "missing " + path
		PermissionDenied(path): "denied " + path
		AlreadyExists(path): "exists " + path
		InvalidInput(detail): "invalid " + detail
		Interrupted(detail): "interrupted " + detail
		TimedOut(detail): "timed out " + detail
		Unsupported(detail): "unsupported " + detail
		Other(detail): "other " + detail


pure func render_missing() -> String:
	message(NotFound("/tmp/nope"))


pure func render_other() -> String:
	classify(Other("io"))
