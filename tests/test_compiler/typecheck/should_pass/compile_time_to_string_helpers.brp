compile_time:
	INT_VALUE: Int = -42
	FLOAT_VALUE: Float = 2.75
	INT_TEXT: String = INT_VALUE.to_string()
	FLOAT_TEXT: String = FLOAT_VALUE.to_string()
	BOOL_TEXT: String = True.to_string()
	CHAR_TEXT: String = 'Z'.to_string()
	STRING_TEXT: String = "ready".to_string()
	STRING_LENGTH: Int = STRING_TEXT.length()


func main(args: List[String]) -> Int:
	if (
		INT_TEXT == "-42"
		and FLOAT_TEXT == "2.75"
		and BOOL_TEXT == "True"
		and CHAR_TEXT == "Z"
		and STRING_TEXT == "ready"
		and STRING_LENGTH == 5
	):
		0
	else:
		1
