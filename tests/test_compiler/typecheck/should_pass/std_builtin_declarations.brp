-- Std declaration coverage for migrated builtins/types.
-- These symbols used to exist only in env_builtins and now also have
-- source declarations in std modules.
import:
	debug: debug_string
	fixed: Fixed, fixed
	float: to_float16, to_float32
	hash: hash_combine
	int:
		Int64,
		to_int128,
		to_int16,
		to_int32,
		to_int8,
		to_uint128,
		to_uint16,
		to_uint32,
		to_uint64,
		to_uint8,
	tensor: tensor_peel, vector


func main(args: List[String]) -> Int:
	x64: Int64 = 42
	_ = to_int8(x64)
	_ = to_int16(x64)
	_ = to_int32(x64)
	_ = to_int128(x64)
	_ = to_uint8(x64)
	_ = to_uint16(x64)
	_ = to_uint32(x64)
	_ = to_uint64(x64)
	_ = to_uint128(x64)
	_ = to_float32(3.14)
	_ = to_float16(2.5)
	_ = hash_combine(1, 2)
	debug:
		debug_string(x64)
	v: Int[#3] = vector(0, 3)
	_ = tensor_peel(v, 0)
	price: Fixed = fixed(19.99, 2)
	_ = price.to_string()
	0
