-- Locks down the current source-level call shapes before call-resolution
-- metadata is made explicit.
import:
	../helpers/call_resolution_impl as CR: Tagged
	dict as D
	heap as H: Heap
	list: reverse


record Runner {
	run: (Int) -> Int
}


func run(box: Runner, x: Int) -> Int:
	0


func field_call_wins(box: Runner) -> Int:
	box.run(5)


pure func add_to(self: Int, amount: Int) -> Int:
	self + amount


pure func local_method_call(x: Int) -> Int:
	x.add_to(2)


func apply(
	f: (Int) -> Int,
	x: Int,
) -> Int:
	f(x)
pure func apply(
	f: pure (Int) -> Int,
	x: Int,
) -> Int:
	f(x)


pure func bare_overload_pure(f: pure (Int) -> Int) -> Int:
	apply(f, 1)


pure func selective_import_bare_call(items: List[Int]) -> Int:
	reverse(items).length()


pure func qualified_module_call() -> Int:
	d: Dict[String, Int] = D.from_list([("a", 1), ("b", 2)])
	D.length(d)


pure func prelude_method_only_call(items: List[Int]) -> Int:
	items
		.map(pure func(x: Int): x + 1)
		.length()


pure func imported_type_method_only_call() -> Int:
	var h: Heap[Int] = H.heap()
	h = h.push(2)
	h.size()


pure func qualified_impl_method_call(t: Tagged) -> Int:
	CR.tag_value(t)


func first_class_call(f: (Int) -> Int) -> Int:
	f(3)


pure func constructor_call(x: Int) -> Option[Int]:
	Some(x)


trait Weighted:
	pure func weight(self: Self) -> Int


implements Weighted for Int:
	pure func weight(self: Int) -> Int:
		self


pure func generic_trait_method_call[T:Weighted](x: T) -> Int:
	weight(x)
