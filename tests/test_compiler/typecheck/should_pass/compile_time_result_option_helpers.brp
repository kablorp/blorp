import:
	result as R


compile_time:
	FROM_SOME: Result[Int, String] = R.from_option(Some(42), "missing")
	FROM_NONE: Result[Int, String] = R.from_option(None, "missing")
	SOME_VALUE: Option[Int] = FROM_SOME.to_option()
	NONE_VALUE: Option[Int] = FROM_NONE.to_option()
	FROM_SOME_SCORE: Int = match FROM_SOME:
		Ok(value): value
		Err(_): 0
	FROM_NONE_TEXT: String = match FROM_NONE:
		Ok(_): "bad"
		Err(value): value
	SOME_SCORE: Int = match SOME_VALUE:
		Some(value): value
		None: 0
	NONE_SCORE: Int = match NONE_VALUE:
		Some(value): value
		None: 42


func main(args: List[String]) -> Int:
	if (
		FROM_SOME_SCORE == 42
		and FROM_NONE_TEXT == "missing"
		and SOME_SCORE == 42
		and NONE_SCORE == 42
	):
		0
	else:
		1
