record Cache[K, V] {
	capacity: Int,
	data: Dict[K, (V, Int)],
	counter: Int
}


pure func new[K, V](capacity: Int) -> Cache[K, V]:
	{
		capacity = capacity,
		data = {},
		counter = 0
	}


pure func wrap[K, V](capacity: Int) -> Cache[K, V]:
	new(capacity)


func main(args: List[String]) -> Int:
	c: Cache[String, Int] = new(8)
	c.capacity
