private pure func apply_compile_time(
	value: Int,
	f: pure (Int) -> Int,
) -> Int:
	f(value)


private pure func captured_callback(offset: Int) -> Int:
	apply_compile_time(20, func(value: Int): value + offset)


compile_time:
	INLINE_CALLBACK: Int = apply_compile_time(20, func(value: Int): value + 22)
	CAPTURED_CALLBACK: Int = captured_callback(22)


func main(args: List[String]) -> Int:
	if INLINE_CALLBACK == 42 and CAPTURED_CALLBACK == 42:
		0
	else:
		1
