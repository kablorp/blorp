import:
	bytes as B: Bytes
	cache as C: Cache
	deque as Deque
	dict as D
	graph as G: Graph
	heap as H: Heap
	log as L: Logger
	set as S
	sorted_map as SM: SortedMap


func main(args: List[String]) -> Int:
	var d: Dict[String, Int] = D.dict()
	var s: Set[Int] = S.set()
	var h: Heap[Int] = H.heap()
	b: Bytes = B.bytes(4)
	var c: Cache[String, Int] = C.cache(2)
	var dq: (List[Int], List[Int]) = Deque.deque()
	var sm: SortedMap[Int, String] = SM.sorted_map()
	var g: Graph = G.graph()
	logger: Logger = L.logger()
	d = d.set("answer", 42)
	s = s.add(42)
	h = h.push(42)
	c = C.put(c, "answer", 42)
	dq = Deque.push_back(dq, 42)
	sm = SM.set(sm, 1, "one")
	g = G.add_node(g, 1)
	ok_collections: Bool = d
		.get("answer")
		.get_or(0) == 42 and s.contains(42)
	ok_structs: Bool = C.contains(c, "answer") and Deque.length(dq) == 1
	ok_ordered: Bool = SM
		.get(sm, 1)
		.get_or("") == "one" and G.node_count(g) == 1
	if (
		ok_collections
		and ok_structs
		and ok_ordered
		and logger.level == 1
	):
		b.length() + h.size()
	else:
		0
