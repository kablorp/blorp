-- Record literal in generic function should infer type args from expected return type
record Pair[#M, #N] {first: Float[#M], second: Float[#N]}


func make_pair[#M, #N](a: Float[#M], b: Float[#N]) -> Pair[#M, #N]:
	{first = a, second = b}


func main(args: List[String]) -> Int:
	a: Float[#3] = {1.0, 2.0, 3.0}
	b: Float[#2] = {4.0, 5.0}
	p: Pair[#3, #2] = make_pair(a, b)
	0
