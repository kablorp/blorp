import:
	matrix: all, any, argmax, argmin, fold, map, map_indexed, max, mean, min, product, sum, zip_map


pure func transform(left: Int[#2, #3], right: Int[#2, #3]) -> Int[#2, #3]:
	left
		.map(pure func(value: Int): value * 2)
		.map_indexed(pure func(row: ..#2, col: ..#3, value: Int): value + row + col)
		.zip_map(right, pure func(a: Int, b: Int): a + b)


pure func summarize(values: Int[#2, #3]) -> Bool:
	total: Int = values.fold(0, pure func(acc: Int, value: Int): acc + value)
	fold_matches_sum: Bool = values.sum() == total
	product_positive: Bool = values.product() > 0
	low: Int = values.min()
	high: Int = values.max()
	range_matches: Bool = low >= 0 and high > 3
	average_positive: Bool = values.mean() > 0.0
	max_pos: (..#2, ..#3) = values.argmax()
	min_pos: (..#2, ..#3) = values.argmin()
	indices_match: Bool = max_pos.0 == 1 and max_pos.1 == 2 and min_pos.0 == 0 and min_pos.1 == 0
	predicates_match: Bool = values.all(
		pure func(value: Int): value >= 0,
	) and values.any(pure func(value: Int): value > 3)
	total > 0 and fold_matches_sum and product_positive and range_matches and average_positive and indices_match and predicates_match


func main(args: List[String]) -> Int:
	0
