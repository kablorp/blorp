-- A generic impl for a trait with a supertrait should satisfy that
-- supertrait through a compatible generic impl with a weaker element bound.
-- Hashable: Equatable, so Box[Element: Hashable] must match the existing
-- Equatable impl for Box[Element: Equatable].
record Box[Element] {value: Element}


implements Equatable for Box[Element:Equatable]:
	pure func equals[Element:Equatable](a: Box[Element], b: Box[Element]) -> Bool:
		a.value == b.value


implements Hashable for Box[Element:Hashable]:
	pure func hash[Element:Hashable](self: Box[Element]) -> Int:
		hash(self.value)


func main(args: List[String]) -> Int:
	0
