VECTOR_VALUES: Int[#3] = vector(7, 3)

VECTOR_LENGTH: Int = VECTOR_VALUES.length()

MATRIX_VALUES: Int[#2, #3] = matrix(9, 2, 3)

MATRIX_LENGTH: Int = MATRIX_VALUES.length()

TENSOR_VALUES: Int[#2, #2, #2] = tensor3(4, 2, 2, 2)

TENSOR_LENGTH: Int = TENSOR_VALUES.length()


func main(args: List[String]) -> Int:
	VECTOR_LENGTH + MATRIX_LENGTH + TENSOR_LENGTH
