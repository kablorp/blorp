-- RUN-BLORP-CHECK
union Color:
	Red
	Blue


func classify(Red: Int, value: Color) -> Color:
	match value:
		Red:
			Red


func classify_or(Red: Int, value: Color) -> Color:
	match value:
		Red | Red:
			Red


func build_classifier() -> (Color) -> Color:
	var Red: Int = 1
	func(value: Color):
		match value:
			Red:
				Red


func main(args: List[String]) -> Int:
	if (
		classify(1, Blue) == Blue
		and classify_or(1, Red) == Red
		and build_classifier()(Blue) == Blue
	):
		0
	else:
		1
