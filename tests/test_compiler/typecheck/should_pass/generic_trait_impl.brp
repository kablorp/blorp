-- Test that generic trait implementations work for operators.
-- [implements Addable for Bag[T]] allows [Bag[Int] + Bag[Int]] to dispatch
-- through the user-written add method.
--
-- Note: this used to [implements Addable for List[T]], but stdlib
-- already provides that impl — the coherence check now correctly rejects
-- the redundant redeclaration, so the test uses a user-defined wrapper
-- record instead.
import:
	list: concat, length


record Bag[T] {items: List[T]}


implements Addable for Bag[T]:
	pure func add[T](a: Bag[T], b: Bag[T]) -> Bag[T]:
		result: Bag[T] = {items = concat(a.items, b.items)}
		result


func main(args: List[String]) -> Int:
	a: Bag[Int] = {items = [1, 2]}
	b: Bag[Int] = {items = [3, 4]}
	c: Bag[Int] = a + b
	if length(c.items) == 4:
		0
	else:
		1
