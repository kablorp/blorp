import:
	vector: ParallelVector, parallel


pure func add_index(values: Int[#5]) -> Int[#5]:
	values.parallel(pure func(chunk: ParallelVector[Int, #5]):
		chunk.map_indexed(pure func(i: ..#5, x: Int) -> Int: x + i)
	)


func main(args: List[String]) -> Int:
	values: Int[#5] = {10, 10, 10, 10, 10}
	result: Int[#5] = add_index(values)
	result[4]
