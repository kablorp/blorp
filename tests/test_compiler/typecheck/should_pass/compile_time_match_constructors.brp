import:
	option: Option(Some, None)


union BuildChoice:
	BuildValue(Int)
	BuildEmpty


private pure func score(choice: BuildChoice) -> Int:
	match choice:
		BuildValue(value): value + 1
		BuildEmpty: 0


compile_time:
	CHOICE: BuildChoice = BuildValue(41)
	CHOICE_SCORE: Int = score(CHOICE)
	MAYBE: Option[Int] = Some(41)
	OPTION_SCORE: Int = match MAYBE:
		Some(value): value + 1
		None: 0
	NONE_VALUE: Option[Int] = None
	NONE_SCORE: Int = match NONE_VALUE:
		Some(value): value
		None: 0


func main(args: List[String]) -> Int:
	if (
		CHOICE_SCORE == 42
		and OPTION_SCORE == 42
		and NONE_SCORE == 0
	):
		0
	else:
		1
