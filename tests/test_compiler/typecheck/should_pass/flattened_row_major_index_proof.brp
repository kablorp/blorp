import:
	tensor: length, matrix, vector


pure func flatten_direct[T, #M, #N](m: T[#M, #N]) -> T[#M * #N]:
	first_row: T[#N] = m[0]
	var out: T[#M * #N] = vector(first_row[0], length(m) * length(first_row))
	for row in 0..length(m):
		values: T[#N] = m[row]
		for col in 0..length(values):
			out[row * length(values) + col] = values[col]
	out


pure func read_flat[T, #M, #N](values: T[#M * #N], rows: #M, columns: #N) -> T:
	first: T = values[0]
	result: T[#M, #N] = matrix(first, rows, columns)
	var sample: T = first
	for row in 0..length(result):
		for col in 0..columns:
			sample = values[row * columns + col]
	sample
