-- Step 5 / Option D: a default body may reference supertrait
-- methods (not just sibling ones). The synthesized default
-- for `derived` calls `base_op` which is declared on the
-- supertrait; the rewriter must see it via the transitive
-- supertrait-methods walk.
trait MyBase:
	pure func base_op(self: Self) -> Int


trait MyDerived: MyBase:
	pure func custom(self: Self) -> Int
	pure func derived(self: Self) -> Int:
		base_op(self)


record Widget {tag: Int}


implements MyBase for Widget:
	pure func base_op(self: Widget) -> Int:
		self.tag


implements MyDerived for Widget:
	pure func custom(self: Widget) -> Int:
		self.tag + 1


func main(args: List[String]) -> Int:
	0
