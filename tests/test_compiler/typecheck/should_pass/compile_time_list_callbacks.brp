compile_time:
	VALUES: List[Int] = [1, 2, 3, 4]
	WORDS: List[String] = ["1", "2", "3", "4"]
	MAPPED: List[Int] = VALUES.map(func(value: Int) -> Int: value * 10)
	FILTERED: List[Int] = VALUES.filter(func(value: Int) -> Bool: value % 2 == 0)
	FILTER_MAPPED: List[String] = VALUES.filter_map(func(value: Int) -> Option[String]:
		if value % 2 == 0:
			Some("even")
		else:
			None
	)
	FLAT_MAPPED: List[Int] = VALUES.flat_map(func(value: Int) -> List[Int]: [value, value + 10])
	INDEXED: List[Int] = VALUES.map_indexed(func(index: Int, value: Int) -> Int: index + value)
	FOLD_LEFT_SUM: Int = VALUES.fold_left(0, func(total: Int, value: Int) -> Int: total + value)
	FOLD_RIGHT_TEXT: String = WORDS.fold_right("", func(value: String, text: String) -> String:
		text + value
	)
	ALL_POSITIVE: Bool = VALUES.all(func(value: Int) -> Bool: value > 0)
	ANY_OVER_THREE: Bool = VALUES.any(func(value: Int) -> Bool: value > 3)


func main(args: List[String]) -> Int:
	if (
		MAPPED.get_or(3, 0) == 40
		and FILTERED.length() == 2
		and FILTERED.get_or(0, 0) == 2
		and FILTER_MAPPED.length() == 2
		and FILTER_MAPPED.get_or(1, "") == "even"
		and FLAT_MAPPED.length() == 8
		and FLAT_MAPPED.get_or(1, 0) == 11
		and INDEXED.get_or(2, 0) == 5
		and FOLD_LEFT_SUM == 10
		and FOLD_RIGHT_TEXT == "4321"
		and ALL_POSITIVE
		and ANY_OVER_THREE
	):
		0
	else:
		1
