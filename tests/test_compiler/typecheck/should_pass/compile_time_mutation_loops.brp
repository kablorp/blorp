private pure func sum_list(values: List[Int]) -> Int:
	var total: Int = 0
	for value in values:
		total += value
	total


private pure func sum_range(limit: Int) -> Int:
	var total: Int = 0
	for value in 0..limit:
		total += value
	total


private pure func sum_while(limit: Int) -> Int:
	var index: Int = 0
	var total: Int = 0
	while index < limit:
		total += index
		index += 1
	total


record Point {
	x: Int,
	y: Int
}


private pure func shift_y(point: Point) -> Point:
	{ point |
		y = point.y + 1
	}


private pure func tuple_sum(pair: (Int, Int)) -> Int:
	(left, right) = pair
	left + right


private pure func interpolate_pair(left: String, right: String) -> String:
	"${left}_${right}"


compile_time:
	LIST_SUM: Int = sum_list([10, 20, 12])
	RANGE_SUM: Int = sum_range(5)
	WHILE_SUM: Int = sum_while(5)
	INTERP_LABEL: String = interpolate_pair("compile", "time")
	INTERP_PRIMITIVES: String = "n=${LIST_SUM}, ok=${True}, char=${'Z'}"
	POINT: Point = {
		x = 10,
		y = 31
	}
	SHIFTED_POINT: Point = shift_y({ POINT |
			x = 11
		})
	TUPLE_SUM: Int = tuple_sum((20, 22))


func main(args: List[String]) -> Int:
	if (
		LIST_SUM == 42
		and RANGE_SUM == 10
		and WHILE_SUM == 10
		and INTERP_LABEL == "compile_time"
		and INTERP_PRIMITIVES == "n=42, ok=True, char=Z"
		and SHIFTED_POINT.x == 11
		and SHIFTED_POINT.y == 32
		and TUPLE_SUM == 42
	):
		0
	else:
		1
