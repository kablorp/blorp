import:
	option: Option(Some, None)


struct Point {
	x: Float,
	y: Float
}


func test_option_struct() -> Bool:
	p: Point = {
		x = 1.0,
		y = 2.0
	}
	opt: Option[Point] = Some(p)
	match opt:
		Some(v): v.x == 1.0 and v.y == 2.0
		None: False


func main(args: List[String]) -> Int:
	if test_option_struct():
		0
	else:
		1
