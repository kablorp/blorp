record Cache[K, V] {capacity: Int, data: Dict[K, (V, Int)], counter: Int}


func make_try[K, V](key: Result[K, String]) -> Result[Cache[K, V], String]:
	try:
		k ?= key
		{capacity = 1, data = {}, counter = 0}


func main(args: List[String]) -> Int:
	c: Result[Cache[String, Int], String] = make_try(Ok("x"))
	0
