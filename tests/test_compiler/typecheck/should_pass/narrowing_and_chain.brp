-- Progressive narrowing in and-chains: bounds check on left narrows for right
-- Basic: v[di] in condition after bounds check
pure func check_threshold(v: Float[#10], di: Int) -> Bool:
	if di >= 0 and di < length(v) and v[di] > 0.5:
		True
	else:
		False


-- Multiple subscripts in condition after bounds check
pure func check_pair(v: Int[#10], i: Int) -> Bool:
	if i >= 0 and i < 9 and v[i] < v[i + 1]:
		True
	else:
		False


-- Narrowing propagates through chained and
pure func check_two_vars(a: Int[#5], b: Int[#8], i: Int, j: Int) -> Bool:
	if i >= 0 and i < length(a) and j >= 0 and j < length(b) and a[i] + b[j] > 10:
		True
	else:
		False
