-- Test: correct multi-method trait impl passes type checking
trait Describable:
	pure func name(value: Self) -> String
	pure func size(value: Self) -> Int


implements Describable for String:
	pure func name(value: String) -> String:
		"String"

	pure func size(value: String) -> Int:
		0


func main(args: List[String]) -> Int:
	0
