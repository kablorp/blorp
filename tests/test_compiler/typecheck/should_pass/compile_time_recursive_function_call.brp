private pure func count_down(value: Int) -> Int:
	if value == 0:
		0
	else:
		count_down(value - 1)


private pure func factorial(value: Int) -> Int:
	if value <= 1:
		1
	else:
		value * factorial(value - 1)


COUNTED_DOWN: Int = count_down(4)

FACTORIAL_FIVE: Int = factorial(5)


func main(args: List[String]) -> Int:
	if COUNTED_DOWN == 0 and FACTORIAL_FIVE == 120:
		0
	else:
		1
