-- Regression: a pure lambda parameter named `input` shadows the prelude
-- console input function during purity validation.
import:
	codec: Value(VString)

type alias ValueParser[T] = pure (Value) -> T

private pure func describe_value(value: Value) -> String:
	match value:
		VString(s): s
		_: "other"

pure func make_parser() -> ValueParser[String]:
	pure func(input: Value) -> String:
		describe_value(input)
