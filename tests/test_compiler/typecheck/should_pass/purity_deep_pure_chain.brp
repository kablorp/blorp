-- Test: Deep chain of pure functions should compile successfully.
pure func add(a: Int, b: Int) -> Int:
	a + b


pure func double_add(x: Int) -> Int:
	add(x, x)


pure func quad(x: Int) -> Int:
	double_add(double_add(x))


pure func apply(x: Int, f: pure (Int) -> Int) -> Int:
	f(x)


pure func apply_twice(x: Int, f: pure (Int) -> Int) -> Int:
	apply(apply(x, f), f)


pure func deep_chain() -> Int:
	quad(apply_twice(3, pure func(n: Int): n * 2))


func main(args: List[String]) -> Int:
	deep_chain()
