import:
	net/tcp as Tcp: IpFamily(IPv4), TcpError


func qualified_listener_port() -> Result[Int, TcpError]:
	with listener ?= Tcp.listen_loopback_any_port(IPv4, 1):
		Tcp.local_port(listener)


func qualified_stream_port(port_num: Int) -> Result[Int, TcpError]:
	remote ?= Tcp.port(port_num)
	with stream ?= Tcp.connect_loopback(IPv4, remote):
		Tcp.stream_local_port(stream)


func qualified_round_trip_shape() -> Result[Int, TcpError]:
	with listener ?= Tcp.listen_loopback_any_port(IPv4, 1):
		port_num ?= Tcp.local_port(listener)
		remote ?= Tcp.port(port_num)
		with client ?= Tcp.connect_loopback(IPv4, remote):
			with peer ?= Tcp.accept(listener):
				listener_port ?= Tcp.local_port(listener)
				ignored ?= Tcp.write_all(client, "tcp".to_bytes())
				data ?= Tcp.read_chunk(peer, 16)
				Ok(data.length() + listener_port - listener_port)
