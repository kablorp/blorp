import:
	net/tcp as Tcp


func keep_stream(stream: Tcp.TcpStream) -> Tcp.TcpStream:
	stream


func keep_listener(listener: Tcp.TcpListener) -> Tcp.TcpListener:
	listener


func read_stream(stream: Tcp.TcpStream) -> Result[Bytes, String]:
	Tcp.read(stream, 16)


func read_stream_checked(stream: Tcp.TcpStream) -> Result[Bytes, Tcp.TcpError]:
	Tcp.read_chunk(stream, 16)


func write_stream_checked(stream: Tcp.TcpStream, data: Bytes) -> Result[Void, Tcp.TcpError]:
	Tcp.write_all(stream, data)


func accept_listener(listener: Tcp.TcpListener) -> Result[Tcp.TcpStream, String]:
	Tcp.accept(listener)


func accept_listener_checked(listener: Tcp.TcpListener) -> Result[Tcp.TcpStream, Tcp.TcpError]:
	Tcp.accept_checked(listener)


func listener_port(listener: Tcp.TcpListener) -> Result[Int, String]:
	Tcp.local_port(listener)


func listener_port_checked(listener: Tcp.TcpListener) -> Result[Int, Tcp.TcpError]:
	Tcp.local_port_checked(listener)


func stream_port_checked(stream: Tcp.TcpStream) -> Result[Int, Tcp.TcpError]:
	Tcp.local_port_checked(stream)


func listener_timeout_checked(listener: Tcp.TcpListener) -> Result[Void, Tcp.TcpError]:
	Tcp.set_timeout_checked(listener, 1000)


func listener_reuse_addr_checked(listener: Tcp.TcpListener) -> Result[Void, Tcp.TcpError]:
	Tcp.set_reuse_addr_checked(listener)


func stream_timeout_checked(stream: Tcp.TcpStream) -> Result[Void, Tcp.TcpError]:
	Tcp.set_timeout_checked(stream, 1000)


func listen_checked() -> Result[Tcp.TcpListener, Tcp.TcpError]:
	Tcp.listen_checked("127.0.0.1", 0, 1)


func connect_checked() -> Result[Tcp.TcpStream, Tcp.TcpError]:
	Tcp.connect_checked("127.0.0.1", 1)


pure func tcp_error_message(err: Tcp.TcpError) -> String:
	Tcp.message(err)


func close_stream(stream: Tcp.TcpStream) -> Void:
	Tcp.close(stream)
