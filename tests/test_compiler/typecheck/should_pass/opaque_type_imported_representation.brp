import:
	../helpers/opaque_imported_rep: ImportedPayload


opaque type WrappedPayload = ImportedPayload


pure func wrap_payload(payload: ImportedPayload) -> WrappedPayload:
	into WrappedPayload(payload)


pure func unwrap_payload(payload: WrappedPayload) -> ImportedPayload:
	from WrappedPayload(payload)


func main(args: List[String]) -> Int:
	payload: ImportedPayload = {value = 42}

	if unwrap_payload(wrap_payload(payload)).value == 42:
		0
	else:
		1
