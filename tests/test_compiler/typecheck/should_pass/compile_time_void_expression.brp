union CompileTimeItem:
	ItemValue(Int)
	ItemSkip


private pure func sum_items(items: List[CompileTimeItem]) -> Int:
	var total: Int = 0

	for item in items:
		match item:
			ItemValue(value):
				total += value
			ItemSkip:
				void

	total


compile_time:
	TOTAL: Int = sum_items([ItemValue(20), ItemSkip, ItemValue(22)])


func main(args: List[String]) -> Int:
	if TOTAL == 42:
		0
	else:
		1
