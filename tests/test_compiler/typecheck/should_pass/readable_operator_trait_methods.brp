record Num {value: Int}


implements Addable for Num:
	pure func add(a: Num, b: Num) -> Num:
		{value = a.value + b.value}


implements Subtractable for Num:
	pure func subtract(a: Num, b: Num) -> Num:
		{value = a.value - b.value}


implements Multipliable for Num:
	pure func multiply(a: Num, b: Num) -> Num:
		{value = a.value * b.value}


implements Divisible for Num:
	pure func divide(a: Num, b: Num) -> Num:
		{value = a.value / b.value}


implements Modulable for Num:
	pure func remainder(a: Num, b: Num) -> Num:
		{value = a.value % b.value}


implements Negatable for Num:
	pure func negate(a: Num) -> Num:
		{value = -a.value}


implements Equatable for Num:
	pure func equals(a: Num, b: Num) -> Bool:
		a.value == b.value


implements Orderable for Num:
	pure func less_than(a: Num, b: Num) -> Bool:
		a.value < b.value


func main(args: List[String]) -> Int:
	a: Num = {value = 10}
	b: Num = {value = 3}
	sum: Num = a + b
	diff: Num = a - b
	product: Num = a * b
	quotient: Num = a / b
	rem: Num = a % b
	negated: Num = -b
	if sum.value == 13 and diff.value == 7 and product.value == 30 and quotient.value == 3 and rem.value == 1 and negated.value == -3 and a != b and b < a and b <= a and a > b and a >= b:
		0
	else:
		1
