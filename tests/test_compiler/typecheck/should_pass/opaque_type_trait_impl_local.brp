opaque type Distance = Int


pure func distance(value: Int) -> Distance:
	into Distance(value)


pure func distance_value(value: Distance) -> Int:
	from Distance(value)


implements Addable for Distance:
	pure func add(a: Distance, b: Distance) -> Distance:
		distance(distance_value(a) + distance_value(b))


func main(args: List[String]) -> Int:
	total: Distance = distance(2) + distance(3)
	if distance_value(total) == 5:
		0
	else:
		1
