import:
	list as L


-- Codegen audit: list_append_owned should be used for fresh tuple elements
-- even inside expression-level while loops (where RC temps are pre-allocated).
-- Bug: the _owned guard checked ctx.call_arg_extract_temps = [] which failed
-- in while bodies, causing retain+release imbalance (leaked tuples).
--
-- AUDIT: compile this file and verify the generated C contains:
-- blorp_list_append_owned(draw_list, blorp_tuple_new(
-- NOT:
-- blorp_list_append(draw_list, blorp_tuple_new(
func f() -> Int:
	var frame: Int = 0
	while frame < 10:
		var draw_list: List[(Int, Float)] = []
		for i in 0..20:
			draw_list = L.append(draw_list, (i, to_float(i) * 1.5))
		_ = L.length(draw_list)
		frame += 1
	0
