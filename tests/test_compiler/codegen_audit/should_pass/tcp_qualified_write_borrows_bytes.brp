-- Qualified resource operations must preserve compiler-owned resource
-- operation metadata through call resolution. The owned Bytes payload is
-- protected by task cleanup because the write call can park and be cancelled.
-- EXPECT-C: blorp_CancelCleanupFrame __blorp_cleanup_payload;
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_payload, &payload, (void*)payload, blorp_cleanup_release_arc_only_value);
-- EXPECT-C: blorp_tcp_write_raw(stream, data)
-- EXPECT-C: blorp_task_cleanup_pop_slot(&payload);
-- EXPECT-C: blorp_release_arc_only(payload);
import:
	bytes as B
	net/tcp as Tcp: TcpError


func write_payload() -> Result[Int, TcpError]:
	with stream ?= Tcp.connect("127.0.0.1", 1):
		payload: Bytes = B.bytes(0)
		match Tcp.write(stream, payload):
			Ok(_): Ok(0)
			Err(_): Ok(1)


func main(args: List[String]) -> Int:
	match write_payload():
		Ok(value): value
		Err(_): 0
