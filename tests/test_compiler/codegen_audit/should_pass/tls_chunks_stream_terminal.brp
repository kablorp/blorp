-- TLS chunk streams should use the shared fallible-stream terminal ABI with a
-- TLS error domain instead of protocol-specific terminal builtins.
-- EXPECT-C: blorp_tls_chunks_raw(session, max_bytes)
-- EXPECT-C: blorp_fallible_stream_collect_raw(
-- EXPECT-C: BLORP_FALLIBLE_STREAM_ERROR_DOMAIN_TLS
-- EXPECT-C: std_net_tls__TlsError*
import:
	net/tcp as TCP: IpFamily(IPv4)
	net/tls as TLS: TlsError
	stream: collect_result


func collect_tls_chunks() -> Result[Int, TlsError]:
	match TCP.port(1):
		Err(err): Err(TLS.Transport(TCP.message(err)))
		Ok(remote):
			with stream ?= TCP.connect_loopback(
				IPv4,
				remote,
			) on err => TLS.Transport(TCP.message(err)):
				with session ?= TLS.connect(stream, "localhost"):
					chunks ?= TLS
						.chunks(session, 64)
						.collect_result()
					Ok(chunks.length())


func main(args: List[String]) -> Int:
	match collect_tls_chunks():
		Ok(n): n
		Err(_): 0
