-- Generated-C shape audit for ParallelList.filter runtime lowering.
-- EXPECT-C: return ((blorp_List*)blorp_filter_parallel(
pure func is_even(x: Int) -> Bool:
	x % 2 == 0


func main(args: List[String]) -> Int:
	nums: List[Int] = [1, 2, 3, 4]
	evens: List[Int] = nums.parallel(pure func(chunk: ParallelList[Int]):
		chunk.filter(is_even)
	)

	evens.length()
