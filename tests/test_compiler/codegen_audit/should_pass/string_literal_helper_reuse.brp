-- Reusing one cached string literal several times in a single C expression must
-- not emit repeated inline assignments to the same __sl_N static. Clang reports
-- that shape as an unsequenced modification/access warning.
-- EXPECT-C: static blorp_String* __blorp_get_sl_0(void)
-- EXPECT-NOT-C: (__sl_0 ? __sl_0 : (__sl_0 = blorp_string_literal
func same(a: String, b: String, c: String) -> Bool:
	a == b and b == c


func main(args: List[String]) -> Int:
	if same("\n", "\n", "\n"):
		0
	else:
		1
