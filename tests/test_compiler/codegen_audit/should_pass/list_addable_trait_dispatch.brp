-- List + is typechecked via Addable for List[T]; Core must dispatch to that
-- trait impl instead of emitting raw C pointer arithmetic.
-- Semantic callable expectation: Addable_add_List_Int(
-- EXPECT-CALLABLE: Addable_add_List_Int
-- EXPECT-C-REGEX: brp_[0-9A-Za-z]+\(
-- EXPECT-NOT-C: blorp_List* xs = (({ blorp_List*
func main(args: List[String]) -> Int:
	xs: List[Int] = [1, 2] + [3, 4]
	xs.length()
