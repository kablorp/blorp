-- Immediate tuple matches that inspect direct fields should scalar-replace
-- the tuple allocation before ownership insertion.
-- EXPECT-C: __tuple_sroa_
-- EXPECT-NOT-C: blorp_tuple_new(2, (void*)(long)(0L), (void*)(long)(5L))
func main(args: List[String]) -> Int:
	result: Int = match (0, 5):
		(0, y): y
		(_, _): 99
	if result == 5:
		0
	else:
		1
