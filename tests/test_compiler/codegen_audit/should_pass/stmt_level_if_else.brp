-- Test that if-expressions used as function return values emit as
-- C if/else statements rather than nested ternary/statement expressions.
--
-- Pattern: func f(x: Int) -> Int:
-- if cond:
-- short_value
-- else:
-- long_block_with_loops
-- value
--
-- The else branch should NOT be a single ({ ... }) mega-expression.
-- Instead it should emit as: if (...) { __retval = ...; } else { ... __retval = ...; }
--
-- EXPECT: no line > 2000 chars
import:
	dict as D
	list as L


record GameState {entities: List[Int], scores: Dict[Int, Int], frame: Int}


func game_loop(flag: Int) -> Int:
	var state: GameState = {entities = [], scores = D.dict(), frame = 0}
	if flag == 0:
		-1
	else:
		var running: Bool = True
		while running:
			-- Per-frame: build entity list
			var new_entities: List[Int] = []
			for i in 0..30:
				new_entities = L.append(new_entities, state.frame * 30 + i)
			-- Per-frame: update scores
			var new_scores: Dict[Int, Int] = D.dict()
			for entity in new_entities:
				old_score: Int = D.get_or(state.scores, entity % 10, 0)
				new_scores = D.set(new_scores, entity % 10, old_score + 1)
			-- Per-frame: check conditions
			if state.frame > 20:
				var active: List[(Int, Int)] = []
				for k in 0..10:
					score: Int = new_scores.get_or(k, 0)
					if score > 0:
						active = L.append(active, (k, score))
				active = L.sort_by(active, func(x: (Int, Int)): 0 - x.1)
				var top_count: Int = 0
				for pair in active:
					if top_count < 3:
						_ = pair.0
						top_count += 1
			state = { state | entities = new_entities,
			scores = new_scores,
			frame = state.frame + 1, }
			if state.frame >= 50:
				running = False
		state.frame


func main(args: List[String]) -> Int:
	result: Int = game_loop(1)
	if result == 50:
		0
	else:
		1
