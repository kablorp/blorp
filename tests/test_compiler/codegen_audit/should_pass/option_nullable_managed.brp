-- Generated-C shape audit for nullable managed Option payloads.
-- EXPECT-C: blorp_String* opt =
-- EXPECT-C: blorp_List* items =
-- EXPECT-C: = NULL
-- EXPECT-C: != NULL
-- EXPECT-C: blorp_String* s = (blorp_String*)__scrut
-- EXPECT-C: blorp_List* xs = (blorp_List*)__scrut
-- EXPECT-NOT-C: Option* opt = __def_
-- EXPECT-NOT-C: Option* items = __def_
-- EXPECT-NOT-C: Some(({ blorp_String*
import:
	option: Option(Some, None)


func choose(flag: Bool) -> Option[String]:
	if flag:
		Some("hello")
	else:
		None


func choose_items(flag: Bool) -> Option[List[Int]]:
	if flag:
		Some([1, 2, 3])
	else:
		None


func main(args: List[String]) -> Int:
	opt: Option[String] = choose(True)
	items: Option[List[Int]] = choose_items(True)
	text_ok: Bool = match opt:
		Some(s):
			s == "hello"
		None: False
	items_ok: Bool = match items:
		Some(xs): xs.length() == 3
		None: False
	if text_ok and items_ok:
		0
	else:
		1
