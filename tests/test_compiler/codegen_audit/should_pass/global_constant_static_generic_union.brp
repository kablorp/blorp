-- EXPECT-C: .tag = TAG_Choice__mono_String_Picked
-- EXPECT-C: .data.Picked = { (blorp_String*)&__blorp_static_string_CHOSEN_Picked_0 }
-- EXPECT-C: static Choice__mono_String* CHOSEN = (Choice__mono_String*)&__blorp_static_union_CHOSEN;
-- EXPECT-C: static Box__mono_String __blorp_static_record_WRAPPED_WrappedValue_0 = {
-- EXPECT-C: static Wrapper__mono_String __blorp_static_union_WRAPPED = {
-- EXPECT-C: .data.WrappedValue = { (Box__mono_String*)&__blorp_static_record_WRAPPED_WrappedValue_0 }
