-- EXPECT-NOT-C: blorp_make_immortal_constant(CHOSEN);
-- EXPECT-NOT-C: blorp_make_immortal_constant(WRAPPED);
union Choice[T]:
	Picked(T)
	Missing


record Box[T] {
	value: T
}


union Wrapper[T]:
	WrappedValue(Box[T])
	WrappedMissing


CHOSEN: Choice[String] = Picked("static")

WRAPPED: Wrapper[String] = WrappedValue({value = "nested"})


func main(args: List[String]) -> Int:
	match CHOSEN:
		Picked(value):
			print(value)
		Missing:
			print("missing")

	match WRAPPED:
		WrappedValue(box):
			print(box.value)
		WrappedMissing:
			print("missing")

	0
