-- End-to-end audit that the default compiler path uses the Blorp-owned
-- final-Core-to-C emitter for its supported subset.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C: static long ANSWER = 42L;
-- EXPECT-C: while (1) {
-- EXPECT-C: __tailrec_arg_0_
-- EXPECT-C: for (long i = __range_start_
-- EXPECT-C: long classify_color(long color)
-- EXPECT-C: == __def_
ANSWER: Int = 42


enum Color:
	Red
	Blue


@tail_recursive
pure func sum_to(n: Int, acc: Int) -> Int:
	if n == 0:
		acc
	else:
		sum_to(n - 1, acc + n)


pure func classify_number(n: Int) -> Int:
	match n:
		0: 10
		1: 20
		_: 30


pure func classify_color(color: Color) -> Int:
	match color:
		Red: 1
		Blue: 2


func main(args: List[String]) -> Int:
	var total: Int = ANSWER
	for i in 5..0:
		total = total + i

	total = total + sum_to(5, 0)
	total = total + classify_number(1)
	total = total + classify_color(Blue)

	if total > 0:
		0
	else:
		1
