-- Regression: Float and Float32 vector/scalar arithmetic should lower to
-- operation-specific kernels instead of generic op-code dispatch.
-- EXPECT-C: blorp_vector_scalar_add_f64(a64, 2.0)
-- EXPECT-C: blorp_vector_scalar_rev_sub_f64(a64, 10.0)
-- EXPECT-C: blorp_vector_scalar_mul_f32(a32, s32)
-- EXPECT-C: blorp_vector_scalar_rev_div_f32(a32, s32)
-- EXPECT-NOT-C: blorp_vector_scalar_op_float(0L
-- EXPECT-NOT-C: blorp_vector_scalar_op_rev_float(1L
-- EXPECT-NOT-C: blorp_vector_scalar_op_float32(2L
-- EXPECT-NOT-C: blorp_vector_scalar_op_rev_float32(3L
import:
	float: to_float32


func main(args: List[String]) -> Int:
	a64: Float[#64] = vector(1.0, 64)
	a32: Float32[#64] = vector(to_float32(1.0), 64)
	s32: Float32 = to_float32(2.0)
	_ = a64 + 2.0
	_ = 10.0 - a64
	_ = a32 * s32
	_ = s32 / a32
	0
