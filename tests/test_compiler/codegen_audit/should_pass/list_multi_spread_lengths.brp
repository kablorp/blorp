-- Regression: list-spread arms at different fixed-head lengths should compile
-- into ordered decision trees instead of leaving raw CMatchArms.
func classify(xs: List[Int]) -> Int:
	match xs:
		[0, ...rest]: 1
		[x, y, ...tail]: 2
		_: 3


func main(args: List[String]) -> Int:
	classify([1]) + classify([1, 2]) + classify([0, 9, 8])
