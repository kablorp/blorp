-- Regression: synthesized tensor allocation should use the return type's
-- explicit storage layout, not the generic pointer-vector constructor.
-- EXPECT-C: static long std_int__INT_MIN = (-9223372036854775807L - 1L);
-- EXPECT-C: blorp_Vector* __result = blorp_vector_new_i64(__n)
-- EXPECT-C: blorp_Vector* __result = blorp_vector_new_f64(__n)
import:
	vector: cumulative_sum


func cumulative_ints(v: Int[#4]) -> Int[#4]:
	cumulative_sum(v)


func cumulative_floats(v: Float[#4]) -> Float[#4]:
	cumulative_sum(v)


func main(args: List[String]) -> Int:
	ints: Int[#4] = cumulative_ints({1, 2, 3, 4})
	floats: Float[#4] = cumulative_floats({1.0, 2.0, 3.0, 4.0})

	if ints[3] == 10 and floats[3] == 10.0:
		0
	else:
		1
