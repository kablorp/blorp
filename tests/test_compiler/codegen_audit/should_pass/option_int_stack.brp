-- Generated-C shape audit for stack Option[Int].
-- EXPECT-C: blorp_StackOption_Int
-- EXPECT-C: .tag = 0
-- EXPECT-C: .tag = 1
-- EXPECT-C: .tag == TAG_Option_Some
-- EXPECT-C: .value
-- EXPECT-C: blorp_StackOption_Int opt =
-- EXPECT-C: blorp_StackOption_Int alias_opt =
import:
	option: Option(Some, None)


type alias MaybeInt = Option[Int]


func choose(flag: Bool) -> Option[Int]:
	if flag:
		Some(7)
	else:
		None


func choose_alias(flag: Bool) -> MaybeInt:
	if flag:
		Some(11)
	else:
		None


func main(args: List[String]) -> Int:
	opt: Option[Int] = choose(True)
	alias_opt: MaybeInt = choose_alias(True)
	x: Int = match opt:
		Some(x): x - 7
		None: 1
	y: Int = match alias_opt:
		Some(v): v - 11
		None: 1
	x + y
