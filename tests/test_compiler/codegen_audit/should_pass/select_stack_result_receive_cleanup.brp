-- select can receive stack-represented Result values from a channel. The
-- cleanup frame must store the address of the local stack slot so cancellation
-- can release an owned Ok/Err payload while the arm body is parked.
-- EXPECT-C: blorp_task_cleanup_push(&__chan_send_cleanup_
-- EXPECT-C: blorp_release(__chan_send_value_
-- EXPECT-C: blorp_stack_result_from_boxed((blorp_Result*)__select_result_
-- EXPECT-C: blorp_task_cleanup_push(&__select_cleanup_
-- EXPECT-C: (void*)&value
-- EXPECT-C: blorp_cleanup_stack_result_value
-- EXPECT-C: blorp_task_cleanup_pop_slot(&value);
-- EXPECT-C: blorp_stack_result_release(value);

func main(args: List[String]) -> Int:
	ch: Channel[Result[String, String]] = channel(1)
	item: Result[String, String] = Ok("selected")
	_ = send(ch, item)
	var selected: Int = 0
	select:
		value from ch:
			sleep(1)
			match value:
				Ok(text): selected = text.length()
				Err(err): selected = err.length()
		_ after 100:
			selected = -1
	selected
