import:
	list as L


record CtfeAuditBox {
	value: Int,
	label: String
}


union CtfeAuditPayload:
	PayloadBox(CtfeAuditBox)
	PayloadEmpty


private pure func ctfe_heap_item_marker(value: Int) -> Int:
	if value < 0:
		991991991
	else:
		value


private pure func ctfe_heap_list_marker() -> List[Int]:
	var values: List[Int] = L.list(2)

	values = L.append(values, ctfe_heap_item_marker(20))
	values = L.append(values, 22)

	values


private pure func ctfe_heap_dict_marker(values: List[Int]) -> Dict[String, Int]:
	var result: Dict[String, Int] = {}

	result = result.set(
		"first",
		values.get_or(0, 0),
	)
	result = result.set(
		"second",
		values.get_or(1, 0),
	)

	result


private pure func ctfe_heap_box_marker(value: Int) -> CtfeAuditBox:
	if value < 0:
		{
			value = 992992992,
			label = "bad"
		}
	else:
		{
			value = value,
			label = "ok"
		}


CTFE_AUDIT_LIST: List[Int] = ctfe_heap_list_marker()

CTFE_AUDIT_DICT: Dict[String, Int] = ctfe_heap_dict_marker(CTFE_AUDIT_LIST)

CTFE_AUDIT_BOX: CtfeAuditBox = ctfe_heap_box_marker(CTFE_AUDIT_DICT.get_or("first", 0))

CTFE_AUDIT_PAYLOAD: CtfeAuditPayload = PayloadBox(CTFE_AUDIT_BOX)


func main(args: List[String]) -> Int:
	if (
		CTFE_AUDIT_LIST.get_or(1, 0) == 22
		and CTFE_AUDIT_DICT.get_or("second", 0) == 22
		and CTFE_AUDIT_BOX.value == 20
	):
		0
	else:
		1
