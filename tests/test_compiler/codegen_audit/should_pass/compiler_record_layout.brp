-- EXPECT-C: LayoutMixed __r = { .first = first, .count = count, .second = second, .total = total };
-- EXPECT-C: blorp_list_new_inline(1, sizeof(LayoutMixed))
-- EXPECT-C: blorp_vector_new_sized(1, sizeof(LayoutMixed))
-- EXPECT-C: blorp_box_struct(&__box_struct_value, sizeof(LayoutMixed))
-- EXPECT-C: typedef struct { int tag; LayoutMixed value; } blorp_StackOption_LayoutMixed;
