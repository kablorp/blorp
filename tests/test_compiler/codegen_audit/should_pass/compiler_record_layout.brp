-- EXPECT-C: typedef struct { _Bool first : 1; _Bool second : 1; _Bool third : 1; } LayoutThreeFlags;
-- EXPECT-C: static inline LayoutThreeFlags LayoutThreeFlags_make(int first, int second, int third)
-- EXPECT-C: typedef struct { _Bool first; long count; _Bool second; long total; } LayoutMixed;
-- EXPECT-C: typedef struct LayoutHeapFlags {
-- EXPECT-C:   _Bool first;
-- EXPECT-C:   _Bool second;
-- EXPECT-C:   _Bool third;
-- EXPECT-C: LayoutHeapFlags* LayoutHeapFlags_make(int first, int second, int third, blorp_String* payload)
-- EXPECT-C: typedef struct LayoutForeignHeapFlags {
-- EXPECT-C:   int flag;
-- EXPECT-C: LayoutForeignHeapFlags* LayoutForeignHeapFlags_make(int flag)
-- EXPECT-C: typedef struct { int first; long count; int second; long total; } LayoutForeignMixed;
-- EXPECT-C: typedef struct { int tag; LayoutThreeFlags value; } blorp_StackOption_LayoutThreeFlags;
-- EXPECT-C: blorp_list_new_inline(1, sizeof(LayoutThreeFlags))
-- EXPECT-C: blorp_vector_new_sized(2, sizeof(LayoutThreeFlags))
-- EXPECT-C: blorp_box_struct(&__box_struct_value, sizeof(LayoutThreeFlags))
-- EXPECT-C: LayoutThreeFlags value = (*(LayoutThreeFlags*)((char*)
-- EXPECT-C: blorp_layout_bool_identity(__ffi_scalar_arg_
import:
	list as Lists
	tensor as Tensors


struct LayoutThreeFlags {
	first: Bool,
	second: Bool,
	third: Bool
}


struct LayoutMixed {
	first: Bool,
	count: Int,
	second: Bool,
	total: Int
}


record LayoutHeapFlags {
	first: Bool,
	second: Bool,
	third: Bool,
	payload: String
}


record LayoutForeignHeapFlags {
	flag: Bool
}


struct LayoutForeignMixed {
	first: Bool,
	count: Int,
	second: Bool,
	total: Int
}


foreign(include: "compiler_record_layout_ffi.h"):
	func layout_ordered_flag(expected: Int) -> Bool = "blorp_layout_ordered_flag"
	pure func layout_bool_identity(value: Bool) -> Bool = "blorp_layout_bool_identity"
	pure func layout_foreign_heap_flag(
		value: LayoutForeignHeapFlags,
	) -> Bool = "blorp_layout_foreign_heap_flag"
	@no_copy func layout_no_copy_foreign_heap_flag(
		value: LayoutForeignHeapFlags,
	) -> Bool = "blorp_layout_foreign_heap_flag"
	pure func layout_foreign_identity(
		value: LayoutForeignMixed,
	) -> LayoutForeignMixed = "blorp_layout_foreign_identity"


func main(args: List[String]) -> Int:
	flags: LayoutThreeFlags = {
		first = True,
		second = False,
		third = True
	}
	updated_flags: LayoutThreeFlags = { flags | second = True }
	copied_flags: LayoutThreeFlags = updated_flags
	ordered_flags: LayoutThreeFlags = {
		first = layout_ordered_flag(0),
		second = layout_ordered_flag(1),
		third = layout_ordered_flag(2)
	}
	foreign_field_value: Bool = layout_bool_identity(flags.first)
	listed_flags: List[LayoutThreeFlags] = [copied_flags]

	list_flags: LayoutThreeFlags = match Lists.get(listed_flags, 0):
		Some(value):
			value
		None:
			flags

	tensor_flags: LayoutThreeFlags[#2] = {copied_flags, flags}
	tensor_value: LayoutThreeFlags = Tensors.get_or(tensor_flags, 0, flags)
	optional_flags: Option[LayoutThreeFlags] = Some(copied_flags)

	option_value: LayoutThreeFlags = match optional_flags:
		Some(value):
			value
		None:
			flags

	result_flags: Result[LayoutThreeFlags, String] = Ok(copied_flags)

	result_value: LayoutThreeFlags = match result_flags:
		Ok(value):
			value
		Err(_):
			flags

	mixed: LayoutMixed = {
		first = flags.first,
		count = 1,
		second = flags.second,
		total = 2
	}
	heap_flags: LayoutHeapFlags = {
		first = mixed.first,
		second = mixed.second,
		third = flags.third,
		payload = "layout"
	}
	updated_heap_flags: LayoutHeapFlags = { heap_flags | second = True }
	copied_heap_flags: LayoutHeapFlags = updated_heap_flags
	foreign_heap_flags: LayoutForeignHeapFlags = {flag = True}
	foreign_mixed: LayoutForeignMixed = layout_foreign_identity({
		first = heap_flags.first,
		count = mixed.count,
		second = heap_flags.second,
		total = mixed.total,
	})

	if (
		foreign_mixed.first
		and not foreign_mixed.second
		and foreign_field_value
		and ordered_flags.first
		and ordered_flags.second
		and ordered_flags.third
		and flags.third
		and copied_flags.second
		and list_flags.second
		and tensor_value.second
		and option_value.second
		and result_value.second
		and foreign_mixed.count + foreign_mixed.total == 3
		and mixed.count + mixed.total == 3
		and heap_flags.payload == "layout"
		and heap_flags.third
		and copied_heap_flags.first
		and copied_heap_flags.second
		and copied_heap_flags.third
		and copied_heap_flags.payload == "layout"
		and layout_foreign_heap_flag(foreign_heap_flags)
		and layout_no_copy_foreign_heap_flag(foreign_heap_flags)
	):
		0
	else:
		1
