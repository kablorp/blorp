record Counter {
	value: Int
}


record CounterBox {
	counter: Counter,
	text: String
}


NESTED_COUNTER: CounterBox = {
	counter = {value = 3},
	text = "nested",
}


func main(args: List[String]) -> Int:
	if NESTED_COUNTER.counter.value == 3 and NESTED_COUNTER.text == "nested":
		0
	else:
		1
