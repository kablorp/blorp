-- Generated-C shape audit for expression-local Option helper fusion.
-- EXPECT-NOT-CALLABLE: std_option__get_or__mono_Int
-- EXPECT-NOT-CALLABLE: std_option__get_or_else__mono_Int
-- EXPECT-NOT-CALLABLE: std_option__is_some__mono_Int
-- EXPECT-NOT-CALLABLE: std_option__is_none__mono_Int
-- EXPECT-C: blorp_StackOption_Int __blorp_option_fusion_
-- EXPECT-C: __blorp_option_fusion_
-- EXPECT-C: .tag == BLORP_TAG_SOME
-- EXPECT-C: .tag == BLORP_TAG_NONE
import:
	option: get_or, get_or_else, is_none, is_some


func fallback() -> Int:
	99


func main(args: List[String]) -> Int:
	value: Int = checked_div(10, 2).get_or(0)
	lazy_value: Int = checked_div(10, 2).get_or_else(fallback)
	present: Bool = is_some(checked_div(10, 2))
	missing: Bool = is_none(checked_div(10, 0))
	if (
		value == 5
		and lazy_value == 5
		and present
		and missing
	):
		0
	else:
		1
