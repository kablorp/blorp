-- A tuple returned from a small monomorphic tuple-factory function and used
-- only through fields or supported tuple matches should scalar-expand at the
-- call site.
-- EXPECT-C: __tuple_sroa_
-- EXPECT-NOT-C: blorp_Tuple* p = __def_
-- EXPECT-NOT-C: swap(1L, 2L)
-- EXPECT-NOT-C: swap(3L, 4L)
-- EXPECT-NOT-C: swap(5L, 6L)
-- EXPECT-NOT-C: pair_expr(2L, 3L)
-- EXPECT-NOT-C: pair_locals(2L, 3L)
-- EXPECT-NOT-C: choose_pair(true, 2L, 3L)
-- EXPECT-NOT-C: return ({ blorp_Tuple* result = blorp_tuple_new(2, (void*)(long)(b), (void*)(long)(a)); result; });
func swap(a: Int, b: Int) -> (Int, Int):
	result: (Int, Int) = (b, a)
	result


func pair_expr(a: Int, b: Int) -> (Int, Int):
	(a + 1, b * 2)


func pair_locals(a: Int, b: Int) -> (Int, Int):
	x: Int = a + 1
	y: Int = b * 2
	(x, y)


func choose_pair(use_swap: Bool, a: Int, b: Int) -> (Int, Int):
	if use_swap:
		(b, a)
	else:
		(a, b)


func main(args: List[String]) -> Int:
	p: (Int, Int) = swap(1, 2)
	direct: Int = swap(3, 4).0
	matched: Int = match swap(5, 6):
		(x, y): x + y
	expr: (Int, Int) = pair_expr(2, 3)
	locals: (Int, Int) = pair_locals(2, 3)
	chosen: (Int, Int) = choose_pair(True, 2, 3)
	if p.0 == 2 and p.1 == 1 and direct == 4 and matched == 11 and expr.0 == 3 and expr.1 == 6 and locals.0 == 3 and locals.1 == 6 and chosen.0 == 3 and chosen.1 == 2:
		0
	else:
		1
