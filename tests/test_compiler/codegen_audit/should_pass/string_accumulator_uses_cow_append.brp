-- Replacing a mutable String with itself plus a suffix must use the
-- COW-consuming append primitive instead of copying the accumulated prefix.
--
-- EXPECT-C: = blorp_string_append(result, part);
-- EXPECT-NOT-C: = blorp_string_concat(result, part);
pure func render(parts: List[String]) -> String:
	var result: String = ""

	for part in parts:
		result += part

	result


func main(args: List[String]) -> Int:
	if render(["a", "b", "c"]) == "abc":
		0
	else:
		1
