-- A fixed concurrent block may capture a managed channel and then return a
-- managed value from the tail that consumes the joined task results. Perceus
-- must be able to drop the captured channel after the tail without turning the
-- value-producing concurrent block into a void GNU statement expression.
-- EXPECT-C: blorp_TaskBatch __conc_batch_
-- EXPECT-C: RunStats* __cdrop_jobs = ({
record RunStats {changed: Int, errors: Int}


func stats(changed: Int, errors: Int) -> RunStats:
	{changed = changed, errors = errors}


func produce(jobs: Channel[String]) -> RunStats:
	_ = send(jobs, "path.py")
	seal(jobs)
	stats(1, 0)


func consume(jobs: Channel[String]) -> RunStats:
	match recv(jobs):
		Some(_): stats(0, 1)
		None: stats(0, 0)


func merge_one(result: TaskResult[RunStats]) -> RunStats:
	match result:
		Ok(value): value
		Err(_): stats(0, 1)


func add_stats(left: RunStats, right: RunStats) -> RunStats:
	stats(left.changed + right.changed, left.errors + right.errors)


func run_pipeline() -> RunStats:
	jobs: Channel[String] = channel(1)
	concurrent:
		produced = produce(jobs)
		consumed = consume(jobs)
	add_stats(merge_one(produced), merge_one(consumed))


func main(args: List[String]) -> Int:
	result: RunStats = run_pipeline()
	result.changed + result.errors
