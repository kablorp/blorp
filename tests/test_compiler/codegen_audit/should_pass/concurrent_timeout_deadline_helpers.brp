-- Concurrent timeout codegen should use the shared runtime deadline helpers.
-- EXPECT-C: blorp_concurrent_deadline_us(
-- EXPECT-C: blorp_concurrent_remaining_ms(__conc_deadline_
-- EXPECT-NOT-C: blorp_now_us() + (
import:
	list: range


func slow(n: Int) -> Int:
	sleep(n)
	n


func main(args: List[String]) -> Int:
	concurrent(timeout: 5):
		a = slow(1)
	a_value: Int = match a:
		Ok(v): v
		Err(_): 0
	limited: List[Result[Int, ConcurrencyError]] = for i in range(
		0,
		3,
	) concurrently(limit: 2, timeout: 5):
		slow(i)
	legacy: List[Result[Int, ConcurrencyError]] = concurrent(timeout: 5) for i in range(0, 2):
		slow(i)
	var total: Int = a_value
	for result in limited:
		match result:
			Ok(v): total += v
			Err(_): total -= 100
	for result in legacy:
		match result:
			Ok(v): total += v
			Err(_): total -= 100
	total
