-- Concurrent timeout codegen should use the shared runtime deadline helpers.
-- EXPECT-C: blorp_concurrent_deadline_us(
-- EXPECT-C: blorp_concurrent_remaining_ms(__conc_deadline_
-- EXPECT-NOT-C: blorp_now_us() + (
import:
	list: range
	units: from_milliseconds


func slow(n: Int) -> Int:
	sleep(n)
	n


func main(args: List[String]) -> Int:
	concurrent(timeout: 5):
		a = slow(1)
	a_value: Int = match a:
		Ok(v): v
		Err(_): 0
	limited: List[Result[Int, ConcurrencyError]] = range(0, 3).concurrent_with_timeout(
		2,
		from_milliseconds(5),
		func(i: Int): slow(i),
	)
	var total: Int = a_value
	for result in limited:
		match result:
			Ok(v): total += v
			Err(_): total -= 100
	total
