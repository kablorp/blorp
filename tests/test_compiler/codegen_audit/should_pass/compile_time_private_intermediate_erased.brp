-- Private compile_time bindings used only by later compile_time bindings are
-- evaluator scratch state. They should not become runtime globals.
-- EXPECT-C: static long CTFE_PUBLIC_RESULT = 42L;
-- EXPECT-NOT-C: CTFE_PRIVATE_SCRATCH
compile_time:
	private CTFE_PRIVATE_SCRATCH: Int = 40
	CTFE_PUBLIC_RESULT: Int = CTFE_PRIVATE_SCRATCH + 2


func main(args: List[String]) -> Int:
	CTFE_PUBLIC_RESULT
