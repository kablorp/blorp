-- EXPECT-C: static struct { blorp_Object header; long len; long capacity; char data[11]; } __blorp_static_string_PREPEND_STR =
-- EXPECT-C: static blorp_String* PREPEND_STR = (blorp_String*)&__blorp_static_string_PREPEND_STR;
-- EXPECT-C: "these,args"
-- EXPECT-NOT-C: PREPEND_STR = __blorp_get_
-- EXPECT-NOT-C: blorp_make_immortal_constant(PREPEND_STR)
TO_PREPEND = ["these", "args"]

PREPEND_STR = TO_PREPEND.join(",")


pure func transform_args(args: List[String]) -> String:
	PREPEND_STR + args
		.join("AHHH")
		.upper()


func main(args: List[String]):
	print(transform_args(args))
