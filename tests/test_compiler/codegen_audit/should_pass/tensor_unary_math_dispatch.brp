-- Unary tensor math crosses the Blorp specialization boundary in semantic
-- form and selects the runtime ABI from the receiver element type.
-- EXPECT-C: float norm32 = blorp_vector_norm_float32(values32)
-- EXPECT-C: blorp_Vector* sqrt32 = blorp_vector_sqrt_float32(values32)
-- EXPECT-C: blorp_Vector* exp32 = blorp_vector_exp_float32(values32)
-- EXPECT-C: blorp_Vector* log32 = blorp_vector_log_float32(values32)
-- EXPECT-C: _Float16 norm16 = blorp_vector_norm_float16(values16)
-- EXPECT-C: blorp_Vector* sqrt16 = blorp_vector_sqrt_float16(values16)
-- EXPECT-C: blorp_Vector* exp16 = blorp_vector_exp_float16(values16)
-- EXPECT-C: blorp_Vector* log16 = blorp_vector_log_float16(values16)
import:
	vector: exp, log, norm, sqrt


func main(args: List[String]) -> Int:
	values32: Float32[#2] = {to_float32(1.0), to_float32(4.0)}
	norm32: Float32 = norm(values32)
	sqrt32: Float32[#2] = sqrt(values32)
	exp32: Float32[#2] = exp(values32)
	log32: Float32[#2] = log(values32)

	values16: Float16[#2] = {to_float16(1.0), to_float16(4.0)}
	norm16: Float16 = norm(values16)
	sqrt16: Float16[#2] = sqrt(values16)
	exp16: Float16[#2] = exp(values16)
	log16: Float16[#2] = log(values16)

	if (
		to_float(norm32) > 0.0
		and to_float(sqrt32[0]) > 0.0
		and to_float(exp32[0]) > 0.0
		and to_float(log32[1]) > 0.0
		and to_float(norm16) > 0.0
		and to_float(sqrt16[0]) > 0.0
		and to_float(exp16[0]) > 0.0
		and to_float(log16[1]) > 0.0
	):
		0
	else:
		1
