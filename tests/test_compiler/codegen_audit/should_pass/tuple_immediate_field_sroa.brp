-- Immediate tuple field access should scalar-replace the tuple allocation
-- while still evaluating every tuple element.
-- EXPECT-C: __blorp_internal_tuple_sroa_
-- Semantic callable expectation: mark(2)
-- EXPECT-C: bh_9FmVDJmPW0(2)
-- EXPECT-NOT-C: blorp_tuple_new(2, (void*)(long)
func mark(x: Int) -> Int:
	x


func main(args: List[String]) -> Int:
	value: Int = (mark(40), mark(2))[0]

	if value == 40:
		0
	else:
		1
