import:
	option: Option(Some, None)
	stream as S


func keep_long(s: String) -> Option[String]:
	if s.length() > 1:
		Some(s)
	else:
		None


func main(args: List[String]) -> Int:
	filtered: Stream[String] = S.filter_map(S.from_list(["a", "bee"]), keep_long)
	items: List[String] = S.collect(filtered)
	found: Option[String] = S.find(S.from_list(["a", "bee"]), func(s: String): s.length() > 1)
	items_ok: Bool = match items.get(0):
		Some(s): s == "bee"
		None: False
	found_ok: Bool = match found:
		Some(s): s == "bee"
		None: False
	if items_ok and found_ok:
		0
	else:
		1
