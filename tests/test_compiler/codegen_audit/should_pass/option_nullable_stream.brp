-- Generated-C shape audit for nullable managed Option payloads in Stream APIs.
-- EXPECT-C: blorp_stream_from_list(__borrow_arg_
-- EXPECT-C: blorp_Stream* __call_result_2 = blorp_stream_filter_map_nullable(__call_arg_0, __call_arg_1);
-- EXPECT-C: blorp_List* items = blorp_stream_collect(filtered);
-- EXPECT-C: void* __call_result_5 = blorp_stream_find_nullable(__call_arg_3, __call_arg_4);
-- EXPECT-NOT-C: __def_528_std_stream__from_list
-- EXPECT-NOT-C: __def_541_std_stream__collect
-- EXPECT-NOT-C: __def_545_std_stream__find
import:
	option: Option(Some, None)
	stream as S


func keep_long(s: String) -> Option[String]:
	if s.length() > 1:
		Some(s)
	else:
		None


func main(args: List[String]) -> Int:
	filtered: Stream[String] = S.filter_map(
		S.from_list(["a", "bee"]),
		keep_long,
	)
	items: List[String] = S.collect(filtered)
	found: Option[String] = S.find(S.from_list(["a", "bee"]), func(s: String): s.length() > 1)

	items_ok: Bool = match items.get(0):
		Some(s):
			s == "bee"
		None:
			False

	found_ok: Bool = match found:
		Some(s):
			s == "bee"
		None:
			False

	if items_ok and found_ok:
		0
	else:
		1
