-- Codegen audit: length() on concrete-dim tensors should constant-fold
-- After optimization, generated C should NOT contain ((blorp_Vector*)...)->len
-- for cases where the dim is known at compile time.
-- EXPECT-C: return 3;
-- EXPECT-NOT-C: ((blorp_Vector*)v)->len
pure func known_len[#N](v: Int[#N]) -> Int:
	length(v)


pure func known_access[#N](v: Int[#N]) -> Int:
	v[0]


func main(args: List[String]) -> Int:
	a: Int = known_len({1, 2, 3})
	b: Int = known_access({10, 20, 30})
	print(a.to_string())
	print(b.to_string())
	0
