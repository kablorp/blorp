-- String.split should lower to a direct part-counting builder, not repeated suffix substring scans.
-- EXPECT-C: __split_part_count
-- EXPECT-C: blorp_list_new(__split_part_count)
-- EXPECT-C: ->len = __split_part_count
-- EXPECT-C: = (blorp_String*)__split_segment; long __string_copy_dst_pos_
-- EXPECT-C: = (blorp_String*)__split_final_segment; long __string_copy_dst_pos_
-- EXPECT-C: memcpy(__string_copy_dst_
import:
	list as L
	string: split


func main(args: List[String]) -> Int:
	parts: List[String] = "alpha::beta::gamma".split("::")
	if L.length(parts) == 3:
		0
	else:
		1
