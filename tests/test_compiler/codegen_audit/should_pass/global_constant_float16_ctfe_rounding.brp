-- EXPECT-C: static blorp_String* ROUNDING_LABEL;
-- EXPECT-C: ROUNDING_LABEL = blorp_string_create("rounded");
-- EXPECT-C: blorp_release_arc_only(ROUNDING_LABEL);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-NOT-C: __blorp_static_string_
-- EXPECT-NOT-C: not-yet
ROUNDING_LABEL: String = if to_float16(1.0001) == to_float16(1.0):
	"rounded"
else:
	"not-yet"


func main(args: List[String]) -> Int:
	if ROUNDING_LABEL == "rounded":
		0
	else:
		1
