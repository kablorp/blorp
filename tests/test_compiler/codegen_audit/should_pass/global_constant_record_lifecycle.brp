-- EXPECT-C: static CounterBox* NESTED_COUNTER;
-- EXPECT-C: NESTED_COUNTER = CounterBox_make(Counter_make(3), blorp_string_create("nested"));
-- EXPECT-C: blorp_release(NESTED_COUNTER);
-- EXPECT-C: blorp_register_global_cleanup(__blorp_drop_globals);
-- EXPECT-NOT-C: __blorp_static_string_
-- EXPECT-NOT-C: blorp_make_immortal_
record Counter {
	value: Int
}


record CounterBox {
	counter: Counter,
	text: String
}


NESTED_COUNTER: CounterBox = {
	counter = {value = 3},
	text = "nested",
}


func main(args: List[String]) -> Int:
	if NESTED_COUNTER.counter.value == 3 and NESTED_COUNTER.text == "nested":
		0
	else:
		1
