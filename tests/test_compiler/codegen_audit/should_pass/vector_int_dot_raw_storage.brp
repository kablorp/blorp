-- Regression: concrete Int vector dot products should use the same guarded
-- typed raw i64 fast path as Int sum, with a generic fallback for unusual
-- vector representations.
-- EXPECT-C: ->storage_mode == BLORP_VECTOR_STORAGE_I64
-- EXPECT-C: ->elem_size == (int16_t)sizeof(long)
-- EXPECT-C: long* __tensor_a_raw = (long*)((blorp_Vector*)__tensor_a)->data
-- EXPECT-C: long* __tensor_b_raw = (long*)((blorp_Vector*)__tensor_b)->data
-- EXPECT-C: __tensor_a_raw[__i] * __tensor_b_raw[__i]
-- EXPECT-C: blorp_vector_read_i64((blorp_Vector*)__tensor_a, __i)
import:
	vector: dot


func main(args: List[String]) -> Int:
	a: Int[#4] = {1, 2, 3, 4}
	b: Int[#4] = {5, 6, 7, 8}
	dot(a, b)
