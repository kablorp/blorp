-- Generated-C audit for matching Some(Ok(...)) when List.get boxes a stack Result payload.
-- EXPECT-C: blorp_StackResult*)((char*)(
-- EXPECT-NOT-C: data.Some.field0.tag
import:
	result: Result(Ok, Err)


func first_or_negative(values: List[Result[Int, String]]) -> Int:
	match values.get(0):
		Some(Ok(value)):
			value
		Some(Err(_error)):
			-2
		None:
			-1


func main(args: List[String]) -> Int:
	values: List[Result[Int, String]] = [Ok(7)]
	first_or_negative(values)
