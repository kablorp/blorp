-- Scoped ParallelVector chains should lower to one runtime parallel map at the
-- call site, with the stage callbacks composed inside one generated callback.
-- EXPECT-C: blorp_vmap_parallel(values,
-- EXPECT-C: blorp_vmap_indexed_parallel(indexed_values,
-- EXPECT-C: blorp_vzip_parallel(left,
-- EXPECT-C: blorp_vzip_parallel(reuse_left,
-- EXPECT-C: blorp_vzip_parallel(managed_left,
-- EXPECT-C: __blorp_internal_parallel_tensor_stage_
-- EXPECT-NOT-C: blorp_vmap_indexed_parallel(left,
-- EXPECT-NOT-C: blorp_vmap_indexed_parallel(reuse_left,
-- EXPECT-NOT-C: blorp_vmap_indexed_parallel(managed_left,
import:
	vector: ParallelVector, parallel


func main(args: List[String]) -> Int:
	__pv_value_0: Int = 7
	values: Int[#4] = {1, 2, 3, 4}
	mapped: Int[#4] = values.parallel(pure func(chunk: ParallelVector[Int, #4]):
		chunk
			.map(pure func(x: Int) -> Int: x + __pv_value_0)
			.map(pure func(x: Int) -> Int: x * 2)
	)
	left: Int[#3] = {1, 2, 3}
	right: Int[#3] = {10, 20, 30}
	zipped: Int[#3] = left.parallel(pure func(chunk: ParallelVector[Int, #3]):
		chunk
			.zip_map(right, pure func(a: Int, b: Int) -> Int: a + b)
			.map(pure func(x: Int) -> Int: x * 2)
	)
	indexed_values: Int[#4] = {4, 5, 6, 7}
	indexed: Int[#4] = indexed_values.parallel(pure func(chunk: ParallelVector[Int, #4]):
		chunk
			.map_indexed(pure func(i: ..#4, x: Int) -> Int: x + i)
			.map(pure func(x: Int) -> Int: x * 2)
	)
	reuse_left: Int[#3] = {2, 4, 6}
	reuse_right: Int[#3] = {3, 5, 7}
	reused: Int[#3] = reuse_left.parallel(pure func(chunk: ParallelVector[Int, #3]):
		chunk
			.zip_map(reuse_right, pure func(a: Int, b: Int) -> Int: a + b)
			.zip_map(reuse_right, pure func(a: Int, b: Int) -> Int: a * b)
			.map(pure func(x: Int) -> Int: x + 1)
	)
	managed_left: Int[#2] = {1, 2}
	managed_right: Int[#2] = {10, 20}
	managed: List[Int][#2] = managed_left.parallel(pure func(chunk: ParallelVector[Int, #2]):
		chunk
			.zip_map(managed_right, pure func(a: Int, b: Int) -> List[Int]: [a, b, a + b])
			.map(pure func(row: List[Int]) -> List[Int]: row.append(row.length()))
	)
	mapped[3] + zipped[2] + indexed[3] + reused[2] + managed[1].length()
