-- A windowed final reverse should materialize by writing result bytes directly
-- from the original source window.
-- EXPECT-C: __sp_reverse_result_
-- EXPECT-C: __sp_reverse_i_
-- EXPECT-C: ->data[__sp_reverse_i_
-- EXPECT-NOT-C: std_string__reverse(__def_
import:
	string: reverse, trim


pure func fused_reverse(s: String) -> String:
	s
		.trim()
		.reverse()


func main(args: List[String]) -> Int:
	if fused_reverse("  abcdef  ") == "fedcba":
		0
	else:
		1
