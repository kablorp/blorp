-- A windowed final reverse should materialize by writing result bytes directly
-- from the original source window.
-- EXPECT-C: __blorp_internal_string_pipeline_14_reverse_result_
-- EXPECT-C: __blorp_internal_string_pipeline_9_reverse_i_
-- EXPECT-C: ->data[__blorp_internal_string_pipeline_9_reverse_i_
-- Semantic callable expectation: std_string__reverse(__def_
-- EXPECT-NOT-C-REGEX: brp_[0-9A-Za-z]+\(__def_
import:
	string: reverse, trim


pure func fused_reverse(s: String) -> String:
	s
		.trim()
		.reverse()


func main(args: List[String]) -> Int:
	if fused_reverse("  abcdef  ") == "fedcba":
		0
	else:
		1
