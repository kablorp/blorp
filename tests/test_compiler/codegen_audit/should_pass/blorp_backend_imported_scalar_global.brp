-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C: static long std_units__MICROSECONDS_PER_MILLISECOND = 1000L;
-- EXPECT-C: long scale = std_units__MICROSECONDS_PER_MILLISECOND;
-- EXPECT-C: long __blorp_main_result = (long)((scale == 1000) ? 0 : 1);
import:
	units: MICROSECONDS_PER_MILLISECOND


func main(args: List[String]) -> Int:
	scale: Int = MICROSECONDS_PER_MILLISECOND

	if scale == 1000:
		0
	else:
		1
