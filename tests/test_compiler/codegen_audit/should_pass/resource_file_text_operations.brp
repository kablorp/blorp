-- EXPECT-C: blorp_file_read_text_reader_raw(reader)
-- EXPECT-C: blorp_file_write_text_writer_raw(writer
-- EXPECT-C: blorp_file_read_bytes_reader_raw(reader)
-- EXPECT-C: blorp_file_write_bytes_writer_raw(writer
-- EXPECT-C: blorp_file_write_chunk_writer_raw(writer
-- EXPECT-C: blorp_file_read_chunk_reader_raw(reader
-- EXPECT-C: blorp_file_read_chunk_at_reader_raw(reader
-- EXPECT-C: blorp_file_chunks_reader_raw(reader)
-- EXPECT-C: blorp_file_chunks_with_size_reader_raw(reader
-- EXPECT-C: blorp_file_lines_reader_raw(reader)
-- EXPECT-C: blorp_file_bytes_reader_raw(reader)
-- EXPECT-C: blorp_file_windows_reader_raw(reader
-- EXPECT-C: blorp_file_count_lines_reader_raw(reader)
-- EXPECT-C: blorp_file_read_text_read_writer_raw(file)
-- EXPECT-C: blorp_file_read_bytes_read_writer_raw(file)
-- EXPECT-C: blorp_file_read_chunk_read_writer_raw(file
-- EXPECT-C: blorp_file_count_lines_read_writer_raw(file)
-- EXPECT-C: blorp_file_write_text_read_writer_raw(file
-- EXPECT-C: blorp_file_write_bytes_read_writer_raw(file
-- EXPECT-C: blorp_file_write_chunk_read_writer_raw(file
-- EXPECT-C: blorp_file_size_read_appender_raw(file
-- EXPECT-C: blorp_file_append_text_read_appender_raw(file
-- EXPECT-C: blorp_fallible_stream_collect_raw(
-- EXPECT-C: BLORP_FALLIBLE_STREAM_ERROR_DOMAIN_FILE
-- EXPECT-C: BLORP_LIST_STORAGE_INLINE, 1
-- EXPECT-C: blorp_fallible_stream_count_raw(
-- EXPECT-C: blorp_fallible_stream_fold_raw(
-- EXPECT-C: blorp_fallible_stream_find_raw_nullable(
-- EXPECT-C: blorp_fallible_stream_any_raw(
-- EXPECT-C: blorp_fallible_stream_all_raw(
-- EXPECT-C: blorp_file_close_writer(writer);
-- EXPECT-C: blorp_file_close_reader(reader);
-- EXPECT-C: blorp_file_close_read_writer(file);
-- EXPECT-C: blorp_file_close_read_appender(file);
import:
	bytes as B
	fs: IOError, open_read, open_read_append, open_read_write, open_write
	stream: all_result, any_result, collect_result, count_result, find_result, fold_result


func copy_text(src: String, dst: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		text ?= reader.read_text()
		with writer ?= open_write(dst):
			match writer.write_text(text):
				Ok(_): Ok(text.length())
				Err(err): Err(err)


func copy_bytes(src: String, dst: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		data ?= reader.read_bytes()
		with writer ?= open_write(dst):
			match writer.write_bytes(data):
				Ok(_): Ok(B.length(data))
				Err(err): Err(err)


func copy_chunk(src: String, dst: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		data ?= reader.read_chunk(4096)
		with writer ?= open_write(dst):
			writer.write_chunk(data)


func read_write_text(path: String) -> Result[String, IOError]:
	with file ?= open_read_write(path):
		ignored ?= file.write_text("prefix")
		file.read_text()


func read_write_bytes(path: String) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		ignored ?= file.write_bytes("bytes".to_bytes())
		data ?= file.read_bytes()
		Ok(B.length(data))


func read_write_chunk(path: String) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		data ?= file.read_chunk(4096)
		file.write_chunk(data)


func read_write_count_lines(path: String) -> Result[Int, IOError]:
	with file ?= open_read_write(path):
		file.count_lines()


func read_at_len(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		data ?= reader.read_chunk_at(1, 2)
		Ok(B.length(data))


func read_append_size_and_append(path: String) -> Result[Int, IOError]:
	with file ?= open_read_append(path):
		size ?= file.size()
		appended ?= file.append_text("\n")
		Ok(size)


func first_chunk_len(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		data ?= reader.read_chunk(1024)
		Ok(B.length(data))


func collect_chunks(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		parts ?= reader
			.chunks()
			.collect_result()
		Ok(parts.length())


func collect_sized_chunks(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		parts ?= reader
			.chunks_with_size(4096)
			.collect_result()
		Ok(parts.length())


func count_sized_chunks(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		reader
			.chunks_with_size(4096)
			.count_result()


func sum_sized_chunk_lengths(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		reader
			.chunks_with_size(4096)
			.fold_result(0, func(total: Int, chunk: Bytes): total + B.length(chunk))


func has_empty_chunk(src: String) -> Result[Bool, IOError]:
	with reader ?= open_read(src):
		reader
			.chunks_with_size(4096)
			.any_result(func(chunk: Bytes): B.length(chunk) == 0)


func all_chunks_have_bytes(src: String) -> Result[Bool, IOError]:
	with reader ?= open_read(src):
		reader
			.chunks_with_size(4096)
			.all_result(func(chunk: Bytes): B.length(chunk) > 0)


func find_named_chunk(src: String) -> Result[Option[Bytes], IOError]:
	with reader ?= open_read(src):
		reader
			.chunks_with_size(4096)
			.find_result(func(chunk: Bytes): B.length(chunk) > 0)


func collect_lines(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		parts ?= reader
			.lines()
			.collect_result()
		Ok(parts.length())


func count_lines_fast(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		reader.count_lines()


func count_bytes(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		reader
			.bytes()
			.count_result()


func collect_bytes(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		parts ?= reader
			.bytes()
			.collect_result()
		Ok(parts.length())


func collect_windows(src: String) -> Result[Int, IOError]:
	with reader ?= open_read(src):
		parts ?= reader
			.windows(8)
			.collect_result()
		Ok(parts.length())
