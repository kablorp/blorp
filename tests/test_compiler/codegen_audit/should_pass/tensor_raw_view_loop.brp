-- Regression: a proven in-bounds tensor update loop should have a guarded raw
-- view fast path. The fast path may write raw storage only after proving both
-- the storage layout and COW uniqueness; the safe COW setter must remain as the
-- fallback path.
--
-- EXPECT-C: __tensor_raw_view_ok_
-- EXPECT-C: blorp_is_unique(
-- EXPECT-C: double* __tensor_raw_view_
-- EXPECT-C: __tensor_raw_view_xs_
-- EXPECT-NOT-C: void* __tensor_raw_view_
-- EXPECT-C: blorp_vector_set_inplace_f64
pure func bump(values: Float[#4]) -> Float:
	var xs = values
	for i in 0..length(xs):
		xs[i] = xs[i] + 1.0
	xs[0] + xs[3]


func main(args: List[String]) -> Int:
	if bump({1.0, 2.0, 3.0, 4.0}) == 7.0:
		0
	else:
		1
