-- TCP connection sources are ARC-owned cursor wrappers that borrow their
-- listener owner. Binding one should release only the wrapper.
-- EXPECT-C: blorp_tcp_connections_stop_on_error_raw(listener)
-- EXPECT-C: blorp_tcp_connections_continue_on_error_raw(listener)
-- EXPECT-C: blorp_release_arc_only(source);
-- EXPECT-C: blorp_release_arc_only(continue_source);
-- EXPECT-NOT-C: blorp_tcp_close_listener(source)
import:
	net/tcp as Tcp: TcpError, TcpStream
	stream: ResourceSource


func connection_source_shape() -> Result[Int, TcpError]:
	with listener ?= Tcp.listen("127.0.0.1", 0, 1):
		source: ResourceSource[TcpStream, TcpError] = Tcp.connections_stop_on_error(listener)
		continue_source: ResourceSource[TcpStream, TcpError] = Tcp.connections_continue_on_error(
			listener,
		)
		Ok(0)


func main(args: List[String]) -> Int:
	match connection_source_shape():
		Ok(value): value
		Err(_): 1
