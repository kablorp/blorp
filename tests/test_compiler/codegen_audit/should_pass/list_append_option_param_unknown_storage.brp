-- Appending stack-represented values through a List parameter must emit valid C
-- even when the parameter's runtime storage layout is not statically proven.
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C: blorp_List* push_option(blorp_List* xs, long x)
-- EXPECT-C: blorp_list_ensure_capacity
-- EXPECT-C: ->storage_mode == BLORP_LIST_STORAGE_INLINE
-- EXPECT-C: blorp_box_struct(&__list_elem
import:
	list: List, append
	option: Option(Some, None)


func push_option(xs: List[Option[Int]], x: Int) -> List[Option[Int]]:
	append(xs, Some(x))


func main(args: List[String]) -> Int:
	xs: List[Option[Int]] = [Some(1)]
	ys: List[Option[Int]] = push_option(xs, 2)
	ys.length()
