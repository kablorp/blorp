-- EXPECT-C: static blorp_StackResult STATIC_ERR_RESULT = { .tag = 1, .release_mask = 1UL, .data.Err.field0 = (void*)(blorp_String*)&__blorp_static_string_STATIC_ERR_RESULT_Err_0 };
import:
	result: Result(Ok, Err)


record Payload {
	value: Int,
	label: String
}


STATIC_RESULT: Result[Payload, String] = Ok({
	value = 42,
	label = "answer",
})

STATIC_INT_RESULT: Result[Int, String] = Ok(7)

STATIC_ERR_RESULT: Result[Int, String] = Err("nope")


func main(args: List[String]) -> Int:
	match STATIC_RESULT:
		Ok(payload):
			if payload.value == 42 and STATIC_INT_RESULT.get_or(0) == 7:
				0
			else:
				1
		Err(_):
			1
