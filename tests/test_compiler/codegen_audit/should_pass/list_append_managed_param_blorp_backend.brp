-- Appending managed pointer elements through a List parameter should stay on
-- the production final backend.
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C: blorp_List* push_string(blorp_List* xs, blorp_String* x)
-- EXPECT-C: blorp_list_retain_for((blorp_List*)
-- EXPECT-C: blorp_list_set_raw((blorp_List*)
import:
	list: List, append


func push_string(xs: List[String], x: String) -> List[String]:
	append(xs, x)


func main(args: List[String]) -> Int:
	xs: List[String] = ["a"]
	ys: List[String] = push_string(xs, "b")
	ys.length()
