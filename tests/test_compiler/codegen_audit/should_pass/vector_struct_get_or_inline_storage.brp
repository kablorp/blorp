-- Direct get_or paths over value-record tensors must check vector inline
-- storage, not list inline storage, before copying the payload by value.
-- EXPECT-C: ->storage_mode == BLORP_VECTOR_STORAGE_INLINE &&
-- EXPECT-C: memcpy(&__tgu_out_
-- EXPECT-NOT-C: __gso_payload_
import:
	tensor: get_or


struct Point {x: Int, y: Int}


func read_vector(v: Point[#3]) -> Point:
	v.get_or(1, {x = 0, y = 0})


func main(args: List[String]) -> Int:
	v: Point[#3] = {{x = 1, y = 10}, {x = 2, y = 20}, {x = 3, y = 30}}
	p: Point = read_vector(v)
	if p.x == 2 and p.y == 20:
		0
	else:
		1
