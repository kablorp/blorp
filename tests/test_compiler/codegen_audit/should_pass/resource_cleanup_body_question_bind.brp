-- EXPECT-C: blorp_file_close_reader(reader); __resource_result_
import:
	file: IOError(NotFound), open_read


func fail_int(path: String) -> Result[Int, IOError]:
	Err(NotFound(path))


func open_then_fail(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		value ?= fail_int(path)
		Ok(value)
