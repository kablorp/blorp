-- concurrent(max_threads: N) for should not initialize the process-wide
-- carrier pool to N. This prevents an early narrow concurrent-for operation
-- from capping later List.parallel work.
-- EXPECT-NOT-C: blorp_thread_pool_init(2);
func work(x: Int) -> Int:
	x + 1


func main(args: List[String]) -> Int:
	results: List[Result[Int, ConcurrencyError]] = concurrent(max_threads: 2)  for i in [
		1,
		2,
		3,
		4,
	]:
		work(i)
	results.length()
