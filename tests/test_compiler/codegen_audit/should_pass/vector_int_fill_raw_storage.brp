-- Regression: Int vector/matrix fill constructors should use typed raw i64
-- storage, not erased pointer-slot storage with boxed values.
-- EXPECT-C: blorp_vector_new_fill_i64
-- EXPECT-C: blorp_matrix_new_fill_i64
-- EXPECT-NOT-C: blorp_vector_new_fill((void*)
-- EXPECT-NOT-C: blorp_matrix_new_fill((void*)
import:
	tensor: matrix, vector


func main(args: List[String]) -> Int:
	v: Int[#4] = vector(7, 4)
	m: Int[#2, #3] = matrix(5, 2, 3)
	v[0] + v[3] + m[0, 0] + m[1, 2]
