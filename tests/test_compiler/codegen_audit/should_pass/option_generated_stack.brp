-- Generated-C shape audit for generated stack Option payload layouts.
-- EXPECT-C: typedef struct { int tag; __int128 value; } blorp_StackOption_Int128;
-- EXPECT-C: typedef struct { int tag; unsigned __int128 value; } blorp_StackOption_UInt128;
-- EXPECT-C: typedef struct { int tag; long value; } blorp_StackOption_Range;
-- EXPECT-C: typedef struct { int tag; StackAuditPoint value; } blorp_StackOption_StackAuditPoint;
-- EXPECT-C: typedef struct { int tag; long value; } blorp_StackOption_StackAuditColor;
