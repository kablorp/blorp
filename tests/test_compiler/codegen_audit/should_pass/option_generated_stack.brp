-- EXPECT-C: blorp_StackOption_Range bounded =
-- EXPECT-C: blorp_StackOption_StackAuditPoint point =
-- EXPECT-C: .tag == TAG_Option_Some
-- EXPECT-C: StackAuditPoint p = __scrut
-- EXPECT-NOT-C: Option* wide =
-- EXPECT-NOT-C: Some(blorp_box_int128
struct StackAuditPoint {x: Int, y: Int}


enum StackAuditColor:
	StackAuditRed
	StackAuditBlue


func choose_wide(flag: Bool) -> Option[Int128]:
	x: Int128 = 123
	if flag:
		Some(x)
	else:
		None


func choose_unsigned(flag: Bool) -> Option[UInt128]:
	x: UInt128 = 123
	if flag:
		Some(x)
	else:
		None


func choose_range(idx: ..#10) -> Option[..#10]:
	Some(idx)


func choose_point(flag: Bool) -> Option[StackAuditPoint]:
	if flag:
		Some({x = 1, y = 2})
	else:
		None


func choose_color(flag: Bool) -> Option[StackAuditColor]:
	if flag:
		Some(StackAuditBlue)
	else:
		None


func main(args: List[String]) -> Int:
	wide: Option[Int128] = choose_wide(True)
	unsigned: Option[UInt128] = choose_unsigned(True)
	bounded: Option[..#10] = choose_range(3)
	point: Option[StackAuditPoint] = choose_point(True)
	color: Option[StackAuditColor] = choose_color(True)
	wide_ok: Bool = match wide:
		Some(v): v == to_int128(123)
		None: False
	unsigned_ok: Bool = match unsigned:
		Some(v): v == to_uint128(123)
		None: False
	range_ok: Bool = match bounded:
		Some(v): v == 3
		None: False
	point_ok: Bool = match point:
		Some(p): p.x == 1 and p.y == 2
		None: False
	color_ok: Bool = match color:
		Some(c): c == StackAuditBlue
		None: False
	if wide_ok and unsigned_ok and range_ok and point_ok and color_ok:
		0
	else:
		1
