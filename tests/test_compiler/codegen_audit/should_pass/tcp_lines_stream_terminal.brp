-- TCP line streams should use the shared fallible-stream terminal ABI with a
-- TCP error domain instead of protocol-specific terminal builtins.
-- EXPECT-C: blorp_tcp_lines_raw(stream)
-- EXPECT-C: blorp_fallible_stream_collect_raw(
-- EXPECT-C: BLORP_FALLIBLE_STREAM_ERROR_DOMAIN_TCP
-- EXPECT-C: std_net_tcp__TcpError*
import:
	net/tcp: IpFamily(IPv4), TcpError, connect_loopback, lines, port
	stream: collect_result


func collect_lines() -> Result[Int, TcpError]:
	remote ?= port(1)
	with stream ?= connect_loopback(IPv4, remote):
		items ?= lines(stream).collect_result()
		Ok(items.length())


func main(args: List[String]) -> Int:
	match collect_lines():
		Ok(n): n
		Err(_): 0
