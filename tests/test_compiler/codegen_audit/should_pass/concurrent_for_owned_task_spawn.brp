-- concurrent for creates a fresh task closure per item. Codegen should
-- transfer that closure directly to the task instead of spawning with a
-- retaining API and immediately releasing the caller's reference.
-- EXPECT-C: blorp_task_spawn_owned_in_batch(&__conc_batch_
-- EXPECT-NOT-C: blorp_task_spawn(__conc_fn_
-- EXPECT-NOT-C: blorp_task_spawn_owned(__conc_fn_
-- EXPECT-NOT-C: if (__conc_fn_
import:
	list: range


func main(args: List[String]) -> Int:
	results: List[Result[Int, ConcurrencyError]] = concurrent for i in range(0, 4):
		i + 1
	var total: Int = 0
	for result in results:
		match result:
			Ok(value): total += value
			Err(_): total -= 100
	total
