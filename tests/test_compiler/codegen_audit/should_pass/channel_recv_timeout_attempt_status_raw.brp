-- Typed timed receive attempts must use one runtime channel observation.
-- EXPECT-C: blorp_channel_recv_timeout_status_raw((blorp_Channel*)ch, ms, &__chan_recv_value_
-- EXPECT-C: == BLORP_CHANNEL_RECV_VALUE) {
-- EXPECT-C: == BLORP_CHANNEL_RECV_SEALED) {
-- EXPECT-C: RecvTimedOut
-- EXPECT-NOT-C: blorp_channel_is_sealed_and_drained
import:
	channel: RecvAttempt(RecvSealed, RecvTimedOut, RecvValue), recv_timeout_attempt


func score(attempt: RecvAttempt[Int]) -> Int:
	match attempt:
		RecvValue(value): value
		RecvTimedOut: 2
		RecvSealed: 3
		_: 4


func main(args: List[String]) -> Int:
	ch: Channel[Int] = channel(1)
	score(recv_timeout_attempt(ch, 1))
