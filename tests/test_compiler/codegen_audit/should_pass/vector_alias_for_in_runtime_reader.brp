-- Aliased vector element types still use the layout-safe runtime reader at
-- function parameter boundaries. The emitter must not need local alias/type
-- heuristics to make this decision.
-- EXPECT-C: blorp_vector_read_i64(__iter_
-- EXPECT-NOT-C: long* __iter_raw_
type alias Count = Int


func sum_alias_for_in(v: Count[#4]) -> Count:
	var total: Count = 0
	for x in v:
		total += x
	total


func main(args: List[String]) -> Int:
	if sum_alias_for_in({1, 2, 3, 4}) == 10:
		0
	else:
		1
