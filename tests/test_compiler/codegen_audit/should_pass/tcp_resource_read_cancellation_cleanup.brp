-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_marker, &marker, (void*)marker, blorp_cleanup_release_arc_only_value);
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_listener, &listener, (void*)listener, (blorp_CancelCleanupFn)blorp_tcp_close_listener);
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_client, &client, (void*)client, (blorp_CancelCleanupFn)blorp_tcp_close_stream);
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_peer, &peer, (void*)peer, (blorp_CancelCleanupFn)blorp_tcp_close_stream);
-- EXPECT-C: blorp_tcp_read_raw(stream, max_bytes)
-- Semantic callable expectation: std_net_tcp__read_chunk(peer, 64)
-- EXPECT-C: bh_PdFfnjsfCC(peer, 64)
-- EXPECT-C: blorp_task_cleanup_pop_slot(&peer);
-- EXPECT-C: (void)(blorp_tcp_close_stream(peer));
import:
	net/tcp:
		IpFamily(IPv4),
		TcpError,
		accept,
		connect_loopback,
		listen_loopback_any_port,
		local_port,
		port,
		read_chunk,


func probe() -> Result[Int, TcpError]:
	marker: String = "tcp-" + "read"

	with listener ?= listen_loopback_any_port(IPv4, 1):
		port_num ?= local_port(listener)
		remote ?= port(port_num)

		with client ?= connect_loopback(IPv4, remote):
			with peer ?= accept(listener):
				data ?= read_chunk(peer, 64)

				if marker == "tcp-read":
					Ok(data.length())
				else:
					Ok(-1)


func main(args: List[String]) -> Int:
	match probe():
		Ok(value):
			value
		Err(_):
			1
