-- Regression: for-in over vector parameters must not use direct raw storage
-- from static type alone. Function parameters are unproven storage boundaries,
-- so they should use the layout-safe runtime reader. Compiler-owned producers
-- with explicit storage provenance are covered by
-- vector_known_for_in_direct_storage.brp.
-- EXPECT-NOT-C: ->storage_mode == BLORP_VECTOR_STORAGE_I64 &&
-- EXPECT-NOT-C: ->elem_size == (int16_t)sizeof(long)
-- EXPECT-NOT-C: long* __iter_raw_
-- EXPECT-NOT-C: __iter_raw_
-- EXPECT-C: blorp_vector_read_i64(__iter_
-- EXPECT-NOT-C: ->storage_mode == BLORP_VECTOR_STORAGE_F64 &&
-- EXPECT-NOT-C: ->elem_size == (int16_t)sizeof(double)
-- EXPECT-NOT-C: double* __iter_raw_
-- EXPECT-C: blorp_vector_read_f64(__iter_
-- EXPECT-NOT-C: ->storage_mode == BLORP_VECTOR_STORAGE_F32 &&
-- EXPECT-NOT-C: ->elem_size == (int16_t)sizeof(float)
-- EXPECT-NOT-C: float* __iter_raw_
-- EXPECT-C: blorp_vector_read_f32(__iter_
import:
	float: to_float32


func sum_for_in(v: Int[#4]) -> Int:
	var total: Int = 0
	for x in v:
		total += x
	total


func sum_float_for_in(v: Float[#4]) -> Float:
	var total: Float = 0.0
	for x in v:
		total += x
	total


func sum_float32_for_in(v: Float32[#4]) -> Float32:
	var total: Float32 = to_float32(0.0)
	for x in v:
		total += x
	total


func main(args: List[String]) -> Int:
	if sum_for_in({1, 2, 3, 4}) == 10 and sum_float_for_in({1.0, 2.0, 3.0, 4.0}) == 10.0:
		if sum_float32_for_in({
			to_float32(1.0),
			to_float32(2.0),
			to_float32(3.0),
			to_float32(4.0)
		}) == to_float32(10.0):
			0
		else:
			1
	else:
		1
