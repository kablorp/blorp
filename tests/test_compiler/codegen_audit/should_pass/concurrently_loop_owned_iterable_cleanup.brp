-- EXPECT-C: blorp_CancelCleanupFrame __blorp_owned_cleanup_
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_owned_cleanup_
-- EXPECT-C: &__conc_list_
-- EXPECT-C: blorp_task_cleanup_pop_slot(&__conc_list_
-- EXPECT-C: blorp_release(__conc_list_
import:
	list: range


func make_items() -> List[Int]:
	range(0, 3)


func main(args: List[String]) -> Int:
	for item in make_items() concurrently(limit: 2):
		_ = item + 1
	0
