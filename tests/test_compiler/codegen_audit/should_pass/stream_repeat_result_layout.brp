-- EXPECT-C: blorp_stream_repeat(value, 1L)
-- EXPECT-C: blorp_stream_repeat(((void*)1L), 0L)

import:
	stream: collect, count, repeat, take


func main(args: List[String]) -> Int:
	value: String = "h" + "a"
	items: List[String] = repeat(value).take(3).collect()
	ones: Int = repeat(1).take(3).count()
	if items.length() == 3 and ones == 3:
		0
	else:
		1
