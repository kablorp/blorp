-- Vector parallel maps returning value structs should pass result-layout
-- metadata so the runtime can store callback results inline instead of keeping
-- boxed struct pointers in the result tensor.
-- EXPECT-C: blorp_vmap_indexed_parallel(
-- EXPECT-C: BLORP_VECTOR_STORAGE_INLINE, sizeof(Accel), BLORP_VECTOR_CALLBACK_BOXED_STRUCT
import:
	tensor: get_or
	vector: map_indexed_parallel


struct Accel {x: Float, y: Float, z: Float}


ZERO_ACCEL: Accel = {x = 0.0, y = 0.0, z = 0.0}


func main(args: List[String]) -> Int:
	values: Float[#4] = vector(1.0, 4)
	accel: Accel[#4] = map_indexed_parallel(
		values,
		pure func(i: Int, value: Float): {x = value + to_float(i), y = value, z = 0.0},
	)
	sample: Accel = get_or(accel, 2, ZERO_ACCEL)
	if sample.x > 2.9:
		0
	else:
		1
