-- Immediate destructuring of a local tuple should scalar-replace the tuple
-- allocation and bind each field directly.
-- EXPECT-C: __blorp_internal_tuple_sroa_
-- EXPECT-NOT-C: blorp_tuple_new(2, (void*)(long)(13L), (void*)(long)(29L))
func main(args: List[String]) -> Int:
	pair: (Int, Int) = (13, 29)
	(a, b) = pair

	if a + b == 42:
		0
	else:
		1
