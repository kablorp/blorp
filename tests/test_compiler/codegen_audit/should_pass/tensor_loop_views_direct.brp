-- Regression: tensor loop-view producers in for-position must lower to direct
-- loops, not calls to materializing enumerate/windows helpers.
-- EXPECT-C: long x = __tensor_raw_view_
-- EXPECT-C: blorp_matrix_checked_get(__loop_enumerate2_source_
-- EXPECT-C: ((5 - 3) + 1)
-- EXPECT-C: blorp_Vector* __call_arg_6 = __loop_windows_source_
-- EXPECT-C: blorp_checked_slice(__call_arg_6, __call_arg_7, __call_arg_8);
-- EXPECT-C: total = (total + __tensor_raw_view_v_
-- Semantic callable expectation: std_tensor__enumerate
-- EXPECT-NOT-C: bh_F0B00dZTCu
-- Semantic callable expectation: std_tensor__enumerate2
-- EXPECT-NOT-C: bh_VKqskBhcG8
-- Semantic callable expectation: std_tensor__windows
-- EXPECT-NOT-C: bh_ct7W5c81WF
-- Semantic callable expectation: std_tensor__indices
-- EXPECT-NOT-C: bh_8LcyHU6Ohj
-- EXPECT-NOT-C: __loop_tuple_
import:
	tensor: enumerate, enumerate2, indices, windows


func main(args: List[String]) -> Int:
	v: Int[#5] = {1, 2, 3, 4, 5}
	var total: Int = 0

	for (i, x) in enumerate(v):
		total += i + x

	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}

	for (i, j, x) in enumerate2(m):
		total += i + j + x

	for w in windows(v, 3):
		total += w[0] + w[1] + w[2]

	for i in indices(v):
		total += v[i]

	total
