-- Regression: tensor loop-view producers in for-position must lower to direct
-- loops, not calls to materializing enumerate/windows helpers.
--
-- EXPECT-C: long x = __tensor_raw_view_v_
-- EXPECT-C: blorp_matrix_checked_get(m, __i, __j)
-- EXPECT-C: ((5L - 3L) + 1L)
-- EXPECT-C: blorp_checked_slice(v, __idx, (__idx + 3L))
-- EXPECT-C: total = (total + __tensor_raw_view_v_
-- EXPECT-NOT-C: std_tensor__enumerate
-- EXPECT-NOT-C: std_tensor__enumerate2
-- EXPECT-NOT-C: std_tensor__windows
-- EXPECT-NOT-C: std_tensor__indices
-- EXPECT-NOT-C: __loop_tuple_
import:
	tensor: enumerate, enumerate2, indices, windows


func main(args: List[String]) -> Int:
	v: Int[#5] = {1, 2, 3, 4, 5}
	var total: Int = 0
	for (i, x) in enumerate(v):
		total += i + x
	m: Int[#2, #3] = {
		{1, 2, 3},
		{4, 5, 6},
	}
	for (i, j, x) in enumerate2(m):
		total += i + j + x
	for w in windows(v, 3):
		total += w[0] + w[1] + w[2]
	for i in indices(v):
		total += v[i]
	total
