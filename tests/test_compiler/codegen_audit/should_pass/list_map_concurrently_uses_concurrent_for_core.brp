-- List.map_concurrently should reuse the concurrent-for emitter so the
-- helper shares task batching, Result wrapping, and limit normalization.
-- EXPECT-C: blorp_concurrent_normalize_limit(
-- EXPECT-C: blorp_task_spawn_owned_in_batch(&__conc_batch_
-- EXPECT-C: blorp_concurrent_join(__conc_tasks_
import:
	list: range


func work(n: Int) -> Int:
	n * 3


func main(args: List[String]) -> Int:
	items: List[Int] = range(0, 4)
	results: List[Result[Int, ConcurrencyError]] = items.map_concurrently(2, func(n: Int): work(n))
	var total: Int = 0
	for result in results:
		match result:
			Ok(value): total += value
			Err(_): total -= 100
	total
