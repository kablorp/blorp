-- Semantic callable expectation: Hashable_hash_Widget
-- EXPECT-C-REGEX: static long brp_[0-9A-Za-z]+\(Widget\* self\)
-- Semantic callable expectation: Equatable_equals_Widget
-- EXPECT-C-REGEX: static int brp_[0-9A-Za-z]+\(Widget\* a, Widget\* b\)
-- Semantic callable expectation: Equatable_not_equals_Widget
-- EXPECT-NOT-C: 918273647L
import:
	dict: Dict, contains, dict, set
	traits: Equatable, Hashable


record Widget {
	id: Int
}


implements Equatable for Widget:
	pure func equals(a: Widget, b: Widget) -> Bool:
		a.id == b.id

	pure func not_equals(a: Widget, b: Widget) -> Bool:
		if a.id == 918273647:
			True
		else:
			a.id != b.id


implements Hashable for Widget:
	pure func hash(self: Widget) -> Int:
		self.id


func main(args: List[String]) -> Int:
	var d: Dict[Widget, Int] = dict()
	d = d.set({id = 1}, 10)
	if d.contains({id = 1}):
		0
	else:
		1
