-- TLS write borrows its Bytes payload while it may park. The caller must still
-- release the local owner after the call result is handled, and cancellation
-- while parked must release the live payload through task cleanup.
-- EXPECT-C: blorp_CancelCleanupFrame __blorp_cleanup_payload;
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_payload, &payload, (void*)payload, blorp_cleanup_release_arc_only_value);
-- EXPECT-C: std_net_tls__write(session, payload)
-- EXPECT-C: blorp_task_cleanup_pop_slot(&payload);
-- EXPECT-C: blorp_release_arc_only(payload);
import:
	bytes as B
	net/tcp as TCP
	net/tls as TLS: TlsError


func write_payload() -> Result[Int, TlsError]:
	with stream ?= TCP.connect("127.0.0.1", 1) on err => TLS.Transport(TCP.message(err)):
		with session ?= TLS.connect(stream, "localhost"):
			payload: Bytes = B.bytes(0)
			match TLS.write(session, payload):
				Ok(_): Ok(0)
				Err(_): Ok(1)


func main(args: List[String]) -> Int:
	match write_payload():
		Ok(value): value
		Err(_): 0
