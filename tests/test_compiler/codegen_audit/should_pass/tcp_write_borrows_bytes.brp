-- write borrows its Bytes argument. The caller must still release the
-- local owner after the call result is handled, and cancellation while write
-- is parked must release the live owned payload through task cleanup.
-- EXPECT-C: blorp_CancelCleanupFrame __blorp_cleanup_payload;
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_payload, &payload, (void*)payload, blorp_cleanup_release_arc_only_value);
-- EXPECT-C: blorp_tcp_write_raw(stream, payload)
-- EXPECT-C: blorp_task_cleanup_pop_slot(&payload);
-- EXPECT-C: blorp_release_arc_only(payload);
import:
	bytes as B
	net/tcp: IpFamily(IPv4), TcpError, connect_loopback, port, write


func write_payload() -> Result[Int, TcpError]:
	remote ?= port(1)
	with stream ?= connect_loopback(IPv4, remote):
		payload: Bytes = B.bytes(0)
		match write(stream, payload):
			Ok(_): Ok(0)
			Err(_): Ok(1)


func main(args: List[String]) -> Int:
	match write_payload():
		Ok(value): value
		Err(_): 0
