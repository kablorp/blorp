-- Tcp.write borrows its Bytes argument. The caller must still release the
-- local owner after the call result is handled.
-- EXPECT-C: blorp_tcp_write(stream, payload)
-- EXPECT-C: blorp_release_arc_only(payload);
import:
	bytes as B
	net/tcp as Tcp


func write_payload(stream: Tcp.TcpStream) -> Int:
	payload: Bytes = B.bytes(0)
	match Tcp.write(stream, payload):
		Ok(_): 0
		Err(_): 1


func main(args: List[String]) -> Int:
	match Tcp.connect("127.0.0.1", 1):
		Ok(stream): write_payload(stream)
		Err(_): 0
