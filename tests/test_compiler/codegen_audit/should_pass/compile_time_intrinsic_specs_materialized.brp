-- The compiler-blorp intrinsic renderer derives lookup and manifest-line data
-- from IntrinsicSpec values at compile time. The spec builders must not
-- survive as runtime helper functions in generated C.
-- EXPECT-C: ____________compiler_blorp_codegen_intrinsic_renderer__parse_intrinsic(blorp_String*
-- EXPECT-C: ____________compiler_blorp_codegen_intrinsic_renderer__render_manifest_lines(void)
-- EXPECT-C: ____________compiler_blorp_codegen_intrinsic_renderer__INTRINSIC_MANIFEST_LINES
-- EXPECT-NOT-C: all_intrinsic_specs
-- EXPECT-NOT-C: specs_from_intrinsics
-- EXPECT-NOT-C: intrinsics_from_specs
-- EXPECT-NOT-C: specs_to_intrinsic_dict
-- EXPECT-NOT-C: manifest_lines_from_specs
-- EXPECT-NOT-C: intrinsic_spec(
-- EXPECT-NOT-C: render_manifest_line(
import:
	../../../../compiler/blorp/codegen_intrinsic_renderer:
		intrinsic_arity,
		intrinsic_name,
		parse_intrinsic,
		render_manifest_lines,


func main(args: List[String]) -> Int:
	lines: List[String] = render_manifest_lines()

	first_line_score: Int = match lines:
		[first, ...rest]: first.length()
		[]: 0

	parsed_score: Int = match parse_intrinsic("math_sqrt"):
		Some(intrinsic): intrinsic_name(intrinsic).length() + intrinsic_arity(intrinsic)
		None: 0

	first_line_score + parsed_score
