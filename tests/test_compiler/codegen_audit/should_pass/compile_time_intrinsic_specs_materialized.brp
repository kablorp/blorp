-- The compiler-blorp intrinsic renderer derives lookup and public intrinsic
-- data from IntrinsicSpec values at compile time. The spec builders must not
-- survive as runtime helper functions in generated C.
-- Semantic callable expectation: compiler_blorp_src_stage_10_backend_intrinsic_renderer__parse_intrinsic(blorp_String*
-- EXPECT-C: bh_MVFryKkmEa(blorp_String*
-- EXPECT-C: compiler_blorp_src_stage_10_backend_intrinsic_renderer__ALL_INTRINSICS
-- Semantic callable expectation: all_intrinsic_specs
-- EXPECT-NOT-C: bh_Rp8K1Bhw65
-- Semantic callable expectation: specs_from_intrinsics
-- EXPECT-NOT-C: bh_Un4eW9fpUH
-- Semantic callable expectation: intrinsics_from_specs
-- EXPECT-NOT-C: bh_QTydfqFWv1
-- Semantic callable expectation: specs_to_intrinsic_dict
-- EXPECT-NOT-C: bh_iDG5se6aJW
-- Semantic callable expectation: specs_to_no_arg_name_dict
-- EXPECT-NOT-C: bh_KlYra8H1n1
-- Semantic callable expectation: specs_to_one_arg_name_dict
-- EXPECT-NOT-C: bh_FY5nDFRKqY
-- Semantic callable expectation: specs_to_two_arg_name_dict
-- EXPECT-NOT-C: bh_G9xoVq4b8u
-- Semantic callable expectation: specs_to_three_arg_name_dict
-- EXPECT-NOT-C: bh_YufEMtdwck
-- Semantic callable expectation: same_intrinsic
-- EXPECT-NOT-C: bh_kZZcMuIjsl
-- Semantic callable expectation: intrinsic_name_from_specs
-- EXPECT-NOT-C: bh_IAC9hoFO0W
-- EXPECT-NOT-C: INTRINSIC_SPECS
-- Semantic callable expectation: intrinsic_spec(
-- EXPECT-NOT-C: bh_tX7fNQSHeE(
import:
	../../../../compiler/blorp/src/stage_10_backend/intrinsic_renderer:
		ALL_INTRINSICS,
		intrinsic_arity,
		intrinsic_name,
		parse_intrinsic,


func main(args: List[String]) -> Int:
	parsed_score: Int = match parse_intrinsic("math_sqrt"):
		Some(intrinsic):
			intrinsic_name(intrinsic).length() + intrinsic_arity(intrinsic)
		None:
			0

	ALL_INTRINSICS.length() + parsed_score
