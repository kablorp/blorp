-- Resource-source loops should acquire one stream at a time, register it for
-- cancellation cleanup, and run the same cleanup before loop-local break.
-- EXPECT-C: blorp_resource_source_next_raw(
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_conn, &conn, (void*)conn, (blorp_CancelCleanupFn)blorp_tcp_close_stream);
-- EXPECT-C: blorp_task_cleanup_pop_slot(&conn);
-- EXPECT-C: (void)(blorp_tcp_close_stream(conn));
import:
	net/tcp as Tcp: IpFamily(IPv4), TcpError


func loop_connections_once() -> Result[Int, TcpError]:
	with listener ?= Tcp.listen_loopback_any_port(IPv4, 1):
		var seen: Int = 0
		for conn in Tcp.connections_stop_on_error(listener):
			_ = Tcp.stream_local_port(conn)
			seen += 1
			break
		Ok(seen)


func main(args: List[String]) -> Int:
	match loop_connections_once():
		Ok(value): value
		Err(_): 1
