-- Channel seal should lower to the seal-named runtime entry point.
-- `close` remains a compatibility alias, but new generated code should not
-- route primary seal calls through the close-named ABI.
-- EXPECT-C: blorp_channel_seal(ch);
-- EXPECT-NOT-C: blorp_channel_close(ch);

func main(args: List[String]) -> Int:
	ch: Channel[Int] = channel(1)
	seal(ch)
	0
