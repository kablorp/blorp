-- WebSocket receive returns a stack Result whose Ok payload is an owned
-- Message. Matching it inside a resource scope must register cleanup before
-- user code can run, so cancellation cannot skip releasing a received message.
-- EXPECT-C: blorp_WebSocketMessageResult __websocket_op_
-- EXPECT-C: blorp_websocket_receive_raw(session)
-- EXPECT-C: switch (__websocket_op_
-- EXPECT-C: BLORP_WEBSOCKET_MESSAGE_TEXT
-- EXPECT-C: BLORP_WEBSOCKET_MESSAGE_BINARY
-- EXPECT-C: BLORP_WEBSOCKET_MESSAGE_CLOSE
-- EXPECT-C: blorp_cleanup_stack_result_value
-- EXPECT-C: blorp_stack_result_release(__match_scrut_
import:
	net/websocket as WS: WebSocketError


func read_once() -> Result[Int, WebSocketError]:
	with session ?= WS.connect("ws://example.com/socket"):
		match WS.receive(session):
			Ok(_):
				Ok(0)
			Err(_):
				Ok(1)


func main(args: List[String]) -> Int:
	match read_once():
		Ok(value):
			value
		Err(_):
			0
