-- Generated-C shape audit for Stream.unfold result and state layout metadata.
-- EXPECT-C: void* __call_arg_0 = (void*)(long)(0);
-- EXPECT-C: long __call_arg_2 = 2;
-- EXPECT-C: long __call_arg_3 = 0;
-- EXPECT-C: blorp_stream_unfold(__call_arg_0, __call_arg_1, __call_arg_2, __call_arg_3);
-- EXPECT-C: blorp_String* __call_arg_5 = seed;
-- EXPECT-C: long __call_arg_7 = 2;
-- EXPECT-C: long __call_arg_8 = 2;
-- EXPECT-C: blorp_stream_unfold(__call_arg_5, __call_arg_6, __call_arg_7, __call_arg_8);
import:
	option: Option(Some, None)
	stream: collect, unfold


func unfold_string_step(n: Int) -> Option[(String, Int)]:
	if n < 2:
		Some((n.to_string(), n + 1))
	else:
		None


func unfold_string_state_step(state: String) -> Option[(String, String)]:
	if state.length() < 3:
		Some((state, state + "a"))
	else:
		None


func main(args: List[String]) -> Int:
	scalar_state_items: List[String] = collect(unfold(0, unfold_string_step))
	seed: String = "a" + ""
	managed_state_items: List[String] = collect(unfold(seed, unfold_string_state_step))
	scalar_state_items.length() + managed_state_items.length()
