-- EXPECT-NOT-C: compile_time_dict_builder
import:
	dict as D
	result: Result(Ok, Err)


private pure func compile_time_dict_builder() -> Dict[String, Int]:
	D
		.from_list([("alpha", 1), ("beta", 2)])
		.set("answer", 42)


compile_time:
	LOOKUP: Dict[String, Int] = compile_time_dict_builder()
	MAYBE_ANSWER: Option[Int] = LOOKUP.get("answer")
	MISSING_ANSWER: Option[Int] = LOOKUP.get("missing")
	ANSWER: Int = match MAYBE_ANSWER:
		Some(value): value
		None: 0
	MISSING_DEFAULT: Int = match MISSING_ANSWER:
		Some(value): value
		None: 7
	RESULT_ANSWER: Result[Int, String] = MAYBE_ANSWER.to_result("missing")
	RESULT_MISSING: Result[Int, String] = MISSING_ANSWER.to_result("missing")
	RESULT_ANSWER_OR: Int = RESULT_ANSWER.get_or(0)
	RESULT_MISSING_OR: Int = RESULT_MISSING.get_or(9)
	RESULT_ANSWER_OK: Bool = RESULT_ANSWER.is_ok()
	RESULT_MISSING_ERR: Bool = RESULT_MISSING.is_err()


func main(args: List[String]) -> Int:
	ANSWER + MISSING_DEFAULT + RESULT_ANSWER_OR + RESULT_MISSING_OR
