-- Escaping string/list producer results must still materialize even after
-- producer-consumer fusion learns to optimize direct length-only consumers.
-- EXPECT-C: __replace_out_len
-- EXPECT-C: blorp_string_alloc(__replace_out_len)
-- EXPECT-C: __split_part_count
-- EXPECT-C: blorp_list_new(__split_part_count)
import:
	list as L
	string: contains, replace, reverse, split, trim


func escaped_replace(s: String) -> Int:
	result: String = s.replace("red", "green")
	if result.contains("green"):
		result.length()
	else:
		0


func escaped_split(s: String) -> Int:
	parts: List[String] = s.split(",")
	L.length(parts)


func escaped_reverse(s: String) -> Int:
	result: String = s.reverse()
	if result.contains("a"):
		result.length()
	else:
		0


func escaped_trim(s: String) -> Int:
	result: String = s.trim()
	if result.contains("hello"):
		result.length()
	else:
		0


func main(args: List[String]) -> Int:
	total: Int = escaped_replace(
		"red blue red",
	) + escaped_split("a,b,c") + escaped_reverse("abc") + escaped_trim("   hello   ")
	if total == 27:
		0
	else:
		1
