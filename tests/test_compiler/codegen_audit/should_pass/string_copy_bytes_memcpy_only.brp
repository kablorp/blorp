-- String byte-range copies should lower to memcpy for every positive length.
-- The string_copy_bytes intrinsic is for proven non-overlapping copies into
-- fresh string storage; it should not emit a per-byte fallback loop.
-- EXPECT-C: memcpy(__string_copy_dst_
-- EXPECT-NOT-C: __string_copy_i_
import:
	list as L
	string: replace, split


func main(args: List[String]) -> Int:
	replaced: String = "the cat and the dog".replace("the", "a")
	parts: List[String] = "alpha::beta::gamma".split("::")
	if replaced.length() == 15 and L.length(parts) == 3:
		0
	else:
		1
