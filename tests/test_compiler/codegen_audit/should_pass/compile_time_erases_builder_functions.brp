-- Generated-C audit for CTFE-only helper functions.
--
-- The builder helpers below are used only by constant evaluation. Their
-- names and sentinel branch constants must not survive in generated C after
-- the global constant initializer is materialized.
-- EXPECT-C: static long MATERIALIZED_SCORE = 42L;
-- EXPECT-NOT-C: ctfe_only_runtime_marker
-- EXPECT-NOT-C: ctfe_only_inner_runtime_marker
-- EXPECT-NOT-C: 777777777L
-- EXPECT-NOT-C: 888888888L
private pure func ctfe_only_inner_runtime_marker(value: Int) -> Int:
	if value < 0:
		777777777
	else:
		value + 1


private pure func ctfe_only_runtime_marker(value: Int) -> Int:
	shifted: Int = ctfe_only_inner_runtime_marker(value)

	if shifted < 0:
		888888888
	else:
		shifted * 2


MATERIALIZED_SCORE: Int = ctfe_only_runtime_marker(20)


func main(args: List[String]) -> Int:
	MATERIALIZED_SCORE
