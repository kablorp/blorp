-- Managed fields still need correct ownership when a non-escaping tuple is
-- scalar-replaced.
-- EXPECT-C: blorp_String* __tuple_sroa_
-- EXPECT-C: blorp_release(__tuple_sroa_
func main(args: List[String]) -> Int:
	pair: (String, Int) = ("hello", 5)
	if pair[0].length() == pair[1]:
		0
	else:
		1
