-- Empty Dict/Set construction should stay on the Blorp final-Core-to-C backend
-- for constructors the JSON handoff can represent directly.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C: return blorp_dict_new_string();
-- EXPECT-C: return blorp_set_new_string();
import:
	dict: Dict, dict
	set: Set, set


pure func empty_string_dict() -> Dict[String, Int]:
	dict()


pure func empty_string_set() -> Set[String]:
	set()


func main(args: List[String]) -> Int:
	d: Dict[String, Int] = empty_string_dict()
	s: Set[String] = empty_string_set()
	0
