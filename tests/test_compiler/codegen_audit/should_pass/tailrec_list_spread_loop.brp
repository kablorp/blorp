-- Generated-C shape audit for tail-recursive list-spread consumers.
--
-- The recursive [x, ...rest] shape should advance a cursor over the original
-- list instead of allocating a fresh tail list on each step.
--
-- EXPECT-C: while (1) {
-- EXPECT-C: __tailrec_list_index
-- EXPECT-C: memcpy(&__tailrec_bits_
-- EXPECT-C: continue;
-- EXPECT-NOT-C: blorp_list_get((blorp_List*)lst
-- EXPECT-NOT-C: blorp_list_drop((blorp_List*)
-- EXPECT-NOT-C: sum_recursive(rest
@tail_recursive
func sum_recursive(lst: List[Int], acc: Int) -> Int:
	match lst:
		[]: acc
		[x, ...rest]: sum_recursive(rest, acc + x)


func main(args: List[String]) -> Int:
	sum_recursive([1, 2, 3], 0)
