-- List.concurrent should reuse the for ... concurrently emitter so the preferred
-- method spelling shares task batching, Result wrapping, and limit normalization.
-- EXPECT-C: blorp_concurrent_normalize_limit(
-- EXPECT-C: blorp_thread_pool_ensure_initialized();
-- EXPECT-C: blorp_ConcurrentTaskWindow __conc_task_window_
-- EXPECT-C: blorp_concurrent_task_window_begin(&__conc_task_window_
-- EXPECT-C: blorp_concurrent_task_window_spawn_owned(&__conc_task_window_
-- EXPECT-C: BLORP_CONCURRENT_TASK_FLUSH_PERIODIC
-- EXPECT-C: blorp_concurrent_task_window_join_release(&__conc_task_window_
-- EXPECT-C: blorp_concurrent_task_window_end(&__conc_task_window_
-- EXPECT-NOT-C: blorp_TaskBatch __conc_batch_
-- EXPECT-NOT-C: blorp_task_batch_init(&__conc_batch_
-- EXPECT-NOT-C: blorp_task_batch_flush(&__conc_batch_
-- EXPECT-NOT-C: blorp_task_batch_flush_periodically(&__conc_batch_
-- EXPECT-NOT-C: blorp_task_spawn_owned_in_batch(&__conc_batch_
-- EXPECT-NOT-C: blorp_concurrent_spawn_owned_cleanup_in_batch(&__conc_batch_
-- EXPECT-NOT-C: blorp_Task** __conc_tasks_
-- EXPECT-NOT-C: blorp_CancelCleanupFrame* __conc_task_cleanups_
-- EXPECT-NOT-C: blorp_concurrent_task_window_init(&__conc_task_window_
-- EXPECT-NOT-C: blorp_concurrent_task_window_cleanup(&__conc_task_window_
-- EXPECT-NOT-C: .tasks[
-- EXPECT-NOT-C: .cleanups[
-- EXPECT-NOT-C: % BLORP_TASK_BATCH_FLUSH_INTERVAL
-- EXPECT-NOT-C: blorp_concurrent_join(__conc_tasks_
-- EXPECT-NOT-C: blorp_thread_pool_init((int)__conc_limit_
import:
	list: range


func work(n: Int) -> Int:
	n * 3


func main(args: List[String]) -> Int:
	items: List[Int] = range(0, 4)
	results: List[Result[Int, ConcurrencyError]] = items.concurrent(2, func(n: Int): work(n))
	var total: Int = 0
	for result in results:
		match result:
			Ok(value): total += value
			Err(_): total -= 100
	total
