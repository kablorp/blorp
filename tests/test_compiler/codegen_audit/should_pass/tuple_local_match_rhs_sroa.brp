-- A local tuple binding whose RHS is a match that returns tuples should
-- scalar-replace when every reachable leaf returns the same tuple shape.
-- The scrutinee is bound once, while each scalar element stays explicit.
-- EXPECT-C: __tuple_match_
-- EXPECT-C: __tuple_sroa_
-- EXPECT-C: mark(20L)
-- EXPECT-C: mark(22L)
-- EXPECT-NOT-C: blorp_tuple_new(2, (void*)(long)(
func mark(x: Int) -> Int:
	x


func main(args: List[String]) -> Int:
	key: Int = 1
	pair: (Int, Int) = match key:
		0: (mark(1), mark(2))
		_: (mark(20), mark(22))
	if pair.0 + pair.1 == 42:
		0
	else:
		1
