-- Generated-C shape audit for Stream[T] for-loop lowering.
-- EXPECT-C: blorp_Stream* __stream_iter_
-- EXPECT-C: blorp_stream_next_raw(__stream_iter_
-- EXPECT-C: blorp_stream_release_pulled_if_owned(__stream_iter_
import:
	stream as S


func main(args: List[String]) -> Int:
	var total: Int = 0
	for n in S.from_list([1, 2, 3]):
		total = total + n
	total
