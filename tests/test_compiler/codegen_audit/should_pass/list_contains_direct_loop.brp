-- List.contains should scan directly instead of allocating a predicate closure
-- and routing through the pure/impure any overloads.
-- Semantic callable expectation: int std_list__contains__mono_String(blorp_List* self, blorp_String* elem)
-- EXPECT-C: int bh_eov3Afs68r(blorp_List* self, blorp_String* elem)
-- Semantic callable expectation: std_list__any__mono_String
-- EXPECT-NOT-C: bh_kDN23BKJWk
import:
	list: List


func main(args: List[String]) -> Int:
	var sections: List[String] = []
	name: String = "section"

	if sections.contains(name):
		1
	else:
		sections = sections.append(name)
		sections.length() - 1
