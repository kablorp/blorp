-- A windowed final replace should lower to one final allocation without first
-- materializing the trim/take window.
-- EXPECT-C: __sp_replace_count_
-- EXPECT-C: __sp_replace_result_
-- EXPECT-C: __sp_replace_segment_start_
import:
	string: replace, take_left, trim


pure func fused_replace(s: String) -> String:
	s
		.trim()
		.take_left(5)
		.replace("a", "xy")


func main(args: List[String]) -> Int:
	if fused_replace("  abacad  ") == "xybxycxy":
		0
	else:
		1
