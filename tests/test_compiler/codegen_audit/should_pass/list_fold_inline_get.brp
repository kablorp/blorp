-- Generated-C shape audit for pure List[Int].fold_left.
--
-- The synthesized fold body should lower list_get into a direct inline scalar
-- load for monomorphized primitive lists.
--
-- EXPECT-C: memcpy(&__lg_
-- EXPECT-NOT-C: ->storage_mode == BLORP_LIST_STORAGE_INLINE
-- EXPECT-NOT-C: ->elem_size == 8
-- EXPECT-NOT-C: blorp_list_get(__lg_list_
import:
	list: List, fold_left


type alias Count = Int


pure func sum_local() -> Int:
	xs: List[Int] = [1, 2, 3]
	fold_left(xs, 0, func(acc: Int, x: Int): acc + x)


pure func sum_alias() -> Int:
	xs: List[Count] = [1, 2, 3]
	fold_left(xs, 0, func(acc: Int, x: Count): acc + x)


func main(args: List[String]) -> Int:
	sum_local() + sum_alias()
