-- Typed channel send attempts also box stack Result payloads before calling the
-- status runtime helper. The temporary box must be cleanup-protected across the
-- send attempt and released after the runtime either accepts or rejects it.
-- EXPECT-C: blorp_task_cleanup_push(&__chan_send_cleanup_
-- EXPECT-C: blorp_channel_try_send_status(ch, __chan_send_value_
-- EXPECT-C: blorp_channel_send_timeout_status(ch, __chan_send_value_
-- EXPECT-C: blorp_release(__chan_send_value_
-- EXPECT-C: blorp_box_stack_result(blorp_stack_result_retain_value(
import:
	channel:
		SendAttempt(SendAccepted, SendTimedOut, SendWouldBlock),
		send_timeout_attempt,
		try_send_attempt,


func score(attempt: SendAttempt) -> Int:
	match attempt:
		SendAccepted: 1
		SendWouldBlock: 2
		SendTimedOut: 3
		_: 4


func main(args: List[String]) -> Int:
	ch: Channel[Result[String, String]] = channel(1)
	first: Result[String, String] = Ok("first")
	second: Result[String, String] = Ok("second")
	third: Result[String, String] = Ok("third")
	a: SendAttempt = try_send_attempt(ch, first)
	b: SendAttempt = try_send_attempt(ch, second)
	c: SendAttempt = send_timeout_attempt(ch, third, 0)
	score(a) + score(b) + score(c)
