-- Generated-C shape audit for result-consuming float benchmarks.
--
-- A benchmark that returns Float must feed the callback result through
-- blorp_black_box_float so optimized C builds cannot erase numeric work
-- whose value is otherwise only used for timing.
--
-- EXPECT-C: blorp_black_box_float
-- EXPECT-C: checksum
import:
	../../../../benchmarks/blorp/support/benchmark: BenchmarkFloatResult, bench_float


func main(args: List[String]) -> Int:
	result: BenchmarkFloatResult = bench_float(10, func(i: Int) -> Float: to_float(i) + 0.25)
	if result.checksum > 0.0:
		0
	else:
		1
