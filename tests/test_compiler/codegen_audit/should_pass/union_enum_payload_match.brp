-- Enum payloads stored in erased union fields must not be emitted as heap
-- union pointers. The OCaml renderer-helper fallback casts these erased
-- fields through `long`; the normal renderer currently emits the equivalent
-- direct scalar comparison.
-- EXPECT-C: SymbolToken.field0
-- EXPECT-NOT-C: CompilerSymbol*
-- EXPECT-NOT-C: TAG_CompilerSymbol
enum CompilerSymbol:
	ColonSymbol
	CommaSymbol


union Token:
	SymbolToken(CompilerSymbol)
	End


pure func is_colon(token: Token) -> Bool:
	match token:
		SymbolToken(ColonSymbol):
			True
		_:
			False


func main(args: List[String]) -> Int:
	if is_colon(SymbolToken(ColonSymbol)):
		0
	else:
		1
