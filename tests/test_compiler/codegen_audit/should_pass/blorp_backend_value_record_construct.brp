-- Value-record construction should stay on the default Blorp final-Core-to-C
-- emitter with the matching declaration and field access path.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C: typedef struct { long x; long y; } Point;
-- EXPECT-C: static inline Point Point_make(long x, long y)
-- EXPECT-C: Point make_point(long x, long y)
-- EXPECT-C: return Point_make(x, y);
-- EXPECT-C: long point_sum(Point point)
-- EXPECT-C: return (point.x + point.y);
struct Point {
	x: Int,
	y: Int
}


pure func make_point(x: Int, y: Int) -> Point:
	{
		y = y,
		x = x
	}


pure func point_sum(point: Point) -> Int:
	point.x + point.y


func main(args: List[String]) -> Int:
	point: Point = make_point(20, 22)

	if point_sum(point) == 42:
		0
	else:
		1
