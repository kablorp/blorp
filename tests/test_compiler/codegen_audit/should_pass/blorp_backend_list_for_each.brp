-- List for-each loops should stay on the Blorp final-Core-to-C backend.
--
-- EXPECT-C: /* Blorp final Core C artifact */
-- Semantic callable expectation: long count_strings(blorp_List* xs)
-- EXPECT-C: long bh_mNwphjnf4V(blorp_List* xs)
-- EXPECT-C: blorp_List* __iter_
-- EXPECT-C: long __len_
-- EXPECT-C: for (long __i_
-- EXPECT-C: blorp_String* item = ((blorp_String*)blorp_list_get(
pure func count_strings(xs: List[String]) -> Int:
	var count: Int = 0

	for item in xs:
		count += 1

	count


func main(args: List[String]) -> Int:
	count_strings(["a", "b"])
