-- Regression: concrete Float32 vector reductions may use raw storage only after
-- checking both storage mode and element size, matching the runtime-safe reader
-- contract.
-- EXPECT-C: ->storage_mode == BLORP_VECTOR_STORAGE_F32 &&
-- EXPECT-C: ->elem_size == (int16_t)sizeof(float)
-- EXPECT-C: float* __tensor_raw = (float*)((blorp_Vector*)__tensor)->data
-- EXPECT-C: __tensor_raw[__i]
-- EXPECT-C: blorp_vector_read_f32((blorp_Vector*)__tensor, __i)
import:
	float: to_float32
	vector: sum


func main(args: List[String]) -> Int:
	arr: Float32[#4] = {to_float32(1.0), to_float32(2.0), to_float32(3.0), to_float32(4.0)}
	_ = sum(arr)
	0
