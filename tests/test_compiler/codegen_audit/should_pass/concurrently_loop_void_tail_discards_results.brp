-- A for ... concurrently(limit:) loop in Void tail position is statement
-- fan-out. It must not allocate a collected List[Result[...]] that no source
-- code can observe.
-- EXPECT-C: blorp_concurrent_task_window_spawn_owned
-- EXPECT-NOT-C: __conc_results_
import:
	list: range


func touch(n: Int) -> Void:
	sleep(0)
	_ = n


func main(args: List[String]) -> Void:
	for n in range(0, 4) concurrently(limit: 2):
		touch(n)
