-- Local tuples used only through field access should scalar-replace instead of
-- allocating a heap blorp_Tuple.
-- EXPECT-C: __blorp_internal_tuple_sroa_
-- EXPECT-NOT-C: blorp_tuple_new(2, (void*)(long)(20L), (void*)(long)(22L))
func main(args: List[String]) -> Int:
	pair: (Int, Int) = (20, 22)

	if pair[0] + pair[1] == 42:
		0
	else:
		1
