-- Regression: vector min/max specialization must resolve to declared runtime helpers.
-- EXPECT-C: blorp_vector_max_float(vf)
-- EXPECT-C: blorp_vector_min_float(vf)
-- EXPECT-C: blorp_vector_max_float32(v32)
-- EXPECT-C: blorp_vector_min_float32(v32)
import:
	float: to_float32
	vector: max, min


func main(args: List[String]):
	vf: Float[#3] = {1.5, 3.7, 2.1}
	v32: Float32[#3] = {to_float32(1.0), to_float32(5.0), to_float32(3.0)}
	_ = max(vf) == 3.7
	_ = min(vf) == 1.5
	_ = max(v32) == to_float32(5.0)
	_ = min(v32) == to_float32(1.0)
