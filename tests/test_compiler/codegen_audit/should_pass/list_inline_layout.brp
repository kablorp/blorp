-- EXPECT-C: return blorp_list_new_inline(123458L, 8);
-- EXPECT-C: return blorp_list_new_inline(123459L, 1);
-- EXPECT-C: blorp_list_new(123460L); blorp_list_init_elem_release(
-- EXPECT-NOT-C: return blorp_list_new(123457L);
-- EXPECT-NOT-C: return blorp_list_new(123458L);
