import:
	list: List, list


type alias Count = Int


enum Tiny:
	Red
	Blue


func make_ints() -> List[Int]:
	list(123457)


func make_counts() -> List[Count]:
	list(123458)


func make_tiny() -> List[Tiny]:
	list(123459)


func make_strings() -> List[String]:
	list(123460)


func main(args: List[String]) -> Int:
	xs: List[Int] = make_ints()
	counts: List[Count] = make_counts()
	colors: List[Tiny] = make_tiny()
	names: List[String] = make_strings()
	xs.length() + counts.length() + colors.length() + names.length()
