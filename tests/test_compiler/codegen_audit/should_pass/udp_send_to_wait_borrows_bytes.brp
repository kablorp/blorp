-- send_to_wait borrows its Bytes payload while it may park. The caller must
-- release the local owner after the result is handled, and cancellation while
-- parked must release the live payload through task cleanup.
-- EXPECT-C: blorp_CancelCleanupFrame __blorp_cleanup_payload;
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_payload, &payload, (void*)payload, blorp_cleanup_release_arc_only_value);
-- EXPECT-C: blorp_udp_send_to_wait_raw(sock, payload
-- EXPECT-C: blorp_task_cleanup_pop_slot(&payload);
-- EXPECT-C: blorp_release(payload);
import:
	bytes as B
	net/udp: UdpError, bind, send_to_wait, socket


func send_payload() -> Result[Int, UdpError]:
	with sock ?= socket():
		ignored ?= bind(sock, "127.0.0.1", 0)
		payload: Bytes = B.bytes(0)
		match send_to_wait(sock, payload, "127.0.0.1", 9):
			Ok(_): Ok(0)
			Err(_): Ok(1)


func main(args: List[String]) -> Int:
	match send_payload():
		Ok(value): value
		Err(_): 0
