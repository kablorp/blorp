-- EXPECT-C: blorp_task_cleanup_push(&__blorp_cleanup_reader, &reader, (void*)reader, (blorp_CancelCleanupFn)blorp_file_close_reader);
-- EXPECT-C: blorp_task_cleanup_pop_slot(&reader);
-- EXPECT-C: blorp_file_close_reader(reader);
import:
	file: IOError, open_read


func hold_reader_until_cancel(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		sleep(1000)
		Ok(1)
