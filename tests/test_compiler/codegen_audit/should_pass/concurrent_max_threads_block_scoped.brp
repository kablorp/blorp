-- concurrent(max_threads: N) should constrain the block, not initialize the
-- process-wide carrier pool to N.
-- EXPECT-NOT-C: blorp_thread_pool_init(2);
func work(x: Int) -> Int:
	x + 1


func main(args: List[String]) -> Int:
	concurrent(max_threads: 2):
		a = work(1)
		b = work(2)
		c = work(3)
		d = work(4)
	match a:
		Ok(v): v
		Err(_): 0
