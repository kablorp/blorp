-- Generated-C shape audit for POSIX/RFC3339 time runtime helper calls.
--
-- These helpers intentionally stay in the runtime instead of being synthesized
-- from source-level wrappers, because host portability and validation rules
-- are owned at the runtime boundary.
--
-- EXPECT-C: blorp_time_parse
-- EXPECT-C: blorp_time_from_iso
-- EXPECT-C: blorp_time_parse_rfc3339
import:
	time:
		from_iso,
		instant_to_posix_microseconds,
		parse_rfc3339,
		parse_time,


func parsed_posix_date() -> Int:
	match parse_time("2000-02-29", "%Y-%m-%d"):
		Some(value): value
		None: 0


func parsed_iso_date_time() -> Int:
	match from_iso("2000-02-29T00:00:00Z"):
		Some(value): value
		None: 0


func parsed_rfc3339_date_time() -> Int:
	match parse_rfc3339("2000-02-29T00:00:00Z"):
		Some(value): instant_to_posix_microseconds(value)
		None: 0


func main(args: List[String]) -> Int:
	parsed_posix: Int = parsed_posix_date()
	parsed_iso: Int = parsed_iso_date_time()
	parsed_rfc3339: Int = parsed_rfc3339_date_time()
	if parsed_posix == parsed_iso and parsed_iso == parsed_rfc3339:
		0
	else:
		1
