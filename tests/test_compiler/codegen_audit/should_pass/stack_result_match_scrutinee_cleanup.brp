-- A stack Result returned from a call can own its payload. If a branch later
-- parks, cancellation must release that payload through the task cleanup stack.
-- EXPECT-C: blorp_task_cleanup_push(&__blorp_owned_cleanup_
-- EXPECT-C: (void*)&__match_scrut_
-- EXPECT-C: blorp_cleanup_stack_result_value
-- EXPECT-C: blorp_task_cleanup_pop_slot(&__match_scrut_
-- EXPECT-C: blorp_stack_result_release(__match_scrut_
import:
	system: read_file


func read_then_park(path: String) -> Int:
	match read_file(path):
		Ok(text):
			sleep(1)
			text.length()
		Err(err):
			err.length()


func main(args: List[String]) -> Int:
	read_then_park("/tmp/blorp-codegen-audit-missing-file")
