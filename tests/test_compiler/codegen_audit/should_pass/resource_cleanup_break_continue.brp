-- EXPECT-C: (void)(blorp_file_close_reader(reader));
-- EXPECT-C: break;
-- EXPECT-C: continue;
import:
	fs: IOError, open_read


func break_after_open(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		var total: Int = 0
		for n in [1, 2, 3]:
			total += n
			if n == 1:
				break
		Ok(total)


func continue_after_open(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		var total: Int = 0
		for n in [1, 2, 3]:
			if n == 2:
				continue
			total += n
		Ok(total)


func main(args: List[String]) -> Int:
	_ = break_after_open("")
	_ = continue_after_open("")
	0
