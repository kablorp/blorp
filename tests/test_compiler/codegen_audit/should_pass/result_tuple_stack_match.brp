-- Generated-C audit for matching two stack Result values through a boxed tuple.
-- Scalar payloads isolate match projection from the separate known ownership
-- hole for managed stack-Result rvalues stored in tuples.
import:
	result: Result(Ok, Err)


pure func parse_value(value: Int) -> Result[Int, Int]:
	if value >= 0:
		Ok(value)
	else:
		Err(value)


pure func combine(left: Int, right: Int) -> Int:
	match (parse_value(left), parse_value(right)):
		(Ok(a), Ok(b)):
			a + b
		(Err(left_error), _):
			left_error
		(_, Err(right_error)):
			right_error


func main(args: List[String]) -> Int:
	if (
		combine(20, 22) == 42
		and combine(-1, 2) == -1
		and combine(1, -2) == -2
	):
		0
	else:
		1
