-- Proven compiler-owned tensor producers should let for-in use direct raw
-- storage without a runtime layout guard. Function parameters are covered by
-- vector_for_in_raw_storage.brp and must use the layout-safe runtime reader
-- because static type alone is not a storage proof.
-- EXPECT-C: long* __iter_raw_
-- EXPECT-C: double* __iter_raw_
-- EXPECT-C: float* __iter_raw_
-- EXPECT-NOT-C: ->storage_mode == BLORP_VECTOR_STORAGE_I64 &&
-- EXPECT-NOT-C: ->storage_mode == BLORP_VECTOR_STORAGE_F64 &&
-- EXPECT-NOT-C: ->storage_mode == BLORP_VECTOR_STORAGE_F32 &&
-- EXPECT-NOT-C: blorp_vector_read_i64(__iter_
-- EXPECT-NOT-C: blorp_vector_read_f64(__iter_
-- EXPECT-NOT-C: blorp_vector_read_f32(__iter_
import:
	float: to_float32


func sum_known_int() -> Int:
	v: Int[#4] = {1, 2, 3, 4}
	var total: Int = 0
	for x in v:
		total += x
	total


func sum_known_float() -> Float:
	v: Float[#3] = vector(1.5, 3)
	var total: Float = 0.0
	for x in v:
		total += x
	total


func sum_known_float32() -> Float32:
	v: Float32[#3] = vector(to_float32(2.0), 3)
	var total: Float32 = to_float32(0.0)
	for x in v:
		total += x
	total


func main(args: List[String]) -> Int:
	if sum_known_int() == 10 and sum_known_float() == 4.5:
		if sum_known_float32() == to_float32(6.0):
			0
		else:
			1
	else:
		1
