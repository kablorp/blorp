-- EXPECT-NOT-C: 1L + 2L
-- Semantic callable expectation: compile_time_builder
-- EXPECT-NOT-C: bh_L0cGpwNOHA
-- Semantic callable expectation: compile_time_loop_builder
-- EXPECT-NOT-C: bh_gfuzaVk7SF
private pure func compile_time_builder(value: Int) -> Int:
	value * 4 + 30


private pure func compile_time_loop_builder(limit: Int) -> Int:
	var total: Int = 0

	for value in 0..limit:
		total += value

	total


private X: Int = 1 + 2

Y: Int = compile_time_builder(X)

Z: Int = compile_time_loop_builder(5)


func main(args: List[String]) -> Int:
	Y + Z
