-- EXPECT-C: /* Blorp final Core C artifact */
-- EXPECT-C: return blorp_now_us();
-- EXPECT-C: return blorp_time_to_year(microseconds);
-- Semantic callable expectation: long timestamp = std_system__now_microseconds();
-- EXPECT-C-REGEX: long timestamp = brp_[0-9A-Za-z]+\(\);
-- Semantic callable expectation: long folded = std_time__to_year(timestamp);
-- EXPECT-C-REGEX: long folded = brp_[0-9A-Za-z]+\(timestamp\);
-- Semantic callable expectation: int __blorp_main_result = (int)ExitStatusAble_resolve_exit_status_Int($blorp$user_main_
-- EXPECT-C-REGEX: int __blorp_main_result = \(int\)brp_[0-9A-Za-z]+\(brp_[0-9A-Za-z]+\(args\)\);
import:
	system: now_microseconds
	time: to_year


func main(args: List[String]) -> Int:
	timestamp: Int = now_microseconds()
	folded: Int = to_year(timestamp)

	if folded >= 1970:
		0
	else:
		1
