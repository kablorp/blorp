-- A private compile_time binding remains a normal private top-level value when
-- ordinary runtime code references it.
-- EXPECT-C: static long CTFE_PRIVATE_RUNTIME_VALUE = 42L;
compile_time:
	private CTFE_PRIVATE_RUNTIME_VALUE: Int = 42


func main(args: List[String]) -> Int:
	CTFE_PRIVATE_RUNTIME_VALUE
