-- select should lower to the explicit runtime wait primitive instead of
-- desugaring into separate channel polls that could race.
-- EXPECT-C: blorp_SelectArm __select_arms_
-- EXPECT-C: .kind = BLORP_SELECT_RECV
-- EXPECT-C: .kind = BLORP_SELECT_SEALED
-- EXPECT-C: .kind = BLORP_SELECT_AFTER
-- EXPECT-C: blorp_SelectResult __select_result_
-- EXPECT-C: blorp_select_wait(__select_arms_
-- EXPECT-C: .arm_index == 0L
-- EXPECT-C: .arm_index == 1L
-- EXPECT-C: .arm_index == 2L

func main(args: List[String]) -> Int:
	ch: Channel[Int] = channel(1)
	seal(ch)
	var selected: Int = 0
	select:
		value from ch:
			selected = value
		sealed ch:
			selected = 1
		_ after 10:
			selected = 2
	selected
