-- Process-session state and write unions have typed Int payloads. Their runtime
-- bridge must pass raw integers to typed constructors, not erased pointers.
-- EXPECT-C: blorp_process_session_state_raw(session)
-- EXPECT-C: BLORP_PROCESS_SESSION_STATE_EXITED
-- EXPECT-C: _SessionExited(__process_session_
-- EXPECT-C: blorp_process_session_write_raw(session,
-- EXPECT-C: blorp_process_session_write_from_raw(session,
-- EXPECT-C: BLORP_PROCESS_SESSION_WRITE_WROTE
-- EXPECT-C: _Wrote(__process_session_
-- EXPECT-NOT-C: (void*)(intptr_t)__process_session_
import:
	process: ProcessError
	process_session:
		ProcessSessionState(SessionExited),
		ProcessWrite(Wrote),
		kill_session,
		session_command,
		session_state,
		start_session,
		write_stdin,
		write_stdin_from,


func exercise_session_payloads() -> Result[Int, ProcessError]:
	with session ?= start_session(
		session_command(
			"sh",
			["-c", "sleep 1"],
		),
	):
		write ?= write_stdin(session, "x".to_bytes())
		offset_write ?= write_stdin_from(session, "yz".to_bytes(), 1)
		state ?= session_state(session)
		_ = kill_session(session)

		written: Int = match write:
			Wrote(count):
				count
			_:
				0

		offset_written: Int = match offset_write:
			Wrote(count):
				count
			_:
				0

		exit_code: Int = match state:
			SessionExited(code):
				code
			_:
				0

		Ok(written + offset_written + exit_code)


func main(args: List[String]) -> Int:
	match exercise_session_payloads():
		Ok(value):
			value
		Err(_):
			0
