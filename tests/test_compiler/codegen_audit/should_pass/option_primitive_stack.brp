-- Generated-C shape audit for primitive stack Option payloads.
-- EXPECT-C: blorp_StackOption_Float
-- EXPECT-C: blorp_StackOption_Bool
-- EXPECT-C: blorp_StackOption_Char
-- EXPECT-C: .tag == TAG_Option_Some
-- EXPECT-C: double f = (double)
-- EXPECT-C: bool b = (bool)
-- EXPECT-C: int32_t c = (int32_t)
-- EXPECT-NOT-C: blorp_unbox_float(__scrut
import:
	option: Option(Some, None)


func choose_float(flag: Bool) -> Option[Float]:
	if flag:
		Some(1.5)
	else:
		None


func choose_bool(flag: Bool) -> Option[Bool]:
	if flag:
		Some(True)
	else:
		None


func choose_char(flag: Bool) -> Option[Char]:
	if flag:
		Some('A')
	else:
		None


func main(args: List[String]) -> Int:
	fo: Option[Float] = choose_float(True)
	bo: Option[Bool] = choose_bool(True)
	co: Option[Char] = choose_char(True)
	f_ok: Bool = match fo:
		Some(f): f == 1.5
		None: False
	b_ok: Bool = match bo:
		Some(b): b
		None: False
	c_ok: Bool = match co:
		Some(c): c == 'A'
		None: False
	if (
		f_ok
		and b_ok
		and c_ok
	):
		0
	else:
		1
