-- Generated-C shape audit for owned string hash runtime builtins.
-- EXPECT-C: return blorp_sha256(
-- EXPECT-C: return blorp_md5(
-- EXPECT-C: return blorp_sha512(
-- EXPECT-C: return blorp_sha256_bytes(
-- EXPECT-C: return blorp_crc32(
-- EXPECT-C: return blorp_crc32_bytes(
-- EXPECT-C: return blorp_hmac_sha256(
import:
	hash: crc32, crc32_bytes, hmac_sha256, md5, sha256, sha256_bytes, sha512


func main(args: List[String]) -> Int:
	text: String = "hello"
	digest: String = sha256(text)
	md5_digest: String = md5(text)
	wide_digest: String = sha512(text)
	byte_digest: String = sha256_bytes(text.to_bytes())
	checksum: Int = crc32(text)
	byte_checksum: Int = crc32_bytes(text.to_bytes())
	mac: String = hmac_sha256("key", text)

	total: Int = digest.length() + md5_digest.length() + wide_digest.length() + byte_digest.length()
	total + checksum + byte_checksum + mac.length()
