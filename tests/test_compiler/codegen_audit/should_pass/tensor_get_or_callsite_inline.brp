-- Tensor get_or should inline at user call sites so hot loops do not pay a
-- generated std/tensor wrapper call before reaching the stack-option get path.
-- EXPECT-C: blorp_vector_read_i64((blorp_Vector*)
-- EXPECT-NOT-C: std_tensor__get_or__mono_Int(values, 2L, 0L)
-- EXPECT-NOT-C: blorp_vector_get_opt_int(__std_inline_arr_
import:
	tensor: get_or


func main(args: List[String]) -> Int:
	values: Int[#4] = {1, 2, 3, 4}
	sample: Int = get_or(values, 2, 0)
	if sample == 3:
		0
	else:
		1
