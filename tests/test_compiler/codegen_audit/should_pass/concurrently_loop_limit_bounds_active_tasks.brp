-- for ... concurrently(limit: N) should bound active task fan-out to N
-- instead of allocating and spawning one task for every item up front.
-- EXPECT-C: long __conc_limit_
-- EXPECT-C: for (long __conc_start_
-- EXPECT-C: __conc_window_end_
-- EXPECT-C: __conc_tasks_
-- EXPECT-NOT-C: blorp_malloc_checked((__conc_len_
import:
	list: range


func main(args: List[String]) -> Int:
	results: List[Result[Int, ConcurrencyError]] = for i in range(0, 4) concurrently(limit: 2):
		i + 1
	var total: Int = 0
	for result in results:
		match result:
			Ok(value): total += value
			Err(_): total -= 100
	total
