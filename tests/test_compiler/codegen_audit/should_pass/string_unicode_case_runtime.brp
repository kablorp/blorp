-- Unicode case conversion is runtime-backed, not ASCII byte-loop IR.
-- EXPECT-C: blorp_upper(
-- EXPECT-C: blorp_lower(
import:
	string: lower, upper


func main(args: List[String]) -> Int:
	upper_value: String = "straße".upper()
	lower_value: String = "İ".lower()
	if upper_value == "STRASSE" and lower_value == "i̇":
		0
	else:
		1
