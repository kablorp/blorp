-- Enum set operations should use immediate integer-tag probing, not custom
-- Hashable/Equatable function pointers.
--
-- EXPECT-C: blorp_hash_int((long)(intptr_t)__insert_key)
-- EXPECT-C: blorp_hash_int((long)(intptr_t)__elem)
-- Semantic callable expectation: Hashable_hash_Color
-- EXPECT-NOT-C: bh_qBGer88jyi
-- Semantic callable expectation: Equatable_equals_Color
-- EXPECT-NOT-C: bh_Q9zTJ99SvL
import:
	set as S


enum Color:
	Red
	Green
	Blue


pure func next_color(c: Color) -> Color:
	match c:
		Red: Green
		Green: Blue
		Blue: Red


func run() -> Int:
	var s: Set[Color] = S.set()
	s = S.add(s, Red)
	s = S.add(s, Blue)
	mapped: Set[Color] = S.map(s, next_color)
	filtered: Set[Color] = S.filter(mapped, func(c: Color): c != Red)
	if (
		S.contains(mapped, Green)
		and S.contains(mapped, Red)
		and S.length(filtered) == 1
		and S.contains(filtered, Green)
	):
		0
	else:
		1


func main(args: List[String]) -> Int:
	run()
