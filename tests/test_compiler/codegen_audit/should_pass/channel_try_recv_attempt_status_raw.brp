-- Typed nonblocking receive attempts must use one runtime channel observation.
-- EXPECT-C: blorp_channel_try_recv_status_raw((blorp_Channel*)ch, &__chan_recv_value_
-- EXPECT-C: == BLORP_CHANNEL_RECV_VALUE) {
-- EXPECT-C: == BLORP_CHANNEL_RECV_SEALED) {
-- EXPECT-C: RecvWouldBlock
-- EXPECT-NOT-C: blorp_channel_is_sealed_and_drained
import:
	channel: RecvAttempt(RecvSealed, RecvValue, RecvWouldBlock), try_recv_attempt


func score(attempt: RecvAttempt[Int]) -> Int:
	match attempt:
		RecvValue(value): value
		RecvWouldBlock: 2
		RecvSealed: 3
		_: 4


func main(args: List[String]) -> Int:
	ch: Channel[Int] = channel(1)
	score(try_recv_attempt(ch))
