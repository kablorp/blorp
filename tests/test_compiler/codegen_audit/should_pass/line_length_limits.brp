-- Test that generated C doesn't produce excessively long lines.
-- The codegen should emit newlines inside statement expressions
-- so that no single C line exceeds a reasonable limit.
--
-- This mimics the particle_sim pattern: an if-expression where the
-- else branch contains a while loop with many statements per iteration.
-- Without line-break emission, this generates a 10K+ char mega-line.
--
-- EXPECT: no line > 2000 chars
import:
	dict as D
	list as L


record State {
	items: List[Int],
	lookup: Dict[Int, String],
	total: Int
}


func run(flag: Int) -> Int:
	var state: State = {
		items = [],
		lookup = D.dict(),
		total = 0
	}
	if flag == 0:
		0
	else:
		var i: Int = 0
		while i < 50:
			var new_items: List[Int] = []
			var new_lookup: Dict[Int, String] = D.dict()
			for j in 0..20:
				new_items = L.append(new_items, i * 20 + j)
				new_lookup = D.set(new_lookup, j, to_string(i * 20 + j))
			state = { state | items = new_items, lookup = new_lookup, total = state.total + 1 }
			var count: Int = 0
			for item in state.items:
				name: String = D.get_or(state.lookup, item % 20, "?")
				if length(name) > 0:
					count += 1
			if state.total > 10:
				var sorted_items: List[(Int, Int)] = []
				for k in 0..L.length(state.items):
					match L.get(state.items, k):
						Some(v): sorted_items = L.append(sorted_items, (v, 0 - v))
						None: void
				sorted_items = L.sort_by(sorted_items, func(x: (Int, Int)): x[1])
				for pair in sorted_items:
					_ = pair[0]
			i += 1
		state.total


func main(args: List[String]) -> Int:
	run(1)
