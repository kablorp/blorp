-- A pure window pipeline should materialize by copying directly from the
-- original source window.
-- EXPECT-C: __sp_window_result_
-- EXPECT-C: __sp_window_len_
-- EXPECT-C: memcpy(__string_copy_dst_
-- EXPECT-NOT-C: std_string__take_right(__def_
import:
	string: drop_left, take_right, trim


pure func fused_window(s: String) -> String:
	s
		.trim()
		.drop_left(1)
		.take_right(3)


func main(args: List[String]) -> Int:
	if fused_window("  abcdef  ") == "def":
		0
	else:
		1
