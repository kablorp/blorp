-- Scoped ParallelMatrix chains should lower to one runtime parallel matrix
-- kernel at the call site, preserving row-major matrix shape.
-- EXPECT-C: blorp_mmap_parallel(values,
-- EXPECT-C: blorp_mmap_indexed_parallel(indexed_values,
-- EXPECT-C: blorp_mzip_parallel(left,
-- EXPECT-C: blorp_mzip_indexed_parallel(mixed_left,
-- EXPECT-C: blorp_mmap_flat_indexed_parallel(distinct_left,
-- EXPECT-C: __pv_mstage_
-- EXPECT-NOT-C: blorp_mmap_indexed_parallel(left,
-- EXPECT-NOT-C: blorp_mmap_indexed_parallel(mixed_left,
-- EXPECT-NOT-C: blorp_mmap_indexed_parallel(distinct_left,
import:
	matrix: ParallelMatrix, parallel


func main(args: List[String]) -> Int:
	values: Int[#2, #2] = {{1, 2}, {3, 4}}
	mapped: Int[#2, #2] = values.parallel(pure func(chunk: ParallelMatrix[Int, #2, #2]):
		chunk
			.map(pure func(x: Int) -> Int: x + 1)
			.map(pure func(x: Int) -> Int: x * 2)
	)
	indexed_values: Int[#2, #3] = {{1, 1, 1}, {1, 1, 1}}
	indexed: Int[#2, #3] = indexed_values.parallel(pure func(chunk: ParallelMatrix[Int, #2, #3]):
		chunk
			.map_indexed(pure func(row: ..#2, col: ..#3, x: Int) -> Int: x + row + col)
			.map(pure func(x: Int) -> Int: x * 2)
	)
	left: Int[#2, #2] = {{1, 2}, {3, 4}}
	right: Int[#2, #2] = {{10, 20}, {30, 40}}
	zipped: Int[#2, #2] = left.parallel(pure func(chunk: ParallelMatrix[Int, #2, #2]):
		chunk
			.zip_map(right, pure func(a: Int, b: Int) -> Int: a + b)
			.map(pure func(x: Int) -> Int: x * 2)
	)
	mixed_left: Int[#2, #2] = {{1, 2}, {3, 4}}
	mixed_right: Int[#2, #2] = {{10, 20}, {30, 40}}
	mixed: Int[#2, #2] = mixed_left.parallel(pure func(chunk: ParallelMatrix[Int, #2, #2]):
		chunk
			.zip_map(mixed_right, pure func(a: Int, b: Int) -> Int: a + b)
			.map_indexed(pure func(row: ..#2, col: ..#2, x: Int) -> Int: x + row * 10 + col)
	)
	distinct_left: Int[#2, #2] = {{1, 2}, {3, 4}}
	distinct_mid: Int[#2, #2] = {{10, 20}, {30, 40}}
	distinct_right: Int[#2, #2] = {{100, 200}, {300, 400}}
	distinct: Int[#2, #2] = distinct_left.parallel(pure func(chunk: ParallelMatrix[Int, #2, #2]):
		chunk
			.zip_map(distinct_mid, pure func(a: Int, b: Int) -> Int: a + b)
			.zip_map(distinct_right, pure func(a: Int, b: Int) -> Int: a + b)
	)
	mapped[1, 1] + indexed[1, 2] + zipped[1, 1] + mixed[1, 1] + distinct[1, 1]
