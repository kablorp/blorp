-- Runtime builtins may return runtime-declared ABI structs such as
-- blorp_Result*. Generated std wrappers must cast those bridge returns to the
-- std-declared wrapper type instead of relying on incompatible pointer returns.
-- EXPECT-C: return blorp_stack_result_from_boxed((blorp_Result*)blorp_read_file(path));
-- EXPECT-C: blorp_MemStats* MemStats_make(
-- EXPECT-C: return (blorp_MemStats*)__rec;
import:
	memory: get_mem_stats, mem_delta
	system: read_file


func main(args: List[String]) -> Int:
	before = get_mem_stats()
	after = get_mem_stats()
	_ = mem_delta(before, after)
	match read_file("/tmp/blorp_codegen_audit_missing_file"):
		Ok(_): 1
		Err(_): 0
