-- Regression test: vector reduction operations
-- Ensures sum, product, max, min, mean, dot work for all element types.
import:
	test: TestSuite
	vector: argmax, argmin, cumulative_sum, dot, max, min, product, scale, sum


func test_sum_int() -> Bool:
	v: Int[#3] = {1, 2, 3}
	sum(v) == 6


func test_sum_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	abs(sum(v) - 6.0) < 0.001


func test_product_int() -> Bool:
	v: Int[#3] = {2, 3, 4}
	product(v) == 24


func test_product_float() -> Bool:
	v: Float[#3] = {2.0, 3.0, 4.0}
	abs(product(v) - 24.0) < 0.001


func test_max_int() -> Bool:
	v: Int[#4] = {3, 7, 1, 5}
	max(v) == 7


func test_max_float() -> Bool:
	v: Float[#3] = {1.5, 3.7, 2.1}
	abs(max(v) - 3.7) < 0.001


func test_min_int() -> Bool:
	v: Int[#4] = {3, 7, 1, 5}
	min(v) == 1


func test_min_float() -> Bool:
	v: Float[#3] = {1.5, 3.7, 2.1}
	abs(min(v) - 1.5) < 0.001


func test_dot_int() -> Bool:
	a: Int[#3] = {1, 2, 3}
	b: Int[#3] = {4, 5, 6}
	dot(a, b) == 32


func test_dot_float() -> Bool:
	a: Float[#3] = {1.0, 2.0, 3.0}
	b: Float[#3] = {4.0, 5.0, 6.0}
	abs(dot(a, b) - 32.0) < 0.001


func test_argmax_int() -> Bool:
	v: Int[#4] = {3, 7, 1, 5}
	argmax(v) == 1


func test_argmax_float() -> Bool:
	v: Float[#3] = {1.5, 3.7, 2.1}
	argmax(v) == 1


func test_argmin_int() -> Bool:
	v: Int[#4] = {3, 7, 1, 5}
	argmin(v) == 2


func test_argmin_float() -> Bool:
	v: Float[#3] = {1.5, 3.7, 2.1}
	argmin(v) == 0


func test_cumulative_sum_int() -> Bool:
	v: Int[#3] = {1, 2, 3}
	c: Int[#3] = cumulative_sum(v)
	c[0] == 1 and c[1] == 3 and c[2] == 6


func test_cumulative_sum_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	c: Float[#3] = cumulative_sum(v)
	abs(c[2] - 6.0) < 0.001


func test_scale_float() -> Bool:
	v: Float[#3] = {1.0, 2.0, 3.0}
	s: Float[#3] = scale(v, 2.0)
	abs(s[0] - 2.0) < 0.001 and abs(s[2] - 6.0) < 0.001


tests: TestSuite = {
	description = "Vector reductions",
	tests = [
		("sum int", test_sum_int),
		("sum float", test_sum_float),
		("product int", test_product_int),
		("product float", test_product_float),
		("max int", test_max_int),
		("max float", test_max_float),
		("min int", test_min_int),
		("min float", test_min_float),
		("dot int", test_dot_int),
		("dot float", test_dot_float),
		("argmax int", test_argmax_int),
		("argmax float", test_argmax_float),
		("argmin int", test_argmin_int),
		("argmin float", test_argmin_float),
		("cumulative_sum int", test_cumulative_sum_int),
		("cumulative_sum float", test_cumulative_sum_float),
		("scale float", test_scale_float),
	],
}
