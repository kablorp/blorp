-- Inline constructor calls as arguments to generic functions
-- Regression test: Some(42) inline must resolve T to Int
union Option[T]:
	Some(T)
	None


pure func map_opt[T, U](opt: Option[T], f: pure (T) -> U) -> Option[U]:
	match opt:
		Some(x): Some(f(x))
		None: None


func test_inline() -> Bool:
	result: Option[Int] = map_opt(Some(42), func(x): x + 1)
	True


func test_none_inline() -> Bool:
	result: Option[Int] = map_opt(None, func(x: Int): x + 1)
	True
