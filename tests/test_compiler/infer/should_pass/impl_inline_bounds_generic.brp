-- Impl with inline bounds on a generic type param of the for-type.
-- Checks that [implements Container for Option[T:Showable]] type-checks,
-- including the trait-bound extraction from the T:Showable syntax in the
-- for-type's type arguments. (Old filename said "where_clause" but no
-- where clause is used.)
trait Showable:
	pure func show(value: Self) -> String


trait Container:
	pure func describe(c: Self) -> String


implements Container for Option[T:Showable]:
	pure func describe(c: Option[T]) -> String:
		"Option container"


func main(args: List[String]) -> Int:
	0
