-- Concrete dims should widen to #Ds... (sound direction)
import:
	tensor: length


-- Passing concrete Int[#3] to func expecting #Ds...
func accept_any(v: Int[#Ds...]) -> Int:
	length(v)


-- Assignment: concrete to inferred (no variadic dim annotation needed)
func test_assign() -> Int:
	v: Int[#3] = {1, 2, 3}
	accept_any(v)


func main(args: List[String]) -> Int:
	v: Int[#3] = {1, 2, 3}
	accept_any(v)
