-- A trailing variadic dimension pack preserves concrete dimensions after its
-- fixed prefix when the call return type is specialized.
pure func preserve_shape[#N](values: Float[#N, #Ds...]) -> Float[#N, #Ds...]:
	values


func main(args: List[String]) -> Int:
	values: Float[#2, #3] = matrix(0.0, 2, 3)
	result: Float[#2, #3] = preserve_shape(values)
	result.length()
