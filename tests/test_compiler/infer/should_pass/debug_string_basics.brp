-- Coverage for the `debug.debug_string` universal diagnostic renderer:
-- MVP handles primitives, collections, and opaque-type placeholders.
-- Composite types (tuples, records, unions, enums) are deferred; see
-- memory/debug_string_composites_followup.md.
import:
	debug: debug_string


func main(args: List[String]) -> Int:
	f: pure (Int) -> Int = pure func(x: Int): x + 1
	c: Channel[Int] = channel(4)
	debug:
		-- Primitives
		debug_string(42)
		debug_string(3.14)
		debug_string(True)
		debug_string("hello")
		-- Collections
		debug_string([1, 2, 3])
		debug_string(["a", "b"])
		-- Opaque types — debug_string emits placeholder strings.
		debug_string(f)
		debug_string(c)
	0
