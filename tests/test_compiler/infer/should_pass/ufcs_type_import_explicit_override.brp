-- TEST: Explicitly imported function works as both bare name and UFCS method
import:
	list: List, map


func main(args: List[String]) -> Int:
	data: List[Int] = [1, 2, 3]
	-- Available as bare name (explicitly imported)
	a: List[Int] = map(data, func(x: Int): x * 2)
	-- Also available as UFCS method
	b: List[Int] = data.map(func(x: Int): x + 1)
	length(a) + length(b)
