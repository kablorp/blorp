-- Multi-character implicit type parameters should auto-generalize.
pure func identity_auto(value: Elem2) -> Elem2:
	value


pure func choose_auto(first: Item, fallback: Item) -> Item:
	first


func main(args: List[String]) -> Int:
	a: Int = identity_auto(42)
	b: String = choose_auto("left", "right")
	0
