-- Calling a generic function from within another generic function
-- where both use the same type parameter name (e.g. T).
-- The callee's T must be freshened to avoid false occurs-check failures.
import:
	list: List, length
	option: Option(Some, None)


-- Direct collision: both use T, inner arg type contains T
pure func count[T](items: List[T]) -> Int:
	length(items)


-- Function-typed list element: List[pure (T) -> Option[T]]
-- This is the exact pattern that triggers occurs_in false positive
pure func run_checks[T](checks: List[pure (T) -> Option[T]], val: T) -> Int:
	length(checks)


func main(args: List[String]) -> Int:
	nums: List[Int] = [1, 2, 3]
	n: Int = count(nums)
	0
