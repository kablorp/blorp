-- TEST: Should pass - tuple type checking
func assert_eq_int(actual: Int, expected: Int, message: String) -> Void:
	match actual == expected:
		True: print("  PASS: " + message)
		False: print("  FAIL: " + message)


func main(args: List[String]) -> Int:
	print("Tuple Type Checking")
	print("")
	print("=== Basic Tuple Types ===")
	pair: (Int, Int) = (1, 2)
	mixed: (Int, String) = (42, "answer")
	bool_float: (Bool, Float) = (True, 3.14)
	first: Int = pair.0
	second: Int = pair.1
	assert_eq_int(first, 1, "Tuple accessor .0 works")
	assert_eq_int(second, 2, "Tuple accessor .1 works")
	print("")
	print("PASS: All tuple type tests completed")
	0
