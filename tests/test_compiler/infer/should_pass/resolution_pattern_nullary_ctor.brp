-- NAME_RESOLUTION.md §5.1: PatVar "None" is normalized to PatConstructor
-- ("None", []) when None is a registered nullary constructor. Verifies
-- that None in a match arm is the constructor, not a fresh binding.
import:
	option: Option(Some, None)


pure func describe(x: Option[Int]) -> Int:
	match x:
		Some(v): v
		None: -1


func main(args: List[String]) -> Int:
	a: Int = describe(Some(42))
	b: Int = describe(None)
	-- a must be 42 (Some arm); b must be -1 (None arm, not a binding).
	if a == 42 and b == -1:
		0
	else:
		1
