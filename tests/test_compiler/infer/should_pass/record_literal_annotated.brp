record Vec2 {x: Float, y: Float}


struct Point2 {x: Float, y: Float}


-- Annotated: should work because variable has explicit type
func make_vec() -> Vec2:
	v: Vec2 = {x = 1.0, y = 2.0}
	v


func make_point() -> Point2:
	p: Point2 = {x = 1.0, y = 2.0}
	p


-- Return type context should also work
func make_vec_return() -> Vec2:
	{x = 1.0, y = 2.0}


func make_point_return() -> Point2:
	{x = 1.0, y = 2.0}
