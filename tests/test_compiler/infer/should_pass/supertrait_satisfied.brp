-- Trait with supertrait: impl'ing [Describable] requires [Printable]
-- to also be impl'd. The [via_supertrait] helper takes a [T: Describable]
-- bound and calls [show] on it — which is a Printable method, reachable
-- only because Describable inherits Printable as a supertrait. Without
-- that call, the test would pass even if supertrait dispatch were broken.
trait Printable:
	func show(value: Self) -> String


trait Describable: Printable:
	func describe(value: Self) -> String


implements Printable for Int:
	func show(value: Int) -> String:
		"int"


implements Describable for Int:
	func describe(value: Int) -> String:
		"an integer"


func via_supertrait[T:Describable](x: T) -> String:
	show(x)


func via_subtrait[T:Describable](x: T) -> String:
	describe(x)


func main(args: List[String]) -> Int:
	0
