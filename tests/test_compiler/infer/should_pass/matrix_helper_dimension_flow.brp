import:
	matrix: diagonal, get_column, get_column_or, identity_matrix, set_diagonal, trace


func use_diagonal(m: Int[#3, #3]) -> Int[#3]:
	m.diagonal()


func use_trace(m: Int[#3, #3]) -> Int:
	m.trace()


func use_identity[#N](size: #N) -> Int[#N, #N]:
	identity_matrix(size)


func use_set_diagonal(m: Int[#3, #3], values: Int[#3]) -> Int[#3, #3]:
	m.set_diagonal(values)


func use_get_column(m: Int[#3, #2]) -> Option[Int[#3]]:
	m.get_column(1)


func use_get_column_or(m: Int[#3, #2]) -> Int[#3]:
	m.get_column_or(1, 0)


func main(args: List[String]) -> Int:
	0
