-- Regression: matrix.brp's `get_or` body must compile when tensor's 2-arg
-- `get` is in scope alongside matrix's 3-arg `get`. Before the fix, bare
-- `get(m, row, col)` in matrix.brp:80 resolved to tensor's 2-arg signature
-- in batch-compile envs, producing "Function 'get' expects 2 arguments,
-- got 3" at typecheck and silently poisoning every downstream test. Fix:
-- matrix.brp's get_or calls a private `_matrix_get` that can't be shadowed.
--
-- Note: the bug is state-pollution-dependent and doesn't reliably reproduce
-- in a single standalone compile (see Phase 1.5 — test-runner module-cache
-- isolation). This test primarily serves as a smoke test for the `get_or`
-- + mixed-import API contract; the true fix-verification signal is the
-- seven runtime tests (`test_enumerate2`, `test_matrix_access`,
-- `test_matrix_builtins_alloc`, `test_matrix_elementwise`, `test_tensor_ops`,
-- `test_variadic_dims`, `test_matrix_ops`) that flipped from FAIL to PASS
-- when the fix landed.
import:
	matrix: get_or
	tensor: get


func main(args: List[String]) -> Int:
	m: Int[#2, #2] = matrix(0, 2, 2)
	v: Int = get_or(m, 0, 0, -1)
	-- Reference tensor's `get` directly so the import is consumed. Pass a
	-- 1D slice so the types line up with the 2-arg signature.
	xs: Int[#3] = vector(0, 3)
	first: Option[Int] = get(xs, 0)
	match first:
		Some(f):
			if v == 0 and f == 0:
				0
			else:
				1
		None: 1
