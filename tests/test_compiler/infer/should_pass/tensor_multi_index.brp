-- Multi-index tensor subscript type checking
-- 2D read
m: Int[#2, #3] = {
	{1, 2, 3},
	{4, 5, 6},
}


pure func read_int_cell() -> Int:
	m[0, 1]


-- 2D float read
mf: Float[#2, #2] = {
	{1.0, 2.0},
	{3.0, 4.0},
}


pure func read_float_cell() -> Float:
	mf[1, 0]


-- Subscript assignment (must be inside a function)
func test_assign() -> Int:
	var v: Int[#3] = {1, 2, 3}
	v[0] = 42
	var grid: Int[#3, #3] = {
		{0, 0, 0},
		{0, 0, 0},
		{0, 0, 0},
	}
	grid[1, 2] = 99
	0
