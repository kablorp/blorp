-- Test: structs as function parameters and return types
struct Vec2 {x: Float, y: Float}


pure func vec2_add(a: Vec2, b: Vec2) -> Vec2:
	{x = a.x + b.x, y = a.y + b.y}


func main(args: List[String]) -> Int:
	a: Vec2 = {x = 1.0, y = 2.0}
	b: Vec2 = {x = 3.0, y = 4.0}
	result: Vec2 = vec2_add(a, b)
	0
