-- Test: generic functions with type parameters don't hang the compiler
-- Regression test for apply_subst infinite loop on cyclic substitutions
union Wrapper[A, B]:
	Wrap(A, B)


func first[A, B](a: A, b: B) -> A:
	a


func second[A, B](a: A, b: B) -> B:
	b


func wrap_swapped[X, Y](x: X, y: Y) -> Wrapper[Y, X]:
	Wrap(y, x)


func main(args: List[String]) -> Int:
	x: Int = first(1, "hello")
	y: String = second(1, "hello")
	w: Wrapper[String, Int] = wrap_swapped(42, "test")
	0
