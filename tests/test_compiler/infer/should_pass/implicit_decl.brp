-- Implicit variable declaration: name = expr without type annotation
-- Should be treated as an immutable let binding
-- 'arr' should not trigger "Did you mean 'Err'?" since they differ in case
import:
	result: Result(Ok, Err)


func main(args: List[String]) -> Int:
	dummy: Result[Int, String] = Ok(0)
	_ = dummy
	x = 42
	x + 1


func test_string() -> String:
	s = "hello"
	s


func test_discard() -> Int:
	_ = 42
	_ = "ignored"
	0


func test_no_false_positive() -> Int:
	arr = [1, 2, 3]
	length(arr)


func test_near_name_declaration() -> Int:
	counter: Int = 0
	conter = 1
	counter + conter
