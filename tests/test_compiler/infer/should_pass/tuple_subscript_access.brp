-- Tuple indexes are compile-time checked and preserve each element type.
func main(args: List[String]) -> Int:
	pair: (Int, String) = (42, "answer")
	triple: (Int, Bool, String) = (1, True, "ok")
	first: Int = pair[0]
	second: String = pair[1]
	flag: Bool = triple[1]
	if (
		first == 42
		and second == "answer"
		and flag
	):
		0
	else:
		1
