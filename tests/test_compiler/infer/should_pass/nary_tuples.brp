-- N-ary tuple type inference
-- 3-tuple creation and field access
func test_triple_access() -> Int:
	t: (Int, Int, Int) = (10, 20, 30)
	t.0 + t.1 + t.2


-- 4-tuple creation and field access
func test_quad_access() -> Int:
	q: (Int, String, Bool, Int) = (1, "hi", True, 4)
	q.0 + q.3


-- 3-tuple destructuring
func test_triple_destruct() -> Int:
	(a, b, c) = (10, 20, 30)
	a + b + c


-- 4-tuple destructuring
func test_quad_destruct() -> Int:
	(a, b, c, d) = (1, 2, 3, 4)
	a + b + c + d


-- 3-tuple pattern matching
func test_triple_match(t: (Int, Int, Int)) -> String:
	match t:
		(0, 0, 0): "zero"
		(_, _, _): "other"


-- Mixed types in 3-tuple
func test_mixed_triple() -> String:
	t: (Int, String, Bool) = (42, "hello", True)
	t.1


-- 2-tuple still works (backward compat)
func test_pair() -> Int:
	p: (Int, Int) = (1, 2)
	p.0 + p.1


-- Destructuring with wildcards
func test_wildcard_destruct() -> Int:
	(_, b, _) = (1, 42, 3)
	b
