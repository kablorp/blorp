-- Test: late-binding type inference through var reassignment.
-- `var c = C.cache(10)` initially gives c a polymorphic type. The next line
-- `c = C.put(c, "a", "one")` constrains K=String, V=String — the first
-- call's type params MUST be retroactively resolved (via HM zonking)
-- so that downstream monomorphization sees concrete types.
import:
	cache as C
	option: Option(Some, None)


pure func test_late_binding() -> Bool:
	var c = C.cache(10)
	c = C.put(c, "a", "one")
	match C.get(c, "a"):
		Some(v): v == "one"
		None: False


func main(args: List[String]) -> Int:
	_ = test_late_binding()
	0
