-- A user record can implement Hashable by providing both Equatable
-- and Hashable impls. The trait supertrait chain (Hashable: Equatable)
-- is satisfied, and method calls resolve through the impl.
record Widget {id: Int, tag: Int}


implements Equatable for Widget:
	pure func equals(a: Widget, b: Widget) -> Bool:
		a.id == b.id and a.tag == b.tag


implements Hashable for Widget:
	pure func hash(self: Widget) -> Int:
		self.id * 31 + self.tag


pure func digest[T:Hashable](value: T) -> Int:
	value.hash()


func main(args: List[String]) -> Int:
	w: Widget = {id = 7, tag = 3}
	if digest(w) == 7 * 31 + 3:
		0
	else:
		1
