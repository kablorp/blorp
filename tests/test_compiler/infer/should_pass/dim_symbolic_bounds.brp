-- Symbolic bounds: v[0] is safe when dim is #N + 1 (minimum 1 element)
pure func first_elem[T, #N](v: T[#N + #1]) -> T:
	v[0]


-- v[0] and v[2] safe when dim is #N + 3 (minimum 3 elements)
pure func third_elem[T, #N](v: T[#N + #3]) -> T:
	v[2]


-- v[-1] safe when dim is #N + 1 (at least 1 element)
pure func last_elem[T, #N](v: T[#N + #1]) -> T:
	v[-1]


-- #N * 3 + 1 has minimum 1 (when #N = 0), so v[0] is safe
pure func first_of_scaled[T, #N](v: T[#N * #3 + #1]) -> T:
	v[0]
