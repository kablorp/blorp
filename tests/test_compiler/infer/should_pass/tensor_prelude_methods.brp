func vector_methods(xs: Int[#5], ys: Float[#3]) -> Bool:
	total: Int = xs.sum()
	biggest: Int = xs.max()
	avg: Float = xs.mean()
	dot_self: Float = ys.dot(ys)
	fallback: Int = xs.get_or(1, 0)
	total >= biggest and avg >= 0.0 and dot_self >= 0.0 and fallback >= 0


func matrix_methods(m: Int[#2, #3]) -> Bool:
	t: Int[#3, #2] = m.transpose()
	value: Int = m.get_or(1, 2, 0)
	t.length() == 3 and value >= 0
