-- Test: invoke a constructor (Some) whose type parameter name T collides
-- with the enclosing generic function's T. Fresh-var instantiation at
-- the call site must prevent false occurs_in failures and let the subst
-- resolve Some's T to the function's T.
import:
	option: Option(Some, None)


pure func wrap[T](x: T) -> Option[T]:
	Some(x)


pure func unwrap_or[T](o: Option[T], default: T) -> T:
	match o:
		Some(v): v
		None: default


func main(args: List[String]) -> Int:
	o: Option[Int] = wrap(7)
	result: Int = unwrap_or(o, 0)
	result
