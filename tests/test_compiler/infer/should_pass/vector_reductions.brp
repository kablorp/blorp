-- Test generic max/min/mean/sum/product reduction builtins type-check
import:
	vector: max, mean, min, product, sum


func use_reductions(vi: Int[#5], vf: Float[#3]) -> Bool:
	a: Int = max(vi)
	b: Int = min(vi)
	c: Float = max(vf)
	d: Float = min(vf)
	e: Float = mean(vi)
	f: Float = mean(vf)
	g: Int = sum(vi)
	h: Float = product(vf)
	True
