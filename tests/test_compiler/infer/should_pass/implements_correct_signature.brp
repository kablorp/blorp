-- Impl on a union type — method body pattern-matches, which forces
-- the type-checker to resolve each variant against [Color]. The
-- [use_describe] call then verifies that dispatch on [Color] picks the
-- correct impl, exercising trait-method lookup on a user-defined type.
trait Describable:
	pure func describe(val: Self) -> String


union Color:
	Red
	Green
	Blue


implements Describable for Color:
	pure func describe(val: Color) -> String:
		match val:
			Red: "Red"
			Green: "Green"
			Blue: "Blue"


pure func use_describe(c: Color) -> String:
	describe(c)


func main(args: List[String]) -> Int:
	0
