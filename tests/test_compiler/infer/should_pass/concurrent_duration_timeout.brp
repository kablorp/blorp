-- Test: concurrent timeouts accept typed Duration values
import:
	units: from_milliseconds


func compute(n: Int) -> Int:
	n + 1


func main(args: List[String]) -> Int:
	concurrent(timeout: from_milliseconds(100)):
		a = compute(1)

	nums: List[Int] = [1, 2, 3]
	for n in nums concurrently(limit: 2, timeout: from_milliseconds(100)):
		compute(n)

	0
