-- Trait with multiple methods — both must type-check at dispatch.
-- The [combine] helper forces the type-checker to resolve [add_op] and
-- [mul_op] through the trait; without those calls, the file would pass
-- on signature validation alone.
trait Arithmetic:
	pure func add_op(a: Self, b: Self) -> Self
	pure func mul_op(a: Self, b: Self) -> Self


implements Arithmetic for Int:
	pure func add_op(a: Int, b: Int) -> Int:
		a + b

	pure func mul_op(a: Int, b: Int) -> Int:
		a * b


pure func combine(x: Int, y: Int) -> Int:
	add_op(mul_op(x, y), y)


func main(args: List[String]) -> Int:
	0
