-- Test that selective import aliases resolve to correct types
import:
	list:
		filter as list_filter,
		get as list_get,
		length as list_length,
		map as list_map,
		sort as list_sort,
	option: Option(Some, None)


func main(args: List[String]) -> Int:
	xs: List[Int] = [3, 1, 2]
	result: Option[Int] = list_get(xs, 0)
	sorted: List[Int] = list_sort(xs)
	len: Int = list_length(xs)
	doubled: List[Int] = list_map(xs, func(x: Int): x * 2)
	evens: List[Int] = list_filter(xs, func(x: Int): x % 2 == 0)
	0
