-- Test: Correct function signatures and call inference
func add_ints(a: Int, b: Int) -> Int:
	a + b


func square(x: Int) -> Int:
	x * x


func greet(name: String) -> String:
	"Hello, " + name


func apply_twice(f: (Int) -> Int, x: Int) -> Int:
	f(f(x))


func compose(x: Int) -> Int:
	add_ints(square(x), x)


func use_all() -> Int:
	r1: Int = add_ints(10, 20)
	r2: Int = square(5)
	greeting: String = greet("World")
	r3: Int = apply_twice(square, 2)
	r1 + r2 + r3
