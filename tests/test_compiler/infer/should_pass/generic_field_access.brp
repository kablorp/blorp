-- Generic record field access should return the substituted type, not raw type param
record Pair[A, B] {first: A, second: B}


func get_first_int(p: Pair[Int, String]) -> Int:
	p.first


func get_second_str(p: Pair[Int, String]) -> String:
	p.second


func use_field_in_expr(p: Pair[Int, Bool]) -> Int:
	p.first + 1
