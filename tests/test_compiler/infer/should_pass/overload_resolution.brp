-- Overload resolution: using qualified imports to avoid ambiguity.
-- Importing the same non-builtin name from two modules is now an error
-- (prevents silent codegen dispatch bugs). Use aliases to disambiguate.
import:
	dict: contains as dict_contains, get as dict_get
	list: contains as list_contains, get as list_get


func test_list_get(xs: List[Int]) -> Option[Int]:
	list_get(xs, 0)


func test_dict_get(d: Dict[String, Int]) -> Option[Int]:
	dict_get(d, "key")


func test_list_contains(xs: List[Int]) -> Bool:
	list_contains(xs, 42)


func test_dict_contains(d: Dict[String, Int]) -> Bool:
	dict_contains(d, "hello")
