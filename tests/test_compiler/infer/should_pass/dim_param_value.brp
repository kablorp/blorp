import:
	tensor: get_or


-- Dimension parameters as runtime values
-- #N as a function parameter type
func make_vec(len: #N) -> Float[#N]:
	vector(0.0, len)


-- #N type param with length() propagation
pure func vget[#N](v: Float[#N], i: Int) -> Float:
	v.get_or(i, 0.0)


-- vector(0.0, length(v)) with generic dim
func zeros_like[#N](v: Float[#N]) -> Float[#N]:
	vector(0.0, length(v))


-- Dim literal type annotation
func dim_literal() -> Int:
	x: #300 = 300
	x


-- Dim type compatible with Int in comparisons
func dim_compare(n: #N) -> Bool:
	n > 0


-- Dim type compatible with Int in arithmetic
func dim_arith(n: #N) -> Int:
	n + 1


-- Dim type in for-loop range
func dim_range(n: #N) -> Int:
	var total: Int = 0
	for i in 0..n:
		total += 1
	total


-- length() returning dim type used in vector creation
func copy_size[#N](src: Float[#N]) -> Int[#N]:
	vector(0, length(src))


-- Subscript with dim-typed loop bound
func sum_vec[#N](v: Float[#N]) -> Float:
	var total: Float = 0.0
	for i in 0..length(v):
		total += v[i]
	total


func main(args: List[String]) -> Int:
	0
