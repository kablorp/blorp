-- With #N >= 1, v[0] is ALWAYS safe on T[#N]
pure func head[T, #N](v: T[#N]) -> T:
	v[0]


-- v[-1] is also always safe (last element always exists)
pure func last[T, #N](v: T[#N]) -> T:
	v[-1]


-- #M + #N >= 2 so v[0] and v[1] are both safe
pure func first_two[T, #M, #N](v: T[#M + #N]) -> (T, T):
	(v[0], v[1])


-- 2 * #N >= 2 so v[0] and v[1] are safe
pure func first_of_doubled[T, #N](v: T[#N * #2]) -> (T, T):
	(v[0], v[1])
