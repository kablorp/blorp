-- Test: assert_shape refines T[#Ds...] to T[#N]
-- assert_shape on a variadic tensor produces Option[T[#5]]
func test_basic(v: Float[#Ds...]) -> Bool:
	match assert_shape(v, 5):
		Some(validated):
			True
		None:
			False


-- assert_shape result can be used where a sized vector is expected
pure func needs_sized(v: Int[#10]) -> Int:
	0


func test_sized(v: Int[#Ds...]) -> Int:
	match assert_shape(v, 10):
		Some(validated):
			needs_sized(validated)
		None:
			-1
