-- Step 6 regression: [T: Orderable] must transitively satisfy the
-- Equatable bound for `==`/`!=`. Mirrors the pattern in std/tuple.brp
-- where the impl's bound is written as `A: Orderable` alone; without
-- Orderable: Equatable being globally resolvable, the `!=` in the
-- default `less_than` body would fail with "requires Equatable bound".
pure func extremes[T:Orderable](a: T, b: T) -> Bool:
	if a != b:
		a < b
	else:
		False


func main(args: List[String]) -> Int:
	if extremes(1, 2):
		0
	else:
		1
