-- Bitwise operations on various integer types
func test_int_bitwise() -> Int:
	a: Int = 255
	b: Int = 15
	bit_and(a, b)


func test_int8_bitwise(x: Int8, y: Int8) -> Int8:
	bit_or(x, y)


func test_uint32_bitwise(x: UInt32) -> UInt32:
	bit_xor(x, x)


func test_bit_not(x: Int) -> Int:
	bit_not(x)


func test_shift(x: Int, n: Int) -> Int:
	shift_left(x, n)


func test_shift_right_uint8(x: UInt8, n: Int) -> UInt8:
	shift_right(x, n)


func main(args: List[String]) -> Int:
	0
