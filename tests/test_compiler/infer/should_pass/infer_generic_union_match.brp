-- Test: generic function body pattern-matches over a parameterized union
-- and returns the same container with a different type parameter.
-- This exercises instantiation + unification across match arms where one
-- arm (Value) constrains the return type and another (Empty) carries
-- only the fresh type variable.
-- Regression guard: Empty arm's Container[T] must unify with Value arm's
-- Container[B] under the declared return type Container[B].
union Container[T]:
	Value(T)
	Empty


pure func container_map[A, B](c: Container[A], f: pure (A) -> B) -> Container[B]:
	match c:
		Value(v): Value(f(v))
		Empty: Empty


func main(args: List[String]) -> Int:
	c: Container[Int] = Value(42)
	result: Container[String] = container_map(c, pure func(x: Int): "hi")
	match result:
		Value(_): 0
		Empty: 1
