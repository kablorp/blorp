-- Test: Float32 same-type arithmetic and comparison
func main(args: List[String]) -> Int:
	a: Float32 = 1.0
	b: Float32 = 2.0
	c: Float32 = a + b
	d: Float32 = a - b
	e: Float32 = a * b
	f: Float32 = a / b
	g: Bool = a < b
	h: Bool = a > b
	i: Bool = a <= b
	j: Bool = a >= b
	k: Bool = a == b
	l: Bool = a != b
	m: Float32 = -a
	0
