-- Test: Dimension arithmetic in type annotations is accepted
-- TyDimOp in aliases and parameter types
type alias AddedDims[T, #M, #N] = T[#M + #N]

type alias MultipliedDims[T, #M, #N] = T[#M * #N]

-- Dim + constant
type alias PaddedOne[T, #N] = T[#N + #1]

-- Dim * constant
type alias DoubledDim[T, #N] = T[#N * #2]


-- TyDimOp in parameter types
pure func process[T, #M, #N](input: T[#M + #N]) -> Int:
	0
