import:
	result: Result(Ok, Err)


type alias Decoder[T] = pure (String) -> Result[T, String]


pure func parse_int(text: String) -> Result[Int, String]:
	Ok(41)


pure func make_decoder() -> Decoder[Int]:
	pure func(text: String):
		n ?= parse_int(text)
		Ok(n + 1)


func main(args: List[String]) -> Int:
	0
