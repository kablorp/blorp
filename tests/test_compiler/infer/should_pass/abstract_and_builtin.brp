-- Test: Trait definitions and ordinary function bodies type check correctly
-- Trait definition
trait Convertible:
	pure func convert(x: Self) -> String


func runtime_add(a: Int, b: Int) -> Int:
	a + b


pure func runtime_multiply(a: Int, b: Int) -> Int:
	a * b


pure func identity[T](x: T) -> T:
	x


-- Regular function that would use these (no main - this is a type check test)
func use_builtins() -> Int:
	x: Int = runtime_add(1, 2)
	y: Int = runtime_multiply(3, 4)
	x + y


func main(args: List[String]) -> Int:
	0
