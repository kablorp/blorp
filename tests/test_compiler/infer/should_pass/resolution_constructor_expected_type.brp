-- NAME_RESOLUTION.md §4.6: constructor type parameters instantiate
-- bidirectionally from the expected return type. Here Some(x)'s T is pinned
-- by the function's Option[Int] return type; no explicit type argument.
import:
	option: Option(Some, None)


pure func wrap(x: Int) -> Option[Int]:
	Some(x)


pure func example() -> Option[Int]:
	wrap(42)


func main(args: List[String]) -> Int:
	match example():
		Some(v):
			if v == 42:
				0
			else:
				1
		None: 2
