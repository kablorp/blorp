-- EXPECT: Variadic dimension #Ds... has conflicting shapes
-- Same variadic dim name in multiple params must have matching shapes
import:
	tensor: length


pure func bad(a: Int[#Ds...], b: Int[#Ds...]) -> Int:
	length(a) + length(b)


func main(args: List[String]) -> Int:
	v: Int[#3] = {1, 2, 3}
	m: Int[#2, #3] = matrix(0, 2, 3)
	bad(v, m)
