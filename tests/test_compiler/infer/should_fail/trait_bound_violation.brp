-- EXPECT: error: Type String does not implement trait Numeric (from std/traits) (required by add_nums)
-- Test trait bound violation (should fail type checking)
-- Generic function requiring Numeric bound
func add_nums[T:Numeric](a: T, b: T) -> T:
	a + b


-- ERROR: String does not implement Numeric
func test_string_not_numeric() -> String:
	add_nums("hello", "world")
