-- EXPECT: Constructor Some
-- EXPECT: expects 1 field(s), but pattern has 0
-- ERROR: Constructor pattern has too few fields
-- Some(T) has 1 field, but pattern has 0
import:
	option: Option(Some, None)


func main(args: List[String]) -> Int:
	x: Option[Int] = Some(42)
	match x:
		Some(): 1
		None: 0
