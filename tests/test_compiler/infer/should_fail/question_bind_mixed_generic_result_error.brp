-- EXPECT: error: Incompatible error type for ?=: enclosing block returns Result[..., String], but expression returns Result[..., E]
import:
	result: Result(Ok, Err)


func concrete_error() -> Result[Int, String]:
	Ok(2)


func bad[E](generic: Result[Int, E]) -> Result[Int, String]:
	x ?= generic
	y ?= concrete_error()
	Ok(x + y)
