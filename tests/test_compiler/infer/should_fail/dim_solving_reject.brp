-- EXPECT: error: Argument type mismatch: in call to 'needs_plus5', argument 1 ('v') expected ?m0[?m1 + #5], got Int[#3]
-- Dimension solving should reject impossible equations
-- #N + 5 = 3 → #N = -2 (negative, rejected)
pure func needs_plus5[T, #N](v: T[#N + #5]) -> Int:
	length(v)


pure func test_negative() -> Int:
	needs_plus5({1, 2, 3})
