-- EXPECT: expected LiteralString, got String
-- Command-line args are runtime Strings, cannot pass as LiteralString
import:
	list: List, get
	option: Option(Some, None)


func safe_query(sql: LiteralString) -> String:
	sql


func main(args: List[String]) -> Int:
	match get(args, 0):
		Some(user_input): _ = safe_query(user_input)
		None: void
	0
