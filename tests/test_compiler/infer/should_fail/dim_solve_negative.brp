-- EXPECT: error: Argument type mismatch: in call to 'prefix', argument 1 ('v') expected ?m0[?m1 + #5], got Int[#3]
-- Test: Calling a function where solving would produce #N = -2.
-- prefix[T, #N] takes T[#N + #5], so calling with Int[#3]
-- would require #N + 5 = 3, giving #N = -2. Unification rejects this.
pure func prefix[T, #N](v: T[#N + #5]) -> T[#N]:
	builtin


func main(args: List[String]) -> Int:
	v: Int[#3] = {1, 2, 3}
	prefix(v)
	0
