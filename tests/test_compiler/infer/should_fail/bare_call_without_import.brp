-- EXPECT: error: Undefined identifier: sort
-- TEST: Bare function calls (not UFCS) require explicit import
-- UFCS resolves via first-arg type, but bare calls need selective import
import:
	list: List


func main(args: List[String]) -> Int:
	data: List[Int] = [3, 1, 2]
	result: List[Int] = sort(data)
	length(result)
