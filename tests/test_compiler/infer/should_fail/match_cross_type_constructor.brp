-- EXPECT: belongs to type Shape, not Result
-- TEST: Should fail - using constructor from wrong type in match
-- Circle belongs to Shape, not Result
union Shape:
	Circle(Int)
	Square(Int, Int)


union Result:
	Ok(Int)
	Err(String)


func test(x: Result) -> Int:
	match x:
		Circle(r): r
		Ok(v): v
		Err(msg): -1


func main(args: List[String]) -> Int:
	test(Ok(5))
