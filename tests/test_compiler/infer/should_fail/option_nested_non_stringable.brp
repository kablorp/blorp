-- EXPECT: error: Type Wrap[Wrap[NotStringable]] does not implement trait Stringable (from std/traits) (required by to_string)
-- to_string on Wrap[Wrap[T]] should fail when T is not Stringable
union Wrap[T]:
	W(T)


union NotStringable:
	NS(Int)


implements Stringable for Wrap[T:Stringable]:
	pure func to_string(w: Wrap[T]) -> String:
		match w:
			W(v): to_string(v)


-- ERROR: Wrap[NotStringable] doesn't implement Stringable
func test_nested() -> String:
	inner: Wrap[NotStringable] = W(NS(42))
	outer: Wrap[Wrap[NotStringable]] = W(inner)
	to_string(outer)
