-- EXPECT: does not implement trait
-- Test that unimplemented user traits fail
-- ERROR: String does not implement Describable
-- Define a trait
trait Describable:
	pure func describe(val: Self) -> String


-- Implement for Int only
implements Describable for Int:
	pure func describe(val: Int) -> String:
		to_string(val)


-- Generic function requiring Describable bound
func show_description[T:Describable](val: T) -> String:
	describe(val)


-- ERROR: String does not implement Describable
func test_string_not_describable() -> String:
	show_description("hello")


func main(args: List[String]) -> Int:
	0
