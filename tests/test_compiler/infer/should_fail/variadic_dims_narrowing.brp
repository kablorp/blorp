import:
	tensor: length


-- EXPECT: type mismatch
-- T[#Ds...] should NOT satisfy T[#3] — narrowing is unsound
-- #Ds... means "any number of dims", so it cannot be proven to be exactly #3
pure func takes_3(v: Int[#3]) -> Int:
	v[0]


-- Returns Int[#Ds...] with no params to resolve dims from
func create_unknown() -> Int[#Ds...]:
	{1, 2, 3}


func main(args: List[String]) -> Int:
	w = create_unknown()
	-- Narrowing: #Ds... to #3 should fail
	takes_3(w)
