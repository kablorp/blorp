-- EXPECT: Argument type mismatch: in call to 'needs_multiple_of_three'
-- Test: dimension solving fails when there's no valid solution
-- #N * 3 = 7 has no integer solution
pure func needs_multiple_of_three[T, #N](v: T[#N * #3]) -> Int:
	length(v)


pure func test_no_solution() -> Int:
	v: Int[#7] = {1, 2, 3, 4, 5, 6, 7}
	needs_multiple_of_three(v)
