-- EXPECT: Argument type mismatch
-- TEST: Should fail - Function passed with wrong return type
-- Passing a (Int) -> String function where (Int) -> Int is expected
func apply(f: (Int) -> Int, x: Int) -> Int:
	f(x)


func wrong_return(n: Int) -> String:
	"string"


func main(args: List[String]) -> Int:
	result: Int = apply(wrong_return, 5)
	print(to_string(result))
	0
