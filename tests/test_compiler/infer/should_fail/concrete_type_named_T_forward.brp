-- EXPECT: error: Argument type mismatch: in call to 'test', argument 1 ('x') expected T, got String
-- Test: A union named [T] declared AFTER a function that references it
-- must still be treated as a concrete type (not auto-generalized).
-- Regression for a forward-reference hole found in the auto-generalization
-- existing-type guard; without the pre-scan of
-- known_type_names, the function would see [T] as a free var and accept
-- test("hello") as a generic call.
func test(x: T) -> Int:
	match x:
		Wrap(n):
			n


union T:
	Wrap(Int)


func main(args: List[String]) -> Int:
	test("hello")
