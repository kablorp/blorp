-- EXPECT: Cannot apply + to Int and Float
-- TEST: Should fail with "Cannot mix Int and Float"
-- Requires explicit conversion with to_int() or to_float()
-- This test is EXPECTED to fail compilation
func main(args: List[String]) -> Int:
	i: Int = 10
	f: Float = 3.14
	result = i + f -- Should require: to_float(i) + f
	print("This should never execute")
	0
