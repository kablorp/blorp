-- EXPECT: does not have bound
-- ERROR: Type parameter without required trait bound passed to bounded function
-- wrapper[U] calls to_string[T:Stringable] with U, but U has no Stringable bound
trait Stringable:
	pure func to_string(value: Self) -> String


pure func show[T:Stringable](x: T) -> String:
	to_string(x)


pure func wrapper[U](x: U) -> String:
	show(x)
