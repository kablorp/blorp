-- EXPECT: private
-- 'private' must sit on the same logical line as the signature it modifies.
-- Putting it on its own line above the signature reads ambiguously and is rejected.
private @tail_recursive
pure func count_down(n: Int) -> Int:
	if n <= 0:
		0
	else:
		count_down(n - 1)


func main(args: List[String]) -> Int:
	count_down(10)
