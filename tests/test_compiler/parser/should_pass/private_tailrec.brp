-- Private with @tailrec annotation, same line as signature.
-- (The newline-separated form `private @tailrec\npure func ...` is
-- a syntax error — see should_fail/private_separated_from_signature.brp.)
private @tailrec pure func count_down(n: Int) -> Int:
	if n <= 0:
		0
	else:
		count_down(n - 1)


func main(args: List[String]) -> Int:
	count_down(10)
