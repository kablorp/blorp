-- Test: foreign function declarations parse correctly
-- Impure foreign
foreign:
	func my_puts(s: String) -> Int = "puts"
	-- Foreign with Ptr type
	func my_malloc(size: Int) -> Ptr = "malloc"


-- Foreign block with named args
foreign(include: "math.h", link: "-lm"):
	func sin(x: Float) -> Float
	func cos(x: Float) -> Float
	func sqrt(x: Float) -> Float
	func my_tan(x: Float) -> Float = "tan"


-- Foreign with default C name (no = "...")
foreign:
	func floor(x: Float) -> Float


func main(args: List[String]) -> Int:
	0
