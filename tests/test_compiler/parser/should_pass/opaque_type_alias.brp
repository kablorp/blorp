-- The legacy spelling remains accepted for one bootstrap transition release.
opaque type UserId = Int


pure func legacy_user_id(raw: Int) -> UserId:
	into UserId(raw)


pure func legacy_user_id_value(value: UserId) -> Int:
	from UserId(value)


func main(args: List[String]) -> Int:
	id: UserId = into UserId(1)
	raw: Int = from UserId(id)
	raw + legacy_user_id_value(legacy_user_id(2))
