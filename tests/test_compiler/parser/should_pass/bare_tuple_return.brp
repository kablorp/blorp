-- Bare tuple as last expression (return value)
func make_pair(x: Int, y: Int) -> (Int, Int):
	(x, y)


func make_triple(x: Int, y: Int, z: Int) -> (Int, Int, Int):
	(x, y, z)


-- Bare tuple with local vars
func partition_like(x: Int) -> (Int, Int):
	var a: Int = x + 1
	var b: Int = x - 1
	(a, b)


-- Tuple destructuring still works via assign
func use_destruct() -> Int:
	(a, b) = (1, 2)
	a + b


-- Underscore in destructuring
func ignore_first() -> Int:
	(_, b) = (1, 2)
	b
