-- Parser accepts trailing commas in all expression contexts
func foo(a: Int, b: Int) -> Int:
	a + b


func main(args: List[String]) -> Int:
	-- Function call
	_ = foo(1, 2)

	-- List
	_ = [1, 2, 3]

	-- Tuple
	_ = (1, 2)

	-- Single element list with trailing comma
	_ = [42]

	-- Empty list (no comma)
	e: List[Int] = []

	-- Nested trailing commas
	_ = [[1, 2], [3, 4]]
	0
