-- Test that multiline function calls with lambda arguments parse correctly.
-- This exercises the lexer's paren_depth vs lambda_body_levels interaction.
import:
	list as L
	option: Option(Some, None)


-- Simple: lambda as last arg, multiline
func test_basic_multiline() -> Int:
	L.fold_left([1, 2, 3], 0, func(acc: Int, x: Int): acc + x)


-- Lambda in middle position, args after it on next line
func test_lambda_middle() -> List[Int]:
	L.filter([1, 2, 3, 4, 5], func(n: Int): n > 2)


-- Nested calls with lambdas, multiline
func test_nested_lambda_calls() -> Int:
	L.fold_left(
		L.map(
			L.filter(
				[1, 2, 3, 4, 5, 6],
				func(n: Int): n % 2 == 0,
			),
			func(n: Int): n * n,
		),
		0,
		func(acc: Int, x: Int): acc + x,
	)


-- Two-arg function call split across lines
func contains_check(items: List[Int], val: Int) -> Bool:
	L.fold_left(items, False, func(found: Bool, x: Int): found or x == val)


func main(args: List[String]) -> Int:
	_ = test_basic_multiline()
	_ = test_lambda_middle()
	_ = test_nested_lambda_calls()
	_ = contains_check([1, 2, 3], 2)
	0
