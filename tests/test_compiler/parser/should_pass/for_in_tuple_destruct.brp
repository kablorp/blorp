import:
	option: Option(Some, None)


-- For-in with tuple destructuring
func process_pairs(pairs: List[(Int, String)]) -> Int:
	var count: Int = 0
	for (key, value) in pairs:
		count += key
	count


func skip_first(pairs: List[(Int, Int)]) -> Int:
	var total: Int = 0
	for (_, val) in pairs:
		total += val
	total


func skip_second(pairs: List[(Int, Int)]) -> Int:
	var total: Int = 0
	for (key, _) in pairs:
		total += key
	total
