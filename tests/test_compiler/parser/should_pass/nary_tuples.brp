-- N-ary tuple parsing: 3-tuple and 4-tuple expressions, types, patterns
-- 3-tuple expression
triple: (Int, Int, Int) = (1, 2, 3)

-- 4-tuple expression
quad: (Int, String, Bool, Float) = (1, "hello", True, 3.14)


-- 3-tuple type annotation
func take_triple(t: (Int, Int, Int)) -> Int:
	t.0 + t.1 + t.2


-- 4-tuple type annotation
func take_quad(q: (Int, String, Bool, Float)) -> Int:
	q.0


-- 3-tuple pattern matching
func match_triple(t: (Int, Int, Int)) -> String:
	match t:
		(0, 0, 0): "origin"
		(_, _, _): "other"


-- 3-tuple destructuring
func destruct_triple() -> Int:
	(a, b, c) = (10, 20, 30)
	a + b + c


-- 4-tuple destructuring
func destruct_quad() -> Int:
	(a, b, c, d) = (1, 2, 3, 4)
	a + b + c + d


-- 2-tuple still works
pair: (Int, Int) = (1, 2)
