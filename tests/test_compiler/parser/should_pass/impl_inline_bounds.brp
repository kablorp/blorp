-- Inline bounds syntax for trait implementations
trait Showable:
	pure func show(value: Self) -> String


record Box[T] {
	value: T
}


-- Single inline bound
implements Showable for Box[T:Showable]:
	pure func show(b: Box[T]) -> String:
		show(b.value)


-- Multiple bounds with +
implements Showable for Option[T:Showable+Equatable]:
	pure func show(o: Option[T]) -> String:
		"option"
