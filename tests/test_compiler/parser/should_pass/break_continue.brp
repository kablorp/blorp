-- Test: Break and continue keyword parsing
func find_first(nums: List[Int], target: Int) -> Int:
	var result: Int = -1
	for n in nums:
		if n == target:
			result = n
			break
	result


func sum_odd(nums: List[Int]) -> Int:
	var total: Int = 0
	for n in nums:
		if n % 2 == 0:
			continue
		total += n
	total
