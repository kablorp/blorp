-- Named variadic dimension variables (#N...) syntax
-- #Ds... is the explicit variadic dim syntax
-- Function with explicit named variadic dims (shared param→return)
pure func identity[T](arr: T[#Ds...]) -> T[#Ds...]:
	arr


-- Function using #Ds... (variadic dims)
pure func length_of[T](arr: T[#Ds...]) -> Int:
	arr.length()


-- Mix of single dim var and variadic dims
pure func first_dim[T, #N](arr: T[#N, #Ds...]) -> Int:
	arr.length()


func main(args: List[String]) -> Int:
	0
