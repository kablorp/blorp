record Point {
	x: Int,
	y: Int
}


func move_right(p: Point) -> Point:
	{ p | x = p.x + 1 }


func move_diagonal(p: Point) -> Point:
	{ p |
		x = p.x + 1,
		y = p.y + 1
	}


func move_with_long_expression(p: Point) -> Point:
	{ p |
		x = very_long_coordinate_offset_name_that_should_not_fit_on_one_line(
			p.x,
			p.y,
			p.x + p.y,
			p.x * 2,
			p.y * 2,
			p.x + p.y + 1,
		)
	}


pure func very_long_coordinate_offset_name_that_should_not_fit_on_one_line(
	current_x: Int,
	current_y: Int,
	combined: Int,
	scaled_x: Int,
	scaled_y: Int,
	adjusted: Int,
) -> Int:
	current_x + current_y + combined + scaled_x + scaled_y + adjusted


func main(args: List[String]) -> Int:
	0
