func configure(attrs: Dict[String, String]) -> Int:
	0


func configure_pair(name: String, attrs: Dict[String, String]) -> Int:
	0


func short_single_entry() -> Int:
	configure({"class" => "primary"})


func long_single_entry() -> Int:
	configure({
		"very_long_configuration_key_name_for_the_formatter_regression" => "a long value that should push the single-entry dictionary past the line width"
	})


func multiple_entries() -> Int:
	configure({
		"class" => "primary",
		"role" => "button"
	})


func multiple_args_keep_call_shape() -> Int:
	configure_pair("button", {"class" => "primary", "role" => "button"})


func method_arg() -> Int:
	H.div.attrs({
		"class" => "primary",
		"role" => "button"
	})
