func json_to_value(json: JsonValue) -> Value:
	match json:
		JsonVector(items):
			VList(items.map(
				func(item: JsonValue): item.json_to_value(),
			))
		JsonObject(pairs):
			VRecord(pairs.map(
				func(pair: (String, JsonValue)): (pair[0], pair[1].json_to_value()),
			))


func sorted_directory_entries(
	entries: List[DirectoryEntry],
) -> Result[List[DirectoryEntry], String]:
	Ok(entries.sort_by(
		func(entry: DirectoryEntry): entry.name,
	))
