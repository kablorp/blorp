func takes_callback(
	x: Int,
	cb: (Int) -> Int,
	y: Int,
) -> Int:
	y


func call_block_lambda_middle() -> Int:
	takes_callback(
		1,
		func(x: Int):
			x + 1
		,
		3
	)


func list_block_lambdas() -> List[(Int) -> Int]:
	[
		func(x: Int):
			x + 1
		,
		func(y: Int):
			y + 2
	]


func tuple_block_lambda() -> ((Int) -> Int, Int):
	(
		func(x: Int):
			x + 1
		,
		3
	)


func main(args: List[String]) -> Int:
	0
