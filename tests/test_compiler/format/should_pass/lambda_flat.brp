-- Tests multiline calls inside lambda bodies stay canonical
-- Inline lambda body: long inner calls break vertically
func inline_lambda() -> List[Int]:
	[1, 2, 3].map(func(x: Int): some_long_function_name(
			x,
			x + 1,
			x + 2,
			x + 3,
		))


-- Block lambda body: long inner calls break vertically
func block_lambda() -> List[Int]:
	[1, 2, 3].map(func(x: Int):
		result: Int = some_long_function_name(
			x,
			x + 1,
			x + 2,
			x + 3,
		)
		result
	)


-- Chained lambda body: long inner calls break vertically
func chained_lambda() -> String:
	items.flat_map(func(item: String, rest: String):
		process(
			item,
			rest,
			"extra_argument_one",
			"extra_argument_two",
		)
	)


func main(args: List[String]) -> Int:
	0
