func id_scores(scores: List[Int]) -> List[Int]:
	scores


func main(args: List[String]) -> Int:
	scores: List[Int] = [1, 2, 3]
	scores
		-- method-call syntax is available for a function's first argument:
		-- scores.id_scores is the same as id_scores(scores)
		.id_scores()
		-- comments between chained calls stay with the next call
		.length()
