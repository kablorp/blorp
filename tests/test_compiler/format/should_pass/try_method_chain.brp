-- Formatter must preserve parens in (try: ...).method() pattern
import:
	list: List
	option: Option(Some, None)
	string: parse_int


func parse_or(args: List[String], default_val: Int) -> Int:
	(try:
		s ?= args.get(0)
		n ?= parse_int(s)
		n
	).get_or(default_val)


func main(args: List[String]) -> Int:
	0
