-- Comment before record
record Point {
	x: Int,
	y: Int
}


-- Comment before union
union Shape:
	Circle(Float)
	Rectangle(Float, Float)


-- Comment before struct
struct Color {
	r: Int,
	g: Int,
	b: Int
}


-- Comment before enum
enum Direction:
	North
	South
	East
	West


-- Comment before function using types
func area(s: Shape) -> Float:
	-- pattern match on shape
	match s:
		Circle(r):
			3.14 * r * r
		Rectangle(w, h):
			w * h


func main(args: List[String]) -> Int:
	0
