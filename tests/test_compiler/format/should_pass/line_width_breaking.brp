-- Tests for line-width-aware breaking of calls, lists, and vectors (100-char width)
-- Short call stays flat
func short_call() -> Int:
	some_func(1, 2, 3)


-- Long call breaks across lines (>100 chars when flat)
func long_call() -> String:
	some_function_with_a_long_name(
		"first argument",
		"second argument",
		"third argument that pushes past the limit",
	)


-- Short list stays flat
func short_list() -> List[Int]:
	[1, 2, 3, 4, 5]


-- Long list breaks across lines
func long_list() -> List[String]:
	[
		"first element that is quite long",
		"second element that is also long",
		"third element completing the set",
	]


-- Nested calls break at appropriate levels
func nested_breaking() -> String:
	outer_function(
		inner_function("short arg"),
		another_function("another short arg"),
		final_function("final short arg"),
	)


func main(args: List[String]) -> Int:
	0
