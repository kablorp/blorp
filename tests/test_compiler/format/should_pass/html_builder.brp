-- Tests for HTML-builder-style nested calls breaking readably
func div(attrs: List[String], children: List[String]) -> String:
	"div"


func button(attrs: List[String], children: List[String]) -> String:
	"button"


func h1(attrs: List[String], children: List[String]) -> String:
	"h1"


func p(attrs: List[String], children: List[String]) -> String:
	"p"


func class_(name: String) -> String:
	name


func text(s: String) -> String:
	s


-- Short HTML stays flat
func short_view() -> String:
	div([], [text("hello")])


-- Long HTML breaks at call and list boundaries
func long_view() -> String:
	div(
		[class_("container")],
		[
			h1([], [text("Title")]),
			p([class_("description")], [text("Some descriptive text here")]),
			div(
				[class_("buttons")],
				[
					button([class_("btn-primary")], [text("Submit")]),
					button([class_("btn-secondary")], [text("Cancel")]),
				],
			),
		],
	)


func main(args: List[String]) -> Int:
	0
