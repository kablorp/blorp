func page():
	H.article
		.attrs({"class" => "doc-page"})
		.children([
			H.section
				.attrs({"class" => "intro"})
				.children([
					H.div
						.attrs({"class" => "intro-copy"})
						.children([
							H.h1.children(["Blorp documentation"]),
							H.p
								.attrs({"class" => "lede"})
								.children([
									"Blorp is a small language for safe, fast code with explicit effects, value semantics, pattern matching, and native output.",
								])
						]),
					code_panel(
						"hello.brp",
						"func main(args: List[String]) -> Void:\n    print(\"Hello, world!\")",
					)
				]),
			H.section
				.attrs({"class" => "doc-section"})
				.children([
					H.h2.children(["Core ideas"]),
					H.ul
						.attrs({"class" => "feature-list"})
						.children([
							feature(
								"Purity tracking",
								"Pure functions cannot perform I/O or call impure code.",
							),
							feature(
								"Value semantics",
								"Assignment copies values, and collections use COW for efficient sharing.",
							),
							feature(
								"UFCS",
								"Functions compose left-to-right through method call syntax.",
							),
							feature(
								"Native output",
								"Blorp compiles to C and uses deterministic ARC.",
							),
						])
				])
		])
