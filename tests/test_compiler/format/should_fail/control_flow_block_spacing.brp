func classify(value: Option[Int]) -> String:
	seen: Int = 0
	match value:
		Some(n): "some"
		None: "none"
	done: String = "yes"
	-- Keep this comment attached to the branch below.
	if seen == 0:
		"zero"
	else:
		done
	for item in [1, 2, 3]:
		seen += item
	while seen < 10:
		seen += 1
	done


func main(args: List[String]) -> Int:
	0
