pure func describe(value: String) -> String:
	match value
		.trim()
		.to_lower():
		_:
			"seen"


func count_ready(values: List[String]) -> Int:
	var count: Int = 0

	for value in values
		.reverse()
		.take(3):
		count += 1

	while values
		.reverse()
		.length() > count:
		count += 1

	count


func count_pairs(pairs: List[(String, Int)]) -> Int:
	var count: Int = 0

	for (name, value) in pairs
		.reverse()
		.take(3):
		count += value

	count
