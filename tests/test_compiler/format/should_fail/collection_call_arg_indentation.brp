func render(value: Any) -> String:
	""


func box_arg(value: Any) -> Any:
	value


func main(args: List[String]):
	render(box_arg({
			safe = True,
			fast = True,
			expressive = True,
			simple = True
		}))
	render(box_arg([
			"alpha",
			"beta",
			"gamma",
			"delta"
		]))
	render(box_arg({
			"alpha" => 1,
			"beta" => 2,
			"gamma" => 3
		}))
	render(box_arg({
			1,
			2,
			3,
			4,
			5,
			6,
			7,
			8,
			9
		}))
