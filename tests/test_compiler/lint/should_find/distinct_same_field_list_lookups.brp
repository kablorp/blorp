-- EXPECT-CONTAINS: "rule_id":"loop.list-lookup"
-- EXPECT-NOT-CONTAINS: "rule_id":"loop.repeated-list-lookup"
record Program {
	decls: List[Int],
	name: String
}


pure func combine(source: Program, expected: Program) -> Int:
	var total: Int = 0

	for index in 0..source.decls.length():
		total += source.decls.get_or(index, 0)
		total += expected.decls.get_or(index, 0)

	total
